#. Occurrence 1DOT5_3:7230:1622: voice_id=C50_1DOT5_3_0022; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7230
msgctxt "text_id=1622 | speaker=unknown"
msgid "　状況ヲ　終了シマス。"
msgstr ""

#. Occurrence 1DOT5_3:7237:1623: voice_id=C50_1DOT5_3_0023; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7237
msgctxt "text_id=1623 | speaker=unknown"
msgid "　Ａａａａａ。主ヨ。ドウカ、コノ身ヲ、護リ―――"
msgstr ""

#. Occurrence 1DOT5_3:7439:1624: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0022; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7439
msgctxt "text_id=1624 | speaker=alice"
msgid "「……済んだようね。お疲れさま、戻ってテムズ。"
msgstr ""

#. Occurrence 1DOT5_3:7451:1625: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0023; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7451
msgctxt "text_id=1625 | speaker=alice"
msgid "　次はもっと、高価な場所ならいいのだけど」"
msgstr ""

#. Occurrence 1DOT5_3:7535:1626: scene=1DOT5_3
#: 1DOT5_3:7535
msgctxt "text_id=1626 | speaker=unknown"
msgid "　少女は踵を返す。"
msgstr ""

#. Occurrence 1DOT5_3:7540:1627: scene=1DOT5_3
#: 1DOT5_3:7540
msgctxt "text_id=1627 | speaker=unknown"
msgid "　この森に工房を構えた外敵は消し去った。"
msgstr ""

#. Occurrence 1DOT5_3:7545:1628: scene=1DOT5_3
#: 1DOT5_3:7545
msgctxt "text_id=1628 | speaker=unknown"
msgid "　彼らが善悪どちらのもので、どれだけの被害者を築き上げてきたか、少女には関心のない事だ。"
msgstr ""

#. Occurrence 1DOT5_3:7550:1629: scene=1DOT5_3
#: 1DOT5_3:7550
msgctxt "text_id=1629 | speaker=unknown"
msgid "　人間社会のしがらみに関心は持たない。"
msgstr ""

#. Occurrence 1DOT5_3:7555:1630: scene=1DOT5_3
#: 1DOT5_3:7555
msgctxt "text_id=1630 | speaker=unknown"
msgid "　それが純血の魔女、マインスターのあり方だ。"
msgstr ""

#. Occurrence 1DOT5_3:7640:1631: voice_id=C20_1DOT5_3_0023; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7640
msgctxt "text_id=1631 | speaker=unknown"
msgid "『ちょ、ボクたちは！？　ねえボクたちは！？』"
msgstr ""

#. Occurrence 1DOT5_3:7648:1632: voice_id=C30_1DOT5_3_0021; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7648
msgctxt "text_id=1632 | speaker=unknown"
msgid "『腕、この腕ぬけないんだけど！』"
msgstr ""

#. Occurrence 1DOT5_3:7654:1633: voice_id=C20_1DOT5_3_0024; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7654
msgctxt "text_id=1633 | speaker=unknown"
msgid "『噛んだままだとボクらも動けないっていうかさあ』"
msgstr ""

#. Occurrence 1DOT5_3:7662:1634: voice_id=C30_1DOT5_3_0022; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7662
msgctxt "text_id=1634 | speaker=unknown"
msgid "『ひどい、飛べないブタに用はないと！？』"
msgstr ""

#. Occurrence 1DOT5_3:7669:1635: voice_id=C20_1DOT5_3_0025; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7669
msgctxt "text_id=1635 | speaker=unknown"
msgid "『次、次はお役に立ちますきっと！　生まれてこの方、失敗続きのボクらだけど！』"
msgstr ""

#. Occurrence 1DOT5_3:7677:1636: voice_id=C30_1DOT5_3_0023; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7677
msgctxt "text_id=1636 | speaker=unknown"
msgid "『うん、壊れるまでに一度ぐらいは褒められたいね！』"
msgstr ""

#. Occurrence 1DOT5_3:7760:1637: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0024; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7760
msgctxt "text_id=1637 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 1DOT5_3:7770:1638: scene=1DOT5_3
#: 1DOT5_3:7770
msgctxt "text_id=1638 | speaker=unknown"
msgid "　少女はため息をついて小川に足を運ぶと、黒い手袋をとって、細い指を氷水に浸した。"
msgstr ""

#. Occurrence 1DOT5_3:7831:1639: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0025; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7831
msgctxt "text_id=1639 | speaker=alice"
msgid "「六の目はだすなって言うけど。"
msgstr ""

#. Occurrence 1DOT5_3:7838:1640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0026; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7838
msgctxt "text_id=1640 | speaker=alice"
msgid "六の目しかでないようになってるわよね、貴方たち」"
msgstr ""

#. Occurrence 1DOT5_3:7858:1641: scene=1DOT5_3
#: 1DOT5_3:7858
msgctxt "text_id=1641 | speaker=unknown"
msgid "　憂鬱な呟きに、<応|こた>えの声はない。"
msgstr ""

#. Occurrence 1DOT5_3:7863:1642: scene=1DOT5_3
#: 1DOT5_3:7863
msgctxt "text_id=1642 | speaker=unknown"
msgid "　あれほど騒がしかった子豚は影も形もなく、少女の手のひらには黒い<賽子|ダイス>が二つだけ。"
msgstr ""

#. Occurrence 1DOT5_3:7868:1643: scene=1DOT5_3
#: 1DOT5_3:7868
msgctxt "text_id=1643 | speaker=unknown"
msgid "　少女は散らばった残骸に声をかけようとして、あ、と口元に手を当てた。"
msgstr ""

#. Occurrence 1DOT5_3:7908:1644: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0027; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7908
msgctxt "text_id=1644 | speaker=alice"
msgid "「……お別れは済ませていたわね。"
msgstr ""

#. Occurrence 1DOT5_3:7914:1645: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0028; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7914
msgctxt "text_id=1645 | speaker=alice"
msgid "　<銘|めい>ぐらいは、聞いておくべきだったかしら」"
msgstr ""

#. Occurrence 1DOT5_3:7972:1646: scene=1DOT5_3
#: 1DOT5_3:7972
msgctxt "text_id=1646 | speaker=unknown"
msgid "　白魚のような指が、名残惜しそうに唇をなぞる。"
msgstr ""

#. Occurrence 1DOT5_3:7977:1647: scene=1DOT5_3
#: 1DOT5_3:7977
msgctxt "text_id=1647 | speaker=unknown"
msgid "　少女は二度目のため息をついた後、訪れた時と同じように、ゆっくりと暗い森を後にした。"
msgstr ""

#. Occurrence 1DOT5_4:47:1648: scene=1DOT5_4
#: 1DOT5_4:47
msgctxt "text_id=1648 | speaker=unknown"
msgid "　カメラは少しだけさかのぼる。"
msgstr ""

#. Occurrence 1DOT5_4:52:1649: scene=1DOT5_4
#: 1DOT5_4:52
msgctxt "text_id=1649 | speaker=unknown"
msgid "　日付にすると１２月初めの、ちょっとした閑話休題。"
msgstr ""

#. Occurrence 1DOT5_4:100:1650: scene=1DOT5_4
#: 1DOT5_4:100
msgctxt "text_id=1650 | speaker=unknown"
msgid "　三時限目の授業が終わり、帰りの<ＨＲ|ホームルーム>を残すだけの土曜の昼前。"
msgstr ""

#. Occurrence 1DOT5_4:105:1651: scene=1DOT5_4
#: 1DOT5_4:105
msgctxt "text_id=1651 | speaker=unknown"
msgid "　２－Ｃ組の生徒である<静希|しずき><草十郎|そうじゅうろう>と<木|き><乃|の><美|み><芳助|ほうすけ>は、担任の山城和樹がいっこうに現れない為、帰りたいのに帰れない、という宙づり状態でベランダから校庭など眺めていた。"
msgstr ""

#. Occurrence 1DOT5_4:125:1652: scene=1DOT5_4
#: 1DOT5_4:125
msgctxt "text_id=1652 | speaker=unknown"
msgid "　他のクラスメイトたちは教室内で雑談中。"
msgstr ""

#. Occurrence 1DOT5_4:146:1653: scene=1DOT5_4
#: 1DOT5_4:146
msgctxt "text_id=1653 | speaker=unknown"
msgid "　ふたりの隣には、暇つぶしで付き合っている<Ａ|よ><組|そ>のクラスの<槻司|つきじ><鳶丸|とびまる>の姿があった。"
msgstr ""

#. Occurrence 1DOT5_4:151:1654: scene=1DOT5_4
#: 1DOT5_4:151
msgctxt "text_id=1654 | speaker=unknown"
msgid "　三人はやる気なさげにベランダの<欄干|らんかん>によりかかり、週末の予定などを話しあっている。"
msgstr ""

#. Occurrence 1DOT5_4:177:1655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0000; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:177
msgctxt "text_id=1655 | speaker=soujuurou"
msgid "「木乃美はベアでアルバイトか？」"
msgstr ""

#. Occurrence 1DOT5_4:190:1656: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0000; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:190
msgctxt "text_id=1656 | speaker=kinomi"
msgid "「バッカ、誰が日曜まで働くかってーの。"
msgstr ""

#. Occurrence 1DOT5_4:196:1657: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0001; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:196
msgctxt "text_id=1657 | speaker=kinomi"
msgid "　明日はほら、Ｂ組の子たちと遊びに行く……予定だったんだけどなー。なんかうちから出られねぇー」"
msgstr ""

#. Occurrence 1DOT5_4:241:1658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0001; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:241
msgctxt "text_id=1658 | speaker=soujuurou"
msgid "「む。それはつまり、またふられたのか」"
msgstr ""

#. Occurrence 1DOT5_4:270:1659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0002; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:270
msgctxt "text_id=1659 | speaker=kinomi"
msgid "「ごはっ、直撃!?　言いづらいコトをまっすぐ言うよね静希クンってば！」"
msgstr ""

#. Occurrence 1DOT5_4:299:1660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0000; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:299
msgctxt "text_id=1660 | speaker=tobimaru"
msgid "「そりゃ毎日テメエのバカ面みてれば、ヒヨコだってふられるって言葉を覚えるだろうよ。自滅するのは勝手だけどな、くれぐれも草の字にヘンな遊び教えんなよ」"
msgstr ""

#. Occurrence 1DOT5_4:342:1661: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0003; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:342
msgctxt "text_id=1661 | speaker=kinomi"
msgid "「あん、そりゃ<殿下|でんか>の方じゃねえの？"
msgstr ""

#. Occurrence 1DOT5_4:348:1662: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0004; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:348
msgctxt "text_id=1662 | speaker=kinomi"
msgid "　気ぃつけろよ静希、<槻司|つきじ>はマジで腹黒いからよ。"
msgstr ""

#. Occurrence 1DOT5_4:354:1663: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0005; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:354
msgctxt "text_id=1663 | speaker=kinomi"
msgid "　コイツの頭ん中は、ほら、アレ。ゴミ捨て場の貼り紙？　あんな感じだから。くっきり使えるモンと使えないモン分けてんだよ」"
msgstr ""

#. Occurrence 1DOT5_4:395:1664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0002; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:395
msgctxt "text_id=1664 | speaker=soujuurou"
msgid "「ああ、それは知ってる。"
msgstr ""

#. Occurrence 1DOT5_4:406:1665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0003; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:406
msgctxt "text_id=1665 | speaker=soujuurou"
msgid "　―――ところで唐突に思ったんだが、鳶丸の中じゃ木乃美はどういう扱いなんだ？」"
msgstr ""

#. Occurrence 1DOT5_4:434:1666: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0001; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:434
msgctxt "text_id=1666 | speaker=tobimaru"
msgid "「そうだなあ。粗大ゴミ回収は、金でも貰わねえとワリ合わなくなるんじゃねえか？　国が無料で回収するのはそろそろおしまいってトコ」"
msgstr ""

#. Occurrence 1DOT5_4:478:1667: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0006; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:478
msgctxt "text_id=1667 | speaker=kinomi"
msgid "「はあ？　なに言ってんのオマエ？　使い古しの箪笥とか高く売れるじゃん！"
msgstr ""

#. Occurrence 1DOT5_4:490:1668: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0007; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:490
msgctxt "text_id=1668 | speaker=kinomi"
msgid "　オレみたいな開封・即使用、みたいな男がこれからのトレンドなワケでしょ？　ほら、コンビニで売ってる使い捨てカメラとか大人気だし？　ようやく流行がオレの消費文明に追いついたと、」"
msgstr ""

#. Occurrence 1DOT5_4:532:1669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:532
msgctxt "text_id=1669 | speaker=soujuurou"
msgid "「じゃあ木乃美はバイト、と。"
msgstr ""

#. Occurrence 1DOT5_4:546:1670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:546
msgctxt "text_id=1670 | speaker=soujuurou"
msgid "鳶丸は？」"
msgstr ""

#. Occurrence 1DOT5_4:558:1671: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0008; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:558
msgctxt "text_id=1671 | speaker=kinomi"
msgid "「来るからネ、ちゃんとオレの時代！」"
msgstr ""

#. Occurrence 1DOT5_4:569:1672: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0002; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:569
msgctxt "text_id=1672 | speaker=tobimaru"
msgid "「俺はちょい私用だ。親父の客が来てるんで接待しなきゃならん。街の案内をしてくれとさ」"
msgstr ""

#. Occurrence 1DOT5_4:596:1673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0009; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:596
msgctxt "text_id=1673 | speaker=kinomi"
msgid "「きけよー。人の話きけよー。"
msgstr ""

#. Occurrence 1DOT5_4:627:1674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0010; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:627
msgctxt "text_id=1674 | speaker=kinomi"
msgid "　あのよぅ、オレは妹の相手してやるだけなんだよぅ。隣のクソ中華飯店の手伝いなんかしねーよー」"
msgstr ""

#. Occurrence 1DOT5_4:655:1675: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0003; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:655
msgctxt "text_id=1675 | speaker=tobimaru"
msgid "「草の字は？　明日もバイトか？」"
msgstr ""

#. Occurrence 1DOT5_4:683:1676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0005; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:683
msgctxt "text_id=1676 | speaker=soujuurou"
msgid "「いや、それが一日空いてる。今日はこれから遊園地でアルバイトだけど」"
msgstr ""

#. Occurrence 1DOT5_4:727:1677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0011; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:727
msgctxt "text_id=1677 | speaker=kinomi"
msgid "「うげぇ、それって魔のキッツィーランド？"
msgstr ""

#. Occurrence 1DOT5_4:733:1678: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0012; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:733
msgctxt "text_id=1678 | speaker=kinomi"
msgid "　タフだねぇ静希。あそこのバイトは柔道部の連中でも音を上げるって話じゃんか」"
msgstr ""

#. Occurrence 1DOT5_4:761:1679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:761
msgctxt "text_id=1679 | speaker=soujuurou"
msgid "「……なんと。まさか、ネコクロの荷物運びより辛い？」"
msgstr ""

#. Occurrence 1DOT5_4:796:1680: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0013; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:796
msgctxt "text_id=1680 | speaker=kinomi"
msgid "「んー。いや、そこまではよく。"
msgstr ""

#. Occurrence 1DOT5_4:802:1681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0014; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:802
msgctxt "text_id=1681 | speaker=kinomi"
msgid "　しっかし山城のヤロウ遅ぇなあ。見ろ、となりのＢ組すらお帰りになられてるぞ」"
msgstr ""

#. Occurrence 1DOT5_4:808:1682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0004; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:808
msgctxt "text_id=1682 | speaker=tobimaru"
msgid "「だな。仕方ねえ、面倒だが呼んでくるか。草の字を遅刻させるワケにゃいかねえし」"
msgstr ""

#. Occurrence 1DOT5_4:851:1683: scene=1DOT5_4
#: 1DOT5_4:851
msgctxt "text_id=1683 | speaker=unknown"
msgid "　大儀そうにベランダの手すりから体を起こす槻司鳶丸と、"
msgstr ""

#. Occurrence 1DOT5_4:858:1684: scene=1DOT5_4
#: 1DOT5_4:858
msgctxt "text_id=1684 | speaker=unknown"
msgid "　狙いすましたように、ピンポンパン、と鳴り響く校内放送。"
msgstr ""

#. Occurrence 1DOT5_4:896:1685: voice_id=F30_1DOT5_4_0000_A; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:896
msgctxt "text_id=1685 | speaker=unknown"
msgid "『２年Ｃ組の静希草十郎くん。山城先生がお呼びです。至急、職員室まで来てください。繰り返します、２年Ｃ組の～』"
msgstr ""

#. Occurrence 1DOT5_4:920:1686: scene=1DOT5_4
#: 1DOT5_4:920
msgctxt "text_id=1686 | speaker=unknown"
msgid "　三人の間に気まずい沈黙。"
msgstr ""

#. Occurrence 1DOT5_4:925:1687: scene=1DOT5_4
#: 1DOT5_4:925
msgctxt "text_id=1687 | speaker=unknown"
msgid "　五秒ほどぼんやりしてから、草十郎はそれじゃあ、とふたりを残してベランダを後にした。"
msgstr ""

#. Occurrence 1DOT5_4:964:1688: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0015; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:964
msgctxt "text_id=1688 | speaker=kinomi"
msgid "「面白いコトねぇなあ。誰か、校庭にミステリーサークルとか作ってくんねぇかなあ」"
msgstr ""

#. Occurrence 1DOT5_4:970:1689: scene=1DOT5_4
#: 1DOT5_4:970
msgctxt "text_id=1689 | speaker=unknown"
msgid "　肩の力を抜きまくり、完全脱力人間になりながらぼやく木乃美。"
msgstr ""

#. Occurrence 1DOT5_4:1013:1690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0005; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1013
msgctxt "text_id=1690 | speaker=tobimaru"
msgid "「他人の妄想力に期待すんなよ。刺激が欲しいならテメエでイベント起こせ。ほら、クラス分け発表の時よろしく、蒼崎につっかかればすぐだぜ」"
msgstr ""

#. Occurrence 1DOT5_4:1060:1691: scene=1DOT5_4
#: 1DOT5_4:1060
msgctxt "text_id=1691 | speaker=unknown"
msgid "「ひいい、蘇るトラウマ！　やだよー、会長の<大立|おおた>ちまわりは<面白|おもしろ>いのを通りこして<恐|おそ>ろしいよー。"
msgstr ""

#. Occurrence 1DOT5_4:1072:1692: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0016_1; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1072
msgctxt "text_id=1692 | speaker=kinomi"
msgid "善良な一男子生徒としちゃあ、美少女が転校してくるだけでいいんだよー。"
msgstr ""

#. Occurrence 1DOT5_4:1083:1693: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0017; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1083
msgctxt "text_id=1693 | speaker=kinomi"
msgid "　んー、まあ、フツーの子じゃつまんないから、ハリウッドのプロデューサーとか、イギリスの歌姫とかー」"
msgstr ""

#. Occurrence 1DOT5_4:1114:1694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0006; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1114
msgctxt "text_id=1694 | speaker=tobimaru"
msgid "「どんな<括|くく>りだそりゃ。そこは火星のお姫さまあたりにしとけよ」"
msgstr ""

#. Occurrence 1DOT5_4:1137:1695: voice_id=F30_1DOT5_4_0001; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1137
msgctxt "text_id=1695 | speaker=unknown"
msgid "『それと、２年Ｃ組の皆さんへ、山城先生から伝言です。"
msgstr ""

#. Occurrence 1DOT5_4:1143:1696: voice_id=F30_1DOT5_4_0002; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1143
msgctxt "text_id=1696 | speaker=unknown"
msgid "“山城先生は訳あってＨＲを欠席しますので、各自、勝手に下校しちゃってくださいね。それではでは”"
msgstr ""

#. Occurrence 1DOT5_4:1149:1697: voice_id=F30_1DOT5_4_0003; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1149
msgctxt "text_id=1697 | speaker=unknown"
msgid "　以上、放送室からお知らせしました』"
msgstr ""

#. Occurrence 1DOT5_4:1175:1698: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0018; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1175
msgctxt "text_id=1698 | speaker=kinomi"
msgid "「……どうよコレ。山城、新車買ってからフリーダムすぎねえ？　このままではあの真新しいセルビアに、オレのギザ<十|じゅう>がうなりかねん」"
msgstr ""

#. Occurrence 1DOT5_4:1181:1699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0007; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1181
msgctxt "text_id=1699 | speaker=tobimaru"
msgid "「鍵穴にガム程度にしとけ。教師の薄給はマジ同情に値するからな」"
msgstr ""

#. Occurrence 1DOT5_4:1216:1700: scene=1DOT5_4
#: 1DOT5_4:1216
msgctxt "text_id=1700 | speaker=unknown"
msgid "　ぼやきながらも教室に戻る悪友ふたり。"
msgstr ""

#. Occurrence 1DOT5_4:1221:1701: scene=1DOT5_4
#: 1DOT5_4:1221
msgctxt "text_id=1701 | speaker=unknown"
msgid "　職員室に呼び出された友人の心配は、これっぽっちもしていなかった。"
msgstr ""

#. Occurrence 1DOT5_4:1267:1702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0000; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1267
msgctxt "text_id=1702 | speaker=aoko"
msgid "「納得いきません。生徒のアルバイトは認められています。"
msgstr ""

#. Occurrence 1DOT5_4:1273:1703: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1273
msgctxt "text_id=1703 | speaker=aoko"
msgid "　学校公認の職場であるなら、社会経験の一環として推奨する、と校則にもありますが」"
msgstr ""

#. Occurrence 1DOT5_4:1291:1704: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0000; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1291
msgctxt "text_id=1704 | speaker=yamashiro"
msgid "「そうなんだけどねえ。彼の場合、やりすぎなのが問題なワケで。"
msgstr ""

#. Occurrence 1DOT5_4:1298:1705: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0001; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1298
msgctxt "text_id=1705 | speaker=yamashiro"
msgid "仮に、もし認可していない、労働基準法に反してそうな所で働いてたら困るでしょ、<学校|うち>も彼も」"
msgstr ""

#. Occurrence 1DOT5_4:1329:1706: scene=1DOT5_4
#: 1DOT5_4:1329
msgctxt "text_id=1706 | speaker=unknown"
msgid "　<土曜日|ハンドン>の昼食を前に浮き足立つ職員室で、鬼の生徒会長となあなあ現国教師が危険な匂いをまき散らす。"
msgstr ""

#. Occurrence 1DOT5_4:1334:1707: scene=1DOT5_4
#: 1DOT5_4:1334
msgctxt "text_id=1707 | speaker=unknown"
msgid "　他の教師陣はくわばらくわばら、と会議室にそそくさ移動。"
msgstr ""

#. Occurrence 1DOT5_4:1339:1708: scene=1DOT5_4
#: 1DOT5_4:1339
msgctxt "text_id=1708 | speaker=unknown"
msgid "　山城教諭がおや？と気づいた時、職員室にいるのは彼と、生徒会長・蒼崎青子その人だけだった。"
msgstr ""

#. Occurrence 1DOT5_4:1372:1709: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0002; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1372
msgctxt "text_id=1709 | speaker=yamashiro"
msgid "「……逃げたか。ひどいなあみんな、怖いのは僕に押しつけてばっかりだもんなあ」"
msgstr ""

#. Occurrence 1DOT5_4:1390:1710: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0002; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1390
msgctxt "text_id=1710 | speaker=aoko"
msgid "「話の続きです、先生。"
msgstr ""

#. Occurrence 1DOT5_4:1396:1711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0003; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1396
msgctxt "text_id=1711 | speaker=aoko"
msgid "　仮に彼が指定以外のアルバイトをしているとしたら、それは彼の要求に学校側が応えていないからではありませんか？」"
msgstr ""

#. Occurrence 1DOT5_4:1422:1712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0004; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1422
msgctxt "text_id=1712 | speaker=aoko"
msgid "「下宿先の家賃を奨学金でまかなえとは言いませんが、時間の許すかぎり働きたい、という要望は考慮すべきです。"
msgstr ""

#. Occurrence 1DOT5_4:1433:1713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0005; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1433
msgctxt "text_id=1713 | speaker=aoko"
msgid "　指定外のアルバイトを疑うのなら、まず“働き先は一生徒につき一件だけ”という規則を改めてください」"
msgstr ""

#. Occurrence 1DOT5_4:1465:1714: scene=1DOT5_4
#: 1DOT5_4:1465
msgctxt "text_id=1714 | speaker=unknown"
msgid "　生徒会長の静かな語り口調に、これはどうあっても引いてくれないなあ、と山城教諭はうなだれる。"
msgstr ""

#. Occurrence 1DOT5_4:1495:1715: scene=1DOT5_4
#: 1DOT5_4:1495
msgctxt "text_id=1715 | speaker=unknown"
msgid "　事はもっと単純に済む筈だった。"
msgstr ""

#. Occurrence 1DOT5_4:1500:1716: scene=1DOT5_4
#: 1DOT5_4:1500
msgctxt "text_id=1716 | speaker=unknown"
msgid "『複数のアルバイトをしている』と噂をたてられた生徒を呼び出して事情を<訊|たず>ね、これが真実なら注意・指導し、世は全て事も無し、と昼食に向かう予定だったのだ。"
msgstr ""

#. Occurrence 1DOT5_4:1505:1717: scene=1DOT5_4
#: 1DOT5_4:1505
msgctxt "text_id=1717 | speaker=unknown"
msgid "　その話をたまたま職員室に来ていた生徒会長が聞きつけ、それはおかしい、と食いついてしまった。"
msgstr ""

#. Occurrence 1DOT5_4:1525:1718: scene=1DOT5_4
#: 1DOT5_4:1525
msgctxt "text_id=1718 | speaker=unknown"
msgid "　山城自身、生徒会長の意見はもっともだし、<件|くだん>の生徒の事情も理解している。"
msgstr ""

#. Occurrence 1DOT5_4:1530:1719: scene=1DOT5_4
#: 1DOT5_4:1530
msgctxt "text_id=1719 | speaker=unknown"
msgid "　個人的には応援してやりたいのだが、彼も悲しい新米教師。"
msgstr ""

#. Occurrence 1DOT5_4:1535:1720: scene=1DOT5_4
#: 1DOT5_4:1535
msgctxt "text_id=1720 | speaker=unknown"
msgid "　副教頭のご機嫌もうかがいたいし、薄給とはいえ職を失うのもよろしくない。"
msgstr ""

#. Occurrence 1DOT5_4:1574:1721: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0003; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1574
msgctxt "text_id=1721 | speaker=yamashiro"
msgid "「……こればかりはね。副教頭先生直々の注意なんで、僕も助けてあげられないんだよ」"
msgstr ""

#. Occurrence 1DOT5_4:1580:1722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0006; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1580
msgctxt "text_id=1722 | speaker=aoko"
msgid "「それでしたら、落としどころがあればいいんですね？」"
msgstr ""

#. Occurrence 1DOT5_4:1591:1723: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0004; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1591
msgctxt "text_id=1723 | speaker=yamashiro"
msgid "「うん？」"
msgstr ""

#. Occurrence 1DOT5_4:1612:1724: scene=1DOT5_4
#: 1DOT5_4:1612
msgctxt "text_id=1724 | speaker=unknown"
msgid "　生徒会長は鞄から一枚の書類を取り出した。"
msgstr ""

#. Occurrence 1DOT5_4:1617:1725: scene=1DOT5_4
#: 1DOT5_4:1617
msgctxt "text_id=1725 | speaker=unknown"
msgid "　今朝の職員会議でも取り上げられた、全教員の頭痛の種の一つである。"
msgstr ""

#. Occurrence 1DOT5_4:1643:1726: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0005; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1643
msgctxt "text_id=1726 | speaker=yamashiro"
msgid "「蒼崎くん、それは」"
msgstr ""

#. Occurrence 1DOT5_4:1665:1727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0007; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1665
msgctxt "text_id=1727 | speaker=aoko"
msgid "「はい。<合田|あいだ>教会のボランティア参加の申告書です。"
msgstr ""

#. Occurrence 1DOT5_4:1671:1728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0008; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1671
msgctxt "text_id=1728 | speaker=aoko"
msgid "　今月も希望者ゼロですね。敬虔なクリスチャンである副教頭先生は、さぞお気を悪くしているかと。"
msgstr ""

#. Occurrence 1DOT5_4:1677:1729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0009; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1677
msgctxt "text_id=1729 | speaker=aoko"
msgid "　我が校の生徒には信心が足りん、と、今朝も<嘆|なげ>かれていたとか？」"
msgstr ""

#. Occurrence 1DOT5_4:1710:1730: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0006; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1710
msgctxt "text_id=1730 | speaker=yamashiro"
msgid "「……そうだけど。どうして君が今朝の職員会議の内容を知っているか聞きたいよ、ホント」"
msgstr ""

#. Occurrence 1DOT5_4:1716:1731: scene=1DOT5_4
#: 1DOT5_4:1716
msgctxt "text_id=1731 | speaker=unknown"
msgid "　頭を掻く山城教諭だが、その目は楽しげに笑っている。"
msgstr ""

#. Occurrence 1DOT5_4:1721:1732: scene=1DOT5_4
#: 1DOT5_4:1721
msgctxt "text_id=1732 | speaker=unknown"
msgid "　生徒会長の狙いに合点がいったからだ。"
msgstr ""

#. Occurrence 1DOT5_4:1760:1733: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0007; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1760
msgctxt "text_id=1733 | speaker=yamashiro"
msgid "「<魚心|うおごころ>あれば<水心|みずごころ>あり、ですか。"
msgstr ""

#. Occurrence 1DOT5_4:1766:1734: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0008; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1766
msgctxt "text_id=1734 | speaker=yamashiro"
msgid "　教会への奉仕活動はボランティアだけど、きちんと謝礼がでる。あれもカタチの上では学校側が推奨する社会見学だからね。"
msgstr ""

#. Occurrence 1DOT5_4:1772:1735: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0009; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1772
msgctxt "text_id=1735 | speaker=yamashiro"
msgid "　副教頭先生は参加者がでた事に喜び、加えて、」"
msgstr ""

#. Occurrence 1DOT5_4:1809:1736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0010; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1809
msgctxt "text_id=1736 | speaker=aoko"
msgid "「その参加希望者が既に他のアルバイトに就いていた場合、学校側の認可が二つになっちゃいますね。"
msgstr ""

#. Occurrence 1DOT5_4:1815:1737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0011; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1815
msgctxt "text_id=1737 | speaker=aoko"
msgid "　前例にしては、いい落としどころだと思いますが」"
msgstr ""

#. Occurrence 1DOT5_4:1850:1738: scene=1DOT5_4
#: 1DOT5_4:1850
msgctxt "text_id=1738 | speaker=unknown"
msgid "　まいった、と手をあげる山城教諭。"
msgstr ""

#. Occurrence 1DOT5_4:1855:1739: scene=1DOT5_4
#: 1DOT5_4:1855
msgctxt "text_id=1739 | speaker=unknown"
msgid "　問題を告発しながらも、きちんと解決策を提案してくる生徒はそういない。"
msgstr ""

#. Occurrence 1DOT5_4:1860:1740: scene=1DOT5_4
#: 1DOT5_4:1860
msgctxt "text_id=1740 | speaker=unknown"
msgid "　この女生徒が恐れられながらも頼られているのは、この姉御肌なところによるものだろう。"
msgstr ""

#. Occurrence 1DOT5_4:1891:1741: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0010; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1891
msgctxt "text_id=1741 | speaker=yamashiro"
msgid "「よし、その方向で攻めてみよう。上手くいくよう祈ってくれよ」"
msgstr ""

#. Occurrence 1DOT5_4:1909:1742: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0012; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1909
msgctxt "text_id=1742 | speaker=aoko"
msgid "「他力本願は嫌いです。<悪巧|わるだく>みに乗ってくれるのなら、きちんと活躍してください、山城先生」"
msgstr ""

#. Occurrence 1DOT5_4:1919:1743: scene=1DOT5_4
#: 1DOT5_4:1919
msgctxt "text_id=1743 | speaker=unknown"
msgid "　それでは失礼します、と礼をして職員室を去る生徒会長。"
msgstr ""

#. Occurrence 1DOT5_4:1940:1744: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0011; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1940
msgctxt "text_id=1744 | speaker=yamashiro"
msgid "「あ、待った待った、君も残るんだ。"
msgstr ""

#. Occurrence 1DOT5_4:1947:1745: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0012; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1947
msgctxt "text_id=1745 | speaker=yamashiro"
msgid "今から静希くんを呼ぶから、ちゃんと面倒見てもらわないと」"
msgstr ""

#. Occurrence 1DOT5_4:1970:1746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0013; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1970
msgctxt "text_id=1746 | speaker=aoko"
msgid "「――――――は？」"
msgstr ""

#. Occurrence 1DOT5_4:1990:1747: scene=1DOT5_4
#: 1DOT5_4:1990
msgctxt "text_id=1747 | speaker=unknown"
msgid "　少女のクールな瞳が、きゅっと細くなる。"
msgstr ""

#. Occurrence 1DOT5_4:1995:1748: scene=1DOT5_4
#: 1DOT5_4:1995
msgctxt "text_id=1748 | speaker=unknown"
msgid "　いま、心底理解できない台詞を聞いたんだけど、と山城教諭を睨みつける。"
msgstr ""

#. Occurrence 1DOT5_4:2034:1749: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0013; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2034
msgctxt "text_id=1749 | speaker=yamashiro"
msgid "「いや、参加希望者は一人より二人の方がいいだろ。"
msgstr ""

#. Occurrence 1DOT5_4:2040:1750: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0014; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2040
msgctxt "text_id=1750 | speaker=yamashiro"
msgid "　蒼崎くんがフォローしてくれるなら僕も安心だしね」"
msgstr ""

#. Occurrence 1DOT5_4:2046:1751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0014; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2046
msgctxt "text_id=1751 | speaker=aoko"
msgid "「あの、ちょっと、先生」"
msgstr ""

#. Occurrence 1DOT5_4:2087:1752: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0015; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2087
msgctxt "text_id=1752 | speaker=yamashiro"
msgid "「あ、放送室？　２年Ｃ組の静希草十郎くん、至急職員室に来てください、で放送、お願いします」"
msgstr ""

#. Occurrence 1DOT5_4:2093:1753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0015; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2093
msgctxt "text_id=1753 | speaker=aoko"
msgid "「その、だから、先生」"
msgstr ""

#. Occurrence 1DOT5_4:2127:1754: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0016; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2127
msgctxt "text_id=1754 | speaker=yamashiro"
msgid "「いやあ、これで万全だ！　まさか頭痛のタネが同時に消え去るなんて、今日はついてる！"
msgstr ""

#. Occurrence 1DOT5_4:2134:1755: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0017; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2134
msgctxt "text_id=1755 | speaker=yamashiro"
msgid "　ああ、けど蒼崎くん、ずいぶん親身になってくれるんだね。なに、もしかしてああいうのがタイプ？　あ、放送室さん、ついでに生徒会長が心からお待ちしていますと付け足して―――」"
msgstr ""

#. Occurrence 1DOT5_4:2140:1756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0016; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2140
msgctxt "text_id=1756 | speaker=aoko"
msgid "「って、山城ォ―――！」"
msgstr ""

#. Occurrence 1DOT5_4:2251:1757: scene=1DOT5_4
#: 1DOT5_4:2251
msgctxt "text_id=1757 | speaker=unknown"
msgid "　翌日、気持ちのいい日曜日。"
msgstr ""

#. Occurrence 1DOT5_4:2257:1758: scene=1DOT5_4
#: 1DOT5_4:2257
msgctxt "text_id=1758 | speaker=unknown"
msgid "　草十郎は待ち合わせの時間より二時間早く目を覚ました。"
msgstr ""

#. Occurrence 1DOT5_4:2294:1759: scene=1DOT5_4
#: 1DOT5_4:2294
msgctxt "text_id=1759 | speaker=unknown"
msgid "　その後、気を落ち着けるためにジョギングがてらの散歩にでかけ、三十分で戻るつもりがあれこれ考えているうちに一時間近く経っている事に気づき、あわてて帰宅。"
msgstr ""

#. Occurrence 1DOT5_4:2299:1760: scene=1DOT5_4
#: 1DOT5_4:2299
msgctxt "text_id=1760 | speaker=unknown"
msgid "　何を着ていくものか考え抜いたあげく、結局、学校の制服で臨むことにした。"
msgstr ""

#. Occurrence 1DOT5_4:2333:1761: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0017; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2333
msgctxt "text_id=1761 | speaker=aoko"
msgid "“午前十時、三咲中央公園の東入り口で待ち合わせ”"
msgstr ""

#. Occurrence 1DOT5_4:2354:1762: scene=1DOT5_4
#: 1DOT5_4:2354
msgctxt "text_id=1762 | speaker=unknown"
msgid "　昨日の職員室。"
msgstr ""

#. Occurrence 1DOT5_4:2359:1763: scene=1DOT5_4
#: 1DOT5_4:2359
msgctxt "text_id=1763 | speaker=unknown"
msgid "　風邪気味だったのか、蒼崎青子は頭痛を押し殺すような顔でそう言った。"
msgstr ""

#. Occurrence 1DOT5_4:2394:1764: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0007; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2394
msgctxt "text_id=1764 | speaker=soujuurou"
msgid "「しかし、蒼崎の風邪は治っているのだろうか」"
msgstr ""

#. Occurrence 1DOT5_4:2400:1765: scene=1DOT5_4
#: 1DOT5_4:2400
msgctxt "text_id=1765 | speaker=unknown"
msgid "　草十郎はあさっての方向を見ながら、あさってを向いた心配ごとを呟く。"
msgstr ""

#. Occurrence 1DOT5_4:2405:1766: scene=1DOT5_4
#: 1DOT5_4:2405
msgctxt "text_id=1766 | speaker=unknown"
msgid "　ともあれ、そうして待つこと約五分。"
msgstr ""

#. Occurrence 1DOT5_4:2410:1767: scene=1DOT5_4
#: 1DOT5_4:2410
msgctxt "text_id=1767 | speaker=unknown"
msgid "　十時きっかりに生徒会長は登場した。"
msgstr ""

#. Occurrence 1DOT5_4:2445:1768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1768 | speaker=aoko"
msgid "「おはよ。"
msgstr ""

#. Occurrence 1DOT5_4:2445:1769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1769 | speaker=aoko"
msgid "　いつもの事だけど、時間だけはピッタリよね、貴方」"
msgstr ""

#. Occurrence 1DOT5_4:2463:1770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0008; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2463
msgctxt "text_id=1770 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 1DOT5_4:2483:1771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0019; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2483
msgctxt "text_id=1771 | speaker=aoko"
msgid "「ひどい顔ね。もしかして気分悪いの？」"
msgstr ""

#. Occurrence 1DOT5_4:2504:1772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0009; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2504
msgctxt "text_id=1772 | speaker=soujuurou"
msgid "「いや、体調はいいと思う」"
msgstr ""

#. Occurrence 1DOT5_4:2509:1773: scene=1DOT5_4
#: 1DOT5_4:2509
msgctxt "text_id=1773 | speaker=unknown"
msgid "　しんぱいごむよう、と軽く弁明する草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:2515:1774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0010; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2515
msgctxt "text_id=1774 | speaker=soujuurou"
msgid "「だがしかし、蒼崎は制服だった」"
msgstr ""

#. Occurrence 1DOT5_4:2526:1775: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0020; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2526
msgctxt "text_id=1775 | speaker=aoko"
msgid "「ええ。学校の行事だもの、当然でしょう？」"
msgstr ""

#. Occurrence 1DOT5_4:2532:1776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2532
msgctxt "text_id=1776 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 1DOT5_4:2566:1777: scene=1DOT5_4
#: 1DOT5_4:2566
msgctxt "text_id=1777 | speaker=unknown"
msgid "　がっくりと肩に重みを感じる草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:2571:1778: scene=1DOT5_4
#: 1DOT5_4:2571
msgctxt "text_id=1778 | speaker=unknown"
msgid "　朝から<益体|やくたい>もなく浮き足立っていた二時間は、こうして容赦なく台無しにされた。"
msgstr ""

#. Occurrence 1DOT5_4:2636:1779: scene=1DOT5_4
#: 1DOT5_4:2636
msgctxt "text_id=1779 | speaker=unknown"
msgid "　休日の駅前を、制服姿の男女が歩く。"
msgstr ""

#. Occurrence 1DOT5_4:2641:1780: scene=1DOT5_4
#: 1DOT5_4:2641
msgctxt "text_id=1780 | speaker=unknown"
msgid "　はじめは丁寧に街の案内をしていた青子だが、今は必要最低限の説明だけにとどめている。"
msgstr ""

#. Occurrence 1DOT5_4:2673:1781: scene=1DOT5_4
#: 1DOT5_4:2673
msgctxt "text_id=1781 | speaker=unknown"
msgid "　草十郎が思いのほか町に詳しくなっていた事もあるが、"
msgstr ""

#. Occurrence 1DOT5_4:2678:1782: scene=1DOT5_4
#: 1DOT5_4:2678
msgctxt "text_id=1782 | speaker=unknown"
msgid "　やれここのゴハンがおいしいだの、"
msgstr ""

#. Occurrence 1DOT5_4:2683:1783: scene=1DOT5_4
#: 1DOT5_4:2683
msgctxt "text_id=1783 | speaker=unknown"
msgid "　急いでる時はこっちが近道だの、自転車を買うなら駅前デパートよりあっちの専門店のがいいだの、"
msgstr ""

#. Occurrence 1DOT5_4:2693:1784: scene=1DOT5_4
#: 1DOT5_4:2693
msgctxt "text_id=1784 | speaker=unknown"
msgid "　そんな会話をしている時、ハタと冷静に、今の状況が第三者的にどう見えるかに気付いたからだ。"
msgstr ""

#. Occurrence 1DOT5_4:2729:1785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0012; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2729
msgctxt "text_id=1785 | speaker=soujuurou"
msgid "「話は変わるけど。具体的にどんな労働内容なのか、そろそろ聞いていいかな」"
msgstr ""

#. Occurrence 1DOT5_4:2749:1786: scene=1DOT5_4
#: 1DOT5_4:2749
msgctxt "text_id=1786 | speaker=unknown"
msgid "　教会の奉仕作業に参加すれば、今後、アルバイトの<掛|か>け<持|も>ちを大目にみてあげられる―――"
msgstr ""

#. Occurrence 1DOT5_4:2754:1787: scene=1DOT5_4
#: 1DOT5_4:2754
msgctxt "text_id=1787 | speaker=unknown"
msgid "　そんな甘い誘いにコクコクと頷いた草十郎だが、例によって例の如く、どんな作業なのか考えてもいないようだ。"
msgstr ""

#. Occurrence 1DOT5_4:2787:1788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0021; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2787
msgctxt "text_id=1788 | speaker=aoko"
msgid "「……まあ、そんなコトだろうと覚悟はしてたけど。"
msgstr ""

#. Occurrence 1DOT5_4:2793:1789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0022; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2793
msgctxt "text_id=1789 | speaker=aoko"
msgid "　貴方、<合田|あいだ>教会は初めて？」"
msgstr ""

#. Occurrence 1DOT5_4:2799:1790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0013; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2799
msgctxt "text_id=1790 | speaker=soujuurou"
msgid "「教会なら二回目だ。珍しい建物なんで近寄ったら、中の人がタダでお菓子をくれたんだけど……」"
msgstr ""

#. Occurrence 1DOT5_4:2836:1791: scene=1DOT5_4
#: 1DOT5_4:2836
msgctxt "text_id=1791 | speaker=unknown"
msgid "　どういう仕組みなんだろう、と草十郎は真剣に考えこんでいる。"
msgstr ""

#. Occurrence 1DOT5_4:2841:1792: scene=1DOT5_4
#: 1DOT5_4:2841
msgctxt "text_id=1792 | speaker=unknown"
msgid "　うつむく仕草は哲学者のソレだが、しょせん、"
msgstr ""

#. Occurrence 1DOT5_4:2847:1793: scene=1DOT5_4
#: 1DOT5_4:2847
msgctxt "text_id=1793 | speaker=unknown"
msgid "“やっぱり二回目からはお金をとられるのだろうか？”"
msgstr ""

#. Occurrence 1DOT5_4:2853:1794: scene=1DOT5_4
#: 1DOT5_4:2853
msgctxt "text_id=1794 | speaker=unknown"
msgid "　程度の悩みである。"
msgstr ""

#. Occurrence 1DOT5_4:2888:1795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0023; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2888
msgctxt "text_id=1795 | speaker=aoko"
msgid "「……普通、そういうコトは子供にしかしないんだけどね、あの教会は」"
msgstr ""

#. Occurrence 1DOT5_4:2894:1796: scene=1DOT5_4
#: 1DOT5_4:2894
msgctxt "text_id=1796 | speaker=unknown"
msgid "　よっぽど迷える子羊に見えたんだろう、とため息をつく青子。"
msgstr ""

#. Occurrence 1DOT5_4:2928:1797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0024; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2928
msgctxt "text_id=1797 | speaker=aoko"
msgid "「で、どんな人にあったの？　神父、それともシスター？」"
msgstr ""

#. Occurrence 1DOT5_4:2934:1798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0014; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2934
msgctxt "text_id=1798 | speaker=soujuurou"
msgid "「それはそれは、綺麗な女の人だった」"
msgstr ""

#. Occurrence 1DOT5_4:2955:1799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0025; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2955
msgctxt "text_id=1799 | speaker=aoko"
msgid "「じゃあ<唯架|ゆいか>さんの方ね。今日会ったらお礼を……って、必要ないか。アンタの事だから、そのあたりはキチッとしてるだろうし」"
msgstr ""

#. Occurrence 1DOT5_4:2961:1800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0015; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2961
msgctxt "text_id=1800 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 1DOT5_4:2988:1801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0026; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2988
msgctxt "text_id=1801 | speaker=aoko"
msgid "「仕事の話なら簡単よ。学校でやってる事と変わらないから。"
msgstr ""

#. Occurrence 1DOT5_4:2995:1802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0027; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2995
msgctxt "text_id=1802 | speaker=aoko"
msgid "あの教会、規模のわりに人数が少ないのよ」"
msgstr ""

#. Occurrence 1DOT5_4:3015:1803: scene=1DOT5_4
#: 1DOT5_4:3015
msgctxt "text_id=1803 | speaker=unknown"
msgid "　早足で教会に向かう青子。"
msgstr ""

#. Occurrence 1DOT5_4:3020:1804: scene=1DOT5_4
#: 1DOT5_4:3020
msgctxt "text_id=1804 | speaker=unknown"
msgid "　なんだか敵地に向かう鬼将軍のようだ、と草十郎は不安げに眉を曇らせた。"
msgstr ""

#. Occurrence 1DOT5_4:3067:1805: scene=1DOT5_4
#: 1DOT5_4:3067
msgctxt "text_id=1805 | speaker=unknown"
msgid "　合田教会は古い歴史を持つ教会だ。"
msgstr ""

#. Occurrence 1DOT5_4:3072:1806: scene=1DOT5_4
#: 1DOT5_4:3072
msgctxt "text_id=1806 | speaker=unknown"
msgid "　駅から離れた、オフィス街と住宅地の<狭間|はざま>に建てられた白い聖域。"
msgstr ""

#. Occurrence 1DOT5_4:3077:1807: scene=1DOT5_4
#: 1DOT5_4:3077
msgctxt "text_id=1807 | speaker=unknown"
msgid "　青子の知るかぎり、たしか八年ほど前に今のカタチに改装された、こんな田舎町には十分すぎるほどの大教会である。"
msgstr ""

#. Occurrence 1DOT5_4:3110:1808: scene=1DOT5_4
#: 1DOT5_4:3110
msgctxt "text_id=1808 | speaker=unknown"
msgid "　ちなみに横にあるのは三咲市一の総合病院。"
msgstr ""

#. Occurrence 1DOT5_4:3115:1809: scene=1DOT5_4
#: 1DOT5_4:3115
msgctxt "text_id=1809 | speaker=unknown"
msgid "　青子からすれば、町で一番多くの命が失われる場所の隣にちゃっかり居を構える時点で信用ならない―――のだが、その所感を知るのは同居人である久遠寺有珠と、教会の神父だけに留まっている。"
msgstr ""

#. Occurrence 1DOT5_4:3147:1810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0016; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3147
msgctxt "text_id=1810 | speaker=soujuurou"
msgid "「蒼崎はこの教会に<縁|えん>があるのか？」"
msgstr ""

#. Occurrence 1DOT5_4:3158:1811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0028; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3158
msgctxt "text_id=1811 | speaker=aoko"
msgid "「私？　私はこれっぽっちも、もう過去に戻って<改竄|かいざん>したいぐらい微塵もないけど、うちの父と祖父は長い付き合い。"
msgstr ""

#. Occurrence 1DOT5_4:3169:1812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0029; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3169
msgctxt "text_id=1812 | speaker=aoko"
msgid "　ここの手伝いなんて、忌々しいコトに小学生の頃は毎日してたもんだけど―――」"
msgstr ""

#. Occurrence 1DOT5_4:3195:1813: scene=1DOT5_4
#: 1DOT5_4:3195
msgctxt "text_id=1813 | speaker=unknown"
msgid "　話せば話すほど、青子の表情は凶悪になっていく。"
msgstr ""

#. Occurrence 1DOT5_4:3200:1814: scene=1DOT5_4
#: 1DOT5_4:3200
msgctxt "text_id=1814 | speaker=unknown"
msgid "　忘れがたいトラウマと向き合い、胸ぐらを掴み、豪快に一本背負いをかまして脳天を地面にたたきつけたあと、無防備な胴体にローキックを食らわせる―――"
msgstr ""

#. Occurrence 1DOT5_4:3205:1815: scene=1DOT5_4
#: 1DOT5_4:3205
msgctxt "text_id=1815 | speaker=unknown"
msgid "　トラウマとやらが擬人化していれば、その程度の報復行為を軽く五セットはこなしそうな、それはそれは凄まじい気炎をあげるのだった。"
msgstr ""

#. Occurrence 1DOT5_4:3240:1816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0017; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3240
msgctxt "text_id=1816 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 1DOT5_4:3246:1817: scene=1DOT5_4
#: 1DOT5_4:3246
msgctxt "text_id=1817 | speaker=unknown"
msgid "　そんな青子の不機嫌っぷりに、草十郎が我が身の危険を感じだした頃。"
msgstr ""

#. Occurrence 1DOT5_4:3252:1818: scene=1DOT5_4
#: 1DOT5_4:3252
msgctxt "text_id=1818 | speaker=unknown"
msgid "　教会の上空にバサバサ集まりだしたカラスに惹かれたのか、"
msgstr ""

msgctxt "text_id=1819 | speaker=unknown"
msgid "正面玄関から<修道女|シスター>服の女性が姿を見せた。"
msgstr ""

#. Occurrence 1DOT5_4:3288:1820: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0000; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3288
msgctxt "text_id=1820 | speaker=yuika"
msgid "「失礼ですが、どちらのお客様でしょう。"
msgstr ""

#. Occurrence 1DOT5_4:3294:1821: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0001; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3294
msgctxt "text_id=1821 | speaker=yuika"
msgid "　当教会は暴力団関係の方はご遠慮いただいておりますので、日を<改|あらた>める、<或|ある>いは生き方を<悔|く>い改めた後、社会的な罪を<償|つぐな>ってから門をくぐって頂きたいのですが―――」"
msgstr ""

#. Occurrence 1DOT5_4:3300:1822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0030; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3300
msgctxt "text_id=1822 | speaker=aoko"
msgid "「蒼崎青子です、シスター唯架」"
msgstr ""

#. Occurrence 1DOT5_4:3333:1823: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0002; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3333
msgctxt "text_id=1823 | speaker=yuika"
msgid "「まあ―――青子さんでしたか。"
msgstr ""

#. Occurrence 1DOT5_4:3339:1824: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0003; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3339
msgctxt "text_id=1824 | speaker=yuika"
msgid "　驚きました。昼間のうちに貴女が来るのは久しぶりです」"
msgstr ""

#. Occurrence 1DOT5_4:3357:1825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0031; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3357
msgctxt "text_id=1825 | speaker=aoko"
msgid "「そうですね。いつもは夜に呼ばれて、神父さまとだけお話をしていますから。唯架さんとは……"
msgstr ""

#. Occurrence 1DOT5_4:3363:1826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0032; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3363
msgctxt "text_id=1826 | speaker=aoko"
msgid "　まあ。意外ですね、一年近く<ま|・><と|・><も|・>にお話をしていません。"
msgstr ""

#. Occurrence 1DOT5_4:3376:1827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0033; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3376
msgctxt "text_id=1827 | speaker=aoko"
msgid "ま、この先だって一度もないでしょうけど」"
msgstr ""

#. Occurrence 1DOT5_4:3414:1828: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0004; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3414
msgctxt "text_id=1828 | speaker=yuika"
msgid "「ええ。貴女もずいぶんと立派になられたようで、ガッカリです。なにより、今の気配は清らかな少女とは思えないほど<悪辣|あくらつ>でした」"
msgstr ""

#. Occurrence 1DOT5_4:3420:1829: scene=1DOT5_4
#: 1DOT5_4:3420
msgctxt "text_id=1829 | speaker=unknown"
msgid "　表向き、和気あいあいと挨拶を交わすふたり。"
msgstr ""

#. Occurrence 1DOT5_4:3425:1830: scene=1DOT5_4
#: 1DOT5_4:3425
msgctxt "text_id=1830 | speaker=unknown"
msgid "　そのピリピリした空気をまったく読めず、仲がいいなあ、と見守る草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:3462:1831: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0034; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3462
msgctxt "text_id=1831 | speaker=aoko"
msgid "「今月のボランティアは私とそこの彼です。"
msgstr ""

#. Occurrence 1DOT5_4:3468:1832: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0035; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3468
msgctxt "text_id=1832 | speaker=aoko"
msgid "　親愛なる合田教会のためですから。十時から三時まで、一分の狂いもなく、きっかり働かせていただきますわ」"
msgstr ""

#. Occurrence 1DOT5_4:3486:1833: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0005; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3486
msgctxt "text_id=1833 | speaker=yuika"
msgid "「まあ。世も末ですが歓迎しますね。"
msgstr ""

#. Occurrence 1DOT5_4:3492:1834: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0006; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3492
msgctxt "text_id=1834 | speaker=yuika"
msgid "　神の家は万人に等しく開くもの。この際、貴女の内面は見なかった事にしておきましょう」"
msgstr ""

#. Occurrence 1DOT5_4:3512:1835: scene=1DOT5_4
#: 1DOT5_4:3512
msgctxt "text_id=1835 | speaker=unknown"
msgid "　上品に、しかし酷薄に微笑むシスター。"
msgstr ""

#. Occurrence 1DOT5_4:3517:1836: scene=1DOT5_4
#: 1DOT5_4:3517
msgctxt "text_id=1836 | speaker=unknown"
msgid "　表向きはどうあれ、労働力が手に入ったのは喜ばしい事らしい。"
msgstr ""

#. Occurrence 1DOT5_4:3565:1837: scene=1DOT5_4
#: 1DOT5_4:3565
msgctxt "text_id=1837 | speaker=unknown"
msgid "　シスターは<周|す><瀬|せ><唯架|ゆいか>と名乗り、自ら奉仕活動を希望した草十郎に礼を述べた。"
msgstr ""

#. Occurrence 1DOT5_4:3570:1838: scene=1DOT5_4
#: 1DOT5_4:3570
msgctxt "text_id=1838 | speaker=unknown"
msgid "　彼女の閉じた目に気づいていた草十郎だったが、青子の手前もあるし、なにより失礼な事かもしれない、と質問は遠慮した。"
msgstr ""

#. Occurrence 1DOT5_4:3605:1839: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0007; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3605
msgctxt "text_id=1839 | speaker=yuika"
msgid "「静希さんと仰るのですね。"
msgstr ""

#. Occurrence 1DOT5_4:3611:1840: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0008; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3611
msgctxt "text_id=1840 | speaker=yuika"
msgid "　声のイメージ通り、落ち着いたお名前です」"
msgstr ""

#. Occurrence 1DOT5_4:3617:1841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0018; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3617
msgctxt "text_id=1841 | speaker=soujuurou"
msgid "「はあ。それはどうも」"
msgstr ""

#. Occurrence 1DOT5_4:3623:1842: scene=1DOT5_4
#: 1DOT5_4:3623
msgctxt "text_id=1842 | speaker=unknown"
msgid "　名前を誉められてもいまいち実感の湧かない草十郎に、シスターはわずかに顔を曇らせる。"
msgstr ""

#. Occurrence 1DOT5_4:3651:1843: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0009; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3651
msgctxt "text_id=1843 | speaker=yuika"
msgid "「失礼、名字で呼ばれるのはお嫌いのようですね。"
msgstr ""

#. Occurrence 1DOT5_4:3657:1844: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0010; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3657
msgctxt "text_id=1844 | speaker=yuika"
msgid "　草十郎さん、でよろしいですか？」"
msgstr ""

#. Occurrence 1DOT5_4:3677:1845: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0019; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3677
msgctxt "text_id=1845 | speaker=soujuurou"
msgid "「え、いや、どっちでも、いいですけど」"
msgstr ""

#. Occurrence 1DOT5_4:3710:1846: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0011; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3710
msgctxt "text_id=1846 | speaker=yuika"
msgid "「ではそのように。……本当、難儀なことですね」"
msgstr ""

#. Occurrence 1DOT5_4:3716:1847: scene=1DOT5_4
#: 1DOT5_4:3716
msgctxt "text_id=1847 | speaker=unknown"
msgid "　口調こそ穏やかだが、シスターの言葉はどこか冷淡だ。"
msgstr ""

#. Occurrence 1DOT5_4:3721:1848: scene=1DOT5_4
#: 1DOT5_4:3721
msgctxt "text_id=1848 | speaker=unknown"
msgid "　視界を閉ざしている彼女だが、確かな足取りで青子たちを先導する。"
msgstr ""

#. Occurrence 1DOT5_4:3764:1849: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0012; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3764
msgctxt "text_id=1849 | speaker=yuika"
msgid "「それで、奉仕の内容ですが」"
msgstr ""

#. Occurrence 1DOT5_4:3776:1850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0036; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3776
msgctxt "text_id=1850 | speaker=aoko"
msgid "「分かってます。クリスマス前だし、面倒な掃除を済ませておきたいんでしょう？"
msgstr ""

#. Occurrence 1DOT5_4:3782:1851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0037; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3782
msgctxt "text_id=1851 | speaker=aoko"
msgid "　問題ありません、そういうの得意ですから」"
msgstr ""

#. Occurrence 1DOT5_4:3788:1852: scene=1DOT5_4
#: 1DOT5_4:3788
msgctxt "text_id=1852 | speaker=unknown"
msgid "　青子ではなく、おもに連れの草十郎がであるが。"
msgstr ""

#. Occurrence 1DOT5_4:3828:1853: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0013; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3828
msgctxt "text_id=1853 | speaker=yuika"
msgid "「……。では青子さんは<竈|かまど>の方で、<聖餅|せいへい>の作り置きを。"
msgstr ""

#. Occurrence 1DOT5_4:3835:1854: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_0; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3835
msgctxt "text_id=1854 | speaker=yuika"
msgid "　静希さんは外に。"
msgstr ""

#. Occurrence 1DOT5_4:3847:1855: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_1; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3847
msgctxt "text_id=1855 | speaker=yuika"
msgid "私どもでは手の届かない箇所の清掃をお願いします」"
msgstr ""

#. Occurrence 1DOT5_4:3859:1856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0038; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3859
msgctxt "text_id=1856 | speaker=aoko"
msgid "「ちょっと待って。台所に<律架|りつか>のヤツ、いないでしょうね？　こんな所であんなのに会うなんてゴメンだから」"
msgstr ""

#. Occurrence 1DOT5_4:3872:1857: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0015; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3872
msgctxt "text_id=1857 | speaker=yuika"
msgid "「律架は留守です。ですので、どうぞ気兼ねなく」"
msgstr ""

#. Occurrence 1DOT5_4:3898:1858: scene=1DOT5_4
#: 1DOT5_4:3898
msgctxt "text_id=1858 | speaker=unknown"
msgid "　はいはい、と手を振って、青子は礼拝堂奥のドアに向かっていった。"
msgstr ""

#. Occurrence 1DOT5_4:3903:1859: scene=1DOT5_4
#: 1DOT5_4:3903
msgctxt "text_id=1859 | speaker=unknown"
msgid "　公言通り、この教会には慣れきっているようだ。"
msgstr ""

#. Occurrence 1DOT5_4:3942:1860: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0016; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3942
msgctxt "text_id=1860 | speaker=yuika"
msgid "「静希さんはこちらに。"
msgstr ""

#. Occurrence 1DOT5_4:3948:1861: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0017; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3948
msgctxt "text_id=1861 | speaker=yuika"
msgid "　まずは物置から、清掃道具を運んでいただきます」"
msgstr ""

#. Occurrence 1DOT5_4:4006:1862: scene=1DOT5_4
#: 1DOT5_4:4006
msgctxt "text_id=1862 | speaker=unknown"
msgid "　草十郎に託された仕事は、これといって特殊な技術を必要としない、いたって普通の窓拭きだった。"
msgstr ""

#. Occurrence 1DOT5_4:4027:1863: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0020; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4027
msgctxt "text_id=1863 | speaker=soujuurou"
msgid "「窓を全部拭けばいいんですね？」"
msgstr ""

#. Occurrence 1DOT5_4:4033:1864: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0018; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4033
msgctxt "text_id=1864 | speaker=yuika"
msgid "「水拭きとから拭き、その後にコートスプレーもお願いします。ハシゴの高さは足りますか？」"
msgstr ""

#. Occurrence 1DOT5_4:4039:1865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0021; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4039
msgctxt "text_id=1865 | speaker=soujuurou"
msgid "「あれ。ちょっと足りないっぽいですね」"
msgstr ""

#. Occurrence 1DOT5_4:4045:1866: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0019; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4045
msgctxt "text_id=1866 | speaker=yuika"
msgid "「では届く範囲で結構ですので、よろしくお願いします」"
msgstr ""

#. Occurrence 1DOT5_4:4092:1867: scene=1DOT5_4
#: 1DOT5_4:4092
msgctxt "text_id=1867 | speaker=unknown"
msgid "　そんな簡潔なやりとりをして、シスターは教会に戻ってしまった。"
msgstr ""

#. Occurrence 1DOT5_4:4097:1868: scene=1DOT5_4
#: 1DOT5_4:4097
msgctxt "text_id=1868 | speaker=unknown"
msgid "　よほど草十郎を信頼しているのか、もともとドライな性格なのか。"
msgstr ""

#. Occurrence 1DOT5_4:4102:1869: scene=1DOT5_4
#: 1DOT5_4:4102
msgctxt "text_id=1869 | speaker=unknown"
msgid "　初対面で判断がつく筈もなし、そもそも草十郎にそんな詮索ができる筈もなし。"
msgstr ""

#. Occurrence 1DOT5_4:4113:1870: scene=1DOT5_4
#: 1DOT5_4:4113
msgctxt "text_id=1870 | speaker=unknown"
msgid "　ぽつんと独り放置されても腐ることなく、草十郎は窓拭きを開始した。"
msgstr ""

#. Occurrence 1DOT5_4:4162:1871: scene=1DOT5_4
#: 1DOT5_4:4162
msgctxt "text_id=1871 | speaker=unknown"
msgid "　今日も天候は思わしくない。"
msgstr ""

#. Occurrence 1DOT5_4:4167:1872: scene=1DOT5_4
#: 1DOT5_4:4167
msgctxt "text_id=1872 | speaker=unknown"
msgid "　雨が降る程ではないが太陽も見えないハンパな天気だ。"
msgstr ""

#. Occurrence 1DOT5_4:4172:1873: scene=1DOT5_4
#: 1DOT5_4:4172
msgctxt "text_id=1873 | speaker=unknown"
msgid "　高いハシゴに腰をかけて、高さにして五メートル近い窓をのどかに掃除する。"
msgstr ""

#. Occurrence 1DOT5_4:4177:1874: scene=1DOT5_4
#: 1DOT5_4:4177
msgctxt "text_id=1874 | speaker=unknown"
msgid "　草十郎は肉体労働が苦にならない人柄なので、これで空が真っ青であったら、それだけで素晴らしい休日になったかもしれない。"
msgstr ""

#. Occurrence 1DOT5_4:4212:1875: scene=1DOT5_4
#: 1DOT5_4:4212
msgctxt "text_id=1875 | speaker=unknown"
msgid "　三枚目、四枚目、と仕上げていくうちに気が<緩|ゆる>み、口笛など吹きつつ窓を拭く。"
msgstr ""

#. Occurrence 1DOT5_4:4217:1876: scene=1DOT5_4
#: 1DOT5_4:4217
msgctxt "text_id=1876 | speaker=unknown"
msgid "　五メートル近い高さは怖くはあるが、同時に絶景でもあった。"
msgstr ""

#. Occurrence 1DOT5_4:4222:1877: scene=1DOT5_4
#: 1DOT5_4:4222
msgctxt "text_id=1877 | speaker=unknown"
msgid "　ふと町の方に目を向ければ、引っ越してきてからずっと気になっていた、緑の丘が見てとれる。"
msgstr ""

#. Occurrence 1DOT5_4:4252:1878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0022; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4252
msgctxt "text_id=1878 | speaker=soujuurou"
msgid "「やっぱり、林の中に家があるような……」"
msgstr ""

#. Occurrence 1DOT5_4:4258:1879: scene=1DOT5_4
#: 1DOT5_4:4258
msgctxt "text_id=1879 | speaker=unknown"
msgid "　三咲町のはずれにある丘と森。"
msgstr ""

#. Occurrence 1DOT5_4:4263:1880: scene=1DOT5_4
#: 1DOT5_4:4263
msgctxt "text_id=1880 | speaker=unknown"
msgid "　眠らない町を見下ろす森は、ここから見ると異国の城塞のようだ。"
msgstr ""

#. Occurrence 1DOT5_4:4285:1881: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0000; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4285
msgctxt "text_id=1881 | speaker=ritsuka"
msgid "「あれ？　なになに、ドロボウさんー？」"
msgstr ""

#. Occurrence 1DOT5_4:4291:1882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0023; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4291
msgctxt "text_id=1882 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 1DOT5_4:4324:1883: scene=1DOT5_4
#: 1DOT5_4:4324
msgctxt "text_id=1883 | speaker=unknown"
msgid "　―――と。"
msgstr ""

#. Occurrence 1DOT5_4:4329:1884: scene=1DOT5_4
#: 1DOT5_4:4329
msgctxt "text_id=1884 | speaker=unknown"
msgid "　物思いにふけりながらもセッセと腕を動かしていた草十郎の眼下で、トコトコと人の気配。"
msgstr ""

#. Occurrence 1DOT5_4:4334:1885: scene=1DOT5_4
#: 1DOT5_4:4334
msgctxt "text_id=1885 | speaker=unknown"
msgid "　視線を下げると、そこには一見して人の良さそうな、それでいてだらしなさそうな、女性の姿があった。"
msgstr ""

#. Occurrence 1DOT5_4:4366:1886: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0001; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4366
msgctxt "text_id=1886 | speaker=ritsuka"
msgid "「ん、でもちょっと怪盗には似合わないのんびり屋さん風味。どっちかって言うと、あれかしら。暖炉から現れては微妙に要らないオモチャを押しつける<聖者|セイント>、みたいな。"
msgstr ""

#. Occurrence 1DOT5_4:4377:1887: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0002; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4377
msgctxt "text_id=1887 | speaker=ritsuka"
msgid "　うわあ……わたし、あのヒゲ苦手なのよねぇ……だってどう見ても不法侵入者じゃない、あの人？」"
msgstr ""

#. Occurrence 1DOT5_4:4414:1888: scene=1DOT5_4
#: 1DOT5_4:4414
msgctxt "text_id=1888 | speaker=unknown"
msgid "　年齢は二十代後半、だろうか。"
msgstr ""

#. Occurrence 1DOT5_4:4419:1889: scene=1DOT5_4
#: 1DOT5_4:4419
msgctxt "text_id=1889 | speaker=unknown"
msgid "　この寒さで上着を羽織っておらず、バッグらしきものも持っていない。草十郎はまだ知りえないコトだが、大人の女性とバッグはワンセットの存在である。"
msgstr ""

#. Occurrence 1DOT5_4:4424:1890: scene=1DOT5_4
#: 1DOT5_4:4424
msgctxt "text_id=1890 | speaker=unknown"
msgid "　そのあたりを無視しているあたり、この女性の自由奔放さが<窺|うかが>える。"
msgstr ""

#. Occurrence 1DOT5_4:4430:1891: scene=1DOT5_4
#: 1DOT5_4:4430
msgctxt "text_id=1891 | speaker=unknown"
msgid "抜けている、とも言う。"
msgstr ""

#. Occurrence 1DOT5_4:4471:1892: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0003; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4471
msgctxt "text_id=1892 | speaker=ritsuka"
msgid "「あ。わたし、ピーンと来たわ。"
msgstr ""

#. Occurrence 1DOT5_4:4477:1893: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0004; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4477
msgctxt "text_id=1893 | speaker=ritsuka"
msgid "　キミ、ミサ高のバイトの子？　偉いわ、今時の高校生は業者さん顔負けなのね！」"
msgstr ""

#. Occurrence 1DOT5_4:4483:1894: scene=1DOT5_4
#: 1DOT5_4:4483
msgctxt "text_id=1894 | speaker=unknown"
msgid "　ハシゴの頂点に座った草十郎を見上げて、女性は感動しきっている。"
msgstr ""

#. Occurrence 1DOT5_4:4509:1895: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0005; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4509
msgctxt "text_id=1895 | speaker=ritsuka"
msgid "「よーし、わたしも手伝っちゃおうかな！"
msgstr ""

#. Occurrence 1DOT5_4:4515:1896: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0006; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4515
msgctxt "text_id=1896 | speaker=ritsuka"
msgid "　ハシゴはまだある？　他の<雑巾|ぞうきん>は？　あ、どうせだからホースで水をかけるのはどうかしら！　こうバアーっと、けるひゃー！とか叫びながら！　バチあたりだけど、それなら少しぐらいは楽しくなりそうじゃない？」"
msgstr ""

#. Occurrence 1DOT5_4:4549:1897: scene=1DOT5_4
#: 1DOT5_4:4549
msgctxt "text_id=1897 | speaker=unknown"
msgid "　心底から楽しそうに女性は笑った。"
msgstr ""

#. Occurrence 1DOT5_4:4554:1898: scene=1DOT5_4
#: 1DOT5_4:4554
msgctxt "text_id=1898 | speaker=unknown"
msgid "　光がこぼれそうな、自立して走りまわるサボテンみたいな笑顔だった。"
msgstr ""

#. Occurrence 1DOT5_4:4560:1899: scene=1DOT5_4
#: 1DOT5_4:4560
msgctxt "text_id=1899 | speaker=unknown"
msgid "はた迷惑という意味だった。"
msgstr ""

#. Occurrence 1DOT5_4:4567:1900: scene=1DOT5_4
#: 1DOT5_4:4567
msgctxt "text_id=1900 | speaker=unknown"
msgid "　そんな草十郎の連想通り、女性は草十郎の返事を待たず、まあまあ、と窓拭きに参加した。"
msgstr ""

#. Occurrence 1DOT5_4:4632:1901: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0007; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4632
msgctxt "text_id=1901 | speaker=ritsuka"
msgid "「いえ、教会の前を通ったら、人影っぽいのが窓にへばりついてるのが見えちゃったの。昼間っから泥棒とか豪快だなあって、ちょっと興味ひかれちゃって。"
msgstr ""

#. Occurrence 1DOT5_4:4638:1902: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0008; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4638
msgctxt "text_id=1902 | speaker=ritsuka"
msgid "　そしたら可愛い子が真面目に労働してたワケ。窓拭きの達人みたいに、ビっと格好よく。そんなの見せられたら手伝いたくなるのが人情じゃない？」"
msgstr ""

#. Occurrence 1DOT5_4:4658:1903: scene=1DOT5_4
#: 1DOT5_4:4658
msgctxt "text_id=1903 | speaker=unknown"
msgid "　草十郎のひとつ隣の窓を拭きながら、女性は陽気に話しかけてくる。"
msgstr ""

#. Occurrence 1DOT5_4:4663:1904: scene=1DOT5_4
#: 1DOT5_4:4663
msgctxt "text_id=1904 | speaker=unknown"
msgid "　そんな、考えようによっては怪しいコトこの上ない女性にうんうんと真面目に同意する草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:4668:1905: scene=1DOT5_4
#: 1DOT5_4:4668
msgctxt "text_id=1905 | speaker=unknown"
msgid "　なんというか、彼の本能が理解したのだ。"
msgstr ""

#. Occurrence 1DOT5_4:4673:1906: scene=1DOT5_4
#: 1DOT5_4:4673
msgctxt "text_id=1906 | speaker=unknown"
msgid "　この女性は自分と同じように、いつもこういう地味な作業を押しつけられる同士なのだと―――！"
msgstr ""

#. Occurrence 1DOT5_4:4720:1907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0024; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4720
msgctxt "text_id=1907 | speaker=soujuurou"
msgid "「貴方は教会の人なんですか？」"
msgstr ""

#. Occurrence 1DOT5_4:4752:1908: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0009; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4752
msgctxt "text_id=1908 | speaker=ritsuka"
msgid "「わたし？　いえ、ただの通りすがりよ。"
msgstr ""

#. Occurrence 1DOT5_4:4763:1909: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0010; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4763
msgctxt "text_id=1909 | speaker=ritsuka"
msgid "　それより貴方ってのは他人行儀ねぇ。キミとは商店街で何度も会ってるのに」"
msgstr ""

#. Occurrence 1DOT5_4:4769:1910: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0025; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4769
msgctxt "text_id=1910 | speaker=soujuurou"
msgid "「いや、会ってませんよ？」"
msgstr ""

#. Occurrence 1DOT5_4:4819:1911: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_0; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4819
msgctxt "text_id=1911 | speaker=ritsuka"
msgid "「会ってますー。キミ、<魚達|うおたつ>さんでバイトしてる子でしょう？　今週だけでも何度か行ってるもん、わたし。"
msgstr ""

#. Occurrence 1DOT5_4:4831:1912: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_1; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4831
msgctxt "text_id=1912 | speaker=ritsuka"
msgid "　わたしは―――ええっと、そうね、"
msgstr ""

#. Occurrence 1DOT5_4:4843:1913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_2; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4843
msgctxt "text_id=1913 | speaker=ritsuka"
msgid "<花澤|はなざわ>って言うんだけど、キミの名前は？」"
msgstr ""

#. Occurrence 1DOT5_4:4863:1914: scene=1DOT5_4
#: 1DOT5_4:4863
msgctxt "text_id=1914 | speaker=unknown"
msgid "　台詞の途中、ちらりと眼下の花壇を見ながら、きさくに笑いかける花澤さん。"
msgstr ""

#. Occurrence 1DOT5_4:4868:1915: scene=1DOT5_4
#: 1DOT5_4:4868
msgctxt "text_id=1915 | speaker=unknown"
msgid "　草十郎はいつも通り、自信なげに自己紹介を済ませた。"
msgstr ""

#. Occurrence 1DOT5_4:4915:1916: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0012; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4915
msgctxt "text_id=1916 | speaker=ritsuka"
msgid "「草十郎さん……うん、いい名前ね、古風な感じで。"
msgstr ""

#. Occurrence 1DOT5_4:4921:1917: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0013; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4921
msgctxt "text_id=1917 | speaker=ritsuka"
msgid "　名前に数字が入ってると、なんか日本人って感じがしない？　ここの神父さんとかシスターの名前、知ってる？　エイリとかユイカとか、なんか外国風なんだけど」"
msgstr ""

#. Occurrence 1DOT5_4:4953:1918: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0026; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4953
msgctxt "text_id=1918 | speaker=soujuurou"
msgid "「エイリさんはともかく、唯架さんは綺麗な黒髪の女の人でしたよ？」"
msgstr ""

#. Occurrence 1DOT5_4:5002:1919: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0014; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5002
msgctxt "text_id=1919 | speaker=ritsuka"
msgid "「あら、神父さんにはまだ会っていないのね。"
msgstr ""

#. Occurrence 1DOT5_4:5008:1920: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0015; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5008
msgctxt "text_id=1920 | speaker=ritsuka"
msgid "　合田教会の美形神父と美人姉妹って言ったら有名なんだけど……あ、そうか！　さてはキミ、最近引っ越してきたんでしょう！　しかもひとり暮らしと見たわ！」"
msgstr ""

#. Occurrence 1DOT5_4:5043:1921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5043
msgctxt "text_id=1921 | speaker=soujuurou"
msgid "「そうですけど……"
msgstr ""

#. Occurrence 1DOT5_4:5056:1922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5056
msgctxt "text_id=1922 | speaker=soujuurou"
msgid "花澤さん、すごいですね？　さっきからあまりにも的確なあてずっぽうです」"
msgstr ""

#. Occurrence 1DOT5_4:5092:1923: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0016; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5092
msgctxt "text_id=1923 | speaker=ritsuka"
msgid "「いえいえ、推理と言ってくれたまえ。"
msgstr ""

#. Occurrence 1DOT5_4:5098:1924: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0017; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5098
msgctxt "text_id=1924 | speaker=ritsuka"
msgid "　キミぐらいの子がアルバイトに精を出すほど、この町の娯楽は魅力的じゃないもの。遊ぶお金ならバイト一件で<賄|まかな>えちゃうわ。キミは物欲のあるタイプじゃなさそうだし。"
msgstr ""

#. Occurrence 1DOT5_4:5104:1925: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0018; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5104
msgctxt "text_id=1925 | speaker=ritsuka"
msgid "　となると、これはもう生活費のためと考えるのが健全でしょう？"
msgstr ""

#. Occurrence 1DOT5_4:5111:1926: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0019; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5111
msgctxt "text_id=1926 | speaker=ritsuka"
msgid "　……んー、まあ、学生さんが生活費も学費も自分だけで賄う、なんてのは健全じゃないんだけど」"
msgstr ""

#. Occurrence 1DOT5_4:5166:1927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1927 | speaker=soujuurou"
msgid "「いや、そうでもないですよ？"
msgstr ""

#. Occurrence 1DOT5_4:5166:1928: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1928 | speaker=soujuurou"
msgid "　働かざるもの食うべからずです」"
msgstr ""

#. Occurrence 1DOT5_4:5180:1929: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1929 | speaker=ritsuka"
msgid "「そっかぁ。草十郎さんは若いのに立派ねー。"
msgstr ""

#. Occurrence 1DOT5_4:5180:1930: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1930 | speaker=ritsuka"
msgid "　わたしも学生の頃はバイト三昧だったから、少しはキミのたいへんさも分かるわよー」"
msgstr ""

#. Occurrence 1DOT5_4:5191:1931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0029; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5191
msgctxt "text_id=1931 | speaker=soujuurou"
msgid "「なんと。花澤さんもひとり暮らしだったんですか？」"
msgstr ""

#. Occurrence 1DOT5_4:5217:1932: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0021; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5217
msgctxt "text_id=1932 | speaker=ritsuka"
msgid "「ええ。親の反対をおしきって、よその国に留学しちゃったの。<留学先|あっち>にはトモダチもいたから下宿先には困らなかったけど、さすがに食費ぐらいは稼がないとねー。"
msgstr ""

#. Occurrence 1DOT5_4:5223:1933: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0022; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5223
msgctxt "text_id=1933 | speaker=ritsuka"
msgid "　けどまあ、こう見えて肉体労働は苦にならないタイプだし。学院もバイトも楽しい思い出になってるわ」"
msgstr ""

#. Occurrence 1DOT5_4:5280:1934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0030; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5280
msgctxt "text_id=1934 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 1DOT5_4:5286:1935: scene=1DOT5_4
#: 1DOT5_4:5286
msgctxt "text_id=1935 | speaker=unknown"
msgid "　おお、とまたもコクコク頷く草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:5291:1936: scene=1DOT5_4
#: 1DOT5_4:5291
msgctxt "text_id=1936 | speaker=unknown"
msgid "　<節操|せっそう>なく湧きたつ親近感を<抑|おさ>えられない。"
msgstr ""

#. Occurrence 1DOT5_4:5340:1937: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0023; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5340
msgctxt "text_id=1937 | speaker=ritsuka"
msgid "「ふふふ。これも何かの縁だし、魚達さんではこれからお世話になりそうだし。頼りないだろうけど、相談事があったらぜひ言ってね。精神面で力になるわ」"
msgstr ""

#. Occurrence 1DOT5_4:5389:1938: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0031; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5389
msgctxt "text_id=1938 | speaker=soujuurou"
msgid "「ありがとうございます。"
msgstr ""

#. Occurrence 1DOT5_4:5396:1939: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5396
msgctxt "text_id=1939 | speaker=soujuurou"
msgid "　じゃあ早速ですけど、"
msgstr ""

#. Occurrence 1DOT5_4:5408:1940: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1940 | speaker=soujuurou"
msgid "ここは何をするところなんでしょう？"
msgstr ""

#. Occurrence 1DOT5_4:5408:1941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1941 | speaker=soujuurou"
msgid "」"
msgstr ""

#. Occurrence 1DOT5_4:5415:1942: scene=1DOT5_4
#: 1DOT5_4:5415
msgctxt "text_id=1942 | speaker=unknown"
msgid "　ここ、と教会を指さす草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:5464:1943: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0024; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5464
msgctxt "text_id=1943 | speaker=ritsuka"
msgid "「え、えっと？」"
msgstr ""

#. Occurrence 1DOT5_4:5470:1944: scene=1DOT5_4
#: 1DOT5_4:5470
msgctxt "text_id=1944 | speaker=unknown"
msgid "　さすがの花澤さんも面食らっている。"
msgstr ""

#. Occurrence 1DOT5_4:5475:1945: scene=1DOT5_4
#: 1DOT5_4:5475
msgctxt "text_id=1945 | speaker=unknown"
msgid "　草十郎がビンテージものの田舎者である事なんぞ知らない花澤さんであるが、持ち前の機転の良さで、これは高度な皮肉なのだと勘違いしてしまったようだ。"
msgstr ""

#. Occurrence 1DOT5_4:5513:1946: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0025; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5513
msgctxt "text_id=1946 | speaker=ritsuka"
msgid "「うーん、そうねー。"
msgstr ""

#. Occurrence 1DOT5_4:5519:1947: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0026; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5519
msgctxt "text_id=1947 | speaker=ritsuka"
msgid "　心の安全を扱っている、というのはどうかしら。いえ、安全というよりは鎧？　ツギハギのバリケード？　とにかく本人はちっとも鍛えられないってコトは同じよね。"
msgstr ""

#. Occurrence 1DOT5_4:5525:1948: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0027; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5525
msgctxt "text_id=1948 | speaker=ritsuka"
msgid "　ああ、あとはパンとワインも分けてくれるわね」"
msgstr ""

#. Occurrence 1DOT5_4:5531:1949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0033; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5531
msgctxt "text_id=1949 | speaker=soujuurou"
msgid "「無料でですか？」"
msgstr ""

#. Occurrence 1DOT5_4:5552:1950: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0028; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5552
msgctxt "text_id=1950 | speaker=ritsuka"
msgid "「もちろん。富める者は勝手に置いていくって話。"
msgstr ""

#. Occurrence 1DOT5_4:5558:1951: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0029; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5558
msgctxt "text_id=1951 | speaker=ritsuka"
msgid "　あとは―――そっか。これが一番大きいんだけど、収入に税金がかからない。心の安全は扱いが難しいけど、きちんと売り物にできればノーリスクハイリターンよ」"
msgstr ""

#. Occurrence 1DOT5_4:5616:1952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0034; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5616
msgctxt "text_id=1952 | speaker=soujuurou"
msgid "「……はあ。よく分からないですけど、ピンチの時はここに転がりこめばいいんですね？」"
msgstr ""

#. Occurrence 1DOT5_4:5622:1953: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0030; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5622
msgctxt "text_id=1953 | speaker=ritsuka"
msgid "「んー、それはおすすめしないなあ。"
msgstr ""

#. Occurrence 1DOT5_4:5628:1954: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0031; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5628
msgctxt "text_id=1954 | speaker=ritsuka"
msgid "　ご利用は月に一回、気休め程度にした方がいいと思う」"
msgstr ""

#. Occurrence 1DOT5_4:5671:1955: scene=1DOT5_4
#: 1DOT5_4:5671
msgctxt "text_id=1955 | speaker=unknown"
msgid "　きゅっきゅっ、と窓を<拭|ふ>く音が響く。"
msgstr ""

#. Occurrence 1DOT5_4:5676:1956: scene=1DOT5_4
#: 1DOT5_4:5676
msgctxt "text_id=1956 | speaker=unknown"
msgid "　趣味を同じくするふたりは<暢気|のんき>に口笛を吹きながら一枚、また一枚、と教会の窓を磨き上げていく。"
msgstr ""

#. Occurrence 1DOT5_4:5719:1957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0035; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5719
msgctxt "text_id=1957 | speaker=soujuurou"
msgid "「そうだ、もうひとつあります。"
msgstr ""

#. Occurrence 1DOT5_4:5725:1958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0036; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5725
msgctxt "text_id=1958 | speaker=soujuurou"
msgid "　ここから見えるあの森、なんですか？」"
msgstr ""

#. Occurrence 1DOT5_4:5737:1959: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0032; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5737
msgctxt "text_id=1959 | speaker=ritsuka"
msgid "「森？　あの山の上にある森のコト？」"
msgstr ""

#. Occurrence 1DOT5_4:5773:1960: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0037; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5773
msgctxt "text_id=1960 | speaker=soujuurou"
msgid "「ですけど、アレは山じゃなくて丘と言うべきです」"
msgstr ""

#. Occurrence 1DOT5_4:5779:1961: scene=1DOT5_4
#: 1DOT5_4:5779
msgctxt "text_id=1961 | speaker=unknown"
msgid "　田舎育ちの人間として、あの程度の高台を山というのはプライドが許さないらしい。"
msgstr ""

#. Occurrence 1DOT5_4:5828:1962: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0033; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5828
msgctxt "text_id=1962 | speaker=ritsuka"
msgid "「そう？　あれはあれで、けっこう登るのに体力使うんだけど……まあ、<丘|そっち>の方がより<ら|・><し|・><い|・>わねぇ」"
msgstr ""

#. Occurrence 1DOT5_4:5834:1963: scene=1DOT5_4
#: 1DOT5_4:5834
msgctxt "text_id=1963 | speaker=unknown"
msgid "　女性の気さくな笑顔に自虐的な影がさす。"
msgstr ""

#. Occurrence 1DOT5_4:5839:1964: scene=1DOT5_4
#: 1DOT5_4:5839
msgctxt "text_id=1964 | speaker=unknown"
msgid "　もともと端整な顔つきをした美人だ。"
msgstr ""

#. Occurrence 1DOT5_4:5844:1965: scene=1DOT5_4
#: 1DOT5_4:5844
msgctxt "text_id=1965 | speaker=unknown"
msgid "　笑顔を崩すと一転して酷薄な、見るものを威圧する表情になる事に、今さらながら草十郎は気が付いた。"
msgstr ""

#. Occurrence 1DOT5_4:5849:1966: scene=1DOT5_4
#: 1DOT5_4:5849
msgctxt "text_id=1966 | speaker=unknown"
msgid "　もちろん、"
msgstr ""

#. Occurrence 1DOT5_4:5887:1967: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0038; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5887
msgctxt "text_id=1967 | speaker=soujuurou"
msgid "「あれは丘です。それとほら、ここから<煙突|えんとつ>みたいなの見えますけど、アレはなんですか？」"
msgstr ""

#. Occurrence 1DOT5_4:5893:1968: scene=1DOT5_4
#: 1DOT5_4:5893
msgctxt "text_id=1968 | speaker=unknown"
msgid "　そんな事で草十郎があれこれ遠慮したり、怪しんだりする事はないのだった。"
msgstr ""

#. Occurrence 1DOT5_4:5914:1969: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0034; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5914
msgctxt "text_id=1969 | speaker=ritsuka"
msgid "「あれは本物の煙突よ。"
msgstr ""

#. Occurrence 1DOT5_4:5920:1970: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0035; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5920
msgctxt "text_id=1970 | speaker=ritsuka"
msgid "　あの森は全部私有地なんだけど、その中にでっかい洋館が建っているの。でも私有地だから地元の人間も入ったコトはないんじゃないかしら。"
msgstr ""

#. Occurrence 1DOT5_4:5962:1971: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0036; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5962
msgctxt "text_id=1971 | speaker=ritsuka"
msgid "　通称、<久遠寺|くおんじ>のお化け屋敷ってね。近所の皆さんは気味悪がってるし、あんまり近寄らない方がいいんじゃない？　あんな小さな森なのに遭難したとか、野犬が出るとか、物騒な話には事欠かないから」"
msgstr ""

#. Occurrence 1DOT5_4:5988:1972: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0039; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5988
msgctxt "text_id=1972 | speaker=soujuurou"
msgid "「野犬って、都会にも野犬？」"
msgstr ""

#. Occurrence 1DOT5_4:5999:1973: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0037; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5999
msgctxt "text_id=1973 | speaker=ritsuka"
msgid "「たくさんいるわよー。この教会の裏手の空き地にだっているし。ここの神父さんは物好きだからパンとかあげちゃって、それでワンちゃんの巡回ルートになっちゃってるんでしょうけど」"
msgstr ""

#. Occurrence 1DOT5_4:6005:1974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0040; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6005
msgctxt "text_id=1974 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 1DOT5_4:6063:1975: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0038; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6063
msgctxt "text_id=1975 | speaker=ritsuka"
msgid "「とにかく、君子危うきに近寄らず、よ。あの森には入らないのが街のルールなの。"
msgstr ""

#. Occurrence 1DOT5_4:6069:1976: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0039; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6069
msgctxt "text_id=1976 | speaker=ritsuka"
msgid "　そもそも私有地だし、入ったらお巡りさんを呼ばれちゃって、そのまま交番でお説教ターイム！　なんて、あんまり楽しくないでしょう？」"
msgstr ""

#. Occurrence 1DOT5_4:6115:1977: scene=1DOT5_4
#: 1DOT5_4:6115
msgctxt "text_id=1977 | speaker=unknown"
msgid "　なるほど、とハシゴの上から遥か彼方の煙突を眺める。"
msgstr ""

#. Occurrence 1DOT5_4:6120:1978: scene=1DOT5_4
#: 1DOT5_4:6120
msgctxt "text_id=1978 | speaker=unknown"
msgid "　少しだけ、ほんの少しだけ故郷の森を連想させる丘なので気になっていたが、どうやら自分には何の関係もないようだと納得し、草十郎は窓拭きを再開した。"
msgstr ""

#. Occurrence 1DOT5_4:6177:1979: scene=1DOT5_4
#: 1DOT5_4:6177
msgctxt "text_id=1979 | speaker=unknown"
msgid "　花澤さんの協力のおかげで、窓拭きは滞りなく終了した。"
msgstr ""

#. Occurrence 1DOT5_4:6182:1980: scene=1DOT5_4
#: 1DOT5_4:6182
msgctxt "text_id=1980 | speaker=unknown"
msgid "　ふたりがかりで、地味だが手間のかかる仕事をやり遂げたのだ。"
msgstr ""

#. Occurrence 1DOT5_4:6221:1981: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0040; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6221
msgctxt "text_id=1981 | speaker=ritsuka"
msgid "「はい、ごくろうさまでした。"
msgstr ""

#. Occurrence 1DOT5_4:6227:1982: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0041; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6227
msgctxt "text_id=1982 | speaker=ritsuka"
msgid "　うん、あれだけ砂まみれだった窓が見違えたわね！"
msgstr ""

#. Occurrence 1DOT5_4:6245:1983: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0042; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6245
msgctxt "text_id=1983 | speaker=ritsuka"
msgid "　どう、これから適当な<茶店|さてん>でお茶にしない？　草十郎さんの仕事っぷりに敬意を表して、わたしがおご"
msgstr ""

#. Occurrence 1DOT5_4:6258:1984: scene=1DOT5_4
#: 1DOT5_4:6258
msgctxt "text_id=1984 | speaker=unknown"
msgid "―――」"
msgstr ""

#. Occurrence 1DOT5_4:6284:1985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0041; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6284
msgctxt "text_id=1985 | speaker=soujuurou"
msgid "「はい？　何か言いました、花澤さ―――」"
msgstr ""

#. Occurrence 1DOT5_4:6296:1986: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0043; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6296
msgctxt "text_id=1986 | speaker=ritsuka"
msgid "「いえ、ごめんなさい、急用を思い出しちゃった。"
msgstr ""

#. Occurrence 1DOT5_4:6307:1987: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0044; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6307
msgctxt "text_id=1987 | speaker=ritsuka"
msgid "　花澤さんはここで失礼するのでした。チャオ～」"
msgstr ""

#. Occurrence 1DOT5_4:6318:1988: scene=1DOT5_4
#: 1DOT5_4:6318
msgctxt "text_id=1988 | speaker=unknown"
msgid "　ハシゴを片づけていた草十郎が振り向くと、女性は<脱兎|だっと>の如く表通りに走り去っていた。"
msgstr ""

#. Occurrence 1DOT5_4:6352:1989: scene=1DOT5_4
#: 1DOT5_4:6352
msgctxt "text_id=1989 | speaker=unknown"
msgid "　時刻はそろそろ三時。"
msgstr ""

#. Occurrence 1DOT5_4:6357:1990: scene=1DOT5_4
#: 1DOT5_4:6357
msgctxt "text_id=1990 | speaker=unknown"
msgid "　花澤さんが手伝いを申し出てから三時間以上経過している。"
msgstr ""

#. Occurrence 1DOT5_4:6392:1991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0042; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6392
msgctxt "text_id=1991 | speaker=soujuurou"
msgid "「うむ」"
msgstr ""

#. Occurrence 1DOT5_4:6398:1992: scene=1DOT5_4
#: 1DOT5_4:6398
msgctxt "text_id=1992 | speaker=unknown"
msgid "　彼女の急変をしたり顔で見送る草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:6403:1993: scene=1DOT5_4
#: 1DOT5_4:6403
msgctxt "text_id=1993 | speaker=unknown"
msgid "　行くあてなく散歩をしていたように見えた花澤さんだが、これだけ時間を潰したのだ。"
msgstr ""

#. Occurrence 1DOT5_4:6408:1994: scene=1DOT5_4
#: 1DOT5_4:6408
msgctxt "text_id=1994 | speaker=unknown"
msgid "　手伝ってくれた時と同じように、適当な用事を思いだしてしまったのだろう。"
msgstr ""

#. Occurrence 1DOT5_4:6439:1995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0039; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6439
msgctxt "text_id=1995 | speaker=aoko"
msgid "「静希君、そっちにいるの？」"
msgstr ""

#. Occurrence 1DOT5_4:6445:1996: scene=1DOT5_4
#: 1DOT5_4:6445
msgctxt "text_id=1996 | speaker=unknown"
msgid "　と。教会の角からひょっこり顔を出す生徒会長。"
msgstr ""

#. Occurrence 1DOT5_4:6483:1997: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0040; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6483
msgctxt "text_id=1997 | speaker=aoko"
msgid "「あ、声かけてゴメン。いいから作業に専念―――」"
msgstr ""

#. Occurrence 1DOT5_4:6489:1998: scene=1DOT5_4
#: 1DOT5_4:6489
msgctxt "text_id=1998 | speaker=unknown"
msgid "　自分の背丈より長いハシゴを片づけている草十郎を見て、青子は面食らったようだ。"
msgstr ""

#. Occurrence 1DOT5_4:6499:1999: scene=1DOT5_4
#: 1DOT5_4:6499
msgctxt "text_id=1999 | speaker=unknown"
msgid "　それも一瞬の事で、彼女は腕まくりをして草十郎に歩み寄った。"
msgstr ""

#. Occurrence 1DOT5_4:6537:2000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0043; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6537
msgctxt "text_id=2000 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 1DOT5_4:6542:2001: scene=1DOT5_4
#: 1DOT5_4:6542
msgctxt "text_id=2001 | speaker=unknown"
msgid "　とつぜん現れた青子より、草十郎にはそっちの方が驚きだったらしい。"
msgstr ""

#. Occurrence 1DOT5_4:6547:2002: scene=1DOT5_4
#: 1DOT5_4:6547
msgctxt "text_id=2002 | speaker=unknown"
msgid "　当惑する草十郎をよそに、青子はてきぱきと指示をだす。"
msgstr ""

#. Occurrence 1DOT5_4:6574:2003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2003 | speaker=aoko"
msgid "「ハシゴ、横に倒していいわよ。"
msgstr ""

#. Occurrence 1DOT5_4:6574:2004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2004 | speaker=aoko"
msgid "　下の方は私が持つから、貴方は上の方お願い」"
msgstr ""

#. Occurrence 1DOT5_4:6586:2005: scene=1DOT5_4
#: 1DOT5_4:6586
msgctxt "text_id=2005 | speaker=unknown"
msgid "　それがあまりに自然な行為だったので、ひとりで十分だと強がる前に、草十郎はハシゴを横に倒していた。"
msgstr ""

#. Occurrence 1DOT5_4:6649:2006: scene=1DOT5_4
#: 1DOT5_4:6649
msgctxt "text_id=2006 | speaker=unknown"
msgid "　アルバイトが終わり、シスターから気持ち程度の謝礼を受け取って、ふたりは教会を後にした。"
msgstr ""

#. Occurrence 1DOT5_4:6654:2007: scene=1DOT5_4
#: 1DOT5_4:6654
msgctxt "text_id=2007 | speaker=unknown"
msgid "　青子は駅前に用事があるとの事で、とりあえずそこまでは同じ道行きだ。"
msgstr ""

#. Occurrence 1DOT5_4:6688:2008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0042; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6688
msgctxt "text_id=2008 | speaker=aoko"
msgid "「でも、ほんとにアルバイト慣れしてるのね」"
msgstr ""

#. Occurrence 1DOT5_4:6694:2009: scene=1DOT5_4
#: 1DOT5_4:6694
msgctxt "text_id=2009 | speaker=unknown"
msgid "　じき夕暮れになる空の下。"
msgstr ""

#. Occurrence 1DOT5_4:6699:2010: scene=1DOT5_4
#: 1DOT5_4:6699
msgctxt "text_id=2010 | speaker=unknown"
msgid "　話しかけるというよりは感想をもらすように、青子はそんな台詞を口にした。"
msgstr ""

#. Occurrence 1DOT5_4:6725:2011: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0044; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6725
msgctxt "text_id=2011 | speaker=soujuurou"
msgid "「そうか。蒼崎から見てそうなら、少しは嬉しいな」"
msgstr ""

#. Occurrence 1DOT5_4:6731:2012: scene=1DOT5_4
#: 1DOT5_4:6731
msgctxt "text_id=2012 | speaker=unknown"
msgid "　素直に微笑む草十郎。"
msgstr ""

#. Occurrence 1DOT5_4:6736:2013: scene=1DOT5_4
#: 1DOT5_4:6736
msgctxt "text_id=2013 | speaker=unknown"
msgid "　もっとも、給金をもらってから彼はずっとホクホク顔だったので、何に喜んでいるかは不明だった。"
msgstr ""

#. Occurrence 1DOT5_4:6776:2014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0043; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6776
msgctxt "text_id=2014 | speaker=aoko"
msgid "「あ、あのね。貴方は普段が問題ばっかりなんだから、あんまり調子に乗らないように。差し引きゼロっていうか、まだまだマイナスなんだから」"
msgstr ""

#. Occurrence 1DOT5_4:6782:2015: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0045; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6782
msgctxt "text_id=2015 | speaker=soujuurou"
msgid "「む。学校の事は、言われると悲しくなる」"
msgstr ""

#. Occurrence 1DOT5_4:6816:2016: scene=1DOT5_4
#: 1DOT5_4:6816
msgctxt "text_id=2016 | speaker=unknown"
msgid "　草十郎はがっくりとうなだれた。"
msgstr ""

#. Occurrence 1DOT5_4:6821:2017: scene=1DOT5_4
#: 1DOT5_4:6821
msgctxt "text_id=2017 | speaker=unknown"
msgid "　アルバイトはこなせても、学校の授業ばかりはどうにもならない。試験はともかく、日々の授業は一朝一夕でついて行けるものではないからだ。"
msgstr ""

#. Occurrence 1DOT5_4:6847:2018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0046; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6847
msgctxt "text_id=2018 | speaker=soujuurou"
msgid "「蒼崎は成績悪いヤツは嫌いか？」"
msgstr ""

#. Occurrence 1DOT5_4:6865:2019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0044; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6865
msgctxt "text_id=2019 | speaker=aoko"
msgid "「……。まあ、頭というか巡りの悪い人との話は、疲れるでしょうね。でも貴方はそれ以前だし、そもそも私にはこれっぽっちも関係ないし。"
msgstr ""

#. Occurrence 1DOT5_4:6876:2020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0045; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6876
msgctxt "text_id=2020 | speaker=aoko"
msgid "　でっかいハンデをなんとかするのは先生たちの仕事で、それに応えるのは貴方の役目。アルバイトもいいけど、帰ったらきちんと予習、やっときなさいよ」"
msgstr ""

#. Occurrence 1DOT5_4:6913:2021: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0047; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6913
msgctxt "text_id=2021 | speaker=soujuurou"
msgid "「それはもちろん。学校の人たちはみんないい人だ」"
msgstr ""

#. Occurrence 1DOT5_4:6919:2022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0046; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6919
msgctxt "text_id=2022 | speaker=aoko"
msgid "「そ。ならいいけど―――みんないい人？」"
msgstr ""

#. Occurrence 1DOT5_4:6925:2023: scene=1DOT5_4
#: 1DOT5_4:6925
msgctxt "text_id=2023 | speaker=unknown"
msgid "　今のやりとりで、なんでそんな台詞が返ってくるのか、と首をかしげる青子だった。"
msgstr ""

#. Occurrence 1DOT5_4:6930:2024: scene=1DOT5_4
#: 1DOT5_4:6930
msgctxt "text_id=2024 | speaker=unknown"
msgid "　おそらく、草十郎なりの感謝の表れなんだろう、と納得する。"
msgstr ""

#. Occurrence 1DOT5_4:6967:2025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0047; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6967
msgctxt "text_id=2025 | speaker=aoko"
msgid "「―――ところで。"
msgstr ""

#. Occurrence 1DOT5_4:6974:2026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0048; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6974
msgctxt "text_id=2026 | speaker=aoko"
msgid "参考までに訊くんだけど、貴方、他にどんなバイトしてるの？」"
msgstr ""

#. Occurrence 1DOT5_4:6985:2027: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0048; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6985
msgctxt "text_id=2027 | speaker=soujuurou"
msgid "「どこって、商店街が多い。魚のお店とか、花の店とか。ああ、でも昨日は隣町まで遠出したな。遊園地のアルバイト」"
msgstr ""

#. Occurrence 1DOT5_4:7019:2028: scene=1DOT5_4
#: 1DOT5_4:7019
msgctxt "text_id=2028 | speaker=unknown"
msgid "　学校側が認可しているのは三咲町の商店街だけなので、予想通りの回答だった。"
msgstr ""

#. Occurrence 1DOT5_4:7024:2029: scene=1DOT5_4
#: 1DOT5_4:7024
msgctxt "text_id=2029 | speaker=unknown"
msgid "　最後に出た、およそ静希草十郎とは無関係の単語以外は。"
msgstr ""

#. Occurrence 1DOT5_4:7062:2030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0049; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7062
msgctxt "text_id=2030 | speaker=aoko"
msgid "「遊園地って、<社木|やしろぎ>の!?」"
msgstr ""

#. Occurrence 1DOT5_4:7068:2031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0049; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7068
msgctxt "text_id=2031 | speaker=soujuurou"
msgid "「そう。使わなくなった看板とかオブジェとか、解体して運び出したんだ。さすがに疲れたな、あれは」"
msgstr ""

#. Occurrence 1DOT5_4:7080:2032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0050; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7080
msgctxt "text_id=2032 | speaker=aoko"
msgid "「へえー……うん、それは体力勝負でしょうね」"
msgstr ""

#. Occurrence 1DOT5_4:7100:2033: scene=1DOT5_4
#: 1DOT5_4:7100
msgctxt "text_id=2033 | speaker=unknown"
msgid "　今度こそ本気で感心する青子。"
msgstr ""

#. Occurrence 1DOT5_4:7105:2034: scene=1DOT5_4
#: 1DOT5_4:7105
msgctxt "text_id=2034 | speaker=unknown"
msgid "　遊園地で使われる機械の運搬は、ちょっと、学生が片手間でやる仕事ではないからだ。"
msgstr ""

#. Occurrence 1DOT5_4:7140:2035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0051; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7140
msgctxt "text_id=2035 | speaker=aoko"
msgid "「でもいいなあ。私、キッツィーランドって一度も行った事ないの。三咲町に住んでるのに」"
msgstr ""

#. Occurrence 1DOT5_4:7189:2036: scene=1DOT5_4
#: 1DOT5_4:7189
msgctxt "text_id=2036 | speaker=unknown"
msgid "　青子は隣町の方角を仰ぎ見る。"
msgstr ""

#. Occurrence 1DOT5_4:7194:2037: scene=1DOT5_4
#: 1DOT5_4:7194
msgctxt "text_id=2037 | speaker=unknown"
msgid "　ここから見えるのは、かろうじて観覧車だけ。"
msgstr ""

#. Occurrence 1DOT5_4:7199:2038: scene=1DOT5_4
#: 1DOT5_4:7199
msgctxt "text_id=2038 | speaker=unknown"
msgid "　夕日に照らされた円形の鉄骨仕掛けは、<寂|さび>れた<墓標|ぼひょう>を思わせる。"
msgstr ""

#. Occurrence 1DOT5_4:7246:2039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0050; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7246
msgctxt "text_id=2039 | speaker=soujuurou"
msgid "「……そうか。それは、金銭的な理由で？」"
msgstr ""

#. Occurrence 1DOT5_4:7271:2040: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0052; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7271
msgctxt "text_id=2040 | speaker=aoko"
msgid "「っ―――」"
msgstr ""

#. Occurrence 1DOT5_4:7277:2041: scene=1DOT5_4
#: 1DOT5_4:7277
msgctxt "text_id=2041 | speaker=unknown"
msgid "　途端、青子はおかしそうに口をおさえた。"
msgstr ""

#. Occurrence 1DOT5_4:7282:2042: scene=1DOT5_4
#: 1DOT5_4:7282
msgctxt "text_id=2042 | speaker=unknown"
msgid "　草十郎に失礼だと思ったものの、笑いのツボに入ってしまったらしい。"
msgstr ""

#. Occurrence 1DOT5_4:7308:2043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0053; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7308
msgctxt "text_id=2043 | speaker=aoko"
msgid "「ううん、そういうんじゃなくて。"
msgstr ""

#. Occurrence 1DOT5_4:7314:2044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0054; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7314
msgctxt "text_id=2044 | speaker=aoko"
msgid "　単純に、あれが開園してから立てこんでて、遊びにいく暇がなかっただけよ。お金で解決する問題だったら、それこそ今すぐに行ってるわ」"
msgstr ""

#. Occurrence 1DOT5_4:7334:2045: scene=1DOT5_4
#: 1DOT5_4:7334
msgctxt "text_id=2045 | speaker=unknown"
msgid "　ほら、と青子は教会のアルバイト代の入った封筒を見せた。"
msgstr ""

#. Occurrence 1DOT5_4:7339:2046: scene=1DOT5_4
#: 1DOT5_4:7339
msgctxt "text_id=2046 | speaker=unknown"
msgid "　その仕草は明るいものだったが、それでも“行く”と口にしない青子に、草十郎はむっと顔を曇らせる。"
msgstr ""

#. Occurrence 1DOT5_4:7374:2047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0051; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7374
msgctxt "text_id=2047 | speaker=soujuurou"
msgid "「それなら、今度行けばいいじゃないか」"
msgstr ""

#. Occurrence 1DOT5_4:7391:2048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0055; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7391
msgctxt "text_id=2048 | speaker=aoko"
msgid "「ありがと。けどそれは無理な話。"
msgstr ""

#. Occurrence 1DOT5_4:7398:2049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0056; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7398
msgctxt "text_id=2049 | speaker=aoko"
msgid "アンタの事だから気づいていないと思うけど、アレ、つぶれてるのよ。"
msgstr ""

#. Occurrence 1DOT5_4:7405:2050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0057; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7405
msgctxt "text_id=2050 | speaker=aoko"
msgid "廃園になってからもう二年以上は経つんじゃない？」"
msgstr ""

#. Occurrence 1DOT5_4:7416:2051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0052; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7416
msgctxt "text_id=2051 | speaker=soujuurou"
msgid "「―――なんと」"
msgstr ""

#. Occurrence 1DOT5_4:7450:2052: scene=1DOT5_4
#: 1DOT5_4:7450
msgctxt "text_id=2052 | speaker=unknown"
msgid "　どうりで客がいなかった、と草十郎は納得する。"
msgstr ""

#. Occurrence 1DOT5_4:7455:2053: scene=1DOT5_4
#: 1DOT5_4:7455
msgctxt "text_id=2053 | speaker=unknown"
msgid "　生徒会長は呆れながらも少しだけ楽しそうだ。"
msgstr ""

#. Occurrence 1DOT5_4:7460:2054: scene=1DOT5_4
#: 1DOT5_4:7460
msgctxt "text_id=2054 | speaker=unknown"
msgid "　いつもなら“そんな事まで教えないと分からないとは！”と呆れていた彼女だが、この夕暮れにかぎっては、なんだか微笑ましく見えたらしい。"
msgstr ""

#. Occurrence 1DOT5_4:7520:2055: scene=1DOT5_4
#: 1DOT5_4:7520
msgctxt "text_id=2055 | speaker=unknown"
msgid "　蒼崎青子と別れ、アパートに帰って学校の予習に埋没していると、あっという間にアルバイトの時間になった。"
msgstr ""

#. Occurrence 1DOT5_4:7525:2056: scene=1DOT5_4
#: 1DOT5_4:7525
msgctxt "text_id=2056 | speaker=unknown"
msgid "　山と都会の違いはそれこそ数えきれないが、もっとも大きな点は時間の用途だ。"
msgstr ""

#. Occurrence 1DOT5_4:7530:2057: scene=1DOT5_4
#: 1DOT5_4:7530
msgctxt "text_id=2057 | speaker=unknown"
msgid "　此処ではともかく、時の流れが早すぎる。"
msgstr ""

#. Occurrence 1DOT5_4:7535:2058: scene=1DOT5_4
#: 1DOT5_4:7535
msgctxt "text_id=2058 | speaker=unknown"
msgid "　ちっとも頭に入らなかった参考書を片づけて、草十郎は一日の締めとばかりに夜の町に出かけていった。"
msgstr ""

#. Occurrence 1DOT5_4:7581:2059: scene=1DOT5_4
#: 1DOT5_4:7581
msgctxt "text_id=2059 | speaker=unknown"
msgid "　日付変更線を越えて、夜はますます深く眠りについていく。"
msgstr ""

#. Occurrence 1DOT5_4:7586:2060: scene=1DOT5_4
#: 1DOT5_4:7586
msgctxt "text_id=2060 | speaker=unknown"
msgid "　<襟|えり>をたてて、冷えこんだ冬の空気から首筋を守りながら、草十郎は帰路につく。"
msgstr ""

#. Occurrence 1DOT5_4:7591:2061: scene=1DOT5_4
#: 1DOT5_4:7591
msgctxt "text_id=2061 | speaker=unknown"
msgid "　周囲には<食べ物|ひろいもの>目当ての犬もいないし、ちょっとした買い物で出歩いている人もいない。"
msgstr ""

#. Occurrence 1DOT5_4:7596:2062: scene=1DOT5_4
#: 1DOT5_4:7596
msgctxt "text_id=2062 | speaker=unknown"
msgid "　この近くに一店だけのコンビニエンスストアも夜の十一時に閉まってしまう以上、買い物目的で外出する住民はいないのだろう。"
msgstr ""

#. Occurrence 1DOT5_4:7621:2063: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0053; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7621
msgctxt "text_id=2063 | speaker=soujuurou"
msgid "「―――ふう」"
msgstr ""

#. Occurrence 1DOT5_4:7627:2064: scene=1DOT5_4
#: 1DOT5_4:7627
msgctxt "text_id=2064 | speaker=unknown"
msgid "　脱力して、ひときわ深く呼吸をする。"
msgstr ""

#. Occurrence 1DOT5_4:7632:2065: scene=1DOT5_4
#: 1DOT5_4:7632
msgctxt "text_id=2065 | speaker=unknown"
msgid "　人気のない、人工物によって築かれた町並み。"
msgstr ""

#. Occurrence 1DOT5_4:7637:2066: scene=1DOT5_4
#: 1DOT5_4:7637
msgctxt "text_id=2066 | speaker=unknown"
msgid "　星明かりより眩しい、青い蛍光灯に照らされた暗がり。"
msgstr ""

#. Occurrence 1DOT5_4:7642:2067: scene=1DOT5_4
#: 1DOT5_4:7642
msgctxt "text_id=2067 | speaker=unknown"
msgid "　そういったものが、意識せずとも草十郎の不安をあおり立てる。"
msgstr ""

#. Occurrence 1DOT5_4:7699:2068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0054; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7699
msgctxt "text_id=2068 | speaker=soujuurou"
msgid "「……情けない。夜が怖いのは当たり前じゃないか」"
msgstr ""

#. Occurrence 1DOT5_4:7705:2069: scene=1DOT5_4
#: 1DOT5_4:7705
msgctxt "text_id=2069 | speaker=unknown"
msgid "　ぶるっとくる寒気に背を丸めながら、強がりを口にする。"
msgstr ""

#. Occurrence 1DOT5_4:7710:2070: scene=1DOT5_4
#: 1DOT5_4:7710
msgctxt "text_id=2070 | speaker=unknown"
msgid "“暗がりに近づくな”"
msgstr ""

#. Occurrence 1DOT5_4:7715:2071: scene=1DOT5_4
#: 1DOT5_4:7715
msgctxt "text_id=2071 | speaker=unknown"
msgid "“人気のないところには立ち入るな”"
msgstr ""

#. Occurrence 1DOT5_4:7720:2072: scene=1DOT5_4
#: 1DOT5_4:7720
msgctxt "text_id=2072 | speaker=unknown"
msgid "　何の因果か、それとも、それだけ情けない顔をしていたのか。"
msgstr ""

#. Occurrence 1DOT5_4:7726:2073: scene=1DOT5_4
#: 1DOT5_4:7726
msgctxt "text_id=2073 | speaker=unknown"
msgid "草十郎がこれまで知り合ってきた人たちは、決まってそんな忠告をした。"
msgstr ""

#. Occurrence 1DOT5_4:7765:2074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0055; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7765
msgctxt "text_id=2074 | speaker=soujuurou"
msgid "「そうは言ってもしょうがないし、だいたい」"
msgstr ""

#. Occurrence 1DOT5_4:7790:2075: scene=1DOT5_4
#: 1DOT5_4:7790
msgctxt "text_id=2075 | speaker=unknown"
msgid "　暗がりに近づくな、なんて言われても実感が湧かない。"
msgstr ""

#. Occurrence 1DOT5_4:7795:2076: scene=1DOT5_4
#: 1DOT5_4:7795
msgctxt "text_id=2076 | speaker=unknown"
msgid "　<都|こ><会|こ>には明かりのない場所はない。"
msgstr ""

#. Occurrence 1DOT5_4:7800:2077: scene=1DOT5_4
#: 1DOT5_4:7800
msgctxt "text_id=2077 | speaker=unknown"
msgid "　大通りは言うに及ばず、駅前の喧噪から離れた住宅地にだって電灯の明かりがある。"
msgstr ""

#. Occurrence 1DOT5_4:7820:2078: scene=1DOT5_4
#: 1DOT5_4:7820
msgctxt "text_id=2078 | speaker=unknown"
msgid "　怖いのは怖いが、怖さの質が山とは違う。"
msgstr ""

#. Occurrence 1DOT5_4:7826:2079: scene=1DOT5_4
#: 1DOT5_4:7826
msgctxt "text_id=2079 | speaker=unknown"
msgid "　おそらくは根本になるルールが違うのだ。"
msgstr ""

#. Occurrence 1DOT5_4:7831:2080: scene=1DOT5_4
#: 1DOT5_4:7831
msgctxt "text_id=2080 | speaker=unknown"
msgid "　因果応報の仕組みが一方にのみ優しく作られている。"
msgstr ""

#. Occurrence 1DOT5_4:7836:2081: scene=1DOT5_4
#: 1DOT5_4:7836
msgctxt "text_id=2081 | speaker=unknown"
msgid "　怖いと言えば、そのルールがまだよく分からない事の方が、田舎育ちの彼には怖い。"
msgstr ""

#. Occurrence 1DOT5_4:7860:2082: scene=1DOT5_4
#: 1DOT5_4:7860
msgctxt "text_id=2082 | speaker=unknown"
msgid "　山では、ルールを破った者は<そ|・><の|・><時|・><点|・>で報いを受ける。"
msgstr ""

#. Occurrence 1DOT5_4:7865:2083: scene=1DOT5_4
#: 1DOT5_4:7865
msgctxt "text_id=2083 | speaker=unknown"
msgid "　例えば<獣道|けものみち>。"
msgstr ""

#. Occurrence 1DOT5_4:7871:2084: scene=1DOT5_4
#: 1DOT5_4:7871
msgctxt "text_id=2084 | speaker=unknown"
msgid "彼らの縄張りと気付かずに入ってしまえば、当然、住人である動物に襲われて怪我を負う。"
msgstr ""

#. Occurrence 1DOT5_4:7876:2085: scene=1DOT5_4
#: 1DOT5_4:7876
msgctxt "text_id=2085 | speaker=unknown"
msgid "　このように、草十郎にとって過ちとはすぐさま返ってくるものだった。"
msgstr ""

#. Occurrence 1DOT5_4:7881:2086: scene=1DOT5_4
#: 1DOT5_4:7881
msgctxt "text_id=2086 | speaker=unknown"
msgid "　誰が誰を罰するというのではなく、ルールを破れば即、その間違いがカタチになって降りかかると。"
msgstr ""

#. Occurrence 1DOT5_4:7915:2087: scene=1DOT5_4
#: 1DOT5_4:7915
msgctxt "text_id=2087 | speaker=unknown"
msgid "　都会はそのあたりが少しだけ曖昧だと思う。"
msgstr ""

#. Occurrence 1DOT5_4:7920:2088: scene=1DOT5_4
#: 1DOT5_4:7920
msgctxt "text_id=2088 | speaker=unknown"
msgid "　だから、一体なにが正しかったのか、なにが間違っていたのか、致命的な<結末|おわり>になるまで分からない。"
msgstr ""

#. Occurrence 1DOT5_4:7941:2089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0056; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7941
msgctxt "text_id=2089 | speaker=soujuurou"
msgid "「……けど、基本的には変わらないんだよな、たぶん」"
msgstr ""

#. Occurrence 1DOT5_4:7947:2090: scene=1DOT5_4
#: 1DOT5_4:7947
msgctxt "text_id=2090 | speaker=unknown"
msgid "　単純に因果応報の効果が遅いだけ。"
msgstr ""

#. Occurrence 1DOT5_4:7952:2091: scene=1DOT5_4
#: 1DOT5_4:7952
msgctxt "text_id=2091 | speaker=unknown"
msgid "　さらに喩えるなら、彼の田舎には村の治安維持を任された人間はいなかった。"
msgstr ""

#. Occurrence 1DOT5_4:7985:2092: scene=1DOT5_4
#: 1DOT5_4:7985
msgctxt "text_id=2092 | speaker=unknown"
msgid "　都会は人間に優しいかわりに、ルールを破った人間を罰する何者かが<据|す>えられている。"
msgstr ""

#. Occurrence 1DOT5_4:7990:2093: scene=1DOT5_4
#: 1DOT5_4:7990
msgctxt "text_id=2093 | speaker=unknown"
msgid "　山では罪と罰は同義だったが、街ではその二つは切り離され、罪をおかした後に、罰を持ってくる他人がいるらしい。"
msgstr ""

#. Occurrence 1DOT5_4:8010:2094: scene=1DOT5_4
#: 1DOT5_4:8010
msgctxt "text_id=2094 | speaker=unknown"
msgid "　入ってはいけない場所。"
msgstr ""

#. Occurrence 1DOT5_4:8015:2095: scene=1DOT5_4
#: 1DOT5_4:8015
msgctxt "text_id=2095 | speaker=unknown"
msgid "　見てはいけない出来事。"
msgstr ""

#. Occurrence 1DOT5_4:8020:2096: scene=1DOT5_4
#: 1DOT5_4:8020
msgctxt "text_id=2096 | speaker=unknown"
msgid "　そういったルールを破った時、何者かが罰しに来るのが社会のルールなのだ。"
msgstr ""

#. Occurrence 1DOT5_4:8050:2097: scene=1DOT5_4
#: 1DOT5_4:8050
msgctxt "text_id=2097 | speaker=unknown"
msgid "　なので―――町で安全に暮らす方法というのは、余人の事情に立ち入らないこと。"
msgstr ""

#. Occurrence 1DOT5_4:8056:2098: scene=1DOT5_4
#: 1DOT5_4:8056
msgctxt "text_id=2098 | speaker=unknown"
msgid "　草十郎を気遣ってくれた人たちが口を揃えて“近づくな”と言っていたのは、“そうなったら誰も助けてあげられない”からなのだろう。"
msgstr ""

#. Occurrence 1DOT5_4:8077:2099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0057; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8077
msgctxt "text_id=2099 | speaker=soujuurou"
msgid "「……っと。いけない、また近道しそうになった」"
msgstr ""

#. Occurrence 1DOT5_4:8097:2100: scene=1DOT5_4
#: 1DOT5_4:8097
msgctxt "text_id=2100 | speaker=unknown"
msgid "　なので、いくら邪魔だからといって人の家の塀をよじのぼって、すぐ向こうのアパートを目指してはいけないのである。"
msgstr ""

#. Occurrence 1DOT5_4:8102:2101: scene=1DOT5_4
#: 1DOT5_4:8102
msgctxt "text_id=2101 | speaker=unknown"
msgid "　たまたま家の人が起きていたら警察に通報されて、誰にも助けてもらえなくなってしまう。"
msgstr ""

#. Occurrence 1DOT5_4:8144:2102: scene=1DOT5_4
#: 1DOT5_4:8144
msgctxt "text_id=2102 | speaker=unknown"
msgid "　そんな見当違いの都市観を持ったまま、今日も静希草十郎の一日は平穏に終わっていく。"
msgstr ""

#. Occurrence 1DOT5_4:8180:2103: scene=1DOT5_4
#: 1DOT5_4:8180
msgctxt "text_id=2103 | speaker=unknown"
msgid "　すぐには寝つけず、床についたまま窓越しの空を眺める。"
msgstr ""

#. Occurrence 1DOT5_4:8185:2104: scene=1DOT5_4
#: 1DOT5_4:8185
msgctxt "text_id=2104 | speaker=unknown"
msgid "　都会にきた彼が最初に戦慄した<風景|もの>。"
msgstr ""

#. Occurrence 1DOT5_4:8190:2105: scene=1DOT5_4
#: 1DOT5_4:8190
msgctxt "text_id=2105 | speaker=unknown"
msgid "　スイッチひとつでたいていの事は解決される便利さも、"
msgstr ""

#. Occurrence 1DOT5_4:8195:2106: scene=1DOT5_4
#: 1DOT5_4:8195
msgctxt "text_id=2106 | speaker=unknown"
msgid "　壁一枚隣りに顔しか知らない他人が住んでいる新鮮さも、"
msgstr ""

#. Occurrence 1DOT5_4:8200:2107: scene=1DOT5_4
#: 1DOT5_4:8200
msgctxt "text_id=2107 | speaker=unknown"
msgid "　この夜空を見上げた時に吹き飛んだ。"
msgstr ""

#. Occurrence 1DOT5_4:8222:2108: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0058; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8222
msgctxt "text_id=2108 | speaker=soujuurou"
msgid "“……こんな空も、あるのか”"
msgstr ""

#. Occurrence 1DOT5_4:8228:2109: scene=1DOT5_4
#: 1DOT5_4:8228
msgctxt "text_id=2109 | speaker=unknown"
msgid "　意識せず、漠然とこぼれた言葉を覚えている。"
msgstr ""

#. Occurrence 1DOT5_4:8248:2110: scene=1DOT5_4
#: 1DOT5_4:8248
msgctxt "text_id=2110 | speaker=unknown"
msgid "　なんて暗い星。"
msgstr ""

#. Occurrence 1DOT5_4:8253:2111: scene=1DOT5_4
#: 1DOT5_4:8253
msgctxt "text_id=2111 | speaker=unknown"
msgid "　なんて狭い空。"
msgstr ""

#. Occurrence 1DOT5_4:8258:2112: scene=1DOT5_4
#: 1DOT5_4:8258
msgctxt "text_id=2112 | speaker=unknown"
msgid "　ここでは星の見える夜はない。"
msgstr ""

#. Occurrence 1DOT5_4:8263:2113: scene=1DOT5_4
#: 1DOT5_4:8263
msgctxt "text_id=2113 | speaker=unknown"
msgid "　自分はここで暮らしていけるのかどうか―――"
msgstr ""

#. Occurrence 1DOT5_4:8269:2114: scene=1DOT5_4
#: 1DOT5_4:8269
msgctxt "text_id=2114 | speaker=unknown"
msgid "　あの夜に抱いた不安は今も変わっていない。"
msgstr ""

#. Occurrence 1DOT5_4:8290:2115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0059; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8290
msgctxt "text_id=2115 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 1DOT5_4:8309:2116: scene=1DOT5_4
#: 1DOT5_4:8309
msgctxt "text_id=2116 | speaker=unknown"
msgid "　<瞼|まぶた>を閉じる。"
msgstr ""

#. Occurrence 1DOT5_4:8314:2117: scene=1DOT5_4
#: 1DOT5_4:8314
msgctxt "text_id=2117 | speaker=unknown"
msgid "　そんな女々しい悩みとは裏腹に、アルバイトと勉強で疲れた体はあっさり、ぐっすり安眠していった。"
msgstr ""

#. Occurrence 2_1:130:2118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0000; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:130
msgctxt "text_id=2118 | speaker=soujuurou"
msgid "“都会は魔界だ。"
msgstr ""

#. Occurrence 2_1:139:2119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0001; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:139
msgctxt "text_id=2119 | speaker=soujuurou"
msgid "　けど、慣れればわりと住みやすいとは思う”"
msgstr ""

#. Occurrence 2_1:198:2120: scene=2_1
#: 2_1:198
msgctxt "text_id=2120 | speaker=unknown"
msgid "　はあ、と力のないため息がこぼれる。"
msgstr ""

#. Occurrence 2_1:203:2121: scene=2_1
#: 2_1:203
msgctxt "text_id=2121 | speaker=unknown"
msgid "　静希草十郎は冬の校庭を見下ろしながら、柄にもなく物思いに<耽|ふけ>っていた。"
msgstr ""

#. Occurrence 2_1:233:2122: scene=2_1
#: 2_1:233
msgctxt "text_id=2122 | speaker=unknown"
msgid "　黒板の隅には１２月の日付。"
msgstr ""

#. Occurrence 2_1:238:2123: scene=2_1
#: 2_1:238
msgctxt "text_id=2123 | speaker=unknown"
msgid "　早いもので、草十郎が転入してからすでに十日。"
msgstr ""

#. Occurrence 2_1:243:2124: scene=2_1
#: 2_1:243
msgctxt "text_id=2124 | speaker=unknown"
msgid "　暦が１２月に移り、辛うじて残っていた秋の面影は見る影もない。"
msgstr ""

#. Occurrence 2_1:248:2125: scene=2_1
#: 2_1:248
msgctxt "text_id=2125 | speaker=unknown"
msgid "　校庭の木々はそのほとんどが裸になり、舞い散った落ち葉が地面を覆い隠している。"
msgstr ""

#. Occurrence 2_1:289:2126: scene=2_1
#: 2_1:289
msgctxt "text_id=2126 | speaker=unknown"
msgid "　古典の時間。"
msgstr ""

#. Occurrence 2_1:294:2127: scene=2_1
#: 2_1:294
msgctxt "text_id=2127 | speaker=unknown"
msgid "　教壇からは老教師による見解が淡々と流れてくる。"
msgstr ""

#. Occurrence 2_1:299:2128: scene=2_1
#: 2_1:299
msgctxt "text_id=2128 | speaker=unknown"
msgid "　ようやく馴れてきた教室と、まだまだ追いつけない授業の四時限目。"
msgstr ""

#. Occurrence 2_1:304:2129: scene=2_1
#: 2_1:304
msgctxt "text_id=2129 | speaker=unknown"
msgid "　基礎が出来てない草十郎にとって、日々の授業は真剣勝負だ。"
msgstr ""

#. Occurrence 2_1:309:2130: scene=2_1
#: 2_1:309
msgctxt "text_id=2130 | speaker=unknown"
msgid "　今は内容を正しく飲みこめなくともきっかり暗記し、後々に生かせるよう心がけている。"
msgstr ""

#. Occurrence 2_1:329:2131: scene=2_1
#: 2_1:329
msgctxt "text_id=2131 | speaker=unknown"
msgid "　なので雑念などもってのほか。"
msgstr ""

#. Occurrence 2_1:334:2132: scene=2_1
#: 2_1:334
msgctxt "text_id=2132 | speaker=unknown"
msgid "　よそ見をしている暇はない、と厳しく自分に言いつけているのだが、"
msgstr ""

#. Occurrence 2_1:374:2133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0002; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:374
msgctxt "text_id=2133 | speaker=soujuurou"
msgid "「………………はあ」"
msgstr ""

#. Occurrence 2_1:379:2134: scene=2_1
#: 2_1:379
msgctxt "text_id=2134 | speaker=unknown"
msgid "　困ったコトに、今日はどうしても授業に集中できなかった。"
msgstr ""

#. Occurrence 2_1:399:2135: scene=2_1
#: 2_1:399
msgctxt "text_id=2135 | speaker=unknown"
msgid "　集中力の不足はどこからきたものか。"
msgstr ""

#. Occurrence 2_1:404:2136: scene=2_1
#: 2_1:404
msgctxt "text_id=2136 | speaker=unknown"
msgid "　都市の冬は山に比べれば格段に住みやすいし、毎日のアルバイトだってそう<過酷|ハード>ではない。"
msgstr ""

#. Occurrence 2_1:409:2137: scene=2_1
#: 2_1:409
msgctxt "text_id=2137 | speaker=unknown"
msgid "　肉体的な疲れは、まあ、人並みだろうから理由にはあげられない。"
msgstr ""

#. Occurrence 2_1:445:2138: scene=2_1
#: 2_1:445
msgctxt "text_id=2138 | speaker=unknown"
msgid "　では授業そのものが退屈だから、と言われるとそれも違う。"
msgstr ""

#. Occurrence 2_1:450:2139: scene=2_1
#: 2_1:450
msgctxt "text_id=2139 | speaker=unknown"
msgid "　草十郎はクラスメイトたちが言うほど授業をつまらないものだと感じていない。"
msgstr ""

#. Occurrence 2_1:455:2140: scene=2_1
#: 2_1:455
msgctxt "text_id=2140 | speaker=unknown"
msgid "　良いか悪いかで言えば、間違いなく良い部類に入る時間だ。"
msgstr ""

#. Occurrence 2_1:475:2141: scene=2_1
#: 2_1:475
msgctxt "text_id=2141 | speaker=unknown"
msgid "　なので精神的な面でも理由は見あたらない。"
msgstr ""

#. Occurrence 2_1:480:2142: scene=2_1
#: 2_1:480
msgctxt "text_id=2142 | speaker=unknown"
msgid "　ここまで集中力が散漫になるのはどうかと思う、と草十郎は我が身の情けなさに落ちこんでいる。"
msgstr ""

#. Occurrence 2_1:527:2143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0003; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:527
msgctxt "text_id=2143 | speaker=soujuurou"
msgid "『……いけない。こんなんじゃ気が散る一方だ』"
msgstr ""

#. Occurrence 2_1:553:2144: scene=2_1
#: 2_1:553
msgctxt "text_id=2144 | speaker=unknown"
msgid "　自分を叱って黒板に目を向ける。"
msgstr ""

#. Occurrence 2_1:558:2145: scene=2_1
#: 2_1:558
msgctxt "text_id=2145 | speaker=unknown"
msgid "　カツカツと規則正しく、なのになぜか眠気を誘う<白墨|チョーク>の滑る音も、この純朴な転入生を<堕落|だらく>させるには至らない。"
msgstr ""

#. Occurrence 2_1:607:2146: scene=2_1
#: 2_1:607
msgctxt "text_id=2146 | speaker=unknown"
msgid "　けれどやっぱり、彼は授業に集中できなかった。"
msgstr ""

#. Occurrence 2_1:613:2147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0004; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:613
msgctxt "text_id=2147 | speaker=soujuurou"
msgid "『…………むう』"
msgstr ""

#. Occurrence 2_1:618:2148: scene=2_1
#: 2_1:618
msgctxt "text_id=2148 | speaker=unknown"
msgid "　重いため息をついて草十郎なりに考える。"
msgstr ""

#. Occurrence 2_1:623:2149: scene=2_1
#: 2_1:623
msgctxt "text_id=2149 | speaker=unknown"
msgid "　あまり考えたくはないが、原因は、まあ。"
msgstr ""

#. Occurrence 2_1:630:2150: scene=2_1
#: 2_1:630
msgctxt "text_id=2150 | speaker=unknown"
msgid "　思い返すたびにどうかと思う、昨夜の出来事以外ありえなかった。"
msgstr ""

#. Occurrence 2_1:686:2151: scene=2_1
#: 2_1:686
msgctxt "text_id=2151 | speaker=unknown"
msgid "　授業の終わりを告げるチャイムと、礼をして廊下に向かう老教師。"
msgstr ""

#. Occurrence 2_1:691:2152: scene=2_1
#: 2_1:691
msgctxt "text_id=2152 | speaker=unknown"
msgid "　彼の退室を見届けて、三十人もの生徒は一斉に席を立った。"
msgstr ""

#. Occurrence 2_1:696:2153: scene=2_1
#: 2_1:696
msgctxt "text_id=2153 | speaker=unknown"
msgid "　11時半ごろから緩慢に進んでいた時計の針は、いまやピッタリと頂点を指し示している。"
msgstr ""

#. Occurrence 2_1:744:2154: scene=2_1
#: 2_1:744
msgctxt "text_id=2154 | speaker=unknown"
msgid "　ざあ、と<伝播|でんぱ>していく憩いの空気。"
msgstr ""

#. Occurrence 2_1:749:2155: scene=2_1
#: 2_1:749
msgctxt "text_id=2155 | speaker=unknown"
msgid "　堅苦しい授業からのひとときの解放、"
msgstr ""

#. Occurrence 2_1:754:2156: scene=2_1
#: 2_1:754
msgctxt "text_id=2156 | speaker=unknown"
msgid "　学園生活の華ともいえる<昼食|ランチタイム>の始まりだ。"
msgstr ""

#. Occurrence 2_1:803:2157: scene=2_1
#: 2_1:803
msgctxt "text_id=2157 | speaker=unknown"
msgid "　三咲高校の学食の味つけはよろしくない。"
msgstr ""

#. Occurrence 2_1:808:2158: scene=2_1
#: 2_1:808
msgctxt "text_id=2158 | speaker=unknown"
msgid "　私立校にあるまじき怠慢、という抗議もどこ吹く風で、"
msgstr ""

#. Occurrence 2_1:813:2159: scene=2_1
#: 2_1:813
msgctxt "text_id=2159 | speaker=unknown"
msgid "　今日も今日とて独特の味を提供している。"
msgstr ""

#. Occurrence 2_1:818:2160: scene=2_1
#: 2_1:818
msgctxt "text_id=2160 | speaker=unknown"
msgid "　値段もそれなり、味もいまいち、となれば、必然、学校ではお弁当派が大勢力となる。"
msgstr ""

#. Occurrence 2_1:852:2161: scene=2_1
#: 2_1:852
msgctxt "text_id=2161 | speaker=unknown"
msgid "　草十郎が転入した二年Ｃ組も例外ではない。"
msgstr ""

#. Occurrence 2_1:857:2162: scene=2_1
#: 2_1:857
msgctxt "text_id=2162 | speaker=unknown"
msgid "　男子は腕力にまかせて十個ほどの机をあわせ、長テーブルのような食卓を築く。"
msgstr ""

#. Occurrence 2_1:862:2163: scene=2_1
#: 2_1:862
msgctxt "text_id=2163 | speaker=unknown"
msgid "　一方、女子は洗練された手順で二、三個の机をこぢんまりとしたテーブルにかえ、いくつかのグループにわかれて談笑を始めていた。"
msgstr ""

#. Occurrence 2_1:894:2164: scene=2_1
#: 2_1:894
msgctxt "text_id=2164 | speaker=unknown"
msgid "　貴重な昼休みを一分一秒も無駄にしない。"
msgstr ""

#. Occurrence 2_1:899:2165: scene=2_1
#: 2_1:899
msgctxt "text_id=2165 | speaker=unknown"
msgid "　かたちは違えど、両陣営の信念は同じだった。"
msgstr ""

#. Occurrence 2_1:951:2166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0005; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:951
msgctxt "text_id=2166 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_1:956:2167: scene=2_1
#: 2_1:956
msgctxt "text_id=2167 | speaker=unknown"
msgid "　その手際の良さに草十郎は呆気に取られている。"
msgstr ""

#. Occurrence 2_1:961:2168: scene=2_1
#: 2_1:961
msgctxt "text_id=2168 | speaker=unknown"
msgid "　転入してから十日経った今でもこのスピーディーさについていけず、いまだ自分の席に居座っていた。"
msgstr ""

#. Occurrence 2_1:983:2169: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0000; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:983
msgctxt "text_id=2169 | speaker=kinomi"
msgid "「おーい、こっちこいよ静希！」"
msgstr ""

#. Occurrence 2_1:994:2170: scene=2_1
#: 2_1:994
msgctxt "text_id=2170 | speaker=unknown"
msgid "　呼びかけてくる声は、教室の窓側を占拠した一大食卓からだった。"
msgstr ""

#. Occurrence 2_1:1036:2171: scene=2_1
#: 2_1:1036
msgctxt "text_id=2171 | speaker=unknown"
msgid "　だらしなく椅子をななめに立て、いつスッ<転|ころ>んでもおかしくない状態で手招きしているのは<木|き><乃|の><美|み><芳助|ほうすけ>。"
msgstr ""

#. Occurrence 2_1:1041:2172: scene=2_1
#: 2_1:1041
msgctxt "text_id=2172 | speaker=unknown"
msgid "　口が悪くて根性も無い、とクラス中から<酷評|こくひょう>される人物だが、さっぱりした性格のおかげか敵は少ない。"
msgstr ""

#. Occurrence 2_1:1046:2173: scene=2_1
#: 2_1:1046
msgctxt "text_id=2173 | speaker=unknown"
msgid "　たまに、さっぱりしすぎるのもどうか、とみなの頭を悩ませてもいる。"
msgstr ""

#. Occurrence 2_1:1082:2174: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0001; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1082
msgctxt "text_id=2174 | speaker=kinomi"
msgid "「メシにしようぜメシぃ。"
msgstr ""

#. Occurrence 2_1:1088:2175: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0002; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1088
msgctxt "text_id=2175 | speaker=kinomi"
msgid "　オレさあ、昨日店の残り物もらいすぎたんだよ。春巻だよ春巻。それを見た親父がさあ、貰ったモンは残すなってうるさくてさあ。食いもん、春巻きしかねーんだわ」"
msgstr ""

#. Occurrence 2_1:1113:2176: scene=2_1
#: 2_1:1113
msgctxt "text_id=2176 | speaker=unknown"
msgid "　なので救いの手を差し向けてくれ、とまっとうな弁当を呼びこもうと企む木乃美だった。"
msgstr ""

#. Occurrence 2_1:1118:2177: scene=2_1
#: 2_1:1118
msgctxt "text_id=2177 | speaker=unknown"
msgid "　木乃美と草十郎は同じ店で働いており、転入前から顔見知りだった数少ないアルバイト仲間だ。"
msgstr ""

#. Occurrence 2_1:1123:2178: scene=2_1
#: 2_1:1123
msgctxt "text_id=2178 | speaker=unknown"
msgid "　また、草十郎に『腐れ縁』という言葉をはじめて実感させた男でもある。"
msgstr ""

#. Occurrence 2_1:1164:2179: voice_id=E20_2_1_0000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1164
msgctxt "text_id=2179 | speaker=unknown"
msgid "「お、いいな、静希も来いよー！　今日は待ちに待った缶詰祭りをすっからさー！」"
msgstr ""

#. Occurrence 2_1:1170:2180: voice_id=E30_2_1_0000; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1170
msgctxt "text_id=2180 | speaker=unknown"
msgid "「……ついに決行するのかよ……誰か冷静になった方がいいんじゃないのか、実際……」"
msgstr ""

#. Occurrence 2_1:1176:2181: voice_id=E20_2_1_9000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1176
msgctxt "text_id=2181 | speaker=unknown"
msgid "「バカ、すげえ楽しいってきっと！　そりゃパチもんくさいけどカニ缶とか食い放題なんだぜ!?　サバ缶じゃなくて！」"
msgstr ""

#. Occurrence 2_1:1224:2182: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2182 | speaker=unknown"
msgid "「まじ！？　やったー、オレも参加するー！"
msgstr ""

#. Occurrence 2_1:1224:2183: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2183 | speaker=unknown"
msgid "　コンビーフはひとり一個？　それとも早い者勝ち？」"
msgstr ""

#. Occurrence 2_1:1238:2184: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0003; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1238
msgctxt "text_id=2184 | speaker=kinomi"
msgid "「おまえな、ひとりで何個も食えるもんじゃねえぞアレ。うまいのは最初の一個だけだって」"
msgstr ""

#. Occurrence 2_1:1244:2185: voice_id=E30_2_1_0001; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1244
msgctxt "text_id=2185 | speaker=unknown"
msgid "「静希たちがくるならノルマはひとり七個に下がるのか……助かるなあ……」"
msgstr ""

#. Occurrence 2_1:1250:2186: voice_id=E50_2_1_0001; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:1250
msgctxt "text_id=2186 | speaker=unknown"
msgid "「ところで木乃美の弁当の中身、なんか缶詰より硬そうじゃね？」"
msgstr ""

#. Occurrence 2_1:1278:2187: scene=2_1
#: 2_1:1278
msgctxt "text_id=2187 | speaker=unknown"
msgid "　いつもは互いの弁当の不出来さをネタにして騒ぐ彼らは、今日に限って団結していた。"
msgstr ""

#. Occurrence 2_1:1289:2188: scene=2_1
#: 2_1:1289
msgctxt "text_id=2188 | speaker=unknown"
msgid "　テーブルにはピラミッド型につまれた無数の缶詰。"
msgstr ""

#. Occurrence 2_1:1294:2189: scene=2_1
#: 2_1:1294
msgctxt "text_id=2189 | speaker=unknown"
msgid "　賞味期限を油性のサインペンで塗りつぶされたソレは、ある男子生徒の家の倉庫から発掘されたものらしい。"
msgstr ""

#. Occurrence 2_1:1332:2190: voice_id=E20_2_1_0001; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1332
msgctxt "text_id=2190 | speaker=unknown"
msgid "「よし野郎ども、各自マイ缶切りの用意はいいな？"
msgstr ""

#. Occurrence 2_1:1338:2191: voice_id=E20_2_1_0002; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1338
msgctxt "text_id=2191 | speaker=unknown"
msgid "　食べるも地獄、残すも地獄。我ら五時限目の授業はないものと恐れぬ修羅となり、鉄の悪魔どもを平らげん―――"
msgstr ""

#. Occurrence 2_1:1344:2192: voice_id=E20_2_1_0003; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1344
msgctxt "text_id=2192 | speaker=unknown"
msgid "　えー、食材は下町のなんでも商会、マーケット中山からの提供です！」"
msgstr ""

#. Occurrence 2_1:1384:2193: voice_id=E40_2_1_0001; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1384
msgctxt "text_id=2193 | speaker=unknown"
msgid "「ヒュー！　バカも休み休みyeah！」"
msgstr ""

#. Occurrence 2_1:1389:2194: scene=2_1
#: 2_1:1389
msgctxt "text_id=2194 | speaker=unknown"
msgid "　一団となって、缶切りを持った手を天高く掲げる男子生徒の群れ。"
msgstr ""

#. Occurrence 2_1:1454:2195: voice_id=E20_2_1_0004; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1454
msgctxt "text_id=2195 | speaker=unknown"
msgid "「ほら、静希も食べようぜー。缶切りならまだあるからさー」"
msgstr ""

#. Occurrence 2_1:1466:2196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0006; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1466
msgctxt "text_id=2196 | speaker=soujuurou"
msgid "「いや、君らの弁当の毒見はゴメンだって昨日言ったはずだ。"
msgstr ""

#. Occurrence 2_1:1472:2197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0007; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1472
msgctxt "text_id=2197 | speaker=soujuurou"
msgid "　それに、その缶詰半分以上、賞味期限切れてるだろう」"
msgstr ""

#. Occurrence 2_1:1478:2198: voice_id=E20_2_1_0005; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1478
msgctxt "text_id=2198 | speaker=unknown"
msgid "「なんだよー、つれねえなあー！」"
msgstr ""

#. Occurrence 2_1:1489:2199: scene=2_1
#: 2_1:1489
msgctxt "text_id=2199 | speaker=unknown"
msgid "　どっと沸くならず者たち。"
msgstr ""

#. Occurrence 2_1:1494:2200: scene=2_1
#: 2_1:1494
msgctxt "text_id=2200 | speaker=unknown"
msgid "　<犠牲者|なかま>を一人でも増やそうと思っているに違いない。"
msgstr ""

#. Occurrence 2_1:1540:2201: scene=2_1
#: 2_1:1540
msgctxt "text_id=2201 | speaker=unknown"
msgid "　彼らの賑やかさにほだされ、仕方ない、と席を立つ草十郎。"
msgstr ""

#. Occurrence 2_1:1545:2202: scene=2_1
#: 2_1:1545
msgctxt "text_id=2202 | speaker=unknown"
msgid "　それを、"
msgstr ""

#. Occurrence 2_1:1552:2203: voice_id=D90_2_1_0000; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1552
msgctxt "text_id=2203 | speaker=unknown"
msgid "「じゃ、わたしたちが釣り上げよっかなー！"
msgstr ""

#. Occurrence 2_1:1558:2204: voice_id=D90_2_1_0001; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1558
msgctxt "text_id=2204 | speaker=unknown"
msgid "　静希くん、あんなの放っておいて一緒にどう？」"
msgstr ""

#. Occurrence 2_1:1564:2205: scene=2_1
#: 2_1:1564
msgctxt "text_id=2205 | speaker=unknown"
msgid "　もう一方の勢力がつかまえた。"
msgstr ""

#. Occurrence 2_1:1584:2206: scene=2_1
#: 2_1:1584
msgctxt "text_id=2206 | speaker=unknown"
msgid "　呼び掛けたのはショートの髪がよく似合う女生徒だった。"
msgstr ""

#. Occurrence 2_1:1589:2207: scene=2_1
#: 2_1:1589
msgctxt "text_id=2207 | speaker=unknown"
msgid "　数日前、草十郎を陸上部に勧誘してくれた事もある。"
msgstr ""

#. Occurrence 2_1:1630:2208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0008; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1630
msgctxt "text_id=2208 | speaker=soujuurou"
msgid "「……いや。そっちも遠慮したいな、できれば」"
msgstr ""

#. Occurrence 2_1:1635:2209: scene=2_1
#: 2_1:1635
msgctxt "text_id=2209 | speaker=unknown"
msgid "　困り顔で返答する。"
msgstr ""

#. Occurrence 2_1:1640:2210: scene=2_1
#: 2_1:1640
msgctxt "text_id=2210 | speaker=unknown"
msgid "　彼女達のテーブルには草十郎があまり知らない果実<だ|・><け|・>が山のようにつまれていた。"
msgstr ""

#. Occurrence 2_1:1666:2211: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2211 | speaker=unknown"
msgid "「えー、なんでー？　パパイヤとか嫌い？"
msgstr ""

#. Occurrence 2_1:1666:2212: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2212 | speaker=unknown"
msgid "　マンゴーもあるし、ヤシの実だってあるし、内緒だけど夕張メロンもあるんだから！」"
msgstr ""

#. Occurrence 2_1:1671:2213: scene=2_1
#: 2_1:1671
msgctxt "text_id=2213 | speaker=unknown"
msgid "　拳を立てて力説する果実グループ。"
msgstr ""

#. Occurrence 2_1:1705:2214: voice_id=E20_2_1_0006; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1705
msgctxt "text_id=2214 | speaker=unknown"
msgid "「待て、なんだヤシの実って？　アレ食えるもんなの？」"
msgstr ""

#. Occurrence 2_1:1711:2215: voice_id=E30_2_1_0002; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1711
msgctxt "text_id=2215 | speaker=unknown"
msgid "「あ、マンゴー余ったら回してほしいなー」"
msgstr ""

#. Occurrence 2_1:1717:2216: voice_id=E40_2_1_0002; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1717
msgctxt "text_id=2216 | speaker=unknown"
msgid "「ばか、肉食え肉。そんなんだから貧弱な体してんだぞ、おまえら！」"
msgstr ""

#. Occurrence 2_1:1722:2217: scene=2_1
#: 2_1:1722
msgctxt "text_id=2217 | speaker=unknown"
msgid "　飛びかう声に、やっぱり草十郎はついていけない。"
msgstr ""

#. Occurrence 2_1:1755:2218: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0009; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1755
msgctxt "text_id=2218 | speaker=soujuurou"
msgid "「……分かるのは、どっちも破滅的だってコトだけだ」"
msgstr ""

#. Occurrence 2_1:1761:2219: scene=2_1
#: 2_1:1761
msgctxt "text_id=2219 | speaker=unknown"
msgid "　言いつつ、草十郎はどちらも断りきれない。"
msgstr ""

#. Occurrence 2_1:1766:2220: scene=2_1
#: 2_1:1766
msgctxt "text_id=2220 | speaker=unknown"
msgid "　他人の好意を素直に受け取りすぎる彼は、時に優柔不断になる。"
msgstr ""

#. Occurrence 2_1:1771:2221: scene=2_1
#: 2_1:1771
msgctxt "text_id=2221 | speaker=unknown"
msgid "　人間、好意になれていないと、何を捨てるべきか咄嗟に判断できないのである。"
msgstr ""

#. Occurrence 2_1:1776:2222: scene=2_1
#: 2_1:1776
msgctxt "text_id=2222 | speaker=unknown"
msgid "　そんな迷える子羊の肩を叩く影がひとつ。"
msgstr ""

#. Occurrence 2_1:1813:2223: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0000; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1813
msgctxt "text_id=2223 | speaker=tobimaru"
msgid "「ほっとけほっとけ。いちいちここのバカどもに付き合ってちゃ人生台無しだ。適当に流しとけばいいんだよ。"
msgstr ""

#. Occurrence 2_1:1819:2224: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0001; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1819
msgctxt "text_id=2224 | speaker=tobimaru"
msgid "　オラ、おまえらもな、善良な羊を悪の園に引きずりこんでんじゃねえよ」"
msgstr ""

#. Occurrence 2_1:1825:2225: scene=2_1
#: 2_1:1825
msgctxt "text_id=2225 | speaker=unknown"
msgid "　場違いにドスのきいた声が、草十郎の背後から教室に響きわたる。"
msgstr ""

#. Occurrence 2_1:1861:2226: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0010; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1861
msgctxt "text_id=2226 | speaker=soujuurou"
msgid "「副会長」"
msgstr ""

#. Occurrence 2_1:1866:2227: scene=2_1
#: 2_1:1866
msgctxt "text_id=2227 | speaker=unknown"
msgid "　草十郎が振り向くと、そこには彼より頭ひとつぶん背の高い男子生徒が立っていた。"
msgstr ""

#. Occurrence 2_1:1900:2228: scene=2_1
#: 2_1:1900
msgctxt "text_id=2228 | speaker=unknown"
msgid "　乱雑に、けれど見栄えよく撫で上げられた長髪。"
msgstr ""

#. Occurrence 2_1:1905:2229: scene=2_1
#: 2_1:1905
msgctxt "text_id=2229 | speaker=unknown"
msgid "　整った美形でありながら刺々しい目つきでクラスを<睥睨|へいげい>する暴力性。"
msgstr ""

#. Occurrence 2_1:1910:2230: scene=2_1
#: 2_1:1910
msgctxt "text_id=2230 | speaker=unknown"
msgid "　いつも眠そうな草十郎とは対照的な、一目で人を魅了する非の打ちどころのない美男子。"
msgstr ""

#. Occurrence 2_1:1915:2231: scene=2_1
#: 2_1:1915
msgctxt "text_id=2231 | speaker=unknown"
msgid "　誰もが<畏|おそ>れ、<敬|うやま>うであろう彼への反応は、しかし。"
msgstr ""

#. Occurrence 2_1:1948:2232: voice_id=E20_2_1_0007; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1948
msgctxt "text_id=2232 | speaker=unknown"
msgid "「なんだよ、副会長さまのお出ましかよー！」"
msgstr ""

#. Occurrence 2_1:1954:2233: voice_id=E30_2_1_0003; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1954
msgctxt "text_id=2233 | speaker=unknown"
msgid "「テメエらのバカ顔にはこりごりだって、学食に陣取ってたんじゃなかったのかよー！」"
msgstr ""

#. Occurrence 2_1:1960:2234: voice_id=E40_2_1_0003; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1960
msgctxt "text_id=2234 | speaker=unknown"
msgid "「へへへ、ここは見てのとおりボンクラどもが集う貧民街でございますよ、王子はほら、Ａ組のきれいどころとカフェでお茶でもしてればいいじゃない！」"
msgstr ""

#. Occurrence 2_1:2003:2235: voice_id=E50_2_1_0002; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:2003
msgctxt "text_id=2235 | speaker=unknown"
msgid "「また静希呼びに来たのかよ。青子女史といい鳶丸殿下といい、静希、なんかヤバいコトしちゃったのか……？」"
msgstr ""

#. Occurrence 2_1:2009:2236: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2236 | speaker=unknown"
msgid "「えー。静希くんは校則違反しないじゃん。"
msgstr ""

#. Occurrence 2_1:2009:2237: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2237 | speaker=unknown"
msgid "　ちょっと、それ以外のルール破るだけで！」"
msgstr ""

#. Occurrence 2_1:2015:2238: voice_id=E10_2_1_0001; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:2015
msgctxt "text_id=2238 | speaker=unknown"
msgid "「ってコトはやっぱり―――<槻司|つきじ>くん、蒼崎に振られてからそっちに走ったって本当だったのね!?」"
msgstr ""

#. Occurrence 2_1:2050:2239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0011; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:2050
msgctxt "text_id=2239 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 2_1:2055:2240: scene=2_1
#: 2_1:2055
msgctxt "text_id=2240 | speaker=unknown"
msgid "　この通り、親愛と友情に満ちた暴言だった。"
msgstr ""

#. Occurrence 2_1:2066:2241: scene=2_1
#: 2_1:2066
msgctxt "text_id=2241 | speaker=unknown"
msgid "　言われたい放題の男子に、草十郎はつい同情してしまう。"
msgstr ""

#. Occurrence 2_1:2071:2242: scene=2_1
#: 2_1:2071
msgctxt "text_id=2242 | speaker=unknown"
msgid "　もっとも、肝心の男子はまったくのノーリアクション。"
msgstr ""

#. Occurrence 2_1:2076:2243: scene=2_1
#: 2_1:2076
msgctxt "text_id=2243 | speaker=unknown"
msgid "　騒ぎ立てる彼らをつまらなげに<一瞥|いちべつ>すると、吐き捨てるように声をあげる。"
msgstr ""

#. Occurrence 2_1:2116:2244: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0002; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2116
msgctxt "text_id=2244 | speaker=tobimaru"
msgid "「相変わらず無駄に元気があって結構じゃねえかテメエら。"
msgstr ""

#. Occurrence 2_1:2123:2245: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0003; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2123
msgctxt "text_id=2245 | speaker=tobimaru"
msgid "　そんなに活力たぎってんなら冬期特別清掃班にだって参加出来るよなあ、"
msgstr ""

msgctxt "text_id=2246 | speaker=unknown"
msgid "オイ？"
msgstr ""

#. Occurrence 2_1:2134:2247: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0004; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2134
msgctxt "text_id=2247 | speaker=tobimaru"
msgid "　いまんところ自主的に申し出てるのは全校で一人しかいねえんだ。２－Ｃ全員が参加すりゃあ、俺も蒼崎も肩の荷がおりるってもんなんだがよ……！」"
msgstr ""

#. Occurrence 2_1:2169:2248: scene=2_1
#: 2_1:2169
msgctxt "text_id=2248 | speaker=unknown"
msgid "　その端整な顔立ちとはかけ離れた、ドスのきいた<胴間|どうま>声が教室に響く。"
msgstr ""

#. Occurrence 2_1:2174:2249: scene=2_1
#: 2_1:2174
msgctxt "text_id=2249 | speaker=unknown"
msgid "　彼の一喝で水を打ったように黙りこむ、ならず者部隊＆スイーツ愛好者たち。"
msgstr ""

#. Occurrence 2_1:2179:2250: scene=2_1
#: 2_1:2179
msgctxt "text_id=2250 | speaker=unknown"
msgid "　この男子生徒を畏怖しての事もあるが、何より『冬期特別清掃班』が恐ろしいからである。"
msgstr ""

#. Occurrence 2_1:2199:2251: scene=2_1
#: 2_1:2199
msgctxt "text_id=2251 | speaker=unknown"
msgid "　冬期特別清掃班。"
msgstr ""

#. Occurrence 2_1:2204:2252: scene=2_1
#: 2_1:2204
msgctxt "text_id=2252 | speaker=unknown"
msgid "　それは先々代の生徒会からお手上げ状態で放置していた旧校舎、および山みたいな裏庭の森を冬休みを挙げて清掃しよう、という趣旨の、学園行事の名を借りた拷問だ。"
msgstr ""

#. Occurrence 2_1:2224:2253: scene=2_1
#: 2_1:2224
msgctxt "text_id=2253 | speaker=unknown"
msgid "　おそらく、冬休みのうち三日は完全に潰される。"
msgstr ""

#. Occurrence 2_1:2229:2254: scene=2_1
#: 2_1:2229
msgctxt "text_id=2254 | speaker=unknown"
msgid "　もちろん成績に残るような見返りはない。"
msgstr ""

#. Occurrence 2_1:2234:2255: scene=2_1
#: 2_1:2234
msgctxt "text_id=2255 | speaker=unknown"
msgid "　ことはあくまで生徒会が立案しただけのボランティア。参加希望者が一人でもいたコトは奇跡に近い。"
msgstr ""

#. Occurrence 2_1:2269:2256: voice_id=E20_2_1_0008; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:2269
msgctxt "text_id=2256 | speaker=unknown"
msgid "「あー……いや、僕ら、ちょっと体弱いんで……すみっちょで缶詰食べてますね？」"
msgstr ""

#. Occurrence 2_1:2275:2257: voice_id=D90_2_1_0003; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2275
msgctxt "text_id=2257 | speaker=unknown"
msgid "「わたしたちも貧血気味で……こうやって果物たべてないと死んじゃうっていうか……冬休みはもう予定いっぱいっていうか……」"
msgstr ""

#. Occurrence 2_1:2292:2258: scene=2_1
#: 2_1:2292
msgctxt "text_id=2258 | speaker=unknown"
msgid "　一名を除いて、そそくさと隅に移動する２年Ｃ組の皆さん。"
msgstr ""

#. Occurrence 2_1:2318:2259: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0005; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2318
msgctxt "text_id=2259 | speaker=tobimaru"
msgid "「よし、昼食はやっぱり静かにやらねえとな。"
msgstr ""

#. Occurrence 2_1:2329:2260: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0006; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2329
msgctxt "text_id=2260 | speaker=tobimaru"
msgid "　一年坊主の教室より二年の教室の方がやかましいなんて苦情、いいかげんにしやがれよアホウども？」"
msgstr ""

#. Occurrence 2_1:2354:2261: scene=2_1
#: 2_1:2354
msgctxt "text_id=2261 | speaker=unknown"
msgid "　うへーい、と弱々しく退散する有象無象たち。"
msgstr ""

#. Occurrence 2_1:2359:2262: scene=2_1
#: 2_1:2359
msgctxt "text_id=2262 | speaker=unknown"
msgid "　その中に溶け込むように流れていく草十郎だったが、"
msgstr ""

#. Occurrence 2_1:2391:2263: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0007; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2391
msgctxt "text_id=2263 | speaker=tobimaru"
msgid "「おう、おまえはこっちだ草十郎。ちょい顔貸せ」"
msgstr ""

#. Occurrence 2_1:2397:2264: scene=2_1
#: 2_1:2397
msgctxt "text_id=2264 | speaker=unknown"
msgid "　強引に肩を引かれ、仲間入りを阻まれた。"
msgstr ""

#. Occurrence 2_1:2420:2265: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0004; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2420
msgctxt "text_id=2265 | speaker=kinomi"
msgid "「……っだよ、生徒会横暴ー。人んちのテーブルマナーまで指図してほしくねーよなー！」"
msgstr ""

#. Occurrence 2_1:2426:2266: scene=2_1
#: 2_1:2426
msgctxt "text_id=2266 | speaker=unknown"
msgid "　立ち去る背中を好機と見たのか、仲間うちでのみ聞こえるよう悪態をつく木乃美。"
msgstr ""

#. Occurrence 2_1:2459:2267: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0008; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2459
msgctxt "text_id=2267 | speaker=tobimaru"
msgid "「ああ？　上等じゃねえか木乃美、いいぜ、おまえが記念すべき二人目だ。冬休み、首を洗って待ってやがれ」"
msgstr ""

#. Occurrence 2_1:2465:2268: scene=2_1
#: 2_1:2465
msgctxt "text_id=2268 | speaker=unknown"
msgid "　きっかり聞こえていたのか、副会長は親指をたてて、ぐるん、と<一回転|ノックアウト>の意を示す。"
msgstr ""

#. Occurrence 2_1:2506:2269: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0005; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2506
msgctxt "text_id=2269 | speaker=kinomi"
msgid "「はあ、なに言ってんですかアイツ？"
msgstr ""

#. Occurrence 2_1:2512:2270: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0006; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2512
msgctxt "text_id=2270 | speaker=kinomi"
msgid "　アレ自主的なイベントじゃん、いくら副会長ったって強制はできないですよねぇ!?」"
msgstr ""

#. Occurrence 2_1:2518:2271: scene=2_1
#: 2_1:2518
msgctxt "text_id=2271 | speaker=unknown"
msgid "　ひひひ、と笑う２年Ｃ組の誇る問題児。"
msgstr ""

#. Occurrence 2_1:2544:2272: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0009; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2544
msgctxt "text_id=2272 | speaker=tobimaru"
msgid "「そりゃ昨日までの話だ。"
msgstr ""

#. Occurrence 2_1:2550:2273: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0010; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2550
msgctxt "text_id=2273 | speaker=tobimaru"
msgid "　会長の提案が学校側に受理されてな、本日付けで生徒会役員は強制力のある推薦権をもらえたんだよ。"
msgstr ""

#. Occurrence 2_1:2561:2274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0011; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2561
msgctxt "text_id=2274 | speaker=tobimaru"
msgid "　とくに会長と副会長の推薦は絶対だ。拒否した場合、学校側はともかく、蒼崎がなにするか俺には止められねえからそのつもりでな？」"
msgstr ""

#. Occurrence 2_1:2587:2275: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0007; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2587
msgctxt "text_id=2275 | speaker=kinomi"
msgid "@o「げぇぇぇ!!!?　ちょ、それ事実上の死刑宣告じゃん!?　生徒^会まじ横暴ー！！！！」"
msgstr ""

#. Occurrence 2_1:2610:2276: scene=2_1
#: 2_1:2610
msgctxt "text_id=2276 | speaker=unknown"
msgid "　悪態から悲鳴に変わる木乃美の断末魔を後に、副会長と草十郎は２年Ｃ組を後にした。"
msgstr ""

#. Occurrence 2_2:72:2277: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0000; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:72
msgctxt "text_id=2277 | speaker=tobimaru"
msgid "「おまえも大変だな、草十郎」"
msgstr ""

#. Occurrence 2_2:78:2278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0000; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:78
msgctxt "text_id=2278 | speaker=soujuurou"
msgid "「あんたもわりと暇なんだな、副会長」"
msgstr ""

#. Occurrence 2_2:104:2279: scene=2_2
#: 2_2:104
msgctxt "text_id=2279 | speaker=unknown"
msgid "　無人の生徒会室に入るなり所感を口にするふたり。"
msgstr ""

#. Occurrence 2_2:110:2280: scene=2_2
#: 2_2:110
msgctxt "text_id=2280 | speaker=unknown"
msgid "　三咲高校の生徒会室は二つあり、"
msgstr ""

#. Occurrence 2_2:115:2281: scene=2_2
#: 2_2:115
msgctxt "text_id=2281 | speaker=unknown"
msgid "　一つは生徒会用に作られた大部屋、"
msgstr ""

#. Occurrence 2_2:120:2282: scene=2_2
#: 2_2:120
msgctxt "text_id=2282 | speaker=unknown"
msgid "　もう一つは数学の準備室だった資料室とに分かれている。"
msgstr ""

#. Occurrence 2_2:141:2283: scene=2_2
#: 2_2:141
msgctxt "text_id=2283 | speaker=unknown"
msgid "　こちらは資料室の方で、壁にはファイルのつまった資料棚がびっしりと並び、ただでさえ狭苦しい部屋を余計に窮屈に見せていた。"
msgstr ""

#. Occurrence 2_2:148:2284: scene=2_2
#: 2_2:148
msgctxt "text_id=2284 | speaker=unknown"
msgid "　生徒会室というより、個人の隠れ家といった方が正しいだろう。"
msgstr ""

#. Occurrence 2_2:153:2285: scene=2_2
#: 2_2:153
msgctxt "text_id=2285 | speaker=unknown"
msgid "　草十郎が椅子に座ると、向かい合うように男子生徒も腰を下ろした。"
msgstr ""

#. Occurrence 2_2:189:2286: scene=2_2
#: 2_2:189
msgctxt "text_id=2286 | speaker=unknown"
msgid "　<槻司|つきじ><鳶丸|とびまる>。"
msgstr ""

#. Occurrence 2_2:194:2287: scene=2_2
#: 2_2:194
msgctxt "text_id=2287 | speaker=unknown"
msgid "　私立三咲高校の理事長の息子であり、生徒会副会長。"
msgstr ""

#. Occurrence 2_2:199:2288: scene=2_2
#: 2_2:199
msgctxt "text_id=2288 | speaker=unknown"
msgid "　学年は草十郎と同じく二年生で、約一週間前、転入生の世話を生徒会長に押しつけられてからの付き合いである。"
msgstr ""

#. Occurrence 2_2:225:2289: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0001; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:225
msgctxt "text_id=2289 | speaker=tobimaru"
msgid "「副会長はやめろって。クソッタレな話だが、俺はしょせん会長の犬だからな」"
msgstr ""

#. Occurrence 2_2:231:2290: scene=2_2
#: 2_2:231
msgctxt "text_id=2290 | speaker=unknown"
msgid "　やれやれと自嘲するも、不満があるワケでもなさそうだ。"
msgstr ""

#. Occurrence 2_2:238:2291: scene=2_2
#: 2_2:238
msgctxt "text_id=2291 | speaker=unknown"
msgid "　鳶丸はポケットからスナック菓子を取りだし、実にまずそうに口に入れた。"
msgstr ""

#. Occurrence 2_2:250:2292: scene=2_2
#: 2_2:250
msgctxt "text_id=2292 | speaker=unknown"
msgid "　一本１００キロカロリーほどのブロック形式の簡易食を、それこそ干し肉を引きちぎるように片づけていく。"
msgstr ""

#. Occurrence 2_2:303:2293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0001; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:303
msgctxt "text_id=2293 | speaker=soujuurou"
msgid "「そうか。でも犬はよくないな、鳶丸」"
msgstr ""

#. Occurrence 2_2:345:2294: scene=2_2
#: 2_2:345
msgctxt "text_id=2294 | speaker=unknown"
msgid "　難しい顔つきで草十郎は椅子に座る。"
msgstr ""

#. Occurrence 2_2:356:2295: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0002; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:356
msgctxt "text_id=2295 | speaker=tobimaru"
msgid "「あん？　犬がどうしたって？」"
msgstr ""

#. Occurrence 2_2:374:2296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0002; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:374
msgctxt "text_id=2296 | speaker=soujuurou"
msgid "「犬はよくないって言った。喩えが違う気がするし、なにより怖いぞ、アレ」"
msgstr ""

#. Occurrence 2_2:380:2297: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0003; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:380
msgctxt "text_id=2297 | speaker=tobimaru"
msgid "「？　なんだよ、山奥育ちのくせに犬が怖いのか？」"
msgstr ""

#. Occurrence 2_2:406:2298: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0003; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:406
msgctxt "text_id=2298 | speaker=soujuurou"
msgid "「そりゃたいていの生き物は怖いけど、犬は別格だ。"
msgstr ""

#. Occurrence 2_2:412:2299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0004; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:412
msgctxt "text_id=2299 | speaker=soujuurou"
msgid "　徒党を組んだ野犬ほど始末に負えないものはない。"
msgstr ""

#. Occurrence 2_2:418:2300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0005; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:418
msgctxt "text_id=2300 | speaker=soujuurou"
msgid "　<脚|あし>の速さも脅威だけど、なにより執念深すぎる。"
msgstr ""

#. Occurrence 2_2:429:2301: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0006; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:429
msgctxt "text_id=2301 | speaker=soujuurou"
msgid "　坂だろうと追いかけてくるし、最後の一匹になるまで引かないんだぞ」"
msgstr ""

#. Occurrence 2_2:474:2302: scene=2_2
#: 2_2:474
msgctxt "text_id=2302 | speaker=unknown"
msgid "　などと言いつつ、弁当の包みを開ける草十郎。"
msgstr ""

#. Occurrence 2_2:479:2303: scene=2_2
#: 2_2:479
msgctxt "text_id=2303 | speaker=unknown"
msgid "　若草色をした布には、綺麗な三角形をしたおにぎりが三つ包まれていた。"
msgstr ""

#. Occurrence 2_2:524:2304: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0004; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:524
msgctxt "text_id=2304 | speaker=tobimaru"
msgid "「……ショックだ」"
msgstr ""

#. Occurrence 2_2:554:2305: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0007; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:554
msgctxt "text_id=2305 | speaker=soujuurou"
msgid "「？　ショックってなにが？」"
msgstr ""

#. Occurrence 2_2:560:2306: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0005; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:560
msgctxt "text_id=2306 | speaker=tobimaru"
msgid "「いや、そんな、この世のものとは思えない握り飯を見たのは初めてだ。思わず絶句しちまった」"
msgstr ""

#. Occurrence 2_2:572:2307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0008; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:572
msgctxt "text_id=2307 | speaker=soujuurou"
msgid "「……。それ、どっちなんだ？」"
msgstr ""

#. Occurrence 2_2:596:2308: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0006; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:596
msgctxt "text_id=2308 | speaker=tobimaru"
msgid "「誉めてるんだよ、馬鹿」"
msgstr ""

#. Occurrence 2_2:640:2309: scene=2_2
#: 2_2:640
msgctxt "text_id=2309 | speaker=unknown"
msgid "　草十郎を相手に侮辱とも称賛とも取れる言い回しはこういう結果を招く。婉曲な表現、遠回しな嫌味をかみ砕ける<機微|きび>がないためだ。"
msgstr ""

#. Occurrence 2_2:645:2310: scene=2_2
#: 2_2:645
msgctxt "text_id=2310 | speaker=unknown"
msgid "　ただ、今のように言葉の良し悪しをいちいち訊ねるのは<希|まれ>だった。"
msgstr ""

#. Occurrence 2_2:650:2311: scene=2_2
#: 2_2:650
msgctxt "text_id=2311 | speaker=unknown"
msgid "　鳶丸の推測だが、この少年は個人的に<譲|ゆず>れない事のみ白黒をハッキリさせる気質らしい。"
msgstr ""

#. Occurrence 2_2:676:2312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0009; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:676
msgctxt "text_id=2312 | speaker=soujuurou"
msgid "「ところで。その固まった小麦粉みたいなの、美味しいのか？」"
msgstr ""

#. Occurrence 2_2:682:2313: scene=2_2
#: 2_2:682
msgctxt "text_id=2313 | speaker=unknown"
msgid "　興味津々とばかりに鳶丸の簡易食を見つめる草十郎。"
msgstr ""

#. Occurrence 2_2:723:2314: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0007; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:723
msgctxt "text_id=2314 | speaker=tobimaru"
msgid "「まずくはねえが美味くもねえよ。ま、試してみる分には止めねえが。"
msgstr ""

#. Occurrence 2_2:735:2315: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0008; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:735
msgctxt "text_id=2315 | speaker=tobimaru"
msgid "　人間、何事も手間暇惜しむようになっちゃおしまいだぜ。事が三大欲求ならなおさらだ」"
msgstr ""

#. Occurrence 2_2:768:2316: scene=2_2
#: 2_2:768
msgctxt "text_id=2316 | speaker=unknown"
msgid "　鳶丸はガリガリとブロック菓子を平らげ、残った一本を机に置き、当然という手つきでおにぎりを一つ手に取った。"
msgstr ""

#. Occurrence 2_2:773:2317: scene=2_2
#: 2_2:773
msgctxt "text_id=2317 | speaker=unknown"
msgid "　草十郎も当然とばかりに鳶丸の暴挙を見逃し、差し出されたブロック菓子を食べてみる。"
msgstr ""

#. Occurrence 2_2:820:2318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0010; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:820
msgctxt "text_id=2318 | speaker=soujuurou"
msgid "「……なんだか、土を食べてるみたいだ」"
msgstr ""

#. Occurrence 2_2:846:2319: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0009; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:846
msgctxt "text_id=2319 | speaker=tobimaru"
msgid "「違いない。遊びを無くせば人生こんなもんだって見本だな」"
msgstr ""

#. Occurrence 2_2:869:2320: scene=2_2
#: 2_2:869
msgctxt "text_id=2320 | speaker=unknown"
msgid "　草十郎は苦い顔のまま、律儀に簡易食をかじっていく。"
msgstr ""

#. Occurrence 2_2:874:2321: scene=2_2
#: 2_2:874
msgctxt "text_id=2321 | speaker=unknown"
msgid "　未知への関心と、はじめた事はきっちり終わらせようとする律儀さである。"
msgstr ""

#. Occurrence 2_2:905:2322: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0010; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:905
msgctxt "text_id=2322 | speaker=tobimaru"
msgid "「いま無理に平らげる必要はねえぞ。そいつの利点は携帯食ってところだからな。素で味けないが、食えるうちは味が落ちないのがいいところだ。"
msgstr ""

#. Occurrence 2_2:916:2323: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0011; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:916
msgctxt "text_id=2323 | speaker=tobimaru"
msgid "　ま、そっちはともかく。どうだ、少しは慣れたか？」"
msgstr ""

#. Occurrence 2_2:963:2324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0011; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:963
msgctxt "text_id=2324 | speaker=soujuurou"
msgid "「ああ。鳶丸や蒼崎が気を遣ってくれているからね」"
msgstr ""

#. Occurrence 2_2:990:2325: scene=2_2
#: 2_2:990
msgctxt "text_id=2325 | speaker=unknown"
msgid "　屈託のない笑顔に、鳶丸はつい顔をそらしてしまった。"
msgstr ""

#. Occurrence 2_2:995:2326: scene=2_2
#: 2_2:995
msgctxt "text_id=2326 | speaker=unknown"
msgid "　草十郎はたしかに普段からぼんやりしているが、反面、こうして見せる感情表現はまっすぐで嘘がない。"
msgstr ""

#. Occurrence 2_2:1000:2327: scene=2_2
#: 2_2:1000
msgctxt "text_id=2327 | speaker=unknown"
msgid "　鳶丸のように若く利己的な人間にとっては、ささやかな毒にもなる。"
msgstr ""

#. Occurrence 2_2:1040:2328: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0012; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1040
msgctxt "text_id=2328 | speaker=tobimaru"
msgid "『……だから蒼崎はこねえんだよなあ……』"
msgstr ""

#. Occurrence 2_2:1046:2329: scene=2_2
#: 2_2:1046
msgctxt "text_id=2329 | speaker=unknown"
msgid "　内心呟いて、手にした握り飯を一口かじる鳶丸。"
msgstr ""

#. Occurrence 2_2:1051:2330: scene=2_2
#: 2_2:1051
msgctxt "text_id=2330 | speaker=unknown"
msgid "　冷めた白米でありながら、しっかり柔らかな食感である事に二度驚く鳶丸だった。"
msgstr ""

#. Occurrence 2_2:1095:2331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0013; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1095
msgctxt "text_id=2331 | speaker=tobimaru"
msgid "「……ん？　"
msgstr ""

msgctxt "text_id=2332 | speaker=unknown"
msgid "いや待て、気を遣ってんのは俺だけじゃねえか。蒼崎なんておまえが転入した日に“彼、迷惑だから見張ってて”の一言だけだぞ!?」"
msgstr ""

#. Occurrence 2_2:1132:2333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0012; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1132
msgctxt "text_id=2333 | speaker=soujuurou"
msgid "「……なんでそこで君が怒るんだ？」"
msgstr ""

#. Occurrence 2_2:1169:2334: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2334 | speaker=tobimaru"
msgid "「いや、だからだな。おまえが学校に慣れるよう陰ながら見守ってんのは俺で、蒼崎は生徒会室で全校生徒の弱みを集めてるだけって話だ！"
msgstr ""

#. Occurrence 2_2:1169:2335: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2335 | speaker=tobimaru"
msgid "　面倒な苦労してんのは俺だけじゃねえかって―――」"
msgstr ""

#. Occurrence 2_2:1193:2336: scene=2_2
#: 2_2:1193
msgctxt "text_id=2336 | speaker=unknown"
msgid "　そこまで口にして、鳶丸は自分の言い分が馬鹿らしくなった。草十郎の言う通り、鳶丸が怒る筋合いでもない。"
msgstr ""

#. Occurrence 2_2:1214:2337: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0015; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1214
msgctxt "text_id=2337 | speaker=tobimaru"
msgid "「……ま、いいさ。蒼崎に言いつけられなきゃこうなる事もなかったしな。"
msgstr ""

#. Occurrence 2_2:1231:2338: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2338 | speaker=tobimaru"
msgid "　知ってるか？"
msgstr ""

#. Occurrence 2_2:1231:2339: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2339 | speaker=tobimaru"
msgid "　あいつ、どうして俺にこんな役させたと思う？」"
msgstr ""

#. Occurrence 2_2:1242:2340: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0013; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1242
msgctxt "text_id=2340 | speaker=soujuurou"
msgid "「副会長だからだろ」"
msgstr ""

#. Occurrence 2_2:1253:2341: scene=2_2
#: 2_2:1253
msgctxt "text_id=2341 | speaker=unknown"
msgid "　言われて、鳶丸はその綺麗な顔を曇らせる。"
msgstr ""

#. Occurrence 2_2:1280:2342: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0017; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1280
msgctxt "text_id=2342 | speaker=tobimaru"
msgid "「あのなあ。どうして副会長が転入生ひとりにかかりっきりにならなくちゃいけねえんだよ。"
msgstr ""

#. Occurrence 2_2:1302:2343: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0018; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1302
msgctxt "text_id=2343 | speaker=tobimaru"
msgid "　チッ、いいぜ、機会があったら蒼崎本人に聞いてみな。あいつの本性が分かるからよ」"
msgstr ""

#. Occurrence 2_2:1347:2344: scene=2_2
#: 2_2:1347
msgctxt "text_id=2344 | speaker=unknown"
msgid "　鳶丸は悪態をつきながらさらに握り飯をかじる。"
msgstr ""

#. Occurrence 2_2:1352:2345: scene=2_2
#: 2_2:1352
msgctxt "text_id=2345 | speaker=unknown"
msgid "　乾燥した米粒でありながら、なんという<瑞々|みずみず>しさ……言うなれば<握|にぎ>り飯ではなく<包|つつ>み飯。力任せに米を固めたのではなく、職人の業で優しく『おにぎり』というカタチに集結させたとしか思えない……"
msgstr ""

#. Occurrence 2_2:1410:2346: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0019; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1410
msgctxt "text_id=2346 | speaker=tobimaru"
msgid "「そしてなによりこの塩加減、中の具からしみだした玄妙な醤油加減はどうだ―――"
msgstr ""

msgctxt "text_id=2347 | speaker=unknown"
msgid "食欲をそそるどころか、脳を食欲だけにするような―――"
msgstr ""

msgctxt "text_id=2348 | speaker=unknown"
msgid "おお―――」"
msgstr ""

#. Occurrence 2_2:1427:2349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0014; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1427
msgctxt "text_id=2349 | speaker=soujuurou"
msgid "「鳶丸、思ってる事が口に出てるみたいだけど」"
msgstr ""

#. Occurrence 2_2:1455:2350: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0020; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1455
msgctxt "text_id=2350 | speaker=tobimaru"
msgid "「いや、それほどのショックだったってワケだ。"
msgstr ""

#. Occurrence 2_2:1489:2351: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0021; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1489
msgctxt "text_id=2351 | speaker=tobimaru"
msgid "　なあ草の字。これ、具はなんだ？」"
msgstr ""

#. Occurrence 2_2:1500:2352: scene=2_2
#: 2_2:1500
msgctxt "text_id=2352 | speaker=unknown"
msgid "　予想外の味に思わず訊ねる。"
msgstr ""

#. Occurrence 2_2:1505:2353: scene=2_2
#: 2_2:1505
msgctxt "text_id=2353 | speaker=unknown"
msgid "　ちなみに、鳶丸はまだ外周だけで中心たる具に辿り着いていない。"
msgstr ""

#. Occurrence 2_2:1551:2354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0015; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1551
msgctxt "text_id=2354 | speaker=soujuurou"
msgid "「ああ、それはイナゴ」"
msgstr ""

#. Occurrence 2_2:1564:2355: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0022; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1564
msgctxt "text_id=2355 | speaker=tobimaru"
msgid "「ありえねえ！」"
msgstr ""

#. Occurrence 2_2:1570:2356: scene=2_2
#: 2_2:1570
msgctxt "text_id=2356 | speaker=unknown"
msgid "　がは、と咳きこむ副会長。"
msgstr ""

#. Occurrence 2_2:1575:2357: scene=2_2
#: 2_2:1575
msgctxt "text_id=2357 | speaker=unknown"
msgid "　たしかに、山奥育ちの草十郎には海の幸より山の幸のイメージがあるような、でもイナゴはないような。"
msgstr ""

#. Occurrence 2_2:1614:2358: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0023; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1614
msgctxt "text_id=2358 | speaker=tobimaru"
msgid "「クソ、食う前に言えよな！　信じられねえぐらい美味いと思っちまったじゃねえか！」"
msgstr ""

#. Occurrence 2_2:1645:2359: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0016; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1645
msgctxt "text_id=2359 | speaker=soujuurou"
msgid "「ああ、今のは嘘だよ」"
msgstr ""

#. Occurrence 2_2:1673:2360: scene=2_2
#: 2_2:1673
msgctxt "text_id=2360 | speaker=unknown"
msgid "　瞬間、見つめ合うふたり。"
msgstr ""

#. Occurrence 2_2:1708:2361: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0017; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1708
msgctxt "text_id=2361 | speaker=soujuurou"
msgid "「ほんとは鮭。いくらなんでも、イナゴはね」"
msgstr ""

#. Occurrence 2_2:1723:2362: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2362 | speaker=tobimaru"
msgid "「―――お、おう。そうだよな、いや、安心した。"
msgstr ""

#. Occurrence 2_2:1723:2363: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2363 | speaker=tobimaru"
msgid "　いくらなんでもイナゴはねえよな」"
msgstr ""

#. Occurrence 2_2:1754:2364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0018; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1754
msgctxt "text_id=2364 | speaker=soujuurou"
msgid "「ああ、こんな都会で身のしまったイナゴが手に入るもんか」"
msgstr ""

#. Occurrence 2_2:1760:2365: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0025; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1760
msgctxt "text_id=2365 | speaker=tobimaru"
msgid "「………………」"
msgstr ""

#. Occurrence 2_2:1765:2366: scene=2_2
#: 2_2:1765
msgctxt "text_id=2366 | speaker=unknown"
msgid "　気になる台詞だったが、あえて鳶丸はスルーする。"
msgstr ""

#. Occurrence 2_2:1804:2367: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0026; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1804
msgctxt "text_id=2367 | speaker=tobimaru"
msgid "「……ったく。どっちにしても冗談きついぜ。あやうくはき出すところだったじゃねえか。らしくねえぞ、草十郎」"
msgstr ""

#. Occurrence 2_2:1810:2368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0019; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1810
msgctxt "text_id=2368 | speaker=soujuurou"
msgid "「君が蒼崎の悪口を言うからだ」"
msgstr ""

#. Occurrence 2_2:1852:2369: scene=2_2
#: 2_2:1852
msgctxt "text_id=2369 | speaker=unknown"
msgid "　瞼を閉じ、不機嫌そうに握り飯を食べながら草十郎はそう言った。たしかに言った。"
msgstr ""

#. Occurrence 2_2:1857:2370: scene=2_2
#: 2_2:1857
msgctxt "text_id=2370 | speaker=unknown"
msgid "　不満そうにもぐもぐ口を動かす草十郎を、鳶丸は<唖然|あぜん>と見つめる。"
msgstr ""

#. Occurrence 2_2:1895:2371: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0027; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1895
msgctxt "text_id=2371 | speaker=tobimaru"
msgid "「―――おい。今のはさすがに聞き捨てならねえぞ。俺が蒼崎の悪口を言ったから<意趣返|いしゅがえ>しをしたと、そういうコトか？」"
msgstr ""

#. Occurrence 2_2:1927:2372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0020; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1927
msgctxt "text_id=2372 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 2_2:1933:2373: scene=2_2
#: 2_2:1933
msgctxt "text_id=2373 | speaker=unknown"
msgid "　もぐもぐもぐ。"
msgstr ""

#. Occurrence 2_2:1938:2374: scene=2_2
#: 2_2:1938
msgctxt "text_id=2374 | speaker=unknown"
msgid "　純朴な田舎少年の無言の抗議は、ますます真実味を増していく。"
msgstr ""

#. Occurrence 2_2:1981:2375: scene=2_2
#: 2_2:1981
msgctxt "text_id=2375 | speaker=unknown"
msgid "　間違いない、なんという悲劇、と副会長は落雷を受けたかのような頭痛にもだえた。"
msgstr ""

#. Occurrence 2_2:2012:2376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0028; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2012
msgctxt "text_id=2376 | speaker=tobimaru"
msgid "「なんてこった。おまえ、まさか蒼崎に惚れてんのか？"
msgstr ""

#. Occurrence 2_2:2031:2377: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0029; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2031
msgctxt "text_id=2377 | speaker=tobimaru"
msgid "　そうなのか？　そうなんだな!?　おい、眠ってねえで起きろ！」"
msgstr ""

#. Occurrence 2_2:2078:2378: scene=2_2
#: 2_2:2078
msgctxt "text_id=2378 | speaker=unknown"
msgid "　椅子から立ち上がり、草十郎の両肩を激しくシェイクする鳶丸。"
msgstr ""

#. Occurrence 2_2:2089:2379: scene=2_2
#: 2_2:2089
msgctxt "text_id=2379 | speaker=unknown"
msgid "　仕方なく、むっとした顔で草十郎は目を開けた。"
msgstr ""

#. Occurrence 2_2:2129:2380: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0030; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2129
msgctxt "text_id=2380 | speaker=tobimaru"
msgid "「そうか……おまえは一年前の惨劇を知らないんだな。"
msgstr ""

#. Occurrence 2_2:2135:2381: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0031; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2135
msgctxt "text_id=2381 | speaker=tobimaru"
msgid "　知ってりゃ、そんなストレートな破滅願望を持つ事もなかったろうに」"
msgstr ""

#. Occurrence 2_2:2156:2382: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0021; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2156
msgctxt "text_id=2382 | speaker=soujuurou"
msgid "「……君の言葉には誤解が含まれてるけど、それは後にする。それより、一年前の惨劇って？」"
msgstr ""

#. Occurrence 2_2:2176:2383: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0032; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2176
msgctxt "text_id=2383 | speaker=tobimaru"
msgid "「―――む」"
msgstr ""

#. Occurrence 2_2:2232:2384: scene=2_2
#: 2_2:2232
msgctxt "text_id=2384 | speaker=unknown"
msgid "　鳶丸はハッと我に返り、どうしたものかと考えたあげく、どすんと椅子に座る。"
msgstr ""

#. Occurrence 2_2:2244:2385: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0033; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2244
msgctxt "text_id=2385 | speaker=tobimaru"
msgid "「仕方ねえ。この手の噂をするのは好きじゃねえんだけどな」"
msgstr ""

#. Occurrence 2_2:2250:2386: scene=2_2
#: 2_2:2250
msgctxt "text_id=2386 | speaker=unknown"
msgid "　しかしそれも青少年の輝かしい未来のためだ、と鳶丸は自己肯定した。"
msgstr ""

#. Occurrence 2_2:2294:2387: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0034; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2294
msgctxt "text_id=2387 | speaker=tobimaru"
msgid "「あれは蒼崎がまだ一年の頃の話だ。"
msgstr ""

#. Occurrence 2_2:2336:2388: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0035; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2336
msgctxt "text_id=2388 | speaker=tobimaru"
msgid "　あの頃はみんな入学したばっかりで、蒼崎がどんな性格か誰も知らなかった。"
msgstr ""

#. Occurrence 2_2:2353:2389: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0036; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2353
msgctxt "text_id=2389 | speaker=tobimaru"
msgid "　あいつ、外見は文句なしに美人だからな。"
msgstr ""

#. Occurrence 2_2:2359:2390: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0037; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2359
msgctxt "text_id=2390 | speaker=tobimaru"
msgid "　そりゃあ男どもは狂喜乱舞したもんさ」"
msgstr ""

#. Occurrence 2_2:2376:2391: scene=2_2
#: 2_2:2376
msgctxt "text_id=2391 | speaker=unknown"
msgid "　そして、後に違った意味で狂喜乱舞する事になるとは、誰ひとり夢にも思わなかったのである。"
msgstr ""

#. Occurrence 2_2:2416:2392: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0038; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2416
msgctxt "text_id=2392 | speaker=tobimaru"
msgid "「四月、五月はもう上を下への大騒ぎでよ。"
msgstr ""

#. Occurrence 2_2:2422:2393: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0039; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2422
msgctxt "text_id=2393 | speaker=tobimaru"
msgid "　あの時ばかりは上級生も下級生もなかったな。"
msgstr ""

#. Occurrence 2_2:2428:2394: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0040; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2428
msgctxt "text_id=2394 | speaker=tobimaru"
msgid "　野郎同士の牽制、共闘、はては決闘まで、まあよくも騒いだもんさ。蒼崎に近寄るだけでも大変だったんだぜ？」"
msgstr ""

#. Occurrence 2_2:2464:2395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0022; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2464
msgctxt "text_id=2395 | speaker=soujuurou"
msgid "「？　なんでそんなよく分からない事態になるんだ？」"
msgstr ""

#. Occurrence 2_2:2502:2396: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0041; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2502
msgctxt "text_id=2396 | speaker=tobimaru"
msgid "「そりゃ蒼崎はひとりきり、命知らずな野郎はのべ百人ほどいたからだよ。"
msgstr ""

#. Occurrence 2_2:2508:2397: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0042; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2508
msgctxt "text_id=2397 | speaker=tobimaru"
msgid "　ひとりひとり蒼崎とランチしても三ヶ月かかるだろ？"
msgstr ""

#. Occurrence 2_2:2519:2398: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0043; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2519
msgctxt "text_id=2398 | speaker=tobimaru"
msgid "　だから、まずは男同士でつまんねえ暗闘があったのさ」"
msgstr ""

#. Occurrence 2_2:2550:2399: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0023; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2550
msgctxt "text_id=2399 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 2_2:2556:2400: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0044; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2556
msgctxt "text_id=2400 | speaker=tobimaru"
msgid "「ま、いい。分からねえんならそこは飛ばそう。<所詮|しょせん>負け犬どもの話だしな、本筋にはなりえねえ」"
msgstr ""

#. Occurrence 2_2:2613:2401: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0045; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2613
msgctxt "text_id=2401 | speaker=tobimaru"
msgid "「でな。そんなどうでもいい戦いを勝ち残ったヤツらは列なして一年の女に言い寄ったワケだ。"
msgstr ""

#. Occurrence 2_2:2619:2402: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0046; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2619
msgctxt "text_id=2402 | speaker=tobimaru"
msgid "　蒼崎はアレでなんていうか、相手のなけなしの誠意？　じゃなくてアレか、勇気？　そういうの、無視できずに認めちまうヤツだからな。"
msgstr ""

#. Occurrence 2_2:2625:2403: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0047; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2625
msgctxt "text_id=2403 | speaker=tobimaru"
msgid "　言い寄ってくる相手を可能なかぎり丁寧に断ってた」"
msgstr ""

#. Occurrence 2_2:2670:2404: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0048; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2670
msgctxt "text_id=2404 | speaker=tobimaru"
msgid "「が、中にはそれで勘違いしちまう奴もいてよ。"
msgstr ""

#. Occurrence 2_2:2676:2405: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0049; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2676
msgctxt "text_id=2405 | speaker=tobimaru"
msgid "　三年のある野郎がこれは脈アリと見て蒼崎に何度も言い寄ったんだよ。"
msgstr ""

#. Occurrence 2_2:2682:2406: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0050; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2682
msgctxt "text_id=2406 | speaker=tobimaru"
msgid "　……たぶん、そいつ頭がおかしかったんだ。今にして思うと、そうとしか思えん」"
msgstr ""

#. Occurrence 2_2:2688:2407: scene=2_2
#: 2_2:2688
msgctxt "text_id=2407 | speaker=unknown"
msgid "　ちなみに、その三年生とやらが前期の生徒会長である事を、鳶丸は秘する事にした。"
msgstr ""

#. Occurrence 2_2:2739:2408: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0051; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2739
msgctxt "text_id=2408 | speaker=tobimaru"
msgid "「学園ばかりか蒼崎の家まで押しかけたそうでな。"
msgstr ""

msgctxt "text_id=2409 | speaker=unknown"
msgid "あまりにしつこいんで蒼崎も堪忍袋の緒が切れたんだろう。ちょっと、口にするのは<憚|はばか>られる方法でふったんだよ」"
msgstr ""

#. Occurrence 2_2:2816:2410: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0052; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2816
msgctxt "text_id=2410 | speaker=tobimaru"
msgid "「結果、そいつは自分から他校に転入希望したばかりか三咲町からも逃げ出しちまって、蒼崎も一ヶ月ばかり自宅謹慎を食らった。"
msgstr ""

#. Occurrence 2_2:2822:2411: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0053; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2822
msgctxt "text_id=2411 | speaker=tobimaru"
msgid "　世に言う血の公会堂事件だ。"
msgstr ""

#. Occurrence 2_2:2828:2412: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0054; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2828
msgctxt "text_id=2412 | speaker=tobimaru"
msgid "　詳しく知りたけりゃ本人………はまずいな、新聞部にでもいけ。あそこの部長は命知らずだから、訊けば面白がって教えてくれる」"
msgstr ""

#. Occurrence 2_2:2895:2413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0024; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2895
msgctxt "text_id=2413 | speaker=soujuurou"
msgid "「……鳶丸。その、具体的な表現を故意に避けてないか？」"
msgstr ""

#. Occurrence 2_2:2919:2414: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0055; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2919
msgctxt "text_id=2414 | speaker=tobimaru"
msgid "「仕方ねえだろ。理事長の息子だろうが何だろうが怖いものは怖ぇし、高校ぐらいは無事卒業しとかねえとな。"
msgstr ""

#. Occurrence 2_2:2930:2415: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0056; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2930
msgctxt "text_id=2415 | speaker=tobimaru"
msgid "　うちの女子の制服みるたびに奇声をあげるトラウマなんて持ちたくねえよ」"
msgstr ""

#. Occurrence 2_2:2977:2416: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0025; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2977
msgctxt "text_id=2416 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 2_2:2983:2417: scene=2_2
#: 2_2:2983
msgctxt "text_id=2417 | speaker=unknown"
msgid "　むう、と納得いかなげに首をかしげる草十郎。"
msgstr ""

#. Occurrence 2_2:2988:2418: scene=2_2
#: 2_2:2988
msgctxt "text_id=2418 | speaker=unknown"
msgid "　鳶丸の言わんとするところが、彼にはさっぱり分からない。"
msgstr ""

#. Occurrence 2_2:3032:2419: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0057; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3032
msgctxt "text_id=2419 | speaker=tobimaru"
msgid "「まあいい。"
msgstr ""

#. Occurrence 2_2:3038:2420: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0058; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3038
msgctxt "text_id=2420 | speaker=tobimaru"
msgid "　それより、なんで蒼崎なんかがいいんだよ、草十郎」"
msgstr ""

#. Occurrence 2_2:3066:2421: scene=2_2
#: 2_2:3066
msgctxt "text_id=2421 | speaker=unknown"
msgid "　言われて、今度は逆の方向に、はて、と草十郎は首をかしげた。"
msgstr ""

#. Occurrence 2_2:3093:2422: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0059; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3093
msgctxt "text_id=2422 | speaker=tobimaru"
msgid "「おい。おまえ、本当に蒼崎が好きなのか？"
msgstr ""

#. Occurrence 2_2:3099:2423: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0060; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3099
msgctxt "text_id=2423 | speaker=tobimaru"
msgid "　たんに胸がドキドキいってるだけなら、それは恋じゃなくて恐怖だってオチもあるぜ。いくら草の字がぼんやりでも理由ってもんがあるだろ？」"
msgstr ""

#. Occurrence 2_2:3105:2424: scene=2_2
#: 2_2:3105
msgctxt "text_id=2424 | speaker=unknown"
msgid "　草十郎はさらに首をかしげる。"
msgstr ""

#. Occurrence 2_2:3152:2425: scene=2_2
#: 2_2:3152
msgctxt "text_id=2425 | speaker=unknown"
msgid "　鳶丸の言い分には<語弊|ごへい>があるが、とりあえず今はそれを抜きにするとして。"
msgstr ""

#. Occurrence 2_2:3157:2426: scene=2_2
#: 2_2:3157
msgctxt "text_id=2426 | speaker=unknown"
msgid "　草十郎自身、蒼崎青子に抱く感情には理解できないものが多すぎた。"
msgstr ""

#. Occurrence 2_2:3183:2427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0026; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3183
msgctxt "text_id=2427 | speaker=soujuurou"
msgid "「そうだな、おかしい。俺は、あまり彼女を知らないのにね」"
msgstr ""

#. Occurrence 2_2:3206:2428: scene=2_2
#: 2_2:3206
msgctxt "text_id=2428 | speaker=unknown"
msgid "　それもその筈、創立記念日の案内以来、学園内において草十郎と青子は一度も話していないのだ。"
msgstr ""

#. Occurrence 2_2:3211:2429: scene=2_2
#: 2_2:3211
msgctxt "text_id=2429 | speaker=unknown"
msgid "　草十郎が話し掛けようとすると青子は素早く立ち去ってしまう。"
msgstr ""

#. Occurrence 2_2:3216:2430: scene=2_2
#: 2_2:3216
msgctxt "text_id=2430 | speaker=unknown"
msgid "　この間の日曜日には縁あって労働を共にしたが、あれだって往復時間に軽く話した程度である。"
msgstr ""

#. Occurrence 2_2:3257:2431: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0027; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3257
msgctxt "text_id=2431 | speaker=soujuurou"
msgid "「けど鳶丸、君は知らないだけなんだ。"
msgstr ""

#. Occurrence 2_2:3263:2432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0028; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3263
msgctxt "text_id=2432 | speaker=soujuurou"
msgid "　時々なんだが、誰かの視線を感じて振り返ってみると、いつ失敗するかを心配して見ている人がいる。"
msgstr ""

#. Occurrence 2_2:3269:2433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0029; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3269
msgctxt "text_id=2433 | speaker=soujuurou"
msgid "　鳶丸の言うとおり、ただ廊下で俺を見かけて、たんに監視していただけなのかも知れない。本当は俺の事なんて気にせず素通りしたいのかも知れない。"
msgstr ""

#. Occurrence 2_2:3275:2434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0030; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3275
msgctxt "text_id=2434 | speaker=soujuurou"
msgid "　けど、どんな種類であれ彼女の心配は本物だ」"
msgstr ""

#. Occurrence 2_2:3333:2435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0031; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3333
msgctxt "text_id=2435 | speaker=soujuurou"
msgid "「それに、ここが一番大事だと思うんだけど。"
msgstr ""

#. Occurrence 2_2:3339:2436: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0032; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3339
msgctxt "text_id=2436 | speaker=soujuurou"
msgid "　実際の話、蒼崎のそういうところのおかげで、俺は助かっていたりするんだ」"
msgstr ""

#. Occurrence 2_2:3384:2437: scene=2_2
#: 2_2:3384
msgctxt "text_id=2437 | speaker=unknown"
msgid "　何の気負いもなく、真剣に彼は言った。"
msgstr ""

#. Occurrence 2_2:3389:2438: scene=2_2
#: 2_2:3389
msgctxt "text_id=2438 | speaker=unknown"
msgid "　それを聞いた鳶丸は軽い後悔と共に、ため息などをこぼしてしまう。"
msgstr ""

#. Occurrence 2_2:3415:2439: scene=2_2
#: 2_2:3415
msgctxt "text_id=2439 | speaker=unknown"
msgid "　今の台詞さえ聞かなければ適当な女生徒を紹介して、草十郎が平穏な高校生活を送れるよう段取っただろうに。"
msgstr ""

#. Occurrence 2_2:3433:2440: scene=2_2
#: 2_2:3433
msgctxt "text_id=2440 | speaker=unknown"
msgid "　本来、彼がそこまで男友達のために骨折るコトはない。"
msgstr ""

#. Occurrence 2_2:3438:2441: scene=2_2
#: 2_2:3438
msgctxt "text_id=2441 | speaker=unknown"
msgid "　利用できる相手なら損得のために騙しあい、助け合う。"
msgstr ""

#. Occurrence 2_2:3443:2442: scene=2_2
#: 2_2:3443
msgctxt "text_id=2442 | speaker=unknown"
msgid "　利用できない人間は、そも利用するべきではないと判断して距離を置くのが槻司鳶丸の信念だ。"
msgstr ""

#. Occurrence 2_2:3448:2443: scene=2_2
#: 2_2:3448
msgctxt "text_id=2443 | speaker=unknown"
msgid "　そんな彼をして、静希草十郎は益を得る相手ではないクセに、手を貸したくなる人種だった。"
msgstr ""

#. Occurrence 2_2:3512:2444: scene=2_2
#: 2_2:3512
msgctxt "text_id=2444 | speaker=unknown"
msgid "　彼は友情には<疎|うと>くなかったが、"
msgstr ""

#. Occurrence 2_2:3517:2445: scene=2_2
#: 2_2:3517
msgctxt "text_id=2445 | speaker=unknown"
msgid "　友人と呼べる人物にはそう恵まれていなかった。"
msgstr ""

#. Occurrence 2_2:3523:2446: scene=2_2
#: 2_2:3523
msgctxt "text_id=2446 | speaker=unknown"
msgid "　……なので、草十郎が本気で青子に惚れているのなら、友人として、それを改めさせる野暮はできなかった。"
msgstr ""

#. Occurrence 2_2:3576:2447: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0061; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3576
msgctxt "text_id=2447 | speaker=tobimaru"
msgid "「……やれやれ。結局、惚れてる奴にゃあ理由なんていらねえんだな」"
msgstr ""

#. Occurrence 2_2:3589:2448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2448 | speaker=soujuurou"
msgid "「そんな事はない。理由ならひとつある。"
msgstr ""

#. Occurrence 2_2:3589:2449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2449 | speaker=soujuurou"
msgid "　彼女を<一目|ひとめ>みた時に、綺麗だなって思ったぞ」"
msgstr ""

#. Occurrence 2_2:3601:2450: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0062; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3601
msgctxt "text_id=2450 | speaker=tobimaru"
msgid "「あ？」"
msgstr ""

#. Occurrence 2_2:3606:2451: scene=2_2
#: 2_2:3606
msgctxt "text_id=2451 | speaker=unknown"
msgid "　がくん、と肩を落とす鳶丸。"
msgstr ""

#. Occurrence 2_2:3641:2452: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0063; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3641
msgctxt "text_id=2452 | speaker=tobimaru"
msgid "「なんだぁ!?　あんだけ恥ずかしい台詞いっといて、要は外見に惚れてますだあ？　結局見てくれかよ草十郎！」"
msgstr ""

#. Occurrence 2_2:3647:2453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0034; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3647
msgctxt "text_id=2453 | speaker=soujuurou"
msgid "「綺麗なものに見惚れるのは、いいことじゃないのか？"
msgstr ""

#. Occurrence 2_2:3653:2454: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0035; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3653
msgctxt "text_id=2454 | speaker=soujuurou"
msgid "　自分を綺麗に見せる努力をしているんだから、外見から内面を判断するのは、そんなおかしな話じゃないと思う」"
msgstr ""

#. Occurrence 2_2:3674:2455: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0064; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3674
msgctxt "text_id=2455 | speaker=tobimaru"
msgid "「む」"
msgstr ""

#. Occurrence 2_2:3679:2456: scene=2_2
#: 2_2:3679
msgctxt "text_id=2456 | speaker=unknown"
msgid "　詭弁のようではあるが、なんとなく正論のような気もする。"
msgstr ""

#. Occurrence 2_2:3706:2457: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0065; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3706
msgctxt "text_id=2457 | speaker=tobimaru"
msgid "「……しょうがねえ、分かったよ。この話はもう止めよう。草の字が誰を<自分|テメエ>の女にするか、俺の知った事じゃねえし」"
msgstr ""

#. Occurrence 2_2:3747:2458: scene=2_2
#: 2_2:3747
msgctxt "text_id=2458 | speaker=unknown"
msgid "　さて。"
msgstr ""

#. Occurrence 2_2:3752:2459: scene=2_2
#: 2_2:3752
msgctxt "text_id=2459 | speaker=unknown"
msgid "　ここで、鳶丸はひとつ、大きな勘違いをしていた。"
msgstr ""

#. Occurrence 2_2:3757:2460: scene=2_2
#: 2_2:3757
msgctxt "text_id=2460 | speaker=unknown"
msgid "　静希草十郎は蒼崎青子に好意を持っているだけであって、別に、心の底から好きだとか、恋人として付き合いたいなんて願望は、むしろ一片も無かった、という点である。"
msgstr ""

#. Occurrence 2_2:3763:2461: scene=2_2
#: 2_2:3763
msgctxt "text_id=2461 | speaker=unknown"
msgid "　この勘違いが後に大きな禍根となるコトを、神ならざる彼らが気付くよしもない。"
msgstr ""

#. Occurrence 2_2:3803:2462: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0066; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3803
msgctxt "text_id=2462 | speaker=tobimaru"
msgid "「だがよ、ひとつだけ忠告しておくぜ草十郎。"
msgstr ""

#. Occurrence 2_2:3810:2463: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_0; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3810
msgctxt "text_id=2463 | speaker=tobimaru"
msgid "蒼崎はケンカをした相手だろうと別に嫌うワケじゃない。逆に言えば、親切にしたって別に好かれるワケでもない。"
msgstr ""

#. Occurrence 2_2:3824:2464: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_1; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3824
msgctxt "text_id=2464 | speaker=tobimaru"
msgid "いい例が俺だ」"
msgstr ""

#. Occurrence 2_2:3830:2465: scene=2_2
#: 2_2:3830
msgctxt "text_id=2465 | speaker=unknown"
msgid "　過去の傷心を思いだしたのか、鳶丸は重いため息とともに語る。"
msgstr ""

#. Occurrence 2_2:3879:2466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0036; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3879
msgctxt "text_id=2466 | speaker=soujuurou"
msgid "「そうか、"
msgstr ""

msgctxt "text_id=2467 | speaker=unknown"
msgid "詳しく」"
msgstr ""

#. Occurrence 2_2:3924:2468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0068; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3924
msgctxt "text_id=2468 | speaker=tobimaru"
msgid "「おう。昔な、あいつがあんまりに独善的だったんでつい手をあげかけちまった事がある。"
msgstr ""

#. Occurrence 2_2:3930:2469: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0069; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3930
msgctxt "text_id=2469 | speaker=tobimaru"
msgid "　半年前の夏だ。一年もあいつと生徒会やってたもんだから、俺も女っつーより戦友って気になっててな。"
msgstr ""

#. Occurrence 2_2:3936:2470: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0070; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3936
msgctxt "text_id=2470 | speaker=tobimaru"
msgid "　つい勢いで平手打ちをしようと右手をあげた。―――我ながら四番<打者|バッター>もかくやという腰のひねり。たしかな実感とともに、俺は勝利を確信したもんさ」"
msgstr ""

#. Occurrence 2_2:3970:2471: scene=2_2
#: 2_2:3970
msgctxt "text_id=2471 | speaker=unknown"
msgid "　ふっ、と遠い目をする彼は、その後の<顛末|てんまつ>を話そうとはしなかった。"
msgstr ""

#. Occurrence 2_2:4017:2472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0071; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4017
msgctxt "text_id=2472 | speaker=tobimaru"
msgid "「翌日になって、こりゃあ完全に敵扱いされたな、と覚悟して生徒会室にいってみりゃあ、蒼崎はいつも通りだった。"
msgstr ""

#. Occurrence 2_2:4023:2473: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0072; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4023
msgctxt "text_id=2473 | speaker=tobimaru"
msgid "　で、以来あいつと俺は会長と副会長で納まってる」"
msgstr ""

#. Occurrence 2_2:4070:2474: scene=2_2
#: 2_2:4070
msgctxt "text_id=2474 | speaker=unknown"
msgid "　話を聞き終わり、ふーん、と感想を漏らす草十郎。"
msgstr ""

#. Occurrence 2_2:4075:2475: scene=2_2
#: 2_2:4075
msgctxt "text_id=2475 | speaker=unknown"
msgid "　そうして自信を持って、"
msgstr ""

#. Occurrence 2_2:4109:2476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0037; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4109
msgctxt "text_id=2476 | speaker=soujuurou"
msgid "「いまの話を総合すると、君はたんに<惚気|のろけ>たいのか？」"
msgstr ""

#. Occurrence 2_2:4115:2477: scene=2_2
#: 2_2:4115
msgctxt "text_id=2477 | speaker=unknown"
msgid "　真顔で、まったく分かってない感想を口にするのだった。"
msgstr ""

#. Occurrence 2_2:4171:2478: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0073; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4171
msgctxt "text_id=2478 | speaker=tobimaru"
msgid "「んなワケあるかぁ！！！！　"
msgstr ""

msgctxt "text_id=2479 | speaker=unknown"
msgid "いまの話のどこに甘ずっぱい要素があんだよ！？"
msgstr ""

#. Occurrence 2_2:4185:2480: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0074; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4185
msgctxt "text_id=2480 | speaker=tobimaru"
msgid "　"
msgstr ""

msgctxt "text_id=2481 | speaker=unknown"
msgid "俺としちゃあ、あいつを女として見なくなった決定的な事件だったんだがねぇ！？」"
msgstr ""

#. Occurrence 2_2:4199:2482: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0038; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4199
msgctxt "text_id=2482 | speaker=soujuurou"
msgid "「なんだ、違うのか」"
msgstr ""

#. Occurrence 2_2:4227:2483: scene=2_2
#: 2_2:4227
msgctxt "text_id=2483 | speaker=unknown"
msgid "　もったいない、と不満そうに漏らす草十郎。"
msgstr ""

#. Occurrence 2_2:4232:2484: scene=2_2
#: 2_2:4232
msgctxt "text_id=2484 | speaker=unknown"
msgid "　……この男、単純のようで底が知れぬのかも、と鳶丸は考えを改めた。"
msgstr ""

#. Occurrence 2_2:4281:2485: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0075; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4281
msgctxt "text_id=2485 | speaker=tobimaru"
msgid "「とにかくだ。俺が言いたいのは、蒼崎青子の“好き嫌いの基準”ってのは普通じゃないって事だ。"
msgstr ""

#. Occurrence 2_2:4287:2486: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0076; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4287
msgctxt "text_id=2486 | speaker=tobimaru"
msgid "いいコトをすれば好かれる、気に入らないコトをすれば嫌われる、ってワケじゃねえんだよ、あのお姫さまは」"
msgstr ""

#. Occurrence 2_2:4306:2487: scene=2_2
#: 2_2:4306
msgctxt "text_id=2487 | speaker=unknown"
msgid "　参考にするよ、と答えて草十郎は時計を見る。"
msgstr ""

#. Occurrence 2_2:4311:2488: scene=2_2
#: 2_2:4311
msgctxt "text_id=2488 | speaker=unknown"
msgid "　長話がすぎたらしい。昼休みは残り少なくなっていた。"
msgstr ""

#. Occurrence 2_2:4332:2489: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0039; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4332
msgctxt "text_id=2489 | speaker=soujuurou"
msgid "「もう君からの話はないか？」"
msgstr ""

#. Occurrence 2_2:4338:2490: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0077; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4338
msgctxt "text_id=2490 | speaker=tobimaru"
msgid "「あ？　はじめからねえよ、そんなの」"
msgstr ""

#. Occurrence 2_2:4359:2491: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0040; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4359
msgctxt "text_id=2491 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 2_2:4365:2492: scene=2_2
#: 2_2:4365
msgctxt "text_id=2492 | speaker=unknown"
msgid "　なら何故この男は自分をここに連れこんだのだろう？　と首をかしげる草十郎だったが、今は他に本題がある。"
msgstr ""

#. Occurrence 2_2:4406:2493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2493 | speaker=soujuurou"
msgid "「よし。じゃあもう少し付きあってくれ。"
msgstr ""

#. Occurrence 2_2:4406:2494: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2494 | speaker=soujuurou"
msgid "　鳶丸に訊きたいことがあったんだ」"
msgstr ""

#. Occurrence 2_2:4412:2495: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0078; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4412
msgctxt "text_id=2495 | speaker=tobimaru"
msgid "「？」"
msgstr ""

#. Occurrence 2_2:4451:2496: scene=2_2
#: 2_2:4451
msgctxt "text_id=2496 | speaker=unknown"
msgid "　今までにない真剣な表情の草十郎に、思わず姿勢を正す鳶丸。"
msgstr ""

#. Occurrence 2_2:4456:2497: scene=2_2
#: 2_2:4456
msgctxt "text_id=2497 | speaker=unknown"
msgid "　食べかけのおにぎりもそのままに、ゴホン、と草十郎は咳払いをする。"
msgstr ""

#. Occurrence 2_2:4505:2498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0042; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4505
msgctxt "text_id=2498 | speaker=soujuurou"
msgid "「―――実は昨日、こんなコトがあって……」"
msgstr ""

#. Occurrence 2_2:4511:2499: scene=2_2
#: 2_2:4511
msgctxt "text_id=2499 | speaker=unknown"
msgid "　語りだしは厳かに。"
msgstr ""

#. Occurrence 2_2:4516:2500: scene=2_2
#: 2_2:4516
msgctxt "text_id=2500 | speaker=unknown"
msgid "　草十郎はできるだけ正確に、昨夜出会ったある出来事について話し始めた。"
msgstr ""

#. Occurrence 2_3:50:2501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0000; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:50
msgctxt "text_id=2501 | speaker=aoko"
msgid "「静希君、いる？」"
msgstr ""

#. Occurrence 2_3:56:2502: scene=2_3
#: 2_3:56
msgctxt "text_id=2502 | speaker=unknown"
msgid "　昼休みも終わろうとしている十二時五十分。"
msgstr ""

#. Occurrence 2_3:61:2503: scene=2_3
#: 2_3:61
msgctxt "text_id=2503 | speaker=unknown"
msgid "　一向に活気の<衰|おとろ>えない二年Ｃ組の教室に顔を出し、"
msgstr ""

#. Occurrence 2_3:66:2504: scene=2_3
#: 2_3:66
msgctxt "text_id=2504 | speaker=unknown"
msgid "　……彼女にとってはごく普通の仕草で……"
msgstr ""

#. Occurrence 2_3:71:2505: scene=2_3
#: 2_3:71
msgctxt "text_id=2505 | speaker=unknown"
msgid "　蒼崎青子はそう告げた。"
msgstr ""

#. Occurrence 2_3:105:2506: scene=2_3
#: 2_3:105
msgctxt "text_id=2506 | speaker=unknown"
msgid "　青子にとってＣ組は<余所|よそ>のクラスだが、そんな事はおかまいなしで気軽に教室へと入っていく。"
msgstr ""

#. Occurrence 2_3:151:2507: scene=2_3
#: 2_3:151
msgctxt "text_id=2507 | speaker=unknown"
msgid "　一方。リラックスした彼女とは対照的に、今まで餌を前にした<雛鳥|ひなどり>の如く騒がしかった生徒達は白々しいほど静かに、行儀よく席につきはじめた。"
msgstr ""

#. Occurrence 2_3:192:2508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0001; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:192
msgctxt "text_id=2508 | speaker=aoko"
msgid "『……どういう意味よ、それ……』"
msgstr ""

#. Occurrence 2_3:198:2509: scene=2_3
#: 2_3:198
msgctxt "text_id=2509 | speaker=unknown"
msgid "　内心で舌打ちしつつ、青子は教室を見回した。"
msgstr ""

#. Occurrence 2_3:203:2510: scene=2_3
#: 2_3:203
msgctxt "text_id=2510 | speaker=unknown"
msgid "　目当ての男子生徒の姿はない。"
msgstr ""

#. Occurrence 2_3:208:2511: scene=2_3
#: 2_3:208
msgctxt "text_id=2511 | speaker=unknown"
msgid "　目立たない奴だから、はじっこに隠れているかと思えばそうでもなさそうだ。"
msgstr ""

#. Occurrence 2_3:242:2512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0002; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:242
msgctxt "text_id=2512 | speaker=aoko"
msgid "「有里君。出席番号12番の静希君は？」"
msgstr ""

#. Occurrence 2_3:247:2513: scene=2_3
#: 2_3:247
msgctxt "text_id=2513 | speaker=unknown"
msgid "　青子はあくまで事務的に問う。"
msgstr ""

#. Occurrence 2_3:253:2514: voice_id=E70_2_3_0000; voice_prefix=E70; voice_category=0; scene=2_3
#: 2_3:253
msgctxt "text_id=2514 | speaker=unknown"
msgid "「え、俺……？　えーと、静希ならさっき鳶丸<殿下|でんか>が連れていったよ」"
msgstr ""

#. Occurrence 2_3:258:2515: scene=2_3
#: 2_3:258
msgctxt "text_id=2515 | speaker=unknown"
msgid "　名前を呼ばれた男子生徒は、青子が自分の名前を知っている事に驚きつつ返答した。"
msgstr ""

#. Occurrence 2_3:284:2516: scene=2_3
#: 2_3:284
msgctxt "text_id=2516 | speaker=unknown"
msgid "　余談ではあるが、<槻司|つきじ><鳶丸|とびまる>が殿下と呼ばれるのは彼が理事長の息子だから……という訳でもなく、純粋に彼の振るまいが王子のようだからである。"
msgstr ""

#. Occurrence 2_3:289:2517: scene=2_3
#: 2_3:289
msgctxt "text_id=2517 | speaker=unknown"
msgid "　本人もそのアダ名は気に入っているらしい。"
msgstr ""

#. Occurrence 2_3:316:2518: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0003; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:316
msgctxt "text_id=2518 | speaker=aoko"
msgid "「鳶丸が……？　あいつ、静希君と仲いいの？」"
msgstr ""

#. Occurrence 2_3:337:2519: scene=2_3
#: 2_3:337
msgctxt "text_id=2519 | speaker=unknown"
msgid "　意外そうに訊く青子と、"
msgstr ""

#. Occurrence 2_3:342:2520: scene=2_3
#: 2_3:342
msgctxt "text_id=2520 | speaker=unknown"
msgid "　その台詞を意外そうに聞くクラス一同。"
msgstr ""

#. Occurrence 2_3:364:2521: voice_id=D90_2_3_0000; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:364
msgctxt "text_id=2521 | speaker=unknown"
msgid "「良いも悪いも、槻司くんが男子と仲良く話してるのって今まで見たことなかったよ、あたし達。"
msgstr ""

#. Occurrence 2_3:370:2522: voice_id=D90_2_3_0001; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:370
msgctxt "text_id=2522 | speaker=unknown"
msgid "　あ、木乃美くんはバカだから別だけど」"
msgstr ""

#. Occurrence 2_3:376:2523: voice_id=E20_2_3_0000; voice_prefix=E20; voice_category=0; scene=2_3
#: 2_3:376
msgctxt "text_id=2523 | speaker=unknown"
msgid "「そうだよなあ。はじめは殿下もあんまり話してなかったけど、三日もしたら楽しそうに口喧嘩してたもんなぁ」"
msgstr ""

#. Occurrence 2_3:382:2524: voice_id=E30_2_3_0000; voice_prefix=E30; voice_category=0; scene=2_3
#: 2_3:382
msgctxt "text_id=2524 | speaker=unknown"
msgid "「ま、静希相手につっぱっても仕方ないじゃん？　あいつ変だけどいい奴だし」"
msgstr ""

#. Occurrence 2_3:388:2525: voice_id=E10_2_3_0000; voice_prefix=E10; voice_category=0; scene=2_3
#: 2_3:388
msgctxt "text_id=2525 | speaker=unknown"
msgid "「そーよねー。いい人だもんねー草十郎くん！」"
msgstr ""

#. Occurrence 2_3:422:2526: scene=2_3
#: 2_3:422
msgctxt "text_id=2526 | speaker=unknown"
msgid "　調子を取り戻しつつあるのか、二年Ｃ組の面々はざわざわと会話をリレーしはじめる。"
msgstr ""

#. Occurrence 2_3:440:2527: scene=2_3
#: 2_3:440
msgctxt "text_id=2527 | speaker=unknown"
msgid "　それをしばらく聞いていた青子だったが、唐突にくるりと背を向け、"
msgstr ""

msgctxt "text_id=2528 | speaker=unknown"
msgid "「それじゃ」と二年Ｃ組を後にした。"
msgstr ""

#. Occurrence 2_3:509:2529: scene=2_3
#: 2_3:509
msgctxt "text_id=2529 | speaker=unknown"
msgid "　とりあえず手短に、草十郎の話は済んだ。"
msgstr ""

#. Occurrence 2_3:515:2530: scene=2_3
#: 2_3:515
msgctxt "text_id=2530 | speaker=unknown"
msgid "　昼休みも残り数分と迫った生徒会室。"
msgstr ""

#. Occurrence 2_3:520:2531: scene=2_3
#: 2_3:520
msgctxt "text_id=2531 | speaker=unknown"
msgid "　話し終えて満足顔の草十郎と、"
msgstr ""

#. Occurrence 2_3:525:2532: scene=2_3
#: 2_3:525
msgctxt "text_id=2532 | speaker=unknown"
msgid "　聞き終わって難色顔の鳶丸が、机をはさんで向かいあっている。"
msgstr ""

#. Occurrence 2_3:566:2533: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0000; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:566
msgctxt "text_id=2533 | speaker=soujuurou"
msgid "「さ、感想を聞かせてくれ」"
msgstr ""

#. Occurrence 2_3:572:2534: scene=2_3
#: 2_3:572
msgctxt "text_id=2534 | speaker=unknown"
msgid "　話す事はすべて話した、と草十郎。"
msgstr ""

#. Occurrence 2_3:577:2535: scene=2_3
#: 2_3:577
msgctxt "text_id=2535 | speaker=unknown"
msgid "　鳶丸はというと、怒っているような、悩んでいるような、曖昧な表情で額に指を当てていた。"
msgstr ""

#. Occurrence 2_3:620:2536: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0000; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:620
msgctxt "text_id=2536 | speaker=tobimaru"
msgid "「……なあ、草の字。おまえ、人を馬鹿にできるほど器用な奴じゃねえよな」"
msgstr ""

#. Occurrence 2_3:653:2537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0001; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:653
msgctxt "text_id=2537 | speaker=soujuurou"
msgid "「失礼な。器用な方だぞ、俺は」"
msgstr ""

#. Occurrence 2_3:658:2538: scene=2_3
#: 2_3:658
msgctxt "text_id=2538 | speaker=unknown"
msgid "　その返答に、つくづく不器用な性格だと確信する。"
msgstr ""

#. Occurrence 2_3:663:2539: scene=2_3
#: 2_3:663
msgctxt "text_id=2539 | speaker=unknown"
msgid "　となると結論は二つに一つだ。"
msgstr ""

#. Occurrence 2_3:700:2540: scene=2_3
#: 2_3:700
msgctxt "text_id=2540 | speaker=unknown"
msgid "　一つは、いま聞いた話は真実だという事。"
msgstr ""

#. Occurrence 2_3:705:2541: scene=2_3
#: 2_3:705
msgctxt "text_id=2541 | speaker=unknown"
msgid "　あるいは、彼が幻覚を見るほど疲れきっているという事。"
msgstr ""

#. Occurrence 2_3:715:2542: scene=2_3
#: 2_3:715
msgctxt "text_id=2542 | speaker=unknown"
msgid "　鳶丸としては後者であってほしいものだが……。"
msgstr ""

#. Occurrence 2_3:741:2543: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0001; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:741
msgctxt "text_id=2543 | speaker=tobimaru"
msgid "「……草十郎。率直に言って、俺はおまえが気に入っている。"
msgstr ""

#. Occurrence 2_3:752:2544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0002; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:752
msgctxt "text_id=2544 | speaker=tobimaru"
msgid "　嘘のない人間なんてのは人間じゃねえ。"
msgstr ""

#. Occurrence 2_3:760:2545: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_0; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:760
msgctxt "text_id=2545 | speaker=tobimaru"
msgid "俺は人間嫌いだから、そんなおまえさんが気に入ってたりするんだが……"
msgstr ""

#. Occurrence 2_3:772:2546: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_1; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:772
msgctxt "text_id=2546 | speaker=tobimaru"
msgid "そんなヤツまでバカげたコトを言い出したら、俺は明日から何を頼りに昼メシを食えばいいんだ？」"
msgstr ""

#. Occurrence 2_3:791:2547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0002; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:791
msgctxt "text_id=2547 | speaker=soujuurou"
msgid "「学食で食べればいいんじゃないか？」"
msgstr ""

#. Occurrence 2_3:796:2548: scene=2_3
#: 2_3:796
msgctxt "text_id=2548 | speaker=unknown"
msgid "　あっさりとした一言に、鳶丸はいっそう表情を暗くする。"
msgstr ""

#. Occurrence 2_3:826:2549: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0004; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:826
msgctxt "text_id=2549 | speaker=tobimaru"
msgid "「分かった、はっきり言おう。それは幻覚だ。"
msgstr ""

#. Occurrence 2_3:832:2550: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0005; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:832
msgctxt "text_id=2550 | speaker=tobimaru"
msgid "　幽霊の正体見たり<枯|か>れ<尾花|おばな>ってヤツだろうさ。それでも納得いかないってんなら、いい精神科を紹介してやる」"
msgstr ""

#. Occurrence 2_3:858:2551: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0003; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:858
msgctxt "text_id=2551 | speaker=soujuurou"
msgid "「それが君の感想か。よし、ならいいんだ」"
msgstr ""

#. Occurrence 2_3:863:2552: scene=2_3
#: 2_3:863
msgctxt "text_id=2552 | speaker=unknown"
msgid "　聞きようによっては侮辱としか取れない鳶丸の言葉を、草十郎は<泰然|たいぜん>と受けとめた。"
msgstr ""

#. Occurrence 2_3:889:2553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0004; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:889
msgctxt "text_id=2553 | speaker=soujuurou"
msgid "「そりゃあ俺だって神隠しの<類|たぐい>だと思ったよ。"
msgstr ""

#. Occurrence 2_3:900:2554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0005; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:900
msgctxt "text_id=2554 | speaker=soujuurou"
msgid "　けど、都会じゃもしかしてそれも有りなのかもしれないだろ。確かめたかったのはそこなんだ」"
msgstr ""

#. Occurrence 2_3:928:2555: scene=2_3
#: 2_3:928
msgctxt "text_id=2555 | speaker=unknown"
msgid "　良かった、とばかりに草十郎は残った最後の握り飯をぺろっと平らげ、包み布をたたむ。"
msgstr ""

#. Occurrence 2_3:955:2556: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0006; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:955
msgctxt "text_id=2556 | speaker=tobimaru"
msgid "「……おい。すると何か？"
msgstr ""

#. Occurrence 2_3:961:2557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0007; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:961
msgctxt "text_id=2557 | speaker=tobimaru"
msgid "　おまえは都会の人間は口から火を吹いたり、腕が伸びたりするのが普通だと思ったのか？」"
msgstr ""

#. Occurrence 2_3:967:2558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0006; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:967
msgctxt "text_id=2558 | speaker=soujuurou"
msgid "「……まあ、普通じゃないけど、特別でもないんじゃないかと思ったんだ。"
msgstr ""

#. Occurrence 2_3:973:2559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0007; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:973
msgctxt "text_id=2559 | speaker=soujuurou"
msgid "　ここは山に無い物があふれている、何でもありの場所だ。だから、それぐらいやってのける人だって、もしかしているのかなと」"
msgstr ""

#. Occurrence 2_3:1015:2560: scene=2_3
#: 2_3:1015
msgctxt "text_id=2560 | speaker=unknown"
msgid "　真顔で返す草十郎を見て、鳶丸は自分と彼を<隔|へだ>てている文化レベルの違いを痛感した。"
msgstr ""

#. Occurrence 2_3:1020:2561: scene=2_3
#: 2_3:1020
msgctxt "text_id=2561 | speaker=unknown"
msgid "　電気も通わない山奥。"
msgstr ""

#. Occurrence 2_3:1025:2562: scene=2_3
#: 2_3:1025
msgctxt "text_id=2562 | speaker=unknown"
msgid "　夜は太古のままの夜で、人間は主役ではなくどうでもいい端役、自然を構築する一パーツに留まっているのなら、たしかに、この少年のような人間が出来るのだろう。"
msgstr ""

#. Occurrence 2_3:1070:2563: scene=2_3
#: 2_3:1070
msgctxt "text_id=2563 | speaker=unknown"
msgid "　赤子が無垢なまま成長したと言えば聞こえはいいが、要は人が少なすぎて文明が発達するまでもなかった、"
msgstr ""

#. Occurrence 2_3:1075:2564: scene=2_3
#: 2_3:1075
msgctxt "text_id=2564 | speaker=unknown"
msgid "　あるいは、余分な知識体系を必要としなかった素朴な世界だったのだ。"
msgstr ""

#. Occurrence 2_3:1081:2565: scene=2_3
#: 2_3:1081
msgctxt "text_id=2565 | speaker=unknown"
msgid "　都会の生活を“今までの生活では全てありえなかった事”と感じる彼だからこそ、逆説的に、“起こりえる事は全てありえる事”に取ってしまう。"
msgstr ""

#. Occurrence 2_3:1118:2566: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0008; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1118
msgctxt "text_id=2566 | speaker=tobimaru"
msgid "「安心しろ。たしかにこっちには<性質|たち>の悪いヤツらばっかりだけどな、そんな魔法使いみたいなヤツはいねえよ」"
msgstr ""

#. Occurrence 2_3:1124:2567: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0008; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1124
msgctxt "text_id=2567 | speaker=soujuurou"
msgid "「そうだと良いんだけど」"
msgstr ""

#. Occurrence 2_3:1130:2568: scene=2_3
#: 2_3:1130
msgctxt "text_id=2568 | speaker=unknown"
msgid "　どこか納得のいかない様子の草十郎。"
msgstr ""

#. Occurrence 2_3:1135:2569: scene=2_3
#: 2_3:1135
msgctxt "text_id=2569 | speaker=unknown"
msgid "　……確かに、今の話の中で納得のいかない点は鳶丸にもあった。"
msgstr ""

#. Occurrence 2_3:1141:2570: scene=2_3
#: 2_3:1141
msgctxt "text_id=2570 | speaker=unknown"
msgid "アリかナシかはともかくとして、いま聞かされた出来事は人道的によろしくない。"
msgstr ""

#. Occurrence 2_3:1188:2571: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0009; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1188
msgctxt "text_id=2571 | speaker=tobimaru"
msgid "「まあ、事の真偽というか、どんな間違いでそう見えたかは置いておいてだ。"
msgstr ""

#. Occurrence 2_3:1194:2572: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0010; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1194
msgctxt "text_id=2572 | speaker=tobimaru"
msgid "　結果だけ見ればうちの生徒が夜の公園で人を殺したって事になる。しかも双方控えめに表現しても普通じゃねえ」"
msgstr ""

#. Occurrence 2_3:1199:2573: scene=2_3
#: 2_3:1199
msgctxt "text_id=2573 | speaker=unknown"
msgid "　町にやってきて日の浅い草十郎は、同い年の少年少女は『みなこの学校の生徒である』と誤認していたのだが、幸か不幸か結論として間違いではなかった。"
msgstr ""

#. Occurrence 2_3:1230:2574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0011; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1230
msgctxt "text_id=2574 | speaker=tobimaru"
msgid "「一人は火炎放射器を持って、もう一人は……"
msgstr ""

msgctxt "text_id=2575 | speaker=unknown"
msgid "まあ、なんだ。<長刀|なぎなた>でも持ち出したのか、刃物らしきものが何メートルも伸びたときた」"
msgstr ""

#. Occurrence 2_3:1258:2576: scene=2_3
#: 2_3:1258
msgctxt "text_id=2576 | speaker=unknown"
msgid "　鳶丸の呆れ声を聞きながら、なるほど、と小さく頷く草十郎。こうして<他人|ひと>の口から聞くと、相手を馬鹿にしてるとしか思えない内容だ。"
msgstr ""

#. Occurrence 2_3:1301:2577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0009; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1301
msgctxt "text_id=2577 | speaker=soujuurou"
msgid "「正気を疑うな。尋常じゃないぞ、その話」"
msgstr ""

#. Occurrence 2_3:1338:2578: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0012; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1338
msgctxt "text_id=2578 | speaker=tobimaru"
msgid "「草十郎。おまえ、実は俺をからかってんだろう？」"
msgstr ""

#. Occurrence 2_3:1365:2579: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0010; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1365
msgctxt "text_id=2579 | speaker=soujuurou"
msgid "「いや、まったく。"
msgstr ""

#. Occurrence 2_3:1387:2580: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0011; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1387
msgctxt "text_id=2580 | speaker=soujuurou"
msgid "　けどまあ、都会にはそんな人間はいないんだろう？"
msgstr ""

#. Occurrence 2_3:1393:2581: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0012; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1393
msgctxt "text_id=2581 | speaker=soujuurou"
msgid "　なら鳶丸の言う通り、夢でも見てたんだ。ここのところアルバイトと試験が重なって辛くて」"
msgstr ""

#. Occurrence 2_3:1399:2582: scene=2_3
#: 2_3:1399
msgctxt "text_id=2582 | speaker=unknown"
msgid "　今は冬休み直前。期末試験は一週間後に迫っている。草十郎にとっては何よりも手強い難敵だ。"
msgstr ""

#. Occurrence 2_3:1420:2583: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0013; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1420
msgctxt "text_id=2583 | speaker=soujuurou"
msgid "「俺は基本ができてないから、人の倍程度の勉強じゃ追いつけない。ほら、勉強ばかりしているとノイローゼをするんだろう？」"
msgstr ""

#. Occurrence 2_3:1440:2584: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0013; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1440
msgctxt "text_id=2584 | speaker=tobimaru"
msgid "「そりゃするんじゃなくてなるものだが、ま、なんにせよやり過ぎ飲み過ぎはよくねえわな。試験前ぐらいはバイト減らしたらどうだ？」"
msgstr ""

#. Occurrence 2_3:1468:2585: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0014; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1468
msgctxt "text_id=2585 | speaker=soujuurou"
msgid "「減らしてはいるんだけどね。年末ってアルバイトを休む人も多くて、その代行も頼まれがちだし」"
msgstr ""

#. Occurrence 2_3:1473:2586: scene=2_3
#: 2_3:1473
msgctxt "text_id=2586 | speaker=unknown"
msgid "　草十郎はやれやれと肩をすくめる。"
msgstr ""

#. Occurrence 2_3:1485:2587: scene=2_3
#: 2_3:1485
msgctxt "text_id=2587 | speaker=unknown"
msgid "　その口ぶりから彼の忙しさは読み取れる。"
msgstr ""

#. Occurrence 2_3:1490:2588: scene=2_3
#: 2_3:1490
msgctxt "text_id=2588 | speaker=unknown"
msgid "　ノイローゼはともかく、睡眠不足で白昼夢を見るぐらいあるかもしれない。……実際、その場面にでくわしたのは深夜とのコトではあるが。"
msgstr ""

#. Occurrence 2_3:1524:2589: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0014; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1524
msgctxt "text_id=2589 | speaker=tobimaru"
msgid "「なんだか大変そうだな、草十郎」"
msgstr ""

#. Occurrence 2_3:1550:2590: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0015; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1550
msgctxt "text_id=2590 | speaker=soujuurou"
msgid "「ああ、実はかなりまいってる。都会の暮らしは深刻だ」"
msgstr ""

#. Occurrence 2_3:1561:2591: scene=2_3
#: 2_3:1561
msgctxt "text_id=2591 | speaker=unknown"
msgid "　困ったもんだと真顔で頷く草十郎。"
msgstr ""

#. Occurrence 2_3:1566:2592: scene=2_3
#: 2_3:1566
msgctxt "text_id=2592 | speaker=unknown"
msgid "　毛ほども疲れていないように見えるのが困りものだった。"
msgstr ""

#. Occurrence 2_3:1616:2593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2593 | speaker=tobimaru"
msgid "「泣き言いわねえのは感心するけどな。"
msgstr ""

#. Occurrence 2_3:1616:2594: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2594 | speaker=tobimaru"
msgid "　おまえ、心労は顔に出ない<性質|タチ>か？」"
msgstr ""

#. Occurrence 2_3:1622:2595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0016; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1622
msgctxt "text_id=2595 | speaker=soujuurou"
msgid "「？　そりゃ、心労はどこも痛まないからね」"
msgstr ""

#. Occurrence 2_3:1628:2596: scene=2_3
#: 2_3:1628
msgctxt "text_id=2596 | speaker=unknown"
msgid "　答えて、草十郎はちらりと壁の時計を見る。"
msgstr ""

#. Occurrence 2_3:1633:2597: scene=2_3
#: 2_3:1633
msgctxt "text_id=2597 | speaker=unknown"
msgid "　そろそろ昼休みも終わろうとしていた。"
msgstr ""

#. Occurrence 2_3:1656:2598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0017; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1656
msgctxt "text_id=2598 | speaker=soujuurou"
msgid "「鳶丸、時間だ」"
msgstr ""

#. Occurrence 2_3:1662:2599: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0016; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1662
msgctxt "text_id=2599 | speaker=tobimaru"
msgid "「お？　ああ、もうそんなに経ったか。気にせず先に行ってていいぜ。俺はまだ用があるからよ」"
msgstr ""

#. Occurrence 2_3:1690:2600: scene=2_3
#: 2_3:1690
msgctxt "text_id=2600 | speaker=unknown"
msgid "　生徒会役員は大変なんだとジェスチャーする鳶丸を、草十郎はマジマジと見つめる。"
msgstr ""

#. Occurrence 2_3:1695:2601: scene=2_3
#: 2_3:1695
msgctxt "text_id=2601 | speaker=unknown"
msgid "　価値の分からない美術品を見るような目で。"
msgstr ""

#. Occurrence 2_3:1721:2602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0018; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1721
msgctxt "text_id=2602 | speaker=soujuurou"
msgid "「授業をさぼれる身分っていうのは羨ましいな。"
msgstr ""

#. Occurrence 2_3:1727:2603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0019; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1727
msgctxt "text_id=2603 | speaker=soujuurou"
msgid "　そういうの、鳶丸が嫌いな手抜きじゃないのか？」"
msgstr ""

#. Occurrence 2_3:1765:2604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0017; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1765
msgctxt "text_id=2604 | speaker=tobimaru"
msgid "「そりゃ誤解も<甚|はなは>だしい！　俺の欠席は手抜きじゃねえ、特権ってヤツだと言ったろう!?」"
msgstr ""

#. Occurrence 2_3:1771:2605: scene=2_3
#: 2_3:1771
msgctxt "text_id=2605 | speaker=unknown"
msgid "　心外だ、とばかりに席を立って力説する副会長。"
msgstr ""

#. Occurrence 2_3:1776:2606: scene=2_3
#: 2_3:1776
msgctxt "text_id=2606 | speaker=unknown"
msgid "　それをふーん、と無感動に眺める転入生。"
msgstr ""

#. Occurrence 2_3:1803:2607: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0018; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1803
msgctxt "text_id=2607 | speaker=tobimaru"
msgid "「おいおい、アレだけ説明したのにぜんっぜん分かってなかったのか!?"
msgstr ""

#. Occurrence 2_3:1809:2608: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0019; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1809
msgctxt "text_id=2608 | speaker=tobimaru"
msgid "　しょうがねえ、まず座れ。いいか草の字。"
msgstr ""

#. Occurrence 2_3:1815:2609: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0020; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1815
msgctxt "text_id=2609 | speaker=tobimaru"
msgid "　常人をうわまわる英気と幸運を兼ね備えながら、座する事なく精進してきた俺でも、ここを卒業しちまえば裸一貫になっちまうんだぞ？」"
msgstr ""

#. Occurrence 2_3:1842:2610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0021; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1842
msgctxt "text_id=2610 | speaker=tobimaru"
msgid "「ひでえ話だ。"
msgstr ""

#. Occurrence 2_3:1848:2611: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0022; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1848
msgctxt "text_id=2611 | speaker=tobimaru"
msgid "　<自分|テメエ>の家柄を活用できんのはあと一年ちょいだけなんだぜ？　これの一体どこが羨ましいってんだ？"
msgstr ""

#. Occurrence 2_3:1854:2612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0023; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1854
msgctxt "text_id=2612 | speaker=tobimaru"
msgid "　ふつう一生続くはずの親の七光って<権利|ヤツ>が、俺の場合はたった三年間しかねえんだからな！」"
msgstr ""

#. Occurrence 2_3:1881:2613: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0024; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1881
msgctxt "text_id=2613 | speaker=tobimaru"
msgid "「となりゃあ、有効なうちに使っておかなきゃもったいなくてオチオチ眠ってもいられねえ。"
msgstr ""

#. Occurrence 2_3:1887:2614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0025; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1887
msgctxt "text_id=2614 | speaker=tobimaru"
msgid "　ああイヤだイヤだ、何がイヤかってバカどもと<雁首|がんくび>ならべて金勘定するのがイヤだ！　ったく、嫉妬渦巻く大人の世界じゃ俺のオブラートみたいな心なんてぱっくり呑まれて溶けちまうコト請け合いだろうさ！」"
msgstr ""

#. Occurrence 2_3:1935:2615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0020; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1935
msgctxt "text_id=2615 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_3:1940:2616: scene=2_3
#: 2_3:1940
msgctxt "text_id=2616 | speaker=unknown"
msgid "　冗談にしか取れない熱弁は、草十郎の聞くかぎりどうも本気のようだった。"
msgstr ""

#. Occurrence 2_3:1951:2617: scene=2_3
#: 2_3:1951
msgctxt "text_id=2617 | speaker=unknown"
msgid "　そういう事を本気で言える人間性が羨ましい、などと思いつつ、草十郎はなるほど、と納得する。"
msgstr ""

#. Occurrence 2_3:1956:2618: scene=2_3
#: 2_3:1956
msgctxt "text_id=2618 | speaker=unknown"
msgid "　本人が言うのだから彼の主観的には正しいのだろうと。"
msgstr ""

#. Occurrence 2_3:1961:2619: scene=2_3
#: 2_3:1961
msgctxt "text_id=2619 | speaker=unknown"
msgid "　だが、"
msgstr ""

#. Occurrence 2_3:1985:2620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0004; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:1985
msgctxt "text_id=2620 | speaker=aoko"
msgid "「あら、そんな権利なんて留年すればいくらでも引き延ばせるのに。なんなら協力してあげましょうか、この私でよろしければ」"
msgstr ""

#. Occurrence 2_3:1997:2621: scene=2_3
#: 2_3:1997
msgctxt "text_id=2621 | speaker=unknown"
msgid "　草十郎の骨のない相づちを蹴散らすように、生徒会室の扉が勢いよく開かれた。"
msgstr ""

#. Occurrence 2_3:2036:2622: scene=2_3
#: 2_3:2036
msgctxt "text_id=2622 | speaker=unknown"
msgid "　ほんわかした空気を一撃で打ち砕く<冷静|クール>な一言。"
msgstr ""

#. Occurrence 2_3:2041:2623: scene=2_3
#: 2_3:2041
msgctxt "text_id=2623 | speaker=unknown"
msgid "　槻司鳶丸にあったこの場の支配権は、<蝙蝠|こうもり>より<潔|いさぎよ>く彼女の手に飛び立ったのだった。"
msgstr ""

#. Occurrence 2_3:2067:2624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0026; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2067
msgctxt "text_id=2624 | speaker=tobimaru"
msgid "「……いや、いい。自分の夢は、自分の力だけで叶えようとつねづね思ってるんだ」"
msgstr ""

#. Occurrence 2_3:2073:2625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2625 | speaker=aoko"
msgid "「そ。なら今みたいな恥ずかしいこと力説しないでね。"
msgstr ""

#. Occurrence 2_3:2073:2626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2626 | speaker=aoko"
msgid "　廊下にまで聞こえてたわよ、副会長さん」"
msgstr ""

#. Occurrence 2_3:2119:2627: scene=2_3
#: 2_3:2119
msgctxt "text_id=2627 | speaker=unknown"
msgid "　さらりと言って、彼女……蒼崎青子が生徒会室に入ってくる。"
msgstr ""

#. Occurrence 2_3:2124:2628: scene=2_3
#: 2_3:2124
msgctxt "text_id=2628 | speaker=unknown"
msgid "　長い黒髪がわずかに乱れているのは、ここまで走ってきたせいか。"
msgstr ""

#. Occurrence 2_3:2129:2629: scene=2_3
#: 2_3:2129
msgctxt "text_id=2629 | speaker=unknown"
msgid "　青子の視線は座ったままの草十郎にではなく、熱弁していた副会長に向けられている。"
msgstr ""

#. Occurrence 2_3:2177:2630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0021; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2177
msgctxt "text_id=2630 | speaker=soujuurou"
msgid "「頑張れ、鳶丸」"
msgstr ""

#. Occurrence 2_3:2189:2631: scene=2_3
#: 2_3:2189
msgctxt "text_id=2631 | speaker=unknown"
msgid "　そろそろ教室に戻らないといけない、と草十郎は静かに立ち上がる。"
msgstr ""

#. Occurrence 2_3:2195:2632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0027; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2195
msgctxt "text_id=2632 | speaker=tobimaru"
msgid "「……わりと薄情なんだな、おまえって」"
msgstr ""

#. Occurrence 2_3:2225:2633: scene=2_3
#: 2_3:2225
msgctxt "text_id=2633 | speaker=unknown"
msgid "　青子を前にして呟く鳶丸。"
msgstr ""

#. Occurrence 2_3:2266:2634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0022; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2266
msgctxt "text_id=2634 | speaker=soujuurou"
msgid "「だって時間がない」"
msgstr ""

#. Occurrence 2_3:2290:2635: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0028; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2290
msgctxt "text_id=2635 | speaker=tobimaru"
msgid "「だから、そういうのが薄情とだな……」"
msgstr ""

#. Occurrence 2_3:2295:2636: scene=2_3
#: 2_3:2295
msgctxt "text_id=2636 | speaker=unknown"
msgid "　言いかけて言葉を呑む鳶丸。"
msgstr ""

#. Occurrence 2_3:2315:2637: scene=2_3
#: 2_3:2315
msgctxt "text_id=2637 | speaker=unknown"
msgid "　今まで自分しか見ていなかった青子の視線が、草十郎をちらりと見たからだ。"
msgstr ""

#. Occurrence 2_3:2357:2638: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0006; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2357
msgctxt "text_id=2638 | speaker=aoko"
msgid "「時間がないのは私も同じよ。貴方にはいつも振り回される」"
msgstr ""

#. Occurrence 2_3:2363:2639: scene=2_3
#: 2_3:2363
msgctxt "text_id=2639 | speaker=unknown"
msgid "　これは文句ではなく、素直な意見らしい。"
msgstr ""

#. Occurrence 2_3:2377:2640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0029; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2377
msgctxt "text_id=2640 | speaker=tobimaru"
msgid "「なんだ、用件は草十郎かよ」"
msgstr ""

#. Occurrence 2_3:2388:2641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0007; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2388
msgctxt "text_id=2641 | speaker=aoko"
msgid "「安心なさい、貴方にもあるから」"
msgstr ""

#. Occurrence 2_3:2425:2642: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0030; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2425
msgctxt "text_id=2642 | speaker=tobimaru"
msgid "「……？」"
msgstr ""

#. Occurrence 2_3:2430:2643: scene=2_3
#: 2_3:2430
msgctxt "text_id=2643 | speaker=unknown"
msgid "　心なしか、青子の目に殺伐とした<翳|かげ>りがある。"
msgstr ""

#. Occurrence 2_3:2435:2644: scene=2_3
#: 2_3:2435
msgctxt "text_id=2644 | speaker=unknown"
msgid "　いつも不機嫌そうな青子の視線に見慣れている鳶丸だからこそ気づける、微妙な差異だ。"
msgstr ""

#. Occurrence 2_3:2440:2645: scene=2_3
#: 2_3:2440
msgctxt "text_id=2645 | speaker=unknown"
msgid "　……理由は不明だが、蒼崎青子はいつになくご機嫌ななめという事らしい。"
msgstr ""

#. Occurrence 2_3:2475:2646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0008; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2475
msgctxt "text_id=2646 | speaker=aoko"
msgid "「静希君。貴方、走るのと泳ぐの、どっちが好き？」"
msgstr ""

#. Occurrence 2_3:2494:2647: scene=2_3
#: 2_3:2494
msgctxt "text_id=2647 | speaker=unknown"
msgid "　唐突に青子が訊ねる。"
msgstr ""

#. Occurrence 2_3:2499:2648: scene=2_3
#: 2_3:2499
msgctxt "text_id=2648 | speaker=unknown"
msgid "　草十郎は少し顔を曇らせてから、どっちも、と答えた。"
msgstr ""

#. Occurrence 2_3:2505:2649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0009; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2505
msgctxt "text_id=2649 | speaker=aoko"
msgid "「だめよ、ひとつにして」"
msgstr ""

#. Occurrence 2_3:2531:2650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0023; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2531
msgctxt "text_id=2650 | speaker=soujuurou"
msgid "「……泳ぐほう、かな。けど、どうして？」"
msgstr ""

#. Occurrence 2_3:2537:2651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0010; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2537
msgctxt "text_id=2651 | speaker=aoko"
msgid "「貴方がまだどこの部にも所属してないから」"
msgstr ""

#. Occurrence 2_3:2542:2652: scene=2_3
#: 2_3:2542
msgctxt "text_id=2652 | speaker=unknown"
msgid "　実に無駄のない答えだった。"
msgstr ""

#. Occurrence 2_3:2547:2653: scene=2_3
#: 2_3:2547
msgctxt "text_id=2653 | speaker=unknown"
msgid "　無駄がなさすぎて、草十郎の意見をはさむ隙間もない。"
msgstr ""

#. Occurrence 2_3:2595:2654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0011; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2595
msgctxt "text_id=2654 | speaker=aoko"
msgid "「うちの校則、読んだわよね。生徒はただ一人の例外もなく部活動に参加しなくてはならない。"
msgstr ""

#. Occurrence 2_3:2601:2655: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0012; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2601
msgctxt "text_id=2655 | speaker=aoko"
msgid "　正直どうかと思う校則だけど、決まりは決まりだから」"
msgstr ""

#. Occurrence 2_3:2607:2656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0024; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2607
msgctxt "text_id=2656 | speaker=soujuurou"
msgid "「そんな無茶な。悪いけど、そこまでの暇はないんだ」"
msgstr ""

#. Occurrence 2_3:2625:2657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0013; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2625
msgctxt "text_id=2657 | speaker=aoko"
msgid "「でしょうね」"
msgstr ""

#. Occurrence 2_3:2630:2658: scene=2_3
#: 2_3:2630
msgctxt "text_id=2658 | speaker=unknown"
msgid "　短い返答。"
msgstr ""

#. Occurrence 2_3:2647:2659: scene=2_3
#: 2_3:2647
msgctxt "text_id=2659 | speaker=unknown"
msgid "　青子に容赦がないのはいつもの事だが、鳶丸には、彼女が草十郎との会話を避けているようにも見える。"
msgstr ""

#. Occurrence 2_3:2694:2660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0014; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2694
msgctxt "text_id=2660 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_3:2700:2661: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0025; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2700
msgctxt "text_id=2661 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_3:2706:2662: scene=2_3
#: 2_3:2706
msgctxt "text_id=2662 | speaker=unknown"
msgid "　無言で見つめあうふたり。"
msgstr ""

#. Occurrence 2_3:2711:2663: scene=2_3
#: 2_3:2711
msgctxt "text_id=2663 | speaker=unknown"
msgid "　第三者の鳶丸すら息がつまりそうな沈黙は、そうか、という草十郎の一言で破られた。"
msgstr ""

#. Occurrence 2_3:2765:2664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0026; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2765
msgctxt "text_id=2664 | speaker=soujuurou"
msgid "「蒼崎は分かってると思ってた。"
msgstr ""

#. Occurrence 2_3:2772:2665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0027; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2772
msgctxt "text_id=2665 | speaker=soujuurou"
msgid "ああ、いや違う、きっと分かっているんだな。"
msgstr ""

#. Occurrence 2_3:2784:2666: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0028; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2784
msgctxt "text_id=2666 | speaker=soujuurou"
msgid "　うん。だから、そこが強いんだろうね」"
msgstr ""

#. Occurrence 2_3:2807:2667: scene=2_3
#: 2_3:2807
msgctxt "text_id=2667 | speaker=unknown"
msgid "　席を離れる草十郎。"
msgstr ""

#. Occurrence 2_3:2825:2668: scene=2_3
#: 2_3:2825
msgctxt "text_id=2668 | speaker=unknown"
msgid "　青子の横を通り過ぎ、あっさりと廊下に出る。"
msgstr ""

#. Occurrence 2_3:2846:2669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0029; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2846
msgctxt "text_id=2669 | speaker=soujuurou"
msgid "「それ、明日からでいいんだろ？」"
msgstr ""

#. Occurrence 2_3:2859:2670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0015; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2859
msgctxt "text_id=2670 | speaker=aoko"
msgid "「静希君がいいならね」"
msgstr ""

#. Occurrence 2_3:2880:2671: scene=2_3
#: 2_3:2880
msgctxt "text_id=2671 | speaker=unknown"
msgid "　できるだけ頑張るよ、と苦笑して、草十郎は生徒会室を後にした。"
msgstr ""

#. Occurrence 2_4:50:2672: scene=2_4
#: 2_4:50
msgctxt "text_id=2672 | speaker=unknown"
msgid "　そんな一連の出来事を観察しながら、鳶丸はつくづく草十郎に感心していた。"
msgstr ""

#. Occurrence 2_4:80:2673: scene=2_4
#: 2_4:80
msgctxt "text_id=2673 | speaker=unknown"
msgid "　今の青子の態度は、相手を怒らせる事を前提としたものだ。しかし草十郎は怒りだす様子もなく、掴みどころのない……言ってるコトは本当に掴みようがなかったが……返答をして去っていった。"
msgstr ""

#. Occurrence 2_4:85:2674: scene=2_4
#: 2_4:85
msgctxt "text_id=2674 | speaker=unknown"
msgid "　草十郎とて少なからず不満に思っただろう。"
msgstr ""

#. Occurrence 2_4:90:2675: scene=2_4
#: 2_4:90
msgctxt "text_id=2675 | speaker=unknown"
msgid "　それを表情にも仕草にも出さなかった事に、鳶丸は一流の芸を見た気がしたのである。"
msgstr ""

#. Occurrence 2_4:148:2676: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0000; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:148
msgctxt "text_id=2676 | speaker=tobimaru"
msgid "「いや、でも何が強いんだろうな会長？」"
msgstr ""

#. Occurrence 2_4:154:2677: scene=2_4
#: 2_4:154
msgctxt "text_id=2677 | speaker=unknown"
msgid "　鳶丸は首をかしげて青子を見る。"
msgstr ""

#. Occurrence 2_4:176:2678: scene=2_4
#: 2_4:176
msgctxt "text_id=2678 | speaker=unknown"
msgid "　青子は立ち尽くしたまま、じっと壁を睨んでいた。"
msgstr ""

#. Occurrence 2_4:182:2679: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0001; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:182
msgctxt "text_id=2679 | speaker=tobimaru"
msgid "「……蒼崎？」"
msgstr ""

#. Occurrence 2_4:187:2680: scene=2_4
#: 2_4:187
msgctxt "text_id=2680 | speaker=unknown"
msgid "　鳶丸の呼び掛けに、青子は応えない。"
msgstr ""

#. Occurrence 2_4:199:2681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2681 | speaker=tobimaru"
msgid "「おーい、かいちょー。蒼崎ぃー。……青子女史？"
msgstr ""

#. Occurrence 2_4:199:2682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2682 | speaker=tobimaru"
msgid "　……"
msgstr ""

msgctxt "text_id=2683 | speaker=unknown"
msgid "おい、聞いてんのかよ蒼崎青子！」"
msgstr ""

#. Occurrence 2_4:260:2684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0000; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:260
msgctxt "text_id=2684 | speaker=aoko"
msgid "「っさいわね！　あおあお呼ぶなっ！」"
msgstr ""

#. Occurrence 2_4:266:2685: scene=2_4
#: 2_4:266
msgctxt "text_id=2685 | speaker=unknown"
msgid "　怒鳴り声が生徒会室に響く。"
msgstr ""

#. Occurrence 2_4:271:2686: scene=2_4
#: 2_4:271
msgctxt "text_id=2686 | speaker=unknown"
msgid "　さきほどの鳶丸の熱弁以上に、廊下にまで通る美声だった。"
msgstr ""

#. Occurrence 2_4:308:2687: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0003; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:308
msgctxt "text_id=2687 | speaker=tobimaru"
msgid "「やかましい、うるせえのはテメエも同じだ！」"
msgstr ""

#. Occurrence 2_4:313:2688: scene=2_4
#: 2_4:313
msgctxt "text_id=2688 | speaker=unknown"
msgid "　よほど耳に響いたのか、それとも怒鳴られたら怒鳴り返す性分なのか、鳶丸も反射的に言い返す。"
msgstr ""

#. Occurrence 2_4:319:2689: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2689 | speaker=tobimaru"
msgid "「そんなんだから男の一人もできねえんだよ、おまえは。"
msgstr ""

#. Occurrence 2_4:319:2690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2690 | speaker=tobimaru"
msgid "　ほら、目ぇ覚めたか？」"
msgstr ""

#. Occurrence 2_4:371:2691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0001; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:371
msgctxt "text_id=2691 | speaker=aoko"
msgid "「別に、貴方の声は聞こえてた。わずらわしかったから無視してただけよ。黙らせるの面倒だし」"
msgstr ""

#. Occurrence 2_4:391:2692: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0005; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:391
msgctxt "text_id=2692 | speaker=tobimaru"
msgid "「テメエな。俺は蚊かなんかか、おい」"
msgstr ""

#. Occurrence 2_4:402:2693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0002; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:402
msgctxt "text_id=2693 | speaker=aoko"
msgid "「コミュニケーションが成立しない点で言えば、あっちのがまだ上品よね」"
msgstr ""

#. Occurrence 2_4:440:2694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0006; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:440
msgctxt "text_id=2694 | speaker=tobimaru"
msgid "「……ほう、その心は？」"
msgstr ""

#. Occurrence 2_4:461:2695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0003; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:461
msgctxt "text_id=2695 | speaker=aoko"
msgid "「お互い、何を言ってるか分からない。意味のない会話なら、逢瀬みたいなものでしょう？」"
msgstr ""

#. Occurrence 2_4:480:2696: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0007; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:480
msgctxt "text_id=2696 | speaker=tobimaru"
msgid "「………………」"
msgstr ""

#. Occurrence 2_4:485:2697: scene=2_4
#: 2_4:485
msgctxt "text_id=2697 | speaker=unknown"
msgid "　その論からいくと、彼女にとって恋人同士とは意味のない会話をするものらしい。"
msgstr ""

#. Occurrence 2_4:518:2698: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0008; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:518
msgctxt "text_id=2698 | speaker=tobimaru"
msgid "「……問題は、おまえにとって意味のある会話ってのがどの程度の価値かってコトだが……まあいいか。"
msgstr ""

#. Occurrence 2_4:524:2699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0009; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:524
msgctxt "text_id=2699 | speaker=tobimaru"
msgid "　いつになくきついじゃねえか、蒼崎」"
msgstr ""

#. Occurrence 2_4:530:2700: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0004; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:530
msgctxt "text_id=2700 | speaker=aoko"
msgid "「ちょっとね。いま愛嬌ふりまける状況じゃないのよ」"
msgstr ""

#. Occurrence 2_4:549:2701: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0010; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:549
msgctxt "text_id=2701 | speaker=tobimaru"
msgid "「不思議だ。この二年間で蒼崎の愛嬌なんてものは見たことがないんだが」"
msgstr ""

#. Occurrence 2_4:575:2702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0005; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:575
msgctxt "text_id=2702 | speaker=aoko"
msgid "「鳶丸のいない時にふりまいてたの」"
msgstr ""

#. Occurrence 2_4:598:2703: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0011; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:598
msgctxt "text_id=2703 | speaker=tobimaru"
msgid "「そうかよ。やっぱりあの時のこと恨んでるんだろ、生徒会長さんはよ」"
msgstr ""

#. Occurrence 2_4:603:2704: scene=2_4
#: 2_4:603
msgctxt "text_id=2704 | speaker=unknown"
msgid "　鳶丸の言うあの時というのは一つしかない。"
msgstr ""

#. Occurrence 2_4:608:2705: scene=2_4
#: 2_4:608
msgctxt "text_id=2705 | speaker=unknown"
msgid "　今年の夏に起きた、生徒会室イン武道館事件の事である。"
msgstr ""

#. Occurrence 2_4:643:2706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0006; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:643
msgctxt "text_id=2706 | speaker=aoko"
msgid "「え、随分と昔の話じゃないそれ？"
msgstr ""

#. Occurrence 2_4:649:2707: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0007; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:649
msgctxt "text_id=2707 | speaker=aoko"
msgid "　そんなどうでもいい事に容量を使っちゃもったいないわよ？　ただでさえ脳の覚醒部分が少ないのに」"
msgstr ""

#. Occurrence 2_4:668:2708: scene=2_4
#: 2_4:668
msgctxt "text_id=2708 | speaker=unknown"
msgid "　会話が走ってきたおかげか、青子から先ほどまでの<殺伐|さつばつ>さが薄れつつあった。鋭い視線も、時たまにしか見せない<涼|すず>しげなものになる。"
msgstr ""

#. Occurrence 2_4:673:2709: scene=2_4
#: 2_4:673
msgctxt "text_id=2709 | speaker=unknown"
msgid "　学校内で彼女のこういった顔を見られるのは、今のところ槻司鳶丸だけだろう。"
msgstr ""

#. Occurrence 2_4:707:2710: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0012; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:707
msgctxt "text_id=2710 | speaker=tobimaru"
msgid "「ご忠告どうも。俺だってあんな事は忘れてえよ。"
msgstr ""

#. Occurrence 2_4:718:2711: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0013; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:718
msgctxt "text_id=2711 | speaker=tobimaru"
msgid "　……ただ、さっき草の字が馬鹿な事いいやがるからつい思い出しちまったんだよ。くそ、考えてみりゃあ場所まで一緒じゃねえか！」"
msgstr ""

#. Occurrence 2_4:731:2712: scene=2_4
#: 2_4:731
msgctxt "text_id=2712 | speaker=unknown"
msgid "　などと悪態をつきながらも、まんざらでもなさげに過去を懐かしむ鳶丸。"
msgstr ""

#. Occurrence 2_4:756:2713: scene=2_4
#: 2_4:756
msgctxt "text_id=2713 | speaker=unknown"
msgid "　一方、青子は顔をしかめる。"
msgstr ""

#. Occurrence 2_4:778:2714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0008; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:778
msgctxt "text_id=2714 | speaker=aoko"
msgid "「ちょっと待って。"
msgstr ""

#. Occurrence 2_4:784:2715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0009; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:784
msgctxt "text_id=2715 | speaker=aoko"
msgid "　あの話、彼にしたの……？」"
msgstr ""

#. Occurrence 2_4:804:2716: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2716 | speaker=tobimaru"
msgid "「おう、俺がテメエに"
msgstr ""

#. Occurrence 2_4:804:2717: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2717 | speaker=tobimaru"
msgid "“なんで会長になんか立候補したのよ。アンタは副会長って顔でしょ、どう見ても”"
msgstr ""

#. Occurrence 2_4:804:2718: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2718 | speaker=tobimaru"
msgid "　なんて挑発されて、生涯最高の突きをしたところまでな」"
msgstr ""

#. Occurrence 2_4:827:2719: scene=2_4
#: 2_4:827
msgctxt "text_id=2719 | speaker=unknown"
msgid "　何故か、ほう、と青子は息をついた。その先を知られなくて良かった、という風に。"
msgstr ""

#. Occurrence 2_4:846:2720: scene=2_4
#: 2_4:846
msgctxt "text_id=2720 | speaker=unknown"
msgid "　何故だかは鳶丸にも青子自身にも分からない。"
msgstr ""

#. Occurrence 2_4:884:2721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2721 | speaker=aoko"
msgid "「アレはたしかに、びっくりするぐらいいい突きだった。"
msgstr ""

#. Occurrence 2_4:884:2722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2722 | speaker=aoko"
msgid "　思わず体が反応しちゃったものね。"
msgstr ""

#. Occurrence 2_4:890:2723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0011; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:890
msgctxt "text_id=2723 | speaker=aoko"
msgid "　ところで、私そんなコト言ったっけ？」"
msgstr ""

#. Occurrence 2_4:901:2724: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0015; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:901
msgctxt "text_id=2724 | speaker=tobimaru"
msgid "「言った。しかも俺が保健室に運ばれたのをこれ幸いと、強引に副会長にしやがった」"
msgstr ""

#. Occurrence 2_4:924:2725: scene=2_4
#: 2_4:924
msgctxt "text_id=2725 | speaker=unknown"
msgid "　以来、鳶丸は選挙戦で負けた相手に副会長として使われているのであった。"
msgstr ""

#. Occurrence 2_4:951:2726: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0016; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:951
msgctxt "text_id=2726 | speaker=tobimaru"
msgid "「いいけどな。俺に会長職は合わねえって分かったし。副会長の方が性に合ってやがる。会長なんてやってたら、あやうく親父みたいな野郎になってただろうしよ」"
msgstr ""

#. Occurrence 2_4:985:2727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0012; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:985
msgctxt "text_id=2727 | speaker=aoko"
msgid "「プライド高い分、できるコトは全部やるからね鳶丸は。"
msgstr ""

#. Occurrence 2_4:996:2728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0013; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:996
msgctxt "text_id=2728 | speaker=aoko"
msgid "　ま、会長職に専心するあまり、気が付いたら優等生になってたアンタも見たかったけど？」"
msgstr ""

#. Occurrence 2_4:1030:2729: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0017; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1030
msgctxt "text_id=2729 | speaker=tobimaru"
msgid "「やめてくれ、ゾッとしねえ。"
msgstr ""

#. Occurrence 2_4:1036:2730: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0018; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1036
msgctxt "text_id=2730 | speaker=tobimaru"
msgid "　ネコかぶるのはおまえだけで十分だ」"
msgstr ""

#. Occurrence 2_4:1047:2731: scene=2_4
#: 2_4:1047
msgctxt "text_id=2731 | speaker=unknown"
msgid "　しっしっ、と青子に手を振る鳶丸。"
msgstr ""

#. Occurrence 2_4:1052:2732: scene=2_4
#: 2_4:1052
msgctxt "text_id=2732 | speaker=unknown"
msgid "　男女にあるまじき戦いを繰り広げた者特有の、実にさっぱりした<罵|ののし>り合いだった。"
msgstr ""

#. Occurrence 2_4:1089:2733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0014; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1089
msgctxt "text_id=2733 | speaker=aoko"
msgid "「―――で。"
msgstr ""

msgctxt "text_id=2734 | speaker=unknown"
msgid "なんでそんな話したのよ」"
msgstr ""

#. Occurrence 2_4:1112:2735: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0019; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1112
msgctxt "text_id=2735 | speaker=tobimaru"
msgid "「は？」"
msgstr ""

#. Occurrence 2_4:1118:2736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0015; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1118
msgctxt "text_id=2736 | speaker=aoko"
msgid "「半年前の、ここの事件を、なんで彼に話したのよ」"
msgstr ""

#. Occurrence 2_4:1130:2737: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2737 | speaker=tobimaru"
msgid "「あ、そっちか。"
msgstr ""

#. Occurrence 2_4:1130:2738: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2738 | speaker=tobimaru"
msgid "　いや、あいつが馬鹿なこと口走ったからなんだが―――」"
msgstr ""

#. Occurrence 2_4:1135:2739: scene=2_4
#: 2_4:1135
msgctxt "text_id=2739 | speaker=unknown"
msgid "　その先は言えない。"
msgstr ""

#. Occurrence 2_4:1155:2740: scene=2_4
#: 2_4:1155
msgctxt "text_id=2740 | speaker=unknown"
msgid "　静希草十郎が蒼崎青子に惚れている、という事実は口に出来ない事だ。<漢|おとこ>としての暗黙の了解である。"
msgstr ""

#. Occurrence 2_4:1155:2741: scene=2_4
#: 2_4:1155
msgctxt "text_id=2741 | speaker=unknown"
msgid "　たとえ、それが彼の勘違いでもだ。"
msgstr ""

#. Occurrence 2_4:1181:2742: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0021; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1181
msgctxt "text_id=2742 | speaker=tobimaru"
msgid "「それより、さっきのはないんじゃねえのか蒼崎。"
msgstr ""

#. Occurrence 2_4:1187:2743: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0022; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1187
msgctxt "text_id=2743 | speaker=tobimaru"
msgid "　おまえ、草十郎に恨みでもあんの？」"
msgstr ""

#. Occurrence 2_4:1198:2744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0016; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1198
msgctxt "text_id=2744 | speaker=aoko"
msgid "「七日以上前の恨みを引きずるほど、私はお姫さまじゃないつもりだけど」"
msgstr ""

#. Occurrence 2_4:1208:2745: scene=2_4
#: 2_4:1208
msgctxt "text_id=2745 | speaker=unknown"
msgid "　ああ、おまえはお姫さまっていうより女王さまだな、と言いかけて止める鳶丸。"
msgstr ""

#. Occurrence 2_4:1218:2746: scene=2_4
#: 2_4:1218
msgctxt "text_id=2746 | speaker=unknown"
msgid "　彼もこの二年で、十分に蒼崎青子を学習しているのだった。"
msgstr ""

#. Occurrence 2_4:1244:2747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0023; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1244
msgctxt "text_id=2747 | speaker=tobimaru"
msgid "「恨みはないねえ。それにしちゃあ故意にケンカ売ってただろ。なんでだ？"
msgstr ""

#. Occurrence 2_4:1251:2748: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0024; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1251
msgctxt "text_id=2748 | speaker=tobimaru"
msgid "　たしかに調子の狂うヤツだが、あいつほどいいヤツはいねえだろうに」"
msgstr ""

#. Occurrence 2_4:1284:2749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0017; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1284
msgctxt "text_id=2749 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_4:1290:2750: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0025; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1290
msgctxt "text_id=2750 | speaker=tobimaru"
msgid "「おい待て。なんだその、足下の白アリを見るかのような態度は」"
msgstr ""

#. Occurrence 2_4:1296:2751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0018; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1296
msgctxt "text_id=2751 | speaker=aoko"
msgid "「別に。アンタまでその台詞を言うのかって、心底から見下げ果てただけよ」"
msgstr ""

#. Occurrence 2_4:1330:2752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0019; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1330
msgctxt "text_id=2752 | speaker=aoko"
msgid "「……まあいいか。いいヤツ、いいひと、結構じゃない？　ケンカを売る相手としちゃあ上等だわ。誰も憎んであげないなら、私ぐらいそうしないとね」"
msgstr ""

#. Occurrence 2_4:1344:2753: scene=2_4
#: 2_4:1344
msgctxt "text_id=2753 | speaker=unknown"
msgid "　うん、と気を取り直して気軽に言う青子。"
msgstr ""

#. Occurrence 2_4:1365:2754: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0026; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1365
msgctxt "text_id=2754 | speaker=tobimaru"
msgid "「しないとねって、おまえ」"
msgstr ""

#. Occurrence 2_4:1370:2755: scene=2_4
#: 2_4:1370
msgctxt "text_id=2755 | speaker=unknown"
msgid "　鳶丸にはその結論がさっぱりである。"
msgstr ""

#. Occurrence 2_4:1396:2756: scene=2_4
#: 2_4:1396
msgctxt "text_id=2756 | speaker=unknown"
msgid "　蒼崎青子のこういう思考の飛び方に慣れてはいる鳶丸だが、理由もなく嫌われる草十郎があんまりと言えばあんまりで、脳裏にはあの人畜無害な顔が浮かんでしまい、つい、"
msgstr ""

#. Occurrence 2_4:1410:2757: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0027; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1410
msgctxt "text_id=2757 | speaker=tobimaru"
msgid "「けど草十郎は蒼崎が好きなんだぜ。それでも嫌いなのか？」"
msgstr ""

#. Occurrence 2_4:1441:2758: scene=2_4
#: 2_4:1441
msgctxt "text_id=2758 | speaker=unknown"
msgid "　二分足らずで、言うべきではないという誓いを破っていた。"
msgstr ""

#. Occurrence 2_4:1479:2759: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0028; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1479
msgctxt "text_id=2759 | speaker=tobimaru"
msgid "「あ―――いや、今のはな、蒼崎」"
msgstr ""

#. Occurrence 2_4:1485:2760: scene=2_4
#: 2_4:1485
msgctxt "text_id=2760 | speaker=unknown"
msgid "　しまった、と口を閉ざすがもう遅い。"
msgstr ""

#. Occurrence 2_4:1490:2761: scene=2_4
#: 2_4:1490
msgctxt "text_id=2761 | speaker=unknown"
msgid "　そして閉まったものは仕方がない。"
msgstr ""

#. Occurrence 2_4:1496:2762: scene=2_4
#: 2_4:1496
msgctxt "text_id=2762 | speaker=unknown"
msgid "こうなると青子の反応に一縷の望みをかける鳶丸だが―――"
msgstr ""

#. Occurrence 2_4:1531:2763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0020; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1531
msgctxt "text_id=2763 | speaker=aoko"
msgid "「そりゃそうでしょ、好き嫌いは誰にもあるし。"
msgstr ""

#. Occurrence 2_4:1537:2764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0021; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1537
msgctxt "text_id=2764 | speaker=aoko"
msgid "　けどこればかりはね。彼が私と仲良くしたいって言っても、私は嫌いなんだから仕方ない」"
msgstr ""

#. Occurrence 2_4:1543:2765: scene=2_4
#: 2_4:1543
msgctxt "text_id=2765 | speaker=unknown"
msgid "　ドライと言えばドライ。"
msgstr ""

#. Occurrence 2_4:1548:2766: scene=2_4
#: 2_4:1548
msgctxt "text_id=2766 | speaker=unknown"
msgid "　スマートと言えばスマートな青子の感想に、柄にもなく憤慨してしまうのだった。"
msgstr ""

#. Occurrence 2_4:1582:2767: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0029; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1582
msgctxt "text_id=2767 | speaker=tobimaru"
msgid "「いや、そんなお友達感覚の話じゃなくてだな！"
msgstr ""

#. Occurrence 2_4:1588:2768: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0030; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1588
msgctxt "text_id=2768 | speaker=tobimaru"
msgid "　そういう好き嫌いじゃなくて、草の字は本気でおまえに惚れてるって言ったんだよ！」"
msgstr ""

#. Occurrence 2_4:1607:2769: scene=2_4
#: 2_4:1607
msgctxt "text_id=2769 | speaker=unknown"
msgid "　真顔で怒鳴る鳶丸。"
msgstr ""

#. Occurrence 2_4:1612:2770: scene=2_4
#: 2_4:1612
msgctxt "text_id=2770 | speaker=unknown"
msgid "　それに、青子はぽかんとした顔を向けていた。"
msgstr ""

#. Occurrence 2_4:1632:2771: scene=2_4
#: 2_4:1632
msgctxt "text_id=2771 | speaker=unknown"
msgid "　まっさらなその顔は、何時間か前に財布を落とした、と気付いた放心に似ている。"
msgstr ""

#. Occurrence 2_4:1637:2772: scene=2_4
#: 2_4:1637
msgctxt "text_id=2772 | speaker=unknown"
msgid "　なんでこんな<現実|コト>になってるのか、と我を疑う一瞬の間。"
msgstr ""

#. Occurrence 2_4:1642:2773: scene=2_4
#: 2_4:1642
msgctxt "text_id=2773 | speaker=unknown"
msgid "　それは本当に一瞬で、"
msgstr ""

#. Occurrence 2_4:1679:2774: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0022; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1679
msgctxt "text_id=2774 | speaker=aoko"
msgid "「で？」"
msgstr ""

#. Occurrence 2_4:1685:2775: scene=2_4
#: 2_4:1685
msgctxt "text_id=2775 | speaker=unknown"
msgid "　何でもないコトのように、平然と青子は聞き返した。"
msgstr ""

#. Occurrence 2_4:1690:2776: scene=2_4
#: 2_4:1690
msgctxt "text_id=2776 | speaker=unknown"
msgid "　それが、一体、私にどんな意味があるのかと。"
msgstr ""

#. Occurrence 2_4:1726:2777: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0031; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1726
msgctxt "text_id=2777 | speaker=tobimaru"
msgid "「で？　ときたか。鬼でもなけりゃ悪魔だな、おまえって女は。よかろう、聞こえなかったのならもう一度言ってやる」"
msgstr ""

#. Occurrence 2_4:1732:2778: scene=2_4
#: 2_4:1732
msgctxt "text_id=2778 | speaker=unknown"
msgid "　こうなったら漢の約束もあったもんじゃない、と開き直る鳶丸。"
msgstr ""

#. Occurrence 2_4:1752:2779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0023; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1752
msgctxt "text_id=2779 | speaker=aoko"
msgid "「いいわよそんなの。つまらないもの」"
msgstr ""

#. Occurrence 2_4:1770:2780: scene=2_4
#: 2_4:1770
msgctxt "text_id=2780 | speaker=unknown"
msgid "　それをあっさりと、心底からの感想で彼女は切り捨てた。"
msgstr ""

#. Occurrence 2_4:1806:2781: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0032; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1806
msgctxt "text_id=2781 | speaker=tobimaru"
msgid "「………………」"
msgstr ""

#. Occurrence 2_4:1812:2782: scene=2_4
#: 2_4:1812
msgctxt "text_id=2782 | speaker=unknown"
msgid "　とりあえず、学校中のいまだ健気に片思いをしている男子生徒のため、この悪鬼に相応しい呼称はないかと模索する鳶丸だった。"
msgstr ""

#. Occurrence 2_4:1860:2783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0024; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1860
msgctxt "text_id=2783 | speaker=aoko"
msgid "「なるほどね、それでさっきの話に結びつくワケだ。"
msgstr ""

#. Occurrence 2_4:1871:2784: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0025; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1871
msgctxt "text_id=2784 | speaker=aoko"
msgid "　へぇー、柄にもなく友達思いじゃない殿下？"
msgstr ""

#. Occurrence 2_4:1877:2785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0026; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1877
msgctxt "text_id=2785 | speaker=aoko"
msgid "　ってコトは聞くも無惨、語るも無情っていう私の噂話、教えてあげたんでしょう？」"
msgstr ""

#. Occurrence 2_4:1883:2786: scene=2_4
#: 2_4:1883
msgctxt "text_id=2786 | speaker=unknown"
msgid "　ふふ、と妖しい笑みを浮かべる青子。"
msgstr ""

#. Occurrence 2_4:1888:2787: scene=2_4
#: 2_4:1888
msgctxt "text_id=2787 | speaker=unknown"
msgid "　鳶丸はこの相手に色恋ざたの話をした事を、どっかにいる神さまに懺悔した。"
msgstr ""

#. Occurrence 2_4:1922:2788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0027; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1922
msgctxt "text_id=2788 | speaker=aoko"
msgid "「鳶丸にしちゃあ正しい判断ね。誉めてあげるから、どんな話をしたのか聞きたいなー、私」"
msgstr ""

#. Occurrence 2_4:1927:2789: scene=2_4
#: 2_4:1927
msgctxt "text_id=2789 | speaker=unknown"
msgid "　笑顔のくせに殺気を放つのは止めてほしい。"
msgstr ""

#. Occurrence 2_4:1950:2790: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0033; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1950
msgctxt "text_id=2790 | speaker=tobimaru"
msgid "「……代表作と、ここでの事件を二つばかり」"
msgstr ""

#. Occurrence 2_4:1955:2791: scene=2_4
#: 2_4:1955
msgctxt "text_id=2791 | speaker=unknown"
msgid "　遠慮がちな鳶丸の返答を聞いて、満足げに頷く青子。"
msgstr ""

#. Occurrence 2_4:1991:2792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0028; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1991
msgctxt "text_id=2792 | speaker=aoko"
msgid "「こういう時、噂話って便利よね。うるさいのを追っ払ってくれるから。でも、そんな話を考えなしで広めたら大変だから、これからは気をつけてね」"
msgstr ""

#. Occurrence 2_4:2012:2793: scene=2_4
#: 2_4:2012
msgctxt "text_id=2793 | speaker=unknown"
msgid "　それは、語尾にハートマークでもつきそうな、ゾッとするほど甘い笑顔だった。"
msgstr ""

#. Occurrence 2_4:2048:2794: scene=2_4
#: 2_4:2048
msgctxt "text_id=2794 | speaker=unknown"
msgid "　怒りにしろ喜びにしろ、感情がハイになると蒼崎は可愛らしい口調になる……"
msgstr ""

#. Occurrence 2_4:2053:2795: scene=2_4
#: 2_4:2053
msgctxt "text_id=2795 | speaker=unknown"
msgid "　そんな新事実を発見した鳶丸だが、だからといってこの場がどうにかなる訳でもない。"
msgstr ""

#. Occurrence 2_4:2091:2796: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0034; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2091
msgctxt "text_id=2796 | speaker=tobimaru"
msgid "「ああ、俺も命は惜しいからな、口はもう滑らねえよ。"
msgstr ""

#. Occurrence 2_4:2103:2797: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0035; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2103
msgctxt "text_id=2797 | speaker=tobimaru"
msgid "　……けどよ蒼崎。本気で草十郎が嫌いなのか？」"
msgstr ""

#. Occurrence 2_4:2124:2798: scene=2_4
#: 2_4:2124
msgctxt "text_id=2798 | speaker=unknown"
msgid "　もうこの話題は避けるべきだと分かっていても<果敢|かかん>に挑む鳶丸。"
msgstr ""

#. Occurrence 2_4:2129:2799: scene=2_4
#: 2_4:2129
msgctxt "text_id=2799 | speaker=unknown"
msgid "　男の友情というものは、時に真珠より美しい。"
msgstr ""

#. Occurrence 2_4:2162:2800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0029; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2162
msgctxt "text_id=2800 | speaker=aoko"
msgid "「まあ……好きじゃないから嫌い、っていうワケじゃないけど。私が彼の事を嫌う理由は自分でも分からない。"
msgstr ""

#. Occurrence 2_4:2192:2801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0030; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2192
msgctxt "text_id=2801 | speaker=aoko"
msgid "　だからダメなのね、きっと」"
msgstr ""

#. Occurrence 2_4:2197:2802: scene=2_4
#: 2_4:2197
msgctxt "text_id=2802 | speaker=unknown"
msgid "　鳶丸の顔を立てていくらか思考実験したのか、青子はしばし悩んでからそんな返答をする。"
msgstr ""

#. Occurrence 2_4:2202:2803: scene=2_4
#: 2_4:2202
msgctxt "text_id=2803 | speaker=unknown"
msgid "　即答ではなく熟考しての答えなら、鳶丸も文句を言う筋合いはない。"
msgstr ""

#. Occurrence 2_4:2241:2804: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0036; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2241
msgctxt "text_id=2804 | speaker=tobimaru"
msgid "「そうか。ま、そういうコトならしょうがねえか。"
msgstr ""

#. Occurrence 2_4:2252:2805: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0037; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2252
msgctxt "text_id=2805 | speaker=tobimaru"
msgid "　なにしろきれいさっぱり感情論だ。お互い理由もなく好きと嫌いじゃ手を貸す隙間もねえワケだし」"
msgstr ""

#. Occurrence 2_4:2257:2806: scene=2_4
#: 2_4:2257
msgctxt "text_id=2806 | speaker=unknown"
msgid "　これでこの話は終わりか、と草十郎に謝りながら天をあおぐ鳶丸。"
msgstr ""

#. Occurrence 2_4:2275:2807: scene=2_4
#: 2_4:2275
msgctxt "text_id=2807 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 2_4:2294:2808: scene=2_4
#: 2_4:2294
msgctxt "text_id=2808 | speaker=unknown"
msgid "　その降参を告げる一言が、蒼崎青子の興味を引いたらしい。"
msgstr ""

#. Occurrence 2_4:2320:2809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0031; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2320
msgctxt "text_id=2809 | speaker=aoko"
msgid "「……待って。今の、どういう意味？」"
msgstr ""

#. Occurrence 2_4:2326:2810: scene=2_4
#: 2_4:2326
msgctxt "text_id=2810 | speaker=unknown"
msgid "　上機嫌ぽかった口調が変わる。"
msgstr ""

#. Occurrence 2_4:2331:2811: scene=2_4
#: 2_4:2331
msgctxt "text_id=2811 | speaker=unknown"
msgid "　それに気付かず、軽い気持ちで鳶丸は答えた。"
msgstr ""

#. Occurrence 2_4:2358:2812: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0038; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2358
msgctxt "text_id=2812 | speaker=tobimaru"
msgid "「いやアイツもさ、蒼崎に惚れた理由が分からない、なんて言いやがってよ。……ああ、違ったか、理由なんてない、なんて意味だったかな」"
msgstr ""

#. Occurrence 2_4:2364:2813: scene=2_4
#: 2_4:2364
msgctxt "text_id=2813 | speaker=unknown"
msgid "　鳶丸は“青子の外見に惹かれた”なんて草十郎の言葉を信じていないので、そこはあっさりと切り離す。"
msgstr ""

#. Occurrence 2_4:2391:2814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0032; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2391
msgctxt "text_id=2814 | speaker=aoko"
msgid "「理由はない、ですって……？」"
msgstr ""

#. Occurrence 2_4:2404:2815: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0039; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2404
msgctxt "text_id=2815 | speaker=tobimaru"
msgid "「ああ。なんで、俺がいくらおまえの噂話をしても無駄だった。あまつさえなんて言ってたかな……そうそう、理由はどうあれ、蒼崎の心配は本物なんだ、とか、自分はそれで助かってるとか。俺なんかにゃ言えない台詞だったのは確かだね、どーにも。"
msgstr ""

#. Occurrence 2_4:2417:2816: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0040; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2417
msgctxt "text_id=2816 | speaker=tobimaru"
msgid "　はっきりしてんのは他の野郎どもと違って、噂を聞いても手を引く素振りなんざ微塵もなかったって事だけ―――」"
msgstr ""

#. Occurrence 2_4:2454:2817: scene=2_4
#: 2_4:2454
msgctxt "text_id=2817 | speaker=unknown"
msgid "　そこまで調子よく語って、鳶丸は青子の変化に気が付いた。"
msgstr ""

#. Occurrence 2_4:2477:2818: scene=2_4
#: 2_4:2477
msgctxt "text_id=2818 | speaker=unknown"
msgid "　彼女は壁を睨んでいる。"
msgstr ""

#. Occurrence 2_4:2482:2819: scene=2_4
#: 2_4:2482
msgctxt "text_id=2819 | speaker=unknown"
msgid "　その、仇を見るような視線は無言のまま何分か続けられた。"
msgstr ""

#. Occurrence 2_4:2530:2820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0033; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2530
msgctxt "text_id=2820 | speaker=aoko"
msgid "「……なにそれ。さっきといいそれといい、どこかで聞いたような事ばっかり―――」"
msgstr ""

#. Occurrence 2_4:2569:2821: scene=2_4
#: 2_4:2569
msgctxt "text_id=2821 | speaker=unknown"
msgid "　ぎり、と歯を噛む音がする。"
msgstr ""

#. Occurrence 2_4:2574:2822: scene=2_4
#: 2_4:2574
msgctxt "text_id=2822 | speaker=unknown"
msgid "　反感ここに極まり、あまりの不機嫌さに目の前にいる鳶丸が視界に入っていないようだ。"
msgstr ""

#. Occurrence 2_4:2584:2823: scene=2_4
#: 2_4:2584
msgctxt "text_id=2823 | speaker=unknown"
msgid "　なんか、また絶望的に草十郎に迷惑かける事を言っちまったな、と鳶丸は天をあおいだ。"
msgstr ""

#. Occurrence 2_4:2649:2824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0034; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2649
msgctxt "text_id=2824 | speaker=aoko"
msgid "「……少し分かったわ。なんでアイツが気に喰わないのか」"
msgstr ""

#. Occurrence 2_4:2661:2825: scene=2_4
#: 2_4:2661
msgctxt "text_id=2825 | speaker=unknown"
msgid "　聞きたくない、どっかよそで喋ってくれないもんかなー、などと目を逸らす鳶丸を無視して、青子は<呪詛|じゅそ>のように言葉を紡ぐ。"
msgstr ""

#. Occurrence 2_4:2687:2826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0035; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2687
msgctxt "text_id=2826 | speaker=aoko"
msgid "「あいつ、私が嫌いな奴と言動が似てるのよ。"
msgstr ""

#. Occurrence 2_4:2693:2827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0036; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2693
msgctxt "text_id=2827 | speaker=aoko"
msgid "　誰彼かまわずいい人扱いされるところとか。妙にふわふわしてるところとか。いちいち私の癇に障るところとか」"
msgstr ""

#. Occurrence 2_4:2711:2828: scene=2_4
#: 2_4:2711
msgctxt "text_id=2828 | speaker=unknown"
msgid "　最後のはただの八つ当たりだよな、と所在なげに時計とか見てみる副会長。"
msgstr ""

#. Occurrence 2_4:2733:2829: scene=2_4
#: 2_4:2733
msgctxt "text_id=2829 | speaker=unknown"
msgid "　―――と。"
msgstr ""

#. Occurrence 2_4:2738:2830: scene=2_4
#: 2_4:2738
msgctxt "text_id=2830 | speaker=unknown"
msgid "　時計は、当然のように午後一時を回っていた。"
msgstr ""

#. Occurrence 2_4:2782:2831: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0041; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2782
msgctxt "text_id=2831 | speaker=tobimaru"
msgid "「……分かった、もういい。この話をした俺が悪かった。"
msgstr ""

#. Occurrence 2_4:2793:2832: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0042; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2793
msgctxt "text_id=2832 | speaker=tobimaru"
msgid "　で、俺に用ってのはなんだよ。言っとくけど、もう授業始まってるぜ？」"
msgstr ""

#. Occurrence 2_4:2812:2833: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_0; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2812
msgctxt "text_id=2833 | speaker=aoko"
msgid "「へ？　授業って、なんで？　"
msgstr ""

#. Occurrence 2_4:2824:2834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_1; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2824
msgctxt "text_id=2834 | speaker=aoko"
msgid "いつ？」"
msgstr ""

#. Occurrence 2_4:2835:2835: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0043; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2835
msgctxt "text_id=2835 | speaker=tobimaru"
msgid "「いや、さっき草の字が出てってから、蒼崎がぎらーんって壁睨んでた時にチャイムが鳴ったんだよ。いいのか生徒会長。五時限目ばっくれて」"
msgstr ""

#. Occurrence 2_4:2929:2836: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0038; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2929
msgctxt "text_id=2836 | speaker=aoko"
msgid "「っ、いいわけないでしょ！"
msgstr ""

msgctxt "text_id=2837 | speaker=unknown"
msgid "　なんで黙ってんのよアンタはーっ！」"
msgstr ""

#. Occurrence 2_4:2938:2838: scene=2_4
#: 2_4:2938
msgctxt "text_id=2838 | speaker=unknown"
msgid "　鳶丸のネクタイをひっぱりながら、半泣き状態で青子は怒鳴る。"
msgstr ""

#. Occurrence 2_4:2944:2839: scene=2_4
#: 2_4:2944
msgctxt "text_id=2839 | speaker=unknown"
msgid "対して、鳶丸は両手をギブアップの形で上げていた。勝者の余裕である。"
msgstr ""

#. Occurrence 2_4:2980:2840: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2840 | speaker=tobimaru"
msgid "「蚊のほうがエレガントなんて言いやがった仕返しだ。"
msgstr ""

#. Occurrence 2_4:2980:2841: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2841 | speaker=tobimaru"
msgid "　思い知るがいい、男の純情を踏みにじったり焼き殺したりするエリート悪魔め」"
msgstr ""

#. Occurrence 2_4:2999:2842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2842 | speaker=aoko"
msgid "「あいかわらず細かく根に持つ男！"
msgstr ""

#. Occurrence 2_4:2999:2843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2843 | speaker=aoko"
msgid "　言動には言動で返しなさいよね、卑怯者！」"
msgstr ""

#. Occurrence 2_4:3005:2844: scene=2_4
#: 2_4:3005
msgctxt "text_id=2844 | speaker=unknown"
msgid "　鳶丸の首にぐいぐいとネクタイが締まっていく。"
msgstr ""

#. Occurrence 2_4:3010:2845: scene=2_4
#: 2_4:3010
msgctxt "text_id=2845 | speaker=unknown"
msgid "　それすら勝者の愉悦、とチンピラ顔で笑う副会長。"
msgstr ""

#. Occurrence 2_4:3057:2846: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0045; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3057
msgctxt "text_id=2846 | speaker=tobimaru"
msgid "「ふふふ、おまえの古典が<補習|はめつ>に向かっているのは周知の事実。そしてＡ組の五時限目は言うまでもない。<藤代|ふじしろ>のばあさん、蒼崎のこと嫌ってるしな」"
msgstr ""

#. Occurrence 2_4:3063:2847: scene=2_4
#: 2_4:3063
msgctxt "text_id=2847 | speaker=unknown"
msgid "　藤代というのは古参教師のひとりで、言うまでもなく、担当は古典である。"
msgstr ""

#. Occurrence 2_4:3084:2848: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0046; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3084
msgctxt "text_id=2848 | speaker=tobimaru"
msgid "「さあ、こんな所で俺のネクタイを引っぱる余裕があるのなら、急いで自分の教室に立ち返るがいい。"
msgstr ""

#. Occurrence 2_4:3090:2849: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0047; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3090
msgctxt "text_id=2849 | speaker=tobimaru"
msgid "　情けだ、別に止めはしねえよ」"
msgstr ""

#. Occurrence 2_4:3121:2850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2850 | speaker=aoko"
msgid "「っっっクソ、あんたなんかに嵌められるなんて！"
msgstr ""

#. Occurrence 2_4:3121:2851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2851 | speaker=aoko"
msgid "　えぇい、このまま死んでしまえ！」"
msgstr ""

#. Occurrence 2_4:3127:2852: scene=2_4
#: 2_4:3127
msgctxt "text_id=2852 | speaker=unknown"
msgid "　さらに締まるネクタイ。"
msgstr ""

#. Occurrence 2_4:3132:2853: scene=2_4
#: 2_4:3132
msgctxt "text_id=2853 | speaker=unknown"
msgid "　有言実行、容赦のない青子の窒息攻撃にひととき、神を見る鳶丸だった。"
msgstr ""

#. Occurrence 2_4:3182:2854: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0048; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3182
msgctxt "text_id=2854 | speaker=tobimaru"
msgid "「―――ハ！？　いや、待て待て、ホントに死んじまうだろうがっ！　今ならまだ間に合う、十分過ぎたら遅刻から欠席扱いだぞ！？」"
msgstr ""

#. Occurrence 2_4:3188:2855: scene=2_4
#: 2_4:3188
msgctxt "text_id=2855 | speaker=unknown"
msgid "　とっさに時計を見る青子。"
msgstr ""

#. Occurrence 2_4:3208:2856: scene=2_4
#: 2_4:3208
msgctxt "text_id=2856 | speaker=unknown"
msgid "　時刻は午後一時七分。二階である第二生徒会室から、三階端のＡ組の教室まで走ればギリギリ間に合う距離だった。"
msgstr ""

#. Occurrence 2_4:3251:2857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0041; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3251
msgctxt "text_id=2857 | speaker=aoko"
msgid "「命<拾|ひろ>ったわね、鳶丸」"
msgstr ""

#. Occurrence 2_4:3257:2858: scene=2_4
#: 2_4:3257
msgctxt "text_id=2858 | speaker=unknown"
msgid "　ち、と言い捨てる青子。"
msgstr ""

#. Occurrence 2_4:3262:2859: scene=2_4
#: 2_4:3262
msgctxt "text_id=2859 | speaker=unknown"
msgid "　あながち嘘でもないのが鳶丸的に頭がいたい。"
msgstr ""

#. Occurrence 2_4:3308:2860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2860 | speaker=aoko"
msgid "「あと放課後、ここにいて。"
msgstr ""

#. Occurrence 2_4:3308:2861: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2861 | speaker=aoko"
msgid "　頼みたい事があるのはホントなんだから」"
msgstr ""

#. Occurrence 2_4:3332:2862: scene=2_4
#: 2_4:3332
msgctxt "text_id=2862 | speaker=unknown"
msgid "　言うが早いか、青子は隼のように生徒会室から飛び出していった。"
msgstr ""

#. Occurrence 2_4:3380:2863: scene=2_4
#: 2_4:3380
msgctxt "text_id=2863 | speaker=unknown"
msgid "　ようやくひとりになって、"
msgstr ""

msgctxt "text_id=2864 | speaker=unknown"
msgid "鳶丸は開けっぱなしの扉を閉め、鍵をかけて"
msgstr ""

msgctxt "text_id=2865 | speaker=unknown"
msgid "椅子に座る。"
msgstr ""

#. Occurrence 2_4:3391:2866: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0049; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3391
msgctxt "text_id=2866 | speaker=tobimaru"
msgid "「……ったく。ああしてる分には楽しいヤツなんだけどよ、蒼崎は」"
msgstr ""

#. Occurrence 2_4:3397:2867: scene=2_4
#: 2_4:3397
msgctxt "text_id=2867 | speaker=unknown"
msgid "　ギシリ、とパイプ椅子の背もたれを<軋|きし>ませてため息をつく。"
msgstr ""

#. Occurrence 2_4:3454:2868: scene=2_4
#: 2_4:3454
msgctxt "text_id=2868 | speaker=unknown"
msgid "　窓の外は気持ちのいい晴れ模様。"
msgstr ""

#. Occurrence 2_4:3459:2869: scene=2_4
#: 2_4:3459
msgctxt "text_id=2869 | speaker=unknown"
msgid "　が、冬の日射しはすぐに弱くなっていく。"
msgstr ""

#. Occurrence 2_4:3464:2870: scene=2_4
#: 2_4:3464
msgctxt "text_id=2870 | speaker=unknown"
msgid "　じき日の勢いも翳って、暖房の入っていない生徒会室は段々と冷えていくだろう。"
msgstr ""

#. Occurrence 2_4:3469:2871: scene=2_4
#: 2_4:3469
msgctxt "text_id=2871 | speaker=unknown"
msgid "　ストーブなんて気の利いた物は第一生徒会室に流れているので、この寒さには慣れろという他ないのだが。"
msgstr ""

#. Occurrence 2_4:3558:2872: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2872 | speaker=tobimaru"
msgid "「こんな天気が続けばいいんだがねぇ。"
msgstr ""

#. Occurrence 2_4:3558:2873: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2873 | speaker=tobimaru"
msgid "　天気予報じゃ、また雲行き怪しいって話だが」"
msgstr ""

#. Occurrence 2_4:3575:2874: scene=2_4
#: 2_4:3575
msgctxt "text_id=2874 | speaker=unknown"
msgid "　なんとなく暗示的な独白の後、鳶丸は草十郎の姿を思い浮べた。"
msgstr ""

#. Occurrence 2_4:3580:2875: scene=2_4
#: 2_4:3580
msgctxt "text_id=2875 | speaker=unknown"
msgid "　曇りと晴れ。そのどちらが彼らしいか考えてみたが、ついに答えは出なかった。"
msgstr ""

#. Occurrence 2_5:55:2876: scene=2_5
#: 2_5:55
msgctxt "text_id=2876 | speaker=unknown"
msgid "　その日の学校が終わると、草十郎は寄り道一つせずアルバイト先に直行した。"
msgstr ""

#. Occurrence 2_5:60:2877: scene=2_5
#: 2_5:60
msgctxt "text_id=2877 | speaker=unknown"
msgid "　学校側に申告してあるのは三咲町商店街にある中華飯店と鮮魚店だけで、他のアルバイトは秘密にしている。"
msgstr ""

#. Occurrence 2_5:65:2878: scene=2_5
#: 2_5:65
msgctxt "text_id=2878 | speaker=unknown"
msgid "　それも単に数が多いからではなく、それ以前に法律に違反していそうな働き先だったからだ。"
msgstr ""

#. Occurrence 2_5:121:2879: scene=2_5
#: 2_5:121
msgctxt "text_id=2879 | speaker=unknown"
msgid "　今日のアルバイト先はその最たるもので、<社木|やしろぎ>駅前にあるパチンコ店だ。"
msgstr ""

#. Occurrence 2_5:128:2880: scene=2_5
#: 2_5:128
msgctxt "text_id=2880 | speaker=unknown"
msgid "　学校の制服から店の黒いタキシードじみた制服に着替え、仕事はじめに店周りの掃除をする。"
msgstr ""

#. Occurrence 2_5:174:2881: scene=2_5
#: 2_5:174
msgctxt "text_id=2881 | speaker=unknown"
msgid "　三咲市の顔である<社木|やしろぎ>の駅前は幾多のショッピングビルが競い合うように乱立し、アーケード街もそれらに<倣|なら>うように騒がしい。"
msgstr ""

#. Occurrence 2_5:179:2882: scene=2_5
#: 2_5:179
msgctxt "text_id=2882 | speaker=unknown"
msgid "　人が多くなれば生み出される物も多くなる。"
msgstr ""

#. Occurrence 2_5:184:2883: scene=2_5
#: 2_5:184
msgctxt "text_id=2883 | speaker=unknown"
msgid "　浪漫として言えば笑顔であり、"
msgstr ""

#. Occurrence 2_5:189:2884: scene=2_5
#: 2_5:189
msgctxt "text_id=2884 | speaker=unknown"
msgid "　現実的に言えば流通であり、"
msgstr ""

#. Occurrence 2_5:194:2885: scene=2_5
#: 2_5:194
msgctxt "text_id=2885 | speaker=unknown"
msgid "　より現実的に言えばゴミである。"
msgstr ""

#. Occurrence 2_5:248:2886: scene=2_5
#: 2_5:248
msgctxt "text_id=2886 | speaker=unknown"
msgid "　クリーンな町作りを目指している社木だが、そのルールには逆らえない。"
msgstr ""

#. Occurrence 2_5:253:2887: scene=2_5
#: 2_5:253
msgctxt "text_id=2887 | speaker=unknown"
msgid "　それがこういった店なら尚更だ。"
msgstr ""

#. Occurrence 2_5:258:2888: scene=2_5
#: 2_5:258
msgctxt "text_id=2888 | speaker=unknown"
msgid "　商売柄<質|たち>の悪い人種を呼びこみやすいホールの前は、日に何度も清掃を心がけるべきである。"
msgstr ""

#. Occurrence 2_5:279:2889: scene=2_5
#: 2_5:279
msgctxt "text_id=2889 | speaker=unknown"
msgid "　冬の寒空の下、草十郎は煙草の吸い殻を集め、チラシを拾い、空き缶をゴミ箱へ。"
msgstr ""

#. Occurrence 2_5:284:2890: scene=2_5
#: 2_5:284
msgctxt "text_id=2890 | speaker=unknown"
msgid "　山での生活を彷彿とさせるものがあるらしく、草十郎は気軽に、淡々と掃除をこなした。"
msgstr ""

#. Occurrence 2_5:339:2891: scene=2_5
#: 2_5:339
msgctxt "text_id=2891 | speaker=unknown"
msgid "　ひととおり店周りを綺麗にし、晴れて暖房の効いた店内に戻る。"
msgstr ""

#. Occurrence 2_5:344:2892: scene=2_5
#: 2_5:344
msgctxt "text_id=2892 | speaker=unknown"
msgid "　まぶしく目に痛い騒音、"
msgstr ""

#. Occurrence 2_5:349:2893: scene=2_5
#: 2_5:349
msgctxt "text_id=2893 | speaker=unknown"
msgid "　充満するタバコの臭いに圧倒されながら店内を横断して事務所へ向かう。"
msgstr ""

#. Occurrence 2_5:399:2894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0000; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:399
msgctxt "text_id=2894 | speaker=soujuurou"
msgid "「店長。外まわりの掃除、終わりました」"
msgstr ""

#. Occurrence 2_5:405:2895: voice_id=D10_2_5_0000; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:405
msgctxt "text_id=2895 | speaker=unknown"
msgid "「はい、ごくろうさま。それで、いいかな。二階の四十番台のお客さんの様子、見てきてくれない？"
msgstr ""

#. Occurrence 2_5:411:2896: voice_id=D10_2_5_0001; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:411
msgctxt "text_id=2896 | speaker=unknown"
msgid "　どうも懐にのんでそうなんだよね、あのお姉さん」"
msgstr ""

#. Occurrence 2_5:431:2897: scene=2_5
#: 2_5:431
msgctxt "text_id=2897 | speaker=unknown"
msgid "　元会社員の、人の良さそうな店長さんである。"
msgstr ""

#. Occurrence 2_5:436:2898: scene=2_5
#: 2_5:436
msgctxt "text_id=2898 | speaker=unknown"
msgid "　あきらかに学生である草十郎を採用したのはその苦学生ぶりに感動したから―――ではなく、"
msgstr ""

#. Occurrence 2_5:441:2899: scene=2_5
#: 2_5:441
msgctxt "text_id=2899 | speaker=unknown"
msgid "　店員がみんな怖い顔をしているので一人でも心安らげる店員がほしい、という理由らしい。"
msgstr ""

#. Occurrence 2_5:462:2900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0001; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:462
msgctxt "text_id=2900 | speaker=soujuurou"
msgid "「いいんですか？　トイレの掃除、まだですけど」"
msgstr ""

#. Occurrence 2_5:468:2901: voice_id=D10_2_5_0002; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:468
msgctxt "text_id=2901 | speaker=unknown"
msgid "「いいのいいの。なんかねぇ、カメラの死角にいるんでイマイチ確証とれないの。"
msgstr ""

#. Occurrence 2_5:474:2902: voice_id=D10_2_5_0003; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:474
msgctxt "text_id=2902 | speaker=unknown"
msgid "　草ちゃん、いまのところ的中率百パーセントでしょ。様子見てきてくれないかなぁ」"
msgstr ""

#. Occurrence 2_5:484:2903: scene=2_5
#: 2_5:484
msgctxt "text_id=2903 | speaker=unknown"
msgid "　そういう事でしたら、と掃除用具を片付けて草十郎は二階フロアに向かった。"
msgstr ""

#. Occurrence 2_5:542:2904: scene=2_5
#: 2_5:542
msgctxt "text_id=2904 | speaker=unknown"
msgid "　店は典型的な二階建ての、大きい部類に入るパチンコ店である。"
msgstr ""

#. Occurrence 2_5:547:2905: scene=2_5
#: 2_5:547
msgctxt "text_id=2905 | speaker=unknown"
msgid "　基本的には地域密着型で、あまりあこぎな調整もせず、少しずつ町の皆さんから収入を得ることを良しとしている。"
msgstr ""

#. Occurrence 2_5:552:2906: scene=2_5
#: 2_5:552
msgctxt "text_id=2906 | speaker=unknown"
msgid "　が、店側はそのつもりでも、お客様は千差万別。"
msgstr ""

#. Occurrence 2_5:572:2907: scene=2_5
#: 2_5:572
msgctxt "text_id=2907 | speaker=unknown"
msgid "　気軽に遊びに来る者もいれば、これで食べている<職業博徒|プ　　ロ>、はては不正を働いて儲けようという輩もやってくる。"
msgstr ""

#. Occurrence 2_5:577:2908: scene=2_5
#: 2_5:577
msgctxt "text_id=2908 | speaker=unknown"
msgid "　中でも八十年代中期から流行しだしたある機械は、ゲーム台の電気系統に外部からアクセスしてプログラムを狂わせ、俗に言うスリーセブン等の大当たりをたやすく実現してしまう。"
msgstr ""

#. Occurrence 2_5:608:2909: scene=2_5
#: 2_5:608
msgctxt "text_id=2909 | speaker=unknown"
msgid "　当然店側としてもそういった人種の入場はお断りしたいのだが、確たる証拠もなしにお帰り願う訳にもいかない。"
msgstr ""

#. Occurrence 2_5:608:2910: scene=2_5
#: 2_5:608
msgctxt "text_id=2910 | speaker=unknown"
msgid "　客商売である以上、疑わしきは罰せず、がルールである。"
msgstr ""

#. Occurrence 2_5:613:2911: scene=2_5
#: 2_5:613
msgctxt "text_id=2911 | speaker=unknown"
msgid "　結果、現行犯としてとっ捕まえるのが店側の正義となる。"
msgstr ""

#. Occurrence 2_5:618:2912: scene=2_5
#: 2_5:618
msgctxt "text_id=2912 | speaker=unknown"
msgid "　そういった不心得者をゴト師と言うらしいが、草十郎にはそのへんの事情は一切分かっていない。"
msgstr ""

#. Occurrence 2_5:623:2913: scene=2_5
#: 2_5:623
msgctxt "text_id=2913 | speaker=unknown"
msgid "　彼が承知しているのは、彼らが店側にとって厄介な相手であり、かつ、不正を働いているルール違反者である、という事だけだ。"
msgstr ""

#. Occurrence 2_5:662:2914: scene=2_5
#: 2_5:662
msgctxt "text_id=2914 | speaker=unknown"
msgid "　二階に上がる。"
msgstr ""

#. Occurrence 2_5:667:2915: scene=2_5
#: 2_5:667
msgctxt "text_id=2915 | speaker=unknown"
msgid "　有線のラジオもゲーム台の音も、一階よりは控えめに流れている。"
msgstr ""

#. Occurrence 2_5:672:2916: scene=2_5
#: 2_5:672
msgctxt "text_id=2916 | speaker=unknown"
msgid "　一階の百台に対して二階のゲーム台の数は八十あまり。空席はちらほらとあるものの、夕方にしては客入りは良好だろう。"
msgstr ""

#. Occurrence 2_5:677:2917: scene=2_5
#: 2_5:677
msgctxt "text_id=2917 | speaker=unknown"
msgid "　店長の言う四十番台は店の中ごろの列だ。"
msgstr ""

#. Occurrence 2_5:695:2918: scene=2_5
#: 2_5:695
msgctxt "text_id=2918 | speaker=unknown"
msgid "　さりげなく列の入り口あたりの壁に寄りかかってみると、たしかに派手に<大当たり|フィーバー>しているお客さんがいた。"
msgstr ""

#. Occurrence 2_5:741:2919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0002; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:741
msgctxt "text_id=2919 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 2_5:746:2920: scene=2_5
#: 2_5:746
msgctxt "text_id=2920 | speaker=unknown"
msgid "　<一目|ひとめ>見た瞬間に違うな、と草十郎は直感した。"
msgstr ""

#. Occurrence 2_5:751:2921: scene=2_5
#: 2_5:751
msgctxt "text_id=2921 | speaker=unknown"
msgid "　何を以てプロと言うかは疑問だが、特別という意味なら彼女は本物だ。"
msgstr ""

#. Occurrence 2_5:756:2922: scene=2_5
#: 2_5:756
msgctxt "text_id=2922 | speaker=unknown"
msgid "　なんとなく、その幸運の強さが感じ取れる。"
msgstr ""

#. Occurrence 2_5:761:2923: scene=2_5
#: 2_5:761
msgctxt "text_id=2923 | speaker=unknown"
msgid "　周りの客達の関心を一身に浴びながら、彼女は黙々とハンドルを回している。"
msgstr ""

#. Occurrence 2_5:781:2924: scene=2_5
#: 2_5:781
msgctxt "text_id=2924 | speaker=unknown"
msgid "　歳は<草十郎|じぶん>より何歳か上。"
msgstr ""

#. Occurrence 2_5:786:2925: scene=2_5
#: 2_5:786
msgctxt "text_id=2925 | speaker=unknown"
msgid "　緑色の、体の線がはっきりと判る洋服を着ている。上着とスカートが一体になったような服だ。"
msgstr ""

#. Occurrence 2_5:791:2926: scene=2_5
#: 2_5:791
msgctxt "text_id=2926 | speaker=unknown"
msgid "　足は素肌ではなくストッキングをはいている。"
msgstr ""

#. Occurrence 2_5:796:2927: scene=2_5
#: 2_5:796
msgctxt "text_id=2927 | speaker=unknown"
msgid "　細い両足は艶やかに組まれ、パチンコをしているというよりは絵画のモデルのような優雅さだった。"
msgstr ""

#. Occurrence 2_5:801:2928: scene=2_5
#: 2_5:801
msgctxt "text_id=2928 | speaker=unknown"
msgid "　赤みのかかった黒髪は短く、涼しげにかけたメガネと赤い唇がやけに決まっていた。"
msgstr ""

#. Occurrence 2_5:821:2929: scene=2_5
#: 2_5:821
msgctxt "text_id=2929 | speaker=unknown"
msgid "　正直に言って、こんな場所でフィーバーを出していい美人ではない。"
msgstr ""

#. Occurrence 2_5:826:2930: scene=2_5
#: 2_5:826
msgctxt "text_id=2930 | speaker=unknown"
msgid "　彼女の足元には四つの大箱が重ねられていて、その勢いは留まるところを知らない。"
msgstr ""

#. Occurrence 2_5:831:2931: scene=2_5
#: 2_5:831
msgctxt "text_id=2931 | speaker=unknown"
msgid "　退屈そうに、細い陶器のような指が長い煙草を唇に運ぶ。"
msgstr ""

#. Occurrence 2_5:852:2932: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0003; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:852
msgctxt "text_id=2932 | speaker=soujuurou"
msgid "『……なんか……どっかで……』"
msgstr ""

#. Occurrence 2_5:857:2933: scene=2_5
#: 2_5:857
msgctxt "text_id=2933 | speaker=unknown"
msgid "　そう思った瞬間、メガネごしに視線が壁側―――草十郎を見た。"
msgstr ""

#. Occurrence 2_5:1004:2934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0004; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1004
msgctxt "text_id=2934 | speaker=soujuurou"
msgid "「………！」"
msgstr ""

#. Occurrence 2_5:1009:2935: scene=2_5
#: 2_5:1009
msgctxt "text_id=2935 | speaker=unknown"
msgid "　とたん、背中に走る悪寒。"
msgstr ""

#. Occurrence 2_5:1014:2936: scene=2_5
#: 2_5:1014
msgctxt "text_id=2936 | speaker=unknown"
msgid "　反射的にこぼれる悲鳴を必死に手で押さえつける。"
msgstr ""

#. Occurrence 2_5:1049:2937: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0005; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1049
msgctxt "text_id=2937 | speaker=soujuurou"
msgid "『あの<女|ひと>、昨日の……！』"
msgstr ""

#. Occurrence 2_5:1097:2938: scene=2_5
#: 2_5:1097
msgctxt "text_id=2938 | speaker=unknown"
msgid "　確証のない直感に弾かれて、草十郎は<脱兎|だっと>の如く走り出した。"
msgstr ""

#. Occurrence 2_5:1102:2939: scene=2_5
#: 2_5:1102
msgctxt "text_id=2939 | speaker=unknown"
msgid "　この場から一刻も早く逃れようと、まず一階へ。"
msgstr ""

#. Occurrence 2_5:1121:2940: scene=2_5
#: 2_5:1121
msgctxt "text_id=2940 | speaker=unknown"
msgid "　そのまま外に駆け出そうとしたが、最低限の責任として店長に声をかける。"
msgstr ""

#. Occurrence 2_5:1163:2941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0006; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1163
msgctxt "text_id=2941 | speaker=soujuurou"
msgid "「店長、早退します。それと、二階の人は問題ないです」"
msgstr ""

#. Occurrence 2_5:1183:2942: scene=2_5
#: 2_5:1183
msgctxt "text_id=2942 | speaker=unknown"
msgid "　心の動揺をなんとか抑えこみながら告げ、学校の制服を紙袋につめて店を飛びだした。"
msgstr ""

#. Occurrence 2_5:1258:2943: scene=2_5
#: 2_5:1258
msgctxt "text_id=2943 | speaker=unknown"
msgid "　曇った天候のせいか、すでに夜の影が濃い社木の商店街を走り抜けて駅に向かう。"
msgstr ""

#. Occurrence 2_5:1263:2944: scene=2_5
#: 2_5:1263
msgctxt "text_id=2944 | speaker=unknown"
msgid "　長い階段を矢のように駆け上がり、定期を財布から素早く取り出して改札を通り過ぎる。"
msgstr ""

#. Occurrence 2_5:1301:2945: scene=2_5
#: 2_5:1301
msgctxt "text_id=2945 | speaker=unknown"
msgid "　改札には大勢の人々がそれぞれの事情で立ち止まったり、歩いたり、話し合ったりしていた。"
msgstr ""

#. Occurrence 2_5:1306:2946: scene=2_5
#: 2_5:1306
msgctxt "text_id=2946 | speaker=unknown"
msgid "　その中で無愛想な顔をしているのは自動改札の横にある駅員室の駅員ぐらいで、ここにはちょっとだけ騒がしい安心があふれていた。"
msgstr ""

#. Occurrence 2_5:1311:2947: scene=2_5
#: 2_5:1311
msgctxt "text_id=2947 | speaker=unknown"
msgid "　都市の日常、と言い換えてもいい。"
msgstr ""

#. Occurrence 2_5:1316:2948: scene=2_5
#: 2_5:1316
msgctxt "text_id=2948 | speaker=unknown"
msgid "　間違っても、昨夜の草十郎が見てしまった風景はどこにも見当たらない。"
msgstr ""

#. Occurrence 2_5:1362:2949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0007; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1362
msgctxt "text_id=2949 | speaker=soujuurou"
msgid "「――――――はあ」"
msgstr ""

#. Occurrence 2_5:1368:2950: scene=2_5
#: 2_5:1368
msgctxt "text_id=2950 | speaker=unknown"
msgid "　ようやく肺に空気を送る。"
msgstr ""

#. Occurrence 2_5:1373:2951: scene=2_5
#: 2_5:1373
msgctxt "text_id=2951 | speaker=unknown"
msgid "　つかの間の安心から、草十郎はぴたりと立ち止まった。"
msgstr ""

#. Occurrence 2_5:1378:2952: scene=2_5
#: 2_5:1378
msgctxt "text_id=2952 | speaker=unknown"
msgid "　おそるおそる背後を振り返る。"
msgstr ""

#. Occurrence 2_5:1397:2953: scene=2_5
#: 2_5:1397
msgctxt "text_id=2953 | speaker=unknown"
msgid "　当然のように、追いかけてくる危険人物など居るはずもない。"
msgstr ""

#. Occurrence 2_5:1418:2954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0008; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1418
msgctxt "text_id=2954 | speaker=soujuurou"
msgid "『……って、考えてみると……』"
msgstr ""

#. Occurrence 2_5:1424:2955: scene=2_5
#: 2_5:1424
msgctxt "text_id=2955 | speaker=unknown"
msgid "　なぜ唐突に走りだしたのか、その理由が脆弱すぎた。"
msgstr ""

#. Occurrence 2_5:1429:2956: scene=2_5
#: 2_5:1429
msgctxt "text_id=2956 | speaker=unknown"
msgid "　そもそも自分は、人相が分かるほど“<危険|あいて>の顔”を見ていなかったではないか、と呆れかえる。"
msgstr ""

#. Occurrence 2_5:1447:2957: scene=2_5
#: 2_5:1447
msgctxt "text_id=2957 | speaker=unknown"
msgid "　頬を叩いて気合いを入れ直し、草十郎は早足でプラットホームに下りていく。"
msgstr ""

#. Occurrence 2_5:1452:2958: scene=2_5
#: 2_5:1452
msgctxt "text_id=2958 | speaker=unknown"
msgid "　あいにく電車は十分待ちだったが、ここで取り乱しても仕方がないので大人しく椅子に座った。"
msgstr ""

#. Occurrence 2_5:1514:2959: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0009; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1514
msgctxt "text_id=2959 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 2_5:1520:2960: scene=2_5
#: 2_5:1520
msgctxt "text_id=2960 | speaker=unknown"
msgid "　もういちど深呼吸。"
msgstr ""

#. Occurrence 2_5:1525:2961: scene=2_5
#: 2_5:1525
msgctxt "text_id=2961 | speaker=unknown"
msgid "　周りには自分と同じく、電車待ちの人々の姿がある。"
msgstr ""

#. Occurrence 2_5:1530:2962: scene=2_5
#: 2_5:1530
msgctxt "text_id=2962 | speaker=unknown"
msgid "　……追いかけてくる“誰か”なんて影も形もない。"
msgstr ""

#. Occurrence 2_5:1535:2963: scene=2_5
#: 2_5:1535
msgctxt "text_id=2963 | speaker=unknown"
msgid "　考えすぎだった、と、ようやく頭がクリアになる。"
msgstr ""

#. Occurrence 2_5:1540:2964: scene=2_5
#: 2_5:1540
msgctxt "text_id=2964 | speaker=unknown"
msgid "　ただ、がっくりと落ちた両肩が重いのが意外だった。"
msgstr ""

#. Occurrence 2_5:1593:2965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0010; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1593
msgctxt "text_id=2965 | speaker=soujuurou"
msgid "『……疲れてるのは分かってる。自分の体のコトだし』"
msgstr ""

#. Occurrence 2_5:1599:2966: scene=2_5
#: 2_5:1599
msgctxt "text_id=2966 | speaker=unknown"
msgid "　予想以上の強い疲労に、草十郎は嘆息した。"
msgstr ""

#. Occurrence 2_5:1604:2967: scene=2_5
#: 2_5:1604
msgctxt "text_id=2967 | speaker=unknown"
msgid "　山を下りてきてからの生活はたしかに過酷だったが、こうして座って振り返ってみると我慢できないほどではなかった。"
msgstr ""

#. Occurrence 2_5:1609:2968: scene=2_5
#: 2_5:1609
msgctxt "text_id=2968 | speaker=unknown"
msgid "　肉体的にはたぶんまだまだ大丈夫。"
msgstr ""

#. Occurrence 2_5:1614:2969: scene=2_5
#: 2_5:1614
msgctxt "text_id=2969 | speaker=unknown"
msgid "　<音|ね>をあげているのは心の問題だ。"
msgstr ""

#. Occurrence 2_5:1663:2970: scene=2_5
#: 2_5:1663
msgctxt "text_id=2970 | speaker=unknown"
msgid "　ここと山とでは何もかもが違う。"
msgstr ""

#. Occurrence 2_5:1668:2971: scene=2_5
#: 2_5:1668
msgctxt "text_id=2971 | speaker=unknown"
msgid "　それを認めて適応する事はひどく難しかった。"
msgstr ""

#. Occurrence 2_5:1673:2972: scene=2_5
#: 2_5:1673
msgctxt "text_id=2972 | speaker=unknown"
msgid "　馴染むのは簡単だ。人間はなんにだって慣れる生き物なので、放っておいても順応していく。"
msgstr ""

#. Occurrence 2_5:1678:2973: scene=2_5
#: 2_5:1678
msgctxt "text_id=2973 | speaker=unknown"
msgid "　なので。難しかったのは、たぶん認める方だろう。"
msgstr ""

#. Occurrence 2_5:1699:2974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0011; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1699
msgctxt "text_id=2974 | speaker=soujuurou"
msgid "「……そりゃあ。とにかく、難しいコトだらけだし」"
msgstr ""

#. Occurrence 2_5:1720:2975: scene=2_5
#: 2_5:1720
msgctxt "text_id=2975 | speaker=unknown"
msgid "　今まで口にしたことのない弱音を漏らす。"
msgstr ""

#. Occurrence 2_5:1725:2976: scene=2_5
#: 2_5:1725
msgctxt "text_id=2976 | speaker=unknown"
msgid "　正直、草十郎は町を出歩く事すらいまだに怖い。"
msgstr ""

#. Occurrence 2_5:1730:2977: scene=2_5
#: 2_5:1730
msgctxt "text_id=2977 | speaker=unknown"
msgid "　都会の人々には当たり前の事でも、彼にとっては未知の事ばかりなのだ。そんな事が連続するたびに驚いているのだから、まいらない筈がない。"
msgstr ""

#. Occurrence 2_5:1755:2978: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0012; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1755
msgctxt "text_id=2978 | speaker=soujuurou"
msgid "『……そっか……疲れてるのは体じゃないのか……』"
msgstr ""

#. Occurrence 2_5:1773:2979: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0013; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1773
msgctxt "text_id=2979 | speaker=soujuurou"
msgid "「だから、あんな幻を見る」"
msgstr ""

#. Occurrence 2_5:1808:2980: scene=2_5
#: 2_5:1808
msgctxt "text_id=2980 | speaker=unknown"
msgid "　呟いてみて、草十郎は小さく首を横に振った。"
msgstr ""

#. Occurrence 2_5:1813:2981: scene=2_5
#: 2_5:1813
msgctxt "text_id=2981 | speaker=unknown"
msgid "　有る物は有るのが、世の習わしだ。"
msgstr ""

#. Occurrence 2_5:1818:2982: scene=2_5
#: 2_5:1818
msgctxt "text_id=2982 | speaker=unknown"
msgid "　鳶丸にはああは言ったが、草十郎は<あ|・><の|・><出|・><来|・><事|・>が現実だと解っていた。"
msgstr ""

#. Occurrence 2_5:1892:2983: scene=2_5
#: 2_5:1892
msgctxt "text_id=2983 | speaker=unknown"
msgid "　ここは山に比べれば魔法の国だ。"
msgstr ""

#. Occurrence 2_5:1897:2984: scene=2_5
#: 2_5:1897
msgctxt "text_id=2984 | speaker=unknown"
msgid "　それなら、本物の魔法使いがこっそり暮らしててもおかしくはない。"
msgstr ""

#. Occurrence 2_5:1902:2985: scene=2_5
#: 2_5:1902
msgctxt "text_id=2985 | speaker=unknown"
msgid "　一度でもそう思ってしまったら、椅子に座った両足が小刻みに震えていた。どうも怖いらしい、と気付いたのはしばらくしてからだ。"
msgstr ""

#. Occurrence 2_5:1907:2986: scene=2_5
#: 2_5:1907
msgctxt "text_id=2986 | speaker=unknown"
msgid "　自然以外を怖いと思うのは、子供のころ山道でばったり野生の熊に出会った時以来である。"
msgstr ""

#. Occurrence 2_5:1959:2987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0014; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1959
msgctxt "text_id=2987 | speaker=soujuurou"
msgid "「いや、あれはこんなもんじゃなかったっけ。"
msgstr ""

#. Occurrence 2_5:1965:2988: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0015; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1965
msgctxt "text_id=2988 | speaker=soujuurou"
msgid "　なりふりかまわず泣き叫んだもんな、あの時は」"
msgstr ""

#. Occurrence 2_5:1971:2989: scene=2_5
#: 2_5:1971
msgctxt "text_id=2989 | speaker=unknown"
msgid "　幼少期のトンデモなトラウマを思い出し、草十郎はつい<微|わ><笑|ら>ってしまった。"
msgstr ""

#. Occurrence 2_5:1991:2990: scene=2_5
#: 2_5:1991
msgctxt "text_id=2990 | speaker=unknown"
msgid "　たしかに二メートル以上の獣がのっそり現れ、ぐるるる、なんて唸った日には誰だって卒倒するだろう。"
msgstr ""

#. Occurrence 2_5:1996:2991: scene=2_5
#: 2_5:1996
msgctxt "text_id=2991 | speaker=unknown"
msgid "　山で生活していた草十郎からしてどのくらい迫力があったかと言うと、ほんの二日前に映画で見た大怪獣をぬいぐるみでは、と錯覚するぐらい野生の獣は怖かった。"
msgstr ""

#. Occurrence 2_5:2001:2992: scene=2_5
#: 2_5:2001
msgctxt "text_id=2992 | speaker=unknown"
msgid "　それを思い出せば、たしかに、これぐらいはなんとか我慢できる話かもしれない。"
msgstr ""

#. Occurrence 2_5:2054:2993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0016; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2054
msgctxt "text_id=2993 | speaker=soujuurou"
msgid "「……そうだよな。今の問題は、えーと……チラっと聞こえた最後の台詞か。『捕まえて始末する』っていうのは、どうなんだ？」"
msgstr ""

#. Occurrence 2_5:2060:2994: scene=2_5
#: 2_5:2060
msgctxt "text_id=2994 | speaker=unknown"
msgid "　額面通りにとるのなら、それこそ文字通りの意味、というヤツだ。"
msgstr ""

#. Occurrence 2_5:2065:2995: scene=2_5
#: 2_5:2065
msgctxt "text_id=2995 | speaker=unknown"
msgid "　あまりにも物騒な意味合いすぎて、真剣に考察することが難しい。何かの聞き間違い、あるいは言い間違いだったのだろう、と放り投げてしまいたくなる。"
msgstr ""

#. Occurrence 2_5:2087:2996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0017; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2087
msgctxt "text_id=2996 | speaker=soujuurou"
msgid "「都会のルール……誰かが、きっと罰しに来る、か……」"
msgstr ""

#. Occurrence 2_5:2093:2997: scene=2_5
#: 2_5:2093
msgctxt "text_id=2997 | speaker=unknown"
msgid "　自分で言っておきながら、やっぱり他人ごとのようで、夢だったと割り切りたい気分だ。"
msgstr ""

#. Occurrence 2_5:2116:2998: scene=2_5
#: 2_5:2116
msgctxt "text_id=2998 | speaker=unknown"
msgid "　草十郎は息をついて瞼を閉じる。"
msgstr ""

#. Occurrence 2_5:2121:2999: scene=2_5
#: 2_5:2121
msgctxt "text_id=2999 | speaker=unknown"
msgid "　視界の暗転と共に先ほどの光景をすべて棚上げ。"
msgstr ""

#. Occurrence 2_5:2126:3000: scene=2_5
#: 2_5:2126
msgctxt "text_id=3000 | speaker=unknown"
msgid "　とりあえず、今はきれいさっぱり昨夜の出来事を忘れる事にした。"
msgstr ""

#. Occurrence 2_5:2175:3001: scene=2_5
#: 2_5:2175
msgctxt "text_id=3001 | speaker=unknown"
msgid "　瞼を開けると、呼吸はすっかり落ち着いていた。"
msgstr ""

#. Occurrence 2_5:2182:3002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0018; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2182
msgctxt "text_id=3002 | speaker=soujuurou"
msgid "「それでさ。"
msgstr ""

#. Occurrence 2_5:2188:3003: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0019; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2188
msgctxt "text_id=3003 | speaker=soujuurou"
msgid "　蒼崎を殴りつけようとして、結局どうなったんだ鳶丸？」"
msgstr ""

#. Occurrence 2_5:2195:3004: scene=2_5
#: 2_5:2195
msgctxt "text_id=3004 | speaker=unknown"
msgid "　なんとなく唐突に、そんな疑問が湧いたりする。"
msgstr ""

#. Occurrence 2_5:2200:3005: scene=2_5
#: 2_5:2200
msgctxt "text_id=3005 | speaker=unknown"
msgid "　今度聞いてみよう、と草十郎が椅子から立ち上がった時、長い光を引いて電車がやってきた。"
msgstr ""

#. Occurrence 3_1:59:3006: scene=3_1
#: 3_1:59
msgctxt "text_id=3006 | speaker=unknown"
msgid "　つまり、"
msgstr ""

msgctxt "text_id=3007 | speaker=unknown"
msgid "昨日こんな事があった。"
msgstr ""

#. Occurrence 3_1:108:3008: scene=3_1
#: 3_1:108
msgctxt "text_id=3008 | speaker=unknown"
msgid "　“月の無い夜は、決して振り向いてはいけないよ―――”"
msgstr ""

#. Occurrence 3_1:130:3009: scene=3_1
#: 3_1:130
msgctxt "text_id=3009 | speaker=unknown"
msgid "　それは教訓だったのか、警告だったのか。"
msgstr ""

#. Occurrence 3_1:135:3010: scene=3_1
#: 3_1:135
msgctxt "text_id=3010 | speaker=unknown"
msgid "　ずいぶんと昔……私がまだ今の<自分|ありかた>を夢にも思っていなかった頃。"
msgstr ""

#. Occurrence 3_1:140:3011: scene=3_1
#: 3_1:140
msgctxt "text_id=3011 | speaker=unknown"
msgid "　突然、何の前触れもなく、泣きだしたくなるぐらいの不安でいっぱいになって、祖父の工房に逃げこんだ夜の話だ。"
msgstr ""

#. Occurrence 3_1:145:3012: scene=3_1
#: 3_1:145
msgctxt "text_id=3012 | speaker=unknown"
msgid "　祖父は別人のように優しく微笑み、私の頭に静かに手を乗せて、"
msgstr ""

#. Occurrence 3_1:170:3013: scene=3_1
#: 3_1:170
msgctxt "text_id=3013 | speaker=unknown"
msgid "　“―――<赤色|あかいろ>の死が、おまえの背中を見ているからね”"
msgstr ""

#. Occurrence 3_1:192:3014: scene=3_1
#: 3_1:192
msgctxt "text_id=3014 | speaker=unknown"
msgid "　そんな、気休めどころかより絶望的な言葉を残して、私を家につき返した。"
msgstr ""

#. Occurrence 3_1:197:3015: scene=3_1
#: 3_1:197
msgctxt "text_id=3015 | speaker=unknown"
msgid "　私はあの夜、たしかに背後に<潜|ひそ>む影を認めた。"
msgstr ""

#. Occurrence 3_1:202:3016: scene=3_1
#: 3_1:202
msgctxt "text_id=3016 | speaker=unknown"
msgid "　ずっと遠くから私を見ている何者か。"
msgstr ""

#. Occurrence 3_1:209:3017: scene=3_1
#: 3_1:209
msgctxt "text_id=3017 | speaker=unknown"
msgid "　それは少しずつ、年々距離を<縮|ちぢ>めていき―――"
msgstr ""

#. Occurrence 3_1:215:3018: scene=3_1
#: 3_1:215
msgctxt "text_id=3018 | speaker=unknown"
msgid "　小さな点ほどだった気配は、その息づかいさえ感じるほどすぐ後ろまで迫っていた。"
msgstr ""

#. Occurrence 3_1:245:3019: scene=3_1
#: 3_1:245
msgctxt "text_id=3019 | speaker=unknown"
msgid "　もちろん錯覚。"
msgstr ""

#. Occurrence 3_1:250:3020: scene=3_1
#: 3_1:250
msgctxt "text_id=3020 | speaker=unknown"
msgid "　振り向いた先には誰もいない。"
msgstr ""

#. Occurrence 3_1:256:3021: scene=3_1
#: 3_1:256
msgctxt "text_id=3021 | speaker=unknown"
msgid "　ただ―――きっかけになったあの夜。"
msgstr ""

#. Occurrence 3_1:261:3022: scene=3_1
#: 3_1:261
msgctxt "text_id=3022 | speaker=unknown"
msgid "　あの時の言いようのない不安は、間違いなく、約束された<恐怖|し>に起因するものだった。"
msgstr ""

#. Occurrence 3_1:336:3023: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_9000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:336
msgctxt "text_id=3023 | speaker=alice"
msgid "“"
msgstr ""

msgctxt "text_id=3024 | speaker=unknown"
msgid "……Hey diddle diddle,The cat and the fiddle,"
msgstr ""

msgctxt "text_id=3025 | speaker=unknown"
msgid "　The cow jump'd over the moon,"
msgstr ""

msgctxt "text_id=3026 | speaker=unknown"
msgid "　The little dog laugh'd……”"
msgstr ""

#. Occurrence 3_1:357:3027: scene=3_1
#: 3_1:357
msgctxt "text_id=3027 | speaker=unknown"
msgid "　……あれはいつの話だっただろう。"
msgstr ""

#. Occurrence 3_1:362:3028: scene=3_1
#: 3_1:362
msgctxt "text_id=3028 | speaker=unknown"
msgid "　遠い子供の頃の記憶の片隅。"
msgstr ""

#. Occurrence 3_1:367:3029: scene=3_1
#: 3_1:367
msgctxt "text_id=3029 | speaker=unknown"
msgid "　絵日記じみたかすかな思い出。"
msgstr ""

#. Occurrence 3_1:372:3030: scene=3_1
#: 3_1:372
msgctxt "text_id=3030 | speaker=unknown"
msgid "　……暗い夜には決まって祖父の言葉が耳に響く。"
msgstr ""

#. Occurrence 3_1:377:3031: scene=3_1
#: 3_1:377
msgctxt "text_id=3031 | speaker=unknown"
msgid "　どんなに風が強く吹いても、<傍|かたわ>らの少女の<鐘|うた>が聞き惚れるほどのものでも、不吉な言葉をかき消す事はできない。"
msgstr ""

#. Occurrence 3_1:411:3032: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:411
msgctxt "text_id=3032 | speaker=alice"
msgid "「……ご到着ね」"
msgstr ""

#. Occurrence 3_1:427:3033: scene=3_1
#: 3_1:427
msgctxt "text_id=3033 | speaker=unknown"
msgid "　傍らの<少女|ありす>が言った。"
msgstr ""

#. Occurrence 3_1:432:3034: scene=3_1
#: 3_1:432
msgctxt "text_id=3034 | speaker=unknown"
msgid "　抑揚のない声は、完全に傍観者でいる事を示している。"
msgstr ""

#. Occurrence 3_1:464:3035: scene=3_1
#: 3_1:464
msgctxt "text_id=3035 | speaker=unknown"
msgid "　夜の公園には私と彼女だけ。"
msgstr ""

#. Occurrence 3_1:469:3036: scene=3_1
#: 3_1:469
msgctxt "text_id=3036 | speaker=unknown"
msgid "　今日は私にとって“今の自分”の誕生日。"
msgstr ""

#. Occurrence 3_1:474:3037: scene=3_1
#: 3_1:474
msgctxt "text_id=3037 | speaker=unknown"
msgid "　記念すべき<初陣|ういじん>にしては、少々不吉な夜と言わざるをえない。"
msgstr ""

#. Occurrence 3_1:522:3038: scene=3_1
#: 3_1:522
msgctxt "text_id=3038 | speaker=unknown"
msgid "　ぶあつい雲は黒い傘のように星明かりを<遮|さえぎ>っている。"
msgstr ""

#. Occurrence 3_1:527:3039: scene=3_1
#: 3_1:527
msgctxt "text_id=3039 | speaker=unknown"
msgid "　強い風は夜空を引き裂き、重い雲を運んでいく。"
msgstr ""

#. Occurrence 3_1:532:3040: scene=3_1
#: 3_1:532
msgctxt "text_id=3040 | speaker=unknown"
msgid "　公園の真ん中に立つ柱時計の針は、二本とも頭上の月を指すように頂点を向いている。"
msgstr ""

#. Occurrence 3_1:556:3041: scene=3_1
#: 3_1:556
msgctxt "text_id=3041 | speaker=unknown"
msgid "　あいにくと、今日は月のない夜だったけれど。"
msgstr ""

#. Occurrence 3_1:607:3042: scene=3_1
#: 3_1:607
msgctxt "text_id=3042 | speaker=unknown"
msgid "　冬の大気は、深夜になって狂暴さを増している。"
msgstr ""

#. Occurrence 3_1:612:3043: scene=3_1
#: 3_1:612
msgctxt "text_id=3043 | speaker=unknown"
msgid "　息を吸うだけで体の中が凍る気がする。"
msgstr ""

#. Occurrence 3_1:655:3044: scene=3_1
#: 3_1:655
msgctxt "text_id=3044 | speaker=unknown"
msgid "　骨に染みこむような冷気は、そのまま背骨を通じて脳に直接入りこんでくる。"
msgstr ""

#. Occurrence 3_1:661:3045: scene=3_1
#: 3_1:661
msgctxt "text_id=3045 | speaker=unknown"
msgid "　思考が寒さで麻痺しないよう、"
msgstr ""

#. Occurrence 3_1:667:3046: scene=3_1
#: 3_1:667
msgctxt "text_id=3046 | speaker=unknown"
msgid "　指先が寒気で化石にならないよう、"
msgstr ""

#. Occurrence 3_1:673:3047: scene=3_1
#: 3_1:673
msgctxt "text_id=3047 | speaker=unknown"
msgid "　私は、自分の<鼓動|リズム>と感情を炎にくべた。"
msgstr ""

#. Occurrence 3_1:731:3048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3048 | speaker=alice"
msgid "「触覚を<譲|ゆず>るわ。……幸運ね。"
msgstr ""

#. Occurrence 3_1:731:3049: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3049 | speaker=alice"
msgid "　あの位置なら刻んでおいた<鬼火|ウィスプ>が灯る」"
msgstr ""

#. Occurrence 3_1:737:3050: scene=3_1
#: 3_1:737
msgctxt "text_id=3050 | speaker=unknown"
msgid "　有珠の言葉に頷きだけで応える。"
msgstr ""

#. Occurrence 3_1:742:3051: scene=3_1
#: 3_1:742
msgctxt "text_id=3051 | speaker=unknown"
msgid "　その時、一瞬だけ地面が見えた。"
msgstr ""

#. Occurrence 3_1:762:3052: scene=3_1
#: 3_1:762
msgctxt "text_id=3052 | speaker=unknown"
msgid "　……私の両足はかすかに震えている。"
msgstr ""

#. Occurrence 3_1:767:3053: scene=3_1
#: 3_1:767
msgctxt "text_id=3053 | speaker=unknown"
msgid "　寒いから震えているんだ、と判断したけれど自信はなかった。"
msgstr ""

#. Occurrence 3_1:772:3054: scene=3_1
#: 3_1:772
msgctxt "text_id=3054 | speaker=unknown"
msgid "　本当は寒さではなく恐怖で<痺|しび>れてしまっているのかも知れない。……ホッと息を吐く。感情が働いているのなら、私はじゅうぶんに人間らしい。"
msgstr ""

#. Occurrence 3_1:847:3055: scene=3_1
#: 3_1:847
msgctxt "text_id=3055 | speaker=unknown"
msgid "　そんな感傷にひたる間もなく、結界の感触が有珠から私に移ってきた。"
msgstr ""

#. Occurrence 3_1:853:3056: scene=3_1
#: 3_1:853
msgctxt "text_id=3056 | speaker=unknown"
msgid "　この公園一帯に敷かれた透明の<境|かべ>。"
msgstr ""

#. Occurrence 3_1:858:3057: scene=3_1
#: 3_1:858
msgctxt "text_id=3057 | speaker=unknown"
msgid "　地中深くまで根を張った認知外の絨毯。"
msgstr ""

#. Occurrence 3_1:937:3058: scene=3_1
#: 3_1:937
msgctxt "text_id=3058 | speaker=unknown"
msgid "　―――夜に<浸|ひび>く、久遠寺有珠の<童話詠唱|マザーグース>。"
msgstr ""

#. Occurrence 3_1:947:3059: scene=3_1
#: 3_1:947
msgctxt "text_id=3059 | speaker=unknown"
msgid "　それらの感覚と、私の体がひとつになる。"
msgstr ""

#. Occurrence 3_1:986:3060: scene=3_1
#: 3_1:986
msgctxt "text_id=3060 | speaker=unknown"
msgid "　ざわり、と右腕に鳥肌がたつ。"
msgstr ""

#. Occurrence 3_1:991:3061: scene=3_1
#: 3_1:991
msgctxt "text_id=3061 | speaker=unknown"
msgid "　誰かが私の腕に侵入したのだ。"
msgstr ""

#. Occurrence 3_1:1038:3062: scene=3_1
#: 3_1:1038
msgctxt "text_id=3062 | speaker=unknown"
msgid "　鳥肌は<蟻|あり>のように右腕を<這|は>い上がってくる。"
msgstr ""

#. Occurrence 3_1:1043:3063: scene=3_1
#: 3_1:1043
msgctxt "text_id=3063 | speaker=unknown"
msgid "　ゆっくりと、確実に、この心臓めがけて。"
msgstr ""

#. Occurrence 3_1:1048:3064: scene=3_1
#: 3_1:1048
msgctxt "text_id=3064 | speaker=unknown"
msgid "　払い<除|の>けたくなる衝動をおさえて、より決定的な位置、より確実な到来を待つ。"
msgstr ""

#. Occurrence 3_1:1093:3065: scene=3_1
#: 3_1:1093
msgctxt "text_id=3065 | speaker=unknown"
msgid "　月の無い夜。"
msgstr ""

#. Occurrence 3_1:1098:3066: scene=3_1
#: 3_1:1098
msgctxt "text_id=3066 | speaker=unknown"
msgid "　公園の小さな街灯だけでは、闇の<全容|すべて>は見渡せない。"
msgstr ""

#. Occurrence 3_1:1136:3067: scene=3_1
#: 3_1:1136
msgctxt "text_id=3067 | speaker=unknown"
msgid "　蟻の進行は止まった。"
msgstr ""

#. Occurrence 3_1:1141:3068: scene=3_1
#: 3_1:1141
msgctxt "text_id=3068 | speaker=unknown"
msgid "　私の右腕から離れて離れて<心臓|まなか>のとなり。"
msgstr ""

#. Occurrence 3_1:1168:3069: scene=3_1
#: 3_1:1168
msgctxt "text_id=3069 | speaker=unknown"
msgid "　視覚を動員することなく、闇に<潜|ひそ>む侵入者の姿が見える。"
msgstr ""

#. Occurrence 3_1:1173:3070: scene=3_1
#: 3_1:1173
msgctxt "text_id=3070 | speaker=unknown"
msgid "　ここから<右舷|うげん>後方三十歩ほどの茂みの<陰|かげ>、四つんばいに手足をついたソレは<手招|てまね>きするように右手をあげ―――"
msgstr ""

#. Occurrence 3_1:1204:3071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0000; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1204
msgctxt "text_id=3071 | speaker=aoko"
msgid "「―――そこ！」"
msgstr ""

#. Occurrence 3_1:1210:3072: scene=3_1
#: 3_1:1210
msgctxt "text_id=3072 | speaker=unknown"
msgid "　私の知覚と、敵の行動はほぼ同時だった。"
msgstr ""

#. Occurrence 3_1:1230:3073: scene=3_1
#: 3_1:1230
msgctxt "text_id=3073 | speaker=unknown"
msgid "　体が振り向く。"
msgstr ""

#. Occurrence 3_1:1282:3074: scene=3_1
#: 3_1:1282
msgctxt "text_id=3074 | speaker=unknown"
msgid "　敵の腕は槍のように伸びた。"
msgstr ""

#. Occurrence 3_1:1330:3075: scene=3_1
#: 3_1:1330
msgctxt "text_id=3075 | speaker=unknown"
msgid "　高速で後頭部に放たれた凶器が、私の髪をさらっていく。"
msgstr ""

#. Occurrence 3_1:1335:3076: scene=3_1
#: 3_1:1335
msgctxt "text_id=3076 | speaker=unknown"
msgid "　有珠から結界を<譲渡|じょうと>され、ここ一帯そのものとなった全能の知覚が、最小の回避を可能とする。"
msgstr ""

#. Occurrence 3_1:1388:3077: scene=3_1
#: 3_1:1388
msgctxt "text_id=3077 | speaker=unknown"
msgid "　礼儀知らずの蛮行に舞い上がる髪。"
msgstr ""

#. Occurrence 3_1:1428:3078: scene=3_1
#: 3_1:1428
msgctxt "text_id=3078 | speaker=unknown"
msgid "　頬をかする、小さいが鋭い痛み。"
msgstr ""

#. Occurrence 3_1:1456:3079: scene=3_1
#: 3_1:1456
msgctxt "text_id=3079 | speaker=unknown"
msgid "　―――死が、魂に触れた気がした。"
msgstr ""

#. Occurrence 3_1:1508:3080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0001; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1508
msgctxt "text_id=3080 | speaker=aoko"
msgid "「っ―――！」"
msgstr ""

#. Occurrence 3_1:1563:3081: scene=3_1
#: 3_1:1563
msgctxt "text_id=3081 | speaker=unknown"
msgid "　体内の血流を、異なる<循環|かいろ>に切り替える。"
msgstr ""

#. Occurrence 3_1:1568:3082: scene=3_1
#: 3_1:1568
msgctxt "text_id=3082 | speaker=unknown"
msgid "　秒速一メートルで体内を巡る血液が、架空の元素に変質する。"
msgstr ""

#. Occurrence 3_1:1574:3083: scene=3_1
#: 3_1:1574
msgctxt "text_id=3083 | speaker=unknown"
msgid "心臓はまったく別の<生|エ><成|ン><機|ジ><関|ン>に成りはてて、私の体を一つの回路として利用する。"
msgstr ""

#. Occurrence 3_1:1595:3084: scene=3_1
#: 3_1:1595
msgctxt "text_id=3084 | speaker=unknown"
msgid "　熱量として計測されない不可知の運動。"
msgstr ""

#. Occurrence 3_1:1600:3085: scene=3_1
#: 3_1:1600
msgctxt "text_id=3085 | speaker=unknown"
msgid "　私を今の私にならしめた、いまだ人の手の及ばぬ神秘。"
msgstr ""

#. Occurrence 3_1:1605:3086: scene=3_1
#: 3_1:1605
msgctxt "text_id=3086 | speaker=unknown"
msgid "　あらゆる奇跡、<寓話|ぐうわ>の動力となる生命の火。"
msgstr ""

#. Occurrence 3_1:1657:3087: scene=3_1
#: 3_1:1657
msgctxt "text_id=3087 | speaker=unknown"
msgid "　これを、私たちは魔力と呼ぶ。"
msgstr ""

#. Occurrence 3_1:1705:3088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0002; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1705
msgctxt "text_id=3088 | speaker=aoko"
msgid "「―――<接続|セット>」"
msgstr ""

#. Occurrence 3_1:1752:3089: scene=3_1
#: 3_1:1752
msgctxt "text_id=3089 | speaker=unknown"
msgid "　振り向いて敵を視界に収め、片手を振りかぶる。"
msgstr ""

#. Occurrence 3_1:1757:3090: scene=3_1
#: 3_1:1757
msgctxt "text_id=3090 | speaker=unknown"
msgid "　腕は意志の代行だ。"
msgstr ""

#. Occurrence 3_1:1762:3091: scene=3_1
#: 3_1:1762
msgctxt "text_id=3091 | speaker=unknown"
msgid "　私はまだ未熟だから、<発|こ><音|え>と<手足|どうさ>を使わないと魔術は働いてくれない。"
msgstr ""

#. Occurrence 3_1:1842:3092: scene=3_1
#: 3_1:1842
msgctxt "text_id=3092 | speaker=unknown"
msgid "　魔術式は予め公園に刻まれている。"
msgstr ""

#. Occurrence 3_1:1847:3093: scene=3_1
#: 3_1:1847
msgctxt "text_id=3093 | speaker=unknown"
msgid "　私がするコトは、その式に火をくべるだけ。"
msgstr ""

#. Occurrence 3_1:1852:3094: scene=3_1
#: 3_1:1852
msgctxt "text_id=3094 | speaker=unknown"
msgid "　体内で生成した魔力を、各自それぞれの方式で流しこめばいい。"
msgstr ""

#. Occurrence 3_1:1903:3095: scene=3_1
#: 3_1:1903
msgctxt "text_id=3095 | speaker=unknown"
msgid "　たいていの魔術師は転移方式だ。有線にしろ無線にしろ、式に魔力を<注|そそ>げばいい。"
msgstr ""

#. Occurrence 3_1:1909:3096: scene=3_1
#: 3_1:1909
msgctxt "text_id=3096 | speaker=unknown"
msgid "　“出す”“撃つ”“流す”と色々あるけど、私の場合はなんていうか、こう―――"
msgstr ""

msgctxt "text_id=3097 | speaker=unknown"
msgid "自分の手足で<弾|はじ>く感じ……！"
msgstr ""

#. Occurrence 3_1:1951:3098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0003; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1951
msgctxt "text_id=3098 | speaker=aoko"
msgid "「―――燃えろ！」"
msgstr ""

#. Occurrence 3_1:2015:3099: scene=3_1
#: 3_1:2015
msgctxt "text_id=3099 | speaker=unknown"
msgid "　高速に高速で対抗する。"
msgstr ""

#. Occurrence 3_1:2072:3100: scene=3_1
#: 3_1:2072
msgctxt "text_id=3100 | speaker=unknown"
msgid "　数メートル伸ばした腕はそのまま、敵は炎に包まれた。"
msgstr ""

#. Occurrence 3_1:2077:3101: scene=3_1
#: 3_1:2077
msgctxt "text_id=3101 | speaker=unknown"
msgid "　夜の公園というコトもあってキャンプファイヤーを連想させる。ただ、炎の中で影絵のように<蠢|うごめ>くのは人間らしき姿だったけど。"
msgstr ""

#. Occurrence 3_1:2135:3102: scene=3_1
#: 3_1:2135
msgctxt "text_id=3102 | speaker=unknown"
msgid "　不自然に発した炎は、やっぱり不自然に消えた。"
msgstr ""

#. Occurrence 3_1:2140:3103: scene=3_1
#: 3_1:2140
msgctxt "text_id=3103 | speaker=unknown"
msgid "　物を焼く音も、焦げた臭いもあまりない。"
msgstr ""

#. Occurrence 3_1:2185:3104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0004; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2185
msgctxt "text_id=3104 | speaker=aoko"
msgid "「―――結界、返すわ。死体を確認するから」"
msgstr ""

#. Occurrence 3_1:2209:3105: scene=3_1
#: 3_1:2209
msgctxt "text_id=3105 | speaker=unknown"
msgid "　傍らの彼女に言って、もう動かない人影に足を向けた。"
msgstr ""

#. Occurrence 3_1:2232:3106: scene=3_1
#: 3_1:2232
msgctxt "text_id=3106 | speaker=unknown"
msgid "　殺した。"
msgstr ""

#. Occurrence 3_1:2238:3107: scene=3_1
#: 3_1:2238
msgctxt "text_id=3107 | speaker=unknown"
msgid "殺した。"
msgstr ""

#. Occurrence 3_1:2244:3108: scene=3_1
#: 3_1:2244
msgctxt "text_id=3108 | speaker=unknown"
msgid "殺した。"
msgstr ""

#. Occurrence 3_1:2249:3109: scene=3_1
#: 3_1:2249
msgctxt "text_id=3109 | speaker=unknown"
msgid "　相手が何者であれ、人の命に、手をかけた。"
msgstr ""

#. Occurrence 3_1:2254:3110: scene=3_1
#: 3_1:2254
msgctxt "text_id=3110 | speaker=unknown"
msgid "　その、現実味もなければ手応えもなかった事実を、<渇|かわ>ききった喉で嚥下する。"
msgstr ""

#. Occurrence 3_1:2260:3111: scene=3_1
#: 3_1:2260
msgctxt "text_id=3111 | speaker=unknown"
msgid "硬くて苦くてこれっぽっちも飲み込めないけど、嚥下しようと努めていた。"
msgstr ""

#. Occurrence 3_1:2298:3112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0005; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2298
msgctxt "text_id=3112 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 3_1:2304:3113: scene=3_1
#: 3_1:2304
msgctxt "text_id=3113 | speaker=unknown"
msgid "　私はいたって冷静だ。心拍数はレートを幾分オーバーしていて、呼吸も<千|ち><々|ぢ>に乱れているけど、頭はすっごく冷静の筈。"
msgstr ""

#. Occurrence 3_1:2309:3114: scene=3_1
#: 3_1:2309
msgctxt "text_id=3114 | speaker=unknown"
msgid "　気が付けば消し炭はもう目の前。"
msgstr ""

#. Occurrence 3_1:2314:3115: scene=3_1
#: 3_1:2314
msgctxt "text_id=3115 | speaker=unknown"
msgid "　反撃を想定しつつ、ゆっくり死骸を確認する。"
msgstr ""

#. Occurrence 3_1:2332:3116: scene=3_1
#: 3_1:2332
msgctxt "text_id=3116 | speaker=unknown"
msgid "　……よし、問題なし。公園の地面に倒れ臥したそれは、燃えつきて灰になっていた。"
msgstr ""

#. Occurrence 3_1:2353:3117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0006; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2353
msgctxt "text_id=3117 | speaker=aoko"
msgid "「………？」"
msgstr ""

#. Occurrence 3_1:2359:3118: scene=3_1
#: 3_1:2359
msgctxt "text_id=3118 | speaker=unknown"
msgid "　けれど何かおかしい。"
msgstr ""

#. Occurrence 3_1:2364:3119: scene=3_1
#: 3_1:2364
msgctxt "text_id=3119 | speaker=unknown"
msgid "　一見した感想、残骸のあり方に生命の匂いがしない。"
msgstr ""

#. Occurrence 3_1:2369:3120: scene=3_1
#: 3_1:2369
msgctxt "text_id=3120 | speaker=unknown"
msgid "　まさか、と人影の顔を見る。"
msgstr ""

#. Occurrence 3_1:2374:3121: scene=3_1
#: 3_1:2374
msgctxt "text_id=3121 | speaker=unknown"
msgid "　そこには目も鼻もなく、マネキンのような白い面だけがあった。"
msgstr ""

#. Occurrence 3_1:2418:3122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0007; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2418
msgctxt "text_id=3122 | speaker=aoko"
msgid "「ちくしょー、またやられた！」"
msgstr ""

#. Occurrence 3_1:2425:3123: scene=3_1
#: 3_1:2425
msgctxt "text_id=3123 | speaker=unknown"
msgid "　叫んでマネキンを蹴っとばす。"
msgstr ""

#. Occurrence 3_1:2430:3124: scene=3_1
#: 3_1:2430
msgctxt "text_id=3124 | speaker=unknown"
msgid "　灰は風に舞い、死体も風化していく。"
msgstr ""

#. Occurrence 3_1:2436:3125: scene=3_1
#: 3_1:2436
msgctxt "text_id=3125 | speaker=unknown"
msgid "いや、死体というのは正しくないか。これはただの人形で、結局、おびき寄せたつもりが、またハズレを引かされた。"
msgstr ""

#. Occurrence 3_1:2441:3126: scene=3_1
#: 3_1:2441
msgctxt "text_id=3126 | speaker=unknown"
msgid "　……本当の意味での初陣は、また先送りになったということだ。"
msgstr ""

#. Occurrence 3_1:2486:3127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0008; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2486
msgctxt "text_id=3127 | speaker=aoko"
msgid "「はあ……"
msgstr ""

msgctxt "text_id=3128 | speaker=unknown"
msgid "いつになったら一人前にって……"
msgstr ""

msgctxt "text_id=3129 | speaker=unknown"
msgid "あれ？」"
msgstr ""

#. Occurrence 3_1:2510:3130: scene=3_1
#: 3_1:2510
msgctxt "text_id=3130 | speaker=unknown"
msgid "　その時、ふと視界を見慣れた物がかすめた。"
msgstr ""

#. Occurrence 3_1:2515:3131: scene=3_1
#: 3_1:2515
msgctxt "text_id=3131 | speaker=unknown"
msgid "　むこうの滑り台の影のカタチがおかしい。なんというか、余分なモノでぷくっと太っている気がする。"
msgstr ""

#. Occurrence 3_1:2540:3132: scene=3_1
#: 3_1:2540
msgctxt "text_id=3132 | speaker=unknown"
msgid "　戦闘の余熱でのぼせていたのか。"
msgstr ""

#. Occurrence 3_1:2545:3133: scene=3_1
#: 3_1:2545
msgctxt "text_id=3133 | speaker=unknown"
msgid "　私は、その“余分な影”が何であるか、思い出すのに一秒もかかってしまった。"
msgstr ""

#. Occurrence 3_1:2589:3134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0009; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2589
msgctxt "text_id=3134 | speaker=aoko"
msgid "「―――誰ッ！？」"
msgstr ""

#. Occurrence 3_1:2596:3135: scene=3_1
#: 3_1:2596
msgctxt "text_id=3135 | speaker=unknown"
msgid "　自分で言うのもなんだけど、失敗だった。"
msgstr ""

#. Occurrence 3_1:2602:3136: scene=3_1
#: 3_1:2602
msgctxt "text_id=3136 | speaker=unknown"
msgid "　その見慣れた高校の制服を着た誰かは私の声でビクっと後じさって、そのまま、"
msgstr ""

msgctxt "text_id=3137 | speaker=unknown"
msgid "ものすごい勢いで走り出した。"
msgstr ""

#. Occurrence 3_1:2612:3138: scene=3_1
#: 3_1:2612
msgctxt "text_id=3138 | speaker=unknown"
msgid "　まるで必死に逃げるみたい―――"
msgstr ""

#. Occurrence 3_1:2634:3139: scene=3_1
#: 3_1:2634
msgctxt "text_id=3139 | speaker=unknown"
msgid "　―――って、実際逃げてるんだアレ！"
msgstr ""

#. Occurrence 3_1:2678:3140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0010; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2678
msgctxt "text_id=3140 | speaker=aoko"
msgid "「追いかけて！　見られた！」"
msgstr ""

#. Occurrence 3_1:2684:3141: scene=3_1
#: 3_1:2684
msgctxt "text_id=3141 | speaker=unknown"
msgid "　急いで相棒に言うけれど、彼女は第三者の存在に気付いてもいなかった。"
msgstr ""

#. Occurrence 3_1:2689:3142: scene=3_1
#: 3_1:2689
msgctxt "text_id=3142 | speaker=unknown"
msgid "　かといって自分も動けない。情けない事に、今の戦闘でまだ足がすくんでやがる……！"
msgstr ""

#. Occurrence 3_1:2751:3143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0011; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2751
msgctxt "text_id=3143 | speaker=aoko"
msgid "「だめ、逃げられる！"
msgstr ""

#. Occurrence 3_1:2757:3144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0012; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2757
msgctxt "text_id=3144 | speaker=aoko"
msgid "　捕まえて始末しないと……！」"
msgstr ""

#. Occurrence 3_1:2763:3145: scene=3_1
#: 3_1:2763
msgctxt "text_id=3145 | speaker=unknown"
msgid "　上品に振る舞う余裕なんてない。"
msgstr ""

#. Occurrence 3_1:2768:3146: scene=3_1
#: 3_1:2768
msgctxt "text_id=3146 | speaker=unknown"
msgid "　この現場を誰かに見られる事は、私たちにとって生死に関わる問題なんだから―――！"
msgstr ""

#. Occurrence 3_1:2827:3147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0013; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2827
msgctxt "text_id=3147 | speaker=aoko"
msgid "「待て、この……！」"
msgstr ""

#. Occurrence 3_1:2833:3148: scene=3_1
#: 3_1:2833
msgctxt "text_id=3148 | speaker=unknown"
msgid "　足の<痺|しび>れを振り払って公園の外に出る。"
msgstr ""

#. Occurrence 3_1:2861:3149: scene=3_1
#: 3_1:2861
msgctxt "text_id=3149 | speaker=unknown"
msgid "　……なんて見事な逃げ足だろう。"
msgstr ""

#. Occurrence 3_1:2866:3150: scene=3_1
#: 3_1:2866
msgctxt "text_id=3150 | speaker=unknown"
msgid "　一部始終を目撃していた何者かは、跡形もなく住宅地の闇に消えていた。"
msgstr ""

#. Occurrence 3_1:2887:3151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0014; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2887
msgctxt "text_id=3151 | speaker=aoko"
msgid "「ああもう、結界にあいつの感触なんてなかったのに……！」"
msgstr ""

#. Occurrence 3_1:2893:3152: scene=3_1
#: 3_1:2893
msgctxt "text_id=3152 | speaker=unknown"
msgid "　などと、文句を言ってみても学生服の人影が戻ってくる筈もない。"
msgstr ""

#. Occurrence 3_1:2898:3153: scene=3_1
#: 3_1:2898
msgctxt "text_id=3153 | speaker=unknown"
msgid "　自分の情けなさを恨めしく思いながら、私は追跡を諦めた。"
msgstr ""

#. Occurrence 3_1:2951:3154: scene=3_1
#: 3_1:2951
msgctxt "text_id=3154 | speaker=unknown"
msgid "　一時的にしろ、公園は有珠の“森”になっている。"
msgstr ""

#. Occurrence 3_1:2956:3155: scene=3_1
#: 3_1:2956
msgctxt "text_id=3155 | speaker=unknown"
msgid "　ここでは一メートル以内にいようと人物像の特定、声の確認はあやふやになる。なにしろ童話の中の出来事だ。"
msgstr ""

#. Occurrence 3_1:2961:3156: scene=3_1
#: 3_1:2961
msgctxt "text_id=3156 | speaker=unknown"
msgid "　一連の出来事は見られたが、私や彼女の顔や素性は知られていない―――なら、他に打つ手はある。"
msgstr ""

#. Occurrence 3_1:3027:3157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0015; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3027
msgctxt "text_id=3157 | speaker=aoko"
msgid "「あの背中、男だった」"
msgstr ""

#. Occurrence 3_1:3033:3158: scene=3_1
#: 3_1:3033
msgctxt "text_id=3158 | speaker=unknown"
msgid "　公園に戻る。"
msgstr ""

#. Occurrence 3_1:3038:3159: scene=3_1
#: 3_1:3038
msgctxt "text_id=3159 | speaker=unknown"
msgid "　見慣れていて当然で、アレは間違いなくうちの高校の制服だ。"
msgstr ""

#. Occurrence 3_1:3043:3160: scene=3_1
#: 3_1:3043
msgctxt "text_id=3160 | speaker=unknown"
msgid "　手がかりとしてはそれで十分。うちの生徒なら洗いだす手段はいくらでもある。"
msgstr ""

#. Occurrence 3_1:3064:3161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0016; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3064
msgctxt "text_id=3161 | speaker=aoko"
msgid "「……にしても。どうしてこう問題ばっかり増えていくんだろう」"
msgstr ""

#. Occurrence 3_1:3070:3162: scene=3_1
#: 3_1:3070
msgctxt "text_id=3162 | speaker=unknown"
msgid "　などと愚痴りつつも、解決の優先順位ははっきりしていた。"
msgstr ""

#. Occurrence 3_1:3075:3163: scene=3_1
#: 3_1:3075
msgctxt "text_id=3163 | speaker=unknown"
msgid "　変な噂をばらまかれるより早く、さっきの目撃者の口を封じなくてはいけない。"
msgstr ""

#. Occurrence 3_1:3080:3164: scene=3_1
#: 3_1:3080
msgctxt "text_id=3164 | speaker=unknown"
msgid "　それも最優先で、迅速に、容赦なく。"
msgstr ""

#. Occurrence 3_1:3126:3165: scene=3_1
#: 3_1:3126
msgctxt "text_id=3165 | speaker=unknown"
msgid "　顔を上げると、離れていた有珠の姿が見えた。"
msgstr ""

#. Occurrence 3_1:3131:3166: scene=3_1
#: 3_1:3131
msgctxt "text_id=3166 | speaker=unknown"
msgid "　魔術師としてのあり方を目撃され、ピンチなのは彼女も同じなのに、"
msgstr ""

#. Occurrence 3_1:3162:3167: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0002; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:3162
msgctxt "text_id=3167 | speaker=alice"
msgid "「……これは、困った事になったわね」"
msgstr ""

#. Occurrence 3_1:3168:3168: scene=3_1
#: 3_1:3168
msgctxt "text_id=3168 | speaker=unknown"
msgid "　人影の走り去った闇を見つめる姿は、冷静というより彫像か何かのように無反応。"
msgstr ""

#. Occurrence 3_1:3174:3169: scene=3_1
#: 3_1:3174
msgctxt "text_id=3169 | speaker=unknown"
msgid "　……本当、うんざりする。"
msgstr ""

#. Occurrence 3_1:3174:3170: scene=3_1
#: 3_1:3174
msgctxt "text_id=3170 | speaker=unknown"
msgid "　抑揚のないその声は、月の無い晩に、憎らしいほど似合っていた。"
msgstr ""

#. Occurrence 4_1:44:3171: scene=4_1
#: 4_1:44
msgctxt "text_id=3171 | speaker=unknown"
msgid "　唐突に言うと、私は魔法使いである。"
msgstr ""

#. Occurrence 4_1:73:3172: scene=4_1
#: 4_1:73
msgctxt "text_id=3172 | speaker=unknown"
msgid "　なんていうか、指先ひとつで奇跡を起こして、<辺鄙|へんぴ>な森に隠れ住んでいる童話のあれだ。"
msgstr ""

#. Occurrence 4_1:78:3173: scene=4_1
#: 4_1:78
msgctxt "text_id=3173 | speaker=unknown"
msgid "　イメージはちょっと違うけど、わりと的を射ているので採用したいと思う。"
msgstr ""

#. Occurrence 4_1:100:3174: scene=4_1
#: 4_1:100
msgctxt "text_id=3174 | speaker=unknown"
msgid "　ただ断っておくと、ホウキに乗って空は飛ばない。"
msgstr ""

#. Occurrence 4_1:105:3175: scene=4_1
#: 4_1:105
msgctxt "text_id=3175 | speaker=unknown"
msgid "　動物に変身したり小鳥と話したりもできない。"
msgstr ""

#. Occurrence 4_1:110:3176: scene=4_1
#: 4_1:110
msgctxt "text_id=3176 | speaker=unknown"
msgid "　夢があるようでないのが今風の魔術師なのである。"
msgstr ""

#. Occurrence 4_1:164:3177: scene=4_1
#: 4_1:164
msgctxt "text_id=3177 | speaker=unknown"
msgid "　非常識だけど現実的。"
msgstr ""

#. Occurrence 4_1:169:3178: scene=4_1
#: 4_1:169
msgctxt "text_id=3178 | speaker=unknown"
msgid "　万能なようでわりと<窮屈|きゅうくつ>。"
msgstr ""

#. Occurrence 4_1:174:3179: scene=4_1
#: 4_1:174
msgctxt "text_id=3179 | speaker=unknown"
msgid "　胸を張るには色々半端なものだけど、私の本当の職業は学生じゃなくて、そんな<浪漫|ロマン>あふれるものだった。"
msgstr ""

#. Occurrence 4_1:194:3180: scene=4_1
#: 4_1:194
msgctxt "text_id=3180 | speaker=unknown"
msgid "　けど、その事はもちろん秘密。"
msgstr ""

#. Occurrence 4_1:200:3181: scene=4_1
#: 4_1:200
msgctxt "text_id=3181 | speaker=unknown"
msgid "“魔術師はこれ、その<御業|みわざ>をすべて<隠匿|いんとく>すべし”"
msgstr ""

#. Occurrence 4_1:206:3182: scene=4_1
#: 4_1:206
msgctxt "text_id=3182 | speaker=unknown"
msgid "　協会の十箇条のトップに出ている事だし、私だってこんなワケわかんない<話|こと>を口外する気はさらさらない。"
msgstr ""

#. Occurrence 4_1:253:3183: scene=4_1
#: 4_1:253
msgctxt "text_id=3183 | speaker=unknown"
msgid "　これでも外じゃ優等生で通っているし、だいたい、知らしめたところで私が嬉しい事なんてまったくない。"
msgstr ""

#. Occurrence 4_1:258:3184: scene=4_1
#: 4_1:258
msgctxt "text_id=3184 | speaker=unknown"
msgid "　どっちかというと頭の痛いことばかりだ。"
msgstr ""

#. Occurrence 4_1:263:3185: scene=4_1
#: 4_1:263
msgctxt "text_id=3185 | speaker=unknown"
msgid "　なので、そんなつまんない事は極力、自重するにかぎる。"
msgstr ""

#. Occurrence 4_1:298:3186: scene=4_1
#: 4_1:298
msgctxt "text_id=3186 | speaker=unknown"
msgid "　もっとも、それはまだ私が立派な魔法使いになれていないからだ。"
msgstr ""

#. Occurrence 4_1:303:3187: scene=4_1
#: 4_1:303
msgctxt "text_id=3187 | speaker=unknown"
msgid "　生涯の秘密というのは、私自身が立派になって一人前になった時、たったひとりにだけ打ち明けられれば、それで幸せだと思う。"
msgstr ""

#. Occurrence 4_1:323:3188: scene=4_1
#: 4_1:323
msgctxt "text_id=3188 | speaker=unknown"
msgid "　うん。いちばん大きな秘密の告白が『実は魔法使いでした』なんていうのは、たいへん洒落ている。"
msgstr ""

#. Occurrence 4_1:329:3189: scene=4_1
#: 4_1:329
msgctxt "text_id=3189 | speaker=unknown"
msgid "　そのシーンを想像すると妙におかしくて、協会の規則なんかより晩年のために秘密を守りたくなるぐらい。"
msgstr ""

#. Occurrence 4_1:374:3190: scene=4_1
#: 4_1:374
msgctxt "text_id=3190 | speaker=unknown"
msgid "　以上の事を祖父に話すと、彼は私の頭を撫でてくれた。"
msgstr ""

#. Occurrence 4_1:380:3191: scene=4_1
#: 4_1:380
msgctxt "text_id=3191 | speaker=unknown"
msgid "　誉めてくれたのか<窘|たしな>めていたのかは分からないけど、あの人にしては優しい感触だったと思う。"
msgstr ""

#. Occurrence 4_1:411:3192: scene=4_1
#: 4_1:411
msgctxt "text_id=3192 | speaker=unknown"
msgid "　私が魔術―――祖父の後を継ぐ事になったのは、中学を卒業したその日だった。"
msgstr ""

#. Occurrence 4_1:416:3193: scene=4_1
#: 4_1:416
msgctxt "text_id=3193 | speaker=unknown"
msgid "　家に帰るなり祖父は"
msgstr ""

#. Occurrence 4_1:422:3194: scene=4_1
#: 4_1:422
msgctxt "text_id=3194 | speaker=unknown"
msgid "『姉は旅に出た。今日からおまえが蒼崎の後継ぎだ』"
msgstr ""

#. Occurrence 4_1:428:3195: scene=4_1
#: 4_1:428
msgctxt "text_id=3195 | speaker=unknown"
msgid "　なんて事を淡々と語ったのだ。"
msgstr ""

#. Occurrence 4_1:460:3196: scene=4_1
#: 4_1:460
msgctxt "text_id=3196 | speaker=unknown"
msgid "　蒼崎の家が魔術なんて古くさいものを伝えていた事は知っていたけど、正直、自分にそのおはちが回ってくるとは思ってもいなかった。"
msgstr ""

#. Occurrence 4_1:493:3197: scene=4_1
#: 4_1:493
msgctxt "text_id=3197 | speaker=unknown"
msgid "　魔術の継承は<一子相伝|いっしそうでん>とかなんとか。"
msgstr ""

#. Occurrence 4_1:499:3198: scene=4_1
#: 4_1:499
msgctxt "text_id=3198 | speaker=unknown"
msgid "　色々と決まり事の多そうな魔法使いの座とやらは姉貴の役割で、私はそういうトンデモとは無関係。いたってノーマルな生活設計、将来希望だったのだ。"
msgstr ""

#. Occurrence 4_1:519:3199: scene=4_1
#: 4_1:519
msgctxt "text_id=3199 | speaker=unknown"
msgid "　なので、姉貴には悪いけど自由気ままに人生を送らせてもらいましょう―――"
msgstr ""

#. Occurrence 4_1:524:3200: scene=4_1
#: 4_1:524
msgctxt "text_id=3200 | speaker=unknown"
msgid "　なんて気楽にやってきたところで、とんでもないカウンターが待っていたワケである。"
msgstr ""

#. Occurrence 4_1:557:3201: scene=4_1
#: 4_1:557
msgctxt "text_id=3201 | speaker=unknown"
msgid "　以来、私は今まで横目で見ていただけの世界に身を置くことになった。"
msgstr ""

#. Occurrence 4_1:562:3202: scene=4_1
#: 4_1:562
msgctxt "text_id=3202 | speaker=unknown"
msgid "　まさかまさかの高校デビュー。"
msgstr ""

#. Occurrence 4_1:568:3203: scene=4_1
#: 4_1:568
msgctxt "text_id=3203 | speaker=unknown"
msgid "　まあ、新生活のスタートとしては悪くない。"
msgstr ""

#. Occurrence 4_1:604:3204: scene=4_1
#: 4_1:604
msgctxt "text_id=3204 | speaker=unknown"
msgid "　……それから色々あって現在。"
msgstr ""

#. Occurrence 4_1:609:3205: scene=4_1
#: 4_1:609
msgctxt "text_id=3205 | speaker=unknown"
msgid "　この役柄には戸惑ったけど、それも気が付けばもう二年目に届こうとしている。"
msgstr ""

#. Occurrence 4_1:641:3206: scene=4_1
#: 4_1:641
msgctxt "text_id=3206 | speaker=unknown"
msgid "　その間にトラブルらしき物は一切なかったし……私たちの名誉のため、半年に<亘|わた>る同居人との殺し合いはカウントしない……"
msgstr ""

#. Occurrence 4_1:647:3207: scene=4_1
#: 4_1:647
msgctxt "text_id=3207 | speaker=unknown"
msgid "魔法使いとしての才能もそれなりに優れているみたいで、まだ壁にはぶつかってはいない。"
msgstr ""

#. Occurrence 4_1:691:3208: scene=4_1
#: 4_1:691
msgctxt "text_id=3208 | speaker=unknown"
msgid "　人間なんだから頭の痛い悩みは二つや三つあるけれど、今のところ将来に不安を感じる事はまったくなかった。"
msgstr ""

#. Occurrence 4_1:696:3209: scene=4_1
#: 4_1:696
msgctxt "text_id=3209 | speaker=unknown"
msgid "　私の生活は、このまま<順風満帆|じゅんぷうまんぱん>に行くと思っていたのだ。"
msgstr ""

#. Occurrence 4_1:713:3210: scene=4_1
#: 4_1:713
msgctxt "text_id=3210 | speaker=unknown"
msgid "　昨夜の、例の一件さえ起こらなければ。"
msgstr ""

#. Occurrence 4_1:748:3211: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0000; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:748
msgctxt "text_id=3211 | speaker=alice"
msgid "「どう？」"
msgstr ""

#. Occurrence 4_1:770:3212: scene=4_1
#: 4_1:770
msgctxt "text_id=3212 | speaker=unknown"
msgid "　久遠寺邸に帰宅するなり、蒼崎青子は久遠寺有珠にそう<訊|たず>ねられた。"
msgstr ""

#. Occurrence 4_1:775:3213: scene=4_1
#: 4_1:775
msgctxt "text_id=3213 | speaker=unknown"
msgid "　切迫感も危機感もない声だが、<玻|は><璃|り>のような<黒瞳|こくどう>が事の重要性を告げている。"
msgstr ""

#. Occurrence 4_1:826:3214: scene=4_1
#: 4_1:826
msgctxt "text_id=3214 | speaker=unknown"
msgid "　色気のないコートを脱いでハンガーにかけ、青子はソファーに腰を下ろした。"
msgstr ""

#. Occurrence 4_1:831:3215: scene=4_1
#: 4_1:831
msgctxt "text_id=3215 | speaker=unknown"
msgid "　正面にはテーブルを挟んで有珠が座っている。"
msgstr ""

#. Occurrence 4_1:865:3216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:865
msgctxt "text_id=3216 | speaker=aoko"
msgid "「そっちは？」"
msgstr ""

#. Occurrence 4_1:885:3217: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0001; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:885
msgctxt "text_id=3217 | speaker=alice"
msgid "「良くないわね。<偵察|ていさつ>に行けるのは七個ぐらい。ここのところ使ってばかりで、作り置きをする余裕もなかったし」"
msgstr ""

#. Occurrence 4_1:891:3218: scene=4_1
#: 4_1:891
msgctxt "text_id=3218 | speaker=unknown"
msgid "　青子から視線を逸らすと、有珠はテーブルの上に置かれた箱に視線を戻す。"
msgstr ""

#. Occurrence 4_1:937:3219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3219 | speaker=aoko"
msgid "「あの夜、街を監視していたヤツはいないの？"
msgstr ""

#. Occurrence 4_1:937:3220: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3220 | speaker=aoko"
msgid "　街の偵察は完璧なんでしょ、そいつら」"
msgstr ""

#. Occurrence 4_1:953:3221: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0002; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:953
msgctxt "text_id=3221 | speaker=alice"
msgid "「それは昼間の話よ。夜間飛行は危険が多いわ」"
msgstr ""

#. Occurrence 4_1:990:3222: scene=4_1
#: 4_1:990
msgctxt "text_id=3222 | speaker=unknown"
msgid "　肝心なところで役に立たないのね、とため息をつく青子。"
msgstr ""

#. Occurrence 4_1:1017:3223: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0003; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1017
msgctxt "text_id=3223 | speaker=alice"
msgid "「……そういう貴女は？　朝はずいぶんと強気だったけど？」"
msgstr ""

#. Occurrence 4_1:1046:3224: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0002; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1046
msgctxt "text_id=3224 | speaker=aoko"
msgid "「ん？　"
msgstr ""

msgctxt "text_id=3225 | speaker=unknown"
msgid "あ、こっちは予定通りよ。"
msgstr ""

#. Occurrence 4_1:1059:3226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0003; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1059
msgctxt "text_id=3226 | speaker=aoko"
msgid "　明日までにはしぼりこめると思う。今朝、鳶丸にうちの生徒の自宅と行動時間を調べさせたから。"
msgstr ""

#. Occurrence 4_1:1065:3227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0004; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1065
msgctxt "text_id=3227 | speaker=aoko"
msgid "　あの時間に公園をうろつく奴は滅多にいないし、簡単に割り出せる」"
msgstr ""

#. Occurrence 4_1:1098:3228: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0004; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1098
msgctxt "text_id=3228 | speaker=alice"
msgid "「そう簡単にいくの？」"
msgstr ""

#. Occurrence 4_1:1104:3229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0005; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1104
msgctxt "text_id=3229 | speaker=aoko"
msgid "「いくわよ。<伊|ダ><達|テ>に生徒会に勤めてないわ。その程度のデータは揃えてある。"
msgstr ""

#. Occurrence 4_1:1111:3230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0006; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1111
msgctxt "text_id=3230 | speaker=aoko"
msgid "月一のバイト先はおろか親しい友人宅との移動時間、その優先順位まで調べ上げてるんだから。"
msgstr ""

#. Occurrence 4_1:1117:3231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0007; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1117
msgctxt "text_id=3231 | speaker=aoko"
msgid "　<他|ひ><人|と>には見せたくなかったリストだけど、そんな余裕ないでしょ？　だから、そういうのが向いてる副会長にやらせたの」"
msgstr ""

#. Occurrence 4_1:1155:3232: scene=4_1
#: 4_1:1155
msgctxt "text_id=3232 | speaker=unknown"
msgid "　余談ではあるが、その機密ファイルが作成されたのは青子が生徒会長になってからである。"
msgstr ""

#. Occurrence 4_1:1160:3233: scene=4_1
#: 4_1:1160
msgctxt "text_id=3233 | speaker=unknown"
msgid "　その存在だけが噂され、彼女が全校生徒に恐れられる一因になっている、いわく付きの一品だ。"
msgstr ""

#. Occurrence 4_1:1199:3234: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0005; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1199
msgctxt "text_id=3234 | speaker=alice"
msgid "「……そう。徹底しているわね、あい変わらず」"
msgstr ""

#. Occurrence 4_1:1205:3235: scene=4_1
#: 4_1:1205
msgctxt "text_id=3235 | speaker=unknown"
msgid "　やや呆れ気味に漏らす有珠。"
msgstr ""

#. Occurrence 4_1:1210:3236: scene=4_1
#: 4_1:1210
msgctxt "text_id=3236 | speaker=unknown"
msgid "　同居をはじめて二年近く。"
msgstr ""

#. Occurrence 4_1:1215:3237: scene=4_1
#: 4_1:1215
msgctxt "text_id=3237 | speaker=unknown"
msgid "　一度やると決めればとことんまで突っ走るのが蒼崎青子だと、有珠も十分身にしみている。"
msgstr ""

#. Occurrence 4_1:1258:3238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0008; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1258
msgctxt "text_id=3238 | speaker=aoko"
msgid "「ま、私もアレがこんな風に役立つとは思ってもみなかったけど。ほんと、備えあれば憂いなしとはこの事ね」"
msgstr ""

#. Occurrence 4_1:1264:3239: scene=4_1
#: 4_1:1264
msgctxt "text_id=3239 | speaker=unknown"
msgid "　とはいえ昨夜の出来事は異例中の異例だ。"
msgstr ""

#. Occurrence 4_1:1269:3240: scene=4_1
#: 4_1:1269
msgctxt "text_id=3240 | speaker=unknown"
msgid "　この状況は、本来起こりえるものではない。"
msgstr ""

#. Occurrence 4_1:1308:3241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_9000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1308
msgctxt "text_id=3241 | speaker=aoko"
msgid "「それより原因は分かったの？　結界の<結|むす>びに不手際があったなんてのは聞かないわよ」"
msgstr ""

#. Occurrence 4_1:1314:3242: scene=4_1
#: 4_1:1314
msgctxt "text_id=3242 | speaker=unknown"
msgid "　凛とした視線を一際強くする青子。"
msgstr ""

#. Occurrence 4_1:1319:3243: scene=4_1
#: 4_1:1319
msgctxt "text_id=3243 | speaker=unknown"
msgid "　結界の仕上げは有珠の役割だ。"
msgstr ""

#. Occurrence 4_1:1324:3244: scene=4_1
#: 4_1:1324
msgctxt "text_id=3244 | speaker=unknown"
msgid "　昨夜のトラブルの原因が結界にあるのなら、責任の所在は明らかにしなくてはならない。"
msgstr ""

#. Occurrence 4_1:1361:3245: scene=4_1
#: 4_1:1361
msgctxt "text_id=3245 | speaker=unknown"
msgid "　同居人であり相棒である青子と有珠だが、それはあくまで利害が一致しているからである。"
msgstr ""

#. Occurrence 4_1:1366:3246: scene=4_1
#: 4_1:1366
msgctxt "text_id=3246 | speaker=unknown"
msgid "　ふたりの関係は、それが家柄によるものだとしても、味方というより敵に近い。"
msgstr ""

#. Occurrence 4_1:1371:3247: scene=4_1
#: 4_1:1371
msgctxt "text_id=3247 | speaker=unknown"
msgid "　最終的な話、蒼崎青子と久遠寺有珠は<相容|あいい>れない。"
msgstr ""

#. Occurrence 4_1:1407:3248: scene=4_1
#: 4_1:1407
msgctxt "text_id=3248 | speaker=unknown"
msgid "　失点があれば叩く。"
msgstr ""

#. Occurrence 4_1:1426:3249: scene=4_1
#: 4_1:1426
msgctxt "text_id=3249 | speaker=unknown"
msgid "　隙があれば攻撃する。"
msgstr ""

#. Occurrence 4_1:1453:3250: scene=4_1
#: 4_1:1453
msgctxt "text_id=3250 | speaker=unknown"
msgid "　―――機会さえ。"
msgstr ""

#. Occurrence 4_1:1458:3251: scene=4_1
#: 4_1:1458
msgctxt "text_id=3251 | speaker=unknown"
msgid "　互いが信条的に納得のいく機会が訪れるのなら、当然のように殺し合う関係だ。"
msgstr ""

#. Occurrence 4_1:1514:3252: scene=4_1
#: 4_1:1514
msgctxt "text_id=3252 | speaker=unknown"
msgid "　そんな青子の視線を、有珠は正面から受けとめる。"
msgstr ""

#. Occurrence 4_1:1542:3253: scene=4_1
#: 4_1:1542
msgctxt "text_id=3253 | speaker=unknown"
msgid "　大の男でもたじろぐ視線を前にして、有珠の<表情|かお>は微塵も変わらない。"
msgstr ""

#. Occurrence 4_1:1569:3254: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0007; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1569
msgctxt "text_id=3254 | speaker=alice"
msgid "「……仮の話だけど。あの結界に落ち度があったのなら、今まで何度もこういう状況になっていたでしょうね」"
msgstr ""

#. Occurrence 4_1:1591:3255: scene=4_1
#: 4_1:1591
msgctxt "text_id=3255 | speaker=unknown"
msgid "　でしょうね、と青子は頷いた。立場上問いつめただけで、青子は有珠を信頼している。"
msgstr ""

#. Occurrence 4_1:1626:3256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0009; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1626
msgctxt "text_id=3256 | speaker=aoko"
msgid "「結界の在り方は完璧だったのね？」"
msgstr ""

#. Occurrence 4_1:1650:3257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0008; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1650
msgctxt "text_id=3257 | speaker=alice"
msgid "「絶対とまでは、断言はできないけど」"
msgstr ""

#. Occurrence 4_1:1656:3258: scene=4_1
#: 4_1:1656
msgctxt "text_id=3258 | speaker=unknown"
msgid "　やはり抑揚のない声で答える有珠。"
msgstr ""

#. Occurrence 4_1:1718:3259: scene=4_1
#: 4_1:1718
msgctxt "text_id=3259 | speaker=unknown"
msgid "　結界とは、一つの閉じられた世界を意味する。"
msgstr ""

#. Occurrence 4_1:1723:3260: scene=4_1
#: 4_1:1723
msgctxt "text_id=3260 | speaker=unknown"
msgid "　閉じたい場所を、どのような手段であれ外界から<遮断|しゃだん>した状況を結界と呼ぶ。"
msgstr ""

#. Occurrence 4_1:1728:3261: scene=4_1
#: 4_1:1728
msgctxt "text_id=3261 | speaker=unknown"
msgid "　結界には様々な種類があり、"
msgstr ""

#. Occurrence 4_1:1733:3262: scene=4_1
#: 4_1:1733
msgctxt "text_id=3262 | speaker=unknown"
msgid "　実際にその区間を壁で隔離する物理的なものもあれば、"
msgstr ""

#. Occurrence 4_1:1738:3263: scene=4_1
#: 4_1:1738
msgctxt "text_id=3263 | speaker=unknown"
msgid "　区間内の様子を鏡や霧、森の囲み等で隠してしまう視覚的なものもある。"
msgstr ""

#. Occurrence 4_1:1759:3264: scene=4_1
#: 4_1:1759
msgctxt "text_id=3264 | speaker=unknown"
msgid "　ただし、それらの結界は『内部』を閉じるために『外部』に異常性を報せてしまっている。"
msgstr ""

#. Occurrence 4_1:1764:3265: scene=4_1
#: 4_1:1764
msgctxt "text_id=3265 | speaker=unknown"
msgid "　立ち入り禁止にはできても、その区間が立ち入り禁止となっている事実を隠蔽できない。"
msgstr ""

#. Occurrence 4_1:1769:3266: scene=4_1
#: 4_1:1769
msgctxt "text_id=3266 | speaker=unknown"
msgid "　いずれ、中の様子が見えずとも“立ち入り禁止”区域そのものに興味を持つ者がでてくるだろう。"
msgstr ""

#. Occurrence 4_1:1804:3267: scene=4_1
#: 4_1:1804
msgctxt "text_id=3267 | speaker=unknown"
msgid "　それでは本末転倒だ。"
msgstr ""

#. Occurrence 4_1:1809:3268: scene=4_1
#: 4_1:1809
msgctxt "text_id=3268 | speaker=unknown"
msgid "　真に優れた結界とは、外界に何ら異変を感じさせず、同時に、外から干渉されない<隔|へだ>たりでなくてはならない。"
msgstr ""

#. Occurrence 4_1:1847:3269: scene=4_1
#: 4_1:1847
msgctxt "text_id=3269 | speaker=unknown"
msgid "　昨夜、久遠寺有珠が公園に敷いた結界はその<類|たぐい>の、“理想的な”結界だった。"
msgstr ""

#. Occurrence 4_1:1868:3270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0010; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1868
msgctxt "text_id=3270 | speaker=aoko"
msgid "「……その場所に用があっても、今は無いように思わせれば誰もそこには立ち入らない。"
msgstr ""

#. Occurrence 4_1:1899:3271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0011; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1899
msgctxt "text_id=3271 | speaker=aoko"
msgid "　隠したい場所の周りに、一時的な意識の<改竄|かいざん>を<促|うなが>す結界を張る……手間はかかるんだけど、一時間程度の<人避|ひとよ>けには信頼性は高い結界よね。"
msgstr ""

#. Occurrence 4_1:1918:3272: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3272 | speaker=aoko"
msgid "　有珠の鏡を使った一級品だし、途中で破れる事もない。事実、入ってきたのはあの人形だけだとはっきり感じられた。"
msgstr ""

#. Occurrence 4_1:1918:3273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3273 | speaker=aoko"
msgid "　これで完璧じゃなかったら何が完璧なのよ？」"
msgstr ""

#. Occurrence 4_1:1956:3274: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0009; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1956
msgctxt "text_id=3274 | speaker=alice"
msgid "「……わたしも分からない。森作りに落ち度はなかったわ。"
msgstr ""

#. Occurrence 4_1:1962:3275: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0010; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1962
msgctxt "text_id=3275 | speaker=alice"
msgid "　森は数日かけて栽培したものだし、今まで通り信頼できる結界よ。けど例外があったのなら、どこかで見落としがあったのね」"
msgstr ""

#. Occurrence 4_1:1968:3276: scene=4_1
#: 4_1:1968
msgctxt "text_id=3276 | speaker=unknown"
msgid "　そう言う有珠の瞳は、その見落とし自体なかった事を示している。"
msgstr ""

#. Occurrence 4_1:2010:3277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0013; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2010
msgctxt "text_id=3277 | speaker=aoko"
msgid "「……まいった。こうなると、一番いいのは<目撃者|あいつ>が人形使いだってパターンね。それならかろうじて納得できる。相手が魔術師なら、結界の侵入ぐらいできるでしょうし。"
msgstr ""

#. Occurrence 4_1:2022:3278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0014; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2022
msgctxt "text_id=3278 | speaker=aoko"
msgid "　問題は……侵入した時の違和感を、どうやって消したかって事だけど」"
msgstr ""

#. Occurrence 4_1:2042:3279: scene=4_1
#: 4_1:2042
msgctxt "text_id=3279 | speaker=unknown"
msgid "　そんな使い手が自分たちを狙っている、というのもぞっとしない話だ。"
msgstr ""

#. Occurrence 4_1:2047:3280: scene=4_1
#: 4_1:2047
msgctxt "text_id=3280 | speaker=unknown"
msgid "　有珠の結界を魔術で騙し通せるという事は、相手は久遠寺有珠を上回る魔術の腕を持つという事。"
msgstr ""

#. Occurrence 4_1:2066:3281: scene=4_1
#: 4_1:2066
msgctxt "text_id=3281 | speaker=unknown"
msgid "　―――とてもではないが、今の蒼崎青子にどうにかできる相手ではない。"
msgstr ""

#. Occurrence 4_1:2116:3282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0011; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2116
msgctxt "text_id=3282 | speaker=alice"
msgid "「……その線はないわ。"
msgstr ""

#. Occurrence 4_1:2122:3283: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0012; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2122
msgctxt "text_id=3283 | speaker=alice"
msgid "　彼は部外者よ。<椋鳥|むくどり>はともかく、ロビンが後を<辿|たど>れなかったもの。魔力の気配はまったくなし。誰かの魔術で操られている犠牲者、というのもないわね」"
msgstr ""

#. Occurrence 4_1:2156:3284: scene=4_1
#: 4_1:2156
msgctxt "text_id=3284 | speaker=unknown"
msgid "　はかない希望は打ち砕かれた。"
msgstr ""

#. Occurrence 4_1:2161:3285: scene=4_1
#: 4_1:2161
msgctxt "text_id=3285 | speaker=unknown"
msgid "　なら、これで青子の質問は終わりだ。"
msgstr ""

#. Occurrence 4_1:2166:3286: scene=4_1
#: 4_1:2166
msgctxt "text_id=3286 | speaker=unknown"
msgid "　ここはもう、たんに運が無かったと諦めて昨夜の事を認めるしかない。"
msgstr ""

#. Occurrence 4_1:2211:3287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0015; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2211
msgctxt "text_id=3287 | speaker=aoko"
msgid "『……魔術師の秘密を見られて、おまけに目撃者を逃がした、か……。普通の高校生の悩みじゃないなぁ……』"
msgstr ""

#. Occurrence 4_1:2217:3288: scene=4_1
#: 4_1:2217
msgctxt "text_id=3288 | speaker=unknown"
msgid "　ばふ、とソファーに大きく背中を預ける。"
msgstr ""

#. Occurrence 4_1:2222:3289: scene=4_1
#: 4_1:2222
msgctxt "text_id=3289 | speaker=unknown"
msgid "　悲しいかな、見上げた空はブラウンの天井だ。"
msgstr ""

#. Occurrence 4_1:2227:3290: scene=4_1
#: 4_1:2227
msgctxt "text_id=3290 | speaker=unknown"
msgid "　風情も何もあったものじゃない、とますます青子はブルーになる。"
msgstr ""

#. Occurrence 4_1:2248:3291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0013; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2248
msgctxt "text_id=3291 | speaker=alice"
msgid "「青子。覚悟を決めておいて」"
msgstr ""

#. Occurrence 4_1:2273:3292: scene=4_1
#: 4_1:2273
msgctxt "text_id=3292 | speaker=unknown"
msgid "　超然とした同居人の声。"
msgstr ""

#. Occurrence 4_1:2278:3293: scene=4_1
#: 4_1:2278
msgctxt "text_id=3293 | speaker=unknown"
msgid "　天井を見上げる青子の瞳に変化はない。ただ、ぼんやりと木造の景色を眺めている。"
msgstr ""

#. Occurrence 4_1:2304:3294: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0014; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2304
msgctxt "text_id=3294 | speaker=alice"
msgid "「……それとも。貴女にできないのなら、わたしが行ってあげてもいいけど」"
msgstr ""

#. Occurrence 4_1:2339:3295: scene=4_1
#: 4_1:2339
msgctxt "text_id=3295 | speaker=unknown"
msgid "　冷酷な彼女の言葉は、真実、冷酷な意味を持っていた。"
msgstr ""

#. Occurrence 4_1:2344:3296: scene=4_1
#: 4_1:2344
msgctxt "text_id=3296 | speaker=unknown"
msgid "　それをゆっくり、自分に許される精一杯の誠実さで青子は飲みこんだ。"
msgstr ""

#. Occurrence 4_1:2349:3297: scene=4_1
#: 4_1:2349
msgctxt "text_id=3297 | speaker=unknown"
msgid "　決して消化できない、熱した<鉛|なまり>を口にするように。"
msgstr ""

#. Occurrence 4_1:2393:3298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0016; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2393
msgctxt "text_id=3298 | speaker=aoko"
msgid "『……そうだ。覚悟なんて、もう決めたでしょう』"
msgstr ""

#. Occurrence 4_1:2399:3299: scene=4_1
#: 4_1:2399
msgctxt "text_id=3299 | speaker=unknown"
msgid "　自分に言い聞かせるが、それも誤魔化しだ。"
msgstr ""

#. Occurrence 4_1:2404:3300: scene=4_1
#: 4_1:2404
msgctxt "text_id=3300 | speaker=unknown"
msgid "　明らかに前回と今回は違う。"
msgstr ""

#. Occurrence 4_1:2409:3301: scene=4_1
#: 4_1:2409
msgctxt "text_id=3301 | speaker=unknown"
msgid "　やる事は同じだとしても、その対象の立場が違う。"
msgstr ""

#. Occurrence 4_1:2440:3302: scene=4_1
#: 4_1:2440
msgctxt "text_id=3302 | speaker=unknown"
msgid "　前回の覚悟は、いわば魔術師としての覚悟だった。"
msgstr ""

#. Occurrence 4_1:2445:3303: scene=4_1
#: 4_1:2445
msgctxt "text_id=3303 | speaker=unknown"
msgid "　敵が来るから倒す。"
msgstr ""

#. Occurrence 4_1:2450:3304: scene=4_1
#: 4_1:2450
msgctxt "text_id=3304 | speaker=unknown"
msgid "　戦いを挑まれたのならこれに応える。"
msgstr ""

#. Occurrence 4_1:2455:3305: scene=4_1
#: 4_1:2455
msgctxt "text_id=3305 | speaker=unknown"
msgid "　こちらもむこうも同じ魔術師で、形式上<非|ひ>はあちら側にある。たとえその決着が殺人以外の何物でもないとしても、お互い合意の行動だ。"
msgstr ""

#. Occurrence 4_1:2460:3306: scene=4_1
#: 4_1:2460
msgctxt "text_id=3306 | speaker=unknown"
msgid "　殺し、殺される<天秤|てんびん>の上での行為。"
msgstr ""

#. Occurrence 4_1:2465:3307: scene=4_1
#: 4_1:2465
msgctxt "text_id=3307 | speaker=unknown"
msgid "　彼らも彼女も、善悪の<秤|はかり>をそもそも用意していない。"
msgstr ""

#. Occurrence 4_1:2503:3308: scene=4_1
#: 4_1:2503
msgctxt "text_id=3308 | speaker=unknown"
msgid "　けれど今回は違う。"
msgstr ""

#. Occurrence 4_1:2508:3309: scene=4_1
#: 4_1:2508
msgctxt "text_id=3309 | speaker=unknown"
msgid "　相手は敵でもないし、魔術師でもない。こっちはそのつもりでも、相手にその気はないだろう。"
msgstr ""

#. Occurrence 4_1:2513:3310: scene=4_1
#: 4_1:2513
msgctxt "text_id=3310 | speaker=unknown"
msgid "　……だから、これはきっと善悪の話になる。"
msgstr ""

#. Occurrence 4_1:2518:3311: scene=4_1
#: 4_1:2518
msgctxt "text_id=3311 | speaker=unknown"
msgid "　無関係な殺戮を、果たして自分は負えるのか。"
msgstr ""

#. Occurrence 4_1:2523:3312: scene=4_1
#: 4_1:2523
msgctxt "text_id=3312 | speaker=unknown"
msgid "　魔術師なら当然の、よくある<手|こ><間|と>だと飲みこむのか。"
msgstr ""

#. Occurrence 4_1:2571:3313: scene=4_1
#: 4_1:2571
msgctxt "text_id=3313 | speaker=unknown"
msgid "　まさか、と鼻で笑う。"
msgstr ""

#. Occurrence 4_1:2576:3314: scene=4_1
#: 4_1:2576
msgctxt "text_id=3314 | speaker=unknown"
msgid "『魔術師だから』なんて理由で現実社会との折り合いを無くす超越性なぞ、はなから青子は持っていない。"
msgstr ""

#. Occurrence 4_1:2581:3315: scene=4_1
#: 4_1:2581
msgctxt "text_id=3315 | speaker=unknown"
msgid "　心に確信のないまま、"
msgstr ""

#. Occurrence 4_1:2586:3316: scene=4_1
#: 4_1:2586
msgctxt "text_id=3316 | speaker=unknown"
msgid "　分からないまま行動する事を、青子は嫌っている。"
msgstr ""

#. Occurrence 4_1:2591:3317: scene=4_1
#: 4_1:2591
msgctxt "text_id=3317 | speaker=unknown"
msgid "　彼女が走る時は、いつも自分に決断を下した後だ。"
msgstr ""

#. Occurrence 4_1:2654:3318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0017; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2654
msgctxt "text_id=3318 | speaker=aoko"
msgid "「うん。ま、やるしかないだろうね」"
msgstr ""

#. Occurrence 4_1:2687:3319: scene=4_1
#: 4_1:2687
msgctxt "text_id=3319 | speaker=unknown"
msgid "　さばさばした一言とともに、青子はソファーから背を離した。いいかげん天井は見飽きたらしい。"
msgstr ""

#. Occurrence 4_1:2692:3320: scene=4_1
#: 4_1:2692
msgctxt "text_id=3320 | speaker=unknown"
msgid "　青子はいつも通りの青子で、有珠もあえて言及はしない。"
msgstr ""

#. Occurrence 4_1:2720:3321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0015; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2720
msgctxt "text_id=3321 | speaker=alice"
msgid "「じゃあ、これ」"
msgstr ""

#. Occurrence 4_1:2726:3322: scene=4_1
#: 4_1:2726
msgctxt "text_id=3322 | speaker=unknown"
msgid "　ご褒美、とばかりに有珠は<小瓶|こびん>を取り出した。"
msgstr ""

#. Occurrence 4_1:2762:3323: scene=4_1
#: 4_1:2762
msgctxt "text_id=3323 | speaker=unknown"
msgid "　手のひらに収まるほどの大きさ。"
msgstr ""

#. Occurrence 4_1:2767:3324: scene=4_1
#: 4_1:2767
msgctxt "text_id=3324 | speaker=unknown"
msgid "　少女の細い指先とは不釣り合いな、寸胴の、見栄えしない瓶である。"
msgstr ""

#. Occurrence 4_1:2772:3325: scene=4_1
#: 4_1:2772
msgctxt "text_id=3325 | speaker=unknown"
msgid "　瓶は曇っていて、中身はカラ。"
msgstr ""

#. Occurrence 4_1:2777:3326: scene=4_1
#: 4_1:2777
msgctxt "text_id=3326 | speaker=unknown"
msgid "　表面にはラベルのシールを強引に剥がした跡が見られた。"
msgstr ""

#. Occurrence 4_1:2798:3327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0018; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2798
msgctxt "text_id=3327 | speaker=aoko"
msgid "「なによ、それ」"
msgstr ""

#. Occurrence 4_1:2822:3328: scene=4_1
#: 4_1:2822
msgctxt "text_id=3328 | speaker=unknown"
msgid "　不吉なものを感じて、<胡散|うさん>臭そうに小瓶を睨む。"
msgstr ""

#. Occurrence 4_1:2862:3329: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0016; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2862
msgctxt "text_id=3329 | speaker=alice"
msgid "「収納の小瓶。ちょうどひとつ余ってたから、あげるわ」"
msgstr ""

#. Occurrence 4_1:2899:3330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0019; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2899
msgctxt "text_id=3330 | speaker=aoko"
msgid "「はい？」"
msgstr ""

#. Occurrence 4_1:2905:3331: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0017; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2905
msgctxt "text_id=3331 | speaker=alice"
msgid "「名前は忘れたけど、中国の小説に出てきたのと同じよ」"
msgstr ""

#. Occurrence 4_1:2918:3332: scene=4_1
#: 4_1:2918
msgctxt "text_id=3332 | speaker=unknown"
msgid "　素っ気ない言葉に、青子は驚異の理解力を示した。"
msgstr ""

#. Occurrence 4_1:2958:3333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_0; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2958
msgctxt "text_id=3333 | speaker=aoko"
msgid "「それって<蓮華洞|れんげどう>の<番人|きょうだい>の話？　じゃ、あの赤い<瓢箪|ひょうたん>と同じなわけ？"
msgstr ""

#. Occurrence 4_1:2985:3334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_1; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2985
msgctxt "text_id=3334 | speaker=aoko"
msgid "　言いたくないけど、そこらへんの風邪薬のラベルを無理やり剥がして、小瓶に見せかけてるそれが？」"
msgstr ""

#. Occurrence 4_1:3034:3335: scene=4_1
#: 4_1:3034
msgctxt "text_id=3335 | speaker=unknown"
msgid "　言われて、たしかにセンスも何もない、と小瓶をまじまじと見る有珠。"
msgstr ""

#. Occurrence 4_1:3060:3336: scene=4_1
#: 4_1:3060
msgctxt "text_id=3336 | speaker=unknown"
msgid "　が、別に自分が使うわけでもないと悟ったのか、あっさりと小瓶をテーブルに置いた。"
msgstr ""

#. Occurrence 4_1:3087:3337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0018; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3087
msgctxt "text_id=3337 | speaker=alice"
msgid "「赤い瓢箪じゃなくて、<羊脂玉|ようしぎょく>の<浄瓶|じょうびん>の方」"
msgstr ""

#. Occurrence 4_1:3117:3338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0021; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3117
msgctxt "text_id=3338 | speaker=aoko"
msgid "「そういう問題じゃない。私は魔術師としての雰囲気を論じてるんだっ」"
msgstr ""

#. Occurrence 4_1:3130:3339: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0019; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3130
msgctxt "text_id=3339 | speaker=alice"
msgid "「些細な事を気にするのね。<正露丸|せいろがん>の瓶じゃないだけいいと思うけど」"
msgstr ""

#. Occurrence 4_1:3143:3340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0022; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3143
msgctxt "text_id=3340 | speaker=aoko"
msgid "「―――む」"
msgstr ""

#. Occurrence 4_1:3148:3341: scene=4_1
#: 4_1:3148
msgctxt "text_id=3341 | speaker=unknown"
msgid "　あまりにも説得力のある返答だった。"
msgstr ""

#. Occurrence 4_1:3199:3342: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0020; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3199
msgctxt "text_id=3342 | speaker=alice"
msgid "「ふたを開けて、相手の名前を<訊|たず>ねればいいから。"
msgstr ""

#. Occurrence 4_1:3205:3343: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0021; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3205
msgctxt "text_id=3343 | speaker=alice"
msgid "　ただし相手に抵抗する意志が残っている場合、小瓶は割れるから気をつけて」"
msgstr ""

#. Occurrence 4_1:3210:3344: scene=4_1
#: 4_1:3210
msgctxt "text_id=3344 | speaker=unknown"
msgid "　淡々と語る有珠と、眉をひそめる青子。"
msgstr ""

#. Occurrence 4_1:3226:3345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0023; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3226
msgctxt "text_id=3345 | speaker=aoko"
msgid "「ちょっと待った。抵抗する意志があるとダメって、眠っている時にやれってコト？」"
msgstr ""

#. Occurrence 4_1:3277:3346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0022; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3277
msgctxt "text_id=3346 | speaker=alice"
msgid "「……それは試したコトがなかったわ。"
msgstr ""

#. Occurrence 4_1:3283:3347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0023; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3283
msgctxt "text_id=3347 | speaker=alice"
msgid "　眠っているのに返事をする人っているの？」"
msgstr ""

#. Occurrence 4_1:3304:3348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3348 | speaker=aoko"
msgid "「……たまにいるけど。"
msgstr ""

#. Occurrence 4_1:3304:3349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3349 | speaker=aoko"
msgid "　まあ、確かに珍しいわね、そういう人」"
msgstr ""

#. Occurrence 4_1:3310:3350: scene=4_1
#: 4_1:3310
msgctxt "text_id=3350 | speaker=unknown"
msgid "　となると、あとは相手が思いっきり衰弱していて、前後不覚になっている、といった状況ぐらいか。"
msgstr ""

#. Occurrence 4_1:3331:3351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0024; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3331
msgctxt "text_id=3351 | speaker=alice"
msgid "「あ、そうそう。薬や魔術がかかっていると、その<余分|おも>さでも割れるから気をつけて」"
msgstr ""

#. Occurrence 4_1:3376:3352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3352 | speaker=aoko"
msgid "「つっかえない！"
msgstr ""

#. Occurrence 4_1:3376:3353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3353 | speaker=aoko"
msgid "　それってほとんど役たたずって事じゃない！」"
msgstr ""

#. Occurrence 4_1:3406:3354: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0025; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3406
msgctxt "text_id=3354 | speaker=alice"
msgid "「それは青子しだいね」"
msgstr ""

#. Occurrence 4_1:3411:3355: scene=4_1
#: 4_1:3411
msgctxt "text_id=3355 | speaker=unknown"
msgid "　言って、有珠は視線を外す。"
msgstr ""

#. Occurrence 4_1:3416:3356: scene=4_1
#: 4_1:3416
msgctxt "text_id=3356 | speaker=unknown"
msgid "　もうこの話題はどうでもいい、と言うように。"
msgstr ""

#. Occurrence 4_1:3466:3357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0026; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3466
msgctxt "text_id=3357 | speaker=aoko"
msgid "「……はあ。有珠がこういう小道具好きなのは知ってたけどね……これも趣味なワケ？」"
msgstr ""

#. Occurrence 4_1:3471:3358: scene=4_1
#: 4_1:3471
msgctxt "text_id=3358 | speaker=unknown"
msgid "　あんまりこういう趣味は持ってほしくないな、と思いつつ青子は問う。"
msgstr ""

#. Occurrence 4_1:3484:3359: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0026; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3484
msgctxt "text_id=3359 | speaker=alice"
msgid "「たぶん。"
msgstr ""

#. Occurrence 4_1:3490:3360: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0027; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3490
msgctxt "text_id=3360 | speaker=alice"
msgid "　それで、どうするの？　持っていくのか、いかないのか」"
msgstr ""

#. Occurrence 4_1:3555:3361: scene=4_1
#: 4_1:3555
msgctxt "text_id=3361 | speaker=unknown"
msgid "　その質問には答えず、しばし迷ってから青子は小瓶を手に取ると、ポケットにしまいこんだ。"
msgstr ""

#. Occurrence 4_1:3561:3362: scene=4_1
#: 4_1:3561
msgctxt "text_id=3362 | speaker=unknown"
msgid "　まあ、何かの役には立つかもしれない。"
msgstr ""

#. Occurrence 4_2:54:3363: scene=4_2
#: 4_2:54
msgctxt "text_id=3363 | speaker=unknown"
msgid "　それから二時間ほど経った午後九時。"
msgstr ""

#. Occurrence 4_2:59:3364: scene=4_2
#: 4_2:59
msgctxt "text_id=3364 | speaker=unknown"
msgid "　ふたりは話し合いの場を居間からサンルームに移し、この洋館に不釣り合いな光景をくり広げていた。"
msgstr ""

#. Occurrence 4_2:105:3365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0000; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:105
msgctxt "text_id=3365 | speaker=aoko"
msgid "「まあホントはね、鳶丸に任せる気はなかったんだけど」"
msgstr ""

#. Occurrence 4_2:111:3366: scene=4_2
#: 4_2:111
msgctxt "text_id=3366 | speaker=unknown"
msgid "　テーブルの上にでん、と土鍋が置かれている。"
msgstr ""

#. Occurrence 4_2:117:3367: scene=4_2
#: 4_2:117
msgctxt "text_id=3367 | speaker=unknown"
msgid "　くつくつと温かな湯気をたてる土鍋を<箸|はし>でつつきながら、青子は誰に語るでもなくぼやいている。"
msgstr ""

#. Occurrence 4_2:137:3368: scene=4_2
#: 4_2:137
msgctxt "text_id=3368 | speaker=unknown"
msgid "　今晩の夕食は、洋館にあるまじき和食だった。"
msgstr ""

#. Occurrence 4_2:142:3369: scene=4_2
#: 4_2:142
msgctxt "text_id=3369 | speaker=unknown"
msgid "　こういう日本的、かつ材料を買ってくるだけで済む鍋物はおもに青子の担当である。"
msgstr ""

#. Occurrence 4_2:148:3370: scene=4_2
#: 4_2:148
msgctxt "text_id=3370 | speaker=unknown"
msgid "　有珠は青子の対面で、やはり無言で鍋にフォークを入れていた。"
msgstr ""

#. Occurrence 4_2:200:3371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0001; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:200
msgctxt "text_id=3371 | speaker=aoko"
msgid "「<山城|ヤマシロ>の奴が来るなり『静希くんはまだ部活に入っていないから、面倒みてあげてくれないかな』なんて言ってくるもんだからさ。全校生徒の行動範囲なんて見直す気力無くなっちゃったのよ」"
msgstr ""

#. Occurrence 4_2:240:3372: scene=4_2
#: 4_2:240
msgctxt "text_id=3372 | speaker=unknown"
msgid "　取った玉子はまだ乙女のように純白だったので鍋に返す。"
msgstr ""

#. Occurrence 4_2:245:3373: scene=4_2
#: 4_2:245
msgctxt "text_id=3373 | speaker=unknown"
msgid "　仕方なく火の通りの早いしらたきに手を出した。"
msgstr ""

#. Occurrence 4_2:372:3374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0002; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:372
msgctxt "text_id=3374 | speaker=aoko"
msgid "「そりゃあ、あのバカがバイトで忙しいのは知ってるわよ。"
msgstr ""

#. Occurrence 4_2:378:3375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0003; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:378
msgctxt "text_id=3375 | speaker=aoko"
msgid "　だから出来るだけ春先までのんびりしてて、あんなのでも親身になってくれそうな部の部長にあたってみたのに。"
msgstr ""

#. Occurrence 4_2:387:3376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_0; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:387
#. Occurrence 4_2:395:3376: scene=4_2
#: 4_2:395
msgctxt "text_id=3376 | speaker=aoko"
msgid "ありがとうのひとつも無いってのは、ちょっと癪にさわるわよね。"
msgstr ""

#. Occurrence 4_2:438:3377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:438
msgctxt "text_id=3377 | speaker=aoko"
msgid "　ね、聞いてる有珠？」"
msgstr ""

#. Occurrence 4_2:486:3378: scene=4_2
#: 4_2:486
msgctxt "text_id=3378 | speaker=unknown"
msgid "　具を口に含んでいたのか、声を上げずに有珠は首を縦に振った。"
msgstr ""

#. Occurrence 4_2:491:3379: scene=4_2
#: 4_2:491
msgctxt "text_id=3379 | speaker=unknown"
msgid "　興味も意見もまったくないという<表情|かお>だが、話だけは聞いているようだ。"
msgstr ""

#. Occurrence 4_2:496:3380: scene=4_2
#: 4_2:496
msgctxt "text_id=3380 | speaker=unknown"
msgid "　それに満足して青子ははんぺんをかじった。"
msgstr ""

#. Occurrence 4_2:554:3381: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3381 | speaker=aoko"
msgid "「それに私、いい人ー、なんて言われるヤツは信用できないのよ。あろう事か鳶丸までそんなこと口走る始末だし。"
msgstr ""

#. Occurrence 4_2:554:3382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3382 | speaker=aoko"
msgid "　あれはいい人なんじゃなくて、ただぼんやりしてるだけなんだっての。"
msgstr ""

#. Occurrence 4_2:566:3383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0006; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:566
msgctxt "text_id=3383 | speaker=aoko"
msgid "　……大体、あそこまで言われて怒りもしないなんてどうかしてるわ」"
msgstr ""

#. Occurrence 4_2:625:3384: scene=4_2
#: 4_2:625
msgctxt "text_id=3384 | speaker=unknown"
msgid "　今日の生徒会室での一件を思い出す。"
msgstr ""

#. Occurrence 4_2:630:3385: scene=4_2
#: 4_2:630
msgctxt "text_id=3385 | speaker=unknown"
msgid "　草十郎は青子の一方的な言葉に、さして反論もせずそのまま去っていった。"
msgstr ""

#. Occurrence 4_2:635:3386: scene=4_2
#: 4_2:635
msgctxt "text_id=3386 | speaker=unknown"
msgid "　あの取り澄ました顔を思い出すだけで残ったはんぺんを噛まずに飲みこんでしまう青子なのだった。"
msgstr ""

#. Occurrence 4_2:691:3387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0007; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:691
msgctxt "text_id=3387 | speaker=aoko"
msgid "『……ふん。なにが分かってるんだな、よ』"
msgstr ""

#. Occurrence 4_2:697:3388: scene=4_2
#: 4_2:697
msgctxt "text_id=3388 | speaker=unknown"
msgid "　草十郎の一言と、幼年期の終わりに贈られた言葉が重なる。"
msgstr ""

#. Occurrence 4_2:718:3389: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0000; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:718
msgctxt "text_id=3389 | speaker=ritsuka"
msgid "“―――青子ちゃんは分かっているんだね。"
msgstr ""

#. Occurrence 4_2:724:3390: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0001; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:724
msgctxt "text_id=3390 | speaker=ritsuka"
msgid "　それでも自分であり続けられるという事は、とても強い事なんだよ―――”"
msgstr ""

#. Occurrence 4_2:730:3391: scene=4_2
#: 4_2:730
msgctxt "text_id=3391 | speaker=unknown"
msgid "　たぶん、あの言葉は誉めてくれていたのだ。"
msgstr ""

#. Occurrence 4_2:735:3392: scene=4_2
#: 4_2:735
msgctxt "text_id=3392 | speaker=unknown"
msgid "　でも自分にとって残酷な評価だった。"
msgstr ""

#. Occurrence 4_2:740:3393: scene=4_2
#: 4_2:740
msgctxt "text_id=3393 | speaker=unknown"
msgid "　だって、それを告げるあの人の顔は、痛ましいものを見るような顔をしていたのだ。"
msgstr ""

#. Occurrence 4_2:761:3394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0008; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:761
msgctxt "text_id=3394 | speaker=aoko"
msgid "『―――ま。あんな変態の言ってたコトなんて、いまさらどうでもいいけどさ』"
msgstr ""

#. Occurrence 4_2:767:3395: scene=4_2
#: 4_2:767
msgctxt "text_id=3395 | speaker=unknown"
msgid "　それでも、生涯最大の気の迷いであったワケだけど、憧れていた人物にあんな顔をされたのは幼心にショックだった。"
msgstr ""

#. Occurrence 4_2:788:3396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0000; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:788
msgctxt "text_id=3396 | speaker=alice"
msgid "「……ケンカ」"
msgstr ""

#. Occurrence 4_2:829:3397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0009; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:829
msgctxt "text_id=3397 | speaker=aoko"
msgid "「え？」"
msgstr ""

#. Occurrence 4_2:834:3398: scene=4_2
#: 4_2:834
msgctxt "text_id=3398 | speaker=unknown"
msgid "　箸を浮かせたまま物思いに<耽|ふけ>っていた青子に、有珠は唐突にそう言い放った。"
msgstr ""

#. Occurrence 4_2:876:3399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0010; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:876
msgctxt "text_id=3399 | speaker=aoko"
msgid "「ごめん、聞いてなかった。ケンカって、あの喧嘩？」"
msgstr ""

#. Occurrence 4_2:881:3400: scene=4_2
#: 4_2:881
msgctxt "text_id=3400 | speaker=unknown"
msgid "　こくり、と可憐な首が頷く。"
msgstr ""

#. Occurrence 4_2:932:3401: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0001; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:932
msgctxt "text_id=3401 | speaker=alice"
msgid "「貴女の感想だけじゃ状況はよく掴めないけど。"
msgstr ""

#. Occurrence 4_2:944:3402: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0002; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:944
msgctxt "text_id=3402 | speaker=alice"
msgid "　つまり、青子はその人に喧嘩を売りたかったのね」"
msgstr ""

#. Occurrence 4_2:981:3403: scene=4_2
#: 4_2:981
msgctxt "text_id=3403 | speaker=unknown"
msgid "　はむ、と最後のはんぺんに口をつける有珠。"
msgstr ""

#. Occurrence 4_2:986:3404: scene=4_2
#: 4_2:986
msgctxt "text_id=3404 | speaker=unknown"
msgid "　それはあんまりに予想外で、いやに的を射た意見のような。"
msgstr ""

#. Occurrence 4_2:1040:3405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0011; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1040
msgctxt "text_id=3405 | speaker=aoko"
msgid "「な……なんでそうなるのよ!?"
msgstr ""

#. Occurrence 4_2:1047:3406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_0; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1047
msgctxt "text_id=3406 | speaker=aoko"
msgid "　私はあんなのと一秒だって関わりたくないだけだってば！"
msgstr ""

#. Occurrence 4_2:1088:3407: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1088
msgctxt "text_id=3407 | speaker=aoko"
msgid "だいたいそれどころじゃないし！　興味とかまったくないし！"
msgstr ""

#. Occurrence 4_2:1127:3408: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_2; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1127
msgctxt "text_id=3408 | speaker=aoko"
msgid "会話もこれ以上ないってぐらい簡潔に切り上げたし！」"
msgstr ""

#. Occurrence 4_2:1162:3409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0003; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1162
msgctxt "text_id=3409 | speaker=alice"
msgid "「なら、どうして今そんな話をするの？」"
msgstr ""

#. Occurrence 4_2:1201:3410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0013; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1201
msgctxt "text_id=3410 | speaker=aoko"
msgid "「え……それは……その、"
msgstr ""

msgctxt "text_id=3411 | speaker=unknown"
msgid "アンタに今日の調査過程を報せてあげたのよ。それ以外何があるって言うの？」"
msgstr ""

#. Occurrence 4_2:1255:3412: scene=4_2
#: 4_2:1255
msgctxt "text_id=3412 | speaker=unknown"
msgid "　本当に、それ以外に何があるって言うんだろう？"
msgstr ""

#. Occurrence 4_2:1274:3413: scene=4_2
#: 4_2:1274
msgctxt "text_id=3413 | speaker=unknown"
msgid "　自ら墓穴を掘って中に入り、追い打ちとばかりに土を被っている事に青子が気付くのは数時間後、おやすみなさいとベッドに入ってからである。"
msgstr ""

#. Occurrence 4_2:1316:3414: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0004; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1316
msgctxt "text_id=3414 | speaker=alice"
msgid "「いいけど、わたしは別に。"
msgstr ""

#. Occurrence 4_2:1322:3415: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0005; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1322
msgctxt "text_id=3415 | speaker=alice"
msgid "　ただ……青子は、本当にその人が嫌いなの？」"
msgstr ""

#. Occurrence 4_2:1328:3416: scene=4_2
#: 4_2:1328
msgctxt "text_id=3416 | speaker=unknown"
msgid "　何か神聖な作業をするように、黙々とおでんを食べながら有珠は質問する。"
msgstr ""

#. Occurrence 4_2:1382:3417: scene=4_2
#: 4_2:1382
msgctxt "text_id=3417 | speaker=unknown"
msgid "　表情こそいつも通り無関心だが、内面では青子の態度を面白がっている節がある。"
msgstr ""

#. Occurrence 4_2:1387:3418: scene=4_2
#: 4_2:1387
msgctxt "text_id=3418 | speaker=unknown"
msgid "　そんな有珠の思惑にも青子は気付けなかった。"
msgstr ""

#. Occurrence 4_2:1392:3419: scene=4_2
#: 4_2:1392
msgctxt "text_id=3419 | speaker=unknown"
msgid "　いつもなら簡単に気が付くのだが、ちょっとした心の混乱がその余裕を奪っている。"
msgstr ""

#. Occurrence 4_2:1444:3420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0014; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1444
msgctxt "text_id=3420 | speaker=aoko"
msgid "「本当にって……そりゃそうよ。気にくわないって何度も言ってるじゃない」"
msgstr ""

#. Occurrence 4_2:1453:3421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0006; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1453
msgctxt "text_id=3421 | speaker=alice"
msgid "「そ。具体的には？」"
msgstr ""

#. Occurrence 4_2:1462:3422: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0015; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1462
msgctxt "text_id=3422 | speaker=aoko"
msgid "「はあ？　具体的にはって、そんなのに理由なんて……」"
msgstr ""

#. Occurrence 4_2:1498:3423: scene=4_2
#: 4_2:1498
msgctxt "text_id=3423 | speaker=unknown"
msgid "　そこまで口にして、ようやく青子はその矛盾に気が付いた。"
msgstr ""

#. Occurrence 4_2:1525:3424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0016; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1525
msgctxt "text_id=3424 | speaker=aoko"
msgid "『……む……ぬ？』"
msgstr ""

#. Occurrence 4_2:1530:3425: scene=4_2
#: 4_2:1530
msgctxt "text_id=3425 | speaker=unknown"
msgid "　そう、理由なんてこれっぽっちもない。"
msgstr ""

#. Occurrence 4_2:1535:3426: scene=4_2
#: 4_2:1535
msgctxt "text_id=3426 | speaker=unknown"
msgid "　一目見た時からあの田舎者とは相容れないな、と本能が告げただけだ。"
msgstr ""

#. Occurrence 4_2:1540:3427: scene=4_2
#: 4_2:1540
msgctxt "text_id=3427 | speaker=unknown"
msgid "　でも、それは一体どうしてだろう？"
msgstr ""

#. Occurrence 4_2:1545:3428: scene=4_2
#: 4_2:1545
msgctxt "text_id=3428 | speaker=unknown"
msgid "　そもそも理由のない感情、根拠のない決めつけなんてものは、彼女が一番嫌うところだ。"
msgstr ""

#. Occurrence 4_2:1599:3429: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0017; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1599
msgctxt "text_id=3429 | speaker=aoko"
msgid "「う……き、嫌いな物は嫌いなんだから……ちゃんと、どっかに理由があるんだ、と思うけど……」"
msgstr ""

#. Occurrence 4_2:1605:3430: scene=4_2
#: 4_2:1605
msgctxt "text_id=3430 | speaker=unknown"
msgid "　口にすればするほど歯切れが悪くなる。"
msgstr ""

#. Occurrence 4_2:1610:3431: scene=4_2
#: 4_2:1610
msgctxt "text_id=3431 | speaker=unknown"
msgid "　……困ったことに、青子には静希草十郎を嫌がる理由が見当たらなかった。"
msgstr ""

#. Occurrence 4_2:1692:3432: scene=4_2
#: 4_2:1692
msgctxt "text_id=3432 | speaker=unknown"
msgid "　常識がないのは彼の今までの環境が悪いのであって、草十郎自身に非はない。"
msgstr ""

#. Occurrence 4_2:1697:3433: scene=4_2
#: 4_2:1697
msgctxt "text_id=3433 | speaker=unknown"
msgid "　いや、逆になんとか文明社会に順応しようとする姿勢には好感が持てる筈だ。"
msgstr ""

#. Occurrence 4_2:1723:3434: scene=4_2
#: 4_2:1723
msgctxt "text_id=3434 | speaker=unknown"
msgid "　ぼんやりした所も、行動が<緩慢|かんまん>という訳ではない。"
msgstr ""

#. Occurrence 4_2:1728:3435: scene=4_2
#: 4_2:1728
msgctxt "text_id=3435 | speaker=unknown"
msgid "　彼の仕草や言動がワンテンポ遅く見えるのは、彼が自分の言動に注意を払っているからであり、結果、緩やかに見えるだけなのだ。"
msgstr ""

#. Occurrence 4_2:1733:3436: scene=4_2
#: 4_2:1733
msgctxt "text_id=3436 | speaker=unknown"
msgid "　そうやって静希草十郎という人物をあくまで公平に環境と人格に分けて評価すれば、結果は分かりきっている。"
msgstr ""

#. Occurrence 4_2:1738:3437: scene=4_2
#: 4_2:1738
msgctxt "text_id=3437 | speaker=unknown"
msgid "　認めたくないが、みんなの言う通り、嫌味のない『いい人』像がそこにある。"
msgstr ""

#. Occurrence 4_2:1765:3438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0018; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1765
msgctxt "text_id=3438 | speaker=aoko"
msgid "『ちょっと本気かっての……人間的に悪いところ、ホントに微塵もないのかアレ………？』"
msgstr ""

#. Occurrence 4_2:1817:3439: scene=4_2
#: 4_2:1817
msgctxt "text_id=3439 | speaker=unknown"
msgid "　ダメな部分は山ほどあるのでとりあえずそこは保留。"
msgstr ""

#. Occurrence 4_2:1822:3440: scene=4_2
#: 4_2:1822
msgctxt "text_id=3440 | speaker=unknown"
msgid "　今まで忙しなく動いていたおでんをつつく箸は、ここで完全に停止した。"
msgstr ""

#. Occurrence 4_2:1827:3441: scene=4_2
#: 4_2:1827
msgctxt "text_id=3441 | speaker=unknown"
msgid "　なんか、ますますムカつく。"
msgstr ""

#. Occurrence 4_2:1885:3442: scene=4_2
#: 4_2:1885
msgctxt "text_id=3442 | speaker=unknown"
msgid "　理由のない反感に青子はぐるぐる頭を回す。"
msgstr ""

#. Occurrence 4_2:1890:3443: scene=4_2
#: 4_2:1890
msgctxt "text_id=3443 | speaker=unknown"
msgid "　それはまずい、自分的にそんなのは許容できない、と必死に静希草十郎を分析するのだが、ますます自分を追いつめるだけだった。"
msgstr ""

#. Occurrence 4_2:1935:3444: scene=4_2
#: 4_2:1935
msgctxt "text_id=3444 | speaker=unknown"
msgid "　そんな袋小路に<陥|おちい>った青子を、有珠はまじまじと眺める。"
msgstr ""

#. Occurrence 4_2:1946:3445: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0007; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1946
msgctxt "text_id=3445 | speaker=alice"
msgid "「……あきれた」"
msgstr ""

#. Occurrence 4_2:1951:3446: scene=4_2
#: 4_2:1951
msgctxt "text_id=3446 | speaker=unknown"
msgid "　小さな嘆息。"
msgstr ""

#. Occurrence 4_2:2020:3447: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0008; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:2020
msgctxt "text_id=3447 | speaker=alice"
msgid "「らしくないわね、青子」"
msgstr ""

#. Occurrence 4_2:2029:3448: scene=4_2
#: 4_2:2029
msgctxt "text_id=3448 | speaker=unknown"
msgid "　その一言は、青子にとってまさにとどめだった。"
msgstr ""

#. Occurrence 4_2:2034:3449: scene=4_2
#: 4_2:2034
msgctxt "text_id=3449 | speaker=unknown"
msgid "　自分の理解不能ぶりに目眩がする。"
msgstr ""

#. Occurrence 4_2:2066:3450: scene=4_2
#: 4_2:2066
msgctxt "text_id=3450 | speaker=unknown"
msgid "　ご馳走さまと有珠が居間に立ち去った後、しばらく椅子から立てなかった程に。"
msgstr ""

#. Occurrence 4_3:72:3451: scene=4_3
#: 4_3:72
msgctxt "text_id=3451 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 4_3:77:3452: scene=4_3
#: 4_3:77
msgctxt "text_id=3452 | speaker=unknown"
msgid "　とどめを刺されたからといって、いつまでも伏せっている蒼崎青子ではなかった。"
msgstr ""

#. Occurrence 4_3:82:3453: scene=4_3
#: 4_3:82
msgctxt "text_id=3453 | speaker=unknown"
msgid "　早々に夕食の片付けを済ませ、はじめのお風呂を有珠に譲って居間を後にする。"
msgstr ""

#. Occurrence 4_3:87:3454: scene=4_3
#: 4_3:87
msgctxt "text_id=3454 | speaker=unknown"
msgid "　洋館では人のいない場所に電灯はつけない決まりなので、明かりがついているのは居間と彼女たちの部屋ぐらいだ。"
msgstr ""

#. Occurrence 4_3:109:3455: scene=4_3
#: 4_3:109
msgctxt "text_id=3455 | speaker=unknown"
msgid "　二階は暗闇に包まれている。"
msgstr ""

#. Occurrence 4_3:114:3456: scene=4_3
#: 4_3:114
msgctxt "text_id=3456 | speaker=unknown"
msgid "　長い、月明かりだけが頼りの廊下をスタスタと移動して、青子は二階東側の最奥にある自室に辿り着いた。"
msgstr ""

#. Occurrence 4_3:163:3457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0000; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:163
msgctxt "text_id=3457 | speaker=aoko"
msgid "「―――結論として。"
msgstr ""

#. Occurrence 4_3:169:3458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0001; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:169
msgctxt "text_id=3458 | speaker=aoko"
msgid "　やっぱり、<騙|だま>し<討|う>ちは気にくわない」"
msgstr ""

#. Occurrence 4_3:193:3459: scene=4_3
#: 4_3:193
msgctxt "text_id=3459 | speaker=unknown"
msgid "　廊下を歩きながら、いや、居間からずっと考えていたのか。"
msgstr ""

#. Occurrence 4_3:198:3460: scene=4_3
#: 4_3:198
msgctxt "text_id=3460 | speaker=unknown"
msgid "　部屋に入るなり、青子はきっぱりと断言した。"
msgstr ""

#. Occurrence 4_3:219:3461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0002; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:219
msgctxt "text_id=3461 | speaker=aoko"
msgid "「やるにしても隠れるのはなし。正面から堂々と、向かいあって理由を言う」"
msgstr ""

#. Occurrence 4_3:225:3462: scene=4_3
#: 4_3:225
msgctxt "text_id=3462 | speaker=unknown"
msgid "　情けにかられての精一杯の譲歩、ではない。"
msgstr ""

#. Occurrence 4_3:230:3463: scene=4_3
#: 4_3:230
msgctxt "text_id=3463 | speaker=unknown"
msgid "　単に、彼女にとってそういうあり方が<当然|スタンダード>というだけだ。"
msgstr ""

#. Occurrence 4_3:251:3464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0003; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:251
msgctxt "text_id=3464 | speaker=aoko"
msgid "「よし、そうと決まれば―――」"
msgstr ""

#. Occurrence 4_3:275:3465: scene=4_3
#: 4_3:275
msgctxt "text_id=3465 | speaker=unknown"
msgid "　自分の意志を確認して、隣室の書斎に向かう。"
msgstr ""

#. Occurrence 4_3:339:3466: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0004; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:339
msgctxt "text_id=3466 | speaker=aoko"
msgid "「えーと、木曜棚の冬至覧、緑の背表紙、と……」"
msgstr ""

#. Occurrence 4_3:345:3467: scene=4_3
#: 4_3:345
msgctxt "text_id=3467 | speaker=unknown"
msgid "　無数の本の中から迷わず一冊を抜き取る。"
msgstr ""

#. Occurrence 4_3:351:3468: scene=4_3
#: 4_3:351
msgctxt "text_id=3468 | speaker=unknown"
msgid "　蒼崎の家から運びこんだ入門書は、月曜から土曜と六つの<棚|カテゴリ>に振り分けられていた。"
msgstr ""

#. Occurrence 4_3:402:3469: scene=4_3
#: 4_3:402
msgctxt "text_id=3469 | speaker=unknown"
msgid "　青子は蔵書を項目、分類、用途に分けておおまかに記憶している。"
msgstr ""

#. Occurrence 4_3:407:3470: scene=4_3
#: 4_3:407
msgctxt "text_id=3470 | speaker=unknown"
msgid "　必要な知識、資料の検索には時間はとらない。"
msgstr ""

#. Occurrence 4_3:412:3471: scene=4_3
#: 4_3:412
msgctxt "text_id=3471 | speaker=unknown"
msgid "　書斎の主として最低限の務めである。"
msgstr ""

#. Occurrence 4_3:432:3472: scene=4_3
#: 4_3:432
msgctxt "text_id=3472 | speaker=unknown"
msgid "　……などと偉ぶっても、所詮はちっぽけな書斎の管理のみ。"
msgstr ""

#. Occurrence 4_3:437:3473: scene=4_3
#: 4_3:437
msgctxt "text_id=3473 | speaker=unknown"
msgid "　別館にある図書室は青子も有珠もお手上げの魔窟だ。"
msgstr ""

#. Occurrence 4_3:442:3474: scene=4_3
#: 4_3:442
msgctxt "text_id=3474 | speaker=unknown"
msgid "　もしこの書斎だけで用が足りないのなら、有珠に声をかけて別館に<赴|おもむ>くしかない。"
msgstr ""

#. Occurrence 4_3:488:3475: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0005; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:488
msgctxt "text_id=3475 | speaker=aoko"
msgid "「……できればそれは避けたいところだけど、っと」"
msgstr ""

#. Occurrence 4_3:509:3476: scene=4_3
#: 4_3:509
msgctxt "text_id=3476 | speaker=unknown"
msgid "　緑色の、分厚い装丁の本を机に置いて、椅子に座る。"
msgstr ""

#. Occurrence 4_3:516:3477: scene=4_3
#: 4_3:516
msgctxt "text_id=3477 | speaker=unknown"
msgid "　頑丈で硬質で温かみのない机。"
msgstr ""

#. Occurrence 4_3:521:3478: scene=4_3
#: 4_3:521
msgctxt "text_id=3478 | speaker=unknown"
msgid "　まだ年若い少女が愛用する物ではないが、青子はこの洗練されすぎて骨しかないような豪華さが好きだった。"
msgstr ""

#. Occurrence 4_3:527:3479: scene=4_3
#: 4_3:527
msgctxt "text_id=3479 | speaker=unknown"
msgid "　古びた本のページが、その机の上ではらりとめくられる。"
msgstr ""

#. Occurrence 4_3:560:3480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0006; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:560
msgctxt "text_id=3480 | speaker=aoko"
msgid "『……有珠みたいな結界は私にはまだ無理だ。"
msgstr ""

#. Occurrence 4_3:567:3481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0007; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:567
msgctxt "text_id=3481 | speaker=aoko"
msgid "人払いはその場所自体に頼らないといけないか……』"
msgstr ""

#. Occurrence 4_3:573:3482: scene=4_3
#: 4_3:573
msgctxt "text_id=3482 | speaker=unknown"
msgid "　たとえば山奥。"
msgstr ""

#. Occurrence 4_3:578:3483: scene=4_3
#: 4_3:578
msgctxt "text_id=3483 | speaker=unknown"
msgid "　たとえば林中。"
msgstr ""

#. Occurrence 4_3:583:3484: scene=4_3
#: 4_3:583
msgctxt "text_id=3484 | speaker=unknown"
msgid "　たとえば、生徒のいない深夜の校舎。"
msgstr ""

#. Occurrence 4_3:588:3485: scene=4_3
#: 4_3:588
msgctxt "text_id=3485 | speaker=unknown"
msgid "　場所自体に魔術をかけなくても、よっぽど運が悪くないかぎり誰もやってこない場所が望ましい。"
msgstr ""

#. Occurrence 4_3:615:3486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0008; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:615
msgctxt "text_id=3486 | speaker=aoko"
msgid "『茨の壁だの魔力の霧だの、そういう回りくどいのもナンだしなあ……退路を断つ、っていうなら、もっとこう、見た目にも状況的にも派手な方が効果的だし』"
msgstr ""

#. Occurrence 4_3:627:3487: scene=4_3
#: 4_3:627
msgctxt "text_id=3487 | speaker=unknown"
msgid "　ぶつぶつと自分好みの、初歩的な術式はないものかとページをめくる青子。"
msgstr ""

#. Occurrence 4_3:632:3488: scene=4_3
#: 4_3:632
msgctxt "text_id=3488 | speaker=unknown"
msgid "　言うまでもなく、彼女が探しているのは昨夜の目撃者を始末する方法だ。"
msgstr ""

#. Occurrence 4_3:667:3489: scene=4_3
#: 4_3:667
msgctxt "text_id=3489 | speaker=unknown"
msgid "　魔術は万能ではあるが有限である。"
msgstr ""

#. Occurrence 4_3:683:3490: scene=4_3
#: 4_3:683
msgctxt "text_id=3490 | speaker=unknown"
msgid "　基本的に、<地上|ここ>にある物、<現実|ここ>で起きる事を、実現時間や必要経費を多少無視して発現させるだけのものだ。"
msgstr ""

#. Occurrence 4_3:688:3491: scene=4_3
#: 4_3:688
msgctxt "text_id=3491 | speaker=unknown"
msgid "　この<宇宙|せかい>で起きえない現象は、魔術では発現できない。"
msgstr ""

#. Occurrence 4_3:693:3492: scene=4_3
#: 4_3:693
msgctxt "text_id=3492 | speaker=unknown"
msgid "　要はショートカットを使いまくった等価交換だ。"
msgstr ""

#. Occurrence 4_3:713:3493: scene=4_3
#: 4_3:713
msgctxt "text_id=3493 | speaker=unknown"
msgid "　人の手で可能となる現象を、個人の力で実行する―――"
msgstr ""

#. Occurrence 4_3:713:3494: scene=4_3
#: 4_3:713
msgctxt "text_id=3494 | speaker=unknown"
msgid "　それが一般的な魔術のあり方である。"
msgstr ""

#. Occurrence 4_3:718:3495: scene=4_3
#: 4_3:718
msgctxt "text_id=3495 | speaker=unknown"
msgid "　単純な話、その気になれば巨大な湖をこの洋館に持ってくる事もできる。"
msgstr ""

#. Occurrence 4_3:723:3496: scene=4_3
#: 4_3:723
msgctxt "text_id=3496 | speaker=unknown"
msgid "　けれど、<こ|・><の|・><世|・><に|・><な|・><い|・><も|・><の|・>を持ってくるコトは、たとえ小指の先ほどであろうと許されない。"
msgstr ""

#. Occurrence 4_3:755:3497: scene=4_3
#: 4_3:755
msgctxt "text_id=3497 | speaker=unknown"
msgid "　例えば、青子単体で<戦闘機|Ｆ－１５>のアフターバーナー並みの熱量を放出できたとしても、それは魔術式によって蒼崎青子という回路が一時的に入力の変数になっただけだ。"
msgstr ""

#. Occurrence 4_3:775:3498: scene=4_3
#: 4_3:775
msgctxt "text_id=3498 | speaker=unknown"
msgid "　導き出されるイコールそのものは、現実に起こりえる数値となる。"
msgstr ""

#. Occurrence 4_3:780:3499: scene=4_3
#: 4_3:780
msgctxt "text_id=3499 | speaker=unknown"
msgid "　だが、そのイコールそのものが現実にないモノである場合、術式は成り立たない。"
msgstr ""

#. Occurrence 4_3:814:3500: scene=4_3
#: 4_3:814
msgctxt "text_id=3500 | speaker=unknown"
msgid "　魔力という架空要素は、発火の瞬間だけ秩序の網をくぐり抜ける嘘のようなもの。"
msgstr ""

#. Occurrence 4_3:830:3501: scene=4_3
#: 4_3:830
msgctxt "text_id=3501 | speaker=unknown"
msgid "　この世にないものをカタチにする事―――幻想が現実を侵す事を、この宇宙は容認しない。"
msgstr ""

#. Occurrence 4_3:878:3502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0009; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:878
msgctxt "text_id=3502 | speaker=aoko"
msgid "『……とは言っても<架|エ><空|ー><要|テ><素|ル>は基本なんにでも<付属|で>きるんで、<大本|おおもと>がウソ、なんだっけ。"
msgstr ""

#. Occurrence 4_3:884:3503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0010; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:884
msgctxt "text_id=3503 | speaker=aoko"
msgid "　魔力だけで構成されたものは幻想扱いされて急速に消えていくとか……典型的な結界、茨の壁とかはもともと茨を生やしておいて、魔力で一気に成長・強化してるものだし。"
msgstr ""

#. Occurrence 4_3:890:3504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0011; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:890
msgctxt "text_id=3504 | speaker=aoko"
msgid "　魔力っていうのは結局、使い勝手のいいガソリン、兼、事象に火をつける火花ってワケで―――』"
msgstr ""

#. Occurrence 4_3:916:3505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0012; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:916
msgctxt "text_id=3505 | speaker=aoko"
msgid "「―――なんて言いつつ。"
msgstr ""

#. Occurrence 4_3:922:3506: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0013; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:922
msgctxt "text_id=3506 | speaker=aoko"
msgid "　架空要素<云々|うんぬん>より、基本的な回路の接続と、魔力を加工して弾く事ぐらいしかできないのよね、私」"
msgstr ""

#. Occurrence 4_3:948:3507: scene=4_3
#: 4_3:948
msgctxt "text_id=3507 | speaker=unknown"
msgid "　あはは、と笑って<現|い><状|ま>の自分に作れる結界は何か、と検索する。"
msgstr ""

#. Occurrence 4_3:953:3508: scene=4_3
#: 4_3:953
msgctxt "text_id=3508 | speaker=unknown"
msgid "　目撃者の素性は不明だが、相手が同じ高校の生徒なら呼び出す口実はいくらでもある。"
msgstr ""

#. Occurrence 4_3:958:3509: scene=4_3
#: 4_3:958
msgctxt "text_id=3509 | speaker=unknown"
msgid "　問題は呼び出した後だろう。"
msgstr ""

#. Occurrence 4_3:985:3510: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0014; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:985
msgctxt "text_id=3510 | speaker=aoko"
msgid "『そうなると、問題は命中率よね……。一撃で決めないと逃げられちゃうだろうし』"
msgstr ""

#. Occurrence 4_3:991:3511: scene=4_3
#: 4_3:991
msgctxt "text_id=3511 | speaker=unknown"
msgid "　正直、有珠のサポートなしで上手くやれる自信はない。"
msgstr ""

#. Occurrence 4_3:996:3512: scene=4_3
#: 4_3:996
msgctxt "text_id=3512 | speaker=unknown"
msgid "　けれど相手が一般人なら自分だけで十分、と青子は助力を一切拒否したのだ。"
msgstr ""

#. Occurrence 4_3:1001:3513: scene=4_3
#: 4_3:1001
msgctxt "text_id=3513 | speaker=unknown"
msgid "　半人前ではあるが、青子にも魔術師としてのプライドがある。"
msgstr ""

#. Occurrence 4_3:1058:3514: scene=4_3
#: 4_3:1058
msgctxt "text_id=3514 | speaker=unknown"
msgid "　ページはリズムよくめくられていく。"
msgstr ""

#. Occurrence 4_3:1063:3515: scene=4_3
#: 4_3:1063
msgctxt "text_id=3515 | speaker=unknown"
msgid "　パラパラと小さな音をたてる中、青子の指がぴたりとあるページで止まった。"
msgstr ""

#. Occurrence 4_3:1102:3516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0015; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1102
msgctxt "text_id=3516 | speaker=aoko"
msgid "「見付けた」"
msgstr ""

#. Occurrence 4_3:1108:3517: scene=4_3
#: 4_3:1108
msgctxt "text_id=3517 | speaker=unknown"
msgid "　小さな微笑。"
msgstr ""

#. Occurrence 4_3:1113:3518: scene=4_3
#: 4_3:1113
msgctxt "text_id=3518 | speaker=unknown"
msgid "　それは記憶の片隅にあった、ただ壊すだけの単純な魔術式。"
msgstr ""

#. Occurrence 4_3:1134:3519: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0016; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1134
msgctxt "text_id=3519 | speaker=aoko"
msgid "『……檻をね、作ればいいのよ。"
msgstr ""

#. Occurrence 4_3:1140:3520: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0017; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1140
msgctxt "text_id=3520 | speaker=aoko"
msgid "　狩りをする時の常套手段じゃない。獲物を逃げられないようにするのは』"
msgstr ""

#. Occurrence 4_3:1171:3521: scene=4_3
#: 4_3:1171
msgctxt "text_id=3521 | speaker=unknown"
msgid "　ページに栞を挟んで、部屋に持ち帰ろうと立ち上がる。"
msgstr ""

#. Occurrence 4_3:1206:3522: scene=4_3
#: 4_3:1206
msgctxt "text_id=3522 | speaker=unknown"
msgid "　ふいに視線を感じた。"
msgstr ""

#. Occurrence 4_3:1254:3523: scene=4_3
#: 4_3:1254
msgctxt "text_id=3523 | speaker=unknown"
msgid "　夜を<透|とお>す窓に、冷めきった目の少女が映っている。"
msgstr ""

#. Occurrence 4_3:1259:3524: scene=4_3
#: 4_3:1259
msgctxt "text_id=3524 | speaker=unknown"
msgid "　それが今の自分の<表情|かお>である事を、青子は冷静に受けとめる。"
msgstr ""

#. Occurrence 4_3:1280:3525: scene=4_3
#: 4_3:1280
msgctxt "text_id=3525 | speaker=unknown"
msgid "　―――目撃者を消す計画を立て始めた。"
msgstr ""

#. Occurrence 4_3:1286:3526: scene=4_3
#: 4_3:1286
msgctxt "text_id=3526 | speaker=unknown"
msgid "　いや、計画なんて複雑なものではない。"
msgstr ""

#. Occurrence 4_3:1291:3527: scene=4_3
#: 4_3:1291
msgctxt "text_id=3527 | speaker=unknown"
msgid "　これはただの作業。"
msgstr ""

#. Occurrence 4_3:1296:3528: scene=4_3
#: 4_3:1296
msgctxt "text_id=3528 | speaker=unknown"
msgid "　事前に檻を作っておき、そこに獲物を誘うだけの話。"
msgstr ""

#. Occurrence 4_3:1301:3529: scene=4_3
#: 4_3:1301
msgctxt "text_id=3529 | speaker=unknown"
msgid "　まったくもって、何の言い逃れもできない暴力だ。"
msgstr ""

#. Occurrence 4_3:1375:3530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0018; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1375
msgctxt "text_id=3530 | speaker=aoko"
msgid "「さ、そろそろ有珠は上がったかな」"
msgstr ""

#. Occurrence 4_3:1381:3531: scene=4_3
#: 4_3:1381
msgctxt "text_id=3531 | speaker=unknown"
msgid "　青子は冷めた心に熱を戻すように、どうでもいい独り言を口にした。"
msgstr ""

#. Occurrence 4_3:1465:3532: scene=4_3
#: 4_3:1465
msgctxt "text_id=3532 | speaker=unknown"
msgid "　有珠にはじめの入浴を譲ってから二十分近く経つ。"
msgstr ""

#. Occurrence 4_3:1470:3533: scene=4_3
#: 4_3:1470
msgctxt "text_id=3533 | speaker=unknown"
msgid "　彼女のお風呂はカラスの行水よろしく、十分もあれば終わっている。"
msgstr ""

#. Occurrence 4_3:1475:3534: scene=4_3
#: 4_3:1475
msgctxt "text_id=3534 | speaker=unknown"
msgid "　有珠はお風呂の情緒を理解できないタイプで、風呂はあくまで体のメンテナンスをするものと捉えている。"
msgstr ""

#. Occurrence 4_3:1480:3535: scene=4_3
#: 4_3:1480
msgctxt "text_id=3535 | speaker=unknown"
msgid "　温泉宿のすばらしさも有珠にとっては“なんか面倒なところ”にすぎず、そのあたりには本気で同情する青子だった。"
msgstr ""

#. Occurrence 4_3:1530:3536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0019; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1530
msgctxt "text_id=3536 | speaker=aoko"
msgid "「よし、浴場はカラ、と……あれ？　居間に電気ついてる？」"
msgstr ""

#. Occurrence 4_3:1536:3537: scene=4_3
#: 4_3:1536
msgctxt "text_id=3537 | speaker=unknown"
msgid "　入浴を済ませた後、有珠が居間にいるのは珍しい。"
msgstr ""

#. Occurrence 4_3:1541:3538: scene=4_3
#: 4_3:1541
msgctxt "text_id=3538 | speaker=unknown"
msgid "　話し合いのない夜は、さっさと自室に戻るのが彼女のスタイルなのだが。"
msgstr ""

#. Occurrence 4_3:1593:3539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0020; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1593
msgctxt "text_id=3539 | speaker=aoko"
msgid "「有珠、いるの？」"
msgstr ""

#. Occurrence 4_3:1603:3540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0000; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1603
msgctxt "text_id=3540 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 4_3:1608:3541: scene=4_3
#: 4_3:1608
msgctxt "text_id=3541 | speaker=unknown"
msgid "　こくり、と頷く有珠。"
msgstr ""

#. Occurrence 4_3:1613:3542: scene=4_3
#: 4_3:1613
msgctxt "text_id=3542 | speaker=unknown"
msgid "　読書中でもなく、彼女は青子を待っていたようだ。"
msgstr ""

#. Occurrence 4_3:1647:3543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0021; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1647
msgctxt "text_id=3543 | speaker=aoko"
msgid "『……そういうコト。私も信用ないな、ほんと』"
msgstr ""

#. Occurrence 4_3:1653:3544: scene=4_3
#: 4_3:1653
msgctxt "text_id=3544 | speaker=unknown"
msgid "　はあ、と頭を掻く青子。"
msgstr ""

#. Occurrence 4_3:1658:3545: scene=4_3
#: 4_3:1658
msgctxt "text_id=3545 | speaker=unknown"
msgid "　信用されていないのか、心配されているのか。"
msgstr ""

#. Occurrence 4_3:1663:3546: scene=4_3
#: 4_3:1663
msgctxt "text_id=3546 | speaker=unknown"
msgid "　久遠寺有珠の表情は静かすぎて、いまいち真意が読み取れない。"
msgstr ""

#. Occurrence 4_3:1689:3547: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0022; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1689
msgctxt "text_id=3547 | speaker=aoko"
msgid "「方針なら決まったけど。聞く？」"
msgstr ""

#. Occurrence 4_3:1709:3548: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0001; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1709
msgctxt "text_id=3548 | speaker=alice"
msgid "「……その顔を見れば聞かなくても分かるわ。"
msgstr ""

#. Occurrence 4_3:1720:3549: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0002; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1720
msgctxt "text_id=3549 | speaker=alice"
msgid "　迷いがなくなったのはいい事だけど。……悪い癖ね、青子」"
msgstr ""

#. Occurrence 4_3:1726:3550: scene=4_3
#: 4_3:1726
msgctxt "text_id=3550 | speaker=unknown"
msgid "　小さなため息。"
msgstr ""

#. Occurrence 4_3:1731:3551: scene=4_3
#: 4_3:1731
msgctxt "text_id=3551 | speaker=unknown"
msgid "　この黒衣の少女がこれみよがしに<落胆|らくたん>を表すのは珍しい。"
msgstr ""

#. Occurrence 4_3:1766:3552: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0023; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1766
msgctxt "text_id=3552 | speaker=aoko"
msgid "「ええ。騙し討ちは趣味じゃないから。殺すにしても正々堂々、正面から理由を言った後にする。"
msgstr ""

#. Occurrence 4_3:1772:3553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0024; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1772
msgctxt "text_id=3553 | speaker=aoko"
msgid "　それならすっぱり後腐れもないし。文句ある？」"
msgstr ""

#. Occurrence 4_3:1790:3554: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0003; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1790
msgctxt "text_id=3554 | speaker=alice"
msgid "「文句はないわ。そういうの、好きか嫌いかはこの<際|さい>関係ないでしょうし。"
msgstr ""

#. Occurrence 4_3:1801:3555: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0004; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1801
msgctxt "text_id=3555 | speaker=alice"
msgid "　けど―――」"
msgstr ""

#. Occurrence 4_3:1840:3556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0025; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1840
msgctxt "text_id=3556 | speaker=aoko"
msgid "「確実性はどうかってコトでしょ。私、いまいち命中率悪いし。そのへんの問題は場所選びでフォローしようかなと。"
msgstr ""

#. Occurrence 4_3:1852:3557: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0026; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1852
msgctxt "text_id=3557 | speaker=aoko"
msgid "　私は有珠のようにはいかないから、物理的に逃げられない場所にしようと思うんだけど……なにかアイデアない？」"
msgstr ""

#. Occurrence 4_3:1891:3558: scene=4_3
#: 4_3:1891
msgctxt "text_id=3558 | speaker=unknown"
msgid "　青子からの相談に、そうね、と一考する有珠。"
msgstr ""

#. Occurrence 4_3:1896:3559: scene=4_3
#: 4_3:1896
msgctxt "text_id=3559 | speaker=unknown"
msgid "　そっと唇にあてた指が、彼女好みの質問だったコトを示している。"
msgstr ""

#. Occurrence 4_3:1922:3560: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0005; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1922
msgctxt "text_id=3560 | speaker=alice"
msgid "「鏡はどう？　鏡の国なら永遠に閉じこめていられるけど」"
msgstr ""

#. Occurrence 4_3:1940:3561: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0027; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1940
msgctxt "text_id=3561 | speaker=aoko"
msgid "「……アンタ、そういうところ常識ないわよね」"
msgstr ""

#. Occurrence 4_3:1950:3562: scene=4_3
#: 4_3:1950
msgctxt "text_id=3562 | speaker=unknown"
msgid "　というか悪趣味、と青子は顔をしかめる。"
msgstr ""

#. Occurrence 4_3:1984:3563: scene=4_3
#: 4_3:1984
msgctxt "text_id=3563 | speaker=unknown"
msgid "　同居人なりのクリティカルなアイデアだったのだろうが、とても参考にならない。"
msgstr ""

#. Occurrence 4_3:2004:3564: scene=4_3
#: 4_3:2004
msgctxt "text_id=3564 | speaker=unknown"
msgid "　青子は自分に用意できる結界を知りたいのであって、魔法スレスレの大結界など望んでいないし、用意もできないのだ。"
msgstr ""

#. Occurrence 4_3:2030:3565: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0006; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2030
msgctxt "text_id=3565 | speaker=alice"
msgid "「なら他をあたるのね。……でも、ここを使うのだけはやめてちょうだい」"
msgstr ""

#. Occurrence 4_3:2050:3566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0028; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2050
msgctxt "text_id=3566 | speaker=aoko"
msgid "「言われなくても分かってるって。"
msgstr ""

#. Occurrence 4_3:2062:3567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0029; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2062
msgctxt "text_id=3567 | speaker=aoko"
msgid "　あ―――けど、そうね。"
msgstr ""

#. Occurrence 4_3:2068:3568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0030; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2068
msgctxt "text_id=3568 | speaker=aoko"
msgid "　ミラーハウスはいいアイデアかも」"
msgstr ""

#. Occurrence 4_3:2096:3569: scene=4_3
#: 4_3:2096
msgctxt "text_id=3569 | speaker=unknown"
msgid "　ニヤリと微笑って、青子は壁に寄りかかっていた体を起こした。"
msgstr ""

#. Occurrence 4_3:2132:3570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0031; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2132
msgctxt "text_id=3570 | speaker=aoko"
msgid "「サンキュ、有珠。全体の流れはできあがったわ。"
msgstr ""

#. Occurrence 4_3:2139:3571: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0032; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2139
msgctxt "text_id=3571 | speaker=aoko"
msgid "ほんと、こういうのってダメもとでも相談してみるものよね」"
msgstr ""

#. Occurrence 4_3:2167:3572: scene=4_3
#: 4_3:2167
msgctxt "text_id=3572 | speaker=unknown"
msgid "　ご機嫌な様子で立ち去る青子。"
msgstr ""

#. Occurrence 4_3:2172:3573: scene=4_3
#: 4_3:2172
msgctxt "text_id=3573 | speaker=unknown"
msgid "　どんな青写真ができたのか有珠には見当もつかないが、彼女なりに万全の策ができたらしい。"
msgstr ""

#. Occurrence 4_3:2203:3574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0007; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2203
msgctxt "text_id=3574 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 4_3:2209:3575: scene=4_3
#: 4_3:2209
msgctxt "text_id=3575 | speaker=unknown"
msgid "　鼻歌まじりに浴場に向かう同居人。"
msgstr ""

#. Occurrence 4_3:2214:3576: scene=4_3
#: 4_3:2214
msgctxt "text_id=3576 | speaker=unknown"
msgid "　ここ一年半の経験か。"
msgstr ""

#. Occurrence 4_3:2219:3577: scene=4_3
#: 4_3:2219
msgctxt "text_id=3577 | speaker=unknown"
msgid "　黒衣の少女は、蒼崎青子は有頂天になった時こそ信じられないトラブルに見舞われる事を知っていた。"
msgstr ""

#. Occurrence 4_3:2274:3578: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0008; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2274
msgctxt "text_id=3578 | speaker=alice"
msgid "「え？　……青子ひとりに<任|まか>せていいのか、ですって？」"
msgstr ""

#. Occurrence 4_3:2287:3579: scene=4_3
#: 4_3:2287
msgctxt "text_id=3579 | speaker=unknown"
msgid "　いつから居間にいたのか。"
msgstr ""

#. Occurrence 4_3:2293:3580: scene=4_3
#: 4_3:2293
msgctxt "text_id=3580 | speaker=unknown"
msgid "　コマドリ……のような鳥が、チチチ、と鳴き声をあげながら調度品の上を<闊歩|かっぽ>する。"
msgstr ""

#. Occurrence 4_3:2319:3581: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0009; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2319
msgctxt "text_id=3581 | speaker=alice"
msgid "「……そうね。彼女がひとりでやると言ったのだから、任せるのが正しい信頼関係なんでしょうけど―――」"
msgstr ""

#. Occurrence 4_3:2325:3582: scene=4_3
#: 4_3:2325
msgctxt "text_id=3582 | speaker=unknown"
msgid "　黒衣の少女の腕があがる。"
msgstr ""

#. Occurrence 4_3:2380:3583: scene=4_3
#: 4_3:2380
msgctxt "text_id=3583 | speaker=unknown"
msgid "　口づけを許すように差し出された指先に、チチチ、と鳴き声が舞い降りる。"
msgstr ""

#. Occurrence 4_3:2387:3584: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0010; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2387
msgctxt "text_id=3584 | speaker=alice"
msgid "「……嫌な話だけど。"
msgstr ""

#. Occurrence 4_3:2394:3585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0011; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2394
msgctxt "text_id=3585 | speaker=alice"
msgid "信頼と信用は、また違う話よね」"
msgstr ""

#. Occurrence 4_3:2401:3586: scene=4_3
#: 4_3:2401
msgctxt "text_id=3586 | speaker=unknown"
msgid "　<言|こえ>なき鳥が、そのでっぷりとした胸を張って同意する。"
msgstr ""

#. Occurrence 4_3:2406:3587: scene=4_3
#: 4_3:2406
msgctxt "text_id=3587 | speaker=unknown"
msgid "　わりかし物騒な同居人の<囁|ささや>きを、もちろん、青子は知るよしもないのだった。"
msgstr ""

#. Occurrence 4_4:97:3588: scene=4_4
#: 4_4:97
msgctxt "text_id=3588 | speaker=unknown"
msgid "　翌日。空は相変わらずの曇り模様。"
msgstr ""

#. Occurrence 4_4:119:3589: scene=4_4
#: 4_4:119
msgctxt "text_id=3589 | speaker=unknown"
msgid "　一日の授業は何事もなく終わった。"
msgstr ""

#. Occurrence 4_4:124:3590: scene=4_4
#: 4_4:124
msgctxt "text_id=3590 | speaker=unknown"
msgid "　冬休み前の期末試験まであとわずか。"
msgstr ""

#. Occurrence 4_4:129:3591: scene=4_4
#: 4_4:129
msgctxt "text_id=3591 | speaker=unknown"
msgid "　今では厳しい規律に支配された<三咲高|ミサコー>であるが、もともとは生徒の自主性を第一とするおおらかな私立高校である。"
msgstr ""

#. Occurrence 4_4:149:3592: scene=4_4
#: 4_4:149
msgctxt "text_id=3592 | speaker=unknown"
msgid "　真面目な生徒は生徒会長の<庇|ひ><護|ご>の下とことん真面目に。"
msgstr ""

#. Occurrence 4_4:154:3593: scene=4_4
#: 4_4:154
msgctxt "text_id=3593 | speaker=unknown"
msgid "　気楽な生徒は、まあ個人の責任のかぎり、とことん自由に放課後を過ごしているのだった。"
msgstr ""

#. Occurrence 4_4:174:3594: scene=4_4
#: 4_4:174
msgctxt "text_id=3594 | speaker=unknown"
msgid "　そして、その自由な生徒の代表みたいな男が生徒会の副会長にいるあたり、この学校の懐の深さはちょっとおかしい。"
msgstr ""

#. Occurrence 4_4:225:3595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0000; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:225
msgctxt "text_id=3595 | speaker=tobimaru"
msgid "「蒼崎、いるかー！」"
msgstr ""

#. Occurrence 4_4:254:3596: scene=4_4
#: 4_4:254
msgctxt "text_id=3596 | speaker=unknown"
msgid "　おもに密会用と噂される第二生徒会室の扉を、<槻司|つきじ><鳶丸|とびまる>は陽気にブチ開けた。"
msgstr ""

#. Occurrence 4_4:259:3597: scene=4_4
#: 4_4:259
msgctxt "text_id=3597 | speaker=unknown"
msgid "　これでも副会長さまであり、生徒会の<陰|かげ>の雑務係と哀れまれる人物である。"
msgstr ""

#. Occurrence 4_4:294:3598: scene=4_4
#: 4_4:294
msgctxt "text_id=3598 | speaker=unknown"
msgid "　狭苦しい室内には待ち人がひとり。"
msgstr ""

#. Occurrence 4_4:299:3599: scene=4_4
#: 4_4:299
msgctxt "text_id=3599 | speaker=unknown"
msgid "　生徒会長・蒼崎青子は姿勢良くパイプ椅子に座って、大声を上げた鳶丸をじろりと睨んでいる。"
msgstr ""

#. Occurrence 4_4:344:3600: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3600 | speaker=tobimaru"
msgid "「あいかわらず寒いなこの部屋。"
msgstr ""

#. Occurrence 4_4:344:3601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3601 | speaker=tobimaru"
msgid "　なあ、今度ストーブ購入しようぜ」"
msgstr ""

#. Occurrence 4_4:350:3602: scene=4_4
#: 4_4:350
msgctxt "text_id=3602 | speaker=unknown"
msgid "　青子の無言の圧迫に負けないように、鳶丸は何気なく会話を切り出した。"
msgstr ""

#. Occurrence 4_4:396:3603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0000; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:396
msgctxt "text_id=3603 | speaker=aoko"
msgid "「お疲れさま。ところでアンタ、何しに来たのか分かってる？」"
msgstr ""

#. Occurrence 4_4:419:3604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0002; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:419
msgctxt "text_id=3604 | speaker=tobimaru"
msgid "「まあな。ただ、事務的に話すのって寒いじゃねえか。"
msgstr ""

#. Occurrence 4_4:425:3605: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0003; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:425
msgctxt "text_id=3605 | speaker=tobimaru"
msgid "　少しぐらい世間話でもしねえとつまらねえだろ？」"
msgstr ""

#. Occurrence 4_4:452:3606: scene=4_4
#: 4_4:452
msgctxt "text_id=3606 | speaker=unknown"
msgid "　鳶丸は扉を閉めて、青子の前の椅子に座った。"
msgstr ""

#. Occurrence 4_4:457:3607: scene=4_4
#: 4_4:457
msgctxt "text_id=3607 | speaker=unknown"
msgid "　その手には青い封筒を抱えている。"
msgstr ""

#. Occurrence 4_4:501:3608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0001; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:501
msgctxt "text_id=3608 | speaker=aoko"
msgid "「こういう時は無駄口はたたかない方がいいわよ。"
msgstr ""

#. Occurrence 4_4:507:3609: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0002; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:507
msgctxt "text_id=3609 | speaker=aoko"
msgid "　なんとなくプロっぽいでしょ」"
msgstr ""

#. Occurrence 4_4:513:3610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0004; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:513
msgctxt "text_id=3610 | speaker=tobimaru"
msgid "「なる―――いや、いやいやいや」"
msgstr ""

#. Occurrence 4_4:534:3611: scene=4_4
#: 4_4:534
msgctxt "text_id=3611 | speaker=unknown"
msgid "　青子の刺々しい返答にそうかも、と同意しかけて、鳶丸はイヤイヤと首を振った。"
msgstr ""

#. Occurrence 4_4:539:3612: scene=4_4
#: 4_4:539
msgctxt "text_id=3612 | speaker=unknown"
msgid "　いくらフリーダムな鳶丸でも、そんな諜報員めいた日常は<御免|ごめん><蒙|こうむ>る。"
msgstr ""

#. Occurrence 4_4:566:3613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0003; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:566
msgctxt "text_id=3613 | speaker=aoko"
msgid "「それで、調べ終わったの？」"
msgstr ""

#. Occurrence 4_4:578:3614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0005; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:578
msgctxt "text_id=3614 | speaker=tobimaru"
msgid "「ああ。ついさっき最後の聴取を済ませてきた。"
msgstr ""

#. Occurrence 4_4:584:3615: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0006; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:584
msgctxt "text_id=3615 | speaker=tobimaru"
msgid "　詳しい事はその封筒に入ってる。おまえから渡された例のファイルも、そん中」"
msgstr ""

#. Occurrence 4_4:629:3616: scene=4_4
#: 4_4:629
msgctxt "text_id=3616 | speaker=unknown"
msgid "　ぱさり、と机に置かれる青封筒。"
msgstr ""

#. Occurrence 4_4:660:3617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0004; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:660
msgctxt "text_id=3617 | speaker=aoko"
msgid "「そう」"
msgstr ""

#. Occurrence 4_4:719:3618: scene=4_4
#: 4_4:719
msgctxt "text_id=3618 | speaker=unknown"
msgid "　青子は封筒を手にし、中の書類に目を通す。"
msgstr ""

#. Occurrence 4_4:724:3619: scene=4_4
#: 4_4:724
msgctxt "text_id=3619 | speaker=unknown"
msgid "　そこからは完全に彼女ひとりの世界で、鳶丸に対して気を配ってさえいない。"
msgstr ""

#. Occurrence 4_4:729:3620: scene=4_4
#: 4_4:729
msgctxt "text_id=3620 | speaker=unknown"
msgid "　歯に<衣|きぬ>着せずに言えば、パーフェクトなまでの無視っぷりである。"
msgstr ""

#. Occurrence 4_4:808:3621: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0007; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:808
msgctxt "text_id=3621 | speaker=tobimaru"
msgid "「………………なあ」"
msgstr ""

#. Occurrence 4_4:814:3622: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0005; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:814
msgctxt "text_id=3622 | speaker=aoko"
msgid "「なに？」"
msgstr ""

#. Occurrence 4_4:820:3623: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0008; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:820
msgctxt "text_id=3623 | speaker=tobimaru"
msgid "「ひとつ、聞きたいんだけどよ」"
msgstr ""

#. Occurrence 4_4:832:3624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0006; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:832
msgctxt "text_id=3624 | speaker=aoko"
msgid "「だから、なに？」"
msgstr ""

#. Occurrence 4_4:859:3625: scene=4_4
#: 4_4:859
msgctxt "text_id=3625 | speaker=unknown"
msgid "　冷えきった沈黙。"
msgstr ""

#. Occurrence 4_4:864:3626: scene=4_4
#: 4_4:864
msgctxt "text_id=3626 | speaker=unknown"
msgid "　無感情に書類をチェックする青子と、"
msgstr ""

#. Occurrence 4_4:869:3627: scene=4_4
#: 4_4:869
msgctxt "text_id=3627 | speaker=unknown"
msgid "　そんな青子をどうでもよさげに、しかし正面から見据える鳶丸。"
msgstr ""

#. Occurrence 4_4:890:3628: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0009; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:890
msgctxt "text_id=3628 | speaker=tobimaru"
msgid "「蒼崎、そういうの作って楽しい？」"
msgstr ""

#. Occurrence 4_4:947:3629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0007; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:947
msgctxt "text_id=3629 | speaker=aoko"
msgid "「楽しいワケないでしょ。こんなの、作ったところであんまり使う機会なんてないんだから」"
msgstr ""

#. Occurrence 4_4:981:3630: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0010; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:981
msgctxt "text_id=3630 | speaker=tobimaru"
msgid "「そうか。ならいい」"
msgstr ""

#. Occurrence 4_4:989:3631: scene=4_4
#: 4_4:989
msgctxt "text_id=3631 | speaker=unknown"
msgid "　納得いったのか、<憮然|ぶぜん>顔のまま鳶丸は席を立った。"
msgstr ""

#. Occurrence 4_4:1024:3632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0011; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1024
msgctxt "text_id=3632 | speaker=tobimaru"
msgid "「最後まで読めば分かるだろうが、あんまり確証は取れなかったぜ。"
msgstr ""

#. Occurrence 4_4:1031:3633: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0012; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1031
msgctxt "text_id=3633 | speaker=tobimaru"
msgid "というより、一昨日あの辺りにいた生徒はいないって話になりそうだ。ま、断定はできないけどな」"
msgstr ""

#. Occurrence 4_4:1082:3634: scene=4_4
#: 4_4:1082
msgctxt "text_id=3634 | speaker=unknown"
msgid "　鳶丸はつれない態度でドアに向かう。"
msgstr ""

#. Occurrence 4_4:1087:3635: scene=4_4
#: 4_4:1087
msgctxt "text_id=3635 | speaker=unknown"
msgid "　俺はこの件には無関係です、と言わんばかりだ。"
msgstr ""

#. Occurrence 4_4:1137:3636: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0013; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1137
msgctxt "text_id=3636 | speaker=tobimaru"
msgid "「―――っと、そうだ。"
msgstr ""

#. Occurrence 4_4:1143:3637: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0014; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1143
msgctxt "text_id=3637 | speaker=tobimaru"
msgid "　そういえば一人だけ該当しなかった奴がいる。季節外れの転入生までは、蒼崎も調べきれなかったみてえじゃねぇか」"
msgstr ""

#. Occurrence 4_4:1187:3638: scene=4_4
#: 4_4:1187
msgctxt "text_id=3638 | speaker=unknown"
msgid "　わずかに顔をあげる青子。"
msgstr ""

#. Occurrence 4_4:1192:3639: scene=4_4
#: 4_4:1192
msgctxt "text_id=3639 | speaker=unknown"
msgid "　たしかに転入したばかりの生徒は彼女の調査範囲に含まれてはいない。"
msgstr ""

#. Occurrence 4_4:1213:3640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0015; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1213
msgctxt "text_id=3640 | speaker=tobimaru"
msgid "「そんなわけで草の字に関しては調べてないぜ。"
msgstr ""

#. Occurrence 4_4:1219:3641: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0016; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1219
msgctxt "text_id=3641 | speaker=tobimaru"
msgid "　ま、アイツならいつだろうと遅くまでバイトだろうが……いや、人殺しを見た、なんてコト口走ってるようじゃ、家で悪い夢でも見てたのかもしれねえか」"
msgstr ""

#. Occurrence 4_4:1256:3642: scene=4_4
#: 4_4:1256
msgctxt "text_id=3642 | speaker=unknown"
msgid "　鳶丸は陽気にこぼして去っていった。"
msgstr ""

#. Occurrence 4_4:1291:3643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0008; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1291
msgctxt "text_id=3643 | speaker=aoko"
msgid "「―――、は？」"
msgstr ""

#. Occurrence 4_4:1297:3644: scene=4_4
#: 4_4:1297
msgctxt "text_id=3644 | speaker=unknown"
msgid "　同時に、青子は持っていた書類を机に落とした。"
msgstr ""

#. Occurrence 4_4:1302:3645: scene=4_4
#: 4_4:1302
msgctxt "text_id=3645 | speaker=unknown"
msgid "　別にそんなつもりはなかったのに、なぜか、指先から力が失われてしまったらしい。"
msgstr ""

#. Occurrence 4_4:1353:3646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0009; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1353
msgctxt "text_id=3646 | speaker=aoko"
msgid "「……そんな、まさかね」"
msgstr ""

#. Occurrence 4_4:1359:3647: scene=4_4
#: 4_4:1359
msgctxt "text_id=3647 | speaker=unknown"
msgid "　考えすぎだ、と自分に対して軽口を言ってみる。"
msgstr ""

#. Occurrence 4_4:1364:3648: scene=4_4
#: 4_4:1364
msgctxt "text_id=3648 | speaker=unknown"
msgid "　けれど突然生まれた不安は消えず、こういう時の自分の直感がたいてい合っている事を、蒼崎青子は知っていた。"
msgstr ""

#. Occurrence 4_4:1456:3649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0010; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1456
msgctxt "text_id=3649 | speaker=aoko"
msgid "「―――馬鹿らしい」"
msgstr ""

#. Occurrence 4_4:1462:3650: scene=4_4
#: 4_4:1462
msgctxt "text_id=3650 | speaker=unknown"
msgid "　だとしてもやる事は同じだ。"
msgstr ""

#. Occurrence 4_4:1467:3651: scene=4_4
#: 4_4:1467
msgctxt "text_id=3651 | speaker=unknown"
msgid "　仮に目撃者が鳶丸だった場合、青子は<躊躇|ためら>わず殺せるだろう。"
msgstr ""

#. Occurrence 4_4:1472:3652: scene=4_4
#: 4_4:1472
msgctxt "text_id=3652 | speaker=unknown"
msgid "　けれど、それが彼だったら？"
msgstr ""

#. Occurrence 4_4:1477:3653: scene=4_4
#: 4_4:1477
msgctxt "text_id=3653 | speaker=unknown"
msgid "　そんな『もしも』を連想した途端、どんな仮定より冷めきっていく自分を感じた。"
msgstr ""

#. Occurrence 4_4:1514:3654: scene=4_4
#: 4_4:1514
msgctxt "text_id=3654 | speaker=unknown"
msgid "　青子は額に手を当てて考えこむ。"
msgstr ""

#. Occurrence 4_4:1519:3655: scene=4_4
#: 4_4:1519
msgctxt "text_id=3655 | speaker=unknown"
msgid "　そうして唐突に、"
msgstr ""

#. Occurrence 4_4:1579:3656: scene=4_4
#: 4_4:1579
msgctxt "text_id=3656 | speaker=unknown"
msgid "「選択の話をしよう。おまえは常に二者択一を迫られる。"
msgstr ""

#. Occurrence 4_4:1584:3657: scene=4_4
#: 4_4:1584
msgctxt "text_id=3657 | speaker=unknown"
msgid "　善良な愚者と醜悪な賢者。すべてを救う手段はない。どちらかを選ぶこと。それだけが、おまえに許された自由となる」"
msgstr ""

#. Occurrence 4_4:1644:3658: scene=4_4
#: 4_4:1644
msgctxt "text_id=3658 | speaker=unknown"
msgid "　二年前。"
msgstr ""

#. Occurrence 4_4:1649:3659: scene=4_4
#: 4_4:1649
msgctxt "text_id=3659 | speaker=unknown"
msgid "　姉に代わって後継ぎになった日に祖父から贈られた言葉を呟いて、青子は小さく嘆息した。"
msgstr ""

#. Occurrence 4_4:1656:3660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0011; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1656
msgctxt "text_id=3660 | speaker=aoko"
msgid "「―――すごく、バカみたい」"
msgstr ""

#. Occurrence 4_4:1670:3661: scene=4_4
#: 4_4:1670
msgctxt "text_id=3661 | speaker=unknown"
msgid "　自分の勘の良さに<嗤|わら>ってしまう。"
msgstr ""

#. Occurrence 4_4:1676:3662: scene=4_4
#: 4_4:1676
msgctxt "text_id=3662 | speaker=unknown"
msgid "　本当。"
msgstr ""

msgctxt "text_id=3663 | speaker=unknown"
msgid "そんな台詞、口にしなければよかったのにと。"
msgstr ""

#. Occurrence 4_4:1776:3664: scene=4_4
#: 4_4:1776
msgctxt "text_id=3664 | speaker=unknown"
msgid "　青子は戸締まりを済ませ、生徒会室を後にした。"
msgstr ""

#. Occurrence 4_4:1781:3665: scene=4_4
#: 4_4:1781
msgctxt "text_id=3665 | speaker=unknown"
msgid "　平然と、それこそ何もなかったようにすれ違う生徒たちと挨拶を交わせるあたり、自分らしいと呆れながら。"
msgstr ""

#. Occurrence 4_4:1830:3666: scene=4_4
#: 4_4:1830
msgctxt "text_id=3666 | speaker=unknown"
msgid "　学校にはまだ活気がある。"
msgstr ""

#. Occurrence 4_4:1835:3667: scene=4_4
#: 4_4:1835
msgctxt "text_id=3667 | speaker=unknown"
msgid "　部活動の生徒は言うに及ばず、用を済ませて下校していく生徒たちの話し声で校庭は騒がしい。"
msgstr ""

#. Occurrence 4_4:1840:3668: scene=4_4
#: 4_4:1840
msgctxt "text_id=3668 | speaker=unknown"
msgid "　今にも泣きだしそうな灰色の空だが、彼らにはさして気になる問題ではないようだ。"
msgstr ""

#. Occurrence 4_4:1887:3669: scene=4_4
#: 4_4:1887
msgctxt "text_id=3669 | speaker=unknown"
msgid "　そんな喧噪にまじって、青子は早足で校門に向かう。"
msgstr ""

#. Occurrence 4_4:1892:3670: scene=4_4
#: 4_4:1892
msgctxt "text_id=3670 | speaker=unknown"
msgid "　お<喋|しゃべ>りに花を咲かす生徒たちを通りすぎる。"
msgstr ""

#. Occurrence 4_4:1897:3671: scene=4_4
#: 4_4:1897
msgctxt "text_id=3671 | speaker=unknown"
msgid "　会話の内容は放課後の予定について。"
msgstr ""

#. Occurrence 4_4:1903:3672: scene=4_4
#: 4_4:1903
msgctxt "text_id=3672 | speaker=unknown"
msgid "いかに無駄なく充実した放課後を過ごすかを真剣に論じている。"
msgstr ""

#. Occurrence 4_4:1923:3673: scene=4_4
#: 4_4:1923
msgctxt "text_id=3673 | speaker=unknown"
msgid "　彼らが持つ、<遮二無二|しゃにむに>に遊ぼうという気は知れないけど、馬鹿にする気も、羨ましがる気持ちも青子にはない。"
msgstr ""

#. Occurrence 4_4:1928:3674: scene=4_4
#: 4_4:1928
msgctxt "text_id=3674 | speaker=unknown"
msgid "　ほんの二年前まで、そういった自由を心から愛していた自分がいたとしてもだ。"
msgstr ""

#. Occurrence 4_4:1949:3675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0012; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1949
msgctxt "text_id=3675 | speaker=aoko"
msgid "『……根は冷めてるのかな、私って』"
msgstr ""

#. Occurrence 4_4:1955:3676: scene=4_4
#: 4_4:1955
msgctxt "text_id=3676 | speaker=unknown"
msgid "　マフラーをきつめに締めてみたが、それで孤独を漂わせるにはまだ経験が少なかった。"
msgstr ""

#. Occurrence 4_4:1960:3677: scene=4_4
#: 4_4:1960
msgctxt "text_id=3677 | speaker=unknown"
msgid "　そもそも淋しいと思わない人間が孤独を装っても、それは孤独ではなく拒絶と言うのだ。"
msgstr ""

#. Occurrence 4_4:1981:3678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0013; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1981
msgctxt "text_id=3678 | speaker=aoko"
msgid "『……そうよね。孤独っていうのはああいうのを言うもんでしょうし』"
msgstr ""

#. Occurrence 4_4:1989:3679: scene=4_4
#: 4_4:1989
msgctxt "text_id=3679 | speaker=unknown"
msgid "　校門はいつもより騒がしい。"
msgstr ""

#. Occurrence 4_4:1994:3680: scene=4_4
#: 4_4:1994
msgctxt "text_id=3680 | speaker=unknown"
msgid "　原因は校門の陰で立往生をしている男子生徒たちだ。"
msgstr ""

#. Occurrence 4_4:1999:3681: scene=4_4
#: 4_4:1999
msgctxt "text_id=3681 | speaker=unknown"
msgid "　寄り添って密談をしている彼らは、校門の陰に隠れて、表通りに立っている一人の少女について、ざわざわと論じあっていた。"
msgstr ""

#. Occurrence 4_4:2079:3682: scene=4_4
#: 4_4:2079
msgctxt "text_id=3682 | speaker=unknown"
msgid "　少女は黒いケープに身を包んでいた。"
msgstr ""

#. Occurrence 4_4:2084:3683: scene=4_4
#: 4_4:2084
msgctxt "text_id=3683 | speaker=unknown"
msgid "　一見すると普段着だが、三咲町の人間なら、ケープ下の服がとある名門女子校の制服である事を知っている。"
msgstr ""

#. Occurrence 4_4:2089:3684: scene=4_4
#: 4_4:2089
msgctxt "text_id=3684 | speaker=unknown"
msgid "　もっとも、その女学院は三咲高校とは縁もゆかりもない、距離的にも精神的にも遠く離れた存在である。"
msgstr ""

#. Occurrence 4_4:2109:3685: scene=4_4
#: 4_4:2109
msgctxt "text_id=3685 | speaker=unknown"
msgid "　彼女達の大半は寮生活を強いられており、町中で見かける事は滅多にない。"
msgstr ""

#. Occurrence 4_4:2114:3686: scene=4_4
#: 4_4:2114
msgctxt "text_id=3686 | speaker=unknown"
msgid "　お嬢様学園と名こそ響いているが、実際にはそうお目にかかれない礼園女学院の制服だ。"
msgstr ""

#. Occurrence 4_4:2134:3687: scene=4_4
#: 4_4:2134
msgctxt "text_id=3687 | speaker=unknown"
msgid "　それだけで男どもが騒ぎ立てるには十分だが、くわえて、その少女は上等すぎた。"
msgstr ""

#. Occurrence 4_4:2154:3688: scene=4_4
#: 4_4:2154
msgctxt "text_id=3688 | speaker=unknown"
msgid "　可憐としか言いようのない立ち姿。"
msgstr ""

#. Occurrence 4_4:2159:3689: scene=4_4
#: 4_4:2159
msgctxt "text_id=3689 | speaker=unknown"
msgid "　身じろぎひとつせず待ち続ける様は、丁寧に描かれた絵画を思わせる。"
msgstr ""

#. Occurrence 4_4:2164:3690: scene=4_4
#: 4_4:2164
msgctxt "text_id=3690 | speaker=unknown"
msgid "　その姿を見て、一言で青子が『孤独』と断言したように。"
msgstr ""

#. Occurrence 4_4:2212:3691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0014; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2212
msgctxt "text_id=3691 | speaker=aoko"
msgid "『……まったく、うちの男子どもは。家に帰りもせず、陰でこそこそやってるのはそういうコト』"
msgstr ""

#. Occurrence 4_4:2218:3692: scene=4_4
#: 4_4:2218
msgctxt "text_id=3692 | speaker=unknown"
msgid "　呆れながら、青子はずかずかと校門を通過した。"
msgstr ""

#. Occurrence 4_4:2223:3693: scene=4_4
#: 4_4:2223
msgctxt "text_id=3693 | speaker=unknown"
msgid "　いつもなら坂道を下りていくところを、まっすぐアスファルトを横断し、道端に立ち続ける少女へと向かう。"
msgstr ""

#. Occurrence 4_4:2284:3694: voice_id=F80_4_4_0000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2284
msgctxt "text_id=3694 | speaker=unknown"
msgid "「げぇー!?　あれなるは生徒会長さまー!?」"
msgstr ""

#. Occurrence 4_4:2290:3695: voice_id=F90_4_4_0000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2290
msgctxt "text_id=3695 | speaker=unknown"
msgid "「くそ、追っ払う気なのかよぅ。居たいんならいつまでだって居させてあげればいいじゃんかー！」"
msgstr ""

#. Occurrence 4_4:2304:3696: voice_id=G10_4_4_0000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2304
msgctxt "text_id=3696 | speaker=unknown"
msgid "「ってか怒られる？　怒られるのあの天使？」"
msgstr ""

#. Occurrence 4_4:2310:3697: voice_id=G20_4_4_0000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2310
msgctxt "text_id=3697 | speaker=unknown"
msgid "「<他校|よそ>の生徒でも、校門前にいるぐらいなら……別に問題はないと思う……けど……」"
msgstr ""

#. Occurrence 4_4:2316:3698: voice_id=G30_4_4_9000; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2316
msgctxt "text_id=3698 | speaker=unknown"
msgid "「青子女史は容赦ねえからな。下手すると平手だぜ、平手」"
msgstr ""

#. Occurrence 4_4:2362:3699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0015; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2362
msgctxt "text_id=3699 | speaker=aoko"
msgid "「…………はあ」"
msgstr ""

#. Occurrence 4_4:2367:3700: scene=4_4
#: 4_4:2367
msgctxt "text_id=3700 | speaker=unknown"
msgid "　背中では言いたい放題だ。"
msgstr ""

#. Occurrence 4_4:2372:3701: scene=4_4
#: 4_4:2372
msgctxt "text_id=3701 | speaker=unknown"
msgid "　振り返って黙らせる気分でもなく、青子は少女の目前まで歩いて、やあ、とばかりに片手を上げた。"
msgstr ""

#. Occurrence 4_4:2425:3702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0016; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2425
msgctxt "text_id=3702 | speaker=aoko"
msgid "「どうしたの有珠？　こんなところに来たって、何も面白いコトはないって言ったのに」"
msgstr ""

#. Occurrence 4_4:2445:3703: voice_id=X20_4_4_0000; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2445
msgctxt "text_id=3703 | speaker=unknown"
msgid "「ちょ、ありえねーーーーーーー！！！！？」"
msgstr ""

#. Occurrence 4_4:2451:3704: scene=4_4
#: 4_4:2451
msgctxt "text_id=3704 | speaker=unknown"
msgid "　校門の陰から悲鳴らしきものがハモって聞こえたが、もちろん無視する青子だった。"
msgstr ""

#. Occurrence 4_4:2490:3705: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_0; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2490
msgctxt "text_id=3705 | speaker=alice"
msgid "「あの事を確かめに。―――"
msgstr ""

#. Occurrence 4_4:2504:3706: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_1; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2504
msgctxt "text_id=3706 | speaker=alice"
msgid "青子。"
msgstr ""

#. Occurrence 4_4:2543:3707: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0001; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2543
msgctxt "text_id=3707 | speaker=alice"
msgid "　あの人たち、邪魔なんだけど」"
msgstr ""

#. Occurrence 4_4:2555:3708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0017; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2555
msgctxt "text_id=3708 | speaker=aoko"
msgid "「分かってる、いま追っ払うから」"
msgstr ""

#. Occurrence 4_4:2561:3709: scene=4_4
#: 4_4:2561
msgctxt "text_id=3709 | speaker=unknown"
msgid "　細い有珠の声に対して、青子ははっきりと、これみよがしに声を大きくしている。"
msgstr ""

#. Occurrence 4_4:2566:3710: scene=4_4
#: 4_4:2566
msgctxt "text_id=3710 | speaker=unknown"
msgid "　無論、校門の陰に群がる<十把一絡|じっぱひとから>げに聞こえるように。"
msgstr ""

#. Occurrence 4_4:2640:3711: voice_id=F80_4_4_0002; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2640
msgctxt "text_id=3711 | speaker=unknown"
msgid "「げ、会長こっち来んぞ!?」"
msgstr ""

#. Occurrence 4_4:2646:3712: voice_id=F90_4_4_0001; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2646
msgctxt "text_id=3712 | speaker=unknown"
msgid "「おい、押すなよ、うしろのヤツどけって！　オレ校舎に逃げるから！」"
msgstr ""

#. Occurrence 4_4:2652:3713: voice_id=G10_4_4_0001; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2652
msgctxt "text_id=3713 | speaker=unknown"
msgid "「いや、でも……あの<娘|こ>、会長と知り合いなんでしょ？　うまく会長に紹介してもらう、とか……」"
msgstr ""

#. Occurrence 4_4:2658:3714: voice_id=G20_4_4_9000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2658
msgctxt "text_id=3714 | speaker=unknown"
msgid "「あはは、さすが一年坊主。まだ戦場の現実ってもんを理解していねぇ。―――よし、死の<間際|まぎわ>までいい夢見ろよ」"
msgstr ""

#. Occurrence 4_4:2730:3715: scene=4_4
#: 4_4:2730
msgctxt "text_id=3715 | speaker=unknown"
msgid "　一ヶ所に集まりすぎたのか、混乱きわまって校門の陰でつまる男子生徒たち。"
msgstr ""

#. Occurrence 4_4:2736:3716: scene=4_4
#: 4_4:2736
msgctxt "text_id=3716 | speaker=unknown"
msgid "そんな彼らを、"
msgstr ""

#. Occurrence 4_4:2748:3717: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0018; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2748
msgctxt "text_id=3717 | speaker=aoko"
msgid "「さーて。部活動があるワケでもなし、ただ家に帰るだけの帰宅部の皆さん？　こんなところで何を集まってるのか、教えてくれる？」"
msgstr ""

#. Occurrence 4_4:2759:3718: voice_id=X20_4_4_0001; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2759
msgctxt "text_id=3718 | speaker=unknown"
msgid "「ひぃぃいい！」"
msgstr ""

#. Occurrence 4_4:2765:3719: scene=4_4
#: 4_4:2765
msgctxt "text_id=3719 | speaker=unknown"
msgid "　どーん、と擬音を背負って<睥睨|へいげい>する生徒会長。"
msgstr ""

#. Occurrence 4_4:2806:3720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0019; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2806
msgctxt "text_id=3720 | speaker=aoko"
msgid "「なにしろ試験前だもの。"
msgstr ""

#. Occurrence 4_4:2812:3721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0020; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2812
msgctxt "text_id=3721 | speaker=aoko"
msgid "　<実|み>になる事なら私も教えてほしいけど、まさか<雁首|がんくび>並べて女学院のお嬢様を<眺|なが>めてただけ、なんて事はないわよね？"
msgstr ""

#. Occurrence 4_4:2818:3722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0021; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2818
msgctxt "text_id=3722 | speaker=aoko"
msgid "　声をかける勇気もなくて、眺めてただけ、なんて事は」"
msgstr ""

#. Occurrence 4_4:2836:3723: scene=4_4
#: 4_4:2836
msgctxt "text_id=3723 | speaker=unknown"
msgid "　はい、実はそうなんです、などと返答できる剛の者はいなかった。それだけの勇気があるならとっくに声をかけている。"
msgstr ""

#. Occurrence 4_4:2900:3724: voice_id=F80_4_4_9000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2900
msgctxt "text_id=3724 | speaker=unknown"
msgid "「……いや、ボク教室にちょっと忘れ物が……」"
msgstr ""

#. Occurrence 4_4:2910:3725: voice_id=F90_4_4_9000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2910
msgctxt "text_id=3725 | speaker=unknown"
msgid "「こんなオチならダメもとで玉砕しとくんだった……」"
msgstr ""

#. Occurrence 4_4:2916:3726: voice_id=G10_4_4_9000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2916
msgctxt "text_id=3726 | speaker=unknown"
msgid "「天文部にいって双眼鏡借りるのどうだ？　屋上からお顔を<賜|たまわ>るとか」"
msgstr ""

#. Occurrence 4_4:2926:3727: voice_id=G20_4_4_9001; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2926
msgctxt "text_id=3727 | speaker=unknown"
msgid "「天文部にそんなのねえよ！　あるとしたら野鳥同好会じゃね？」"
msgstr ""

#. Occurrence 4_4:2951:3728: voice_id=G30_4_4_9001; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2951
msgctxt "text_id=3728 | speaker=unknown"
msgid "「あはははは。それ、先月会長が潰したじゃん。<鳥|とり><愛|め>でてる暇があるなら彼女作れって」"
msgstr ""

#. Occurrence 4_4:2961:3729: voice_id=G60_4_4_9000; voice_prefix=G60; voice_category=0; scene=4_4
#: 4_4:2961
msgctxt "text_id=3729 | speaker=unknown"
msgid "「あはは、は……彼女、作れです、か……すみませんっす、今日は裏口から帰るっす、ザキさん……」"
msgstr ""

#. Occurrence 4_4:2971:3730: voice_id=F90_4_4_0003; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2971
msgctxt "text_id=3730 | speaker=unknown"
msgid "「クソ、じゃあなー会長ー！　また明日ー！」"
msgstr ""

#. Occurrence 4_4:3007:3731: scene=4_4
#: 4_4:3007
msgctxt "text_id=3731 | speaker=unknown"
msgid "　愛らしい捨て台詞を残し、負け犬のようにハラハラと散っていく男子生徒たち。"
msgstr ""

#. Occurrence 4_4:3040:3732: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0002; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3040
msgctxt "text_id=3732 | speaker=alice"
msgid "「楽しそうね、青子」"
msgstr ""

#. Occurrence 4_4:3056:3733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0022; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3056
msgctxt "text_id=3733 | speaker=aoko"
msgid "「あ、わかる？」"
msgstr ""

#. Occurrence 4_4:3061:3734: scene=4_4
#: 4_4:3061
msgctxt "text_id=3734 | speaker=unknown"
msgid "　有珠の一言に、つい即答する青子。"
msgstr ""

#. Occurrence 4_4:3066:3735: scene=4_4
#: 4_4:3066
msgctxt "text_id=3735 | speaker=unknown"
msgid "　事実、三咲高校の生徒たちは嫌味のない人間ばかりで、彼らとのやりとりは愉快ではあるのだ。"
msgstr ""

#. Occurrence 4_4:3096:3736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0023; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3096
msgctxt "text_id=3736 | speaker=aoko"
msgid "「―――で。"
msgstr ""

#. Occurrence 4_4:3117:3737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0024; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3117
msgctxt "text_id=3737 | speaker=aoko"
msgid "　ここまで出向くって事は、何か分かったの？」"
msgstr ""

#. Occurrence 4_4:3123:3738: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0003; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3123
msgctxt "text_id=3738 | speaker=alice"
msgid "「結界に残っていた気配の識別は。あとはここで確かめればいいだけよ」"
msgstr ""

#. Occurrence 4_4:3129:3739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0025; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3129
msgctxt "text_id=3739 | speaker=aoko"
msgid "「そう。ん……？　有珠、いつからここに？」"
msgstr ""

#. Occurrence 4_4:3135:3740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0004; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3135
msgctxt "text_id=3740 | speaker=alice"
msgid "「下校時刻から」"
msgstr ""

#. Occurrence 4_4:3140:3741: scene=4_4
#: 4_4:3140
msgctxt "text_id=3741 | speaker=unknown"
msgid "　……という事はかれこれ一時間は経つ。"
msgstr ""

#. Occurrence 4_4:3145:3742: scene=4_4
#: 4_4:3145
msgctxt "text_id=3742 | speaker=unknown"
msgid "　寒がりな彼女にとって、同じ場所に一時間も立つのは辛かっただろう。"
msgstr ""

#. Occurrence 4_4:3175:3743: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0026; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3175
msgctxt "text_id=3743 | speaker=aoko"
msgid "「悪いわね、無理させて」"
msgstr ""

#. Occurrence 4_4:3181:3744: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0005; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3181
msgctxt "text_id=3744 | speaker=alice"
msgid "「……別に。好きでやってる事だから」"
msgstr ""

#. Occurrence 4_4:3187:3745: scene=4_4
#: 4_4:3187
msgctxt "text_id=3745 | speaker=unknown"
msgid "　言いながらも、彼女の黒い瞳は校門を通る生徒たちを見つめている。"
msgstr ""

#. Occurrence 4_4:3192:3746: scene=4_4
#: 4_4:3192
msgctxt "text_id=3746 | speaker=unknown"
msgid "　こうやって一時間ものあいだ、有珠は校門を監視していたのだろう。"
msgstr ""

#. Occurrence 4_4:3213:3747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0027; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3213
msgctxt "text_id=3747 | speaker=aoko"
msgid "「私を待ってたワケじゃないんでしょ？　今からでも付き合うわ」"
msgstr ""

#. Occurrence 4_4:3218:3748: scene=4_4
#: 4_4:3218
msgctxt "text_id=3748 | speaker=unknown"
msgid "　こくん、と頷く有珠。"
msgstr ""

#. Occurrence 4_4:3223:3749: scene=4_4
#: 4_4:3223
msgctxt "text_id=3749 | speaker=unknown"
msgid "　有珠が残っているのは、いまだ目撃者を発見できていないからだ。"
msgstr ""

#. Occurrence 4_4:3228:3750: scene=4_4
#: 4_4:3228
msgctxt "text_id=3750 | speaker=unknown"
msgid "　結界に残った気配に一致する生徒がいたのなら、有珠は青子を待たずに帰宅し、その生徒の素性を調べていただろう。"
msgstr ""

#. Occurrence 4_4:3271:3751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0028; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3271
msgctxt "text_id=3751 | speaker=aoko"
msgid "「私の方はダメだった」"
msgstr ""

#. Occurrence 4_4:3277:3752: scene=4_4
#: 4_4:3277
msgctxt "text_id=3752 | speaker=unknown"
msgid "　鳶丸に調べさせた結果について、青子は結果だけを告げた。有珠に言葉はない。"
msgstr ""

#. Occurrence 4_4:3282:3753: scene=4_4
#: 4_4:3282
msgctxt "text_id=3753 | speaker=unknown"
msgid "　会話はそれで打ち止めになり、あとは冷たい風に耐えるだけである。"
msgstr ""

#. Occurrence 4_4:3333:3754: scene=4_4
#: 4_4:3333
msgctxt "text_id=3754 | speaker=unknown"
msgid "　……無言の監視はあてもなく続く。"
msgstr ""

#. Occurrence 4_4:3338:3755: scene=4_4
#: 4_4:3338
msgctxt "text_id=3755 | speaker=unknown"
msgid "　校門に来た生徒たちは、生徒会長と礼園女学院の生徒という組み合わせに驚きつつ下校していく。"
msgstr ""

#. Occurrence 4_4:3343:3756: scene=4_4
#: 4_4:3343
msgctxt "text_id=3756 | speaker=unknown"
msgid "　退屈さと冬の寒さも手伝ってか、二十分もすぎると青子はため息をついていた。"
msgstr ""

#. Occurrence 4_4:3394:3757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0029; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3394
msgctxt "text_id=3757 | speaker=aoko"
msgid "「ね、有珠。帰り、<黎明|レイメイ>に寄ってかない？」"
msgstr ""

#. Occurrence 4_4:3400:3758: scene=4_4
#: 4_4:3400
msgctxt "text_id=3758 | speaker=unknown"
msgid "　ちらり、と有珠の顔を覗きこむ青子。"
msgstr ""

#. Occurrence 4_4:3405:3759: scene=4_4
#: 4_4:3405
msgctxt "text_id=3759 | speaker=unknown"
msgid "　黎明は青子お気に入りの喫茶店の名前である。"
msgstr ""

#. Occurrence 4_4:3442:3760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0006; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3442
msgctxt "text_id=3760 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 4_4:3448:3761: scene=4_4
#: 4_4:3448
msgctxt "text_id=3761 | speaker=unknown"
msgid "　状況を理解していない青子への非難か、それともわりと同意なのか、有珠は微かに視線を動かした。"
msgstr ""

#. Occurrence 4_4:3453:3762: scene=4_4
#: 4_4:3453
msgctxt "text_id=3762 | speaker=unknown"
msgid "　その視線の先には―――"
msgstr ""

#. Occurrence 4_4:3492:3763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0000; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3492
msgctxt "text_id=3763 | speaker=soujuurou"
msgid "「あれ、蒼崎も待ち合わせか？」"
msgstr ""

#. Occurrence 4_4:3498:3764: scene=4_4
#: 4_4:3498
msgctxt "text_id=3764 | speaker=unknown"
msgid "　意識の隙を<衝|つ>くような、突然の声。"
msgstr ""

#. Occurrence 4_4:3503:3765: scene=4_4
#: 4_4:3503
msgctxt "text_id=3765 | speaker=unknown"
msgid "　自然な、刺のない口調が誰であるかは言うまでもない。"
msgstr ""

#. Occurrence 4_4:3564:3766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0030; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3564
msgctxt "text_id=3766 | speaker=aoko"
msgid "「―――そ。やっぱ、そうなるワケか」"
msgstr ""

#. Occurrence 4_4:3570:3767: scene=4_4
#: 4_4:3570
msgctxt "text_id=3767 | speaker=unknown"
msgid "　有珠に背中を向けて、青子はキッと、やってきた生徒を見据える。"
msgstr ""

#. Occurrence 4_4:3620:3768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0031; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3620
msgctxt "text_id=3768 | speaker=aoko"
msgid "「それで、今日は何の用？」"
msgstr ""

#. Occurrence 4_4:3626:3769: scene=4_4
#: 4_4:3626
msgctxt "text_id=3769 | speaker=unknown"
msgid "　こんにちはも何もない。"
msgstr ""

#. Occurrence 4_4:3631:3770: scene=4_4
#: 4_4:3631
msgctxt "text_id=3770 | speaker=unknown"
msgid "　不機嫌な青子の視線は、その険悪さをより増して草十郎に向けられる。"
msgstr ""

#. Occurrence 4_4:3636:3771: scene=4_4
#: 4_4:3636
msgctxt "text_id=3771 | speaker=unknown"
msgid "　が、そんな青子の眼力も草十郎には通じなかったようだ。"
msgstr ""

#. Occurrence 4_4:3664:3772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0001; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3664
msgctxt "text_id=3772 | speaker=soujuurou"
msgid "「いや、これから駅前で水泳部の部長と待ち合わせなんだけど、その事でお礼を言っておきたくて」"
msgstr ""

#. Occurrence 4_4:3688:3773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0032; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3688
msgctxt "text_id=3773 | speaker=aoko"
msgid "「？」"
msgstr ""

#. Occurrence 4_4:3693:3774: scene=4_4
#: 4_4:3693
msgctxt "text_id=3774 | speaker=unknown"
msgid "　それは、意外と言えば意外な一言だった筈だ。"
msgstr ""

#. Occurrence 4_4:3698:3775: scene=4_4
#: 4_4:3698
msgctxt "text_id=3775 | speaker=unknown"
msgid "　部活とお礼。"
msgstr ""

#. Occurrence 4_4:3703:3776: scene=4_4
#: 4_4:3703
msgctxt "text_id=3776 | speaker=unknown"
msgid "　……ただ、その組み合わせなら、この人物は間の抜けた事を言ってくるだろうと、青子は思ってもいた。なんの根拠もなかったけれど。"
msgstr ""

#. Occurrence 4_4:3729:3777: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0033; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3729
msgctxt "text_id=3777 | speaker=aoko"
msgid "「……ふうん。お礼って、お礼参りってこと？」"
msgstr ""

#. Occurrence 4_4:3735:3778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0002; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3735
msgctxt "text_id=3778 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 4_4:3740:3779: scene=4_4
#: 4_4:3740
msgctxt "text_id=3779 | speaker=unknown"
msgid "　これまた幸運な事に、学生におけるお礼参りの意味も、草十郎はまだ知らずにいたらしい。"
msgstr ""

#. Occurrence 4_4:3775:3780: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0003; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3775
msgctxt "text_id=3780 | speaker=soujuurou"
msgid "「よく分からないけど、そんな大した事じゃないよ。"
msgstr ""

#. Occurrence 4_4:3781:3781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0004; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3781
msgctxt "text_id=3781 | speaker=soujuurou"
msgid "　ただ、水泳部は夏までそう忙しくないって話だったから」"
msgstr ""

#. Occurrence 4_4:3787:3782: scene=4_4
#: 4_4:3787
msgctxt "text_id=3782 | speaker=unknown"
msgid "　そういう部活を<薦|すす>めてくれたんだな、と草十郎は続けようとしたが、青子はつまらなそうな顔で遮った。"
msgstr ""

#. Occurrence 4_4:3823:3783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0034; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3823
msgctxt "text_id=3783 | speaker=aoko"
msgid "「当然でしょう。幽霊部員になりそうな生徒なんて、紹介できないから。忙しい貴方でも<勤|つと>まりそうな場所があったから、口に出しただけよ」"
msgstr ""

#. Occurrence 4_4:3843:3784: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0005; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3843
msgctxt "text_id=3784 | speaker=soujuurou"
msgid "「なるほど、無駄がないね」"
msgstr ""

#. Occurrence 4_4:3863:3785: scene=4_4
#: 4_4:3863
msgctxt "text_id=3785 | speaker=unknown"
msgid "　感心する草十郎に、青子は文句を言う気も無くしてしまった。"
msgstr ""

#. Occurrence 4_4:3868:3786: scene=4_4
#: 4_4:3868
msgctxt "text_id=3786 | speaker=unknown"
msgid "　彼女にとって、彼に似合った部活を探して部長に話をつけること自体が無駄な事だったのだが。"
msgstr ""

#. Occurrence 4_4:3895:3787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3787 | speaker=soujuurou"
msgid "「とにかく、お世話になったから。"
msgstr ""

#. Occurrence 4_4:3895:3788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3788 | speaker=soujuurou"
msgid "　それで礼を言っときたくて」"
msgstr ""

#. Occurrence 4_4:3901:3789: scene=4_4
#: 4_4:3901
msgctxt "text_id=3789 | speaker=unknown"
msgid "　ありがとう、と今にも頭を下げそうな草十郎を、あわてて青子は止める。"
msgstr ""

#. Occurrence 4_4:3940:3790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0035; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3940
msgctxt "text_id=3790 | speaker=aoko"
msgid "「よしてよ。いま貴方にそんな事されても迷惑だから。"
msgstr ""

#. Occurrence 4_4:3946:3791: scene=4_4
#: 4_4:3946
msgctxt "text_id=3791 | speaker=unknown"
msgid "　……"
msgstr ""

#. Occurrence 4_4:3958:3792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0036; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3958
msgctxt "text_id=3792 | speaker=aoko"
msgid "それで、水泳部はどう？　やっていけそう？」"
msgstr ""

#. Occurrence 4_4:3984:3793: scene=4_4
#: 4_4:3984
msgctxt "text_id=3793 | speaker=unknown"
msgid "　鋭かった視線が、どこか気まずいものに変わる。"
msgstr ""

#. Occurrence 4_4:3989:3794: scene=4_4
#: 4_4:3989
msgctxt "text_id=3794 | speaker=unknown"
msgid "　青子の態度に違和感を覚える草十郎だったが、その理由までは分からない。"
msgstr ""

#. Occurrence 4_4:3994:3795: scene=4_4
#: 4_4:3994
msgctxt "text_id=3795 | speaker=unknown"
msgid "　なので、とりあえず分かるところから、と最新のニュースを青子に告げた。"
msgstr ""

#. Occurrence 4_4:4032:3796: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0007; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4032
msgctxt "text_id=3796 | speaker=soujuurou"
msgid "「ああ、水泳部はクビになった」"
msgstr ""

#. Occurrence 4_4:4055:3797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0037; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4055
msgctxt "text_id=3797 | speaker=aoko"
msgid "「な、"
msgstr ""

msgctxt "text_id=3798 | speaker=unknown"
msgid "なんでよーーー！？」"
msgstr ""

#. Occurrence 4_4:4071:3799: scene=4_4
#: 4_4:4071
msgctxt "text_id=3799 | speaker=unknown"
msgid "　予想外の返答に、思わず怒鳴る青子。"
msgstr ""

#. Occurrence 4_4:4076:3800: scene=4_4
#: 4_4:4076
msgctxt "text_id=3800 | speaker=unknown"
msgid "　……びっくり箱の化身にも程がある。"
msgstr ""

#. Occurrence 4_4:4081:3801: scene=4_4
#: 4_4:4081
msgctxt "text_id=3801 | speaker=unknown"
msgid "　あまりの展開に、青子の複雑にねじれていた心持ちが一瞬で真っ白になるぐらい。"
msgstr ""

#. Occurrence 4_4:4108:3802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0038; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4108
msgctxt "text_id=3802 | speaker=aoko"
msgid "「だだ、だって、今から待ち合わせだって……！」"
msgstr ""

#. Occurrence 4_4:4145:3803: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0008; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4145
msgctxt "text_id=3803 | speaker=soujuurou"
msgid "「それは、これから<社木|やしろぎ>の温水プールに連れていってくれるからだよ」"
msgstr ""

#. Occurrence 4_4:4151:3804: scene=4_4
#: 4_4:4151
msgctxt "text_id=3804 | speaker=unknown"
msgid "　驚く青子に、うん、と告げる草十郎。"
msgstr ""

#. Occurrence 4_4:4182:3805: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0039; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4182
msgctxt "text_id=3805 | speaker=aoko"
msgid "「……話が繋がらない。そこまで上手くいってるのに、どうして入部を拒否されるのよ、アンタは！」"
msgstr ""

#. Occurrence 4_4:4195:3806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0009; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4195
msgctxt "text_id=3806 | speaker=soujuurou"
msgid "「そりゃあ、俺が泳げないからだろ」"
msgstr ""

#. Occurrence 4_4:4230:3807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0040; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4230
msgctxt "text_id=3807 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 4_4:4235:3808: scene=4_4
#: 4_4:4235
msgctxt "text_id=3808 | speaker=unknown"
msgid "　なるほど、そうきたか、と眉間を指で押さえる青子。"
msgstr ""

#. Occurrence 4_4:4270:3809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0041; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4270
msgctxt "text_id=3809 | speaker=aoko"
msgid "「……静希君。昨日の私の質問は覚えてる？　走るのか泳ぐのか、どっちがいいかってヤツ。"
msgstr ""

#. Occurrence 4_4:4276:3810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0042; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4276
msgctxt "text_id=3810 | speaker=aoko"
msgid "　私の記憶は正しいけど、いちおう確認しておくわね。"
msgstr ""

#. Occurrence 4_4:4296:3811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0043; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4296
msgctxt "text_id=3811 | speaker=aoko"
msgid "　貴方、たしかに泳ぐ方だって言ったけど……？」"
msgstr ""

#. Occurrence 4_4:4323:3812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0010; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4323
msgctxt "text_id=3812 | speaker=soujuurou"
msgid "「ああ。昔から、泳げないのはなんとか克服したかったんだ。反対に、走る方は得意だけど」"
msgstr ""

#. Occurrence 4_4:4335:3813: scene=4_4
#: 4_4:4335
msgctxt "text_id=3813 | speaker=unknown"
msgid "　あっそ、と答えて青子は力尽きた。"
msgstr ""

#. Occurrence 4_4:4370:3814: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0011; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4370
msgctxt "text_id=3814 | speaker=soujuurou"
msgid "「俺が一年なら一から鍛えてくれたらしいんだけど。"
msgstr ""

#. Occurrence 4_4:4376:3815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0012; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4376
msgctxt "text_id=3815 | speaker=soujuurou"
msgid "　あと三ヶ月で三年になる身分なのに、カナヅチの部員は雇えないそうだ。"
msgstr ""

#. Occurrence 4_4:4387:3816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0013; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4387
msgctxt "text_id=3816 | speaker=soujuurou"
msgid "　けど部長が親身になってくれて、これから泳ぎを教えてくれる事になったんだよ」"
msgstr ""

#. Occurrence 4_4:4409:3817: scene=4_4
#: 4_4:4409
msgctxt "text_id=3817 | speaker=unknown"
msgid "　どこか嬉しそうに言う草十郎の言葉は、青子にはあまり届いていない。"
msgstr ""

#. Occurrence 4_4:4448:3818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_0; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4448
msgctxt "text_id=3818 | speaker=aoko"
msgid "『はあ……つまり、欠陥品を売り付けたってワケか……こりゃ水泳部の部長に合わす顔がない……っと、"
msgstr ""

#. Occurrence 4_4:4460:3819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_1; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4460
msgctxt "text_id=3819 | speaker=aoko"
msgid "ちょっと待った』"
msgstr ""

#. Occurrence 4_4:4472:3820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0045; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4472
msgctxt "text_id=3820 | speaker=aoko"
msgid "「静希君。水泳部の部長って……」"
msgstr ""

#. Occurrence 4_4:4478:3821: scene=4_4
#: 4_4:4478
msgctxt "text_id=3821 | speaker=unknown"
msgid "　女子、と言いかけて止めた。"
msgstr ""

#. Occurrence 4_4:4483:3822: scene=4_4
#: 4_4:4483
msgctxt "text_id=3822 | speaker=unknown"
msgid "　口にした途端、自分が変なことを口走りそうで怖くなったからだ。"
msgstr ""

#. Occurrence 4_4:4509:3823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0046; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4509
msgctxt "text_id=3823 | speaker=aoko"
msgid "「……もういいわ。気持ちは分かったから、どこか遠くにいてくれない？　少し疲れてて、とてもじゃないけど貴方の相手はしていられないの」"
msgstr ""

#. Occurrence 4_4:4532:3824: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0014; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4532
msgctxt "text_id=3824 | speaker=soujuurou"
msgid "「鳶丸もそんな事を言ってたな。蒼崎は昨日と今日、めずらしく疲れてるって。何かあったのか？」"
msgstr ""

#. Occurrence 4_4:4538:3825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0047; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4538
msgctxt "text_id=3825 | speaker=aoko"
msgid "「ちょっとね。でもいいの。解決したみたいだから。"
msgstr ""

#. Occurrence 4_4:4544:3826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0048; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4544
msgctxt "text_id=3826 | speaker=aoko"
msgid "　それより……静希君はどう見える？　私、そんなに疲れて見えるのかな」"
msgstr ""

#. Occurrence 4_4:4577:3827: scene=4_4
#: 4_4:4577
msgctxt "text_id=3827 | speaker=unknown"
msgid "　何故そんな事を訊ねたのか。"
msgstr ""

#. Occurrence 4_4:4583:3828: scene=4_4
#: 4_4:4583
msgctxt "text_id=3828 | speaker=unknown"
msgid "　青子にしては珍しい、"
msgstr ""

msgctxt "text_id=3829 | speaker=unknown"
msgid "　理由のない、<惰性|だせい>で口から出た言葉だ。"
msgstr ""

#. Occurrence 4_4:4591:3830: scene=4_4
#: 4_4:4591
msgctxt "text_id=3830 | speaker=unknown"
msgid "　……あえて言うなら、これが最後だろうから、何かしらか普通の会話をしておこうと思ったのかもしれない。"
msgstr ""

#. Occurrence 4_4:4623:3831: scene=4_4
#: 4_4:4623
msgctxt "text_id=3831 | speaker=unknown"
msgid "　草十郎はしばし考えこんでから、そのぼんやりした雰囲気からかけ離れた笑顔を浮かべた。"
msgstr ""

#. Occurrence 4_4:4649:3832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0015; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4649
msgctxt "text_id=3832 | speaker=soujuurou"
msgid "「そうだな、疲れているというより生き生きしているように見える。仕方なく畑をたがやしていた狼が、久しぶりに狩りにでる事になって<気炎|きえん>をあげている感じだ」"
msgstr ""

#. Occurrence 4_4:4655:3833: scene=4_4
#: 4_4:4655
msgctxt "text_id=3833 | speaker=unknown"
msgid "　めでたいな、と。"
msgstr ""

#. Occurrence 4_4:4660:3834: scene=4_4
#: 4_4:4660
msgctxt "text_id=3834 | speaker=unknown"
msgid "　まるで我が事のように、彼は微笑んだ。"
msgstr ""

#. Occurrence 4_4:4693:3835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0049; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4693
msgctxt "text_id=3835 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 4_4:4699:3836: scene=4_4
#: 4_4:4699
msgctxt "text_id=3836 | speaker=unknown"
msgid "　知れず、青子は頬に手を当てた。"
msgstr ""

#. Occurrence 4_4:4704:3837: scene=4_4
#: 4_4:4704
msgctxt "text_id=3837 | speaker=unknown"
msgid "　彼の言う事が本当なら、今の自分はこの上なく味のあるニヤけ顔をしている事になる。"
msgstr ""

#. Occurrence 4_4:4709:3838: scene=4_4
#: 4_4:4709
msgctxt "text_id=3838 | speaker=unknown"
msgid "　当然、そんなヘマは犯していなかったが。"
msgstr ""

#. Occurrence 4_4:4733:3839: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0016; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4733
msgctxt "text_id=3839 | speaker=soujuurou"
msgid "「とにかくありがとう。じゃあ、また明日」"
msgstr ""

#. Occurrence 4_4:4739:3840: scene=4_4
#: 4_4:4739
msgctxt "text_id=3840 | speaker=unknown"
msgid "　まだ手を上げるほどの気楽さはないのか、草十郎は真摯な声と<表情|かお>だけで挨拶をして去ろうとする。"
msgstr ""

#. Occurrence 4_4:4781:3841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0050; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4781
msgctxt "text_id=3841 | speaker=aoko"
msgid "「待って。こんな話があるの。聞いてから行って」"
msgstr ""

#. Occurrence 4_4:4787:3842: scene=4_4
#: 4_4:4787
msgctxt "text_id=3842 | speaker=unknown"
msgid "　そんな草十郎を青子は呼び止めた。"
msgstr ""

#. Occurrence 4_4:4792:3843: scene=4_4
#: 4_4:4792
msgctxt "text_id=3843 | speaker=unknown"
msgid "　温和になりかけていた自分を<戒|いまし>める、冷たい声で。"
msgstr ""

#. Occurrence 4_4:4841:3844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0017; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4841
msgctxt "text_id=3844 | speaker=soujuurou"
msgid "「うん？」"
msgstr ""

#. Occurrence 4_4:4847:3845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0051; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4847
msgctxt "text_id=3845 | speaker=aoko"
msgid "「意味のない<喩|たと>え話よ。"
msgstr ""

#. Occurrence 4_4:4853:3846: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0052; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4853
msgctxt "text_id=3846 | speaker=aoko"
msgid "　……そうね。貴方が空腹で死にそうな時、目の前に、同じように空腹で死にそうな二匹の動物がいるとするわ。"
msgstr ""

#. Occurrence 4_4:4859:3847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3847 | speaker=aoko"
msgid "　静希君に銃をあげる。それでどちらかの動物を撃って。"
msgstr ""

#. Occurrence 4_4:4859:3848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3848 | speaker=aoko"
msgid "　右はライオンで左は子猫。選ぶのは貴方の自由だから」"
msgstr ""

#. Occurrence 4_4:4912:3849: scene=4_4
#: 4_4:4912
msgctxt "text_id=3849 | speaker=unknown"
msgid "　どことなく童話めいた質問。"
msgstr ""

#. Occurrence 4_4:4917:3850: scene=4_4
#: 4_4:4917
msgctxt "text_id=3850 | speaker=unknown"
msgid "　残酷さと教訓と、押しつけがましいところがとくに。"
msgstr ""

#. Occurrence 4_4:4922:3851: scene=4_4
#: 4_4:4922
msgctxt "text_id=3851 | speaker=unknown"
msgid "　この手の話は考えこむときりがない。"
msgstr ""

#. Occurrence 4_4:4927:3852: scene=4_4
#: 4_4:4927
msgctxt "text_id=3852 | speaker=unknown"
msgid "　が、彼はあっさりと返答した。"
msgstr ""

#. Occurrence 4_4:4964:3853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0018; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4964
msgctxt "text_id=3853 | speaker=soujuurou"
msgid "「いや、撃たないと思うよ。だって、自分の好きにしていいんだろう？　それにほら、空腹ならお互い様だ」"
msgstr ""

#. Occurrence 4_4:4970:3854: scene=4_4
#: 4_4:4970
msgctxt "text_id=3854 | speaker=unknown"
msgid "　おそらくは悩む間もなかっただろう。"
msgstr ""

#. Occurrence 4_4:4975:3855: scene=4_4
#: 4_4:4975
msgctxt "text_id=3855 | speaker=unknown"
msgid "　それは本当にどうかと思うぐらい、真っ白な解答だった。"
msgstr ""

#. Occurrence 4_4:5008:3856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0054; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5008
msgctxt "text_id=3856 | speaker=aoko"
msgid "「……長生きするわ、貴方」"
msgstr ""

#. Occurrence 4_4:5026:3857: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0019; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:5026
msgctxt "text_id=3857 | speaker=soujuurou"
msgid "「すごい台詞だな。そんなコトを言われたのは、たぶん君が初めてだ」"
msgstr ""

#. Occurrence 4_4:5031:3858: scene=4_4
#: 4_4:5031
msgctxt "text_id=3858 | speaker=unknown"
msgid "　笑顔には似つかわしくない台詞。"
msgstr ""

#. Occurrence 4_4:5050:3859: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0055; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5050
msgctxt "text_id=3859 | speaker=aoko"
msgid "「――――――なによ、それ」"
msgstr ""

#. Occurrence 4_4:5055:3860: scene=4_4
#: 4_4:5055
msgctxt "text_id=3860 | speaker=unknown"
msgid "　……呼び止めるべきではなかったと後悔する。"
msgstr ""

#. Occurrence 4_4:5060:3861: scene=4_4
#: 4_4:5060
msgctxt "text_id=3861 | speaker=unknown"
msgid "　あのまま見送っていれば、こんな答えを聞くこともなかったのに、と。"
msgstr ""

#. Occurrence 4_4:5105:3862: scene=4_4
#: 4_4:5105
msgctxt "text_id=3862 | speaker=unknown"
msgid "　そして、静希草十郎はてくてくと坂道を下っていった。"
msgstr ""

#. Occurrence 4_4:5110:3863: scene=4_4
#: 4_4:5110
msgctxt "text_id=3863 | speaker=unknown"
msgid "　今日も今日とて、夜遅くまでアルバイトでもあるのだろう。"
msgstr ""

#. Occurrence 4_4:5115:3864: scene=4_4
#: 4_4:5115
msgctxt "text_id=3864 | speaker=unknown"
msgid "　残されたのは青子と、今まで背景と化していた有珠だけである。"
msgstr ""

#. Occurrence 4_4:5149:3865: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0056; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5149
msgctxt "text_id=3865 | speaker=aoko"
msgid "「つくづく……こっちのペースを乱してくれるわね、あの人畜無害な田舎者は」"
msgstr ""

#. Occurrence 4_4:5155:3866: scene=4_4
#: 4_4:5155
msgctxt "text_id=3866 | speaker=unknown"
msgid "　ぐっと右手を強く握り締めて、青子は独白する。"
msgstr ""

#. Occurrence 4_4:5160:3867: scene=4_4
#: 4_4:5160
msgctxt "text_id=3867 | speaker=unknown"
msgid "　どこでもいいから体に力を入れておかないと、ここで意味不明の大声を上げかねなかった。"
msgstr ""

#. Occurrence 4_4:5165:3868: scene=4_4
#: 4_4:5165
msgctxt "text_id=3868 | speaker=unknown"
msgid "　……それが相手への罵倒なのか、自分への罵倒なのかは、口にしないと分からない。"
msgstr ""

#. Occurrence 4_4:5196:3869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0007; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5196
msgctxt "text_id=3869 | speaker=alice"
msgid "「青子」"
msgstr ""

#. Occurrence 4_4:5202:3870: scene=4_4
#: 4_4:5202
msgctxt "text_id=3870 | speaker=unknown"
msgid "　後ろから有珠の細い声が聞こえる。彼女が何を言おうとしているかは、ちょっと前から分かっている。"
msgstr ""

#. Occurrence 4_4:5207:3871: scene=4_4
#: 4_4:5207
msgctxt "text_id=3871 | speaker=unknown"
msgid "　……今までどんな生徒にも無反応だった彼女が、草十郎の出現で表情を変えた時から。"
msgstr ""

#. Occurrence 4_4:5243:3872: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0057; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5243
msgctxt "text_id=3872 | speaker=aoko"
msgid "「言わなくてもいい。あいつでしょ、目撃者は」"
msgstr ""

#. Occurrence 4_4:5249:3873: scene=4_4
#: 4_4:5249
msgctxt "text_id=3873 | speaker=unknown"
msgid "　それは冷めきった、"
msgstr ""

#. Occurrence 4_4:5249:3874: scene=4_4
#: 4_4:5249
msgctxt "text_id=3874 | speaker=unknown"
msgid "　知らない人間の事を口にする声だった。"
msgstr ""

#. Occurrence 4_4:5308:3875: scene=4_4
#: 4_4:5308
msgctxt "text_id=3875 | speaker=unknown"
msgid "　―――ライオンと猫。"
msgstr ""

#. Occurrence 4_4:5313:3876: scene=4_4
#: 4_4:5313
msgctxt "text_id=3876 | speaker=unknown"
msgid "　それぞれ長所短所のある、結局のところ、自分とは違う生き物を選べと彼女は言った。"
msgstr ""

#. Occurrence 4_4:5333:3877: scene=4_4
#: 4_4:5333
msgctxt "text_id=3877 | speaker=unknown"
msgid "　リスクでいうのならライオンの方が大きい。銃口を向けた瞬間、最後の反撃をする可能性もある。"
msgstr ""

#. Occurrence 4_4:5338:3878: scene=4_4
#: 4_4:5338
msgctxt "text_id=3878 | speaker=unknown"
msgid "　だから、ライオンを狙う方が勇気はいるけれど、同時に銃を持つという後ろめたさはなくなっている。"
msgstr ""

#. Occurrence 4_4:5343:3879: scene=4_4
#: 4_4:5343
msgctxt "text_id=3879 | speaker=unknown"
msgid "　なにしろ相手は強い生き物だ。人間側の勝手な言い訳であれ、銃を使うことへの罪悪感は薄れてくれる。"
msgstr ""

#. Occurrence 4_4:5363:3880: scene=4_4
#: 4_4:5363
msgctxt "text_id=3880 | speaker=unknown"
msgid "　では、猫はどうだろう。弱い生き物。"
msgstr ""

#. Occurrence 4_4:5368:3881: scene=4_4
#: 4_4:5368
msgctxt "text_id=3881 | speaker=unknown"
msgid "　言うまでもなくライオンを狙うより簡単だ。けれど、誰だって不快な気持ちになる。"
msgstr ""

#. Occurrence 4_4:5373:3882: scene=4_4
#: 4_4:5373
msgctxt "text_id=3882 | speaker=unknown"
msgid "　初めから対等でないとしても、その理不尽さはあまりにも度が過ぎている。"
msgstr ""

#. Occurrence 4_4:5378:3883: scene=4_4
#: 4_4:5378
msgctxt "text_id=3883 | speaker=unknown"
msgid "　青子にとって、草十郎はその“理不尽さ”に該当するものだった。"
msgstr ""

#. Occurrence 4_4:5442:3884: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0058; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5442
msgctxt "text_id=3884 | speaker=aoko"
msgid "『……てっきり、私もそうだと思ってた……』"
msgstr ""

#. Occurrence 4_4:5448:3885: scene=4_4
#: 4_4:5448
msgctxt "text_id=3885 | speaker=unknown"
msgid "　生徒会室でもしもと危惧した時は、そうであっても仕方がない、と思いきった。"
msgstr ""

#. Occurrence 4_4:5454:3886: scene=4_4
#: 4_4:5454
msgctxt "text_id=3886 | speaker=unknown"
msgid "けれど去りぎわの草十郎の言葉で、その決心が揺らいでいる。"
msgstr ""

#. Occurrence 4_4:5474:3887: scene=4_4
#: 4_4:5474
msgctxt "text_id=3887 | speaker=unknown"
msgid "　この胸の不快さは、後ろめたさだけの<躊躇|とまど>いではない。"
msgstr ""

#. Occurrence 4_4:5480:3888: scene=4_4
#: 4_4:5480
msgctxt "text_id=3888 | speaker=unknown"
msgid "　静希草十郎は気に入らない人間であり、弱い相手であり、誰よりも御しやすい相手だ。"
msgstr ""

#. Occurrence 4_4:5485:3889: scene=4_4
#: 4_4:5485
msgctxt "text_id=3889 | speaker=unknown"
msgid "　なのになぜ、自分は躊躇いを覚えるのか。"
msgstr ""

#. Occurrence 4_4:5526:3890: scene=4_4
#: 4_4:5526
msgctxt "text_id=3890 | speaker=unknown"
msgid "　田舎から上京してきて身寄りもない転入生。"
msgstr ""

#. Occurrence 4_4:5531:3891: scene=4_4
#: 4_4:5531
msgctxt "text_id=3891 | speaker=unknown"
msgid "　他のまっとうな人間と違って、ここで消えたところで騒ぎだす人間も少ない。"
msgstr ""

#. Occurrence 4_4:5536:3892: scene=4_4
#: 4_4:5536
msgctxt "text_id=3892 | speaker=unknown"
msgid "　殺すなら、それこそ猫の首をひねるように仕留められる。"
msgstr ""

#. Occurrence 4_4:5541:3893: scene=4_4
#: 4_4:5541
msgctxt "text_id=3893 | speaker=unknown"
msgid "　……ほんと、いい事ずくめで頭にくる。"
msgstr ""

#. Occurrence 4_4:5546:3894: scene=4_4
#: 4_4:5546
msgctxt "text_id=3894 | speaker=unknown"
msgid "　なんて<幸運|ラッキー>。その尻をつま先で蹴り飛ばしてムチャクチャにしたいぐらい、正直、余計なお世話と苛々する―――"
msgstr ""

#. Occurrence 4_4:5604:3895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0059; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5604
msgctxt "text_id=3895 | speaker=aoko"
msgid "「……信じられない。私、嫌がってる。これは違う。"
msgstr ""

#. Occurrence 4_4:5610:3896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0060; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5610
msgctxt "text_id=3896 | speaker=aoko"
msgid "　―――こんなの、私じゃない」"
msgstr ""

#. Occurrence 4_4:5616:3897: scene=4_4
#: 4_4:5616
msgctxt "text_id=3897 | speaker=unknown"
msgid "　呟きは背後の有珠にも聞こえていたかも知れない。"
msgstr ""

#. Occurrence 4_4:5621:3898: scene=4_4
#: 4_4:5621
msgctxt "text_id=3898 | speaker=unknown"
msgid "　しかし、有珠は相棒の<癇癪|かんしゃく>など気にもせず、"
msgstr ""

#. Occurrence 4_4:5660:3899: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0008; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5660
msgctxt "text_id=3899 | speaker=alice"
msgid "「彼、首に布を巻いていたわね」"
msgstr ""

#. Occurrence 4_4:5666:3900: scene=4_4
#: 4_4:5666
msgctxt "text_id=3900 | speaker=unknown"
msgid "　などと、まったく関係のない感想を口にした。"
msgstr ""

#. Occurrence 4_4:5692:3901: scene=4_4
#: 4_4:5692
msgctxt "text_id=3901 | speaker=unknown"
msgid "　有珠の言葉に青子はハッと我に返る。"
msgstr ""

#. Occurrence 4_4:5698:3902: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0061; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5698
msgctxt "text_id=3902 | speaker=aoko"
msgid "「くび……？」"
msgstr ""

#. Occurrence 4_4:5709:3903: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0009; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5709
msgctxt "text_id=3903 | speaker=alice"
msgid "「……ええ。水泳部のクビとかけていたのかしら」"
msgstr ""

#. Occurrence 4_4:5714:3904: scene=4_4
#: 4_4:5714
msgctxt "text_id=3904 | speaker=unknown"
msgid "　ほとんど独り言の、心底から考えている有珠だった。"
msgstr ""

#. Occurrence 4_4:5753:3905: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0062; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5753
msgctxt "text_id=3905 | speaker=aoko"
msgid "「そういえば……あいつ、初めて会った時も首に布巻いてたっけ。<衿|えり>を行儀よく締めてるから目立たないけど」"
msgstr ""

#. Occurrence 4_4:5759:3906: scene=4_4
#: 4_4:5759
msgctxt "text_id=3906 | speaker=unknown"
msgid "　重要性のない、意味のない会話。"
msgstr ""

#. Occurrence 4_4:5764:3907: scene=4_4
#: 4_4:5764
msgctxt "text_id=3907 | speaker=unknown"
msgid "　何ら解決を生むものではなかったけれど、ぐらぐらと揺れていた青子の思考は、それできっかり落ち着いてくれた。"
msgstr ""

#. Occurrence 4_4:5790:3908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0063; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5790
msgctxt "text_id=3908 | speaker=aoko"
msgid "「……サンキュ、落ち着いたわ有珠。"
msgstr ""

#. Occurrence 4_4:5801:3909: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0064; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5801
msgctxt "text_id=3909 | speaker=aoko"
msgid "　それと気合いも入った。"
msgstr ""

#. Occurrence 4_4:5807:3910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0065; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5807
msgctxt "text_id=3910 | speaker=aoko"
msgid "　善は急げ、あいつが言い触らす前に決着をつけよう」"
msgstr ""

#. Occurrence 4_4:5827:3911: scene=4_4
#: 4_4:5827
msgctxt "text_id=3911 | speaker=unknown"
msgid "　よし、とばかりに青子は校門に背を向ける。"
msgstr ""

#. Occurrence 4_4:5832:3912: scene=4_4
#: 4_4:5832
msgctxt "text_id=3912 | speaker=unknown"
msgid "　とりあえず、洋館に戻って戦闘準備をしなくてはならない。"
msgstr ""

#. Occurrence 4_4:5908:3913: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0010; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5908
msgctxt "text_id=3913 | speaker=alice"
msgid "「……いいけど、いつ、どこで彼を殺すの？」"
msgstr ""

#. Occurrence 4_4:5921:3914: scene=4_4
#: 4_4:5921
msgctxt "text_id=3914 | speaker=unknown"
msgid "　……小さい声だが公衆の面前で口にする言葉ではない。"
msgstr ""

#. Occurrence 4_4:5926:3915: scene=4_4
#: 4_4:5926
msgctxt "text_id=3915 | speaker=unknown"
msgid "　有珠のこういった物騒さをたしなめるのは青子の役割だが、物騒さで言えば今の彼女も大差はないらしい。"
msgstr ""

#. Occurrence 4_4:5969:3916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0066; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5969
msgctxt "text_id=3916 | speaker=aoko"
msgid "「今日の夜。場所はとっておきの夢の国よ」"
msgstr ""

#. Occurrence 4_4:5975:3917: scene=4_4
#: 4_4:5975
msgctxt "text_id=3917 | speaker=unknown"
msgid "　有珠を<咎|とが>めもせず、クスリと不敵な笑みを浮かべる青子。"
msgstr ""

#. Occurrence 4_4:5981:3918: scene=4_4
#: 4_4:5981
msgctxt "text_id=3918 | speaker=unknown"
msgid "　それは恋人と待ち合わせる時のような、不思議と<爽|さわ>やかな響きだった。"
msgstr ""

#. Occurrence 5A_1:70:3919: scene=5A_1
#: 5A_1:70
msgctxt "text_id=3919 | speaker=unknown"
msgid "　雲のかかった夜空の下、草十郎はあいかわらずの徒歩でアパートに帰ってきた。"
msgstr ""

#. Occurrence 5A_1:90:3920: scene=5A_1
#: 5A_1:90
msgctxt "text_id=3920 | speaker=unknown"
msgid "　カンカンカン、と<錆|さ>びた金属音を踏みながら階段を上っていく。"
msgstr ""

#. Occurrence 5A_1:95:3921: scene=5A_1
#: 5A_1:95
msgctxt "text_id=3921 | speaker=unknown"
msgid "　アパートの塀に置かれた自転車をチラリと見て、"
msgstr ""

#. Occurrence 5A_1:100:3922: scene=5A_1
#: 5A_1:100
msgctxt "text_id=3922 | speaker=unknown"
msgid "　自分も自転車があれば楽なのだろうか、でも余分な出費だし、あれば便利だけど無くて死ぬようなものじゃなし、もう少し我慢しよう、などと真剣に悩んでみる。"
msgstr ""

#. Occurrence 5A_1:146:3923: scene=5A_1
#: 5A_1:146
msgctxt "text_id=3923 | speaker=unknown"
msgid "　ドアに到着して、リンゴのつまった紙袋を抱えたまま鍵を取り出す。"
msgstr ""

#. Occurrence 5A_1:153:3924: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0000; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:153
msgctxt "text_id=3924 | speaker=soujuurou"
msgid "　　　　　“あれば便利だけど無くて―――”"
msgstr ""

#. Occurrence 5A_1:159:3925: scene=5A_1
#: 5A_1:159
msgctxt "text_id=3925 | speaker=unknown"
msgid "　ん？と首をかしげる。"
msgstr ""

#. Occurrence 5A_1:164:3926: scene=5A_1
#: 5A_1:164
msgctxt "text_id=3926 | speaker=unknown"
msgid "　<益体|やくたい>も無い自分の言葉にひっかかるものを感じた草十郎だったが、もらい物の<果物|リンゴ>をどうさばくかでいっぱいだったコトもあり、あっけなくスルーした。"
msgstr ""

#. Occurrence 5A_1:231:3927: scene=5A_1
#: 5A_1:231
msgctxt "text_id=3927 | speaker=unknown"
msgid "　紙袋を流し場に置いて、部屋の電気をつける。"
msgstr ""

#. Occurrence 5A_1:236:3928: scene=5A_1
#: 5A_1:236
msgctxt "text_id=3928 | speaker=unknown"
msgid "　時刻は午後十時過ぎ。"
msgstr ""

#. Occurrence 5A_1:241:3929: scene=5A_1
#: 5A_1:241
msgctxt "text_id=3929 | speaker=unknown"
msgid "　試験前なのでいつもより一時間早い帰宅。"
msgstr ""

#. Occurrence 5A_1:257:3930: scene=5A_1
#: 5A_1:257
msgctxt "text_id=3930 | speaker=unknown"
msgid "　とりあえずリンゴをひとつ食べてみるか、と台所を振り返ると、新聞受けに差しこまれた封筒に気が付いた。"
msgstr ""

#. Occurrence 5A_1:284:3931: scene=5A_1
#: 5A_1:284
msgctxt "text_id=3931 | speaker=unknown"
msgid "　差出人の明記はなく、切手すら貼っていない。"
msgstr ""

#. Occurrence 5A_1:289:3932: scene=5A_1
#: 5A_1:289
msgctxt "text_id=3932 | speaker=unknown"
msgid "　中には一枚の手紙が入っていて、用件と差出人の名前だけが書かれていた。"
msgstr ""

#. Occurrence 5A_1:327:3933: scene=5A_1
#: 5A_1:327
msgctxt "text_id=3933 | speaker=unknown"
msgid "　内容はいたってシンプルで、"
msgstr ""

#. Occurrence 5A_1:334:3934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3934 | speaker=aoko"
msgid "『話があるので今夜どこそこのここに来られたし、"
msgstr ""

#. Occurrence 5A_1:334:3935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3935 | speaker=aoko"
msgid "　大事な用なので来るまでずっと待っている、"
msgstr ""

#. Occurrence 5A_1:334:3936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3936 | speaker=aoko"
msgid "　言うまでもなく他言無用―――』"
msgstr ""

#. Occurrence 5A_1:340:3937: scene=5A_1
#: 5A_1:340
msgctxt "text_id=3937 | speaker=unknown"
msgid "　という<旨|むね>が、簡潔、かつ凛々しい文字で<綴|つづ>られていた。"
msgstr ""

#. Occurrence 5A_1:360:3938: scene=5A_1
#: 5A_1:360
msgctxt "text_id=3938 | speaker=unknown"
msgid "　差出人の名前は蒼崎青子とある。"
msgstr ""

#. Occurrence 5A_1:365:3939: scene=5A_1
#: 5A_1:365
msgctxt "text_id=3939 | speaker=unknown"
msgid "　丁寧な事に、待ちあわせ場所の詳細な地図まで同封されていた。"
msgstr ""

#. Occurrence 5A_1:370:3940: scene=5A_1
#: 5A_1:370
msgctxt "text_id=3940 | speaker=unknown"
msgid "　ふむ、と少しだけ首をかしげて、彼はアパートを後にした。"
msgstr ""

#. Occurrence 5A_1:428:3941: scene=5A_1
#: 5A_1:428
msgctxt "text_id=3941 | speaker=unknown"
msgid "　……その後。"
msgstr ""

#. Occurrence 5A_1:435:3942: scene=5A_1
#: 5A_1:435
msgctxt "text_id=3942 | speaker=unknown"
msgid "　主人のいなくなった部屋で残された封筒はひとりでに燃えだし、はじめから何も無かったかのように、跡形もなく消滅した。"
msgstr ""

#. Occurrence 5A_1:499:3943: scene=5A_1
#: 5A_1:499
msgctxt "text_id=3943 | speaker=unknown"
msgid "　高度成長期もひとまずの落ち着きを見せ、安定期に入った８０年代後半。"
msgstr ""

#. Occurrence 5A_1:504:3944: scene=5A_1
#: 5A_1:504
msgctxt "text_id=3944 | speaker=unknown"
msgid "　街の近代化は着々と進み、新時代を代表するＪＲの駅が落成しようとしていた頃。"
msgstr ""

#. Occurrence 5A_1:510:3945: scene=5A_1
#: 5A_1:510
msgctxt "text_id=3945 | speaker=unknown"
msgid "　三咲町の隣町である<社木|やしろぎ>に、またひとつ、町の新しいシンボルが生まれようとしていた。"
msgstr ""

#. Occurrence 5A_1:564:3946: scene=5A_1
#: 5A_1:564
msgctxt "text_id=3946 | speaker=unknown"
msgid "　その名はやしろぎブレッド＆キッツィーランド。"
msgstr ""

#. Occurrence 5A_1:570:3947: scene=5A_1
#: 5A_1:570
msgctxt "text_id=3947 | speaker=unknown"
msgid "　三咲市最大の不良債権。"
msgstr ""

#. Occurrence 5A_1:575:3948: scene=5A_1
#: 5A_1:575
msgctxt "text_id=3948 | speaker=unknown"
msgid "　<後|のち>にバブルのあだ花と言われる、一つの時代の残骸である。"
msgstr ""

#. Occurrence 5A_1:597:3949: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0000; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:597
msgctxt "text_id=3949 | speaker=yurihiko"
msgid "“この町には<夢|ゆめ>とか<洒脱|しゃだつ>さが足りない”"
msgstr ""

#. Occurrence 5A_1:603:3950: scene=5A_1
#: 5A_1:603
msgctxt "text_id=3950 | speaker=unknown"
msgid "　今をさかのぼること十年前。"
msgstr ""

#. Occurrence 5A_1:608:3951: scene=5A_1
#: 5A_1:608
msgctxt "text_id=3951 | speaker=unknown"
msgid "　社木の名士であり、全国に多くの工場をかまえる<土桔|ときつ>製パン株式会社―――通称トッパンの経営者・<土桔|トキツ><由里彦|ユリヒコ>翁（当時五十六歳）はそんな使命感を合い言葉に、所有地であった社木郊外の土地を開放、三咲市を代表するレジャーランドの建築に着手した。"
msgstr ""

#. Occurrence 5A_1:628:3952: scene=5A_1
#: 5A_1:628
msgctxt "text_id=3952 | speaker=unknown"
msgid "　こうして運命の１９８１年。"
msgstr ""

#. Occurrence 5A_1:633:3953: scene=5A_1
#: 5A_1:633
msgctxt "text_id=3953 | speaker=unknown"
msgid "　完成までに三年の月日を費やし、夢とユーモアあふれる地域密着型遊園地・やしろぎブレッド＆キッツィーランドはその短い人生をスタートさせた。"
msgstr ""

#. Occurrence 5A_1:653:3954: scene=5A_1
#: 5A_1:653
msgctxt "text_id=3954 | speaker=unknown"
msgid "　敷地面積三十五万㎡。"
msgstr ""

#. Occurrence 5A_1:660:3955: scene=5A_1
#: 5A_1:660
msgctxt "text_id=3955 | speaker=unknown"
msgid "　<入り口|ゲート>をくぐった人々の目を奪う豪華絢爛なメリーゴーラウンド。"
msgstr ""

#. Occurrence 5A_1:665:3956: scene=5A_1
#: 5A_1:665
msgctxt "text_id=3956 | speaker=unknown"
msgid "　のたうつ龍のように遊園地をぐるりと囲むコースター。"
msgstr ""

#. Occurrence 5A_1:674:3957: scene=5A_1
#: 5A_1:674
msgctxt "text_id=3957 | speaker=unknown"
msgid "　当時の建築技術の限界に挑んだといわれる、無駄にギミック満載な観覧車。"
msgstr ""

#. Occurrence 5A_1:695:3958: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0001; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:695
msgctxt "text_id=3958 | speaker=yurihiko"
msgid "“完璧だ。遊園地に必要なものはすべてつぎこんだ”"
msgstr ""

#. Occurrence 5A_1:703:3959: scene=5A_1
#: 5A_1:703
msgctxt "text_id=3959 | speaker=unknown"
msgid "　自らの仕事っぷりに目を細める由里彦翁。"
msgstr ""

#. Occurrence 5A_1:708:3960: scene=5A_1
#: 5A_1:708
msgctxt "text_id=3960 | speaker=unknown"
msgid "　その自信を裏付けるように、開園当時の盛況はこの世の春だったという。"
msgstr ""

#. Occurrence 5A_1:713:3961: scene=5A_1
#: 5A_1:713
msgctxt "text_id=3961 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence 5A_1:748:3962: scene=5A_1
#: 5A_1:748
msgctxt "text_id=3962 | speaker=unknown"
msgid "　だがしかし。"
msgstr ""

#. Occurrence 5A_1:753:3963: scene=5A_1
#: 5A_1:753
msgctxt "text_id=3963 | speaker=unknown"
msgid "　夢と洒脱のバランスを、彼らは豪快に間違えていた。"
msgstr ""

#. Occurrence 5A_1:804:3964: scene=5A_1
#: 5A_1:804
msgctxt "text_id=3964 | speaker=unknown"
msgid "　あまりにも不細工、かつパチもん臭いオリジナルマスコット・キッツィーちゃん。"
msgstr ""

#. Occurrence 5A_1:809:3965: scene=5A_1
#: 5A_1:809
msgctxt "text_id=3965 | speaker=unknown"
msgid "　必要以上に園内をにぎわす焼きたてブレッドの売店。"
msgstr ""

#. Occurrence 5A_1:814:3966: scene=5A_1
#: 5A_1:814
msgctxt "text_id=3966 | speaker=unknown"
msgid "　８０年初頭から流行しだした大迷路を極限まで難解にしたミラーメイズ。"
msgstr ""

#. Occurrence 5A_1:834:3967: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3967 | speaker=unknown"
msgid "“キッツィーランドにドリームはない。"
msgstr ""

#. Occurrence 5A_1:834:3968: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3968 | speaker=unknown"
msgid "　ただ悪夢のようなユーモアがあるだけだ”"
msgstr ""

#. Occurrence 5A_1:840:3969: scene=5A_1
#: 5A_1:840
msgctxt "text_id=3969 | speaker=unknown"
msgid "　各種専門誌はこぞってキッツィーランドの欠点をあげつらい、客足は減少。"
msgstr ""

#. Occurrence 5A_1:845:3970: scene=5A_1
#: 5A_1:845
msgctxt "text_id=3970 | speaker=unknown"
msgid "　また、不運な事に母親とはぐれた六歳児が園内の施設で遭難し、衰弱死寸前で救出される事件まで起きてしまった。"
msgstr ""

#. Occurrence 5A_1:899:3971: scene=5A_1
#: 5A_1:899
msgctxt "text_id=3971 | speaker=unknown"
msgid "　開園から五年後の１９８６年。"
msgstr ""

#. Occurrence 5A_1:910:3972: scene=5A_1
#: 5A_1:910
msgctxt "text_id=3972 | speaker=unknown"
msgid "　悪化の一途をたどる経営不振、"
msgstr ""

#. Occurrence 5A_1:915:3973: scene=5A_1
#: 5A_1:915
msgctxt "text_id=3973 | speaker=unknown"
msgid "　キッツィーちゃんのブレイクに余生をかけていた由里彦翁の引退が重なり、キッツィーランドの運営は困難となった。"
msgstr ""

#. Occurrence 5A_1:921:3974: scene=5A_1
#: 5A_1:921
msgctxt "text_id=3974 | speaker=unknown"
msgid "　こうして、地域の人々に惜しまれながらも三咲市唯一の遊園地は、その短い一生を終えたのだった。"
msgstr ""

#. Occurrence 5A_1:945:3975: scene=5A_1
#: 5A_1:945
msgctxt "text_id=3975 | speaker=unknown"
msgid "　……また。"
msgstr ""

msgctxt "text_id=3976 | speaker=unknown"
msgid "　余談ではあるが、キッツィーちゃんをデザインしたパリ在住（自称）のアーティスト、トッキー・ユーリッヒ氏も、閉園を<悼|いた>むようにその筆を折ったという。"
msgstr ""

#. Occurrence 5A_1:983:3977: scene=5A_1
#: 5A_1:983
msgctxt "text_id=3977 | speaker=unknown"
msgid "　そして現在。"
msgstr ""

#. Occurrence 5A_1:1005:3978: scene=5A_1
#: 5A_1:1005
msgctxt "text_id=3978 | speaker=unknown"
msgid "　深夜零時のキッツィーランドは、かつての栄華など微塵も見られない。"
msgstr ""

#. Occurrence 5A_1:1010:3979: scene=5A_1
#: 5A_1:1010
msgctxt "text_id=3979 | speaker=unknown"
msgid "　オモチャ箱の片隅においやられた人形のように、ひとり寂しく、今も生き続ける町からの明かりに照らされている。"
msgstr ""

#. Occurrence 5A_1:1031:3980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0001; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1031
msgctxt "text_id=3980 | speaker=soujuurou"
msgid "「なるほど」"
msgstr ""

#. Occurrence 5A_1:1037:3981: scene=5A_1
#: 5A_1:1037
msgctxt "text_id=3981 | speaker=unknown"
msgid "　草十郎はぱたん、と来る途中で拾った『社木案内のしおり』を閉じた。"
msgstr ""

#. Occurrence 5A_1:1042:3982: scene=5A_1
#: 5A_1:1042
msgctxt "text_id=3982 | speaker=unknown"
msgid "　いまいち実感の湧かない歴史だが、これも<必衰|ひっすい>というヤツだろう、と納得する。"
msgstr ""

#. Occurrence 5A_1:1088:3983: scene=5A_1
#: 5A_1:1088
msgctxt "text_id=3983 | speaker=unknown"
msgid "　遊園地の正門は施錠されていなかった。"
msgstr ""

#. Occurrence 5A_1:1093:3984: scene=5A_1
#: 5A_1:1093
msgctxt "text_id=3984 | speaker=unknown"
msgid "　以前アルバイトにきた時、<鉄柵|いりぐち>は錆びた鎖によって施錠されていたが、今は外され、鉄柵も少しだけ開いている。"
msgstr ""

#. Occurrence 5A_1:1114:3985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0002; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1114
msgctxt "text_id=3985 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_1:1133:3986: scene=5A_1
#: 5A_1:1133
msgctxt "text_id=3986 | speaker=unknown"
msgid "　草十郎は手紙に描かれた地図にしたがって、ひょこっと園内に侵入する。"
msgstr ""

#. Occurrence 5A_1:1156:3987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0003; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1156
msgctxt "text_id=3987 | speaker=soujuurou"
msgid "「……急ぎの用なんだろうけど。こんな夜中に、なんなんだいったい」"
msgstr ""

#. Occurrence 5A_1:1162:3988: scene=5A_1
#: 5A_1:1162
msgctxt "text_id=3988 | speaker=unknown"
msgid "　らしくなく<愚|ぐ><痴|ち>を言う。"
msgstr ""

#. Occurrence 5A_1:1192:3989: scene=5A_1
#: 5A_1:1192
msgctxt "text_id=3989 | speaker=unknown"
msgid "　世間知らずな彼にでも、この行為がよくない事だと分かっているからだろう。"
msgstr ""

#. Occurrence 5A_1:1197:3990: scene=5A_1
#: 5A_1:1197
msgctxt "text_id=3990 | speaker=unknown"
msgid "　廃墟になったとはいえ、立ち入り禁止の遊園地に忍びこんでいる。"
msgstr ""

#. Occurrence 5A_1:1202:3991: scene=5A_1
#: 5A_1:1202
msgctxt "text_id=3991 | speaker=unknown"
msgid "　不法侵入、窃盗、泥棒。"
msgstr ""

#. Occurrence 5A_1:1208:3992: scene=5A_1
#: 5A_1:1208
msgctxt "text_id=3992 | speaker=unknown"
msgid "決して胸を張れる事ではなく、犯罪と言えば犯罪なのだが―――"
msgstr ""

#. Occurrence 5A_1:1229:3993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0004; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1229
msgctxt "text_id=3993 | speaker=soujuurou"
msgid "「……すまない、お金は払えないんだ。"
msgstr ""

#. Occurrence 5A_1:1235:3994: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0005; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1235
msgctxt "text_id=3994 | speaker=soujuurou"
msgid "　タダで入って申しわけない」"
msgstr ""

#. Occurrence 5A_1:1251:3995: scene=5A_1
#: 5A_1:1251
msgctxt "text_id=3995 | speaker=unknown"
msgid "　彼にとって後ろめたいのはその一点だけらしい。"
msgstr ""

#. Occurrence 5A_1:1256:3996: scene=5A_1
#: 5A_1:1256
msgctxt "text_id=3996 | speaker=unknown"
msgid "　目のペンキがいい感じで<融解|とけだ>しているキッツィーちゃん像に、ぱんぱん、と手を合わせる。"
msgstr ""

#. Occurrence 5A_1:1261:3997: scene=5A_1
#: 5A_1:1261
msgctxt "text_id=3997 | speaker=unknown"
msgid "　赤ペンキを<眼窩|がんか>から流すマスコットを通過して、草十郎は夜の遊園地へと歩き出した。"
msgstr ""

#. Occurrence 5A_1:1307:3998: scene=5A_1
#: 5A_1:1307
msgctxt "text_id=3998 | speaker=unknown"
msgid "　色落ちた建物。"
msgstr ""

#. Occurrence 5A_1:1312:3999: scene=5A_1
#: 5A_1:1312
msgctxt "text_id=3999 | speaker=unknown"
msgid "　錆び付いた機械の群。"
msgstr ""

#. Occurrence 5A_1:1317:4000: scene=5A_1
#: 5A_1:1317
msgctxt "text_id=4000 | speaker=unknown"
msgid "　もう時を刻むことのない、作り物の住人たち。"
msgstr ""

#. Occurrence 5A_1:1322:4001: scene=5A_1
#: 5A_1:1322
msgctxt "text_id=4001 | speaker=unknown"
msgid "　かつての栄華とのあまりの落差に、幽霊すらいたたまれず住み着かなくなったゴーストタウン。"
msgstr ""

#. Occurrence 5A_1:1342:4002: scene=5A_1
#: 5A_1:1342
msgctxt "text_id=4002 | speaker=unknown"
msgid "　―――まるで<童話|ユメ>の化石だ。"
msgstr ""

#. Occurrence 5A_1:1348:4003: scene=5A_1
#: 5A_1:1348
msgctxt "text_id=4003 | speaker=unknown"
msgid "　ここは<現実|人の手>によって造られながら、<現実|ひとびと>に置き去りにされた楽園の跡。"
msgstr ""

#. Occurrence 5A_1:1354:4004: scene=5A_1
#: 5A_1:1354
msgctxt "text_id=4004 | speaker=unknown"
msgid "　経済が安定し、"
msgstr ""

msgctxt "text_id=4005 | speaker=unknown"
msgid "　人々の生活水準は右肩あがりで、誰もが未来に不安を抱かなかった、狂騒の時代の遺物である。"
msgstr ""

#. Occurrence 5A_1:1419:4006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0006; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1419
msgctxt "text_id=4006 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_1:1425:4007: scene=5A_1
#: 5A_1:1425
msgctxt "text_id=4007 | speaker=unknown"
msgid "　白い息を吐きながら、草十郎は廃遊園地を歩いていく。"
msgstr ""

#. Occurrence 5A_1:1430:4008: scene=5A_1
#: 5A_1:1430
msgctxt "text_id=4008 | speaker=unknown"
msgid "　人気はないが、山中の闇に比べればそう怖くもない。"
msgstr ""

#. Occurrence 5A_1:1450:4009: scene=5A_1
#: 5A_1:1450
msgctxt "text_id=4009 | speaker=unknown"
msgid "　郊外といっても様々で、キッツィーランドは遊園地にしては珍しく、住宅地の<傍|そば>に造られている。"
msgstr ""

#. Occurrence 5A_1:1455:4010: scene=5A_1
#: 5A_1:1455
msgctxt "text_id=4010 | speaker=unknown"
msgid "　遊園地は林に囲まれているが、それも所詮は人工のもの。教室の窓を閉ざすカーテンとなんら変わりはない。"
msgstr ""

#. Occurrence 5A_1:1478:4011: scene=5A_1
#: 5A_1:1478
msgctxt "text_id=4011 | speaker=unknown"
msgid "　キッツィーランドを囲む鉄柵を越え、二十メートルほど造林された木々を抜ければ、簡単に見慣れた町並みに帰ることができる。"
msgstr ""

#. Occurrence 5A_1:1483:4012: scene=5A_1
#: 5A_1:1483
msgctxt "text_id=4012 | speaker=unknown"
msgid "　都会の人間にとって夜の遊園地は恐怖を喚起させるものだが、草十郎にとっては、この遊園地も駅前の喧噪も“怖さ”の深度は同じだった。"
msgstr ""

#. Occurrence 5A_10:63:4013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0000; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:63
msgctxt "text_id=4013 | speaker=aoko"
msgid "“結構きついかもね、あなたの役目”"
msgstr ""

#. Occurrence 5A_10:69:4014: scene=5A_10
#: 5A_10:69
msgctxt "text_id=4014 | speaker=unknown"
msgid "　草十郎にそう告げて、青子は静かに、可能なかぎり音を殺して走り出した。"
msgstr ""

#. Occurrence 5A_10:74:4015: scene=5A_10
#: 5A_10:74
msgctxt "text_id=4015 | speaker=unknown"
msgid "　二階のほぼ中心、渦の終点には草十郎だけが残っている。"
msgstr ""

#. Occurrence 5A_10:131:4016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0001; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:131
msgctxt "text_id=4016 | speaker=aoko"
msgid "“実を言うと、もう一つ用意しておいた仕掛けがあるの。"
msgstr ""

#. Occurrence 5A_10:137:4017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0002; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:137
msgctxt "text_id=4017 | speaker=aoko"
msgid "　自分でもやりすぎだって呆れたもんだけど、貴方が<遊園地|ここ>に来るのが遅かったから。ちょっと興に乗っちゃって”"
msgstr ""

#. Occurrence 5A_10:166:4018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0000; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:166
msgctxt "text_id=4018 | speaker=soujuurou"
msgid "“……？　仕掛けって、俺用の？”"
msgstr ""

#. Occurrence 5A_10:186:4019: scene=5A_10
#: 5A_10:186
msgctxt "text_id=4019 | speaker=unknown"
msgid "　リスのように首をかしげる草十郎に、青子はそ、と気軽に答えて、伏せておいた最後の切り札を提示した。"
msgstr ""

#. Occurrence 5A_10:234:4020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0003; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:234
msgctxt "text_id=4020 | speaker=aoko"
msgid "“地下の<支柱|はしら>に着火型の、ちょっとした魔術式を刻んでおいたの。中心の柱に点火することで、連鎖的に他の柱に仕掛けた魔術も起動する。"
msgstr ""

#. Occurrence 5A_10:240:4021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0004; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:240
msgctxt "text_id=4021 | speaker=aoko"
msgid "　ジャミングを食らう前に作ったものだから、直接魔力をたたき込めば一気に、こう、いくわ”"
msgstr ""

#. Occurrence 5A_10:246:4022: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0001; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:246
msgctxt "text_id=4022 | speaker=soujuurou"
msgid "“………………”"
msgstr ""

#. Occurrence 5A_10:251:4023: scene=5A_10
#: 5A_10:251
msgctxt "text_id=4023 | speaker=unknown"
msgid "　具体的な表現を避ける青子に、一抹の不安を隠せない草十郎なのだった。"
msgstr ""

#. Occurrence 5A_10:291:4024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0002; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:291
msgctxt "text_id=4024 | speaker=soujuurou"
msgid "“……蒼崎。こう、じゃ分からない。できるだけ明確に、どこまで爆破する気だったのか白状してくれ。"
msgstr ""

#. Occurrence 5A_10:297:4025: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0003; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:297
msgctxt "text_id=4025 | speaker=soujuurou"
msgid "　あと、もしかして俺、早まったか？”"
msgstr ""

#. Occurrence 5A_10:331:4026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0005; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:331
msgctxt "text_id=4026 | speaker=aoko"
msgid "“いや、その……単なる保険って言うか。"
msgstr ""

#. Occurrence 5A_10:337:4027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0006; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:337
msgctxt "text_id=4027 | speaker=aoko"
msgid "　追いかけっこの途中でアンタを見失ったら、いっそ建物ごと爆破しちゃおうかなー、って”"
msgstr ""

#. Occurrence 5A_10:525:4028: scene=5A_10
#: 5A_10:525
msgctxt "text_id=4028 | speaker=unknown"
msgid "　なにごとも徹底しておくものねー、と照れ笑いをしながら頭を<掻|か>く青子。"
msgstr ""

#. Occurrence 5A_10:532:4029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0004; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:532
msgctxt "text_id=4029 | speaker=soujuurou"
msgid "“いくらなんでも徹底しすぎてる！”"
msgstr ""

#. Occurrence 5A_10:538:4030: scene=5A_10
#: 5A_10:538
msgctxt "text_id=4030 | speaker=unknown"
msgid "　そんな青子の暴虐ぶりに、草十郎は状況を忘れて、心底からの感想で抗議した。"
msgstr ""

#. Occurrence 5A_10:589:4031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0007; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:589
msgctxt "text_id=4031 | speaker=aoko"
msgid "「……なによ。いいじゃない、そのおかげでなんとかなりそうなんだから」"
msgstr ""

#. Occurrence 5A_10:595:4032: scene=5A_10
#: 5A_10:595
msgctxt "text_id=4032 | speaker=unknown"
msgid "　……などと。"
msgstr ""

#. Occurrence 5A_10:600:4033: scene=5A_10
#: 5A_10:600
msgctxt "text_id=4033 | speaker=unknown"
msgid "　草十郎が聞いたら<協力|けいかく>を白紙に戻しかねない<愚|グ><痴|チ>をこぼしつつ、青子は通路をひた走る。"
msgstr ""

#. Occurrence 5A_10:633:4034: scene=5A_10
#: 5A_10:633
msgctxt "text_id=4034 | speaker=unknown"
msgid "　作戦はシンプルだ。"
msgstr ""

#. Occurrence 5A_10:649:4035: scene=5A_10
#: 5A_10:649
msgctxt "text_id=4035 | speaker=unknown"
msgid "　青子は右に曲がる抜け道を利用し、人形を避けて地下一階まで移動。"
msgstr ""

#. Occurrence 5A_10:654:4036: scene=5A_10
#: 5A_10:654
msgctxt "text_id=4036 | speaker=unknown"
msgid "　地下中央の柱まで辿り着き、仕掛けておいた魔術式に直接魔力を注入し、脱出する。"
msgstr ""

#. Occurrence 5A_10:659:4037: scene=5A_10
#: 5A_10:659
msgctxt "text_id=4037 | speaker=unknown"
msgid "　魔術式が起動し、崩壊がミラーハウス全体に広がるまで早くて一分、その後の倒壊まであと一分。"
msgstr ""

#. Occurrence 5A_10:675:4038: scene=5A_10
#: 5A_10:675
msgctxt "text_id=4038 | speaker=unknown"
msgid "　……厳しいが、迷路を暗記している青子ならギリギリで脱出できるスケジュールだ。"
msgstr ""

#. Occurrence 5A_10:721:4039: scene=5A_10
#: 5A_10:721
msgctxt "text_id=4039 | speaker=unknown"
msgid "　人形による入り口の<結界|かべ>は、柱の連鎖爆破で吹き飛ぶ程度だろうと青子は予想している。"
msgstr ""

#. Occurrence 5A_10:726:4040: scene=5A_10
#: 5A_10:726
msgctxt "text_id=4040 | speaker=unknown"
msgid "　仮にもっと上等な結界だとしても、建物全体が歪んでしまえば消えざるを得ない。地下の魔術式さえ起動させれば草十郎の脱出路は確保できる。"
msgstr ""

#. Occurrence 5A_10:761:4041: scene=5A_10
#: 5A_10:761
msgctxt "text_id=4041 | speaker=unknown"
msgid "　最後に、肝心の標的について。"
msgstr ""

#. Occurrence 5A_10:779:4042: scene=5A_10
#: 5A_10:779
msgctxt "text_id=4042 | speaker=unknown"
msgid "　あのオートマタは遮蔽物だらけの<この場所|ミラーハウス>を苦手としている。アレは構造上、この地形での全速移動はできない。"
msgstr ""

#. Occurrence 5A_10:784:4043: scene=5A_10
#: 5A_10:784
msgctxt "text_id=4043 | speaker=unknown"
msgid "　建物が崩壊しだした時に二階の中心付近にいれば、倒壊に巻きこまれてあえなくスクラップだ。"
msgstr ""

#. Occurrence 5A_10:801:4044: scene=5A_10
#: 5A_10:801
msgctxt "text_id=4044 | speaker=unknown"
msgid "　なので問題は、青子が地下に行くまで、いかにして人形を二階に押しとどめておくか、という事だった。"
msgstr ""

#. Occurrence 5A_10:822:4045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4045 | speaker=aoko"
msgid "“……アテにしたからね、静希君。"
msgstr ""

#. Occurrence 5A_10:822:4046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4046 | speaker=aoko"
msgid "　せめて三分ぐらいは引き付けて―――”"
msgstr ""

#. Occurrence 5A_10:883:4047: scene=5A_10
#: 5A_10:883
msgctxt "text_id=4047 | speaker=unknown"
msgid "　青子が地下に到達し、魔術式を起動させるまで人形を引き付けてくれるなら文句なし。"
msgstr ""

#. Occurrence 5A_10:888:4048: scene=5A_10
#: 5A_10:888
msgctxt "text_id=4048 | speaker=unknown"
msgid "　もしくは、せめて一階の大広間に下りるまで囮になってくれれば、この作戦は上手くいく。"
msgstr ""

#. Occurrence 5A_10:908:4049: scene=5A_10
#: 5A_10:908
msgctxt "text_id=4049 | speaker=unknown"
msgid "　草十郎が危険なのは百も承知だが、<青子|じぶん>からあれだけ逃げ回った草十郎の運と脚力は馬鹿にできない。"
msgstr ""

#. Occurrence 5A_10:935:4050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4050 | speaker=aoko"
msgid "“……うん、ただ逃げるだけなら、もしかして―――"
msgstr ""

#. Occurrence 5A_10:935:4051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4051 | speaker=aoko"
msgid "　トンデモない事をしてくれるかも、アイツ”"
msgstr ""

#. Occurrence 5A_10:1017:4052: scene=5A_10
#: 5A_10:1017
msgctxt "text_id=4052 | speaker=unknown"
msgid "　などと。迷路の横道を走りながら、青子はつい、ここには居ない草十郎に期待をよせたのだった。"
msgstr ""

#. Occurrence 5A_10:1118:4053: scene=5A_10
#: 5A_10:1118
msgctxt "text_id=4053 | speaker=unknown"
msgid "　―――一方。"
msgstr ""

#. Occurrence 5A_10:1124:4054: scene=5A_10
#: 5A_10:1124
msgctxt "text_id=4054 | speaker=unknown"
msgid "　そんな青子の声が聞こえるはずもなく、草十郎は必死の追いかけっこに挑もうとしていた。"
msgstr ""

#. Occurrence 5A_10:1129:4055: scene=5A_10
#: 5A_10:1129
msgctxt "text_id=4055 | speaker=unknown"
msgid "　彼は自分なりの方法で<心|む><臓|ね>の動悸を押さえつける。"
msgstr ""

#. Occurrence 5A_10:1134:4056: scene=5A_10
#: 5A_10:1134
msgctxt "text_id=4056 | speaker=unknown"
msgid "　大事なのは落ち着く事だ。作戦自体はシンプルで、そう難しいものじゃない。"
msgstr ""

#. Occurrence 5A_10:1139:4057: scene=5A_10
#: 5A_10:1139
msgctxt "text_id=4057 | speaker=unknown"
msgid "　青子の指示は短く、実に分かりやすかった。"
msgstr ""

#. Occurrence 5A_10:1229:4058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0010; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1229
msgctxt "text_id=4058 | speaker=aoko"
msgid "“十メートルぐらいの距離を保って、できるだけゆっくり通路を三、四周する事。"
msgstr ""

#. Occurrence 5A_10:1235:4059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0011; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1235
msgctxt "text_id=4059 | speaker=aoko"
msgid "　横道は鏡のつなぎ目で覚えて。ここなら左回りで六、三、七、二枚目にあるから、そこをぐるぐる回ってれば比較的安全よ”"
msgstr ""

#. Occurrence 5A_10:1255:4060: scene=5A_10
#: 5A_10:1255
msgctxt "text_id=4060 | speaker=unknown"
msgid "　……要は円を描くマラソンである。"
msgstr ""

#. Occurrence 5A_10:1260:4061: scene=5A_10
#: 5A_10:1260
msgctxt "text_id=4061 | speaker=unknown"
msgid "　人形からは伸びる腕だけが届いて、ぎりぎり追跡できるじれったい距離をキープしていれば、相手はしつこく追いかけてくる筈だ。"
msgstr ""

#. Occurrence 5A_10:1265:4062: scene=5A_10
#: 5A_10:1265
msgctxt "text_id=4062 | speaker=unknown"
msgid "　単純作業だが、草十郎にとっては命懸けの囮役である。"
msgstr ""

#. Occurrence 5A_10:1270:4063: scene=5A_10
#: 5A_10:1270
msgctxt "text_id=4063 | speaker=unknown"
msgid "　加えて、建物が揺れだしたら全力で出口まで走れ、という無茶な注文付き。"
msgstr ""

#. Occurrence 5A_10:1362:4064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0005; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1362
msgctxt "text_id=4064 | speaker=soujuurou"
msgid "「……けっこうじゃなくて、かなりきついんじゃないかな、コレは」"
msgstr ""

#. Occurrence 5A_10:1430:4065: scene=5A_10
#: 5A_10:1430
msgctxt "text_id=4065 | speaker=unknown"
msgid "　おびえおびえのぎこちない動作で、草十郎は曲がり角から顔を出す。"
msgstr ""

#. Occurrence 5A_10:1435:4066: scene=5A_10
#: 5A_10:1435
msgctxt "text_id=4066 | speaker=unknown"
msgid "　……突き当たりの曲がり角からは例のオルゴールの音。"
msgstr ""

#. Occurrence 5A_10:1440:4067: scene=5A_10
#: 5A_10:1440
msgctxt "text_id=4067 | speaker=unknown"
msgid "　まずはここで顔を合わせて、右側のショートカットを抜けて、ループ状の鬼ごっこを開始しなくてはいけない。"
msgstr ""

#. Occurrence 5A_10:1476:4068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0006; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1476
msgctxt "text_id=4068 | speaker=soujuurou"
msgid "「…………！」"
msgstr ""

#. Occurrence 5A_10:1548:4069: scene=5A_10
#: 5A_10:1548
msgctxt "text_id=4069 | speaker=unknown"
msgid "　来た、と身構える。"
msgstr ""

#. Occurrence 5A_10:1553:4070: scene=5A_10
#: 5A_10:1553
msgctxt "text_id=4070 | speaker=unknown"
msgid "　引きつけて、引きつけて。"
msgstr ""

#. Occurrence 5A_10:1558:4071: scene=5A_10
#: 5A_10:1558
msgctxt "text_id=4071 | speaker=unknown"
msgid "　いつ伸びてくるか分からない腕におびえながら、草十郎は青子の説明を思いかえ―――"
msgstr ""

#. Occurrence 5A_10:1658:4072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0007; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1658
msgctxt "text_id=4072 | speaker=soujuurou"
msgid "「…………あれ？」"
msgstr ""

#. Occurrence 5A_10:1664:4073: scene=5A_10
#: 5A_10:1664
msgctxt "text_id=4073 | speaker=unknown"
msgid "　ところで。"
msgstr ""

#. Occurrence 5A_10:1669:4074: scene=5A_10
#: 5A_10:1669
msgctxt "text_id=4074 | speaker=unknown"
msgid "　一番はじめの横道は、何枚目だったっけ？"
msgstr ""

#. Occurrence 5A_10:1674:4075: scene=5A_10
#: 5A_10:1674
msgctxt "text_id=4075 | speaker=unknown"
msgid "　三枚目か、六枚目か、九枚目か―――"
msgstr ""

#. Occurrence 5A_10:1705:4076: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0008; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1705
msgctxt "text_id=4076 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_10:1711:4077: scene=5A_10
#: 5A_10:1711
msgctxt "text_id=4077 | speaker=unknown"
msgid "　違う。"
msgstr ""

#. Occurrence 5A_10:1716:4078: scene=5A_10
#: 5A_10:1716
msgctxt "text_id=4078 | speaker=unknown"
msgid "　なんか、全部違う気がする。"
msgstr ""

#. Occurrence 5A_10:1721:4079: scene=5A_10
#: 5A_10:1721
msgctxt "text_id=4079 | speaker=unknown"
msgid "　さっきまでは完璧に思い返せたのに、緊張からか、草十郎の頭はぐるんぐるんに回りはじめ―――"
msgstr ""

#. Occurrence 5A_10:1765:4080: scene=5A_10
#: 5A_10:1765
msgctxt "text_id=4080 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence 5A_10:1772:4081: scene=5A_10
#: 5A_10:1772
msgctxt "text_id=4081 | speaker=unknown"
msgid "　草十郎は前方にあった追跡者の<物音|プレッシャー>が、唐突に離れていく事に気が付いた。"
msgstr ""

#. Occurrence 5A_10:1777:4082: scene=5A_10
#: 5A_10:1777
msgctxt "text_id=4082 | speaker=unknown"
msgid "　それも予想外のスピードで、ガシャガシャと音をたてながら。"
msgstr ""

#. Occurrence 5A_10:2011:4083: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0009; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2011
msgctxt "text_id=4083 | speaker=soujuurou"
msgid "「……なに？」"
msgstr ""

#. Occurrence 5A_10:2017:4084: scene=5A_10
#: 5A_10:2017
msgctxt "text_id=4084 | speaker=unknown"
msgid "　異様な人形のシルエットに、<唖然|あぜん>とする草十郎。"
msgstr ""

#. Occurrence 5A_10:2022:4085: scene=5A_10
#: 5A_10:2022
msgctxt "text_id=4085 | speaker=unknown"
msgid "　あろうことか、美しい少女のカタチをした人形は唐突に、"
msgstr ""

#. Occurrence 5A_10:2076:4086: scene=5A_10
#: 5A_10:2076
msgctxt "text_id=4086 | speaker=unknown"
msgid "　構造的にあり得ない変形をして、"
msgstr ""

msgctxt "text_id=4087 | speaker=unknown"
msgid "　一階に下りていった“本命”へと踵を返した。"
msgstr ""

#. Occurrence 5A_10:2200:4088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0010; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2200
msgctxt "text_id=4088 | speaker=soujuurou"
msgid "「あ―――いや、それは」"
msgstr ""

#. Occurrence 5A_10:2206:4089: scene=5A_10
#: 5A_10:2206
msgctxt "text_id=4089 | speaker=unknown"
msgid "　まずいな、と呟いて、途方にくれる草十郎。"
msgstr ""

#. Occurrence 5A_10:2211:4090: scene=5A_10
#: 5A_10:2211
msgctxt "text_id=4090 | speaker=unknown"
msgid "　失敗を悔やむ時間すらない。人形はもう影もカタチもなく、草十郎の前から走り去ってしまったのだ。"
msgstr ""

#. Occurrence 5A_10:2216:4091: scene=5A_10
#: 5A_10:2216
msgctxt "text_id=4091 | speaker=unknown"
msgid "“役に立つから見逃してくれ”"
msgstr ""

#. Occurrence 5A_10:2221:4092: scene=5A_10
#: 5A_10:2221
msgctxt "text_id=4092 | speaker=unknown"
msgid "　……などと言っておいて、コレでは立場も何もない。"
msgstr ""

#. Occurrence 5A_10:2292:4093: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0012; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2292
msgctxt "text_id=4093 | speaker=soujuurou"
msgid "「…………さて、自分はこれからどうしよう」"
msgstr ""

#. Occurrence 5A_10:2298:4094: scene=5A_10
#: 5A_10:2298
msgctxt "text_id=4094 | speaker=unknown"
msgid "　ひとり、困ったように首をかしげる。"
msgstr ""

#. Occurrence 5A_10:2303:4095: scene=5A_10
#: 5A_10:2303
msgctxt "text_id=4095 | speaker=unknown"
msgid "　草十郎は<傍|かたわ>らに青子がいるかのように、暗い通路に語りかけた。"
msgstr ""

#. Occurrence 5A_10:2391:4096: scene=5A_10
#: 5A_10:2391
msgctxt "text_id=4096 | speaker=unknown"
msgid "　同時刻。"
msgstr ""

msgctxt "text_id=4097 | speaker=unknown"
msgid "青子は一階の広間に辿り着いた時、正しく状況を受け入れた。"
msgstr ""

#. Occurrence 5A_10:2413:4098: scene=5A_10
#: 5A_10:2413
msgctxt "text_id=4098 | speaker=unknown"
msgid "　耳を澄ませるまでもない。"
msgstr ""

#. Occurrence 5A_10:2418:4099: scene=5A_10
#: 5A_10:2418
msgctxt "text_id=4099 | speaker=unknown"
msgid "　このアトラクションが<栄華|えいが>を誇っていた頃ですら、なかったであろう<騒音|にぎわい>。"
msgstr ""

#. Occurrence 5A_10:2423:4100: scene=5A_10
#: 5A_10:2423
msgctxt "text_id=4100 | speaker=unknown"
msgid "　ハリネズミのお化けが鏡をけずりながら大挙して迫ってくるような、そんな、絶望に似たノイズが聞こえてくる。"
msgstr ""

#. Occurrence 5A_10:2453:4101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0012; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2453
msgctxt "text_id=4101 | speaker=aoko"
msgid "「…………あのドジ。三分どころか十秒<保|も>たないって、どういうコトよ」"
msgstr ""

#. Occurrence 5A_10:2459:4102: scene=5A_10
#: 5A_10:2459
msgctxt "text_id=4102 | speaker=unknown"
msgid "　時間を稼ぐ、どころの話じゃない。"
msgstr ""

#. Occurrence 5A_10:2464:4103: scene=5A_10
#: 5A_10:2464
msgctxt "text_id=4103 | speaker=unknown"
msgid "　本当、ただ逃げるだけなのにトンデモない事をしてくれやがった、と悪態のひとつもつきたくなる。"
msgstr ""

#. Occurrence 5A_10:2502:4104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0013; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2502
msgctxt "text_id=4104 | speaker=aoko"
msgid "「―――複数の足音―――ってコトは、二足から多脚に切り替えたのね」"
msgstr ""

#. Occurrence 5A_10:2508:4105: scene=5A_10
#: 5A_10:2508
msgctxt "text_id=4105 | speaker=unknown"
msgid "　反響する何人もの足音。"
msgstr ""

#. Occurrence 5A_10:2513:4106: scene=5A_10
#: 5A_10:2513
msgctxt "text_id=4106 | speaker=unknown"
msgid "　それだけで青子は、通路を走る、六足歩行の巨大な蜘蛛を予想した。"
msgstr ""

#. Occurrence 5A_10:2615:4107: scene=5A_10
#: 5A_10:2615
msgctxt "text_id=4107 | speaker=unknown"
msgid "　敵の移動速度が今までとは比較にならないのは当然だ。"
msgstr ""

#. Occurrence 5A_10:2620:4108: scene=5A_10
#: 5A_10:2620
msgctxt "text_id=4108 | speaker=unknown"
msgid "　反響定位による環境把握は暗闇でこそ生きる。"
msgstr ""

#. Occurrence 5A_10:2625:4109: scene=5A_10
#: 5A_10:2625
msgctxt "text_id=4109 | speaker=unknown"
msgid "　鏡の迷路において、視力に頼る人間より、自動人形は何倍も精確に周囲を把握している。"
msgstr ""

#. Occurrence 5A_10:2630:4110: scene=5A_10
#: 5A_10:2630
msgctxt "text_id=4110 | speaker=unknown"
msgid "　それでも青子に追いつけなかったのは、たんに二本足では小刻みな方向転換に耐えられなかったからだ。"
msgstr ""

#. Occurrence 5A_10:2635:4111: scene=5A_10
#: 5A_10:2635
msgctxt "text_id=4111 | speaker=unknown"
msgid "　多脚という安定性を持てば、そのスピードは人間を遥かに凌駕する。"
msgstr ""

#. Occurrence 5A_10:2732:4112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0014; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2732
msgctxt "text_id=4112 | speaker=aoko"
msgid "“どうする、どうする、どうする―――！”"
msgstr ""

#. Occurrence 5A_10:2738:4113: scene=5A_10
#: 5A_10:2738
msgctxt "text_id=4113 | speaker=unknown"
msgid "　混乱する思考のまま、迅速に打開策を模索する。"
msgstr ""

#. Occurrence 5A_10:2743:4114: scene=5A_10
#: 5A_10:2743
msgctxt "text_id=4114 | speaker=unknown"
msgid "　はっきりしているのは、ここが勝敗の分かれ目というコトだけ。"
msgstr ""

#. Occurrence 5A_10:2770:4115: scene=5A_10
#: 5A_10:2770
msgctxt "text_id=4115 | speaker=unknown"
msgid "　このまま足を止めていれば十秒ほどで追いつかれる。"
msgstr ""

#. Occurrence 5A_10:2775:4116: scene=5A_10
#: 5A_10:2775
msgctxt "text_id=4116 | speaker=unknown"
msgid "　入り口の<結界|かべ>は今の青子でも小指一本で解除できる<稚拙さ|レベル>だ。魔術と言わず、魔力を流すだけで中和できる。"
msgstr ""

#. Occurrence 5A_10:2780:4117: scene=5A_10
#: 5A_10:2780
msgctxt "text_id=4117 | speaker=unknown"
msgid "　青子が全力で走り続けられるのは三分強。"
msgstr ""

#. Occurrence 5A_10:2785:4118: scene=5A_10
#: 5A_10:2785
msgctxt "text_id=4118 | speaker=unknown"
msgid "　<我慢|スタミナ>比べはどう見ても人形に分がある。"
msgstr ""

#. Occurrence 5A_10:2848:4119: scene=5A_10
#: 5A_10:2848
msgctxt "text_id=4119 | speaker=unknown"
msgid "　考えられる選択肢は三つ。"
msgstr ""

#. Occurrence 5A_10:2853:4120: scene=5A_10
#: 5A_10:2853
msgctxt "text_id=4120 | speaker=unknown"
msgid "　一つ、出口は目の前、外に逃げる。"
msgstr ""

#. Occurrence 5A_10:2858:4121: scene=5A_10
#: 5A_10:2858
msgctxt "text_id=4121 | speaker=unknown"
msgid "　二つ、二階より複雑な一階の迷路に身を隠す。"
msgstr ""

#. Occurrence 5A_10:2863:4122: scene=5A_10
#: 5A_10:2863
msgctxt "text_id=4122 | speaker=unknown"
msgid "　三つ、地下に走って、袋のネズミとばかりに、あの人形に追いつめられる―――"
msgstr ""

#. Occurrence 5A_10:2898:4123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0015; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2898
msgctxt "text_id=4123 | speaker=aoko"
msgid "「―――なんだ、考えるまでもない」"
msgstr ""

#. Occurrence 5A_10:2904:4124: scene=5A_10
#: 5A_10:2904
msgctxt "text_id=4124 | speaker=unknown"
msgid "　決断はまたたきの内に。"
msgstr ""

#. Occurrence 5A_10:2909:4125: scene=5A_10
#: 5A_10:2909
msgctxt "text_id=4125 | speaker=unknown"
msgid "　立ちつくしていた両足には確かな力。"
msgstr ""

#. Occurrence 5A_10:2914:4126: scene=5A_10
#: 5A_10:2914
msgctxt "text_id=4126 | speaker=unknown"
msgid "　嵐はもう頭上に迫っている。"
msgstr ""

#. Occurrence 5A_10:2950:4127: scene=5A_10
#: 5A_10:2950
msgctxt "text_id=4127 | speaker=unknown"
msgid "　意を決して、少女は眼下の暗闇に向かって走りだした。"
msgstr ""

#. Occurrence 5A_11:56:4128: scene=5A_11
#: 5A_11:56
msgctxt "text_id=4128 | speaker=unknown"
msgid "　　何であれ、<終局|フィナーレ>は華やかに。"
msgstr ""

#. Occurrence 5A_11:61:4129: scene=5A_11
#: 5A_11:61
msgctxt "text_id=4129 | speaker=unknown"
msgid "　　鏡の城に最後の見せ場が訪れる。"
msgstr ""

#. Occurrence 5A_11:83:4130: scene=5A_11
#: 5A_11:83
msgctxt "text_id=4130 | speaker=unknown"
msgid "　入場者は二人プラス一体。"
msgstr ""

#. Occurrence 5A_11:88:4131: scene=5A_11
#: 5A_11:88
msgctxt "text_id=4131 | speaker=unknown"
msgid "　魔法使いの少女は城の心臓部である地下に走り、"
msgstr ""

#. Occurrence 5A_11:93:4132: scene=5A_11
#: 5A_11:93
msgctxt "text_id=4132 | speaker=unknown"
msgid "　自律するアンティークは少女を追いかけて魔のダンジョンへ。"
msgstr ""

#. Occurrence 5A_11:306:4133: scene=5A_11
#: 5A_11:306
msgctxt "text_id=4133 | speaker=unknown"
msgid "　一分の<後|のち>、城には微弱な青い電荷が走り抜けた。"
msgstr ""

#. Occurrence 5A_11:312:4134: scene=5A_11
#: 5A_11:312
msgctxt "text_id=4134 | speaker=unknown"
msgid "　地下一階、最深最奥のメインピラー。"
msgstr ""

#. Occurrence 5A_11:317:4135: scene=5A_11
#: 5A_11:317
msgctxt "text_id=4135 | speaker=unknown"
msgid "　城を支えているワケではないけれど、象徴であった柱を、少女は渾身の魔力をこめた拳で打ち叩いた。"
msgstr ""

#. Occurrence 5A_11:473:4136: scene=5A_11
#: 5A_11:473
msgctxt "text_id=4136 | speaker=unknown"
msgid "　この一撃で鏡の城は崩れ去る。"
msgstr ""

#. Occurrence 5A_11:478:4137: scene=5A_11
#: 5A_11:478
msgctxt "text_id=4137 | speaker=unknown"
msgid "　そんなイメージの元に放った<正拳|ストレート>は、数秒の後、イメージを真実に変換する。"
msgstr ""

#. Occurrence 5A_11:483:4138: scene=5A_11
#: 5A_11:483
msgctxt "text_id=4138 | speaker=unknown"
msgid "　城の四方の柱、地盤に刻まれた魔力を圧縮、解放させるだけの単純な発火魔術。"
msgstr ""

#. Occurrence 5A_11:519:4139: scene=5A_11
#: 5A_11:519
msgctxt "text_id=4139 | speaker=unknown"
msgid "　仕掛けは電荷をスイッチにして、ほぼ同時に発動し―――"
msgstr ""

#. Occurrence 5A_11:864:4140: scene=5A_11
#: 5A_11:864
msgctxt "text_id=4140 | speaker=unknown"
msgid "　<緩|ゆる>やかに、<速|すみ>やかに。"
msgstr ""

#. Occurrence 5A_11:869:4141: scene=5A_11
#: 5A_11:869
msgctxt "text_id=4141 | speaker=unknown"
msgid "　二年もの歳月、かたくなに滅びを<拒|こば>んだ夢の城に、臨終の<槌|つち>が下ろされる。"
msgstr ""

#. Occurrence 5A_11:1037:4142: scene=5A_11
#: 5A_11:1037
msgctxt "text_id=4142 | speaker=unknown"
msgid "　―――それは、喜びに似た音だった。"
msgstr ""

#. Occurrence 5A_11:1043:4143: scene=5A_11
#: 5A_11:1043
msgctxt "text_id=4143 | speaker=unknown"
msgid "　とうに命を失い、訪れる者のいなくなった鏡の城が迎えた、最後にして最大のショウタイム。"
msgstr ""

#. Occurrence 5A_11:1048:4144: scene=5A_11
#: 5A_11:1048
msgctxt "text_id=4144 | speaker=unknown"
msgid "　青子の魔力は電荷となって支柱に刻まれた魔術式を起動させ、連鎖的に、建物の息の根を止めていく。"
msgstr ""

#. Occurrence 5A_11:1183:4145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0000; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1183
msgctxt "text_id=4145 | speaker=aoko"
msgid "「……ごくろうさま。"
msgstr ""

#. Occurrence 5A_11:1189:4146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0001; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1189
msgctxt "text_id=4146 | speaker=aoko"
msgid "　でも、思ってたよりくたびれてたのね。これじゃ一分<保|も>つかどうか」"
msgstr ""

#. Occurrence 5A_11:1199:4147: scene=5A_11
#: 5A_11:1199
msgctxt "text_id=4147 | speaker=unknown"
msgid "　地下一階の中央広場。"
msgstr ""

#. Occurrence 5A_11:1204:4148: scene=5A_11
#: 5A_11:1204
msgctxt "text_id=4148 | speaker=unknown"
msgid "　呼吸を整えながら、青子は魔術刻印をフル回転させる。"
msgstr ""

#. Occurrence 5A_11:1209:4149: scene=5A_11
#: 5A_11:1209
msgctxt "text_id=4149 | speaker=unknown"
msgid "　魔術式を組めないのを承知の上で、その両手に青い光をまとわせる。"
msgstr ""

#. Occurrence 5A_11:1393:4150: scene=5A_11
#: 5A_11:1393
msgctxt "text_id=4150 | speaker=unknown"
msgid "　……乱れた呼吸は簡単には治まらない。"
msgstr ""

#. Occurrence 5A_11:1398:4151: scene=5A_11
#: 5A_11:1398
msgctxt "text_id=4151 | speaker=unknown"
msgid "　地下一階の中心。"
msgstr ""

#. Occurrence 5A_11:1403:4152: scene=5A_11
#: 5A_11:1403
msgctxt "text_id=4152 | speaker=unknown"
msgid "　中心の柱にたどり着くまで、彼女は追跡者に背中を見せることなく走りきったのだ。百メートル走十三秒の俊足は間違いなく自己記録を更新した。"
msgstr ""

#. Occurrence 5A_11:1408:4153: scene=5A_11
#: 5A_11:1408
msgctxt "text_id=4153 | speaker=unknown"
msgid "　その先に待っているのが<こ|・><の|・><状|・><況|・>だと承知した上で、あえぐ心臓に鞭を打った。"
msgstr ""

#. Occurrence 5A_11:1519:4154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0002; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1519
msgctxt "text_id=4154 | speaker=aoko"
msgid "「……入れば追ってくる。地下に行けば逃げられない。"
msgstr ""

#. Occurrence 5A_11:1525:4155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0003; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1525
msgctxt "text_id=4155 | speaker=aoko"
msgid "　当然よね。最後まで逃げ回ろうなんて、虫のいい話だった」"
msgstr ""

#. Occurrence 5A_11:1531:4156: scene=5A_11
#: 5A_11:1531
msgctxt "text_id=4156 | speaker=unknown"
msgid "　反省するわ、と青子は物言わぬ<人形|じぶん>に語りかける。"
msgstr ""

#. Occurrence 5A_11:1675:4157: scene=5A_11
#: 5A_11:1675
msgctxt "text_id=4157 | speaker=unknown"
msgid "　城が完全に崩れるまで残り一分。"
msgstr ""

#. Occurrence 5A_11:1680:4158: scene=5A_11
#: 5A_11:1680
msgctxt "text_id=4158 | speaker=unknown"
msgid "　ここに留まるかぎり、どちらも瓦礫の下敷きだ。"
msgstr ""

#. Occurrence 5A_11:1685:4159: scene=5A_11
#: 5A_11:1685
msgctxt "text_id=4159 | speaker=unknown"
msgid "　あの人形にとってはそれでオッケー。"
msgstr ""

#. Occurrence 5A_11:1690:4160: scene=5A_11
#: 5A_11:1690
msgctxt "text_id=4160 | speaker=unknown"
msgid "　もとより命のないモノ、標的である蒼崎青子を殺す事だけが彼女の<目的|ねがい>なのだから。"
msgstr ""

#. Occurrence 5A_11:1744:4161: scene=5A_11
#: 5A_11:1744
msgctxt "text_id=4161 | speaker=unknown"
msgid "　……そう。"
msgstr ""

#. Occurrence 5A_11:1749:4162: scene=5A_11
#: 5A_11:1749
msgctxt "text_id=4162 | speaker=unknown"
msgid "　要するに、敵だけが初めから必死だった。"
msgstr ""

#. Occurrence 5A_11:1754:4163: scene=5A_11
#: 5A_11:1754
msgctxt "text_id=4163 | speaker=unknown"
msgid "　決意の甘さに<憤慨|ふんがい>する。"
msgstr ""

#. Occurrence 5A_11:1759:4164: scene=5A_11
#: 5A_11:1759
msgctxt "text_id=4164 | speaker=unknown"
msgid "　もろとも死ぬ事さえいとわない相手に尻尾を巻くなんて、あまりに自分らしくなかったな、と。"
msgstr ""

#. Occurrence 5A_11:1818:4165: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4165 | speaker=unknown"
msgid "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr ""

#. Occurrence 5A_11:1818:4166: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4166 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr ""

#. Occurrence 5A_11:1839:4167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0004; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1839
msgctxt "text_id=4167 | speaker=aoko"
msgid "“……ふん。そもそも自爆覚悟じゃない、アレ。"
msgstr ""

#. Occurrence 5A_11:1845:4168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0005; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1845
msgctxt "text_id=4168 | speaker=aoko"
msgid "　六足歩行とフィンの一撃は<使|・><い|・><す|・><ぎ|・>よ。もう呪詛による魔力補給じゃ間に合わない”"
msgstr ""

#. Occurrence 5A_11:1867:4169: scene=5A_11
#: 5A_11:1867
msgctxt "text_id=4169 | speaker=unknown"
msgid "　……そう。永久機関と言っても、それは魔力の消費量を抑えてこその永久機関だ。"
msgstr ""

#. Occurrence 5A_11:1872:4170: scene=5A_11
#: 5A_11:1872
msgctxt "text_id=4170 | speaker=unknown"
msgid "　あれだけの機巧を使えば燃料はすぐにカラになり、電力である呪詛を回す事もできなくなる。"
msgstr ""

#. Occurrence 5A_11:1877:4171: scene=5A_11
#: 5A_11:1877
msgctxt "text_id=4171 | speaker=unknown"
msgid "　<人形|かのじょ>は与えられた機能を、目的の為に燃やし尽くす。"
msgstr ""

#. Occurrence 5A_11:1882:4172: scene=5A_11
#: 5A_11:1882
msgctxt "text_id=4172 | speaker=unknown"
msgid "　それは知恵あるものでは届かない器物の誇り。"
msgstr ""

#. Occurrence 5A_11:1887:4173: scene=5A_11
#: 5A_11:1887
msgctxt "text_id=4173 | speaker=unknown"
msgid "　走る為だけに生まれた獣の覚悟に、人が触れれば火傷する。"
msgstr ""

#. Occurrence 5A_11:1987:4174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0006; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1987
msgctxt "text_id=4174 | speaker=aoko"
msgid "“……ホント、勿体ない。"
msgstr ""

#. Occurrence 5A_11:1993:4175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0007; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1993
msgctxt "text_id=4175 | speaker=aoko"
msgid "　こういう無茶をするのは姉貴だけかと思ってたけど、いるところにはいるもんね”"
msgstr ""

#. Occurrence 5A_11:2093:4176: scene=5A_11
#: 5A_11:2093
msgctxt "text_id=4176 | speaker=unknown"
msgid "　だが、共倒れになる気は毛頭無い。"
msgstr ""

#. Occurrence 5A_11:2098:4177: scene=5A_11
#: 5A_11:2098
msgctxt "text_id=4177 | speaker=unknown"
msgid "　反省は済ませたし、敬意も払ったし。"
msgstr ""

#. Occurrence 5A_11:2103:4178: scene=5A_11
#: 5A_11:2103
msgctxt "text_id=4178 | speaker=unknown"
msgid "　時間もないしいい加減、"
msgstr ""

#. Occurrence 5A_11:2168:4179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0008; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2168
msgctxt "text_id=4179 | speaker=aoko"
msgid "「行くわよ。ここで、きっかり―――」"
msgstr ""

#. Occurrence 5A_11:2249:4180: scene=5A_11
#: 5A_11:2249
msgctxt "text_id=4180 | speaker=unknown"
msgid "　たまったツケを、倍にして返してやる―――！"
msgstr ""

#. Occurrence 5A_11:2306:4181: scene=5A_11
#: 5A_11:2306
msgctxt "text_id=4181 | speaker=unknown"
msgid "　溜めに溜めた力を、<右脚|みぎあし>に爆発させる。"
msgstr ""

#. Occurrence 5A_11:2311:4182: scene=5A_11
#: 5A_11:2311
msgctxt "text_id=4182 | speaker=unknown"
msgid "　狙いは一点、正面からの直接打撃―――！"
msgstr ""

#. Occurrence 5A_11:2407:4183: scene=5A_11
#: 5A_11:2407
msgctxt "text_id=4183 | speaker=unknown"
msgid "　迎え撃つは心臓を<鷲掴|わしづか>む呪いの一撃。"
msgstr ""

#. Occurrence 5A_11:2412:4184: scene=5A_11
#: 5A_11:2412
msgctxt "text_id=4184 | speaker=unknown"
msgid "　燃え尽きる事を恐れない、最大出力の心臓破り。"
msgstr ""

#. Occurrence 5A_11:2419:4185: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0009; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2419
msgctxt "text_id=4185 | speaker=aoko"
msgid "“―――っ、フッ―――！”"
msgstr ""

#. Occurrence 5A_11:2425:4186: scene=5A_11
#: 5A_11:2425
msgctxt "text_id=4186 | speaker=unknown"
msgid "　それを視認したのと同時に、青子は全力で床を蹴った。"
msgstr ""

#. Occurrence 5A_11:2509:4187: scene=5A_11
#: 5A_11:2509
msgctxt "text_id=4187 | speaker=unknown"
msgid "　長い髪を尾のようになびかせて、少女の体は真横に<踊|おど>る。"
msgstr ""

#. Occurrence 5A_11:2530:4188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0010; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2530
msgctxt "text_id=4188 | speaker=aoko"
msgid "「っ、き―――」"
msgstr ""

#. Occurrence 5A_11:2536:4189: scene=5A_11
#: 5A_11:2536
msgctxt "text_id=4189 | speaker=unknown"
msgid "　無理やりな横移動で崩れる<体勢|からだ>を、腕の振りで転ばずに持ち直す。"
msgstr ""

#. Occurrence 5A_11:2577:4190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0011; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2577
msgctxt "text_id=4190 | speaker=aoko"
msgid "「っ……！」"
msgstr ""

#. Occurrence 5A_11:2625:4191: scene=5A_11
#: 5A_11:2625
msgctxt "text_id=4191 | speaker=unknown"
msgid "　散弾が肩をかすめる。"
msgstr ""

#. Occurrence 5A_11:2630:4192: scene=5A_11
#: 5A_11:2630
msgctxt "text_id=4192 | speaker=unknown"
msgid "　呪詛をうけた左肩が白熱する。"
msgstr ""

#. Occurrence 5A_11:2635:4193: scene=5A_11
#: 5A_11:2635
msgctxt "text_id=4193 | speaker=unknown"
msgid "　構わない。どんな不利な体勢になろうと、“フィンの一撃”の直撃だけは回避する―――！"
msgstr ""

#. Occurrence 5A_11:2705:4194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0012; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2705
msgctxt "text_id=4194 | speaker=aoko"
msgid "「―――！」"
msgstr ""

#. Occurrence 5A_11:2713:4195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0013; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2713
msgctxt "text_id=4195 | speaker=aoko"
msgid "“<弾いて|スナップ>……！”"
msgstr ""

#. Occurrence 5A_11:2802:4196: scene=5A_11
#: 5A_11:2802
msgctxt "text_id=4196 | speaker=unknown"
msgid "　痛みとバランスの乱れから、立ち直るのに０．５秒。"
msgstr ""

#. Occurrence 5A_11:2807:4197: scene=5A_11
#: 5A_11:2807
msgctxt "text_id=4197 | speaker=unknown"
msgid "　顔を上げた瞬間、目前に迫る凶器を、魔力を帯びた拳で殴り<弾|はじ>く。"
msgstr ""

#. Occurrence 5A_11:2908:4198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0014; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2908
msgctxt "text_id=4198 | speaker=aoko"
msgid "「せー、のぉ……！」"
msgstr ""

#. Occurrence 5A_11:2913:4199: scene=5A_11
#: 5A_11:2913
msgctxt "text_id=4199 | speaker=unknown"
msgid "　人形に意志があったのなら、間違いなく目を見張っただろう。"
msgstr ""

#. Occurrence 5A_11:2918:4200: scene=5A_11
#: 5A_11:2918
msgctxt "text_id=4200 | speaker=unknown"
msgid "　驚嘆すべきは。"
msgstr ""

#. Occurrence 5A_11:2923:4201: scene=5A_11
#: 5A_11:2923
msgctxt "text_id=4201 | speaker=unknown"
msgid "　その一連の動作をしながらも、足を止めない彼女の意志の強さだった。"
msgstr ""

#. Occurrence 5A_11:3011:4202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0015; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3011
msgctxt "text_id=4202 | speaker=aoko"
msgid "“<砕いて|クラック>……！”"
msgstr ""

#. Occurrence 5A_11:3122:4203: scene=5A_11
#: 5A_11:3122
msgctxt "text_id=4203 | speaker=unknown"
msgid "　コンマの世界で弾かれる凶器。"
msgstr ""

#. Occurrence 5A_11:3127:4204: scene=5A_11
#: 5A_11:3127
msgctxt "text_id=4204 | speaker=unknown"
msgid "　少女の力では完全に弾ききれず、凶器はわずかに軌道を逸らし、長い髪をさらっていく。"
msgstr ""

#. Occurrence 5A_11:3210:4205: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4205 | speaker=unknown"
msgid "@o“―――<Initio erraveramus. Dum vivimus dolores sunt|すべてが間違いだったのです。生まれなければ良かったのです。>."
msgstr ""

#. Occurrence 5A_11:3210:4206: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4206 | speaker=unknown"
msgid "<Nemo adiuvat. Nemo adiuvat. Nemo adiuvat.|誰か私を償って。償って。償って。償って。償って。償って。償って。償って。償って―――！>”"
msgstr ""

#. Occurrence 5A_11:3216:4207: scene=5A_11
#: 5A_11:3216
msgctxt "text_id=4207 | speaker=unknown"
msgid "　詠唱は呪いとなって青子から気力を奪う。"
msgstr ""

#. Occurrence 5A_11:3275:4208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0016; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3275
msgctxt "text_id=4208 | speaker=aoko"
msgid "「―――ハ」"
msgstr ""

#. Occurrence 5A_11:3312:4209: scene=5A_11
#: 5A_11:3312
msgctxt "text_id=4209 | speaker=unknown"
msgid "　こぼれたのは余裕か怒りか。"
msgstr ""

#. Occurrence 5A_11:3317:4210: scene=5A_11
#: 5A_11:3317
msgctxt "text_id=4210 | speaker=unknown"
msgid "　あまりにも脆弱な防衛機能を気迫で<嚥下|レジスト>し、"
msgstr ""

#. Occurrence 5A_11:3491:4211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0017; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3491
msgctxt "text_id=4211 | speaker=aoko"
msgid "“蹴<り上げ|グライダー>る……！”"
msgstr ""

#. Occurrence 5A_11:3497:4212: scene=5A_11
#: 5A_11:3497
msgctxt "text_id=4212 | speaker=unknown"
msgid "　魔力を帯びた渾身の右脚が、人形の<心|む><臓|ね>を打ち上げる！"
msgstr ""

#. Occurrence 5A_11:3728:4213: scene=5A_11
#: 5A_11:3728
msgctxt "text_id=4213 | speaker=unknown"
msgid "　人形の軽さは青子の予想以上だった。"
msgstr ""

#. Occurrence 5A_11:3733:4214: scene=5A_11
#: 5A_11:3733
msgctxt "text_id=4214 | speaker=unknown"
msgid "　いや、重さではなく力が無かった、と言うべきか。"
msgstr ""

#. Occurrence 5A_11:3738:4215: scene=5A_11
#: 5A_11:3738
msgctxt "text_id=4215 | speaker=unknown"
msgid "　自動人形の重量はその内部構造―――動力源の大小によって決定される。"
msgstr ""

#. Occurrence 5A_11:3743:4216: scene=5A_11
#: 5A_11:3743
msgctxt "text_id=4216 | speaker=unknown"
msgid "　自動<詠唱永久|オルゴールエンジン>機関を持つこのオートマタは、皮肉な事に、その優秀さがアダになったのだ。"
msgstr ""

#. Occurrence 5A_11:3812:4217: voice_id=C40_5A_11_0002_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3812
msgctxt "text_id=4217 | speaker=unknown"
msgid "“……<Venite, Venite, Venite, meum sepulchrum|いらっしゃい、いらっしゃい、私の墓穴に、> ^<veniteeeeeeee……|いらっしゃいいいいいい……>”"
msgstr ""

#. Occurrence 5A_11:3933:4218: scene=5A_11
#: 5A_11:3933
msgctxt "text_id=4218 | speaker=unknown"
msgid "　途切れ途切れの呪詛。"
msgstr ""

#. Occurrence 5A_11:3938:4219: scene=5A_11
#: 5A_11:3938
msgctxt "text_id=4219 | speaker=unknown"
msgid "　青子の蹴りと天井への衝突、とどめに落下の衝撃で、人形はほぼ停止していた。"
msgstr ""

#. Occurrence 5A_11:3943:4220: scene=5A_11
#: 5A_11:3943
msgctxt "text_id=4220 | speaker=unknown"
msgid "　内部構造に歪みが生じ、動力源である<自動詠唱|オルゴール>のドラムが歪んでしまったのだ。"
msgstr ""

#. Occurrence 5A_11:3971:4221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0018; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3971
msgctxt "text_id=4221 | speaker=aoko"
msgid "「恨むなら設計者を恨みなさい。"
msgstr ""

#. Occurrence 5A_11:3979:4222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_0; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3979
msgctxt "text_id=4222 | speaker=aoko"
msgid "ダイナモの一つでも積んでいれば、もうちょっとは重たくなったでしょうに……"
msgstr ""

#. Occurrence 5A_11:3986:4223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_1; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3986
msgctxt "text_id=4223 | speaker=aoko"
msgid "って、うわ!?」"
msgstr ""

#. Occurrence 5A_11:4098:4224: scene=5A_11
#: 5A_11:4098
msgctxt "text_id=4224 | speaker=unknown"
msgid "　目の前に落ちてきた天井の衝撃で、青子は正しい意識を取り戻した。"
msgstr ""

#. Occurrence 5A_11:4104:4225: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0020; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4104
msgctxt "text_id=4225 | speaker=aoko"
msgid "“……ところでいま、どうやってぶっ倒したんだろう？”"
msgstr ""

#. Occurrence 5A_11:4109:4226: scene=5A_11
#: 5A_11:4109
msgctxt "text_id=4226 | speaker=unknown"
msgid "　と首をかしげるほど無我夢中だったので失念していたが、ミラーハウスの倒壊はもう始まっている。"
msgstr ""

#. Occurrence 5A_11:4147:4227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0021; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4147
msgctxt "text_id=4227 | speaker=aoko"
msgid "「って、こっちのがやばかった……！」"
msgstr ""

#. Occurrence 5A_11:4299:4228: scene=5A_11
#: 5A_11:4299
msgctxt "text_id=4228 | speaker=unknown"
msgid "　勝利の余韻にひたっている場合でも、同情している余裕もない。"
msgstr ""

#. Occurrence 5A_11:4304:4229: scene=5A_11
#: 5A_11:4304
msgctxt "text_id=4229 | speaker=unknown"
msgid "　このままだと数秒後には同じ運命。"
msgstr ""

#. Occurrence 5A_11:4309:4230: scene=5A_11
#: 5A_11:4309
msgctxt "text_id=4230 | speaker=unknown"
msgid "　青子自身、生還できる未来をイメージできないほど、状況は壊滅的だ。"
msgstr ""

#. Occurrence 5A_11:4342:4231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0022; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4342
msgctxt "text_id=4231 | speaker=aoko"
msgid "「急げ、ダッシュだ私……！」"
msgstr ""

#. Occurrence 5A_11:4361:4232: scene=5A_11
#: 5A_11:4361
msgctxt "text_id=4232 | speaker=unknown"
msgid "　それでも最善を尽くそうと頬を叩く。"
msgstr ""

#. Occurrence 5A_11:4366:4233: scene=5A_11
#: 5A_11:4366
msgctxt "text_id=4233 | speaker=unknown"
msgid "　わずか数秒間の交戦の報酬。"
msgstr ""

#. Occurrence 5A_11:4371:4234: scene=5A_11
#: 5A_11:4371
msgctxt "text_id=4234 | speaker=unknown"
msgid "　興奮と緊張で乱れた呼吸もそのままに、青子は出口に向かって走りだした。"
msgstr ""

#. Occurrence 5A_12:140:4235: scene=5A_12
#: 5A_12:140
msgctxt "text_id=4235 | speaker=unknown"
msgid "　秒単位で倒壊は激化していく。"
msgstr ""

#. Occurrence 5A_12:145:4236: scene=5A_12
#: 5A_12:145
msgctxt "text_id=4236 | speaker=unknown"
msgid "　支柱を失った城は中心に折りたたまれるよう、自重によって潰れていく。"
msgstr ""

#. Occurrence 5A_12:222:4237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0000; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:222
msgctxt "text_id=4237 | speaker=aoko"
msgid "「この、邪魔……！」"
msgstr ""

#. Occurrence 5A_12:334:4238: scene=5A_12
#: 5A_12:334
msgctxt "text_id=4238 | speaker=unknown"
msgid "　なので、地下からの脱出は困難を極めた。"
msgstr ""

#. Occurrence 5A_12:339:4239: scene=5A_12
#: 5A_12:339
msgctxt "text_id=4239 | speaker=unknown"
msgid "　迷路を最短距離で突っ切った青子だが、途中、崩落した天井に潰されかけたのが一度。"
msgstr ""

#. Occurrence 5A_12:345:4240: scene=5A_12
#: 5A_12:345
msgctxt "text_id=4240 | speaker=unknown"
msgid "立ちふさがる瓦礫で一秒だけ足を止めたのが二度、いやこれで三度目。"
msgstr ""

#. Occurrence 5A_12:500:4241: scene=5A_12
#: 5A_12:500
msgctxt "text_id=4241 | speaker=unknown"
msgid "　階段に降り積もった瓦礫を、走りながらの魔弾によって粉砕する。"
msgstr ""

#. Occurrence 5A_12:505:4242: scene=5A_12
#: 5A_12:505
msgctxt "text_id=4242 | speaker=unknown"
msgid "　既に、自動人形による<妨害電波|ジャミング>は途絶えている。"
msgstr ""

#. Occurrence 5A_12:510:4243: scene=5A_12
#: 5A_12:510
msgctxt "text_id=4243 | speaker=unknown"
msgid "　先ほどの攻防で人形はその大部分の機能を破損したからだ。"
msgstr ""

#. Occurrence 5A_12:943:4244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0001; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:943
msgctxt "text_id=4244 | speaker=aoko"
msgid "「―――、っ―――！」"
msgstr ""

#. Occurrence 5A_12:949:4245: scene=5A_12
#: 5A_12:949
msgctxt "text_id=4245 | speaker=unknown"
msgid "　息を飲むように走る。"
msgstr ""

#. Occurrence 5A_12:954:4246: scene=5A_12
#: 5A_12:954
msgctxt "text_id=4246 | speaker=unknown"
msgid "　窮地における緊張から、脳は倍速で稼働する。"
msgstr ""

#. Occurrence 5A_12:959:4247: scene=5A_12
#: 5A_12:959
msgctxt "text_id=4247 | speaker=unknown"
msgid "　崩れていく天井が緩やかに流れていく。"
msgstr ""

#. Occurrence 5A_12:967:4248: scene=5A_12
#: 5A_12:967
msgctxt "text_id=4248 | speaker=unknown"
msgid "　まるで死の<間際|まぎわ>の走馬灯。"
msgstr ""

#. Occurrence 5A_12:972:4249: scene=5A_12
#: 5A_12:972
msgctxt "text_id=4249 | speaker=unknown"
msgid "　今の彼女には一秒が五秒に相当する。"
msgstr ""

#. Occurrence 5A_12:977:4250: scene=5A_12
#: 5A_12:977
msgctxt "text_id=4250 | speaker=unknown"
msgid "　研ぎ澄まされた神経が、体感時間を延長する。"
msgstr ""

#. Occurrence 5A_12:1079:4251: scene=5A_12
#: 5A_12:1079
msgctxt "text_id=4251 | speaker=unknown"
msgid "　倒壊する地下から、崩落する一階へ。"
msgstr ""

#. Occurrence 5A_12:1084:4252: scene=5A_12
#: 5A_12:1084
msgctxt "text_id=4252 | speaker=unknown"
msgid "　青子は瓦礫で埋もれかけた階段を這って上りきった。"
msgstr ""

#. Occurrence 5A_12:1090:4253: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4253 | speaker=unknown"
msgid "　広間はまだ開けているコト自体が奇跡で、"
msgstr ""

#. Occurrence 5A_12:1090:4254: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4254 | speaker=unknown"
msgid "　肝心の出口への通路は―――幸運な事に、まだ崩落していない……！"
msgstr ""

#. Occurrence 5A_12:1207:4255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0002; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1207
msgctxt "text_id=4255 | speaker=aoko"
msgid "“よし、ついてる……！”"
msgstr ""

#. Occurrence 5A_12:1213:4256: scene=5A_12
#: 5A_12:1213
msgctxt "text_id=4256 | speaker=unknown"
msgid "　入り口通路は地下に沈まない。"
msgstr ""

#. Occurrence 5A_12:1218:4257: scene=5A_12
#: 5A_12:1218
msgctxt "text_id=4257 | speaker=unknown"
msgid "　地下迷路があるのは広間までで、入り口通路は下に崩れようがないからだ。崩れるのは天井だけで、足場は最後まで残るはず。"
msgstr ""

#. Occurrence 5A_12:1361:4258: scene=5A_12
#: 5A_12:1361
msgctxt "text_id=4258 | speaker=unknown"
msgid "　なので、この運任せの脱出は広場まで辿り着けるかの勝負だ、と青子は自分に言い聞かせて突き進んできた。"
msgstr ""

#. Occurrence 5A_12:1367:4259: scene=5A_12
#: 5A_12:1367
msgctxt "text_id=4259 | speaker=unknown"
msgid "　賭けは彼女の勝ちだ。幸運は青子に味方した。"
msgstr ""

#. Occurrence 5A_12:1372:4260: scene=5A_12
#: 5A_12:1372
msgctxt "text_id=4260 | speaker=unknown"
msgid "　ここからは残りの体力を総動員して、脇目もふらず外を目指せば―――"
msgstr ""

#. Occurrence 5A_12:1420:4261: scene=5A_12
#: 5A_12:1420
msgctxt "text_id=4261 | speaker=unknown"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_12:1456:4262: scene=5A_12
#: 5A_12:1456
msgctxt "text_id=4262 | speaker=unknown"
msgid "　時間にして０．２秒だけ、青子は足を止めかける。"
msgstr ""

#. Occurrence 5A_12:1461:4263: scene=5A_12
#: 5A_12:1461
msgctxt "text_id=4263 | speaker=unknown"
msgid "　心の甘さか、責任か。"
msgstr ""

#. Occurrence 5A_12:1514:4264: scene=5A_12
#: 5A_12:1514
msgctxt "text_id=4264 | speaker=unknown"
msgid "　脳裏によぎったイメージを振り払って、彼女は通路に向かって走りだした。"
msgstr ""

#. Occurrence 5A_12:1552:4265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0004; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1552
msgctxt "text_id=4265 | speaker=aoko"
msgid "“……言っとくけど時間合わせの余裕はないわよ。"
msgstr ""

#. Occurrence 5A_12:1558:4266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0005; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1558
msgctxt "text_id=4266 | speaker=aoko"
msgid "　そんな上等な作戦じゃないし。お互い、できるコトをやったら最速で出口に向かいましょう”"
msgstr ""

#. Occurrence 5A_12:1580:4267: scene=5A_12
#: 5A_12:1580
msgctxt "text_id=4267 | speaker=unknown"
msgid "　たった五分前の話だ。"
msgstr ""

#. Occurrence 5A_12:1585:4268: scene=5A_12
#: 5A_12:1585
msgctxt "text_id=4268 | speaker=unknown"
msgid "　それに、彼は少しだけ不安そうに頷いた。"
msgstr ""

#. Occurrence 5A_12:1590:4269: scene=5A_12
#: 5A_12:1590
msgctxt "text_id=4269 | speaker=unknown"
msgid "　あの顔は―――何に対してのものだったのか。"
msgstr ""

#. Occurrence 5A_12:1651:4270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0006; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1651
msgctxt "text_id=4270 | speaker=aoko"
msgid "“っ、なに様だっての私、今は走ることだけ考えろ……！”"
msgstr ""

#. Occurrence 5A_12:1657:4271: scene=5A_12
#: 5A_12:1657
msgctxt "text_id=4271 | speaker=unknown"
msgid "　この通路も、もう<保|も>たない。"
msgstr ""

#. Occurrence 5A_12:1662:4272: scene=5A_12
#: 5A_12:1662
msgctxt "text_id=4272 | speaker=unknown"
msgid "　振り向けば迷路側から崩れている事だろう。"
msgstr ""

#. Occurrence 5A_12:1667:4273: scene=5A_12
#: 5A_12:1667
msgctxt "text_id=4273 | speaker=unknown"
msgid "　そして、今は振り向く時間すら惜しい。"
msgstr ""

#. Occurrence 5A_12:1785:4274: scene=5A_12
#: 5A_12:1785
msgctxt "text_id=4274 | speaker=unknown"
msgid "　建物の強度的にはきっとギリギリで、自分の運も絶対ギリギリ。"
msgstr ""

#. Occurrence 5A_12:1790:4275: scene=5A_12
#: 5A_12:1790
msgctxt "text_id=4275 | speaker=unknown"
msgid "　ここまで無傷だった事がそもそも破格のヒロイン補正で、これ以上はどんなトラブルも背負えない。"
msgstr ""

#. Occurrence 5A_12:1795:4276: scene=5A_12
#: 5A_12:1795
msgctxt "text_id=4276 | speaker=unknown"
msgid "　足首の<捻挫|ねんざ>、<目眩|めまい>、くしゃみ、その程度ですら死に繋がる。後ろから肩を叩かれるだけでゲームオーバーだ。"
msgstr ""

#. Occurrence 5A_12:1801:4277: scene=5A_12
#: 5A_12:1801
msgctxt "text_id=4277 | speaker=unknown"
msgid "　―――なので。"
msgstr ""

#. Occurrence 5A_12:1920:4278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0007; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1920
msgctxt "text_id=4278 | speaker=aoko"
msgid "「―――、あ」"
msgstr ""

#. Occurrence 5A_12:1926:4279: scene=5A_12
#: 5A_12:1926
msgctxt "text_id=4279 | speaker=unknown"
msgid "　……彼女の瞳には、はっきりと。"
msgstr ""

#. Occurrence 5A_12:1931:4280: scene=5A_12
#: 5A_12:1931
msgctxt "text_id=4280 | speaker=unknown"
msgid "　地下へ落ちる階段の瓦礫から、蒼<崎青|じぶん>子を道連れにしようとする“死”が見えた。"
msgstr ""

#. Occurrence 5A_12:2021:4281: scene=5A_12
#: 5A_12:2021
msgctxt "text_id=4281 | speaker=unknown"
msgid "　<彼女|したい>は<奈落|ならく>から這い出てくる。"
msgstr ""

#. Occurrence 5A_12:2026:4282: scene=5A_12
#: 5A_12:2026
msgctxt "text_id=4282 | speaker=unknown"
msgid "　まだ<稼働|いき>ている。"
msgstr ""

#. Occurrence 5A_12:2086:4283: scene=5A_12
#: 5A_12:2086
msgctxt "text_id=4283 | speaker=unknown"
msgid "　まだ<呪詛|いし>がある。"
msgstr ""

#. Occurrence 5A_12:2091:4284: scene=5A_12
#: 5A_12:2091
msgctxt "text_id=4284 | speaker=unknown"
msgid "　<青子|じぶん>と同じように階段を這ってきて、<青子|じぶん>と同じ目で、一人だけ助かろうとする<少女|あおこ>を見つめている。"
msgstr ""

#. Occurrence 5A_12:2170:4285: scene=5A_12
#: 5A_12:2170
msgctxt "text_id=4285 | speaker=unknown"
msgid "　人形の腕が突き出される。"
msgstr ""

#. Occurrence 5A_12:2175:4286: scene=5A_12
#: 5A_12:2175
msgctxt "text_id=4286 | speaker=unknown"
msgid "　青子が振り向かなくとも、鏡にその姿が映っている。"
msgstr ""

#. Occurrence 5A_12:2267:4287: voice_id=C40_5A_12_0000_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2267
msgctxt "text_id=4287 | speaker=unknown"
msgid "“Iis salvatio Iis salvatio Iis salvatio Iis salvatio”"
msgstr ""

#. Occurrence 5A_12:2273:4288: scene=5A_12
#: 5A_12:2273
msgctxt "text_id=4288 | speaker=unknown"
msgid "　伸びる。伸びる。伸びる。"
msgstr ""

#. Occurrence 5A_12:2278:4289: scene=5A_12
#: 5A_12:2278
msgctxt "text_id=4289 | speaker=unknown"
msgid "　今度こそ<躱|かわ>せない。躱しようがない。"
msgstr ""

#. Occurrence 5A_12:2299:4290: scene=5A_12
#: 5A_12:2299
msgctxt "text_id=4290 | speaker=unknown"
msgid "　同じ顔をした人形が<詠|うた>っている。"
msgstr ""

#. Occurrence 5A_12:2308:4291: voice_id=C40_5A_12_0001_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2308
msgctxt "text_id=4291 | speaker=unknown"
msgid "　<招き入れる|@_Venite domum meam.>。"
msgstr ""

#. Occurrence 5A_12:2316:4292: voice_id=C40_5A_12_0002_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2316
msgctxt "text_id=4292 | speaker=unknown"
msgid "　<泥のような死を|@_Luto simile somnium>。"
msgstr ""

#. Occurrence 5A_12:2324:4293: voice_id=C40_5A_12_0003_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2324
msgctxt "text_id=4293 | speaker=unknown"
msgid "　<塵となって囁く|@_et pulveri simile cotidianum>。"
msgstr ""

#. Occurrence 5A_12:2332:4294: voice_id=C40_5A_12_0004_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2332
msgctxt "text_id=4294 | speaker=unknown"
msgid "　<心臓を抉り|@_Cor privo>出して、"
msgstr ""

#. Occurrence 5A_12:2342:4295: voice_id=C40_5A_12_0005_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2342
msgctxt "text_id=4295 | speaker=unknown"
msgid "　　　　　　　　"
msgstr ""

msgctxt "text_id=4296 | speaker=unknown"
msgid "“「オ<マエニ、|Te iudico>死ヲ」”"
msgstr ""

#. Occurrence 5A_12:2398:4297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0008; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2398
msgctxt "text_id=4297 | speaker=aoko"
msgid "「―――、な」"
msgstr ""

#. Occurrence 5A_12:2456:4298: scene=5A_12
#: 5A_12:2456
msgctxt "text_id=4298 | speaker=unknown"
msgid "　瞬間、青子は我が目を疑った。"
msgstr ""

#. Occurrence 5A_12:2461:4299: scene=5A_12
#: 5A_12:2461
msgctxt "text_id=4299 | speaker=unknown"
msgid "　最後にとんでもない光景を見せられた。"
msgstr ""

#. Occurrence 5A_12:2514:4300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0000; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:2514
msgctxt "text_id=4300 | speaker=soujuurou"
msgid "「しつこいぞ、おまえ」"
msgstr ""

#. Occurrence 5A_12:2520:4301: scene=5A_12
#: 5A_12:2520
msgctxt "text_id=4301 | speaker=unknown"
msgid "　彼はむっとした顔で、広場にとどまって、伸びきった人形の腕を壊していた。"
msgstr ""

#. Occurrence 5A_12:2540:4302: scene=5A_12
#: 5A_12:2540
msgctxt "text_id=4302 | speaker=unknown"
msgid "　怒っている顔が本当に似合わない。"
msgstr ""

#. Occurrence 5A_12:2545:4303: scene=5A_12
#: 5A_12:2545
msgctxt "text_id=4303 | speaker=unknown"
msgid "　手にしている武器は消火器だった。"
msgstr ""

#. Occurrence 5A_12:2550:4304: scene=5A_12
#: 5A_12:2550
msgctxt "text_id=4304 | speaker=unknown"
msgid "　きっと武器になるものを探して、いつまでも迷路の中に。"
msgstr ""

#. Occurrence 5A_12:2567:4305: scene=5A_12
#: 5A_12:2567
msgctxt "text_id=4305 | speaker=unknown"
msgid "　……いや、それよりも。"
msgstr ""

#. Occurrence 5A_12:2606:4306: scene=5A_12
#: 5A_12:2606
msgctxt "text_id=4306 | speaker=unknown"
msgid "　彼がまだ広間にいたのは、考えたくもないけど、まさかそういう理由なんだろうか？"
msgstr ""

#. Occurrence 5A_12:2724:4307: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0009; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2724
msgctxt "text_id=4307 | speaker=aoko"
msgid "「っ、静希君―――！」"
msgstr ""

#. Occurrence 5A_12:2730:4308: scene=5A_12
#: 5A_12:2730
msgctxt "text_id=4308 | speaker=unknown"
msgid "　青子は決して止めまいと誓った足を止めて、無我夢中で手を伸ばす。"
msgstr ""

#. Occurrence 5A_12:2765:4309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0010; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2765
msgctxt "text_id=4309 | speaker=aoko"
msgid "「そんなのほっといていいから、早く！」"
msgstr ""

#. Occurrence 5A_12:2827:4310: scene=5A_12
#: 5A_12:2827
msgctxt "text_id=4310 | speaker=unknown"
msgid "　草十郎は消火器を捨てて走りだした。"
msgstr ""

#. Occurrence 5A_12:3010:4311: scene=5A_12
#: 5A_12:3010
msgctxt "text_id=4311 | speaker=unknown"
msgid "　ドミノ倒しに倒壊していく通路の天井。"
msgstr ""

#. Occurrence 5A_12:3054:4312: scene=5A_12
#: 5A_12:3054
msgctxt "text_id=4312 | speaker=unknown"
msgid "　土砂に阻まれながらも先行する背。"
msgstr ""

#. Occurrence 5A_12:3190:4313: scene=5A_12
#: 5A_12:3190
msgctxt "text_id=4313 | speaker=unknown"
msgid "　崩れ落ちる通路を、全力で走るふたりの影。"
msgstr ""

#. Occurrence 5A_12:3311:4314: scene=5A_12
#: 5A_12:3311
msgctxt "text_id=4314 | speaker=unknown"
msgid "　……断末魔があがる。"
msgstr ""

#. Occurrence 5A_12:3316:4315: scene=5A_12
#: 5A_12:3316
msgctxt "text_id=4315 | speaker=unknown"
msgid "　轟音と粉塵をまきあげ、キッツィーランドのシンボルであった御伽の城は、こうして、最後の<見せ場|ショウ>を終えたのだった。"
msgstr ""

#. Occurrence 5A_12:3402:4316: scene=5A_12
#: 5A_12:3402
msgctxt "text_id=4316 | speaker=unknown"
msgid "　生死を賭けたマラソンは終わった。"
msgstr ""

#. Occurrence 5A_12:3407:4317: scene=5A_12
#: 5A_12:3407
msgctxt "text_id=4317 | speaker=unknown"
msgid "　苦楽とか命運とかを一瞬だけ共にしたふたりは、疲れきった体を芝生にあずけて、妙な連帯感に包まれていた。"
msgstr ""

#. Occurrence 5A_12:3427:4318: scene=5A_12
#: 5A_12:3427
msgctxt "text_id=4318 | speaker=unknown"
msgid "　……耳鳴りはもう治まっている。"
msgstr ""

#. Occurrence 5A_12:3432:4319: scene=5A_12
#: 5A_12:3432
msgctxt "text_id=4319 | speaker=unknown"
msgid "　あれだけ大きかった地響きも、このさびれた遊園地では<彩|いろ>を失う。"
msgstr ""

#. Occurrence 5A_12:3457:4320: scene=5A_12
#: 5A_12:3457
msgctxt "text_id=4320 | speaker=unknown"
msgid "　崩落の残響が廃墟に<沁|し>みこんでいくのを聞き届けながら、青子はとなりの人影に語りかけた。"
msgstr ""

#. Occurrence 5A_12:3465:4321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0011; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3465
msgctxt "text_id=4321 | speaker=aoko"
msgid "「………………ねえ、生きてる？」"
msgstr ""

#. Occurrence 5A_12:3471:4322: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0001; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3471
msgctxt "text_id=4322 | speaker=soujuurou"
msgid "「うん」"
msgstr ""

#. Occurrence 5A_12:3477:4323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0012; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3477
msgctxt "text_id=4323 | speaker=aoko"
msgid "「ちぇっ」"
msgstr ""

#. Occurrence 5A_12:3482:4324: scene=5A_12
#: 5A_12:3482
msgctxt "text_id=4324 | speaker=unknown"
msgid "　可愛らしい舌打ちだったが、その真意は物騒なコトこの上ない。"
msgstr ""

#. Occurrence 5A_12:3532:4325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0002; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3532
msgctxt "text_id=4325 | speaker=soujuurou"
msgid "「……蒼崎。あいつ、どうなった？」"
msgstr ""

#. Occurrence 5A_12:3538:4326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0013; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3538
msgctxt "text_id=4326 | speaker=aoko"
msgid "「見ての通りよ。今ごろバラバラ死体になってるんじゃない？」"
msgstr ""

#. Occurrence 5A_12:3544:4327: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0003; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3544
msgctxt "text_id=4327 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_12:3564:4328: scene=5A_12
#: 5A_12:3564
msgctxt "text_id=4328 | speaker=unknown"
msgid "　身もふたもない青子の返答に、それならいいけど、とため息をつく草十郎。なぜなら、"
msgstr ""

#. Occurrence 5A_12:3589:4329: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0014; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3589
msgctxt "text_id=4329 | speaker=aoko"
msgid "「でも、そんな心配より自分の心配をした方がいいと思うわよ、静希くん？」"
msgstr ""

#. Occurrence 5A_12:3595:4330: scene=5A_12
#: 5A_12:3595
msgctxt "text_id=4330 | speaker=unknown"
msgid "　彼の災難は、目下継続中だったからだ。"
msgstr ""

#. Occurrence 5A_12:3654:4331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0004; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3654
msgctxt "text_id=4331 | speaker=soujuurou"
msgid "「……蒼崎、子供の頃はいじめっ子だっただろ」"
msgstr ""

#. Occurrence 5A_12:3674:4332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0015; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3674
msgctxt "text_id=4332 | speaker=aoko"
msgid "「<加虐|かぎゃく>趣味はないって自負してるけど。"
msgstr ""

#. Occurrence 5A_12:3680:4333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0016; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3680
msgctxt "text_id=4333 | speaker=aoko"
msgid "　それで、今の自分の立場、分かってる？」"
msgstr ""

#. Occurrence 5A_12:3702:4334: scene=5A_12
#: 5A_12:3702
msgctxt "text_id=4334 | speaker=unknown"
msgid "　体を起こしてニコリと微笑む青子。"
msgstr ""

#. Occurrence 5A_12:3707:4335: scene=5A_12
#: 5A_12:3707
msgctxt "text_id=4335 | speaker=unknown"
msgid "　口調も表情も優しいのに、なんでぞわっと寒気がするんだろうな、と草十郎はうなだれてみた。"
msgstr ""

#. Occurrence 5A_12:3739:4336: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0005; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3739
msgctxt "text_id=4336 | speaker=soujuurou"
msgid "「……<面目|めんぼく>次第もございません」"
msgstr ""

#. Occurrence 5A_12:3759:4337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0017; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3759
msgctxt "text_id=4337 | speaker=aoko"
msgid "「かしこまってもダメよ。あの提案には大前提があったわよね。これは取引だって。貴方が役に立つのなら見逃してあげるっていう」"
msgstr ""

#. Occurrence 5A_12:3770:4338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0006; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3770
msgctxt "text_id=4338 | speaker=soujuurou"
msgid "「分かってる。だから面目ないって言ってるだろ」"
msgstr ""

#. Occurrence 5A_12:3776:4339: scene=5A_12
#: 5A_12:3776
msgctxt "text_id=4339 | speaker=unknown"
msgid "　草十郎はこれみよがしに顔を背けた。"
msgstr ""

#. Occurrence 5A_12:3781:4340: scene=5A_12
#: 5A_12:3781
msgctxt "text_id=4340 | speaker=unknown"
msgid "　ふん、と子供のようにふて腐れる。"
msgstr ""

#. Occurrence 5A_12:3824:4341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0018; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3824
msgctxt "text_id=4341 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_12:3830:4342: scene=5A_12
#: 5A_12:3830
msgctxt "text_id=4342 | speaker=unknown"
msgid "　その拗ねっぷりに面食らう青子。"
msgstr ""

#. Occurrence 5A_12:3835:4343: scene=5A_12
#: 5A_12:3835
msgctxt "text_id=4343 | speaker=unknown"
msgid "　……おそらく、ではあるが。"
msgstr ""

#. Occurrence 5A_12:3841:4344: scene=5A_12
#: 5A_12:3841
msgctxt "text_id=4344 | speaker=unknown"
msgid "草十郎は青子にではなく、自分に対して怒っているのだ。"
msgstr ""

#. Occurrence 5A_12:3846:4345: scene=5A_12
#: 5A_12:3846
msgctxt "text_id=4345 | speaker=unknown"
msgid "　青子に見逃してもらえない事より、役に立てなかった事が悔しかった、と。"
msgstr ""

#. Occurrence 5A_12:3872:4346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0019; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3872
msgctxt "text_id=4346 | speaker=aoko"
msgid "「――――――はあ」"
msgstr ""

#. Occurrence 5A_12:3878:4347: scene=5A_12
#: 5A_12:3878
msgctxt "text_id=4347 | speaker=unknown"
msgid "　つい、<本日|ほんじつ>何度目かのため息を青子はもらした。"
msgstr ""

#. Occurrence 5A_12:3883:4348: scene=5A_12
#: 5A_12:3883
msgctxt "text_id=4348 | speaker=unknown"
msgid "　……目前の少年のお人好し加減と、その長所を認めてしまった自分の甘さに呆れてしまう。"
msgstr ""

#. Occurrence 5A_12:3918:4349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0020; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3918
msgctxt "text_id=4349 | speaker=aoko"
msgid "「じゃあ覚悟は出来てるの？」"
msgstr ""

#. Occurrence 5A_12:3930:4350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0007; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3930
msgctxt "text_id=4350 | speaker=soujuurou"
msgid "「……そんなのは出来ないけど、約束だからな。結局は、何もしていないし」"
msgstr ""

#. Occurrence 5A_12:3936:4351: scene=5A_12
#: 5A_12:3936
msgctxt "text_id=4351 | speaker=unknown"
msgid "　確かに、青子が期待した事は、なにひとつ。"
msgstr ""

#. Occurrence 5A_12:3946:4352: scene=5A_12
#: 5A_12:3946
msgctxt "text_id=4352 | speaker=unknown"
msgid "　けど、と青子は崩れ去ったミラーハウスを一瞥した。"
msgstr ""

#. Occurrence 5A_12:3951:4353: scene=5A_12
#: 5A_12:3951
msgctxt "text_id=4353 | speaker=unknown"
msgid "　囮役を見事に失敗し、途方にくれた彼は何を選択したのか。"
msgstr ""

#. Occurrence 5A_12:3998:4354: scene=5A_12
#: 5A_12:3998
msgctxt "text_id=4354 | speaker=unknown"
msgid "　……わざわざ武器になるような消火器を探して、"
msgstr ""

#. Occurrence 5A_12:4003:4355: scene=5A_12
#: 5A_12:4003
msgctxt "text_id=4355 | speaker=unknown"
msgid "　崩れだした迷路の中で、ひとりで出るわけにはいかないと、あの広間で足を止めていた。"
msgstr ""

#. Occurrence 5A_12:4009:4356: scene=5A_12
#: 5A_12:4009
msgctxt "text_id=4356 | speaker=unknown"
msgid "　それは<躊躇|ためら>うことなく出口を目指した彼女とは真逆の、あまりにも愚かな選択だ。"
msgstr ""

#. Occurrence 5A_12:4035:4357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0021; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4035
msgctxt "text_id=4357 | speaker=aoko"
msgid "“……ま、それでよしとするか”"
msgstr ""

#. Occurrence 5A_12:4041:4358: scene=5A_12
#: 5A_12:4041
msgctxt "text_id=4358 | speaker=unknown"
msgid "　甘いなあ、と呆れながらも満足する。"
msgstr ""

#. Occurrence 5A_12:4046:4359: scene=5A_12
#: 5A_12:4046
msgctxt "text_id=4359 | speaker=unknown"
msgid "　だって救われたのは事実だし。"
msgstr ""

#. Occurrence 5A_12:4051:4360: scene=5A_12
#: 5A_12:4051
msgctxt "text_id=4360 | speaker=unknown"
msgid "　あの状況で待ち続ける勇気は、たとえ一秒だけだとしても賞賛に値すると、彼女は内心微笑んだ。"
msgstr ""

#. Occurrence 5A_12:4109:4361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0022; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4109
msgctxt "text_id=4361 | speaker=aoko"
msgid "“……役割は果たさなかったけど、アフターケアは合格だし。約束は、守らなくちゃね”"
msgstr ""

#. Occurrence 5A_12:4115:4362: scene=5A_12
#: 5A_12:4115
msgctxt "text_id=4362 | speaker=unknown"
msgid "　ひとり頷いて、青子はすくっと立ち上がる。"
msgstr ""

#. Occurrence 5A_12:4143:4363: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0023; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4143
msgctxt "text_id=4363 | speaker=aoko"
msgid "「約束は、ま、いつか守ってもらうとして」"
msgstr ""

#. Occurrence 5A_12:4165:4364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0008; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4165
msgctxt "text_id=4364 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 5A_12:4200:4365: scene=5A_12
#: 5A_12:4200
msgctxt "text_id=4365 | speaker=unknown"
msgid "　少女は出来るだけ無感情を装って、まだ倒れこんでいる少年に手を差し伸べる。"
msgstr ""

#. Occurrence 5A_12:4221:4366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0024; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4221
msgctxt "text_id=4366 | speaker=aoko"
msgid "「結果はどうあれ手助けしてもらったし。"
msgstr ""

#. Occurrence 5A_12:4228:4367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0025; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4228
msgctxt "text_id=4367 | speaker=aoko"
msgid "特別サービスってコトで、今夜はもう手を出さないであげる」"
msgstr ""

#. Occurrence 5A_12:4252:4368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0009; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4252
msgctxt "text_id=4368 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_12:4299:4369: scene=5A_12
#: 5A_12:4299
msgctxt "text_id=4369 | speaker=unknown"
msgid "　照れくさそうに顔を逸らす少女。"
msgstr ""

#. Occurrence 5A_12:4304:4370: scene=5A_12
#: 5A_12:4304
msgctxt "text_id=4370 | speaker=unknown"
msgid "　その横顔はあの日のものとは違っていたけれど、紛れもなく、少年がこの町に来てはじめて見入った、鮮やかな少女の顔だった。"
msgstr ""

#. Occurrence 5A_12:4338:4371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0026; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4338
msgctxt "text_id=4371 | speaker=aoko"
msgid "「――――――なによ」"
msgstr ""

#. Occurrence 5A_12:4343:4372: scene=5A_12
#: 5A_12:4343
msgctxt "text_id=4372 | speaker=unknown"
msgid "　視線を感じたのか、口をとがらせてじろりと睨む青子。"
msgstr ""

#. Occurrence 5A_12:4363:4373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0010; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4363
msgctxt "text_id=4373 | speaker=soujuurou"
msgid "「いや。突拍子もないけど、蒼崎は律儀だなって」"
msgstr ""

#. Occurrence 5A_12:4387:4374: scene=5A_12
#: 5A_12:4387
msgctxt "text_id=4374 | speaker=unknown"
msgid "　差し出された手を握る。"
msgstr ""

#. Occurrence 5A_12:4392:4375: scene=5A_12
#: 5A_12:4392
msgctxt "text_id=4375 | speaker=unknown"
msgid "　青子は草十郎の体重を感じながら、貴方にだけは言われたくはないわ、と手を引いた。"
msgstr ""

#. Occurrence 5A_12:4437:4376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0011; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4437
msgctxt "text_id=4376 | speaker=soujuurou"
msgid "「ところで。今夜はって言うけど、明日からは？」"
msgstr ""

#. Occurrence 5A_12:4443:4377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0027; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4443
msgctxt "text_id=4377 | speaker=aoko"
msgid "「さあ。ま、その時になったら考えるわ」"
msgstr ""

#. Occurrence 5A_12:4449:4378: scene=5A_12
#: 5A_12:4449
msgctxt "text_id=4378 | speaker=unknown"
msgid "　自分でもなんだかなあ、と肩をすくめる青子。"
msgstr ""

#. Occurrence 5A_12:4454:4379: scene=5A_12
#: 5A_12:4454
msgctxt "text_id=4379 | speaker=unknown"
msgid "　その仕草がおかしく、草十郎も笑ってしまう。"
msgstr ""

#. Occurrence 5A_12:4493:4380: scene=5A_12
#: 5A_12:4493
msgctxt "text_id=4380 | speaker=unknown"
msgid "　共に死線をくぐり抜けた連帯感とか、つかの間<築|きず>かれた友情とか。"
msgstr ""

#. Occurrence 5A_12:4498:4381: scene=5A_12
#: 5A_12:4498
msgctxt "text_id=4381 | speaker=unknown"
msgid "　それが今夜かぎりのものでも、ふたりを包む空気は<和|なご>やかで、優しいものだった。"
msgstr ""

#. Occurrence 5A_12:4503:4382: scene=5A_12
#: 5A_12:4503
msgctxt "text_id=4382 | speaker=unknown"
msgid "　色々あったけれど、真冬の夜の悪夢はこれでおしまい。"
msgstr ""

#. Occurrence 5A_12:4508:4383: scene=5A_12
#: 5A_12:4508
msgctxt "text_id=4383 | speaker=unknown"
msgid "　ふたりはそれぞれの窮地を乗り越え、鏡の国を後にする。"
msgstr ""

#. Occurrence 5A_12:4530:4384: scene=5A_12
#: 5A_12:4530
msgctxt "text_id=4384 | speaker=unknown"
msgid "　……けれど、その前に。"
msgstr ""

#. Occurrence 5A_12:4577:4385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0000; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4577
msgctxt "text_id=4385 | speaker=alice"
msgid "「―――随分と身勝手ね。"
msgstr ""

#. Occurrence 5A_12:4583:4386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0001; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4583
msgctxt "text_id=4386 | speaker=alice"
msgid "　それは貴女ひとりで決めていい事だったかしら、青子？」"
msgstr ""

#. Occurrence 5A_12:4773:4387: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4387 | speaker=unknown"
msgid "　それは美しい鳥のさえずりにも、"
msgstr ""

#. Occurrence 5A_12:4773:4388: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4388 | speaker=unknown"
msgid "　無慈悲な機械の声にも似て。"
msgstr ""

#. Occurrence 5A_12:4794:4389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0028; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4794
msgctxt "text_id=4389 | speaker=aoko"
msgid "「―――有珠」"
msgstr ""

#. Occurrence 5A_12:4800:4390: scene=5A_12
#: 5A_12:4800
msgctxt "text_id=4390 | speaker=unknown"
msgid "　……震える声で、青子は少女の名を口にした。"
msgstr ""

#. Occurrence 5A_12:4857:4391: scene=5A_12
#: 5A_12:4857
msgctxt "text_id=4391 | speaker=unknown"
msgid "　降り立つ黒衣。"
msgstr ""

#. Occurrence 5A_12:4863:4392: scene=5A_12
#: 5A_12:4863
msgctxt "text_id=4392 | speaker=unknown"
msgid "　……夜はまだ終わらない。"
msgstr ""

#. Occurrence 5A_12:4868:4393: scene=5A_12
#: 5A_12:4868
msgctxt "text_id=4393 | speaker=unknown"
msgid "　少女の名は久遠寺有珠。"
msgstr ""

#. Occurrence 5A_12:4874:4394: scene=5A_12
#: 5A_12:4874
msgctxt "text_id=4394 | speaker=unknown"
msgid "　青子をして魔女と恐れさせる、"
msgstr ""

msgctxt "text_id=4395 | speaker=unknown"
msgid "目撃者は例外なく逃がさない、夜の化身がやってきた。"
msgstr ""

#. Occurrence 5A_2:79:4396: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0000; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:79
msgctxt "text_id=4396 | speaker=soujuurou"
msgid "「あれか」"
msgstr ""

#. Occurrence 5A_2:86:4397: scene=5A_2
#: 5A_2:86
msgctxt "text_id=4397 | speaker=unknown"
msgid "　静まりかえった中央広場から、案内にしたがって西に。"
msgstr ""

#. Occurrence 5A_2:91:4398: scene=5A_2
#: 5A_2:91
msgctxt "text_id=4398 | speaker=unknown"
msgid "　着いた先には曇天の夜を<背景|バック>に、<凹凸|おうとつ>の多い、<威容|いよう><異彩|いさい>な城がそびえていた。"
msgstr ""

#. Occurrence 5A_2:111:4399: scene=5A_2
#: 5A_2:111
msgctxt "text_id=4399 | speaker=unknown"
msgid "　廃遊園地の中でも<一際|ひときわ>大きい建造物。"
msgstr ""

#. Occurrence 5A_2:116:4400: scene=5A_2
#: 5A_2:116
msgctxt "text_id=4400 | speaker=unknown"
msgid "　コースターや観覧車が動のアトラクションなら、あれは静のアトラクション。"
msgstr ""

#. Occurrence 5A_2:122:4401: scene=5A_2
#: 5A_2:122
msgctxt "text_id=4401 | speaker=unknown"
msgid "　キッツィーランドの三大シンボルの一つであり、ある意味、この楽園を閉鎖に導いた魔の建物だ。"
msgstr ""

#. Occurrence 5A_2:158:4402: scene=5A_2
#: 5A_2:158
msgctxt "text_id=4402 | speaker=unknown"
msgid "　一般的に、遊園地の<迷路|メイズ>は大きく二種類に分類される。"
msgstr ""

#. Occurrence 5A_2:164:4403: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4403 | speaker=unknown"
msgid "　建物の広さで来訪者を迷わす<大迷路|ラビュリントス>と、"
msgstr ""

#. Occurrence 5A_2:164:4404: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4404 | speaker=unknown"
msgid "　交錯する光で来訪者を迷わすミラーハウスだ。"
msgstr ""

#. Occurrence 5A_2:209:4405: scene=5A_2
#: 5A_2:209
msgctxt "text_id=4405 | speaker=unknown"
msgid "　大迷路はその広さ、つかの間の冒険性で、多くの来訪者たちを楽しませた。"
msgstr ""

#. Occurrence 5A_2:214:4406: scene=5A_2
#: 5A_2:214
msgctxt "text_id=4406 | speaker=unknown"
msgid "　後年、刺激をより増していく他のアトラクションに押され衰退していく事になるが、それは一世を<風靡|ふうび>したものの宿命だろう。"
msgstr ""

#. Occurrence 5A_2:219:4407: scene=5A_2
#: 5A_2:219
msgctxt "text_id=4407 | speaker=unknown"
msgid "　新しいものは、次の新しいものに駆逐されなければならないのだから。"
msgstr ""

#. Occurrence 5A_2:243:4408: scene=5A_2
#: 5A_2:243
msgctxt "text_id=4408 | speaker=unknown"
msgid "　一方、ミラーハウスは古くから愛されてきた定番だ。"
msgstr ""

#. Occurrence 5A_2:248:4409: scene=5A_2
#: 5A_2:248
msgctxt "text_id=4409 | speaker=unknown"
msgid "　学校の教室ほどの広さでも鏡の設置と光の演出で来訪者を楽しませ、迷わせる。"
msgstr ""

#. Occurrence 5A_2:253:4410: scene=5A_2
#: 5A_2:253
msgctxt "text_id=4410 | speaker=unknown"
msgid "　コスト面に優れたミラーハウスは大迷路より遥かに長生きしたアトラクションだ。"
msgstr ""

#. Occurrence 5A_2:258:4411: scene=5A_2
#: 5A_2:258
msgctxt "text_id=4411 | speaker=unknown"
msgid "　両者とも新世紀には姿を消す事になるとしても、遊園地を代表する遊び場であるのは間違いない。"
msgstr ""

#. Occurrence 5A_2:278:4412: scene=5A_2
#: 5A_2:278
msgctxt "text_id=4412 | speaker=unknown"
msgid "　……が。"
msgstr ""

#. Occurrence 5A_2:289:4413: scene=5A_2
#: 5A_2:289
msgctxt "text_id=4413 | speaker=unknown"
msgid "　だからといって、その二つを混ぜるのはよろしくない。"
msgstr ""

#. Occurrence 5A_2:294:4414: scene=5A_2
#: 5A_2:294
msgctxt "text_id=4414 | speaker=unknown"
msgid "　それでは訪れた者を楽しませる迷路というより、踏み入れた者を帰さない魔境になってしまう。"
msgstr ""

#. Occurrence 5A_2:299:4415: scene=5A_2
#: 5A_2:299
msgctxt "text_id=4415 | speaker=unknown"
msgid "　さもありなん。"
msgstr ""

#. Occurrence 5A_2:304:4416: scene=5A_2
#: 5A_2:304
msgctxt "text_id=4416 | speaker=unknown"
msgid "　その魔境こそがここ、キッツィーミステリーツアー城なのであった。"
msgstr ""

#. Occurrence 5A_2:324:4417: scene=5A_2
#: 5A_2:324
msgctxt "text_id=4417 | speaker=unknown"
msgid "　係員に助けを求めた入場者、実に５パーセント。"
msgstr ""

#. Occurrence 5A_2:329:4418: scene=5A_2
#: 5A_2:329
msgctxt "text_id=4418 | speaker=unknown"
msgid "　西洋の城を模した建物は奥行き百メートルほどもあり、内部はさらに三層に分かれている。"
msgstr ""

#. Occurrence 5A_2:349:4419: scene=5A_2
#: 5A_2:349
msgctxt "text_id=4419 | speaker=unknown"
msgid "　地上二階、地下一階の迷路はすべて鏡張りで、熟練者でも脱出に三十分を要するほど複雑かつ広大。"
msgstr ""

#. Occurrence 5A_2:354:4420: scene=5A_2
#: 5A_2:354
msgctxt "text_id=4420 | speaker=unknown"
msgid "　一度足を踏み入れたが最後、むこう半日は鏡面恐怖症におちいる大迷路のなれの果てが、こうして草十郎の目の前に立ちふさがっているのだが―――"
msgstr ""

#. Occurrence 5A_2:423:4421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0001; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:423
msgctxt "text_id=4421 | speaker=soujuurou"
msgid "「真っ暗ってワケじゃないな……電気とか、ついてるんだろうか」"
msgstr ""

#. Occurrence 5A_2:429:4422: scene=5A_2
#: 5A_2:429
msgctxt "text_id=4422 | speaker=unknown"
msgid "　そもそもミラーハウスを知らない草十郎の関心は、明かりの有無にのみ向けられている。"
msgstr ""

#. Occurrence 5A_2:451:4423: scene=5A_2
#: 5A_2:451
msgctxt "text_id=4423 | speaker=unknown"
msgid "　もう一度、蒼崎青子からの手紙を確認する。"
msgstr ""

#. Occurrence 5A_2:456:4424: scene=5A_2
#: 5A_2:456
msgctxt "text_id=4424 | speaker=unknown"
msgid "　手紙には『ミラーハウス一階ロビーで待っています』とある。"
msgstr ""

#. Occurrence 5A_2:476:4425: scene=5A_2
#: 5A_2:476
msgctxt "text_id=4425 | speaker=unknown"
msgid "　待ち合わせ場所はたしかにこの中だ。"
msgstr ""

#. Occurrence 5A_2:481:4426: scene=5A_2
#: 5A_2:481
msgctxt "text_id=4426 | speaker=unknown"
msgid "　電灯の有無はともかく、開けっ放しの入り口から見える内部はうっすらと明るい。"
msgstr ""

#. Occurrence 5A_2:487:4427: scene=5A_2
#: 5A_2:487
msgctxt "text_id=4427 | speaker=unknown"
msgid "　なら間違いないだろう、と草十郎はミラーハウスの入り口に向かって歩きだした。"
msgstr ""

#. Occurrence 5A_2:535:4428: scene=5A_2
#: 5A_2:535
msgctxt "text_id=4428 | speaker=unknown"
msgid "　……カツカツと煉瓦の道を踏みならす音。"
msgstr ""

#. Occurrence 5A_2:541:4429: scene=5A_2
#: 5A_2:541
msgctxt "text_id=4429 | speaker=unknown"
msgid "　街の喧噪は遠く、"
msgstr ""

#. Occurrence 5A_2:546:4430: scene=5A_2
#: 5A_2:546
msgctxt "text_id=4430 | speaker=unknown"
msgid "　時計の秒針は数年前から動かず、"
msgstr ""

#. Occurrence 5A_2:551:4431: scene=5A_2
#: 5A_2:551
msgctxt "text_id=4431 | speaker=unknown"
msgid "　風の音すら無い冬の夜。"
msgstr ""

#. Occurrence 5A_2:571:4432: scene=5A_2
#: 5A_2:571
msgctxt "text_id=4432 | speaker=unknown"
msgid "　そんな、第三者がいれば<固唾|かたず>を呑んで呼吸を止めそうな静寂のなか。"
msgstr ""

#. Occurrence 5A_2:580:4433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0002; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:580
msgctxt "text_id=4433 | speaker=soujuurou"
msgid "「……えーと」"
msgstr ""

#. Occurrence 5A_2:586:4434: scene=5A_2
#: 5A_2:586
msgctxt "text_id=4434 | speaker=unknown"
msgid "　草十郎はミラーハウスの入り口で、ぴたりと唐突に立ち止まると、"
msgstr ""

#. Occurrence 5A_2:623:4435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0003; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:623
msgctxt "text_id=4435 | speaker=soujuurou"
msgid "「ところで蒼崎。そんなところで何してるんだ？」"
msgstr ""

#. Occurrence 5A_2:629:4436: scene=5A_2
#: 5A_2:629
msgctxt "text_id=4436 | speaker=unknown"
msgid "　いま歩いてきた広場を振り返って、不思議そうに呼びかけるのだった。"
msgstr ""

#. Occurrence 5A_2:666:4437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0000; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:666
msgctxt "text_id=4437 | speaker=aoko"
msgid "「！？」"
msgstr ""

#. Occurrence 5A_2:672:4438: scene=5A_2
#: 5A_2:672
msgctxt "text_id=4438 | speaker=unknown"
msgid "　勢い、身を隠していたゴミ箱ごと<突|つ>っ<伏|ぷ>す音。"
msgstr ""

#. Occurrence 5A_2:694:4439: scene=5A_2
#: 5A_2:694
msgctxt "text_id=4439 | speaker=unknown"
msgid "　……しばしの静寂。"
msgstr ""

#. Occurrence 5A_2:699:4440: scene=5A_2
#: 5A_2:699
msgctxt "text_id=4440 | speaker=unknown"
msgid "　一分ほどで廃遊園地はもとの静けさを取り戻した。"
msgstr ""

#. Occurrence 5A_2:704:4441: scene=5A_2
#: 5A_2:704
msgctxt "text_id=4441 | speaker=unknown"
msgid "　ついでに、観念したように物陰から現れる少女がひとり。"
msgstr ""

#. Occurrence 5A_2:752:4442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0004; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:752
msgctxt "text_id=4442 | speaker=soujuurou"
msgid "「あお―――」"
msgstr ""

#. Occurrence 5A_2:768:4443: scene=5A_2
#: 5A_2:768
msgctxt "text_id=4443 | speaker=unknown"
msgid "　見知った顔と、見慣れない私服姿に声が止まる。"
msgstr ""

#. Occurrence 5A_2:773:4444: scene=5A_2
#: 5A_2:773
msgctxt "text_id=4444 | speaker=unknown"
msgid "　はらりと長髪を流して現れた蒼崎青子は、草十郎の知っている彼女とは違っていたからだ。"
msgstr ""

#. Occurrence 5A_2:820:4445: scene=5A_2
#: 5A_2:820
msgctxt "text_id=4445 | speaker=unknown"
msgid "　凛とした背筋と手足が、意志の強さをいっそう際立たせている。"
msgstr ""

#. Occurrence 5A_2:825:4446: scene=5A_2
#: 5A_2:825
msgctxt "text_id=4446 | speaker=unknown"
msgid "　まっすぐに相手を<射|い><貫|ぬ>く瞳。"
msgstr ""

#. Occurrence 5A_2:830:4447: scene=5A_2
#: 5A_2:830
msgctxt "text_id=4447 | speaker=unknown"
msgid "　<澄|す>んだ瞳は<比|ひ><喩|ゆ>ではなく、錯覚でなければ、実際に<燐|うす>い光を帯びている。"
msgstr ""

#. Occurrence 5A_2:850:4448: scene=5A_2
#: 5A_2:850
msgctxt "text_id=4448 | speaker=unknown"
msgid "　氷の無機質さと、少女としての力強さ。"
msgstr ""

#. Occurrence 5A_2:855:4449: scene=5A_2
#: 5A_2:855
msgctxt "text_id=4449 | speaker=unknown"
msgid "　その不釣り合いな組み合わせが、危機感の欠如した草十郎をして、良からぬ空気を感じさせた。"
msgstr ""

#. Occurrence 5A_2:861:4450: scene=5A_2
#: 5A_2:861
msgctxt "text_id=4450 | speaker=unknown"
msgid "　<喩|たと>えるなら、怪談でいう雪女が現実に現れたような。"
msgstr ""

#. Occurrence 5A_2:904:4451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0005; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:904
msgctxt "text_id=4451 | speaker=soujuurou"
msgid "「……蒼崎？」"
msgstr ""

#. Occurrence 5A_2:918:4452: scene=5A_2
#: 5A_2:918
msgctxt "text_id=4452 | speaker=unknown"
msgid "　つい、と草十郎はあとずさる。"
msgstr ""

#. Occurrence 5A_2:923:4453: scene=5A_2
#: 5A_2:923
msgctxt "text_id=4453 | speaker=unknown"
msgid "　小さな驚きと違和感。"
msgstr ""

#. Occurrence 5A_2:928:4454: scene=5A_2
#: 5A_2:928
msgctxt "text_id=4454 | speaker=unknown"
msgid "　そして、それらを上回る嫌な予感に混乱しつつあるが、とにかく都会の礼儀として声をかけたのだが……"
msgstr ""

#. Occurrence 5A_2:949:4455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0006; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:949
msgctxt "text_id=4455 | speaker=soujuurou"
msgid "「……その顔を見るに、何かあったのかといちおう聞いておくん、だけど―――」"
msgstr ""

#. Occurrence 5A_2:972:4456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0001; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:972
msgctxt "text_id=4456 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_2:978:4457: scene=5A_2
#: 5A_2:978
msgctxt "text_id=4457 | speaker=unknown"
msgid "　挨拶もなく、青子は一歩前に進んだ。"
msgstr ""

#. Occurrence 5A_2:983:4458: scene=5A_2
#: 5A_2:983
msgctxt "text_id=4458 | speaker=unknown"
msgid "　その姿、その雰囲気が草十郎の曖昧な記憶を揺さぶる。"
msgstr ""

#. Occurrence 5A_2:1036:4459: scene=5A_2
#: 5A_2:1036
msgctxt "text_id=4459 | speaker=unknown"
msgid "　心中、交錯しまくっていた草十郎の不安は、そろそろ確信に変わりつつある。"
msgstr ""

#. Occurrence 5A_2:1060:4460: scene=5A_2
#: 5A_2:1060
msgctxt "text_id=4460 | speaker=unknown"
msgid "　あの時は後ろ姿だけだったが、今にして思えば夜の公園で見た人影と目前の少女の姿はなんとなく……"
msgstr ""

#. Occurrence 5A_2:1065:4461: scene=5A_2
#: 5A_2:1065
msgctxt "text_id=4461 | speaker=unknown"
msgid "　どころか、うり二つではないだろうか？　と<固唾|かたず>など呑む始末。"
msgstr ""

#. Occurrence 5A_2:1095:4462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0002; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1095
msgctxt "text_id=4462 | speaker=aoko"
msgid "「何をしていたかって話なら、見ての通りよ。"
msgstr ""

#. Occurrence 5A_2:1103:4463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0003; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1103
msgctxt "text_id=4463 | speaker=aoko"
msgid "　ここで獲物が通り過ぎるのを待ってたの。貴方が入ってから私も入って、逃げ道を無くすつもりだったから」"
msgstr ""

#. Occurrence 5A_2:1112:4464: scene=5A_2
#: 5A_2:1112
msgctxt "text_id=4464 | speaker=unknown"
msgid "　なのにいきなりコレとはね、と腐りながら青子は言った。"
msgstr ""

#. Occurrence 5A_2:1133:4465: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0007; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1133
msgctxt "text_id=4465 | speaker=soujuurou"
msgid "“そうか。待ち合わせ場所はあってたんだな”"
msgstr ""

#. Occurrence 5A_2:1144:4466: scene=5A_2
#: 5A_2:1144
msgctxt "text_id=4466 | speaker=unknown"
msgid "　良かった、と内心でホッとする草十郎。"
msgstr ""

#. Occurrence 5A_2:1149:4467: scene=5A_2
#: 5A_2:1149
msgctxt "text_id=4467 | speaker=unknown"
msgid "　わりと余裕があるのか、それとも事ここに至ってやっぱり現状が把握できていないのか。"
msgstr ""

#. Occurrence 5A_2:1154:4468: scene=5A_2
#: 5A_2:1154
msgctxt "text_id=4468 | speaker=unknown"
msgid "　そんな草十郎の<鈍|にぶ>い反応をあえて無視して青子は続けた。"
msgstr ""

#. Occurrence 5A_2:1180:4469: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0004; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1180
msgctxt "text_id=4469 | speaker=aoko"
msgid "「―――私はね、静希君。"
msgstr ""

#. Occurrence 5A_2:1211:4470: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0005; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1211
msgctxt "text_id=4470 | speaker=aoko"
msgid "　嫌いな人とか、憎い人とかは人並みにいるんだ。"
msgstr ""

#. Occurrence 5A_2:1217:4471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0006; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1217
msgctxt "text_id=4471 | speaker=aoko"
msgid "　ただ、ちょっとヘンなのが敵になる奴の条件でね」"
msgstr ""

#. Occurrence 5A_2:1237:4472: scene=5A_2
#: 5A_2:1237
msgctxt "text_id=4472 | speaker=unknown"
msgid "　凍った<双眸|そうぼう>に火のような感情がともる。"
msgstr ""

#. Occurrence 5A_2:1242:4473: scene=5A_2
#: 5A_2:1242
msgctxt "text_id=4473 | speaker=unknown"
msgid "　彼女の足はさらに一歩前へ。"
msgstr ""

#. Occurrence 5A_2:1270:4474: scene=5A_2
#: 5A_2:1270
msgctxt "text_id=4474 | speaker=unknown"
msgid "　草十郎はますます嫌な予感……殺気、というのだろうか？……を覚えてあとじさりする。"
msgstr ""

#. Occurrence 5A_2:1276:4475: scene=5A_2
#: 5A_2:1276
msgctxt "text_id=4475 | speaker=unknown"
msgid "　ふたりの距離は、なんだかんだときっかり五メートルをキープしている。"
msgstr ""

#. Occurrence 5A_2:1298:4476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0007; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1298
msgctxt "text_id=4476 | speaker=aoko"
msgid "「昔から、私は嫌いな相手でも敵と思った事はなかったの。"
msgstr ""

#. Occurrence 5A_2:1304:4477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0008; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1304
msgctxt "text_id=4477 | speaker=aoko"
msgid "　でも逆に、好きな相手を敵だと思う事もあった。"
msgstr ""

#. Occurrence 5A_2:1340:4478: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0009; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1340
msgctxt "text_id=4478 | speaker=aoko"
msgid "　理由は単純―――」"
msgstr ""

#. Occurrence 5A_2:1403:4479: scene=5A_2
#: 5A_2:1403
msgctxt "text_id=4479 | speaker=unknown"
msgid "　そして、彼女は右腕を目前に<掲|かか>げた。"
msgstr ""

#. Occurrence 5A_2:1408:4480: scene=5A_2
#: 5A_2:1408
msgctxt "text_id=4480 | speaker=unknown"
msgid "　洋服ごしに光って見えるのは目の錯覚ではなく―――"
msgstr ""

#. Occurrence 5A_2:1489:4481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0010; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1489
msgctxt "text_id=4481 | speaker=aoko"
msgid "「―――当たり前のことだけど。"
msgstr ""

#. Occurrence 5A_2:1495:4482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0011; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1495
msgctxt "text_id=4482 | speaker=aoko"
msgid "　私は、私の感情を乱す奴が敵なのよ」"
msgstr ""

#. Occurrence 5A_2:1503:4483: scene=5A_2
#: 5A_2:1503
msgctxt "text_id=4483 | speaker=unknown"
msgid "　掲げられた右腕が振るわれる。"
msgstr ""

#. Occurrence 5A_2:1528:4484: scene=5A_2
#: 5A_2:1528
msgctxt "text_id=4484 | speaker=unknown"
msgid "　瞬間、"
msgstr ""

#. Occurrence 5A_2:1623:4485: scene=5A_2
#: 5A_2:1623
msgctxt "text_id=4485 | speaker=unknown"
msgid "　何か、視認しづらい物騒なモノが、草十郎から二十センチばかり左にズレて放たれた。"
msgstr ""

#. Occurrence 5A_2:1653:4486: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0008; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1653
msgctxt "text_id=4486 | speaker=soujuurou"
msgid "「ちょっ……」"
msgstr ""

#. Occurrence 5A_2:1659:4487: scene=5A_2
#: 5A_2:1659
msgctxt "text_id=4487 | speaker=unknown"
msgid "　青い光とも、火の玉ともとれる発火現象を目の当たりにして、草十郎はようやく現状を把握した。"
msgstr ""

#. Occurrence 5A_2:1689:4488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0009; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1689
msgctxt "text_id=4488 | speaker=soujuurou"
msgid "「ちょっと待った、今のはたいへん見覚えがある！」"
msgstr ""

#. Occurrence 5A_2:1694:4489: scene=5A_2
#: 5A_2:1694
msgctxt "text_id=4489 | speaker=unknown"
msgid "　そんな間の抜けた感想は聞き流し、"
msgstr ""

#. Occurrence 5A_2:1736:4490: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0012; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1736
msgctxt "text_id=4490 | speaker=aoko"
msgid "「ち、外したか」"
msgstr ""

#. Occurrence 5A_2:1741:4491: scene=5A_2
#: 5A_2:1741
msgctxt "text_id=4491 | speaker=unknown"
msgid "　なんてコトを、青子は呟いた。"
msgstr ""

#. Occurrence 5A_2:1761:4492: scene=5A_2
#: 5A_2:1761
msgctxt "text_id=4492 | speaker=unknown"
msgid "　青い光はミラーハウスの壁にこぶし大の穴をあけたばかりか、未だにゴウゴウと<燻|くすぶ>っていた。"
msgstr ""

#. Occurrence 5A_2:1766:4493: scene=5A_2
#: 5A_2:1766
msgctxt "text_id=4493 | speaker=unknown"
msgid "　あれなら人間ひとりの<頭蓋|あたま>を<陥没|かんぼつ>させる事も、まるっと<黒|くろ><焦|こ>げにする事も可能だろう。"
msgstr ""

#. Occurrence 5A_2:1794:4494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0013; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1794
msgctxt "text_id=4494 | speaker=aoko"
msgid "「……はあ。こんな射程で外すなんて、有珠に見られたら自殺ものね。"
msgstr ""

#. Occurrence 5A_2:1807:4495: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0014; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1807
msgctxt "text_id=4495 | speaker=aoko"
msgid "　でもこれで分かったでしょ？　二度目だものね、貴方にとっては」"
msgstr ""

#. Occurrence 5A_2:1829:4496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0010; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1829
msgctxt "text_id=4496 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_2:1849:4497: scene=5A_2
#: 5A_2:1849
msgctxt "text_id=4497 | speaker=unknown"
msgid "　急速に腰が引ける草十郎。"
msgstr ""

#. Occurrence 5A_2:1854:4498: scene=5A_2
#: 5A_2:1854
msgctxt "text_id=4498 | speaker=unknown"
msgid "　理解不能を通り越して思考停止まで一歩手前。"
msgstr ""

#. Occurrence 5A_2:1873:4499: scene=5A_2
#: 5A_2:1873
msgctxt "text_id=4499 | speaker=unknown"
msgid "　瞳に<映|うつ>るのは頼れる生徒会長……だったもの……の姿と、二日前に目撃した夜の公園のフラッシュバックだけだ。"
msgstr ""

#. Occurrence 5A_2:1908:4500: scene=5A_2
#: 5A_2:1908
msgctxt "text_id=4500 | speaker=unknown"
msgid "　彼には経験がなく、また、法治国家に住むほとんどの人々には経験がない事だが。"
msgstr ""

#. Occurrence 5A_2:1913:4501: scene=5A_2
#: 5A_2:1913
msgctxt "text_id=4501 | speaker=unknown"
msgid "　指を引くだけで人間を殺せる凶器を向けられた時、知性は善悪はおろか夢と現実、過去と未来の判断を停止させる。"
msgstr ""

#. Occurrence 5A_2:1918:4502: scene=5A_2
#: 5A_2:1918
msgctxt "text_id=4502 | speaker=unknown"
msgid "　それまでの生活が平穏であった分だけ、その停止はより強いものになるだろう。"
msgstr ""

#. Occurrence 5A_2:1952:4503: scene=5A_2
#: 5A_2:1952
msgctxt "text_id=4503 | speaker=unknown"
msgid "　思考にあるのは「生きている今の自分」の姿だけ。"
msgstr ""

#. Occurrence 5A_2:1957:4504: scene=5A_2
#: 5A_2:1957
msgctxt "text_id=4504 | speaker=unknown"
msgid "　白紙の上にぽつんと置かれた黒い点と変わらない。"
msgstr ""

#. Occurrence 5A_2:1962:4505: scene=5A_2
#: 5A_2:1962
msgctxt "text_id=4505 | speaker=unknown"
msgid "　後も先もない、ただそれだけの状態。"
msgstr ""

#. Occurrence 5A_2:1968:4506: scene=5A_2
#: 5A_2:1968
msgctxt "text_id=4506 | speaker=unknown"
msgid "　それが銃口を向けられた人間の、ごく平均的な思考である。"
msgstr ""

#. Occurrence 5A_2:2020:4507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0015; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2020
msgctxt "text_id=4507 | speaker=aoko"
msgid "「あ、<命乞|いのちご>いは止めてね。意味ないから。"
msgstr ""

#. Occurrence 5A_2:2026:4508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0016; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2026
msgctxt "text_id=4508 | speaker=aoko"
msgid "　でも恨み言ならご自由に。殺す側の義務として、一言一句聞いてあげる」"
msgstr ""

#. Occurrence 5A_2:2032:4509: scene=5A_2
#: 5A_2:2032
msgctxt "text_id=4509 | speaker=unknown"
msgid "　意味がない、とは、一切聞かない、というコトらしい。"
msgstr ""

#. Occurrence 5A_2:2037:4510: scene=5A_2
#: 5A_2:2037
msgctxt "text_id=4510 | speaker=unknown"
msgid "　もっとも、草十郎はショック状態で声をあげる行為そのものが思いつかない。"
msgstr ""

#. Occurrence 5A_2:2085:4511: scene=5A_2
#: 5A_2:2085
msgctxt "text_id=4511 | speaker=unknown"
msgid "　確かな事は―――そう、理由はともかく、目の前の少女が自分を殺したがっている現実だけ。"
msgstr ""

#. Occurrence 5A_2:2106:4512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0011; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2106
msgctxt "text_id=4512 | speaker=soujuurou"
msgid "『う、嘘つきにもほどがある……！"
msgstr ""

#. Occurrence 5A_2:2112:4513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4513 | speaker=soujuurou"
msgid "　鳶丸のバカ、何が“そんな生き物はいない”だ！"
msgstr ""

#. Occurrence 5A_2:2112:4514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4514 | speaker=soujuurou"
msgid "　実際いるじゃないか、こんなお化けみたいなのが……！』"
msgstr ""

#. Occurrence 5A_2:2146:4515: scene=5A_2
#: 5A_2:2146
msgctxt "text_id=4515 | speaker=unknown"
msgid "　もし口に出していたら間髪入れず第二撃が飛んできたであろう感想を、草十郎はすんでのところで心にとどめた。"
msgstr ""

#. Occurrence 5A_2:2151:4516: scene=5A_2
#: 5A_2:2151
msgctxt "text_id=4516 | speaker=unknown"
msgid "　友人への悪態で<麻痺|ショック>状態から<恐慌|パニック>状態に持ち直す。"
msgstr ""

#. Occurrence 5A_2:2198:4517: scene=5A_2
#: 5A_2:2198
msgctxt "text_id=4517 | speaker=unknown"
msgid "　しかし、それは決して余裕からきたものではない。"
msgstr ""

#. Occurrence 5A_2:2204:4518: scene=5A_2
#: 5A_2:2204
msgctxt "text_id=4518 | speaker=unknown"
msgid "“ある日突然、何者かに殺される”"
msgstr ""

#. Occurrence 5A_2:2210:4519: scene=5A_2
#: 5A_2:2210
msgctxt "text_id=4519 | speaker=unknown"
msgid "　その、あまりにも<経緯|りゆう>のない非日常は、"
msgstr ""

#. Occurrence 5A_2:2231:4520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0013; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2231
msgctxt "text_id=4520 | speaker=soujuurou"
msgid "『でも、そうだった……都会には<殺|・><人|・><事|・><件|・>がある。"
msgstr ""

#. Occurrence 5A_2:2237:4521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0014; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2237
msgctxt "text_id=4521 | speaker=soujuurou"
msgid "　ルールを破れば殺されるのは当たり前だって、ちゃんと教えてもらってた……！』"
msgstr ""

#. Occurrence 5A_2:2243:4522: scene=5A_2
#: 5A_2:2243
msgctxt "text_id=4522 | speaker=unknown"
msgid "　都会に慣れていない草十郎にとって、極めて現実的なものだったからだ。"
msgstr ""

#. Occurrence 5A_2:2263:4523: scene=5A_2
#: 5A_2:2263
msgctxt "text_id=4523 | speaker=unknown"
msgid "　彼にとって同級生に殺される現実は、そう驚くべき事ではないらしい。"
msgstr ""

#. Occurrence 5A_2:2268:4524: scene=5A_2
#: 5A_2:2268
msgctxt "text_id=4524 | speaker=unknown"
msgid "　人が人を殺す<事件|ケース>が起こりえる社会ならば、そういうコトもあるだろうと受け止められる。彼は青子の行為、凶行にいたる経緯に、なんら疑問を持っていない。"
msgstr ""

#. Occurrence 5A_2:2314:4525: scene=5A_2
#: 5A_2:2314
msgctxt "text_id=4525 | speaker=unknown"
msgid "　なので、いま彼を混乱させているものは、青子が起こしている発火現象だけなのだった。"
msgstr ""

#. Occurrence 5A_2:2347:4526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0015; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2347
msgctxt "text_id=4526 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_2:2364:4527: scene=5A_2
#: 5A_2:2364
msgctxt "text_id=4527 | speaker=unknown"
msgid "　草十郎の喉がごくりと唾を飲みこむ。"
msgstr ""

#. Occurrence 5A_2:2369:4528: scene=5A_2
#: 5A_2:2369
msgctxt "text_id=4528 | speaker=unknown"
msgid "　その反応は、誰の目にも恐怖で<痺|しび>れている犠牲者に見える。"
msgstr ""

#. Occurrence 5A_2:2403:4529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0017; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2403
msgctxt "text_id=4529 | speaker=aoko"
msgid "「そういう事よ。ようやく理解してくれたわね。"
msgstr ""

#. Occurrence 5A_2:2409:4530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0018; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2409
msgctxt "text_id=4530 | speaker=aoko"
msgid "　多くは語らないけど、貴方にはここで死んでもらう。"
msgstr ""

#. Occurrence 5A_2:2427:4531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0019; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2427
msgctxt "text_id=4531 | speaker=aoko"
msgid "　魔術は<隠匿|いんとく>するもの―――なんて言ってもそっちには関係のない事だし。単に運がなかったって思えばいいわ。大事なのは、私が、貴方を殺したってコトだけだから」"
msgstr ""

#. Occurrence 5A_2:2482:4532: scene=5A_2
#: 5A_2:2482
msgctxt "text_id=4532 | speaker=unknown"
msgid "　さて、とばかりに青子は再度、右手を<掲|かか>げた。"
msgstr ""

#. Occurrence 5A_2:2487:4533: scene=5A_2
#: 5A_2:2487
msgctxt "text_id=4533 | speaker=unknown"
msgid "　機械を思わせる駆動音。"
msgstr ""

#. Occurrence 5A_2:2492:4534: scene=5A_2
#: 5A_2:2492
msgctxt "text_id=4534 | speaker=unknown"
msgid "　<袖|ふく>の下で青い光が回転している。"
msgstr ""

#. Occurrence 5A_2:2497:4535: scene=5A_2
#: 5A_2:2497
msgctxt "text_id=4535 | speaker=unknown"
msgid "　それがさっきより長い―――つまり、きっと、いま背後の壁を燃やしているものよりずっと強い―――ことに気づいて、草十郎の混乱は加速していく。"
msgstr ""

#. Occurrence 5A_2:2570:4536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0016; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2570
msgctxt "text_id=4536 | speaker=soujuurou"
msgid "“いや、なんだ、つまり、始末するとかしないとか、あの夜のお化けは蒼崎だったとか、都会はホントに込み入ってるとか、そういうコトじゃなくて―――”"
msgstr ""

#. Occurrence 5A_2:2576:4537: scene=5A_2
#: 5A_2:2576
msgctxt "text_id=4537 | speaker=unknown"
msgid "　混線する思考。"
msgstr ""

#. Occurrence 5A_2:2581:4538: scene=5A_2
#: 5A_2:2581
msgctxt "text_id=4538 | speaker=unknown"
msgid "　早鐘を打つ心臓。"
msgstr ""

#. Occurrence 5A_2:2601:4539: scene=5A_2
#: 5A_2:2601
msgctxt "text_id=4539 | speaker=unknown"
msgid "　―――もう立ち尽くしている場合じゃない。"
msgstr ""

#. Occurrence 5A_2:2636:4540: scene=5A_2
#: 5A_2:2636
msgctxt "text_id=4540 | speaker=unknown"
msgid "　目の前の少女が同じ人間であるかさえ怪しいが"
msgstr ""

#. Occurrence 5A_2:2661:4541: scene=5A_2
#: 5A_2:2661
msgctxt "text_id=4541 | speaker=unknown"
msgid "　それはともかく、やっぱり、たとえ納得がいくといってもきちんと考えてみたら、"
msgstr ""

#. Occurrence 5A_2:2683:4542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0017; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2683
msgctxt "text_id=4542 | speaker=soujuurou"
msgid "「まて、人殺しはいけないんだぞっ……！」"
msgstr ""

#. Occurrence 5A_2:2689:4543: scene=5A_2
#: 5A_2:2689
msgctxt "text_id=4543 | speaker=unknown"
msgid "　この通り、いくら都会のルールだからって殺されるのはご<免|めん>こうむる……！"
msgstr ""

#. Occurrence 5A_2:2779:4544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0020; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2779
msgctxt "text_id=4544 | speaker=aoko"
msgid "「分かってるわよ、そんな事はっ！」"
msgstr ""

#. Occurrence 5A_2:2805:4545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0018; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2805
msgctxt "text_id=4545 | speaker=soujuurou"
msgid "「ちょっ、待―――！」"
msgstr ""

#. Occurrence 5A_2:2811:4546: scene=5A_2
#: 5A_2:2811
msgctxt "text_id=4546 | speaker=unknown"
msgid "　あまりにも空気を読まない草十郎の意見は、的確に青子の<逆鱗|げきりん>に触れまくった。"
msgstr ""

#. Occurrence 5A_2:3052:4547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0019; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3052
msgctxt "text_id=4547 | speaker=soujuurou"
msgid "「うわああああ――――――！！！？」"
msgstr ""

#. Occurrence 5A_2:3058:4548: scene=5A_2
#: 5A_2:3058
msgctxt "text_id=4548 | speaker=unknown"
msgid "　連続で<撃|う>ち出される青い<魔弾|まだん>と、"
msgstr ""

#. Occurrence 5A_2:3063:4549: scene=5A_2
#: 5A_2:3063
msgctxt "text_id=4549 | speaker=unknown"
msgid "　とっさに背後の闇―――ミラーハウスの入り口に駆けこむ草十郎。"
msgstr ""

#. Occurrence 5A_2:3242:4550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0020; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3242
msgctxt "text_id=4550 | speaker=soujuurou"
msgid "「はっ―――なななんだ、今のなんだ―――！？」"
msgstr ""

#. Occurrence 5A_2:3249:4551: scene=5A_2
#: 5A_2:3249
msgctxt "text_id=4551 | speaker=unknown"
msgid "　無我夢中で長い通路を走る。"
msgstr ""

#. Occurrence 5A_2:3254:4552: scene=5A_2
#: 5A_2:3254
msgctxt "text_id=4552 | speaker=unknown"
msgid "　たった二メートルの全力疾走で息が上がっているのは初撃を上回る“見たこともない出来事”への驚きと、本気で、あと一秒でも飛びのくのが遅かったら死んでいた、という実感のせいだ。"
msgstr ""

#. Occurrence 5A_2:3330:4553: scene=5A_2
#: 5A_2:3330
msgctxt "text_id=4553 | speaker=unknown"
msgid "　足を止める余裕はない。"
msgstr ""

#. Occurrence 5A_2:3339:4554: scene=5A_2
#: 5A_2:3339
msgctxt "text_id=4554 | speaker=unknown"
msgid "　草十郎の後ろには容赦のない足音が迫っている。"
msgstr ""

#. Occurrence 5A_2:3360:4555: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0021; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3360
msgctxt "text_id=4555 | speaker=soujuurou"
msgid "「……けど助かった。ここならなんとか―――」"
msgstr ""

#. Occurrence 5A_2:3382:4556: scene=5A_2
#: 5A_2:3382
msgctxt "text_id=4556 | speaker=unknown"
msgid "　なるかもしれない、と全力で走る。"
msgstr ""

#. Occurrence 5A_2:3388:4557: scene=5A_2
#: 5A_2:3388
msgctxt "text_id=4557 | speaker=unknown"
msgid "　ミラーハウスは入り口からエントランスにあたるロビーまで、細長い通路が二十メートルほど続いている。"
msgstr ""

#. Occurrence 5A_2:3395:4558: scene=5A_2
#: 5A_2:3395
msgctxt "text_id=4558 | speaker=unknown"
msgid "　このままロビーまで逃げこめば、あとはいくらでも隠れ場所はありそうだ。"
msgstr ""

#. Occurrence 5A_2:3453:4559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0022; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3453
msgctxt "text_id=4559 | speaker=soujuurou"
msgid "『助かった……！』"
msgstr ""

#. Occurrence 5A_2:3459:4560: scene=5A_2
#: 5A_2:3459
msgctxt "text_id=4560 | speaker=unknown"
msgid "　大きな空間にたどり着く。"
msgstr ""

#. Occurrence 5A_2:3464:4561: scene=5A_2
#: 5A_2:3464
msgctxt "text_id=4561 | speaker=unknown"
msgid "　ここが一階ロビー。通路は三つ。"
msgstr ""

#. Occurrence 5A_2:3469:4562: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4562 | speaker=unknown"
msgid "　地下に下りる階段と、"
msgstr ""

#. Occurrence 5A_2:3469:4563: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4563 | speaker=unknown"
msgid "　一階迷路への入り口通路と、"
msgstr ""

#. Occurrence 5A_2:3469:4564: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4564 | speaker=unknown"
msgid "　二階に上る階段。"
msgstr ""

#. Occurrence 5A_2:3489:4565: scene=5A_2
#: 5A_2:3489
msgctxt "text_id=4565 | speaker=unknown"
msgid "　今はどれでもいい、と草十郎は直感的に一階の迷路へ逃げこもうと踏みこんで、"
msgstr ""

#. Occurrence 5A_2:3556:4566: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0023; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3556
msgctxt "text_id=4566 | speaker=soujuurou"
msgid "「痛……！？」"
msgstr ""

#. Occurrence 5A_2:3562:4567: scene=5A_2
#: 5A_2:3562
msgctxt "text_id=4567 | speaker=unknown"
msgid "　がいーん、と透明の壁に頭からぶつかった。"
msgstr ""

#. Occurrence 5A_2:3589:4568: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0024; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3589
msgctxt "text_id=4568 | speaker=soujuurou"
msgid "「か、鏡……!?」"
msgstr ""

#. Occurrence 5A_2:3595:4569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0021; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3595
msgctxt "text_id=4569 | speaker=aoko"
msgid "「ええ。面倒だけど、それならフェアでしょ？"
msgstr ""

#. Occurrence 5A_2:3601:4570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0022; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3601
msgctxt "text_id=4570 | speaker=aoko"
msgid "　追いかける方にも逃げる方にも有利不利がある」"
msgstr ""

#. Occurrence 5A_2:3630:4571: scene=5A_2
#: 5A_2:3630
msgctxt "text_id=4571 | speaker=unknown"
msgid "　どことなく楽しげな声が届く。"
msgstr ""

#. Occurrence 5A_2:3635:4572: scene=5A_2
#: 5A_2:3635
msgctxt "text_id=4572 | speaker=unknown"
msgid "　いちいち振り向くまでもない。"
msgstr ""

#. Occurrence 5A_2:3640:4573: scene=5A_2
#: 5A_2:3640
msgctxt "text_id=4573 | speaker=unknown"
msgid "　いま彼を<弾|はじ>いた鏡に、ゆっくりと歩いてくる蒼崎青子の姿が映っている。"
msgstr ""

#. Occurrence 5A_2:3661:4574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0023; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3661
msgctxt "text_id=4574 | speaker=aoko"
msgid "「それと、一階の奥にある出口は封鎖しといたから。結界じゃなくて物理的に。"
msgstr ""

#. Occurrence 5A_2:3667:4575: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0024; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3667
msgctxt "text_id=4575 | speaker=aoko"
msgid "　やりすぎて封鎖っていうより瓦礫？　土砂崩れ？　どっちでもいっか。とにかく下手に出口に近づくと崩落に巻き込まれるから。生き埋めがイヤなら近寄らないことね」"
msgstr ""

#. Occurrence 5A_2:3711:4576: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0025; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3711
msgctxt "text_id=4576 | speaker=soujuurou"
msgid "「―――、―――！」"
msgstr ""

#. Occurrence 5A_2:3717:4577: scene=5A_2
#: 5A_2:3717
msgctxt "text_id=4577 | speaker=unknown"
msgid "　近づいてくる足音に焦りながら、草十郎は手探りで壁に向かう。"
msgstr ""

#. Occurrence 5A_2:3722:4578: scene=5A_2
#: 5A_2:3722
msgctxt "text_id=4578 | speaker=unknown"
msgid "　見えているのは二階への階段だ。"
msgstr ""

#. Occurrence 5A_2:3727:4579: scene=5A_2
#: 5A_2:3727
msgctxt "text_id=4579 | speaker=unknown"
msgid "　青子の言っている<内|コ><容|ト>はさっぱりだが、一階はまずい、という事だけは確かだった。"
msgstr ""

#. Occurrence 5A_2:3768:4580: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0025; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3768
msgctxt "text_id=4580 | speaker=aoko"
msgid "「ま、私としてはそっちのが助かるけど。"
msgstr ""

#. Occurrence 5A_2:3774:4581: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0026; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3774
msgctxt "text_id=4581 | speaker=aoko"
msgid "　形式上、事故死の方が後始末とか楽だから」"
msgstr ""

#. Occurrence 5A_2:3786:4582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0026; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3786
msgctxt "text_id=4582 | speaker=soujuurou"
msgid "「……！」"
msgstr ""

#. Occurrence 5A_2:3792:4583: scene=5A_2
#: 5A_2:3792
msgctxt "text_id=4583 | speaker=unknown"
msgid "　背後には正体不明の生物。"
msgstr ""

#. Occurrence 5A_2:3797:4584: scene=5A_2
#: 5A_2:3797
msgctxt "text_id=4584 | speaker=unknown"
msgid "　彼女は軽口と共に、これみよがしに右腕を持ち上げる。"
msgstr ""

#. Occurrence 5A_2:3855:4585: scene=5A_2
#: 5A_2:3855
msgctxt "text_id=4585 | speaker=unknown"
msgid "　……それは服の上からでも分かる、少女の体には不釣り合いな、一種奇怪な<紋様|もんよう>だった。"
msgstr ""

#. Occurrence 5A_2:3860:4586: scene=5A_2
#: 5A_2:3860
msgctxt "text_id=4586 | speaker=unknown"
msgid "　皮膚の下の血管。"
msgstr ""

#. Occurrence 5A_2:3865:4587: scene=5A_2
#: 5A_2:3865
msgctxt "text_id=4587 | speaker=unknown"
msgid "　身体を巡る機能の一つが、人間以外のモノで回っているような。"
msgstr ""

#. Occurrence 5A_2:3923:4588: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0027; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3923
msgctxt "text_id=4588 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_2:3928:4589: scene=5A_2
#: 5A_2:3928
msgctxt "text_id=4589 | speaker=unknown"
msgid "　それを傷ましいとも、おぞましいとも感じたのか。"
msgstr ""

#. Occurrence 5A_2:3933:4590: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4590 | speaker=unknown"
msgid "　一瞬だけ足を止める草十郎と、"
msgstr ""

#. Occurrence 5A_2:3933:4591: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4591 | speaker=unknown"
msgid "　その視線を受け流す追跡者。"
msgstr ""

#. Occurrence 5A_2:3975:4592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0027; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3975
msgctxt "text_id=4592 | speaker=aoko"
msgid "「ああ、これ？　普段は塗り薬で隠しているんだけど、今日は特別。"
msgstr ""

#. Occurrence 5A_2:3986:4593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0028; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3986
msgctxt "text_id=4593 | speaker=aoko"
msgid "　魔術刻印って言ってね、魔術師の証みたいな物よ。"
msgstr ""

#. Occurrence 5A_2:3992:4594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0029; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3992
msgctxt "text_id=4594 | speaker=aoko"
msgid "　ほら、光が回ってるでしょ？　これがさっきのスナップ……分かりやすくいうと弾丸のもと。"
msgstr ""

#. Occurrence 5A_2:4003:4595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0030; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4003
msgctxt "text_id=4595 | speaker=aoko"
msgid "　今日は調子いいし、私、魔力を効率よく使うのだけは自信あるし―――うん、あと三十回ぐらいかな？　さっきみたいな掃射ができるのは」"
msgstr ""

#. Occurrence 5A_2:4023:4596: scene=5A_2
#: 5A_2:4023
msgctxt "text_id=4596 | speaker=unknown"
msgid "　感情がハイになっているのか、彼女はやけにフレンドリーな口調だった。"
msgstr ""

#. Occurrence 5A_2:4049:4597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0028; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4049
msgctxt "text_id=4597 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 5A_2:4054:4598: scene=5A_2
#: 5A_2:4054
msgctxt "text_id=4598 | speaker=unknown"
msgid "　もっとも、会話の内容は物騒なコトこの上ないのだが。"
msgstr ""

#. Occurrence 5A_2:4081:4599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0029; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4081
msgctxt "text_id=4599 | speaker=soujuurou"
msgid "「……そもそも、何を言っているかよく分からないんだけど、蒼崎」"
msgstr ""

#. Occurrence 5A_2:4087:4600: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0031; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4087
msgctxt "text_id=4600 | speaker=aoko"
msgid "「分からない？　弾数はあと三十発って事。"
msgstr ""

#. Occurrence 5A_2:4093:4601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0032; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4093
msgctxt "text_id=4601 | speaker=aoko"
msgid "　そこまで逃げ切ればあなたの勝ちよ。とりあえず、今日のところはね」"
msgstr ""

#. Occurrence 5A_2:4126:4602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0030; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4126
msgctxt "text_id=4602 | speaker=soujuurou"
msgid "『……今日はって、明日もあるのかな……』"
msgstr ""

#. Occurrence 5A_2:4132:4603: scene=5A_2
#: 5A_2:4132
msgctxt "text_id=4603 | speaker=unknown"
msgid "　眉をひそめて悩む草十郎。"
msgstr ""

#. Occurrence 5A_2:4221:4604: scene=5A_2
#: 5A_2:4221
msgctxt "text_id=4604 | speaker=unknown"
msgid "　恐慌しながらも、やはり根っこのところで危機感のない態度に、青子も<微|かす>かに眉を寄せる。"
msgstr ""

#. Occurrence 5A_2:4226:4605: scene=5A_2
#: 5A_2:4226
msgctxt "text_id=4605 | speaker=unknown"
msgid "　やっぱりこいつは理解できない、と。"
msgstr ""

#. Occurrence 5A_2:4254:4606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0033; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4254
msgctxt "text_id=4606 | speaker=aoko"
msgid "「宣言はしたわ。自由時間はこれでおしまい。"
msgstr ""

#. Occurrence 5A_2:4260:4607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0034; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4260
msgctxt "text_id=4607 | speaker=aoko"
msgid "　まだ<罵|ののし>り足りないだろうけど、ま、その手の時間はキリがないしね。このあたりで<諦|あきら>めて」"
msgstr ""

#. Occurrence 5A_2:4287:4608: scene=5A_2
#: 5A_2:4287
msgctxt "text_id=4608 | speaker=unknown"
msgid "　どうも、この<弛緩|しかん>した会話劇は<意|い><図|と>的に用意されたものらしい。"
msgstr ""

#. Occurrence 5A_2:4292:4609: scene=5A_2
#: 5A_2:4292
msgctxt "text_id=4609 | speaker=unknown"
msgid "　届かない命乞いではなく、殺人者を呪う<時間|けんり>。"
msgstr ""

#. Occurrence 5A_2:4297:4610: scene=5A_2
#: 5A_2:4297
msgctxt "text_id=4610 | speaker=unknown"
msgid "　……青子流の公正さなのだが、締まらないコトに、今回はうまく機能しなかったようだ。"
msgstr ""

#. Occurrence 5A_2:4366:4611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0035; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4366
msgctxt "text_id=4611 | speaker=aoko"
msgid "「とにかくそういう事だから。"
msgstr ""

#. Occurrence 5A_2:4377:4612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0036; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4377
msgctxt "text_id=4612 | speaker=aoko"
msgid "　―――じゃ、狩りの時間といきましょうか」"
msgstr ""

#. Occurrence 5A_2:4383:4613: scene=5A_2
#: 5A_2:4383
msgctxt "text_id=4613 | speaker=unknown"
msgid "　感情を<排|はい>した声と、冷酷に獲物を見据える瞳。"
msgstr ""

#. Occurrence 5A_2:4388:4614: scene=5A_2
#: 5A_2:4388
msgctxt "text_id=4614 | speaker=unknown"
msgid "　それで今度こそ本当に、自分が殺されるという現実を、草十郎は実感した。"
msgstr ""

#. Occurrence 5A_3:60:4615: scene=5A_3
#: 5A_3:60
msgctxt "text_id=4615 | speaker=unknown"
msgid "　……長らく入園者のいない夢の<廃墟|あと>に、<彼|ソ><女|レ>は力なく、亡霊のような静けさで足を踏み入れた。"
msgstr ""

#. Occurrence 5A_3:66:4616: scene=5A_3
#: 5A_3:66
msgctxt "text_id=4616 | speaker=unknown"
msgid "　今夜は無風で、周囲は無人。"
msgstr ""

#. Occurrence 5A_3:75:4617: scene=5A_3
#: 5A_3:75
msgctxt "text_id=4617 | speaker=unknown"
msgid "　それなのに響いてくる雑音に、<彼|ソ><女|レ>はにんまりと、手を合わせて微笑んだ。"
msgstr ""

#. Occurrence 5A_3:134:4618: scene=5A_3
#: 5A_3:134
msgctxt "text_id=4618 | speaker=unknown"
msgid "　可愛らしく合わされた<手|カタチ>は、チューリップの蕾のようだ。"
msgstr ""

#. Occurrence 5A_3:140:4619: scene=5A_3
#: 5A_3:140
msgctxt "text_id=4619 | speaker=unknown"
msgid "　<入|ゲ><り|ー><口|ト>横の係員室の<曇|くも>った鏡に、造花の仕草が映し出される。"
msgstr ""

#. Occurrence 5A_3:145:4620: scene=5A_3
#: 5A_3:145
msgctxt "text_id=4620 | speaker=unknown"
msgid "　その横には、錆びに錆びた掲示板。"
msgstr ""

#. Occurrence 5A_3:209:4621: scene=5A_3
#: 5A_3:209
msgctxt "text_id=4621 | speaker=unknown"
msgid "　　　　　『今日の入園者数：　　２人"
msgstr ""

#. Occurrence 5A_3:215:4622: scene=5A_3
#: 5A_3:215
msgctxt "text_id=4622 | speaker=unknown"
msgid "　　　　　　今日の××××：　　　件』"
msgstr ""

#. Occurrence 5A_3:222:4623: scene=5A_3
#: 5A_3:222
msgctxt "text_id=4623 | speaker=unknown"
msgid "　　　　　　今日の××××：　　　件』"
msgstr ""

#. Occurrence 5A_3:257:4624: scene=5A_3
#: 5A_3:257
msgctxt "text_id=4624 | speaker=unknown"
msgid "　風蝕にさらされた掲示板には心ない落書きが一つ。"
msgstr ""

#. Occurrence 5A_3:263:4625: scene=5A_3
#: 5A_3:263
msgctxt "text_id=4625 | speaker=unknown"
msgid "　今日の××××数は、死亡事故、という単語に書き換えられていた。"
msgstr ""

#. Occurrence 5A_3:268:4626: scene=5A_3
#: 5A_3:268
msgctxt "text_id=4626 | speaker=unknown"
msgid "　もう使われるコトのない記録表。"
msgstr ""

#. Occurrence 5A_3:273:4627: scene=5A_3
#: 5A_3:273
msgctxt "text_id=4627 | speaker=unknown"
msgid "　それが何であるかたっぷり十秒ほど考えて、<彼|ソ><女|レ>は新たな数字を付け足した。"
msgstr ""

#. Occurrence 5A_3:332:4628: scene=5A_3
#: 5A_3:332
msgctxt "text_id=4628 | speaker=unknown"
msgid "　　　　　　『今日の入園者数：　　３人"
msgstr ""

msgctxt "text_id=4629 | speaker=unknown"
msgid "　　　　　　　今日の死亡事故：　　１件』"
msgstr ""

#. Occurrence 5A_3:367:4630: scene=5A_3
#: 5A_3:367
msgctxt "text_id=4630 | speaker=unknown"
msgid "　人差し指で数字を付け足して、彼女は花のように微笑む。"
msgstr ""

#. Occurrence 5A_3:372:4631: scene=5A_3
#: 5A_3:372
msgctxt "text_id=4631 | speaker=unknown"
msgid "　……は、音に向かって歩きだす。"
msgstr ""

#. Occurrence 5A_3:433:4632: scene=5A_3
#: 5A_3:433
msgctxt "text_id=4632 | speaker=unknown"
msgid "　ミラーハウスから狂詩曲じみた雑音が<響|ひび>きだしてから、はや十分。"
msgstr ""

#. Occurrence 5A_3:440:4633: scene=5A_3
#: 5A_3:440
msgctxt "text_id=4633 | speaker=unknown"
msgid "　遊園地の入り口は、ずっと無人のままだった。"
msgstr ""

#. Occurrence 5A_4:45:4634: scene=5A_4
#: 5A_4:45
msgctxt "text_id=4634 | speaker=unknown"
msgid "　結論から言えば。"
msgstr ""

#. Occurrence 5A_4:50:4635: scene=5A_4
#: 5A_4:50
msgctxt "text_id=4635 | speaker=unknown"
msgid "　仮に、<草十郎|カレ>が世界で一番強運な男だとしても、逃げきれる筈はなかったのである。"
msgstr ""

#. Occurrence 5A_4:88:4636: scene=5A_4
#: 5A_4:88
msgctxt "text_id=4636 | speaker=unknown"
msgid "　ただ、どこまでが計算通りで、"
msgstr ""

#. Occurrence 5A_4:93:4637: scene=5A_4
#: 5A_4:93
msgctxt "text_id=4637 | speaker=unknown"
msgid "　どこまでが偶然だったのか。"
msgstr ""

#. Occurrence 5A_4:98:4638: scene=5A_4
#: 5A_4:98
msgctxt "text_id=4638 | speaker=unknown"
msgid "　それは結末を用意していた青子にも分からない。"
msgstr ""

#. Occurrence 5A_4:119:4639: scene=5A_4
#: 5A_4:119
msgctxt "text_id=4639 | speaker=unknown"
msgid "　彼女に言えるのは三つだけ。"
msgstr ""

#. Occurrence 5A_4:124:4640: scene=5A_4
#: 5A_4:124
msgctxt "text_id=4640 | speaker=unknown"
msgid "　思っていたより時間がかかって、"
msgstr ""

#. Occurrence 5A_4:129:4641: scene=5A_4
#: 5A_4:129
msgctxt "text_id=4641 | speaker=unknown"
msgid "　予想していたより<手応|てごた>えがあって、"
msgstr ""

#. Occurrence 5A_4:134:4642: scene=5A_4
#: 5A_4:134
msgctxt "text_id=4642 | speaker=unknown"
msgid "　それと、ミラーハウスを選んだのは失敗だった、というコトぐらい。"
msgstr ""

#. Occurrence 5A_4:202:4643: scene=5A_4
#: 5A_4:202
msgctxt "text_id=4643 | speaker=unknown"
msgid "　……そう、何が失敗かと言うと。"
msgstr ""

#. Occurrence 5A_4:207:4644: scene=5A_4
#: 5A_4:207
msgctxt "text_id=4644 | speaker=unknown"
msgid "　ミラーハウスは狩り場として文句なしの地形だったけれど、鏡に映る自分と向き合うのは半人前の彼女にとって、少しだけ苛立たしいコトだった。"
msgstr ""

#. Occurrence 5A_4:463:4645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0000; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:463
msgctxt "text_id=4645 | speaker=soujuurou"
msgid "「うわあ！」"
msgstr ""

#. Occurrence 5A_4:469:4646: scene=5A_4
#: 5A_4:469
msgctxt "text_id=4646 | speaker=unknown"
msgid "　青子の右腕が光った瞬間、草十郎は目の前の階段に逃げこんだ。"
msgstr ""

#. Occurrence 5A_4:474:4647: scene=5A_4
#: 5A_4:474
msgctxt "text_id=4647 | speaker=unknown"
msgid "　背後には連続する青い<閃光|ストロボ>。"
msgstr ""

#. Occurrence 5A_4:479:4648: scene=5A_4
#: 5A_4:479
msgctxt "text_id=4648 | speaker=unknown"
msgid "　無我夢中で階段を駆け上がる獲物を、狩人はあわてずに追っていく。"
msgstr ""

#. Occurrence 5A_4:592:4649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0000; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:592
msgctxt "text_id=4649 | speaker=aoko"
msgid "「―――注文通り。"
msgstr ""

#. Occurrence 5A_4:598:4650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0001; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:598
msgctxt "text_id=4650 | speaker=aoko"
msgid "　そうでなくっちゃ、お<膳立|ぜんだ>てした甲斐がない」"
msgstr ""

#. Occurrence 5A_4:604:4651: scene=5A_4
#: 5A_4:604
msgctxt "text_id=4651 | speaker=unknown"
msgid "　走る草十郎とは対照的に、青子はやや早歩きで階段を上っていく。"
msgstr ""

#. Occurrence 5A_4:650:4652: scene=5A_4
#: 5A_4:650
msgctxt "text_id=4652 | speaker=unknown"
msgid "　青子が走って追わないのは、獲物と一定の距離を保つためだ。"
msgstr ""

#. Occurrence 5A_4:655:4653: scene=5A_4
#: 5A_4:655
msgctxt "text_id=4653 | speaker=unknown"
msgid "　命中率に自信のない彼女にとって、もっとも対処に困るのが玉砕覚悟の突進である。"
msgstr ""

#. Occurrence 5A_4:751:4654: scene=5A_4
#: 5A_4:751
msgctxt "text_id=4654 | speaker=unknown"
msgid "　十メートル程度の距離があるのなら問題はない。"
msgstr ""

#. Occurrence 5A_4:756:4655: scene=5A_4
#: 5A_4:756
msgctxt "text_id=4655 | speaker=unknown"
msgid "　獲物が接近するまで十発中四発は当てられる。"
msgstr ""

#. Occurrence 5A_4:761:4656: scene=5A_4
#: 5A_4:761
msgctxt "text_id=4656 | speaker=unknown"
msgid "　しかし先ほどの位置関係は少々まずかった。"
msgstr ""

#. Occurrence 5A_4:766:4657: scene=5A_4
#: 5A_4:766
msgctxt "text_id=4657 | speaker=unknown"
msgid "　あの距離、あの広さの空間で迂回されながら突進されたら、わずかではあるが、そのまま接近されて素手での争いになる可能性がある。"
msgstr ""

#. Occurrence 5A_4:786:4658: scene=5A_4
#: 5A_4:786
msgctxt "text_id=4658 | speaker=unknown"
msgid "　現在、青子の最大の武器は右腕の魔弾だ。"
msgstr ""

#. Occurrence 5A_4:791:4659: scene=5A_4
#: 5A_4:791
msgctxt "text_id=4659 | speaker=unknown"
msgid "　この利点を生かすのなら距離を詰めすぎてはいけない。"
msgstr ""

#. Occurrence 5A_4:796:4660: scene=5A_4
#: 5A_4:796
msgctxt "text_id=4660 | speaker=unknown"
msgid "　近づく時があるとしたら、それは獲物の体力がなくなり、<諦|あきら>めたあと。"
msgstr ""

#. Occurrence 5A_4:851:4661: scene=5A_4
#: 5A_4:851
msgctxt "text_id=4661 | speaker=unknown"
msgid "　足を射貫くか、背中を撃つか。"
msgstr ""

#. Occurrence 5A_4:856:4662: scene=5A_4
#: 5A_4:856
msgctxt "text_id=4662 | speaker=unknown"
msgid "　あるいは、この迷路で心が折れるか。"
msgstr ""

#. Occurrence 5A_4:861:4663: scene=5A_4
#: 5A_4:861
msgctxt "text_id=4663 | speaker=unknown"
msgid "　なんらかの傷を負って標的が走れなくなった時が、この狩りの幕引きとなる。"
msgstr ""

#. Occurrence 5A_4:917:4664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0001; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:917
msgctxt "text_id=4664 | speaker=soujuurou"
msgid "「っ―――！」"
msgstr ""

#. Occurrence 5A_4:923:4665: scene=5A_4
#: 5A_4:923
msgctxt "text_id=4665 | speaker=unknown"
msgid "　一方、草十郎は悲鳴を<堪|こら>えながら迷路を走っていた。"
msgstr ""

#. Occurrence 5A_4:928:4666: scene=5A_4
#: 5A_4:928
msgctxt "text_id=4666 | speaker=unknown"
msgid "　出口など目指しようもなく、まっすぐ走る事すら難しい。"
msgstr ""

#. Occurrence 5A_4:988:4667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0002; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:988
msgctxt "text_id=4667 | speaker=soujuurou"
msgid "「あいた！？」"
msgstr ""

#. Occurrence 5A_4:994:4668: scene=5A_4
#: 5A_4:994
msgctxt "text_id=4668 | speaker=unknown"
msgid "　長く伸びている通路は、そう見えるだけで鏡の壁でふさがれている。"
msgstr ""

#. Occurrence 5A_4:1000:4669: scene=5A_4
#: 5A_4:1000
msgctxt "text_id=4669 | speaker=unknown"
msgid "　あわてて右に曲がろうとして、"
msgstr ""

#. Occurrence 5A_4:1066:4670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0003; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1066
msgctxt "text_id=4670 | speaker=soujuurou"
msgid "「あたた！？」"
msgstr ""

#. Occurrence 5A_4:1074:4671: scene=5A_4
#: 5A_4:1074
msgctxt "text_id=4671 | speaker=unknown"
msgid "　草十郎は額をおさえながら残った左に腕を伸ばし、壁がない事を確認し、"
msgstr ""

#. Occurrence 5A_4:1131:4672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0004; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1131
msgctxt "text_id=4672 | speaker=soujuurou"
msgid "「！」"
msgstr ""

#. Occurrence 5A_4:1136:4673: scene=5A_4
#: 5A_4:1136
msgctxt "text_id=4673 | speaker=unknown"
msgid "　とっさに左の通路に飛びこんで、コンマの差で凶弾から身をかわす。"
msgstr ""

#. Occurrence 5A_4:1219:4674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0005; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1219
msgctxt "text_id=4674 | speaker=soujuurou"
msgid "「はっ―――、は―――！」"
msgstr ""

#. Occurrence 5A_4:1225:4675: scene=5A_4
#: 5A_4:1225
msgctxt "text_id=4675 | speaker=unknown"
msgid "　近づいてくる足音にせき立てられて、考える前にとにかく走る。"
msgstr ""

#. Occurrence 5A_4:1273:4676: scene=5A_4
#: 5A_4:1273
msgctxt "text_id=4676 | speaker=unknown"
msgid "　今のは本当に紙一重だった。"
msgstr ""

#. Occurrence 5A_4:1279:4677: scene=5A_4
#: 5A_4:1279
msgctxt "text_id=4677 | speaker=unknown"
msgid "　後ろ髪の焦げた臭いがする。"
msgstr ""

#. Occurrence 5A_4:1284:4678: scene=5A_4
#: 5A_4:1284
msgctxt "text_id=4678 | speaker=unknown"
msgid "　きっと強運。"
msgstr ""

#. Occurrence 5A_4:1289:4679: scene=5A_4
#: 5A_4:1289
msgctxt "text_id=4679 | speaker=unknown"
msgid "　あるいは悪運だ。"
msgstr ""

#. Occurrence 5A_4:1295:4680: scene=5A_4
#: 5A_4:1295
msgctxt "text_id=4680 | speaker=unknown"
msgid "幸運の類があるなら、そもそもこんな事態になってはいない。"
msgstr ""

#. Occurrence 5A_4:1342:4681: scene=5A_4
#: 5A_4:1342
msgctxt "text_id=4681 | speaker=unknown"
msgid "　ミラーハウスの二階は巨大な渦巻き状になっているらしい。"
msgstr ""

#. Occurrence 5A_4:1347:4682: scene=5A_4
#: 5A_4:1347
msgctxt "text_id=4682 | speaker=unknown"
msgid "　外周からはじまって、とにかく左に左にと曲がっていく。"
msgstr ""

#. Occurrence 5A_4:1352:4683: scene=5A_4
#: 5A_4:1352
msgctxt "text_id=4683 | speaker=unknown"
msgid "　いきつく先はどんづまり。逃げれば逃げるほど追いつめられる、<蝸牛|かたつむり>のカラに似た断頭台だ。"
msgstr ""

#. Occurrence 5A_4:1435:4684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0006; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1435
msgctxt "text_id=4684 | speaker=soujuurou"
msgid "「…………、っ」"
msgstr ""

#. Occurrence 5A_4:1443:4685: scene=5A_4
#: 5A_4:1443
msgctxt "text_id=4685 | speaker=unknown"
msgid "　<抑|おさ>えつけた悲鳴が、文句になって出てきそうだ。"
msgstr ""

#. Occurrence 5A_4:1448:4686: scene=5A_4
#: 5A_4:1448
msgctxt "text_id=4686 | speaker=unknown"
msgid "　どのみち殺されるのに、こんなワケの分からない状況がまだ<数秒|すうびょう><数分|すうふん>、自分の頑張り次第で続くなんて―――！"
msgstr ""

#. Occurrence 5A_4:1483:4687: scene=5A_4
#: 5A_4:1483
msgctxt "text_id=4687 | speaker=unknown"
msgid "　けれど走る。"
msgstr ""

#. Occurrence 5A_4:1488:4688: scene=5A_4
#: 5A_4:1488
msgctxt "text_id=4688 | speaker=unknown"
msgid "　何度も鏡の壁にぶつかりながら走る。"
msgstr ""

#. Occurrence 5A_4:1493:4689: scene=5A_4
#: 5A_4:1493
msgctxt "text_id=4689 | speaker=unknown"
msgid "　衝突のたび目に星が舞って、額から出血しても走る。"
msgstr ""

#. Occurrence 5A_4:1570:4690: scene=5A_4
#: 5A_4:1570
msgctxt "text_id=4690 | speaker=unknown"
msgid "　激痛は数秒ごとに。"
msgstr ""

#. Occurrence 5A_4:1575:4691: scene=5A_4
#: 5A_4:1575
msgctxt "text_id=4691 | speaker=unknown"
msgid "　がむしゃらに走れば走るほど手ひどく透明の壁にぶつかってしまう。"
msgstr ""

#. Occurrence 5A_4:1580:4692: scene=5A_4
#: 5A_4:1580
msgctxt "text_id=4692 | speaker=unknown"
msgid "　体はもうその法則を覚え始めていて、これ以上は走りたくないと<訴|うった>える。"
msgstr ""

#. Occurrence 5A_4:1661:4693: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0007; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1661
msgctxt "text_id=4693 | speaker=soujuurou"
msgid "「はっ、は―――！」"
msgstr ""

#. Occurrence 5A_4:1667:4694: scene=5A_4
#: 5A_4:1667
msgctxt "text_id=4694 | speaker=unknown"
msgid "　結果、たった六十メートル程度の全力疾走で息が上がっていた。"
msgstr ""

#. Occurrence 5A_4:1672:4695: scene=5A_4
#: 5A_4:1672
msgctxt "text_id=4695 | speaker=unknown"
msgid "　そもそも<而|しか>るに、どう考えてもマトモじゃない。いくらなんでも突拍子がなさすぎる。"
msgstr ""

#. Occurrence 5A_4:1679:4696: scene=5A_4
#: 5A_4:1679
msgctxt "text_id=4696 | speaker=unknown"
msgid "こんなのは<性質|たち>の悪い冗談で、振り返ればやりすぎてゴメンと謝る彼女がいるに決まっている。"
msgstr ""

#. Occurrence 5A_4:1686:4697: scene=5A_4
#: 5A_4:1686
msgctxt "text_id=4697 | speaker=unknown"
msgid "頭は真っ白で、体は度重なる衝突で音を上げて、そうに違いないと足を止めそうになったところに、"
msgstr ""

#. Occurrence 5A_4:1729:4698: scene=5A_4
#: 5A_4:1729
msgctxt "text_id=4698 | speaker=unknown"
msgid "　ぞくりと。"
msgstr ""

#. Occurrence 5A_4:1734:4699: scene=5A_4
#: 5A_4:1734
msgctxt "text_id=4699 | speaker=unknown"
msgid "　首もとに<被|かぶ>さるような、死の手触りを感じ取った。"
msgstr ""

#. Occurrence 5A_4:1766:4700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0008; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1766
msgctxt "text_id=4700 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_4:1772:4701: scene=5A_4
#: 5A_4:1772
msgctxt "text_id=4701 | speaker=unknown"
msgid "　大げさな話ではなく、草十郎はこの類の悪寒をイヤというほど知っていた。"
msgstr ""

#. Occurrence 5A_4:1777:4702: scene=5A_4
#: 5A_4:1777
msgctxt "text_id=4702 | speaker=unknown"
msgid "　なにしろ町にやってきてからこっち、死にかけた事は一度や二度ではなかったのだ。"
msgstr ""

#. Occurrence 5A_4:1782:4703: scene=5A_4
#: 5A_4:1782
msgctxt "text_id=4703 | speaker=unknown"
msgid "　道を行く自動車や通勤ラッシュで混雑する駅のホームは、ルールを知らない彼からすれば、いまの状況とそう大差のないものなのだから。"
msgstr ""

#. Occurrence 5A_4:1865:4704: scene=5A_4
#: 5A_4:1865
msgctxt "text_id=4704 | speaker=unknown"
msgid "　彼はまだ命も恐怖も知らない、無邪気な幼子ではない。"
msgstr ""

#. Occurrence 5A_4:1881:4705: scene=5A_4
#: 5A_4:1881
msgctxt "text_id=4705 | speaker=unknown"
msgid "　一つの人格としてかたちどられた知性が、ある日突然、まったく違う文化圏に放りこまれただけ。"
msgstr ""

#. Occurrence 5A_4:1886:4706: scene=5A_4
#: 5A_4:1886
msgctxt "text_id=4706 | speaker=unknown"
msgid "　この町にとって当然のもの―――安全が約束されている公共の機構ですら、彼にとっては“未知”の脅威だった。"
msgstr ""

#. Occurrence 5A_4:1929:4707: scene=5A_4
#: 5A_4:1929
msgctxt "text_id=4707 | speaker=unknown"
msgid "　……だから、既に慣れてはいたし。"
msgstr ""

#. Occurrence 5A_4:1934:4708: scene=5A_4
#: 5A_4:1934
msgctxt "text_id=4708 | speaker=unknown"
msgid "　正直に告白すれば、不満に思う事だってあったのだ。"
msgstr ""

#. Occurrence 5A_4:1974:4709: scene=5A_4
#: 5A_4:1974
msgctxt "text_id=4709 | speaker=unknown"
msgid "　まったく不要なもの。"
msgstr ""

#. Occurrence 5A_4:1979:4710: scene=5A_4
#: 5A_4:1979
msgctxt "text_id=4710 | speaker=unknown"
msgid "　まったく価値を見いだせないものにあふれ、それらがすべて危険な役割を持った世界。"
msgstr ""

#. Occurrence 5A_4:1984:4711: scene=5A_4
#: 5A_4:1984
msgctxt "text_id=4711 | speaker=unknown"
msgid "　コンビニエンスストアにある多くの日用雑貨すら、彼にとってはたいへん優れた“道具”である。"
msgstr ""

#. Occurrence 5A_4:2004:4712: scene=5A_4
#: 5A_4:2004
msgctxt "text_id=4712 | speaker=unknown"
msgid "　文明はその水準を上げるほど、人間の持つ危機感を麻痺させる。"
msgstr ""

#. Occurrence 5A_4:2009:4713: scene=5A_4
#: 5A_4:2009
msgctxt "text_id=4713 | speaker=unknown"
msgid "　裕福さ、便利さを進めていく街のあり方は、田舎で育った草十郎にとっては毒そのものだ。"
msgstr ""

#. Occurrence 5A_4:2053:4714: scene=5A_4
#: 5A_4:2053
msgctxt "text_id=4714 | speaker=unknown"
msgid "　そして不幸な事に、彼には便利さを甘受するだけの余裕がなく。"
msgstr ""

#. Occurrence 5A_4:2058:4715: scene=5A_4
#: 5A_4:2058
msgctxt "text_id=4715 | speaker=unknown"
msgid "　扱い方を間違えるだけで<容易|ようい>に、唐突に、誰もが意図しなかった事故が起きる都会の便利さに、ずっと、違和感を抱いていた。"
msgstr ""

#. Occurrence 5A_4:2063:4716: scene=5A_4
#: 5A_4:2063
msgctxt "text_id=4716 | speaker=unknown"
msgid "　どうして。"
msgstr ""

#. Occurrence 5A_4:2068:4717: scene=5A_4
#: 5A_4:2068
msgctxt "text_id=4717 | speaker=unknown"
msgid "　なんで自分は、こんなところにいるのだろう、と。"
msgstr ""

#. Occurrence 5A_4:2200:4718: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0009; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2200
msgctxt "text_id=4718 | speaker=soujuurou"
msgid "「―――、ああ」"
msgstr ""

#. Occurrence 5A_4:2206:4719: scene=5A_4
#: 5A_4:2206
msgctxt "text_id=4719 | speaker=unknown"
msgid "　皮肉にすぎる。"
msgstr ""

#. Occurrence 5A_4:2212:4720: scene=5A_4
#: 5A_4:2212
msgctxt "text_id=4720 | speaker=unknown"
msgid "　そんな、今まで気付かなかった本心に、"
msgstr ""

msgctxt "text_id=4721 | speaker=unknown"
msgid "　命を狙われている状況で、<天啓|てんけい>のように思い知るなんて。"
msgstr ""

#. Occurrence 5A_4:2234:4722: scene=5A_4
#: 5A_4:2234
msgctxt "text_id=4722 | speaker=unknown"
msgid "　……そう。唐突なのは今に始まった事ではない。"
msgstr ""

#. Occurrence 5A_4:2239:4723: scene=5A_4
#: 5A_4:2239
msgctxt "text_id=4723 | speaker=unknown"
msgid "　死にそうな目に遭うのはそこまで特別な事ではない。"
msgstr ""

#. Occurrence 5A_4:2244:4724: scene=5A_4
#: 5A_4:2244
msgctxt "text_id=4724 | speaker=unknown"
msgid "　本来<安全|あんぜん>というのは対価を支払って得るものなのだし。"
msgstr ""

#. Occurrence 5A_4:2249:4725: scene=5A_4
#: 5A_4:2249
msgctxt "text_id=4725 | speaker=unknown"
msgid "　生きているのなら常に逆の目が待っている。"
msgstr ""

#. Occurrence 5A_4:2255:4726: scene=5A_4
#: 5A_4:2255
msgctxt "text_id=4726 | speaker=unknown"
msgid "　例えば、夜の街灯のように。"
msgstr ""

#. Occurrence 5A_4:2260:4727: scene=5A_4
#: 5A_4:2260
msgctxt "text_id=4727 | speaker=unknown"
msgid "　朝になれば当然、その明かりは消えるのだ。"
msgstr ""

#. Occurrence 5A_4:2347:4728: scene=5A_4
#: 5A_4:2347
msgctxt "text_id=4728 | speaker=unknown"
msgid "　容赦なく撃ちだされる正体不明の凶器。"
msgstr ""

#. Occurrence 5A_4:2352:4729: scene=5A_4
#: 5A_4:2352
msgctxt "text_id=4729 | speaker=unknown"
msgid "　二日前の夜、青い炎に包まれて消し<炭|ずみ>になった人影が脳裏に蘇る。"
msgstr ""

#. Occurrence 5A_4:2385:4730: scene=5A_4
#: 5A_4:2385
msgctxt "text_id=4730 | speaker=unknown"
msgid "　釣られた<人参|にんじん>欲しさに走る馬みたいだ、と彼は思った。"
msgstr ""

#. Occurrence 5A_4:2394:4731: scene=5A_4
#: 5A_4:2394
msgctxt "text_id=4731 | speaker=unknown"
msgid "　とにかくアゴをあげて迷路を走る。"
msgstr ""

#. Occurrence 5A_4:2412:4732: scene=5A_4
#: 5A_4:2412
msgctxt "text_id=4732 | speaker=unknown"
msgid "　でも、いったい何のために？"
msgstr ""

#. Occurrence 5A_4:2460:4733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0010; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2460
msgctxt "text_id=4733 | speaker=soujuurou"
msgid "「はっ―――、はっ―――」"
msgstr ""

#. Occurrence 5A_4:2466:4734: scene=5A_4
#: 5A_4:2466
msgctxt "text_id=4734 | speaker=unknown"
msgid "　心臓の苦しさは本物なのに、まるで現実感がない。"
msgstr ""

#. Occurrence 5A_4:2472:4735: scene=5A_4
#: 5A_4:2472
msgctxt "text_id=4735 | speaker=unknown"
msgid "　天窓から見える夜空は泥を流したような<群青|ぐんじょう>で、<草十郎|カレ>の知っている夜空には似ても似つかない。"
msgstr ""

#. Occurrence 5A_4:2520:4736: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0011; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2520
msgctxt "text_id=4736 | speaker=soujuurou"
msgid "「―――、は」"
msgstr ""

#. Occurrence 5A_4:2525:4737: scene=5A_4
#: 5A_4:2525
msgctxt "text_id=4737 | speaker=unknown"
msgid "　唐突に気が<緩|ゆる>む。"
msgstr ""

#. Occurrence 5A_4:2530:4738: scene=5A_4
#: 5A_4:2530
msgctxt "text_id=4738 | speaker=unknown"
msgid "　<捨|す>て<鉢|ばち>気味に草十郎は笑って、わりと大切なものが折れた気がした。"
msgstr ""

#. Occurrence 5A_4:2550:4739: scene=5A_4
#: 5A_4:2550
msgctxt "text_id=4739 | speaker=unknown"
msgid "　だって、そもそも全てがどうでもいい。"
msgstr ""

#. Occurrence 5A_4:2617:4740: scene=5A_4
#: 5A_4:2617
msgctxt "text_id=4740 | speaker=unknown"
msgid "　それでもなんとか足が進んだのは、合わせ鏡に彼女の姿が映るからだ。"
msgstr ""

#. Occurrence 5A_4:2735:4741: scene=5A_4
#: 5A_4:2735
msgctxt "text_id=4741 | speaker=unknown"
msgid "　追いかけっこをするネコとネズミのように、草十郎は鏡の迷路を<遁走|とんそう>する。"
msgstr ""

#. Occurrence 5A_4:2740:4742: scene=5A_4
#: 5A_4:2740
msgctxt "text_id=4742 | speaker=unknown"
msgid "　その、妙に現実感のない緊迫は、実質四分ほどで終了した。"
msgstr ""

#. Occurrence 5A_4:2917:4743: scene=5A_4
#: 5A_4:2917
msgctxt "text_id=4743 | speaker=unknown"
msgid "　九回目の青い光が、草十郎の真横で発火する。"
msgstr ""

#. Occurrence 5A_4:2922:4744: scene=5A_4
#: 5A_4:2922
msgctxt "text_id=4744 | speaker=unknown"
msgid "　光は壁に被弾するなり爆発して、その衝撃で草十郎を反対側の壁に叩きつける。"
msgstr ""

#. Occurrence 5A_4:2928:4745: scene=5A_4
#: 5A_4:2928
msgctxt "text_id=4745 | speaker=unknown"
msgid "　文句なく、今までで一番「死」に近い一撃だった。"
msgstr ""

#. Occurrence 5A_4:3030:4746: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0012; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3030
msgctxt "text_id=4746 | speaker=soujuurou"
msgid "「痛っ……！」"
msgstr ""

#. Occurrence 5A_4:3036:4747: scene=5A_4
#: 5A_4:3036
msgctxt "text_id=4747 | speaker=unknown"
msgid "　呻いて、床に倒れこむ。"
msgstr ""

#. Occurrence 5A_4:3041:4748: scene=5A_4
#: 5A_4:3041
msgctxt "text_id=4748 | speaker=unknown"
msgid "　背中はひりひりと痛んでいる。"
msgstr ""

#. Occurrence 5A_4:3046:4749: scene=5A_4
#: 5A_4:3046
msgctxt "text_id=4749 | speaker=unknown"
msgid "　出血はない。『痛い』程度で済んだのは幸運だろう。"
msgstr ""

#. Occurrence 5A_4:3082:4750: scene=5A_4
#: 5A_4:3082
msgctxt "text_id=4750 | speaker=unknown"
msgid "　けれど、体は<頑|がん>として動かなかった。"
msgstr ""

#. Occurrence 5A_4:3087:4751: scene=5A_4
#: 5A_4:3087
msgctxt "text_id=4751 | speaker=unknown"
msgid "　肉体的にも精神的にもまだ余裕はある。"
msgstr ""

#. Occurrence 5A_4:3092:4752: scene=5A_4
#: 5A_4:3092
msgctxt "text_id=4752 | speaker=unknown"
msgid "　起き上がれない程の痛みでもない。"
msgstr ""

#. Occurrence 5A_4:3121:4753: scene=5A_4
#: 5A_4:3121
msgctxt "text_id=4753 | speaker=unknown"
msgid "　ただ、倒れてふと見上げた天井には窓があって、暗い夜空が見えてしまった。"
msgstr ""

#. Occurrence 5A_4:3126:4754: scene=5A_4
#: 5A_4:3126
msgctxt "text_id=4754 | speaker=unknown"
msgid "　胸に去来した<感|も><情|の>は未熟な、身勝手な嘆きだった。"
msgstr ""

#. Occurrence 5A_4:3133:4755: scene=5A_4
#: 5A_4:3133
msgctxt "text_id=4755 | speaker=unknown"
msgid "　……ああ、なんて醜い。"
msgstr ""

#. Occurrence 5A_4:3138:4756: scene=5A_4
#: 5A_4:3138
msgctxt "text_id=4756 | speaker=unknown"
msgid "　こんなものを、これから一生、見続けていく。"
msgstr ""

#. Occurrence 5A_4:3189:4757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0013; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3189
msgctxt "text_id=4757 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_4:3195:4758: scene=5A_4
#: 5A_4:3195
msgctxt "text_id=4758 | speaker=unknown"
msgid "　乱れていた呼吸が、熱を失ったように治まった。"
msgstr ""

#. Occurrence 5A_4:3200:4759: scene=5A_4
#: 5A_4:3200
msgctxt "text_id=4759 | speaker=unknown"
msgid "　簡単に言うなら、彼はそれで諦めてしまったのだ。"
msgstr ""

#. Occurrence 5A_4:3205:4760: scene=5A_4
#: 5A_4:3205
msgctxt "text_id=4760 | speaker=unknown"
msgid "　追いかけてくる足音から逃げるという行為と、たぶん、もっと大きな、根本にある問題から。"
msgstr ""

#. Occurrence 5A_4:3238:4761: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0014; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3238
msgctxt "text_id=4761 | speaker=soujuurou"
msgid "“まあ……蒼崎に殺されるなら、いいかな”"
msgstr ""

#. Occurrence 5A_4:3245:4762: scene=5A_4
#: 5A_4:3245
msgctxt "text_id=4762 | speaker=unknown"
msgid "　静希草十郎という人間にとって、決してあってはならない感想が漏れる。"
msgstr ""

#. Occurrence 5A_4:3250:4763: scene=5A_4
#: 5A_4:3250
msgctxt "text_id=4763 | speaker=unknown"
msgid "　……余談ではあるが。"
msgstr ""

#. Occurrence 5A_4:3256:4764: scene=5A_4
#: 5A_4:3256
msgctxt "text_id=4764 | speaker=unknown"
msgid "大げさな話ではなく、それは彼にとって、生涯ただ一度の過ちだった。"
msgstr ""

#. Occurrence 5A_4:3276:4765: scene=5A_4
#: 5A_4:3276
msgctxt "text_id=4765 | speaker=unknown"
msgid "　ぼんやりと夜空を見上げながら、草十郎は近づいてくる足音を聞く。"
msgstr ""

#. Occurrence 5A_4:3324:4766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0002; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3324
msgctxt "text_id=4766 | speaker=aoko"
msgid "「ギブアップ？」"
msgstr ""

#. Occurrence 5A_4:3330:4767: scene=5A_4
#: 5A_4:3330
msgctxt "text_id=4767 | speaker=unknown"
msgid "　今までで一番近い声。"
msgstr ""

#. Occurrence 5A_4:3335:4768: scene=5A_4
#: 5A_4:3335
msgctxt "text_id=4768 | speaker=unknown"
msgid "　これで幕引きと踏んだのか、彼女は倒れこんだ草十郎の目前まで歩み寄った。"
msgstr ""

#. Occurrence 5A_4:3355:4769: scene=5A_4
#: 5A_4:3355
msgctxt "text_id=4769 | speaker=unknown"
msgid "　暗い鏡張りの通路では、その表情はうかがい知れない。"
msgstr ""

#. Occurrence 5A_4:3360:4770: scene=5A_4
#: 5A_4:3360
msgctxt "text_id=4770 | speaker=unknown"
msgid "　草十郎は何を言うのでもなく、目前の殺人者を見上げている。"
msgstr ""

#. Occurrence 5A_4:3460:4771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0003; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3460
msgctxt "text_id=4771 | speaker=aoko"
msgid "「……返事がないならそれでいいけど。"
msgstr ""

#. Occurrence 5A_4:3466:4772: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0004; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3466
msgctxt "text_id=4772 | speaker=aoko"
msgid "　調子狂うわ。普通、どうして殺そうとするのかぐらい、訊くものじゃない？」"
msgstr ""

#. Occurrence 5A_4:3472:4773: scene=5A_4
#: 5A_4:3472
msgctxt "text_id=4773 | speaker=unknown"
msgid "　顔を陰に隠したまま青子は言う。"
msgstr ""

#. Occurrence 5A_4:3547:4774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0015; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3547
msgctxt "text_id=4774 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_4:3553:4775: scene=5A_4
#: 5A_4:3553
msgctxt "text_id=4775 | speaker=unknown"
msgid "　きょとんと目を大きくする草十郎。"
msgstr ""

#. Occurrence 5A_4:3558:4776: scene=5A_4
#: 5A_4:3558
msgctxt "text_id=4776 | speaker=unknown"
msgid "　言われて、それが自然な疑問なのだと気が付いた。"
msgstr ""

#. Occurrence 5A_4:3563:4777: scene=5A_4
#: 5A_4:3563
msgctxt "text_id=4777 | speaker=unknown"
msgid "　なんとなく雰囲気で“秘密を知ったから殺す”と読み取れたが、どうして自分がこんな目にあうのか、理由を聞きたくなるのが人情である。"
msgstr ""

#. Occurrence 5A_4:3596:4778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0016; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3596
msgctxt "text_id=4778 | speaker=soujuurou"
msgid "「……そっか。それは、そうなるな」"
msgstr ""

#. Occurrence 5A_4:3601:4779: scene=5A_4
#: 5A_4:3601
msgctxt "text_id=4779 | speaker=unknown"
msgid "　ああ、という肯定。"
msgstr ""

#. Occurrence 5A_4:3606:4780: scene=5A_4
#: 5A_4:3606
msgctxt "text_id=4780 | speaker=unknown"
msgid "　どこか寂しい願いと、諦めのまざった顔。"
msgstr ""

#. Occurrence 5A_4:3611:4781: scene=5A_4
#: 5A_4:3611
msgctxt "text_id=4781 | speaker=unknown"
msgid "　彼はしばし考えたあと、"
msgstr ""

#. Occurrence 5A_4:3645:4782: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0017; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3645
msgctxt "text_id=4782 | speaker=soujuurou"
msgid "「でも言う必要はない。"
msgstr ""

#. Occurrence 5A_4:3652:4783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0018; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3652
msgctxt "text_id=4783 | speaker=soujuurou"
msgid "聞きたくないんだ、そういうのは」"
msgstr ""

#. Occurrence 5A_4:3658:4784: scene=5A_4
#: 5A_4:3658
msgctxt "text_id=4784 | speaker=unknown"
msgid "　大人びた、静かな声でそう答えた。"
msgstr ""

#. Occurrence 5A_4:3761:4785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0005; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3761
msgctxt "text_id=4785 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_4:3767:4786: scene=5A_4
#: 5A_4:3767
msgctxt "text_id=4786 | speaker=unknown"
msgid "　鮮やかといえば、鮮やかすぎたその回答。"
msgstr ""

#. Occurrence 5A_4:3798:4787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0006; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3798
msgctxt "text_id=4787 | speaker=aoko"
msgid "「―――そ。"
msgstr ""

#. Occurrence 5A_4:3804:4788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0007; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3804
msgctxt "text_id=4788 | speaker=aoko"
msgid "　じゃ、殺すけど。死ぬの、恐くないの？」"
msgstr ""

#. Occurrence 5A_4:3810:4789: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0019; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3810
msgctxt "text_id=4789 | speaker=soujuurou"
msgid "「恐いに決まってる。なにより痛そうだ」"
msgstr ""

#. Occurrence 5A_4:3840:4790: scene=5A_4
#: 5A_4:3840
msgctxt "text_id=4790 | speaker=unknown"
msgid "　口をとがらせて抗議する草十郎に、青子はむっ、と顔をくもらせる。"
msgstr ""

#. Occurrence 5A_4:3846:4791: scene=5A_4
#: 5A_4:3846
msgctxt "text_id=4791 | speaker=unknown"
msgid "投げやりになっていても、自分の気持ちに素直な少年だった。"
msgstr ""

#. Occurrence 5A_4:3901:4792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0008; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3901
msgctxt "text_id=4792 | speaker=aoko"
msgid "「そりゃ恐いでしょう。私だって恐いと思うし。"
msgstr ""

#. Occurrence 5A_4:3907:4793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0009; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3907
msgctxt "text_id=4793 | speaker=aoko"
msgid "　でも悪いわね、我慢して。"
msgstr ""

#. Occurrence 5A_4:3913:4794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0010; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3913
msgctxt "text_id=4794 | speaker=aoko"
msgid "　人でなしと<罵|ののし>ってくれて結構よ。今の私は本当にその通りだから。"
msgstr ""

#. Occurrence 5A_4:3930:4795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0011; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3930
msgctxt "text_id=4795 | speaker=aoko"
msgid "……"
msgstr ""

msgctxt "text_id=4796 | speaker=unknown"
msgid "そういった意味じゃアンタと同じ。普通の道徳がないのよ。だから、必要なら人も殺せる」"
msgstr ""

#. Occurrence 5A_4:3961:4797: scene=5A_4
#: 5A_4:3961
msgctxt "text_id=4797 | speaker=unknown"
msgid "　淡々とした声に、ぴくりと草十郎の指が反応した。"
msgstr ""

#. Occurrence 5A_4:3966:4798: scene=5A_4
#: 5A_4:3966
msgctxt "text_id=4798 | speaker=unknown"
msgid "　何もかも諦めていた彼の体が、今の言葉は聞き流せないと言うように。"
msgstr ""

#. Occurrence 5A_4:4022:4799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0020; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4022
msgctxt "text_id=4799 | speaker=soujuurou"
msgid "「人殺しなんて、よくないぞ」"
msgstr ""

#. Occurrence 5A_4:4028:4800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0012; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4028
msgctxt "text_id=4800 | speaker=aoko"
msgid "「分かってるって言ってるでしょ」"
msgstr ""

#. Occurrence 5A_4:4039:4801: scene=5A_4
#: 5A_4:4039
msgctxt "text_id=4801 | speaker=unknown"
msgid "　青子の右腕が掲げられる。"
msgstr ""

#. Occurrence 5A_4:4044:4802: scene=5A_4
#: 5A_4:4044
msgctxt "text_id=4802 | speaker=unknown"
msgid "　刻印の光が顔を照らす。"
msgstr ""

#. Occurrence 5A_4:4131:4803: scene=5A_4
#: 5A_4:4131
msgctxt "text_id=4803 | speaker=unknown"
msgid "　言うまでもなく、彼女の顔はいつも通りだ。"
msgstr ""

#. Occurrence 5A_4:4136:4804: scene=5A_4
#: 5A_4:4136
msgctxt "text_id=4804 | speaker=unknown"
msgid "　泣き顔でもなく笑顔でもない。"
msgstr ""

#. Occurrence 5A_4:4141:4805: scene=5A_4
#: 5A_4:4141
msgctxt "text_id=4805 | speaker=unknown"
msgid "　感情を<排|はい>した、どこにでもいる一人の少女。"
msgstr ""

#. Occurrence 5A_4:4146:4806: scene=5A_4
#: 5A_4:4146
msgctxt "text_id=4806 | speaker=unknown"
msgid "　……我慢して、なんてとんでもない。"
msgstr ""

#. Occurrence 5A_4:4151:4807: scene=5A_4
#: 5A_4:4151
msgctxt "text_id=4807 | speaker=unknown"
msgid "　普段の青子を知る草十郎にとって、それは、どんな<表|か><情|お>より<辛|つら>く映った。"
msgstr ""

#. Occurrence 5A_4:4276:4808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0021; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4276
msgctxt "text_id=4808 | speaker=soujuurou"
msgid "「……すまない。ちょっと、いいかな」"
msgstr ""

#. Occurrence 5A_4:4282:4809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0013; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4282
msgctxt "text_id=4809 | speaker=aoko"
msgid "「なに？　ここまで<悲愴感|ひそうかん>を盛り上げておいて、やっぱり逃げるなんてのは却下よ」"
msgstr ""

#. Occurrence 5A_4:4307:4810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0022; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4307
msgctxt "text_id=4810 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_4:4313:4811: scene=5A_4
#: 5A_4:4313
msgctxt "text_id=4811 | speaker=unknown"
msgid "　容赦のない青子の切り返しに、彼はつい頬を<緩|ゆる>ませた。"
msgstr ""

#. Occurrence 5A_4:4318:4812: scene=5A_4
#: 5A_4:4318
msgctxt "text_id=4812 | speaker=unknown"
msgid "　ほっと息をつくように。さきほど見えた辛さは勘違いで、青子はやっぱり青子だった。"
msgstr ""

#. Occurrence 5A_4:4323:4813: scene=5A_4
#: 5A_4:4323
msgctxt "text_id=4813 | speaker=unknown"
msgid "　それが嬉しくて草十郎は笑ったのだが、言うまでもなく、彼以外には真逆に見える笑いだった。"
msgstr ""

#. Occurrence 5A_4:4401:4814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0014; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4401
msgctxt "text_id=4814 | speaker=aoko"
msgid "「……<遺言|ゆいごん>でも聞いてあげようと思った私が甘かった。"
msgstr ""

#. Occurrence 5A_4:4407:4815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0015; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4407
msgctxt "text_id=4815 | speaker=aoko"
msgid "　っていうか、今の小馬鹿にした笑いがアンタの遺言ってコトでオッケー？」"
msgstr ""

#. Occurrence 5A_4:4458:4816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0023; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4458
msgctxt "text_id=4816 | speaker=soujuurou"
msgid "「いや、そうじゃなくて。あそこにいる人は、蒼崎の友人なのか？」"
msgstr ""

#. Occurrence 5A_4:4464:4817: scene=5A_4
#: 5A_4:4464
msgctxt "text_id=4817 | speaker=unknown"
msgid "　つい、と指で青子の背後を指す草十郎。"
msgstr ""

#. Occurrence 5A_4:4523:4818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0016; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4523
msgctxt "text_id=4818 | speaker=aoko"
msgid "「はあ？」"
msgstr ""

#. Occurrence 5A_4:4529:4819: scene=5A_4
#: 5A_4:4529
msgctxt "text_id=4819 | speaker=unknown"
msgid "　使い古された手だと青子は思った。"
msgstr ""

#. Occurrence 5A_4:4535:4820: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4820 | speaker=unknown"
msgid "ここがステージならハリセンでダメ出しも辞さないところだ。"
msgstr ""

#. Occurrence 5A_4:4535:4821: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4821 | speaker=unknown"
msgid "　……しかし草十郎にそんな雰囲気はないし、そもそもこの男には<流行|はやり>も古いもなかった、と思い直す。"
msgstr ""

#. Occurrence 5A_4:4652:4822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0017; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4652
msgctxt "text_id=4822 | speaker=aoko"
msgid "「アンタ、なに言って―――」"
msgstr ""

#. Occurrence 5A_4:4658:4823: scene=5A_4
#: 5A_4:4658
msgctxt "text_id=4823 | speaker=unknown"
msgid "　なんだかんだと律儀な性格が幸いしたのか。"
msgstr ""

#. Occurrence 5A_4:4663:4824: scene=5A_4
#: 5A_4:4663
msgctxt "text_id=4824 | speaker=unknown"
msgid "　つい気になって、指差された背後に目を向ける青子。"
msgstr ""

#. Occurrence 5A_4:4668:4825: scene=5A_4
#: 5A_4:4668
msgctxt "text_id=4825 | speaker=unknown"
msgid "　―――そこには、"
msgstr ""

#. Occurrence 5A_4:4758:4826: scene=5A_4
#: 5A_4:4758
msgctxt "text_id=4826 | speaker=unknown"
msgid "　ぎい、と。"
msgstr ""

#. Occurrence 5A_4:4766:4827: scene=5A_4
#: 5A_4:4766
msgctxt "text_id=4827 | speaker=unknown"
msgid "　この迷路には無い木製の<笑顔|きしみ>をあげる、不吉で不気味な“彼女”の姿が―――"
msgstr ""

#. Occurrence 5A_5:116:4828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0000; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:116
msgctxt "text_id=4828 | speaker=aoko"
msgid "「―――人、形……？」"
msgstr ""

#. Occurrence 5A_5:122:4829: scene=5A_5
#: 5A_5:122
msgctxt "text_id=4829 | speaker=unknown"
msgid "　暗がりに<仄|ほの>浮かぶ<二|ヒ><足|ト><二|ガ><手|タ>の異形。"
msgstr ""

#. Occurrence 5A_5:127:4830: scene=5A_5
#: 5A_5:127
msgctxt "text_id=4830 | speaker=unknown"
msgid "　その、物言わぬ<佇|たたず>まいと、遠目からでも分かる造りの美しさが、事の異常性を一瞬だけ漂白し―――"
msgstr ""

#. Occurrence 5A_5:293:4831: scene=5A_5
#: 5A_5:293
msgctxt "text_id=4831 | speaker=unknown"
msgid "　伸びる。伸びる。伸びる。"
msgstr ""

#. Occurrence 5A_5:298:4832: scene=5A_5
#: 5A_5:298
msgctxt "text_id=4832 | speaker=unknown"
msgid "　その、あまりの“未知”に青子の思考は停止した。"
msgstr ""

#. Occurrence 5A_5:303:4833: scene=5A_5
#: 5A_5:303
msgctxt "text_id=4833 | speaker=unknown"
msgid "　避ける、という選択が浮かばない。人間は知性、知識がある故に、“初めて見る”ものに<鈍感|どんかん>で―――"
msgstr ""

#. Occurrence 5A_5:393:4834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0001; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:393
msgctxt "text_id=4834 | speaker=aoko"
msgid "「っ、ぁあぁあ――――――！！！！」"
msgstr ""

#. Occurrence 5A_5:399:4835: scene=5A_5
#: 5A_5:399
msgctxt "text_id=4835 | speaker=unknown"
msgid "　青子の口から悲鳴がこぼれる。"
msgstr ""

#. Occurrence 5A_5:404:4836: scene=5A_5
#: 5A_5:404
msgctxt "text_id=4836 | speaker=unknown"
msgid "　十メートル以上の距離を無視した魔の一撃。"
msgstr ""

#. Occurrence 5A_5:409:4837: scene=5A_5
#: 5A_5:409
msgctxt "text_id=4837 | speaker=unknown"
msgid "　奥の通路に現れた“彼女”の腕は細く速く、どこまでも長く伸び、青子の背中を<撃|う>ち<捉|とら>えた。"
msgstr ""

#. Occurrence 5A_5:488:4838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0002; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:488
msgctxt "text_id=4838 | speaker=aoko"
msgid "「っ―――！」"
msgstr ""

#. Occurrence 5A_5:495:4839: scene=5A_5
#: 5A_5:495
msgctxt "text_id=4839 | speaker=unknown"
msgid "　青子は壁に激突しつつも、苦悶の声を飲みくだす。"
msgstr ""

#. Occurrence 5A_5:500:4840: scene=5A_5
#: 5A_5:500
msgctxt "text_id=4840 | speaker=unknown"
msgid "　一方、伸びきった腕は速やかに“彼女”へと戻っていく。"
msgstr ""

#. Occurrence 5A_5:606:4841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0000; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:606
msgctxt "text_id=4841 | speaker=soujuurou"
msgid "「蒼崎！」"
msgstr ""

#. Occurrence 5A_5:652:4842: scene=5A_5
#: 5A_5:652
msgctxt "text_id=4842 | speaker=unknown"
msgid "　草十郎はすぐさま立ち上がっていた。"
msgstr ""

#. Occurrence 5A_5:657:4843: scene=5A_5
#: 5A_5:657
msgctxt "text_id=4843 | speaker=unknown"
msgid "　手足をついて咳きこむ青子に駆け寄ると、力任せに立ち上がらせ―――"
msgstr ""

#. Occurrence 5A_5:710:4844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0001; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:710
msgctxt "text_id=4844 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_5:716:4845: scene=5A_5
#: 5A_5:716
msgctxt "text_id=4845 | speaker=unknown"
msgid "　その軽さに、少し戸惑う。"
msgstr ""

#. Occurrence 5A_5:721:4846: scene=5A_5
#: 5A_5:721
msgctxt "text_id=4846 | speaker=unknown"
msgid "　草十郎にとって、蒼崎青子は普段から凛としていて、中身がぎゅっと詰まっているイメージだった。"
msgstr ""

#. Occurrence 5A_5:726:4847: scene=5A_5
#: 5A_5:726
msgctxt "text_id=4847 | speaker=unknown"
msgid "　だからきっと、<触|ふ>れた時は自分なんかより確かな力強さがあると思ったのだ。"
msgstr ""

#. Occurrence 5A_5:732:4848: scene=5A_5
#: 5A_5:732
msgctxt "text_id=4848 | speaker=unknown"
msgid "けれど実際は四十五キロ程度の、少女として当たり前の重さだった。"
msgstr ""

#. Occurrence 5A_5:829:4849: scene=5A_5
#: 5A_5:829
msgctxt "text_id=4849 | speaker=unknown"
msgid "　……一方。"
msgstr ""

#. Occurrence 5A_5:834:4850: scene=5A_5
#: 5A_5:834
msgctxt "text_id=4850 | speaker=unknown"
msgid "　どのような<機巧|カラクリ>か、“彼女”は伸びきった腕を収納していく。"
msgstr ""

#. Occurrence 5A_5:839:4851: scene=5A_5
#: 5A_5:839
msgctxt "text_id=4851 | speaker=unknown"
msgid "　十メートル以上伸びた腕、何倍にも増設された<肘|ひじ>関節が、カシャンカシャンと元の<形状|おおきさ>に戻っていく。"
msgstr ""

#. Occurrence 5A_5:934:4852: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0002; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:934
msgctxt "text_id=4852 | speaker=soujuurou"
msgid "「大丈夫か？」"
msgstr ""

#. Occurrence 5A_5:1030:4853: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0003; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1030
msgctxt "text_id=4853 | speaker=aoko"
msgid "「……やめてよ。分からないわ、なんでそんな顔できるの」"
msgstr ""

#. Occurrence 5A_5:1085:4854: scene=5A_5
#: 5A_5:1085
msgctxt "text_id=4854 | speaker=unknown"
msgid "　呟きながら草十郎の手から離れる青子。"
msgstr ""

#. Occurrence 5A_5:1090:4855: scene=5A_5
#: 5A_5:1090
msgctxt "text_id=4855 | speaker=unknown"
msgid "　途端、がくんと膝から倒れこんだが、彼女が膝をつくより早く、草十郎は肩を貸して立ちあがらせていた。"
msgstr ""

#. Occurrence 5A_5:1111:4856: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0003; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1111
msgctxt "text_id=4856 | speaker=soujuurou"
msgid "「無理するな。……で、あいつは知り合いか？」"
msgstr ""

#. Occurrence 5A_5:1174:4857: scene=5A_5
#: 5A_5:1174
msgctxt "text_id=4857 | speaker=unknown"
msgid "　草十郎は十メートル向こう、不気味に<佇|たたず>む人影を見据えている。伸びきった腕は、あと少しで完全に収納されようとしていた。"
msgstr ""

#. Occurrence 5A_5:1181:4858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0004; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1181
msgctxt "text_id=4858 | speaker=aoko"
msgid "「……そうね。似たような奴とは命を<鬩|せめ>ぎ合った仲よ」"
msgstr ""

#. Occurrence 5A_5:1201:4859: scene=5A_5
#: 5A_5:1201
msgctxt "text_id=4859 | speaker=unknown"
msgid "　青子は答えながら、自身の背中に指をはわせた。"
msgstr ""

#. Occurrence 5A_5:1262:4860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0005; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1262
msgctxt "text_id=4860 | speaker=aoko"
msgid "「っ……！」"
msgstr ""

#. Occurrence 5A_5:1267:4861: scene=5A_5
#: 5A_5:1267
msgctxt "text_id=4861 | speaker=unknown"
msgid "　途端、火で<炙|あぶ>られるような痛みが走る。"
msgstr ""

#. Occurrence 5A_5:1332:4862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0006; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1332
msgctxt "text_id=4862 | speaker=aoko"
msgid "“っ……でも、痛いっちゃあ痛いけど、打撲だけ……？"
msgstr ""

#. Occurrence 5A_5:1338:4863: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0007; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1338
msgctxt "text_id=4863 | speaker=aoko"
msgid "　あれだけ絶好の奇襲をしておいて？　それとも、この距離じゃ当たっても致命傷にならない？"
msgstr ""

#. Occurrence 5A_5:1345:4864: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0008; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1345
msgctxt "text_id=4864 | speaker=aoko"
msgid "　……なんて、あるワケないか。なにか別の意味があると見るべきね―――”"
msgstr ""

#. Occurrence 5A_5:1372:4865: scene=5A_5
#: 5A_5:1372
msgctxt "text_id=4865 | speaker=unknown"
msgid "　背中の<損傷|ダメージ>を量りながら、乱れた呼吸を整える青子。"
msgstr ""

#. Occurrence 5A_5:1377:4866: scene=5A_5
#: 5A_5:1377
msgctxt "text_id=4866 | speaker=unknown"
msgid "　痛みも呼吸もすぐに治まった。"
msgstr ""

#. Occurrence 5A_5:1382:4867: scene=5A_5
#: 5A_5:1382
msgctxt "text_id=4867 | speaker=unknown"
msgid "　あくまで今のところではあるが、運動機能に支障はない。"
msgstr ""

#. Occurrence 5A_5:1388:4868: scene=5A_5
#: 5A_5:1388
msgctxt "text_id=4868 | speaker=unknown"
msgid "　となると、深刻なダメージと言えるのは―――"
msgstr ""

#. Occurrence 5A_5:1548:4869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0004; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1548
msgctxt "text_id=4869 | speaker=soujuurou"
msgid "「あ、蒼崎、アレ！」"
msgstr ""

#. Occurrence 5A_5:1561:4870: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0009; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1561
msgctxt "text_id=4870 | speaker=aoko"
msgid "「分かってるわ、黙ってて」"
msgstr ""

#. Occurrence 5A_5:1641:4871: scene=5A_5
#: 5A_5:1641
msgctxt "text_id=4871 | speaker=unknown"
msgid "　<薄闇|うすやみ>に青い光がともる。"
msgstr ""

#. Occurrence 5A_5:1646:4872: scene=5A_5
#: 5A_5:1646
msgctxt "text_id=4872 | speaker=unknown"
msgid "　青子の呼吸に連動して生成された魔力が、その右腕に集められる。"
msgstr ""

#. Occurrence 5A_5:1738:4873: scene=5A_5
#: 5A_5:1738
msgctxt "text_id=4873 | speaker=unknown"
msgid "　魔力が燃料なら、術式は点火装置だ。"
msgstr ""

#. Occurrence 5A_5:1743:4874: scene=5A_5
#: 5A_5:1743
msgctxt "text_id=4874 | speaker=unknown"
msgid "　青子にとって、これは二日前の夜の再現にすぎない。"
msgstr ""

#. Occurrence 5A_5:1748:4875: scene=5A_5
#: 5A_5:1748
msgctxt "text_id=4875 | speaker=unknown"
msgid "　あの人形が腕を伸ばしてきた時、最速で術式を走らせ、生成した<魔|た><力|ま>を弾く。"
msgstr ""

#. Occurrence 5A_5:1779:4876: scene=5A_5
#: 5A_5:1779
msgctxt "text_id=4876 | speaker=unknown"
msgid "　およそ十メートルの格闘戦。"
msgstr ""

#. Occurrence 5A_5:1784:4877: scene=5A_5
#: 5A_5:1784
msgctxt "text_id=4877 | speaker=unknown"
msgid "　生死を分かつクロスカウンターだが、二秒の隙間があるのなら青子でも合わせられる。"
msgstr ""

#. Occurrence 5A_5:1832:4878: scene=5A_5
#: 5A_5:1832
msgctxt "text_id=4878 | speaker=unknown"
msgid "“彼女”が動く。"
msgstr ""

#. Occurrence 5A_5:1838:4879: scene=5A_5
#: 5A_5:1838
msgctxt "text_id=4879 | speaker=unknown"
msgid "　<俯|うつむ>いているので<表|か><情|お>は見えず、この距離、この暗さでは肉体年齢も判別できない。"
msgstr ""

#. Occurrence 5A_5:1843:4880: scene=5A_5
#: 5A_5:1843
msgctxt "text_id=4880 | speaker=unknown"
msgid "　青子たちにとって、人形はいまだ正体のない亡霊と変わらない。"
msgstr ""

#. Occurrence 5A_5:1892:4881: scene=5A_5
#: 5A_5:1892
msgctxt "text_id=4881 | speaker=unknown"
msgid "　キリキリと音をたてて左腕が持ち上がる。"
msgstr ""

#. Occurrence 5A_5:1897:4882: scene=5A_5
#: 5A_5:1897
msgctxt "text_id=4882 | speaker=unknown"
msgid "　<緩慢|かんまん>な、関節が<錆|さ>びきったような動作。"
msgstr ""

#. Occurrence 5A_5:1940:4883: scene=5A_5
#: 5A_5:1940
msgctxt "text_id=4883 | speaker=unknown"
msgid "　先ほど伸びた右腕は下げられている。"
msgstr ""

#. Occurrence 5A_5:1980:4884: scene=5A_5
#: 5A_5:1980
msgctxt "text_id=4884 | speaker=unknown"
msgid "　くすりと、長い髪に隠れた口元が笑った気がした。"
msgstr ""

#. Occurrence 5A_5:2062:4885: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0010; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2062
msgctxt "text_id=4885 | speaker=aoko"
msgid "“―――<右手|さっき>と用途が違う、<左|アレ>が本命―――！”"
msgstr ""

#. Occurrence 5A_5:2091:4886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0011; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2091
msgctxt "text_id=4886 | speaker=aoko"
msgid "「静希君、どいて……！！」"
msgstr ""

#. Occurrence 5A_5:2215:4887: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4887 | speaker=unknown"
msgid "　青子が草十郎を突きとばしつつ右手をなぎ払うのと、"
msgstr ""

#. Occurrence 5A_5:2215:4888: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4888 | speaker=unknown"
msgid "“彼女”の左腕が伸びるのは同時だった。"
msgstr ""

#. Occurrence 5A_5:2235:4889: scene=5A_5
#: 5A_5:2235
msgctxt "text_id=4889 | speaker=unknown"
msgid "　タイミングは完璧。"
msgstr ""

#. Occurrence 5A_5:2240:4890: scene=5A_5
#: 5A_5:2240
msgctxt "text_id=4890 | speaker=unknown"
msgid "　一秒の差で青子の<魔弾|スナップ>は人形の<凶|う><器|で>に直撃し、その軌道をズラしながら敵本体に炸裂する。"
msgstr ""

#. Occurrence 5A_5:2265:4891: scene=5A_5
#: 5A_5:2265
msgctxt "text_id=4891 | speaker=unknown"
msgid "　―――肝心の、魔術式が駆動すればの話だが。"
msgstr ""

#. Occurrence 5A_5:2525:4892: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0012; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2525
msgctxt "text_id=4892 | speaker=aoko"
msgid "「ッ―――！？」"
msgstr ""

#. Occurrence 5A_5:2531:4893: scene=5A_5
#: 5A_5:2531
msgctxt "text_id=4893 | speaker=unknown"
msgid "　撃ち出された腕を紙一重でかわす青子。"
msgstr ""

#. Occurrence 5A_5:2536:4894: scene=5A_5
#: 5A_5:2536
msgctxt "text_id=4894 | speaker=unknown"
msgid "　魔術は発動しなかったが、相手の攻撃をかわせたのはここ一番の<勘|かん>の良さか。"
msgstr ""

#. Occurrence 5A_5:2587:4895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0013; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2587
msgctxt "text_id=4895 | speaker=aoko"
msgid "“やられた、最初のはそういうコトか……！”"
msgstr ""

#. Occurrence 5A_5:2593:4896: scene=5A_5
#: 5A_5:2593
msgctxt "text_id=4896 | speaker=unknown"
msgid "　こんちくしょう、と歯がみしつつ青子は思考を巡らせた。"
msgstr ""

#. Occurrence 5A_5:2598:4897: scene=5A_5
#: 5A_5:2598
msgctxt "text_id=4897 | speaker=unknown"
msgid "　<走|せ>るべきか、<退|ひ>くべきか。"
msgstr ""

#. Occurrence 5A_5:2603:4898: scene=5A_5
#: 5A_5:2603
msgctxt "text_id=4898 | speaker=unknown"
msgid "　残る腕は一本。人形の腕は巻き戻しに時間がかかる。"
msgstr ""

#. Occurrence 5A_5:2608:4899: scene=5A_5
#: 5A_5:2608
msgctxt "text_id=4899 | speaker=unknown"
msgid "　言うまでもなく好機。やるのなら今だ。"
msgstr ""

#. Occurrence 5A_5:2613:4900: scene=5A_5
#: 5A_5:2613
msgctxt "text_id=4900 | speaker=unknown"
msgid "　右腕だけならもう一度ギリギリでかわして、とにかく近づいてしまえば―――"
msgstr ""

#. Occurrence 5A_5:2655:4901: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4901 | speaker=unknown"
msgid "　　“<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr ""

#. Occurrence 5A_5:2655:4902: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4902 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr ""

#. Occurrence 5A_5:2690:4903: scene=5A_5
#: 5A_5:2690
msgctxt "text_id=4903 | speaker=unknown"
msgid "　がさついた音が<木霊|こだま>する。"
msgstr ""

#. Occurrence 5A_5:2695:4904: scene=5A_5
#: 5A_5:2695
msgctxt "text_id=4904 | speaker=unknown"
msgid "　<詩文|しぶん>めいた<囁|ささや>きは、魔術師なら視覚できるほどの魔力の<残|の><留|こ><思|り><念|び>だった。"
msgstr ""

#. Occurrence 5A_5:2700:4905: scene=5A_5
#: 5A_5:2700
msgctxt "text_id=4905 | speaker=unknown"
msgid "　唄い文句こそラテン語だが、ところどころに<呪詛|ガンド>の韻が含まれている。"
msgstr ""

#. Occurrence 5A_5:2705:4906: scene=5A_5
#: 5A_5:2705
msgctxt "text_id=4906 | speaker=unknown"
msgid "　本来なら憎い相手を<呪|のろ>う言葉。"
msgstr ""

#. Occurrence 5A_5:2710:4907: scene=5A_5
#: 5A_5:2710
msgctxt "text_id=4907 | speaker=unknown"
msgid "　それを、"
msgstr ""

#. Occurrence 5A_5:2765:4908: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4908 | speaker=unknown"
msgid "“<Mea anima immortalis. Autem mea futura necata sunt|私の命は不滅ですが、私の未来は殺されました。>."
msgstr ""

#. Occurrence 5A_5:2765:4909: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4909 | speaker=unknown"
msgid "　　　<Manes sum. Animam definire ambiguum est|私は亡霊です。生命の定義はあやふやです。>."
msgstr ""

#. Occurrence 5A_5:2765:4910: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4910 | speaker=unknown"
msgid "　　<Te odi, et te amo. Conveniamus in somnio ipso.|憎らしい、愛おしい貴方。どうか、夢で会いましょう。>”"
msgstr ""

#. Occurrence 5A_5:2812:4911: scene=5A_5
#: 5A_5:2812
msgctxt "text_id=4911 | speaker=unknown"
msgid "　……それを、あの人形は自分自身に向けていた。"
msgstr ""

#. Occurrence 5A_5:2817:4912: scene=5A_5
#: 5A_5:2817
msgctxt "text_id=4912 | speaker=unknown"
msgid "　呪いは呪いを生む。被害者は加害者を呪い返す事で、負の連鎖を回していく。"
msgstr ""

#. Occurrence 5A_5:2837:4913: scene=5A_5
#: 5A_5:2837
msgctxt "text_id=4913 | speaker=unknown"
msgid "　……あの詠唱はそのサイクルを利用したものだ。"
msgstr ""

#. Occurrence 5A_5:2842:4914: scene=5A_5
#: 5A_5:2842
msgctxt "text_id=4914 | speaker=unknown"
msgid "　ただしあくまで一人芝居。"
msgstr ""

#. Occurrence 5A_5:2847:4915: scene=5A_5
#: 5A_5:2847
msgctxt "text_id=4915 | speaker=unknown"
msgid "　自家中毒にも似た異例の動力源。"
msgstr ""

#. Occurrence 5A_5:2852:4916: scene=5A_5
#: 5A_5:2852
msgctxt "text_id=4916 | speaker=unknown"
msgid "　信じがたい事だが―――アレは呪い呪われる事で、一定の<動力|まりょく>を維持し続ける永久機関……！"
msgstr ""

#. Occurrence 5A_5:2929:4917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0014; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2929
msgctxt "text_id=4917 | speaker=aoko"
msgid "「なにそれ、レベル高すぎじゃない……！？」"
msgstr ""

#. Occurrence 5A_5:2989:4918: scene=5A_5
#: 5A_5:2989
msgctxt "text_id=4918 | speaker=unknown"
msgid "　青子は徹底抗戦の選択肢を切り捨てた。"
msgstr ""

#. Occurrence 5A_5:2994:4919: scene=5A_5
#: 5A_5:2994
msgctxt "text_id=4919 | speaker=unknown"
msgid "　反撃はせず、最速で身をひるがえす。"
msgstr ""

#. Occurrence 5A_5:3075:4920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0015; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:3075
msgctxt "text_id=4920 | speaker=aoko"
msgid "「なにしてんの、アンタも来る！」"
msgstr ""

#. Occurrence 5A_5:3101:4921: scene=5A_5
#: 5A_5:3101
msgctxt "text_id=4921 | speaker=unknown"
msgid "　急展開に置いてけぼりだった草十郎の手をとって、青子は全力で鏡の国の奥地へと走り出す。"
msgstr ""

#. Occurrence 5A_5:3119:4922: scene=5A_5
#: 5A_5:3119
msgctxt "text_id=4922 | speaker=unknown"
msgid "　ふたりの背後には、なお続くひび割れた声。"
msgstr ""

#. Occurrence 5A_5:3155:4923: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4923 | speaker=unknown"
msgid "“<Proximi mihi neglegentes fuerunt. Omnes nos peccante|隣人は私に無関心でした。私たちは誰もが罪深く、>s"
msgstr ""

#. Occurrence 5A_5:3155:4924: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4924 | speaker=unknown"
msgid "<fuimus, et omnes nos eidem fuimus, omnes nos peccatore|同類でした。私たちは罪人です。>s"
msgstr ""

#. Occurrence 5A_5:3155:4925: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4925 | speaker=unknown"
msgid "　　<sumus. Venite domum meam. Luto simile somnium|私の家にいらっしゃい。泥のような死を。>,"
msgstr ""

#. Occurrence 5A_5:3155:4926: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4926 | speaker=unknown"
msgid "　　　　<et pulveri simile cotidianum. Cor privo.|塵となって囁く。この胸を去った心臓を抉り出して、>”"
msgstr ""

#. Occurrence 5A_5:3193:4927: voice_id=C40_5A_5_0003_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3193
msgctxt "text_id=4927 | speaker=unknown"
msgid "　　　　　　　　“「<オマエニ、死ヲ|Te iudico.>」”"
msgstr ""

#. Occurrence 5A_6:56:4928: scene=5A_6
#: 5A_6:56
msgctxt "text_id=4928 | speaker=unknown"
msgid "　青子は背中の痛みに耐えながら、鏡張りの通路を走る。"
msgstr ""

#. Occurrence 5A_6:61:4929: scene=5A_6
#: 5A_6:61
msgctxt "text_id=4929 | speaker=unknown"
msgid "　その手に引かれておまけ状態の草十郎も走る。"
msgstr ""

#. Occurrence 5A_6:147:4930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0000; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:147
msgctxt "text_id=4930 | speaker=soujuurou"
msgid "「蒼崎、傷は？」"
msgstr ""

#. Occurrence 5A_6:154:4931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0000; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:154
msgctxt "text_id=4931 | speaker=aoko"
msgid "「……べつに、背骨が<痺|しび>れてる程度よ。内臓は平気だし、出血もないみたい」"
msgstr ""

#. Occurrence 5A_6:160:4932: scene=5A_6
#: 5A_6:160
msgctxt "text_id=4932 | speaker=unknown"
msgid "　ま、肝心の<神経|かいろ>はズタズタだけど、と内心呟く青子。"
msgstr ""

#. Occurrence 5A_6:167:4933: scene=5A_6
#: 5A_6:167
msgctxt "text_id=4933 | speaker=unknown"
msgid "　草十郎と違い、青子は透明の壁にぶつからない。"
msgstr ""

#. Occurrence 5A_6:172:4934: scene=5A_6
#: 5A_6:172
msgctxt "text_id=4934 | speaker=unknown"
msgid "　目がいいのではなく、ミラーハウスの構造を頭にたたきこんでいるからだ。"
msgstr ""

#. Occurrence 5A_6:225:4935: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0001; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:225
msgctxt "text_id=4935 | speaker=soujuurou"
msgid "「……平気って、分かるのか？」"
msgstr ""

#. Occurrence 5A_6:231:4936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0001; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:231
msgctxt "text_id=4936 | speaker=aoko"
msgid "「そりゃ自分の体だもの。身体管理は基礎中の基礎よ」"
msgstr ""

#. Occurrence 5A_6:259:4937: scene=5A_6
#: 5A_6:259
msgctxt "text_id=4937 | speaker=unknown"
msgid "　恐る恐る訊ねる草十郎と、つまらなそうに答える青子。"
msgstr ""

#. Occurrence 5A_6:264:4938: scene=5A_6
#: 5A_6:264
msgctxt "text_id=4938 | speaker=unknown"
msgid "　左曲がりの回廊は段々と、その直線距離を短くしていた。"
msgstr ""

#. Occurrence 5A_6:269:4939: scene=5A_6
#: 5A_6:269
msgctxt "text_id=4939 | speaker=unknown"
msgid "　先ほどまではまっすぐに三十メートル。"
msgstr ""

#. Occurrence 5A_6:274:4940: scene=5A_6
#: 5A_6:274
msgctxt "text_id=4940 | speaker=unknown"
msgid "　今では十五メートルほどで曲がり角に突き当たる。"
msgstr ""

#. Occurrence 5A_6:330:4941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0002; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:330
msgctxt "text_id=4941 | speaker=soujuurou"
msgid "「あいつは、あの夜の……？」"
msgstr ""

#. Occurrence 5A_6:336:4942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0002; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:336
msgctxt "text_id=4942 | speaker=aoko"
msgid "「たぶんね。同じタイプだと思う。貴重な<自動人形|オートマタ>を惜し気もなく使い捨てるなんて、よっぽどお金持ちなんだろうけど」"
msgstr ""

#. Occurrence 5A_6:366:4943: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0003; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:366
msgctxt "text_id=4943 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 5A_6:371:4944: scene=5A_6
#: 5A_6:371
msgctxt "text_id=4944 | speaker=unknown"
msgid "　む、と眉間に<皺|しわ>の草十郎。"
msgstr ""

#. Occurrence 5A_6:376:4945: scene=5A_6
#: 5A_6:376
msgctxt "text_id=4945 | speaker=unknown"
msgid "　質問にきちんと答えてくれるのはありがたいが、聞けば聞くほど聴き慣れない単語が出てくるのは困りものだ。"
msgstr ""

#. Occurrence 5A_6:476:4946: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0004; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:476
msgctxt "text_id=4946 | speaker=soujuurou"
msgid "「蒼崎、ストップ。もうずいぶん走ったぞ。"
msgstr ""

#. Occurrence 5A_6:482:4947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0005; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:482
msgctxt "text_id=4947 | speaker=soujuurou"
msgid "　あいつは曲がり<角|かど>一つぶん向こうだ。少し休もう」"
msgstr ""

#. Occurrence 5A_6:488:4948: scene=5A_6
#: 5A_6:488
msgctxt "text_id=4948 | speaker=unknown"
msgid "　青子の傷を気遣って声をかける。"
msgstr ""

#. Occurrence 5A_6:493:4949: scene=5A_6
#: 5A_6:493
msgctxt "text_id=4949 | speaker=unknown"
msgid "　しかし、彼女は不機嫌そうに首を振った。"
msgstr ""

#. Occurrence 5A_6:556:4950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0003; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:556
msgctxt "text_id=4950 | speaker=aoko"
msgid "「あの距離を狙ってくる相手に通路一つ分のリードは無意味よ。せめて二つ分に行くまで走るの」"
msgstr ""

#. Occurrence 5A_6:576:4951: scene=5A_6
#: 5A_6:576
msgctxt "text_id=4951 | speaker=unknown"
msgid "　なるほど、と頷く草十郎。"
msgstr ""

#. Occurrence 5A_6:581:4952: scene=5A_6
#: 5A_6:581
msgctxt "text_id=4952 | speaker=unknown"
msgid "　と、それはともかくとして、"
msgstr ""

#. Occurrence 5A_6:602:4953: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0006; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:602
msgctxt "text_id=4953 | speaker=soujuurou"
msgid "「なんで俺を連れていってるんだ？」"
msgstr ""

#. Occurrence 5A_6:642:4954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0004; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:642
msgctxt "text_id=4954 | speaker=aoko"
msgid "「逃げられたくないからじゃない、馬鹿」"
msgstr ""

#. Occurrence 5A_6:651:4955: scene=5A_6
#: 5A_6:651
msgctxt "text_id=4955 | speaker=unknown"
msgid "　実に簡潔な返答をしつつ、平和ぼけした獲物をむっと睨む青子だった。"
msgstr ""

#. Occurrence 5A_6:752:4956: scene=5A_6
#: 5A_6:752
msgctxt "text_id=4956 | speaker=unknown"
msgid "　ふたりはさらに先の曲がり角へ。"
msgstr ""

#. Occurrence 5A_6:757:4957: scene=5A_6
#: 5A_6:757
msgctxt "text_id=4957 | speaker=unknown"
msgid "　通路二つ分のリードをとって、ようやく足が止められる。"
msgstr ""

#. Occurrence 5A_6:832:4958: scene=5A_6
#: 5A_6:832
msgctxt "text_id=4958 | speaker=unknown"
msgid "　青子は息を整えながら背中に手を当てた。"
msgstr ""

#. Occurrence 5A_6:837:4959: scene=5A_6
#: 5A_6:837
msgctxt "text_id=4959 | speaker=unknown"
msgid "　先ほどは“ぜんぜん平気”と断言した青子だが、どうも強がりだったらしい。"
msgstr ""

#. Occurrence 5A_6:842:4960: scene=5A_6
#: 5A_6:842
msgctxt "text_id=4960 | speaker=unknown"
msgid "　なぜなら、空気の読めない草十郎にも分かるぐらい空気が重い。"
msgstr ""

#. Occurrence 5A_6:888:4961: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0007; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:888
msgctxt "text_id=4961 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 5A_6:893:4962: scene=5A_6
#: 5A_6:893
msgctxt "text_id=4962 | speaker=unknown"
msgid "　そんな青子の後ろで、さて、と腕を組む草十郎。"
msgstr ""

#. Occurrence 5A_6:898:4963: scene=5A_6
#: 5A_6:898
msgctxt "text_id=4963 | speaker=unknown"
msgid "　鬼の居ぬ間になんとやらで、この隙に、彼は彼なりに現状把握などにトライしてみた。"
msgstr ""

#. Occurrence 5A_6:956:4964: scene=5A_6
#: 5A_6:956
msgctxt "text_id=4964 | speaker=unknown"
msgid "　まず、自分は蒼崎青子に殺されかけた。"
msgstr ""

#. Occurrence 5A_6:977:4965: scene=5A_6
#: 5A_6:977
msgctxt "text_id=4965 | speaker=unknown"
msgid "　あわやというところで助けが入ったが、割って入った人物は二日前の夜、青子によって燃やされた『怪奇腕が伸びる人間』だった。"
msgstr ""

#. Occurrence 5A_6:982:4966: scene=5A_6
#: 5A_6:982
msgctxt "text_id=4966 | speaker=unknown"
msgid "　よく見えなかったが、とりあえず女性っぽかったので彼女と呼称する。"
msgstr ""

#. Occurrence 5A_6:1021:4967: scene=5A_6
#: 5A_6:1021
msgctxt "text_id=4967 | speaker=unknown"
msgid "　その彼女の攻撃で青子は背中を負傷し、一旦逃走。"
msgstr ""

#. Occurrence 5A_6:1026:4968: scene=5A_6
#: 5A_6:1026
msgctxt "text_id=4968 | speaker=unknown"
msgid "　その際、なぜか草十郎の手を取ったが、それはどさくさに紛れて<草十郎|エモノ>が逃げ出すのを阻止するため、とのコトだった。"
msgstr ""

#. Occurrence 5A_6:1037:4969: scene=5A_6
#: 5A_6:1037
msgctxt "text_id=4969 | speaker=unknown"
msgid "　つまり―――"
msgstr ""

#. Occurrence 5A_6:1068:4970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0008; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1068
msgctxt "text_id=4970 | speaker=soujuurou"
msgid "「蒼崎は、まだ<諦|あきら>めてないんだな？」"
msgstr ""

#. Occurrence 5A_6:1099:4971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0005; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1099
msgctxt "text_id=4971 | speaker=aoko"
msgid "「あったりまえよ。あんなヤツ、仮に二体と半分始末してもアンタ用の余力は残せるわ」"
msgstr ""

#. Occurrence 5A_6:1105:4972: scene=5A_6
#: 5A_6:1105
msgctxt "text_id=4972 | speaker=unknown"
msgid "　などとタンカをきる青子の表情は、<草十郎|しろうと>目にも厳しい。"
msgstr ""

#. Occurrence 5A_6:1110:4973: scene=5A_6
#: 5A_6:1110
msgctxt "text_id=4973 | speaker=unknown"
msgid "　彼女の体のダメージは無視できるものではなく、状況は楽観できるものではない。"
msgstr ""

#. Occurrence 5A_6:1145:4974: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0006; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1145
msgctxt "text_id=4974 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_6:1150:4975: scene=5A_6
#: 5A_6:1150
msgctxt "text_id=4975 | speaker=unknown"
msgid "　だが、彼女の目に秘められた激情が、その一切を否定する。"
msgstr ""

#. Occurrence 5A_6:1202:4976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4976 | speaker=aoko"
msgid "“<魔術回路|なか>がところどころショートしてる……"
msgstr ""

#. Occurrence 5A_6:1202:4977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4977 | speaker=aoko"
msgid "　あの右腕は回路を混線させる<術式妨害|ジャミング>ってワケね―――”"
msgstr ""

#. Occurrence 5A_6:1208:4978: scene=5A_6
#: 5A_6:1208
msgctxt "text_id=4978 | speaker=unknown"
msgid "　本来ならピンチに震え上がるところだが、青子の拳を震わせたのは怒りだけだ。"
msgstr ""

#. Occurrence 5A_6:1235:4979: scene=5A_6
#: 5A_6:1235
msgctxt "text_id=4979 | speaker=unknown"
msgid "　術式妨害なんて初歩の初歩、かけだしの半人前にしか通じない。"
msgstr ""

#. Occurrence 5A_6:1240:4980: scene=5A_6
#: 5A_6:1240
msgctxt "text_id=4980 | speaker=unknown"
msgid "　彼女の同居人レベルなら、あんなジャミングはそれこそ腕が触れた時点で弾き、接触しようとした相手の回路を逆に焼き切ってしまうだろう。"
msgstr ""

#. Occurrence 5A_6:1245:4981: scene=5A_6
#: 5A_6:1245
msgctxt "text_id=4981 | speaker=unknown"
msgid "　このように、他の魔術師と回路を繋げよう、なんて行為は自分の心臓を差し出すに等しい。卓越した魔術師同士の術理戦において、何の役にもたたない<駄機能|だきのう>だ。"
msgstr ""

#. Occurrence 5A_6:1296:4982: scene=5A_6
#: 5A_6:1296
msgctxt "text_id=4982 | speaker=unknown"
msgid "　なのに、あの敵にはそんな“余分な”機能が備えられていた。"
msgstr ""

#. Occurrence 5A_6:1301:4983: scene=5A_6
#: 5A_6:1301
msgctxt "text_id=4983 | speaker=unknown"
msgid "　ここ数週間の、三咲の管理地を巡る戦いっぷりから出た、敵の結論。二日前、正式に魔術師として踏みだした彼女に対する評価がそれ。"
msgstr ""

#. Occurrence 5A_6:1308:4984: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4984 | speaker=unknown"
msgid "　要するに―――"
msgstr ""

#. Occurrence 5A_6:1308:4985: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4985 | speaker=unknown"
msgid "　あの<人形|てき>は、蒼崎青子を完っ全に舐めている。"
msgstr ""

#. Occurrence 5A_6:1375:4986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0008; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1375
msgctxt "text_id=4986 | speaker=aoko"
msgid "「……ふん。敵ながら精確な判断だこと」"
msgstr ""

#. Occurrence 5A_6:1381:4987: scene=5A_6
#: 5A_6:1381
msgctxt "text_id=4987 | speaker=unknown"
msgid "　怒りはそのままに、浮き足立つ激情を冷却する。"
msgstr ""

#. Occurrence 5A_6:1386:4988: scene=5A_6
#: 5A_6:1386
msgctxt "text_id=4988 | speaker=unknown"
msgid "　十七歳の少女には似つかわしくない、達観した狩人の顔。"
msgstr ""

#. Occurrence 5A_6:1467:4989: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0009; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1467
msgctxt "text_id=4989 | speaker=soujuurou"
msgid "「なんか、俺の時より真剣だな」"
msgstr ""

#. Occurrence 5A_6:1487:4990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0009; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1487
msgctxt "text_id=4990 | speaker=aoko"
msgid "「まあね。アンタの時は遊びが入ってたし」"
msgstr ""

#. Occurrence 5A_6:1502:4991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0010; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1502
msgctxt "text_id=4991 | speaker=soujuurou"
msgid "「……む」"
msgstr ""

#. Occurrence 5A_6:1508:4992: scene=5A_6
#: 5A_6:1508
msgctxt "text_id=4992 | speaker=unknown"
msgid "　喜んでいいのか悲しんでいいのか、草十郎には難しい返答だった。"
msgstr ""

#. Occurrence 5A_6:1565:4993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0011; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1565
msgctxt "text_id=4993 | speaker=soujuurou"
msgid "「分からない事だらけで何を聞いていいか分からないんだけど、ひとつだけいいか？」"
msgstr ""

#. Occurrence 5A_6:1606:4994: scene=5A_6
#: 5A_6:1606
msgctxt "text_id=4994 | speaker=unknown"
msgid "　青子は<応|こた>えず、目前の闇を見詰めている。"
msgstr ""

#. Occurrence 5A_6:1611:4995: scene=5A_6
#: 5A_6:1611
msgctxt "text_id=4995 | speaker=unknown"
msgid "　沈黙は重く、まとわりつく闇は締めつける<真綿|まわた>のようだ。"
msgstr ""

#. Occurrence 5A_6:1616:4996: scene=5A_6
#: 5A_6:1616
msgctxt "text_id=4996 | speaker=unknown"
msgid "　それでも、完全に自分を無いものと扱う青子に臆さず、草十郎は続けた。"
msgstr ""

#. Occurrence 5A_6:1638:4997: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0012; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1638
msgctxt "text_id=4997 | speaker=soujuurou"
msgid "「蒼崎は、あいつも殺すのか」"
msgstr ""

#. Occurrence 5A_6:1644:4998: scene=5A_6
#: 5A_6:1644
msgctxt "text_id=4998 | speaker=unknown"
msgid "　<粛々|しゅくしゅく>と。"
msgstr ""

#. Occurrence 5A_6:1649:4999: scene=5A_6
#: 5A_6:1649
msgctxt "text_id=4999 | speaker=unknown"
msgid "　その行為を、暗闇から引きずりだすように。"
msgstr ""

#. Occurrence 5A_6:1703:5000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0010; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1703
msgctxt "text_id=5000 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_6:1709:5001: scene=5A_6
#: 5A_6:1709
msgctxt "text_id=5001 | speaker=unknown"
msgid "　返事はない。"
msgstr ""

#. Occurrence 5A_6:1714:5002: scene=5A_6
#: 5A_6:1714
msgctxt "text_id=5002 | speaker=unknown"
msgid "　薄影の廊下に、ふたりの息遣いだけが響く。"
msgstr ""

#. Occurrence 5A_6:1769:5003: scene=5A_6
#: 5A_6:1769
msgctxt "text_id=5003 | speaker=unknown"
msgid "　罪を問いかける草十郎と、それを無視し続ける魔法使いの少女。"
msgstr ""

#. Occurrence 5A_6:1775:5004: scene=5A_6
#: 5A_6:1775
msgctxt "text_id=5004 | speaker=unknown"
msgid "……凍りつくような数秒の<後|のち>、"
msgstr ""

#. Occurrence 5A_6:1782:5005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0011; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1782
msgctxt "text_id=5005 | speaker=aoko"
msgid "「―――そう。"
msgstr ""

#. Occurrence 5A_6:1788:5006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0012; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1788
msgctxt "text_id=5006 | speaker=aoko"
msgid "　それが貴方のキーワードみたいね」"
msgstr ""

#. Occurrence 5A_6:1820:5007: scene=5A_6
#: 5A_6:1820
msgctxt "text_id=5007 | speaker=unknown"
msgid "　抑揚のない声で、青子は呟いた。"
msgstr ""

#. Occurrence 5A_6:1825:5008: scene=5A_6
#: 5A_6:1825
msgctxt "text_id=5008 | speaker=unknown"
msgid "　観念したようにも、軽蔑したようにも取れる、ため息をこぼしながら。"
msgstr ""

#. Occurrence 5A_6:1873:5009: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0013; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1873
msgctxt "text_id=5009 | speaker=soujuurou"
msgid "「キー……なに？」"
msgstr ""

#. Occurrence 5A_6:1902:5010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0013; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1902
msgctxt "text_id=5010 | speaker=aoko"
msgid "「独り言よ。忘れて。"
msgstr ""

#. Occurrence 5A_6:1908:5011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0014; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1908
msgctxt "text_id=5011 | speaker=aoko"
msgid "　それと。言っとくけど、あいつは人間じゃないわ。"
msgstr ""

#. Occurrence 5A_6:1914:5012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0015; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1914
msgctxt "text_id=5012 | speaker=aoko"
msgid "　信じられないだろうけど自分の意志で動く人形なの。この前のも、今のヤツもね」"
msgstr ""

#. Occurrence 5A_6:1919:5013: scene=5A_6
#: 5A_6:1919
msgctxt "text_id=5013 | speaker=unknown"
msgid "　ふーん、と素直に頷く草十郎。"
msgstr ""

#. Occurrence 5A_6:1932:5014: scene=5A_6
#: 5A_6:1932
msgctxt "text_id=5014 | speaker=unknown"
msgid "　青子の話を信じないどころか、納得さえしている風だ。"
msgstr ""

#. Occurrence 5A_6:1975:5015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0016; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1975
msgctxt "text_id=5015 | speaker=aoko"
msgid "「……なんか落ち着いてるわね、貴方」"
msgstr ""

#. Occurrence 5A_6:1988:5016: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0014; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1988
msgctxt "text_id=5016 | speaker=soujuurou"
msgid "「まさか。もう何がなんだか分からないから、あまり考えない事にしてるだけだ。"
msgstr ""

#. Occurrence 5A_6:1995:5017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0015; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1995
msgctxt "text_id=5017 | speaker=soujuurou"
msgid "ただ、人形に関しては別に、どうという事はない」"
msgstr ""

#. Occurrence 5A_6:2009:5018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0017; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2009
msgctxt "text_id=5018 | speaker=aoko"
msgid "「え？　もしかして、他でも自動人形を見た事あるとか！？」"
msgstr ""

#. Occurrence 5A_6:2034:5019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0016; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:2034
msgctxt "text_id=5019 | speaker=soujuurou"
msgid "「？　都会の人形ってああいうものじゃないのか？」"
msgstr ""

#. Occurrence 5A_6:2083:5020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0018; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2083
msgctxt "text_id=5020 | speaker=aoko"
msgid "「な―――」"
msgstr ""

#. Occurrence 5A_6:2098:5021: scene=5A_6
#: 5A_6:2098
msgctxt "text_id=5021 | speaker=unknown"
msgid "　ばたり、と倒れこみたい衝動をギリギリで<堪|こら>える青子。"
msgstr ""

#. Occurrence 5A_6:2103:5022: scene=5A_6
#: 5A_6:2103
msgctxt "text_id=5022 | speaker=unknown"
msgid "　そうなのだった。"
msgstr ""

#. Occurrence 5A_6:2109:5023: scene=5A_6
#: 5A_6:2109
msgctxt "text_id=5023 | speaker=unknown"
msgid "この、神がかった<呆|ほう>け者はそういう男なのだった。"
msgstr ""

#. Occurrence 5A_6:2114:5024: scene=5A_6
#: 5A_6:2114
msgctxt "text_id=5024 | speaker=unknown"
msgid "　天然保護動物なみに隔離された山奥からの転入生で、常識はずれの常識の無さで、見るものすべてが奇想天外という異邦人。"
msgstr ""

#. Occurrence 5A_6:2141:5025: scene=5A_6
#: 5A_6:2141
msgctxt "text_id=5025 | speaker=unknown"
msgid "　自動車という鉄の塊が動くなら、人形だって動くと思っても不思議はない。"
msgstr ""

#. Occurrence 5A_6:2146:5026: scene=5A_6
#: 5A_6:2146
msgctxt "text_id=5026 | speaker=unknown"
msgid "　……なので、もしかしたら。"
msgstr ""

#. Occurrence 5A_6:2151:5027: scene=5A_6
#: 5A_6:2151
msgctxt "text_id=5027 | speaker=unknown"
msgid "　彼にとってあの夜の出来事は“特別”なことではなく。"
msgstr ""

#. Occurrence 5A_6:2156:5028: scene=5A_6
#: 5A_6:2156
msgctxt "text_id=5028 | speaker=unknown"
msgid "　都会ではよくある風景として、誰に言いふらすような事ではなかったのかもしれない。"
msgstr ""

#. Occurrence 5A_6:2183:5029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0019_A; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2183
msgctxt "text_id=5029 | speaker=aoko"
msgid "「……まいった。いっぺん頭のなか覗いてみたいっていうか、ほんと、ここまでくると感心するわ。"
msgstr ""

#. Occurrence 5A_6:2189:5030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0020; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2189
msgctxt "text_id=5030 | speaker=aoko"
msgid "　……調子が狂うのも当然だった。普通は私に襲われた時点でもっと違う反応をするはずなのに。"
msgstr ""

#. Occurrence 5A_6:2196:5031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0021; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2196
msgctxt "text_id=5031 | speaker=aoko"
msgid "化け物とか、お化けとかさ。でも貴方にとっては『そういう事もある』で済まされてたワケなんだ。"
msgstr ""

#. Occurrence 5A_6:2227:5032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0022; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2227
msgctxt "text_id=5032 | speaker=aoko"
msgid "　……なんか<莫|ば><迦|か>みたいね、私」"
msgstr ""

#. Occurrence 5A_6:2247:5033: scene=5A_6
#: 5A_6:2247
msgctxt "text_id=5033 | speaker=unknown"
msgid "　張りつめた彼女の顔が、一瞬だけ元に戻る。"
msgstr ""

#. Occurrence 5A_6:2252:5034: scene=5A_6
#: 5A_6:2252
msgctxt "text_id=5034 | speaker=unknown"
msgid "　そう。それならもっと違った方法で、誰も傷つかずに済む選択があったかも知れない。"
msgstr ""

#. Occurrence 5A_6:2257:5035: scene=5A_6
#: 5A_6:2257
msgctxt "text_id=5035 | speaker=unknown"
msgid "　けれどもう遅い。"
msgstr ""

#. Occurrence 5A_6:2262:5036: scene=5A_6
#: 5A_6:2262
msgctxt "text_id=5036 | speaker=unknown"
msgid "　基本、人生にやり直しはない。あってはならない。"
msgstr ""

#. Occurrence 5A_6:2282:5037: scene=5A_6
#: 5A_6:2282
msgctxt "text_id=5037 | speaker=unknown"
msgid "　些細な勘違い、勝手な思いこみで状況は悪化しすぎた。"
msgstr ""

#. Occurrence 5A_6:2287:5038: scene=5A_6
#: 5A_6:2287
msgctxt "text_id=5038 | speaker=unknown"
msgid "　ここまで関わった以上、彼女は草十郎を手にかけて秘密を守らなければならない。"
msgstr ""

#. Occurrence 5A_6:2293:5039: scene=5A_6
#: 5A_6:2293
msgctxt "text_id=5039 | speaker=unknown"
msgid "　……本当はもうひとつぐらい、最善の選択肢があっただろうけど後の祭り。"
msgstr ""

#. Occurrence 5A_6:2298:5040: scene=5A_6
#: 5A_6:2298
msgctxt "text_id=5040 | speaker=unknown"
msgid "　所詮、人間の関わり合いなんて相互誤解で回るもの。"
msgstr ""

#. Occurrence 5A_6:2303:5041: scene=5A_6
#: 5A_6:2303
msgctxt "text_id=5041 | speaker=unknown"
msgid "　<意|い><図|と>の編み違いで転がっていく<織物|おりもの>だ。"
msgstr ""

#. Occurrence 5A_7:58:5042: scene=5A_7
#: 5A_7:58
msgctxt "text_id=5042 | speaker=unknown"
msgid "　―――休憩はここまで。"
msgstr ""

#. Occurrence 5A_7:64:5043: scene=5A_7
#: 5A_7:64
msgctxt "text_id=5043 | speaker=unknown"
msgid "　蒼崎青子と静希草十郎。"
msgstr ""

#. Occurrence 5A_7:69:5044: scene=5A_7
#: 5A_7:69
msgctxt "text_id=5044 | speaker=unknown"
msgid "　ふたりが自己紹介を交わした日以来の、なんでもない会話はここで終わり。"
msgstr ""

#. Occurrence 5A_7:74:5045: scene=5A_7
#: 5A_7:74
msgctxt "text_id=5045 | speaker=unknown"
msgid "　彼らの心情とは関係なく、曲がり角の向こうから耳障りな囁きが流れてくる。"
msgstr ""

#. Occurrence 5A_7:153:5046: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5046 | speaker=unknown"
msgid "@o“<Nemo meum funus meminit, qui doluit exstinctus est|私のお葬式はもう誰も覚えていません。悲しむ人も消え去りました。>."
msgstr ""

#. Occurrence 5A_7:153:5047: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5047 | speaker=unknown"
msgid "　　<Initio erraveramus. Dum vivimus dolores sunt|はじまりから私たちは間違えていました。生きているのは苦しいです。>."
msgstr ""

#. Occurrence 5A_7:153:5048: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5048 | speaker=unknown"
msgid "　　　　　　　　　<Nemo adiuvat.|誰か、私を救ってください。>”"
msgstr ""

#. Occurrence 5A_7:211:5049: scene=5A_7
#: 5A_7:211
msgctxt "text_id=5049 | speaker=unknown"
msgid "　合わせ鏡に、曲がり<角|かど>向こうの敵が<映|うつ>る。"
msgstr ""

#. Occurrence 5A_7:231:5050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_0; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:231
msgctxt "text_id=5050 | speaker=aoko"
msgid "「……悠長に話してる場合じゃないわね。とにかく今は距離を―――"
msgstr ""

#. Occurrence 5A_7:243:5051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_1; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:243
msgctxt "text_id=5051 | speaker=aoko"
msgid "っ、！？」"
msgstr ""

#. Occurrence 5A_7:452:5052: scene=5A_7
#: 5A_7:452
msgctxt "text_id=5052 | speaker=unknown"
msgid "　青子の鮮麗な青色とは違う、怨恨を思わせる赤い光。"
msgstr ""

#. Occurrence 5A_7:505:5053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0001; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:505
msgctxt "text_id=5053 | speaker=aoko"
msgid "“ガンド撃ち……！”"
msgstr ""

#. Occurrence 5A_7:589:5054: scene=5A_7
#: 5A_7:589
msgctxt "text_id=5054 | speaker=unknown"
msgid "　伸びる腕より速い、一瞬の閃光。"
msgstr ""

#. Occurrence 5A_7:594:5055: scene=5A_7
#: 5A_7:594
msgctxt "text_id=5055 | speaker=unknown"
msgid "　が、はっきりと敵の姿を視認した時点で、沈みかけていた青子の感情も一瞬で再熱していた。"
msgstr ""

#. Occurrence 5A_7:615:5056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0002; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:615
msgctxt "text_id=5056 | speaker=aoko"
msgid "「っ、さっきから邪魔なのよ……っ！」"
msgstr ""

#. Occurrence 5A_7:743:5057: scene=5A_7
#: 5A_7:743
msgctxt "text_id=5057 | speaker=unknown"
msgid "　行き場のない、ありったけの怒りをぶつけて彼女の右腕が突き出される。"
msgstr ""

#. Occurrence 5A_7:763:5058: scene=5A_7
#: 5A_7:763
msgctxt "text_id=5058 | speaker=unknown"
msgid "　展開された霧は魔術によるものではなく、魔力をぶちまけただけの障壁だ。"
msgstr ""

#. Occurrence 5A_7:768:5059: scene=5A_7
#: 5A_7:768
msgctxt "text_id=5059 | speaker=unknown"
msgid "　飛来する一本の矢の威力をそぐために、バケツ三杯分のガソリンを燃やして壁を作るようなものである。"
msgstr ""

#. Occurrence 5A_7:788:5060: scene=5A_7
#: 5A_7:788
msgctxt "text_id=5060 | speaker=unknown"
msgid "　これが人形の腕であったのなら魔力の壁はたやすく突破されただろうが、実像のない“呪い”だからこそ、魔力の壁に弾かれる。"
msgstr ""

#. Occurrence 5A_7:793:5061: scene=5A_7
#: 5A_7:793
msgctxt "text_id=5061 | speaker=unknown"
msgid "　膨大な魔力の無駄遣いだが、今の青子にはそれしか<防|ふせ>ぐ手段がない。"
msgstr ""

#. Occurrence 5A_7:902:5062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0000; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:902
msgctxt "text_id=5062 | speaker=soujuurou"
msgid "「……う」"
msgstr ""

#. Occurrence 5A_7:908:5063: scene=5A_7
#: 5A_7:908
msgctxt "text_id=5063 | speaker=unknown"
msgid "　が、それで守りきれるのは青子だけだった。"
msgstr ""

#. Occurrence 5A_7:1042:5064: scene=5A_7
#: 5A_7:1042
msgctxt "text_id=5064 | speaker=unknown"
msgid "　口を押さえる草十郎。"
msgstr ""

#. Occurrence 5A_7:1047:5065: scene=5A_7
#: 5A_7:1047
msgctxt "text_id=5065 | speaker=unknown"
msgid "　青子には影響を及ぼさないほど小さくなった呪いでも、魔術師ではない草十郎には十分な効果がある。"
msgstr ""

#. Occurrence 5A_7:1116:5066: scene=5A_7
#: 5A_7:1116
msgctxt "text_id=5066 | speaker=unknown"
msgid "　それが理解できるのか、人形は青子ではなく、その背後にいる予定外の人間に視線を向けた。"
msgstr ""

#. Occurrence 5A_7:1161:5067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0003; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1161
msgctxt "text_id=5067 | speaker=aoko"
msgid "「この、こいつは関係ないでしょう……！」"
msgstr ""

#. Occurrence 5A_7:1204:5068: scene=5A_7
#: 5A_7:1204
msgctxt "text_id=5068 | speaker=unknown"
msgid "　カッとなってもう一度腕を振るう。"
msgstr ""

#. Occurrence 5A_7:1209:5069: scene=5A_7
#: 5A_7:1209
msgctxt "text_id=5069 | speaker=unknown"
msgid "　わずか数秒、青い燐光は<呪い|ガンド>を防ぐ障壁となる。"
msgstr ""

#. Occurrence 5A_7:1308:5070: scene=5A_7
#: 5A_7:1308
msgctxt "text_id=5070 | speaker=unknown"
msgid "　その隙。"
msgstr ""

#. Occurrence 5A_7:1313:5071: scene=5A_7
#: 5A_7:1313
msgctxt "text_id=5071 | speaker=unknown"
msgid "　壁を張ったばかりの青子の顔を指さすように、人形の右腕が突き出され―――"
msgstr ""

#. Occurrence 5A_7:1320:5072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0001; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1320
msgctxt "text_id=5072 | speaker=soujuurou"
msgid "「関係あるみたいだから、逃げるぞ」"
msgstr ""

#. Occurrence 5A_7:1389:5073: scene=5A_7
#: 5A_7:1389
msgctxt "text_id=5073 | speaker=unknown"
msgid "　死のロケット弾が放たれる前に、草十郎はひょいっと青子を抱き抱えた。"
msgstr ""

#. Occurrence 5A_7:1455:5074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0004; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1455
msgctxt "text_id=5074 | speaker=aoko"
msgid "「へ！？」"
msgstr ""

#. Occurrence 5A_7:1461:5075: scene=5A_7
#: 5A_7:1461
msgctxt "text_id=5075 | speaker=unknown"
msgid "　どこにそんな力が残っていたのか、草十郎は人形に背を向けて走り出した。"
msgstr ""

#. Occurrence 5A_7:1549:5076: scene=5A_7
#: 5A_7:1549
msgctxt "text_id=5076 | speaker=unknown"
msgid "　軽快なスプリンターか、岩肌を跳ぶ鹿のようだ。"
msgstr ""

#. Occurrence 5A_7:1554:5077: scene=5A_7
#: 5A_7:1554
msgctxt "text_id=5077 | speaker=unknown"
msgid "　草十郎は曲がり角を二つ越え、"
msgstr ""

#. Occurrence 5A_7:1579:5078: scene=5A_7
#: 5A_7:1579
msgctxt "text_id=5078 | speaker=unknown"
msgid "　なにか文句を言いたそうな青子を無視して、"
msgstr ""

#. Occurrence 5A_7:1584:5079: scene=5A_7
#: 5A_7:1584
msgctxt "text_id=5079 | speaker=unknown"
msgid "　もうじき二階の中心、というところで足を止めて、青子から手を離した。"
msgstr ""

#. Occurrence 5A_7:1635:5080: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0002; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1635
msgctxt "text_id=5080 | speaker=soujuurou"
msgid "「……よし。ここまでくれば少しは休めるな」"
msgstr ""

#. Occurrence 5A_7:1641:5081: scene=5A_7
#: 5A_7:1641
msgctxt "text_id=5081 | speaker=unknown"
msgid "　ふう、と肩で息をする草十郎。"
msgstr ""

#. Occurrence 5A_7:1646:5082: scene=5A_7
#: 5A_7:1646
msgctxt "text_id=5082 | speaker=unknown"
msgid "　いくら軽いとは言え、人間ひとり抱えて走ったので息があがっている。"
msgstr ""

#. Occurrence 5A_7:1651:5083: scene=5A_7
#: 5A_7:1651
msgctxt "text_id=5083 | speaker=unknown"
msgid "　その顔を、青子は理解不能とばかりに見あげている。"
msgstr ""

#. Occurrence 5A_7:1688:5084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0005; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1688
msgctxt "text_id=5084 | speaker=aoko"
msgid "「……こんな体力あったのに、なんで……？」"
msgstr ""

#. Occurrence 5A_7:1694:5085: scene=5A_7
#: 5A_7:1694
msgctxt "text_id=5085 | speaker=unknown"
msgid "　道理に合わない。"
msgstr ""

#. Occurrence 5A_7:1699:5086: scene=5A_7
#: 5A_7:1699
msgctxt "text_id=5086 | speaker=unknown"
msgid "　自分を抱えて走れるだけの体力があったのなら、床に倒れたあの時、まだ立ち上がって逃げられたはずなのにと。"
msgstr ""

#. Occurrence 5A_7:1750:5087: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0003; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1750
msgctxt "text_id=5087 | speaker=soujuurou"
msgid "「ああ、あの時は諦めてたから」"
msgstr ""

#. Occurrence 5A_7:1756:5088: scene=5A_7
#: 5A_7:1756
msgctxt "text_id=5088 | speaker=unknown"
msgid "　取り<繕|つくろ>いのない、さっぱりとした言葉。"
msgstr ""

#. Occurrence 5A_7:1761:5089: scene=5A_7
#: 5A_7:1761
msgctxt "text_id=5089 | speaker=unknown"
msgid "　一刻、一命を争う状況だ。普段のぼんやりした雰囲気は、さすがに薄くなっている。"
msgstr ""

#. Occurrence 5A_7:1782:5090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0006; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1782
msgctxt "text_id=5090 | speaker=aoko"
msgid "「……諦めてたって、どうして？」"
msgstr ""

#. Occurrence 5A_7:1823:5091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0004; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1823
msgctxt "text_id=5091 | speaker=soujuurou"
msgid "「さあ。忘れた、そんな事は」"
msgstr ""

#. Occurrence 5A_7:1829:5092: scene=5A_7
#: 5A_7:1829
msgctxt "text_id=5092 | speaker=unknown"
msgid "　言いたくない、と顔を背けるものの、律儀に草十郎は答える。"
msgstr ""

#. Occurrence 5A_7:1834:5093: scene=5A_7
#: 5A_7:1834
msgctxt "text_id=5093 | speaker=unknown"
msgid "　その横顔は、青子にはなんだか痛かった。"
msgstr ""

#. Occurrence 5A_7:1882:5094: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0005; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1882
msgctxt "text_id=5094 | speaker=soujuurou"
msgid "「それより蒼崎、とうとつに気分が悪いんだが……。"
msgstr ""

#. Occurrence 5A_7:1888:5095: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0006; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1888
msgctxt "text_id=5095 | speaker=soujuurou"
msgid "　あの赤い光も、その……？」"
msgstr ""

#. Occurrence 5A_7:1903:5096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0007; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1903
msgctxt "text_id=5096 | speaker=aoko"
msgid "「……ええ、魔術の類よ。ガンド撃ちって言ってね。北欧の呪詛の一つ。魔術回路のある私には効かないけど、抵抗のない貴方には効果てきめんみたいね」"
msgstr ""

#. Occurrence 5A_7:1948:5097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5097 | speaker=soujuurou"
msgid "「―――なんだ。蒼崎には効かないのか。"
msgstr ""

#. Occurrence 5A_7:1948:5098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5098 | speaker=soujuurou"
msgid "　じゃあ、危ないのはあの腕だけだな」"
msgstr ""

#. Occurrence 5A_7:1954:5099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0008; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1954
msgctxt "text_id=5099 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 5A_7:2009:5100: scene=5A_7
#: 5A_7:2009
msgctxt "text_id=5100 | speaker=unknown"
msgid "　なぜかホッとする草十郎に、青子は奥歯を噛んで、突発的な<感|こ><情|え>を抑えこんだ。"
msgstr ""

#. Occurrence 5A_7:2015:5101: scene=5A_7
#: 5A_7:2015
msgctxt "text_id=5101 | speaker=unknown"
msgid "　……こんなところで怒鳴っても仕方がないし。"
msgstr ""

#. Occurrence 5A_7:2020:5102: scene=5A_7
#: 5A_7:2020
msgctxt "text_id=5102 | speaker=unknown"
msgid "　なにより、どうしていま自分が最高にイラっときたかなんて、言語化したらそれこそ何もかもどうでもよくなってしまいそうだ。"
msgstr ""

#. Occurrence 5A_7:2079:5103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0009; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2079
msgctxt "text_id=5103 | speaker=aoko"
msgid "「―――そうね。注意するのは伸ばしてくる腕だけ。大した相手じゃないわ、やっぱり」"
msgstr ""

#. Occurrence 5A_7:2085:5104: scene=5A_7
#: 5A_7:2085
msgctxt "text_id=5104 | speaker=unknown"
msgid "　嘘偽りのない感想だった。"
msgstr ""

#. Occurrence 5A_7:2090:5105: scene=5A_7
#: 5A_7:2090
msgctxt "text_id=5105 | speaker=unknown"
msgid "　普段の蒼崎青子なら問題のない相手。"
msgstr ""

#. Occurrence 5A_7:2095:5106: scene=5A_7
#: 5A_7:2095
msgctxt "text_id=5106 | speaker=unknown"
msgid "　ただ、目も当てられない油断から魔術回路に介入されて、自分がさらに大した相手じゃなくなっただけの話。"
msgstr ""

#. Occurrence 5A_7:2140:5107: scene=5A_7
#: 5A_7:2140
msgctxt "text_id=5107 | speaker=unknown"
msgid "　今の青子には攻撃手段がない。"
msgstr ""

#. Occurrence 5A_7:2145:5108: scene=5A_7
#: 5A_7:2145
msgctxt "text_id=5108 | speaker=unknown"
msgid "　こうなると相手の魔力切れを待つしかないのだが、相手は呪いの永久機関。"
msgstr ""

#. Occurrence 5A_7:2150:5109: scene=5A_7
#: 5A_7:2150
msgctxt "text_id=5109 | speaker=unknown"
msgid "　この追いかけっこは、どちらかが息絶えるまで終わらない。"
msgstr ""

#. Occurrence 5A_7:2156:5110: scene=5A_7
#: 5A_7:2156
msgctxt "text_id=5110 | speaker=unknown"
msgid "　……まるでさっきの自分たちのようだと青子は自嘲する。"
msgstr ""

#. Occurrence 5A_7:2194:5111: scene=5A_7
#: 5A_7:2194
msgctxt "text_id=5111 | speaker=unknown"
msgid "　右腕をちらりと見る。"
msgstr ""

#. Occurrence 5A_7:2201:5112: scene=5A_7
#: 5A_7:2201
msgctxt "text_id=5112 | speaker=unknown"
msgid "　魔力残量はまだ半分以上もあるのに、このていたらくとは。"
msgstr ""

#. Occurrence 5A_7:2206:5113: scene=5A_7
#: 5A_7:2206
msgctxt "text_id=5113 | speaker=unknown"
msgid "　面白がって草十郎を追いかけ回した<罰|ツケ>が、こんな形で回ってきた。"
msgstr ""

#. Occurrence 5A_7:2227:5114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0010; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2227
msgctxt "text_id=5114 | speaker=aoko"
msgid "“……呆れた。居るところには居るものね、神さまって”"
msgstr ""

#. Occurrence 5A_7:2254:5115: scene=5A_7
#: 5A_7:2254
msgctxt "text_id=5115 | speaker=unknown"
msgid "　ひとり<愚|ぐ><痴|ち>って、青子は意識を切り替える。"
msgstr ""

#. Occurrence 5A_7:2259:5116: scene=5A_7
#: 5A_7:2259
msgctxt "text_id=5116 | speaker=unknown"
msgid "　弾こそ撃てないがまだ燃料のある自分。"
msgstr ""

#. Occurrence 5A_7:2264:5117: scene=5A_7
#: 5A_7:2264
msgctxt "text_id=5117 | speaker=unknown"
msgid "　尽きない動力で永久に追いかけてくる殺人機巧。"
msgstr ""

#. Occurrence 5A_7:2269:5118: scene=5A_7
#: 5A_7:2269
msgctxt "text_id=5118 | speaker=unknown"
msgid "　なら、取るべき未来は明白すぎる。"
msgstr ""

#. Occurrence 5A_7:2274:5119: scene=5A_7
#: 5A_7:2274
msgctxt "text_id=5119 | speaker=unknown"
msgid "　あとはいつもの自分に戻るだけだ。"
msgstr ""

#. Occurrence 5A_7:2295:5120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0008; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2295
msgctxt "text_id=5120 | speaker=soujuurou"
msgid "「……蒼崎？」"
msgstr ""

#. Occurrence 5A_7:2332:5121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0011; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2332
msgctxt "text_id=5121 | speaker=aoko"
msgid "「ごめん、考え事してた。"
msgstr ""

#. Occurrence 5A_7:2352:5122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0012; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2352
msgctxt "text_id=5122 | speaker=aoko"
msgid "えっと、たしか……よし、あってる。静希君、そこに横道あるの、分かる？」"
msgstr ""

#. Occurrence 5A_7:2358:5123: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0009; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2358
msgctxt "text_id=5123 | speaker=soujuurou"
msgid "「は？」"
msgstr ""

#. Occurrence 5A_7:2403:5124: scene=5A_7
#: 5A_7:2403
msgctxt "text_id=5124 | speaker=unknown"
msgid "　青子が指さした先はどう見ても通路の壁で、横道なんて見あたらない。"
msgstr ""

#. Occurrence 5A_7:2408:5125: scene=5A_7
#: 5A_7:2408
msgctxt "text_id=5125 | speaker=unknown"
msgid "　そもそもこのフロアは左に曲がるだけの造りで、青子が示しているのは右側に抜ける道だ。"
msgstr ""

#. Occurrence 5A_7:2436:5126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0013; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2436
msgctxt "text_id=5126 | speaker=aoko"
msgid "「二階は中心までいくと一階に下りる階段があるんだけど、それは私が壊したから使えないの。"
msgstr ""

#. Occurrence 5A_7:2442:5127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0014; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2442
msgctxt "text_id=5127 | speaker=aoko"
msgid "　けどここの造りも意地が悪くてね。よく見れば右に曲がる通路もあるのよ。上級者だけに分かる抜け道ってヤツ。"
msgstr ""

#. Occurrence 5A_7:2448:5128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0015; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2448
msgctxt "text_id=5128 | speaker=aoko"
msgid "　あとは注意して探せば、一階の階段までショートカットできる。悪いけどひとりで行って」"
msgstr ""

#. Occurrence 5A_7:2498:5129: scene=5A_7
#: 5A_7:2498
msgctxt "text_id=5129 | speaker=unknown"
msgid "　青子は草十郎に背を向けて歩きだした。"
msgstr ""

#. Occurrence 5A_7:2503:5130: scene=5A_7
#: 5A_7:2503
msgctxt "text_id=5130 | speaker=unknown"
msgid "　逃げ道である右に抜ける通路とは逆の、人形が追いかけてくる長い通路へと。"
msgstr ""

#. Occurrence 5A_7:2550:5131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0016; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2550
msgctxt "text_id=5131 | speaker=aoko"
msgid "「あいつは無差別だから、ここで壊さないといけない。魔術師は魔術師同士で争うのはいいんだけど、みだりに一般人に手をだしちゃいけないって決まりがあるの。"
msgstr ""

#. Occurrence 5A_7:2556:5132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0017; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2556
msgctxt "text_id=5132 | speaker=aoko"
msgid "　あいつの目的は私のワケだし、結果がどうあれスッキリするでしょ？」"
msgstr ""

#. Occurrence 5A_7:2593:5133: scene=5A_7
#: 5A_7:2593
msgctxt "text_id=5133 | speaker=unknown"
msgid "　青子が勝てば人形は壊れる。"
msgstr ""

#. Occurrence 5A_7:2598:5134: scene=5A_7
#: 5A_7:2598
msgctxt "text_id=5134 | speaker=unknown"
msgid "　青子が負けても目的完了という事で人形は停止する。"
msgstr ""

#. Occurrence 5A_7:2603:5135: scene=5A_7
#: 5A_7:2603
msgctxt "text_id=5135 | speaker=unknown"
msgid "　どうあれ、ここで別れれば草十郎は無関係のまま生還できる。"
msgstr ""

#. Occurrence 5A_7:2608:5136: scene=5A_7
#: 5A_7:2608
msgctxt "text_id=5136 | speaker=unknown"
msgid "　そういう事を青子は言っていた。"
msgstr ""

#. Occurrence 5A_7:2613:5137: scene=5A_7
#: 5A_7:2613
msgctxt "text_id=5137 | speaker=unknown"
msgid "　事務的に、あくまで他人事のように。"
msgstr ""

#. Occurrence 5A_7:2656:5138: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0018; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2656
msgctxt "text_id=5138 | speaker=aoko"
msgid "「運が良ければ入り口までたどり着けるわ。"
msgstr ""

#. Occurrence 5A_7:2662:5139: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0019; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2662
msgctxt "text_id=5139 | speaker=aoko"
msgid "　それじゃ、また明日ね」"
msgstr ""

#. Occurrence 5A_7:2697:5140: scene=5A_7
#: 5A_7:2697
msgctxt "text_id=5140 | speaker=unknown"
msgid "　強がりであるのは草十郎ですら感じ取れた。"
msgstr ""

#. Occurrence 5A_7:2702:5141: scene=5A_7
#: 5A_7:2702
msgctxt "text_id=5141 | speaker=unknown"
msgid "　けれど止める間も、その必要もなく、彼女は曲がり角に消えていった。"
msgstr ""

#. Occurrence 5A_8:67:5142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0000; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:67
msgctxt "text_id=5142 | speaker=aoko"
msgid "「―――さて」"
msgstr ""

#. Occurrence 5A_8:73:5143: scene=5A_8
#: 5A_8:73
msgctxt "text_id=5143 | speaker=unknown"
msgid "　本格的にまずい事になったな、と青子は心中で呟いた。"
msgstr ""

#. Occurrence 5A_8:78:5144: scene=5A_8
#: 5A_8:78
msgctxt "text_id=5144 | speaker=unknown"
msgid "　今回の<人|て><形|き>は二日前の公園で倒したものとは<品|か><質|く>が違う。"
msgstr ""

#. Occurrence 5A_8:83:5145: scene=5A_8
#: 5A_8:83
msgctxt "text_id=5145 | speaker=unknown"
msgid "　自動詠唱による永久機関だけでも稀少品なのに、腕を伸ばすという荒事にも耐え、両目は<呪詛|ガンド>を投影する水晶製ときた。"
msgstr ""

#. Occurrence 5A_8:88:5146: scene=5A_8
#: 5A_8:88
msgctxt "text_id=5146 | speaker=unknown"
msgid "　日本円に換算すれば九桁に届きかねない超一級品である。"
msgstr ""

#. Occurrence 5A_8:123:5147: scene=5A_8
#: 5A_8:123
msgctxt "text_id=5147 | speaker=unknown"
msgid "　ただし。それはあくまでアンティークとしての話。"
msgstr ""

#. Occurrence 5A_8:128:5148: scene=5A_8
#: 5A_8:128
msgctxt "text_id=5148 | speaker=unknown"
msgid "　戦闘に<用|もち>いるのなら、もっと安価で、かつ戦いに適した使い魔を動員すべきだろうに。"
msgstr ""

#. Occurrence 5A_8:133:5149: scene=5A_8
#: 5A_8:133
msgctxt "text_id=5149 | speaker=unknown"
msgid "　あれだけの高級品を殺人に用いるあたり、あの人形の持ち主は今までの“敵”とは一線を画した変態に違いない。"
msgstr ""

#. Occurrence 5A_8:333:5150: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5150 | speaker=unknown"
msgid "“<Vivo|ウィウォ> <in|イン> <somno|スォムノ>. <Solitarie|スォリタリエ> <putresco|プトゥレスコ> <in|イン> <inferis|インフェリス>."
msgstr ""

#. Occurrence 5A_8:333:5151: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5151 | speaker=unknown"
msgid "@o<Hic|ヒク> <dies|ディエス> <meus|メウス> <obitus|オビトゥス> <dies|ディエス>, <et|エトゥ> <meus|メウス> <nativus|ナティウゥス> <dies|ディエス>. <Te|テ> <obeam|オベアム>.”"
msgstr ""

#. Occurrence 5A_8:469:5152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0001; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:469
msgctxt "text_id=5152 | speaker=aoko"
msgid "「―――来たわね」"
msgstr ""

#. Occurrence 5A_8:475:5153: scene=5A_8
#: 5A_8:475
msgctxt "text_id=5153 | speaker=unknown"
msgid "　がさついたオルゴール。"
msgstr ""

#. Occurrence 5A_8:480:5154: scene=5A_8
#: 5A_8:480
msgctxt "text_id=5154 | speaker=unknown"
msgid "　自らを呪う事で動力を得る<自動人形|オートマタ>が近づいてくる。"
msgstr ""

#. Occurrence 5A_8:485:5155: scene=5A_8
#: 5A_8:485
msgctxt "text_id=5155 | speaker=unknown"
msgid "　通路の長さは約十メートル。青子は一つ奥の曲がり角で、人形が現れるのを待ちかまえる。"
msgstr ""

#. Occurrence 5A_8:548:5156: scene=5A_8
#: 5A_8:548
msgctxt "text_id=5156 | speaker=unknown"
msgid "　……ここで決着をつけるのは静希草十郎を逃がす為ではない。断じてない。"
msgstr ""

#. Occurrence 5A_8:553:5157: scene=5A_8
#: 5A_8:553
msgctxt "text_id=5157 | speaker=unknown"
msgid "　青子は的確に、今の自分ではあの人形からは逃げきれないと判断しただけだ。"
msgstr ""

#. Occurrence 5A_8:573:5158: scene=5A_8
#: 5A_8:573
msgctxt "text_id=5158 | speaker=unknown"
msgid "　仮に逃走を選んだ場合、幾つかの幸運が働いてミラーハウスから出られたとしてもそこまで。"
msgstr ""

#. Occurrence 5A_8:578:5159: scene=5A_8
#: 5A_8:578
msgctxt "text_id=5159 | speaker=unknown"
msgid "　障害物のない外に出ればあっさりと追いつかれ、背中から串刺しにされる。"
msgstr ""

#. Occurrence 5A_8:603:5160: scene=5A_8
#: 5A_8:603
msgctxt "text_id=5160 | speaker=unknown"
msgid "　魔術が封じられている以上、追っ手から逃げきるのは不可能だ。"
msgstr ""

#. Occurrence 5A_8:608:5161: scene=5A_8
#: 5A_8:608
msgctxt "text_id=5161 | speaker=unknown"
msgid "　なので、ここで撃退する選択をとる。"
msgstr ""

#. Occurrence 5A_8:613:5162: scene=5A_8
#: 5A_8:613
msgctxt "text_id=5162 | speaker=unknown"
msgid "　状況は不利だが、それはあちらも同じこと。"
msgstr ""

#. Occurrence 5A_8:680:5163: scene=5A_8
#: 5A_8:680
msgctxt "text_id=5163 | speaker=unknown"
msgid "　この細い通路では青子に逃げ場はないが、反面、あの人形も全速を出せずにいる。"
msgstr ""

#. Occurrence 5A_8:685:5164: scene=5A_8
#: 5A_8:685
msgctxt "text_id=5164 | speaker=unknown"
msgid "　機械仕掛けの欠点だ。"
msgstr ""

#. Occurrence 5A_8:690:5165: scene=5A_8
#: 5A_8:690
msgctxt "text_id=5165 | speaker=unknown"
msgid "　<小刻|こきざ>みな加速と減速は、あの時代のオートマタにとっても苦手とする機能だろう。"
msgstr ""

#. Occurrence 5A_8:752:5166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0002; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:752
msgctxt "text_id=5166 | speaker=aoko"
msgid "「―――<接続|セット>」"
msgstr ""

#. Occurrence 5A_8:815:5167: scene=5A_8
#: 5A_8:815
msgctxt "text_id=5167 | speaker=unknown"
msgid "　断線だらけの魔術回路に魔力を流す。"
msgstr ""

#. Occurrence 5A_8:820:5168: scene=5A_8
#: 5A_8:820
msgctxt "text_id=5168 | speaker=unknown"
msgid "　……血液の流れ、魔力の供給がまったく安定しない。"
msgstr ""

#. Occurrence 5A_8:825:5169: scene=5A_8
#: 5A_8:825
msgctxt "text_id=5169 | speaker=unknown"
msgid "　これでは魔術式を組むのは難しい。"
msgstr ""

#. Occurrence 5A_8:831:5170: scene=5A_8
#: 5A_8:831
msgctxt "text_id=5170 | speaker=unknown"
msgid "　魔力で右手を加工し、大雑把に硬度を上げる事しかできない。"
msgstr ""

#. Occurrence 5A_8:837:5171: scene=5A_8
#: 5A_8:837
msgctxt "text_id=5171 | speaker=unknown"
msgid "青子の武器はトンカチ以上、バット未満の<細腕|ほそうで><鈍器|どんき>だ。近づく事が前提の時点で、この上なく頼りない。"
msgstr ""

#. Occurrence 5A_8:923:5172: scene=5A_8
#: 5A_8:923
msgctxt "text_id=5172 | speaker=unknown"
msgid "　となると、あとは戦法だ。"
msgstr ""

#. Occurrence 5A_8:928:5173: scene=5A_8
#: 5A_8:928
msgctxt "text_id=5173 | speaker=unknown"
msgid "　今はどんな武器を用意するかではなく、この武器でどう戦うかを選ばなくては。"
msgstr ""

#. Occurrence 5A_8:933:5174: scene=5A_8
#: 5A_8:933
msgctxt "text_id=5174 | speaker=unknown"
msgid "　簡単に考えつくのは鏡の反射を利用して姿を隠し、死角から襲いかかる―――しかし、それは通じまい。"
msgstr ""

#. Occurrence 5A_8:953:5175: scene=5A_8
#: 5A_8:953
msgctxt "text_id=5175 | speaker=unknown"
msgid "　なぜなら、あの人形にはもともと視覚がない。"
msgstr ""

#. Occurrence 5A_8:958:5176: scene=5A_8
#: 5A_8:958
msgctxt "text_id=5176 | speaker=unknown"
msgid "　人形は視覚情報からではなく、周囲の地形状況から世界を視ている。"
msgstr ""

#. Occurrence 5A_8:963:5177: scene=5A_8
#: 5A_8:963
msgctxt "text_id=5177 | speaker=unknown"
msgid "　暗闇に棲息するコウモリと同じ理屈だ。高音の波を発し、その反響によって周囲の地形を<測|はか>る反響定位法。"
msgstr ""

#. Occurrence 5A_8:968:5178: scene=5A_8
#: 5A_8:968
msgctxt "text_id=5178 | speaker=unknown"
msgid "　あの詠唱は<音波|センサー>の役割も果たしている。人形にとって壁は透明の板にすぎず、物陰からの奇襲なぞお笑い草だろう。"
msgstr ""

#. Occurrence 5A_8:994:5179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0003; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:994
msgctxt "text_id=5179 | speaker=aoko"
msgid "“……近づけば近づくほど、より<明確|リアル>に察知される……ホントは遠距離からの狙撃が最適なんだけど……ガンドを撃ってくるなら、フィンの一撃ぐらい隠してるわよね……”"
msgstr ""

#. Occurrence 5A_8:1063:5180: scene=5A_8
#: 5A_8:1063
msgctxt "text_id=5180 | speaker=unknown"
msgid "　ガンド撃ちは北欧に伝わる、単純にして汎用性の高い呪詛だ。最適化されたものは“指をさす”だけで相手の体調を悪化させる。"
msgstr ""

#. Occurrence 5A_8:1068:5181: scene=5A_8
#: 5A_8:1068
msgctxt "text_id=5181 | speaker=unknown"
msgid "　<一工程|シングルアクション>の魔術なので効果はあくまで“<病|やまい>”に限定されるが、ガンド撃ちには最奥と言われる秘術がある。"
msgstr ""

#. Occurrence 5A_8:1073:5182: scene=5A_8
#: 5A_8:1073
msgctxt "text_id=5182 | speaker=unknown"
msgid "　<曰|いわ>く“フィンの一撃”。"
msgstr ""

#. Occurrence 5A_8:1078:5183: scene=5A_8
#: 5A_8:1078
msgctxt "text_id=5183 | speaker=unknown"
msgid "　病ではなく、受けた相手の心臓を停止させる死の呪い。"
msgstr ""

#. Occurrence 5A_8:1186:5184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0004; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1186
msgctxt "text_id=5184 | speaker=aoko"
msgid "「…………っ」"
msgstr ""

#. Occurrence 5A_8:1193:5185: scene=5A_8
#: 5A_8:1193
msgctxt "text_id=5185 | speaker=unknown"
msgid "　背中に受けた傷が神経を<昂|たか>ぶらせる。"
msgstr ""

#. Occurrence 5A_8:1198:5186: scene=5A_8
#: 5A_8:1198
msgctxt "text_id=5186 | speaker=unknown"
msgid "　武器を失った小娘と、即死の奥の手を持つ自動人形。"
msgstr ""

#. Occurrence 5A_8:1203:5187: scene=5A_8
#: 5A_8:1203
msgctxt "text_id=5187 | speaker=unknown"
msgid "　誰がどう見ても殺されるのは自分の方。"
msgstr ""

#. Occurrence 5A_8:1208:5188: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5188 | speaker=unknown"
msgid "　彼女は、現状の蒼<崎青|じぶん>子に生き延びる手段は<乏|とぼ>しいと考え、"
msgstr ""

#. Occurrence 5A_8:1208:5189: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5189 | speaker=unknown"
msgid "　そして―――"
msgstr ""

#. Occurrence 5A_8:1347:5190: scene=5A_8
#: 5A_8:1347
msgctxt "text_id=5190 | speaker=unknown"
msgid "　その幻視に、ぞくりとした。"
msgstr ""

#. Occurrence 5A_8:1368:5191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0005; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1368
msgctxt "text_id=5191 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_8:1374:5192: scene=5A_8
#: 5A_8:1374
msgctxt "text_id=5192 | speaker=unknown"
msgid "　青子は静かに、<努|つと>めて全霊で、いつもの錯覚を堪え忍ぶ。"
msgstr ""

#. Occurrence 5A_8:1379:5193: scene=5A_8
#: 5A_8:1379
msgctxt "text_id=5193 | speaker=unknown"
msgid "　カチカチと鳴りそうな奥歯をきっと噛みしめる。"
msgstr ""

#. Occurrence 5A_8:1384:5194: scene=5A_8
#: 5A_8:1384
msgctxt "text_id=5194 | speaker=unknown"
msgid "　ああ、でも、首筋にナニモノかの指が<這|は>っていく感触がある。背後にいる<幽霊|さっかく>が彼女を見て笑っている。"
msgstr ""

#. Occurrence 5A_8:1389:5195: scene=5A_8
#: 5A_8:1389
msgctxt "text_id=5195 | speaker=unknown"
msgid "　それだけで逃げだす一歩手前なのに、五秒後の<脳内予測|シミュレート>では、十戦して二回も倒れる自分の姿。"
msgstr ""

#. Occurrence 5A_8:1531:5196: scene=5A_8
#: 5A_8:1531
msgctxt "text_id=5196 | speaker=unknown"
msgid "　……二回。彼女の予測は時に現実よりも現実的だ。"
msgstr ""

#. Occurrence 5A_8:1537:5197: scene=5A_8
#: 5A_8:1537
msgctxt "text_id=5197 | speaker=unknown"
msgid "　……十回やって、二回。イメージに留まらない、あまりに<真実|リアル>な自分の亡骸たちを幻視する。"
msgstr ""

#. Occurrence 5A_8:1558:5198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0006; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1558
msgctxt "text_id=5198 | speaker=aoko"
msgid "「――――――、っ」"
msgstr ""

#. Occurrence 5A_8:1564:5199: scene=5A_8
#: 5A_8:1564
msgctxt "text_id=5199 | speaker=unknown"
msgid "　人形の呪いを受けて倒れている自分。"
msgstr ""

#. Occurrence 5A_8:1570:5200: scene=5A_8
#: 5A_8:1570
msgctxt "text_id=5200 | speaker=unknown"
msgid "　眼球は<河|フ><豚|グ>のようにこぼれかけ、<耳鼻口|みみはなくち>からだらしなく垂れる血小便。"
msgstr ""

msgctxt "text_id=5201 | speaker=unknown"
msgid "二回、二回、二回。"
msgstr ""

msgctxt "text_id=5202 | speaker=unknown"
msgid "一回だけでも耐えられないのに、二回も死ぬなんて、とても正気じゃいられない……！"
msgstr ""

#. Occurrence 5A_8:1662:5203: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0007; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1662
msgctxt "text_id=5203 | speaker=aoko"
msgid "「―――、―――でも」"
msgstr ""

#. Occurrence 5A_8:1668:5204: scene=5A_8
#: 5A_8:1668
msgctxt "text_id=5204 | speaker=unknown"
msgid "　ねじ曲がろうとする心を<抑|おさ>える。"
msgstr ""

#. Occurrence 5A_8:1673:5205: scene=5A_8
#: 5A_8:1673
msgctxt "text_id=5205 | speaker=unknown"
msgid "　青子は深呼吸をして、それがどうした、と鏡に映る自分を見つめ返した。"
msgstr ""

#. Occurrence 5A_8:1762:5206: scene=5A_8
#: 5A_8:1762
msgctxt "text_id=5206 | speaker=unknown"
msgid "　―――半年前の、あの白い夜を思い出せ。"
msgstr ""

#. Occurrence 5A_8:1767:5207: scene=5A_8
#: 5A_8:1767
msgctxt "text_id=5207 | speaker=unknown"
msgid "　この程度、ピンチでもなんでもない。"
msgstr ""

#. Occurrence 5A_8:1772:5208: scene=5A_8
#: 5A_8:1772
msgctxt "text_id=5208 | speaker=unknown"
msgid "　半年前の久遠寺の洋館。"
msgstr ""

#. Occurrence 5A_8:1777:5209: scene=5A_8
#: 5A_8:1777
msgctxt "text_id=5209 | speaker=unknown"
msgid "　深い霧に現れた<白薔薇|しろばら>の<猟犬|ワンダースナッチ>に、自分は十回中<百|・><回|・>は殺されたのではなかったか。"
msgstr ""

#. Occurrence 5A_8:1836:5210: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5210 | speaker=unknown"
msgid "“<Me|メア>a <ani|アニマ>ma <immorta|イムモルタリス>lis. <Aute|アウテム>m <me|メア>a <futu|フトゥラ>ra <nec|ネカタ>ata <sunt|スントゥ>."
msgstr ""

#. Occurrence 5A_8:1836:5211: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5211 | speaker=unknown"
msgid "　<Man|マネス>es <su|スム>m. <Anim|アニマム>am <defin|デフィニレ>ire <ambigu|アンビグウム>um <est.|エストゥ>”"
msgstr ""

#. Occurrence 5A_8:1856:5212: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5212 | speaker=unknown"
msgid "　青子の錯覚は、その<昏|くら>い呪詛によってかき消えた。"
msgstr ""

#. Occurrence 5A_8:1856:5213: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5213 | speaker=unknown"
msgid "　距離にして約十メートル。"
msgstr ""

#. Occurrence 5A_8:1861:5214: scene=5A_8
#: 5A_8:1861
msgctxt "text_id=5214 | speaker=unknown"
msgid "　対面の曲がり角に少女の人形が現れる。"
msgstr ""

#. Occurrence 5A_8:1866:5215: scene=5A_8
#: 5A_8:1866
msgctxt "text_id=5215 | speaker=unknown"
msgid "　お互い、<輪郭|りんかく>もはっきりしない影の間合い。"
msgstr ""

#. Occurrence 5A_8:2032:5216: scene=5A_8
#: 5A_8:2032
msgctxt "text_id=5216 | speaker=unknown"
msgid "　人形には前口上も初動もない。"
msgstr ""

#. Occurrence 5A_8:2037:5217: scene=5A_8
#: 5A_8:2037
msgctxt "text_id=5217 | speaker=unknown"
msgid "　気配の起こりもなく撃ち出される<呪詛|ガンド>を、"
msgstr ""

#. Occurrence 5A_8:2146:5218: scene=5A_8
#: 5A_8:2146
msgctxt "text_id=5218 | speaker=unknown"
msgid "　青子は予測通り、魔力の霧で<削|けず>り<防|ふせ>ぐ。"
msgstr ""

#. Occurrence 5A_8:2306:5219: scene=5A_8
#: 5A_8:2306
msgctxt "text_id=5219 | speaker=unknown"
msgid "　わずか数秒の濃霧。"
msgstr ""

#. Occurrence 5A_8:2311:5220: scene=5A_8
#: 5A_8:2311
msgctxt "text_id=5220 | speaker=unknown"
msgid "　その隙をついて、"
msgstr ""

#. Occurrence 5A_8:2356:5221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0008; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2356
msgctxt "text_id=5221 | speaker=aoko"
msgid "“―――来い！”"
msgstr ""

#. Occurrence 5A_8:2362:5222: scene=5A_8
#: 5A_8:2362
msgctxt "text_id=5222 | speaker=unknown"
msgid "　伸縮する槍が、青子の顔へ撃ちだされる！"
msgstr ""

#. Occurrence 5A_8:2515:5223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0009; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2515
msgctxt "text_id=5223 | speaker=aoko"
msgid "「っ、ビンゴ―――！」"
msgstr ""

#. Occurrence 5A_8:2557:5224: scene=5A_8
#: 5A_8:2557
msgctxt "text_id=5224 | speaker=unknown"
msgid "　横顔をかすめる凶器。"
msgstr ""

#. Occurrence 5A_8:2562:5225: scene=5A_8
#: 5A_8:2562
msgctxt "text_id=5225 | speaker=unknown"
msgid "　死角からの攻撃を紙一重で<躱|かわ>せたのは、人形の攻撃パターンを既に経験していたからだ。"
msgstr ""

#. Occurrence 5A_8:2613:5226: scene=5A_8
#: 5A_8:2613
msgctxt "text_id=5226 | speaker=unknown"
msgid "　術者が操っているのならともかく、自律している自動人形の機能は限られている。"
msgstr ""

#. Occurrence 5A_8:2618:5227: scene=5A_8
#: 5A_8:2618
msgctxt "text_id=5227 | speaker=unknown"
msgid "　この距離ならこの攻撃、といったテンプレートを行うだけの殺戮機巧なら対応できると、青子は己の運に賭けたのだ。"
msgstr ""

#. Occurrence 5A_8:2742:5228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0010; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2742
msgctxt "text_id=5228 | speaker=aoko"
msgid "“いける、このまま―――！”"
msgstr ""

#. Occurrence 5A_8:2748:5229: scene=5A_8
#: 5A_8:2748
msgctxt "text_id=5229 | speaker=unknown"
msgid "　伸びきった腕が巻き戻る前に、人形へ突撃する。"
msgstr ""

#. Occurrence 5A_8:2753:5230: scene=5A_8
#: 5A_8:2753
msgctxt "text_id=5230 | speaker=unknown"
msgid "　勝算の薄い賭けではあったが、ともかく<勝機|しょうき>はもぎ取った。"
msgstr ""

#. Occurrence 5A_8:2758:5231: scene=5A_8
#: 5A_8:2758
msgctxt "text_id=5231 | speaker=unknown"
msgid "　勝利の天秤は青子に<傾|かたむ>いた。"
msgstr ""

#. Occurrence 5A_8:2866:5232: scene=5A_8
#: 5A_8:2866
msgctxt "text_id=5232 | speaker=unknown"
msgid "　予測による十回中二回の死は、あの間合いでフィンの一撃を使われた場合と。"
msgstr ""

#. Occurrence 5A_8:3046:5233: scene=5A_8
#: 5A_8:3046
msgctxt "text_id=5233 | speaker=unknown"
msgid "　このように。"
msgstr ""

#. Occurrence 5A_8:3051:5234: scene=5A_8
#: 5A_8:3051
msgctxt "text_id=5234 | speaker=unknown"
msgid "　人形の攻撃パターンが、彼女の予想を大きく上まわった場合である。"
msgstr ""

#. Occurrence 5A_8:3072:5235: scene=5A_8
#: 5A_8:3072
msgctxt "text_id=5235 | speaker=unknown"
msgid "　一瞬の質量移動。"
msgstr ""

#. Occurrence 5A_8:3078:5236: scene=5A_8
#: 5A_8:3078
msgctxt "text_id=5236 | speaker=unknown"
msgid "あるいは<積載|せきさい>。"
msgstr ""

#. Occurrence 5A_8:3084:5237: scene=5A_8
#: 5A_8:3084
msgctxt "text_id=5237 | speaker=unknown"
msgid "　青子が人形の腕という槍を<躱|かわ>した直後、"
msgstr ""

#. Occurrence 5A_8:3089:5238: scene=5A_8
#: 5A_8:3089
msgctxt "text_id=5238 | speaker=unknown"
msgid "　正体不明の重量が、彼女の腹部に激突していた。"
msgstr ""

#. Occurrence 5A_8:3196:5239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0011; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3196
msgctxt "text_id=5239 | speaker=aoko"
msgid "「ご、ぶっ……！」"
msgstr ""

#. Occurrence 5A_8:3202:5240: scene=5A_8
#: 5A_8:3202
msgctxt "text_id=5240 | speaker=unknown"
msgid "　ロケットで撃ち出されたとしか思えない、肩口からの正面衝突。"
msgstr ""

#. Occurrence 5A_8:3207:5241: scene=5A_8
#: 5A_8:3207
msgctxt "text_id=5241 | speaker=unknown"
msgid "　しかし、その推進力は何処から出たものなのか。"
msgstr ""

#. Occurrence 5A_8:3212:5242: scene=5A_8
#: 5A_8:3212
msgctxt "text_id=5242 | speaker=unknown"
msgid "　自らを飛ばす機能なぞ、あの人形は持ち合わせていないというのに……！"
msgstr ""

#. Occurrence 5A_8:3260:5243: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0012; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3260
msgctxt "text_id=5243 | speaker=aoko"
msgid "“は―――、は―――！”"
msgstr ""

#. Occurrence 5A_8:3265:5244: scene=5A_8
#: 5A_8:3265
msgctxt "text_id=5244 | speaker=unknown"
msgid "　激痛で<薄|うす>れかける意識を<留|とど>めながら、青子は即座に攻撃の正体を看破した。"
msgstr ""

#. Occurrence 5A_8:3272:5245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0013; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3272
msgctxt "text_id=5245 | speaker=aoko"
msgid "“今の、<推進力|すいしんりょく>じゃなくて、<牽引力|けんいんりょく>……！”"
msgstr ""

#. Occurrence 5A_8:3278:5246: scene=5A_8
#: 5A_8:3278
msgctxt "text_id=5246 | speaker=unknown"
msgid "　そう。人形の腕は本体に戻るのではなく、壁に突き刺さったまま、本体を<引|・><き|・><寄|・><せ|・><た|・>のだ……！"
msgstr ""

#. Occurrence 5A_8:3307:5247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0014; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3307
msgctxt "text_id=5247 | speaker=aoko"
msgid "“そ、そんなのアリか―――！？”"
msgstr ""

#. Occurrence 5A_8:3313:5248: scene=5A_8
#: 5A_8:3313
msgctxt "text_id=5248 | speaker=unknown"
msgid "　青子は驚きを飲み下しながら、必死に体勢を立て直す。"
msgstr ""

#. Occurrence 5A_8:3392:5249: scene=5A_8
#: 5A_8:3392
msgctxt "text_id=5249 | speaker=unknown"
msgid "　腹部、<横隔膜|おうかくまく>を強打された。"
msgstr ""

#. Occurrence 5A_8:3399:5250: scene=5A_8
#: 5A_8:3399
msgctxt "text_id=5250 | speaker=unknown"
msgid "衝撃で目も<眩|くら>んでいる。"
msgstr ""

#. Occurrence 5A_8:3406:5251: scene=5A_8
#: 5A_8:3406
msgctxt "text_id=5251 | speaker=unknown"
msgid "だが人形は驚くほど軽い。"
msgstr ""

#. Occurrence 5A_8:3413:5252: scene=5A_8
#: 5A_8:3413
msgctxt "text_id=5252 | speaker=unknown"
msgid "おかげで骨にも内臓にも深刻なダメージはないが、とにかく呼吸ができない。"
msgstr ""

#. Occurrence 5A_8:3420:5253: scene=5A_8
#: 5A_8:3420
msgctxt "text_id=5253 | speaker=unknown"
msgid "気は動転しているけど根っこの部分ではまだ冷静だ、あと二秒もあれば持ち直す。いや違う、マトモになるまであと二秒もかかってしまう！"
msgstr ""

#. Occurrence 5A_8:3440:5254: scene=5A_8
#: 5A_8:3440
msgctxt "text_id=5254 | speaker=unknown"
msgid "　いやいや落ち着け、もう落ち着いている、クラクラして位置関係が把握できないだけ、いい、今は呼吸も視力も後回しで、とにかく体を―――"
msgstr ""

#. Occurrence 5A_8:3462:5255: voice_id=C40_5A_8_0002_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3462
msgctxt "text_id=5255 | speaker=unknown"
msgid "“<知性は不必要でした|インテルレクトゥス・ノン・ネケススァリウス・エストゥ>。<敬虔さは重荷でした|ピウス・クウィエスカトゥ>。<ああ、私たち|オ・ノストゥラ><の本質は奪い合いで|エススェンティア・アブラタ・フイトゥ>、<理性は全て後付けでした|ラティオ・フィクサァ・タントゥム・エストゥ>。<苦しみのも|ドロリス・イニティウム><とは、脳髄でした|ケレブルム・フイトゥ>”"
msgstr ""

#. Occurrence 5A_8:3468:5256: scene=5A_8
#: 5A_8:3468
msgctxt "text_id=5256 | speaker=unknown"
msgid "　頭上には<歪|ゆが>みをあげる駆動音。"
msgstr ""

#. Occurrence 5A_8:3475:5257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0015; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3475
msgctxt "text_id=5257 | speaker=aoko"
msgid "“足、動け……！　でもどっち、どっちにいけば―――”"
msgstr ""

#. Occurrence 5A_8:3560:5258: scene=5A_8
#: 5A_8:3560
msgctxt "text_id=5258 | speaker=unknown"
msgid "　死の手触りがする。"
msgstr ""

#. Occurrence 5A_8:3567:5259: voice_id=C40_5A_8_0003_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3567
msgctxt "text_id=5259 | speaker=unknown"
msgid "“<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。”"
msgstr ""

#. Occurrence 5A_8:3573:5260: scene=5A_8
#: 5A_8:3573
msgctxt "text_id=5260 | speaker=unknown"
msgid "　手を伸ばせば届く距離、"
msgstr ""

#. Occurrence 5A_8:3578:5261: scene=5A_8
#: 5A_8:3578
msgctxt "text_id=5261 | speaker=unknown"
msgid "　手を下ろされば殺される距離にお互いがいて、"
msgstr ""

#. Occurrence 5A_8:3585:5262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0016; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3585
msgctxt "text_id=5262 | speaker=aoko"
msgid "“―――コイツの、右腕の死角に入れる……！”"
msgstr ""

#. Occurrence 5A_8:3669:5263: scene=5A_8
#: 5A_8:3669
msgctxt "text_id=5263 | speaker=unknown"
msgid "　青子は<勘|カン>だけで人形の右側に転がりでた。"
msgstr ""

#. Occurrence 5A_8:3674:5264: scene=5A_8
#: 5A_8:3674
msgctxt "text_id=5264 | speaker=unknown"
msgid "　人形の右腕は壁に刺さったままだ。"
msgstr ""

#. Occurrence 5A_8:3679:5265: scene=5A_8
#: 5A_8:3679
msgctxt "text_id=5265 | speaker=unknown"
msgid "　必然、そちらからの攻撃はない。判断は正しく、一時的な<目眩|めまい>も消えた。"
msgstr ""

#. Occurrence 5A_8:3733:5266: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5266 | speaker=unknown"
msgid "　“<Intellectus non necessarius est. Pius quiescat|正しさは脱ぎ捨てなさい。敬虔はお休みなさい。>."
msgstr ""

#. Occurrence 5A_8:3733:5267: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5267 | speaker=unknown"
msgid "　　　　　　<O nostra essentia ablata fuit|私たちは食み合う獣、その生はすべて装飾。>,"
msgstr ""

#. Occurrence 5A_8:3733:5268: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5268 | speaker=unknown"
msgid "<　ratio fixa tantum est. Doloris initium cerebrum fuit|であれ知性のすべてをブチまけて―――>”"
msgstr ""

#. Occurrence 5A_8:3753:5269: scene=5A_8
#: 5A_8:3753
msgctxt "text_id=5269 | speaker=unknown"
msgid "　転がる体を立て直し、今度はこちらの番と顔を上げる青子。"
msgstr ""

#. Occurrence 5A_8:3773:5270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0017; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3773
msgctxt "text_id=5270 | speaker=aoko"
msgid "“え―――？”"
msgstr ""

#. Occurrence 5A_8:3812:5271: scene=5A_8
#: 5A_8:3812
msgctxt "text_id=5271 | speaker=unknown"
msgid "　瞬間。"
msgstr ""

#. Occurrence 5A_8:3818:5272: scene=5A_8
#: 5A_8:3818
msgctxt "text_id=5272 | speaker=unknown"
msgid "鏡の迷路の中で、彼女は、自分と同じ<像|すがた>を見た。"
msgstr ""

#. Occurrence 5A_8:3860:5273: voice_id=C40_5A_8_0005_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3860
msgctxt "text_id=5273 | speaker=unknown"
msgid "　　　　　　　"
msgstr ""

msgctxt "text_id=5274 | speaker=unknown"
msgid "“「ワレ<ラ、死セリ|Iis salvatio>―――」”"
msgstr ""

#. Occurrence 5A_8:4170:5275: scene=5A_8
#: 5A_8:4170
msgctxt "text_id=5275 | speaker=unknown"
msgid "　ひときわ鮮烈な光。"
msgstr ""

#. Occurrence 5A_8:4175:5276: scene=5A_8
#: 5A_8:4175
msgctxt "text_id=5276 | speaker=unknown"
msgid "　壁に刻まれていく爪痕じみた裂傷。"
msgstr ""

#. Occurrence 5A_8:4180:5277: scene=5A_8
#: 5A_8:4180
msgctxt "text_id=5277 | speaker=unknown"
msgid "　人形の切札だろう一撃を、青子は体内を走る<血液|まりょく>の濃度をあげる原始的な対魔術で、かろうじて致死手前で踏みとどまった。"
msgstr ""

#. Occurrence 5A_8:4274:5278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0018; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4274
msgctxt "text_id=5278 | speaker=aoko"
msgid "「っ、こ、の…………！」"
msgstr ""

#. Occurrence 5A_8:4280:5279: scene=5A_8
#: 5A_8:4280
msgctxt "text_id=5279 | speaker=unknown"
msgid "　自分そっくりの人形。"
msgstr ""

#. Occurrence 5A_8:4285:5280: scene=5A_8
#: 5A_8:4285
msgctxt "text_id=5280 | speaker=unknown"
msgid "　心臓を止めるだけではあきたらず、物質さえ<損傷|しめつ>させる強力な呪詛。"
msgstr ""

#. Occurrence 5A_8:4290:5281: scene=5A_8
#: 5A_8:4290
msgctxt "text_id=5281 | speaker=unknown"
msgid "　どちらも目を見張る異常さだが、<呆|ほう>けている暇はない。"
msgstr ""

#. Occurrence 5A_8:4368:5282: scene=5A_8
#: 5A_8:4368
msgctxt "text_id=5282 | speaker=unknown"
msgid "　今度こそ反撃のチャンス。"
msgstr ""

#. Occurrence 5A_8:4373:5283: scene=5A_8
#: 5A_8:4373
msgctxt "text_id=5283 | speaker=unknown"
msgid "　右腕を壁に突き刺したままの人形はバランスが悪い。"
msgstr ""

#. Occurrence 5A_8:4413:5284: scene=5A_8
#: 5A_8:4413
msgctxt "text_id=5284 | speaker=unknown"
msgid "　その無防備な体を蹴り上げようとして、しかし、青子は膝から床に倒れこんだ。"
msgstr ""

#. Occurrence 5A_8:4438:5285: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5285 | speaker=unknown"
msgid "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr ""

#. Occurrence 5A_8:4438:5286: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5286 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr ""

#. Occurrence 5A_8:4507:5287: scene=5A_8
#: 5A_8:4507
msgctxt "text_id=5287 | speaker=unknown"
msgid "　急激な吐き気と貧血。"
msgstr ""

#. Occurrence 5A_8:4512:5288: scene=5A_8
#: 5A_8:4512
msgctxt "text_id=5288 | speaker=unknown"
msgid "　嘘のように低下していく体温。"
msgstr ""

#. Occurrence 5A_8:4518:5289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0019; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4518
msgctxt "text_id=5289 | speaker=aoko"
msgid "“しまっ……こいつ、呪いをばらまいてるんだった……！”"
msgstr ""

#. Occurrence 5A_8:4523:5290: scene=5A_8
#: 5A_8:4523
msgctxt "text_id=5290 | speaker=unknown"
msgid "　気付いた時には遅かった。"
msgstr ""

#. Occurrence 5A_8:4528:5291: scene=5A_8
#: 5A_8:4528
msgctxt "text_id=5291 | speaker=unknown"
msgid "　人形の周囲には呪詛が渦巻いている。"
msgstr ""

#. Occurrence 5A_8:4533:5292: scene=5A_8
#: 5A_8:4533
msgctxt "text_id=5292 | speaker=unknown"
msgid "　人形の動力源である呪いの詩は、近寄る者に病をもたらす防衛機巧にもなっている。"
msgstr ""

#. Occurrence 5A_8:4569:5293: scene=5A_8
#: 5A_8:4569
msgctxt "text_id=5293 | speaker=unknown"
msgid "　それをこんな間近で受け続けた。"
msgstr ""

#. Occurrence 5A_8:4574:5294: scene=5A_8
#: 5A_8:4574
msgctxt "text_id=5294 | speaker=unknown"
msgid "　魔術回路を持つ青子といえど、草十郎のように体調を崩してしまう。"
msgstr ""

#. Occurrence 5A_8:4579:5295: scene=5A_8
#: 5A_8:4579
msgctxt "text_id=5295 | speaker=unknown"
msgid "　<気怠|けだる>く、倒れこみそうな体に鞭を打って、青子は人形から跳び退いた。"
msgstr ""

#. Occurrence 5A_8:4627:5296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0020; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4627
msgctxt "text_id=5296 | speaker=aoko"
msgid "「っ、負けるかぁ……！」"
msgstr ""

#. Occurrence 5A_8:4633:5297: scene=5A_8
#: 5A_8:4633
msgctxt "text_id=5297 | speaker=unknown"
msgid "　気合いで呪詛の気怠さから逃れる。"
msgstr ""

#. Occurrence 5A_8:4710:5298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0021; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4710
msgctxt "text_id=5298 | speaker=aoko"
msgid "「――――――、ぁ」"
msgstr ""

#. Occurrence 5A_8:4716:5299: scene=5A_8
#: 5A_8:4716
msgctxt "text_id=5299 | speaker=unknown"
msgid "　だが。呪いによる貧血ではなく、自らの窮地にざあ、と青子の血圧が低下する。"
msgstr ""

#. Occurrence 5A_8:4721:5300: scene=5A_8
#: 5A_8:4721
msgctxt "text_id=5300 | speaker=unknown"
msgid "　絶好の位置関係。"
msgstr ""

#. Occurrence 5A_8:4726:5301: scene=5A_8
#: 5A_8:4726
msgctxt "text_id=5301 | speaker=unknown"
msgid "　跳び退いた青子の前には、左腕を矢のように差し出す、自分と同じ顔をした自動人形。"
msgstr ""

#. Occurrence 5A_8:4819:5302: scene=5A_8
#: 5A_8:4819
msgctxt "text_id=5302 | speaker=unknown"
msgid "　……凶器は寸分違わず、青子の心臓へと撃ちだされた。"
msgstr ""

#. Occurrence 5A_8:4893:5303: scene=5A_8
#: 5A_8:4893
msgctxt "text_id=5303 | speaker=unknown"
msgid "　ただ、そのちょっと前。"
msgstr ""

#. Occurrence 5A_8:4900:5304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_8_0000; voice_prefix=A30; voice_category=3; scene=5A_8
#: 5A_8:4900
msgctxt "text_id=5304 | speaker=soujuurou"
msgid "「危ない」"
msgstr ""

#. Occurrence 5A_8:4977:5305: scene=5A_8
#: 5A_8:4977
msgctxt "text_id=5305 | speaker=unknown"
msgid "　なんて、まったく危機感のない声がしたかと思うと、青子の体はぐいっと横に引っ張られていた。"
msgstr ""

#. Occurrence 5A_8:5030:5306: scene=5A_8
#: 5A_8:5030
msgctxt "text_id=5306 | speaker=unknown"
msgid "　伸びる腕はまたも<虚空|こくう>を<掠|かす>めていく。"
msgstr ""

#. Occurrence 5A_8:5036:5307: scene=5A_8
#: 5A_8:5036
msgctxt "text_id=5307 | speaker=unknown"
msgid "　人形は急いで腕を巻き戻すが、彼はその隙にと青子の手を取って、一目散に走りだしていた。"
msgstr ""

#. Occurrence 5A_9:55:5308: scene=5A_9
#: 5A_9:55
msgctxt "text_id=5308 | speaker=unknown"
msgid "　デタラメに通路を走り、人形から十分離れたところで、草十郎は足を止めてきりだした。"
msgstr ""

#. Occurrence 5A_9:111:5309: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0000; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:111
msgctxt "text_id=5309 | speaker=soujuurou"
msgid "「その、考えてみると」"
msgstr ""

#. Occurrence 5A_9:147:5310: scene=5A_9
#: 5A_9:147
msgctxt "text_id=5310 | speaker=unknown"
msgid "　助けたはずの相手はこの通り、目に見えてご立腹だ。"
msgstr ""

#. Occurrence 5A_9:153:5311: scene=5A_9
#: 5A_9:153
msgctxt "text_id=5311 | speaker=unknown"
msgid "それでも彼は彼なりに考え抜いた、気の利いた<台詞|いいわけ>を口にする。"
msgstr ""

#. Occurrence 5A_9:184:5312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0001; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:184
msgctxt "text_id=5312 | speaker=soujuurou"
msgid "「明日は、どうも忙しいみたいなんだ」"
msgstr ""

#. Occurrence 5A_9:190:5313: scene=5A_9
#: 5A_9:190
msgctxt "text_id=5313 | speaker=unknown"
msgid "“だから、用件は今日中に済ませてしまわないか？”"
msgstr ""

#. Occurrence 5A_9:195:5314: scene=5A_9
#: 5A_9:195
msgctxt "text_id=5314 | speaker=unknown"
msgid "　なんて続きそうな、場違いな提案を。"
msgstr ""

#. Occurrence 5A_9:237:5315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0000; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:237
msgctxt "text_id=5315 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_9:242:5316: scene=5A_9
#: 5A_9:242
msgctxt "text_id=5316 | speaker=unknown"
msgid "　青子は黙っている。"
msgstr ""

#. Occurrence 5A_9:247:5317: scene=5A_9
#: 5A_9:247
msgctxt "text_id=5317 | speaker=unknown"
msgid "　ついでにかなり怒ってもいた。"
msgstr ""

#. Occurrence 5A_9:252:5318: scene=5A_9
#: 5A_9:252
msgctxt "text_id=5318 | speaker=unknown"
msgid "　この男の精神構造が理解できないから、ではない。"
msgstr ""

#. Occurrence 5A_9:257:5319: scene=5A_9
#: 5A_9:257
msgctxt "text_id=5319 | speaker=unknown"
msgid "　せっかく逃がしてやったのに戻ってきた事でもない。"
msgstr ""

#. Occurrence 5A_9:262:5320: scene=5A_9
#: 5A_9:262
msgctxt "text_id=5320 | speaker=unknown"
msgid "　相変わらずの<間|ま><抜|ぬ>けな台詞に苛ついたからでもない。"
msgstr ""

#. Occurrence 5A_9:322:5321: scene=5A_9
#: 5A_9:322
msgctxt "text_id=5321 | speaker=unknown"
msgid "　……なんというか、あの一瞬。"
msgstr ""

#. Occurrence 5A_9:327:5322: scene=5A_9
#: 5A_9:327
msgctxt "text_id=5322 | speaker=unknown"
msgid "　手を引かれた時、何も考えられなくなって<為|な>すがままになった事が、青子的に許せないらしい。"
msgstr ""

#. Occurrence 5A_9:382:5323: scene=5A_9
#: 5A_9:382
msgctxt "text_id=5323 | speaker=unknown"
msgid "　なので、"
msgstr ""

#. Occurrence 5A_9:393:5324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0001; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:393
msgctxt "text_id=5324 | speaker=aoko"
msgid "「貴方、正気？」"
msgstr ""

#. Occurrence 5A_9:399:5325: scene=5A_9
#: 5A_9:399
msgctxt "text_id=5325 | speaker=unknown"
msgid "　勢いで、つい、そんな言葉を口にしていた。"
msgstr ""

#. Occurrence 5A_9:428:5326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0002; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:428
msgctxt "text_id=5326 | speaker=aoko"
msgid "「それとも自殺願望でもあったワケ？　私も<人形|アイツ>も、アンタなんか殺す対象にすぎないのよ。"
msgstr ""

#. Occurrence 5A_9:434:5327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0003; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:434
msgctxt "text_id=5327 | speaker=aoko"
msgid "　少なくとも恩を売る相手じゃない。"
msgstr ""

#. Occurrence 5A_9:445:5328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0004; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:445
msgctxt "text_id=5328 | speaker=aoko"
msgid "　言っとくけど、私、助けられたぐらいで曲がる信念は持ち合わせていないから」"
msgstr ""

#. Occurrence 5A_9:451:5329: scene=5A_9
#: 5A_9:451
msgctxt "text_id=5329 | speaker=unknown"
msgid "　だろうね、と頷く草十郎。"
msgstr ""

#. Occurrence 5A_9:492:5330: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0002; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:492
msgctxt "text_id=5330 | speaker=soujuurou"
msgid "「蒼崎がそんな可愛らしいもんじゃないのは、この夜だけで骨身にしみてるよ」"
msgstr ""

#. Occurrence 5A_9:525:5331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0005; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:525
msgctxt "text_id=5331 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_9:531:5332: scene=5A_9
#: 5A_9:531
msgctxt "text_id=5332 | speaker=unknown"
msgid "　それはそれでちょっと不満な青子だった。"
msgstr ""

#. Occurrence 5A_9:583:5333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0003; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:583
msgctxt "text_id=5333 | speaker=soujuurou"
msgid "「けど君は勘違いをしてるから、少し正そう。"
msgstr ""

#. Occurrence 5A_9:589:5334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0004; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:589
msgctxt "text_id=5334 | speaker=soujuurou"
msgid "　あいつの狙いは蒼崎だけじゃない。君だけじゃなく、俺も殺す気だと思う」"
msgstr ""

#. Occurrence 5A_9:627:5335: scene=5A_9
#: 5A_9:627
msgctxt "text_id=5335 | speaker=unknown"
msgid "　それは嘘だ、と。"
msgstr ""

#. Occurrence 5A_9:632:5336: scene=5A_9
#: 5A_9:632
msgctxt "text_id=5336 | speaker=unknown"
msgid "　視線をいっそう鋭くして、青子は草十郎を睨んだ。"
msgstr ""

#. Occurrence 5A_9:676:5337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0005; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:676
msgctxt "text_id=5337 | speaker=soujuurou"
msgid "「話は最後まで聞く。……どうしてかって言うと、一階の入り口あるだろ？　あの細長い通路。"
msgstr ""

#. Occurrence 5A_9:691:5338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0006; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:691
msgctxt "text_id=5338 | speaker=soujuurou"
msgid "　なんでかあそこから先に進めないんだ。逃げたくても逃げだせなくて、仕方なく戻ってきた」"
msgstr ""

#. Occurrence 5A_9:727:5339: scene=5A_9
#: 5A_9:727
msgctxt "text_id=5339 | speaker=unknown"
msgid "　青子はわずかに目を見張った。"
msgstr ""

#. Occurrence 5A_9:732:5340: scene=5A_9
#: 5A_9:732
msgctxt "text_id=5340 | speaker=unknown"
msgid "　あり得ない、と驚いたのではなく、そこまでしていたか、という敵への称賛だ。"
msgstr ""

#. Occurrence 5A_9:788:5341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0007; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:788
msgctxt "text_id=5341 | speaker=soujuurou"
msgid "「それに、さっきので完全に敵扱いされた。あの人形、こっちをじろっと<睨|にら>んできたし。"
msgstr ""

#. Occurrence 5A_9:808:5342: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0008; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:808
msgctxt "text_id=5342 | speaker=soujuurou"
msgid "　……いや、一瞬でよく見えなかったけど、生きた心地しなかったな。蒼崎も気をつけた方がいい。たぶん、よっぽど怖い顔をしているに違いないぞ、<彼|ア><女|レ>」"
msgstr ""

#. Occurrence 5A_9:878:5343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0006; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:878
msgctxt "text_id=5343 | speaker=aoko"
msgid "「―――それはご親切に、どうも」"
msgstr ""

#. Occurrence 5A_9:906:5344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0009; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:906
msgctxt "text_id=5344 | speaker=soujuurou"
msgid "「うん。なんで、これはもう他人事じゃないんだ。"
msgstr ""

#. Occurrence 5A_9:912:5345: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0010; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:912
msgctxt "text_id=5345 | speaker=soujuurou"
msgid "　蒼崎と人形。結論として、どっちが勝っても俺は殺されてしまうんじゃないか？」"
msgstr ""

#. Occurrence 5A_9:932:5346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0007; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:932
msgctxt "text_id=5346 | speaker=aoko"
msgid "「……そうね。そこまでやってるなら、目撃者は消すでしょうね。私みたいに」"
msgstr ""

#. Occurrence 5A_9:975:5347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0011; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:975
msgctxt "text_id=5347 | speaker=soujuurou"
msgid "「だろう。でも、俺はあいつには殺されたくない」"
msgstr ""

#. Occurrence 5A_9:981:5348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0008; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:981
msgctxt "text_id=5348 | speaker=aoko"
msgid "「え？」"
msgstr ""

#. Occurrence 5A_9:1017:5349: scene=5A_9
#: 5A_9:1017
msgctxt "text_id=5349 | speaker=unknown"
msgid "　きっぱりと彼は断言した。"
msgstr ""

#. Occurrence 5A_9:1022:5350: scene=5A_9
#: 5A_9:1022
msgctxt "text_id=5350 | speaker=unknown"
msgid "　まるで励ますような草十郎の言葉に、顔を上げる青子。"
msgstr ""

#. Occurrence 5A_9:1028:5351: scene=5A_9
#: 5A_9:1028
msgctxt "text_id=5351 | speaker=unknown"
msgid "　……そうして、ようやく気づいた。"
msgstr ""

#. Occurrence 5A_9:1066:5352: scene=5A_9
#: 5A_9:1066
msgctxt "text_id=5352 | speaker=unknown"
msgid "　草十郎の顔色の悪さが、さっきより濃くなっている事に。"
msgstr ""

#. Occurrence 5A_9:1096:5353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0009; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1096
msgctxt "text_id=5353 | speaker=aoko"
msgid "「ちょっと待って。大丈夫なの、貴方？」"
msgstr ""

#. Occurrence 5A_9:1111:5354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0012; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1111
msgctxt "text_id=5354 | speaker=soujuurou"
msgid "「……まあ、醤油を<一升瓶|いっしょうびん>飲むよりは、ましではないかと」"
msgstr ""

#. Occurrence 5A_9:1117:5355: scene=5A_9
#: 5A_9:1117
msgctxt "text_id=5355 | speaker=unknown"
msgid "　彼なりに場を<和|なご>ませようとした軽口だが、額に脂汗を浮かべられては余計に重い。"
msgstr ""

#. Occurrence 5A_9:1171:5356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0010; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1171
msgctxt "text_id=5356 | speaker=aoko"
msgid "“……そうか、さっき人形に近付いたから……”"
msgstr ""

#. Occurrence 5A_9:1177:5357: scene=5A_9
#: 5A_9:1177
msgctxt "text_id=5357 | speaker=unknown"
msgid "　青子ですら吐き気に襲われる呪いの圏内に入って、草十郎が平気である筈がない。"
msgstr ""

#. Occurrence 5A_9:1189:5358: scene=5A_9
#: 5A_9:1189
msgctxt "text_id=5358 | speaker=unknown"
msgid "　……自分の洞察力の低さに唇を噛む。"
msgstr ""

#. Occurrence 5A_9:1194:5359: scene=5A_9
#: 5A_9:1194
msgctxt "text_id=5359 | speaker=unknown"
msgid "　あんまりに彼がぼんやりしているから、そこに考えがいたらなかった。"
msgstr ""

#. Occurrence 5A_9:1267:5360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5360 | speaker=aoko"
msgid "「……下で隠れていようとか思わなかったの？"
msgstr ""

#. Occurrence 5A_9:1267:5361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5361 | speaker=aoko"
msgid "　その方がどう考えても安全でしょ？」"
msgstr ""

#. Occurrence 5A_9:1272:5362: scene=5A_9
#: 5A_9:1272
msgctxt "text_id=5362 | speaker=unknown"
msgid "　ほんとうに分からない、と青子。"
msgstr ""

#. Occurrence 5A_9:1287:5363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0013; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1287
msgctxt "text_id=5363 | speaker=soujuurou"
msgid "「それは蒼崎が言う台詞じゃないな。"
msgstr ""

#. Occurrence 5A_9:1337:5364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0014; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1337
msgctxt "text_id=5364 | speaker=soujuurou"
msgid "　―――でもまあ、長話をしている時間もない。そろそろ追いついて来る頃だ」"
msgstr ""

#. Occurrence 5A_9:1357:5365: scene=5A_9
#: 5A_9:1357
msgctxt "text_id=5365 | speaker=unknown"
msgid "　通路に視線を向ける草十郎。"
msgstr ""

#. Occurrence 5A_9:1362:5366: scene=5A_9
#: 5A_9:1362
msgctxt "text_id=5366 | speaker=unknown"
msgid "　……鏡張りの闇からは、ざらついたオルゴールが聞こえだしていた。"
msgstr ""

#. Occurrence 5A_9:1394:5367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0015; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1394
msgctxt "text_id=5367 | speaker=soujuurou"
msgid "「さっき一階にいて考えたんだ。君がやられても俺は殺される。なら、まずヤツをどうにかするべきだ」"
msgstr ""

#. Occurrence 5A_9:1429:5368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0012; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1429
msgctxt "text_id=5368 | speaker=aoko"
msgid "「…………………。"
msgstr ""

#. Occurrence 5A_9:1442:5369: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0013; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1442
msgctxt "text_id=5369 | speaker=aoko"
msgid "　貴方、なにが言いたいの？」"
msgstr ""

#. Occurrence 5A_9:1492:5370: scene=5A_9
#: 5A_9:1492
msgctxt "text_id=5370 | speaker=unknown"
msgid "　分かりきった事を、青子はあえて問いただした。"
msgstr ""

#. Occurrence 5A_9:1497:5371: scene=5A_9
#: 5A_9:1497
msgctxt "text_id=5371 | speaker=unknown"
msgid "　草十郎の決意の程を試すように。"
msgstr ""

#. Occurrence 5A_9:1502:5372: scene=5A_9
#: 5A_9:1502
msgctxt "text_id=5372 | speaker=unknown"
msgid "　その先を半端な気持ちで口にするのなら、やっぱり今ここで始末する、と見据えながら。"
msgstr ""

#. Occurrence 5A_9:1545:5373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0016; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1545
msgctxt "text_id=5373 | speaker=soujuurou"
msgid "「提案。アイツをやっつけるのに協力したら、俺の事は見逃してくれる？」"
msgstr ""

#. Occurrence 5A_9:1582:5374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0014; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1582
msgctxt "text_id=5374 | speaker=aoko"
msgid "「……助けられたぐらいじゃ信念は曲げないって言ったでしょう。"
msgstr ""

#. Occurrence 5A_9:1589:5375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0015; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1589
msgctxt "text_id=5375 | speaker=aoko"
msgid "それに、貴方に何が出来るって言うの？」"
msgstr ""

#. Occurrence 5A_9:1606:5376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0017; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1606
msgctxt "text_id=5376 | speaker=soujuurou"
msgid "「それは蒼崎が考えてくれ。得意だろ、そういうの」"
msgstr ""

#. Occurrence 5A_9:1655:5377: scene=5A_9
#: 5A_9:1655
msgctxt "text_id=5377 | speaker=unknown"
msgid "　協力者を適材適所にふりわけるのは指揮者の役割だ。"
msgstr ""

#. Occurrence 5A_9:1660:5378: scene=5A_9
#: 5A_9:1660
msgctxt "text_id=5378 | speaker=unknown"
msgid "　そもそもこの状況をまったく把握できず、また、自身と敵の差を理解できない人間に“何が出来るか”なんてコトを考えさせるのは間違っている、と草十郎は胸を張った。"
msgstr ""

#. Occurrence 5A_9:1687:5379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0016; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1687
msgctxt "text_id=5379 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5A_9:1692:5380: scene=5A_9
#: 5A_9:1692
msgctxt "text_id=5380 | speaker=unknown"
msgid "　彼の言う通り、草十郎を知り、自動人形を知っているのは蒼崎青子だけ。"
msgstr ""

#. Occurrence 5A_9:1697:5381: scene=5A_9
#: 5A_9:1697
msgctxt "text_id=5381 | speaker=unknown"
msgid "　なので、青子の指示を全力でこなす事が“いまの自分に出来る事”だと彼は言った。"
msgstr ""

#. Occurrence 5A_9:1702:5382: scene=5A_9
#: 5A_9:1702
msgctxt "text_id=5382 | speaker=unknown"
msgid "　思考放棄に近いが、それでも、草十郎の提案は自分が無力である事を受け入れた末の、最大限の信頼に他ならない。"
msgstr ""

#. Occurrence 5A_9:1737:5383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0017; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1737
msgctxt "text_id=5383 | speaker=aoko"
msgid "「……。じゃあ、私の指示に百パーセント従うってこと？」"
msgstr ""

#. Occurrence 5A_9:1750:5384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0018; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1750
msgctxt "text_id=5384 | speaker=soujuurou"
msgid "「ああ。それに、これは恩とか義理の話じゃない。"
msgstr ""

#. Occurrence 5A_9:1756:5385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0019; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1756
msgctxt "text_id=5385 | speaker=soujuurou"
msgid "　ひとりだと分が悪いからふたりでかかるだけだ。善意でも厚意でもない。取引って言わないか、こういうの？」"
msgstr ""

#. Occurrence 5A_9:1762:5386: scene=5A_9
#: 5A_9:1762
msgctxt "text_id=5386 | speaker=unknown"
msgid "　信条的な物々交換だ、純朴な<瞳|め>が語っている。"
msgstr ""

#. Occurrence 5A_9:1846:5387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0018; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1846
msgctxt "text_id=5387 | speaker=aoko"
msgid "「――――――まったく」"
msgstr ""

#. Occurrence 5A_9:1852:5388: scene=5A_9
#: 5A_9:1852
msgctxt "text_id=5388 | speaker=unknown"
msgid "　……この少年にそんな知恵をつけたのは鳶丸の阿呆に違いない。"
msgstr ""

#. Occurrence 5A_9:1857:5389: scene=5A_9
#: 5A_9:1857
msgctxt "text_id=5389 | speaker=unknown"
msgid "　決して口にはこぼさないが、青子は少しだけ笑いたくなった。"
msgstr ""

#. Occurrence 5A_9:1863:5390: scene=5A_9
#: 5A_9:1863
msgctxt "text_id=5390 | speaker=unknown"
msgid "完全に一本とられたけど、なんというか、悔しくない敗北なんてものが、世の中にはあるらしい。"
msgstr ""

#. Occurrence 5A_9:1890:5391: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0019; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1890
msgctxt "text_id=5391 | speaker=aoko"
msgid "「労働と報酬ってワケね。それなら理にかなってる。"
msgstr ""

#. Occurrence 5A_9:1896:5392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0020; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1896
msgctxt "text_id=5392 | speaker=aoko"
msgid "　うん、言いたくないけど―――」"
msgstr ""

#. Occurrence 5A_9:1929:5393: scene=5A_9
#: 5A_9:1929
msgctxt "text_id=5393 | speaker=unknown"
msgid "　少し間をおいて、やれやれ、と肩で息をする。"
msgstr ""

#. Occurrence 5A_9:1934:5394: scene=5A_9
#: 5A_9:1934
msgctxt "text_id=5394 | speaker=unknown"
msgid "　青子はふっきれたような、見ようによっては邪悪な笑みをうかべて、"
msgstr ""

#. Occurrence 5A_9:1969:5395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0021; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1969
msgctxt "text_id=5395 | speaker=aoko"
msgid "「―――それ、けっこう私の好みよ」"
msgstr ""

#. Occurrence 5A_9:1975:5396: scene=5A_9
#: 5A_9:1975
msgctxt "text_id=5396 | speaker=unknown"
msgid "　彼が向けたのと同程度の信頼を、まっすぐに投げ返した。"
msgstr ""

#. Occurrence 5B_1:78:5397: scene=5B_1
#: 5B_1:78
msgctxt "text_id=5397 | speaker=unknown"
msgid "　それは、彼らにとって<郷愁|きょうしゅう>に似た旋律だった。"
msgstr ""

#. Occurrence 5B_1:83:5398: scene=5B_1
#: 5B_1:83
msgctxt "text_id=5398 | speaker=unknown"
msgid "　かつてこの世界にありふれていたもの。"
msgstr ""

#. Occurrence 5B_1:88:5399: scene=5B_1
#: 5B_1:88
msgctxt "text_id=5399 | speaker=unknown"
msgid "　物言わぬ彼らのすべてが、永遠に続くと信じて疑わなかったもの。"
msgstr ""

#. Occurrence 5B_1:93:5400: scene=5B_1
#: 5B_1:93
msgctxt "text_id=5400 | speaker=unknown"
msgid "　始まりに一度、終わりに一度。"
msgstr ""

#. Occurrence 5B_1:98:5401: scene=5B_1
#: 5B_1:98
msgctxt "text_id=5401 | speaker=unknown"
msgid "　夢の開園と、現実への帰還を告げる、陽気で、どこか寂しくなる不思議な<音楽|サイレン>。"
msgstr ""

#. Occurrence 5B_1:187:5402: scene=5B_1
#: 5B_1:187
msgctxt "text_id=5402 | speaker=unknown"
msgid "　夜が<響|ひび>く。"
msgstr ""

#. Occurrence 5B_1:192:5403: scene=5B_1
#: 5B_1:192
msgctxt "text_id=5403 | speaker=unknown"
msgid "　唄を<紡|つむ>ぐ。"
msgstr ""

#. Occurrence 5B_1:197:5404: scene=5B_1
#: 5B_1:197
msgctxt "text_id=5404 | speaker=unknown"
msgid "　今は失われた彼らの楽園を掘り返す。"
msgstr ""

#. Occurrence 5B_1:202:5405: scene=5B_1
#: 5B_1:202
msgctxt "text_id=5405 | speaker=unknown"
msgid "　うち捨てられた多くの<夢路|ゆめじ>が、"
msgstr ""

#. Occurrence 5B_1:207:5406: scene=5B_1
#: 5B_1:207
msgctxt "text_id=5406 | speaker=unknown"
msgid "　見放されたかつての偶像が、"
msgstr ""

#. Occurrence 5B_1:212:5407: scene=5B_1
#: 5B_1:212
msgctxt "text_id=5407 | speaker=unknown"
msgid "　青猫の鳴き声に呼応する。"
msgstr ""

#. Occurrence 5B_1:236:5408: scene=5B_1
#: 5B_1:236
msgctxt "text_id=5408 | speaker=unknown"
msgid "　―――その鐘の名は“<夜の饗宴|ディドルディドル>”"
msgstr ""

#. Occurrence 5B_1:243:5409: scene=5B_1
#: 5B_1:243
msgctxt "text_id=5409 | speaker=unknown"
msgid "　あらゆる寓話、"
msgstr ""

msgctxt "text_id=5410 | speaker=unknown"
msgid "　あらゆる不思議を許容する、"
msgstr ""

msgctxt "text_id=5411 | speaker=unknown"
msgid "　魔法以上に魔法に近い、久遠寺有珠の魔術である。"
msgstr ""

#. Occurrence 5B_1:460:5412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0000; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:460
msgctxt "text_id=5412 | speaker=alice"
msgid "「……随分と身勝手ね。"
msgstr ""

#. Occurrence 5B_1:466:5413: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0001; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:466
msgctxt "text_id=5413 | speaker=alice"
msgid "　それは貴女ひとりで決めていい事だったかしら、青子？」"
msgstr ""

#. Occurrence 5B_1:472:5414: scene=5B_1
#: 5B_1:472
msgctxt "text_id=5414 | speaker=unknown"
msgid "　少女は黒い<凶鳥|まがどり>のように時計台の上に降り立った。"
msgstr ""

#. Occurrence 5B_1:477:5415: scene=5B_1
#: 5B_1:477
msgctxt "text_id=5415 | speaker=unknown"
msgid "　細い指は静かに、羽をつくろうように、<衣服|スカート>の乱れを直す。"
msgstr ""

#. Occurrence 5B_1:502:5416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0000; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:502
msgctxt "text_id=5416 | speaker=aoko"
msgid "「―――有珠」"
msgstr ""

#. Occurrence 5B_1:508:5417: scene=5B_1
#: 5B_1:508
msgctxt "text_id=5417 | speaker=unknown"
msgid "　見上げる青子の声には<微|かす>かな緊張。"
msgstr ""

#. Occurrence 5B_1:513:5418: scene=5B_1
#: 5B_1:513
msgctxt "text_id=5418 | speaker=unknown"
msgid "　……先ほどまでの穏やかな空気は、有珠の視線だけで霧散していた。"
msgstr ""

#. Occurrence 5B_1:547:5419: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0000; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:547
msgctxt "text_id=5419 | speaker=soujuurou"
msgid "“あの娘、たしか……”"
msgstr ""

#. Occurrence 5B_1:552:5420: scene=5B_1
#: 5B_1:552
msgctxt "text_id=5420 | speaker=unknown"
msgid "　草十郎は曖昧な記憶を辿る。"
msgstr ""

#. Occurrence 5B_1:563:5421: scene=5B_1
#: 5B_1:563
msgctxt "text_id=5421 | speaker=unknown"
msgid "　遠くて顔ははっきりしないが、何度か町で見かけたかもしれない。"
msgstr ""

#. Occurrence 5B_1:568:5422: scene=5B_1
#: 5B_1:568
msgctxt "text_id=5422 | speaker=unknown"
msgid "　それが何処だったかを思い出そうとするのだが、妙な緊張感が邪魔をして、どうにもはっきりしなかった。"
msgstr ""

#. Occurrence 5B_1:644:5423: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5423 | speaker=aoko"
msgid "「―――驚いた。ずいぶんと仲間思いになったのね有珠。"
msgstr ""

#. Occurrence 5B_1:644:5424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5424 | speaker=aoko"
msgid "　今夜は私に任せるんじゃなかったっけ？」"
msgstr ""

#. Occurrence 5B_1:665:5425: scene=5B_1
#: 5B_1:665
msgctxt "text_id=5425 | speaker=unknown"
msgid "　青子はわずかに身構え、半歩だけ前に出た。"
msgstr ""

#. Occurrence 5B_1:670:5426: scene=5B_1
#: 5B_1:670
msgctxt "text_id=5426 | speaker=unknown"
msgid "　無意識に。"
msgstr ""

#. Occurrence 5B_1:675:5427: scene=5B_1
#: 5B_1:675
msgctxt "text_id=5427 | speaker=unknown"
msgid "　第三者的に見れば、<傍|かたわ>らの人影をかばうように。"
msgstr ""

#. Occurrence 5B_1:726:5428: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0002; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:726
msgctxt "text_id=5428 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_1:732:5429: scene=5B_1
#: 5B_1:732
msgctxt "text_id=5429 | speaker=unknown"
msgid "　有珠の沈黙はますます重くなっていく。"
msgstr ""

#. Occurrence 5B_1:737:5430: scene=5B_1
#: 5B_1:737
msgctxt "text_id=5430 | speaker=unknown"
msgid "　地上を<睥睨|へいげい>する瞳は感情に<乏|とぼ>しい。"
msgstr ""

#. Occurrence 5B_1:742:5431: scene=5B_1
#: 5B_1:742
msgctxt "text_id=5431 | speaker=unknown"
msgid "　でありながら、言いようのない不安と重圧でこの広場を支配しつつある。"
msgstr ""

#. Occurrence 5B_1:813:5432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0001; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:813
msgctxt "text_id=5432 | speaker=soujuurou"
msgid "“……鐘……？”"
msgstr ""

#. Occurrence 5B_1:819:5433: scene=5B_1
#: 5B_1:819
msgctxt "text_id=5433 | speaker=unknown"
msgid "　耳を澄ますと、どこからか鐘の音が響いていた。"
msgstr ""

#. Occurrence 5B_1:824:5434: scene=5B_1
#: 5B_1:824
msgctxt "text_id=5434 | speaker=unknown"
msgid "　寄せ返すさざ波のような<鐘|おと>は、信じがたい事に地面の下から聴こえてくる。"
msgstr ""

#. Occurrence 5B_1:851:5435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0002; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:851
msgctxt "text_id=5435 | speaker=soujuurou"
msgid "「なあ蒼崎、あの<娘|こ>」"
msgstr ""

#. Occurrence 5B_1:862:5436: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0002; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:862
msgctxt "text_id=5436 | speaker=aoko"
msgid "「黙ってて」"
msgstr ""

#. Occurrence 5B_1:874:5437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0003; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:874
msgctxt "text_id=5437 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_1:880:5438: scene=5B_1
#: 5B_1:880
msgctxt "text_id=5438 | speaker=unknown"
msgid "　むう、と邪魔にならないよう引っこむ草十郎。"
msgstr ""

#. Occurrence 5B_1:885:5439: scene=5B_1
#: 5B_1:885
msgctxt "text_id=5439 | speaker=unknown"
msgid "　知り合い？　という質問に、"
msgstr ""

#. Occurrence 5B_1:890:5440: scene=5B_1
#: 5B_1:890
msgctxt "text_id=5440 | speaker=unknown"
msgid "　死にたい？　と返された感じ。"
msgstr ""

#. Occurrence 5B_1:931:5441: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0003; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:931
msgctxt "text_id=5441 | speaker=alice"
msgid "「……そうね。仲間思い、に当てはまるかは微妙だけど、良くない予感がしたから様子を見に来ただけ。"
msgstr ""

#. Occurrence 5B_1:937:5442: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0004; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:937
msgctxt "text_id=5442 | speaker=alice"
msgid "　別に、貴女の仕事を疑ったワケじゃないわ。」"
msgstr ""

#. Occurrence 5B_1:980:5443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0003; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:980
msgctxt "text_id=5443 | speaker=aoko"
msgid "「それはどうも。どうせならもう少し早く、その良くない予感とやらに気づいてほしかったけど。"
msgstr ""

#. Occurrence 5B_1:986:5444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0004; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:986
msgctxt "text_id=5444 | speaker=aoko"
msgid "　―――でもま、ごらんの通り自己解決したわ。"
msgstr ""

#. Occurrence 5B_1:999:5445: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0005; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:999
msgctxt "text_id=5445 | speaker=aoko"
msgid "　夜も遅いし、さっさと帰っていいわよ有珠。私の仕事っぷりを疑うワケじゃないんでしょう？」"
msgstr ""

#. Occurrence 5B_1:1038:5446: scene=5B_1
#: 5B_1:1038
msgctxt "text_id=5446 | speaker=unknown"
msgid "　両者の視線が交差する。"
msgstr ""

#. Occurrence 5B_1:1043:5447: scene=5B_1
#: 5B_1:1043
msgctxt "text_id=5447 | speaker=unknown"
msgid "　有珠はやや不快げに、冷たさをこめて。"
msgstr ""

#. Occurrence 5B_1:1048:5448: scene=5B_1
#: 5B_1:1048
msgctxt "text_id=5448 | speaker=unknown"
msgid "　青子は堂々と、文句があるなら言いやがれと挑発するように。"
msgstr ""

#. Occurrence 5B_1:1084:5449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0005; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1084
msgctxt "text_id=5449 | speaker=alice"
msgid "「……いえ、気が変わったわ。"
msgstr ""

#. Occurrence 5B_1:1090:5450: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0006; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1090
msgctxt "text_id=5450 | speaker=alice"
msgid "　せっかくだし<二|・><人|・><で|・><帰|・><り|・><ま|・><し|・><ょ|・><う|・>。その方が貴女らしいわ。帰りしな、人形の話でも聞かせてちょうだい」"
msgstr ""

#. Occurrence 5B_1:1096:5451: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0006; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1096
msgctxt "text_id=5451 | speaker=aoko"
msgid "「は。らしいってなによ、らしいって。"
msgstr ""

#. Occurrence 5B_1:1102:5452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0007; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1102
msgctxt "text_id=5452 | speaker=aoko"
msgid "　いいから帰れ帰れ、ぐうたら有珠。部屋に閉じこもって役に立たない<椋鳥|むくどり>でも作ってろっての」"
msgstr ""

#. Occurrence 5B_1:1161:5453: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0007; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1161
msgctxt "text_id=5453 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 5B_1:1166:5454: scene=5B_1
#: 5B_1:1166
msgctxt "text_id=5454 | speaker=unknown"
msgid "　可憐な唇が<落胆|らくたん>の息をこぼす。"
msgstr ""

#. Occurrence 5B_1:1171:5455: scene=5B_1
#: 5B_1:1171
msgctxt "text_id=5455 | speaker=unknown"
msgid "　黒衣の少女は怒るというより呆れたように、"
msgstr ""

#. Occurrence 5B_1:1186:5456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0008; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1186
msgctxt "text_id=5456 | speaker=alice"
msgid "「……青子。口にしたくないけど、本気？」"
msgstr ""

#. Occurrence 5B_1:1192:5457: scene=5B_1
#: 5B_1:1192
msgctxt "text_id=5457 | speaker=unknown"
msgid "　静かに。"
msgstr ""

#. Occurrence 5B_1:1197:5458: scene=5B_1
#: 5B_1:1197
msgctxt "text_id=5458 | speaker=unknown"
msgid "　二年近くともに暮らした同居人を問いただした。"
msgstr ""

#. Occurrence 5B_1:1245:5459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0008; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1245
msgctxt "text_id=5459 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_1:1267:5460: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0009; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1267
msgctxt "text_id=5460 | speaker=alice"
msgid "「……呆れた。二人で秘密を守ると言ったのに？"
msgstr ""

#. Occurrence 5B_1:1273:5461: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0010; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1273
msgctxt "text_id=5461 | speaker=alice"
msgid "　まだ半端にそっち側なの？　それとも情でも移った？」"
msgstr ""

#. Occurrence 5B_1:1316:5462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0009; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1316
msgctxt "text_id=5462 | speaker=aoko"
msgid "「別に。情っていうより私の気分よ。"
msgstr ""

#. Occurrence 5B_1:1328:5463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0010; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1328
msgctxt "text_id=5463 | speaker=aoko"
msgid "　だいたい、方針なんてその場その場で変わるもんでしょ。気分なら尚更よ。"
msgstr ""

#. Occurrence 5B_1:1335:5464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5464 | speaker=aoko"
msgid "そっちこそ、一度した約束は絶対守"
msgstr ""

#. Occurrence 5B_1:1335:5465: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5465 | speaker=aoko"
msgid "　るぅー、なんて、時代遅れなんじゃない？」"
msgstr ""

#. Occurrence 5B_1:1385:5466: scene=5B_1
#: 5B_1:1385
msgctxt "text_id=5466 | speaker=unknown"
msgid "　睨みあうふたり。"
msgstr ""

#. Occurrence 5B_1:1390:5467: scene=5B_1
#: 5B_1:1390
msgctxt "text_id=5467 | speaker=unknown"
msgid "　歩み寄る気なんて微塵もなし。"
msgstr ""

#. Occurrence 5B_1:1395:5468: scene=5B_1
#: 5B_1:1395
msgctxt "text_id=5468 | speaker=unknown"
msgid "　悲しい事だが、彼女たちの在り方はあくまで協力関係であって、相互理解の域には達していない。"
msgstr ""

#. Occurrence 5B_1:1400:5469: scene=5B_1
#: 5B_1:1400
msgctxt "text_id=5469 | speaker=unknown"
msgid "　なので、友情のカタチは微妙かつ特殊だった。互いの意見が衝突したら、どちらかが砕けるまで先には進まない。"
msgstr ""

#. Occurrence 5B_1:1405:5470: scene=5B_1
#: 5B_1:1405
msgctxt "text_id=5470 | speaker=unknown"
msgid "　<青子|それ>は<青子|それ>、<有珠|これ>は<有珠|これ>、と綺麗さっぱり切り捨てられるのが、今のところ、彼女たちが良しとする友情である。"
msgstr ""

#. Occurrence 5B_1:1436:5471: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0011; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1436
msgctxt "text_id=5471 | speaker=alice"
msgid "「……そうね。今の暴言は貴女らしいとは思うけど」"
msgstr ""

#. Occurrence 5B_1:1441:5472: scene=5B_1
#: 5B_1:1441
msgctxt "text_id=5472 | speaker=unknown"
msgid "　少女はもう一度、今度はさっきより大きなため息をついて、"
msgstr ""

#. Occurrence 5B_1:1453:5473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0012; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1453
msgctxt "text_id=5473 | speaker=alice"
msgid "「言い争いは後にしましょう。"
msgstr ""

#. Occurrence 5B_1:1459:5474: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0013; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1459
msgctxt "text_id=5474 | speaker=alice"
msgid "　そこの彼を<い|・><な|・><か|・><っ|・><た|・><事|・>にするのは、私だけで十分だし」"
msgstr ""

#. Occurrence 5B_1:1465:5475: scene=5B_1
#: 5B_1:1465
msgctxt "text_id=5475 | speaker=unknown"
msgid "　つい、と。"
msgstr ""

#. Occurrence 5B_1:1470:5476: scene=5B_1
#: 5B_1:1470
msgctxt "text_id=5476 | speaker=unknown"
msgid "　チェスの駒をさすような仕草で、細い指を動かした。"
msgstr ""

#. Occurrence 5B_1:1643:5477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0004; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:1643
msgctxt "text_id=5477 | speaker=soujuurou"
msgid "“うん？”"
msgstr ""

#. Occurrence 5B_1:1649:5478: scene=5B_1
#: 5B_1:1649
msgctxt "text_id=5478 | speaker=unknown"
msgid "　それは、蒼崎青子に命を狙われ、まがりなりにも自動人形を目撃した草十郎をして、目を見張る“不思議”だった。"
msgstr ""

#. Occurrence 5B_1:1654:5479: scene=5B_1
#: 5B_1:1654
msgctxt "text_id=5479 | speaker=unknown"
msgid "　……青子の暴挙、動く人形。"
msgstr ""

#. Occurrence 5B_1:1659:5480: scene=5B_1
#: 5B_1:1659
msgctxt "text_id=5480 | speaker=unknown"
msgid "　それらは常識外とは言え、<現|そ><実|こ>にあるものから派生した出来事だ。彼にとっては驚きこそすれ、不思議に思う事はない。"
msgstr ""

#. Occurrence 5B_1:1729:5481: scene=5B_1
#: 5B_1:1729
msgctxt "text_id=5481 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 5B_1:1734:5482: scene=5B_1
#: 5B_1:1734
msgctxt "text_id=5482 | speaker=unknown"
msgid "　何もない空間、何の関連もない動作から突如あらわれたソレは、彼にとっては不思議以外の何物でもなかった。"
msgstr ""

#. Occurrence 5B_1:1739:5483: scene=5B_1
#: 5B_1:1739
msgctxt "text_id=5483 | speaker=unknown"
msgid "　草十郎は手品に見惚れるよう、指一本動かせず少女の魔術に襲われる。"
msgstr ""

#. Occurrence 5B_1:1768:5484: scene=5B_1
#: 5B_1:1768
msgctxt "text_id=5484 | speaker=unknown"
msgid "　それを横から<弾|はじ>こう……として、<勢|いきお>い、<跡形|あとかた>もなく粉砕する青い光。"
msgstr ""

#. Occurrence 5B_1:1854:5485: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0012; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1854
msgctxt "text_id=5485 | speaker=aoko"
msgid "「あ、やば」"
msgstr ""

#. Occurrence 5B_1:1860:5486: scene=5B_1
#: 5B_1:1860
msgctxt "text_id=5486 | speaker=unknown"
msgid "　青子は脊髄反射で手をだしてしまい、しまった、と反省する。"
msgstr ""

#. Occurrence 5B_1:1934:5487: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0014; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1934
msgctxt "text_id=5487 | speaker=alice"
msgid "「…………どういう事？　<言葉|やくそく>を曲げただけじゃなく、ルールまで破るつもり？」"
msgstr ""

#. Occurrence 5B_1:1954:5488: scene=5B_1
#: 5B_1:1954
msgctxt "text_id=5488 | speaker=unknown"
msgid "　……ただでさえ冷えきっていた真冬の空気が、もう氷結レベルまで落ちこんでいく。"
msgstr ""

#. Occurrence 5B_1:1959:5489: scene=5B_1
#: 5B_1:1959
msgctxt "text_id=5489 | speaker=unknown"
msgid "　有珠はクールそうに見えて、その実、青子以上に激情家なところがあった。"
msgstr ""

#. Occurrence 5B_1:1979:5490: scene=5B_1
#: 5B_1:1979
msgctxt "text_id=5490 | speaker=unknown"
msgid "　その最たるものが、使い魔への扱いである。"
msgstr ""

#. Occurrence 5B_1:1984:5491: scene=5B_1
#: 5B_1:1984
msgctxt "text_id=5491 | speaker=unknown"
msgid "　悪意のないミスで壊してしまった場合は一週間程度の無言の抗議で済むが、"
msgstr ""

#. Occurrence 5B_1:1989:5492: scene=5B_1
#: 5B_1:1989
msgctxt "text_id=5492 | speaker=unknown"
msgid "　悪意をもって破壊したのなら、もうどんな言い訳があろうと報復するのが彼女の性格だった。"
msgstr ""

#. Occurrence 5B_1:2010:5493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0013; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2010
msgctxt "text_id=5493 | speaker=aoko"
msgid "“あっちゃあ……いつかやるとは思ったけど、ついに<逆鱗|げきりん>に触れちゃったか……”"
msgstr ""

#. Occurrence 5B_1:2016:5494: scene=5B_1
#: 5B_1:2016
msgctxt "text_id=5494 | speaker=unknown"
msgid "　あーあ、と。自分の馬鹿さ加減に呆れながらも、青子は<清々|すがすが>しさを感じていた。"
msgstr ""

#. Occurrence 5B_1:2021:5495: scene=5B_1
#: 5B_1:2021
msgctxt "text_id=5495 | speaker=unknown"
msgid "　言い訳をする気はないし、後悔もしていない。"
msgstr ""

#. Occurrence 5B_1:2026:5496: scene=5B_1
#: 5B_1:2026
msgctxt "text_id=5496 | speaker=unknown"
msgid "　ルールを破ったというのなら、それは有珠も同じである。"
msgstr ""

#. Occurrence 5B_1:2097:5497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0015; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2097
msgctxt "text_id=5497 | speaker=alice"
msgid "「青子」"
msgstr ""

#. Occurrence 5B_1:2119:5498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0014; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2119
msgctxt "text_id=5498 | speaker=aoko"
msgid "「ま、なんていうか―――」"
msgstr ""

#. Occurrence 5B_1:2131:5499: scene=5B_1
#: 5B_1:2131
msgctxt "text_id=5499 | speaker=unknown"
msgid "　逆にさっぱりしたぐらいだ。"
msgstr ""

#. Occurrence 5B_1:2136:5500: scene=5B_1
#: 5B_1:2136
msgctxt "text_id=5500 | speaker=unknown"
msgid "　だって、こうなった以上はもう色々仕方がない。"
msgstr ""

#. Occurrence 5B_1:2141:5501: scene=5B_1
#: 5B_1:2141
msgctxt "text_id=5501 | speaker=unknown"
msgid "　青子には自分のルールを破る気なんて毛頭なく、"
msgstr ""

#. Occurrence 5B_1:2183:5502: scene=5B_1
#: 5B_1:2183
msgctxt "text_id=5502 | speaker=unknown"
msgid "　反省する事があるといったら、それは力加減を間違えた事だけで、"
msgstr ""

#. Occurrence 5B_1:2190:5503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0015; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2190
msgctxt "text_id=5503 | speaker=aoko"
msgid "「<私|わたし>的に、今夜コイツに死なれるのは困るのよ。"
msgstr ""

#. Occurrence 5B_1:2196:5504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0016; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2196
msgctxt "text_id=5504 | speaker=aoko"
msgid "　なんで、日を改めて殺しに来てくれない有珠？　いいでしょ、たった一日ぐらい」"
msgstr ""

#. Occurrence 5B_1:2202:5505: scene=5B_1
#: 5B_1:2202
msgctxt "text_id=5505 | speaker=unknown"
msgid "　とっさに容疑者Ｓをかばったのは、彼女にとって当然の正義だった。"
msgstr ""

#. Occurrence 5B_1:2255:5506: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0016; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2255
msgctxt "text_id=5506 | speaker=alice"
msgid "「それは私情？」"
msgstr ""

#. Occurrence 5B_1:2264:5507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0017; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2264
msgctxt "text_id=5507 | speaker=aoko"
msgid "「悪い？　一宿一飯の恩義ってわりと大事にしてるの、私」"
msgstr ""

#. Occurrence 5B_1:2273:5508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0017; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2273
msgctxt "text_id=5508 | speaker=alice"
msgid "「わたしとの協定より？」"
msgstr ""

#. Occurrence 5B_1:2282:5509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0018; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2282
msgctxt "text_id=5509 | speaker=aoko"
msgid "「ええ。時と場合によっては」"
msgstr ""

#. Occurrence 5B_1:2338:5510: scene=5B_1
#: 5B_1:2338
msgctxt "text_id=5510 | speaker=unknown"
msgid "　この場にいる<草十郎|さんにんめ>の人権もなんのその。"
msgstr ""

#. Occurrence 5B_1:2349:5511: scene=5B_1
#: 5B_1:2349
msgctxt "text_id=5511 | speaker=unknown"
msgid "　少女たちは互いに油をかけあっていく。"
msgstr ""

#. Occurrence 5B_1:2370:5512: scene=5B_1
#: 5B_1:2370
msgctxt "text_id=5512 | speaker=unknown"
msgid "　感情の切り替え―――いや、感情に火をつけるのは、黒衣の少女の方が先だった。"
msgstr ""

#. Occurrence 5B_1:2403:5513: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0018; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2403
msgctxt "text_id=5513 | speaker=alice"
msgid "「―――そう。よく分かったわ青子。"
msgstr ""

#. Occurrence 5B_1:2433:5514: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0019; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2433
msgctxt "text_id=5514 | speaker=alice"
msgid "　わたしは彼をここで殺す。"
msgstr ""

#. Occurrence 5B_1:2478:5515: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0020; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2478
msgctxt "text_id=5515 | speaker=alice"
msgid "　貴女は彼をここだけ生かす。"
msgstr ""

#. Occurrence 5B_1:2502:5516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0021; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2502
msgctxt "text_id=5516 | speaker=alice"
msgid "　……つまり。<わ|・><た|・><し|・><と|・><戦|・><う|・>、という事でいい？」"
msgstr ""

#. Occurrence 5B_1:2546:5517: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0019; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2546
msgctxt "text_id=5517 | speaker=aoko"
msgid "“……ふん。そんなの、いいワケないじゃない”"
msgstr ""

#. Occurrence 5B_1:2555:5518: scene=5B_1
#: 5B_1:2555
msgctxt "text_id=5518 | speaker=unknown"
msgid "　なんて弱音をぐっと堪える。"
msgstr ""

#. Occurrence 5B_1:2560:5519: scene=5B_1
#: 5B_1:2560
msgctxt "text_id=5519 | speaker=unknown"
msgid "　青子は有珠の魔術を知っている。"
msgstr ""

#. Occurrence 5B_1:2565:5520: scene=5B_1
#: 5B_1:2565
msgctxt "text_id=5520 | speaker=unknown"
msgid "　あの小さな体にどれほどの神秘を秘めているか、痛いほど経験している。"
msgstr ""

#. Occurrence 5B_1:2625:5521: scene=5B_1
#: 5B_1:2625
msgctxt "text_id=5521 | speaker=unknown"
msgid "　勝ち目はほとんど、ぜったい<皆無|かいむ>。"
msgstr ""

#. Occurrence 5B_1:2630:5522: scene=5B_1
#: 5B_1:2630
msgctxt "text_id=5522 | speaker=unknown"
msgid "　そして一度でも口火をきれば、久遠寺有珠は容赦なしだ。"
msgstr ""

#. Occurrence 5B_1:2643:5523: scene=5B_1
#: 5B_1:2643
msgctxt "text_id=5523 | speaker=unknown"
msgid "　同居人であろうと友人だろうと、"
msgstr ""

#. Occurrence 5B_1:2648:5524: scene=5B_1
#: 5B_1:2648
msgctxt "text_id=5524 | speaker=unknown"
msgid "　彼女の最愛の肉親であろうと、"
msgstr ""

#. Occurrence 5B_1:2653:5525: scene=5B_1
#: 5B_1:2653
msgctxt "text_id=5525 | speaker=unknown"
msgid "　魔女として戦う以上、あの少女は<冷徹|れいてつ><無|む><比|ひ>な怪物となる。"
msgstr ""

#. Occurrence 5B_1:2725:5526: scene=5B_1
#: 5B_1:2725
msgctxt "text_id=5526 | speaker=unknown"
msgid "　青子はもう半歩、自らを<鼓|こ><舞|ぶ>するよう前進した。"
msgstr ""

#. Occurrence 5B_1:2730:5527: scene=5B_1
#: 5B_1:2730
msgctxt "text_id=5527 | speaker=unknown"
msgid "　今さら後には退けない。<事|コ><態|ト>はもう、どうでもいい<目撃者|だいさんしゃ>を<巡|めぐ>っての言い争いではない。"
msgstr ""

#. Occurrence 5B_1:2735:5528: scene=5B_1
#: 5B_1:2735
msgctxt "text_id=5528 | speaker=unknown"
msgid "　彼女たちの友情らしきものは、実力差はどうあれ、精神的に対等である事が成立の条件になっている。"
msgstr ""

#. Occurrence 5B_1:2741:5529: scene=5B_1
#: 5B_1:2741
msgctxt "text_id=5529 | speaker=unknown"
msgid "　だからこそ―――『自分』を通すのであれば、妥協も誤魔化しも、する訳にはいかなかった。"
msgstr ""

#. Occurrence 5B_1:2775:5530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0020; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2775
msgctxt "text_id=5530 | speaker=aoko"
msgid "「もちろん。アンタを殺す事になっても、そこのバカは生かしきるわ。それに―――」"
msgstr ""

#. Occurrence 5B_1:2881:5531: scene=5B_1
#: 5B_1:2881
msgctxt "text_id=5531 | speaker=unknown"
msgid "　うなりをあげて式を走らせる魔術回路。"
msgstr ""

#. Occurrence 5B_1:2887:5532: scene=5B_1
#: 5B_1:2887
msgctxt "text_id=5532 | speaker=unknown"
msgid "先の人形戦では眠っていた身体が、その真価を発揮させろと燃え上がり―――"
msgstr ""

#. Occurrence 5B_1:2939:5533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0021; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2939
msgctxt "text_id=5533 | speaker=aoko"
msgid "「それに。どのみち最後には殺し合う仲でしょ、私たち……！」"
msgstr ""

#. Occurrence 5B_1:2945:5534: scene=5B_1
#: 5B_1:2945
msgctxt "text_id=5534 | speaker=unknown"
msgid "　闘志を<以|もっ>て、強敵への恐怖を克服する―――！"
msgstr ""

#. Occurrence 5B_1:3153:5535: scene=5B_1
#: 5B_1:3153
msgctxt "text_id=5535 | speaker=unknown"
msgid "　青子の魔弾は自身の体……魔術回路を銃身にして魔力を放つ、ごく単純な魔術式だ。"
msgstr ""

#. Occurrence 5B_1:3158:5536: scene=5B_1
#: 5B_1:3158
msgctxt "text_id=5536 | speaker=unknown"
msgid "　風を起こす、水を分ける、<劣化|じかん>をかける、といった自然干渉ではない。"
msgstr ""

#. Occurrence 5B_1:3163:5537: scene=5B_1
#: 5B_1:3163
msgctxt "text_id=5537 | speaker=unknown"
msgid "　魔力という架空の運動を実在へと加工し、熱量として撃ちだしている。"
msgstr ""

#. Occurrence 5B_1:3168:5538: scene=5B_1
#: 5B_1:3168
msgctxt "text_id=5538 | speaker=unknown"
msgid "　なので、その破壊力は青子が扱える魔力量がイコールとなる。"
msgstr ""

#. Occurrence 5B_1:3188:5539: scene=5B_1
#: 5B_1:3188
msgctxt "text_id=5539 | speaker=unknown"
msgid "　草十郎相手に使用した魔弾は<一工程|シングルアクション>、詠唱を必要としない最低限の魔術だった。"
msgstr ""

#. Occurrence 5B_1:3194:5540: scene=5B_1
#: 5B_1:3194
msgctxt "text_id=5540 | speaker=unknown"
msgid "　現状、青子が主武器とする魔弾には三つの工程がある。"
msgstr ""

#. Occurrence 5B_1:3199:5541: scene=5B_1
#: 5B_1:3199
msgctxt "text_id=5541 | speaker=unknown"
msgid "　これはその二つめ。"
msgstr ""

#. Occurrence 5B_1:3204:5542: scene=5B_1
#: 5B_1:3204
msgctxt "text_id=5542 | speaker=unknown"
msgid "　魔術刻印を<起動|リード>させ、簡略化詠唱を用いた二工程の魔弾である。"
msgstr ""

#. Occurrence 5B_1:3345:5543: scene=5B_1
#: 5B_1:3345
msgctxt "text_id=5543 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 5B_1:3350:5544: scene=5B_1
#: 5B_1:3350
msgctxt "text_id=5544 | speaker=unknown"
msgid "　それなりに気合いを込めた青子の魔弾を、少女は<瞬|またた>き一つせず霧散させた。"
msgstr ""

#. Occurrence 5B_1:3550:5545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0022; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3550
msgctxt "text_id=5545 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_1:3556:5546: scene=5B_1
#: 5B_1:3556
msgctxt "text_id=5546 | speaker=unknown"
msgid "　ち、と舌打ちする青子。"
msgstr ""

#. Occurrence 5B_1:3561:5547: scene=5B_1
#: 5B_1:3561
msgctxt "text_id=5547 | speaker=unknown"
msgid "　不意打ちの速攻―――詠唱を簡略した魔術行使では、久遠寺有珠の守りは破れない。"
msgstr ""

#. Occurrence 5B_1:3630:5548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0023; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3630
msgctxt "text_id=5548 | speaker=aoko"
msgid "「相変わらずお<堅|かた>いこと。その<殻|カラ>、一段と独りよがりになってるんじゃない？」"
msgstr ""

#. Occurrence 5B_1:3636:5549: scene=5B_1
#: 5B_1:3636
msgctxt "text_id=5549 | speaker=unknown"
msgid "　青子は内心の焦りをおくびにも出さず挑発する。"
msgstr ""

#. Occurrence 5B_1:3658:5550: scene=5B_1
#: 5B_1:3658
msgctxt "text_id=5550 | speaker=unknown"
msgid "　そのやせ我慢が気に入ったのか。"
msgstr ""

#. Occurrence 5B_1:3665:5551: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0022; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3665
msgctxt "text_id=5551 | speaker=alice"
msgid "「売り言葉に買い言葉、というヤツね。"
msgstr ""

#. Occurrence 5B_1:3671:5552: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0023; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3671
msgctxt "text_id=5552 | speaker=alice"
msgid "　こういう、勢いだけのきっかけは初めてだけど……」"
msgstr ""

#. Occurrence 5B_1:3725:5553: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0024; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3725
msgctxt "text_id=5553 | speaker=alice"
msgid "「驚いたわ。こんな下らない理由でも、その気になるものなのね、人間って」"
msgstr ""

#. Occurrence 5B_1:3731:5554: scene=5B_1
#: 5B_1:3731
msgctxt "text_id=5554 | speaker=unknown"
msgid "　くすりと。"
msgstr ""

#. Occurrence 5B_1:3736:5555: scene=5B_1
#: 5B_1:3736
msgctxt "text_id=5555 | speaker=unknown"
msgid "　心の底から感心するように微笑んで、少女は左手の指を地上に向けた。"
msgstr ""

#. Occurrence 5B_1:3978:5556: scene=5B_1
#: 5B_1:3978
msgctxt "text_id=5556 | speaker=unknown"
msgid "　<刺|zap>す。<刺|zap>す。<刺|zap>す。<刺|zap>す。"
msgstr ""

#. Occurrence 5B_1:3983:5557: scene=5B_1
#: 5B_1:3983
msgctxt "text_id=5557 | speaker=unknown"
msgid "　広場の地面、レンガを破って突き出る無数の槍。"
msgstr ""

#. Occurrence 5B_1:4050:5558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0024; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4050
msgctxt "text_id=5558 | speaker=aoko"
msgid "「静希君、後ろに跳んで！」"
msgstr ""

#. Occurrence 5B_1:4056:5559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0005; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:4056
msgctxt "text_id=5559 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 5B_1:4061:5560: scene=5B_1
#: 5B_1:4061
msgctxt "text_id=5560 | speaker=unknown"
msgid "　青子は呼びかけながら、彼が反応するより早く手を取って後ろに跳んだ。"
msgstr ""

#. Occurrence 5B_1:4128:5561: scene=5B_1
#: 5B_1:4128
msgctxt "text_id=5561 | speaker=unknown"
msgid "　地面から湧き立つ器物は意志を持つように、跳び退く青子たちを追いかける。"
msgstr ""

#. Occurrence 5B_1:4133:5562: scene=5B_1
#: 5B_1:4133
msgctxt "text_id=5562 | speaker=unknown"
msgid "　槍の守りは放射状に広がり、青子と草十郎を時計台から離していく。"
msgstr ""

#. Occurrence 5B_1:4191:5563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0025; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4191
msgctxt "text_id=5563 | speaker=aoko"
msgid "「―――え、これで終わり？」"
msgstr ""

#. Occurrence 5B_1:4197:5564: scene=5B_1
#: 5B_1:4197
msgctxt "text_id=5564 | speaker=unknown"
msgid "　後ろに下がること十メートル弱。"
msgstr ""

#. Occurrence 5B_1:4202:5565: scene=5B_1
#: 5B_1:4202
msgctxt "text_id=5565 | speaker=unknown"
msgid "　地面を砕いて現れる凶器たちの成長は、青子の予想より小規模に留まった。"
msgstr ""

#. Occurrence 5B_1:4207:5566: scene=5B_1
#: 5B_1:4207
msgctxt "text_id=5566 | speaker=unknown"
msgid "　少女の立つ時計台を守るソレは、<磔|はりつけ>にされた魔女を責める<薪|たきぎ>のようで―――"
msgstr ""

#. Occurrence 5B_1:4228:5567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0026; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4228
msgctxt "text_id=5567 | speaker=aoko"
msgid "“……普通、逆じゃない？　ここは私たちを逃がさないよう、槍で周りを囲むものでしょう……？”"
msgstr ""

#. Occurrence 5B_1:4234:5568: scene=5B_1
#: 5B_1:4234
msgctxt "text_id=5568 | speaker=unknown"
msgid "　青子と草十郎の後ろには安全な道がある。"
msgstr ""

#. Occurrence 5B_1:4239:5569: scene=5B_1
#: 5B_1:4239
msgctxt "text_id=5569 | speaker=unknown"
msgid "　その気になれば二人は遊園地の入り口まで走って、そのまま町へ逃げられる。"
msgstr ""

#. Occurrence 5B_1:4285:5570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0027; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4285
msgctxt "text_id=5570 | speaker=aoko"
msgid "「いいの有珠？"
msgstr ""

msgctxt "text_id=5571 | speaker=unknown"
msgid "　悪いけど、逃げられるなら逃げるわよ、私」"
msgstr ""

#. Occurrence 5B_1:4293:5572: scene=5B_1
#: 5B_1:4293
msgctxt "text_id=5572 | speaker=unknown"
msgid "　町にまで出れば青子の勝ちだ。"
msgstr ""

#. Occurrence 5B_1:4298:5573: scene=5B_1
#: 5B_1:4298
msgctxt "text_id=5573 | speaker=unknown"
msgid "　今夜だけ草十郎を見逃したい青子にとって、彼を街に逃がしてしまえば目的は大部分達成―――"
msgstr ""

#. Occurrence 5B_1:4354:5574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0028; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4354
msgctxt "text_id=5574 | speaker=aoko"
msgid "「？」"
msgstr ""

#. Occurrence 5B_1:4374:5575: scene=5B_1
#: 5B_1:4374
msgctxt "text_id=5575 | speaker=unknown"
msgid "　―――なのだが。"
msgstr ""

#. Occurrence 5B_1:4379:5576: scene=5B_1
#: 5B_1:4379
msgctxt "text_id=5576 | speaker=unknown"
msgid "　有珠は眼下の標的に目もくれず、愛しい、大切なものを扱うように<小瓶|こびん>を取り出した。"
msgstr ""

#. Occurrence 5B_1:4425:5577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0029; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4425
msgctxt "text_id=5577 | speaker=aoko"
msgid "「緑の……フラスコ？"
msgstr ""

#. Occurrence 5B_1:4431:5578: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0030; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4431
msgctxt "text_id=5578 | speaker=aoko"
msgid "　あれってたしか―――やばっ、とにかく<撃て|ファイヤ>―――！」"
msgstr ""

#. Occurrence 5B_1:4665:5579: scene=5B_1
#: 5B_1:4665
msgctxt "text_id=5579 | speaker=unknown"
msgid "　防がれる魔弾。"
msgstr ""

#. Occurrence 5B_1:4670:5580: scene=5B_1
#: 5B_1:4670
msgctxt "text_id=5580 | speaker=unknown"
msgid "　青子の顔には、もう一片の余裕もない。"
msgstr ""

#. Occurrence 5B_1:4757:5581: scene=5B_1
#: 5B_1:4757
msgctxt "text_id=5581 | speaker=unknown"
msgid "　……そう。"
msgstr ""

#. Occurrence 5B_1:4762:5582: scene=5B_1
#: 5B_1:4762
msgctxt "text_id=5582 | speaker=unknown"
msgid "　増長していたと言えば、青子はたしかに増長していた。"
msgstr ""

#. Occurrence 5B_1:4767:5583: scene=5B_1
#: 5B_1:4767
msgctxt "text_id=5583 | speaker=unknown"
msgid "　この二年、学び続けた魔術に手応えもあった。"
msgstr ""

#. Occurrence 5B_1:4772:5584: scene=5B_1
#: 5B_1:4772
msgctxt "text_id=5584 | speaker=unknown"
msgid "　同居人の性格、魔術もそれなりに把握していた。"
msgstr ""

#. Occurrence 5B_1:4812:5585: scene=5B_1
#: 5B_1:4812
msgctxt "text_id=5585 | speaker=unknown"
msgid "　だから―――最善の立ち回りをすれば、久遠寺有珠に一杯くわせられると思い上がったのだ。"
msgstr ""

#. Occurrence 5B_1:4890:5586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0031; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4890
msgctxt "text_id=5586 | speaker=aoko"
msgid "「あ―――」"
msgstr ""

#. Occurrence 5B_1:4895:5587: scene=5B_1
#: 5B_1:4895
msgctxt "text_id=5587 | speaker=unknown"
msgid "　……魔法の<瓶|びん>の<蓋|ふた>が開く。"
msgstr ""

#. Occurrence 5B_1:4936:5588: scene=5B_1
#: 5B_1:4936
msgctxt "text_id=5588 | speaker=unknown"
msgid "　頬を優しい風が<撫|な>でる。"
msgstr ""

#. Occurrence 5B_1:5050:5589: scene=5B_1
#: 5B_1:5050
msgctxt "text_id=5589 | speaker=unknown"
msgid "　夜の饗宴が、新たな主役の登場に尻尾を巻いて逃げ出していく。"
msgstr ""

#. Occurrence 5B_1:5104:5590: scene=5B_1
#: 5B_1:5104
msgctxt "text_id=5590 | speaker=unknown"
msgid "　―――どこからか。"
msgstr ""

#. Occurrence 5B_1:5109:5591: scene=5B_1
#: 5B_1:5109
msgctxt "text_id=5591 | speaker=unknown"
msgid "　懐かしい、パレードの足音がやってくる。"
msgstr ""

#. Occurrence 5B_1:5380:5592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0032; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:5380
msgctxt "text_id=5592 | speaker=aoko"
msgid "「う、そ―――」"
msgstr ""

#. Occurrence 5B_1:5469:5593: scene=5B_1
#: 5B_1:5469
msgctxt "text_id=5593 | speaker=unknown"
msgid "　それは。"
msgstr ""

#. Occurrence 5B_1:5474:5594: scene=5B_1
#: 5B_1:5474
msgctxt "text_id=5594 | speaker=unknown"
msgid "　魔術師見習いである蒼崎青子ですら、体験した事のない奇跡だった。"
msgstr ""

#. Occurrence 5B_1:5597:5595: scene=5B_1
#: 5B_1:5597
msgctxt "text_id=5595 | speaker=unknown"
msgid "　死んでいたモノが蘇る。"
msgstr ""

#. Occurrence 5B_1:5602:5596: scene=5B_1
#: 5B_1:5602
msgctxt "text_id=5596 | speaker=unknown"
msgid "　生きていないモノが目を覚ます。"
msgstr ""

#. Occurrence 5B_1:5607:5597: scene=5B_1
#: 5B_1:5607
msgctxt "text_id=5597 | speaker=unknown"
msgid "　霧に包まれた深い森。"
msgstr ""

#. Occurrence 5B_1:5612:5598: scene=5B_1
#: 5B_1:5612
msgctxt "text_id=5598 | speaker=unknown"
msgid "　沼地にひそむ火を噴くトカゲ。"
msgstr ""

#. Occurrence 5B_1:5617:5599: scene=5B_1
#: 5B_1:5617
msgctxt "text_id=5599 | speaker=unknown"
msgid "　午前零時をむかえてはしゃぎだすパペットたち。"
msgstr ""

#. Occurrence 5B_1:5627:5600: scene=5B_1
#: 5B_1:5627
msgctxt "text_id=5600 | speaker=unknown"
msgid "　久遠寺有珠の細い指は、年老いた猫の背中を撫でるように優しく、遊園地全体を変貌させ―――"
msgstr ""

#. Occurrence 5B_1:5677:5601: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_0; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5677
msgctxt "text_id=5601 | speaker=alice"
msgid "　　「いいわ―――"
msgstr ""

#. Occurrence 5B_1:5684:5602: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_1; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5684
msgctxt "text_id=5602 | speaker=alice"
msgid "ごっこ遊びをしましょう、青子」"
msgstr ""

#. Occurrence 5B_1:5747:5603: scene=5B_1
#: 5B_1:5747
msgctxt "text_id=5603 | speaker=unknown"
msgid "　……ありし日の夢の廃棄場は、一夜かぎりの王国に生まれ変わる。"
msgstr ""

#. Occurrence 5B_1:5853:5604: scene=5B_1
#: 5B_1:5853
msgctxt "text_id=5604 | speaker=unknown"
msgid "　それは現実を侵食する不死身の魔物。"
msgstr ""

#. Occurrence 5B_1:5858:5605: scene=5B_1
#: 5B_1:5858
msgctxt "text_id=5605 | speaker=unknown"
msgid "　<一度|ひとたび>解き放たれれば、決して獲物を逃がさない暗黒童話。"
msgstr ""

#. Occurrence 5B_1:5890:5606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0026; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5890
msgctxt "text_id=5606 | speaker=alice"
msgid "「逃げられるものなら逃げてみせて。"
msgstr ""

#. Occurrence 5B_1:5896:5607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0027; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5896
msgctxt "text_id=5607 | speaker=alice"
msgid "　どこまで行けるか分からないけど―――この夜を越える事ができたのなら、貴女の勝ちにしてあげる」"
msgstr ""

#. Occurrence 5B_1:5917:5608: scene=5B_1
#: 5B_1:5917
msgctxt "text_id=5608 | speaker=unknown"
msgid "　……絶望的な戦いの開幕宣言。"
msgstr ""

#. Occurrence 5B_1:5922:5609: scene=5B_1
#: 5B_1:5922
msgctxt "text_id=5609 | speaker=unknown"
msgid "　親愛と悲しみ、それと無邪気な愉悦をこめて、"
msgstr ""

#. Occurrence 5B_1:5927:5610: scene=5B_1
#: 5B_1:5927
msgctxt "text_id=5610 | speaker=unknown"
msgid "　黒衣の魔女は友人へと<歌|わら>いかけた。"
msgstr ""

#. Occurrence 5B_10:42:5611: scene=5B_10
#: 5B_10:42
msgctxt "text_id=5611 | speaker=unknown"
msgid "　けれど、希望はいつだって束の間のもの。"
msgstr ""

#. Occurrence 5B_10:47:5612: scene=5B_10
#: 5B_10:47
msgctxt "text_id=5612 | speaker=unknown"
msgid "　彼らの希望は三百メートル分しか続かなかった。"
msgstr ""

#. Occurrence 5B_10:53:5613: scene=5B_10
#: 5B_10:53
msgctxt "text_id=5613 | speaker=unknown"
msgid "　遊園地の果ては、何の比喩もなく“世界の果て”そのものだったのだから。"
msgstr ""

#. Occurrence 5B_10:250:5614: scene=5B_10
#: 5B_10:250
msgctxt "text_id=5614 | speaker=unknown"
msgid "　波立つ、何十という地平線。"
msgstr ""

#. Occurrence 5B_10:255:5615: scene=5B_10
#: 5B_10:255
msgctxt "text_id=5615 | speaker=unknown"
msgid "　それは<群雲|むらくも>のような、<緞帳|どんちょう>のような、"
msgstr ""

#. Occurrence 5B_10:260:5616: scene=5B_10
#: 5B_10:260
msgctxt "text_id=5616 | speaker=unknown"
msgid "　あるいは呻きをもらす<唇|ひだ>のような、"
msgstr ""

#. Occurrence 5B_10:265:5617: scene=5B_10
#: 5B_10:265
msgctxt "text_id=5617 | speaker=unknown"
msgid "　あまりにも奇怪で、あまりにも童話めいた、この世界の行き止まり。"
msgstr ""

#. Occurrence 5B_10:271:5618: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5618 | speaker=unknown"
msgid "　―――さながら。"
msgstr ""

#. Occurrence 5B_10:271:5619: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5619 | speaker=unknown"
msgid "　巨大な紙芝居の最後の一枚だと、彼女は思った。"
msgstr ""

#. Occurrence 5B_10:426:5620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0000; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:426
msgctxt "text_id=5620 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_10:432:5621: scene=5B_10
#: 5B_10:432
msgctxt "text_id=5621 | speaker=unknown"
msgid "　その光景を前にした時、青子は不覚にも、一切の思考を放棄した。"
msgstr ""

#. Occurrence 5B_10:437:5622: scene=5B_10
#: 5B_10:437
msgctxt "text_id=5622 | speaker=unknown"
msgid "　……ああ、たいへんな事になったな、と。"
msgstr ""

#. Occurrence 5B_10:442:5623: scene=5B_10
#: 5B_10:442
msgctxt "text_id=5623 | speaker=unknown"
msgid "　波立つ境界線を見て、ようやく、この<絶望島|スナーク>に膝を屈した。"
msgstr ""

#. Occurrence 5B_10:533:5624: scene=5B_10
#: 5B_10:533
msgctxt "text_id=5624 | speaker=unknown"
msgid "　遊園地に終わりはあった。"
msgstr ""

#. Occurrence 5B_10:538:5625: scene=5B_10
#: 5B_10:538
msgctxt "text_id=5625 | speaker=unknown"
msgid "　青子たちの知っている通り、遊園地と住宅街を<隔|へだ>てる鉄柵はこうして今も。"
msgstr ""

#. Occurrence 5B_10:558:5626: scene=5B_10
#: 5B_10:558
msgctxt "text_id=5626 | speaker=unknown"
msgid "　鉄柵は二倍ぐらい高くなっていたり、なんだか装飾が頑丈になっていたりするけど、それも想定の範囲内。"
msgstr ""

#. Occurrence 5B_10:563:5627: scene=5B_10
#: 5B_10:563
msgctxt "text_id=5627 | speaker=unknown"
msgid "　たとえ鉄柵がスナーク化していようと、壁の一枚や二枚なら撃ち抜く<気概|つもり>で彼女はここまでやって来たのだから。"
msgstr ""

#. Occurrence 5B_10:569:5628: scene=5B_10
#: 5B_10:569
msgctxt "text_id=5628 | speaker=unknown"
msgid "　……けれど。"
msgstr ""

#. Occurrence 5B_10:574:5629: scene=5B_10
#: 5B_10:574
msgctxt "text_id=5629 | speaker=unknown"
msgid "　目前に広がるモノは、もはや境界ですらなかった。"
msgstr ""

#. Occurrence 5B_10:647:5630: scene=5B_10
#: 5B_10:647
msgctxt "text_id=5630 | speaker=unknown"
msgid "　この異界と外界を分かつ海。"
msgstr ""

#. Occurrence 5B_10:652:5631: scene=5B_10
#: 5B_10:652
msgctxt "text_id=5631 | speaker=unknown"
msgid "　鉄柵は寄せ返す<波濤|はとう>の如く。"
msgstr ""

#. Occurrence 5B_10:657:5632: scene=5B_10
#: 5B_10:657
msgctxt "text_id=5632 | speaker=unknown"
msgid "　一枚、二枚はたやすく破れる。"
msgstr ""

#. Occurrence 5B_10:662:5633: scene=5B_10
#: 5B_10:662
msgctxt "text_id=5633 | speaker=unknown"
msgid "　十枚、二十枚までは何とか進める。"
msgstr ""

#. Occurrence 5B_10:667:5634: scene=5B_10
#: 5B_10:667
msgctxt "text_id=5634 | speaker=unknown"
msgid "　残った自身の魔力と、遊園地に満ちた魔力と、魔術回路と刻印を焼き切れるまで総動員すれば、ただ一度きり、<十戒|じっかい>の真似事ぐらいはやってみせると強がれる。"
msgstr ""

#. Occurrence 5B_10:707:5635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0001; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:707
msgctxt "text_id=5635 | speaker=aoko"
msgid "「―――でも、それで終わり」"
msgstr ""

#. Occurrence 5B_10:713:5636: scene=5B_10
#: 5B_10:713
msgctxt "text_id=5636 | speaker=unknown"
msgid "　この海を割った後、青子には立ち上がる体力さえ残らない。"
msgstr ""

#. Occurrence 5B_10:718:5637: scene=5B_10
#: 5B_10:718
msgctxt "text_id=5637 | speaker=unknown"
msgid "　……その後の運命は明白だ。"
msgstr ""

#. Occurrence 5B_10:723:5638: scene=5B_10
#: 5B_10:723
msgctxt "text_id=5638 | speaker=unknown"
msgid "　さんざん遊園地を壊してまわった青子を、住人たちは決して許しはしないだろう。<蜜|みつ>にたかる<蟻|あり>の如く、動けなくなった少女を八つ裂きにする。"
msgstr ""

#. Occurrence 5B_10:757:5639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0002; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:757
msgctxt "text_id=5639 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_10:763:5640: scene=5B_10
#: 5B_10:763
msgctxt "text_id=5640 | speaker=unknown"
msgid "　<落胆|らくたん>と疲れから、微かな後悔がこぼれる。"
msgstr ""

#. Occurrence 5B_10:768:5641: scene=5B_10
#: 5B_10:768
msgctxt "text_id=5641 | speaker=unknown"
msgid "　遊園地から外に出る。"
msgstr ""

#. Occurrence 5B_10:773:5642: scene=5B_10
#: 5B_10:773
msgctxt "text_id=5642 | speaker=unknown"
msgid "　その選択自体が間違いだったと認めて、青子は来た道を振り返った。"
msgstr ""

#. Occurrence 5B_10:924:5643: scene=5B_10
#: 5B_10:924
msgctxt "text_id=5643 | speaker=unknown"
msgid "　<金色|こんじき>の満月の下、鉄骨はうねり、針金細工のように集まっている。"
msgstr ""

#. Occurrence 5B_10:939:5644: scene=5B_10
#: 5B_10:939
msgctxt "text_id=5644 | speaker=unknown"
msgid "　遊園地そのものが巨大な“怪物”になるのも時間の問題だ。"
msgstr ""

#. Occurrence 5B_10:944:5645: scene=5B_10
#: 5B_10:944
msgctxt "text_id=5645 | speaker=unknown"
msgid "　有珠のいる広場には大量の使い魔が集っており近寄れもしない。"
msgstr ""

#. Occurrence 5B_10:957:5646: scene=5B_10
#: 5B_10:957
msgctxt "text_id=5646 | speaker=unknown"
msgid "　傍らに立つ少年の頭上には、かわらず表面をシャッフルし続ける<囁く卵|スクラッチ・ダンプティ>。"
msgstr ""

#. Occurrence 5B_10:1020:5647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0000; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1020
msgctxt "text_id=5647 | speaker=soujuurou"
msgid "「―――蒼崎！」"
msgstr ""

#. Occurrence 5B_10:1071:5648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0003; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1071
msgctxt "text_id=5648 | speaker=aoko"
msgid "「静希君……？」"
msgstr ""

#. Occurrence 5B_10:1141:5649: scene=5B_10
#: 5B_10:1141
msgctxt "text_id=5649 | speaker=unknown"
msgid "　少年の声に、止まっていた思考が動き出す。"
msgstr ""

#. Occurrence 5B_10:1146:5650: scene=5B_10
#: 5B_10:1146
msgctxt "text_id=5650 | speaker=unknown"
msgid "　……けれど、それも一瞬。"
msgstr ""

#. Occurrence 5B_10:1151:5651: scene=5B_10
#: 5B_10:1151
msgctxt "text_id=5651 | speaker=unknown"
msgid "　魔術師である青子は現状を把握してしまう。"
msgstr ""

#. Occurrence 5B_10:1156:5652: scene=5B_10
#: 5B_10:1156
msgctxt "text_id=5652 | speaker=unknown"
msgid "　その絶望が、彼女から抗う<選択|いし>を根こそぎ奪っていた。"
msgstr ""

#. Occurrence 5B_10:1241:5653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0001; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1241
msgctxt "text_id=5653 | speaker=soujuurou"
msgid "「<正門|ゲート>に行こう。ここはどうしようもないけど、入り口ならもうちょっとマシだろう。"
msgstr ""

#. Occurrence 5B_10:1247:5654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0002; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1247
msgctxt "text_id=5654 | speaker=soujuurou"
msgid "　フラットスナークだっけ？　コイツにもルールがあるって言ったじゃないか。"
msgstr ""

#. Occurrence 5B_10:1254:5655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0003; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1254
msgctxt "text_id=5655 | speaker=soujuurou"
msgid "なら、これは役割の問題だ。はじめから鉄柵は通れない壁だけど、正門なら出入り口として機能しているかも知れない」"
msgstr ""

#. Occurrence 5B_10:1282:5656: scene=5B_10
#: 5B_10:1282
msgctxt "text_id=5656 | speaker=unknown"
msgid "　草十郎はパニックに<陥|おちい>っていない。"
msgstr ""

#. Occurrence 5B_10:1287:5657: scene=5B_10
#: 5B_10:1287
msgctxt "text_id=5657 | speaker=unknown"
msgid "　この状況でスナークの特性を読み取れるのは凄いな、と青子は素直に感心した。"
msgstr ""

#. Occurrence 5B_10:1292:5658: scene=5B_10
#: 5B_10:1292
msgctxt "text_id=5658 | speaker=unknown"
msgid "　冷めきった、覚悟を決めた心持ちで。"
msgstr ""

#. Occurrence 5B_10:1326:5659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0004; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1326
msgctxt "text_id=5659 | speaker=aoko"
msgid "「……そうね。たしかに門はあると思う。"
msgstr ""

#. Occurrence 5B_10:1332:5660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0005; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1332
msgctxt "text_id=5660 | speaker=aoko"
msgid "　けど、たどり着くのは難しいわ。一番弱かった焼きたてパンですら、今はもうアレだもの。"
msgstr ""

#. Occurrence 5B_10:1338:5661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0006; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1338
msgctxt "text_id=5661 | speaker=aoko"
msgid "　広場や入り口にはもっと上等なのがたむろしてるだろうし、門だって、あの観覧車以上の怪物かもしれない。たしか大きなキッツィーちゃんだったでしょ、正門って」"
msgstr ""

#. Occurrence 5B_10:1411:5662: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0004; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1411
msgctxt "text_id=5662 | speaker=soujuurou"
msgid "「……蒼崎は正門には行かないのか？」"
msgstr ""

#. Occurrence 5B_10:1417:5663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0007; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1417
msgctxt "text_id=5663 | speaker=aoko"
msgid "「まあね。それよりこっちの方が現実的だし」"
msgstr ""

#. Occurrence 5B_10:1431:5664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0005; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1431
msgctxt "text_id=5664 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 5B_10:1502:5665: scene=5B_10
#: 5B_10:1502
msgctxt "text_id=5665 | speaker=unknown"
msgid "　青子は波立つ鉄柵を<一瞥|いちべつ>する。"
msgstr ""

#. Occurrence 5B_10:1507:5666: scene=5B_10
#: 5B_10:1507
msgctxt "text_id=5666 | speaker=unknown"
msgid "　既に『生きて脱出する』という目標は達成できない。"
msgstr ""

#. Occurrence 5B_10:1512:5667: scene=5B_10
#: 5B_10:1512
msgctxt "text_id=5667 | speaker=unknown"
msgid "　である以上、残ったもう一つの約束を優先しようと、彼女は心を切り替えていた。"
msgstr ""

#. Occurrence 5B_10:1541:5668: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0008; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1541
msgctxt "text_id=5668 | speaker=aoko"
msgid "「今からこの鉄柵を壊すから、貴方はそこから外に出て。"
msgstr ""

#. Occurrence 5B_10:1547:5669: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0009; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1547
msgctxt "text_id=5669 | speaker=aoko"
msgid "　それで、私の役割はおしまいよ」"
msgstr ""

#. Occurrence 5B_10:1600:5670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0006; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1600
msgctxt "text_id=5670 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_10:1606:5671: scene=5B_10
#: 5B_10:1606
msgctxt "text_id=5671 | speaker=unknown"
msgid "　言葉は少なかったが、淡々とした声がすべてを物語っている。"
msgstr ""

#. Occurrence 5B_10:1611:5672: scene=5B_10
#: 5B_10:1611
msgctxt "text_id=5672 | speaker=unknown"
msgid "　彼女は彼に、ひとりで逃げろと言ったのだ。"
msgstr ""

#. Occurrence 5B_10:1683:5673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0007; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1683
msgctxt "text_id=5673 | speaker=soujuurou"
msgid "「……信じられない。"
msgstr ""

#. Occurrence 5B_10:1689:5674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0008; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1689
msgctxt "text_id=5674 | speaker=soujuurou"
msgid "　こんなの、蒼崎だけじゃ壊せないだろう」"
msgstr ""

#. Occurrence 5B_10:1702:5675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0010; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1702
msgctxt "text_id=5675 | speaker=aoko"
msgid "「私だけならね。でも、今はこの遊園地が味方してる。燃料がこれだけあるんだから、私は銃身になるだけでいいんだし。一発でかいのお見舞いしてやるわ。"
msgstr ""

#. Occurrence 5B_10:1708:5676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0011; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1708
msgctxt "text_id=5676 | speaker=aoko"
msgid "　……ま、それでも一回が限度だから、穴をあけたら、アンタには全力で走り抜けてもらうしかないけど」"
msgstr ""

#. Occurrence 5B_10:1728:5677: scene=5B_10
#: 5B_10:1728
msgctxt "text_id=5677 | speaker=unknown"
msgid "　この鉄柵の海に道を作る。"
msgstr ""

#. Occurrence 5B_10:1733:5678: scene=5B_10
#: 5B_10:1733
msgctxt "text_id=5678 | speaker=unknown"
msgid "　それは彼女の持てる力を総動員しての、一度きりの大詠唱、大射程の極限魔弾。"
msgstr ""

#. Occurrence 5B_10:1801:5679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0009; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1801
msgctxt "text_id=5679 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_10:1807:5680: scene=5B_10
#: 5B_10:1807
msgctxt "text_id=5680 | speaker=unknown"
msgid "　門外漢である草十郎には、それがどれほどの負担をかけるものか想像もできない。ただ漠然と、遊園地に取り残される青子の姿が思い浮かぶ。"
msgstr ""

#. Occurrence 5B_10:1866:5681: scene=5B_10
#: 5B_10:1866
msgctxt "text_id=5681 | speaker=unknown"
msgid "　……残された彼女はどうなるのか。"
msgstr ""

#. Occurrence 5B_10:1871:5682: scene=5B_10
#: 5B_10:1871
msgctxt "text_id=5682 | speaker=unknown"
msgid "　あの黒衣の少女は彼女を助けるのか。"
msgstr ""

#. Occurrence 5B_10:1937:5683: scene=5B_10
#: 5B_10:1937
msgctxt "text_id=5683 | speaker=unknown"
msgid "　無慈悲な話だが、それはない。"
msgstr ""

#. Occurrence 5B_10:1942:5684: scene=5B_10
#: 5B_10:1942
msgctxt "text_id=5684 | speaker=unknown"
msgid "　青子が草十郎を助けるために最善を尽くした以上、あの少女も手を<緩|ゆる>めはしないだろう。"
msgstr ""

#. Occurrence 5B_10:2014:5685: scene=5B_10
#: 5B_10:2014
msgctxt "text_id=5685 | speaker=unknown"
msgid "　有珠が青子を見逃すとしたら、それは青子が自分の<命|いのち>惜しさに草十郎を殺した時だけだ。"
msgstr ""

#. Occurrence 5B_10:2019:5686: scene=5B_10
#: 5B_10:2019
msgctxt "text_id=5686 | speaker=unknown"
msgid "　そして、"
msgstr ""

#. Occurrence 5B_10:2091:5687: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0012; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2091
msgctxt "text_id=5687 | speaker=aoko"
msgid "「二十メートルぐらい離れてて。"
msgstr ""

#. Occurrence 5B_10:2098:5688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0013; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2098
msgctxt "text_id=5688 | speaker=aoko"
msgid "<詠唱|じゅんび>に手間どるけど、その卵の表面がゆで上がるまでには終わらせるから」"
msgstr ""

#. Occurrence 5B_10:2104:5689: scene=5B_10
#: 5B_10:2104
msgctxt "text_id=5689 | speaker=unknown"
msgid "　言うまでもなく、彼女はその道を選ばない。"
msgstr ""

#. Occurrence 5B_10:2180:5690: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5690 | speaker=soujuurou"
msgid "「待ってくれ。"
msgstr ""

#. Occurrence 5B_10:2180:5691: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5691 | speaker=soujuurou"
msgid "　俺を逃がすっていうけど、それに意味はあるのか、蒼崎」"
msgstr ""

#. Occurrence 5B_10:2261:5692: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0014; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2261
msgctxt "text_id=5692 | speaker=aoko"
msgid "「……ないけど。外に出られたところで有珠から逃げきれるとは思えないし。"
msgstr ""

#. Occurrence 5B_10:2268:5693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0015; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2268
msgctxt "text_id=5693 | speaker=aoko"
msgid "けど、これぐらいは最後の意地よ。守るって言ったんだから、できるところまでやらないと」"
msgstr ""

#. Occurrence 5B_10:2343:5694: scene=5B_10
#: 5B_10:2343
msgctxt "text_id=5694 | speaker=unknown"
msgid "　その芯の強さを、彼は驚きながら再認識した。"
msgstr ""

#. Occurrence 5B_10:2348:5695: scene=5B_10
#: 5B_10:2348
msgctxt "text_id=5695 | speaker=unknown"
msgid "　……つまりはそういうこと。"
msgstr ""

#. Occurrence 5B_10:2353:5696: scene=5B_10
#: 5B_10:2353
msgctxt "text_id=5696 | speaker=unknown"
msgid "　彼女は草十郎のためではなく、自分の誇りのために戦っている。"
msgstr ""

#. Occurrence 5B_10:2435:5697: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0011; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2435
msgctxt "text_id=5697 | speaker=soujuurou"
msgid "「……うん、そうだったな。"
msgstr ""

#. Occurrence 5B_10:2441:5698: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0012; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2441
msgctxt "text_id=5698 | speaker=soujuurou"
msgid "　けど、それなら俺だけ逃がすのはらしくないぞ」"
msgstr ""

#. Occurrence 5B_10:2447:5699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0016; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2447
msgctxt "text_id=5699 | speaker=aoko"
msgid "「な、なによ。いいから離れてて」"
msgstr ""

#. Occurrence 5B_10:2453:5700: scene=5B_10
#: 5B_10:2453
msgctxt "text_id=5700 | speaker=unknown"
msgid "　なんとなく、ちょっとだけ後退する青子。"
msgstr ""

#. Occurrence 5B_10:2520:5701: scene=5B_10
#: 5B_10:2520
msgctxt "text_id=5701 | speaker=unknown"
msgid "　つい一時間ほど前、この顔に一本とられた事を思い出したのだ。"
msgstr ""

#. Occurrence 5B_10:2591:5702: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0013; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2591
msgctxt "text_id=5702 | speaker=soujuurou"
msgid "「蒼崎。まだ意地を張れるんなら、他の事をやろう。"
msgstr ""

#. Occurrence 5B_10:2642:5703: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0014; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2642
msgctxt "text_id=5703 | speaker=soujuurou"
msgid "　このお化けみたいな鉄柵を壊せるなら、他に壊すべきものがあるはずだ」"
msgstr ""

#. Occurrence 5B_10:2722:5704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0017; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2722
msgctxt "text_id=5704 | speaker=aoko"
msgid "「ないわよ。悪いけど、私は目に見えるものしか壊せないの。最後までカタチのない希望にすがるとか、考えるのも寒気がする。"
msgstr ""

#. Occurrence 5B_10:2737:5705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0018; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2737
msgctxt "text_id=5705 | speaker=aoko"
msgid "いい？　今はフラットスナークなんかより、この壁を壊してアンタを<足抜|あしぬ>けさせるのが私の現実。私に負える最大限の責任って―――」"
msgstr ""

#. Occurrence 5B_10:2765:5706: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0015; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2765
msgctxt "text_id=5706 | speaker=soujuurou"
msgid "「逃げるのか」"
msgstr ""

#. Occurrence 5B_10:2770:5707: scene=5B_10
#: 5B_10:2770
msgctxt "text_id=5707 | speaker=unknown"
msgid "　背中を向けようとした青子の手が掴まれる。"
msgstr ""

#. Occurrence 5B_10:2845:5708: scene=5B_10
#: 5B_10:2845
msgctxt "text_id=5708 | speaker=unknown"
msgid "　その一言が少女の心を<沸騰|ふっとう>させた。"
msgstr ""

#. Occurrence 5B_10:2850:5709: scene=5B_10
#: 5B_10:2850
msgctxt "text_id=5709 | speaker=unknown"
msgid "　本当に、心臓に火を放たれたようだ。"
msgstr ""

#. Occurrence 5B_10:2855:5710: scene=5B_10
#: 5B_10:2855
msgctxt "text_id=5710 | speaker=unknown"
msgid "　本心を突かれた驚きと、自分自身への不甲斐なさが、凍っていた手足を蘇らせる。"
msgstr ""

#. Occurrence 5B_10:2889:5711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0019; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2889
msgctxt "text_id=5711 | speaker=aoko"
msgid "「誰が―――！　逃げるのはそっちで、逃がしてあげるのはこっちだって言うのよ！　甘く見ないで、いざとなったら遊園地ごと爆破してみせるわ！」"
msgstr ""

#. Occurrence 5B_10:2958:5712: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0016; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2958
msgctxt "text_id=5712 | speaker=soujuurou"
msgid "「そうか。なら、ここで俺を逃がすのは無駄だな。"
msgstr ""

#. Occurrence 5B_10:2965:5713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0017; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2965
msgctxt "text_id=5713 | speaker=soujuurou"
msgid "その気迫は本命のためにとっておこう。それまでは俺も手伝うから」"
msgstr ""

#. Occurrence 5B_10:3053:5714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0020; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3053
msgctxt "text_id=5714 | speaker=aoko"
msgid "「はあ!?　手伝う!?　それこそ無駄な気遣いよ！"
msgstr ""

#. Occurrence 5B_10:3059:5715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0021; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3059
msgctxt "text_id=5715 | speaker=aoko"
msgid "　あったまきた、いいから逃げろバカ！　だいたい、走りづめで息もたえだえなヤツなんか使えないわよ！」"
msgstr ""

#. Occurrence 5B_10:3065:5716: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0018; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3065
msgctxt "text_id=5716 | speaker=soujuurou"
msgid "「そりゃいいかげんヘトヘトだけど。"
msgstr ""

#. Occurrence 5B_10:3072:5717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0019; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3072
msgctxt "text_id=5717 | speaker=soujuurou"
msgid "そういう蒼崎なんか、疲れ以上に傷の方が痛んでるだろ」"
msgstr ""

#. Occurrence 5B_10:3155:5718: scene=5B_10
#: 5B_10:3155
msgctxt "text_id=5718 | speaker=unknown"
msgid "　青子本人ですら忘れかけていた背中の痛み。"
msgstr ""

#. Occurrence 5B_10:3160:5719: scene=5B_10
#: 5B_10:3160
msgctxt "text_id=5719 | speaker=unknown"
msgid "　自動人形に強打された彼女の背中は、今では無視できないほどの痛みを<訴|うった>えていた。"
msgstr ""

#. Occurrence 5B_10:3165:5720: scene=5B_10
#: 5B_10:3165
msgctxt "text_id=5720 | speaker=unknown"
msgid "　青子は単に、鉄の自制心で背中の傷を後回しにしていただけなのだ。"
msgstr ""

#. Occurrence 5B_10:3186:5721: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0020; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3186
msgctxt "text_id=5721 | speaker=soujuurou"
msgid "「ほら。魔術とか抜きにすれば、まだ俺の方がマシじゃないか。入り口までおぶっていくコトぐらいなら、なんとか」"
msgstr ""

#. Occurrence 5B_10:3217:5722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0022; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3217
msgctxt "text_id=5722 | speaker=aoko"
msgid "「できないコトは口にしないで。"
msgstr ""

#. Occurrence 5B_10:3223:5723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0023; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3223
msgctxt "text_id=5723 | speaker=aoko"
msgid "　……もう、いいから行って。慣れているもの、私は。でも貴方は違う。こういうの初めてでしょ？"
msgstr ""

#. Occurrence 5B_10:3229:5724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0024; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3229
msgctxt "text_id=5724 | speaker=aoko"
msgid "　だから、いいの」"
msgstr ""

#. Occurrence 5B_10:3324:5725: scene=5B_10
#: 5B_10:3324
msgctxt "text_id=5725 | speaker=unknown"
msgid "　こうして協力されるのも、"
msgstr ""

#. Occurrence 5B_10:3329:5726: scene=5B_10
#: 5B_10:3329
msgctxt "text_id=5726 | speaker=unknown"
msgid "　結局はそのあと少年を殺さなければいけない事も、"
msgstr ""

#. Occurrence 5B_10:3334:5727: scene=5B_10
#: 5B_10:3334
msgctxt "text_id=5727 | speaker=unknown"
msgid "　全部ひっくるめて彼女は言った。"
msgstr ""

#. Occurrence 5B_10:3340:5728: scene=5B_10
#: 5B_10:3340
msgctxt "text_id=5728 | speaker=unknown"
msgid "　もういいの、と。"
msgstr ""

#. Occurrence 5B_10:3385:5729: scene=5B_10
#: 5B_10:3385
msgctxt "text_id=5729 | speaker=unknown"
msgid "　けれど、草十郎は手を離さなかった。"
msgstr ""

#. Occurrence 5B_10:3390:5730: scene=5B_10
#: 5B_10:3390
msgctxt "text_id=5730 | speaker=unknown"
msgid "　掴んだ手の力は一段と増している。"
msgstr ""

#. Occurrence 5B_10:3395:5731: scene=5B_10
#: 5B_10:3395
msgctxt "text_id=5731 | speaker=unknown"
msgid "　<表情|かお>はいつものままだけど、もしかして怒っているのかな、と青子は眉を<曇|くも>らせた。"
msgstr ""

#. Occurrence 5B_10:3449:5732: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0021; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3449
msgctxt "text_id=5732 | speaker=soujuurou"
msgid "「たしかに、こういうのは初めてだ。"
msgstr ""

#. Occurrence 5B_10:3455:5733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0022; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3455
msgctxt "text_id=5733 | speaker=soujuurou"
msgid "　けど、山じゃ危険な目ぐらいあってる。<鹿|シカ>に襲われた事だってあるんだぞ、俺は」"
msgstr ""

#. Occurrence 5B_10:3522:5734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0025; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3522
msgctxt "text_id=5734 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_10:3542:5735: scene=5B_10
#: 5B_10:3542
msgctxt "text_id=5735 | speaker=unknown"
msgid "　少女は都会の人間で、シカ、なんて単語を出されてもいまいち実感は湧かなかったけれど、少年には確かな覚悟があると感じ取れた。"
msgstr ""

#. Occurrence 5B_10:3569:5736: scene=5B_10
#: 5B_10:3569
msgctxt "text_id=5736 | speaker=unknown"
msgid "　……たしかに。"
msgstr ""

#. Occurrence 5B_10:3574:5737: scene=5B_10
#: 5B_10:3574
msgctxt "text_id=5737 | speaker=unknown"
msgid "　振り返れば、彼は努めて冷静だった。"
msgstr ""

#. Occurrence 5B_10:3579:5738: scene=5B_10
#: 5B_10:3579
msgctxt "text_id=5738 | speaker=unknown"
msgid "　普通ならパニック状態で会話する事さえ困難だろう。"
msgstr ""

#. Occurrence 5B_10:3584:5739: scene=5B_10
#: 5B_10:3584
msgctxt "text_id=5739 | speaker=unknown"
msgid "　それをここまで、なんとか冷静でいようと努力できるのは、文明から離れた山奥で暮らしていたからなのか。"
msgstr ""

#. Occurrence 5B_10:3666:5740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0023; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3666
msgctxt "text_id=5740 | speaker=soujuurou"
msgid "「だから信じてくれ。少しでいいから」"
msgstr ""

#. Occurrence 5B_10:3672:5741: scene=5B_10
#: 5B_10:3672
msgctxt "text_id=5741 | speaker=unknown"
msgid "　飾り気のない本心。"
msgstr ""

#. Occurrence 5B_10:3677:5742: scene=5B_10
#: 5B_10:3677
msgctxt "text_id=5742 | speaker=unknown"
msgid "　簡潔な気持ちを口にして、草十郎は手を離した。"
msgstr ""

#. Occurrence 5B_10:3682:5743: scene=5B_10
#: 5B_10:3682
msgctxt "text_id=5743 | speaker=unknown"
msgid "　……少年の言葉に嘘はない。"
msgstr ""

#. Occurrence 5B_10:3687:5744: scene=5B_10
#: 5B_10:3687
msgctxt "text_id=5744 | speaker=unknown"
msgid "　それが余計、少女には信じられなかった。"
msgstr ""

#. Occurrence 5B_10:3772:5745: scene=5B_10
#: 5B_10:3772
msgctxt "text_id=5745 | speaker=unknown"
msgid "　だって、草十郎にはそこまでの事をする理由がない。"
msgstr ""

#. Occurrence 5B_10:3777:5746: scene=5B_10
#: 5B_10:3777
msgctxt "text_id=5746 | speaker=unknown"
msgid "　今の青子にはあらゆる未来がない。"
msgstr ""

#. Occurrence 5B_10:3782:5747: scene=5B_10
#: 5B_10:3782
msgctxt "text_id=5747 | speaker=unknown"
msgid "　それを白状して逃げろと言っているのに、どうしてこの少年は、こんな自分に協力すると言うのだろう―――"
msgstr ""

#. Occurrence 5B_10:3811:5748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0026; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3811
msgctxt "text_id=5748 | speaker=aoko"
msgid "「分からない。どうしてそこまでするの。"
msgstr ""

#. Occurrence 5B_10:3817:5749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0027; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3817
msgctxt "text_id=5749 | speaker=aoko"
msgid "　私に付き合えば貴方は死ぬのよ。"
msgstr ""

#. Occurrence 5B_10:3824:5750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0028; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3824
msgctxt "text_id=5750 | speaker=aoko"
msgid "これが最後だから、ちゃんと考えてよね。……貴方はここで逃げるべきよ」"
msgstr ""

#. Occurrence 5B_10:3901:5751: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0024; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3901
msgctxt "text_id=5751 | speaker=soujuurou"
msgid "「それは分かるよ。でも行かない」"
msgstr ""

#. Occurrence 5B_10:3906:5752: scene=5B_10
#: 5B_10:3906
msgctxt "text_id=5752 | speaker=unknown"
msgid "　即答しながら、青子はその理由をこそ求めている、と草十郎は気が付いた。"
msgstr ""

#. Occurrence 5B_10:3911:5753: scene=5B_10
#: 5B_10:3911
msgctxt "text_id=5753 | speaker=unknown"
msgid "　普段の彼からすればまさに<喝采|かっさい>ものの察しの良さで、"
msgstr ""

#. Occurrence 5B_10:3926:5754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0025; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3926
msgctxt "text_id=5754 | speaker=soujuurou"
msgid "「そうすると、蒼崎が死んでしまいそうだ」"
msgstr ""

#. Occurrence 5B_10:3931:5755: scene=5B_10
#: 5B_10:3931
msgctxt "text_id=5755 | speaker=unknown"
msgid "　でた言葉は、いつも通りの理由の無さ。"
msgstr ""

#. Occurrence 5B_10:4016:5756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0029; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4016
msgctxt "text_id=5756 | speaker=aoko"
msgid "「だから、どうしてそこまでするのよアンタはっ！」"
msgstr ""

#. Occurrence 5B_10:4021:5757: scene=5B_10
#: 5B_10:4021
msgctxt "text_id=5757 | speaker=unknown"
msgid "　苛立ちから怒鳴り付ける。"
msgstr ""

#. Occurrence 5B_10:4026:5758: scene=5B_10
#: 5B_10:4026
msgctxt "text_id=5758 | speaker=unknown"
msgid "　少年は少しだけ考えこんでから、"
msgstr ""

#. Occurrence 5B_10:4033:5759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0026; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4033
msgctxt "text_id=5759 | speaker=soujuurou"
msgid "「―――そりゃあ、君が好きだからだろ」"
msgstr ""

#. Occurrence 5B_10:4047:5760: scene=5B_10
#: 5B_10:4047
msgctxt "text_id=5760 | speaker=unknown"
msgid "　あっさりと。"
msgstr ""

#. Occurrence 5B_10:4052:5761: scene=5B_10
#: 5B_10:4052
msgctxt "text_id=5761 | speaker=unknown"
msgid "　なんでそんなこと訊くんだ？　なんて顔で返答した。"
msgstr ""

#. Occurrence 5B_10:4142:5762: scene=5B_10
#: 5B_10:4142
msgctxt "text_id=5762 | speaker=unknown"
msgid "　……一秒か、たぶん二秒ほど。"
msgstr ""

#. Occurrence 5B_10:4147:5763: scene=5B_10
#: 5B_10:4147
msgctxt "text_id=5763 | speaker=unknown"
msgid "　あまりの不意打ちに、青子の時間は止まってしまった。"
msgstr ""

#. Occurrence 5B_10:4152:5764: scene=5B_10
#: 5B_10:4152
msgctxt "text_id=5764 | speaker=unknown"
msgid "　切り札を隠していたのは有珠だけではなかったようだ。"
msgstr ""

#. Occurrence 5B_10:4157:5765: scene=5B_10
#: 5B_10:4157
msgctxt "text_id=5765 | speaker=unknown"
msgid "　今の一言は、フラットスナークなんかより底が深い。"
msgstr ""

#. Occurrence 5B_10:4177:5766: scene=5B_10
#: 5B_10:4177
msgctxt "text_id=5766 | speaker=unknown"
msgid "　青子にとってはただただ呆れるばかりの返答。"
msgstr ""

#. Occurrence 5B_10:4182:5767: scene=5B_10
#: 5B_10:4182
msgctxt "text_id=5767 | speaker=unknown"
msgid "　けれど単純で頑強な、地上でいちばん強い理由。"
msgstr ""

#. Occurrence 5B_10:4215:5768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0030; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4215
msgctxt "text_id=5768 | speaker=aoko"
msgid "「―――はあ」"
msgstr ""

#. Occurrence 5B_10:4280:5769: scene=5B_10
#: 5B_10:4280
msgctxt "text_id=5769 | speaker=unknown"
msgid "　自分を殺そうとしている相手に無条件で協力出来るなんて、静希草十郎はやっぱり分からない。"
msgstr ""

#. Occurrence 5B_10:4285:5770: scene=5B_10
#: 5B_10:4285
msgctxt "text_id=5770 | speaker=unknown"
msgid "　ただ少しだけ、青子はこの少年の<為人|ひととなり>が掴めた気がした。"
msgstr ""

#. Occurrence 5B_10:4291:5771: scene=5B_10
#: 5B_10:4291
msgctxt "text_id=5771 | speaker=unknown"
msgid "　鳶丸たちの評価は、たぶん、間違ってはいないのだ。"
msgstr ""

msgctxt "text_id=5772 | speaker=unknown"
msgid "口惜しいことに。"
msgstr ""

#. Occurrence 5B_10:4378:5773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0031; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4378
msgctxt "text_id=5773 | speaker=aoko"
msgid "「莫迦ね。私は貴方のこと、嫌いなのに」"
msgstr ""

#. Occurrence 5B_10:4438:5774: scene=5B_10
#: 5B_10:4438
msgctxt "text_id=5774 | speaker=unknown"
msgid "　なんだか負け惜しみのような呟きに、少年は知ってるよ、と苦笑した。"
msgstr ""

#. Occurrence 5B_10:4519:5775: scene=5B_10
#: 5B_10:4519
msgctxt "text_id=5775 | speaker=unknown"
msgid "　意地の張り合いはここで終わり。"
msgstr ""

#. Occurrence 5B_10:4524:5776: scene=5B_10
#: 5B_10:4524
msgctxt "text_id=5776 | speaker=unknown"
msgid "　火を放たれた心臓が、青子の体に熱い血液を走らせる。"
msgstr ""

#. Occurrence 5B_10:4529:5777: scene=5B_10
#: 5B_10:4529
msgctxt "text_id=5777 | speaker=unknown"
msgid "　だってあんな顔をされたら、ふたりそろって生還する方法しか考えられない。"
msgstr ""

#. Occurrence 5B_10:4605:5778: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0032; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4605
msgctxt "text_id=5778 | speaker=aoko"
msgid "「……ま、私だって逃げっぱなしは性に合わないし。"
msgstr ""

#. Occurrence 5B_10:4611:5779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0033; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4611
msgctxt "text_id=5779 | speaker=aoko"
msgid "　いいわよ、最後まで粘ってみる。それに静希君が付き合ってくれるなら、何かの役には立つでしょう」"
msgstr ""

#. Occurrence 5B_10:4637:5780: scene=5B_10
#: 5B_10:4637
msgctxt "text_id=5780 | speaker=unknown"
msgid "　軽口を叩きながらも、青子の眼にはまだ迷いがあった。"
msgstr ""

#. Occurrence 5B_10:4642:5781: scene=5B_10
#: 5B_10:4642
msgctxt "text_id=5781 | speaker=unknown"
msgid "　当然だ。戦うも何も、青子にはスナークの正体、その糸口すら掴めていない。"
msgstr ""

#. Occurrence 5B_10:4647:5782: scene=5B_10
#: 5B_10:4647
msgctxt "text_id=5782 | speaker=unknown"
msgid "　自分がもう少し器用で、もう少しだけ修練を積んでいたのなら、あるいはスナークを探る手段もあっただろうに。"
msgstr ""

#. Occurrence 5B_10:4803:5783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0034; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4803
msgctxt "text_id=5783 | speaker=aoko"
msgid "「……我ながら情けない。せめて、正体を暴く手がかりでもあればいいんだけど」"
msgstr ""

#. Occurrence 5B_10:4809:5784: scene=5B_10
#: 5B_10:4809
msgctxt "text_id=5784 | speaker=unknown"
msgid "　知らず、不安をこぼす。"
msgstr ""

#. Occurrence 5B_10:4814:5785: scene=5B_10
#: 5B_10:4814
msgctxt "text_id=5785 | speaker=unknown"
msgid "　こんな弱音、口にしても仕方がない。"
msgstr ""

#. Occurrence 5B_10:4819:5786: scene=5B_10
#: 5B_10:4819
msgctxt "text_id=5786 | speaker=unknown"
msgid "　その問題は自分が解決するしかない、と青子は自らを<鼓|こ><舞|ぶ>しようとして、"
msgstr ""

#. Occurrence 5B_10:4937:5787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0027; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4937
msgctxt "text_id=5787 | speaker=soujuurou"
msgid "「ん？　なんだ、正体さえ分かればいいのか？」"
msgstr ""

#. Occurrence 5B_10:4951:5788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0035; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4951
msgctxt "text_id=5788 | speaker=aoko"
msgid "「へ？」"
msgstr ""

#. Occurrence 5B_10:4956:5789: scene=5B_10
#: 5B_10:4956
msgctxt "text_id=5789 | speaker=unknown"
msgid "　なにそれどういうイミ？　なんて顔をする青子と、"
msgstr ""

#. Occurrence 5B_10:4970:5790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0028; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4970
msgctxt "text_id=5790 | speaker=soujuurou"
msgid "「いや、だからおかしなモノはどれかってコトだろ？」"
msgstr ""

#. Occurrence 5B_10:4975:5791: scene=5B_10
#: 5B_10:4975
msgctxt "text_id=5791 | speaker=unknown"
msgid "　言ってくれれば良かったのに、なんて顔をする草十郎。"
msgstr ""

#. Occurrence 5B_10:5072:5792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0036; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5072
msgctxt "text_id=5792 | speaker=aoko"
msgid "「ちょっ―――分かるの、アンタ!?」"
msgstr ""

#. Occurrence 5B_10:5078:5793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0029; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:5078
msgctxt "text_id=5793 | speaker=soujuurou"
msgid "「たぶん。いや、けっこう前から気になっていたんだけど」"
msgstr ""

#. Occurrence 5B_10:5099:5794: scene=5B_10
#: 5B_10:5099
msgctxt "text_id=5794 | speaker=unknown"
msgid "　草十郎は誰かに聞かれないよう、こっそりと青子に耳打ちをする。"
msgstr ""

#. Occurrence 5B_10:5171:5795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0037; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5171
msgctxt "text_id=5795 | speaker=aoko"
msgid "「――――――あ」"
msgstr ""

#. Occurrence 5B_10:5183:5796: scene=5B_10
#: 5B_10:5183
msgctxt "text_id=5796 | speaker=unknown"
msgid "　意外と言えば意外、"
msgstr ""

#. Occurrence 5B_10:5188:5797: scene=5B_10
#: 5B_10:5188
msgctxt "text_id=5797 | speaker=unknown"
msgid "　当然と言えば当然の“間違い”を教えられて、青子はその“答え”が正しい事を直感した。"
msgstr ""

#. Occurrence 5B_10:5194:5798: scene=5B_10
#: 5B_10:5194
msgctxt "text_id=5798 | speaker=unknown"
msgid "　敵の正体。フラットスナークの本体とは、つまり―――"
msgstr ""

#. Occurrence 5B_11:401:5799: scene=5B_11
#: 5B_11:401
msgctxt "text_id=5799 | speaker=unknown"
msgid "　密談は十分で終わった。"
msgstr ""

#. Occurrence 5B_11:406:5800: scene=5B_11
#: 5B_11:406
msgctxt "text_id=5800 | speaker=unknown"
msgid "　スナーク本体の考察と、その撃破方法を導きだして、ふたりは互いの役割に頷きあう。"
msgstr ""

#. Occurrence 5B_11:438:5801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0000; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:438
msgctxt "text_id=5801 | speaker=aoko"
msgid "「それじゃ、ここからは別行動ね。"
msgstr ""

#. Occurrence 5B_11:444:5802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0001; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:444
msgctxt "text_id=5802 | speaker=aoko"
msgid "　でもミラーハウスの時みたいなのは勘弁してよ。この作戦の<肝|きも>は貴方なんだから。開始一分でドジったら、ホントに打つ手なしだからね」"
msgstr ""

#. Occurrence 5B_11:523:5803: scene=5B_11
#: 5B_11:523
msgctxt "text_id=5803 | speaker=unknown"
msgid "　ミラーハウスでの囮役失敗の件をチクチクとつつく青子だが、その声は明るい。"
msgstr ""

#. Occurrence 5B_11:528:5804: scene=5B_11
#: 5B_11:528
msgctxt "text_id=5804 | speaker=unknown"
msgid "　草十郎の発見からこっち、彼女本来の力強さが戻っている。"
msgstr ""

#. Occurrence 5B_11:599:5805: scene=5B_11
#: 5B_11:599
msgctxt "text_id=5805 | speaker=unknown"
msgid "　一方、草十郎も彼なりに真剣だ。"
msgstr ""

#. Occurrence 5B_11:604:5806: scene=5B_11
#: 5B_11:604
msgctxt "text_id=5806 | speaker=unknown"
msgid "　青子の注意を真面目に受けとめている。"
msgstr ""

#. Occurrence 5B_11:690:5807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0002; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:690
msgctxt "text_id=5807 | speaker=aoko"
msgid "「……ならいいけど。いい、さっきと立場は反対よ。"
msgstr ""

#. Occurrence 5B_11:696:5808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0003; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:696
msgctxt "text_id=5808 | speaker=aoko"
msgid "　失敗したら死ぬのは私じゃなくてそっち。もうフォローに回れないから、できるだけ慎重にね」"
msgstr ""

#. Occurrence 5B_11:768:5809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_11_0000; voice_prefix=A30; voice_category=3; scene=5B_11
#: 5B_11:768
msgctxt "text_id=5809 | speaker=soujuurou"
msgid "「分かってる。いまさらながら、やっぱりさっき逃がしてもらえば良かったと思うぐらい、慎重だ」"
msgstr ""

#. Occurrence 5B_11:774:5810: scene=5B_11
#: 5B_11:774
msgctxt "text_id=5810 | speaker=unknown"
msgid "　任せてくれ、と頷く草十郎。恨み言のような台詞だが、彼なりに決意を表しているらしい。"
msgstr ""

#. Occurrence 5B_11:779:5811: scene=5B_11
#: 5B_11:779
msgctxt "text_id=5811 | speaker=unknown"
msgid "　ちぐはぐで分かりづらい草十郎の仕草に、青子はまったく、と降参するようなため息ひとつ。"
msgstr ""

#. Occurrence 5B_11:853:5812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0004; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:853
msgctxt "text_id=5812 | speaker=aoko"
msgid "「ほんと、大バカなんだか大物なんだか。"
msgstr ""

#. Occurrence 5B_11:865:5813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0005; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:865
msgctxt "text_id=5813 | speaker=aoko"
msgid "　―――でも任せた。期待してるわ、静希君」"
msgstr ""

#. Occurrence 5B_11:924:5814: scene=5B_11
#: 5B_11:924
msgctxt "text_id=5814 | speaker=unknown"
msgid "　信じている、と返してやりたかったが、さすがにそれは気恥ずかしかったらしい。"
msgstr ""

#. Occurrence 5B_11:1009:5815: scene=5B_11
#: 5B_11:1009
msgctxt "text_id=5815 | speaker=unknown"
msgid "　青子は草十郎に背を向けて走り出す。"
msgstr ""

#. Occurrence 5B_11:1014:5816: scene=5B_11
#: 5B_11:1014
msgctxt "text_id=5816 | speaker=unknown"
msgid "　まあ、こういう風にペースを崩されるのも、たまにはいいかもしれない、なんて思いながら。"
msgstr ""

#. Occurrence 5B_11:1065:5817: scene=5B_11
#: 5B_11:1065
msgctxt "text_id=5817 | speaker=unknown"
msgid "　―――休憩は終わりを告げた。"
msgstr ""

#. Occurrence 5B_11:1070:5818: scene=5B_11
#: 5B_11:1070
msgctxt "text_id=5818 | speaker=unknown"
msgid "　未熟な役者に新たな脚本が手渡される。"
msgstr ""

#. Occurrence 5B_11:1076:5819: scene=5B_11
#: 5B_11:1076
msgctxt "text_id=5819 | speaker=unknown"
msgid "　さて、結果はどうあれ。"
msgstr ""

#. Occurrence 5B_11:1081:5820: scene=5B_11
#: 5B_11:1081
msgctxt "text_id=5820 | speaker=unknown"
msgid "　長かった魔法使いの夜は、最後の幕に入ったらしい。"
msgstr ""

#. Occurrence 5B_12:87:5821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0000; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:87
msgctxt "text_id=5821 | speaker=alice"
msgid "「―――別行動？　あの二人が？」"
msgstr ""

#. Occurrence 5B_12:105:5822: scene=5B_12
#: 5B_12:105
msgctxt "text_id=5822 | speaker=unknown"
msgid "　駒鳥からの報告に、少女は不吉な響きを感じとった。"
msgstr ""

#. Occurrence 5B_12:110:5823: scene=5B_12
#: 5B_12:110
msgctxt "text_id=5823 | speaker=unknown"
msgid "　彼らはそれぞれ反対方向に移動したらしい。"
msgstr ""

#. Occurrence 5B_12:115:5824: scene=5B_12
#: 5B_12:115
msgctxt "text_id=5824 | speaker=unknown"
msgid "　遊園地の住人たちは目撃者の少年を追いかけ、あと数分で捕まえ、処理するという。"
msgstr ""

#. Occurrence 5B_12:191:5825: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0001; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:191
msgctxt "text_id=5825 | speaker=alice"
msgid "「……どういう事？　追いかけているのは本当に彼？　青子が変装しているのではなく？」"
msgstr ""

#. Occurrence 5B_12:198:5826: scene=5B_12
#: 5B_12:198
msgctxt "text_id=5826 | speaker=unknown"
msgid "　駒鳥は羽をすくめて主人の疑いを鳴きとばす。"
msgstr ""

#. Occurrence 5B_12:203:5827: scene=5B_12
#: 5B_12:203
msgctxt "text_id=5827 | speaker=unknown"
msgid "　自分の目に間違いはない、広場方面に向かっているのは青子で、コースター方面に逃げているのはとっぽい小僧だと。"
msgstr ""

#. Occurrence 5B_12:270:5828: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0002; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:270
msgctxt "text_id=5828 | speaker=alice"
msgid "「青子が彼を見捨てた、ですって？"
msgstr ""

#. Occurrence 5B_12:306:5829: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_0; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:306
msgctxt "text_id=5829 | speaker=alice"
msgid "　……そんな簡単な事ならいいけど。"
msgstr ""

#. Occurrence 5B_12:318:5830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_1; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:318
msgctxt "text_id=5830 | speaker=alice"
msgid "ダンプティは彼に張り付いているの？」"
msgstr ""

#. Occurrence 5B_12:324:5831: scene=5B_12
#: 5B_12:324
msgctxt "text_id=5831 | speaker=unknown"
msgid "　駒鳥は自信満々に頷く。"
msgstr ""

#. Occurrence 5B_12:329:5832: scene=5B_12
#: 5B_12:329
msgctxt "text_id=5832 | speaker=unknown"
msgid "　他の鳥はともかく、夜目の利く自分ならここからでもあのカモネギっぽい坊主を見て取れる。なにしろ相手は<高|・><い|・><と|・><こ|・><ろ|・><に|・><登|・><っ|・><て|・><い|・><る|・>し。"
msgstr ""

#. Occurrence 5B_12:420:5833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0004; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:420
msgctxt "text_id=5833 | speaker=alice"
msgid "「ダンプティはなんて？"
msgstr ""

#. Occurrence 5B_12:447:5834: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0005; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:447
msgctxt "text_id=5834 | speaker=alice"
msgid "　……最後まで<吟|うた>わせろ、こんな<褒|ほ>め殺したい<間|ま><抜|ぬ>けはまたとない、ですって？」"
msgstr ""

#. Occurrence 5B_12:512:5835: scene=5B_12
#: 5B_12:512
msgctxt "text_id=5835 | speaker=unknown"
msgid "　スクラッチダンプティは、捕捉した対象が目を離した途端に落下し、破裂する時限爆弾だ。"
msgstr ""

#. Occurrence 5B_12:517:5836: scene=5B_12
#: 5B_12:517
msgctxt "text_id=5836 | speaker=unknown"
msgid "　対象がきちんと監視していれば落下しない、ある意味紳士的な“<童話の怪物|プロイキッシャー>”。だが乱戦時においてこれほどの嫌がらせもないだろう。"
msgstr ""

#. Occurrence 5B_12:554:5837: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0006; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:554
msgctxt "text_id=5837 | speaker=alice"
msgid "「……そうね。視線を切らないだけではダンプティからは逃げられない。表面の詩が完成すれば扉が開く。"
msgstr ""

#. Occurrence 5B_12:560:5838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0007; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:560
msgctxt "text_id=5838 | speaker=alice"
msgid "　彼がどこまで逃げようと、あと少しでダンプティが仕舞ってくれるわ」"
msgstr ""

#. Occurrence 5B_12:605:5839: scene=5B_12
#: 5B_12:605
msgctxt "text_id=5839 | speaker=unknown"
msgid "　何処に行こうと、この遊園地―――いや、スナークが破壊されない以上、少年は逃げられない。"
msgstr ""

#. Occurrence 5B_12:610:5840: scene=5B_12
#: 5B_12:610
msgctxt "text_id=5840 | speaker=unknown"
msgid "　なら気になるのは青子の方だ。"
msgstr ""

#. Occurrence 5B_12:615:5841: scene=5B_12
#: 5B_12:615
msgctxt "text_id=5841 | speaker=unknown"
msgid "　あの少年を守ると言い切った彼女は、いま何処に向かっているのか。"
msgstr ""

#. Occurrence 5B_12:687:5842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0008; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:687
msgctxt "text_id=5842 | speaker=alice"
msgid "「……ここにいるかぎり、青子の動向は掴めない」"
msgstr ""

#. Occurrence 5B_12:762:5843: scene=5B_12
#: 5B_12:762
msgctxt "text_id=5843 | speaker=unknown"
msgid "　羽を広げて存在をアピールする駒鳥を無視して、少女は遊園地を見渡した。"
msgstr ""

#. Occurrence 5B_12:836:5844: scene=5B_12
#: 5B_12:836
msgctxt "text_id=5844 | speaker=unknown"
msgid "　フラットスナークはもうじき育ちきる。"
msgstr ""

#. Occurrence 5B_12:841:5845: scene=5B_12
#: 5B_12:841
msgctxt "text_id=5845 | speaker=unknown"
msgid "　他の安価なプロイとは根本からして違う怪物。"
msgstr ""

#. Occurrence 5B_12:846:5846: scene=5B_12
#: 5B_12:846
msgctxt "text_id=5846 | speaker=unknown"
msgid "　少女にとって代えのきかない、貴重な三体の使い魔のうち一体。"
msgstr ""

#. Occurrence 5B_12:932:5847: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5847 | speaker=alice"
msgid "「……そうね。任せたわスナーク。"
msgstr ""

#. Occurrence 5B_12:932:5848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5848 | speaker=alice"
msgid "　青子が<諦|あきら>めない以上、貴方も手は抜かないで」"
msgstr ""

#. Occurrence 5B_12:938:5849: scene=5B_12
#: 5B_12:938
msgctxt "text_id=5849 | speaker=unknown"
msgid "　少女は動かない。"
msgstr ""

#. Occurrence 5B_12:943:5850: scene=5B_12
#: 5B_12:943
msgctxt "text_id=5850 | speaker=unknown"
msgid "　橋の巨人、毒爪トカゲと同じ<歴|か><史|ち>を持つ、<至高|しこう>のプロイ、フラットスナーク。"
msgstr ""

#. Occurrence 5B_12:948:5851: scene=5B_12
#: 5B_12:948
msgctxt "text_id=5851 | speaker=unknown"
msgid "　その名と能力を、ここは信頼する事にした。"
msgstr ""

#. Occurrence 5B_12:998:5852: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0010; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:998
msgctxt "text_id=5852 | speaker=alice"
msgid "「でも忘れないで。これはゲームよ。"
msgstr ""

#. Occurrence 5B_12:1004:5853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0011; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:1004
msgctxt "text_id=5853 | speaker=alice"
msgid "　勝敗がついたのなら、わたしのところに帰ってきて」"
msgstr ""

#. Occurrence 5B_12:1068:5854: scene=5B_12
#: 5B_12:1068
msgctxt "text_id=5854 | speaker=unknown"
msgid "“―――――――――”"
msgstr ""

#. Occurrence 5B_12:1074:5855: scene=5B_12
#: 5B_12:1074
msgctxt "text_id=5855 | speaker=unknown"
msgid "　主の言葉を、<漂|ただよ>う霧は聞き流す。"
msgstr ""

#. Occurrence 5B_12:1079:5856: scene=5B_12
#: 5B_12:1079
msgctxt "text_id=5856 | speaker=unknown"
msgid "　……有珠もそこだけは読み違えていた。"
msgstr ""

#. Occurrence 5B_12:1085:5857: scene=5B_12
#: 5B_12:1085
msgctxt "text_id=5857 | speaker=unknown"
msgid "フラットスナークはプロイの中でも<最悪|さいあく><低俗|ていぞく>な道化の王さま。"
msgstr ""

#. Occurrence 5B_12:1090:5858: scene=5B_12
#: 5B_12:1090
msgctxt "text_id=5858 | speaker=unknown"
msgid "　敗者には死を。惨たらしい悲劇を。"
msgstr ""

#. Occurrence 5B_12:1096:5859: scene=5B_12
#: 5B_12:1096
msgctxt "text_id=5859 | speaker=unknown"
msgid "財布も命も取りこぼす、素晴らしい破産じゃないと愉しめない。"
msgstr ""

#. Occurrence 5B_12:1116:5860: scene=5B_12
#: 5B_12:1116
msgctxt "text_id=5860 | speaker=unknown"
msgid "“―――――――――”"
msgstr ""

#. Occurrence 5B_12:1122:5861: scene=5B_12
#: 5B_12:1122
msgctxt "text_id=5861 | speaker=unknown"
msgid "　<邪|よこしま>な笑みのように霧が煙る。"
msgstr ""

#. Occurrence 5B_12:1127:5862: scene=5B_12
#: 5B_12:1127
msgctxt "text_id=5862 | speaker=unknown"
msgid "　そう。負かした相手をどう扱うかなんて、それこそ王さまの特権で、スナークは自分の欲望を止められない。"
msgstr ""

#. Occurrence 5B_12:1132:5863: scene=5B_12
#: 5B_12:1132
msgctxt "text_id=5863 | speaker=unknown"
msgid "　なので―――"
msgstr ""

#. Occurrence 5B_12:1138:5864: scene=5B_12
#: 5B_12:1138
msgctxt "text_id=5864 | speaker=unknown"
msgid "　たとえ主人の言いつけであろうと、行儀の良いフェアプレーなんて、これっぽっちも、守る気はなかったのだ。"
msgstr ""

#. Occurrence 5B_13:119:5865: scene=5B_13
#: 5B_13:119
msgctxt "text_id=5865 | speaker=unknown"
msgid "　地上四十メートルの高み。"
msgstr ""

#. Occurrence 5B_13:124:5866: scene=5B_13
#: 5B_13:124
msgctxt "text_id=5866 | speaker=unknown"
msgid "　遊園地の中心へ向かって延びる<骨組み|レール>の上を、慎重に慎重に、足場を確認しながら登っていく人影が一つ。"
msgstr ""

#. Occurrence 5B_13:145:5867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0000; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:145
msgctxt "text_id=5867 | speaker=soujuurou"
msgid "「―――、―――」"
msgstr ""

#. Occurrence 5B_13:151:5868: scene=5B_13
#: 5B_13:151
msgctxt "text_id=5868 | speaker=unknown"
msgid "　押さえつけているのは動悸と呼吸だ。"
msgstr ""

#. Occurrence 5B_13:156:5869: scene=5B_13
#: 5B_13:156
msgctxt "text_id=5869 | speaker=unknown"
msgid "　今はそんな、わずかな動作すら前進の邪魔になる。"
msgstr ""

#. Occurrence 5B_13:253:5870: scene=5B_13
#: 5B_13:253
msgctxt "text_id=5870 | speaker=unknown"
msgid "　顔面蒼白でより高い位置を目指しているのは、あろう事か静希草十郎である。"
msgstr ""

#. Occurrence 5B_13:258:5871: scene=5B_13
#: 5B_13:258
msgctxt "text_id=5871 | speaker=unknown"
msgid "　遥か地上を見下ろせば、コースター乗り場には焼きたてパンたちの群れ。"
msgstr ""

#. Occurrence 5B_13:263:5872: scene=5B_13
#: 5B_13:263
msgctxt "text_id=5872 | speaker=unknown"
msgid "　入り口で右往左往している彼らは刻一刻と数を増やしながら、レールを登っていく草十郎へ<諸手|もろて>を挙げての応援中。"
msgstr ""

#. Occurrence 5B_13:268:5873: scene=5B_13
#: 5B_13:268
msgctxt "text_id=5873 | speaker=unknown"
msgid "　もとい、下りてこいとブーイングをあげている。"
msgstr ""

#. Occurrence 5B_13:289:5874: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0001; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:289
msgctxt "text_id=5874 | speaker=soujuurou"
msgid "「……助かった。アレ、高いところは苦手なんだ」"
msgstr ""

#. Occurrence 5B_13:329:5875: scene=5B_13
#: 5B_13:329
msgctxt "text_id=5875 | speaker=unknown"
msgid "　もちろん草十郎も苦手だが、彼らに包囲されないのなら、これはこれで少しだけマシである。"
msgstr ""

#. Occurrence 5B_13:400:5876: scene=5B_13
#: 5B_13:400
msgctxt "text_id=5876 | speaker=unknown"
msgid "　追ってきているのは浮遊する卵だけ。"
msgstr ""

#. Occurrence 5B_13:405:5877: scene=5B_13
#: 5B_13:405
msgctxt "text_id=5877 | speaker=unknown"
msgid "　草十郎は大きく息をついた後、やや前屈みになって、天に向かって延びるコースターを登っていく。"
msgstr ""

#. Occurrence 5B_13:410:5878: scene=5B_13
#: 5B_13:410
msgctxt "text_id=5878 | speaker=unknown"
msgid "　これで地上四十八メートル。"
msgstr ""

#. Occurrence 5B_13:415:5879: scene=5B_13
#: 5B_13:415
msgctxt "text_id=5879 | speaker=unknown"
msgid "　ビルで言うなら十六階の高さに相当する。"
msgstr ""

#. Occurrence 5B_13:459:5880: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0002; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:459
msgctxt "text_id=5880 | speaker=soujuurou"
msgid "「っ、―――……！」"
msgstr ""

#. Occurrence 5B_13:513:5881: scene=5B_13
#: 5B_13:513
msgctxt "text_id=5881 | speaker=unknown"
msgid "　強風が髪をさらう。"
msgstr ""

#. Occurrence 5B_13:518:5882: scene=5B_13
#: 5B_13:518
msgctxt "text_id=5882 | speaker=unknown"
msgid "　人間は根本的に高所を恐れる生き物だ。"
msgstr ""

#. Occurrence 5B_13:523:5883: scene=5B_13
#: 5B_13:523
msgctxt "text_id=5883 | speaker=unknown"
msgid "　ことに、このように落下のイメージを想起させる場所では、本人にその気がなくとも膝が震える。"
msgstr ""

#. Occurrence 5B_13:528:5884: scene=5B_13
#: 5B_13:528
msgctxt "text_id=5884 | speaker=unknown"
msgid "　死を<警戒|けいかい>する本能が、安全な地上への<回帰|かいき>を<促|うなが>している。"
msgstr ""

#. Occurrence 5B_13:548:5885: scene=5B_13
#: 5B_13:548
msgctxt "text_id=5885 | speaker=unknown"
msgid "　それも無理からぬ事。"
msgstr ""

#. Occurrence 5B_13:553:5886: scene=5B_13
#: 5B_13:553
msgctxt "text_id=5886 | speaker=unknown"
msgid "　ジェットコースターのレールを人力で登ろうなどと、笑い話を通り越してファンタジーの領域なのだから。"
msgstr ""

#. Occurrence 5B_13:562:5887: scene=5B_13
#: 5B_13:562
msgctxt "text_id=5887 | speaker=unknown"
msgid "　気圧や強風による妨害。"
msgstr ""

#. Occurrence 5B_13:567:5888: scene=5B_13
#: 5B_13:567
msgctxt "text_id=5888 | speaker=unknown"
msgid "　本能からの中止勧告、痺れる手足、筋力の衰え、とりとめなく暴走する思考。"
msgstr ""

#. Occurrence 5B_13:573:5889: scene=5B_13
#: 5B_13:573
msgctxt "text_id=5889 | speaker=unknown"
msgid "仮に命綱をしていようと、五メートルも登れば思考は恐怖で固まってしまう。"
msgstr ""

#. Occurrence 5B_13:593:5890: scene=5B_13
#: 5B_13:593
msgctxt "text_id=5890 | speaker=unknown"
msgid "　加えて、この苦しみは倍々ゲームだ。"
msgstr ""

#. Occurrence 5B_13:598:5891: scene=5B_13
#: 5B_13:598
msgctxt "text_id=5891 | speaker=unknown"
msgid "　一メートル進めば、それだけ肉体と精神にかかる負担はいや増していく。"
msgstr ""

#. Occurrence 5B_13:667:5892: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0003; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:667
msgctxt "text_id=5892 | speaker=soujuurou"
msgid "「―――よし。頂上まであと少し―――」"
msgstr ""

#. Occurrence 5B_13:673:5893: scene=5B_13
#: 5B_13:673
msgctxt "text_id=5893 | speaker=unknown"
msgid "　そんな精神の負担はともかく、体の調子を注意深く<測|はか>りながら草十郎は前進する。"
msgstr ""

#. Occurrence 5B_13:678:5894: scene=5B_13
#: 5B_13:678
msgctxt "text_id=5894 | speaker=unknown"
msgid "　走りづめだった足は、気を抜いたとたん、膝から崩れかねない。"
msgstr ""

#. Occurrence 5B_13:684:5895: scene=5B_13
#: 5B_13:684
msgctxt "text_id=5895 | speaker=unknown"
msgid "青子が“草十郎の方が危ない”と念を押したのも、疲労しきった体では危険すぎるからだろう。"
msgstr ""

#. Occurrence 5B_13:721:5896: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0004; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:721
msgctxt "text_id=5896 | speaker=soujuurou"
msgid "「……待てよ。逆を言うと、疲れてなければなんとかなると思ってたんだよな、蒼崎は」"
msgstr ""

#. Occurrence 5B_13:775:5897: scene=5B_13
#: 5B_13:775
msgctxt "text_id=5897 | speaker=unknown"
msgid "　ふわふわ浮遊する卵を眺めながら、草十郎は思い出し笑いをする。"
msgstr ""

#. Occurrence 5B_13:780:5898: scene=5B_13
#: 5B_13:780
msgctxt "text_id=5898 | speaker=unknown"
msgid "　こんな無茶をする事になった<顛末|てんまつ>。"
msgstr ""

#. Occurrence 5B_13:785:5899: scene=5B_13
#: 5B_13:785
msgctxt "text_id=5899 | speaker=unknown"
msgid "　ほんの十分前、ふたりはこんな会話を交わしていた。"
msgstr ""

#. Occurrence 5B_13:836:5900: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0000; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:836
msgctxt "text_id=5900 | speaker=aoko"
msgid "「じゃあ次ね。正体が分かった以上、あとはどう壊すかを話しあいましょう」"
msgstr ""

#. Occurrence 5B_13:936:5901: scene=5B_13
#: 5B_13:936
msgctxt "text_id=5901 | speaker=unknown"
msgid "　にんまりと笑う青子に、ぞぞっと背筋が寒くなる草十郎。"
msgstr ""

#. Occurrence 5B_13:941:5902: scene=5B_13
#: 5B_13:941
msgctxt "text_id=5902 | speaker=unknown"
msgid "　……思えば、この時から青子は草十郎に無茶をさせる気満々だったのだ。"
msgstr ""

#. Occurrence 5B_13:1013:5903: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0005; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1013
msgctxt "text_id=5903 | speaker=soujuurou"
msgid "「どう壊すかって、それなら」"
msgstr ""

#. Occurrence 5B_13:1019:5904: scene=5B_13
#: 5B_13:1019
msgctxt "text_id=5904 | speaker=unknown"
msgid "　この鉄柵を外まで壊せる魔術があるのなら考えるまでもないのでは、と手を挙げる草十郎。"
msgstr ""

#. Occurrence 5B_13:1024:5905: scene=5B_13
#: 5B_13:1024
msgctxt "text_id=5905 | speaker=unknown"
msgid "　彼がこれまでフラットスナークの本体について意見しなかったのは、ひとえに『分かっていてもどうしようもない』と思っていたからだ。"
msgstr ""

#. Occurrence 5B_13:1044:5906: scene=5B_13
#: 5B_13:1044
msgctxt "text_id=5906 | speaker=unknown"
msgid "　が、今は条件が違う。"
msgstr ""

#. Occurrence 5B_13:1049:5907: scene=5B_13
#: 5B_13:1049
msgctxt "text_id=5907 | speaker=unknown"
msgid "　青子なら文字通り、不可能に手が届く。"
msgstr ""

#. Occurrence 5B_13:1122:5908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0001; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1122
msgctxt "text_id=5908 | speaker=aoko"
msgid "「そうでもないわ。私の目算だと、あと五十メートル分、ギリギリで届かない」"
msgstr ""

#. Occurrence 5B_13:1136:5909: scene=5B_13
#: 5B_13:1136
msgctxt "text_id=5909 | speaker=unknown"
msgid "　だめじゃないか、と目で<訴|うった>える草十郎。"
msgstr ""

#. Occurrence 5B_13:1209:5910: scene=5B_13
#: 5B_13:1209
msgctxt "text_id=5910 | speaker=unknown"
msgid "　青子は自分の長髪に手をやると、魔力をこめた指で、<一房|ひとふさ>スパッと切った。"
msgstr ""

#. Occurrence 5B_13:1290:5911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0002; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1290
msgctxt "text_id=5911 | speaker=aoko"
msgid "「足りない分は努力と根性ってね。"
msgstr ""

#. Occurrence 5B_13:1296:5912: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0003; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1296
msgctxt "text_id=5912 | speaker=aoko"
msgid "　貴方はできるだけ高いところまで逃げて。頃合いを見て合図をだすから、そうしたらこれを空に放ってくれる？　静希君の役目はそれだけでいいから」"
msgstr ""

#. Occurrence 5B_13:1323:5913: scene=5B_13
#: 5B_13:1323
msgctxt "text_id=5913 | speaker=unknown"
msgid "　そう言う青子の視線は、とても“できるだけ”なんて言ってはいなかった。"
msgstr ""

#. Occurrence 5B_13:1328:5914: scene=5B_13
#: 5B_13:1328
msgctxt "text_id=5914 | speaker=unknown"
msgid "　彼女はこれみよがしに、遊園地二大アトラクションの一つ、ジェットコースターを見つめている。"
msgstr ""

#. Occurrence 5B_13:1349:5915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0006; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1349
msgctxt "text_id=5915 | speaker=soujuurou"
msgid "「…………。つまり、蒼崎とは別行動をとって、あの怪物たちに追われながら、高いところに逃げこめと？」"
msgstr ""

#. Occurrence 5B_13:1370:5916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0004; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1370
msgctxt "text_id=5916 | speaker=aoko"
msgid "「そういうコト。ほら、あのうねうね動き出してるコースターのレールとか、よくない？」"
msgstr ""

#. Occurrence 5B_13:1390:5917: scene=5B_13
#: 5B_13:1390
msgctxt "text_id=5917 | speaker=unknown"
msgid "　遊園地に悪魔は二匹いる。"
msgstr ""

#. Occurrence 5B_13:1395:5918: scene=5B_13
#: 5B_13:1395
msgctxt "text_id=5918 | speaker=unknown"
msgid "　草十郎ですら「よくない」と即答したくなる笑顔だった。"
msgstr ""

#. Occurrence 5B_13:1468:5919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0007; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1468
msgctxt "text_id=5919 | speaker=soujuurou"
msgid "「……疑いたくはないんだが。"
msgstr ""

#. Occurrence 5B_13:1474:5920: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0008; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1474
msgctxt "text_id=5920 | speaker=soujuurou"
msgid "　ホントはあの子とグルで、俺を遠回しに殺そうとしてるんじゃないか？」"
msgstr ""

#. Occurrence 5B_13:1487:5921: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0005; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1487
msgctxt "text_id=5921 | speaker=aoko"
msgid "「あら。私に殺されるのならいいんでしょう？」"
msgstr ""

#. Occurrence 5B_13:1565:5922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0009; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1565
msgctxt "text_id=5922 | speaker=soujuurou"
msgid "「……人の失言を悪用するのは、よくないと思う」"
msgstr ""

#. Occurrence 5B_13:1593:5923: scene=5B_13
#: 5B_13:1593
msgctxt "text_id=5923 | speaker=unknown"
msgid "　とても正気じゃない、とうなだれる草十郎。"
msgstr ""

#. Occurrence 5B_13:1606:5924: scene=5B_13
#: 5B_13:1606
msgctxt "text_id=5924 | speaker=unknown"
msgid "　青子の言う通りにしていたらキッツィーちゃんに食べられる前に過労死しそうだ。"
msgstr ""

#. Occurrence 5B_13:1685:5925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0006; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1685
msgctxt "text_id=5925 | speaker=aoko"
msgid "「私だって鬼じゃないわ。ほら、こっち向いて。"
msgstr ""

#. Occurrence 5B_13:1691:5926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0007; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1691
msgctxt "text_id=5926 | speaker=aoko"
msgid "　おまじない、かけてあげる」"
msgstr ""

#. Occurrence 5B_13:1705:5927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0010; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1705
msgctxt "text_id=5927 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 5B_13:1804:5928: scene=5B_13
#: 5B_13:1804
msgctxt "text_id=5928 | speaker=unknown"
msgid "　軽い接触。"
msgstr ""

#. Occurrence 5B_13:1809:5929: scene=5B_13
#: 5B_13:1809
msgctxt "text_id=5929 | speaker=unknown"
msgid "　息と息、肌と肌が触れ合う距離。"
msgstr ""

#. Occurrence 5B_13:1876:5930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0011; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1876
msgctxt "text_id=5930 | speaker=soujuurou"
msgid "「―――、あ」"
msgstr ""

#. Occurrence 5B_13:1882:5931: scene=5B_13
#: 5B_13:1882
msgctxt "text_id=5931 | speaker=unknown"
msgid "　おざき、と続く声が弱い。"
msgstr ""

#. Occurrence 5B_13:1887:5932: scene=5B_13
#: 5B_13:1887
msgctxt "text_id=5932 | speaker=unknown"
msgid "　それは、一方にとってはごく当たり前の魔術で、"
msgstr ""

#. Occurrence 5B_13:1892:5933: scene=5B_13
#: 5B_13:1892
msgctxt "text_id=5933 | speaker=unknown"
msgid "　一方にとっては頭が真っ白になるほどの、柔らかな不意打ちだった。"
msgstr ""

#. Occurrence 5B_13:1955:5934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0008; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1955
msgctxt "text_id=5934 | speaker=aoko"
msgid "　　『―――空<気のおも|かるく、よわく>り、<胸のふる|うまく、はやく>え。"
msgstr ""

#. Occurrence 5B_13:1961:5935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0009; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1961
msgctxt "text_id=5935 | speaker=aoko"
msgid "　　　　　　ひ<かりは先|チクタクチクタク>立つ、<かげは遅|いそげやいそげ>れる。』"
msgstr ""

#. Occurrence 5B_13:1981:5936: scene=5B_13
#: 5B_13:1981
msgctxt "text_id=5936 | speaker=unknown"
msgid "　通常の声帯では発音できない、何か特殊な重みをもった声が草十郎の鼓膜に響く。"
msgstr ""

#. Occurrence 5B_13:1986:5937: scene=5B_13
#: 5B_13:1986
msgctxt "text_id=5937 | speaker=unknown"
msgid "　……もし言葉に色が見えたのなら、きっと彼女の名前通りの色だっただろう。"
msgstr ""

#. Occurrence 5B_13:1991:5938: scene=5B_13
#: 5B_13:1991
msgctxt "text_id=5938 | speaker=unknown"
msgid "　疲れきっていた体が、熱くなっていた血液が、緩やかに冷やされていく。"
msgstr ""

#. Occurrence 5B_13:2034:5939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0010; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2034
msgctxt "text_id=5939 | speaker=aoko"
msgid "　　『<鳥は空に|と　　ぶ>、<魚は海に|お　よ　ぐ>、<貴方は彼方に|か け ぬ け る>。"
msgstr ""

#. Occurrence 5B_13:2040:5940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0011; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2040
msgctxt "text_id=5940 | speaker=aoko"
msgid "　　　疑<問も不安も鞄|チクタクチクタク>の底に、旅路<の一歩は|きてきをならせ>曙に。"
msgstr ""

#. Occurrence 5B_13:2046:5941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0012; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2046
msgctxt "text_id=5941 | speaker=aoko"
msgid "　　　輝<く星はするりと降|ほしはいつでもきたのそら>ちて、今は<貴方の心の内|どこまでも、いつまでも>に。』"
msgstr ""

#. Occurrence 5B_13:2066:5942: scene=5B_13
#: 5B_13:2066
msgctxt "text_id=5942 | speaker=unknown"
msgid "　実際には五秒ほど。"
msgstr ""

#. Occurrence 5B_13:2071:5943: scene=5B_13
#: 5B_13:2071
msgctxt "text_id=5943 | speaker=unknown"
msgid "　不意を突かれた彼にとってはもう少しだけ長く感じられた触れ合いは、こうして何の失敗もなく、<名残|なごり>惜しくも完了した。"
msgstr ""

#. Occurrence 5B_13:2135:5944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0013; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2135
msgctxt "text_id=5944 | speaker=aoko"
msgid "「よし、暗示成功！　成功したはず！　ここまで手応えがあったの初めてだし！"
msgstr ""

#. Occurrence 5B_13:2141:5945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0014; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2141
msgctxt "text_id=5945 | speaker=aoko"
msgid "　有珠の小言もたまには役に立つじゃない！」"
msgstr ""

#. Occurrence 5B_13:2190:5946: scene=5B_13
#: 5B_13:2190
msgctxt "text_id=5946 | speaker=unknown"
msgid "　はしゃぐ青子と、とにかく現状が掴めない草十郎。"
msgstr ""

#. Occurrence 5B_13:2195:5947: scene=5B_13
#: 5B_13:2195
msgctxt "text_id=5947 | speaker=unknown"
msgid "　今のは一体なんだったのかと訊くと、"
msgstr ""

#. Occurrence 5B_13:2222:5948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0015; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2222
msgctxt "text_id=5948 | speaker=aoko"
msgid "「簡単な暗示よ。一時的に恐怖心を消しておいたから、高いところに登っても平気なはず。"
msgstr ""

#. Occurrence 5B_13:2228:5949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0016; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2228
msgctxt "text_id=5949 | speaker=aoko"
msgid "　あの手の作業でいちばん足を引っ張るのは動揺でしょ？"
msgstr ""

#. Occurrence 5B_13:2240:5950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0017; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2240
msgctxt "text_id=5950 | speaker=aoko"
msgid "　恐怖も何も感じなければ、地上何メートルだろうと平均台とそう変わらないってワケ」"
msgstr ""

#. Occurrence 5B_13:2312:5951: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0012; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2312
msgctxt "text_id=5951 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_13:2354:5952: scene=5B_13
#: 5B_13:2354
msgctxt "text_id=5952 | speaker=unknown"
msgid "　なるほど、と手を打つ純朴少年。"
msgstr ""

#. Occurrence 5B_13:2359:5953: scene=5B_13
#: 5B_13:2359
msgctxt "text_id=5953 | speaker=unknown"
msgid "　青子の言っている事は<眉唾|まゆつば>だが、さっきの謎の行為はそういう事か、と納得する草十郎だった。"
msgstr ""

#. Occurrence 5B_13:2455:5954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0013; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2455
msgctxt "text_id=5954 | speaker=soujuurou"
msgid "「……はあ。やっと、着いた」"
msgstr ""

#. Occurrence 5B_13:2461:5955: scene=5B_13
#: 5B_13:2461
msgctxt "text_id=5955 | speaker=unknown"
msgid "　山なりのレールの頂点。"
msgstr ""

#. Occurrence 5B_13:2466:5956: scene=5B_13
#: 5B_13:2466
msgctxt "text_id=5956 | speaker=unknown"
msgid "　草十郎は地上六十メートル近い高みに到着し、遊園地を俯瞰する。"
msgstr ""

#. Occurrence 5B_13:2486:5957: scene=5B_13
#: 5B_13:2486
msgctxt "text_id=5957 | speaker=unknown"
msgid "　青子の姿はすぐに発見できた。"
msgstr ""

#. Occurrence 5B_13:2491:5958: scene=5B_13
#: 5B_13:2491
msgctxt "text_id=5958 | speaker=unknown"
msgid "　この地点からそう離れていない広場で、なにやら怪しげな作業を行っている。"
msgstr ""

#. Occurrence 5B_13:2496:5959: scene=5B_13
#: 5B_13:2496
msgctxt "text_id=5959 | speaker=unknown"
msgid "　青子の周囲は静かなものだ。"
msgstr ""

#. Occurrence 5B_13:2501:5960: scene=5B_13
#: 5B_13:2501
msgctxt "text_id=5960 | speaker=unknown"
msgid "　ブレッドマンたちは草十郎を追いかけようとして、いまだコースター入り口で試行錯誤の真っ最中。"
msgstr ""

#. Occurrence 5B_13:2506:5961: scene=5B_13
#: 5B_13:2506
msgctxt "text_id=5961 | speaker=unknown"
msgid "　距離にして、もう百メートル以上も離れている。"
msgstr ""

#. Occurrence 5B_13:2594:5962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0014; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2594
msgctxt "text_id=5962 | speaker=soujuurou"
msgid "「……汗をかくはずだ。こんなに移動したのか」"
msgstr ""

#. Occurrence 5B_13:2600:5963: scene=5B_13
#: 5B_13:2600
msgctxt "text_id=5963 | speaker=unknown"
msgid "　真冬の強風で額の汗はすぐに乾くが、シャツの下は汗で濡れている。"
msgstr ""

#. Occurrence 5B_13:2605:5964: scene=5B_13
#: 5B_13:2605
msgctxt "text_id=5964 | speaker=unknown"
msgid "　一キロマラソン以上の運動量プラス、冷や汗分も含まれているに違いない。"
msgstr ""

#. Occurrence 5B_13:2633:5965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0015; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2633
msgctxt "text_id=5965 | speaker=soujuurou"
msgid "「でも良かった。あとは合図を待つだけだ」"
msgstr ""

#. Occurrence 5B_13:2639:5966: scene=5B_13
#: 5B_13:2639
msgctxt "text_id=5966 | speaker=unknown"
msgid "　心底から安心する。"
msgstr ""

#. Occurrence 5B_13:2644:5967: scene=5B_13
#: 5B_13:2644
msgctxt "text_id=5967 | speaker=unknown"
msgid "　この方法で、青子が<遊園地|スナーク>を破壊できるから、ではない。"
msgstr ""

#. Occurrence 5B_13:2649:5968: scene=5B_13
#: 5B_13:2649
msgctxt "text_id=5968 | speaker=unknown"
msgid "　彼はそんな事より、ミラーハウスでの借りを少しでも返せる気がして嬉しいのだ。"
msgstr ""

#. Occurrence 5B_13:2776:5969: scene=5B_13
#: 5B_13:2776
msgctxt "text_id=5969 | speaker=unknown"
msgid "　青子のいた広場から青い魔弾が昇る。"
msgstr ""

#. Occurrence 5B_13:2782:5970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0016; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2782
msgctxt "text_id=5970 | speaker=soujuurou"
msgid "「合図だ……！」"
msgstr ""

#. Occurrence 5B_13:2787:5971: scene=5B_13
#: 5B_13:2787
msgctxt "text_id=5971 | speaker=unknown"
msgid "　草十郎はレールの上に立ち上がり、ポケットに仕舞った巾着袋を放り投げた。"
msgstr ""

#. Occurrence 5B_13:2875:5972: scene=5B_13
#: 5B_13:2875
msgctxt "text_id=5972 | speaker=unknown"
msgid "　ここが不安定な足場である事を考えない、豪快なオーバースロー。"
msgstr ""

#. Occurrence 5B_13:2880:5973: scene=5B_13
#: 5B_13:2880
msgctxt "text_id=5973 | speaker=unknown"
msgid "　巾着は放物線を描きながら青子のいる方角に向かっていき、ほどなくして空に<解|と>けた。"
msgstr ""

#. Occurrence 5B_13:2950:5974: scene=5B_13
#: 5B_13:2950
msgctxt "text_id=5974 | speaker=unknown"
msgid "　巾着には彼女の髪と、重しの小石が入っていた。"
msgstr ""

#. Occurrence 5B_13:2957:5975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0018; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2957
msgctxt "text_id=5975 | speaker=aoko"
msgid "“高いところから風に乗せてくれれば、後はなんとかするから”"
msgstr ""

#. Occurrence 5B_13:2963:5976: scene=5B_13
#: 5B_13:2963
msgctxt "text_id=5976 | speaker=unknown"
msgid "　青子はそう言ったが、草十郎なりに工夫した結果である。"
msgstr ""

#. Occurrence 5B_13:2968:5977: scene=5B_13
#: 5B_13:2968
msgctxt "text_id=5977 | speaker=unknown"
msgid "　<一房|ひとふさ>の髪は、持ち主である少女を見守るように<滞空|たいくう>する。"
msgstr ""

#. Occurrence 5B_13:3055:5978: scene=5B_13
#: 5B_13:3055
msgctxt "text_id=5978 | speaker=unknown"
msgid "　草十郎に託された仕事は終わった。"
msgstr ""

#. Occurrence 5B_13:3060:5979: scene=5B_13
#: 5B_13:3060
msgctxt "text_id=5979 | speaker=unknown"
msgid "　いまだ浮遊する卵は気になるが、これは彼にどうにかできる物ではない。"
msgstr ""

#. Occurrence 5B_13:3072:5980: scene=5B_13
#: 5B_13:3072
msgctxt "text_id=5980 | speaker=unknown"
msgid "　草十郎はホッと息をついて、事の成り行きを見届けようと身を乗り出し、"
msgstr ""

#. Occurrence 5B_13:3151:5981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0017; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:3151
msgctxt "text_id=5981 | speaker=soujuurou"
msgid "「…………むむ？」"
msgstr ""

#. Occurrence 5B_13:3157:5982: scene=5B_13
#: 5B_13:3157
msgctxt "text_id=5982 | speaker=unknown"
msgid "　視界の<隅|すみ>。"
msgstr ""

#. Occurrence 5B_13:3162:5983: scene=5B_13
#: 5B_13:3162
msgctxt "text_id=5983 | speaker=unknown"
msgid "　青子のいる広場に近寄りつつある、なにか、見覚えのあるものを見かけた気がした。"
msgstr ""

#. Occurrence 5B_14:139:5984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0000; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:139
msgctxt "text_id=5984 | speaker=aoko"
msgid "「<刻印|ルート>、<接続|セット>―――"
msgstr ""

#. Occurrence 5B_14:347:5985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0001; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:347
msgctxt "text_id=5985 | speaker=aoko"
msgid "　直<流数|ディレクト>紋、一層、二層―――予備に三層。"
msgstr ""

#. Occurrence 5B_14:369:5986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0002; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:369
msgctxt "text_id=5986 | speaker=aoko"
msgid "　魔力提供、大源に固定。"
msgstr ""

#. Occurrence 5B_14:375:5987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0003; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:375
msgctxt "text_id=5987 | speaker=aoko"
msgid "　……<循環|じゅんかん>良し、<射角|しゃかく>良し、<術式|じゅつしき>安定、おおまか良し」"
msgstr ""

#. Occurrence 5B_14:395:5988: scene=5B_14
#: 5B_14:395
msgctxt "text_id=5988 | speaker=unknown"
msgid "　レンガの<路|うえ>に<紋様|もんよう>が刻まれていく。"
msgstr ""

#. Occurrence 5B_14:400:5989: scene=5B_14
#: 5B_14:400
msgctxt "text_id=5989 | speaker=unknown"
msgid "　かつてない大詠唱による、かつてない大射程の魔術行使。"
msgstr ""

#. Occurrence 5B_14:405:5990: scene=5B_14
#: 5B_14:405
msgctxt "text_id=5990 | speaker=unknown"
msgid "　ほのかな緊張と高揚を胸に<留|とど>めながら、新米魔術師は指を鳴らす。"
msgstr ""

#. Occurrence 5B_14:441:5991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0004; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:441
msgctxt "text_id=5991 | speaker=aoko"
msgid "「―――決めた。<魔弾|ツアー><形式|プラン>、<収束|スター><投射|マイン>」"
msgstr ""

#. Occurrence 5B_14:447:5992: scene=5B_14
#: 5B_14:447
msgctxt "text_id=5992 | speaker=unknown"
msgid "　術式の中心に膝をつき、夜空を見上げる青子。"
msgstr ""

#. Occurrence 5B_14:452:5993: scene=5B_14
#: 5B_14:452
msgctxt "text_id=5993 | speaker=unknown"
msgid "　御伽の国と化した遊園地だったが、もう、その片鱗すら彼女の視界には<映|うつ>らない。"
msgstr ""

#. Occurrence 5B_14:457:5994: scene=5B_14
#: 5B_14:457
msgctxt "text_id=5994 | speaker=unknown"
msgid "　青い目に映るのは、たったひとつの触れられぬもの。"
msgstr ""

#. Occurrence 5B_14:511:5995: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0000; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:511
msgctxt "text_id=5995 | speaker=soujuurou"
msgid "「実は、ずっと気になっていた事が」"
msgstr ""

#. Occurrence 5B_14:591:5996: scene=5B_14
#: 5B_14:591
msgctxt "text_id=5996 | speaker=unknown"
msgid "　つい数分ほど前の話。"
msgstr ""

#. Occurrence 5B_14:596:5997: scene=5B_14
#: 5B_14:596
msgctxt "text_id=5997 | speaker=unknown"
msgid "　そう切りだして、草十郎はある事実を口にした。"
msgstr ""

#. Occurrence 5B_14:601:5998: scene=5B_14
#: 5B_14:601
msgctxt "text_id=5998 | speaker=unknown"
msgid "　本当に単純な食い違い。"
msgstr ""

#. Occurrence 5B_14:606:5999: scene=5B_14
#: 5B_14:606
msgctxt "text_id=5999 | speaker=unknown"
msgid "　一時間前までの現実と、たった今の幻想と、その最小にして最大の間違い探しを。"
msgstr ""

#. Occurrence 5B_14:683:6000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0001; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:683
msgctxt "text_id=6000 | speaker=soujuurou"
msgid "「雲があったから、勘違いしたんだろうけど―――」"
msgstr ""

#. Occurrence 5B_14:689:6001: scene=5B_14
#: 5B_14:689
msgctxt "text_id=6001 | speaker=unknown"
msgid "　見えているのに見えないもの。"
msgstr ""

#. Occurrence 5B_14:694:6002: scene=5B_14
#: 5B_14:694
msgctxt "text_id=6002 | speaker=unknown"
msgid "　現実では有りえなくて、ここに有るのもおかしいもの。"
msgstr ""

#. Occurrence 5B_14:699:6003: scene=5B_14
#: 5B_14:699
msgctxt "text_id=6003 | speaker=unknown"
msgid "　あらゆる原型が変わっていく遊園地で、堂々と、正常なカタチを見せつけていた―――"
msgstr ""

#. Occurrence 5B_14:781:6004: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0002; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:781
msgctxt "text_id=6004 | speaker=soujuurou"
msgid "「今夜は新月なんだ、蒼崎」"
msgstr ""

#. Occurrence 5B_14:889:6005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0005; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:889
msgctxt "text_id=6005 | speaker=aoko"
msgid "「思えば、はじめっからそのカタチだったものね、アンタは」"
msgstr ""

#. Occurrence 5B_14:895:6006: scene=5B_14
#: 5B_14:895
msgctxt "text_id=6006 | speaker=unknown"
msgid "　月までの距離は三十八万キロメートル。"
msgstr ""

#. Occurrence 5B_14:900:6007: scene=5B_14
#: 5B_14:900
msgctxt "text_id=6007 | speaker=unknown"
msgid "　本当に<そ|・><こ|・><ま|・><で|・><同|・><じ|・>であるなら、まさしく異名に恥じない怪物だ。"
msgstr ""

#. Occurrence 5B_14:995:6008: scene=5B_14
#: 5B_14:995
msgctxt "text_id=6008 | speaker=unknown"
msgid "　だが、そうであるのなら姿を隠す必要はない。堂々と正体を明かせばいい。"
msgstr ""

#. Occurrence 5B_14:1000:6009: scene=5B_14
#: 5B_14:1000
msgctxt "text_id=6009 | speaker=unknown"
msgid "　正体を隠すのは手の届く位置にいるからこそ。"
msgstr ""

#. Occurrence 5B_14:1005:6010: scene=5B_14
#: 5B_14:1005
msgctxt "text_id=6010 | speaker=unknown"
msgid "　あの怪物の擬態は、同時に、人間の手で<到|・><達|・><可|・><能|・>である事を示している……！"
msgstr ""

#. Occurrence 5B_14:1046:6011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0006; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1046
msgctxt "text_id=6011 | speaker=aoko"
msgid "「こっちの最大射程は、よくて六百ってところだけど……」"
msgstr ""

#. Occurrence 5B_14:1199:6012: scene=5B_14
#: 5B_14:1199
msgctxt "text_id=6012 | speaker=unknown"
msgid "　こうなったら力尽きるまで。"
msgstr ""

#. Occurrence 5B_14:1204:6013: scene=5B_14
#: 5B_14:1204
msgctxt "text_id=6013 | speaker=unknown"
msgid "　この遊園地中の魔力を総動員して、魔弾の手を伸ばしてみせる。"
msgstr ""

#. Occurrence 5B_14:1260:6014: scene=5B_14
#: 5B_14:1260
msgctxt "text_id=6014 | speaker=unknown"
msgid "　夜空に青い花火が上がる。"
msgstr ""

#. Occurrence 5B_14:1355:6015: scene=5B_14
#: 5B_14:1355
msgctxt "text_id=6015 | speaker=unknown"
msgid "　風に舞う自分の髪を見上げて、青子は虚空をつかむように右手を伸ばした。"
msgstr ""

#. Occurrence 5B_14:1360:6016: scene=5B_14
#: 5B_14:1360
msgctxt "text_id=6016 | speaker=unknown"
msgid "　魔術師にとって自身の肉体は一線級の触媒だ。"
msgstr ""

#. Occurrence 5B_14:1365:6017: scene=5B_14
#: 5B_14:1365
msgctxt "text_id=6017 | speaker=unknown"
msgid "　女性の魔術師であるなら、年月を積み重ねた髪は特に貴重かつ強力な燃料になる。"
msgstr ""

#. Occurrence 5B_14:1485:6018: scene=5B_14
#: 5B_14:1485
msgctxt "text_id=6018 | speaker=unknown"
msgid "　扱いはそれこそ念じるだけでいい。"
msgstr ""

#. Occurrence 5B_14:1490:6019: scene=5B_14
#: 5B_14:1490
msgctxt "text_id=6019 | speaker=unknown"
msgid "　彼女は力強く、開いた指を握りこみ、"
msgstr ""

#. Occurrence 5B_14:1507:6020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0007; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1507
msgctxt "text_id=6020 | speaker=aoko"
msgid "「三層展開！　全術式、連結起動―――！」"
msgstr ""

#. Occurrence 5B_14:1544:6021: scene=5B_14
#: 5B_14:1544
msgctxt "text_id=6021 | speaker=unknown"
msgid "　月と自らを<繋|つな>げる、明確な挑戦状をたたきつけた。"
msgstr ""

#. Occurrence 5B_14:1671:6022: scene=5B_14
#: 5B_14:1671
msgctxt "text_id=6022 | speaker=unknown"
msgid "　霧が渦巻く。"
msgstr ""

#. Occurrence 5B_14:1676:6023: scene=5B_14
#: 5B_14:1676
msgctxt "text_id=6023 | speaker=unknown"
msgid "　中空に現れた青い魔術式を見て、高みの怪物がその牙を<剥|む>きだしにする。"
msgstr ""

#. Occurrence 5B_14:1738:6024: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0000; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1738
msgctxt "text_id=6024 | speaker=alice"
msgid "「見抜かれた、ですって……？」"
msgstr ""

#. Occurrence 5B_14:1757:6025: scene=5B_14
#: 5B_14:1757
msgctxt "text_id=6025 | speaker=unknown"
msgid "　有珠がその変化に気付いた時、青子、スナークの両者は、ともに明確な敵意を向けあっていた。"
msgstr ""

#. Occurrence 5B_14:1827:6026: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0001; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1827
msgctxt "text_id=6026 | speaker=alice"
msgid "「……そう。なら青子の勝ちよ。すぐに戻りなさい。"
msgstr ""

#. Occurrence 5B_14:1833:6027: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0002; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1833
msgctxt "text_id=6027 | speaker=alice"
msgid "　たしかに雨雲を消したのはヒントのあげすぎだけど、それぐらいは大目に見て―――スナーク？」"
msgstr ""

#. Occurrence 5B_14:1843:6028: scene=5B_14
#: 5B_14:1843
msgctxt "text_id=6028 | speaker=unknown"
msgid "　霧の集結は止まらない。"
msgstr ""

#. Occurrence 5B_14:1848:6029: scene=5B_14
#: 5B_14:1848
msgctxt "text_id=6029 | speaker=unknown"
msgid "　夜空に浮かぶ月は、<不遜|ふそん>極まる魔法使いを許しはしない。"
msgstr ""

#. Occurrence 5B_14:1853:6030: scene=5B_14
#: 5B_14:1853
msgctxt "text_id=6030 | speaker=unknown"
msgid "　夜の王たる自分を<敬|うやま>わぬばかりか、あんな、あからさまに挑戦状をたたき付けられては、怒りの<収|おさ>めようがない。"
msgstr ""

#. Occurrence 5B_14:1941:6031: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0003; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1941
msgctxt "text_id=6031 | speaker=alice"
msgid "「スナーク！」"
msgstr ""

#. Occurrence 5B_14:1948:6032: scene=5B_14
#: 5B_14:1948
msgctxt "text_id=6032 | speaker=unknown"
msgid "　あわてて報告に来る駒鳥を手で払いながら、少女は変貌していく黄金の月を凝視する。"
msgstr ""

#. Occurrence 5B_14:2067:6033: scene=5B_14
#: 5B_14:2067
msgctxt "text_id=6033 | speaker=unknown"
msgid "　制止の声は届かない。"
msgstr ""

#. Occurrence 5B_14:2072:6034: scene=5B_14
#: 5B_14:2072
msgctxt "text_id=6034 | speaker=unknown"
msgid "“童話の怪物”は誰はばかることなく、その強大な力を、ちっぽけな<青子|えもの>に振り下ろそうと―――"
msgstr ""

#. Occurrence 5B_14:2244:6035: scene=5B_14
#: 5B_14:2244
msgctxt "text_id=6035 | speaker=unknown"
msgid "　うなりをあげる魔弾の炉心。"
msgstr ""

#. Occurrence 5B_14:2249:6036: scene=5B_14
#: 5B_14:2249
msgctxt "text_id=6036 | speaker=unknown"
msgid "　回転する体内の魔術回路。"
msgstr ""

#. Occurrence 5B_14:2254:6037: scene=5B_14
#: 5B_14:2254
msgctxt "text_id=6037 | speaker=unknown"
msgid "　架空の炎に神経を焼かれながら、青子は魔力を走らせる。"
msgstr ""

#. Occurrence 5B_14:2274:6038: scene=5B_14
#: 5B_14:2274
msgctxt "text_id=6038 | speaker=unknown"
msgid "　地面に刻んだ術式は青子と<連結|リンク>している。"
msgstr ""

#. Occurrence 5B_14:2279:6039: scene=5B_14
#: 5B_14:2279
msgctxt "text_id=6039 | speaker=unknown"
msgid "　術式を読みこみ実行するのは今まで通りだが、出力はその比ではない。"
msgstr ""

#. Occurrence 5B_14:2284:6040: scene=5B_14
#: 5B_14:2284
msgctxt "text_id=6040 | speaker=unknown"
msgid "　同じ工程でもこれほどの火力なら術者にも害が及ぶ。"
msgstr ""

#. Occurrence 5B_14:2289:6041: scene=5B_14
#: 5B_14:2289
msgctxt "text_id=6041 | speaker=unknown"
msgid "　あるいは、<砲身|しんけい>が焼き崩れるほどの。"
msgstr ""

#. Occurrence 5B_14:2374:6042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0008; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2374
msgctxt "text_id=6042 | speaker=aoko"
msgid "「―――、でも、いける……！」"
msgstr ""

#. Occurrence 5B_14:2380:6043: scene=5B_14
#: 5B_14:2380
msgctxt "text_id=6043 | speaker=unknown"
msgid "　怖いくらいに上昇する架空の熱量。"
msgstr ""

#. Occurrence 5B_14:2385:6044: scene=5B_14
#: 5B_14:2385
msgctxt "text_id=6044 | speaker=unknown"
msgid "　底なしの感覚に身震いする青子だが、そうでなくてはこの戦法を選んだ意味がない。"
msgstr ""

#. Occurrence 5B_14:2405:6045: scene=5B_14
#: 5B_14:2405
msgctxt "text_id=6045 | speaker=unknown"
msgid "　青子はもう移動できない。"
msgstr ""

#. Occurrence 5B_14:2410:6046: scene=5B_14
#: 5B_14:2410
msgctxt "text_id=6046 | speaker=unknown"
msgid "　草十郎からスナークの正体を聞いた時、彼女は“移動する砲台”の優位性を捨てて、設置砲台になる道を選んだ。"
msgstr ""

#. Occurrence 5B_14:2415:6047: scene=5B_14
#: 5B_14:2415
msgctxt "text_id=6047 | speaker=unknown"
msgid "　そうでなければ届かない。この位置、この角度で刻印を固定しなければ、スナーク<狩り|ハント>はできないのだ。"
msgstr ""

#. Occurrence 5B_14:2435:6048: scene=5B_14
#: 5B_14:2435
msgctxt "text_id=6048 | speaker=unknown"
msgid "　同時に、それは“次の手段”がない事を示している。"
msgstr ""

#. Occurrence 5B_14:2440:6049: scene=5B_14
#: 5B_14:2440
msgctxt "text_id=6049 | speaker=unknown"
msgid "　口火をきればこの場所で最後まで戦うしかない。"
msgstr ""

#. Occurrence 5B_14:2445:6050: scene=5B_14
#: 5B_14:2445
msgctxt "text_id=6050 | speaker=unknown"
msgid "　それでいい、と青子は大きく息を吸い込んだ。"
msgstr ""

#. Occurrence 5B_14:2450:6051: scene=5B_14
#: 5B_14:2450
msgctxt "text_id=6051 | speaker=unknown"
msgid "　準備は万全。ロケットの噴射に等しい魔力の渦を、直接、あの月にまで届かせる―――！"
msgstr ""

#. Occurrence 5B_14:2470:6052: scene=5B_14
#: 5B_14:2470
msgctxt "text_id=6052 | speaker=unknown"
msgid "　中空に浮かぶ第三層は臨界に達した魔力を撃ち出す銃口であり、射角を調整する<照星|しょうせい>だ。"
msgstr ""

#. Occurrence 5B_14:2485:6053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0009; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2485
msgctxt "text_id=6053 | speaker=aoko"
msgid "“霧……？”"
msgstr ""

#. Occurrence 5B_14:2490:6054: scene=5B_14
#: 5B_14:2490
msgctxt "text_id=6054 | speaker=unknown"
msgid "　その照準越しに月が<歪|ゆが>む。"
msgstr ""

#. Occurrence 5B_14:2600:6055: scene=5B_14
#: 5B_14:2600
msgctxt "text_id=6055 | speaker=unknown"
msgid "　魔力を充電する青子をあざ笑うように、黄金の月はその正体を現していく。"
msgstr ""

#. Occurrence 5B_14:2624:6056: scene=5B_14
#: 5B_14:2624
msgctxt "text_id=6056 | speaker=unknown"
msgid "　さあ―――<宙|てん>を仰げ、異能なき<無|む><辜|こ>の血統。"
msgstr ""

#. Occurrence 5B_14:2630:6057: scene=5B_14
#: 5B_14:2630
msgctxt "text_id=6057 | speaker=unknown"
msgid "　あれこそは魔天の一角、"
msgstr ""

msgctxt "text_id=6058 | speaker=unknown"
msgid "　緑色の霧、<紺碧|こんぺき>の雲にかすむ神秘の<貌|すがた>。"
msgstr ""

#. Occurrence 5B_14:2638:6059: scene=5B_14
#: 5B_14:2638
msgctxt "text_id=6059 | speaker=unknown"
msgid "　魔術世界において至宝と称され、"
msgstr ""

msgctxt "text_id=6060 | speaker=unknown"
msgid "　一つの王国より稀少と値付けられた<至高の幻想|クラウン・ファンタズム>。"
msgstr ""

#. Occurrence 5B_14:2759:6061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0010; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2759
msgctxt "text_id=6061 | speaker=aoko"
msgid "“あれが―――フラットスナーク……！！！！”"
msgstr ""

#. Occurrence 5B_14:2765:6062: scene=5B_14
#: 5B_14:2765
msgctxt "text_id=6062 | speaker=unknown"
msgid "　<第一|はじまり>より<別|わか>たれた、この世でもっとも大きな虚構！"
msgstr ""

#. Occurrence 5B_14:2896:6063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0011; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2896
msgctxt "text_id=6063 | speaker=aoko"
msgid "“っ……まだ早い―――まだ早い、けど―――！”"
msgstr ""

#. Occurrence 5B_14:2985:6064: scene=5B_14
#: 5B_14:2985
msgctxt "text_id=6064 | speaker=unknown"
msgid "　これ以上の<猶|た><予|め>は許されない、と本能が叫んでいた。"
msgstr ""

#. Occurrence 5B_14:2990:6065: scene=5B_14
#: 5B_14:2990
msgctxt "text_id=6065 | speaker=unknown"
msgid "　正体を暴かれようと敵は最高級の“童話の怪物”。"
msgstr ""

#. Occurrence 5B_14:2995:6066: scene=5B_14
#: 5B_14:2995
msgctxt "text_id=6066 | speaker=unknown"
msgid "　この状況でも反撃の用意はある事を、剥き出しの敵意が示している……！"
msgstr ""

#. Occurrence 5B_14:3016:6067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0012; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3016
msgctxt "text_id=6067 | speaker=aoko"
msgid "“こっちはもう動けない……逃げを捨てての大詠唱、先に撃たれたらそこで終わりだ……！”　"
msgstr ""

#. Occurrence 5B_14:3022:6068: scene=5B_14
#: 5B_14:3022
msgctxt "text_id=6068 | speaker=unknown"
msgid "　故に、その前に撃ち落とす。"
msgstr ""

#. Occurrence 5B_14:3027:6069: scene=5B_14
#: 5B_14:3027
msgctxt "text_id=6069 | speaker=unknown"
msgid "　魔力は八分、術式は正常稼働、あとは<引|ひ>き<金|がね>を引くだけだが―――"
msgstr ""

#. Occurrence 5B_14:3071:6070: scene=5B_14
#: 5B_14:3071
msgctxt "text_id=6070 | speaker=unknown"
msgid "　本当にそれでいいのか、と冷静な自分が告げる。"
msgstr ""

#. Occurrence 5B_14:3140:6071: scene=5B_14
#: 5B_14:3140
msgctxt "text_id=6071 | speaker=unknown"
msgid "　始めてしまえば後戻りはできない。"
msgstr ""

#. Occurrence 5B_14:3145:6072: scene=5B_14
#: 5B_14:3145
msgctxt "text_id=6072 | speaker=unknown"
msgid "　この先はコンマの戦いだ。判断ミスを悔いる瞬間さえない。０．１秒の迷いが天秤をかたむける。"
msgstr ""

#. Occurrence 5B_14:3215:6073: scene=5B_14
#: 5B_14:3215
msgctxt "text_id=6073 | speaker=unknown"
msgid "　痛みへの覚悟も、失着への開き直りはできているか？"
msgstr ""

#. Occurrence 5B_14:3262:6074: scene=5B_14
#: 5B_14:3262
msgctxt "text_id=6074 | speaker=unknown"
msgid "　そもそも本当におまえは、そのちっぽけな魔弾で、月を落とす事ができるのか―――？"
msgstr ""

#. Occurrence 5B_14:3325:6075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0013; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3325
msgctxt "text_id=6075 | speaker=aoko"
msgid "“いい―――とりあえず、当たった後で考える！”"
msgstr ""

#. Occurrence 5B_14:3331:6076: scene=5B_14
#: 5B_14:3331
msgctxt "text_id=6076 | speaker=unknown"
msgid "　月を見据える<双眸|そうぼう>に決意をこめる。"
msgstr ""

#. Occurrence 5B_14:3336:6077: scene=5B_14
#: 5B_14:3336
msgctxt "text_id=6077 | speaker=unknown"
msgid "　魔弾を放った瞬間、強大なフィードバックが全身を打ちのめす事を念頭にいれて、"
msgstr ""

#. Occurrence 5B_14:3443:6078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6078 | speaker=aoko"
msgid "「―――上等！"
msgstr ""

#. Occurrence 5B_14:3443:6079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6079 | speaker=aoko"
msgid "　出し惜しみはなし、めいっぱいブン回すわ……！」"
msgstr ""

#. Occurrence 5B_14:3449:6080: scene=5B_14
#: 5B_14:3449
msgctxt "text_id=6080 | speaker=unknown"
msgid "　<宙|そら>を狙う狙撃手は気勢と共に、一撃必中、超長射程の魔弾を解き放つ……！"
msgstr ""

#. Occurrence 5B_14:3760:6081: scene=5B_14
#: 5B_14:3760
msgctxt "text_id=6081 | speaker=unknown"
msgid "　地上からの魔弾を抱く第三層。"
msgstr ""

#. Occurrence 5B_14:3765:6082: scene=5B_14
#: 5B_14:3765
msgctxt "text_id=6082 | speaker=unknown"
msgid "　青子の分身とも言える刻印が、月を射抜けと光を放つ。"
msgstr ""

#. Occurrence 5B_14:3770:6083: scene=5B_14
#: 5B_14:3770
msgctxt "text_id=6083 | speaker=unknown"
msgid "　―――だが。"
msgstr ""

#. Occurrence 5B_14:4096:6084: scene=5B_14
#: 5B_14:4096
msgctxt "text_id=6084 | speaker=unknown"
msgid "　光を砕く<巨|あ><峰|お>の<天蓋|てんがい>。"
msgstr ""

#. Occurrence 5B_14:4101:6085: scene=5B_14
#: 5B_14:4101
msgctxt "text_id=6085 | speaker=unknown"
msgid "　瞬間火炎温度３０００度に匹敵する<架|エ><空|ー><要|テ><素|ル>が、真っ向から無に帰していく……！"
msgstr ""

#. Occurrence 5B_14:4233:6086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0015; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4233
msgctxt "text_id=6086 | speaker=aoko"
msgid "「あ、づっ―――！！！！！」"
msgstr ""

#. Occurrence 5B_14:4239:6087: scene=5B_14
#: 5B_14:4239
msgctxt "text_id=6087 | speaker=unknown"
msgid "　身に余る大魔術の反動に、全身の血が沸騰する。"
msgstr ""

#. Occurrence 5B_14:4244:6088: scene=5B_14
#: 5B_14:4244
msgctxt "text_id=6088 | speaker=unknown"
msgid "　停止した心臓。"
msgstr ""

#. Occurrence 5B_14:4249:6089: scene=5B_14
#: 5B_14:4249
msgctxt "text_id=6089 | speaker=unknown"
msgid "　激痛と衝撃で麻痺する<脳髄|のうずい>。"
msgstr ""

#. Occurrence 5B_14:4254:6090: scene=5B_14
#: 5B_14:4254
msgctxt "text_id=6090 | speaker=unknown"
msgid "　末端から<壊|え><死|し>していく神経。"
msgstr ""

#. Occurrence 5B_14:4259:6091: scene=5B_14
#: 5B_14:4259
msgctxt "text_id=6091 | speaker=unknown"
msgid "　それらすべてを、魔術刻印が強引に蘇生させる。"
msgstr ""

#. Occurrence 5B_14:4385:6092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0016; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4385
msgctxt "text_id=6092 | speaker=aoko"
msgid "「は、ぁつ、ぁ―――！」"
msgstr ""

#. Occurrence 5B_14:4391:6093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0017; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4391
msgctxt "text_id=6093 | speaker=aoko"
msgid "“氷―――！　氷で<防|ふせ>がれた！”"
msgstr ""

#. Occurrence 5B_14:4397:6094: scene=5B_14
#: 5B_14:4397
msgctxt "text_id=6094 | speaker=unknown"
msgid "　真っ白に眩む視界のなか、青子はたしかに見た。"
msgstr ""

#. Occurrence 5B_14:4402:6095: scene=5B_14
#: 5B_14:4402
msgctxt "text_id=6095 | speaker=unknown"
msgid "　<口内|こうない>の血を飲みこんで頭上を<睨|にら>む。"
msgstr ""

#. Occurrence 5B_14:4509:6096: scene=5B_14
#: 5B_14:4509
msgctxt "text_id=6096 | speaker=unknown"
msgid "　そこには。"
msgstr ""

#. Occurrence 5B_14:4515:6097: scene=5B_14
#: 5B_14:4515
msgctxt "text_id=6097 | speaker=unknown"
msgid "巨大な氷塊を盾にしてあざ笑う、いびつで邪悪な<髑髏|どくろ>の顔が……！"
msgstr ""

#. Occurrence 5B_14:4603:6098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6098 | speaker=aoko"
msgid "“撃つのが遅すぎた、それとも早すぎた……！？"
msgstr ""

#. Occurrence 5B_14:4603:6099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6099 | speaker=aoko"
msgid "　盾を作られる前に撃てばよかった！？"
msgstr ""

#. Occurrence 5B_14:4603:6100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6100 | speaker=aoko"
msgid "　それとも、正面からじゃ無謀すぎた……！？”"
msgstr ""

#. Occurrence 5B_14:4697:6101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0019; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4697
msgctxt "text_id=6101 | speaker=aoko"
msgid "「っ、どっちでもいい！"
msgstr ""

#. Occurrence 5B_14:4703:6102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0020; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4703
msgctxt "text_id=6102 | speaker=aoko"
msgid "　一層、二層、再起動―――！　急いで！」"
msgstr ""

#. Occurrence 5B_14:4786:6103: scene=5B_14
#: 5B_14:4786
msgctxt "text_id=6103 | speaker=unknown"
msgid "　考える余分も、迷っている余裕もない。"
msgstr ""

#. Occurrence 5B_14:4849:6104: scene=5B_14
#: 5B_14:4849
msgctxt "text_id=6104 | speaker=unknown"
msgid "　遊園地<中|じゅう>の魔力が集結する。"
msgstr ""

#. Occurrence 5B_14:4856:6105: scene=5B_14
#: 5B_14:4856
msgctxt "text_id=6105 | speaker=unknown"
msgid "　一方は青子に。"
msgstr ""

#. Occurrence 5B_14:4861:6106: scene=5B_14
#: 5B_14:4861
msgctxt "text_id=6106 | speaker=unknown"
msgid "　もう一方は君臨する月の顔に。"
msgstr ""

#. Occurrence 5B_14:4866:6107: scene=5B_14
#: 5B_14:4866
msgctxt "text_id=6107 | speaker=unknown"
msgid "　今の氷は未完成だ、と青子は直感した。こちらがそうであったように、フラットスナークもまだ<極限|じょうげん>に達していない。"
msgstr ""

#. Occurrence 5B_14:4871:6108: scene=5B_14
#: 5B_14:4871
msgctxt "text_id=6108 | speaker=unknown"
msgid "　そう、だからこそ―――"
msgstr ""

#. Occurrence 5B_14:4965:6109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0021; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4965
msgctxt "text_id=6109 | speaker=aoko"
msgid "“まずい―――まずい、まずい、まずい！”"
msgstr ""

#. Occurrence 5B_14:4971:6110: scene=5B_14
#: 5B_14:4971
msgctxt "text_id=6110 | speaker=unknown"
msgid "　術式の加速は青子自身を傷つける。"
msgstr ""

#. Occurrence 5B_14:4976:6111: scene=5B_14
#: 5B_14:4976
msgctxt "text_id=6111 | speaker=unknown"
msgid "　繋がっている以上、術式に負荷をかけるほど<軋|きし>みは青子の体にのしかかる。それでも今は耐えるしかない。"
msgstr ""

#. Occurrence 5B_14:5003:6112: scene=5B_14
#: 5B_14:5003
msgctxt "text_id=6112 | speaker=unknown"
msgid "　なぜなら―――"
msgstr ""

#. Occurrence 5B_14:5066:6113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0022; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5066
msgctxt "text_id=6113 | speaker=aoko"
msgid "“―――あの氷、<私|・><の|・><マ|・><ッ|・><ク|・><ス|・><よ|・><り|・><も|・><っ|・><と|・><上|・><だ|・>！”"
msgstr ""

#. Occurrence 5B_14:5072:6114: scene=5B_14
#: 5B_14:5072
msgctxt "text_id=6114 | speaker=unknown"
msgid "　今の一撃で互いの戦力が分かってしまった。"
msgstr ""

#. Occurrence 5B_14:5077:6115: scene=5B_14
#: 5B_14:5077
msgctxt "text_id=6115 | speaker=unknown"
msgid "　魔力量こそ同じでも、<神秘|カタチ>を成す術式の強度が違う。"
msgstr ""

#. Occurrence 5B_14:5082:6116: scene=5B_14
#: 5B_14:5082
msgctxt "text_id=6116 | speaker=unknown"
msgid "　青子が限界まで魔力を充電しても、ようやく<今|・><の|・><氷|・><塊|・>を打ち抜ける程度なのだ。"
msgstr ""

#. Occurrence 5B_14:5087:6117: scene=5B_14
#: 5B_14:5087
msgctxt "text_id=6117 | speaker=unknown"
msgid "　<即|すなわ>ち、スナークが限界まで魔力を集めた場合、何をやっても圧し負ける……！"
msgstr ""

#. Occurrence 5B_14:5177:6118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0023; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5177
msgctxt "text_id=6118 | speaker=aoko"
msgid "「なら、その前に―――！」"
msgstr ""

#. Occurrence 5B_14:5183:6119: scene=5B_14
#: 5B_14:5183
msgctxt "text_id=6119 | speaker=unknown"
msgid "　次弾を装填する。"
msgstr ""

#. Occurrence 5B_14:5188:6120: scene=5B_14
#: 5B_14:5188
msgctxt "text_id=6120 | speaker=unknown"
msgid "　空中の第三層に命令を届かせる。"
msgstr ""

#. Occurrence 5B_14:5193:6121: scene=5B_14
#: 5B_14:5193
msgctxt "text_id=6121 | speaker=unknown"
msgid "　体への負担を無視して一層の術式を加速させる。"
msgstr ""

#. Occurrence 5B_14:5280:6122: scene=5B_14
#: 5B_14:5280
msgctxt "text_id=6122 | speaker=unknown"
msgid "　右手の一層は周囲の魔力を吸収、蓄電する役割だ。"
msgstr ""

#. Occurrence 5B_14:5285:6123: scene=5B_14
#: 5B_14:5285
msgctxt "text_id=6123 | speaker=unknown"
msgid "　遊園地を覆う濃霧。フラットスナーク自身がはき出した太古の<魔力|エーテル>が、術式に注ぎ込まれる。"
msgstr ""

#. Occurrence 5B_14:5381:6124: scene=5B_14
#: 5B_14:5381
msgctxt "text_id=6124 | speaker=unknown"
msgid "　当然、術式と一体化している青子の身体は、許容量をはるかに超えた魔力に悲鳴をあげる。"
msgstr ""

#. Occurrence 5B_14:5386:6125: scene=5B_14
#: 5B_14:5386
msgctxt "text_id=6125 | speaker=unknown"
msgid "　いや、歓喜にうち<震|ふる>える。"
msgstr ""

#. Occurrence 5B_14:5406:6126: scene=5B_14
#: 5B_14:5406
msgctxt "text_id=6126 | speaker=unknown"
msgid "　魔術師にとって、魔力とは神秘に至る為の推進剤。"
msgstr ""

#. Occurrence 5B_14:5418:6127: scene=5B_14
#: 5B_14:5418
msgctxt "text_id=6127 | speaker=unknown"
msgid "　体内時間の膨張。"
msgstr ""

#. Occurrence 5B_14:5423:6128: scene=5B_14
#: 5B_14:5423
msgctxt "text_id=6128 | speaker=unknown"
msgid "　自我の融解。"
msgstr ""

#. Occurrence 5B_14:5428:6129: scene=5B_14
#: 5B_14:5428
msgctxt "text_id=6129 | speaker=unknown"
msgid "　肉体からの解放。"
msgstr ""

#. Occurrence 5B_14:5433:6130: scene=5B_14
#: 5B_14:5433
msgctxt "text_id=6130 | speaker=unknown"
msgid "　言ってしまえば臨死体験。"
msgstr ""

#. Occurrence 5B_14:5463:6131: scene=5B_14
#: 5B_14:5463
msgctxt "text_id=6131 | speaker=unknown"
msgid "　そのギリギリの境界で、青子は現実を直視する。"
msgstr ""

#. Occurrence 5B_14:5551:6132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0024; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5551
msgctxt "text_id=6132 | speaker=aoko"
msgid "“――――――”"
msgstr ""

#. Occurrence 5B_14:5557:6133: scene=5B_14
#: 5B_14:5557
msgctxt "text_id=6133 | speaker=unknown"
msgid "　……その現実が、激痛に耐える意志を、折りにくる。"
msgstr ""

#. Occurrence 5B_14:5562:6134: scene=5B_14
#: 5B_14:5562
msgctxt "text_id=6134 | speaker=unknown"
msgid "　誰であろうと差は歴然。"
msgstr ""

#. Occurrence 5B_14:5568:6135: scene=5B_14
#: 5B_14:5568
msgctxt "text_id=6135 | speaker=unknown"
msgid "　蒼崎青子という砲身では、"
msgstr ""

msgctxt "text_id=6136 | speaker=unknown"
msgid "　あの氷塊を<削|けず>る事さえできはしまい―――"
msgstr ""

#. Occurrence 5B_14:5683:6137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0025; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5683
msgctxt "text_id=6137 | speaker=aoko"
msgid "“っ、<痛|そ><み|れ>が―――”"
msgstr ""

#. Occurrence 5B_14:5694:6138: scene=5B_14
#: 5B_14:5694
msgctxt "text_id=6138 | speaker=unknown"
msgid "　術式をなお加速させる。"
msgstr ""

#. Occurrence 5B_14:5759:6139: scene=5B_14
#: 5B_14:5759
msgctxt "text_id=6139 | speaker=unknown"
msgid "　髑髏が笑う。"
msgstr ""

msgctxt "text_id=6140 | speaker=unknown"
msgid "氷塊は盾ではない。"
msgstr ""

msgctxt "text_id=6141 | speaker=unknown"
msgid "アレは身を<弁|わきま>えない魔術師を押しつぶすもの。"
msgstr ""

msgctxt "text_id=6142 | speaker=unknown"
msgid "遊園地全体を<陥没|かんぼつ>させる<氷塊|いちげき>で、青子だけでなく、コースターの上にいる彼さえも踏み砕こうと笑っている。"
msgstr ""

#. Occurrence 5B_14:5824:6143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0026; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5824
msgctxt "text_id=6143 | speaker=aoko"
msgid "“どうした―――！！！！”"
msgstr ""

#. Occurrence 5B_14:5884:6144: scene=5B_14
#: 5B_14:5884
msgctxt "text_id=6144 | speaker=unknown"
msgid "　臨界寸前の魔術回路。"
msgstr ""

#. Occurrence 5B_14:5890:6145: scene=5B_14
#: 5B_14:5890
msgctxt "text_id=6145 | speaker=unknown"
msgid "指先はおろか眼球まで焼く電荷。"
msgstr ""

#. Occurrence 5B_14:5895:6146: scene=5B_14
#: 5B_14:5895
msgctxt "text_id=6146 | speaker=unknown"
msgid "　それでも魔弾の引き金を<絞|しぼ>る。"
msgstr ""

#. Occurrence 5B_14:5900:6147: scene=5B_14
#: 5B_14:5900
msgctxt "text_id=6147 | speaker=unknown"
msgid "　神経の伝達速度で魔術式を<強化|アレンジ>する。"
msgstr ""

#. Occurrence 5B_14:5927:6148: scene=5B_14
#: 5B_14:5927
msgctxt "text_id=6148 | speaker=unknown"
msgid "　一撃では越えられない。"
msgstr ""

#. Occurrence 5B_14:5932:6149: scene=5B_14
#: 5B_14:5932
msgctxt "text_id=6149 | speaker=unknown"
msgid "　側面から撃つ手段はない。"
msgstr ""

#. Occurrence 5B_14:5959:6150: scene=5B_14
#: 5B_14:5959
msgctxt "text_id=6150 | speaker=unknown"
msgid "　なら、<試|や>るべき<手段|こたえ>は明白すぎる―――！"
msgstr ""

#. Occurrence 5B_14:6173:6151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0027; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6173
msgctxt "text_id=6151 | speaker=aoko"
msgid "“<再接続|セレクタ>、<交流数紋|オルタネイト>……！”"
msgstr ""

#. Occurrence 5B_14:6179:6152: scene=5B_14
#: 5B_14:6179
msgctxt "text_id=6152 | speaker=unknown"
msgid "　変革する第三層。"
msgstr ""

#. Occurrence 5B_14:6184:6153: scene=5B_14
#: 5B_14:6184
msgctxt "text_id=6153 | speaker=unknown"
msgid "　直流から交流へ。本来なら軌道の変化を得意とする術式だが、今は単純に数が欲しい……！"
msgstr ""

#. Occurrence 5B_14:6228:6154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0028; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6228
msgctxt "text_id=6154 | speaker=aoko"
msgid "「<接続|セット>、<八芒星|オクタグラム>―――！"
msgstr ""

#. Occurrence 5B_14:6235:6155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0029; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6235
msgctxt "text_id=6155 | speaker=aoko"
msgid "　全界層、ブン回せ―――！」"
msgstr ""

#. Occurrence 5B_14:6757:6156: scene=5B_14
#: 5B_14:6757
msgctxt "text_id=6156 | speaker=unknown"
msgid "　遊園地を照らす青い太陽。"
msgstr ""

#. Occurrence 5B_14:6762:6157: scene=5B_14
#: 5B_14:6762
msgctxt "text_id=6157 | speaker=unknown"
msgid "　最大出力の光弾が、黄金の月を射止めに走る。"
msgstr ""

#. Occurrence 5B_14:7336:6158: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0030; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7336
msgctxt "text_id=6158 | speaker=aoko"
msgid "「こ、のぉ……！」"
msgstr ""

#. Occurrence 5B_14:7342:6159: scene=5B_14
#: 5B_14:7342
msgctxt "text_id=6159 | speaker=unknown"
msgid "　引き金は<絞|しぼ>ったまま、際限なく取りこむ魔力を、休むことなく放ち続ける。"
msgstr ""

#. Occurrence 5B_14:7679:6160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0031; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7679
msgctxt "text_id=6160 | speaker=aoko"
msgid "“っ―――、ぁ―――…………”"
msgstr ""

#. Occurrence 5B_14:7685:6161: scene=5B_14
#: 5B_14:7685
msgctxt "text_id=6161 | speaker=unknown"
msgid "　臨界域から噴き出される青い炎。"
msgstr ""

#. Occurrence 5B_14:7690:6162: scene=5B_14
#: 5B_14:7690
msgctxt "text_id=6162 | speaker=unknown"
msgid "　だが氷塊は融解さえしない。"
msgstr ""

#. Occurrence 5B_14:7695:6163: scene=5B_14
#: 5B_14:7695
msgctxt "text_id=6163 | speaker=unknown"
msgid "　温度以前に、カタチ取られた魔力量が違いすぎる。"
msgstr ""

#. Occurrence 5B_14:7800:6164: scene=5B_14
#: 5B_14:7800
msgctxt "text_id=6164 | speaker=unknown"
msgid "　体内の魔術回路の負荷が、鮮血となって荒れ狂う。"
msgstr ""

#. Occurrence 5B_14:7806:6165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0032; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7806
msgctxt "text_id=6165 | speaker=aoko"
msgid "“っ……！！　これだけ、回して、るのに―――"
msgstr ""

#. Occurrence 5B_14:7812:6166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0033; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7812
msgctxt "text_id=6166 | speaker=aoko"
msgid "　アイツの方が、ぜんぜん、上……！”"
msgstr ""

#. Occurrence 5B_14:7890:6167: scene=5B_14
#: 5B_14:7890
msgctxt "text_id=6167 | speaker=unknown"
msgid "　この戦いは遊園地に満ちた魔力の奪い合いでもある。"
msgstr ""

#. Occurrence 5B_14:7895:6168: scene=5B_14
#: 5B_14:7895
msgctxt "text_id=6168 | speaker=unknown"
msgid "　もとよりここはスナークの庭。"
msgstr ""

#. Occurrence 5B_14:7900:6169: scene=5B_14
#: 5B_14:7900
msgctxt "text_id=6169 | speaker=unknown"
msgid "　空間の支配率はスナークが八割、青子は二割にすぎない。"
msgstr ""

#. Occurrence 5B_14:8030:6170: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0034; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8030
msgctxt "text_id=6170 | speaker=aoko"
msgid "「だ、め……止められ、ない……！」"
msgstr ""

#. Occurrence 5B_14:8150:6171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0035; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8150
msgctxt "text_id=6171 | speaker=aoko"
msgid "“あ……”"
msgstr ""

#. Occurrence 5B_14:8156:6172: scene=5B_14
#: 5B_14:8156
msgctxt "text_id=6172 | speaker=unknown"
msgid "　勝敗を告げるように、氷の城が落ちてくる。"
msgstr ""

#. Occurrence 5B_14:8237:6173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0036; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8237
msgctxt "text_id=6173 | speaker=aoko"
msgid "「あ―――ああ、ああぁああ……！」"
msgstr ""

#. Occurrence 5B_14:8243:6174: scene=5B_14
#: 5B_14:8243
msgctxt "text_id=6174 | speaker=unknown"
msgid "　青子にできるのはその結末を遅らせる程度。"
msgstr ""

#. Occurrence 5B_14:8248:6175: scene=5B_14
#: 5B_14:8248
msgctxt "text_id=6175 | speaker=unknown"
msgid "　追いつめられるだけと分かっていながら、今は魔弾を撃ち続けるしかない。"
msgstr ""

#. Occurrence 5B_14:8303:6176: scene=5B_14
#: 5B_14:8303
msgctxt "text_id=6176 | speaker=unknown"
msgid "　ああ、でも―――今ならまだ、他に手はある。"
msgstr ""

#. Occurrence 5B_14:8308:6177: scene=5B_14
#: 5B_14:8308
msgctxt "text_id=6177 | speaker=unknown"
msgid "　この魔力をすべて防御に回せば、万が一―――いや、高い確率で、<青子|じぶん>だけは助かるのでは、と―――"
msgstr ""

#. Occurrence 5B_14:8412:6178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6178 | speaker=aoko"
msgid "“……っ、うるさい！"
msgstr ""

#. Occurrence 5B_14:8412:6179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6179 | speaker=aoko"
msgid "　ここの魔力を使い切れば、あの氷だって……！”"
msgstr ""

#. Occurrence 5B_14:8418:6180: scene=5B_14
#: 5B_14:8418
msgctxt "text_id=6180 | speaker=unknown"
msgid "　破綻した希望にすがって青子は回路を回し続ける。"
msgstr ""

#. Occurrence 5B_14:8533:6181: scene=5B_14
#: 5B_14:8533
msgctxt "text_id=6181 | speaker=unknown"
msgid "　魔力の<過剰摂取|オーバードウズ>で停止する時間。"
msgstr ""

#. Occurrence 5B_14:8538:6182: scene=5B_14
#: 5B_14:8538
msgctxt "text_id=6182 | speaker=unknown"
msgid "　永遠に続く一秒の激痛。"
msgstr ""

#. Occurrence 5B_14:8543:6183: scene=5B_14
#: 5B_14:8543
msgctxt "text_id=6183 | speaker=unknown"
msgid "　その中で、"
msgstr ""

#. Occurrence 5B_14:8595:6184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0038; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8595
msgctxt "text_id=6184 | speaker=aoko"
msgid "“―――え？”"
msgstr ""

#. Occurrence 5B_14:8628:6185: scene=5B_14
#: 5B_14:8628
msgctxt "text_id=6185 | speaker=unknown"
msgid "　何かが、ひたひたと、"
msgstr ""

#. Occurrence 5B_14:8702:6186: scene=5B_14
#: 5B_14:8702
msgctxt "text_id=6186 | speaker=unknown"
msgid "　何かが、遊園地の物陰から、"
msgstr ""

#. Occurrence 5B_14:8749:6187: scene=5B_14
#: 5B_14:8749
msgctxt "text_id=6187 | speaker=unknown"
msgid "　何かが、"
msgstr ""

msgctxt "text_id=6188 | speaker=unknown"
msgid "何かが、"
msgstr ""

msgctxt "text_id=6189 | speaker=unknown"
msgid "何かが、"
msgstr ""

#. Occurrence 5B_14:8928:6190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0039; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8928
msgctxt "text_id=6190 | speaker=aoko"
msgid "“ちょっ―――”"
msgstr ""

#. Occurrence 5B_14:8934:6191: scene=5B_14
#: 5B_14:8934
msgctxt "text_id=6191 | speaker=unknown"
msgid "　全身が総毛立つ。"
msgstr ""

#. Occurrence 5B_14:8939:6192: scene=5B_14
#: 5B_14:8939
msgctxt "text_id=6192 | speaker=unknown"
msgid "　頭上の氷塊なんて問題じゃない。"
msgstr ""

#. Occurrence 5B_14:8944:6193: scene=5B_14
#: 5B_14:8944
msgctxt "text_id=6193 | speaker=unknown"
msgid "　静止した時間の中で、ひたひたと、赤い死がやってくる。"
msgstr ""

#. Occurrence 5B_14:8972:6194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0040; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8972
msgctxt "text_id=6194 | speaker=aoko"
msgid "“なんで、こんな、ところで…………！”"
msgstr ""

#. Occurrence 5B_14:8978:6195: scene=5B_14
#: 5B_14:8978
msgctxt "text_id=6195 | speaker=unknown"
msgid "　恐怖で<回路|せいしん>が破裂しかける。"
msgstr ""

#. Occurrence 5B_14:8983:6196: scene=5B_14
#: 5B_14:8983
msgctxt "text_id=6196 | speaker=unknown"
msgid "　<術式|こころ>の形成がほころびかける。"
msgstr ""

#. Occurrence 5B_14:8988:6197: scene=5B_14
#: 5B_14:8988
msgctxt "text_id=6197 | speaker=unknown"
msgid "　ソレは彼女の背後にまでやってきて、"
msgstr ""

#. Occurrence 5B_14:8993:6198: scene=5B_14
#: 5B_14:8993
msgctxt "text_id=6198 | speaker=unknown"
msgid "　ひたり、と。"
msgstr ""

#. Occurrence 5B_14:8998:6199: scene=5B_14
#: 5B_14:8998
msgctxt "text_id=6199 | speaker=unknown"
msgid "　血まみれの手で、後ろから青子の両頬に手を当てて、"
msgstr ""

#. Occurrence 5B_14:9093:6200: voice_id=C70_5B_14_0000; voice_prefix=C70; voice_category=0; scene=5B_14
#: 5B_14:9093
msgctxt "text_id=6200 | speaker=unknown"
msgid "　　　　　　　　　"
msgstr ""

msgctxt "text_id=6201 | speaker=unknown"
msgid "『こんにち　は』"
msgstr ""

#. Occurrence 5B_14:9137:6202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0041; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9137
msgctxt "text_id=6202 | speaker=aoko"
msgid "“！！！！！”"
msgstr ""

#. Occurrence 5B_14:9143:6203: scene=5B_14
#: 5B_14:9143
msgctxt "text_id=6203 | speaker=unknown"
msgid "　あらゆる感情、あらゆる自我が絶叫したがる。"
msgstr ""

#. Occurrence 5B_14:9148:6204: scene=5B_14
#: 5B_14:9148
msgctxt "text_id=6204 | speaker=unknown"
msgid "　もういい。どうでもいい、なんでもいい！"
msgstr ""

#. Occurrence 5B_14:9153:6205: scene=5B_14
#: 5B_14:9153
msgctxt "text_id=6205 | speaker=unknown"
msgid "　逃げられるのなら逃げてしまえ！"
msgstr ""

#. Occurrence 5B_14:9158:6206: scene=5B_14
#: 5B_14:9158
msgctxt "text_id=6206 | speaker=unknown"
msgid "　隠しているのなら明かせばいい！"
msgstr ""

#. Occurrence 5B_14:9163:6207: scene=5B_14
#: 5B_14:9163
msgctxt "text_id=6207 | speaker=unknown"
msgid "　使えるのなら、そんなもの、いっそ無慈悲に使えばいい！"
msgstr ""

#. Occurrence 5B_14:9234:6208: scene=5B_14
#: 5B_14:9234
msgctxt "text_id=6208 | speaker=unknown"
msgid "　そうだ。"
msgstr ""

#. Occurrence 5B_14:9239:6209: scene=5B_14
#: 5B_14:9239
msgctxt "text_id=6209 | speaker=unknown"
msgid "　彼女は起死回生の切り札を持っている。"
msgstr ""

#. Occurrence 5B_14:9244:6210: scene=5B_14
#: 5B_14:9244
msgctxt "text_id=6210 | speaker=unknown"
msgid "　あんな氷塊、あんな玩具なんて物ともしない奇蹟を、ある日、ポンと冗談みたいに手渡された。"
msgstr ""

#. Occurrence 5B_14:9253:6211: scene=5B_14
#: 5B_14:9253
msgctxt "text_id=6211 | speaker=unknown"
msgid "　　　　　　　　　　／それを、この赤い死が殺しに来る。"
msgstr ""

#. Occurrence 5B_14:9273:6212: scene=5B_14
#: 5B_14:9273
msgctxt "text_id=6212 | speaker=unknown"
msgid "　使えば破滅。"
msgstr ""

#. Occurrence 5B_14:9278:6213: scene=5B_14
#: 5B_14:9278
msgctxt "text_id=6213 | speaker=unknown"
msgid "　使わずとも氷に潰されて死滅。"
msgstr ""

#. Occurrence 5B_14:9288:6214: scene=5B_14
#: 5B_14:9288
msgctxt "text_id=6214 | speaker=unknown"
msgid "　なら、どうしてためらう必要がある？"
msgstr ""

#. Occurrence 5B_14:9293:6215: scene=5B_14
#: 5B_14:9293
msgctxt "text_id=6215 | speaker=unknown"
msgid "　別に使用制限なんてものはない。"
msgstr ""

#. Occurrence 5B_14:9355:6216: scene=5B_14
#: 5B_14:9355
msgctxt "text_id=6216 | speaker=unknown"
msgid "　等価に何かが失われる事もない。"
msgstr ""

#. Occurrence 5B_14:9360:6217: scene=5B_14
#: 5B_14:9360
msgctxt "text_id=6217 | speaker=unknown"
msgid "　ただ、彼女が彼女でなくなるだけ。"
msgstr ""

#. Occurrence 5B_14:9460:6218: scene=5B_14
#: 5B_14:9460
msgctxt "text_id=6218 | speaker=unknown"
msgid "　たったそれだけ。"
msgstr ""

#. Occurrence 5B_14:9465:6219: scene=5B_14
#: 5B_14:9465
msgctxt "text_id=6219 | speaker=unknown"
msgid "　人間なんて曖昧なものだ。"
msgstr ""

#. Occurrence 5B_14:9470:6220: scene=5B_14
#: 5B_14:9470
msgctxt "text_id=6220 | speaker=unknown"
msgid "　脳の電流は一分ごとに何十回と断線して、何一つ、“いつまでも続いている<自|も><分|の>”なんてない。"
msgstr ""

#. Occurrence 5B_14:9563:6221: scene=5B_14
#: 5B_14:9563
msgctxt "text_id=6221 | speaker=unknown"
msgid "　それは別段、<軽蔑|けいべつ>する事でもなく。"
msgstr ""

#. Occurrence 5B_14:9570:6222: scene=5B_14
#: 5B_14:9570
msgctxt "text_id=6222 | speaker=unknown"
msgid "　それは格段、<禁忌|きんき>するものでもない。"
msgstr ""

#. Occurrence 5B_14:9617:6223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0042; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9617
msgctxt "text_id=6223 | speaker=aoko"
msgid "“―――っ、さい”"
msgstr ""

#. Occurrence 5B_14:9669:6224: scene=5B_14
#: 5B_14:9669
msgctxt "text_id=6224 | speaker=unknown"
msgid "　なのに、口から漏れた声は怒りだった。"
msgstr ""

#. Occurrence 5B_14:9674:6225: scene=5B_14
#: 5B_14:9674
msgctxt "text_id=6225 | speaker=unknown"
msgid "　赤い影はかすかに首をかしげる。"
msgstr ""

#. Occurrence 5B_14:9766:6226: scene=5B_14
#: 5B_14:9766
msgctxt "text_id=6226 | speaker=unknown"
msgid "　少女は声なき声で叫ぶ。"
msgstr ""

#. Occurrence 5B_14:9829:6227: scene=5B_14
#: 5B_14:9829
msgctxt "text_id=6227 | speaker=unknown"
msgid "　魔法を使えば勝てる？　事情も知らないでよくも勝手な。"
msgstr ""

#. Occurrence 5B_14:9834:6228: scene=5B_14
#: 5B_14:9834
msgctxt "text_id=6228 | speaker=unknown"
msgid "　だいたい、そもそも―――"
msgstr ""

#. Occurrence 5B_14:9899:6229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0043; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9899
msgctxt "text_id=6229 | speaker=aoko"
msgid "“あんなの、どうやって使えってぇのよ―――！”"
msgstr ""

#. Occurrence 5B_14:9905:6230: scene=5B_14
#: 5B_14:9905
msgctxt "text_id=6230 | speaker=unknown"
msgid "　彼女には、その魔法とやらの有効な利用法が、どうにも思い当たらない―――！"
msgstr ""

#. Occurrence 5B_14:10518:6231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0044; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10518
msgctxt "text_id=6231 | speaker=aoko"
msgid "「―――って、バカか私……！」"
msgstr ""

#. Occurrence 5B_14:10524:6232: scene=5B_14
#: 5B_14:10524
msgctxt "text_id=6232 | speaker=unknown"
msgid "　一瞬の錯覚から目を覚ます。"
msgstr ""

#. Occurrence 5B_14:10529:6233: scene=5B_14
#: 5B_14:10529
msgctxt "text_id=6233 | speaker=unknown"
msgid "　折れようとしていた心が見せた幻。"
msgstr ""

#. Occurrence 5B_14:10580:6234: scene=5B_14
#: 5B_14:10580
msgctxt "text_id=6234 | speaker=unknown"
msgid "　最低ラインの弱音が、逆に少女の<誇|ほこ>りに火をつけた。"
msgstr ""

#. Occurrence 5B_14:10616:6235: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0003; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:10616
msgctxt "text_id=6235 | speaker=soujuurou"
msgid "『―――逃げるのか？』"
msgstr ""

#. Occurrence 5B_14:10659:6236: scene=5B_14
#: 5B_14:10659
msgctxt "text_id=6236 | speaker=unknown"
msgid "　そうだ。自分は王手をかけられているが、それは相手も同じこと。なぜ負けているかは明白で、あとは対策を立てるだけ。それは十分に実行可能だ。"
msgstr ""

#. Occurrence 5B_14:10665:6237: scene=5B_14
#: 5B_14:10665
msgctxt "text_id=6237 | speaker=unknown"
msgid "たしかに無茶な話だけど、試す前から諦めるのは許されない。"
msgstr ""

#. Occurrence 5B_14:10781:6238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0045; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10781
msgctxt "text_id=6238 | speaker=aoko"
msgid "“……そうだ。"
msgstr ""

#. Occurrence 5B_14:10787:6239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0046; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10787
msgctxt "text_id=6239 | speaker=aoko"
msgid "　放りだすのは、やれる事を全部やってから……！”"
msgstr ""

#. Occurrence 5B_14:10793:6240: scene=5B_14
#: 5B_14:10793
msgctxt "text_id=6240 | speaker=unknown"
msgid "　もう感覚さえ無い指を握りしめる。"
msgstr ""

#. Occurrence 5B_14:10798:6241: scene=5B_14
#: 5B_14:10798
msgctxt "text_id=6241 | speaker=unknown"
msgid "　思考に浮かんだ無理難題は、正気を疑う大博打だ。"
msgstr ""

#. Occurrence 5B_14:10803:6242: scene=5B_14
#: 5B_14:10803
msgctxt "text_id=6242 | speaker=unknown"
msgid "　はじめの一歩をコンマでも間違えれば、その時点で青子の体は蒸発する。"
msgstr ""

#. Occurrence 5B_14:10835:6243: scene=5B_14
#: 5B_14:10835
msgctxt "text_id=6243 | speaker=unknown"
msgid "　ああ、でも―――"
msgstr ""

#. Occurrence 5B_14:10872:6244: scene=5B_14
#: 5B_14:10872
msgctxt "text_id=6244 | speaker=unknown"
msgid "　彼女は、逃げなかった少年を知っている。"
msgstr ""

#. Occurrence 5B_14:10969:6245: scene=5B_14
#: 5B_14:10969
msgctxt "text_id=6245 | speaker=unknown"
msgid "　絶体絶命の窮地なのにギリギリまで耐え続けた、ちっぽけでも輝ける、強い勇気を知っている。"
msgstr ""

#. Occurrence 5B_14:11073:6246: scene=5B_14
#: 5B_14:11073
msgctxt "text_id=6246 | speaker=unknown"
msgid "　そう。この敗北は自分だけの問題ではない。"
msgstr ""

#. Occurrence 5B_14:11078:6247: scene=5B_14
#: 5B_14:11078
msgctxt "text_id=6247 | speaker=unknown"
msgid "　あの氷が落ちれば遊園地そのものが倒壊する。"
msgstr ""

#. Occurrence 5B_14:11083:6248: scene=5B_14
#: 5B_14:11083
msgctxt "text_id=6248 | speaker=unknown"
msgid "　平気な顔で、命懸けの綱渡りをやり通した誰かさんの成果も無駄になる。"
msgstr ""

#. Occurrence 5B_14:11090:6249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0047; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11090
msgctxt "text_id=6249 | speaker=aoko"
msgid "“―――ほんと。"
msgstr ""

#. Occurrence 5B_14:11096:6250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0048; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11096
msgctxt "text_id=6250 | speaker=aoko"
msgid "　それじゃ、何のために意地を張ったか分からない……！”"
msgstr ""

#. Occurrence 5B_14:11243:6251: scene=5B_14
#: 5B_14:11243
msgctxt "text_id=6251 | speaker=unknown"
msgid "　決意と自信は、それこそ<迸|はし>る電荷のように。"
msgstr ""

#. Occurrence 5B_14:11248:6252: scene=5B_14
#: 5B_14:11248
msgctxt "text_id=6252 | speaker=unknown"
msgid "　このまま氷に押しつぶされるのなんて願い下げ。"
msgstr ""

#. Occurrence 5B_14:11253:6253: scene=5B_14
#: 5B_14:11253
msgctxt "text_id=6253 | speaker=unknown"
msgid "　どうせ負けるのなら自滅がいい、と少女は笑った。"
msgstr ""

#. Occurrence 5B_14:11258:6254: scene=5B_14
#: 5B_14:11258
msgctxt "text_id=6254 | speaker=unknown"
msgid "　負けず嫌いでご免あそばせ。こうなったらやられる前に、灰になるまで燃え尽きてやる―――！"
msgstr ""

#. Occurrence 5B_14:11413:6255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0049; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11413
msgctxt "text_id=6255 | speaker=aoko"
msgid "「<接|チ><続|ェ><解|ン><除|ジ>―――<領|チ><域|ェ><拡|ン><大|ジ>、<再接続|チェンジ>―――！」"
msgstr ""

#. Occurrence 5B_14:11428:6256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0050; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11428
msgctxt "text_id=6256 | speaker=aoko"
msgid "“ぐ、つぅ―――！”"
msgstr ""

#. Occurrence 5B_14:11433:6257: scene=5B_14
#: 5B_14:11433
msgctxt "text_id=6257 | speaker=unknown"
msgid "　激流する体内魔力。"
msgstr ""

#. Occurrence 5B_14:11438:6258: scene=5B_14
#: 5B_14:11438
msgctxt "text_id=6258 | speaker=unknown"
msgid "　分解寸前の魔術回路。"
msgstr ""

#. Occurrence 5B_14:11443:6259: scene=5B_14
#: 5B_14:11443
msgctxt "text_id=6259 | speaker=unknown"
msgid "　魔術をカタチにした刻印は皮膚や肉のみならず、骨の<髄|ずい>、骨の<芯|しん>までその文字を刻んでいく。"
msgstr ""

#. Occurrence 5B_14:11578:6260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0051; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11578
msgctxt "text_id=6260 | speaker=aoko"
msgid "「は―――いっっ、つぅ…………！」"
msgstr ""

#. Occurrence 5B_14:11586:6261: scene=5B_14
#: 5B_14:11586
msgctxt "text_id=6261 | speaker=unknown"
msgid "　口元に<諧謔|かいぎゃく>の笑みが浮かぶ。"
msgstr ""

#. Occurrence 5B_14:11591:6262: scene=5B_14
#: 5B_14:11591
msgctxt "text_id=6262 | speaker=unknown"
msgid "　あまりの激痛に理性、基準が逆転した。"
msgstr ""

#. Occurrence 5B_14:11596:6263: scene=5B_14
#: 5B_14:11596
msgctxt "text_id=6263 | speaker=unknown"
msgid "　それも当然。"
msgstr ""

#. Occurrence 5B_14:11602:6264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0052; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11602
msgctxt "text_id=6264 | speaker=aoko"
msgid "“なんだ、やればできるじゃない私……！”"
msgstr ""

#. Occurrence 5B_14:11607:6265: scene=5B_14
#: 5B_14:11607
msgctxt "text_id=6265 | speaker=unknown"
msgid "　極限を<迎|むか>えてまだ耐えている自分の体を、誉めてやらないでどうするのか―――！"
msgstr ""

#. Occurrence 5B_14:11749:6266: scene=5B_14
#: 5B_14:11749
msgctxt "text_id=6266 | speaker=unknown"
msgid "　髑髏の面が異常に気付く。"
msgstr ""

#. Occurrence 5B_14:11754:6267: scene=5B_14
#: 5B_14:11754
msgctxt "text_id=6267 | speaker=unknown"
msgid "　空間の支配率が拮抗している事を、彼はようやく観測した。"
msgstr ""

#. Occurrence 5B_14:11759:6268: scene=5B_14
#: 5B_14:11759
msgctxt "text_id=6268 | speaker=unknown"
msgid "　だがその慢心を笑えようか。"
msgstr ""

#. Occurrence 5B_14:11764:6269: scene=5B_14
#: 5B_14:11764
msgctxt "text_id=6269 | speaker=unknown"
msgid "　千年を越える器物の王、フラットスナークに勝る“魔力使い”が、この末世の時代に現れるなど―――！"
msgstr ""

#. Occurrence 5B_14:11858:6270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0053; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11858
msgctxt "text_id=6270 | speaker=aoko"
msgid "「ふ―――っ、うっ……！」"
msgstr ""

#. Occurrence 5B_14:11864:6271: scene=5B_14
#: 5B_14:11864
msgctxt "text_id=6271 | speaker=unknown"
msgid "　呼吸を整える。"
msgstr ""

#. Occurrence 5B_14:11869:6272: scene=5B_14
#: 5B_14:11869
msgctxt "text_id=6272 | speaker=unknown"
msgid "　この後に来るであろう激痛に身構える。"
msgstr ""

#. Occurrence 5B_14:11874:6273: scene=5B_14
#: 5B_14:11874
msgctxt "text_id=6273 | speaker=unknown"
msgid "　<あ|・><の|・><氷|・><を|・><撃|・><ち|・><破|・><る|・>。"
msgstr ""

#. Occurrence 5B_14:11879:6274: scene=5B_14
#: 5B_14:11879
msgctxt "text_id=6274 | speaker=unknown"
msgid "　使用できる魔力量は同じ。"
msgstr ""

#. Occurrence 5B_14:11884:6275: scene=5B_14
#: 5B_14:11884
msgctxt "text_id=6275 | speaker=unknown"
msgid "　なのに力負けしているのは、つまり―――"
msgstr ""

#. Occurrence 5B_14:11998:6276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0054; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11998
msgctxt "text_id=6276 | speaker=aoko"
msgid "“……出力装置に差があった。魔力の吸飲、砲身の規模で負けているのなら。"
msgstr ""

#. Occurrence 5B_14:12004:6277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0055; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12004
msgctxt "text_id=6277 | speaker=aoko"
msgid "　単純な話、<術式|わたし>を<増築|でかく>するだけでいい―――！”"
msgstr ""

#. Occurrence 5B_14:12050:6278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0056; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12050
msgctxt "text_id=6278 | speaker=aoko"
msgid "「―――<再接続|チェンジ>、<魔弾|ツアー><形式|プラン>―――」"
msgstr ""

#. Occurrence 5B_14:12275:6279: scene=5B_14
#: 5B_14:12275
msgctxt "text_id=6279 | speaker=unknown"
msgid "　フィードバックは今までの比ではないだろう。"
msgstr ""

#. Occurrence 5B_14:12280:6280: scene=5B_14
#: 5B_14:12280
msgctxt "text_id=6280 | speaker=unknown"
msgid "　彼女の選択は単純にして、蛮勇きわまりない。"
msgstr ""

#. Occurrence 5B_14:12285:6281: scene=5B_14
#: 5B_14:12285
msgctxt "text_id=6281 | speaker=unknown"
msgid "　最大展開する二つの術式。"
msgstr ""

#. Occurrence 5B_14:12290:6282: scene=5B_14
#: 5B_14:12290
msgctxt "text_id=6282 | speaker=unknown"
msgid "　一層は巨大な渦と化して霧という霧を飲みこみ、"
msgstr ""

#. Occurrence 5B_14:12295:6283: scene=5B_14
#: 5B_14:12295
msgctxt "text_id=6283 | speaker=unknown"
msgid "　二層はかたっぱしから魔力を加工して<砲身|あおこ>に注ぎ込む。"
msgstr ""

#. Occurrence 5B_14:12425:6284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0057; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12425
msgctxt "text_id=6284 | speaker=aoko"
msgid "「―――私の想定が甘かった。"
msgstr ""

#. Occurrence 5B_14:12431:6285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0058; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12431
msgctxt "text_id=6285 | speaker=aoko"
msgid "　撃ち落とす、なんてハンパもいいとこ。"
msgstr ""

#. Occurrence 5B_14:12437:6286: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0059; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12437
msgctxt "text_id=6286 | speaker=aoko"
msgid "　この場合、跡形もなく<撃|・><ち|・><砕|・><く|・>、だっ……！」"
msgstr ""

#. Occurrence 5B_14:12541:6287: scene=5B_14
#: 5B_14:12541
msgctxt "text_id=6287 | speaker=unknown"
msgid "　術者の確信に、太古の魔力が呼応する。"
msgstr ""

#. Occurrence 5B_14:12546:6288: scene=5B_14
#: 5B_14:12546
msgctxt "text_id=6288 | speaker=unknown"
msgid "　のたうち回る<大蛇|オロチ>の紋様。"
msgstr ""

#. Occurrence 5B_14:12551:6289: scene=5B_14
#: 5B_14:12551
msgctxt "text_id=6289 | speaker=unknown"
msgid "　反旗を<翻|ひるが>す声なき魔力。"
msgstr ""

#. Occurrence 5B_14:12682:6290: scene=5B_14
#: 5B_14:12682
msgctxt "text_id=6290 | speaker=unknown"
msgid "　さあ―――いざ地を<省|かえり>みよ<貴|たけ>き遺産。"
msgstr ""

#. Occurrence 5B_14:12687:6291: scene=5B_14
#: 5B_14:12687
msgctxt "text_id=6291 | speaker=unknown"
msgid "　あれなるは開拓の<最先端|トップランナー>。"
msgstr ""

#. Occurrence 5B_14:12692:6292: scene=5B_14
#: 5B_14:12692
msgctxt "text_id=6292 | speaker=unknown"
msgid "　これより数多の神秘、あらゆる伝統を台無しにする、恐れ知らずの人類代表。"
msgstr ""

#. Occurrence 5B_14:12830:6293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0060; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12830
msgctxt "text_id=6293 | speaker=aoko"
msgid "「貸し借りはここまでよ嘘つきブージャム。"
msgstr ""

#. Occurrence 5B_14:12836:6294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0061; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12836
msgctxt "text_id=6294 | speaker=aoko"
msgid "　お望み通り、ノシをつけて返してあげる……！」"
msgstr ""

#. Occurrence 5B_14:12842:6295: scene=5B_14
#: 5B_14:12842
msgctxt "text_id=6295 | speaker=unknown"
msgid "　消費／消滅の理を<担|にな>う、最新の魔法使い―――！"
msgstr ""

#. Occurrence 5B_14:13353:6296: scene=5B_14
#: 5B_14:13353
msgctxt "text_id=6296 | speaker=unknown"
msgid "　常識外の光弾が氷の城を融解させる。"
msgstr ""

#. Occurrence 5B_14:13358:6297: scene=5B_14
#: 5B_14:13358
msgctxt "text_id=6297 | speaker=unknown"
msgid "　砲身は焼ききれない。"
msgstr ""

#. Occurrence 5B_14:13479:6298: scene=5B_14
#: 5B_14:13479
msgctxt "text_id=6298 | speaker=unknown"
msgid "　彼女の魔力の扱いは神懸かっている。"
msgstr ""

#. Occurrence 5B_14:13484:6299: scene=5B_14
#: 5B_14:13484
msgctxt "text_id=6299 | speaker=unknown"
msgid "　最大十万キロ、赤道の二周半に相当する<血管|バイパス>は貪欲に魔力を受け入れ、倍の速度で魔弾を月へとたたき込む―――！"
msgstr ""

#. Occurrence 5B_14:13666:6300: scene=5B_14
#: 5B_14:13666
msgctxt "text_id=6300 | speaker=unknown"
msgid "　否　否　否　否！"
msgstr ""

#. Occurrence 5B_14:13672:6301: scene=5B_14
#: 5B_14:13672
msgctxt "text_id=6301 | speaker=unknown"
msgid "　月面に死相が浮かぶ。"
msgstr ""

#. Occurrence 5B_14:13677:6302: scene=5B_14
#: 5B_14:13677
msgctxt "text_id=6302 | speaker=unknown"
msgid "　廃遊園地に響く、恐怖あるいは<憤怒|ふんぬ>の叫び。"
msgstr ""

#. Occurrence 5B_14:13682:6303: scene=5B_14
#: 5B_14:13682
msgctxt "text_id=6303 | speaker=unknown"
msgid "　幻想に生きるソレにとって、現実はかくもおぞましく<眼|まなこ>を焦がす。"
msgstr ""

#. Occurrence 5B_14:13705:6304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0062; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13705
msgctxt "text_id=6304 | speaker=aoko"
msgid "「―――ハ」"
msgstr ""

#. Occurrence 5B_14:13711:6305: scene=5B_14
#: 5B_14:13711
msgctxt "text_id=6305 | speaker=unknown"
msgid "　その悪あがきに、彼女は勝利を確信した。"
msgstr ""

#. Occurrence 5B_14:13716:6306: scene=5B_14
#: 5B_14:13716
msgctxt "text_id=6306 | speaker=unknown"
msgid "　あまりにも無駄な魔力の使い方だ。"
msgstr ""

#. Occurrence 5B_14:13721:6307: scene=5B_14
#: 5B_14:13721
msgctxt "text_id=6307 | speaker=unknown"
msgid "　<傾|かたむ>きだしていた魔力の天秤は、完全に彼女のもとへなだれこみ―――"
msgstr ""

#. Occurrence 5B_14:13728:6308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0063; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13728
msgctxt "text_id=6308 | speaker=aoko"
msgid "「<魔弾形|　ツアープラン>式―――」"
msgstr ""

#. Occurrence 5B_14:13774:6309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0064; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13774
msgctxt "text_id=6309 | speaker=aoko"
msgid "「<大月蝕|ブラックライト>、<収斂投|　スターボウ>射―――！"
msgstr ""

#. Occurrence 5B_14:13780:6310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0065; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13780
msgctxt "text_id=6310 | speaker=aoko"
msgid "　一気に、ブチ抜けぇーーーーーえ！！！！！」"
msgstr ""

#. Occurrence 5B_14:14342:6311: scene=5B_14
#: 5B_14:14342
msgctxt "text_id=6311 | speaker=unknown"
msgid "　砕く。砕く。砕く。砕く。"
msgstr ""

#. Occurrence 5B_14:14347:6312: scene=5B_14
#: 5B_14:14347
msgctxt "text_id=6312 | speaker=unknown"
msgid "　微塵と散る摩天楼。"
msgstr ""

#. Occurrence 5B_14:14352:6313: scene=5B_14
#: 5B_14:14352
msgctxt "text_id=6313 | speaker=unknown"
msgid "　決して届かぬと謳われ、多くの挑戦者を飲んだ絶望の島。"
msgstr ""

#. Occurrence 5B_14:14470:6314: scene=5B_14
#: 5B_14:14470
msgctxt "text_id=6314 | speaker=unknown"
msgid "　その、人智<未踏|みとう>を誇った先にあるモノこそ―――"
msgstr ""

#. Occurrence 5B_14:14551:6315: scene=5B_14
#: 5B_14:14551
msgctxt "text_id=6315 | speaker=unknown"
msgid "　破滅を叫ぶ紺碧の霧。"
msgstr ""

#. Occurrence 5B_14:14556:6316: scene=5B_14
#: 5B_14:14556
msgctxt "text_id=6316 | speaker=unknown"
msgid "　崩壊する絶氷の<天|ソ><蓋|ラ>。"
msgstr ""

#. Occurrence 5B_14:14562:6317: scene=5B_14
#: 5B_14:14562
msgctxt "text_id=6317 | speaker=unknown"
msgid "　スナーク<狩り|ハント>の魔弾は月を越えて。"
msgstr ""

#. Occurrence 5B_14:14568:6318: scene=5B_14
#: 5B_14:14568
msgctxt "text_id=6318 | speaker=unknown"
msgid "　断末魔は<潮騒|しおさい>のように、御伽の国に響き渡り―――"
msgstr ""

#. Occurrence 5B_14:14715:6319: scene=5B_14
#: 5B_14:14715
msgctxt "text_id=6319 | speaker=unknown"
msgid "　―――勝敗は、ここに決した。"
msgstr ""

#. Occurrence 5B_14:14721:6320: scene=5B_14
#: 5B_14:14721
msgctxt "text_id=6320 | speaker=unknown"
msgid "　濃霧は途絶え、砕かれた氷は地上に降ることなく霧散していく。"
msgstr ""

#. Occurrence 5B_14:14726:6321: scene=5B_14
#: 5B_14:14726
msgctxt "text_id=6321 | speaker=unknown"
msgid "　魔弾は敗因を悔やませる間もなく、玉座ごと夜の王を撃ち砕いた。"
msgstr ""

#. Occurrence 5B_14:14747:6322: scene=5B_14
#: 5B_14:14747
msgctxt "text_id=6322 | speaker=unknown"
msgid "　月の油。"
msgstr ""

#. Occurrence 5B_14:14752:6323: scene=5B_14
#: 5B_14:14752
msgctxt "text_id=6323 | speaker=unknown"
msgid "　触れられぬもの、フラットスナーク。"
msgstr ""

#. Occurrence 5B_14:14758:6324: scene=5B_14
#: 5B_14:14758
msgctxt "text_id=6324 | speaker=unknown"
msgid "　廃棄されたモノを蘇らせる一夜の夢は、自らの死をもって、悪夢に幕を下ろしたのだ。"
msgstr ""

#. Occurrence 5B_15:103:6325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0000; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:103
msgctxt "text_id=6325 | speaker=aoko"
msgid "「―――うわ。さすがに、無茶だわ」"
msgstr ""

#. Occurrence 5B_15:153:6326: scene=5B_15
#: 5B_15:153
msgctxt "text_id=6326 | speaker=unknown"
msgid "　青子は倒れたまま夜空を見上げている。"
msgstr ""

#. Occurrence 5B_15:158:6327: scene=5B_15
#: 5B_15:158
msgctxt "text_id=6327 | speaker=unknown"
msgid "　体はもう指一本だって動かない。"
msgstr ""

#. Occurrence 5B_15:163:6328: scene=5B_15
#: 5B_15:163
msgctxt "text_id=6328 | speaker=unknown"
msgid "　なんとか体を起こそうと力を入れてみたが、どこもかしこも悲鳴をあげている。"
msgstr ""

#. Occurrence 5B_15:183:6329: scene=5B_15
#: 5B_15:183
msgctxt "text_id=6329 | speaker=unknown"
msgid "　魔力はすっからかんで、魔術刻印も停止していた。"
msgstr ""

#. Occurrence 5B_15:188:6330: scene=5B_15
#: 5B_15:188
msgctxt "text_id=6330 | speaker=unknown"
msgid "　体力の回復……もとい、身体機能の完全回復には丸一日を要するだろう。"
msgstr ""

#. Occurrence 5B_15:193:6331: scene=5B_15
#: 5B_15:193
msgctxt "text_id=6331 | speaker=unknown"
msgid "　情けない話だが、今は呼吸だけで精一杯。"
msgstr ""

#. Occurrence 5B_15:212:6332: scene=5B_15
#: 5B_15:212
msgctxt "text_id=6332 | speaker=unknown"
msgid "　反面、胸はかつてない達成感に満ちていた。"
msgstr ""

#. Occurrence 5B_15:253:6333: scene=5B_15
#: 5B_15:253
msgctxt "text_id=6333 | speaker=unknown"
msgid "　なにしろ、あの“童話の怪物”のうち一体を真っ向から撃ち壊したのだ。"
msgstr ""

#. Occurrence 5B_15:258:6334: scene=5B_15
#: 5B_15:258
msgctxt "text_id=6334 | speaker=unknown"
msgid "　自分に有利な状況が続いただけ、とも言えるが、手も足もでなかった半年前に比べれば格段の進歩である。"
msgstr ""

#. Occurrence 5B_15:332:6335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0001; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:332
msgctxt "text_id=6335 | speaker=aoko"
msgid "“……それはそれとして、有珠には<謝|あやま>っとかないと。"
msgstr ""

#. Occurrence 5B_15:338:6336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0002; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:338
msgctxt "text_id=6336 | speaker=aoko"
msgid "　プロイって、壊したらそれっきりだものね”"
msgstr ""

#. Occurrence 5B_15:344:6337: scene=5B_15
#: 5B_15:344
msgctxt "text_id=6337 | speaker=unknown"
msgid "　そう。フラットスナークはもう二度と現れない。"
msgstr ""

#. Occurrence 5B_15:349:6338: scene=5B_15
#: 5B_15:349
msgctxt "text_id=6338 | speaker=unknown"
msgid "　ロンドンの協会に売り出せば値の付かない超稀少品、"
msgstr ""

#. Occurrence 5B_15:354:6339: scene=5B_15
#: 5B_15:354
msgctxt "text_id=6339 | speaker=unknown"
msgid "　魔術世界の財産とまで言われる秘術を、青子は跡形もなくブッ壊してしまったのだ。"
msgstr ""

#. Occurrence 5B_15:359:6340: scene=5B_15
#: 5B_15:359
msgctxt "text_id=6340 | speaker=unknown"
msgid "　なんというか、その場のノリと勢いで。"
msgstr ""

#. Occurrence 5B_15:398:6341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0003; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:398
msgctxt "text_id=6341 | speaker=aoko"
msgid "“まあ、でも―――”"
msgstr ""

#. Occurrence 5B_15:433:6342: scene=5B_15
#: 5B_15:433
msgctxt "text_id=6342 | speaker=unknown"
msgid "　お互い納得ずくの戦いだったから、有珠は文句ひとつ言わないだろう。"
msgstr ""

#. Occurrence 5B_15:438:6343: scene=5B_15
#: 5B_15:438
msgctxt "text_id=6343 | speaker=unknown"
msgid "　内心では不満いっぱいと思われるが、あの少女はそういう、自らの品格を落とす真似はしないのだ。"
msgstr ""

#. Occurrence 5B_15:514:6344: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0004; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:514
msgctxt "text_id=6344 | speaker=aoko"
msgid "「っ―――」"
msgstr ""

#. Occurrence 5B_15:713:6345: scene=5B_15
#: 5B_15:713
msgctxt "text_id=6345 | speaker=unknown"
msgid "　安心から気が緩み、積み重なった疲労がなだれこむ。"
msgstr ""

#. Occurrence 5B_15:718:6346: scene=5B_15
#: 5B_15:718
msgctxt "text_id=6346 | speaker=unknown"
msgid "　失神じみた眠気を青子は理性で押しとどめた。"
msgstr ""

#. Occurrence 5B_15:723:6347: scene=5B_15
#: 5B_15:723
msgctxt "text_id=6347 | speaker=unknown"
msgid "　体の中は細かい傷だらけだが、奇跡的に外傷はない。このまま<十分|じゅっぷん>も休んでいれば立ち上がる事ぐらいはできそうだ。"
msgstr ""

#. Occurrence 5B_15:813:6348: scene=5B_15
#: 5B_15:813
msgctxt "text_id=6348 | speaker=unknown"
msgid "　夜空には、いまだ炎上する黄金の月。"
msgstr ""

#. Occurrence 5B_15:820:6349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0005; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:820
msgctxt "text_id=6349 | speaker=aoko"
msgid "“正体は油だものね。そりゃあ、いつまでも燃え―――”"
msgstr ""

#. Occurrence 5B_15:830:6350: scene=5B_15
#: 5B_15:830
msgctxt "text_id=6350 | speaker=unknown"
msgid "　<漠然|ばくぜん>と空を見ていた目が、<愕然|がくぜん>とした空白に切り替わる。"
msgstr ""

#. Occurrence 5B_15:850:6351: scene=5B_15
#: 5B_15:850
msgctxt "text_id=6351 | speaker=unknown"
msgid "　彼女は指一本動かない状態で、"
msgstr ""

#. Occurrence 5B_15:857:6352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0006; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:857
msgctxt "text_id=6352 | speaker=aoko"
msgid "“……そっか。スナークを見つけたベイカーも、最後はいっしょに消えるんだっけ―――”"
msgstr ""

#. Occurrence 5B_15:1017:6353: scene=5B_15
#: 5B_15:1017
msgctxt "text_id=6353 | speaker=unknown"
msgid "　あーあ、と。"
msgstr ""

#. Occurrence 5B_15:1022:6354: scene=5B_15
#: 5B_15:1022
msgctxt "text_id=6354 | speaker=unknown"
msgid "　最後の反撃で燃え尽きる、十秒後の<自分|みらい>を受け入れた。"
msgstr ""

#. Occurrence 5B_15:1082:6355: scene=5B_15
#: 5B_15:1082
msgctxt "text_id=6355 | speaker=unknown"
msgid "　―――一方、そのちょっと前。"
msgstr ""

#. Occurrence 5B_15:1088:6356: scene=5B_15
#: 5B_15:1088
msgctxt "text_id=6356 | speaker=unknown"
msgid "　強風<荒|すさ>ぶ<鉄骨橋|コースター>の上で、難しい顔のまま、彼は地上に目をこらしていた。"
msgstr ""

#. Occurrence 5B_15:1150:6357: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0000; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1150
msgctxt "text_id=6357 | speaker=soujuurou"
msgid "「―――むむ？」"
msgstr ""

#. Occurrence 5B_15:1197:6358: scene=5B_15
#: 5B_15:1197
msgctxt "text_id=6358 | speaker=unknown"
msgid "　こぼれた呟きはこの上なく頼りない。"
msgstr ""

#. Occurrence 5B_15:1202:6359: scene=5B_15
#: 5B_15:1202
msgctxt "text_id=6359 | speaker=unknown"
msgid "　彼の視線の先。地上ではクリーチャーたちの目を盗んで地面に図形を刻んでいる青子の姿と―――"
msgstr ""

#. Occurrence 5B_15:1268:6360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0001; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1268
msgctxt "text_id=6360 | speaker=soujuurou"
msgid "「……なんだアレ。いくらなんでも頑丈すぎないか？」"
msgstr ""

#. Occurrence 5B_15:1274:6361: scene=5B_15
#: 5B_15:1274
msgctxt "text_id=6361 | speaker=unknown"
msgid "　そのずっと向こう。"
msgstr ""

#. Occurrence 5B_15:1279:6362: scene=5B_15
#: 5B_15:1279
msgctxt "text_id=6362 | speaker=unknown"
msgid "　倒壊したミラーハウスの方角に、何か、見覚えのあるモノを見た気がした。"
msgstr ""

#. Occurrence 5B_15:1299:6363: scene=5B_15
#: 5B_15:1299
msgctxt "text_id=6363 | speaker=unknown"
msgid "　草十郎の役割……地上六十メートルの高みから青子の髪を投げる、という仕事は終わっている。"
msgstr ""

#. Occurrence 5B_15:1304:6364: scene=5B_15
#: 5B_15:1304
msgctxt "text_id=6364 | speaker=unknown"
msgid "　派手さこそないが、掛け値無しで命がけの難行だった。"
msgstr ""

#. Occurrence 5B_15:1381:6365: scene=5B_15
#: 5B_15:1381
msgctxt "text_id=6365 | speaker=unknown"
msgid "　さらに付け加えるのなら、この後どうやって下りるのかを考えるだけで目眩がする。"
msgstr ""

#. Occurrence 5B_15:1386:6366: scene=5B_15
#: 5B_15:1386
msgctxt "text_id=6366 | speaker=unknown"
msgid "　これ以上の厄介事なんて、とてもじゃないが頷けない。"
msgstr ""

#. Occurrence 5B_15:1422:6367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0002; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1422
msgctxt "text_id=6367 | speaker=soujuurou"
msgid "「―――いや、でも、アレ―――」"
msgstr ""

#. Occurrence 5B_15:1717:6368: scene=5B_15
#: 5B_15:1717
msgctxt "text_id=6368 | speaker=unknown"
msgid "　ぐらぐら揺れる橋の上で、わたわたと取り乱す。"
msgstr ""

#. Occurrence 5B_15:1903:6369: scene=5B_15
#: 5B_15:1903
msgctxt "text_id=6369 | speaker=unknown"
msgid "　空には前触れなく現れた髑髏の面。"
msgstr ""

#. Occurrence 5B_15:1926:6370: scene=5B_15
#: 5B_15:1926
msgctxt "text_id=6370 | speaker=unknown"
msgid "　地上にはぐるんぐるん回転している青い光と、その中心にいる蒼崎青子。"
msgstr ""

#. Occurrence 5B_15:1980:6371: scene=5B_15
#: 5B_15:1980
msgctxt "text_id=6371 | speaker=unknown"
msgid "　……そしてもう一つ。"
msgstr ""

#. Occurrence 5B_15:1985:6372: scene=5B_15
#: 5B_15:1985
msgctxt "text_id=6372 | speaker=unknown"
msgid "　この位置にいる草十郎にしか知り得ないヒト影が、月に挑む青子へと迫っていた。"
msgstr ""

#. Occurrence 5B_15:2048:6373: scene=5B_15
#: 5B_15:2048
msgctxt "text_id=6373 | speaker=unknown"
msgid "　その影には下半身がない。"
msgstr ""

#. Occurrence 5B_15:2053:6374: scene=5B_15
#: 5B_15:2053
msgctxt "text_id=6374 | speaker=unknown"
msgid "　上半身だけの体で、ずるずると青子に近づいている。"
msgstr ""

#. Occurrence 5B_15:2058:6375: scene=5B_15
#: 5B_15:2058
msgctxt "text_id=6375 | speaker=unknown"
msgid "　距離的にはあと二百メートルほど。"
msgstr ""

#. Occurrence 5B_15:2063:6376: scene=5B_15
#: 5B_15:2063
msgctxt "text_id=6376 | speaker=unknown"
msgid "　不運な事に、青子の背後から<這|・><っ|・><て|・><き|・><て|・>いるため、彼女はその影に気付けない。"
msgstr ""

#. Occurrence 5B_15:2087:6377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0003; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2087
msgctxt "text_id=6377 | speaker=soujuurou"
msgid "「―――遠くて見えないけど、アレは―――」"
msgstr ""

#. Occurrence 5B_15:2100:6378: scene=5B_15
#: 5B_15:2100
msgctxt "text_id=6378 | speaker=unknown"
msgid "　間違いない。"
msgstr ""

#. Occurrence 5B_15:2105:6379: scene=5B_15
#: 5B_15:2105
msgctxt "text_id=6379 | speaker=unknown"
msgid "　この遊園地において、草十郎ではなく青子を狙うのは<あ|・><の|・><人|・><形|・>だけなのだから。"
msgstr ""

#. Occurrence 5B_15:2161:6380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6380 | speaker=soujuurou"
msgid "「いや、でも。ほら、あるいは、ひょっとして―――"
msgstr ""

#. Occurrence 5B_15:2161:6381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6381 | speaker=soujuurou"
msgid "　ただの偶然、ではないだろうか」"
msgstr ""

#. Occurrence 5B_15:2178:6382: scene=5B_15
#: 5B_15:2178
msgctxt "text_id=6382 | speaker=unknown"
msgid "　幾重にも交錯し、混乱する思考。"
msgstr ""

#. Occurrence 5B_15:2183:6383: scene=5B_15
#: 5B_15:2183
msgctxt "text_id=6383 | speaker=unknown"
msgid "　それも無理からぬ事だろう。"
msgstr ""

#. Occurrence 5B_15:2188:6384: scene=5B_15
#: 5B_15:2188
msgctxt "text_id=6384 | speaker=unknown"
msgid "　膨張した月と<光弾|ビーム>を撃ちまくってる少女、という状況だけで、草十郎的には目を疑う状況なのだ。"
msgstr ""

#. Occurrence 5B_15:2470:6385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0005; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2470
msgctxt "text_id=6385 | speaker=soujuurou"
msgid "「うわぁ……！」"
msgstr ""

#. Occurrence 5B_15:2476:6386: scene=5B_15
#: 5B_15:2476
msgctxt "text_id=6386 | speaker=unknown"
msgid "　青子の容赦のない超距離魔弾は、嵐のようにコースターを揺さぶっていく。"
msgstr ""

#. Occurrence 5B_15:2481:6387: scene=5B_15
#: 5B_15:2481
msgctxt "text_id=6387 | speaker=unknown"
msgid "　立っているだけで振り落とされ、転落死しかねない。"
msgstr ""

#. Occurrence 5B_15:2607:6388: scene=5B_15
#: 5B_15:2607
msgctxt "text_id=6388 | speaker=unknown"
msgid "　とにかく、この状況は草十郎には難しすぎる。"
msgstr ""

#. Occurrence 5B_15:2612:6389: scene=5B_15
#: 5B_15:2612
msgctxt "text_id=6389 | speaker=unknown"
msgid "　ここからコースターの入り口まで戻って青子に注意を<促|うなが>しに行くか？"
msgstr ""

#. Occurrence 5B_15:2618:6390: scene=5B_15
#: 5B_15:2618
msgctxt "text_id=6390 | speaker=unknown"
msgid "　いや、間に合うハズもなし、駆け下りたところで入り口には大量の焼きたてパンがいる。"
msgstr ""

#. Occurrence 5B_15:2623:6391: scene=5B_15
#: 5B_15:2623
msgctxt "text_id=6391 | speaker=unknown"
msgid "　そもそも青子は人形に気付いていて、近づいたとたん一撃で倒す可能性もある。その場合、自慢じゃないが足を引っ張る自信すらある草十郎だった。"
msgstr ""

#. Occurrence 5B_15:2884:6392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0006; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2884
msgctxt "text_id=6392 | speaker=soujuurou"
msgid "「っ………………」"
msgstr ""

#. Occurrence 5B_15:2890:6393: scene=5B_15
#: 5B_15:2890
msgctxt "text_id=6393 | speaker=unknown"
msgid "　何を選んでも役に立てそうにない状況。"
msgstr ""

#. Occurrence 5B_15:2895:6394: scene=5B_15
#: 5B_15:2895
msgctxt "text_id=6394 | speaker=unknown"
msgid "　第一、危険なのは青子だけでなく、草十郎も窮地に立っている。"
msgstr ""

#. Occurrence 5B_15:2931:6395: scene=5B_15
#: 5B_15:2931
msgctxt "text_id=6395 | speaker=unknown"
msgid "『行きは良い良い帰りは怖い』"
msgstr ""

#. Occurrence 5B_15:2986:6396: scene=5B_15
#: 5B_15:2986
msgctxt "text_id=6396 | speaker=unknown"
msgid "　帰り道に鬼が待っているのは都会であろうと山奥であろうと同じこと。"
msgstr ""

#. Occurrence 5B_15:2991:6397: scene=5B_15
#: 5B_15:2991
msgctxt "text_id=6397 | speaker=unknown"
msgid "　この道は特に顕著だ。行きはもちろん、帰り道も危険すぎる。"
msgstr ""

#. Occurrence 5B_15:2997:6398: scene=5B_15
#: 5B_15:2997
msgctxt "text_id=6398 | speaker=unknown"
msgid "<他|ひ><人|と>の事を心配する余裕はどこにもない。"
msgstr ""

#. Occurrence 5B_15:3002:6399: scene=5B_15
#: 5B_15:3002
msgctxt "text_id=6399 | speaker=unknown"
msgid "　地上六十メートルの死の淵にいる事を忘れるな、と草十郎は震える足に言い聞かせる。"
msgstr ""

#. Occurrence 5B_15:3023:6400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0007; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3023
msgctxt "text_id=6400 | speaker=soujuurou"
msgid "“……大丈夫、それは分かっている。けど―――”"
msgstr ""

#. Occurrence 5B_15:3028:6401: scene=5B_15
#: 5B_15:3028
msgctxt "text_id=6401 | speaker=unknown"
msgid "　キリキリと頭が痛む。"
msgstr ""

#. Occurrence 5B_15:3033:6402: scene=5B_15
#: 5B_15:3033
msgctxt "text_id=6402 | speaker=unknown"
msgid "　無謀である事も、馬鹿げた事なのも分かっている。"
msgstr ""

#. Occurrence 5B_15:3039:6403: scene=5B_15
#: 5B_15:3039
msgctxt "text_id=6403 | speaker=unknown"
msgid "山奥育ちの彼は、都会の誰よりも危険に関して敏感で、これからするコトを考えるだけで緊張で喉が嗄れきってしまう。"
msgstr ""

#. Occurrence 5B_15:3044:6404: scene=5B_15
#: 5B_15:3044
msgctxt "text_id=6404 | speaker=unknown"
msgid "　が、そんな草十郎でもはっきりと言えることは、"
msgstr ""

#. Occurrence 5B_15:3054:6405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0008; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3054
msgctxt "text_id=6405 | speaker=soujuurou"
msgid "「蒼崎のことだ、アレにぜったい気付いていない……！」"
msgstr ""

#. Occurrence 5B_15:3186:6406: scene=5B_15
#: 5B_15:3186
msgctxt "text_id=6406 | speaker=unknown"
msgid "　<半|なか>ば泣くような声をあげて、草十郎は高さ六十メートルの鉄骨を駆け下りだした。"
msgstr ""

#. Occurrence 5B_15:3290:6407: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0009; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3290
msgctxt "text_id=6407 | speaker=soujuurou"
msgid "「はっ、はっ、はぁ、はっ―――！」"
msgstr ""

#. Occurrence 5B_15:3296:6408: scene=5B_15
#: 5B_15:3296
msgctxt "text_id=6408 | speaker=unknown"
msgid "　死の道行きを加速する。"
msgstr ""

#. Occurrence 5B_15:3301:6409: scene=5B_15
#: 5B_15:3301
msgctxt "text_id=6409 | speaker=unknown"
msgid "　加速するつもりはなくとも、下り坂である以上スピードは増していく。"
msgstr ""

#. Occurrence 5B_15:3436:6410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0010; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3436
msgctxt "text_id=6410 | speaker=soujuurou"
msgid "「っ、この、はっ、よっと―――！」"
msgstr ""

#. Occurrence 5B_15:3442:6411: scene=5B_15
#: 5B_15:3442
msgctxt "text_id=6411 | speaker=unknown"
msgid "　が、後悔はもう遅い。走りだしたのならもっと早く。"
msgstr ""

#. Occurrence 5B_15:3448:6412: scene=5B_15
#: 5B_15:3448
msgctxt "text_id=6412 | speaker=unknown"
msgid "なにしろホントに時間がない、今から全力で下りても間に合わない、ああでもそれより、コースターの出口にはブレッドマンたちで混雑中、"
msgstr ""

#. Occurrence 5B_15:3454:6413: scene=5B_15
#: 5B_15:3454
msgctxt "text_id=6413 | speaker=unknown"
msgid "となれば遅いも早いも結果は同じ、どのみち出口が塞がっている。急げ急げと必死になって、一歩ごとに落ちかける必要性とかまったくない……！"
msgstr ""

#. Occurrence 5B_15:3562:6414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0011; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3562
msgctxt "text_id=6414 | speaker=soujuurou"
msgid "「っ、だから！？」"
msgstr ""

#. Occurrence 5B_15:3568:6415: scene=5B_15
#: 5B_15:3568
msgctxt "text_id=6415 | speaker=unknown"
msgid "　それがどうしたと。"
msgstr ""

#. Occurrence 5B_15:3573:6416: scene=5B_15
#: 5B_15:3573
msgctxt "text_id=6416 | speaker=unknown"
msgid "　ごちゃついた<煩悶|はんもん>を、彼は一太刀で切り払った。"
msgstr ""

#. Occurrence 5B_15:3578:6417: scene=5B_15
#: 5B_15:3578
msgctxt "text_id=6417 | speaker=unknown"
msgid "　自分にできる事は足下に意識を集中して、一秒でも早く駆け下りるだけ。"
msgstr ""

#. Occurrence 5B_15:3720:6418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0012; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3720
msgctxt "text_id=6418 | speaker=soujuurou"
msgid "“間違えるな。いま大事なのは、間に合うとか助けられるとか、そういう結果の話じゃなくて―――”"
msgstr ""

#. Occurrence 5B_15:3726:6419: scene=5B_15
#: 5B_15:3726
msgctxt "text_id=6419 | speaker=unknown"
msgid "　ある衝動が、縮こまった手足を駆動させる。"
msgstr ""

#. Occurrence 5B_15:3731:6420: scene=5B_15
#: 5B_15:3731
msgctxt "text_id=6420 | speaker=unknown"
msgid "　渇ききった喉を、冷め切った<理屈|こころ>を、草十郎は“思いつき”だけで心の端っこに蹴り飛ばす。"
msgstr ""

#. Occurrence 5B_15:3736:6421: scene=5B_15
#: 5B_15:3736
msgctxt "text_id=6421 | speaker=unknown"
msgid "　根が単純な人間の面目躍如、とにかく難しいコトは終わってから考える―――！"
msgstr ""

#. Occurrence 5B_15:3889:6422: scene=5B_15
#: 5B_15:3889
msgctxt "text_id=6422 | speaker=unknown"
msgid "　だが、障害は縮こまる自分だけではない。"
msgstr ""

#. Occurrence 5B_15:3895:6423: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0013; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3895
msgctxt "text_id=6423 | speaker=soujuurou"
msgid "「こんな時に―――！」"
msgstr ""

#. Occurrence 5B_15:3900:6424: scene=5B_15
#: 5B_15:3900
msgctxt "text_id=6424 | speaker=unknown"
msgid "　レールに集中していなければ落ちる状況で、最悪の邪魔者が出現する。"
msgstr ""

#. Occurrence 5B_15:3998:6425: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0014; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3998
msgctxt "text_id=6425 | speaker=soujuurou"
msgid "「！」"
msgstr ""

#. Occurrence 5B_15:4003:6426: scene=5B_15
#: 5B_15:4003
msgctxt "text_id=6426 | speaker=unknown"
msgid "　一見いままで通りの卵に違和感を覚える草十郎。"
msgstr ""

#. Occurrence 5B_15:4008:6427: scene=5B_15
#: 5B_15:4008
msgctxt "text_id=6427 | speaker=unknown"
msgid "　何が変わっているのか。"
msgstr ""

#. Occurrence 5B_15:4013:6428: scene=5B_15
#: 5B_15:4013
msgctxt "text_id=6428 | speaker=unknown"
msgid "　その変化に気付いた瞬間、"
msgstr ""

#. Occurrence 5B_15:4103:6429: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0015; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4103
msgctxt "text_id=6429 | speaker=soujuurou"
msgid "「って、よそ見してる場合じゃない……！」"
msgstr ""

#. Occurrence 5B_15:4123:6430: scene=5B_15
#: 5B_15:4123
msgctxt "text_id=6430 | speaker=unknown"
msgid "　踏み<外|はず>しかけた足を本能で持ち直す。"
msgstr ""

#. Occurrence 5B_15:4128:6431: scene=5B_15
#: 5B_15:4128
msgctxt "text_id=6431 | speaker=unknown"
msgid "　まだ落ちていない事が奇跡だった。"
msgstr ""

#. Occurrence 5B_15:4133:6432: scene=5B_15
#: 5B_15:4133
msgctxt "text_id=6432 | speaker=unknown"
msgid "　コースターを駆け下りるのは自殺行為そのものだった。"
msgstr ""

#. Occurrence 5B_15:4201:6433: scene=5B_15
#: 5B_15:4201
msgctxt "text_id=6433 | speaker=unknown"
msgid "　卵はぴったりと並走し、隙あらば体当たりでもしてきそうな<剣呑|けんのん>さ。"
msgstr ""

#. Occurrence 5B_15:4207:6434: scene=5B_15
#: 5B_15:4207
msgctxt "text_id=6434 | speaker=unknown"
msgid "オマケにあまり直視したくないが、内部に作られた扉らしき飾りが、少しずつ開こうとしているのも気になりすぎる。"
msgstr ""

#. Occurrence 5B_15:4320:6435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0016; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4320
msgctxt "text_id=6435 | speaker=soujuurou"
msgid "「ああもう、畜生！　なんだって、こんな―――！」"
msgstr ""

#. Occurrence 5B_15:4326:6436: scene=5B_15
#: 5B_15:4326
msgctxt "text_id=6436 | speaker=unknown"
msgid "　あまりにもどん詰まりな状況に悪態をつく。"
msgstr ""

#. Occurrence 5B_15:4331:6437: scene=5B_15
#: 5B_15:4331
msgctxt "text_id=6437 | speaker=unknown"
msgid "　それでも足は緩めない。"
msgstr ""

#. Occurrence 5B_15:4337:6438: scene=5B_15
#: 5B_15:4337
msgctxt "text_id=6438 | speaker=unknown"
msgid "むしろ速度をより増して、彼は並走する卵を睨みつける。"
msgstr ""

#. Occurrence 5B_15:4465:6439: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0017; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4465
msgctxt "text_id=6439 | speaker=soujuurou"
msgid "「ハ―――ほんと、おかしい。"
msgstr ""

#. Occurrence 5B_15:4471:6440: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0018; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4471
msgctxt "text_id=6440 | speaker=soujuurou"
msgid "　こんな状況なのに、何で―――」"
msgstr ""

#. Occurrence 5B_15:4477:6441: scene=5B_15
#: 5B_15:4477
msgctxt "text_id=6441 | speaker=unknown"
msgid "　自分は笑っているのだろう、と草十郎は不思議に思った。"
msgstr ""

#. Occurrence 5B_15:4482:6442: scene=5B_15
#: 5B_15:4482
msgctxt "text_id=6442 | speaker=unknown"
msgid "　青子のおまじないとやらの効果……なのかどうか、草十郎には判別できない。"
msgstr ""

#. Occurrence 5B_15:4527:6443: scene=5B_15
#: 5B_15:4527
msgctxt "text_id=6443 | speaker=unknown"
msgid "　彼女の指の感触は、まだ肌に残っている。"
msgstr ""

#. Occurrence 5B_15:4569:6444: scene=5B_15
#: 5B_15:4569
msgctxt "text_id=6444 | speaker=unknown"
msgid "　向けられた信頼も期待も、しっかりと胸に<覚|おぼ>えている。"
msgstr ""

#. Occurrence 5B_15:4574:6445: scene=5B_15
#: 5B_15:4574
msgctxt "text_id=6445 | speaker=unknown"
msgid "　……けれど、この衝動はそれらとは違うものだ。"
msgstr ""

#. Occurrence 5B_15:4662:6446: scene=5B_15
#: 5B_15:4662
msgctxt "text_id=6446 | speaker=unknown"
msgid "　この高揚は、もっと深層にある問題。"
msgstr ""

#. Occurrence 5B_15:4667:6447: scene=5B_15
#: 5B_15:4667
msgctxt "text_id=6447 | speaker=unknown"
msgid "　今の彼には分からない、いずれ向き合う事になる、埋められるべきがらんどう。"
msgstr ""

#. Occurrence 5B_15:4715:6448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0019; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4715
msgctxt "text_id=6448 | speaker=soujuurou"
msgid "「よし―――距離は、今なら二メートル、弱……！」"
msgstr ""

#. Occurrence 5B_15:4770:6449: scene=5B_15
#: 5B_15:4770
msgctxt "text_id=6449 | speaker=unknown"
msgid "　死のレールを走りながら、草十郎は正確に距離を<測|はか>る。"
msgstr ""

#. Occurrence 5B_15:4775:6450: scene=5B_15
#: 5B_15:4775
msgctxt "text_id=6450 | speaker=unknown"
msgid "　何との？"
msgstr ""

#. Occurrence 5B_15:4780:6451: scene=5B_15
#: 5B_15:4780
msgctxt "text_id=6451 | speaker=unknown"
msgid "　言うまでもない。この状況でたったひとつ、死の結末を飛び越える大一番との。"
msgstr ""

#. Occurrence 5B_15:4877:6452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0020; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4877
msgctxt "text_id=6452 | speaker=soujuurou"
msgid "「はっ―――はっ、はっは、はっ！」"
msgstr ""

#. Occurrence 5B_15:4883:6453: scene=5B_15
#: 5B_15:4883
msgctxt "text_id=6453 | speaker=unknown"
msgid "　乱れる呼吸に合わせて、“行くぞ、行くぞ”とハッパをかける。"
msgstr ""

#. Occurrence 5B_15:4890:6454: scene=5B_15
#: 5B_15:4890
msgctxt "text_id=6454 | speaker=unknown"
msgid "　本当にありえない。"
msgstr ""

#. Occurrence 5B_15:4895:6455: scene=5B_15
#: 5B_15:4895
msgctxt "text_id=6455 | speaker=unknown"
msgid "　自分は馬鹿げた事をしようとしている。"
msgstr ""

#. Occurrence 5B_15:4900:6456: scene=5B_15
#: 5B_15:4900
msgctxt "text_id=6456 | speaker=unknown"
msgid "　でも<そ|・><う|・><し|・><な|・><け|・><れ|・><ば|・><間|・><に|・><合|・><わ|・><な|・><い|・>、と気付いたのだからしようがない！"
msgstr ""

#. Occurrence 5B_15:5004:6457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0021; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5004
msgctxt "text_id=6457 | speaker=soujuurou"
msgid "「ほんと―――なんで、そこまでやるんだ！？」"
msgstr ""

#. Occurrence 5B_15:5010:6458: scene=5B_15
#: 5B_15:5010
msgctxt "text_id=6458 | speaker=unknown"
msgid "　今さらな自問自答を、彼は鼻で笑った。"
msgstr ""

#. Occurrence 5B_15:5015:6459: scene=5B_15
#: 5B_15:5015
msgctxt "text_id=6459 | speaker=unknown"
msgid "　一時的な混乱。極限状態における精神の高揚が、彼の心を裸にする。"
msgstr ""

#. Occurrence 5B_15:5114:6460: scene=5B_15
#: 5B_15:5114
msgctxt "text_id=6460 | speaker=unknown"
msgid "　大事なものは何なのか。"
msgstr ""

#. Occurrence 5B_15:5119:6461: scene=5B_15
#: 5B_15:5119
msgctxt "text_id=6461 | speaker=unknown"
msgid "　そんなもの、シンプルな彼には考えるまでもない。"
msgstr ""

#. Occurrence 5B_15:5124:6462: scene=5B_15
#: 5B_15:5124
msgctxt "text_id=6462 | speaker=unknown"
msgid "　成功も報酬も、原始の心には美味しそうには映らない。"
msgstr ""

#. Occurrence 5B_15:5129:6463: scene=5B_15
#: 5B_15:5129
msgctxt "text_id=6463 | speaker=unknown"
msgid "　彼は、ただ、"
msgstr ""

#. Occurrence 5B_15:5174:6464: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0022; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5174
msgctxt "text_id=6464 | speaker=soujuurou"
msgid "“よし―――”"
msgstr ""

#. Occurrence 5B_15:5180:6465: scene=5B_15
#: 5B_15:5180
msgctxt "text_id=6465 | speaker=unknown"
msgid "　これはただ、そうありたいと望んだだけの話。"
msgstr ""

#. Occurrence 5B_15:5185:6466: scene=5B_15
#: 5B_15:5185
msgctxt "text_id=6466 | speaker=unknown"
msgid "　周りから強制された義務ではなく。"
msgstr ""

#. Occurrence 5B_15:5190:6467: scene=5B_15
#: 5B_15:5190
msgctxt "text_id=6467 | speaker=unknown"
msgid "　ただ純粋に、そういう風に生きたいと信じた、愚直な自己の欲望そのもので―――"
msgstr ""

#. Occurrence 5B_15:5213:6468: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0023; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5213
msgctxt "text_id=6468 | speaker=soujuurou"
msgid "“行こう！”"
msgstr ""

#. Occurrence 5B_15:5272:6469: scene=5B_15
#: 5B_15:5272
msgctxt "text_id=6469 | speaker=unknown"
msgid "『！？』"
msgstr ""

#. Occurrence 5B_15:5278:6470: scene=5B_15
#: 5B_15:5278
msgctxt "text_id=6470 | speaker=unknown"
msgid "　卵に発声機能があったのなら、そう驚いたに違いない。"
msgstr ""

#. Occurrence 5B_15:5283:6471: scene=5B_15
#: 5B_15:5283
msgctxt "text_id=6471 | speaker=unknown"
msgid "　逃げるだけだった少年は、自分から大きく足を踏み外したのだ。"
msgstr ""

#. Occurrence 5B_15:5363:6472: scene=5B_15
#: 5B_15:5363
msgctxt "text_id=6472 | speaker=unknown"
msgid "　足は内ではなく、外に向かって。"
msgstr ""

#. Occurrence 5B_15:5368:6473: scene=5B_15
#: 5B_15:5368
msgctxt "text_id=6473 | speaker=unknown"
msgid "　レールの端で、勢いを殺さないようわずかに膝を曲げ、浮遊する卵を凝視し―――"
msgstr ""

#. Occurrence 5B_15:5442:6474: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0024; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5442
msgctxt "text_id=6474 | speaker=soujuurou"
msgid "“やれる―――距離的に問題はない！”"
msgstr ""

#. Occurrence 5B_15:5626:6475: scene=5B_15
#: 5B_15:5626
msgctxt "text_id=6475 | speaker=unknown"
msgid "　夜を駆ける。"
msgstr ""

#. Occurrence 5B_15:5631:6476: scene=5B_15
#: 5B_15:5631
msgctxt "text_id=6476 | speaker=unknown"
msgid "　わずか１．５秒の夜間飛行。"
msgstr ""

#. Occurrence 5B_15:5636:6477: scene=5B_15
#: 5B_15:5636
msgctxt "text_id=6477 | speaker=unknown"
msgid "　地上三十メートルの、<紐|ひも>なし<縄|なわ>なしバンジージャンプ。"
msgstr ""

#. Occurrence 5B_15:5641:6478: scene=5B_15
#: 5B_15:5641
msgctxt "text_id=6478 | speaker=unknown"
msgid "　その落下先は―――"
msgstr ""

#. Occurrence 5B_15:5725:6479: scene=5B_15
#: 5B_15:5725
msgctxt "text_id=6479 | speaker=unknown"
msgid "　唯一の足場となる、空飛ぶ巨大な卵だった。"
msgstr ""

#. Occurrence 5B_15:5841:6480: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0025; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5841
msgctxt "text_id=6480 | speaker=soujuurou"
msgid "「う、ひゃああーーーー！」"
msgstr ""

#. Occurrence 5B_15:5847:6481: scene=5B_15
#: 5B_15:5847
msgctxt "text_id=6481 | speaker=unknown"
msgid "　悲鳴のような、歓声のような声をあげながら、草十郎は必死に卵の表面にしがみつく。"
msgstr ""

#. Occurrence 5B_15:5867:6482: scene=5B_15
#: 5B_15:5867
msgctxt "text_id=6482 | speaker=unknown"
msgid "　……ほんの少し前。"
msgstr ""

#. Occurrence 5B_15:5874:6483: scene=5B_15
#: 5B_15:5874
msgctxt "text_id=6483 | speaker=unknown"
msgid "　恐怖心が無ければビルの上も平均台も変わらない、と血も涙もない魔女は言った。"
msgstr ""

#. Occurrence 5B_15:5879:6484: scene=5B_15
#: 5B_15:5879
msgctxt "text_id=6484 | speaker=unknown"
msgid "　その魔女とて、この光景を見たら言葉を失っただろう。"
msgstr ""

#. Occurrence 5B_15:5884:6485: scene=5B_15
#: 5B_15:5884
msgctxt "text_id=6485 | speaker=unknown"
msgid "　いくら恐怖心が無いと言っても、無茶と無謀は別の物だ。"
msgstr ""

#. Occurrence 5B_15:5889:6486: scene=5B_15
#: 5B_15:5889
msgctxt "text_id=6486 | speaker=unknown"
msgid "　あまつさえ、<こ|・><の|・><後|・>の行為に至っては、後日本気で頭にきた程である。"
msgstr ""

#. Occurrence 5B_15:5957:6487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0026; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5957
msgctxt "text_id=6487 | speaker=soujuurou"
msgid "「頼むぞ、卵！」"
msgstr ""

#. Occurrence 5B_15:5966:6488: scene=5B_15
#: 5B_15:5966
msgctxt "text_id=6488 | speaker=unknown"
msgid "　卵にしがみついたまま、<卵|・><か|・><ら|・><視|・><線|・><を|・><切|・><る|・>。"
msgstr ""

#. Occurrence 5B_15:5971:6489: scene=5B_15
#: 5B_15:5971
msgctxt "text_id=6489 | speaker=unknown"
msgid "　急速な落下感覚。"
msgstr ""

#. Occurrence 5B_15:6052:6490: scene=5B_15
#: 5B_15:6052
msgctxt "text_id=6490 | speaker=unknown"
msgid "　草十郎は薄目で風景を確認しながら、残り一メートル付近で視線を戻し、卵を視界に<納|おさ>めながら飛びだした。"
msgstr ""

#. Occurrence 5B_15:6118:6491: scene=5B_15
#: 5B_15:6118
msgctxt "text_id=6491 | speaker=unknown"
msgid "　―――いや、まことに信じがたい話ではあるが。"
msgstr ""

#. Occurrence 5B_15:6124:6492: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6492 | speaker=unknown"
msgid "　彼にとってはデパートのエレベーターも、"
msgstr ""

#. Occurrence 5B_15:6124:6493: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6493 | speaker=unknown"
msgid "　不思議動力で浮遊する卵も、"
msgstr ""

#. Occurrence 5B_15:6124:6494: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6494 | speaker=unknown"
msgid "　そう大差のない「移動道具」に見えたのである……！"
msgstr ""

#. Occurrence 5B_15:6240:6495: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6495 | speaker=soujuurou"
msgid "「よし、割れてない！"
msgstr ""

#. Occurrence 5B_15:6240:6496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6496 | speaker=soujuurou"
msgid "食べ物を粗末にするのはよくないと思う！」"
msgstr ""

#. Occurrence 5B_15:6406:6497: scene=5B_15
#: 5B_15:6406
msgctxt "text_id=6497 | speaker=unknown"
msgid "　着地したのは小広場の近く。"
msgstr ""

#. Occurrence 5B_15:6411:6498: scene=5B_15
#: 5B_15:6411
msgctxt "text_id=6498 | speaker=unknown"
msgid "　命を投げたショートカットは、これ以上ないカタチで実を結んだ。"
msgstr ""

#. Occurrence 5B_15:6488:6499: scene=5B_15
#: 5B_15:6488
msgctxt "text_id=6499 | speaker=unknown"
msgid "　草十郎は着地しながら、止まる事なく走りだす。"
msgstr ""

#. Occurrence 5B_15:6581:6500: scene=5B_15
#: 5B_15:6581
msgctxt "text_id=6500 | speaker=unknown"
msgid "　彼の脳裏にあるのは青子に迫る人形の姿だけ。"
msgstr ""

#. Occurrence 5B_15:6608:6501: scene=5B_15
#: 5B_15:6608
msgctxt "text_id=6501 | speaker=unknown"
msgid "　なので、空から降ってくる月の光も、"
msgstr ""

#. Occurrence 5B_15:6706:6502: scene=5B_15
#: 5B_15:6706
msgctxt "text_id=6502 | speaker=unknown"
msgid "　利用された怒りに燃えて自ら破裂し、破片をまき散らさんとする卵も視界に映らない。"
msgstr ""

#. Occurrence 5B_15:6777:6503: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0028; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6777
msgctxt "text_id=6503 | speaker=soujuurou"
msgid "「蒼崎―――！」"
msgstr ""

#. Occurrence 5B_15:6834:6504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0007; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:6834
msgctxt "text_id=6504 | speaker=aoko"
msgid "「なぬ―――？」"
msgstr ""

#. Occurrence 5B_15:6840:6505: scene=5B_15
#: 5B_15:6840
msgctxt "text_id=6505 | speaker=unknown"
msgid "　目を疑う青子の表情が、最後の一足に力を入れる。"
msgstr ""

#. Occurrence 5B_15:6940:6506: scene=5B_15
#: 5B_15:6940
msgctxt "text_id=6506 | speaker=unknown"
msgid "　<詩篇|のろい>が展開する。"
msgstr ""

#. Occurrence 5B_15:6945:6507: scene=5B_15
#: 5B_15:6945
msgctxt "text_id=6507 | speaker=unknown"
msgid "　もはや逃がさぬと中身のない卵は<謳|うた>い―――"
msgstr ""

#. Occurrence 5B_15:7192:6508: scene=5B_15
#: 5B_15:7192
msgctxt "text_id=6508 | speaker=unknown"
msgid "　カオスに散らかる卵の断片。"
msgstr ""

#. Occurrence 5B_15:7197:6509: scene=5B_15
#: 5B_15:7197
msgctxt "text_id=6509 | speaker=unknown"
msgid "　ダンプティに刻まれた“女王アリスを讃える唄”は、急速に五感を奪っていく。"
msgstr ""

#. Occurrence 5B_15:7218:6510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0029; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7218
msgctxt "text_id=6510 | speaker=soujuurou"
msgid "「っ―――それは、それとして―――」"
msgstr ""

#. Occurrence 5B_15:7224:6511: scene=5B_15
#: 5B_15:7224
msgctxt "text_id=6511 | speaker=unknown"
msgid "　途切れていく感覚に<喝|かつ>を入れて、草十郎は横たわる青子に走り寄る。"
msgstr ""

#. Occurrence 5B_15:7229:6512: scene=5B_15
#: 5B_15:7229
msgctxt "text_id=6512 | speaker=unknown"
msgid "　足は止まらない。"
msgstr ""

#. Occurrence 5B_15:7235:6513: scene=5B_15
#: 5B_15:7235
msgctxt "text_id=6513 | speaker=unknown"
msgid "そもそも感覚がないので自らの意志で止める事さえできず、"
msgstr ""

#. Occurrence 5B_15:7351:6514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0030; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7351
msgctxt "text_id=6514 | speaker=soujuurou"
msgid "「<人形|おまえ>、驚くほどしつこいぞ……！」"
msgstr ""

#. Occurrence 5B_15:7860:6515: scene=5B_15
#: 5B_15:7860
msgctxt "text_id=6515 | speaker=unknown"
msgid "　<交差点|スクランブル>の<爆発|マーダー><事故|ケース>。"
msgstr ""

#. Occurrence 5B_15:7865:6516: scene=5B_15
#: 5B_15:7865
msgctxt "text_id=6516 | speaker=unknown"
msgid "　三者三様の残骸が、閃光弾となって地上に咲く。"
msgstr ""

#. Occurrence 5B_15:7916:6517: scene=5B_15
#: 5B_15:7916
msgctxt "text_id=6517 | speaker=unknown"
msgid "　……敗者たちがこぞって潰しあった最終幕。"
msgstr ""

#. Occurrence 5B_15:7921:6518: scene=5B_15
#: 5B_15:7921
msgctxt "text_id=6518 | speaker=unknown"
msgid "　久遠寺有珠が見ていたら頭を抱えそうな結末から、ふたりは間一髪ではじき出された。"
msgstr ""

#. Occurrence 5B_15:8049:6519: scene=5B_15
#: 5B_15:8049
msgctxt "text_id=6519 | speaker=unknown"
msgid "　この、世にも<希|まれ>なつぶし合いを冷静に把握できたのは、助けられた少女だけ。"
msgstr ""

#. Occurrence 5B_15:8054:6520: scene=5B_15
#: 5B_15:8054
msgctxt "text_id=6520 | speaker=unknown"
msgid "　走り続けた少年は背後の結末にあまり関心もなく、"
msgstr ""

#. Occurrence 5B_15:8137:6521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0031; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:8137
msgctxt "text_id=6521 | speaker=soujuurou"
msgid "「はあ―――死ぬかと、思った」"
msgstr ""

#. Occurrence 5B_15:8143:6522: scene=5B_15
#: 5B_15:8143
msgctxt "text_id=6522 | speaker=unknown"
msgid "　自分のしでかした奇跡より、抱きかかえた少女の無事を確かめて、安堵の息を漏らしていた。"
msgstr ""

#. Occurrence 5B_16:59:6523: scene=5B_16
#: 5B_16:59
msgctxt "text_id=6523 | speaker=unknown"
msgid "　……かくして、夜明けを待たず月は落ちた。"
msgstr ""

#. Occurrence 5B_16:65:6524: scene=5B_16
#: 5B_16:65
msgctxt "text_id=6524 | speaker=unknown"
msgid "　御伽の国の<装飾|テクスチャ>が溶けていく。"
msgstr ""

#. Occurrence 5B_16:70:6525: scene=5B_16
#: 5B_16:70
msgctxt "text_id=6525 | speaker=unknown"
msgid "　道に響いていた華やかな<旋律|コード>も、"
msgstr ""

#. Occurrence 5B_16:75:6526: scene=5B_16
#: 5B_16:75
msgctxt "text_id=6526 | speaker=unknown"
msgid "　来客を歓迎する<人形|パペット>たちの姿も、"
msgstr ""

#. Occurrence 5B_16:80:6527: scene=5B_16
#: 5B_16:80
msgctxt "text_id=6527 | speaker=unknown"
msgid "　すべて幻となって、本来のカタチに戻っていく。"
msgstr ""

#. Occurrence 5B_16:155:6528: scene=5B_16
#: 5B_16:155
msgctxt "text_id=6528 | speaker=unknown"
msgid "　<密|ひそ>やかに、<静|しず>やかに。"
msgstr ""

#. Occurrence 5B_16:160:6529: scene=5B_16
#: 5B_16:160
msgctxt "text_id=6529 | speaker=unknown"
msgid "　もう二度と目覚める事のない、忘却の国に沈んでいく。"
msgstr ""

#. Occurrence 5B_16:238:6530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0000; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:238
msgctxt "text_id=6530 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_16:244:6531: scene=5B_16
#: 5B_16:244
msgctxt "text_id=6531 | speaker=unknown"
msgid "　一夜の夢の名残火。"
msgstr ""

#. Occurrence 5B_16:249:6532: scene=5B_16
#: 5B_16:249
msgctxt "text_id=6532 | speaker=unknown"
msgid "　遊園地を照らす数多の<電飾|ライト>も、ひとつずつ消えていく。"
msgstr ""

#. Occurrence 5B_16:289:6533: scene=5B_16
#: 5B_16:289
msgctxt "text_id=6533 | speaker=unknown"
msgid "　その光景をふたりは眺めていた。"
msgstr ""

#. Occurrence 5B_16:309:6534: scene=5B_16
#: 5B_16:309
msgctxt "text_id=6534 | speaker=unknown"
msgid "　草十郎は地面に倒れこんで、必死に酸素を取りこんでいる。"
msgstr ""

#. Occurrence 5B_16:314:6535: scene=5B_16
#: 5B_16:314
msgctxt "text_id=6535 | speaker=unknown"
msgid "　爆弾卵の<詩篇|のろい>で痛覚は麻痺し、積み重なった疲労は相当なものだろう。吹けば消えそうとはこの事だ。"
msgstr ""

#. Occurrence 5B_16:319:6536: scene=5B_16
#: 5B_16:319
msgctxt "text_id=6536 | speaker=unknown"
msgid "　一方の青子も疲れきってはいたが、草十郎ほど息の乱れはない。"
msgstr ""

#. Occurrence 5B_16:325:6537: scene=5B_16
#: 5B_16:325
msgctxt "text_id=6537 | speaker=unknown"
msgid "今は深呼吸を繰り返し、体力回復に努めている。"
msgstr ""

#. Occurrence 5B_16:376:6538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0001; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:376
msgctxt "text_id=6538 | speaker=aoko"
msgid "「……あのさ」"
msgstr ""

#. Occurrence 5B_16:383:6539: scene=5B_16
#: 5B_16:383
msgctxt "text_id=6539 | speaker=unknown"
msgid "　青子は視線を遊園地に向けたまま、関心のない素振りで、草十郎に声をかけた。"
msgstr ""

#. Occurrence 5B_16:388:6540: scene=5B_16
#: 5B_16:388
msgctxt "text_id=6540 | speaker=unknown"
msgid "　やや芝居がかった唐突さ。本当は面と向かって話しかけたいのを、意地で堪えているのが見え見えである。"
msgstr ""

#. Occurrence 5B_16:439:6541: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0002; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:439
msgctxt "text_id=6541 | speaker=aoko"
msgid "「……貴方、なんかすごいコトしなかった？」"
msgstr ""

#. Occurrence 5B_16:503:6542: scene=5B_16
#: 5B_16:503
msgctxt "text_id=6542 | speaker=unknown"
msgid "　……彼女が死を受け入れた、永遠とも言える一瞬。"
msgstr ""

#. Occurrence 5B_16:509:6543: scene=5B_16
#: 5B_16:509
msgctxt "text_id=6543 | speaker=unknown"
msgid "　月の破片に貫かれる自分を、冷静に、自分でもどうかと思うほど客観的に見ていた時。"
msgstr ""

#. Occurrence 5B_16:514:6544: scene=5B_16
#: 5B_16:514
msgctxt "text_id=6544 | speaker=unknown"
msgid "　力強く呼びかける声が、彼女を現実に引き戻した。"
msgstr ""

#. Occurrence 5B_16:585:6545: scene=5B_16
#: 5B_16:585
msgctxt "text_id=6545 | speaker=unknown"
msgid "　……いかなる理由で、何を考えて、どんな無茶をして、彼は自分を助けたのか。"
msgstr ""

#. Occurrence 5B_16:590:6546: scene=5B_16
#: 5B_16:590
msgctxt "text_id=6546 | speaker=unknown"
msgid "　倒れていた青子には、そのあたりの経緯がまったく分からない。確かなことは、最後の最後で、最高のフォローをしてもらったという事だけ。"
msgstr ""

#. Occurrence 5B_16:610:6547: scene=5B_16
#: 5B_16:610
msgctxt "text_id=6547 | speaker=unknown"
msgid "　それが知りたくて声をかけたが、それ以上のことは言葉にできない。"
msgstr ""

#. Occurrence 5B_16:624:6548: scene=5B_16
#: 5B_16:624
msgctxt "text_id=6548 | speaker=unknown"
msgid "　言葉にしたら負けな気がして、こんな風に、らしくない態度で声をかけたのだ。"
msgstr ""

#. Occurrence 5B_16:629:6549: scene=5B_16
#: 5B_16:629
msgctxt "text_id=6549 | speaker=unknown"
msgid "　もちろん幸い、話しかけられた彼には、そんな彼女のいじらしさに気付く余裕も情緒も、ありはしなかったのだが。"
msgstr ""

#. Occurrence 5B_16:681:6550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0000; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:681
msgctxt "text_id=6550 | speaker=soujuurou"
msgid "「すごいって、"
msgstr ""

msgctxt "text_id=6551 | speaker=unknown"
msgid "それは、"
msgstr ""

msgctxt "text_id=6552 | speaker=unknown"
msgid "蒼崎の方、"
msgstr ""

msgctxt "text_id=6553 | speaker=unknown"
msgid "だろ」"
msgstr ""

#. Occurrence 5B_16:695:6554: scene=5B_16
#: 5B_16:695
msgctxt "text_id=6554 | speaker=unknown"
msgid "　草十郎は胸を弾ませながら答える。"
msgstr ""

#. Occurrence 5B_16:700:6555: scene=5B_16
#: 5B_16:700
msgctxt "text_id=6555 | speaker=unknown"
msgid "　今は肺に酸素を送るのに手一杯で、青子に顔を向ける余裕もない。"
msgstr ""

#. Occurrence 5B_16:706:6556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0003; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:706
msgctxt "text_id=6556 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 5B_16:711:6557: scene=5B_16
#: 5B_16:711
msgctxt "text_id=6557 | speaker=unknown"
msgid "　そんな様子を、少女は横目で観察する。"
msgstr ""

#. Occurrence 5B_16:766:6558: scene=5B_16
#: 5B_16:766
msgctxt "text_id=6558 | speaker=unknown"
msgid "　振り返れば、少年の役割はどれも同じだった。"
msgstr ""

#. Occurrence 5B_16:771:6559: scene=5B_16
#: 5B_16:771
msgctxt "text_id=6559 | speaker=unknown"
msgid "　鏡の城でも童話の遊園地でも、彼は自分の無力さを<嗤|わら>わず、自分にできる事と向きあい続けた。"
msgstr ""

#. Occurrence 5B_16:776:6560: scene=5B_16
#: 5B_16:776
msgctxt "text_id=6560 | speaker=unknown"
msgid "　相手を打ち負かしたのはいいものの、勢いあまって転びかけた愚か者とは大違いだ。"
msgstr ""

#. Occurrence 5B_16:811:6561: scene=5B_16
#: 5B_16:811
msgctxt "text_id=6561 | speaker=unknown"
msgid "　…………だから今の無謀だって、彼にすればそう特別な事ではなく、"
msgstr ""

#. Occurrence 5B_16:842:6562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0001; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:842
msgctxt "text_id=6562 | speaker=soujuurou"
msgid "『―――提案。あいつをやっつけるのに協力したら、俺の事は見逃してくれる？』"
msgstr ""

#. Occurrence 5B_16:872:6563: scene=5B_16
#: 5B_16:872
msgctxt "text_id=6563 | speaker=unknown"
msgid "　せめて、自分に出来る事からは目を背けない彼にとっての、<精一杯|できるかぎり>の勇気だった。"
msgstr ""

#. Occurrence 5B_16:950:6564: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0004; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:950
msgctxt "text_id=6564 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_16:956:6565: scene=5B_16
#: 5B_16:956
msgctxt "text_id=6565 | speaker=unknown"
msgid "　観客から見ればただの脇役。"
msgstr ""

#. Occurrence 5B_16:961:6566: scene=5B_16
#: 5B_16:961
msgctxt "text_id=6566 | speaker=unknown"
msgid "　目の覚めるような活躍だなんてとても言えない。"
msgstr ""

#. Occurrence 5B_16:974:6567: scene=5B_16
#: 5B_16:974
msgctxt "text_id=6567 | speaker=unknown"
msgid "　けれど、転ばないよう手を引っ張られた少女にすれば話は別で、"
msgstr ""

#. Occurrence 5B_16:1015:6568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0005; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1015
msgctxt "text_id=6568 | speaker=aoko"
msgid "“……まあね。"
msgstr ""

#. Occurrence 5B_16:1021:6569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0006; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1021
msgctxt "text_id=6569 | speaker=aoko"
msgid "　認めたくないし、口になんて、もっとしたくないけど”"
msgstr ""

#. Occurrence 5B_16:1027:6570: scene=5B_16
#: 5B_16:1027
msgctxt "text_id=6570 | speaker=unknown"
msgid "　少年の<奮起|ふんき>は脇役扱いされるものではなく。"
msgstr ""

#. Occurrence 5B_16:1032:6571: scene=5B_16
#: 5B_16:1032
msgctxt "text_id=6571 | speaker=unknown"
msgid "　本当にすごい事をしたのはコイツだよ、なんて、まわりに言い聞かせたいほどの奮戦だったのだ。"
msgstr ""

#. Occurrence 5B_16:1067:6572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0007; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1067
msgctxt "text_id=6572 | speaker=aoko"
msgid "「――――――はあ」"
msgstr ""

#. Occurrence 5B_16:1073:6573: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0002; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1073
msgctxt "text_id=6573 | speaker=soujuurou"
msgid "「蒼崎？」"
msgstr ""

#. Occurrence 5B_16:1080:6574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0008; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1080
msgctxt "text_id=6574 | speaker=aoko"
msgid "“……ホント。人畜無害も、度を過ぎると侮れないわ”"
msgstr ""

#. Occurrence 5B_16:1085:6575: scene=5B_16
#: 5B_16:1085
msgctxt "text_id=6575 | speaker=unknown"
msgid "　はあ、と青子は自分自身にため息をつく。"
msgstr ""

#. Occurrence 5B_16:1137:6576: scene=5B_16
#: 5B_16:1137
msgctxt "text_id=6576 | speaker=unknown"
msgid "　けれど仕方がない。たったいま窮地から救ってくれた姿は、ほんのちょっとだけ格好良かったし、"
msgstr ""

#. Occurrence 5B_16:1144:6577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0009; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1144
msgctxt "text_id=6577 | speaker=aoko"
msgid "「……ま。評価、甘めだけど」"
msgstr ""

#. Occurrence 5B_16:1150:6578: scene=5B_16
#: 5B_16:1150
msgctxt "text_id=6578 | speaker=unknown"
msgid "　正直。こんなのにわざわざ手を下すなんて、<莫|ば><迦|か>らしいにも程がある。"
msgstr ""

#. Occurrence 5B_16:1241:6579: scene=5B_16
#: 5B_16:1241
msgctxt "text_id=6579 | speaker=unknown"
msgid "　呼吸を整え、少女はすぅ、と体を起こした。"
msgstr ""

#. Occurrence 5B_16:1246:6580: scene=5B_16
#: 5B_16:1246
msgctxt "text_id=6580 | speaker=unknown"
msgid "　……実のところまだ厳しいが、彼女にも魔術師としての誇りがある。"
msgstr ""

#. Occurrence 5B_16:1251:6581: scene=5B_16
#: 5B_16:1251
msgctxt "text_id=6581 | speaker=unknown"
msgid "　なので、<宣言|せんげん>する時は<威厳|いげん>がなくてはいけないのだ。"
msgstr ""

#. Occurrence 5B_16:1303:6582: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0010; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1303
msgctxt "text_id=6582 | speaker=aoko"
msgid "「静希君。見逃すのは今日だけって話だったけど、アレ、なしでいいわ。"
msgstr ""

#. Occurrence 5B_16:1310:6583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0011; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1310
msgctxt "text_id=6583 | speaker=aoko"
msgid "とりあえず、命は助けてあげるから」"
msgstr ""

#. Occurrence 5B_16:1343:6584: scene=5B_16
#: 5B_16:1343
msgctxt "text_id=6584 | speaker=unknown"
msgid "　仕方なさげに差し出される右手。"
msgstr ""

#. Occurrence 5B_16:1348:6585: scene=5B_16
#: 5B_16:1348
msgctxt "text_id=6585 | speaker=unknown"
msgid "　握手とも、座りこんだ草十郎を立ち上がらせる為のものとも取れる。"
msgstr ""

#. Occurrence 5B_16:1368:6586: scene=5B_16
#: 5B_16:1368
msgctxt "text_id=6586 | speaker=unknown"
msgid "　一方。"
msgstr ""

#. Occurrence 5B_16:1444:6587: scene=5B_16
#: 5B_16:1444
msgctxt "text_id=6587 | speaker=unknown"
msgid "　差し出された手を取らず、草十郎は自分の足で立ち上がった。"
msgstr ""

#. Occurrence 5B_16:1449:6588: scene=5B_16
#: 5B_16:1449
msgctxt "text_id=6588 | speaker=unknown"
msgid "　この夜。"
msgstr ""

#. Occurrence 5B_16:1455:6589: scene=5B_16
#: 5B_16:1455
msgctxt "text_id=6589 | speaker=unknown"
msgid "散々な目にあわされながらも、結局一度も見せなかった、心から意外そうな<表|か><情|お>をして。"
msgstr ""

#. Occurrence 5B_16:1522:6590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0012; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1522
msgctxt "text_id=6590 | speaker=aoko"
msgid "「な、なによそのリアクションは」"
msgstr ""

#. Occurrence 5B_16:1528:6591: scene=5B_16
#: 5B_16:1528
msgctxt "text_id=6591 | speaker=unknown"
msgid "　何か、とんでもなく恥ずかしい事をした気になって言い<淀|よど>む青子。"
msgstr ""

#. Occurrence 5B_16:1533:6592: scene=5B_16
#: 5B_16:1533
msgctxt "text_id=6592 | speaker=unknown"
msgid "　そんな彼女を、草十郎はまじまじと見つめている。"
msgstr ""

#. Occurrence 5B_16:1589:6593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0013; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1589
msgctxt "text_id=6593 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_16:1595:6594: scene=5B_16
#: 5B_16:1595
msgctxt "text_id=6594 | speaker=unknown"
msgid "　……問題は。"
msgstr ""

#. Occurrence 5B_16:1601:6595: scene=5B_16
#: 5B_16:1601
msgctxt "text_id=6595 | speaker=unknown"
msgid "じろじろと見つめられれば不快になる筈なのに、嫌悪感がまったくないこと。"
msgstr ""

#. Occurrence 5B_16:1606:6596: scene=5B_16
#: 5B_16:1606
msgctxt "text_id=6596 | speaker=unknown"
msgid "　むしろ容認しちゃってもいいかも知れない、などと、青子をして思わせるほど温かみのある視線で―――"
msgstr ""

#. Occurrence 5B_16:1663:6597: scene=5B_16
#: 5B_16:1663
msgctxt "text_id=6597 | speaker=unknown"
msgid "「いや、そんなお友達感覚の話じゃなくてだな。そういう好き嫌いじゃなくて、草の字は本気でおまえに―――」"
msgstr ""

#. Occurrence 5B_16:1725:6598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0014; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1725
msgctxt "text_id=6598 | speaker=aoko"
msgid "“……あ……”"
msgstr ""

#. Occurrence 5B_16:1731:6599: scene=5B_16
#: 5B_16:1731
msgctxt "text_id=6599 | speaker=unknown"
msgid "　そこで。"
msgstr ""

#. Occurrence 5B_16:1736:6600: scene=5B_16
#: 5B_16:1736
msgctxt "text_id=6600 | speaker=unknown"
msgid "　よせばいいのに、忘れていた台詞を思い出した。"
msgstr ""

#. Occurrence 5B_16:1789:6601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0015; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1789
msgctxt "text_id=6601 | speaker=aoko"
msgid "“いかん、それは違う！”"
msgstr ""

#. Occurrence 5B_16:1841:6602: scene=5B_16
#: 5B_16:1841
msgctxt "text_id=6602 | speaker=unknown"
msgid "　鳶丸の台詞を心の中で思いっきり否定して、青子は草十郎に向き直る。"
msgstr ""

#. Occurrence 5B_16:1870:6603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0016; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1870
msgctxt "text_id=6603 | speaker=aoko"
msgid "「そ、それとこれは別だから！"
msgstr ""

#. Occurrence 5B_16:1876:6604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0017; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1876
msgctxt "text_id=6604 | speaker=aoko"
msgid "　私はアンタの事とか、ホントどうでもいいんだから！」"
msgstr ""

#. Occurrence 5B_16:1881:6605: scene=5B_16
#: 5B_16:1881
msgctxt "text_id=6605 | speaker=unknown"
msgid "　はい？　と首を傾げる草十郎。"
msgstr ""

#. Occurrence 5B_16:1915:6606: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0003; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1915
msgctxt "text_id=6606 | speaker=soujuurou"
msgid "「さっき嫌いだって言われたけど」"
msgstr ""

#. Occurrence 5B_16:1920:6607: scene=5B_16
#: 5B_16:1920
msgctxt "text_id=6607 | speaker=unknown"
msgid "　唐突な青子の発言に疑問こそあれ文句はなく、彼は淡々と言葉を返す。"
msgstr ""

#. Occurrence 5B_16:1961:6608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0018; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1961
msgctxt "text_id=6608 | speaker=aoko"
msgid "「う―――」"
msgstr ""

#. Occurrence 5B_16:1967:6609: scene=5B_16
#: 5B_16:1967
msgctxt "text_id=6609 | speaker=unknown"
msgid "　……たしかに、面と向かって言った。"
msgstr ""

#. Occurrence 5B_16:1972:6610: scene=5B_16
#: 5B_16:1972
msgctxt "text_id=6610 | speaker=unknown"
msgid "　けれどあれは言葉のアヤで、本気に取られると困ってしまうし、なによりそれより、今はそんな事を論じている場面ではなく、"
msgstr ""

#. Occurrence 5B_16:2001:6611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0019; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2001
msgctxt "text_id=6611 | speaker=aoko"
msgid "「そ、そうじゃなくて！　あなたが私に<惚|ほ>れてても、期待しないでって言ってるの！」"
msgstr ""

#. Occurrence 5B_16:2007:6612: scene=5B_16
#: 5B_16:2007
msgctxt "text_id=6612 | speaker=unknown"
msgid "　つまり彼女は、そういう事を論じたいらしい。"
msgstr ""

#. Occurrence 5B_16:2060:6613: scene=5B_16
#: 5B_16:2060
msgctxt "text_id=6613 | speaker=unknown"
msgid "　柄にもない事を怒鳴って、青子は<微|かす>かに赤面する。"
msgstr ""

#. Occurrence 5B_16:2065:6614: scene=5B_16
#: 5B_16:2065
msgctxt "text_id=6614 | speaker=unknown"
msgid "　なんでこんなコトを口にする羽目になったんだろう、と悩みながら。"
msgstr ""

#. Occurrence 5B_16:2106:6615: scene=5B_16
#: 5B_16:2106
msgctxt "text_id=6615 | speaker=unknown"
msgid "　……それでも、とにかく言いたい事、言うべき事は言ったのだ。"
msgstr ""

#. Occurrence 5B_16:2111:6616: scene=5B_16
#: 5B_16:2111
msgctxt "text_id=6616 | speaker=unknown"
msgid "　ここは礼儀として、相手の返答を待つだけである。"
msgstr ""

#. Occurrence 5B_16:2146:6617: scene=5B_16
#: 5B_16:2146
msgctxt "text_id=6617 | speaker=unknown"
msgid "“あなたとは付き合えない”"
msgstr ""

#. Occurrence 5B_16:2168:6618: scene=5B_16
#: 5B_16:2168
msgctxt "text_id=6618 | speaker=unknown"
msgid "　なんてハートブレイクな言葉を受けて、純朴な少年はこの世の終わりのように、がっくりと肩を落とし……"
msgstr ""

msgctxt "text_id=6619 | speaker=unknown"
msgid "　てはいなかった。"
msgstr ""

#. Occurrence 5B_16:2175:6620: scene=5B_16
#: 5B_16:2175
msgctxt "text_id=6620 | speaker=unknown"
msgid "　それどころか、なにやら真剣に考えこんでいる。"
msgstr ""

#. Occurrence 5B_16:2203:6621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0004; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2203
msgctxt "text_id=6621 | speaker=soujuurou"
msgid "「俺が、蒼崎に、惚れてるって……？」"
msgstr ""

#. Occurrence 5B_16:2231:6622: scene=5B_16
#: 5B_16:2231
msgctxt "text_id=6622 | speaker=unknown"
msgid "　呪文のように呟く草十郎。"
msgstr ""

#. Occurrence 5B_16:2267:6623: scene=5B_16
#: 5B_16:2267
msgctxt "text_id=6623 | speaker=unknown"
msgid "　そうよ、と突っ返す青子。"
msgstr ""

#. Occurrence 5B_16:2314:6624: scene=5B_16
#: 5B_16:2314
msgctxt "text_id=6624 | speaker=unknown"
msgid "　深く、返事を待つ青子がドギマギするぐらい深く考えこんだ末、少年は少女を見つめ返して、すっぱりと言った。"
msgstr ""

#. Occurrence 5B_16:2358:6625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0005; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2358
msgctxt "text_id=6625 | speaker=soujuurou"
msgid "「―――なんで？」"
msgstr ""

#. Occurrence 5B_16:2496:6626: scene=5B_16
#: 5B_16:2496
msgctxt "text_id=6626 | speaker=unknown"
msgid "　………冗談じゃ、"
msgstr ""

msgctxt "text_id=6627 | speaker=unknown"
msgid "ない。"
msgstr ""

#. Occurrence 5B_16:2503:6628: scene=5B_16
#: 5B_16:2503
msgctxt "text_id=6628 | speaker=unknown"
msgid "　彼は本気で言っている。"
msgstr ""

#. Occurrence 5B_16:2510:6629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0021; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2510
msgctxt "text_id=6629 | speaker=aoko"
msgid "“と―――”"
msgstr ""

#. Occurrence 5B_16:2515:6630: scene=5B_16
#: 5B_16:2515
msgctxt "text_id=6630 | speaker=unknown"
msgid "　つまり、好きではあるけど、好きなダケ。"
msgstr ""

#. Occurrence 5B_16:2520:6631: scene=5B_16
#: 5B_16:2520
msgctxt "text_id=6631 | speaker=unknown"
msgid "　ぜんぶ副会長の早とちり。色恋沙汰とか男女の浪漫とか、はじめっからあたまになし。"
msgstr ""

#. Occurrence 5B_16:2575:6632: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0022; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2575
msgctxt "text_id=6632 | speaker=aoko"
msgid "“と、と、と―――”"
msgstr ""

#. Occurrence 5B_16:2580:6633: scene=5B_16
#: 5B_16:2580
msgctxt "text_id=6633 | speaker=unknown"
msgid "　まだ悩んでいる草十郎の仕草が、よけい恥ずかしい。"
msgstr ""

#. Occurrence 5B_16:2585:6634: scene=5B_16
#: 5B_16:2585
msgctxt "text_id=6634 | speaker=unknown"
msgid "　青子は顔どころか全身熱くなる衝動に襲われて、"
msgstr ""

#. Occurrence 5B_16:2632:6635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0006; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2632
msgctxt "text_id=6635 | speaker=soujuurou"
msgid "「むう。もう一度聞くけど、なんで？」"
msgstr ""

#. Occurrence 5B_16:2653:6636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0023; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2653
msgctxt "text_id=6636 | speaker=aoko"
msgid "「そりゃあ、こっちが聞きたいわよーーーー！！！！」"
msgstr ""

#. Occurrence 5B_16:2660:6637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0024; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2660
msgctxt "text_id=6637 | speaker=aoko"
msgid "“鳶丸の、大馬鹿野郎ーーーーーーっ！！！！！”"
msgstr ""

#. Occurrence 5B_16:2680:6638: scene=5B_16
#: 5B_16:2680
msgctxt "text_id=6638 | speaker=unknown"
msgid "　……このように。"
msgstr ""

#. Occurrence 5B_16:2686:6639: scene=5B_16
#: 5B_16:2686
msgctxt "text_id=6639 | speaker=unknown"
msgid "もはや<釈明|しゃくめい>のしようもない、あるまじき暴挙に出たのだった。"
msgstr ""

#. Occurrence 5B_16:2763:6640: scene=5B_16
#: 5B_16:2763
msgctxt "text_id=6640 | speaker=unknown"
msgid "　なんという現場封鎖、証拠隠滅。"
msgstr ""

#. Occurrence 5B_16:2768:6641: scene=5B_16
#: 5B_16:2768
msgctxt "text_id=6641 | speaker=unknown"
msgid "　恥ずかしさで頬が溶けるかのようなパニックと、鳶丸への恨みが彼女を突発的な犯行に走らせた。"
msgstr ""

#. Occurrence 5B_16:2773:6642: scene=5B_16
#: 5B_16:2773
msgctxt "text_id=6642 | speaker=unknown"
msgid "　飛ぶ鳥すら落とす正拳突き。もとい、やや弧を描いたのでストレートではなくフックと言うべきか。"
msgstr ""

#. Occurrence 5B_16:2810:6643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0025; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2810
msgctxt "text_id=6643 | speaker=aoko"
msgid "「あ…………」"
msgstr ""

#. Occurrence 5B_16:2816:6644: scene=5B_16
#: 5B_16:2816
msgctxt "text_id=6644 | speaker=unknown"
msgid "　会心の手応えに目を点にする青子。"
msgstr ""

#. Occurrence 5B_16:2821:6645: scene=5B_16
#: 5B_16:2821
msgctxt "text_id=6645 | speaker=unknown"
msgid "　無防備だった彼と、激情に乗り出した自分。"
msgstr ""

#. Occurrence 5B_16:2826:6646: scene=5B_16
#: 5B_16:2826
msgctxt "text_id=6646 | speaker=unknown"
msgid "　腰の入った一撃は、見事なまでに彼の意識を刈り取った。"
msgstr ""

#. Occurrence 5B_16:2908:6647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0007; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2908
msgctxt "text_id=6647 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_16:2913:6648: scene=5B_16
#: 5B_16:2913
msgctxt "text_id=6648 | speaker=unknown"
msgid "　きゅう、と声をもらして倒れこむ草十郎。"
msgstr ""

#. Occurrence 5B_16:2918:6649: scene=5B_16
#: 5B_16:2918
msgctxt "text_id=6649 | speaker=unknown"
msgid "　受けたばかりの詩篇の呪いと、今の一撃がトドメになったらしい。"
msgstr ""

#. Occurrence 5B_16:2923:6650: scene=5B_16
#: 5B_16:2923
msgctxt "text_id=6650 | speaker=unknown"
msgid "　眠るように……と表現するにはやや苦しい、苦悶に歪んだ寝顔だが、これは気絶ではなく眠ったのだ、と青子は強引に解釈するコトにした。"
msgstr ""

#. Occurrence 5B_16:2967:6651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0026; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2967
msgctxt "text_id=6651 | speaker=aoko"
msgid "「……ま、いっか。予定通りになったものね」"
msgstr ""

#. Occurrence 5B_16:2973:6652: scene=5B_16
#: 5B_16:2973
msgctxt "text_id=6652 | speaker=unknown"
msgid "　うん、とノックダウンした草十郎を見て、青子は肩の力を抜いた。色々と邪魔が入ったけれど、とりあえずこれで一件落着だ。"
msgstr ""

#. Occurrence 5B_16:2978:6653: scene=5B_16
#: 5B_16:2978
msgctxt "text_id=6653 | speaker=unknown"
msgid "　虚勢を張る相手もいなくなると、どっと疲れがやってくる。"
msgstr ""

#. Occurrence 5B_16:3014:6654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0027; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3014
msgctxt "text_id=6654 | speaker=aoko"
msgid "「うわ……歩いて帰れるかな、私」"
msgstr ""

#. Occurrence 5B_16:3020:6655: scene=5B_16
#: 5B_16:3020
msgctxt "text_id=6655 | speaker=unknown"
msgid "　つい弱音をこぼすほどの疲労だった。"
msgstr ""

#. Occurrence 5B_16:3025:6656: scene=5B_16
#: 5B_16:3025
msgctxt "text_id=6656 | speaker=unknown"
msgid "　考えてみれば魔力を使いきったのも初めてだし、何の前準備もなしでこれだけの戦いをこなしたのも初めてだ。"
msgstr ""

#. Occurrence 5B_16:3030:6657: scene=5B_16
#: 5B_16:3030
msgctxt "text_id=6657 | speaker=unknown"
msgid "　いや、そもそも―――"
msgstr ""

#. Occurrence 5B_16:3072:6658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0028; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3072
msgctxt "text_id=6658 | speaker=aoko"
msgid "「私ひとりじゃ、どっちも相打ちだったっけ」"
msgstr ""

#. Occurrence 5B_16:3078:6659: scene=5B_16
#: 5B_16:3078
msgctxt "text_id=6659 | speaker=unknown"
msgid "　呟いた声は、どこか誇らしげだった。"
msgstr ""

#. Occurrence 5B_16:3083:6660: scene=5B_16
#: 5B_16:3083
msgctxt "text_id=6660 | speaker=unknown"
msgid "　本来なら<自戒|じかい>すべき事なのに、苦笑いしている自分にやれやれと肩をすくめる。"
msgstr ""

#. Occurrence 5B_16:3088:6661: scene=5B_16
#: 5B_16:3088
msgctxt "text_id=6661 | speaker=unknown"
msgid "　それもこれも、いま傍らで眠っている誰かさんのおかげだろう。"
msgstr ""

#. Occurrence 5B_16:3122:6662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0029; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3122
msgctxt "text_id=6662 | speaker=aoko"
msgid "「……ね、聞こえてないわよね？」"
msgstr ""

#. Occurrence 5B_16:3128:6663: scene=5B_16
#: 5B_16:3128
msgctxt "text_id=6663 | speaker=unknown"
msgid "　夜風よりも小さい呼びかけに、反応はない。"
msgstr ""

#. Occurrence 5B_16:3133:6664: scene=5B_16
#: 5B_16:3133
msgctxt "text_id=6664 | speaker=unknown"
msgid "　それに安心して、もっと小さい声で彼女は続ける。"
msgstr ""

#. Occurrence 5B_16:3155:6665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0030; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3155
msgctxt "text_id=6665 | speaker=aoko"
msgid "「……その、ありがと。"
msgstr ""

msgctxt "text_id=6666 | speaker=unknown"
msgid "十分に助けてもらったわ」"
msgstr ""

#. Occurrence 5B_16:3190:6667: scene=5B_16
#: 5B_16:3190
msgctxt "text_id=6667 | speaker=unknown"
msgid "　もちろん返事はないし、期待もしていない。たんに言っておきたかっただけだ。"
msgstr ""

#. Occurrence 5B_16:3239:6668: scene=5B_16
#: 5B_16:3239
msgctxt "text_id=6668 | speaker=unknown"
msgid "　少女はしばしうなされ眠る少年を眺めたあと、よし、と気持ちを入れ替えてポケットに手を伸ばした。"
msgstr ""

#. Occurrence 5B_16:3259:6669: scene=5B_16
#: 5B_16:3259
msgctxt "text_id=6669 | speaker=unknown"
msgid "　同居人にもらった、手のひらに納まりそうなガラスの瓶を取り出して、ポン、と開封する。"
msgstr ""

#. Occurrence 5B_16:3266:6670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0031; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3266
msgctxt "text_id=6670 | speaker=aoko"
msgid "「でも、それとこれとは別だから」"
msgstr ""

#. Occurrence 5B_16:3317:6671: scene=5B_16
#: 5B_16:3317
msgctxt "text_id=6671 | speaker=unknown"
msgid "　冬の夜風よりクールな一言を残して、彼女は彼の名前を呼びかけた。"
msgstr ""

#. Occurrence 5B_16:3326:6672: scene=5B_16
#: 5B_16:3326
msgctxt "text_id=6672 | speaker=unknown"
msgid "　返事もないのに、瓶はことり、と反応する。"
msgstr ""

#. Occurrence 5B_16:3331:6673: scene=5B_16
#: 5B_16:3331
msgctxt "text_id=6673 | speaker=unknown"
msgid "　横になっている少年の姿がぐにゃりと歪んだかと思うと、瓶の重さが少しだけ増した気がした。"
msgstr ""

#. Occurrence 5B_16:3394:6674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0032; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3394
msgctxt "text_id=6674 | speaker=aoko"
msgid "「うわ。どうなってんだろ、コレ」"
msgstr ""

#. Occurrence 5B_16:3400:6675: scene=5B_16
#: 5B_16:3400
msgctxt "text_id=6675 | speaker=unknown"
msgid "　<曇|くも>ったガラスごしには、たしかに人影のような形が見える。"
msgstr ""

#. Occurrence 5B_16:3420:6676: scene=5B_16
#: 5B_16:3420
msgctxt "text_id=6676 | speaker=unknown"
msgid "　久遠寺有珠の道具は、魔術師たちですら頭を悩ます神秘の具現だ。"
msgstr ""

#. Occurrence 5B_16:3425:6677: scene=5B_16
#: 5B_16:3425
msgctxt "text_id=6677 | speaker=unknown"
msgid "　理屈やら辻褄を合わせようとする時点で、<魔術師|あおこ>には手の届かない魔術である。"
msgstr ""

#. Occurrence 5B_16:3449:6678: scene=5B_16
#: 5B_16:3449
msgctxt "text_id=6678 | speaker=unknown"
msgid "　それに納得して瓶の蓋を閉めると、少年の姿は手品のようにかき消えた。"
msgstr ""

#. Occurrence 5B_16:3519:6679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0033; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3519
msgctxt "text_id=6679 | speaker=aoko"
msgid "「……まったく。こんなの手品じゃなくて魔法だって」"
msgstr ""

#. Occurrence 5B_16:3525:6680: scene=5B_16
#: 5B_16:3525
msgctxt "text_id=6680 | speaker=unknown"
msgid "　ひとり呟いて、青子は魔法の瓶を覗きこむ。"
msgstr ""

#. Occurrence 5B_16:3530:6681: scene=5B_16
#: 5B_16:3530
msgctxt "text_id=6681 | speaker=unknown"
msgid "　瓶の重さはさして変わらないし、どんな仕組みかも青子には分からない。けれどたしかに、人間ひとりが閉じこめられている。"
msgstr ""

#. Occurrence 5B_16:3600:6682: scene=5B_16
#: 5B_16:3600
msgctxt "text_id=6682 | speaker=unknown"
msgid "　その軽さは幻のようで、いまいち実感が湧かなかった。"
msgstr ""

#. Occurrence 5B_16:3605:6683: scene=5B_16
#: 5B_16:3605
msgctxt "text_id=6683 | speaker=unknown"
msgid "　人の重さというより風の重さだ。"
msgstr ""

#. Occurrence 5B_16:3610:6684: scene=5B_16
#: 5B_16:3610
msgctxt "text_id=6684 | speaker=unknown"
msgid "　夏の風を手探りで掻き集めて、この瓶に詰めこんだのなら、ちょうどこれぐらいの重さになるだろう。"
msgstr ""

#. Occurrence 5B_16:3616:6685: scene=5B_16
#: 5B_16:3616
msgctxt "text_id=6685 | speaker=unknown"
msgid "　だから彼女にとって、草十郎はそんなイメージなのだ。"
msgstr ""

#. Occurrence 5B_16:3668:6686: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0034; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3668
msgctxt "text_id=6686 | speaker=aoko"
msgid "「……有珠の言う通り」"
msgstr ""

#. Occurrence 5B_16:3674:6687: scene=5B_16
#: 5B_16:3674
msgctxt "text_id=6687 | speaker=unknown"
msgid "　そんな事を考えてしまった自分を振り返って、ぼんやりと彼女は呟く。"
msgstr ""

#. Occurrence 5B_16:3689:6688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0035; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3689
msgctxt "text_id=6688 | speaker=aoko"
msgid "「ほんと、私らしくない」"
msgstr ""

#. Occurrence 5B_16:3735:6689: scene=5B_16
#: 5B_16:3735
msgctxt "text_id=6689 | speaker=unknown"
msgid "　いつもの不機嫌さではなく、微笑むように苦笑する。"
msgstr ""

#. Occurrence 5B_16:3740:6690: scene=5B_16
#: 5B_16:3740
msgctxt "text_id=6690 | speaker=unknown"
msgid "　世の中は広いのだし。ひとりぐらいは、ペースを乱す相手がいるのも、張り合いがあっていい。"
msgstr ""

#. Occurrence 5B_16:3760:6691: scene=5B_16
#: 5B_16:3760
msgctxt "text_id=6691 | speaker=unknown"
msgid "　苦笑しながら、一回だけこつん、と小さな魔法の瓶を指で弾くと、彼女は静かに歩きだした。"
msgstr ""

#. Occurrence 5B_16:3827:6692: scene=5B_16
#: 5B_16:3827
msgctxt "text_id=6692 | speaker=unknown"
msgid "　遠く、終演のベルが鳴る。"
msgstr ""

#. Occurrence 5B_16:3834:6693: scene=5B_16
#: 5B_16:3834
msgctxt "text_id=6693 | speaker=unknown"
msgid "　世は全て事もなく、うたかたの夢も元通り。"
msgstr ""

#. Occurrence 5B_16:3839:6694: scene=5B_16
#: 5B_16:3839
msgctxt "text_id=6694 | speaker=unknown"
msgid "　役者の去った遊園地は、静かに<装飾|あかり>を消していく。"
msgstr ""

#. Occurrence 5B_16:3860:6695: scene=5B_16
#: 5B_16:3860
msgctxt "text_id=6695 | speaker=unknown"
msgid "　……こうして。とうに寿命を迎えていた遊園地は少年と少女の思い出の地になって、その役割を終えたのだった。"
msgstr ""

#. Occurrence 5B_2:61:6696: scene=5B_2
#: 5B_2:61
msgctxt "text_id=6696 | speaker=unknown"
msgid "　かくして、遊園地は遠き日の輝きを取り戻した。"
msgstr ""

#. Occurrence 5B_2:168:6697: scene=5B_2
#: 5B_2:168
msgctxt "text_id=6697 | speaker=unknown"
msgid "　夜を照らす無数の電飾。"
msgstr ""

#. Occurrence 5B_2:173:6698: scene=5B_2
#: 5B_2:173
msgctxt "text_id=6698 | speaker=unknown"
msgid "　スピーカーから流れるレコードの音。"
msgstr ""

#. Occurrence 5B_2:178:6699: scene=5B_2
#: 5B_2:178
msgctxt "text_id=6699 | speaker=unknown"
msgid "　くるくると回りだす大小のゴーラウンド。"
msgstr ""

#. Occurrence 5B_2:218:6700: scene=5B_2
#: 5B_2:218
msgctxt "text_id=6700 | speaker=unknown"
msgid "　……言うまでもなく、すべてあり得ない光景だ。"
msgstr ""

#. Occurrence 5B_2:223:6701: scene=5B_2
#: 5B_2:223
msgctxt "text_id=6701 | speaker=unknown"
msgid "　魔力を電流に変換して施設を動かす、というのも錬金術なら可能だろう。"
msgstr ""

#. Occurrence 5B_2:244:6702: scene=5B_2
#: 5B_2:244
msgctxt "text_id=6702 | speaker=unknown"
msgid "　―――だが。"
msgstr ""

#. Occurrence 5B_2:273:6703: scene=5B_2
#: 5B_2:273
msgctxt "text_id=6703 | speaker=unknown"
msgid "　仮に電気が供給されたとしても、壊れたものは蘇らない。"
msgstr ""

#. Occurrence 5B_2:278:6704: scene=5B_2
#: 5B_2:278
msgctxt "text_id=6704 | speaker=unknown"
msgid "　少女が調合しているものは化学式ではなく、摂理を<融|と>かす魔女の鍋に他ならない。"
msgstr ""

#. Occurrence 5B_2:370:6705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0000; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:370
msgctxt "text_id=6705 | speaker=aoko"
msgid "“……まずいわね。有珠のプロイは何個か見てきたけど、今回のはケタが違う―――”"
msgstr ""

#. Occurrence 5B_2:416:6706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0001; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:416
msgctxt "text_id=6706 | speaker=aoko"
msgid "「――――<接続|セット>」"
msgstr ""

#. Occurrence 5B_2:435:6707: scene=5B_2
#: 5B_2:435
msgctxt "text_id=6707 | speaker=unknown"
msgid "　不安を押し殺し、青子は右腕の刻印に火をいれる。"
msgstr ""

#. Occurrence 5B_2:456:6708: scene=5B_2
#: 5B_2:456
msgctxt "text_id=6708 | speaker=unknown"
msgid "　魔術回路が魔術師の<基|エ><本|ン><性|ジ><能|ン>なら、"
msgstr ""

msgctxt "text_id=6709 | speaker=unknown"
msgid "　刻印は魔術行使を補助する<演算装置|ソフトウェア>だ。"
msgstr ""

#. Occurrence 5B_2:464:6710: scene=5B_2
#: 5B_2:464
msgctxt "text_id=6710 | speaker=unknown"
msgid "　魔術師として半人前の青子を助ける切り札。"
msgstr ""

#. Occurrence 5B_2:469:6711: scene=5B_2
#: 5B_2:469
msgctxt "text_id=6711 | speaker=unknown"
msgid "　刻印化された術式なら魔力を通すだけで……その効能は劣化するにしても……再現できる、蒼崎の後継者の証である。"
msgstr ""

#. Occurrence 5B_2:550:6712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0002; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:550
msgctxt "text_id=6712 | speaker=aoko"
msgid "「―――行使二層、直流数紋」"
msgstr ""

#. Occurrence 5B_2:588:6713: scene=5B_2
#: 5B_2:588
msgctxt "text_id=6713 | speaker=unknown"
msgid "　刻印の紋様を術式再現のカタチに切り替え、自身の魔力回路に繋ぐ。"
msgstr ""

#. Occurrence 5B_2:593:6714: scene=5B_2
#: 5B_2:593
msgctxt "text_id=6714 | speaker=unknown"
msgid "　列車の<路線変更|レールチェンジ>じみた、何十という回路の<形成|パズル>。"
msgstr ""

#. Occurrence 5B_2:598:6715: scene=5B_2
#: 5B_2:598
msgctxt "text_id=6715 | speaker=unknown"
msgid "　それをできるだけ迅速に、可能な限り丁寧に組みたてる。"
msgstr ""

#. Occurrence 5B_2:707:6716: scene=5B_2
#: 5B_2:707
msgctxt "text_id=6716 | speaker=unknown"
msgid "　<無詠唱|そくせき>の魔術では久遠寺有珠に届かない。"
msgstr ""

#. Occurrence 5B_2:712:6717: scene=5B_2
#: 5B_2:712
msgctxt "text_id=6717 | speaker=unknown"
msgid "　先の魔弾で有珠を守る防壁の強度は<測|はか>った。"
msgstr ""

#. Occurrence 5B_2:717:6718: scene=5B_2
#: 5B_2:717
msgctxt "text_id=6718 | speaker=unknown"
msgid "　今度は先の五倍、二十トンの衝撃を叩きこむ。"
msgstr ""

#. Occurrence 5B_2:722:6719: scene=5B_2
#: 5B_2:722
msgctxt "text_id=6719 | speaker=unknown"
msgid "　漂いだした濃霧の守りと、有珠が常に<纏|まと>っている障壁。"
msgstr ""

#. Occurrence 5B_2:727:6720: scene=5B_2
#: 5B_2:727
msgctxt "text_id=6720 | speaker=unknown"
msgid "　両方合わせても十分に貫通する。"
msgstr ""

#. Occurrence 5B_2:786:6721: scene=5B_2
#: 5B_2:786
msgctxt "text_id=6721 | speaker=unknown"
msgid "　なので、当たりどころが悪ければ胸骨が心臓に刺さってノックアウト。"
msgstr ""

#. Occurrence 5B_2:791:6722: scene=5B_2
#: 5B_2:791
msgctxt "text_id=6722 | speaker=unknown"
msgid "　<最悪|さいあく>でも時計台からは撃ち落とせる、のだが―――"
msgstr ""

#. Occurrence 5B_2:808:6723: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0000; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:808
msgctxt "text_id=6723 | speaker=soujuurou"
msgid "「あの、そろそろいいかな」"
msgstr ""

#. Occurrence 5B_2:814:6724: scene=5B_2
#: 5B_2:814
msgctxt "text_id=6724 | speaker=unknown"
msgid "　殺し合いモードに入った緊張感を台無しにする男がひとり。"
msgstr ""

#. Occurrence 5B_2:834:6725: scene=5B_2
#: 5B_2:834
msgctxt "text_id=6725 | speaker=unknown"
msgid "　さっきから難しい顔で青子と有珠を交互に観察していた草十郎は、"
msgstr ""

#. Occurrence 5B_2:846:6726: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0001; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:846
msgctxt "text_id=6726 | speaker=soujuurou"
msgid "「それで、どういう話になったんだ？」"
msgstr ""

#. Occurrence 5B_2:859:6727: scene=5B_2
#: 5B_2:859
msgctxt "text_id=6727 | speaker=unknown"
msgid "　駅まではどう行くんですか？"
msgstr ""

msgctxt "text_id=6728 | speaker=unknown"
msgid "　みたいな質問を口にするのだった。"
msgstr ""

#. Occurrence 5B_2:909:6729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0003; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:909
msgctxt "text_id=6729 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_2:914:6730: scene=5B_2
#: 5B_2:914
msgctxt "text_id=6730 | speaker=unknown"
msgid "　怒鳴り返したいところだが、こう真剣に訊かれると怒るより呆れてしまう。"
msgstr ""

#. Occurrence 5B_2:944:6731: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0004; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:944
msgctxt "text_id=6731 | speaker=aoko"
msgid "“……信じられない。慣れてきた、私……”"
msgstr ""

#. Occurrence 5B_2:949:6732: scene=5B_2
#: 5B_2:949
msgctxt "text_id=6732 | speaker=unknown"
msgid "　青子はぐっとため息を飲みこんで、刻印の起動に意識を集中する。"
msgstr ""

#. Occurrence 5B_2:1018:6733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0005; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1018
msgctxt "text_id=6733 | speaker=aoko"
msgid "「交渉は決裂。ちょっと怒らせすぎた。"
msgstr ""

#. Occurrence 5B_2:1024:6734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0006; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1024
msgctxt "text_id=6734 | speaker=aoko"
msgid "　あの子から見れば、まあいい機会だし、遊園地ごと私を亡きものにしようってハラね」"
msgstr ""

#. Occurrence 5B_2:1030:6735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0002; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1030
msgctxt "text_id=6735 | speaker=soujuurou"
msgid "「？？？」"
msgstr ""

#. Occurrence 5B_2:1035:6736: scene=5B_2
#: 5B_2:1035
msgctxt "text_id=6736 | speaker=unknown"
msgid "　もっと簡単な言い回しプリーズ、と首をかしげる草十郎。"
msgstr ""

#. Occurrence 5B_2:1090:6737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0007; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1090
msgctxt "text_id=6737 | speaker=aoko"
msgid "「私、わりとあの子に恨まれてるから。捕まったが最後、どんな風に殺されるか想像すらできないわ。"
msgstr ""

#. Occurrence 5B_2:1102:6738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0008; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1102
msgctxt "text_id=6738 | speaker=aoko"
msgid "　……要するに、アンタも私も、あの子をどうにかしないと生きて帰れないってコトよ」"
msgstr ""

#. Occurrence 5B_2:1183:6739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0003; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1183
msgctxt "text_id=6739 | speaker=soujuurou"
msgid "「そんな、とばっちりだ！」"
msgstr ""

#. Occurrence 5B_2:1283:6740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0009; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1283
msgctxt "text_id=6740 | speaker=aoko"
msgid "「まあ―――そういう事になるかもね！」"
msgstr ""

#. Occurrence 5B_2:1377:6741: scene=5B_2
#: 5B_2:1377
msgctxt "text_id=6741 | speaker=unknown"
msgid "　この期におよんで空気読めていない草十郎の叫びに、青子は渾身の右腕を放つ。"
msgstr ""

#. Occurrence 5B_2:1382:6742: scene=5B_2
#: 5B_2:1382
msgctxt "text_id=6742 | speaker=unknown"
msgid "　狙いは草十郎ではない。"
msgstr ""

#. Occurrence 5B_2:1387:6743: scene=5B_2
#: 5B_2:1387
msgctxt "text_id=6743 | speaker=unknown"
msgid "　ちょっと前までの青子なら草十郎へ掃射していた気配濃厚だが、今は時計台に立つ黒衣の少女が優先される―――！"
msgstr ""

#. Occurrence 5B_2:1713:6744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0010; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1713
msgctxt "text_id=6744 | speaker=aoko"
msgid "「っ―――！！！？」"
msgstr ""

#. Occurrence 5B_2:1719:6745: scene=5B_2
#: 5B_2:1719
msgctxt "text_id=6745 | speaker=unknown"
msgid "　あまりの驚きに状況把握が間に合わない。"
msgstr ""

#. Occurrence 5B_2:1724:6746: scene=5B_2
#: 5B_2:1724
msgctxt "text_id=6746 | speaker=unknown"
msgid "　現状で考えられる最速／最高威力の魔弾を防がれた。"
msgstr ""

#. Occurrence 5B_2:1729:6747: scene=5B_2
#: 5B_2:1729
msgctxt "text_id=6747 | speaker=unknown"
msgid "　それはいい。"
msgstr ""

#. Occurrence 5B_2:1734:6748: scene=5B_2
#: 5B_2:1734
msgctxt "text_id=6748 | speaker=unknown"
msgid "　有珠が本気で防御に徹すればそれぐらいはするだろう。"
msgstr ""

#. Occurrence 5B_2:1807:6749: scene=5B_2
#: 5B_2:1807
msgctxt "text_id=6749 | speaker=unknown"
msgid "　だが今のは何事か。"
msgstr ""

#. Occurrence 5B_2:1812:6750: scene=5B_2
#: 5B_2:1812
msgctxt "text_id=6750 | speaker=unknown"
msgid "　何か得体の知れないものが飛んできて有珠を守った。"
msgstr ""

#. Occurrence 5B_2:1817:6751: scene=5B_2
#: 5B_2:1817
msgctxt "text_id=6751 | speaker=unknown"
msgid "　馬？バッタ？いや、そもそもあんな生き物はこの世には存在しない。"
msgstr ""

#. Occurrence 5B_2:1822:6752: scene=5B_2
#: 5B_2:1822
msgctxt "text_id=6752 | speaker=unknown"
msgid "　あんな風に―――雲霞のように群をなして、夜空を埋め尽くしたりはしない。"
msgstr ""

#. Occurrence 5B_2:2151:6753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0011; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2151
msgctxt "text_id=6753 | speaker=aoko"
msgid "「な―――」"
msgstr ""

#. Occurrence 5B_2:2247:6754: scene=5B_2
#: 5B_2:2247
msgctxt "text_id=6754 | speaker=unknown"
msgid "　あり得ないものが、あり得ないカタチで動き出す。"
msgstr ""

#. Occurrence 5B_2:2252:6755: scene=5B_2
#: 5B_2:2252
msgctxt "text_id=6755 | speaker=unknown"
msgid "　少女は彼らに電源など与えていない。"
msgstr ""

#. Occurrence 5B_2:2257:6756: scene=5B_2
#: 5B_2:2257
msgctxt "text_id=6756 | speaker=unknown"
msgid "　そも必要としていない。"
msgstr ""

#. Occurrence 5B_2:2262:6757: scene=5B_2
#: 5B_2:2262
msgctxt "text_id=6757 | speaker=unknown"
msgid "　壊れ、<棄|す>てられた彼らは、もう人間の<法則|ルール>には従わない。"
msgstr ""

#. Occurrence 5B_2:2445:6758: scene=5B_2
#: 5B_2:2445
msgctxt "text_id=6758 | speaker=unknown"
msgid "　それは、おとぎ話の侵略だった。"
msgstr ""

#. Occurrence 5B_2:2450:6759: scene=5B_2
#: 5B_2:2450
msgctxt "text_id=6759 | speaker=unknown"
msgid "　<自動人形|オートマタ>なぞ優しいものだ。"
msgstr ""

#. Occurrence 5B_2:2455:6760: scene=5B_2
#: 5B_2:2455
msgctxt "text_id=6760 | speaker=unknown"
msgid "　自律する人形は魔術の<業|わざ>によるものだが、それでも、人形としてのあり方を守っていた。"
msgstr ""

#. Occurrence 5B_2:2460:6761: scene=5B_2
#: 5B_2:2460
msgctxt "text_id=6761 | speaker=unknown"
msgid "　だが―――動きだし、新たな命を得た<彼|・><ら|・>は、もう人形ですらない。"
msgstr ""

#. Occurrence 5B_2:2513:6762: scene=5B_2
#: 5B_2:2513
msgctxt "text_id=6762 | speaker=unknown"
msgid "　器物が生物に、"
msgstr ""

#. Occurrence 5B_2:2518:6763: scene=5B_2
#: 5B_2:2518
msgctxt "text_id=6763 | speaker=unknown"
msgid "　模型が畸形に変貌する。"
msgstr ""

#. Occurrence 5B_2:2523:6764: scene=5B_2
#: 5B_2:2523
msgctxt "text_id=6764 | speaker=unknown"
msgid "　広がりつつあるのは視覚化できるほど濃密な魔力の霧と、"
msgstr ""

#. Occurrence 5B_2:2528:6765: scene=5B_2
#: 5B_2:2528
msgctxt "text_id=6765 | speaker=unknown"
msgid "　入園者を歓迎する、千を超える<怪物|クリーチャー>たち……！"
msgstr ""

#. Occurrence 5B_2:2570:6766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0012; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2570
msgctxt "text_id=6766 | speaker=aoko"
msgid "「っ、―――！！！！」"
msgstr ""

#. Occurrence 5B_2:2602:6767: scene=5B_2
#: 5B_2:2602
msgctxt "text_id=6767 | speaker=unknown"
msgid "　背中を走る戦慄につき動かされ、青子は一工程の魔弾を掃射する。"
msgstr ""

#. Occurrence 5B_2:2743:6768: scene=5B_2
#: 5B_2:2743
msgctxt "text_id=6768 | speaker=unknown"
msgid "　無我夢中の攻撃は無様に散った。"
msgstr ""

#. Occurrence 5B_2:2818:6769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0013; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2818
msgctxt "text_id=6769 | speaker=aoko"
msgid "「あ―――」"
msgstr ""

#. Occurrence 5B_2:2823:6770: scene=5B_2
#: 5B_2:2823
msgctxt "text_id=6770 | speaker=unknown"
msgid "　メリーゴーラウンドの騎士は空を飛び、"
msgstr ""

#. Occurrence 5B_2:2828:6771: scene=5B_2
#: 5B_2:2828
msgctxt "text_id=6771 | speaker=unknown"
msgid "　<緑|みどり>トカゲは火を吹きながら集まりだす。"
msgstr ""

#. Occurrence 5B_2:2833:6772: scene=5B_2
#: 5B_2:2833
msgctxt "text_id=6772 | speaker=unknown"
msgid "　焼きたてべーカリーは経営を再開し、オーブンからは人間大の焼きたてパンが小隊を組んで進軍する。"
msgstr ""

#. Occurrence 5B_2:2885:6773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0004; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:2885
msgctxt "text_id=6773 | speaker=soujuurou"
msgid "「―――蒼崎、後ろ！」"
msgstr ""

#. Occurrence 5B_2:2891:6774: scene=5B_2
#: 5B_2:2891
msgctxt "text_id=6774 | speaker=unknown"
msgid "　青子と草十郎は包囲されつつあった。"
msgstr ""

#. Occurrence 5B_2:2896:6775: scene=5B_2
#: 5B_2:2896
msgctxt "text_id=6775 | speaker=unknown"
msgid "　軋みをあげてゆっくりとまわる観覧車。"
msgstr ""

#. Occurrence 5B_2:2901:6776: scene=5B_2
#: 5B_2:2901
msgctxt "text_id=6776 | speaker=unknown"
msgid "　涙に濡れたキッツィーを乗せて、ガラクタの車両がコースターを走っていく。"
msgstr ""

#. Occurrence 5B_2:2971:6777: scene=5B_2
#: 5B_2:2971
msgctxt "text_id=6777 | speaker=unknown"
msgid "　あまりにも歪んだ幻想。"
msgstr ""

#. Occurrence 5B_2:2976:6778: scene=5B_2
#: 5B_2:2976
msgctxt "text_id=6778 | speaker=unknown"
msgid "　赤く回りだした遊園地を背に、黒衣の少女は君臨する。"
msgstr ""

#. Occurrence 5B_2:3028:6779: scene=5B_2
#: 5B_2:3028
msgctxt "text_id=6779 | speaker=unknown"
msgid "　ああ、これはない。"
msgstr ""

#. Occurrence 5B_2:3033:6780: scene=5B_2
#: 5B_2:3033
msgctxt "text_id=6780 | speaker=unknown"
msgid "　これはないわ、と忘我しながら、青子はこの現象が何であるかに当たりをつけた。"
msgstr ""

#. Occurrence 5B_2:3066:6781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0014; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3066
msgctxt "text_id=6781 | speaker=aoko"
msgid "「―――そうだ、これは」"
msgstr ""

#. Occurrence 5B_2:3072:6782: scene=5B_2
#: 5B_2:3072
msgctxt "text_id=6782 | speaker=unknown"
msgid "　有珠に聞いたマインスターの使い魔たち。"
msgstr ""

#. Occurrence 5B_2:3077:6783: scene=5B_2
#: 5B_2:3077
msgctxt "text_id=6783 | speaker=unknown"
msgid "　その中でも三本指に入る折り紙付きの使い魔が、これと似た出来事を起こすハズだ。"
msgstr ""

#. Occurrence 5B_2:3082:6784: scene=5B_2
#: 5B_2:3082
msgctxt "text_id=6784 | speaker=unknown"
msgid "　名前は、たしか―――"
msgstr ""

#. Occurrence 5B_2:3104:6785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0015; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3104
msgctxt "text_id=6785 | speaker=aoko"
msgid "「<童話の怪物|プロイキッシャー>、フラットスナーク……！」"
msgstr ""

#. Occurrence 5B_2:3140:6786: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0005; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3140
msgctxt "text_id=6786 | speaker=soujuurou"
msgid "「蒼崎、だから後ろ！」"
msgstr ""

#. Occurrence 5B_2:3241:6787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0016; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3241
msgctxt "text_id=6787 | speaker=aoko"
msgid "「―――！」"
msgstr ""

#. Occurrence 5B_2:3301:6788: scene=5B_2
#: 5B_2:3301
msgctxt "text_id=6788 | speaker=unknown"
msgid "　青い魔弾を受け、木っ端微塵に砕け散るクリーチャー。"
msgstr ""

#. Occurrence 5B_2:3306:6789: scene=5B_2
#: 5B_2:3306
msgctxt "text_id=6789 | speaker=unknown"
msgid "　青子の魔弾の威力があがっている、というのもあるが、一体一体は自動人形ほど頑丈ではないようだ。"
msgstr ""

#. Occurrence 5B_2:3360:6790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0017; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3360
msgctxt "text_id=6790 | speaker=aoko"
msgid "「静希君、こっち！」"
msgstr ""

#. Occurrence 5B_2:3366:6791: scene=5B_2
#: 5B_2:3366
msgctxt "text_id=6791 | speaker=unknown"
msgid "　青子は時計台に背を向けて、草十郎の手をとって走りだす。"
msgstr ""

#. Occurrence 5B_2:3446:6792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0006; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3446
msgctxt "text_id=6792 | speaker=soujuurou"
msgid "「ちょっ、蒼崎！？」"
msgstr ""

#. Occurrence 5B_2:3452:6793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0018; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3452
msgctxt "text_id=6793 | speaker=aoko"
msgid "「ごめん、これ無理！"
msgstr ""

#. Occurrence 5B_2:3459:6794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0019; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3459
msgctxt "text_id=6794 | speaker=aoko"
msgid "　逃げるわよ！」"
msgstr ""

#. Occurrence 5B_2:3465:6795: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0007; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3465
msgctxt "text_id=6795 | speaker=soujuurou"
msgid "「逃げるってどこに！？」"
msgstr ""

#. Occurrence 5B_2:3471:6796: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0020; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3471
msgctxt "text_id=6796 | speaker=aoko"
msgid "「どこって、とにかく行けるところまで……！」"
msgstr ""

#. Occurrence 5B_2:3555:6797: scene=5B_2
#: 5B_2:3555
msgctxt "text_id=6797 | speaker=unknown"
msgid "　自分に言い聞かせるように叫んで、青子は気合いで道を<拓|ひら>く。"
msgstr ""

#. Occurrence 5B_2:3560:6798: scene=5B_2
#: 5B_2:3560
msgctxt "text_id=6798 | speaker=unknown"
msgid "　放たれる魔弾は悲鳴そのものだ。"
msgstr ""

#. Occurrence 5B_2:3565:6799: scene=5B_2
#: 5B_2:3565
msgctxt "text_id=6799 | speaker=unknown"
msgid "　立ちふさがる……というより、ただ集まっていただけのクリーチャーたちを吹き飛ばし、ふたりは包囲網を抜けだした。"
msgstr ""

#. Occurrence 5B_3:365:6800: scene=5B_3
#: 5B_3:365
msgctxt "text_id=6800 | speaker=unknown"
msgid "　青い火花を散らす魔弾。"
msgstr ""

#. Occurrence 5B_3:406:6801: scene=5B_3
#: 5B_3:406
msgctxt "text_id=6801 | speaker=unknown"
msgid "　波うつレンガの道を青子たちはひた走る。"
msgstr ""

#. Occurrence 5B_3:411:6802: scene=5B_3
#: 5B_3:411
msgctxt "text_id=6802 | speaker=unknown"
msgid "　つり橋効果を遥かに超える戦場での信頼感。"
msgstr ""

#. Occurrence 5B_3:416:6803: scene=5B_3
#: 5B_3:416
msgctxt "text_id=6803 | speaker=unknown"
msgid "　ふたりは全速力で、さしたる会話もアイコンタクトもなく、遊園地の出口を目指す。"
msgstr ""

#. Occurrence 5B_3:421:6804: scene=5B_3
#: 5B_3:421
msgctxt "text_id=6804 | speaker=unknown"
msgid "　この異常は遊園地の中だけのこと。"
msgstr ""

#. Occurrence 5B_3:426:6805: scene=5B_3
#: 5B_3:426
msgctxt "text_id=6805 | speaker=unknown"
msgid "　なら、外に出てしまえば助かるだろうと。"
msgstr ""

#. Occurrence 5B_3:476:6806: scene=5B_3
#: 5B_3:476
msgctxt "text_id=6806 | speaker=unknown"
msgid "　が。"
msgstr ""

#. Occurrence 5B_3:481:6807: scene=5B_3
#: 5B_3:481
msgctxt "text_id=6807 | speaker=unknown"
msgid "　戦力差、数にして二人対数百人。"
msgstr ""

#. Occurrence 5B_3:486:6808: scene=5B_3
#: 5B_3:486
msgctxt "text_id=6808 | speaker=unknown"
msgid "　もとい、一人対数百体。"
msgstr ""

#. Occurrence 5B_3:491:6809: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6809 | speaker=unknown"
msgid "　草十郎はほとんど使い物にならないし、"
msgstr ""

#. Occurrence 5B_3:491:6810: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6810 | speaker=unknown"
msgid "　襲いかかってくるのは人というより<人形|パペット>である。"
msgstr ""

#. Occurrence 5B_3:543:6811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6811 | speaker=aoko"
msgid "「さっきの大丈夫！？"
msgstr ""

#. Occurrence 5B_3:543:6812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6812 | speaker=aoko"
msgid "　上からこう、でっかいハサミが落ちてきたけど！」"
msgstr ""

#. Occurrence 5B_3:549:6813: scene=5B_3
#: 5B_3:549
msgctxt "text_id=6813 | speaker=unknown"
msgid "　立ちふさがる怪物を撃ち砕きながら青子が叫ぶ。"
msgstr ""

#. Occurrence 5B_3:554:6814: scene=5B_3
#: 5B_3:554
msgctxt "text_id=6814 | speaker=unknown"
msgid "　振り向く余裕も、立ち止まっている暇もない。"
msgstr ""

#. Occurrence 5B_3:585:6815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0000; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:585
msgctxt "text_id=6815 | speaker=soujuurou"
msgid "「なんとか、ギリギリ！」"
msgstr ""

#. Occurrence 5B_3:591:6816: scene=5B_3
#: 5B_3:591
msgctxt "text_id=6816 | speaker=unknown"
msgid "　青子を追う草十郎も、さすがに声がうわずっている。"
msgstr ""

#. Occurrence 5B_3:691:6817: scene=5B_3
#: 5B_3:691
msgctxt "text_id=6817 | speaker=unknown"
msgid "　―――さかのぼること五分前。"
msgstr ""

#. Occurrence 5B_3:697:6818: scene=5B_3
#: 5B_3:697
msgctxt "text_id=6818 | speaker=unknown"
msgid "　広場の包囲網からは呆気なく抜け出せた。"
msgstr ""

#. Occurrence 5B_3:702:6819: scene=5B_3
#: 5B_3:702
msgctxt "text_id=6819 | speaker=unknown"
msgid "　住人たちの“目覚め”には個体差があって、大きなものほど動きだすには時間が必要らしい。"
msgstr ""

#. Occurrence 5B_3:772:6820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0001; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:772
msgctxt "text_id=6820 | speaker=aoko"
msgid "「ラッキー、朝に弱いタイプばっかとみた！」"
msgstr ""

#. Occurrence 5B_3:778:6821: scene=5B_3
#: 5B_3:778
msgctxt "text_id=6821 | speaker=unknown"
msgid "　青子は軽口を言って、ひょっこり現れたザコをなぎ払う。"
msgstr ""

#. Occurrence 5B_3:799:6822: scene=5B_3
#: 5B_3:799
msgctxt "text_id=6822 | speaker=unknown"
msgid "　そんな時。"
msgstr ""

#. Occurrence 5B_3:825:6823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0002; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:825
msgctxt "text_id=6823 | speaker=aoko"
msgid "「へ？」"
msgstr ""

#. Occurrence 5B_3:830:6824: scene=5B_3
#: 5B_3:830
msgctxt "text_id=6824 | speaker=unknown"
msgid "　突如、ふたりの頭上にとんでもないモノが伸びてきた。"
msgstr ""

#. Occurrence 5B_3:1002:6825: scene=5B_3
#: 5B_3:1002
msgctxt "text_id=6825 | speaker=unknown"
msgid "　ロブスター<専門店|レストラン>の屋根に鎮座していた、全長18メートルのザリガニ、そのハサミである。"
msgstr ""

#. Occurrence 5B_3:1122:6826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0003; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1122
msgctxt "text_id=6826 | speaker=aoko"
msgid "「…………！」"
msgstr ""

#. Occurrence 5B_3:1127:6827: scene=5B_3
#: 5B_3:1127
msgctxt "text_id=6827 | speaker=unknown"
msgid "　ほとんどギロチンのようなハサミだった。"
msgstr ""

#. Occurrence 5B_3:1132:6828: scene=5B_3
#: 5B_3:1132
msgctxt "text_id=6828 | speaker=unknown"
msgid "　レストラン前を横切る青子たちを、凄まじいスピードでまっ二つにしようと迫る<赤い甲殻類|レッドキング>。"
msgstr ""

#. Occurrence 5B_3:1205:6829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0004; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1205
msgctxt "text_id=6829 | speaker=aoko"
msgid "「静希君、ユーターン！　こっちはダメ！」"
msgstr ""

#. Occurrence 5B_3:1211:6830: scene=5B_3
#: 5B_3:1211
msgctxt "text_id=6830 | speaker=unknown"
msgid "　ロブスター店を抜ければすぐに<正門|ゲート>だったが、ふたりは巨大ザリガニから逃れるように遠回りをする。"
msgstr ""

#. Occurrence 5B_3:1216:6831: scene=5B_3
#: 5B_3:1216
msgctxt "text_id=6831 | speaker=unknown"
msgid "　そうして迂回した先に待ち受けていたのは、おびただしいまでの怪物の群だった。"
msgstr ""

#. Occurrence 5B_3:1263:6832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0001; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1263
msgctxt "text_id=6832 | speaker=soujuurou"
msgid "「なんとか、ギリギリ！」"
msgstr ""

#. Occurrence 5B_3:1303:6833: scene=5B_3
#: 5B_3:1303
msgctxt "text_id=6833 | speaker=unknown"
msgid "　あやうく首からすっぱり切られそうだったピンチを思いだしながら、草十郎は青子に叫び返す。"
msgstr ""

#. Occurrence 5B_3:1355:6834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0002; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1355
msgctxt "text_id=6834 | speaker=soujuurou"
msgid "「って前！　うわ、なんだあれ、焼きたてか！？」"
msgstr ""

#. Occurrence 5B_3:1361:6835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0005; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1361
msgctxt "text_id=6835 | speaker=aoko"
msgid "「そうみたいね、要するに下級兵士よ！」"
msgstr ""

#. Occurrence 5B_3:1421:6836: scene=5B_3
#: 5B_3:1421
msgctxt "text_id=6836 | speaker=unknown"
msgid "　青子は駆け足を止めて魔術刻印をフル回転させる。"
msgstr ""

#. Occurrence 5B_3:1428:6837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0006; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1428
msgctxt "text_id=6837 | speaker=aoko"
msgid "“距離七、六、五メートル……！"
msgstr ""

msgctxt "text_id=6838 | speaker=unknown"
msgid "　あの程度ならスナップだけで事足りる……！”"
msgstr ""

#. Occurrence 5B_3:1523:6839: scene=5B_3
#: 5B_3:1523
msgctxt "text_id=6839 | speaker=unknown"
msgid "　レンガの道を滑りながら右腕を一閃する。"
msgstr ""

#. Occurrence 5B_3:1528:6840: scene=5B_3
#: 5B_3:1528
msgctxt "text_id=6840 | speaker=unknown"
msgid "　放たれる魔弾の雨。"
msgstr ""

#. Occurrence 5B_3:1571:6841: scene=5B_3
#: 5B_3:1571
msgctxt "text_id=6841 | speaker=unknown"
msgid "　威力より弾数を優先した<一工程|スナップ>は、立ちふさがる怪物たちを小気味良くまき散らかす。"
msgstr ""

#. Occurrence 5B_3:1625:6842: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0003; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1625
msgctxt "text_id=6842 | speaker=soujuurou"
msgid "「―――蒼崎、そっちも！」"
msgstr ""

#. Occurrence 5B_3:1705:6843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0007; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1705
msgctxt "text_id=6843 | speaker=aoko"
msgid "「了解……！」"
msgstr ""

#. Occurrence 5B_3:1862:6844: scene=5B_3
#: 5B_3:1862
msgctxt "text_id=6844 | speaker=unknown"
msgid "　電飾のついた遊歩道に、青い火花が咲き乱れる。"
msgstr ""

#. Occurrence 5B_3:1867:6845: scene=5B_3
#: 5B_3:1867
msgctxt "text_id=6845 | speaker=unknown"
msgid "　扇状に弾幕をはる青子の姿は、空から<俯瞰|ふかん>すれば美しいスターマインそのものだ。"
msgstr ""

#. Occurrence 5B_3:1872:6846: scene=5B_3
#: 5B_3:1872
msgctxt "text_id=6846 | speaker=unknown"
msgid "　焼きたてパンの<遊び道具|レイカンファー>、ブレッドマンではそれこそ消し<炭|ずみ>にされるだけ。"
msgstr ""

#. Occurrence 5B_3:1954:6847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0008; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1954
msgctxt "text_id=6847 | speaker=aoko"
msgid "“いける―――数でこそ押されてるけど、この状態が続くなら逃げきれる―――！”"
msgstr ""

#. Occurrence 5B_3:1969:6848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0009; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1969
msgctxt "text_id=6848 | speaker=aoko"
msgid "「静希君、そっちは！？」"
msgstr ""

#. Occurrence 5B_3:2020:6849: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0004; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:2020
msgctxt "text_id=6849 | speaker=soujuurou"
msgid "「いない、空いてる！　ここからなら入り口の東側に出られるはずだ！」"
msgstr ""

#. Occurrence 5B_3:2098:6850: scene=5B_3
#: 5B_3:2098
msgctxt "text_id=6850 | speaker=unknown"
msgid "　並の魔術師なら息切れをする数の魔弾を放ちながら、新米魔術師は敵の囲みを突破する。"
msgstr ""

#. Occurrence 5B_3:2105:6851: scene=5B_3
#: 5B_3:2105
msgctxt "text_id=6851 | speaker=unknown"
msgid "　……一方。"
msgstr ""

#. Occurrence 5B_3:2110:6852: scene=5B_3
#: 5B_3:2110
msgctxt "text_id=6852 | speaker=unknown"
msgid "　そんな光景を、じっくりと観察する鳥が一羽。"
msgstr ""

#. Occurrence 5B_4:119:6853: scene=5B_4
#: 5B_4:119
msgctxt "text_id=6853 | speaker=unknown"
msgid "　チ、チチチ、チ！"
msgstr ""

#. Occurrence 5B_4:124:6854: scene=5B_4
#: 5B_4:124
msgctxt "text_id=6854 | speaker=unknown"
msgid "　高度を落として主人の視界に入るなり、かん高く鳴く青い鳥。"
msgstr ""

#. Occurrence 5B_4:129:6855: scene=5B_4
#: 5B_4:129
msgctxt "text_id=6855 | speaker=unknown"
msgid "　その報告を、少女は無表情で聞いている。"
msgstr ""

#. Occurrence 5B_4:150:6856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0000; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:150
msgctxt "text_id=6856 | speaker=alice"
msgid "「……かまわないわ、予想通りよ。"
msgstr ""

#. Occurrence 5B_4:156:6857: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0001; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:156
msgctxt "text_id=6857 | speaker=alice"
msgid "　撃つ事、壊す事しか能がなくても、青子の魔力の使い方は並じゃないから。急造の使い魔じゃ、まだ相手にはならないでしょう」"
msgstr ""

#. Occurrence 5B_4:178:6858: scene=5B_4
#: 5B_4:178
msgctxt "text_id=6858 | speaker=unknown"
msgid "　チチチ、と羽をすくめる駒鳥。"
msgstr ""

#. Occurrence 5B_4:183:6859: scene=5B_4
#: 5B_4:183
msgctxt "text_id=6859 | speaker=unknown"
msgid "　青子を<誉|ほ>める有珠を批難しているのか、"
msgstr ""

#. Occurrence 5B_4:188:6860: scene=5B_4
#: 5B_4:188
msgctxt "text_id=6860 | speaker=unknown"
msgid "　有珠に誉められる青子に嫉妬しているのか。"
msgstr ""

#. Occurrence 5B_4:193:6861: scene=5B_4
#: 5B_4:193
msgctxt "text_id=6861 | speaker=unknown"
msgid "　主人である有珠にも、いまいち読み取れない鳴き声である。"
msgstr ""

#. Occurrence 5B_4:297:6862: scene=5B_4
#: 5B_4:297
msgctxt "text_id=6862 | speaker=unknown"
msgid "　蒼崎青子は半人前の魔術師だ。"
msgstr ""

#. Occurrence 5B_4:302:6863: scene=5B_4
#: 5B_4:302
msgctxt "text_id=6863 | speaker=unknown"
msgid "　二年前まで魔術とは無関係に育ってきた少女で、生まれた時から魔女として育った有珠とは素質も経験も違いすぎる。"
msgstr ""

#. Occurrence 5B_4:307:6864: scene=5B_4
#: 5B_4:307
msgctxt "text_id=6864 | speaker=unknown"
msgid "　本来なら相手にすらしない次元。"
msgstr ""

#. Occurrence 5B_4:312:6865: scene=5B_4
#: 5B_4:312
msgctxt "text_id=6865 | speaker=unknown"
msgid "　魔術の腕を競うなら十回中十回、有珠に軍配があがるだろう。"
msgstr ""

#. Occurrence 5B_4:332:6866: scene=5B_4
#: 5B_4:332
msgctxt "text_id=6866 | speaker=unknown"
msgid "　けれど、こと戦い、殺し合いなら話は別だ。"
msgstr ""

#. Occurrence 5B_4:337:6867: scene=5B_4
#: 5B_4:337
msgctxt "text_id=6867 | speaker=unknown"
msgid "　久遠寺有珠は戦闘向きの魔術師ではなく、"
msgstr ""

#. Occurrence 5B_4:342:6868: scene=5B_4
#: 5B_4:342
msgctxt "text_id=6868 | speaker=unknown"
msgid "　蒼崎青子は戦いに特化した壊し屋である。"
msgstr ""

#. Occurrence 5B_4:348:6869: scene=5B_4
#: 5B_4:348
msgctxt "text_id=6869 | speaker=unknown"
msgid "　純粋な魔力勝負では青子の方が上だろう、と有珠は認めてさえいる。"
msgstr ""

#. Occurrence 5B_4:368:6870: scene=5B_4
#: 5B_4:368
msgctxt "text_id=6870 | speaker=unknown"
msgid "　青子は魔力の使い方が抜群に上手い。"
msgstr ""

#. Occurrence 5B_4:373:6871: scene=5B_4
#: 5B_4:373
msgctxt "text_id=6871 | speaker=unknown"
msgid "　魔術回路の規模は有珠より小さいが、回路の回転の速さ、その耐久構造、魔力の質、燃費の良さが並はずれている。"
msgstr ""

#. Occurrence 5B_4:378:6872: scene=5B_4
#: 5B_4:378
msgctxt "text_id=6872 | speaker=unknown"
msgid "　それが蒼崎青子の特性だ。"
msgstr ""

#. Occurrence 5B_4:384:6873: scene=5B_4
#: 5B_4:384
msgctxt "text_id=6873 | speaker=unknown"
msgid "　高度な魔術式は凡百に落ちるが、"
msgstr ""

msgctxt "text_id=6874 | speaker=unknown"
msgid "　魔力を流動させるだけの単純な魔術式なら、わずか二年の実践で有珠を上回っている。"
msgstr ""

#. Occurrence 5B_4:406:6875: scene=5B_4
#: 5B_4:406
msgctxt "text_id=6875 | speaker=unknown"
msgid "　……天才的なノリの良さと勘の良さ。"
msgstr ""

#. Occurrence 5B_4:411:6876: scene=5B_4
#: 5B_4:411
msgctxt "text_id=6876 | speaker=unknown"
msgid "　彼女の魔術行使は強いのではなく、おそろしく“速い”のだ。"
msgstr ""

#. Occurrence 5B_4:416:6877: scene=5B_4
#: 5B_4:416
msgctxt "text_id=6877 | speaker=unknown"
msgid "　蒼崎の家になんて生まれなければ、天才的な射撃手として名を<馳|は>せたに違いない。"
msgstr ""

#. Occurrence 5B_4:476:6878: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0002; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:476
msgctxt "text_id=6878 | speaker=alice"
msgid "「でも、残念ね」"
msgstr ""

#. Occurrence 5B_4:482:6879: scene=5B_4
#: 5B_4:482
msgctxt "text_id=6879 | speaker=unknown"
msgid "　正面から撃ちあえば有珠に勝ち目はない。"
msgstr ""

#. Occurrence 5B_4:487:6880: scene=5B_4
#: 5B_4:487
msgctxt "text_id=6880 | speaker=unknown"
msgid "　否、そもそも魔弾などという原始的な魔術を、久遠寺有珠は習得していない。"
msgstr ""

#. Occurrence 5B_4:492:6881: scene=5B_4
#: 5B_4:492
msgctxt "text_id=6881 | speaker=unknown"
msgid "　彼女は典型的な人形師。"
msgstr ""

#. Occurrence 5B_4:497:6882: scene=5B_4
#: 5B_4:497
msgctxt "text_id=6882 | speaker=unknown"
msgid "　戦闘はすべて、手足となる使い魔が行うことだ。"
msgstr ""

#. Occurrence 5B_4:597:6883: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0003; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:597
msgctxt "text_id=6883 | speaker=alice"
msgid "「……制限時間には気づいているわよね青子。"
msgstr ""

#. Occurrence 5B_4:603:6884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0004; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:603
msgctxt "text_id=6884 | speaker=alice"
msgid "　魔力はいくらでも貸してあげるけど―――貴女の魔弾は、あと半刻で<値崩|ねくず>れするわ」"
msgstr ""

#. Occurrence 5B_4:659:6885: scene=5B_4
#: 5B_4:659
msgctxt "text_id=6885 | speaker=unknown"
msgid "　チチチ、と<頷|うなず>くようにさえずって飛び立つ駒鳥。"
msgstr ""

#. Occurrence 5B_4:665:6886: scene=5B_4
#: 5B_4:665
msgctxt "text_id=6886 | speaker=unknown"
msgid "　遊園地が少女の支配下に<陥|おちい>ってからじき十分。"
msgstr ""

#. Occurrence 5B_4:670:6887: scene=5B_4
#: 5B_4:670
msgctxt "text_id=6887 | speaker=unknown"
msgid "　<緑|みどり>色の霧が何を生み出すものなのか。"
msgstr ""

#. Occurrence 5B_4:675:6888: scene=5B_4
#: 5B_4:675
msgctxt "text_id=6888 | speaker=unknown"
msgid "　地上を走る青子たちも、そろそろ事の深刻さに気が付く頃だった。"
msgstr ""

#. Occurrence 5B_5:103:6889: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0000; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:103
msgctxt "text_id=6889 | speaker=aoko"
msgid "「静希君、正門ってこっち！？」"
msgstr ""

#. Occurrence 5B_5:109:6890: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0000; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:109
msgctxt "text_id=6890 | speaker=soujuurou"
msgid "「ああ、その店を曲がれば出口だ！」"
msgstr ""

#. Occurrence 5B_5:210:6891: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6891 | speaker=unknown"
msgid "　全力とは言わずとも、休まずに走り続けてはや十分。"
msgstr ""

#. Occurrence 5B_5:210:6892: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6892 | speaker=unknown"
msgid "　息を乱しながらふたりは曲がり角に飛びこんだ。"
msgstr ""

#. Occurrence 5B_5:215:6893: scene=5B_5
#: 5B_5:215
msgctxt "text_id=6893 | speaker=unknown"
msgid "　遊園地と言っても所詮はキッツィーランド。"
msgstr ""

#. Occurrence 5B_5:220:6894: scene=5B_5
#: 5B_5:220
msgctxt "text_id=6894 | speaker=unknown"
msgid "　高校生が全力で走れば二十分ほどで一周できる。"
msgstr ""

#. Occurrence 5B_5:248:6895: scene=5B_5
#: 5B_5:248
msgctxt "text_id=6895 | speaker=unknown"
msgid "　そんな地域密着型のアミューズメントパークは、しかし。"
msgstr ""

#. Occurrence 5B_5:463:6896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0001; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:463
msgctxt "text_id=6896 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_5:469:6897: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0001; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:469
msgctxt "text_id=6897 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_5:474:6898: scene=5B_5
#: 5B_5:474
msgctxt "text_id=6898 | speaker=unknown"
msgid "　……このように。"
msgstr ""

#. Occurrence 5B_5:479:6899: scene=5B_5
#: 5B_5:479
msgctxt "text_id=6899 | speaker=unknown"
msgid "　住人ばかりか、遊園地そのものを変化させていた。"
msgstr ""

#. Occurrence 5B_5:573:6900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0002; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:573
msgctxt "text_id=6900 | speaker=soujuurou"
msgid "「……蒼崎」"
msgstr ""

#. Occurrence 5B_5:585:6901: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0002; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:585
msgctxt "text_id=6901 | speaker=aoko"
msgid "「……なによ」"
msgstr ""

#. Occurrence 5B_5:596:6902: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0003; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:596
msgctxt "text_id=6902 | speaker=soujuurou"
msgid "「……言いたくないんだけど。この遊園地、広くなってないか？」"
msgstr ""

#. Occurrence 5B_5:621:6903: scene=5B_5
#: 5B_5:621
msgctxt "text_id=6903 | speaker=unknown"
msgid "　そう。"
msgstr ""

#. Occurrence 5B_5:627:6904: scene=5B_5
#: 5B_5:627
msgctxt "text_id=6904 | speaker=unknown"
msgid "出口を間違えたとか、地形が変わっているとか、そんな現実的な間違いではない。"
msgstr ""

#. Occurrence 5B_5:633:6905: scene=5B_5
#: 5B_5:633
msgctxt "text_id=6905 | speaker=unknown"
msgid "　あらゆるものが、ねじ曲がっている。"
msgstr ""

#. Occurrence 5B_5:639:6906: scene=5B_5
#: 5B_5:639
msgctxt "text_id=6906 | speaker=unknown"
msgid "　遊園地はそれ自体が生き物のように、いまもって、その規模を成長させていた。"
msgstr ""

#. Occurrence 5B_5:749:6907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0004; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:749
msgctxt "text_id=6907 | speaker=soujuurou"
msgid "「―――」"
msgstr ""

#. Occurrence 5B_5:755:6908: scene=5B_5
#: 5B_5:755
msgctxt "text_id=6908 | speaker=unknown"
msgid "　気が付けば包囲網は一段と強固になっている。"
msgstr ""

#. Occurrence 5B_5:775:6909: scene=5B_5
#: 5B_5:775
msgctxt "text_id=6909 | speaker=unknown"
msgid "　草十郎に背中をあずけながら、青子は懸命に泣き言を抑えこむ。"
msgstr ""

#. Occurrence 5B_5:780:6910: scene=5B_5
#: 5B_5:780
msgctxt "text_id=6910 | speaker=unknown"
msgid "　草十郎は驚き、怖がるだけでいい。"
msgstr ""

#. Occurrence 5B_5:785:6911: scene=5B_5
#: 5B_5:785
msgctxt "text_id=6911 | speaker=unknown"
msgid "　けれど青子はそうはいかない。"
msgstr ""

#. Occurrence 5B_5:790:6912: scene=5B_5
#: 5B_5:790
msgctxt "text_id=6912 | speaker=unknown"
msgid "　この状況を招き、彼の手を取った責任がある。"
msgstr ""

#. Occurrence 5B_5:795:6913: scene=5B_5
#: 5B_5:795
msgctxt "text_id=6913 | speaker=unknown"
msgid "　おいそれとパニックに<陥|おちい>るワケにはいかないのだ。"
msgstr ""

#. Occurrence 5B_5:885:6914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0003; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:885
msgctxt "text_id=6914 | speaker=aoko"
msgid "“……大丈夫、落ち着け私……"
msgstr ""

#. Occurrence 5B_5:891:6915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0004; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:891
msgctxt "text_id=6915 | speaker=aoko"
msgid "　遊園地の果てはある。遠いけど、鉄柵はちゃんと見える。"
msgstr ""

#. Occurrence 5B_5:897:6916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0005; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:897
msgctxt "text_id=6916 | speaker=aoko"
msgid "　フラットスナークだって制限無しってワケじゃない。外に逃げるって選択は正しいはず……。"
msgstr ""

#. Occurrence 5B_5:903:6917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0006; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:903
msgctxt "text_id=6917 | speaker=aoko"
msgid "　現状、外までは目算で一キロぐらいだけど―――”"
msgstr ""

#. Occurrence 5B_5:944:6918: scene=5B_5
#: 5B_5:944
msgctxt "text_id=6918 | speaker=unknown"
msgid "　ここまで夢中で走りすぎた。"
msgstr ""

#. Occurrence 5B_5:949:6919: scene=5B_5
#: 5B_5:949
msgctxt "text_id=6919 | speaker=unknown"
msgid "　青子も草十郎も息が上がっている。"
msgstr ""

#. Occurrence 5B_5:954:6920: scene=5B_5
#: 5B_5:954
msgctxt "text_id=6920 | speaker=unknown"
msgid "　あと一キロ走るのなら、いったん休憩をいれないと途中で足が止まってしまう。"
msgstr ""

#. Occurrence 5B_5:975:6921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0005; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:975
msgctxt "text_id=6921 | speaker=soujuurou"
msgid "「……蒼崎。体、大丈夫か？」"
msgstr ""

#. Occurrence 5B_5:1044:6922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0007; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1044
msgctxt "text_id=6922 | speaker=aoko"
msgid "「へ？」"
msgstr ""

#. Occurrence 5B_5:1050:6923: scene=5B_5
#: 5B_5:1050
msgctxt "text_id=6923 | speaker=unknown"
msgid "　背中ごしに<囁|ささや>きかけられ、青子は現実に引き戻された。"
msgstr ""

#. Occurrence 5B_5:1129:6924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0008; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1129
msgctxt "text_id=6924 | speaker=aoko"
msgid "「大丈夫だけど……ちょっと、一息いれたいわね」"
msgstr ""

#. Occurrence 5B_5:1141:6925: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0006; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1141
msgctxt "text_id=6925 | speaker=soujuurou"
msgid "「……賛成。ここから休みなしで外周まで走るのは、やめた方がいい」"
msgstr ""

#. Occurrence 5B_5:1153:6926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0009; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1153
msgctxt "text_id=6926 | speaker=aoko"
msgid "「―――驚いた。静希君も外まで走ろう派とは」"
msgstr ""

#. Occurrence 5B_5:1247:6927: scene=5B_5
#: 5B_5:1247
msgctxt "text_id=6927 | speaker=unknown"
msgid "　言って、くすりと笑ってしまった。"
msgstr ""

#. Occurrence 5B_5:1252:6928: scene=5B_5
#: 5B_5:1252
msgctxt "text_id=6928 | speaker=unknown"
msgid "　背中の戦友はパニック状態どころか、きちんと現状と、その打開策を考えていた。"
msgstr ""

#. Occurrence 5B_5:1329:6929: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0007; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1329
msgctxt "text_id=6929 | speaker=soujuurou"
msgid "「ちょっとだけ建物に逃げこむのは？」"
msgstr ""

#. Occurrence 5B_5:1341:6930: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0010; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1341
msgctxt "text_id=6930 | speaker=aoko"
msgid "「………気は進まないけど、それしかないわね」"
msgstr ""

#. Occurrence 5B_5:1422:6931: scene=5B_5
#: 5B_5:1422
msgctxt "text_id=6931 | speaker=unknown"
msgid "　焼きたてパンたちの包囲網。"
msgstr ""

#. Occurrence 5B_5:1427:6932: scene=5B_5
#: 5B_5:1427
msgctxt "text_id=6932 | speaker=unknown"
msgid "　常人ならいざ知らず、青子ならこの囲みを破って建物に逃げこむのは<容易|ようい>だ。"
msgstr ""

#. Occurrence 5B_5:1432:6933: scene=5B_5
#: 5B_5:1432
msgctxt "text_id=6933 | speaker=unknown"
msgid "　問題は―――"
msgstr ""

#. Occurrence 5B_5:1539:6934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0011; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1539
msgctxt "text_id=6934 | speaker=aoko"
msgid "“……問題は、どんな店を選ぶかってコト―――”"
msgstr ""

#. Occurrence 5B_5:1601:6935: scene=5B_5
#: 5B_5:1601
msgctxt "text_id=6935 | speaker=unknown"
msgid "　変貌する遊園地の特性を考慮する。"
msgstr ""

#. Occurrence 5B_5:1606:6936: scene=5B_5
#: 5B_5:1606
msgctxt "text_id=6936 | speaker=unknown"
msgid "　何が危険で、何が安全なのか。"
msgstr ""

#. Occurrence 5B_5:1611:6937: scene=5B_5
#: 5B_5:1611
msgctxt "text_id=6937 | speaker=unknown"
msgid "　大事なのは建物の強度や複雑さではなく―――"
msgstr ""

#. Occurrence 5B_5:1643:6938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0012; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1643
msgctxt "text_id=6938 | speaker=aoko"
msgid "“そうだ、選ぶなら<あ|・><の|・><単|・><純|・><さ|・>で正しいはず……！”"
msgstr ""

#. Occurrence 5B_5:1751:6939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0013; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1751
msgctxt "text_id=6939 | speaker=aoko"
msgid "「静希君、あっち！」"
msgstr ""

#. Occurrence 5B_5:1874:6940: scene=5B_5
#: 5B_5:1874
msgctxt "text_id=6940 | speaker=unknown"
msgid "　怪物たちを蹴散らしてカウンターに飛びこむ青子と、その後に続く草十郎。"
msgstr ""

#. Occurrence 5B_5:2045:6941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0014; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2045
msgctxt "text_id=6941 | speaker=aoko"
msgid "「カウンターに隠れてて！」"
msgstr ""

#. Occurrence 5B_5:2090:6942: scene=5B_5
#: 5B_5:2090
msgctxt "text_id=6942 | speaker=unknown"
msgid "　青子は西部劇の銃撃戦のように、カウンターを盾にして怪物たちと対峙する。"
msgstr ""

#. Occurrence 5B_5:2384:6943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0015; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2384
msgctxt "text_id=6943 | speaker=aoko"
msgid "「ビンゴ……！　ここならスナーク化しないんだ！」"
msgstr ""

#. Occurrence 5B_5:2390:6944: scene=5B_5
#: 5B_5:2390
msgctxt "text_id=6944 | speaker=unknown"
msgid "　敵の様子を確認し、青子もカウンター内部に腰を下ろした。"
msgstr ""

#. Occurrence 5B_5:2446:6945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0008; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2446
msgctxt "text_id=6945 | speaker=soujuurou"
msgid "「アイツらは……？」"
msgstr ""

#. Occurrence 5B_5:2457:6946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0016; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2457
msgctxt "text_id=6946 | speaker=aoko"
msgid "「店の周りで<地団駄|じだんだ>踏んでるわ。理由があってね、アイツらはここには入ってこられないのよ」"
msgstr ""

#. Occurrence 5B_5:2468:6947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0009; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2468
msgctxt "text_id=6947 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 5B_5:2537:6948: scene=5B_5
#: 5B_5:2537
msgctxt "text_id=6948 | speaker=unknown"
msgid "　不思議がる草十郎にまあまあと笑いかけて、青子は大きく胸を上下させた。"
msgstr ""

#. Occurrence 5B_5:2542:6949: scene=5B_5
#: 5B_5:2542
msgctxt "text_id=6949 | speaker=unknown"
msgid "　安堵と、おそらくは疲労からきた大きな息継ぎ。"
msgstr ""

#. Occurrence 5B_5:2632:6950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0017; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2632
msgctxt "text_id=6950 | speaker=aoko"
msgid "「とりあえずコーヒーブレイクね。ここは遊園地の中でも遊びのない場所だから、アイツらにとっては鬼門なのよ。"
msgstr ""

#. Occurrence 5B_5:2638:6951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0018; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2638
msgctxt "text_id=6951 | speaker=aoko"
msgid "　レジスターも調理道具も最近のものだし、擬人化されたマスコットもないし。スナーク化するには、ちょい文明圏すぎるってコト」"
msgstr ""

#. Occurrence 5B_5:2705:6952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0010; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2705
msgctxt "text_id=6952 | speaker=soujuurou"
msgid "「すなーく？」"
msgstr ""

#. Occurrence 5B_5:2752:6953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0019; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2752
msgctxt "text_id=6953 | speaker=aoko"
msgid "「アイツらの名前よ。つけたのは私じゃなくて有珠……なのかしらね。あの子の性格的にちょっと想像できないけど、まあ、とにかくそういう名前」"
msgstr ""

#. Occurrence 5B_5:2821:6954: scene=5B_5
#: 5B_5:2821
msgctxt "text_id=6954 | speaker=unknown"
msgid "　安全と分かって落ち着いたのか、草十郎は興味津々とばかりに耳を傾ける。"
msgstr ""

#. Occurrence 5B_5:2826:6955: scene=5B_5
#: 5B_5:2826
msgctxt "text_id=6955 | speaker=unknown"
msgid "　なるほど、なんてしかつめらしく頷いているが、きっと分かってないだろうなー、と青子はつい笑ってしまった。"
msgstr ""

#. Occurrence 5B_5:2831:6956: scene=5B_5
#: 5B_5:2831
msgctxt "text_id=6956 | speaker=unknown"
msgid "　普段ならイラっとくるところだが、今は彼の妙な真面目さがありがたく、あたたかい。"
msgstr ""

#. Occurrence 5B_5:2869:6957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0011; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2869
msgctxt "text_id=6957 | speaker=soujuurou"
msgid "「それはともかく。調子良さそうだな、蒼崎」"
msgstr ""

#. Occurrence 5B_5:2875:6958: scene=5B_5
#: 5B_5:2875
msgctxt "text_id=6958 | speaker=unknown"
msgid "　そんな青子の笑みを余裕と勘違いして、草十郎も顔をほころばす。"
msgstr ""

#. Occurrence 5B_5:2880:6959: scene=5B_5
#: 5B_5:2880
msgctxt "text_id=6959 | speaker=unknown"
msgid "　誤解の連鎖だが、今はそれを<糾|ただ>すこともない。"
msgstr ""

#. Occurrence 5B_5:2960:6960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6960 | speaker=aoko"
msgid "「あれ、貴方から見ても分かる？"
msgstr ""

#. Occurrence 5B_5:2960:6961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6961 | speaker=aoko"
msgid "　私の魔弾の威力が上がっているの」"
msgstr ""

#. Occurrence 5B_5:2993:6962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0012; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2993
msgctxt "text_id=6962 | speaker=soujuurou"
msgid "「そりゃあ、ミラーハウスでさんざん追いかけ回されたからな。あの時と同じ動作なのに物騒さが増していれば、イヤでも分かる」"
msgstr ""

#. Occurrence 5B_5:3019:6963: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0013; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3019
msgctxt "text_id=6963 | speaker=soujuurou"
msgid "「でもいいのか？　たしか、数にかぎりがあるとか言ってただろ。もうずいぶん撃っちまったけど。二十、三十じゃきかないぞ」"
msgstr ""

#. Occurrence 5B_5:3031:6964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0021; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3031
msgctxt "text_id=6964 | speaker=aoko"
msgid "「―――アンタ、時々、アレよね」"
msgstr ""

#. Occurrence 5B_5:3042:6965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0014; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3042
msgctxt "text_id=6965 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 5B_5:3047:6966: scene=5B_5
#: 5B_5:3047
msgctxt "text_id=6966 | speaker=unknown"
msgid "　不覚にも、ちょっと見直す青子だった。"
msgstr ""

#. Occurrence 5B_5:3074:6967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0022; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3074
msgctxt "text_id=6967 | speaker=aoko"
msgid "「なんでもない。"
msgstr ""

#. Occurrence 5B_5:3080:6968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0023; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3080
msgctxt "text_id=6968 | speaker=aoko"
msgid "　私の魔弾の威力が上がっているのは、単純に魔力の濃度の問題。さっきから霧がかかってるでしょ？　あれ、全部魔力なのよ。<魔|タ><弾|マ>を撃つための燃料と思って」"
msgstr ""

#. Occurrence 5B_5:3130:6969: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6969 | speaker=unknown"
msgid "　魔力とは大きく二種類あり、"
msgstr ""

#. Occurrence 5B_5:3130:6970: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6970 | speaker=unknown"
msgid "　魔術師が肉体から生成する<小源|オド>と、"
msgstr ""

msgctxt "text_id=6971 | speaker=unknown"
msgid "　大気に満ちている<大源|マナ>とがある。"
msgstr ""

#. Occurrence 5B_5:3137:6972: scene=5B_5
#: 5B_5:3137
msgctxt "text_id=6972 | speaker=unknown"
msgid "　この遊園地はいま、マナに満ちあふれた御伽の国だ。"
msgstr ""

#. Occurrence 5B_5:3142:6973: scene=5B_5
#: 5B_5:3142
msgctxt "text_id=6973 | speaker=unknown"
msgid "　一般人にとっては何の効果もないが、魔術師にとっては術式を使いたい放題の楽園と化している。"
msgstr ""

#. Occurrence 5B_5:3163:6974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0015; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3163
msgctxt "text_id=6974 | speaker=soujuurou"
msgid "「じゃあ残り魔力とやらは気にしなくていいのか。"
msgstr ""

#. Occurrence 5B_5:3169:6975: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0016; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3169
msgctxt "text_id=6975 | speaker=soujuurou"
msgid "　注意すべきは怪我と体力だけ？」"
msgstr ""

#. Occurrence 5B_5:3196:6976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0024; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3196
msgctxt "text_id=6976 | speaker=aoko"
msgid "「……まあ、個人的な責任においてはそのかぎりね」"
msgstr ""

#. Occurrence 5B_5:3221:6977: scene=5B_5
#: 5B_5:3221
msgctxt "text_id=6977 | speaker=unknown"
msgid "　良かった、と息をつく草十郎。"
msgstr ""

#. Occurrence 5B_5:3226:6978: scene=5B_5
#: 5B_5:3226
msgctxt "text_id=6978 | speaker=unknown"
msgid "　草十郎から見れば、青子は怪物たちをなぎ払う遊園地最強の暴れん坊だ。"
msgstr ""

#. Occurrence 5B_5:3231:6979: scene=5B_5
#: 5B_5:3231
msgctxt "text_id=6979 | speaker=unknown"
msgid "　不安なのは魔力が尽きる事だったが、それがないのであればまさに百人力である。"
msgstr ""

#. Occurrence 5B_5:3311:6980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0025; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3311
msgctxt "text_id=6980 | speaker=aoko"
msgid "「頼りにしてくれるのは嬉しいけど、ぬか喜びよ。"
msgstr ""

#. Occurrence 5B_5:3318:6981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0026; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3318
msgctxt "text_id=6981 | speaker=aoko"
msgid "あんな雑魚たち、ただ動いているだけのガラクタなんだから。"
msgstr ""

#. Occurrence 5B_5:3324:6982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0027; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3324
msgctxt "text_id=6982 | speaker=aoko"
msgid "　スナーク本体は当然として、有珠が<他|・><の|・><童|・><話|・><の|・><怪|・><物|・>を出してきたら私じゃどうにもならない」"
msgstr ""

#. Occurrence 5B_5:3361:6983: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0017; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3361
msgctxt "text_id=6983 | speaker=soujuurou"
msgid "「他の童話の怪物？　……遊園地をこんなふうに変えたヤツ以外に、まだいるのか？」"
msgstr ""

#. Occurrence 5B_5:3398:6984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0028; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3398
msgctxt "text_id=6984 | speaker=aoko"
msgid "「そ。プロイキッシャーって名付けられた、<魔術師|わたしたち>でさえ目を背けたくなる反則。"
msgstr ""

#. Occurrence 5B_5:3405:6985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0029; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3405
msgctxt "text_id=6985 | speaker=aoko"
msgid "不可能な夢物語をも再現する、時代に取り残されたデタラメよ」"
msgstr ""

#. Occurrence 5B_5:3460:6986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0018; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3460
msgctxt "text_id=6986 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 5B_5:3465:6987: scene=5B_5
#: 5B_5:3465
msgctxt "text_id=6987 | speaker=unknown"
msgid "　自分の事は棚にあげて？　と言いたげな顔である。"
msgstr ""

#. Occurrence 5B_5:3545:6988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0030; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3545
msgctxt "text_id=6988 | speaker=aoko"
msgid "「あのね、私たちはちゃんと現代によりそった魔術師よ。"
msgstr ""

#. Occurrence 5B_5:3557:6989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0031; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3557
msgctxt "text_id=6989 | speaker=aoko"
msgid "　できない事もあるし、当たり前の事だけど、近代兵器には敵わない。二十世紀―――ま、色んな戦争の後押しで、兵器の進化は私たちを越えちゃったから」"
msgstr ""

#. Occurrence 5B_5:3584:6990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0032; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3584
msgctxt "text_id=6990 | speaker=aoko"
msgid "「……けどあの子のは違う。どんなに人間の技術が進歩しようと関係ないって怪物なの。"
msgstr ""

#. Occurrence 5B_5:3597:6991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0033; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3597
msgctxt "text_id=6991 | speaker=aoko"
msgid "　たとえば、あのブレッドマンいるでしょ？"
msgstr ""

#. Occurrence 5B_5:3603:6992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0034; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3603
msgctxt "text_id=6992 | speaker=aoko"
msgid "　あいつには自動拳銃とかきかないわよ。たぶん、意味が分かっていないから」"
msgstr ""

#. Occurrence 5B_5:3608:6993: scene=5B_5
#: 5B_5:3608
msgctxt "text_id=6993 | speaker=unknown"
msgid "　ひょい、とカウンターから外を指す青子。"
msgstr ""

#. Occurrence 5B_5:3687:6994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0035; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3687
msgctxt "text_id=6994 | speaker=aoko"
msgid "「有珠の使い魔は全てが空想によってこねられた神秘なの。"
msgstr ""

#. Occurrence 5B_5:3693:6995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0036; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3693
msgctxt "text_id=6995 | speaker=aoko"
msgid "　前提からしてあり得ない事だから、通常の物理法則と折り合いが悪い。空想と現実は両立しないっていう、ごく当たり前の理由でね」"
msgstr ""

#. Occurrence 5B_5:3759:6996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0019; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3759
msgctxt "text_id=6996 | speaker=soujuurou"
msgid "「……なるほど。ブレッドマンってのは、あの動く焼きたてパンの事なんだな」"
msgstr ""

#. Occurrence 5B_5:3764:6997: scene=5B_5
#: 5B_5:3764
msgctxt "text_id=6997 | speaker=unknown"
msgid "　青子の説明の大部分をスルーして、気になるコトだけ拾う草十郎だった。"
msgstr ""

#. Occurrence 5B_5:3847:6998: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0037; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3847
msgctxt "text_id=6998 | speaker=aoko"
msgid "「…………話を戻すけど。"
msgstr ""

#. Occurrence 5B_5:3853:6999: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0038; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3853
msgctxt "text_id=6999 | speaker=aoko"
msgid "　あいつらと近代兵器の相性は最悪。ロケット弾でも効果はないわ。意思の疎通、秩序の共有ができてないから」"
msgstr ""

#. Occurrence 5B_5:3882:7000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0039; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3882
msgctxt "text_id=7000 | speaker=aoko"
msgid "「<童話の怪物|プロイキッシャー>にとって、彼らの世界には存在しないもの、意味が分からないモノは、触れるコトなく霧散する。"
msgstr ""

#. Occurrence 5B_5:3895:7001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0040; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3895
msgctxt "text_id=7001 | speaker=aoko"
msgid "　彼らに<通|つう>じるのは同じ神秘を帯びた“魔力”だけっていうデタラメぶりよ。もう完全に<概念|がいねん>空間っていうか、概念宇宙っていうか―――」"
msgstr ""

#. Occurrence 5B_5:3963:7002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0020; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3963
msgctxt "text_id=7002 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_5:4011:7003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0041; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4011
msgctxt "text_id=7003 | speaker=aoko"
msgid "「…………こほん。"
msgstr ""

#. Occurrence 5B_5:4023:7004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0042; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4023
msgctxt "text_id=7004 | speaker=aoko"
msgid "　要するに、アイツらは伝承防御っていう特別なルールを持っていて、単純に強い力、強い魔術じゃ効果は薄いの。元になった童話にちなんだ欠点をつかないと倒せない。"
msgstr ""

#. Occurrence 5B_5:4035:7005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0043; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4035
msgctxt "text_id=7005 | speaker=aoko"
msgid "　ギリシャ神話のアキレスあたり分かりやすい喩えなんだけど……知ってる？」"
msgstr ""

#. Occurrence 5B_5:4040:7006: scene=5B_5
#: 5B_5:4040
msgctxt "text_id=7006 | speaker=unknown"
msgid "　草十郎はぶんぶんと首を振る。"
msgstr ""

#. Occurrence 5B_5:4067:7007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7007 | speaker=aoko"
msgid "「そ。無事帰れたら、鳶丸あたりに教えてもらって。"
msgstr ""

#. Occurrence 5B_5:4067:7008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7008 | speaker=aoko"
msgid "　定番だけどいい<教訓|はなし>よ、アレ」"
msgstr ""

#. Occurrence 5B_5:4078:7009: scene=5B_5
#: 5B_5:4078
msgctxt "text_id=7009 | speaker=unknown"
msgid "　……かなりおいてけぼり感ただよう草十郎だが、彼は彼なりに現状把握に努めてみた。"
msgstr ""

#. Occurrence 5B_5:4098:7010: scene=5B_5
#: 5B_5:4098
msgctxt "text_id=7010 | speaker=unknown"
msgid "“<童話の怪物|プロイキッシャー>”とやらは、青子やミラーハウスの自動人形ですら<裸足|はだし>で逃げだすモノだという。"
msgstr ""

#. Occurrence 5B_5:4151:7011: scene=5B_5
#: 5B_5:4151
msgctxt "text_id=7011 | speaker=unknown"
msgid "　たしかに目の前の光景は誰かの悪夢の中に迷いこんだとしか思えない。"
msgstr ""

#. Occurrence 5B_5:4229:7012: scene=5B_5
#: 5B_5:4229
msgctxt "text_id=7012 | speaker=unknown"
msgid "　だがしかし、と草十郎は思うのだ。"
msgstr ""

#. Occurrence 5B_5:4267:7013: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0021; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4267
msgctxt "text_id=7013 | speaker=soujuurou"
msgid "「やっぱり、蒼崎の方が怖くないか？」"
msgstr ""

#. Occurrence 5B_5:4345:7014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0045; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4345
msgctxt "text_id=7014 | speaker=aoko"
msgid "「アンタ死ぬの？」"
msgstr ""

#. Occurrence 5B_5:4351:7015: scene=5B_5
#: 5B_5:4351
msgctxt "text_id=7015 | speaker=unknown"
msgid "　ほら、と無言の抗議をする草十郎。"
msgstr ""

#. Occurrence 5B_5:4393:7016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0046; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4393
msgctxt "text_id=7016 | speaker=aoko"
msgid "「……あのね。いま私たちを取り囲んでるのはオマケにすぎないの。"
msgstr ""

#. Occurrence 5B_5:4399:7017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0047; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4399
msgctxt "text_id=7017 | speaker=aoko"
msgid "　有珠にとって、あのブレッドマンもロブスターもソーセージ屋のミンチマシーンも、全部が全部、私が撃ってる魔弾より価値がない。"
msgstr ""

#. Occurrence 5B_5:4411:7018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0048; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4411
msgctxt "text_id=7018 | speaker=aoko"
msgid "　いい？　あの動くマスコットたちはね、<た|・><だ|・><の|・><オ|・><マ|・><ケ|・>なの。有珠が解放した“童話の怪物”の、一呼吸みたいなものなのよ」"
msgstr ""

#. Occurrence 5B_5:4437:7019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0022; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4437
msgctxt "text_id=7019 | speaker=soujuurou"
msgid "「―――呼吸って、これが？」"
msgstr ""

#. Occurrence 5B_5:4449:7020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0049; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4449
msgctxt "text_id=7020 | speaker=aoko"
msgid "「……私だって考えたくないわよ。"
msgstr ""

#. Occurrence 5B_5:4455:7021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0050; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4455
msgctxt "text_id=7021 | speaker=aoko"
msgid "　でもそれが現状。たった一体の“童話の怪物”だけで私たちは手一杯。"
msgstr ""

#. Occurrence 5B_5:4462:7022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0051; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4462
msgctxt "text_id=7022 | speaker=aoko"
msgid "そういう訳だから、有珠があと一体でも追加したら諦めて」"
msgstr ""

#. Occurrence 5B_5:4499:7023: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0023; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4499
msgctxt "text_id=7023 | speaker=soujuurou"
msgid "「追加って……これに制限はないのか？」"
msgstr ""

#. Occurrence 5B_5:4505:7024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0052; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4505
msgctxt "text_id=7024 | speaker=aoko"
msgid "「あの子が出し惜しみしなければ、まだ何体かストックはあるでしょうけど……ま、成立する条件はあるわね。"
msgstr ""

#. Occurrence 5B_5:4511:7025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0053; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4511
msgctxt "text_id=7025 | speaker=aoko"
msgid "　たとえば川がないと目を覚まさない怪物もいる。この遊園地、噴水はあるけど川はないでしょ？　元になった童話しばりなの、あの子の使い魔は」"
msgstr ""

#. Occurrence 5B_5:4532:7026: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0024; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4532
msgctxt "text_id=7026 | speaker=soujuurou"
msgid "「童話って、かけそばとか？」"
msgstr ""

#. Occurrence 5B_5:4552:7027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0054; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4552
msgctxt "text_id=7027 | speaker=aoko"
msgid "「<遊園地|ここ>に川がないのは不幸中の幸いね。もしあったら、もっと直接制圧に向いた奴が出てきてた」"
msgstr ""

#. Occurrence 5B_5:4558:7028: scene=5B_5
#: 5B_5:4558
msgctxt "text_id=7028 | speaker=unknown"
msgid "　草十郎の合いの手をサラッと無視する青子だった。"
msgstr ""

#. Occurrence 5B_5:4625:7029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0055; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4625
msgctxt "text_id=7029 | speaker=aoko"
msgid "「―――話の続きだけど。"
msgstr ""

#. Occurrence 5B_5:4632:7030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_0; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4632
msgctxt "text_id=7030 | speaker=aoko"
msgid "　有珠の魔術の基本はマザーグース……"
msgstr ""

#. Occurrence 5B_5:4645:7031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_1; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4645
msgctxt "text_id=7031 | speaker=aoko"
msgid "って知らないか。イギリスの唄で、遊び心にとんだ、メルヘンチックな内容よ。"
msgstr ""

#. Occurrence 5B_5:4651:7032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0057; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4651
msgctxt "text_id=7032 | speaker=aoko"
msgid "　ただ、そっち系のプロイキッシャーは怖くないの。"
msgstr ""

#. Occurrence 5B_5:4658:7033: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0058; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4658
msgctxt "text_id=7033 | speaker=aoko"
msgid "みんなそれなりに、なんとか魔術にも落としこめる範囲だから」"
msgstr ""

#. Occurrence 5B_5:4725:7034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0025; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4725
msgctxt "text_id=7034 | speaker=soujuurou"
msgid "「……聞きたくないんだけど、そっち系じゃないのは？」"
msgstr ""

#. Occurrence 5B_5:4828:7035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0059; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4828
msgctxt "text_id=7035 | speaker=aoko"
msgid "「マザーグースを下地にした、とある創作童話系。"
msgstr ""

#. Occurrence 5B_5:4834:7036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0060; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4834
msgctxt "text_id=7036 | speaker=aoko"
msgid "　……<有珠|あの子>のお母さんが好きでね、<こ|・><っ|・><ち|・><系|・>のはドイツもコイツも尋常じゃない。<魔術師|わたしたち>から見ても勘弁してって言いたくなるわ」"
msgstr ""

#. Occurrence 5B_5:4857:7037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0061; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4857
msgctxt "text_id=7037 | speaker=aoko"
msgid "「で、この遊園地を生き返らせたのは<こ|・><っ|・><ち|・><系|・>よ。"
msgstr ""

#. Occurrence 5B_5:4863:7038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0062; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4863
msgctxt "text_id=7038 | speaker=aoko"
msgid "　たぶんフラットスナークってヤツだと思う。……私も聞き流していたから、詳しくは分からないけど」"
msgstr ""

#. Occurrence 5B_5:4918:7039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0026; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4918
msgctxt "text_id=7039 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_5:4924:7040: scene=5B_5
#: 5B_5:4924
msgctxt "text_id=7040 | speaker=unknown"
msgid "　のど元まで出た不満を飲みこむ。"
msgstr ""

#. Occurrence 5B_5:4929:7041: scene=5B_5
#: 5B_5:4929
msgctxt "text_id=7041 | speaker=unknown"
msgid "　こっち系とかそっち系とか曖昧な言い方はやめてほしい草十郎だったが、今の台詞には、他に追及すべき事があったからだ。"
msgstr ""

#. Occurrence 5B_5:4955:7042: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0027; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4955
msgctxt "text_id=7042 | speaker=soujuurou"
msgid "「待て蒼崎。あの子の話を聞き流したって、なんで」"
msgstr ""

#. Occurrence 5B_5:4975:7043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0063; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4975
msgctxt "text_id=7043 | speaker=aoko"
msgid "「いやぁ、説明してもらったのは随分と前だし……あの頃は有珠の話、あんまり信じられなかったのよね。"
msgstr ""

#. Occurrence 5B_5:4981:7044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0064; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4981
msgctxt "text_id=7044 | speaker=aoko"
msgid "　私が素人だと思って大げさに自分の魔術を語ってくれてるなあ、舐められてるなあ、とか。あはは」"
msgstr ""

#. Occurrence 5B_5:5024:7045: scene=5B_5
#: 5B_5:5024
msgctxt "text_id=7045 | speaker=unknown"
msgid "　無論、舐めていたのは青子の方だった。"
msgstr ""

#. Occurrence 5B_5:5029:7046: scene=5B_5
#: 5B_5:5029
msgctxt "text_id=7046 | speaker=unknown"
msgid "　有珠を守る怪物が「本物」だと青子が経験するのは、二人が出会ってからしばらくしての事だ。"
msgstr ""

#. Occurrence 5B_5:5034:7047: scene=5B_5
#: 5B_5:5034
msgctxt "text_id=7047 | speaker=unknown"
msgid "　マインスターの魔女が魔術世界においてどれほど異端なのか、青子は身をもって経験する事になる。"
msgstr ""

#. Occurrence 5B_5:5071:7048: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0028; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5071
msgctxt "text_id=7048 | speaker=soujuurou"
msgid "「……その聞き流した内容は？」"
msgstr ""

#. Occurrence 5B_5:5083:7049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0065; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5083
msgctxt "text_id=7049 | speaker=aoko"
msgid "「なんでも強力な結界を張るプロイだって。"
msgstr ""

#. Occurrence 5B_5:5090:7050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0066; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5090
msgctxt "text_id=7050 | speaker=aoko"
msgid "有珠が受け継いだ<玩具|プロイ>は山ほどあるけど、その中でも<選|え>りすぐりの一つよ。"
msgstr ""

#. Occurrence 5B_5:5096:7051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0067; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5096
msgctxt "text_id=7051 | speaker=aoko"
msgid "　<棄|す>てられたモノ、忘れられたモノを童話的に蘇らせるヤツで、今まで誰も破ったコトがないとか。"
msgstr ""

#. Occurrence 5B_5:5149:7052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0068; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5149
msgctxt "text_id=7052 | speaker=aoko"
msgid "　それで、ついたあだ名が“<触|ふ>れられぬもの”」"
msgstr ""

#. Occurrence 5B_5:5170:7053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0029; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5170
msgctxt "text_id=7053 | speaker=soujuurou"
msgid "「？　ふらっとすなーく、じゃないのか？」"
msgstr ""

#. Occurrence 5B_5:5183:7054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0069; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5183
msgctxt "text_id=7054 | speaker=aoko"
msgid "「それもあだ名。とにかく正体が分からないヤツばっかりなんで、一つの個体に複数の名前がつけられるの。"
msgstr ""

#. Occurrence 5B_5:5189:7055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0070; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5189
msgctxt "text_id=7055 | speaker=aoko"
msgid "　フラットスナークはその中でも、正体不明さはトップランクのデタラメぶりよ。"
msgstr ""

#. Occurrence 5B_5:5202:7056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0071; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5202
msgctxt "text_id=7056 | speaker=aoko"
msgid "　―――貴方、ルイス・キャロルの『スナーク狩り』って本、知ってる？」"
msgstr ""

#. Occurrence 5B_5:5251:7057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0030; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5251
msgctxt "text_id=7057 | speaker=soujuurou"
msgid "「いや。そもそもルイスキャロルというのは？」"
msgstr ""

#. Occurrence 5B_5:5263:7058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0072; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5263
msgctxt "text_id=7058 | speaker=aoko"
msgid "「……そっからかあ……えーと、ドジスン教授は、そうね。特殊性癖を持った妄想紳士ってトコ？　ま、こっちは別にどうでもいいか。人によっては時間の無駄だろうし」"
msgstr ""

#. Occurrence 5B_5:5289:7059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0073; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5289
msgctxt "text_id=7059 | speaker=aoko"
msgid "「いま重要なのは、彼が残した著作の方。"
msgstr ""

#. Occurrence 5B_5:5295:7060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0074; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5295
msgctxt "text_id=7060 | speaker=aoko"
msgid "　『スナーク狩り』はね、スナークって呼ばれる正体不明の怪物を捕まえようと奔走する冒険家たちの話なの」"
msgstr ""

#. Occurrence 5B_5:5358:7061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0075; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5358
msgctxt "text_id=7061 | speaker=aoko"
msgid "「キャロルらしい、皮肉ばっちり、支離滅裂、意味不明、結末不在のホントに困った本で、一行は島で苦しみつつ、最終的にはスナークを見つけるものの、見つけた<主人公|ベイカー>は唐突に姿を消して終わってしまう。"
msgstr ""

#. Occurrence 5B_5:5364:7062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0076; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5364
msgctxt "text_id=7062 | speaker=aoko"
msgid "“よく分からないもの”探しに奔走する人間の風刺なんだけど―――この遊園地において、誰が<主人公|ベイカー>で、何が<怪物|スナーク>かは言うまでもないでしょ？」"
msgstr ""

#. Occurrence 5B_5:5391:7063: scene=5B_5
#: 5B_5:5391
msgctxt "text_id=7063 | speaker=unknown"
msgid "　青子は語らないが、フラットスナークには他にも俗称がある。"
msgstr ""

#. Occurrence 5B_5:5396:7064: scene=5B_5
#: 5B_5:5396
msgctxt "text_id=7064 | speaker=unknown"
msgid "　不可解の島、五次元平面。"
msgstr ""

#. Occurrence 5B_5:5401:7065: scene=5B_5
#: 5B_5:5401
msgctxt "text_id=7065 | speaker=unknown"
msgid "　こちらは有珠が口にしたものではなく、かつてマインスターに破れた魔術師たちのうわごとだ。"
msgstr ""

#. Occurrence 5B_5:5464:7066: scene=5B_5
#: 5B_5:5464
msgctxt "text_id=7066 | speaker=unknown"
msgid "　数学において、スナークとはグラフ理論で用いられる、矛盾した、決してあり得ないある平面グラフを指す。"
msgstr ""

#. Occurrence 5B_5:5469:7067: scene=5B_5
#: 5B_5:5469
msgctxt "text_id=7067 | speaker=unknown"
msgid "　この世に『無い』と立証されながらも名を与えられた平面。逆説のみで構成された不遇の存在。"
msgstr ""

#. Occurrence 5B_5:5474:7068: scene=5B_5
#: 5B_5:5474
msgctxt "text_id=7068 | speaker=unknown"
msgid "　その名を冠した“童話の怪物”は、誰にも正体を明かす事がないという。"
msgstr ""

#. Occurrence 5B_5:5495:7069: scene=5B_5
#: 5B_5:5495
msgctxt "text_id=7069 | speaker=unknown"
msgid "　……そして、青子は語らない。"
msgstr ""

#. Occurrence 5B_5:5500:7070: scene=5B_5
#: 5B_5:5500
msgctxt "text_id=7070 | speaker=unknown"
msgid "　フラットスナークは成長する“童話の怪物”だ。"
msgstr ""

#. Occurrence 5B_5:5505:7071: scene=5B_5
#: 5B_5:5505
msgctxt "text_id=7071 | speaker=unknown"
msgid "　どこかに隠れている本体は、こうしている今も遊園地を完全な御伽の国に変えようと、<魔|い><力|き>を吐き続けている事を。"
msgstr ""

#. Occurrence 5B_5:5586:7072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0077; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5586
msgctxt "text_id=7072 | speaker=aoko"
msgid "「……ま、<脅|おど>かしてもしょうがないし」"
msgstr ""

#. Occurrence 5B_5:5619:7073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0031; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5619
msgctxt "text_id=7073 | speaker=soujuurou"
msgid "「なにか言ったか？」"
msgstr ""

#. Occurrence 5B_5:5630:7074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0078; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5630
msgctxt "text_id=7074 | speaker=aoko"
msgid "「別に。簡単に言って、『童話世界の再生』がフラットスナークの力なの。"
msgstr ""

#. Occurrence 5B_5:5636:7075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0079; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5636
msgctxt "text_id=7075 | speaker=aoko"
msgid "　この遊園地との相性は抜群でしょうね。なにしろ、元々が童話を元にした遊び場だから」"
msgstr ""

#. Occurrence 5B_5:5664:7076: scene=5B_5
#: 5B_5:5664
msgctxt "text_id=7076 | speaker=unknown"
msgid "　……仮にオフィス街であったのなら、フラットスナークもここまでの脅威は持たなかっただろう。"
msgstr ""

#. Occurrence 5B_5:5669:7077: scene=5B_5
#: 5B_5:5669
msgctxt "text_id=7077 | speaker=unknown"
msgid "　せいぜいビルの窓硝子に恐竜の影絵を映す程度の力だ。"
msgstr ""

#. Occurrence 5B_5:5702:7078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0032; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5702
msgctxt "text_id=7078 | speaker=soujuurou"
msgid "「あ。だからここは安全だって―――"
msgstr ""

msgctxt "text_id=7079 | speaker=unknown"
msgid "ん？」"
msgstr ""

#. Occurrence 5B_5:5724:7080: scene=5B_5
#: 5B_5:5724
msgctxt "text_id=7080 | speaker=unknown"
msgid "　草十郎が“その異変”に気が付いたのは、背中にぴちょん、と<粘|ねば>つく液体が落ちたからだ。"
msgstr ""

#. Occurrence 5B_5:5795:7081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0033; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5795
msgctxt "text_id=7081 | speaker=soujuurou"
msgid "「あ、あ―――」"
msgstr ""

#. Occurrence 5B_5:5800:7082: scene=5B_5
#: 5B_5:5800
msgctxt "text_id=7082 | speaker=unknown"
msgid "　天井を見上げる。"
msgstr ""

#. Occurrence 5B_5:5806:7083: scene=5B_5
#: 5B_5:5806
msgctxt "text_id=7083 | speaker=unknown"
msgid "<ソ|・><レ|・>と目が合う。"
msgstr ""

#. Occurrence 5B_5:5812:7084: scene=5B_5
#: 5B_5:5812
msgctxt "text_id=7084 | speaker=unknown"
msgid "どうなっているのか考える前に、草十郎の腰は跳ね上がって―――"
msgstr ""

#. Occurrence 5B_5:5857:7085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0034; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5857
msgctxt "text_id=7085 | speaker=soujuurou"
msgid "「蒼崎、外だ！」"
msgstr ""

#. Occurrence 5B_5:5863:7086: scene=5B_5
#: 5B_5:5863
msgctxt "text_id=7086 | speaker=unknown"
msgid "　彼は<率先|そっせん>してカウンターから飛び出した。"
msgstr ""

#. Occurrence 5B_5:5901:7087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0080; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5901
msgctxt "text_id=7087 | speaker=aoko"
msgid "「バカ、何して―――」"
msgstr ""

#. Occurrence 5B_5:5921:7088: scene=5B_5
#: 5B_5:5921
msgctxt "text_id=7088 | speaker=unknown"
msgid "　自殺行為に等しい愚行を止めようと、つられて青子は腰を浮かす。"
msgstr ""

#. Occurrence 5B_5:5926:7089: scene=5B_5
#: 5B_5:5926
msgctxt "text_id=7089 | speaker=unknown"
msgid "　瞬間、頭上に何が生まれているのかに気が付いた。"
msgstr ""

#. Occurrence 5B_5:5994:7090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0081; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5994
msgctxt "text_id=7090 | speaker=aoko"
msgid "「！　って、ヤバ―――!?」"
msgstr ""

#. Occurrence 5B_5:6225:7091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0082; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6225
msgctxt "text_id=7091 | speaker=aoko"
msgid "「あ、危なかったぁ……！」"
msgstr ""

#. Occurrence 5B_5:6242:7092: scene=5B_5
#: 5B_5:6242
msgctxt "text_id=7092 | speaker=unknown"
msgid "　ばくん、と閉じられる巨大な口。"
msgstr ""

#. Occurrence 5B_5:6247:7093: scene=5B_5
#: 5B_5:6247
msgctxt "text_id=7093 | speaker=unknown"
msgid "　呼びこみマスコットのいないバーガーショップは、その店ごと怪物に変貌していた。"
msgstr ""

#. Occurrence 5B_5:6322:7094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0083; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6322
msgctxt "text_id=7094 | speaker=aoko"
msgid "「もうっ、なんで天井にピエロの絵なんて描いてんのよあの店！？"
msgstr ""

#. Occurrence 5B_5:6329:7095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0084; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6329
msgctxt "text_id=7095 | speaker=aoko"
msgid "　普通、もっと違うところに労力さかない！？　そんなにピエロが好きなら入り口にでも飾っとけ！」"
msgstr ""

#. Occurrence 5B_5:6335:7096: scene=5B_5
#: 5B_5:6335
msgctxt "text_id=7096 | speaker=unknown"
msgid "　罵倒しながら走る青子。"
msgstr ""

#. Occurrence 5B_5:6340:7097: scene=5B_5
#: 5B_5:6340
msgctxt "text_id=7097 | speaker=unknown"
msgid "　……もう安全な場所はどこにもない。"
msgstr ""

#. Occurrence 5B_5:6345:7098: scene=5B_5
#: 5B_5:6345
msgctxt "text_id=7098 | speaker=unknown"
msgid "　かろうじて残っていた文明圏すら、刻一刻と童話に侵食されていた。"
msgstr ""

#. Occurrence 5B_6:310:7099: scene=5B_6
#: 5B_6:310
msgctxt "text_id=7099 | speaker=unknown"
msgid "　遊園地のスナーク化は最終段階を迎えていた。"
msgstr ""

#. Occurrence 5B_6:315:7100: scene=5B_6
#: 5B_6:315
msgctxt "text_id=7100 | speaker=unknown"
msgid "　命を与えられたのはマスコットたちだけではない。"
msgstr ""

#. Occurrence 5B_6:320:7101: scene=5B_6
#: 5B_6:320
msgctxt "text_id=7101 | speaker=unknown"
msgid "　バーガーショップのように、建物すら生き物に変貌しようとしている。"
msgstr ""

#. Occurrence 5B_6:325:7102: scene=5B_6
#: 5B_6:325
msgctxt "text_id=7102 | speaker=unknown"
msgid "　遊園地を巡るコースターは<中華龍|チャイニーズドラゴン>よろしく、うねうねとのたうつ始末。"
msgstr ""

#. Occurrence 5B_6:433:7103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0000; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:433
msgctxt "text_id=7103 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 5B_6:506:7104: scene=5B_6
#: 5B_6:506
msgctxt "text_id=7104 | speaker=unknown"
msgid "　呆然と、全長八十メートル近くまで膨張した観覧車を見上げる青子と草十郎。"
msgstr ""

#. Occurrence 5B_6:511:7105: scene=5B_6
#: 5B_6:511
msgctxt "text_id=7105 | speaker=unknown"
msgid "　そんなふたりにチケットを配るように、大量のブレッドマンが襲いかかる。"
msgstr ""

#. Occurrence 5B_6:605:7106: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0001; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:605
msgctxt "text_id=7106 | speaker=aoko"
msgid "「このっ、列整理は間に合ってるっての！」"
msgstr ""

#. Occurrence 5B_6:685:7107: scene=5B_6
#: 5B_6:685
msgctxt "text_id=7107 | speaker=unknown"
msgid "　わらわらと大挙するオブジェ。"
msgstr ""

#. Occurrence 5B_6:690:7108: scene=5B_6
#: 5B_6:690
msgctxt "text_id=7108 | speaker=unknown"
msgid "　包囲網は破っても破っても形成される。"
msgstr ""

#. Occurrence 5B_6:695:7109: scene=5B_6
#: 5B_6:695
msgctxt "text_id=7109 | speaker=unknown"
msgid "　絶え間ない物量作戦。"
msgstr ""

#. Occurrence 5B_6:701:7110: scene=5B_6
#: 5B_6:701
msgctxt "text_id=7110 | speaker=unknown"
msgid "さもありなん、資源の<枯渇|こかつ>で悩むおとぎ<噺|ばなし>は<滅多|めった>にない……！"
msgstr ""

#. Occurrence 5B_6:785:7111: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7111 | speaker=soujuurou"
msgid "「っ、なんかどうしようもないぞ！"
msgstr ""

#. Occurrence 5B_6:785:7112: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7112 | speaker=soujuurou"
msgid "　コイツら、増える一方だ！」"
msgstr ""

#. Occurrence 5B_6:853:7113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0002; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:853
msgctxt "text_id=7113 | speaker=aoko"
msgid "「スナーク本体を探して！"
msgstr ""

#. Occurrence 5B_6:859:7114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0003; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:859
msgctxt "text_id=7114 | speaker=aoko"
msgid "　童話の怪物には本体にあたる器物があるの！　それさえ壊せば遊園地から出られるはず！」"
msgstr ""

#. Occurrence 5B_6:1023:7115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0001; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1023
msgctxt "text_id=7115 | speaker=soujuurou"
msgid "「本体ってどんな!?」"
msgstr ""

#. Occurrence 5B_6:1135:7116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0004; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1135
msgctxt "text_id=7116 | speaker=aoko"
msgid "「さっき言ったでしょ、童話の怪物は現実に無いものだって！　今までいなかったおかしなヤツとか、現実じゃありえないモノ！　それが本体！」"
msgstr ""

#. Occurrence 5B_6:1189:7117: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0002; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1189
msgctxt "text_id=7117 | speaker=soujuurou"
msgid "「おかしなヤツって、たとえば!?」"
msgstr ""

#. Occurrence 5B_6:1325:7118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0005; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1325
msgctxt "text_id=7118 | speaker=aoko"
msgid "「だから！"
msgstr ""

#. Occurrence 5B_6:1331:7119: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0006; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1331
msgctxt "text_id=7119 | speaker=aoko"
msgid "　命のある人形とか、空飛ぶゴーカートとか―――」"
msgstr ""

#. Occurrence 5B_6:1373:7120: scene=5B_6
#: 5B_6:1373
msgctxt "text_id=7120 | speaker=unknown"
msgid "　魔弾を放つ青子の手が止まる。"
msgstr ""

#. Occurrence 5B_6:1378:7121: scene=5B_6
#: 5B_6:1378
msgctxt "text_id=7121 | speaker=unknown"
msgid "　口にして、自分たちがどれほど<窮|きわ>まっているかを思い知ったのだ。"
msgstr ""

#. Occurrence 5B_6:1383:7122: scene=5B_6
#: 5B_6:1383
msgctxt "text_id=7122 | speaker=unknown"
msgid "　遊園地は“童話の怪物”と思われるモノであふれている。"
msgstr ""

#. Occurrence 5B_6:1388:7123: scene=5B_6
#: 5B_6:1388
msgctxt "text_id=7123 | speaker=unknown"
msgid "　変形し、自ら動き出したオブジェたちはみな“現実にないモノ”なのだ。"
msgstr ""

#. Occurrence 5B_6:1478:7124: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0007; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1478
msgctxt "text_id=7124 | speaker=aoko"
msgid "「……そっか。おかしくないヤツなんて、一つもないんだ」"
msgstr ""

#. Occurrence 5B_6:1537:7125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0008; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1537
msgctxt "text_id=7125 | speaker=aoko"
msgid "“この中に紛れこんでる……？”"
msgstr ""

#. Occurrence 5B_6:1553:7126: scene=5B_6
#: 5B_6:1553
msgctxt "text_id=7126 | speaker=unknown"
msgid "　青子は呟きながら、それはないな、と唇を噛んだ。"
msgstr ""

#. Occurrence 5B_6:1573:7127: scene=5B_6
#: 5B_6:1573
msgctxt "text_id=7127 | speaker=unknown"
msgid "　フラットスナークは結界を張るタイプの<怪物|プロイ>だ。"
msgstr ""

#. Occurrence 5B_6:1578:7128: scene=5B_6
#: 5B_6:1578
msgctxt "text_id=7128 | speaker=unknown"
msgid "　これだけ大量の使い魔を統率している以上、本体の防御力は低いか、もしくは<皆無|かいむ>と見るべきだろう。"
msgstr ""

#. Occurrence 5B_6:1584:7129: scene=5B_6
#: 5B_6:1584
msgctxt "text_id=7129 | speaker=unknown"
msgid "　……加えて、“触れられぬもの”“正体不明”という物語を原型としているのなら、見抜かれたが最後、呆気なく崩壊するのが筋というもの。"
msgstr ""

#. Occurrence 5B_6:1623:7130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0009; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1623
msgctxt "text_id=7130 | speaker=aoko"
msgid "“……逆に言えば、見つければ私たちの勝ち。"
msgstr ""

#. Occurrence 5B_6:1629:7131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0010; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1629
msgctxt "text_id=7131 | speaker=aoko"
msgid "　そんな<脆|もろ>いヤツが雑魚に紛れこむ？　木の葉を隠すなら森の中って言うけど―――”"
msgstr ""

#. Occurrence 5B_6:1758:7132: scene=5B_6
#: 5B_6:1758
msgctxt "text_id=7132 | speaker=unknown"
msgid "　この通り。"
msgstr ""

#. Occurrence 5B_6:1763:7133: scene=5B_6
#: 5B_6:1763
msgctxt "text_id=7133 | speaker=unknown"
msgid "　流れ弾であっさり吹き飛ぶ可能性がある以上、青子たちの前には現れない。"
msgstr ""

#. Occurrence 5B_6:1768:7134: scene=5B_6
#: 5B_6:1768
msgctxt "text_id=7134 | speaker=unknown"
msgid "　スナーク本体はもっと安全な場所で、この遊園地を育てている。"
msgstr ""

#. Occurrence 5B_6:1856:7135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0011; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1856
msgctxt "text_id=7135 | speaker=aoko"
msgid "“……でもどこかに見えているはず。"
msgstr ""

#. Occurrence 5B_6:1862:7136: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0012; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1862
msgctxt "text_id=7136 | speaker=aoko"
msgid "　スナークは本の主題だもの。<常|つね>に<視界|ページ>のどこかにいないと、主人公の資格がない―――！”"
msgstr ""

#. Occurrence 5B_6:1868:7137: scene=5B_6
#: 5B_6:1868
msgctxt "text_id=7137 | speaker=unknown"
msgid "　それはどこか。"
msgstr ""

#. Occurrence 5B_6:1873:7138: scene=5B_6
#: 5B_6:1873
msgctxt "text_id=7138 | speaker=unknown"
msgid "　安易に考えるなら、あの観覧車がもっとも安全、かつ遊園地を象徴する“主題”だが―――"
msgstr ""

#. Occurrence 5B_6:1944:7139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0003; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1944
msgctxt "text_id=7139 | speaker=soujuurou"
msgid "「あの子を捕まえるのは！？」"
msgstr ""

#. Occurrence 5B_6:1957:7140: scene=5B_6
#: 5B_6:1957
msgctxt "text_id=7140 | speaker=unknown"
msgid "　突然の提案に目を見張る。"
msgstr ""

#. Occurrence 5B_6:1962:7141: scene=5B_6
#: 5B_6:1962
msgctxt "text_id=7141 | speaker=unknown"
msgid "　青子が打開策を思案していたように、草十郎もまた、彼なりに頭を巡らせていたらしい。"
msgstr ""

#. Occurrence 5B_6:2017:7142: scene=5B_6
#: 5B_6:2017
msgctxt "text_id=7142 | speaker=unknown"
msgid "　草十郎の提案はシンプルだ。"
msgstr ""

#. Occurrence 5B_6:2022:7143: scene=5B_6
#: 5B_6:2022
msgctxt "text_id=7143 | speaker=unknown"
msgid "　スナークの本体が見つけられないのなら、その持ち主である有珠を倒せばいいのではないか。"
msgstr ""

#. Occurrence 5B_6:2027:7144: scene=5B_6
#: 5B_6:2027
msgctxt "text_id=7144 | speaker=unknown"
msgid "　有珠は時計台から動いていない。"
msgstr ""

#. Occurrence 5B_6:2032:7145: scene=5B_6
#: 5B_6:2032
msgctxt "text_id=7145 | speaker=unknown"
msgid "　ここからでも、月光に照らされる姿は目に入る。"
msgstr ""

#. Occurrence 5B_6:2091:7146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0013; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2091
msgctxt "text_id=7146 | speaker=aoko"
msgid "「それは一番ダメ！"
msgstr ""

#. Occurrence 5B_6:2098:7147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0014; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2098
msgctxt "text_id=7147 | speaker=aoko"
msgid "　有珠を殺してもフラットスナークは止まらないし、このトンデモが外にあふれだす事になる！"
msgstr ""

#. Occurrence 5B_6:2110:7148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0015; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2110
msgctxt "text_id=7148 | speaker=aoko"
msgid "　だいたい、私じゃあの子を殺せないから！　よくて半殺しがいいところ！」"
msgstr ""

#. Occurrence 5B_6:2230:7149: scene=5B_6
#: 5B_6:2230
msgctxt "text_id=7149 | speaker=unknown"
msgid "　主人の悪口にいきりたったブレッドマンが、こんがり無惨に焼け焦げになる。"
msgstr ""

#. Occurrence 5B_6:2307:7150: scene=5B_6
#: 5B_6:2307
msgctxt "text_id=7150 | speaker=unknown"
msgid "　……じり、と背中をあわせて呼吸を整えるふたり。"
msgstr ""

#. Occurrence 5B_6:2312:7151: scene=5B_6
#: 5B_6:2312
msgctxt "text_id=7151 | speaker=unknown"
msgid "　目の醒めるような打開策は出ず、いよいよもって八方ふさがりになった状況に消沈する。"
msgstr ""

#. Occurrence 5B_7:52:7152: scene=5B_7
#: 5B_7:52
msgctxt "text_id=7152 | speaker=unknown"
msgid "　一方。<獲物|えもの>の活きの良さが分かるのか、オブジェたちは輪になって青子たちを観察していた。"
msgstr ""

#. Occurrence 5B_7:58:7153: scene=5B_7
#: 5B_7:58
msgctxt "text_id=7153 | speaker=unknown"
msgid "　パン屋にひきずりこんで焼き殺すか、"
msgstr ""

msgctxt "text_id=7154 | speaker=unknown"
msgid "　精肉店の挽肉機ですり潰すか。"
msgstr ""

#. Occurrence 5B_7:66:7155: scene=5B_7
#: 5B_7:66
msgctxt "text_id=7155 | speaker=unknown"
msgid "　はたまた串刺しにしてゴーラウンドで引き回すか、"
msgstr ""

msgctxt "text_id=7156 | speaker=unknown"
msgid "　トゲトゲだらけの<海賊船|ゆりかご>に乗せて航海に乗りだすか。"
msgstr ""

#. Occurrence 5B_7:112:7157: scene=5B_7
#: 5B_7:112
msgctxt "text_id=7157 | speaker=unknown"
msgid "　二年間眠っていた分、歓迎意欲は盛りだくさんだ。"
msgstr ""

#. Occurrence 5B_7:181:7158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0000; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:181
msgctxt "text_id=7158 | speaker=soujuurou"
msgid "「……いちおう、聞いておきたいんだけど」"
msgstr ""

#. Occurrence 5B_7:198:7159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0000; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:198
msgctxt "text_id=7159 | speaker=aoko"
msgid "「なに。手短にね、いま考え事してるから」"
msgstr ""

#. Occurrence 5B_7:215:7160: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0001; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:215
msgctxt "text_id=7160 | speaker=soujuurou"
msgid "「ああ。……あの連中がなにをしたいか、イヤっていうほど伝わってくるんだけど。それって、あの子の趣味なのかな」"
msgstr ""

#. Occurrence 5B_7:254:7161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0001; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:254
msgctxt "text_id=7161 | speaker=aoko"
msgid "「……その疑問はなかったわ。"
msgstr ""

#. Occurrence 5B_7:261:7162: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0002; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:261
msgctxt "text_id=7162 | speaker=aoko"
msgid "連中の人間嫌いは遊園地の怨念と、フラットスナークの性格じゃない？　基本的にマトモなヤツいないから、有珠の使い魔って。"
msgstr ""

#. Occurrence 5B_7:273:7163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0003; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:273
msgctxt "text_id=7163 | speaker=aoko"
msgid "　ああ、でも―――」"
msgstr ""

#. Occurrence 5B_7:327:7164: scene=5B_7
#: 5B_7:327
msgctxt "text_id=7164 | speaker=unknown"
msgid "　なんというか、有珠の性格の怖さも否定できない青子だった。"
msgstr ""

#. Occurrence 5B_7:354:7165: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0002; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:354
msgctxt "text_id=7165 | speaker=soujuurou"
msgid "「それは結構。……それで、蒼崎の考えごとって？　止める方法、考えついたのか？」"
msgstr ""

#. Occurrence 5B_7:365:7166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0004; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:365
msgctxt "text_id=7166 | speaker=aoko"
msgid "「期待させて悪いけどお手上げ。ま、アンタが殺されれば止まるでしょうけど」"
msgstr ""

#. Occurrence 5B_7:377:7167: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0003; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:377
msgctxt "text_id=7167 | speaker=soujuurou"
msgid "「それはイヤだ！　とりあえず逃げよう！」"
msgstr ""

#. Occurrence 5B_7:405:7168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0005; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:405
msgctxt "text_id=7168 | speaker=aoko"
msgid "「え、ちょっ、静希君！？」"
msgstr ""

#. Occurrence 5B_7:474:7169: scene=5B_7
#: 5B_7:474
msgctxt "text_id=7169 | speaker=unknown"
msgid "　―――突然の<展|こ><開|と>に目を見張る。"
msgstr ""

#. Occurrence 5B_7:480:7170: scene=5B_7
#: 5B_7:480
msgctxt "text_id=7170 | speaker=unknown"
msgid "　今まで青子に付いてくるだけだった草十郎は強引に青子の手を取って、焼きたてパンの群に突進―――囲みを<破|やぶ>ろうと力任せに特攻する。"
msgstr ""

#. Occurrence 5B_7:740:7171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0006; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:740
msgctxt "text_id=7171 | speaker=aoko"
msgid "「い、意味わかんなすぎ！"
msgstr ""

#. Occurrence 5B_7:746:7172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0007; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:746
msgctxt "text_id=7172 | speaker=aoko"
msgid "　なんで今の流れでそうなるのよアンタはーーーー！？」"
msgstr ""

#. Occurrence 5B_7:831:7173: scene=5B_7
#: 5B_7:831
msgctxt "text_id=7173 | speaker=unknown"
msgid "　別人のようなアグレッシブさを発揮する草十郎を<罵|ののし>りながら、律儀にフォローする青子。"
msgstr ""

#. Occurrence 5B_7:921:7174: scene=5B_7
#: 5B_7:921
msgctxt "text_id=7174 | speaker=unknown"
msgid "　草十郎の体当たりでは包囲網を突破できない。"
msgstr ""

#. Occurrence 5B_7:926:7175: scene=5B_7
#: 5B_7:926
msgctxt "text_id=7175 | speaker=unknown"
msgid "　青子はすぐさま体勢をたてなおし、草十郎の正面に魔弾を掃射する。"
msgstr ""

#. Occurrence 5B_7:1015:7176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0008; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1015
msgctxt "text_id=7176 | speaker=aoko"
msgid "「っ、はっ―――！」"
msgstr ""

#. Occurrence 5B_7:1021:7177: scene=5B_7
#: 5B_7:1021
msgctxt "text_id=7177 | speaker=unknown"
msgid "　囲いを抜け、全力で走りだす。"
msgstr ""

#. Occurrence 5B_7:1026:7178: scene=5B_7
#: 5B_7:1026
msgctxt "text_id=7178 | speaker=unknown"
msgid "　こうなっては当初の予定通り、遊園地の外を目指すしかない。"
msgstr ""

#. Occurrence 5B_7:1046:7179: scene=5B_7
#: 5B_7:1046
msgctxt "text_id=7179 | speaker=unknown"
msgid "　……まあ、それはともかくとして。"
msgstr ""

#. Occurrence 5B_7:1103:7180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0009; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1103
msgctxt "text_id=7180 | speaker=aoko"
msgid "「なんでよ!?　さっきはあんなに諦め良かったのに！」"
msgstr ""

#. Occurrence 5B_7:1109:7181: scene=5B_7
#: 5B_7:1109
msgctxt "text_id=7181 | speaker=unknown"
msgid "　青子には草十郎の反応が、とにかくホントに理解不能。"
msgstr ""

#. Occurrence 5B_7:1178:7182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0004; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1178
msgctxt "text_id=7182 | speaker=soujuurou"
msgid "「ミラーハウスの時と今は違うだろ！　いいから走れ！」"
msgstr ""

#. Occurrence 5B_7:1229:7183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0010; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1229
msgctxt "text_id=7183 | speaker=aoko"
msgid "「違わないわよ！　アンタを殺そうとした私も、アンタを殺したい有珠も！　理由も結果も同じよ、私たち!?」"
msgstr ""

#. Occurrence 5B_7:1281:7184: scene=5B_7
#: 5B_7:1281
msgctxt "text_id=7184 | speaker=unknown"
msgid "　何でこんなコトで怒鳴っているんだろう、と思いながらも青子は止まらない。"
msgstr ""

#. Occurrence 5B_7:1286:7185: scene=5B_7
#: 5B_7:1286
msgctxt "text_id=7185 | speaker=unknown"
msgid "　きっと、無謀にもブレッドマンに突進した草十郎の馬鹿さ加減が頭にきているんだ、と自分自身に言い聞かせる。"
msgstr ""

#. Occurrence 5B_7:1352:7186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0011; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1352
msgctxt "text_id=7186 | speaker=aoko"
msgid "「あのね、一緒に逃げてるぐらいで勘違いしないでくれる!?　言っとくけど私、明日になったらまたアンタを殺しに行くから！　死にたくないってんなら、ここで私からも逃げだしたら!?」"
msgstr ""

#. Occurrence 5B_7:1417:7187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0005; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1417
msgctxt "text_id=7187 | speaker=soujuurou"
msgid "「それはまた今度の話だろ！　だいたい、蒼崎に殺されるのならいいけど、あの子に殺されるのはイヤだ！」"
msgstr ""

#. Occurrence 5B_7:1423:7188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0012; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1423
msgctxt "text_id=7188 | speaker=aoko"
msgid "「だからなんで！？」"
msgstr ""

#. Occurrence 5B_7:1429:7189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0006; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1429
msgctxt "text_id=7189 | speaker=soujuurou"
msgid "「だって顔も知らない！　話したコトさえない相手だ！」"
msgstr ""

#. Occurrence 5B_7:1483:7190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0013; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1483
msgctxt "text_id=7190 | speaker=aoko"
msgid "「―――は？」"
msgstr ""

#. Occurrence 5B_7:1518:7191: scene=5B_7
#: 5B_7:1518
msgctxt "text_id=7191 | speaker=unknown"
msgid "　沸き立っていた激情が、一瞬で鎮火する。"
msgstr ""

#. Occurrence 5B_7:1523:7192: scene=5B_7
#: 5B_7:1523
msgctxt "text_id=7192 | speaker=unknown"
msgid "　あまりに簡潔かつどうでもいい理由に、青子の<直情|いかり>はあっさりと消えてしまった。"
msgstr ""

#. Occurrence 5B_7:1574:7193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0014; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1574
msgctxt "text_id=7193 | speaker=aoko"
msgid "「顔も知らないって……」"
msgstr ""

#. Occurrence 5B_7:1581:7194: scene=5B_7
#: 5B_7:1581
msgctxt "text_id=7194 | speaker=unknown"
msgid "　草十郎としては、よく知った相手なら殺されてもいいのだろうか？"
msgstr ""

#. Occurrence 5B_7:1586:7195: scene=5B_7
#: 5B_7:1586
msgctxt "text_id=7195 | speaker=unknown"
msgid "　ますますもって理解できない、と顔をしかめながら、青子は草十郎の背中を追いかけるのだった。"
msgstr ""

#. Occurrence 5B_8:77:7196: scene=5B_8
#: 5B_8:77
msgctxt "text_id=7196 | speaker=unknown"
msgid "　時計台の上で、少女は使い魔の成長を監視している。"
msgstr ""

#. Occurrence 5B_8:82:7197: scene=5B_8
#: 5B_8:82
msgctxt "text_id=7197 | speaker=unknown"
msgid "　フラットスナーク。"
msgstr ""

#. Occurrence 5B_8:87:7198: scene=5B_8
#: 5B_8:87
msgctxt "text_id=7198 | speaker=unknown"
msgid "　廃棄されたモノたちの救世主。"
msgstr ""

#. Occurrence 5B_8:92:7199: scene=5B_8
#: 5B_8:92
msgctxt "text_id=7199 | speaker=unknown"
msgid "　朽ちゆく<運命|さだめ>のモノたちに一時の希望を与え、根こそぎ奪い去る、<性悪|しょうわる>で<低俗|ていぞく>な“童話の怪物”。"
msgstr ""

#. Occurrence 5B_8:99:7200: scene=5B_8
#: 5B_8:99
msgctxt "text_id=7200 | speaker=unknown"
msgid "　自らの手駒ではあるが、スナークがその<悪癖|あくへき>を発揮しないよう、少女は目を光らせていた。"
msgstr ""

#. Occurrence 5B_8:120:7201: scene=5B_8
#: 5B_8:120
msgctxt "text_id=7201 | speaker=unknown"
msgid "　いまやひとつの街ほどまでに広がった遊園地を一周した駒鳥が、少女に現状を報告する。"
msgstr ""

#. Occurrence 5B_8:183:7202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0000; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:183
msgctxt "text_id=7202 | speaker=alice"
msgid "「……そう。外を目指しているの」"
msgstr ""

#. Occurrence 5B_8:189:7203: scene=5B_8
#: 5B_8:189
msgctxt "text_id=7203 | speaker=unknown"
msgid "　青子は少年の安全を優先したのだろう。"
msgstr ""

#. Occurrence 5B_8:194:7204: scene=5B_8
#: 5B_8:194
msgctxt "text_id=7204 | speaker=unknown"
msgid "　たとえ一日で無駄になる事でも、一度決めた事を曲げないのは実に彼女らしい。"
msgstr ""

#. Occurrence 5B_8:267:7205: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0001; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:267
msgctxt "text_id=7205 | speaker=alice"
msgid "「青子の事だから、時計台ごと私を焼き払いにくるかと思ったけど」"
msgstr ""

#. Occurrence 5B_8:273:7206: scene=5B_8
#: 5B_8:273
msgctxt "text_id=7206 | speaker=unknown"
msgid "　チチチ、と<嘴|くちばし>を鳴らす青い鳥。"
msgstr ""

#. Occurrence 5B_8:278:7207: scene=5B_8
#: 5B_8:278
msgctxt "text_id=7207 | speaker=unknown"
msgid "　主人の語る青子像を否定しているのか、"
msgstr ""

#. Occurrence 5B_8:283:7208: scene=5B_8
#: 5B_8:283
msgctxt "text_id=7208 | speaker=unknown"
msgid "　青子ならやりかねないと同意しているのか。"
msgstr ""

#. Occurrence 5B_8:288:7209: scene=5B_8
#: 5B_8:288
msgctxt "text_id=7209 | speaker=unknown"
msgid "　傍目にはどちらにも取れる合いの手である。"
msgstr ""

#. Occurrence 5B_8:337:7210: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0002; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:337
msgctxt "text_id=7210 | speaker=alice"
msgid "「退屈？」"
msgstr ""

#. Occurrence 5B_8:345:7211: scene=5B_8
#: 5B_8:345
msgctxt "text_id=7211 | speaker=unknown"
msgid "　突然話しかけられ、ビクッと震える駒鳥。"
msgstr ""

#. Occurrence 5B_8:350:7212: scene=5B_8
#: 5B_8:350
msgctxt "text_id=7212 | speaker=unknown"
msgid "　チチチ、と必死に羽を振る仕草は、“そんなコトないっス！”とあわてる<丁稚|でっち>のようだ。"
msgstr ""

#. Occurrence 5B_8:445:7213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0003; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:445
msgctxt "text_id=7213 | speaker=alice"
msgid "「……珍しく気があったわね。"
msgstr ""

#. Occurrence 5B_8:451:7214: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0004; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:451
msgctxt "text_id=7214 | speaker=alice"
msgid "　いいわ。せっかくのゲームだし、もう少しだけ盛り上げましょう」"
msgstr ""

#. Occurrence 5B_8:457:7215: scene=5B_8
#: 5B_8:457
msgctxt "text_id=7215 | speaker=unknown"
msgid "　無表情のまま少女は小さな器物を取り出した。"
msgstr ""

#. Occurrence 5B_8:462:7216: scene=5B_8
#: 5B_8:462
msgctxt "text_id=7216 | speaker=unknown"
msgid "　カチカチと内から秒針の音をこぼす、鈍色の<装飾卵|イースターエッグ>。"
msgstr ""

#. Occurrence 5B_8:531:7217: scene=5B_8
#: 5B_8:531
msgctxt "text_id=7217 | speaker=unknown"
msgid "　それがフラットスナークには及ばずとも、対個人戦においてトップランクに<性質|タチ>の悪い“<童話の怪物|プロイキッシャー>”である事を、駒鳥は知っている。"
msgstr ""

#. Occurrence 5B_8:645:7218: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0005; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:645
msgctxt "text_id=7218 | speaker=alice"
msgid "「行ってらっしゃい。<讃|たた>える時間は二十分に設定したわ。"
msgstr ""

#. Occurrence 5B_8:651:7219: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0006; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:651
msgctxt "text_id=7219 | speaker=alice"
msgid "　……いつも通り、控え目に壊れてきて」"
msgstr ""

#. Occurrence 5B_8:657:7220: scene=5B_8
#: 5B_8:657
msgctxt "text_id=7220 | speaker=unknown"
msgid "　魔女の一息と共に、<祝|いわ>いの言葉がつまった卵が消える。"
msgstr ""

#. Occurrence 5B_8:724:7221: scene=5B_8
#: 5B_8:724
msgctxt "text_id=7221 | speaker=unknown"
msgid "　不意に、遊園地に強い風が吹いた。"
msgstr ""

#. Occurrence 5B_8:730:7222: scene=5B_8
#: 5B_8:730
msgctxt "text_id=7222 | speaker=unknown"
msgid "　　　『彼らを殺すのは、自分だけで十分なのに』と。"
msgstr ""

#. Occurrence 5B_8:736:7223: scene=5B_8
#: 5B_8:736
msgctxt "text_id=7223 | speaker=unknown"
msgid "　それは、目に映っていながら見過ごしてしまう、巨大な何かの嘆息のようだった。"
msgstr ""

#. Occurrence 5B_9:94:7224: scene=5B_9
#: 5B_9:94
msgctxt "text_id=7224 | speaker=unknown"
msgid "　遊園地と外を分ける境界線に向かって、青子たちは走り続ける。"
msgstr ""

#. Occurrence 5B_9:248:7225: scene=5B_9
#: 5B_9:248
msgctxt "text_id=7225 | speaker=unknown"
msgid "　行く手を阻むオブジェの数は減ってきていた。"
msgstr ""

#. Occurrence 5B_9:253:7226: scene=5B_9
#: 5B_9:253
msgctxt "text_id=7226 | speaker=unknown"
msgid "　<外|そ><界|と>に通じる東側の鉄柵まで、あと三百メートル弱。"
msgstr ""

#. Occurrence 5B_9:318:7227: scene=5B_9
#: 5B_9:318
msgctxt "text_id=7227 | speaker=unknown"
msgid "　幸運な事に、鉄柵への道中にはこれといって巨大な建物はない。"
msgstr ""

#. Occurrence 5B_9:325:7228: scene=5B_9
#: 5B_9:325
msgctxt "text_id=7228 | speaker=unknown"
msgid "　あの観覧車に立ち<塞|ふさ>がられたらそれこそ終わりだが、観覧車が動き出すまであと幾ばくかの<猶予|ゆうよ>があるようだ。"
msgstr ""

#. Occurrence 5B_9:330:7229: scene=5B_9
#: 5B_9:330
msgctxt "text_id=7229 | speaker=unknown"
msgid "　現れるのは青子の簡易魔術で吹き飛ばせる程度のオブジェのみ。"
msgstr ""

#. Occurrence 5B_9:351:7230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0000; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:351
msgctxt "text_id=7230 | speaker=aoko"
msgid "“これなら、なんとか―――”"
msgstr ""

#. Occurrence 5B_9:410:7231: scene=5B_9
#: 5B_9:410
msgctxt "text_id=7231 | speaker=unknown"
msgid "　鉄柵まで辿り着ける、と青子は呼吸を整える。"
msgstr ""

#. Occurrence 5B_9:415:7232: scene=5B_9
#: 5B_9:415
msgctxt "text_id=7232 | speaker=unknown"
msgid "　遊園地に満ちている<魔力|マナ>を使用しているので、青子本人の魔力はほぼ満タン。"
msgstr ""

#. Occurrence 5B_9:420:7233: scene=5B_9
#: 5B_9:420
msgctxt "text_id=7233 | speaker=unknown"
msgid "　<身体|からだ>の魔術回路は調子をあげる一方だし、一度ぐらいは全開で魔術行使をしてもいいぐらいだ。"
msgstr ""

#. Occurrence 5B_9:520:7234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0001; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:520
msgctxt "text_id=7234 | speaker=aoko"
msgid "「―――？」"
msgstr ""

#. Occurrence 5B_9:526:7235: scene=5B_9
#: 5B_9:526
msgctxt "text_id=7235 | speaker=unknown"
msgid "　と。"
msgstr ""

#. Occurrence 5B_9:532:7236: scene=5B_9
#: 5B_9:532
msgctxt "text_id=7236 | speaker=unknown"
msgid "そんな青子の視界上空に、なにやら系統の違うモノが浮遊していた。"
msgstr ""

#. Occurrence 5B_9:537:7237: scene=5B_9
#: 5B_9:537
msgctxt "text_id=7237 | speaker=unknown"
msgid "　それは草十郎のななめ上空に張りつき、三メートルの高さを維持したまま移動している。"
msgstr ""

#. Occurrence 5B_9:616:7238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0002; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:616
msgctxt "text_id=7238 | speaker=aoko"
msgid "「静希君、ちょっと」"
msgstr ""

#. Occurrence 5B_9:622:7239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0000; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:622
msgctxt "text_id=7239 | speaker=soujuurou"
msgid "「ああ。さっきから付いてきてる」"
msgstr ""

#. Occurrence 5B_9:628:7240: scene=5B_9
#: 5B_9:628
msgctxt "text_id=7240 | speaker=unknown"
msgid "　青子より先に気づいていたのか、草十郎はイヤそうに上空を盗み見ていた。"
msgstr ""

#. Occurrence 5B_9:633:7241: scene=5B_9
#: 5B_9:633
msgctxt "text_id=7241 | speaker=unknown"
msgid "　なにしろ自分にぴったりとくっついて来ているのだ。気にならない方がおかしい。"
msgstr ""

#. Occurrence 5B_9:766:7242: scene=5B_9
#: 5B_9:766
msgctxt "text_id=7242 | speaker=unknown"
msgid "　浮遊物は大きさにして直径一メートルほど。"
msgstr ""

#. Occurrence 5B_9:771:7243: scene=5B_9
#: 5B_9:771
msgctxt "text_id=7243 | speaker=unknown"
msgid "　表面のタイルには<十|と><重|え><二|は><十|た><重|え>に廻る光の躍動。"
msgstr ""

#. Occurrence 5B_9:792:7244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0001; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:792
msgctxt "text_id=7244 | speaker=soujuurou"
msgid "「……卵、かな」"
msgstr ""

#. Occurrence 5B_9:797:7245: scene=5B_9
#: 5B_9:797
msgctxt "text_id=7245 | speaker=unknown"
msgid "　草十郎は自信なさげに呟いた。"
msgstr ""

#. Occurrence 5B_9:865:7246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0003; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:865
msgctxt "text_id=7246 | speaker=aoko"
msgid "「卵……？　卵って言ったら―――割れる卵！」"
msgstr ""

#. Occurrence 5B_9:1010:7247: scene=5B_9
#: 5B_9:1010
msgctxt "text_id=7247 | speaker=unknown"
msgid "　<衛星|たまご>はゴムのように魔弾を弾く。"
msgstr ""

#. Occurrence 5B_9:1015:7248: scene=5B_9
#: 5B_9:1015
msgctxt "text_id=7248 | speaker=unknown"
msgid "　その特性―――干渉を当然のように無効化するのは、間違いなく“<童話の怪物|プロイキッシャー>”……！"
msgstr ""

#. Occurrence 5B_9:1099:7249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0004; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1099
msgctxt "text_id=7249 | speaker=aoko"
msgid "「やっぱり外からのルールじゃ壊れないか……"
msgstr ""

#. Occurrence 5B_9:1105:7250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0005; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1105
msgctxt "text_id=7250 | speaker=aoko"
msgid "　静希君、アレから絶対に目をそらさないで！"
msgstr ""

#. Occurrence 5B_9:1111:7251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0006; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1111
msgctxt "text_id=7251 | speaker=aoko"
msgid "　いい、何があっても見続けること！　視界の<隅|すみ>に入れとくだけでいいから！」"
msgstr ""

#. Occurrence 5B_9:1117:7252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0002; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1117
msgctxt "text_id=7252 | speaker=soujuurou"
msgid "「あ、ああ!?」"
msgstr ""

#. Occurrence 5B_9:1155:7253: scene=5B_9
#: 5B_9:1155
msgctxt "text_id=7253 | speaker=unknown"
msgid "　草十郎に指示をだしながら、青子は走る速度を速める。"
msgstr ""

#. Occurrence 5B_9:1160:7254: scene=5B_9
#: 5B_9:1160
msgctxt "text_id=7254 | speaker=unknown"
msgid "　……アレは文字通り、割れる卵だ。"
msgstr ""

#. Occurrence 5B_9:1165:7255: scene=5B_9
#: 5B_9:1165
msgctxt "text_id=7255 | speaker=unknown"
msgid "　塀の上に乗った卵人間。"
msgstr ""

#. Occurrence 5B_9:1170:7256: scene=5B_9
#: 5B_9:1170
msgctxt "text_id=7256 | speaker=unknown"
msgid "　何をしても、何を言っても決して落ちる事はないが、目を離した途端に落下して破片をまき散らす。"
msgstr ""

#. Occurrence 5B_9:1224:7257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0007; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1224
msgctxt "text_id=7257 | speaker=aoko"
msgid "「曰く、王様の軍隊でも元に戻せない数の破片―――」"
msgstr ""

#. Occurrence 5B_9:1230:7258: scene=5B_9
#: 5B_9:1230
msgctxt "text_id=7258 | speaker=unknown"
msgid "　それがマザーグースに唄われるハンプティ・ダンプティの一節だ。"
msgstr ""

#. Occurrence 5B_9:1235:7259: scene=5B_9
#: 5B_9:1235
msgctxt "text_id=7259 | speaker=unknown"
msgid "　あの卵の標的が草十郎なら、草十郎が卵から視線をきった瞬間、落下して爆発する……！"
msgstr ""

#. Occurrence 5B_9:1299:7260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0008; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1299
msgctxt "text_id=7260 | speaker=aoko"
msgid "「……まあ、爆発するかどうかは知らないけど」"
msgstr ""

#. Occurrence 5B_9:1305:7261: scene=5B_9
#: 5B_9:1305
msgctxt "text_id=7261 | speaker=unknown"
msgid "　どうあれ、厄介なモノをまき散らすに違いない。"
msgstr ""

#. Occurrence 5B_9:1310:7262: scene=5B_9
#: 5B_9:1310
msgctxt "text_id=7262 | speaker=unknown"
msgid "　卵という形状、錠門の装飾、刻まれた詩文も気になる。"
msgstr ""

#. Occurrence 5B_9:1315:7263: scene=5B_9
#: 5B_9:1315
msgctxt "text_id=7263 | speaker=unknown"
msgid "　アレが卵ならいつかは<孵|かえ>る。"
msgstr ""

#. Occurrence 5B_9:1320:7264: scene=5B_9
#: 5B_9:1320
msgctxt "text_id=7264 | speaker=unknown"
msgid "　ずっと見続けていても、時間がくれば“中身が出る”としたら、ますます余力を残している場合ではない。"
msgstr ""

#. Occurrence 5B_9:1384:7265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0003; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1384
msgctxt "text_id=7265 | speaker=soujuurou"
msgid "「蒼崎、速すぎないか!?"
msgstr ""

#. Occurrence 5B_9:1390:7266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0004; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1390
msgctxt "text_id=7266 | speaker=soujuurou"
msgid "　あんまり全力で走ると―――」"
msgstr ""

#. Occurrence 5B_9:1436:7267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0009; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1436
msgctxt "text_id=7267 | speaker=aoko"
msgid "「後の事は考えないで！"
msgstr ""

#. Occurrence 5B_9:1442:7268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0010; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1442
msgctxt "text_id=7268 | speaker=aoko"
msgid "　いいから静希君は卵だけに集中して―――」"
msgstr ""

#. Occurrence 5B_9:1492:7269: scene=5B_9
#: 5B_9:1492
msgctxt "text_id=7269 | speaker=unknown"
msgid "　卵の出現にあわせて、ここぞとばかりに立ちふさがるブレッドマン。"
msgstr ""

#. Occurrence 5B_9:1543:7270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0011; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1543
msgctxt "text_id=7270 | speaker=aoko"
msgid "「邪魔―――！」"
msgstr ""

#. Occurrence 5B_9:1671:7271: scene=5B_9
#: 5B_9:1671
msgctxt "text_id=7271 | speaker=unknown"
msgid "　かつてない大軍で押し寄せる焼きたてパンを、"
msgstr ""

msgctxt "text_id=7272 | speaker=unknown"
msgid "　青子はこれまで以上の火力でなぎ払うのだが―――"
msgstr ""

#. Occurrence 5B_9:1831:7273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0012; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1831
msgctxt "text_id=7273 | speaker=aoko"
msgid "「っ、<堅|かた>焼きか、この―――！」"
msgstr ""

#. Occurrence 5B_9:1961:7274: scene=5B_9
#: 5B_9:1961
msgctxt "text_id=7274 | speaker=unknown"
msgid "　<弾く|スナップ>が効かないというのなら、刻印を用いた魔弾を放つ。"
msgstr ""

#. Occurrence 5B_9:1966:7275: scene=5B_9
#: 5B_9:1966
msgctxt "text_id=7275 | speaker=unknown"
msgid "　<術式|だんがん>を用いた<風圧甲弾|ドロウ>。"
msgstr ""

#. Occurrence 5B_9:1971:7276: scene=5B_9
#: 5B_9:1971
msgctxt "text_id=7276 | speaker=unknown"
msgid "　先ほどまでのが機関銃の掃射なら、これは大砲の一撃だ。"
msgstr ""

#. Occurrence 5B_9:2095:7277: scene=5B_9
#: 5B_9:2095
msgctxt "text_id=7277 | speaker=unknown"
msgid "　<魔力|スナップ>に耐えきった堅焼きパンたちは、<魔術|ドロウ>の<奔流|ほんりゅう>を受けて焼き千切れていった。"
msgstr ""

#. Occurrence 5B_9:2179:7278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0005; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2179
msgctxt "text_id=7278 | speaker=soujuurou"
msgid "「うわ……」"
msgstr ""

#. Occurrence 5B_9:2185:7279: scene=5B_9
#: 5B_9:2185
msgctxt "text_id=7279 | speaker=unknown"
msgid "　もちろん、破壊はブレッドマンだけに留まらない。"
msgstr ""

#. Occurrence 5B_9:2191:7280: scene=5B_9
#: 5B_9:2191
msgctxt "text_id=7280 | speaker=unknown"
msgid "　レンガの道は舗装をふっ飛ばされ丸裸にされ、"
msgstr ""

#. Occurrence 5B_9:2196:7281: scene=5B_9
#: 5B_9:2196
msgctxt "text_id=7281 | speaker=unknown"
msgid "　近くにあった売店は鉄骨だけを残した<骸骨|スケルトン>と化していた。"
msgstr ""

#. Occurrence 5B_9:2284:7282: scene=5B_9
#: 5B_9:2284
msgctxt "text_id=7282 | speaker=unknown"
msgid "　ブレッドマンの壁より青子の破壊活動の方がいずれ行く手を阻むのでは、と草十郎でなくとも不安に思う惨状である。"
msgstr ""

#. Occurrence 5B_9:2350:7283: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0013; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2350
msgctxt "text_id=7283 | speaker=aoko"
msgid "「ちょっと。なんで距離とるのよ、そこ。<傍|そば>にいないと危ないじゃない。"
msgstr ""

#. Occurrence 5B_9:2366:7284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0014; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2366
msgctxt "text_id=7284 | speaker=aoko"
msgid "　ほら、もっとこっち！"
msgstr ""

#. Occurrence 5B_9:2373:7285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0015; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2373
msgctxt "text_id=7285 | speaker=aoko"
msgid "　言っとくけどアンタがアイツらに囲まれちゃったらアウトよ？　私、人質とか意味ないタイプだし。そもそも区別して撃つとか、そういうのできないし」"
msgstr ""

#. Occurrence 5B_9:2415:7286: scene=5B_9
#: 5B_9:2415
msgctxt "text_id=7286 | speaker=unknown"
msgid "　なるほど、と頷く草十郎。"
msgstr ""

#. Occurrence 5B_9:2420:7287: scene=5B_9
#: 5B_9:2420
msgctxt "text_id=7287 | speaker=unknown"
msgid "　人質は意味をなさない、という言葉の意味は分からずとも、彼女の言わんとするところは分かる。"
msgstr ""

#. Occurrence 5B_9:2464:7288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0006; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2464
msgctxt "text_id=7288 | speaker=soujuurou"
msgid "「つまり、今はどこであろうと危険なのか」"
msgstr ""

#. Occurrence 5B_9:2480:7289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0016; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2480
msgctxt "text_id=7289 | speaker=aoko"
msgid "「……アンタね」"
msgstr ""

#. Occurrence 5B_9:2523:7290: scene=5B_9
#: 5B_9:2523
msgctxt "text_id=7290 | speaker=unknown"
msgid "　草十郎の相変わらずの天然っぷりにカチンときながらも、青子は少しだけ感心した。"
msgstr ""

#. Occurrence 5B_9:2528:7291: scene=5B_9
#: 5B_9:2528
msgctxt "text_id=7291 | speaker=unknown"
msgid "　草十郎はいたって真面目だ。"
msgstr ""

#. Occurrence 5B_9:2533:7292: scene=5B_9
#: 5B_9:2533
msgctxt "text_id=7292 | speaker=unknown"
msgid "　彼の視線は、今の乱戦の中でもしっかり頭上の卵に向けられている。"
msgstr ""

#. Occurrence 5B_9:2559:7293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0017; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2559
msgctxt "text_id=7293 | speaker=aoko"
msgid "「その分なら安心か。"
msgstr ""

#. Occurrence 5B_9:2565:7294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0018; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2565
msgctxt "text_id=7294 | speaker=aoko"
msgid "　物分かりは悪いけど、一度言われた事はきっちり守るあたり、貴方のいいところよね」"
msgstr ""

#. Occurrence 5B_9:2598:7295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0007; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2598
msgctxt "text_id=7295 | speaker=soujuurou"
msgid "「そんなことより蒼崎。俺の気のせいならいいんだけど、さっきのパン、堅くなかったか？」"
msgstr ""

#. Occurrence 5B_9:2645:7296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0019; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2645
msgctxt "text_id=7296 | speaker=aoko"
msgid "「……まあね。アイツら、少しずつ強くなってきてるわ。"
msgstr ""

#. Occurrence 5B_9:2651:7297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0020; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2651
msgctxt "text_id=7297 | speaker=aoko"
msgid "　大量生産が軌道に乗ったんで、今度はクオリティアップをテーマにしたのかも」"
msgstr ""

#. Occurrence 5B_9:2694:7298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0021; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2694
msgctxt "text_id=7298 | speaker=aoko"
msgid "「静希君でもお察しの通り、ここからは手強くなっていく一方よ。あのパンたちでさえ個体差がでてきたみたいだし。"
msgstr ""

#. Occurrence 5B_9:2700:7299: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0022; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2700
msgctxt "text_id=7299 | speaker=aoko"
msgid "　考えたくないけど、そのうちジャム塗ったりレタス乗っけたり、はては合体したりして」"
msgstr ""

#. Occurrence 5B_9:2744:7300: scene=5B_9
#: 5B_9:2744
msgctxt "text_id=7300 | speaker=unknown"
msgid "　冗談を言いながらも青子の目は真剣だ。"
msgstr ""

#. Occurrence 5B_9:2754:7301: scene=5B_9
#: 5B_9:2754
msgctxt "text_id=7301 | speaker=unknown"
msgid "　容赦なく悪化していく状況に、草十郎は今更ながら戦慄を覚えてしまう。"
msgstr ""

#. Occurrence 5B_9:2780:7302: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0008; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2780
msgctxt "text_id=7302 | speaker=soujuurou"
msgid "「じゃあ、そのうちミラーハウスの人形ぐらいに恐くなるのか、あいつら？」"
msgstr ""

#. Occurrence 5B_9:2808:7303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0023; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2808
msgctxt "text_id=7303 | speaker=aoko"
msgid "「間違いなくね。そこまで<高価|レア>なパンになったら私も自分だけで手一杯になる。ところで静希君、ああいうのとケンカできる？」"
msgstr ""

#. Occurrence 5B_9:2818:7304: scene=5B_9
#: 5B_9:2818
msgctxt "text_id=7304 | speaker=unknown"
msgid "　ぶんぶん、と草十郎は心底イヤそうな顔で首を振る。"
msgstr ""

#. Occurrence 5B_9:2830:7305: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0024; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2830
msgctxt "text_id=7305 | speaker=aoko"
msgid "「でしょ？　なら急ぎましょ。色々余裕ないんだから」"
msgstr ""

#. Occurrence 5B_9:2881:7306: scene=5B_9
#: 5B_9:2881
msgctxt "text_id=7306 | speaker=unknown"
msgid "　青子は短く深呼吸をして、駆け足を再開する。"
msgstr ""

#. Occurrence 5B_9:2886:7307: scene=5B_9
#: 5B_9:2886
msgctxt "text_id=7307 | speaker=unknown"
msgid "　視界<遥|はる>か、霧の向こうの鉄柵まであと三百メートルほど。"
msgstr ""

#. Occurrence 5B_9:2891:7308: scene=5B_9
#: 5B_9:2891
msgctxt "text_id=7308 | speaker=unknown"
msgid "　……このまま何事もなければ無事にたどり着けるかもしれない。"
msgstr ""

#. Occurrence 5B_9:2901:7309: scene=5B_9
#: 5B_9:2901
msgctxt "text_id=7309 | speaker=unknown"
msgid "　そんな都合のいい希望を抱きながら、草十郎は青子の後に続いていった。"
msgstr ""

#. Occurrence 6_1:49:7310: scene=6_1
#: 6_1:49
msgctxt "text_id=7310 | speaker=unknown"
msgid "　彼はまだ、深い眠りの中にいる―――"
msgstr ""

#. Occurrence 6_1:88:7311: scene=6_1
#: 6_1:88
msgctxt "text_id=7311 | speaker=unknown"
msgid "　それは一面の、燃えるような<茜|あかね>色だった。"
msgstr ""

#. Occurrence 6_1:96:7312: scene=6_1
#: 6_1:96
msgctxt "text_id=7312 | speaker=unknown"
msgid "　<忍|しの>びない雑念。"
msgstr ""

#. Occurrence 6_1:101:7313: scene=6_1
#: 6_1:101
msgctxt "text_id=7313 | speaker=unknown"
msgid "　絶え間のない<我執|がしゅう>。"
msgstr ""

#. Occurrence 6_1:106:7314: scene=6_1
#: 6_1:106
msgctxt "text_id=7314 | speaker=unknown"
msgid "　見るも悲哀、語るも<陰鬱|いんうつ>な<悲喜交々|ひきこもごも>。"
msgstr ""

#. Occurrence 6_1:111:7315: scene=6_1
#: 6_1:111
msgctxt "text_id=7315 | speaker=unknown"
msgid "　人と人の<交|まじ>わりから生じる<有為|うい><悪作|あくさ>。"
msgstr ""

#. Occurrence 6_1:116:7316: scene=6_1
#: 6_1:116
msgctxt "text_id=7316 | speaker=unknown"
msgid "　即ち、救いようのない共存の<声|おと>。"
msgstr ""

#. Occurrence 6_1:122:7317: scene=6_1
#: 6_1:122
msgctxt "text_id=7317 | speaker=unknown"
msgid "　これはその一切から、あまりにも遠い世界の<風景|はなし>。"
msgstr ""

#. Occurrence 6_1:142:7318: scene=6_1
#: 6_1:142
msgctxt "text_id=7318 | speaker=unknown"
msgid "　天上<楽土|らくど>と手を合わせる者もいれば、"
msgstr ""

#. Occurrence 6_1:147:7319: scene=6_1
#: 6_1:147
msgctxt "text_id=7319 | speaker=unknown"
msgid "　死後の<幽世|かくりよ>と目を伏せる者もいるだろう。"
msgstr ""

#. Occurrence 6_1:152:7320: scene=6_1
#: 6_1:152
msgctxt "text_id=7320 | speaker=unknown"
msgid "　あと十年、"
msgstr ""

#. Occurrence 6_1:157:7321: scene=6_1
#: 6_1:157
msgctxt "text_id=7321 | speaker=unknown"
msgid "　あるいは何十年後かにはあり方を変えていく、いまだ人の靴を知らぬ<紅葉|こうよう>の海。"
msgstr ""

#. Occurrence 6_1:163:7322: scene=6_1
#: 6_1:163
msgctxt "text_id=7322 | speaker=unknown"
msgid "　それが、彼にとって当たり前の風景だった。"
msgstr ""

#. Occurrence 6_1:205:7323: scene=6_1
#: 6_1:205
msgctxt "text_id=7323 | speaker=unknown"
msgid "　<山中|さんちゅう>において人間の<営|いとな>みは<慎|つつ>ましくささやかだ。"
msgstr ""

#. Occurrence 6_1:210:7324: scene=6_1
#: 6_1:210
msgctxt "text_id=7324 | speaker=unknown"
msgid "　彼の住まいである山にも、向かいのお山にも目立つほどの建物はない。"
msgstr ""

#. Occurrence 6_1:215:7325: scene=6_1
#: 6_1:215
msgctxt "text_id=7325 | speaker=unknown"
msgid "　衣食住に関する事柄は必要な分だけ、多くを奪うことなく積み重ねられている。"
msgstr ""

#. Occurrence 6_1:235:7326: scene=6_1
#: 6_1:235
msgctxt "text_id=7326 | speaker=unknown"
msgid "　見れば蛇のように身をくねらせる野道や、<頂|いただき>に続く石段なども造られているが、それも山中に踏み入らなければ気付かない程度だ。"
msgstr ""

#. Occurrence 6_1:240:7327: scene=6_1
#: 6_1:240
msgctxt "text_id=7327 | speaker=unknown"
msgid "　この山で暮らす者たちの方針だろう。"
msgstr ""

#. Occurrence 6_1:245:7328: scene=6_1
#: 6_1:245
msgctxt "text_id=7328 | speaker=unknown"
msgid "　人の手によるもので、山の景色を損なう物は一つもない。"
msgstr ""

#. Occurrence 6_1:291:7329: scene=6_1
#: 6_1:291
msgctxt "text_id=7329 | speaker=unknown"
msgid "　ふと、この<季節|しきさい>が一番好きだった事を思い出す。"
msgstr ""

#. Occurrence 6_1:296:7330: scene=6_1
#: 6_1:296
msgctxt "text_id=7330 | speaker=unknown"
msgid "　好きというより己の性に合っていた。"
msgstr ""

#. Occurrence 6_1:301:7331: scene=6_1
#: 6_1:301
msgctxt "text_id=7331 | speaker=unknown"
msgid "　冬に備えてやるべき事は山積みだったが、<暇|ひま>を見付けては<頂|いただき>近くにまで足を運んだ。"
msgstr ""

#. Occurrence 6_1:306:7332: scene=6_1
#: 6_1:306
msgctxt "text_id=7332 | speaker=unknown"
msgid "　深く呼吸をして、ぼんやりと斜陽の<兆|きざ>しを眺めていた時が、たぶん、毎日で二番目ぐらいに幸せだった。"
msgstr ""

#. Occurrence 6_1:374:7333: scene=6_1
#: 6_1:374
msgctxt "text_id=7333 | speaker=unknown"
msgid "　茜の山をいっそう赤く染める夕日。"
msgstr ""

#. Occurrence 6_1:379:7334: scene=6_1
#: 6_1:379
msgctxt "text_id=7334 | speaker=unknown"
msgid "　<黄昏|たそがれ>時に吹く風は冷たくも、安らげるものだった。"
msgstr ""

#. Occurrence 6_1:384:7335: scene=6_1
#: 6_1:384
msgctxt "text_id=7335 | speaker=unknown"
msgid "　山を下りてからまだ二ヶ月も<経|た>っていないのに、記憶が<薄|うす>れている事が少し<淋|さみ>しい。"
msgstr ""

#. Occurrence 6_1:389:7336: scene=6_1
#: 6_1:389
msgctxt "text_id=7336 | speaker=unknown"
msgid "　日々の記憶は薄れていくから、それに負けないように思い出は重ねていくしかないのだと、誰かが口にしていたっけ。"
msgstr ""

#. Occurrence 6_1:411:7337: scene=6_1
#: 6_1:411
msgctxt "text_id=7337 | speaker=unknown"
msgid "　思い出はかくも<霞|かす>んでいく。"
msgstr ""

#. Occurrence 6_1:416:7338: scene=6_1
#: 6_1:416
msgctxt "text_id=7338 | speaker=unknown"
msgid "　住む場所が変われば、新しい生活は始まっていく。"
msgstr ""

#. Occurrence 6_1:421:7339: scene=6_1
#: 6_1:421
msgctxt "text_id=7339 | speaker=unknown"
msgid "　その中で、長く親しんできた景色を引きずるのは<贅沢|ぜいたく>なのか、未練なのか。"
msgstr ""

#. Occurrence 6_1:426:7340: scene=6_1
#: 6_1:426
msgctxt "text_id=7340 | speaker=unknown"
msgid "　<現在|いま>の住み家は高いビルディングに囲まれた都会なのに、この記憶だけは鮮明であってほしいと思うのが後ろめたい。"
msgstr ""

#. Occurrence 6_1:446:7341: scene=6_1
#: 6_1:446
msgctxt "text_id=7341 | speaker=unknown"
msgid "　なにしろせっかくの新生活。"
msgstr ""

#. Occurrence 6_1:451:7342: scene=6_1
#: 6_1:451
msgctxt "text_id=7342 | speaker=unknown"
msgid "　新居より故郷を思うのはちょっと、男としてどうか、と彼は生真面目に反省して、"
msgstr ""

#. Occurrence 6_1:476:7343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0000; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:476
msgctxt "text_id=7343 | speaker=soujuurou"
msgid "「そうか。これ、夢だ」"
msgstr ""

#. Occurrence 6_1:482:7344: scene=6_1
#: 6_1:482
msgctxt "text_id=7344 | speaker=unknown"
msgid "　そう、ガラにもなく<耽|ふけ>っていた感傷を止めてみた。"
msgstr ""

#. Occurrence 6_1:487:7345: scene=6_1
#: 6_1:487
msgctxt "text_id=7345 | speaker=unknown"
msgid "　我が事ながら、何の迷いもなく夢と<判|わか>ってしまうあたり夢がない、と思いながら。"
msgstr ""

#. Occurrence 6_1:564:7346: scene=6_1
#: 6_1:564
msgctxt "text_id=7346 | speaker=unknown"
msgid "　夢と断じた途端、紅葉に鋭角な影がそびえ立っていく。"
msgstr ""

#. Occurrence 6_1:569:7347: scene=6_1
#: 6_1:569
msgctxt "text_id=7347 | speaker=unknown"
msgid "　それはかつて知らず、今は<既|き><知|ち>となったコンクリートの建物たちだ。"
msgstr ""

#. Occurrence 6_1:574:7348: scene=6_1
#: 6_1:574
msgctxt "text_id=7348 | speaker=unknown"
msgid "　思い出はこうやって、今の暮らしに<融|と>かされていく。"
msgstr ""

#. Occurrence 6_1:579:7349: scene=6_1
#: 6_1:579
msgctxt "text_id=7349 | speaker=unknown"
msgid "　もとより人間の記憶、人間の印象は、どうあがこうと劣化していく。"
msgstr ""

#. Occurrence 6_1:599:7350: scene=6_1
#: 6_1:599
msgctxt "text_id=7350 | speaker=unknown"
msgid "　それは仕方のない事だ。"
msgstr ""

#. Occurrence 6_1:604:7351: scene=6_1
#: 6_1:604
msgctxt "text_id=7351 | speaker=unknown"
msgid "　何であれ、人間は過去より今に期待するものだし。"
msgstr ""

#. Occurrence 6_1:609:7352: scene=6_1
#: 6_1:609
msgctxt "text_id=7352 | speaker=unknown"
msgid "　いずれ過去の思い出でさえ、ビルディングに飲みこまれていくだろう。"
msgstr ""

#. Occurrence 6_1:614:7353: scene=6_1
#: 6_1:614
msgctxt "text_id=7353 | speaker=unknown"
msgid "　無情も薄情もない。"
msgstr ""

#. Occurrence 6_1:619:7354: scene=6_1
#: 6_1:619
msgctxt "text_id=7354 | speaker=unknown"
msgid "　かならず消えると予感しているのなら、今はただ、鮮明に思いだせる記憶を夢見ていればいい。"
msgstr ""

#. Occurrence 6_1:639:7355: scene=6_1
#: 6_1:639
msgctxt "text_id=7355 | speaker=unknown"
msgid "　山であろうと町であろうと、日々はもとより一瞬だ。"
msgstr ""

#. Occurrence 6_1:644:7356: scene=6_1
#: 6_1:644
msgctxt "text_id=7356 | speaker=unknown"
msgid "　たとえ一日後の今日でも、昨日と同じ風景はどこにもないのだから。"
msgstr ""

#. Occurrence 6_1:653:7357: scene=6_1
#: 6_1:653
msgctxt "text_id=7357 | speaker=unknown"
msgid "　…………などと。"
msgstr ""

#. Occurrence 6_1:658:7358: scene=6_1
#: 6_1:658
msgctxt "text_id=7358 | speaker=unknown"
msgid "　しんみりする暇を、彼女はまったく与えてくれなかった。"
msgstr ""

#. Occurrence 6_1:663:7359: scene=6_1
#: 6_1:663
msgctxt "text_id=7359 | speaker=unknown"
msgid "　<懐|なつ>かしく遠い記憶は、美しいが故に<儚|はかな>いらしい。"
msgstr ""

#. Occurrence 6_1:684:7360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0001; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:684
msgctxt "text_id=7360 | speaker=soujuurou"
msgid "「……<見|み><上|あ>げ<入道|にゅうどう>じゃないんだぞ、蒼崎」"
msgstr ""

#. Occurrence 6_1:713:7361: scene=6_1
#: 6_1:713
msgctxt "text_id=7361 | speaker=unknown"
msgid "　軽い目眩から目を閉じる。"
msgstr ""

#. Occurrence 6_1:718:7362: scene=6_1
#: 6_1:718
msgctxt "text_id=7362 | speaker=unknown"
msgid "　<視界|いしき>を切ったことで山の風景は見えなくなり、かわりに聞き覚えのある声が響いてきた。"
msgstr ""

#. Occurrence 6_1:723:7363: scene=6_1
#: 6_1:723
msgctxt "text_id=7363 | speaker=unknown"
msgid "　彼のいる山の中腹はおろか、山全体を震わすような大声だ。"
msgstr ""

#. Occurrence 6_1:766:7364: scene=6_1
#: 6_1:766
msgctxt "text_id=7364 | speaker=unknown"
msgid "　それも当然で、さっき幻のように現れた蒼崎青子は山の向こうにでーんとそびえていたのだ。"
msgstr ""

#. Occurrence 6_1:771:7365: scene=6_1
#: 6_1:771
msgctxt "text_id=7365 | speaker=unknown"
msgid "　本当に疲れてるんだな、と彼は自分の状態を確認しつつ、彼女の声に気を<配|くば>った。"
msgstr ""

#. Occurrence 6_1:776:7366: scene=6_1
#: 6_1:776
msgctxt "text_id=7366 | speaker=unknown"
msgid "　目を開けているとまた目眩がしそうなので、目は閉じたままである。"
msgstr ""

#. Occurrence 6_1:812:7367: scene=6_1
#: 6_1:812
msgctxt "text_id=7367 | speaker=unknown"
msgid "　……おおよその雰囲気しか分からないが、彼女は誰かと口論しているようだった。"
msgstr ""

#. Occurrence 6_1:817:7368: scene=6_1
#: 6_1:817
msgctxt "text_id=7368 | speaker=unknown"
msgid "　激しくはないが攻撃的な口調。"
msgstr ""

#. Occurrence 6_1:822:7369: scene=6_1
#: 6_1:822
msgctxt "text_id=7369 | speaker=unknown"
msgid "　たぶん向かいの山にでも喧嘩を売っているのだろう。"
msgstr ""

#. Occurrence 6_1:827:7370: scene=6_1
#: 6_1:827
msgctxt "text_id=7370 | speaker=unknown"
msgid "　彼女なら十分にありえる、と彼はひとり頷いた。"
msgstr ""

#. Occurrence 6_1:832:7371: scene=6_1
#: 6_1:832
msgctxt "text_id=7371 | speaker=unknown"
msgid "　なにしろ月まで吹っ飛ばした暴れん坊だ。"
msgstr ""

#. Occurrence 6_1:901:7372: scene=6_1
#: 6_1:901
msgctxt "text_id=7372 | speaker=unknown"
msgid "　会話の内容はよく掴めない。"
msgstr ""

#. Occurrence 6_1:906:7373: scene=6_1
#: 6_1:906
msgctxt "text_id=7373 | speaker=unknown"
msgid "　彼はなんとなく、漠然と、自分の人権あたりが盛大に無視されている気がした。……いかに夢中の出来事とはいえ、<甚|はなは>だよろしくない。"
msgstr ""

#. Occurrence 6_1:911:7374: scene=6_1
#: 6_1:911
msgctxt "text_id=7374 | speaker=unknown"
msgid "　数分の後。"
msgstr ""

#. Occurrence 6_1:916:7375: scene=6_1
#: 6_1:916
msgctxt "text_id=7375 | speaker=unknown"
msgid "　大迫力の口論は、青子側の勝利で終わったらしい。"
msgstr ""

#. Occurrence 6_1:939:7376: scene=6_1
#: 6_1:939
msgctxt "text_id=7376 | speaker=unknown"
msgid "　そうして、強風のようだった声も聞こえなくなった。"
msgstr ""

#. Occurrence 6_1:944:7377: scene=6_1
#: 6_1:944
msgctxt "text_id=7377 | speaker=unknown"
msgid "　次はマトモな光景でありますように、と他力本願<気|ぎ><味|み>に目を開ける。"
msgstr ""

#. Occurrence 6_1:1027:7378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0002; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1027
msgctxt "text_id=7378 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_1:1033:7379: scene=6_1
#: 6_1:1033
msgctxt "text_id=7379 | speaker=unknown"
msgid "　わずかに息をのむ。"
msgstr ""

#. Occurrence 6_1:1038:7380: scene=6_1
#: 6_1:1038
msgctxt "text_id=7380 | speaker=unknown"
msgid "　先ほどまでの懐かしい記憶とは何もかも違う、けれど、そう嫌いでもない風景。"
msgstr ""

#. Occurrence 6_1:1043:7381: scene=6_1
#: 6_1:1043
msgctxt "text_id=7381 | speaker=unknown"
msgid "　確かめるまでもなく、そこはあの遊園地だった。"
msgstr ""

#. Occurrence 6_1:1063:7382: scene=6_1
#: 6_1:1063
msgctxt "text_id=7382 | speaker=unknown"
msgid "　彼にとって最も鮮明な<過去|いぜん>の記憶。"
msgstr ""

#. Occurrence 6_1:1068:7383: scene=6_1
#: 6_1:1068
msgctxt "text_id=7383 | speaker=unknown"
msgid "　蒼崎青子が爆破したミラーハウスが懐かしい。"
msgstr ""

#. Occurrence 6_1:1073:7384: scene=6_1
#: 6_1:1073
msgctxt "text_id=7384 | speaker=unknown"
msgid "　現実と寸分の狂いもない遊園地だが、今いるのは彼だけだ。"
msgstr ""

#. Occurrence 6_1:1078:7385: scene=6_1
#: 6_1:1078
msgctxt "text_id=7385 | speaker=unknown"
msgid "　誰に追いかけられる心配もないので、キッツィーちゃんの残骸に腰を下ろして、撃ち抜かれた筈の月を見上げた。"
msgstr ""

#. Occurrence 6_1:1138:7386: scene=6_1
#: 6_1:1138
msgctxt "text_id=7386 | speaker=unknown"
msgid "　白い、<玻璃|はり>を思わせる冬の月。"
msgstr ""

#. Occurrence 6_1:1143:7387: scene=6_1
#: 6_1:1143
msgctxt "text_id=7387 | speaker=unknown"
msgid "　その月を背に、彼を殺そうとした少女の姿が重なった。"
msgstr ""

#. Occurrence 6_1:1148:7388: scene=6_1
#: 6_1:1148
msgctxt "text_id=7388 | speaker=unknown"
msgid "　……魔術師が魔女だと言うのなら、あの瞬間の彼女は確かにそうだったのだろう。"
msgstr ""

#. Occurrence 6_1:1153:7389: scene=6_1
#: 6_1:1153
msgctxt "text_id=7389 | speaker=unknown"
msgid "“殺されてもいい”"
msgstr ""

#. Occurrence 6_1:1158:7390: scene=6_1
#: 6_1:1158
msgctxt "text_id=7390 | speaker=unknown"
msgid "　そんな、あまりにも馬鹿げた言葉が、ごく自然にこぼれたぐらいには。"
msgstr ""

#. Occurrence 6_1:1179:7391: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0004; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1179
msgctxt "text_id=7391 | speaker=soujuurou"
msgid "「……いや、でも―――」"
msgstr ""

#. Occurrence 6_1:1185:7392: scene=6_1
#: 6_1:1185
msgctxt "text_id=7392 | speaker=unknown"
msgid "　あれは魔女やら魔術やらとは関係ない。"
msgstr ""

#. Occurrence 6_1:1190:7393: scene=6_1
#: 6_1:1190
msgctxt "text_id=7393 | speaker=unknown"
msgid "　<胸|こころ>の隙をついた響き。"
msgstr ""

#. Occurrence 6_1:1195:7394: scene=6_1
#: 6_1:1195
msgctxt "text_id=7394 | speaker=unknown"
msgid "　彼女があんな言葉さえ口にしなければ、彼もあんな言葉を返さなかった。"
msgstr ""

#. Occurrence 6_1:1218:7395: scene=6_1
#: 6_1:1218
msgctxt "text_id=7395 | speaker=unknown"
msgid "　……あのとき、蒼崎青子はどんな言葉を投げたのか。"
msgstr ""

#. Occurrence 6_1:1223:7396: scene=6_1
#: 6_1:1223
msgctxt "text_id=7396 | speaker=unknown"
msgid "　それを思い出そうとしているうちに、深かった彼の眠りは終わりを告げた。"
msgstr ""

#. Occurrence 6_1:1229:7397: scene=6_1
#: 6_1:1229
msgctxt "text_id=7397 | speaker=unknown"
msgid "　もしかすると、夢見より長かった回想の答えもないままに。"
msgstr ""

#. Occurrence 6_2:61:7398: scene=6_2
#: 6_2:61
msgctxt "text_id=7398 | speaker=unknown"
msgid "　……そうして。"
msgstr ""

#. Occurrence 6_2:66:7399: scene=6_2
#: 6_2:66
msgctxt "text_id=7399 | speaker=unknown"
msgid "　見知らぬ部屋のベッドで目を覚ました瞬間、草十郎は大きく息を呑んだ。"
msgstr ""

#. Occurrence 6_2:71:7400: scene=6_2
#: 6_2:71
msgctxt "text_id=7400 | speaker=unknown"
msgid "　アパートの安布団とは段違いのベッドの感触や、"
msgstr ""

#. Occurrence 6_2:76:7401: scene=6_2
#: 6_2:76
msgctxt "text_id=7401 | speaker=unknown"
msgid "　絨毯はおろか壁紙まで高価そうな部屋の雰囲気に……ではなく。"
msgstr ""

#. Occurrence 6_2:105:7402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0000; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:105
msgctxt "text_id=7402 | speaker=soujuurou"
msgid "「―――、―――」"
msgstr ""

#. Occurrence 6_2:111:7403: scene=6_2
#: 6_2:111
msgctxt "text_id=7403 | speaker=unknown"
msgid "　眼を白黒させたまま、こぼれかけた息を呑みこむ。"
msgstr ""

#. Occurrence 6_2:116:7404: scene=6_2
#: 6_2:116
msgctxt "text_id=7404 | speaker=unknown"
msgid "　驚きの<原因|モト>はそれだ。"
msgstr ""

#. Occurrence 6_2:121:7405: scene=6_2
#: 6_2:121
msgctxt "text_id=7405 | speaker=unknown"
msgid "　草十郎がぱちりと目を覚ました<傍|かたわ>らに、あの、黒衣の少女が座っていた。"
msgstr ""

#. Occurrence 6_2:157:7406: scene=6_2
#: 6_2:157
msgctxt "text_id=7406 | speaker=unknown"
msgid "　物音ひとつない静寂だった。"
msgstr ""

#. Occurrence 6_2:162:7407: scene=6_2
#: 6_2:162
msgctxt "text_id=7407 | speaker=unknown"
msgid "　草十郎はベッドに横になったまま少女を見つめる。"
msgstr ""

#. Occurrence 6_2:167:7408: scene=6_2
#: 6_2:167
msgctxt "text_id=7408 | speaker=unknown"
msgid "　なんとなく<上半身|からだ>を起こしたい衝動にかられもしたが、真っ正面からまじまじと見るのは無遠慮かもしれない、と思いとどまった。"
msgstr ""

#. Occurrence 6_2:223:7409: scene=6_2
#: 6_2:223
msgctxt "text_id=7409 | speaker=unknown"
msgid "　少女は椅子に座っているようだ。"
msgstr ""

#. Occurrence 6_2:228:7410: scene=6_2
#: 6_2:228
msgctxt "text_id=7410 | speaker=unknown"
msgid "　黒い、飾り気のない服装。"
msgstr ""

#. Occurrence 6_2:233:7411: scene=6_2
#: 6_2:233
msgctxt "text_id=7411 | speaker=unknown"
msgid "　そのくせ質素な印象はなく、単色なのに言いようのない気品を感じる。"
msgstr ""

#. Occurrence 6_2:238:7412: scene=6_2
#: 6_2:238
msgctxt "text_id=7412 | speaker=unknown"
msgid "　高級な繊維で作られた、この少女の為の装飾―――"
msgstr ""

#. Occurrence 6_2:243:7413: scene=6_2
#: 6_2:243
msgctxt "text_id=7413 | speaker=unknown"
msgid "　そんな詩的な感想を、草十郎をして抱かせるほどの。"
msgstr ""

#. Occurrence 6_2:281:7414: scene=6_2
#: 6_2:281
msgctxt "text_id=7414 | speaker=unknown"
msgid "　少女は座ったままぴくりとも動かない。"
msgstr ""

#. Occurrence 6_2:287:7415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0001; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:287
msgctxt "text_id=7415 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_2:292:7416: scene=6_2
#: 6_2:292
msgctxt "text_id=7416 | speaker=unknown"
msgid "　草十郎の呼吸は知らず止まっていた。"
msgstr ""

#. Occurrence 6_2:297:7417: scene=6_2
#: 6_2:297
msgctxt "text_id=7417 | speaker=unknown"
msgid "　呼吸を忘れて少女に見入ったのは、純粋な驚きからだ。"
msgstr ""

#. Occurrence 6_2:302:7418: scene=6_2
#: 6_2:302
msgctxt "text_id=7418 | speaker=unknown"
msgid "　ただ美しい。"
msgstr ""

#. Occurrence 6_2:307:7419: scene=6_2
#: 6_2:307
msgctxt "text_id=7419 | speaker=unknown"
msgid "　その、あまりにも単純で、あんまりにも理由のない表現を同じ<人間|いきもの>に用いたのは、初めてのことだった。"
msgstr ""

#. Occurrence 6_2:357:7420: scene=6_2
#: 6_2:357
msgctxt "text_id=7420 | speaker=unknown"
msgid "　純潔のまま成長した<水仙|すいせん>の花。"
msgstr ""

#. Occurrence 6_2:363:7421: scene=6_2
#: 6_2:363
msgctxt "text_id=7421 | speaker=unknown"
msgid "　あるいは、夢に描かれた理想の少女像。"
msgstr ""

#. Occurrence 6_2:409:7422: scene=6_2
#: 6_2:409
msgctxt "text_id=7422 | speaker=unknown"
msgid "　少女のソレは、鑑賞され、愛でられる為の美しさだ。"
msgstr ""

#. Occurrence 6_2:414:7423: scene=6_2
#: 6_2:414
msgctxt "text_id=7423 | speaker=unknown"
msgid "　蒼崎青子の華やかな、生命に満ちた輝きとは違う。"
msgstr ""

#. Occurrence 6_2:419:7424: scene=6_2
#: 6_2:419
msgctxt "text_id=7424 | speaker=unknown"
msgid "　なぜなら、生命あるかぎり人は老いて尽きる。"
msgstr ""

#. Occurrence 6_2:424:7425: scene=6_2
#: 6_2:424
msgctxt "text_id=7425 | speaker=unknown"
msgid "　そのような結末―――幸福な完結は、この少女には許される筈がない。"
msgstr ""

#. Occurrence 6_2:444:7426: scene=6_2
#: 6_2:444
msgctxt "text_id=7426 | speaker=unknown"
msgid "　それはこの<奇跡|カタチ>のまま生まれ、このカタチのまま滅び去るひとつの<寓話|ぐうわ>。"
msgstr ""

#. Occurrence 6_2:449:7427: scene=6_2
#: 6_2:449
msgctxt "text_id=7427 | speaker=unknown"
msgid "　生まれながらに人間としての生を奪われた、この世ならざる命のあり方。"
msgstr ""

#. Occurrence 6_2:455:7428: scene=6_2
#: 6_2:455
msgctxt "text_id=7428 | speaker=unknown"
msgid "　……<過|か><度|ど>に美しいものほど、結末は<無惨|むざん>なものになる。"
msgstr ""

#. Occurrence 6_2:460:7429: scene=6_2
#: 6_2:460
msgctxt "text_id=7429 | speaker=unknown"
msgid "　山奥育ちの草十郎にとって、それは教えられるまでもなく経験している事だった。"
msgstr ""

#. Occurrence 6_2:514:7430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0002; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:514
msgctxt "text_id=7430 | speaker=soujuurou"
msgid "『……眠ってるみたいだ』"
msgstr ""

#. Occurrence 6_2:523:7431: scene=6_2
#: 6_2:523
msgctxt "text_id=7431 | speaker=unknown"
msgid "　草十郎は誘われるように、首を横に向ける。"
msgstr ""

#. Occurrence 6_2:528:7432: scene=6_2
#: 6_2:528
msgctxt "text_id=7432 | speaker=unknown"
msgid "　横顔を盗み見るのは無遠慮だと知りつつ、本能には逆らえなかった。"
msgstr ""

#. Occurrence 6_2:533:7433: scene=6_2
#: 6_2:533
msgctxt "text_id=7433 | speaker=unknown"
msgid "　そうして―――"
msgstr ""

#. Occurrence 6_2:599:7434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0003; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:599
msgctxt "text_id=7434 | speaker=soujuurou"
msgid "「……え？」"
msgstr ""

#. Occurrence 6_2:605:7435: scene=6_2
#: 6_2:605
msgctxt "text_id=7435 | speaker=unknown"
msgid "　今度こそ本当に、一瞬、心臓が止まった。"
msgstr ""

#. Occurrence 6_2:610:7436: scene=6_2
#: 6_2:610
msgctxt "text_id=7436 | speaker=unknown"
msgid "　少女は眠ってなどいなかった。"
msgstr ""

#. Occurrence 6_2:615:7437: scene=6_2
#: 6_2:615
msgctxt "text_id=7437 | speaker=unknown"
msgid "　無表情に、横たわる怪我人を見つめていただけだったのだ。"
msgstr ""

#. Occurrence 6_2:673:7438: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0004; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:673
msgctxt "text_id=7438 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 6_2:678:7439: scene=6_2
#: 6_2:678
msgctxt "text_id=7439 | speaker=unknown"
msgid "　草十郎はベッドに横になったまま、動かした首を戻す事もできず、かといって気のきいた台詞も浮かばず、少女と無言で見つめあう。"
msgstr ""

#. Occurrence 6_2:698:7440: scene=6_2
#: 6_2:698
msgctxt "text_id=7440 | speaker=unknown"
msgid "　……<華奢|きゃしゃ>な輪郭からか、自分よりいくぶん幼く見える。"
msgstr ""

#. Occurrence 6_2:703:7441: scene=6_2
#: 6_2:703
msgctxt "text_id=7441 | speaker=unknown"
msgid "　反面、落ち着いた表情が年上のようにも感じさせた。"
msgstr ""

#. Occurrence 6_2:708:7442: scene=6_2
#: 6_2:708
msgctxt "text_id=7442 | speaker=unknown"
msgid "　肩口までの髪はにごりのない黒。"
msgstr ""

#. Occurrence 6_2:713:7443: scene=6_2
#: 6_2:713
msgctxt "text_id=7443 | speaker=unknown"
msgid "　そんな髪に合わせたように、大きめの瞳も混ざり気のない黒一色。"
msgstr ""

#. Occurrence 6_2:752:7444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0005; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:752
msgctxt "text_id=7444 | speaker=soujuurou"
msgid "「……………………」"
msgstr ""

#. Occurrence 6_2:758:7445: scene=6_2
#: 6_2:758
msgctxt "text_id=7445 | speaker=unknown"
msgid "　少女は感情のない瞳を草十郎に向けている。"
msgstr ""

#. Occurrence 6_2:763:7446: scene=6_2
#: 6_2:763
msgctxt "text_id=7446 | speaker=unknown"
msgid "　草十郎と見つめ合うカタチになっても目は逸らさない。"
msgstr ""

#. Occurrence 6_2:796:7447: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0006; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:796
msgctxt "text_id=7447 | speaker=soujuurou"
msgid "「…………………………」"
msgstr ""

#. Occurrence 6_2:802:7448: scene=6_2
#: 6_2:802
msgctxt "text_id=7448 | speaker=unknown"
msgid "　草十郎は声をかけようにもかけられない。"
msgstr ""

#. Occurrence 6_2:807:7449: scene=6_2
#: 6_2:807
msgctxt "text_id=7449 | speaker=unknown"
msgid "　蛇に睨まれた蛙、という程でもないけれど、いま少女に話しかけるのは<躊躇|ためら>われた。"
msgstr ""

#. Occurrence 6_2:812:7450: scene=6_2
#: 6_2:812
msgctxt "text_id=7450 | speaker=unknown"
msgid "　それに、"
msgstr ""

#. Occurrence 6_2:906:7451: scene=6_2
#: 6_2:906
msgctxt "text_id=7451 | speaker=unknown"
msgid "　いかに<暢気|のんき>な草十郎でも、この少女が青子と同じ種類の<爆|にん><弾|げん>である事は身に染みて知っていた。"
msgstr ""

#. Occurrence 6_2:912:7452: scene=6_2
#: 6_2:912
msgctxt "text_id=7452 | speaker=unknown"
msgid "　一方、少女は少女で<堅|かた>く口を閉ざしている。"
msgstr ""

#. Occurrence 6_2:917:7453: scene=6_2
#: 6_2:917
msgctxt "text_id=7453 | speaker=unknown"
msgid "　一心に、雑念なく、横になった異邦人を看病する……ような雰囲気。"
msgstr ""

#. Occurrence 6_2:952:7454: scene=6_2
#: 6_2:952
msgctxt "text_id=7454 | speaker=unknown"
msgid "　少女が何を考えているかは不明だが、草十郎にとっては辛い沈黙が続いていく。"
msgstr ""

#. Occurrence 6_2:957:7455: scene=6_2
#: 6_2:957
msgctxt "text_id=7455 | speaker=unknown"
msgid "　草十郎に分かるのは、少女はこの沈黙をまったく気にしていない、という事だけ。"
msgstr ""

#. Occurrence 6_2:962:7456: scene=6_2
#: 6_2:962
msgctxt "text_id=7456 | speaker=unknown"
msgid "　これでは何らかの罰ゲーム、<罰則|ペナルティ>と言えなくもない。"
msgstr ""

#. Occurrence 6_2:988:7457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0007; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:988
msgctxt "text_id=7457 | speaker=soujuurou"
msgid "『……。これが蒼崎の仕込みなら手がこみすぎる……』"
msgstr ""

#. Occurrence 6_2:994:7458: scene=6_2
#: 6_2:994
msgctxt "text_id=7458 | speaker=unknown"
msgid "　などと思いつつも、草十郎は少女から目を離せなかった。"
msgstr ""

#. Occurrence 6_2:999:7459: scene=6_2
#: 6_2:999
msgctxt "text_id=7459 | speaker=unknown"
msgid "　自分が首を戻したり目を閉じた瞬間、少女が隠し持ったナイフで自分の胸を刺すのでは……"
msgstr ""

#. Occurrence 6_2:1004:7460: scene=6_2
#: 6_2:1004
msgctxt "text_id=7460 | speaker=unknown"
msgid "　なんて想像をかきたてられたからではない。"
msgstr ""

#. Occurrence 6_2:1031:7461: scene=6_2
#: 6_2:1031
msgctxt "text_id=7461 | speaker=unknown"
msgid "　たしかに重苦しい沈黙で、遊園地での事を思い返すと不安になるけれど―――"
msgstr ""

#. Occurrence 6_2:1036:7462: scene=6_2
#: 6_2:1036
msgctxt "text_id=7462 | speaker=unknown"
msgid "　それ以上に少女は魅力的だと、彼は思ったのだ。"
msgstr ""

#. Occurrence 6_2:1084:7463: scene=6_2
#: 6_2:1084
msgctxt "text_id=7463 | speaker=unknown"
msgid "　細い体と白い肌。"
msgstr ""

#. Occurrence 6_2:1089:7464: scene=6_2
#: 6_2:1089
msgctxt "text_id=7464 | speaker=unknown"
msgid "　人を寄せ付けない瞳の冷たさと、いまだ残った少女の面影の温かさ。"
msgstr ""

#. Occurrence 6_2:1094:7465: scene=6_2
#: 6_2:1094
msgctxt "text_id=7465 | speaker=unknown"
msgid "　その二つが混ざりあった姿は、魔的なものと言ってもいい。"
msgstr ""

#. Occurrence 6_2:1115:7466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0008; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1115
msgctxt "text_id=7466 | speaker=soujuurou"
msgid "『…………？』"
msgstr ""

#. Occurrence 6_2:1120:7467: scene=6_2
#: 6_2:1120
msgctxt "text_id=7467 | speaker=unknown"
msgid "　そこまで少女と向き合って、草十郎は彼女とは以前会っているような気がした。"
msgstr ""

#. Occurrence 6_2:1125:7468: scene=6_2
#: 6_2:1125
msgctxt "text_id=7468 | speaker=unknown"
msgid "　遊園地の一件よりもう少し前。"
msgstr ""

#. Occurrence 6_2:1130:7469: scene=6_2
#: 6_2:1130
msgctxt "text_id=7469 | speaker=unknown"
msgid "　どこでだったかは思い出せないけれど、たしかに以前見かけた気がする。"
msgstr ""

#. Occurrence 6_2:1166:7470: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0009; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1166
msgctxt "text_id=7470 | speaker=soujuurou"
msgid "「その、いまさらだけど」"
msgstr ""

#. Occurrence 6_2:1172:7471: scene=6_2
#: 6_2:1172
msgctxt "text_id=7471 | speaker=unknown"
msgid "　凍りついた部屋に、白々しく響く自分の声。"
msgstr ""

#. Occurrence 6_2:1177:7472: scene=6_2
#: 6_2:1177
msgctxt "text_id=7472 | speaker=unknown"
msgid "　その場違いさに申し訳ない気持ちになりながら、草十郎は少女に語りかけた。"
msgstr ""

#. Occurrence 6_2:1182:7473: scene=6_2
#: 6_2:1182
msgctxt "text_id=7473 | speaker=unknown"
msgid "　いつまでも見つめ合っている訳にもいかない。"
msgstr ""

#. Occurrence 6_2:1187:7474: scene=6_2
#: 6_2:1187
msgctxt "text_id=7474 | speaker=unknown"
msgid "　……見つめ合っていると思っていたのは自分だけで、少女は睨み合っていたつもりかも知れないし。"
msgstr ""

#. Occurrence 6_2:1253:7475: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0010; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1253
msgctxt "text_id=7475 | speaker=soujuurou"
msgid "「ここはどこで、君は誰だか分かるかな」"
msgstr ""

#. Occurrence 6_2:1259:7476: scene=6_2
#: 6_2:1259
msgctxt "text_id=7476 | speaker=unknown"
msgid "　少女は黒い瞳をかすかに細める。"
msgstr ""

#. Occurrence 6_2:1264:7477: scene=6_2
#: 6_2:1264
msgctxt "text_id=7477 | speaker=unknown"
msgid "　気分を害した……風ではなさそうだ。"
msgstr ""

#. Occurrence 6_2:1285:7478: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0000; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1285
msgctxt "text_id=7478 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 6_2:1291:7479: scene=6_2
#: 6_2:1291
msgctxt "text_id=7479 | speaker=unknown"
msgid "　質問の返事はない。"
msgstr ""

#. Occurrence 6_2:1296:7480: scene=6_2
#: 6_2:1296
msgctxt "text_id=7480 | speaker=unknown"
msgid "　やっぱり黙ってよう、と草十郎が思った矢先、少女は静かに片腕を上げた。"
msgstr ""

#. Occurrence 6_2:1366:7481: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0001; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1366
msgctxt "text_id=7481 | speaker=alice"
msgid "「これ、あなたのでしょう」"
msgstr ""

#. Occurrence 6_2:1372:7482: scene=6_2
#: 6_2:1372
msgctxt "text_id=7482 | speaker=unknown"
msgid "　冷たいが、唄のような声。"
msgstr ""

#. Occurrence 6_2:1377:7483: scene=6_2
#: 6_2:1377
msgctxt "text_id=7483 | speaker=unknown"
msgid "　少女の指には白い布が<絡|から>まっている。"
msgstr ""

#. Occurrence 6_2:1382:7484: scene=6_2
#: 6_2:1382
msgctxt "text_id=7484 | speaker=unknown"
msgid "　それが何であるかなど、草十郎には語るまでもない。"
msgstr ""

#. Occurrence 6_2:1387:7485: scene=6_2
#: 6_2:1387
msgctxt "text_id=7485 | speaker=unknown"
msgid "　自分の持ち物を忘れるほど寝ぼけてはいなかったらしい。"
msgstr ""

#. Occurrence 6_2:1440:7486: scene=6_2
#: 6_2:1440
msgctxt "text_id=7486 | speaker=unknown"
msgid "　無言の草十郎に、少女はふわりと布を落とした。"
msgstr ""

#. Occurrence 6_2:1447:7487: scene=6_2
#: 6_2:1447
msgctxt "text_id=7487 | speaker=unknown"
msgid "　草十郎は布を拾い上げ、くるくると自分の首に巻く。"
msgstr ""

#. Occurrence 6_2:1501:7488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0002; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1501
msgctxt "text_id=7488 | speaker=alice"
msgid "「……青子は、それを知っているの？」"
msgstr ""

#. Occurrence 6_2:1507:7489: scene=6_2
#: 6_2:1507
msgctxt "text_id=7489 | speaker=unknown"
msgid "　ぶしつけな問いから、草十郎は目を逸らす。"
msgstr ""

#. Occurrence 6_2:1512:7490: scene=6_2
#: 6_2:1512
msgctxt "text_id=7490 | speaker=unknown"
msgid "　彼の頭に浮かんだのはまったく関係のない事だ。"
msgstr ""

#. Occurrence 6_2:1517:7491: scene=6_2
#: 6_2:1517
msgctxt "text_id=7491 | speaker=unknown"
msgid "　少女は蒼崎青子を『青子』と呼んだ。"
msgstr ""

#. Occurrence 6_2:1522:7492: scene=6_2
#: 6_2:1522
msgctxt "text_id=7492 | speaker=unknown"
msgid "　では、青子が喧嘩を売っていたのは向かいの山ではなく彼女だったのだろう、と。"
msgstr ""

#. Occurrence 6_2:1558:7493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0011; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1558
msgctxt "text_id=7493 | speaker=soujuurou"
msgid "「さあ、どうだろう」"
msgstr ""

#. Occurrence 6_2:1564:7494: scene=6_2
#: 6_2:1564
msgctxt "text_id=7494 | speaker=unknown"
msgid "　できるだけ真摯に、予断を<交|まじ>えず草十郎は返答する。"
msgstr ""

#. Occurrence 6_2:1584:7495: scene=6_2
#: 6_2:1584
msgctxt "text_id=7495 | speaker=unknown"
msgid "　知るべき事と、知らなくてもいい事。"
msgstr ""

#. Occurrence 6_2:1589:7496: scene=6_2
#: 6_2:1589
msgctxt "text_id=7496 | speaker=unknown"
msgid "　伝えるべき事と、伝わってはいけない事。"
msgstr ""

#. Occurrence 6_2:1594:7497: scene=6_2
#: 6_2:1594
msgctxt "text_id=7497 | speaker=unknown"
msgid "　少女の言う「それ」がどちらなのか、草十郎には考えられない。ただ、"
msgstr ""

#. Occurrence 6_2:1601:7498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0012; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1601
msgctxt "text_id=7498 | speaker=soujuurou"
msgid "「でも、その方がいいとは思うよ」"
msgstr ""

#. Occurrence 6_2:1618:7499: scene=6_2
#: 6_2:1618
msgctxt "text_id=7499 | speaker=unknown"
msgid "　ごく自然に、少女の問いに微笑んだ。"
msgstr ""

#. Occurrence 6_2:1638:7500: scene=6_2
#: 6_2:1638
msgctxt "text_id=7500 | speaker=unknown"
msgid "　そんな草十郎の対応に感じ入るものがあったのか、部屋を支配していた重圧は目に見えて薄れていった。"
msgstr ""

#. Occurrence 6_2:1643:7501: scene=6_2
#: 6_2:1643
msgctxt "text_id=7501 | speaker=unknown"
msgid "　もしかすると、緊張の度合いは草十郎より少女の方が上だったのかも知れない。"
msgstr ""

#. Occurrence 6_2:1648:7502: scene=6_2
#: 6_2:1648
msgctxt "text_id=7502 | speaker=unknown"
msgid "　……この場を支配していた少女の心の在り方が、部屋に投影されていたのなら。"
msgstr ""

#. Occurrence 6_2:1707:7503: scene=6_2
#: 6_2:1707
msgctxt "text_id=7503 | speaker=unknown"
msgid "　緊張は消えた。"
msgstr ""

#. Occurrence 6_2:1720:7504: scene=6_2
#: 6_2:1720
msgctxt "text_id=7504 | speaker=unknown"
msgid "　草十郎は体を起こそうとベッドに腕をたてる。"
msgstr ""

#. Occurrence 6_2:1725:7505: scene=6_2
#: 6_2:1725
msgctxt "text_id=7505 | speaker=unknown"
msgid "　こうして話し合える以上、寝たままなのは不便だと思ったらしい。"
msgstr ""

#. Occurrence 6_2:1730:7506: scene=6_2
#: 6_2:1730
msgctxt "text_id=7506 | speaker=unknown"
msgid "　が。起きようとした途端、体の異様なだるさに驚いてしまって、簡単には起き上がれなかった。"
msgstr ""

#. Occurrence 6_2:1736:7507: scene=6_2
#: 6_2:1736
msgctxt "text_id=7507 | speaker=unknown"
msgid "　もぞもぞと動いて、ようやく上半身を起こすのが精一杯だ。"
msgstr ""

#. Occurrence 6_2:1786:7508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0013; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1786
msgctxt "text_id=7508 | speaker=soujuurou"
msgid "「……あれ？　洋服のままだ」"
msgstr ""

#. Occurrence 6_2:1792:7509: scene=6_2
#: 6_2:1792
msgctxt "text_id=7509 | speaker=unknown"
msgid "　かかっていた毛布を<剥|は>ぐなり、不思議そうに首をかしげる。"
msgstr ""

#. Occurrence 6_2:1819:7510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0014; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1819
msgctxt "text_id=7510 | speaker=soujuurou"
msgid "「申し訳ない。こんないい布団なのに、これじゃ不釣り合いだ。……というより、勿体ない」"
msgstr ""

#. Occurrence 6_2:1845:7511: scene=6_2
#: 6_2:1845
msgctxt "text_id=7511 | speaker=unknown"
msgid "　どうせならベッドに似合う寝間着で寝たかった、などとぼやく草十郎を、少女は意外そうに見つめている。"
msgstr ""

#. Occurrence 6_2:1850:7512: scene=6_2
#: 6_2:1850
msgctxt "text_id=7512 | speaker=unknown"
msgid "　何か、少女にとって予想外の事をしてしまったらしい。"
msgstr ""

#. Occurrence 6_2:1886:7513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0015; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1886
msgctxt "text_id=7513 | speaker=soujuurou"
msgid "『なんでだ。何もしてないぞ、俺』"
msgstr ""

#. Occurrence 6_2:1892:7514: scene=6_2
#: 6_2:1892
msgctxt "text_id=7514 | speaker=unknown"
msgid "　<謂|い>われのない好奇心を向けられ、なんとなく拗ねながら草十郎は少女に体を向けた。"
msgstr ""

#. Occurrence 6_2:1897:7515: scene=6_2
#: 6_2:1897
msgctxt "text_id=7515 | speaker=unknown"
msgid "　まだベッドの上に横たわってはいるものの、幾分ましな姿勢になっている。"
msgstr ""

#. Occurrence 6_2:1931:7516: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0016; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1931
msgctxt "text_id=7516 | speaker=soujuurou"
msgid "「それで、さっきの続きだけど」"
msgstr ""

#. Occurrence 6_2:1937:7517: scene=6_2
#: 6_2:1937
msgctxt "text_id=7517 | speaker=unknown"
msgid "　そう、ここが何処で少女が何者なのか、まずそれを教えてもらわないと始まらない。"
msgstr ""

#. Occurrence 6_2:1942:7518: scene=6_2
#: 6_2:1942
msgctxt "text_id=7518 | speaker=unknown"
msgid "　実際のところ、遊園地の事を思い出せば思い出すほど、そら恐ろしい想像しかできないのだが。"
msgstr ""

#. Occurrence 6_2:1981:7519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0003; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1981
msgctxt "text_id=7519 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_2:1987:7520: scene=6_2
#: 6_2:1987
msgctxt "text_id=7520 | speaker=unknown"
msgid "　そんな草十郎の決意が伝わったのか、少女も冷徹に、背中に回していた手を動かそうとした時。"
msgstr ""

#. Occurrence 6_2:2025:7521: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0004; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:2025
msgctxt "text_id=7521 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 6_2:2031:7522: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0017; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:2031
msgctxt "text_id=7522 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 6_2:2036:7523: scene=6_2
#: 6_2:2036
msgctxt "text_id=7523 | speaker=unknown"
msgid "　またも無言で見つめ合ってしまう。"
msgstr ""

#. Occurrence 6_2:2041:7524: scene=6_2
#: 6_2:2041
msgctxt "text_id=7524 | speaker=unknown"
msgid "　バタバタバタ。"
msgstr ""

#. Occurrence 6_2:2046:7525: scene=6_2
#: 6_2:2046
msgctxt "text_id=7525 | speaker=unknown"
msgid "　外から響いてくる足音は、何者かが走って来るものだ。"
msgstr ""

#. Occurrence 6_2:2052:7526: scene=6_2
#: 6_2:2052
msgctxt "text_id=7526 | speaker=unknown"
msgid "　それが誰のものか、少女はともかく草十郎にさえもありありと予測でき―――"
msgstr ""

#. Occurrence 6_2:2161:7527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_2_0000; voice_prefix=A10; voice_category=1; scene=6_2
#: 6_2:2161
msgctxt "text_id=7527 | speaker=aoko"
msgid "「有珠っ、約束！」"
msgstr ""

#. Occurrence 6_2:2167:7528: scene=6_2
#: 6_2:2167
msgctxt "text_id=7528 | speaker=unknown"
msgid "　この通り。"
msgstr ""

#. Occurrence 6_2:2172:7529: scene=6_2
#: 6_2:2172
msgctxt "text_id=7529 | speaker=unknown"
msgid "　乱暴な<一喝|いっかつ>と共に入ってきたのは予想通り、蒼崎青子その人だった。"
msgstr ""

#. Occurrence 6_3:57:7530: scene=6_3
#: 6_3:57
msgctxt "text_id=7530 | speaker=unknown"
msgid "　彼女は制服姿で、長い髪をなびかせて登場した。"
msgstr ""

#. Occurrence 6_3:62:7531: scene=6_3
#: 6_3:62
msgctxt "text_id=7531 | speaker=unknown"
msgid "　乱れた呼吸と不機嫌そうにつり上がった瞳が、どことなく修羅めいている。"
msgstr ""

#. Occurrence 6_3:83:7532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0000; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:83
msgctxt "text_id=7532 | speaker=aoko"
msgid "「有珠っ！」"
msgstr ""

#. Occurrence 6_3:104:7533: scene=6_3
#: 6_3:104
msgctxt "text_id=7533 | speaker=unknown"
msgid "　青子にそう呼ばれた少女―――有珠はわずかに眉を<顰|ひそ>めた。"
msgstr ""

#. Occurrence 6_3:109:7534: scene=6_3
#: 6_3:109
msgctxt "text_id=7534 | speaker=unknown"
msgid "　……はあ、とかため息をこぼしたのかもしれない。"
msgstr ""

#. Occurrence 6_3:138:7535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0000; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:138
msgctxt "text_id=7535 | speaker=alice"
msgid "「早かったわね、青子」"
msgstr ""

#. Occurrence 6_3:144:7536: scene=6_3
#: 6_3:144
msgctxt "text_id=7536 | speaker=unknown"
msgid "　激している青子とは正反対の落ち着いた声。"
msgstr ""

#. Occurrence 6_3:149:7537: scene=6_3
#: 6_3:149
msgctxt "text_id=7537 | speaker=unknown"
msgid "　どこか白々しいのは言うまでもない。"
msgstr ""

#. Occurrence 6_3:203:7538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0001; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:203
msgctxt "text_id=7538 | speaker=aoko"
msgid "「そりゃあ、アンタの性格は知り抜いてるからね。"
msgstr ""

#. Occurrence 6_3:209:7539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0002; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:209
msgctxt "text_id=7539 | speaker=aoko"
msgid "　こういう時の短絡思考はこの二年で経験済みよ。お行儀がいいようで、面倒になったらあっさり投げ捨てるのがアンタでしょ」"
msgstr ""

#. Occurrence 6_3:254:7540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0001; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:254
msgctxt "text_id=7540 | speaker=alice"
msgid "「いやね、人聞きの悪い」"
msgstr ""

#. Occurrence 6_3:274:7541: scene=6_3
#: 6_3:274
msgctxt "text_id=7541 | speaker=unknown"
msgid "　青子の指摘を軽く受け流す有珠。"
msgstr ""

#. Occurrence 6_3:279:7542: scene=6_3
#: 6_3:279
msgctxt "text_id=7542 | speaker=unknown"
msgid "　もう草十郎なんて目に入っていない、と言わんばかりの態度だった。"
msgstr ""

#. Occurrence 6_3:326:7543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0003; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:326
msgctxt "text_id=7543 | speaker=aoko"
msgid "「はん。それで今日まで何度<煮|に>え湯を飲まされたコトか。"
msgstr ""

#. Occurrence 6_3:338:7544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0004; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:338
msgctxt "text_id=7544 | speaker=aoko"
msgid "　青子に<譲|ゆず>るといったけど、よく考えると面倒だから私の方で処理しておいたわ―――なんて事<後承|いいわけ>諾、もう聞き飽きたっつーの。"
msgstr ""

#. Occurrence 6_3:365:7545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0005; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:365
msgctxt "text_id=7545 | speaker=aoko"
msgid "　短気なのはそっちの自由だけど、それなら後の始末は相方に任せるのが最低限の筋ってもんじゃないの？」"
msgstr ""

#. Occurrence 6_3:394:7546: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0002; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:394
msgctxt "text_id=7546 | speaker=alice"
msgid "「そうね。そうでなければ協闘している意味がないわ。"
msgstr ""

#. Occurrence 6_3:400:7547: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0003; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:400
msgctxt "text_id=7547 | speaker=alice"
msgid "　……まあ。今後の方針を勝手に決めた人の台詞じゃないとは思うけど」"
msgstr ""

#. Occurrence 6_3:435:7548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0006; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:435
msgctxt "text_id=7548 | speaker=aoko"
msgid "「それもきっちり片をつけたでしょう。"
msgstr ""

#. Occurrence 6_3:441:7549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0007; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:441
msgctxt "text_id=7549 | speaker=aoko"
msgid "　いい、勝ったのは<私|・><た|・><ち|・>よ。逃げ切れば見逃してあげるって言ったのは誰？　言動には責任を持ちなさい有珠。"
msgstr ""

#. Occurrence 6_3:447:7550: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0008; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:447
msgctxt "text_id=7550 | speaker=aoko"
msgid "　それともなに。もしかして、一番気に食わないのはそのあたりの理由なワケ？」"
msgstr ""

#. Occurrence 6_3:483:7551: scene=6_3
#: 6_3:483
msgctxt "text_id=7551 | speaker=unknown"
msgid "　む、と考えこむ有珠。"
msgstr ""

#. Occurrence 6_3:488:7552: scene=6_3
#: 6_3:488
msgctxt "text_id=7552 | speaker=unknown"
msgid "　青子の詰問は、有珠自身気付いていなかったところを突いたらしい。"
msgstr ""

#. Occurrence 6_3:531:7553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0009; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:531
msgctxt "text_id=7553 | speaker=aoko"
msgid "「とにかく。"
msgstr ""

#. Occurrence 6_3:537:7554: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0010; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:537
msgctxt "text_id=7554 | speaker=aoko"
msgid "　コイツの扱いは、ちゃんと目が覚めて、本人の意志でどうするか決めるまで保留ってコトで合意したでしょ。"
msgstr ""

#. Occurrence 6_3:543:7555: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0011; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:543
msgctxt "text_id=7555 | speaker=aoko"
msgid "　人の留守中に出し抜くのはやめてよね」"
msgstr ""

#. Occurrence 6_3:584:7556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7556 | speaker=alice"
msgid "「……それ。青子、学校はどうしたの。"
msgstr ""

#. Occurrence 6_3:584:7557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7557 | speaker=alice"
msgid "　まだ正午になったばかりなのに」"
msgstr ""

#. Occurrence 6_3:627:7558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0012; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:627
msgctxt "text_id=7558 | speaker=aoko"
msgid "「有珠の<学|と><校|こ>が今日で<終業式|おわり>って思い出して、家庭の事情って事で早退したのよ。期末試験前だってのに、ほんと、なにやってんだか」"
msgstr ""

#. Occurrence 6_3:633:7559: scene=6_3
#: 6_3:633
msgctxt "text_id=7559 | speaker=unknown"
msgid "　誰かに同意を求めるのではなく、自分自身に言い聞かせるように青子は言う。"
msgstr ""

#. Occurrence 6_3:676:7560: scene=6_3
#: 6_3:676
msgctxt "text_id=7560 | speaker=unknown"
msgid "　そうして青子と有珠は見つめ合った。"
msgstr ""

#. Occurrence 6_3:681:7561: scene=6_3
#: 6_3:681
msgctxt "text_id=7561 | speaker=unknown"
msgid "　いや、正しくは睨み合っている。"
msgstr ""

#. Occurrence 6_3:709:7562: scene=6_3
#: 6_3:709
msgctxt "text_id=7562 | speaker=unknown"
msgid "　今まさにとっくみ合いの喧嘩が始まりそうな緊迫感だが、<第三者|そうじゅうろう>としてはなす術なく眺めているしかない。"
msgstr ""

#. Occurrence 6_3:755:7563: scene=6_3
#: 6_3:755
msgctxt "text_id=7563 | speaker=unknown"
msgid "　……もっとも。"
msgstr ""

#. Occurrence 6_3:760:7564: scene=6_3
#: 6_3:760
msgctxt "text_id=7564 | speaker=unknown"
msgid "　しばらく続くと思われた沈黙は、一分ほどであっさりと終わってしまった。"
msgstr ""

#. Occurrence 6_3:765:7565: scene=6_3
#: 6_3:765
msgctxt "text_id=7565 | speaker=unknown"
msgid "　この程度のぶつかり合いは日常茶飯事らしい。"
msgstr ""

#. Occurrence 6_3:808:7566: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0005; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:808
msgctxt "text_id=7566 | speaker=alice"
msgid "「……わたしは居間に行っているから。"
msgstr ""

#. Occurrence 6_3:814:7567: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0006; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:814
msgctxt "text_id=7567 | speaker=alice"
msgid "　彼に事情を説明してあげて」"
msgstr ""

#. Occurrence 6_3:841:7568: scene=6_3
#: 6_3:841
msgctxt "text_id=7568 | speaker=unknown"
msgid "　有珠は椅子から立ち上がり、扉へと歩きだす。"
msgstr ""

#. Occurrence 6_3:861:7569: scene=6_3
#: 6_3:861
msgctxt "text_id=7569 | speaker=unknown"
msgid "　その背中を見て草十郎は首を<傾|かし>げてしまった。"
msgstr ""

#. Occurrence 6_3:866:7570: scene=6_3
#: 6_3:866
msgctxt "text_id=7570 | speaker=unknown"
msgid "　有珠の手には何か、どう控えめに表現しても、"
msgstr ""

#. Occurrence 6_3:886:7571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0000; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:886
msgctxt "text_id=7571 | speaker=soujuurou"
msgid "『……果物、ナイフ……？』"
msgstr ""

#. Occurrence 6_3:891:7572: scene=6_3
#: 6_3:891
msgctxt "text_id=7572 | speaker=unknown"
msgid "　としか言い表せない<得物|えもの>が握られていたからだ。"
msgstr ""

#. Occurrence 6_3:936:7573: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0013; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:936
msgctxt "text_id=7573 | speaker=aoko"
msgid "「有珠。あえて聞くけど、その手に持ってるの、なに？」"
msgstr ""

#. Occurrence 6_3:941:7574: scene=6_3
#: 6_3:941
msgctxt "text_id=7574 | speaker=unknown"
msgid "　横を通り過ぎる有珠に問いかける青子。"
msgstr ""

#. Occurrence 6_3:979:7575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0007; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:979
msgctxt "text_id=7575 | speaker=alice"
msgid "「短剣ね、どう見ても」"
msgstr ""

#. Occurrence 6_3:1009:7576: scene=6_3
#: 6_3:1009
msgctxt "text_id=7576 | speaker=unknown"
msgid "　有珠は無表情で返答し、スタスタと部屋から立ち去った。"
msgstr ""

#. Occurrence 6_3:1044:7577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0001; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:1044
msgctxt "text_id=7577 | speaker=soujuurou"
msgid "「……………………」"
msgstr ""

#. Occurrence 6_3:1049:7578: scene=6_3
#: 6_3:1049
msgctxt "text_id=7578 | speaker=unknown"
msgid "　よし。今の会話に関しては深く考えないようにしよう、と自己防衛する草十郎なのだった。"
msgstr ""

#. Occurrence 6_4:69:7579: scene=6_4
#: 6_4:69
msgctxt "text_id=7579 | speaker=unknown"
msgid "　ともあれ、緊張感の大本であった黒衣の少女は立ち去った。"
msgstr ""

#. Occurrence 6_4:74:7580: scene=6_4
#: 6_4:74
msgctxt "text_id=7580 | speaker=unknown"
msgid "　部屋にはベッドに横になった草十郎と、制服姿の蒼崎青子がいる。"
msgstr ""

#. Occurrence 6_4:79:7581: scene=6_4
#: 6_4:79
msgctxt "text_id=7581 | speaker=unknown"
msgid "　草十郎からすれば、たまりにたまった疑問を解決するには絶好の機会だ。"
msgstr ""

#. Occurrence 6_4:111:7582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0000; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:111
msgctxt "text_id=7582 | speaker=soujuurou"
msgid "「ワケの分からない事だらけだ、蒼崎」"
msgstr ""

#. Occurrence 6_4:141:7583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0000; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:141
msgctxt "text_id=7583 | speaker=aoko"
msgid "「でしょうね。順序だてて説明してあげるから、ちょっと黙ってて」"
msgstr ""

#. Occurrence 6_4:191:7584: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0001; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:191
msgctxt "text_id=7584 | speaker=aoko"
msgid "「顔の麻痺も取れてるし、呼吸も再開、と……これならもう安心かな」"
msgstr ""

#. Occurrence 6_4:211:7585: scene=6_4
#: 6_4:211
msgctxt "text_id=7585 | speaker=unknown"
msgid "　青子はよし、と頷いて椅子に腰を下ろした。"
msgstr ""

#. Occurrence 6_4:238:7586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0002; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:238
msgctxt "text_id=7586 | speaker=aoko"
msgid "「どう、調子は？」"
msgstr ""

#. Occurrence 6_4:257:7587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0001; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:257
msgctxt "text_id=7587 | speaker=soujuurou"
msgid "「…………なんか、だるい」"
msgstr ""

#. Occurrence 6_4:263:7588: scene=6_4
#: 6_4:263
msgctxt "text_id=7588 | speaker=unknown"
msgid "　がっくりと肩を落として、草十郎は弱々しく返答する。"
msgstr ""

#. Occurrence 6_4:268:7589: scene=6_4
#: 6_4:268
msgctxt "text_id=7589 | speaker=unknown"
msgid "　答えながらも左手を何度か握りしめたが、指の動きは緩慢で、ぎこちない。体がまだ不調であるのは明白だ。"
msgstr ""

#. Occurrence 6_4:309:7590: scene=6_4
#: 6_4:309
msgctxt "text_id=7590 | speaker=unknown"
msgid "　一方、青子は目をしばたたいていた。"
msgstr ""

#. Occurrence 6_4:314:7591: scene=6_4
#: 6_4:314
msgctxt "text_id=7591 | speaker=unknown"
msgid "　驚き……というより、感心しているようだ。"
msgstr ""

#. Occurrence 6_4:319:7592: scene=6_4
#: 6_4:319
msgctxt "text_id=7592 | speaker=unknown"
msgid "　有珠といい青子といい、草十郎には彼女たちの表情を読み取るのは難しい。"
msgstr ""

#. Occurrence 6_4:347:7593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0003; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:347
msgctxt "text_id=7593 | speaker=aoko"
msgid "「ま、体が重いのは当然よ。"
msgstr ""

#. Occurrence 6_4:354:7594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0004; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:354
msgctxt "text_id=7594 | speaker=aoko"
msgid "まる二日経ってるし、寝てるだけでも体は弱ってるだろうし。"
msgstr ""

#. Occurrence 6_4:360:7595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7595 | speaker=aoko"
msgid "　でも、もう話せるくらい回復してるとは思わなかった。"
msgstr ""

#. Occurrence 6_4:360:7596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7596 | speaker=aoko"
msgid "　アンタって見かけより頑丈にできてるのね」"
msgstr ""

#. Occurrence 6_4:366:7597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0002; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:366
msgctxt "text_id=7597 | speaker=soujuurou"
msgid "「？　……二日って？」"
msgstr ""

#. Occurrence 6_4:394:7598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0006; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:394
msgctxt "text_id=7598 | speaker=aoko"
msgid "「あれからそれだけ経ってるの。学校には欠席届だしといたから、その点は安心して。"
msgstr ""

#. Occurrence 6_4:400:7599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0007; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:400
msgctxt "text_id=7599 | speaker=aoko"
msgid "　ガンドの呪いもダンプティの<詩篇|のろい>も、私と有珠とで解呪しといたから」"
msgstr ""

#. Occurrence 6_4:434:7600: scene=6_4
#: 6_4:434
msgctxt "text_id=7600 | speaker=unknown"
msgid "　呪いと聞いて、草十郎はああ、と頷いた。"
msgstr ""

#. Occurrence 6_4:439:7601: scene=6_4
#: 6_4:439
msgctxt "text_id=7601 | speaker=unknown"
msgid "　そういえば、そんな事もあったなぁ、と。"
msgstr ""

#. Occurrence 6_4:481:7602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0008; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:481
msgctxt "text_id=7602 | speaker=aoko"
msgid "「どうかした？　そんな遠い目しちゃって」"
msgstr ""

#. Occurrence 6_4:496:7603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0003; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:496
msgctxt "text_id=7603 | speaker=soujuurou"
msgid "「ああ、忘れてた。それで二日も寝こんでたのか。恐いもんだな、呪われるって事は」"
msgstr ""

#. Occurrence 6_4:507:7604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0009; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:507
msgctxt "text_id=7604 | speaker=aoko"
msgid "「……ほんと緊張感ないわねアンタ。蝋のように眠ってたのが嘘みたいよ。下手すると一生あのまま、石膏もどきだったかもしれないのに」"
msgstr ""

#. Occurrence 6_4:564:7605: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0004; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:564
msgctxt "text_id=7605 | speaker=soujuurou"
msgid "「……ちょっと待った。今、すごいコト言わなかったか？」"
msgstr ""

#. Occurrence 6_4:577:7606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0010; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:577
msgctxt "text_id=7606 | speaker=aoko"
msgid "「言ったけど聞かぬが花よ。"
msgstr ""

#. Occurrence 6_4:602:7607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0011; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:602
msgctxt "text_id=7607 | speaker=aoko"
msgid "　ま、経緯はどうあれ、後で有珠にお礼を言っときなさい。私じゃ解呪できなかったんだから」"
msgstr ""

#. Occurrence 6_4:616:7608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0005; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:616
msgctxt "text_id=7608 | speaker=soujuurou"
msgid "「……ひどい花もあったもんだ。"
msgstr ""

#. Occurrence 6_4:629:7609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7609 | speaker=soujuurou"
msgid "　あ、けど、有珠っていうのはさっきの<娘|こ>か？"
msgstr ""

#. Occurrence 6_4:629:7610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7610 | speaker=soujuurou"
msgid "　遊園地で、その……俺たちを殺そうとした？」"
msgstr ""

#. Occurrence 6_4:648:7611: scene=6_4
#: 6_4:648
msgctxt "text_id=7611 | speaker=unknown"
msgid "　それにまあね、と答える青子。"
msgstr ""

#. Occurrence 6_4:669:7612: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0007; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:669
msgctxt "text_id=7612 | speaker=soujuurou"
msgid "「彼女、ずっとそこに座ってたけど。……ここは彼女の部屋なのか？」"
msgstr ""

#. Occurrence 6_4:688:7613: scene=6_4
#: 6_4:688
msgctxt "text_id=7613 | speaker=unknown"
msgid "　草十郎は改めて部屋を見渡す。"
msgstr ""

#. Occurrence 6_4:693:7614: scene=6_4
#: 6_4:693
msgctxt "text_id=7614 | speaker=unknown"
msgid "　自分が眠っていたベッド共々、彼の見聞にはない洋風の部屋。"
msgstr ""

#. Occurrence 6_4:726:7615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0012; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:726
msgctxt "text_id=7615 | speaker=aoko"
msgid "「ううん、ここはただの客室。長いこと使ってなかったから埃だらけでしょ。"
msgstr ""

#. Occurrence 6_4:732:7616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0013; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:732
msgctxt "text_id=7616 | speaker=aoko"
msgid "　それより有珠と何か話したの、あなた？」"
msgstr ""

#. Occurrence 6_4:749:7617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0008; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:749
msgctxt "text_id=7617 | speaker=soujuurou"
msgid "「―――。"
msgstr ""

#. Occurrence 6_4:756:7618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0009; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:756
msgctxt "text_id=7618 | speaker=soujuurou"
msgid "いや、あれを会話と言うのは、ちょっと」"
msgstr ""

#. Occurrence 6_4:761:7619: scene=6_4
#: 6_4:761
msgctxt "text_id=7619 | speaker=unknown"
msgid "　草十郎は口に手を当てて、さっき交わした言葉を思い返す。"
msgstr ""

#. Occurrence 6_4:790:7620: scene=6_4
#: 6_4:790
msgctxt "text_id=7620 | speaker=unknown"
msgid "　……彼の言う通り、アレを会話と言うのはおこがましい。"
msgstr ""

#. Occurrence 6_4:795:7621: scene=6_4
#: 6_4:795
msgctxt "text_id=7621 | speaker=unknown"
msgid "　なのに、思い返してみると何時間も話していた気がして、草十郎はかすかに苦笑してしまった。"
msgstr ""

#. Occurrence 6_4:828:7622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0010; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:828
msgctxt "text_id=7622 | speaker=soujuurou"
msgid "「とはいえ、緊張は解けたと思うよ。"
msgstr ""

#. Occurrence 6_4:834:7623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0011; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:834
msgctxt "text_id=7623 | speaker=soujuurou"
msgid "　蒼崎がやってくるのがもう少し遅かったら良かったのに」"
msgstr ""

#. Occurrence 6_4:869:7624: scene=6_4
#: 6_4:869
msgctxt "text_id=7624 | speaker=unknown"
msgid "　本心からの一言に、青子はムッと瞳を細める。"
msgstr ""

#. Occurrence 6_4:874:7625: scene=6_4
#: 6_4:874
msgctxt "text_id=7625 | speaker=unknown"
msgid "　草十郎が<青子|じぶん>を邪魔者扱いしていないのは分かるが、面と向かって言われるのは面白くない。"
msgstr ""

#. Occurrence 6_4:886:7626: scene=6_4
#: 6_4:886
msgctxt "text_id=7626 | speaker=unknown"
msgid "　さらに面白くないのは、彼のそんな言動に慣れはじめている自分がいる事だ。"
msgstr ""

#. Occurrence 6_4:928:7627: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0014; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:928
msgctxt "text_id=7627 | speaker=aoko"
msgid "「でも、だから、なのかもね。相変わらず首の皮一枚の人生送ってるわ、貴方って」"
msgstr ""

#. Occurrence 6_4:933:7628: scene=6_4
#: 6_4:933
msgctxt "text_id=7628 | speaker=unknown"
msgid "　それにはい？　と首を傾げる草十郎。"
msgstr ""

#. Occurrence 6_4:960:7629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7629 | speaker=aoko"
msgid "「だから、アンタはよっぽど有珠好みの対応をしたのよ。"
msgstr ""

#. Occurrence 6_4:960:7630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7630 | speaker=aoko"
msgid "　まだ生きてるって、そういうコト」"
msgstr ""

#. Occurrence 6_4:983:7631: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0012; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:983
msgctxt "text_id=7631 | speaker=soujuurou"
msgid "「？？？」"
msgstr ""

#. Occurrence 6_4:988:7632: scene=6_4
#: 6_4:988
msgctxt "text_id=7632 | speaker=unknown"
msgid "　青子の言いたい事はどうにも草十郎には掴めなかった。"
msgstr ""

#. Occurrence 6_4:993:7633: scene=6_4
#: 6_4:993
msgctxt "text_id=7633 | speaker=unknown"
msgid "　掴めなかったので、その事はあえて訊かない事にする。"
msgstr ""

#. Occurrence 6_4:1037:7634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7634 | speaker=soujuurou"
msgid "「……ところで、ここは何処なんだ？"
msgstr ""

#. Occurrence 6_4:1037:7635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7635 | speaker=soujuurou"
msgid "　あの<娘|こ>に訊いても教えてくれなかったけど、蒼崎なら教えてくれるだろ」"
msgstr ""

#. Occurrence 6_4:1065:7636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0016; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1065
msgctxt "text_id=7636 | speaker=aoko"
msgid "「ここは三咲町の幽霊屋敷よ。正確には<久遠寺|くおんじ>邸と言えばいいかしらね。"
msgstr ""

#. Occurrence 6_4:1087:7637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0017; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1087
msgctxt "text_id=7637 | speaker=aoko"
msgid "　さっきの娘……久遠寺有珠の持ち家で、私が住んでるところでもある。あの後、貴方をここまで持ってきたんだけど、<覚|おぼ>えてないでしょ？」"
msgstr ""

#. Occurrence 6_4:1093:7638: scene=6_4
#: 6_4:1093
msgctxt "text_id=7638 | speaker=unknown"
msgid "　持ってきた、という単語にいまいち違和感を覚える草十郎だった。"
msgstr ""

#. Occurrence 6_4:1114:7639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0014; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1114
msgctxt "text_id=7639 | speaker=soujuurou"
msgid "「久遠寺って言う名前は聞きおぼえがあるような……そうだ、よく商店街でおじさんたちが話してた。なんでもえらいお金持ちだとか、なんとか」"
msgstr ""

#. Occurrence 6_4:1120:7640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7640 | speaker=aoko"
msgid "「それ、有珠の前ではご<法度|はっと>よ。"
msgstr ""

#. Occurrence 6_4:1120:7641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7641 | speaker=aoko"
msgid "　穏便にここで暮らしたいならね」"
msgstr ""

#. Occurrence 6_4:1145:7642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0015; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1145
msgctxt "text_id=7642 | speaker=soujuurou"
msgid "「……？」"
msgstr ""

#. Occurrence 6_4:1150:7643: scene=6_4
#: 6_4:1150
msgctxt "text_id=7643 | speaker=unknown"
msgid "　本日何度目かになる首傾げだった。"
msgstr ""

#. Occurrence 6_4:1155:7644: scene=6_4
#: 6_4:1155
msgctxt "text_id=7644 | speaker=unknown"
msgid "　今、またも引っ掛かる単語が出てきた気がする。"
msgstr ""

#. Occurrence 6_4:1190:7645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0016; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1190
msgctxt "text_id=7645 | speaker=soujuurou"
msgid "「蒼崎。君、今なんて言った？」"
msgstr ""

#. Occurrence 6_4:1211:7646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0019; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1211
msgctxt "text_id=7646 | speaker=aoko"
msgid "「静希君。私ね、あからさまな嘘を言う人と、同じ事を何度も言わせる人と、察しの悪い人には容赦しないから。"
msgstr ""

#. Occurrence 6_4:1217:7647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0020; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1217
msgctxt "text_id=7647 | speaker=aoko"
msgid "　そのあたり覚えておいてね、ここで平穏に暮らしたいなら」"
msgstr ""

#. Occurrence 6_4:1223:7648: scene=6_4
#: 6_4:1223
msgctxt "text_id=7648 | speaker=unknown"
msgid "　極上の笑顔で、さわやかに不穏な宣言をする青子。"
msgstr ""

#. Occurrence 6_4:1228:7649: scene=6_4
#: 6_4:1228
msgctxt "text_id=7649 | speaker=unknown"
msgid "　もちろん、草十郎にとっては寝耳に水の話である。"
msgstr ""

#. Occurrence 6_4:1275:7650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0017; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1275
msgctxt "text_id=7650 | speaker=soujuurou"
msgid "「……気のせいならいいんだけど、君の言葉には、俺がここに住むような響きが感じられる」"
msgstr ""

#. Occurrence 6_4:1302:7651: scene=6_4
#: 6_4:1302
msgctxt "text_id=7651 | speaker=unknown"
msgid "　草十郎は正直に、心底から嫌そうな顔で青子を見る。"
msgstr ""

#. Occurrence 6_4:1307:7652: scene=6_4
#: 6_4:1307
msgctxt "text_id=7652 | speaker=unknown"
msgid "　彼なりの精一杯の<反政府運動|レジスタンス>だ。"
msgstr ""

#. Occurrence 6_4:1312:7653: scene=6_4
#: 6_4:1312
msgctxt "text_id=7653 | speaker=unknown"
msgid "　が、そんな貧弱な運動は効かない、とばかりに青子は冷酷な視線を返すのだった。"
msgstr ""

#. Occurrence 6_4:1348:7654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0021; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1348
msgctxt "text_id=7654 | speaker=aoko"
msgid "「貴方、自分の立場を分かってる？」"
msgstr ""

#. Occurrence 6_4:1354:7655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0018; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1354
msgctxt "text_id=7655 | speaker=soujuurou"
msgid "「えーと、」"
msgstr ""

#. Occurrence 6_4:1359:7656: scene=6_4
#: 6_4:1359
msgctxt "text_id=7656 | speaker=unknown"
msgid "　それが分かっていれば蒼崎が苦労しない、というのは分かるよ―――"
msgstr ""

#. Occurrence 6_4:1364:7657: scene=6_4
#: 6_4:1364
msgctxt "text_id=7657 | speaker=unknown"
msgid "　なんて感想を喉もとで止めて、草十郎は首を横に振った。"
msgstr ""

#. Occurrence 6_4:1405:7658: scene=6_4
#: 6_4:1405
msgctxt "text_id=7658 | speaker=unknown"
msgid "　空気を読めない彼でも、今は自重すべきだと感じ取ったらしい。"
msgstr ""

#. Occurrence 6_4:1410:7659: scene=6_4
#: 6_4:1410
msgctxt "text_id=7659 | speaker=unknown"
msgid "　そんなのんびりした態度こそが青子の癪に障る事を、彼もそろそろ気付くべきだ。"
msgstr ""

#. Occurrence 6_4:1453:7660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0022; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1453
msgctxt "text_id=7660 | speaker=aoko"
msgid "「……はあ。そうだった。アンタに回りくどいこと言っても無駄だったのよね。"
msgstr ""

#. Occurrence 6_4:1460:7661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0023; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1460
msgctxt "text_id=7661 | speaker=aoko"
msgid "いいわ、考える時間ぐらいあげたかったけど、時間もないし、はっきりと言ってあげる」"
msgstr ""

#. Occurrence 6_4:1492:7662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0024; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1492
msgctxt "text_id=7662 | speaker=aoko"
msgid "「いい、静希君？"
msgstr ""

#. Occurrence 6_4:1509:7663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0025; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1509
msgctxt "text_id=7663 | speaker=aoko"
msgid "　このたび、貴方は私たちの監視下に置かれることになりました。しばらくはここで一緒に暮らしてもらいます。"
msgstr ""

#. Occurrence 6_4:1515:7664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0026; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1515
msgctxt "text_id=7664 | speaker=aoko"
msgid "　もちろん、生殺与奪の権利はこちらにあるという条件で」"
msgstr ""

#. Occurrence 6_4:1565:7665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0019; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1565
msgctxt "text_id=7665 | speaker=soujuurou"
msgid "「なっ……！」"
msgstr ""

#. Occurrence 6_4:1571:7666: scene=6_4
#: 6_4:1571
msgctxt "text_id=7666 | speaker=unknown"
msgid "　あまりの<横暴|おうぼう>さに吹き出しかける草十郎。"
msgstr ""

#. Occurrence 6_4:1607:7667: scene=6_4
#: 6_4:1607
msgctxt "text_id=7667 | speaker=unknown"
msgid "　笑顔で言えば傍若無人が通ると思うのもやめてほしい。"
msgstr ""

#. Occurrence 6_4:1644:7668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0020; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1644
msgctxt "text_id=7668 | speaker=soujuurou"
msgid "「い、一緒に住むって蒼崎とか！？」"
msgstr ""

#. Occurrence 6_4:1650:7669: scene=6_4
#: 6_4:1650
msgctxt "text_id=7669 | speaker=unknown"
msgid "　あわてているのは青子と一つ屋根の下で暮らす事に淡い期待を持ってのこと―――"
msgstr ""

#. Occurrence 6_4:1655:7670: scene=6_4
#: 6_4:1655
msgctxt "text_id=7670 | speaker=unknown"
msgid "　では当然なく、"
msgstr ""

#. Occurrence 6_4:1675:7671: scene=6_4
#: 6_4:1675
msgctxt "text_id=7671 | speaker=unknown"
msgid "　純粋に、己が身を案じてだ。"
msgstr ""

#. Occurrence 6_4:1695:7672: scene=6_4
#: 6_4:1695
msgctxt "text_id=7672 | speaker=unknown"
msgid "　いかに彼がお人好しでも、一度殺されかけた事実はきちんと受けとめていたらしい。"
msgstr ""

#. Occurrence 6_4:1729:7673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7673 | speaker=soujuurou"
msgid "「とんでもない！"
msgstr ""

#. Occurrence 6_4:1729:7674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7674 | speaker=soujuurou"
msgid "　冬眠前の熊と、一緒に<暖|だん>を取るようなもんだ！」"
msgstr ""

#. Occurrence 6_4:1747:7675: scene=6_4
#: 6_4:1747
msgctxt "text_id=7675 | speaker=unknown"
msgid "　失礼な感想に、青子はそうね、と平然と答える。"
msgstr ""

#. Occurrence 6_4:1774:7676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0027; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1774
msgctxt "text_id=7676 | speaker=aoko"
msgid "「たまには的確な<比|ひ><喩|ゆ>をするじゃない。"
msgstr ""

#. Occurrence 6_4:1780:7677: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0028; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1780
msgctxt "text_id=7677 | speaker=aoko"
msgid "　貴方の言う通り、下手なコトをしたり決まりを破ったりしたら今度こそ息の根止めるからね。"
msgstr ""

#. Occurrence 6_4:1793:7678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0029; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1793
msgctxt "text_id=7678 | speaker=aoko"
msgid "　それと、ここに住んでるのは私と有珠のふたりだけよ。"
msgstr ""

#. Occurrence 6_4:1799:7679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0030; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1799
msgctxt "text_id=7679 | speaker=aoko"
msgid "　あの子、私なんかより数倍常識ないから。気をつけないと死んじゃうぞ」"
msgstr ""

#. Occurrence 6_4:1838:7680: scene=6_4
#: 6_4:1838
msgctxt "text_id=7680 | speaker=unknown"
msgid "　青子は１００パーセント本気である。"
msgstr ""

#. Occurrence 6_4:1843:7681: scene=6_4
#: 6_4:1843
msgctxt "text_id=7681 | speaker=unknown"
msgid "　<嘘|うそ><偽|いつわ>りない発言こそ誠意と言わんばかりだ。"
msgstr ""

#. Occurrence 6_4:1877:7682: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0022; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1877
msgctxt "text_id=7682 | speaker=soujuurou"
msgid "「いや、いやいやいや！」"
msgstr ""

#. Occurrence 6_4:1882:7683: scene=6_4
#: 6_4:1882
msgctxt "text_id=7683 | speaker=unknown"
msgid "　無論、そんなんで被害者である草十郎が納得できる筈もない。"
msgstr ""

#. Occurrence 6_4:1904:7684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0023; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1904
msgctxt "text_id=7684 | speaker=soujuurou"
msgid "「待ってくれ、俺にはちっとも蒼崎が分からない！"
msgstr ""

#. Occurrence 6_4:1911:7685: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_0; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1911
msgctxt "text_id=7685 | speaker=soujuurou"
msgid "　監視するって言うけど、なんでそんな話になってるんだ？　考えられる範囲、悪いコトとかしてないし、そもそも俺を見張っても得なコトなんていっこもないし！　"
msgstr ""

#. Occurrence 6_4:1920:7686: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_1; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1920
msgctxt "text_id=7686 | speaker=soujuurou"
msgid "蒼崎は色々まちがってる！」"
msgstr ""

#. Occurrence 6_4:1963:7687: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0025; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1963
msgctxt "text_id=7687 | speaker=soujuurou"
msgid "「―――む。いや、それとも魔術師っていうのは、みんな蒼崎みたいなのか？」"
msgstr ""

#. Occurrence 6_4:1989:7688: scene=6_4
#: 6_4:1989
msgctxt "text_id=7688 | speaker=unknown"
msgid "　ぼうじゃくとかぶじんなのか？　と心底困った視線を向けてくる人畜無害。"
msgstr ""

#. Occurrence 6_4:1994:7689: scene=6_4
#: 6_4:1994
msgctxt "text_id=7689 | speaker=unknown"
msgid "　……青子からすれば頭痛のタネもいいところだ。"
msgstr ""

#. Occurrence 6_4:2016:7690: scene=6_4
#: 6_4:2016
msgctxt "text_id=7690 | speaker=unknown"
msgid "　素直すぎるのも考えもので、この通り、草十郎は青子が魔術師であることを異常だと思っていないのである。"
msgstr ""

#. Occurrence 6_4:2065:7691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0031; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2065
msgctxt "text_id=7691 | speaker=aoko"
msgid "「だ、か、らっ！　アンタが、そういう風に、誰はばかることなく私たちの事を言い触らさないかを見張ってんじゃない、この常識なしッ！」"
msgstr ""

#. Occurrence 6_4:2071:7692: scene=6_4
#: 6_4:2071
msgctxt "text_id=7692 | speaker=unknown"
msgid "　青子は勢いあまって椅子から立ち上がった。"
msgstr ""

#. Occurrence 6_4:2076:7693: scene=6_4
#: 6_4:2076
msgctxt "text_id=7693 | speaker=unknown"
msgid "　先ほどから我慢してきた青子の堪忍袋の緒はすっぱりさっぱり、気分よく断ち切れたらしい。"
msgstr ""

#. Occurrence 6_4:2081:7694: scene=6_4
#: 6_4:2081
msgctxt "text_id=7694 | speaker=unknown"
msgid "　そんな青子を見て、ぽん、と草十郎は両手を合わせる。"
msgstr ""

#. Occurrence 6_4:2116:7695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0026; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2116
msgctxt "text_id=7695 | speaker=soujuurou"
msgid "「そうか。蒼崎が俺を殺そうとしたのは、魔術師であることを隠さなくちゃいけないからだったっけ。"
msgstr ""

#. Occurrence 6_4:2129:7696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0027; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2129
msgctxt "text_id=7696 | speaker=soujuurou"
msgid "　うん、それなら分かる。監視するのは蒼崎の秘密のコトで、俺の命云々はオマケみたいなものか」"
msgstr ""

#. Occurrence 6_4:2149:7697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7697 | speaker=aoko"
msgid "「…………。そりゃあ本質的に言えば、そうだけど。"
msgstr ""

#. Occurrence 6_4:2149:7698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7698 | speaker=aoko"
msgid "　身もフタもないわね、その言い方」"
msgstr ""

#. Occurrence 6_4:2180:7699: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0028; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2180
msgctxt "text_id=7699 | speaker=soujuurou"
msgid "「けど、それはあまり意味がないんじゃないか？"
msgstr ""

#. Occurrence 6_4:2186:7700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0029; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2186
msgctxt "text_id=7700 | speaker=soujuurou"
msgid "　学校もあるし、バイトだってあるんだ。一日中、この家から出ないワケにはいかないんだぞ」"
msgstr ""

#. Occurrence 6_4:2233:7701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0033; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2233
msgctxt "text_id=7701 | speaker=aoko"
msgid "「……………………」"
msgstr ""

#. Occurrence 6_4:2238:7702: scene=6_4
#: 6_4:2238
msgctxt "text_id=7702 | speaker=unknown"
msgid "　自分を客観視できる草十郎に感心したのも一瞬、あまりの返答に絶句する青子だった。"
msgstr ""

#. Occurrence 6_4:2243:7703: scene=6_4
#: 6_4:2243
msgctxt "text_id=7703 | speaker=unknown"
msgid "　ほんとーに、この男は自分の立場というものが分かっていない。"
msgstr ""

#. Occurrence 6_4:2248:7704: scene=6_4
#: 6_4:2248
msgctxt "text_id=7704 | speaker=unknown"
msgid "　ここまでの話の流れで、そんな自由があると思っているあたり大物ではあるが。"
msgstr ""

#. Occurrence 6_4:2275:7705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0034; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2275
msgctxt "text_id=7705 | speaker=aoko"
msgid "「……いや、落ち着け私。話が早くなってある意味助かるし」"
msgstr ""

#. Occurrence 6_4:2281:7706: scene=6_4
#: 6_4:2281
msgctxt "text_id=7706 | speaker=unknown"
msgid "　なんとか体裁を整える青子。"
msgstr ""

#. Occurrence 6_4:2286:7707: scene=6_4
#: 6_4:2286
msgctxt "text_id=7707 | speaker=unknown"
msgid "　実のところ、青子も監獄じみた拘束をする気はない。"
msgstr ""

#. Occurrence 6_4:2291:7708: scene=6_4
#: 6_4:2291
msgctxt "text_id=7708 | speaker=unknown"
msgid "　あらゆる自由を禁じ屋敷に閉じこめる、なんて方法では草十郎との約束に反してしまう。"
msgstr ""

#. Occurrence 6_4:2296:7709: scene=6_4
#: 6_4:2296
msgctxt "text_id=7709 | speaker=unknown"
msgid "　第一、そこまでするなら亡き者にしたほうが早い。"
msgstr ""

#. Occurrence 6_4:2301:7710: scene=6_4
#: 6_4:2301
msgctxt "text_id=7710 | speaker=unknown"
msgid "　青子にとって『生かす』という事は、静希草十郎という人間の生活を最低限尊重する事である。"
msgstr ""

#. Occurrence 6_4:2338:7711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0030; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2338
msgctxt "text_id=7711 | speaker=soujuurou"
msgid "「あ。……も、もしかして、この部屋から出ちゃいけないのか、俺！？」"
msgstr ""

#. Occurrence 6_4:2356:7712: scene=6_4
#: 6_4:2356
msgctxt "text_id=7712 | speaker=unknown"
msgid "　ピコーン、と音が鳴りかねない顔で、思いつきを口にする草十郎。"
msgstr ""

#. Occurrence 6_4:2361:7713: scene=6_4
#: 6_4:2361
msgctxt "text_id=7713 | speaker=unknown"
msgid "　悪い方向での想像にようやく行き着いてくれたらしい。"
msgstr ""

#. Occurrence 6_4:2366:7714: scene=6_4
#: 6_4:2366
msgctxt "text_id=7714 | speaker=unknown"
msgid "　そんな狼狽ぶりに、少しだけ<溜飲|りゅういん>をさげる青子だった。"
msgstr ""

#. Occurrence 6_4:2411:7715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0035; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2411
msgctxt "text_id=7715 | speaker=aoko"
msgid "「大丈夫よ。監禁生活なんて面倒なコトだけはしないから。"
msgstr ""

#. Occurrence 6_4:2417:7716: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0036; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2417
msgctxt "text_id=7716 | speaker=aoko"
msgid "　貴方の自由はそれなりに考慮してあります。そのあたりのさじ加減は有珠の手腕に任せてあるから、貴方は心配しなくていいわ」"
msgstr ""

#. Occurrence 6_4:2423:7717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0031; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2423
msgctxt "text_id=7717 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 6_4:2428:7718: scene=6_4
#: 6_4:2428
msgctxt "text_id=7718 | speaker=unknown"
msgid "　草十郎は無言で、それはよけいに心配なのでは、と顔を曇らせた。"
msgstr ""

#. Occurrence 6_4:2455:7719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0037; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2455
msgctxt "text_id=7719 | speaker=aoko"
msgid "「いい？　貴方の処遇は、この家に住むコトを前提にした監視で、それも解決策が見つかるまでの期間限定。"
msgstr ""

#. Occurrence 6_4:2461:7720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0038; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2461
msgctxt "text_id=7720 | speaker=aoko"
msgid "　何でもいいから目撃者を殺す、なんて事より、こっちの方がよっぽど穏便でしょ。"
msgstr ""

#. Occurrence 6_4:2474:7721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0039; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2474
msgctxt "text_id=7721 | speaker=aoko"
msgid "　……だいたい、これは私と貴方との約束なんだから、いちいち文句言わないでよね。ただでさえ有珠との冷戦が続いてて頭痛いんだから」"
msgstr ""

#. Occurrence 6_4:2479:7722: scene=6_4
#: 6_4:2479
msgctxt "text_id=7722 | speaker=unknown"
msgid "　ため息まじりに言いつつ、青子はベッドの上の草十郎をキッと睨みつける。"
msgstr ""

#. Occurrence 6_4:2523:7723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0040; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2523
msgctxt "text_id=7723 | speaker=aoko"
msgid "「けど勘違いはしないで。"
msgstr ""

#. Occurrence 6_4:2529:7724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0041; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2529
msgctxt "text_id=7724 | speaker=aoko"
msgid "　ここじゃアンタの地位は最下層のさらに下、番犬より下なんだから。アンタの生殺与奪はあの夜から私が握ってるんだから、アンタは私に所有されてるようなもんなの。"
msgstr ""

#. Occurrence 6_4:2535:7725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0042; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2535
msgctxt "text_id=7725 | speaker=aoko"
msgid "　さ、これで自分の立場、<判|わか>った？」"
msgstr ""

#. Occurrence 6_4:2605:7726: scene=6_4
#: 6_4:2605
msgctxt "text_id=7726 | speaker=unknown"
msgid "　<大|おお><威|い><張|ば>りでそう言われて、青子に気付かれないよう、草十郎は天を仰いだ。"
msgstr ""

#. Occurrence 6_4:2610:7727: scene=6_4
#: 6_4:2610
msgctxt "text_id=7727 | speaker=unknown"
msgid "　青子には申し訳ないが、ちっともぜんぜん判らない。"
msgstr ""

#. Occurrence 6_4:2615:7728: scene=6_4
#: 6_4:2615
msgctxt "text_id=7728 | speaker=unknown"
msgid "　個人的な感想と言えば、犬より簡単と言われて怒らないのは人間としても、お犬さまにも礼を欠くと思うのだが、自分と彼女の戦力差は兎と猪ほどもあるので反論もできない。"
msgstr ""

#. Occurrence 6_4:2662:7729: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0032; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2662
msgctxt "text_id=7729 | speaker=soujuurou"
msgid "「……………………はあ」"
msgstr ""

#. Occurrence 6_4:2668:7730: scene=6_4
#: 6_4:2668
msgctxt "text_id=7730 | speaker=unknown"
msgid "　見上げた天井は、自分の安アパートとは違って豪奢な紋様があしらわれている。"
msgstr ""

#. Occurrence 6_4:2673:7731: scene=6_4
#: 6_4:2673
msgctxt "text_id=7731 | speaker=unknown"
msgid "　……自分の扱いはともかく、建物に関しては文句なしにグレードが上がっている。"
msgstr ""

#. Occurrence 6_4:2686:7732: scene=6_4
#: 6_4:2686
msgctxt "text_id=7732 | speaker=unknown"
msgid "　つまり、悪いことだけじゃないだろう、と。"
msgstr ""

#. Occurrence 6_4:2691:7733: scene=6_4
#: 6_4:2691
msgctxt "text_id=7733 | speaker=unknown"
msgid "　自分に言い聞かせるように、草十郎はうんうんと頷いた。"
msgstr ""

#. Occurrence 6_4:2696:7734: scene=6_4
#: 6_4:2696
msgctxt "text_id=7734 | speaker=unknown"
msgid "　それに―――"
msgstr ""

#. Occurrence 6_4:2760:7735: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0043; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2760
msgctxt "text_id=7735 | speaker=aoko"
msgid "“とりあえず、命は助けてあげるから”"
msgstr ""

#. Occurrence 6_4:2767:7736: scene=6_4
#: 6_4:2767
msgctxt "text_id=7736 | speaker=unknown"
msgid "　あの時。"
msgstr ""

msgctxt "text_id=7737 | speaker=unknown"
msgid "彼女は確かにそう言ったのだ。"
msgstr ""

#. Occurrence 6_4:2818:7738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7738 | speaker=soujuurou"
msgid "「あまり納得したくないけど、自分の立場は分かったよ。"
msgstr ""

#. Occurrence 6_4:2818:7739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7739 | speaker=soujuurou"
msgid "　うん、たしかにそんな約束だった。色々と言いたい事はあるけど、それは認めるしかない。"
msgstr ""

#. Occurrence 6_4:2824:7740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7740 | speaker=soujuurou"
msgid "　だけど、君たちと一緒に住めっていうのは本気なのか？"
msgstr ""

#. Occurrence 6_4:2824:7741: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7741 | speaker=soujuurou"
msgid "　蒼崎は細かいコトは気にしないとしても、さっきの娘は嫌がりそうだし、俺だって少しは……」"
msgstr ""

#. Occurrence 6_4:2829:7742: scene=6_4
#: 6_4:2829
msgctxt "text_id=7742 | speaker=unknown"
msgid "　そこで、草十郎はぴたりと黙りこんだ。"
msgstr ""

#. Occurrence 6_4:2845:7743: scene=6_4
#: 6_4:2845
msgctxt "text_id=7743 | speaker=unknown"
msgid "　青子の目がひどく殺気を帯びて見えたからだ。"
msgstr ""

#. Occurrence 6_4:2872:7744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0044; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2872
msgctxt "text_id=7744 | speaker=aoko"
msgid "「あら、静希君はご不満？」"
msgstr ""

#. Occurrence 6_4:2891:7745: scene=6_4
#: 6_4:2891
msgctxt "text_id=7745 | speaker=unknown"
msgid "　無理に笑ってるとしか思えない彼女の口元に、草十郎は絶望を見た気がした。"
msgstr ""

#. Occurrence 6_4:2896:7746: scene=6_4
#: 6_4:2896
msgctxt "text_id=7746 | speaker=unknown"
msgid "　そういえば、さっき同じ事は何度も言わせるなと忠告された気がする。"
msgstr ""

#. Occurrence 6_4:2935:7747: scene=6_4
#: 6_4:2935
msgctxt "text_id=7747 | speaker=unknown"
msgid "　さらにさらに。"
msgstr ""

#. Occurrence 6_4:2940:7748: scene=6_4
#: 6_4:2940
msgctxt "text_id=7748 | speaker=unknown"
msgid "　実際問題として、どんなに実感が湧かないとしても、静希草十郎の命は蒼崎青子に握られている。"
msgstr ""

#. Occurrence 6_4:2945:7749: scene=6_4
#: 6_4:2945
msgctxt "text_id=7749 | speaker=unknown"
msgid "　怒らせるのは<賢|かしこ>くない、と他人事のように頷く草十郎なのだった。"
msgstr ""

#. Occurrence 6_4:2973:7750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0035; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2973
msgctxt "text_id=7750 | speaker=soujuurou"
msgid "「……いや、別に。だってそれ以外ないんだろう？」"
msgstr ""

#. Occurrence 6_4:2979:7751: scene=6_4
#: 6_4:2979
msgctxt "text_id=7751 | speaker=unknown"
msgid "　当然、と頷く青子と、"
msgstr ""

#. Occurrence 6_4:2984:7752: scene=6_4
#: 6_4:2984
msgctxt "text_id=7752 | speaker=unknown"
msgid "　降伏するようにがっくりと肩を落とす草十郎。"
msgstr ""

#. Occurrence 6_4:3033:7753: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0036; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3033
msgctxt "text_id=7753 | speaker=soujuurou"
msgid "「……うん、蒼崎の言い分は分かった。"
msgstr ""

#. Occurrence 6_4:3039:7754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0037; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3039
msgctxt "text_id=7754 | speaker=soujuurou"
msgid "　ただ、いちおう聞いておきたいんだけど。俺の人権はどこにいってしまったんだろう？」"
msgstr ""

#. Occurrence 6_4:3066:7755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0045; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3066
msgctxt "text_id=7755 | speaker=aoko"
msgid "「莫迦ね、そんな形のない物なんて初めからあるワケないでしょ。つまんないこと言わないでよ」"
msgstr ""

#. Occurrence 6_4:3072:7756: scene=6_4
#: 6_4:3072
msgctxt "text_id=7756 | speaker=unknown"
msgid "　……うん、たしかに今のはつまらない事だった、と草十郎は噛みしめる。"
msgstr ""

#. Occurrence 6_4:3077:7757: scene=6_4
#: 6_4:3077
msgctxt "text_id=7757 | speaker=unknown"
msgid "　そもそも彼にしてみれば、いまの青子の答えは分かりきっていた事だ。"
msgstr ""

#. Occurrence 6_4:3138:7758: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7758 | speaker=soujuurou"
msgid "「……ああ、だと思った。"
msgstr ""

#. Occurrence 6_4:3138:7759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7759 | speaker=soujuurou"
msgid "　そんな気はしてたんだ、目が覚める前から」"
msgstr ""

#. Occurrence 6_4:3151:7760: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0046; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3151
msgctxt "text_id=7760 | speaker=aoko"
msgid "「？」"
msgstr ""

#. Occurrence 6_4:3157:7761: scene=6_4
#: 6_4:3157
msgctxt "text_id=7761 | speaker=unknown"
msgid "　草十郎の独白に青子は不審げな目を向けたが、すぐに気を取り直した。"
msgstr ""

#. Occurrence 6_4:3162:7762: scene=6_4
#: 6_4:3162
msgctxt "text_id=7762 | speaker=unknown"
msgid "　この男の発言をいちいち気にしていたら日が暮れてしまう、と骨身に染みているからだろう。"
msgstr ""

#. Occurrence 6_4:3190:7763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0047; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3190
msgctxt "text_id=7763 | speaker=aoko"
msgid "「とにかく納得いったみたいね。"
msgstr ""

#. Occurrence 6_4:3196:7764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7764 | speaker=aoko"
msgid "　じゃあ次、いよいよ本題。居間に移動するわよ。"
msgstr ""

#. Occurrence 6_4:3196:7765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7765 | speaker=aoko"
msgid "　説明しなくちゃいけない事が山ほどあるんだから。"
msgstr ""

#. Occurrence 6_4:3223:7766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0049; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3223
msgctxt "text_id=7766 | speaker=aoko"
msgid "　―――って、ひとりで立てる？」"
msgstr ""

#. Occurrence 6_4:3236:7767: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7767 | speaker=soujuurou"
msgid "「さっきから手を動かしてたから、血は巡ってる。"
msgstr ""

#. Occurrence 6_4:3236:7768: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7768 | speaker=soujuurou"
msgid "　歩くぐらいならいけそうだ」"
msgstr ""

#. Occurrence 6_4:3273:7769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0050; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3273
msgctxt "text_id=7769 | speaker=aoko"
msgid "「そ。なら問題ないわね」"
msgstr ""

#. Occurrence 6_4:3304:7770: scene=6_4
#: 6_4:3304
msgctxt "text_id=7770 | speaker=unknown"
msgid "　言うなり、彼女はくるりと草十郎に背を向けて歩きだした。"
msgstr ""

#. Occurrence 6_4:3309:7771: scene=6_4
#: 6_4:3309
msgctxt "text_id=7771 | speaker=unknown"
msgid "　その背中は、もう何度と見てきた颯爽とした後ろ姿だ。"
msgstr ""

#. Occurrence 6_4:3352:7772: scene=6_4
#: 6_4:3352
msgctxt "text_id=7772 | speaker=unknown"
msgid "　瞬間、落雷のように記憶が巻き戻される。"
msgstr ""

#. Occurrence 6_4:3401:7773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0040; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3401
msgctxt "text_id=7773 | speaker=soujuurou"
msgid "『……そうだった。蒼崎は、こういうヤツだった』"
msgstr ""

#. Occurrence 6_4:3407:7774: scene=6_4
#: 6_4:3407
msgctxt "text_id=7774 | speaker=unknown"
msgid "　知らず、頬がほころぶ。"
msgstr ""

#. Occurrence 6_4:3412:7775: scene=6_4
#: 6_4:3412
msgctxt "text_id=7775 | speaker=unknown"
msgid "　草十郎にとっては右も左も分からない状況だったけれど、それだけで彼は充分に落ち着けた。"
msgstr ""

#. Occurrence 6_4:3451:7776: scene=6_4
#: 6_4:3451
msgctxt "text_id=7776 | speaker=unknown"
msgid "　……今の青子は、ミラーハウスでの彼女とは違う。"
msgstr ""

#. Occurrence 6_4:3456:7777: scene=6_4
#: 6_4:3456
msgctxt "text_id=7777 | speaker=unknown"
msgid "　あんな、無理やりに思い詰めた彼女ではない。"
msgstr ""

#. Occurrence 6_4:3461:7778: scene=6_4
#: 6_4:3461
msgctxt "text_id=7778 | speaker=unknown"
msgid "　きびきびとした動作もためらいのない視線も、なんだかひどく懐かしい。"
msgstr ""

#. Occurrence 6_4:3466:7779: scene=6_4
#: 6_4:3466
msgctxt "text_id=7779 | speaker=unknown"
msgid "　それは初めて会った時と同じ、不機嫌そうで、そのくせ自信に満ちた彼女本来のあり方だった。"
msgstr ""

#. Occurrence 6_4:3528:7780: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0051; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3528
msgctxt "text_id=7780 | speaker=aoko"
msgid "「ほら、急いだ急いだ。"
msgstr ""

#. Occurrence 6_4:3534:7781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0052; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3534
msgctxt "text_id=7781 | speaker=aoko"
msgid "　有珠がさっきから居間でお待ちかねよ」"
msgstr ""

#. Occurrence 6_4:3540:7782: scene=6_4
#: 6_4:3540
msgctxt "text_id=7782 | speaker=unknown"
msgid "　彼女はとっくに扉から出て、薄ら寒そうな廊下に立っている。"
msgstr ""

#. Occurrence 6_4:3574:7783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0041; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3574
msgctxt "text_id=7783 | speaker=soujuurou"
msgid "「はあ。寝たきりの辛さを知らないだろう、蒼崎は」"
msgstr ""

#. Occurrence 6_4:3594:7784: scene=6_4
#: 6_4:3594
msgctxt "text_id=7784 | speaker=unknown"
msgid "　ぼやきつつ、草十郎はなんとかベッドから起き上がった。"
msgstr ""

#. Occurrence 6_4:3640:7785: scene=6_4
#: 6_4:3640
msgctxt "text_id=7785 | speaker=unknown"
msgid "　横臥中だるかった体は、立ち上がって歩こうとすると逆に硬く痛む。"
msgstr ""

#. Occurrence 6_4:3645:7786: scene=6_4
#: 6_4:3645
msgctxt "text_id=7786 | speaker=unknown"
msgid "　一歩前に出るだけで骨に<痺|しび>れと痛みが響いた。"
msgstr ""

#. Occurrence 6_4:3650:7787: scene=6_4
#: 6_4:3650
msgctxt "text_id=7787 | speaker=unknown"
msgid "　それでもしれっとした顔で青子へと歩きだす。"
msgstr ""

#. Occurrence 6_4:3670:7788: scene=6_4
#: 6_4:3670
msgctxt "text_id=7788 | speaker=unknown"
msgid "　苦いもの、厳しいものは無意識に受け入れる草十郎だったが、今回にかぎっては意識的に受け流した。"
msgstr ""

#. Occurrence 6_4:3675:7789: scene=6_4
#: 6_4:3675
msgctxt "text_id=7789 | speaker=unknown"
msgid "　要するにやせ我慢だ。彼がこんなふうに、不自然に自分の気持ちを抑えこむのは珍しい。"
msgstr ""

#. Occurrence 6_4:3727:7790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0053; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3727
msgctxt "text_id=7790 | speaker=aoko"
msgid "「驚いた。アンタ、ほんとにタフね」"
msgstr ""

#. Occurrence 6_4:3733:7791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0042; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3733
msgctxt "text_id=7791 | speaker=soujuurou"
msgid "「ありがとう。けど、心は弱いんだ」"
msgstr ""

#. Occurrence 6_4:3745:7792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0054; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3745
msgctxt "text_id=7792 | speaker=aoko"
msgid "「そ。参考までに心に留めておくわ。出来るだけ優しく扱えるようにね」"
msgstr ""

#. Occurrence 6_4:3750:7793: scene=6_4
#: 6_4:3750
msgctxt "text_id=7793 | speaker=unknown"
msgid "　もちろん、青子の声には優しさなど微塵もない。"
msgstr ""

#. Occurrence 6_4:3755:7794: scene=6_4
#: 6_4:3755
msgctxt "text_id=7794 | speaker=unknown"
msgid "　がっくりとする草十郎をよそに、青子はスタスタと廊下を歩きはじめる。"
msgstr ""

#. Occurrence 6_4:3794:7795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0055; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3794
msgctxt "text_id=7795 | speaker=aoko"
msgid "「―――、と」"
msgstr ""

#. Occurrence 6_4:3799:7796: scene=6_4
#: 6_4:3799
msgctxt "text_id=7796 | speaker=unknown"
msgid "　その時、何かを思い立ったように彼女はピタリと足を止めて振り向いた。"
msgstr ""

#. Occurrence 6_4:3804:7797: scene=6_4
#: 6_4:3804
msgctxt "text_id=7797 | speaker=unknown"
msgid "　言い忘れていた事、それでいて何でもない事を告げるように、"
msgstr ""

#. Occurrence 6_4:3858:7798: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0056; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3858
msgctxt "text_id=7798 | speaker=aoko"
msgid "「それじゃ行くわよ。付いてきて、草十郎」"
msgstr ""

#. Occurrence 6_4:3864:7799: scene=6_4
#: 6_4:3864
msgctxt "text_id=7799 | speaker=unknown"
msgid "　颯爽と振り向いて、彼女は自然にそう言った。"
msgstr ""

#. Occurrence 6_4:3917:7800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0043; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3917
msgctxt "text_id=7800 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_4:3924:7801: scene=6_4
#: 6_4:3924
msgctxt "text_id=7801 | speaker=unknown"
msgid "　その時に開かれた視界を、彼女は知らない。"
msgstr ""

#. Occurrence 6_4:3929:7802: scene=6_4
#: 6_4:3929
msgctxt "text_id=7802 | speaker=unknown"
msgid "　彼女が魔法使いだと言うのなら、この言葉こそ魔法だったことを、口にした当人だけが知らずじまい。"
msgstr ""

#. Occurrence 6_4:3934:7803: scene=6_4
#: 6_4:3934
msgctxt "text_id=7803 | speaker=unknown"
msgid "　彼は眩しいものを見たようにまばたきをした後、自然に頷いて、その背中を追いかけた。"
msgstr ""

#. Occurrence 6_5:49:7804: scene=6_5
#: 6_5:49
msgctxt "text_id=7804 | speaker=unknown"
msgid "　館の広さはかなりのものだった。"
msgstr ""

#. Occurrence 6_5:54:7805: scene=6_5
#: 6_5:54
msgctxt "text_id=7805 | speaker=unknown"
msgid "　三階建ての洋館は、部屋の数でも草十郎の住むアパートを上回っている。"
msgstr ""

#. Occurrence 6_5:59:7806: scene=6_5
#: 6_5:59
msgctxt "text_id=7806 | speaker=unknown"
msgid "　ただ、その広さは持てあまし気味だ。"
msgstr ""

#. Occurrence 6_5:64:7807: scene=6_5
#: 6_5:64
msgctxt "text_id=7807 | speaker=unknown"
msgid "　部屋数と住人の比率は合っていない。絨毯張りの廊下は、その豪華さとは裏腹に寒々しかった。"
msgstr ""

#. Occurrence 6_5:84:7808: scene=6_5
#: 6_5:84
msgctxt "text_id=7808 | speaker=unknown"
msgid "　草十郎が眠っていた客室は二階の東側にあった。"
msgstr ""

#. Occurrence 6_5:89:7809: scene=6_5
#: 6_5:89
msgctxt "text_id=7809 | speaker=unknown"
msgid "　一階に下りる階段はこの廊下の先、館の中央にあるらしい。"
msgstr ""

#. Occurrence 6_5:94:7810: scene=6_5
#: 6_5:94
msgctxt "text_id=7810 | speaker=unknown"
msgid "　窓から差しこむ冬の日射しが、廃墟じみた廊下をいっそう寂しく見せている。"
msgstr ""

#. Occurrence 6_5:146:7811: scene=6_5
#: 6_5:146
msgctxt "text_id=7811 | speaker=unknown"
msgid "　館の中央部は吹き抜けになっていて、そのまま一階の様子が見下ろせた。"
msgstr ""

#. Occurrence 6_5:151:7812: scene=6_5
#: 6_5:151
msgctxt "text_id=7812 | speaker=unknown"
msgid "　階段は壁に<沿|そ>って造られている。"
msgstr ""

#. Occurrence 6_5:156:7813: scene=6_5
#: 6_5:156
msgctxt "text_id=7813 | speaker=unknown"
msgid "　一階と二階を繋ぐ階段の他に、二階のホール裏には三階への階段もある。おそらく屋根裏に倉庫でもあるのだろう。"
msgstr ""

#. Occurrence 6_5:177:7814: scene=6_5
#: 6_5:177
msgctxt "text_id=7814 | speaker=unknown"
msgid "　きょろきょろと見渡している草十郎をよそに、青子は慣れた足取りで階段を下りていく。"
msgstr ""

#. Occurrence 6_5:203:7815: scene=6_5
#: 6_5:203
msgctxt "text_id=7815 | speaker=unknown"
msgid "　ロビーは一転して白色と木の空間だった。"
msgstr ""

#. Occurrence 6_5:209:7816: scene=6_5
#: 6_5:209
msgctxt "text_id=7816 | speaker=unknown"
msgid "　天井からの日射しが木の床を明るく照らす。"
msgstr ""

#. Occurrence 6_5:214:7817: scene=6_5
#: 6_5:214
msgctxt "text_id=7817 | speaker=unknown"
msgid "　壁は一面の白色。一点の汚れもなく、高い壁をより堅固に見せている。"
msgstr ""

#. Occurrence 6_5:235:7818: scene=6_5
#: 6_5:235
msgctxt "text_id=7818 | speaker=unknown"
msgid "　二階に続く階段と、"
msgstr ""

msgctxt "text_id=7819 | speaker=unknown"
msgid "　長らく使われていない暖炉。"
msgstr ""

#. Occurrence 6_5:243:7820: scene=6_5
#: 6_5:243
msgctxt "text_id=7820 | speaker=unknown"
msgid "　ぞんざいに放置された電話機と、"
msgstr ""

msgctxt "text_id=7821 | speaker=unknown"
msgid "　独りぼっちで時を刻む大時計。"
msgstr ""

#. Occurrence 6_5:272:7822: scene=6_5
#: 6_5:272
msgctxt "text_id=7822 | speaker=unknown"
msgid "　ここは洋館というより古城の様だ。"
msgstr ""

#. Occurrence 6_5:277:7823: scene=6_5
#: 6_5:277
msgctxt "text_id=7823 | speaker=unknown"
msgid "　あまりの異世界っぷりに呆然としている草十郎に、青子は冷たい視線を向ける。"
msgstr ""

#. Occurrence 6_5:304:7824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0000; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:304
msgctxt "text_id=7824 | speaker=aoko"
msgid "「居間はこっちよ。ぼさっとしない」"
msgstr ""

#. Occurrence 6_5:310:7825: scene=6_5
#: 6_5:310
msgctxt "text_id=7825 | speaker=unknown"
msgid "　彼女は階段横の扉に手を掛けた。"
msgstr ""

#. Occurrence 6_5:347:7826: scene=6_5
#: 6_5:347
msgctxt "text_id=7826 | speaker=unknown"
msgid "　ロビーには四つの扉があって、玄関から見て東側の扉が居間に続いているらしい。"
msgstr ""

#. Occurrence 6_5:352:7827: scene=6_5
#: 6_5:352
msgctxt "text_id=7827 | speaker=unknown"
msgid "　反対側にある西の扉は館の左翼に。"
msgstr ""

#. Occurrence 6_5:372:7828: scene=6_5
#: 6_5:372
msgctxt "text_id=7828 | speaker=unknown"
msgid "　南側の扉は玄関。"
msgstr ""

#. Occurrence 6_5:393:7829: scene=6_5
#: 6_5:393
msgctxt "text_id=7829 | speaker=unknown"
msgid "　北側、暖炉の横にはさらにもう一つ。"
msgstr ""

#. Occurrence 6_5:398:7830: scene=6_5
#: 6_5:398
msgctxt "text_id=7830 | speaker=unknown"
msgid "　階段の下に隠れている扉は浴場に続いているのだが、今の草十郎には知るよしもない。"
msgstr ""

#. Occurrence 6_5:445:7831: scene=6_5
#: 6_5:445
msgctxt "text_id=7831 | speaker=unknown"
msgid "　一階の廊下には窓がないため、全体的に薄暗い。"
msgstr ""

#. Occurrence 6_5:450:7832: scene=6_5
#: 6_5:450
msgctxt "text_id=7832 | speaker=unknown"
msgid "　さながら、二階は放置された診療所で、ロビーは日本とは思えない西洋の城。"
msgstr ""

#. Occurrence 6_5:455:7833: scene=6_5
#: 6_5:455
msgctxt "text_id=7833 | speaker=unknown"
msgid "　そして一階廊下はホテルを思わせる窓なき迷路。"
msgstr ""

#. Occurrence 6_5:476:7834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0000; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:476
msgctxt "text_id=7834 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 6_5:481:7835: scene=6_5
#: 6_5:481
msgctxt "text_id=7835 | speaker=unknown"
msgid "　都会に来て日が浅い草十郎にも、この洋館がただならぬものである事は感じ取れる。"
msgstr ""

#. Occurrence 6_5:486:7836: scene=6_5
#: 6_5:486
msgctxt "text_id=7836 | speaker=unknown"
msgid "　手放しで喜べないのは、そのお化け屋敷としばらく付き合う事になりそうだからだ。"
msgstr ""

#. Occurrence 6_5:521:7837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0001; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:521
msgctxt "text_id=7837 | speaker=aoko"
msgid "「そこが居間で、奥が厨房ね。簡単な料理ぐらいはできるようになってるから。"
msgstr ""

#. Occurrence 6_5:528:7838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_0; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:528
msgctxt "text_id=7838 | speaker=aoko"
msgid "　居間のとなりにはサンルームがあるんだけど、ここが食卓の代わり……"
msgstr ""

#. Occurrence 6_5:540:7839: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_1; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:540
msgctxt "text_id=7839 | speaker=aoko"
msgid "って、そんなの後でいっか」"
msgstr ""

#. Occurrence 6_5:546:7840: scene=6_5
#: 6_5:546
msgctxt "text_id=7840 | speaker=unknown"
msgid "　言って、青子は暗い廊下の扉に手を掛ける。"
msgstr ""

#. Occurrence 6_5:590:7841: scene=6_5
#: 6_5:590
msgctxt "text_id=7841 | speaker=unknown"
msgid "　ドアノブを回す<間際|まぎわ>。"
msgstr ""

#. Occurrence 6_5:623:7842: scene=6_5
#: 6_5:623
msgctxt "text_id=7842 | speaker=unknown"
msgid "　青子は意味ありげな<視線|コンタクト>を草十郎に送ったが、すぐに消した。"
msgstr ""

#. Occurrence 6_5:628:7843: scene=6_5
#: 6_5:628
msgctxt "text_id=7843 | speaker=unknown"
msgid "　ドアノブは待ったなしで回される。"
msgstr ""

#. Occurrence 6_5:699:7844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0003; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:699
msgctxt "text_id=7844 | speaker=aoko"
msgid "「お待たせ。承諾したわよ、あいつ」"
msgstr ""

#. Occurrence 6_5:705:7845: scene=6_5
#: 6_5:705
msgctxt "text_id=7845 | speaker=unknown"
msgid "　青子は居間に入りながら、中にいる有珠に語りかける。"
msgstr ""

#. Occurrence 6_5:710:7846: scene=6_5
#: 6_5:710
msgctxt "text_id=7846 | speaker=unknown"
msgid "　草十郎も少しだけ迷ってから、居間へと足を踏み入れた。"
msgstr ""

#. Occurrence 6_5:750:7847: scene=6_5
#: 6_5:750
msgctxt "text_id=7847 | speaker=unknown"
msgid "　廊下とは違い、居間は思いのほか現代的だった。"
msgstr ""

#. Occurrence 6_5:755:7848: scene=6_5
#: 6_5:755
msgctxt "text_id=7848 | speaker=unknown"
msgid "　絨毯の敷き詰められた床も、革のソファーも、30インチの大きなテレビも、草十郎がこれまで知り得た一般家庭の趣きに満ちている。"
msgstr ""

#. Occurrence 6_5:761:7849: scene=6_5
#: 6_5:761
msgctxt "text_id=7849 | speaker=unknown"
msgid "　その家庭的な居間のソファーに、家庭的な団らんとはかけ離れた少女が座っていた。"
msgstr ""

#. Occurrence 6_5:806:7850: scene=6_5
#: 6_5:806
msgctxt "text_id=7850 | speaker=unknown"
msgid "　青子は黒い少女の向かいのソファーに座る。"
msgstr ""

#. Occurrence 6_5:811:7851: scene=6_5
#: 6_5:811
msgctxt "text_id=7851 | speaker=unknown"
msgid "　草十郎に残された席は二つ。"
msgstr ""

#. Occurrence 6_5:835:7852: scene=6_5
#: 6_5:835
msgctxt "text_id=7852 | speaker=unknown"
msgid "　蒼崎青子のとなりか、"
msgstr ""

#. Occurrence 6_5:862:7853: scene=6_5
#: 6_5:862
msgctxt "text_id=7853 | speaker=unknown"
msgid "　久遠寺有珠のとなりか。"
msgstr ""

#. Occurrence 6_5:902:7854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0001; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:902
msgctxt "text_id=7854 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 6_5:938:7855: scene=6_5
#: 6_5:938
msgctxt "text_id=7855 | speaker=unknown"
msgid "　草十郎は二秒ほど悩んだ末、どっちも不吉な気がしたので壁ぎわで立つ道を選んだ。"
msgstr ""

#. Occurrence 6_5:943:7856: scene=6_5
#: 6_5:943
msgctxt "text_id=7856 | speaker=unknown"
msgid "　テーブルを挟んで青子と有珠は向き合っている。"
msgstr ""

#. Occurrence 6_5:948:7857: scene=6_5
#: 6_5:948
msgctxt "text_id=7857 | speaker=unknown"
msgid "　何も載せられていない真っ平らなテーブルが、どことなく寒い。"
msgstr ""

#. Occurrence 6_5:982:7858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0004; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:982
msgctxt "text_id=7858 | speaker=aoko"
msgid "「当事者も認めた事だし、これで何の問題もないわね、有珠」"
msgstr ""

#. Occurrence 6_5:1009:7859: scene=6_5
#: 6_5:1009
msgctxt "text_id=7859 | speaker=unknown"
msgid "　青子の念押しに、有珠はこくんとうなずいた。"
msgstr ""

#. Occurrence 6_5:1050:7860: scene=6_5
#: 6_5:1050
msgctxt "text_id=7860 | speaker=unknown"
msgid "　……こうして壁ぎわから見ていると、目に見えない文句のぶつけ合いが手に取るようだ。"
msgstr ""

#. Occurrence 6_5:1055:7861: scene=6_5
#: 6_5:1055
msgctxt "text_id=7861 | speaker=unknown"
msgid "　彼女たちの間で、自分の扱いについて一波乱あったんだな、と今更ながら草十郎は感じ取った。"
msgstr ""

#. Occurrence 6_5:1097:7862: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0000; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1097
msgctxt "text_id=7862 | speaker=alice"
msgid "「……そうね。原因も究明しないといけないし」"
msgstr ""

#. Occurrence 6_5:1131:7863: scene=6_5
#: 6_5:1131
msgctxt "text_id=7863 | speaker=unknown"
msgid "　<昏|くら>い色をした目が草十郎を流し見る。"
msgstr ""

#. Occurrence 6_5:1136:7864: scene=6_5
#: 6_5:1136
msgctxt "text_id=7864 | speaker=unknown"
msgid "　視線と同じ<抑揚|よくよう>のない声。"
msgstr ""

#. Occurrence 6_5:1141:7865: scene=6_5
#: 6_5:1141
msgctxt "text_id=7865 | speaker=unknown"
msgid "　そのくせ、草十郎の同居を認めていない意志がありありと伝わってくる。"
msgstr ""

#. Occurrence 6_5:1167:7866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0001; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1167
msgctxt "text_id=7866 | speaker=alice"
msgid "「けれど、貴方はそれでいいの？"
msgstr ""

#. Occurrence 6_5:1173:7867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0002; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1173
msgctxt "text_id=7867 | speaker=alice"
msgid "　遊園地での事を忘れてはいないでしょう？」"
msgstr ""

#. Occurrence 6_5:1179:7868: scene=6_5
#: 6_5:1179
msgctxt "text_id=7868 | speaker=unknown"
msgid "　有珠の声には批難と、試しの色が混ざっている。"
msgstr ""

#. Occurrence 6_5:1184:7869: scene=6_5
#: 6_5:1184
msgctxt "text_id=7869 | speaker=unknown"
msgid "　自分も青子も一般人からすれば危険物だ。そんな得体の知れない人間の<傍|そば>にいられるのか、と。"
msgstr ""

#. Occurrence 6_5:1229:7870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0002; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1229
msgctxt "text_id=7870 | speaker=soujuurou"
msgid "「そりゃあ夢だと思いこみたいけど、ちゃんと覚えてるし。できるだけ無事に済ませるには、これが一番<無難|ぶなん>そうだ」"
msgstr ""

#. Occurrence 6_5:1243:7871: scene=6_5
#: 6_5:1243
msgctxt "text_id=7871 | speaker=unknown"
msgid "　なにより命の保証はされてるみたいだし、と。"
msgstr ""

#. Occurrence 6_5:1277:7872: scene=6_5
#: 6_5:1277
msgctxt "text_id=7872 | speaker=unknown"
msgid "　返答する草十郎に、有珠はそう、と無関心げに答えた。"
msgstr ""

#. Occurrence 6_5:1282:7873: scene=6_5
#: 6_5:1282
msgctxt "text_id=7873 | speaker=unknown"
msgid "　そうして無言のまま、コトリ、とテーブルに小物を置く。"
msgstr ""

#. Occurrence 6_5:1350:7874: scene=6_5
#: 6_5:1350
msgctxt "text_id=7874 | speaker=unknown"
msgid "　白い指が置いた物は、<硝子|ガラス>の<小瓶|こびん>だった。"
msgstr ""

#. Occurrence 6_5:1355:7875: scene=6_5
#: 6_5:1355
msgctxt "text_id=7875 | speaker=unknown"
msgid "　ガラスは透明というより薄い青色をしていて、その色あいだけでも高級品だと見て取れる。"
msgstr ""

#. Occurrence 6_5:1360:7876: scene=6_5
#: 6_5:1360
msgctxt "text_id=7876 | speaker=unknown"
msgid "　有珠はその瓶の<蓋|ふた>を、鶴か何かを思わせる仕草で抜いた。"
msgstr ""

#. Occurrence 6_5:1404:7877: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0003; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1404
msgctxt "text_id=7877 | speaker=soujuurou"
msgid "『………………？』"
msgstr ""

#. Occurrence 6_5:1410:7878: scene=6_5
#: 6_5:1410
msgctxt "text_id=7878 | speaker=unknown"
msgid "　草十郎にとっては初めて見る小瓶だったが、妙にひっかかる物がある。"
msgstr ""

#. Occurrence 6_5:1415:7879: scene=6_5
#: 6_5:1415
msgctxt "text_id=7879 | speaker=unknown"
msgid "　しかし悲しいかな、何がネックなのか思い当たらない。"
msgstr ""

#. Occurrence 6_5:1467:7880: scene=6_5
#: 6_5:1467
msgctxt "text_id=7880 | speaker=unknown"
msgid "　青子が<傍観|ぼうかん>を決めこんでいるのも気にかかる。"
msgstr ""

#. Occurrence 6_5:1478:7881: scene=6_5
#: 6_5:1478
msgctxt "text_id=7881 | speaker=unknown"
msgid "　そんな、イヤな予感に気を張る草十郎に、有珠はもう一度視線を投げた。"
msgstr ""

#. Occurrence 6_5:1522:7882: scene=6_5
#: 6_5:1522
msgctxt "text_id=7882 | speaker=unknown"
msgid "　……少女の瞳は、やはり魔的な感じがする。"
msgstr ""

#. Occurrence 6_5:1527:7883: scene=6_5
#: 6_5:1527
msgctxt "text_id=7883 | speaker=unknown"
msgid "　そんなコトを思っていた草十郎に、有珠は表情のない顔で呼び掛けた。"
msgstr ""

#. Occurrence 6_5:1566:7884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0003; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1566
msgctxt "text_id=7884 | speaker=alice"
msgid "「静希君」、と。"
msgstr ""

#. Occurrence 6_5:1644:7885: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0004; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1644
msgctxt "text_id=7885 | speaker=soujuurou"
msgid "　{{{は―――い？}}}"
msgstr ""

#. Occurrence 6_5:1650:7886: scene=6_5
#: 6_5:1650
msgctxt "text_id=7886 | speaker=unknown"
msgid "　<囁|ささや>くような有珠の呼びかけに応えた瞬間。"
msgstr ""

#. Occurrence 6_5:1655:7887: scene=6_5
#: 6_5:1655
msgctxt "text_id=7887 | speaker=unknown"
msgid "　<彼|・>の周囲の風景は、かくのように一変していた。"
msgstr ""

#. Occurrence 6_5:1660:7888: scene=6_5
#: 6_5:1660
msgctxt "text_id=7888 | speaker=unknown"
msgid "　空気は色と形を持ったように<濁|にご>っている。"
msgstr ""

#. Occurrence 6_5:1665:7889: scene=6_5
#: 6_5:1665
msgctxt "text_id=7889 | speaker=unknown"
msgid "　重く肌に<纏|まと>わりつく密度の濃さ、不自由さは、さながら空気が文字になったようだ。"
msgstr ""

#. Occurrence 6_5:1730:7890: scene=6_5
#: 6_5:1730
msgctxt "text_id=7890 | speaker=unknown"
msgid "　{{{、―――、、―――！}}}"
msgstr ""

#. Occurrence 6_5:1736:7891: scene=6_5
#: 6_5:1736
msgctxt "text_id=7891 | speaker=unknown"
msgid "　息を吸う口から、<文字|いぶつ>が肺に入る錯覚に襲われる。"
msgstr ""

#. Occurrence 6_5:1741:7892: scene=6_5
#: 6_5:1741
msgctxt "text_id=7892 | speaker=unknown"
msgid "　咄嗟に口を<塞|ふさ>ぐ右手も、胸を押さえる左手も、きちんと見えるのによく見えない。"
msgstr ""

#. Occurrence 6_5:1746:7893: scene=6_5
#: 6_5:1746
msgctxt "text_id=7893 | speaker=unknown"
msgid "　山で出会った深い霧だって、ここまで意識を<拐|かどわ>かす事はなかったはずだ。"
msgstr ""

#. Occurrence 6_5:1804:7894: scene=6_5
#: 6_5:1804
msgctxt "text_id=7894 | speaker=unknown"
msgid "　―――喩えるなら、そう。"
msgstr ""

#. Occurrence 6_5:1810:7895: scene=6_5
#: 6_5:1810
msgctxt "text_id=7895 | speaker=unknown"
msgid "　まったく見当違いの比喩ではあるが、まるで生身のまま、<新|・><聞|・><紙|・><の|・><中|・><で|・>立っているような。"
msgstr ""

#. Occurrence 6_5:1859:7896: scene=6_5
#: 6_5:1859
msgctxt "text_id=7896 | speaker=unknown"
msgid "　味わった事のない方位感覚に、まず聴覚から慣れていく。"
msgstr ""

#. Occurrence 6_5:1864:7897: scene=6_5
#: 6_5:1864
msgctxt "text_id=7897 | speaker=unknown"
msgid "　呼吸は普段通りだが、ざらついた圧迫感がある。"
msgstr ""

#. Occurrence 6_5:1869:7898: scene=6_5
#: 6_5:1869
msgctxt "text_id=7898 | speaker=unknown"
msgid "　別に閉じこめられている訳ではないのに、この周りはひどく<狭|せま>い。"
msgstr ""

#. Occurrence 6_5:1874:7899: scene=6_5
#: 6_5:1874
msgctxt "text_id=7899 | speaker=unknown"
msgid "　突然の異変に驚くより先に、その狭さから逃れるために手を伸ばしたほどだ。"
msgstr ""

#. Occurrence 6_5:1901:7900: scene=6_5
#: 6_5:1901
msgctxt "text_id=7900 | speaker=unknown"
msgid "　けれど伸ばした手は<空|くう>を切るだけ。"
msgstr ""

#. Occurrence 6_5:1906:7901: scene=6_5
#: 6_5:1906
msgctxt "text_id=7901 | speaker=unknown"
msgid "　周囲に壁はなく、これだけ見晴らしのいい場所で「狭い」と感じること自体、常軌を逸している。"
msgstr ""

#. Occurrence 6_5:1911:7902: scene=6_5
#: 6_5:1911
msgctxt "text_id=7902 | speaker=unknown"
msgid "　深い霧の日は神隠しに遭う―――"
msgstr ""

#. Occurrence 6_5:1916:7903: scene=6_5
#: 6_5:1916
msgctxt "text_id=7903 | speaker=unknown"
msgid "　山でのそんな<口伝|くでん>を信じていた<彼|・>ではなかったが、これは本当に神隠しの領域では、と思いかけて、"
msgstr ""

#. Occurrence 6_5:1986:7904: scene=6_5
#: 6_5:1986
msgctxt "text_id=7904 | speaker=unknown"
msgid "　そこでようやく、"
msgstr ""

#. Occurrence 6_5:1993:7905: scene=6_5
#: 6_5:1993
msgctxt "text_id=7905 | speaker=unknown"
msgid "　彼はもっと別の、"
msgstr ""

#. Occurrence 6_5:2000:7906: scene=6_5
#: 6_5:2000
msgctxt "text_id=7906 | speaker=unknown"
msgid "　驚かなくてはいけないコトに気が付いた。"
msgstr ""

#. Occurrence 6_5:2020:7907: scene=6_5
#: 6_5:2020
msgctxt "text_id=7907 | speaker=unknown"
msgid "　そもそもの話、居間が別世界に一変した訳ではない。"
msgstr ""

#. Occurrence 6_5:2025:7908: scene=6_5
#: 6_5:2025
msgctxt "text_id=7908 | speaker=unknown"
msgid "　なぜなら霧ごしに見える景色は、間違いなく<彼|・>が先ほどまで居た居間の物だったし、"
msgstr ""

#. Occurrence 6_5:2030:7909: scene=6_5
#: 6_5:2030
msgctxt "text_id=7909 | speaker=unknown"
msgid "　その場にいた二人の少女―――蒼崎青子と久遠寺有珠の姿もきちんと見えている。"
msgstr ""

#. Occurrence 6_5:2036:7910: scene=6_5
#: 6_5:2036
msgctxt "text_id=7910 | speaker=unknown"
msgid "　ただ、その見え方に問題があっただけだ。"
msgstr ""

#. Occurrence 6_5:2120:7911: scene=6_5
#: 6_5:2120
msgctxt "text_id=7911 | speaker=unknown"
msgid "　地面は黒い、真っ平らな地平だった。"
msgstr ""

#. Occurrence 6_5:2125:7912: scene=6_5
#: 6_5:2125
msgctxt "text_id=7912 | speaker=unknown"
msgid "　そこから見上げるようにして二人の姿が見える。"
msgstr ""

#. Occurrence 6_5:2131:7913: scene=6_5
#: 6_5:2131
msgctxt "text_id=7913 | speaker=unknown"
msgid "　現実味のない、入道雲の様に大きな少女が、冷たい瞳を向けている。"
msgstr ""

#. Occurrence 6_5:2151:7914: scene=6_5
#: 6_5:2151
msgctxt "text_id=7914 | speaker=unknown"
msgid "　部屋の構造、そこにあった家具の位置関係を思い出し、<彼|・>は信じがたい素直さで、この事態を把握した。"
msgstr ""

#. Occurrence 6_5:2156:7915: scene=6_5
#: 6_5:2156
msgctxt "text_id=7915 | speaker=unknown"
msgid "　あの遊園地でのパレードを経験しておいて、なお信じられない、と頭を抱えそうだが。"
msgstr ""

#. Occurrence 6_5:2215:7916: scene=6_5
#: 6_5:2215
msgctxt "text_id=7916 | speaker=unknown"
msgid "　<此|・><処|・>は間違いなく、久遠寺有珠が取り出した小瓶の中であるらしい。"
msgstr ""

#. Occurrence 6_5:2249:7917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0005; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2249
msgctxt "text_id=7917 | speaker=aoko"
msgid "「<図|はか>らずも」"
msgstr ""

#. Occurrence 6_5:2255:7918: scene=6_5
#: 6_5:2255
msgctxt "text_id=7918 | speaker=unknown"
msgid "　青子は有珠の性根の悪さに呆れながら、テーブルに置かれた小瓶をチラ見する。"
msgstr ""

#. Occurrence 6_5:2272:7919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7919 | speaker=aoko"
msgid "「二日前の夜と同じ状況になったわね。"
msgstr ""

#. Occurrence 6_5:2272:7920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7920 | speaker=aoko"
msgid "　今回、<草十郎|ソイツ>は起きてるけど」"
msgstr ""

#. Occurrence 6_5:2303:7921: scene=6_5
#: 6_5:2303
msgctxt "text_id=7921 | speaker=unknown"
msgid "　淡々と青子は語った。"
msgstr ""

#. Occurrence 6_5:2327:7922: scene=6_5
#: 6_5:2327
msgctxt "text_id=7922 | speaker=unknown"
msgid "　有珠はというと、小瓶には視線も落とさず、目前の青子を見つめている。"
msgstr ""

#. Occurrence 6_5:2354:7923: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0004; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2354
msgctxt "text_id=7923 | speaker=alice"
msgid "「……意外ね。青子は怒ると思ってたのに」"
msgstr ""

#. Occurrence 6_5:2374:7924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0007; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2374
msgctxt "text_id=7924 | speaker=aoko"
msgid "「いや、私も似たようなコト考えてたから。"
msgstr ""

#. Occurrence 6_5:2380:7925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0008; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2380
msgctxt "text_id=7925 | speaker=aoko"
msgid "　少しは魔術ってもんを思い知らせておかないと困るでしょ。"
msgstr ""

#. Occurrence 6_5:2387:7926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0009; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2387
msgctxt "text_id=7926 | speaker=aoko"
msgid "有珠がやってくれるなら止めはしないし<怒|おこ>りもしないわ。"
msgstr ""

#. Occurrence 6_5:2393:7927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0010; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2393
msgctxt "text_id=7927 | speaker=aoko"
msgid "　……ま、こっちが予定していたものより何倍もメチャクチャだけど」"
msgstr ""

#. Occurrence 6_5:2429:7928: scene=6_5
#: 6_5:2429
msgctxt "text_id=7928 | speaker=unknown"
msgid "　言いつつ、青子は小瓶から視線を外さない。"
msgstr ""

#. Occurrence 6_5:2434:7929: scene=6_5
#: 6_5:2434
msgctxt "text_id=7929 | speaker=unknown"
msgid "　有珠の魔術に無関心を装っているものの、興味を隠しきれていない。"
msgstr ""

#. Occurrence 6_5:2454:7930: scene=6_5
#: 6_5:2454
msgctxt "text_id=7930 | speaker=unknown"
msgid "　小瓶の中の人影はようやく事態が飲みこめたのか、バタバタと手を伸ばしたり、全力で走ってみたり、色々と試行錯誤しているように見えた。"
msgstr ""

#. Occurrence 6_5:2459:7931: scene=6_5
#: 6_5:2459
msgctxt "text_id=7931 | speaker=unknown"
msgid "　小瓶の表面が<濁|にご>っているため、<外|そ><界|と>からでは<瓶|なか>の様子はぼんやりとしか分からない。"
msgstr ""

#. Occurrence 6_5:2499:7932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0011; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2499
msgctxt "text_id=7932 | speaker=aoko"
msgid "「……ところで、これって私にくれたヤツとは別物みたいだけど」"
msgstr ""

#. Occurrence 6_5:2523:7933: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0005; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2523
msgctxt "text_id=7933 | speaker=alice"
msgid "「アレより作りは細かいわ。"
msgstr ""

#. Occurrence 6_5:2530:7934: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0006; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2530
msgctxt "text_id=7934 | speaker=alice"
msgid "青子にあげたのは使い捨ての、隔離するだけの物よ。コレはお互いの声も聞こえるから」"
msgstr ""

#. Occurrence 6_5:2574:7935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0012; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2574
msgctxt "text_id=7935 | speaker=aoko"
msgid "「へえ。けど、そのわりには何の反応もないわね」"
msgstr ""

#. Occurrence 6_5:2587:7936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0007; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2587
msgctxt "text_id=7936 | speaker=alice"
msgid "「青子には聞こえないだけよ」"
msgstr ""

#. Occurrence 6_5:2610:7937: scene=6_5
#: 6_5:2610
msgctxt "text_id=7937 | speaker=unknown"
msgid "　平然と言って、有珠は小瓶へ視線を落とした。"
msgstr ""

#. Occurrence 6_5:2615:7938: scene=6_5
#: 6_5:2615
msgctxt "text_id=7938 | speaker=unknown"
msgid "　同時に人影の動きが止まる。"
msgstr ""

#. Occurrence 6_5:2620:7939: scene=6_5
#: 6_5:2620
msgctxt "text_id=7939 | speaker=unknown"
msgid "　どうやら有珠だけが、小瓶の中の別世界と関わりが持てるようだ。"
msgstr ""

#. Occurrence 6_5:2654:7940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0013; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2654
msgctxt "text_id=7940 | speaker=aoko"
msgid "『……なんだ、術者にしか特典はないんだ』"
msgstr ""

#. Occurrence 6_5:2660:7941: scene=6_5
#: 6_5:2660
msgctxt "text_id=7941 | speaker=unknown"
msgid "　つまらなそうに<嘆息|たんそく>する青子。"
msgstr ""

#. Occurrence 6_5:2665:7942: scene=6_5
#: 6_5:2665
msgctxt "text_id=7942 | speaker=unknown"
msgid "　そんな青子をよそに、有珠は誰に話しかけるのでもなく口を開けた。"
msgstr ""

#. Occurrence 6_5:2710:7943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0008; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2710
msgctxt "text_id=7943 | speaker=alice"
msgid "「どう？　これでも一番、無難だと思う……？」"
msgstr ""

#. Occurrence 6_5:2716:7944: scene=6_5
#: 6_5:2716
msgctxt "text_id=7944 | speaker=unknown"
msgid "　語りかける相手は、言うまでもなく小瓶の中の人影だ。"
msgstr ""

#. Occurrence 6_5:2721:7945: scene=6_5
#: 6_5:2721
msgctxt "text_id=7945 | speaker=unknown"
msgid "　先ほどの会話。"
msgstr ""

#. Occurrence 6_5:2726:7946: scene=6_5
#: 6_5:2726
msgctxt "text_id=7946 | speaker=unknown"
msgid "　この洋館に住む事が無難だと言った彼の言葉を、少女はこんなカタチで確認しているのだ。"
msgstr ""

#. Occurrence 6_5:2770:7947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0014; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2770
msgctxt "text_id=7947 | speaker=aoko"
msgid "『……いきなり小瓶に閉じこめて聞き返すあたり容赦ないというか……この子の洋館への執着も問題よね……』"
msgstr ""

#. Occurrence 6_5:2776:7948: scene=6_5
#: 6_5:2776
msgctxt "text_id=7948 | speaker=unknown"
msgid "　が、目撃者をミラーハウスに誘いこんで、正々堂々と殺し合いをしよう、と提案した自分が批難できる事でもない。"
msgstr ""

#. Occurrence 6_5:2787:7949: scene=6_5
#: 6_5:2787
msgctxt "text_id=7949 | speaker=unknown"
msgid "　青子は有珠が感情的になって手をあげないよう注意しつつ、あくまで傍観者として事の顛末を見定めている。"
msgstr ""

#. Occurrence 6_5:2844:7950: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0009; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2844
msgctxt "text_id=7950 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_5:2849:7951: scene=6_5
#: 6_5:2849
msgctxt "text_id=7951 | speaker=unknown"
msgid "　少し間をおいて、有珠の表情が変化した。"
msgstr ""

#. Occurrence 6_5:2854:7952: scene=6_5
#: 6_5:2854
msgctxt "text_id=7952 | speaker=unknown"
msgid "　少女の問いかけに、人影は何らかの返答をしたらしい。"
msgstr ""

#. Occurrence 6_5:2859:7953: scene=6_5
#: 6_5:2859
msgctxt "text_id=7953 | speaker=unknown"
msgid "　小瓶の中の様子を探れない青子には彼がなんと返答したかは分からない。"
msgstr ""

#. Occurrence 6_5:2864:7954: scene=6_5
#: 6_5:2864
msgctxt "text_id=7954 | speaker=unknown"
msgid "　ただ、"
msgstr ""

#. Occurrence 6_5:2896:7955: scene=6_5
#: 6_5:2896
msgctxt "text_id=7955 | speaker=unknown"
msgid "　相方がああいう顔をしている時は、完膚無きまで、相手の言い分が正しかった時なのだった。"
msgstr ""

#. Occurrence 6_5:2958:7956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0010; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2958
msgctxt "text_id=7956 | speaker=alice"
msgid "「……わたしが言える事でもないけど」"
msgstr ""

#. Occurrence 6_5:2981:7957: scene=6_5
#: 6_5:2981
msgctxt "text_id=7957 | speaker=unknown"
msgid "　少女は一瞬、青子を<一瞥|いちべつ>する。"
msgstr ""

#. Occurrence 6_5:2986:7958: scene=6_5
#: 6_5:2986
msgctxt "text_id=7958 | speaker=unknown"
msgid "　有珠はかすかにかぶりをふって小瓶に手を伸ばし、"
msgstr ""

#. Occurrence 6_5:3024:7959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0011; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3024
msgctxt "text_id=7959 | speaker=alice"
msgid "「……本当。物好きね、静希君は」"
msgstr ""

#. Occurrence 6_5:3030:7960: scene=6_5
#: 6_5:3030
msgctxt "text_id=7960 | speaker=unknown"
msgid "　<憂鬱|ゆううつ>げなため息のように、彼の名前を口にした。"
msgstr ""

#. Occurrence 6_5:3072:7961: scene=6_5
#: 6_5:3072
msgctxt "text_id=7961 | speaker=unknown"
msgid "　<蓋|フタ>が抜かれた瞬間、居間の空気がわずかに揺れた。"
msgstr ""

#. Occurrence 6_5:3077:7962: scene=6_5
#: 6_5:3077
msgctxt "text_id=7962 | speaker=unknown"
msgid "　かと思うと、先ほどまで壁際に影だけ映していた少年が、<憮然|ぶぜん>とした顔で壁に寄りかかっていた。"
msgstr ""

#. Occurrence 6_5:3082:7963: scene=6_5
#: 6_5:3082
msgctxt "text_id=7963 | speaker=unknown"
msgid "　ちょうど自分の背後にいる草十郎へ、青子は片肘をついたまま振り向く。"
msgstr ""

#. Occurrence 6_5:3116:7964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0015; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3116
msgctxt "text_id=7964 | speaker=aoko"
msgid "「どう、気分は？」"
msgstr ""

#. Occurrence 6_5:3141:7965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0006; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3141
msgctxt "text_id=7965 | speaker=soujuurou"
msgid "「見ての通り、めちゃくちゃだ」"
msgstr ""

#. Occurrence 6_5:3147:7966: scene=6_5
#: 6_5:3147
msgctxt "text_id=7966 | speaker=unknown"
msgid "　草十郎は柄にもなく敵意をむき出しにしていた。"
msgstr ""

#. Occurrence 6_5:3152:7967: scene=6_5
#: 6_5:3152
msgctxt "text_id=7967 | speaker=unknown"
msgid "　<怯|おび>えや驚きではなく怒っているあたり、相変わらず謎なヤツ、と青子は思う。"
msgstr ""

#. Occurrence 6_5:3190:7968: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0007; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3190
msgctxt "text_id=7968 | speaker=soujuurou"
msgid "「……夢で似たようなものを見てなかったら、今ごろ心臓が止まってたところだ。そこはついてたと思う。"
msgstr ""

#. Occurrence 6_5:3197:7969: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_0; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3197
msgctxt "text_id=7969 | speaker=soujuurou"
msgid "　信じられないのは、なんでいちいち実践するかって事だ。魔術は恐いものなんだって言えば済むだろうに。"
msgstr ""

#. Occurrence 6_5:3211:7970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_1; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3211
msgctxt "text_id=7970 | speaker=soujuurou"
msgid "それと、ぶっそうな蒼崎の声、聞こえてたぞ」"
msgstr ""

#. Occurrence 6_5:3251:7971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0016; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3251
msgctxt "text_id=7971 | speaker=aoko"
msgid "「ぶっそうで悪うございました。"
msgstr ""

#. Occurrence 6_5:3258:7972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0017; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3258
msgctxt "text_id=7972 | speaker=aoko"
msgid "けど、言葉じゃなくてきちんと実感してもらいたかったのは本当よ。"
msgstr ""

#. Occurrence 6_5:3264:7973: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0018; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3264
msgctxt "text_id=7973 | speaker=aoko"
msgid "　どう？　魔術ってもんを甘く見てたでしょ、草十郎？」"
msgstr ""

#. Occurrence 6_5:3297:7974: scene=6_5
#: 6_5:3297
msgctxt "text_id=7974 | speaker=unknown"
msgid "　不本意ながらも、むう、と納得する草十郎。"
msgstr ""

#. Occurrence 6_5:3302:7975: scene=6_5
#: 6_5:3302
msgctxt "text_id=7975 | speaker=unknown"
msgid "　彼の場合、『甘く見ていた』と言うより『分かっていなかった』と言う方が正しいのだが。"
msgstr ""

#. Occurrence 6_5:3323:7976: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0009; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3323
msgctxt "text_id=7976 | speaker=soujuurou"
msgid "「けど、実感うんぬん言われても困る。"
msgstr ""

#. Occurrence 6_5:3329:7977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0010; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3329
msgctxt "text_id=7977 | speaker=soujuurou"
msgid "　これまでの蒼崎の無茶っぷりと、今の訳の分からなさはとても比べられない」"
msgstr ""

#. Occurrence 6_5:3348:7978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0019; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3348
msgctxt "text_id=7978 | speaker=aoko"
msgid "「ちょ、"
msgstr ""

msgctxt "text_id=7979 | speaker=unknown"
msgid "そりゃそうよ、有珠と比べないでよね。"
msgstr ""

#. Occurrence 6_5:3361:7980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0020; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3361
msgctxt "text_id=7980 | speaker=aoko"
msgid "　有珠の魔術は私たちの中でもデタラメで、もう言葉にできないぐらい最悪なんだって言ったでしょ」"
msgstr ""

#. Occurrence 6_5:3401:7981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0012; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3401
msgctxt "text_id=7981 | speaker=alice"
msgid "「……失礼ね。人命を<脅|おびや>かす、という点なら青子の方がよっぽど酷いと思うけど。"
msgstr ""

#. Occurrence 6_5:3413:7982: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0013; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3413
msgctxt "text_id=7982 | speaker=alice"
msgid "　それより貴女、本当に彼を殺す気はあったの？"
msgstr ""

#. Occurrence 6_5:3419:7983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0014; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3419
msgctxt "text_id=7983 | speaker=alice"
msgid "　一体どんな追いつめ方をすれば、蒼崎ならたぶん安全、なんて言葉が返ってくるのかしらね」"
msgstr ""

#. Occurrence 6_5:3464:7984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0021; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3464
msgctxt "text_id=7984 | speaker=aoko"
msgid "「そ―――"
msgstr ""

msgctxt "text_id=7985 | speaker=unknown"
msgid "そんなのあったに決まってるでしょ！"
msgstr ""

#. Occurrence 6_5:3478:7986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0022; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3478
msgctxt "text_id=7986 | speaker=aoko"
msgid "　コイツがなんて言ったか知らないけど、ぜったい意味違うから！"
msgstr ""

#. Occurrence 6_5:3484:7987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0023; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3484
msgctxt "text_id=7987 | speaker=aoko"
msgid "　<草十郎|コイツ>はね、そもそも何が危ないのか<火傷|ヤケド>するまで気付かない……"
msgstr ""

#. Occurrence 6_5:3496:7988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0024; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3496
msgctxt "text_id=7988 | speaker=aoko"
msgid "っていうか、火傷しても“よし、死ななきゃ安い”なんて本気で思っちゃう天然ボケなのっ！"
msgstr ""

#. Occurrence 6_5:3531:7989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0025; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3531
msgctxt "text_id=7989 | speaker=aoko"
msgid "　ね、そうでしょ草十郎！？」"
msgstr ""

#. Occurrence 6_5:3567:7990: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0011; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3567
msgctxt "text_id=7990 | speaker=soujuurou"
msgid "「え？」"
msgstr ""

#. Occurrence 6_5:3572:7991: scene=6_5
#: 6_5:3572
msgctxt "text_id=7991 | speaker=unknown"
msgid "　とつぜん怒鳴られ、よく分からないクセに「うん、まあ」とうなずく天然なんとか。"
msgstr ""

#. Occurrence 6_5:3610:7992: scene=6_5
#: 6_5:3610
msgctxt "text_id=7992 | speaker=unknown"
msgid "　居間は騒がしいコトこの上ない。"
msgstr ""

#. Occurrence 6_5:3621:7993: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0015; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3621
msgctxt "text_id=7993 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 6_5:3626:7994: scene=6_5
#: 6_5:3626
msgctxt "text_id=7994 | speaker=unknown"
msgid "　そんなふたりを、有珠は<呆|あき>れたように見つめていた。"
msgstr ""

#. Occurrence 6_6:54:7995: scene=6_6
#: 6_6:54
msgctxt "text_id=7995 | speaker=unknown"
msgid "　ともあれ、草十郎は洋館での監視生活を承諾した。"
msgstr ""

#. Occurrence 6_6:59:7996: scene=6_6
#: 6_6:59
msgctxt "text_id=7996 | speaker=unknown"
msgid "　魔術を<生業|なりわい>とする者と屋根を同じくすること。"
msgstr ""

#. Occurrence 6_6:64:7997: scene=6_6
#: 6_6:64
msgctxt "text_id=7997 | speaker=unknown"
msgid "　それがどれだけ危険であるのか、身をもって体験させられた上で、"
msgstr ""

#. Occurrence 6_6:117:7998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0000; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:117
msgctxt "text_id=7998 | speaker=soujuurou"
msgid "「うん、まあ、そういう事なら」"
msgstr ""

#. Occurrence 6_6:123:7999: scene=6_6
#: 6_6:123
msgctxt "text_id=7999 | speaker=unknown"
msgid "　とてもそうは見えないが、彼なりに真剣に考えた末で、はっきりと答えたのである。"
msgstr ""

#. Occurrence 6_6:156:8000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0000; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:156
msgctxt "text_id=8000 | speaker=aoko"
msgid "「それじゃ、やっと本題に入れるわね。"
msgstr ""

#. Occurrence 6_6:162:8001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0001; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:162
msgctxt "text_id=8001 | speaker=aoko"
msgid "　監視するとは言ったけど、どうやって草十郎を監視するのか。そもそも、貴方を監視する原因になった『魔術』とは何なのか。そのあたり、ざざっと説明させてもらうわ」"
msgstr ""

#. Occurrence 6_6:199:8002: scene=6_6
#: 6_6:199
msgctxt "text_id=8002 | speaker=unknown"
msgid "　新しい規則のレクチャーはきちんと聞くように教育されているのか、草十郎はいいぞ、と身構える。"
msgstr ""

#. Occurrence 6_6:227:8003: scene=6_6
#: 6_6:227
msgctxt "text_id=8003 | speaker=unknown"
msgid "　一方、有珠はまだ不満があるようで、かたくなに口を閉ざしていた。"
msgstr ""

#. Occurrence 6_6:274:8004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0002; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:274
msgctxt "text_id=8004 | speaker=aoko"
msgid "「最初に言っておくと、アンタをここに住まわせる期限は決まってるから。"
msgstr ""

#. Occurrence 6_6:280:8005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0003; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:280
msgctxt "text_id=8005 | speaker=aoko"
msgid "　要はその期限まで、誰にも私たちの事をしゃべらず、また、勝手に死ななければ晴れて自由の身ってこと。"
msgstr ""

#. Occurrence 6_6:297:8006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0004; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:297
msgctxt "text_id=8006 | speaker=aoko"
msgid "　ね、そうよね有珠？」"
msgstr ""

#. Occurrence 6_6:337:8007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0000; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:337
msgctxt "text_id=8007 | speaker=alice"
msgid "「……そうね。わたしたちを怒らせなければ、そういう可能性もあるわね」"
msgstr ""

#. Occurrence 6_6:362:8008: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0001; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:362
msgctxt "text_id=8008 | speaker=soujuurou"
msgid "「よし、いきなり話が食い違ってる」"
msgstr ""

#. Occurrence 6_6:367:8009: scene=6_6
#: 6_6:367
msgctxt "text_id=8009 | speaker=unknown"
msgid "　<予|う><想|ん><通|う><り|ん>、とうなずく草十郎と、"
msgstr ""

#. Occurrence 6_6:403:8010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0005; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:403
msgctxt "text_id=8010 | speaker=aoko"
msgid "「ちょっと黙ってて有珠。"
msgstr ""

#. Occurrence 6_6:419:8011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0006; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:419
msgctxt "text_id=8011 | speaker=aoko"
msgid "あとアンタも黙ってろ」"
msgstr ""

#. Occurrence 6_6:424:8012: scene=6_6
#: 6_6:424
msgctxt "text_id=8012 | speaker=unknown"
msgid "　そんなふたりを睨みつける、気苦労の多い青子。"
msgstr ""

#. Occurrence 6_6:469:8013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0007; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:469
msgctxt "text_id=8013 | speaker=aoko"
msgid "「……話を続けるけど。"
msgstr ""

#. Occurrence 6_6:481:8014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0008; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:481
msgctxt "text_id=8014 | speaker=aoko"
msgid "　秘密保持のためにアンタを住まわせる場合、二次災害はどうしても避けられない。"
msgstr ""

#. Occurrence 6_6:487:8015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0009; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:487
msgctxt "text_id=8015 | speaker=aoko"
msgid "　同じ家にいる以上、余計に秘密を見せる事になるからね。有珠はそれがイヤなんだろうけど」"
msgstr ""

#. Occurrence 6_6:519:8016: scene=6_6
#: 6_6:519
msgctxt "text_id=8016 | speaker=unknown"
msgid "　言われてみればその通りだ。"
msgstr ""

#. Occurrence 6_6:524:8017: scene=6_6
#: 6_6:524
msgctxt "text_id=8017 | speaker=unknown"
msgid "　監視対象を軟禁した場合、更なる内部事情の<露呈|ろてい>は避けられない。"
msgstr ""

#. Occurrence 6_6:561:8018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0002; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:561
msgctxt "text_id=8018 | speaker=soujuurou"
msgid "「ちょっと待ってくれ。どうどう巡りじゃないか、それ？」"
msgstr ""

#. Occurrence 6_6:567:8019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0010; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:567
msgctxt "text_id=8019 | speaker=aoko"
msgid "「大丈夫、問題ないわ。だって、最後にはここで暮らした記憶ごと、私たちの事を忘れてもらう事にしたから」"
msgstr ""

#. Occurrence 6_6:589:8020: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0003; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:589
msgctxt "text_id=8020 | speaker=soujuurou"
msgid "「―――忘れてもらう？」"
msgstr ""

#. Occurrence 6_6:610:8021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0011; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:610
msgctxt "text_id=8021 | speaker=aoko"
msgid "「そ。公園での一件からまるごと全部、忘れてもらう。"
msgstr ""

#. Occurrence 6_6:616:8022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0012; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:616
msgctxt "text_id=8022 | speaker=aoko"
msgid "　ルーンっていう魔術系統があるんだけどね、その中でサクッと記憶を忘れさせる物があるのよ。"
msgstr ""

#. Occurrence 6_6:622:8023: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0013; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:622
msgctxt "text_id=8023 | speaker=aoko"
msgid "　非人道的であるのは変わらないけど、ま、命を消すかわりに記憶を消すって事で妥協して」"
msgstr ""

#. Occurrence 6_6:649:8024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0004; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:649
msgctxt "text_id=8024 | speaker=soujuurou"
msgid "「――――蒼崎、それは」"
msgstr ""

#. Occurrence 6_6:674:8025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0014; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:674
msgctxt "text_id=8025 | speaker=aoko"
msgid "「悪いけど反論は却下。"
msgstr ""

#. Occurrence 6_6:680:8026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0015; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:680
msgctxt "text_id=8026 | speaker=aoko"
msgid "　で、肝心の<忘却|ぼうきゃく>のルーンなんだけど。私も有珠も専門外だから、文献を探して修得するのに時間がかかる。"
msgstr ""

#. Occurrence 6_6:686:8027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0016; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:686
msgctxt "text_id=8027 | speaker=aoko"
msgid "　つまり、それが監視の期限ってワケ。"
msgstr ""

#. Occurrence 6_6:692:8028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0017; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:692
msgctxt "text_id=8028 | speaker=aoko"
msgid "　私たちが忘却のルーンを見つけるまで、命を担保に口を閉じていてもらうわ」"
msgstr ""

#. Occurrence 6_6:719:8029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0018; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:719
msgctxt "text_id=8029 | speaker=aoko"
msgid "「有珠はそんなややこしい事はせずに、五感全部壊してしまおうなんて言ってるけど。"
msgstr ""

#. Occurrence 6_6:732:8030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0019; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:732
msgctxt "text_id=8030 | speaker=aoko"
msgid "　―――静希君、<彫像生活|リビングスタチュー>とか嫌でしょ？」"
msgstr ""

#. Occurrence 6_6:769:8031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0005; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:769
msgctxt "text_id=8031 | speaker=soujuurou"
msgid "「む」"
msgstr ""

#. Occurrence 6_6:774:8032: scene=6_6
#: 6_6:774
msgctxt "text_id=8032 | speaker=unknown"
msgid "　青子の言っている事は八割納得できる草十郎だったが、最後のリビングスタチュー、という単語はあまりにも意味不明だった。"
msgstr ""

#. Occurrence 6_6:779:8033: scene=6_6
#: 6_6:779
msgctxt "text_id=8033 | speaker=unknown"
msgid "　できるかぎり想像力を働かせるも、こう、キッツィーちゃんばりのクリーチャーしか想像できない。"
msgstr ""

#. Occurrence 6_6:800:8034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0006; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:800
msgctxt "text_id=8034 | speaker=soujuurou"
msgid "「うん。それは、たしかにイヤだな」"
msgstr ""

#. Occurrence 6_6:824:8035: scene=6_6
#: 6_6:824
msgctxt "text_id=8035 | speaker=unknown"
msgid "　難しい顔で頷く草十郎に、青子もでしょう、と同意する。二人の<齟齬|そご>はとても深い。"
msgstr ""

#. Occurrence 6_6:864:8036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0020; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:864
msgctxt "text_id=8036 | speaker=aoko"
msgid "「とにかく、遅くても一ヶ月で“忘却のルーン”は見つけだせるだろうし、一回きりの実行ならプラス二ヶ月ぐらいでなんとかなるわ。"
msgstr ""

#. Occurrence 6_6:870:8037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0021; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:870
msgctxt "text_id=8037 | speaker=aoko"
msgid "　それまで<草十郎|アンタ>にはここで暮らしてもらうワケだけど……私たちについて無知なまま歩き回られると、命の保証はできないのよ」"
msgstr ""

#. Occurrence 6_6:891:8038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0022; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:891
msgctxt "text_id=8038 | speaker=aoko"
msgid "「そっちもこっちの事情を知らないのは気持ち悪いだろうし。なんで、今から簡潔に、現代の魔法使いのなんたるかを教えてあげる。"
msgstr ""

#. Occurrence 6_6:897:8039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0023; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:897
msgctxt "text_id=8039 | speaker=aoko"
msgid "　それで少しは私たちへの勘違いもなくなるだろうし」"
msgstr ""

#. Occurrence 6_6:926:8040: scene=6_6
#: 6_6:926
msgctxt "text_id=8040 | speaker=unknown"
msgid "　ま、この山奥育ちに現代も過去もないだろうけど、と青子は自分の台詞に苦笑いをこぼした。"
msgstr ""

#. Occurrence 6_6:957:8041: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0024; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:957
msgctxt "text_id=8041 | speaker=aoko"
msgid "「洋館のことは後にして、まずは<魔術師|わたしたち>の立場についてね。"
msgstr ""

#. Occurrence 6_6:963:8042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0025; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:963
msgctxt "text_id=8042 | speaker=aoko"
msgid "　あ、でも一から百まで理解する必要はないから。"
msgstr ""

#. Occurrence 6_6:969:8043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0026; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:969
msgctxt "text_id=8043 | speaker=aoko"
msgid "　どうせ門外漢なんだし、感じ入った事だけしっかり噛みしめておきなさい」"
msgstr ""

#. Occurrence 6_6:1003:8044: scene=6_6
#: 6_6:1003
msgctxt "text_id=8044 | speaker=unknown"
msgid "　教師めいた言葉に、草十郎は素直に頷いた。"
msgstr ""

#. Occurrence 6_6:1008:8045: scene=6_6
#: 6_6:1008
msgctxt "text_id=8045 | speaker=unknown"
msgid "　要するに、理解できない事は聞き返さなくていい、と青子は言ったのだ。"
msgstr ""

#. Occurrence 6_6:1013:8046: scene=6_6
#: 6_6:1013
msgctxt "text_id=8046 | speaker=unknown"
msgid "　その発言自体に納得のいかない草十郎だったが、聞き返すのはダメらしいので素直に従った。"
msgstr ""

#. Occurrence 6_6:1052:8047: scene=6_6
#: 6_6:1052
msgctxt "text_id=8047 | speaker=unknown"
msgid "　よろしい、と頷いて、青子は話をはじめる。"
msgstr ""

#. Occurrence 6_6:1057:8048: scene=6_6
#: 6_6:1057
msgctxt "text_id=8048 | speaker=unknown"
msgid "　長く、それは長くなる話を。"
msgstr ""

#. Occurrence 6_6:1092:8049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0027; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1092
msgctxt "text_id=8049 | speaker=aoko"
msgid "「まず魔術師、魔法使いの話からね。"
msgstr ""

#. Occurrence 6_6:1098:8050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0028; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1098
msgctxt "text_id=8050 | speaker=aoko"
msgid "　<魔|・><術|・>と<魔|・><法|・>の違いは草十郎には関わりのない話だからしないけど、それぞれ別種の物だと思ってくれればいいわ。"
msgstr ""

#. Occurrence 6_6:1113:8051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0029; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1113
msgctxt "text_id=8051 | speaker=aoko"
msgid "　で、魔術師の事だけど、これは絶対条件として隠された存在でなくてはならないの。"
msgstr ""

#. Occurrence 6_6:1119:8052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0030; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1119
msgctxt "text_id=8052 | speaker=aoko"
msgid "　<魔術師|どうぎょうしゃ>に知られるのは仕方ないとしても、貴方みたいに関わりのない人間に知られるのは罪にあたる。ほとんど死罪クラスのね」"
msgstr ""

#. Occurrence 6_6:1140:8053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0031; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1140
msgctxt "text_id=8053 | speaker=aoko"
msgid "「何故かって言うと、魔術ってのは隠されていないと力が薄れてしまうものだから。"
msgstr ""

#. Occurrence 6_6:1146:8054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0032; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1146
msgctxt "text_id=8054 | speaker=aoko"
msgid "　神秘の語源は閉ざす、というギリシャ語だけど、魔術は限られた密儀でなければ魔術でなくなってしまう。"
msgstr ""

#. Occurrence 6_6:1152:8055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0033; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1152
msgctxt "text_id=8055 | speaker=aoko"
msgid "　文明にとって、未知なるモノ、未開なる<場所|モノ>は<拓|ひら>かれていないからこそ恐怖に値するのと同じね」"
msgstr ""

#. Occurrence 6_6:1196:8056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0034; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1196
msgctxt "text_id=8056 | speaker=aoko"
msgid "「知られたら迫害されるから隠す、じゃないの。"
msgstr ""

#. Occurrence 6_6:1202:8057: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0035; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1202
msgctxt "text_id=8057 | speaker=aoko"
msgid "　未知でなくなった魔術師……というより魔術ね。"
msgstr ""

#. Occurrence 6_6:1208:8058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0036; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1208
msgctxt "text_id=8058 | speaker=aoko"
msgid "　明かされた魔術は力を弱めてしまう。だから<隠匿|いんとく>するのよ。何より、<魔術師|わたしたち>の未来のために」"
msgstr ""

#. Occurrence 6_6:1247:8059: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0007; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1247
msgctxt "text_id=8059 | speaker=soujuurou"
msgid "「……魔術の仕組みはよく分からないけど、とにかく自分だけの秘密でないと弱くなるって事か。"
msgstr ""

#. Occurrence 6_6:1259:8060: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0008; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1259
msgctxt "text_id=8060 | speaker=soujuurou"
msgid "　じゃあ蒼崎も弱くなってるのか？　俺が見ちゃったから」"
msgstr ""

#. Occurrence 6_6:1293:8061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0037; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1293
msgctxt "text_id=8061 | speaker=aoko"
msgid "「いいえ、別に。"
msgstr ""

#. Occurrence 6_6:1305:8062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0038; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1305
msgctxt "text_id=8062 | speaker=aoko"
msgid "　……ここからはちょっと込みいった話でね。"
msgstr ""

#. Occurrence 6_6:1311:8063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0039; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1311
msgctxt "text_id=8063 | speaker=aoko"
msgid "　弱くなる、っていうのはあくまで全体、それも随分と未来の話。個人単位では関係のない話よ。"
msgstr ""

#. Occurrence 6_6:1323:8064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0040; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1323
msgctxt "text_id=8064 | speaker=aoko"
msgid "　汝、<隠匿|いんとく>すべし―――って不文律は、この大本の仕組みが<形骸|けいがい>化して、いつのまにか絶対のルールになっているだけなの」"
msgstr ""

#. Occurrence 6_6:1365:8065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0041; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1365
msgctxt "text_id=8065 | speaker=aoko"
msgid "「文明社会の法律と一緒よ。犯罪、不道徳を罰するのは人間的であろうとする意識の高さと、それとはまったく別の、全体の仕組みを守るための構造的な結論でしょ。"
msgstr ""

#. Occurrence 6_6:1371:8066: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0042; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1371
msgctxt "text_id=8066 | speaker=aoko"
msgid "　犯罪が罰せられるのは、野放しにしたらせっかく築いた社会がうまく機能しなくなるから。"
msgstr ""

#. Occurrence 6_6:1377:8067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0043; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1377
msgctxt "text_id=8067 | speaker=aoko"
msgid "　で、<魔|わ><術|た><師|し>たちにとって犯罪にあたるのは神秘の一般化、低俗化であって、不道徳とか殺人とかは―――ま、それぞれの良心次第ってコトで、基本的に罪にもならない」"
msgstr ""

#. Occurrence 6_6:1420:8068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0044; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1420
msgctxt "text_id=8068 | speaker=aoko"
msgid "そんなろくでもない連中にルールを敷いたのが、魔術協会っていう集まり。組合みたいなものよ。"
msgstr ""

#. Occurrence 6_6:1426:8069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0045; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1426
msgctxt "text_id=8069 | speaker=aoko"
msgid "“魔術を不朽の神秘とせよ”……というのは、魔術を魔術として永続させるために敷いたルールにすぎないわ」"
msgstr ""

#. Occurrence 6_6:1464:8070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0046; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1464
msgctxt "text_id=8070 | speaker=aoko"
msgid "「けど、その原則は絶対でさ。"
msgstr ""

#. Occurrence 6_6:1470:8071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0047; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1470
msgctxt "text_id=8071 | speaker=aoko"
msgid "　これを破った者は、魔術世界には居られなくなる。"
msgstr ""

#. Occurrence 6_6:1476:8072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0048; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1476
msgctxt "text_id=8072 | speaker=aoko"
msgid "　いえ、実際問題として、<生|・><き|・><て|・><い|・><く|・><の|・><が|・><困|・><難|・><に|・><な|・><る|・>。"
msgstr ""

#. Occurrence 6_6:1519:8073: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0049; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1519
msgctxt "text_id=8073 | speaker=aoko"
msgid "　私たちは私たちの……まあ、魔術師としての命？"
msgstr ""

#. Occurrence 6_6:1525:8074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0050; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1525
msgctxt "text_id=8074 | speaker=aoko"
msgid "　そういうのを守るために、目撃者であるアンタを消さなくちゃいけなかった」"
msgstr ""

#. Occurrence 6_6:1560:8075: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0009; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1560
msgctxt "text_id=8075 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_6:1579:8076: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0051; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1579
msgctxt "text_id=8076 | speaker=aoko"
msgid "「そこ、同情とかしなくていいから。私たちの事情を知ったぐらいで、遊園地のことを帳消しにしないでよ。"
msgstr ""

#. Occurrence 6_6:1585:8077: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0052; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1585
msgctxt "text_id=8077 | speaker=aoko"
msgid "　私たちは私たちの判断でアンタを殺そうとしたんだから、誰彼のせいってワケじゃない。"
msgstr ""

#. Occurrence 6_6:1598:8078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0053; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1598
msgctxt "text_id=8078 | speaker=aoko"
msgid "　恨むなら、きちんと私を恨んでちょうだい」"
msgstr ""

#. Occurrence 6_6:1637:8079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0054; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1637
msgctxt "text_id=8079 | speaker=aoko"
msgid "「ま、それはともかく。"
msgstr ""

#. Occurrence 6_6:1643:8080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0055; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1643
msgctxt "text_id=8080 | speaker=aoko"
msgid "　過去、魔術師は職業として成りたったぐらい社会に認知されていたけど、その魔術自体は墓まで持っていく秘密だった。"
msgstr ""

#. Occurrence 6_6:1650:8081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0056; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1650
msgctxt "text_id=8081 | speaker=aoko"
msgid "それがどう<歪|ゆが>んだかは知らないけど、現代ではその職業すら秘密にしなくてはならなくなった。"
msgstr ""

#. Occurrence 6_6:1656:8082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0057; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1656
msgctxt "text_id=8082 | speaker=aoko"
msgid "　そこまでしないと、遠い未来、魔術すら消費するだけのものに解体されると協会は恐れたのよ」"
msgstr ""

#. Occurrence 6_6:1677:8083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0058; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1677
msgctxt "text_id=8083 | speaker=aoko"
msgid "「自然界の仕組みも、かつて天上の領域だった宇宙の運営すら、私たちは人智で解き明かせるほどになった。"
msgstr ""

#. Occurrence 6_6:1683:8084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0059; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1683
msgctxt "text_id=8084 | speaker=aoko"
msgid "　人の手にあまるもの。神秘という未知の領域にとって、魔術が最後の砦になると協会の設立者は信じたのかもしれない。"
msgstr ""

#. Occurrence 6_6:1689:8085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0060; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1689
msgctxt "text_id=8085 | speaker=aoko"
msgid "　それとも、魔術なんてもう意味がないって達観したのかもね」"
msgstr ""

#. Occurrence 6_6:1736:8086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0061; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1736
msgctxt "text_id=8086 | speaker=aoko"
msgid "「そんなわけで、魔術師はその正体を隠して各々の秘儀を伝えていった。他人に教えるワケにはいかないから、必然的にその伝承者は子孫になる。"
msgstr ""

#. Occurrence 6_6:1742:8087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0062; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1742
msgctxt "text_id=8087 | speaker=aoko"
msgid "　私も有珠も、そうやって何代か続いた連中の<末|すえ>なのよ。"
msgstr ""

#. Occurrence 6_6:1748:8088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0063; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1748
msgctxt "text_id=8088 | speaker=aoko"
msgid "　さっき言った魔術協会っていうのは、そんな細々と続いてる連中を束ねる一大組織。魔術師にとって司法の神ってところかしらね」"
msgstr ""

#. Occurrence 6_6:1769:8089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8089 | speaker=aoko"
msgid "「協会も色んな派閥に分かれるんだけど、大抵の魔術師はロンドンの魔術協会に属している。"
msgstr ""

#. Occurrence 6_6:1769:8090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8090 | speaker=aoko"
msgid "　汝隠匿すべしっていうのも協会の三大原則の一つよ。"
msgstr ""

#. Occurrence 6_6:1775:8091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0065; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1775
msgctxt "text_id=8091 | speaker=aoko"
msgid "　魔術師が一般人に秘密を漏らすと協会から罰が下される仕組みになっている。"
msgstr ""

#. Occurrence 6_6:1781:8092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0066; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1781
msgctxt "text_id=8092 | speaker=aoko"
msgid "　ま、そんな罰なんかなくても、自分と血族が伝えた魔術のために、目撃者は消さないといけないんだけど」"
msgstr ""

#. Occurrence 6_6:1829:8093: scene=6_6
#: 6_6:1829
msgctxt "text_id=8093 | speaker=unknown"
msgid "　まずはここまで、と青子は話を区切る。"
msgstr ""

#. Occurrence 6_6:1834:8094: scene=6_6
#: 6_6:1834
msgctxt "text_id=8094 | speaker=unknown"
msgid "　草十郎は草十郎なりに話をまとめているようだ。"
msgstr ""

#. Occurrence 6_6:1867:8095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0067; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1867
msgctxt "text_id=8095 | speaker=aoko"
msgid "「次いくけど、いい？」"
msgstr ""

#. Occurrence 6_6:1887:8096: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0010; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1887
msgctxt "text_id=8096 | speaker=soujuurou"
msgid "「いいけど、その前に確認したい。"
msgstr ""

#. Occurrence 6_6:1899:8097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0011; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1899
msgctxt "text_id=8097 | speaker=soujuurou"
msgid "　魔術師が正体を隠すのは自分のためじゃなく魔術のためだったけど、最近では自分の正体を隠すことの方が重要になっている。"
msgstr ""

#. Occurrence 6_6:1906:8098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0012; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1906
msgctxt "text_id=8098 | speaker=soujuurou"
msgid "そして、その決まりを破ると協会というところからお<咎|とが>めがくる。"
msgstr ""

#. Occurrence 6_6:1918:8099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0013; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1918
msgctxt "text_id=8099 | speaker=soujuurou"
msgid "　……つまり、蒼崎たちもその協会に入っているのか？」"
msgstr ""

#. Occurrence 6_6:1958:8100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0068; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1958
msgctxt "text_id=8100 | speaker=aoko"
msgid "「いいえ、私たちはフリーよ。いちおう協会と繋がりはあるけどね。"
msgstr ""

#. Occurrence 6_6:1965:8101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0069; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1965
msgctxt "text_id=8101 | speaker=aoko"
msgid "単純に、協会は最大勢力ってだけ。連中は頼まれもしないのに魔術世界全体の秩序を守ってるの。"
msgstr ""

#. Occurrence 6_6:1971:8102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0070; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1971
msgctxt "text_id=8102 | speaker=aoko"
msgid "　だから私たちが何であれ、彼らとの関わりがないにしても、魔術師としての決まりを破ったら罰しにくるわ」"
msgstr ""

#. Occurrence 6_6:2006:8103: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0014; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2006
msgctxt "text_id=8103 | speaker=soujuurou"
msgid "「……分かった。だいたい呑みこめた」"
msgstr ""

#. Occurrence 6_6:2012:8104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0071; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2012
msgctxt "text_id=8104 | speaker=aoko"
msgid "「よしよし。そうやって自分に必要な部分だけ手に入れなさい。"
msgstr ""

#. Occurrence 6_6:2018:8105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0072; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2018
msgctxt "text_id=8105 | speaker=aoko"
msgid "　じゃ、次は魔術について。……といっても、私自身、語れるほど学んでいないんだけどね」"
msgstr ""

#. Occurrence 6_6:2024:8106: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0015; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2024
msgctxt "text_id=8106 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 6_6:2047:8107: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0073; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2047
msgctxt "text_id=8107 | speaker=aoko"
msgid "「ごめん、こっちの話だから忘れて。"
msgstr ""

#. Occurrence 6_6:2053:8108: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0074; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2053
msgctxt "text_id=8108 | speaker=aoko"
msgid "　―――さっきも言ったけど、現代において魔術は無意味な物になりつつある。"
msgstr ""

#. Occurrence 6_6:2059:8109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0075; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2059
msgctxt "text_id=8109 | speaker=aoko"
msgid "　ライターのない大昔なら火を起こせればそれは<神秘|まじゅつ>として成り立つわ。けど<現代|いま>は何かと便利でしょう？　貴方ならよく分かると思うけど」"
msgstr ""

#. Occurrence 6_6:2105:8110: scene=6_6
#: 6_6:2105
msgctxt "text_id=8110 | speaker=unknown"
msgid "　青子の問いかけに、草十郎はまあ、と浮かない顔で同意した。"
msgstr ""

#. Occurrence 6_6:2110:8111: scene=6_6
#: 6_6:2110
msgctxt "text_id=8111 | speaker=unknown"
msgid "　草十郎も、その便利さを痛いほど実感している。"
msgstr ""

#. Occurrence 6_6:2115:8112: scene=6_6
#: 6_6:2115
msgctxt "text_id=8112 | speaker=unknown"
msgid "　山では一日かける大仕事が、ここでは簡単に出来てしまう。"
msgstr ""

#. Occurrence 6_6:2121:8113: scene=6_6
#: 6_6:2121
msgctxt "text_id=8113 | speaker=unknown"
msgid "電気も水道もない世界で育った彼にしてみれば、都会の生活そのものが魔法だ。"
msgstr ""

#. Occurrence 6_6:2126:8114: scene=6_6
#: 6_6:2126
msgctxt "text_id=8114 | speaker=unknown"
msgid "　この便利さが常識なのだと順応するのに、どれだけ苦労したことか。"
msgstr ""

#. Occurrence 6_6:2153:8115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0016; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2153
msgctxt "text_id=8115 | speaker=soujuurou"
msgid "「あ。"
msgstr ""

#. Occurrence 6_6:2160:8116: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0017; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2160
msgctxt "text_id=8116 | speaker=soujuurou"
msgid "でも、道具を使わずに火を起こせるのは神さまの仕事だと思うけど」"
msgstr ""

#. Occurrence 6_6:2185:8117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0076; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2185
msgctxt "text_id=8117 | speaker=aoko"
msgid "「そのために積み重ねた手間は、火炎放射器を手に入れるより面倒だとしても？」"
msgstr ""

#. Occurrence 6_6:2213:8118: scene=6_6
#: 6_6:2213
msgctxt "text_id=8118 | speaker=unknown"
msgid "　青子の言葉に、草十郎は答えられない。"
msgstr ""

#. Occurrence 6_6:2218:8119: scene=6_6
#: 6_6:2218
msgctxt "text_id=8119 | speaker=unknown"
msgid "　人間が神さまの真似事をする為にはどれだけの尽力があったのか、安易に答える事は彼女への侮辱だと思ったからだ。"
msgstr ""

#. Occurrence 6_6:2256:8120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0018; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2256
msgctxt "text_id=8120 | speaker=soujuurou"
msgid "「……。さっきのを見るかぎり、魔術ってのはなんでも出来ると思ったけど、それは誤解なのか」"
msgstr ""

#. Occurrence 6_6:2262:8121: scene=6_6
#: 6_6:2262
msgctxt "text_id=8121 | speaker=unknown"
msgid "　ちらり、とテーブルの上の小瓶に目をやる草十郎。"
msgstr ""

#. Occurrence 6_6:2267:8122: scene=6_6
#: 6_6:2267
msgctxt "text_id=8122 | speaker=unknown"
msgid "　内心、それはそれでホッとできる。"
msgstr ""

#. Occurrence 6_6:2272:8123: scene=6_6
#: 6_6:2272
msgctxt "text_id=8123 | speaker=unknown"
msgid "　あんな小瓶の中に閉じこめられていたなんて、今でも現実だと信じられない。"
msgstr ""

#. Occurrence 6_6:2315:8124: scene=6_6
#: 6_6:2315
msgctxt "text_id=8124 | speaker=unknown"
msgid "　―――しかし。"
msgstr ""

#. Occurrence 6_6:2322:8125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8125 | speaker=aoko"
msgid "「あら、それこそ誤解よ。"
msgstr ""

#. Occurrence 6_6:2322:8126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8126 | speaker=aoko"
msgid "　万能じゃなければ誰が魔術なんて学ぶと思ってるの？」"
msgstr ""

#. Occurrence 6_6:2349:8127: scene=6_6
#: 6_6:2349
msgctxt "text_id=8127 | speaker=unknown"
msgid "　胸を張って青子は言い返した。"
msgstr ""

#. Occurrence 6_6:2376:8128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0078; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2376
msgctxt "text_id=8128 | speaker=aoko"
msgid "「手間暇かかるけど、魔術に出来ない事はないわ。"
msgstr ""

#. Occurrence 6_6:2382:8129: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0079; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2382
msgctxt "text_id=8129 | speaker=aoko"
msgid "　中には“出来ていないけど出来ているように見せる”みたいな、何らかのイカサマはあるけどね。"
msgstr ""

#. Occurrence 6_6:2388:8130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0080; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2388
msgctxt "text_id=8130 | speaker=aoko"
msgid "　この世界に生まれた以上、その許容範囲で出来ない事なんてないの。そこで魔法がでてくるんだけど、それはまた改めて」"
msgstr ""

#. Occurrence 6_6:2426:8131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0081; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2426
msgctxt "text_id=8131 | speaker=aoko"
msgid "「私が言いたかったのは、魔術は奇跡を起こしているのではなくて、その過程が奇跡だってこと。"
msgstr ""

#. Occurrence 6_6:2432:8132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0082; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2432
msgctxt "text_id=8132 | speaker=aoko"
msgid "　結果が奇跡になるのは魔法の方なの」"
msgstr ""

#. Occurrence 6_6:2459:8133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0083; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2459
msgctxt "text_id=8133 | speaker=aoko"
msgid "「偉大な魔術師っていうのは、個人の魔術だけで旅客機飛ばしたりする人のこと。"
msgstr ""

#. Occurrence 6_6:2465:8134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0084; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2465
msgctxt "text_id=8134 | speaker=aoko"
msgid "　対して、偉大な魔法使いっていうのは、<現|い><在|ま>不可能な事を可能にする人の事よ。"
msgstr ""

#. Occurrence 6_6:2484:8135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0085; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2484
msgctxt "text_id=8135 | speaker=aoko"
msgid "　……そういった意味じゃ、私たちは最後の魔法使いになるかも知れないけどね」"
msgstr ""

#. Occurrence 6_6:2523:8136: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0001; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2523
msgctxt "text_id=8136 | speaker=alice"
msgid "「脱線してるわよ、青子」"
msgstr ""

#. Occurrence 6_6:2529:8137: scene=6_6
#: 6_6:2529
msgctxt "text_id=8137 | speaker=unknown"
msgid "　触れてはいけない一線に踏みこんだのか。"
msgstr ""

#. Occurrence 6_6:2534:8138: scene=6_6
#: 6_6:2534
msgctxt "text_id=8138 | speaker=unknown"
msgid "　黙って聞いていた有珠が、<窘|たしな>めるように呟いた。"
msgstr ""

#. Occurrence 6_6:2561:8139: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0002; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2561
msgctxt "text_id=8139 | speaker=alice"
msgid "「……そこまで教える必要はないでしょう。"
msgstr ""

#. Occurrence 6_6:2567:8140: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0003; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2567
msgctxt "text_id=8140 | speaker=alice"
msgid "　静希君に教えるべき事は、わたしたちと暮らす上で危険になる事だけじゃなかった？」"
msgstr ""

#. Occurrence 6_6:2612:8141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0086; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2612
msgctxt "text_id=8141 | speaker=aoko"
msgid "「悪かったわ、ちょい口<滑|すべ>らせた。"
msgstr ""

#. Occurrence 6_6:2624:8142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0087; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2624
msgctxt "text_id=8142 | speaker=aoko"
msgid "　ともかく、魔術師っていうのは暇さえあれば魔術の実験をしてる連中で―――自分の家系が伝えてきた秘儀を守るためなら鬼でも悪魔にでもなる」"
msgstr ""

#. Occurrence 6_6:2651:8143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0088; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2651
msgctxt "text_id=8143 | speaker=aoko"
msgid "「必然、そのアジト……工房って言うんだけど、工房も魔術的な機構が積み重なって、要塞みたいになっちゃうのよ。"
msgstr ""

#. Occurrence 6_6:2657:8144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0089; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2657
msgctxt "text_id=8144 | speaker=aoko"
msgid "　秘儀を守るために、入ってきた相手を問答無用で叩きのめす仕掛けとか。"
msgstr ""

#. Occurrence 6_6:2669:8145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0090; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2669
msgctxt "text_id=8145 | speaker=aoko"
msgid "　この洋館も、そういった工房と同じなの。"
msgstr ""

#. Occurrence 6_6:2675:8146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0091; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2675
msgctxt "text_id=8146 | speaker=aoko"
msgid "　不用心に歩き回って、さっきみたいな事になったら私でも助けてあげられないから、暗闇には気をつけなさい。気が付いたら鏡の中にいる！とか本気であるから」"
msgstr ""

#. Occurrence 6_6:2720:8147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0019; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2720
msgctxt "text_id=8147 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_6:2726:8148: scene=6_6
#: 6_6:2726
msgctxt "text_id=8148 | speaker=unknown"
msgid "　その気をつけ方を具体的に教えてくれないものか、と心底思う草十郎だが、口にしたところでいい返事はなさそうだった。"
msgstr ""

#. Occurrence 6_6:2761:8149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0092; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2761
msgctxt "text_id=8149 | speaker=aoko"
msgid "「枝葉から入っちゃったけど、要は私たちのプライベートに関わるなってコト。"
msgstr ""

#. Occurrence 6_6:2767:8150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0093; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2767
msgctxt "text_id=8150 | speaker=aoko"
msgid "　いくら最後には記憶を消すっていっても、それを<見|・><ら|・><れ|・><た|・><段|・><階|・><で|・><消|・><す|・><し|・><か|・><な|・><い|・>ものもあるから」"
msgstr ""

#. Occurrence 6_6:2799:8151: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0020; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2799
msgctxt "text_id=8151 | speaker=soujuurou"
msgid "「……なるほど。この<館|なか>にもルールがある事はよく分かった。他に注意すべきコトは―――」"
msgstr ""

#. Occurrence 6_6:2813:8152: scene=6_6
#: 6_6:2813
msgctxt "text_id=8152 | speaker=unknown"
msgid "　言いかけて、はてな、と草十郎は視線を泳がす。"
msgstr ""

#. Occurrence 6_6:2818:8153: scene=6_6
#: 6_6:2818
msgctxt "text_id=8153 | speaker=unknown"
msgid "　館の方が危ない、とか、魔術は隠すものだ、とか。"
msgstr ""

#. Occurrence 6_6:2823:8154: scene=6_6
#: 6_6:2823
msgctxt "text_id=8154 | speaker=unknown"
msgid "　その説明は彼がこうなった原因と矛盾する。"
msgstr ""

#. Occurrence 6_6:2829:8155: scene=6_6
#: 6_6:2829
msgctxt "text_id=8155 | speaker=unknown"
msgid "そもそも、そこまでして隠すものを、どうして草十郎は目の当たりにする事になったのか。"
msgstr ""

#. Occurrence 6_6:2856:8156: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0021; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2856
msgctxt "text_id=8156 | speaker=soujuurou"
msgid "「すまない。話の腰を折るんだけど、いいかな。"
msgstr ""

#. Occurrence 6_6:2862:8157: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0022; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2862
msgctxt "text_id=8157 | speaker=soujuurou"
msgid "　魔術師は協会という組織で結ばれてるんだろう？　なら、どうして蒼崎はあんな人形に襲われたんだ？"
msgstr ""

#. Occurrence 6_6:2887:8158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0023; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2887
msgctxt "text_id=8158 | speaker=soujuurou"
msgid "　あれの持ち主が魔術師なら、君たちは味方同士で争っている事になる。なにか、説明が不足していないか？」"
msgstr ""

#. Occurrence 6_6:2947:8159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0094; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2947
msgctxt "text_id=8159 | speaker=aoko"
msgid "「……それは最後にしようと思ってたのよ。"
msgstr ""

#. Occurrence 6_6:2958:8160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0095; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2958
msgctxt "text_id=8160 | speaker=aoko"
msgid "　普通はここまでの話だけで<眉唾|まゆつば>ものっていうか、笑い飛ばすっていうか。"
msgstr ""

#. Occurrence 6_6:2970:8161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0096; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2970
msgctxt "text_id=8161 | speaker=aoko"
msgid "　いくら経験済みだからって、魔術なんて<存在|モン>をあっさり受け入れるなんて出来ないって言うか―――」"
msgstr ""

#. Occurrence 6_6:3010:8162: scene=6_6
#: 6_6:3010
msgctxt "text_id=8162 | speaker=unknown"
msgid "　すっかり自分の話を信じこんでいる草十郎に対して、青子は困ったように頬をかく。"
msgstr ""

#. Occurrence 6_6:3015:8163: scene=6_6
#: 6_6:3015
msgctxt "text_id=8163 | speaker=unknown"
msgid "　向かい合った有珠も、表情にこそ出ていないが同意見のようだ。"
msgstr ""

#. Occurrence 6_6:3060:8164: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0024; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3060
msgctxt "text_id=8164 | speaker=soujuurou"
msgid "「？　おかしいのか、それ？」"
msgstr ""

#. Occurrence 6_6:3085:8165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8165 | speaker=aoko"
msgid "「おかしいわよ。"
msgstr ""

#. Occurrence 6_6:3085:8166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8166 | speaker=aoko"
msgid "　そもそも、あんたは第一ステップから変だった。"
msgstr ""

#. Occurrence 6_6:3091:8167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0098; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3091
msgctxt "text_id=8167 | speaker=aoko"
msgid "　普通は驚いたり恐がったり無視したりするものなのに、どうして魔法使いだ、なんて言った私を信じたの？」"
msgstr ""

#. Occurrence 6_6:3117:8168: scene=6_6
#: 6_6:3117
msgctxt "text_id=8168 | speaker=unknown"
msgid "　思えば、それはミラーハウスで訊くべき問いだった。"
msgstr ""

#. Occurrence 6_6:3122:8169: scene=6_6
#: 6_6:3122
msgctxt "text_id=8169 | speaker=unknown"
msgid "　あの時、静希草十郎は見た事のない『魔術』という現象に驚いたのであって、それを使う青子自身に何の驚きも、不快感も表さなかったのだ。"
msgstr ""

#. Occurrence 6_6:3186:8170: scene=6_6
#: 6_6:3186
msgctxt "text_id=8170 | speaker=unknown"
msgid "　ふたりの少女―――いや、魔術師の疑惑の眼差しを一身に受けて、草十郎は困ってしまう。"
msgstr ""

#. Occurrence 6_6:3191:8171: scene=6_6
#: 6_6:3191
msgctxt "text_id=8171 | speaker=unknown"
msgid "　彼にしてみれば、そんな疑問すら疑問なのだ。"
msgstr ""

#. Occurrence 6_6:3234:8172: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0025; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3234
msgctxt "text_id=8172 | speaker=soujuurou"
msgid "「なんでも何もない。蒼崎。山ではね、有る物は有るのが当たり前なんだよ。"
msgstr ""

#. Occurrence 6_6:3240:8173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0026; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3240
msgctxt "text_id=8173 | speaker=soujuurou"
msgid "　理由をつけられるだけの知識がなかったからにしても、実際に見た物を信じない、なんて事はないんだ。"
msgstr ""

#. Occurrence 6_6:3246:8174: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0027; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3246
msgctxt "text_id=8174 | speaker=soujuurou"
msgid "　それに君も言ったろう。貴方にとっては魔法もライターも同じ物なんだろうって」"
msgstr ""

#. Occurrence 6_6:3252:8175: scene=6_6
#: 6_6:3252
msgctxt "text_id=8175 | speaker=unknown"
msgid "　いやまあ、今では違うけど、と付け足して草十郎は言葉をきった。"
msgstr ""

#. Occurrence 6_6:3284:8176: scene=6_6
#: 6_6:3284
msgctxt "text_id=8176 | speaker=unknown"
msgid "　素朴だった山での日々を語った、本心からの言葉。"
msgstr ""

#. Occurrence 6_6:3289:8177: scene=6_6
#: 6_6:3289
msgctxt "text_id=8177 | speaker=unknown"
msgid "　それは蒼崎青子だけでなく、久遠寺有珠まで<得心|とくしん>させる響きがあった。"
msgstr ""

#. Occurrence 6_6:3313:8178: scene=6_6
#: 6_6:3313
msgctxt "text_id=8178 | speaker=unknown"
msgid "　誰であれ持っているだろう、胸を張れる<矜持|きょうじ>。"
msgstr ""

#. Occurrence 6_6:3318:8179: scene=6_6
#: 6_6:3318
msgctxt "text_id=8179 | speaker=unknown"
msgid "　きっとこの少年にとって、今の言葉こそが揺るぎのない真実だったのだ。"
msgstr ""

#. Occurrence 6_6:3362:8180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0099; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3362
msgctxt "text_id=8180 | speaker=aoko"
msgid "「有るものは有る、か」"
msgstr ""

#. Occurrence 6_6:3368:8181: scene=6_6
#: 6_6:3368
msgctxt "text_id=8181 | speaker=unknown"
msgid "　ちょっとだけ感心する。"
msgstr ""

#. Occurrence 6_6:3373:8182: scene=6_6
#: 6_6:3373
msgctxt "text_id=8182 | speaker=unknown"
msgid "　この少年自体がどんなに異端でも、彼自身が周りの物をそんな風に受けとめているのなら、たしかに、いつだって自然に生きられるはずだ。"
msgstr ""

#. Occurrence 6_6:3401:8183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0100; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3401
msgctxt "text_id=8183 | speaker=aoko"
msgid "「そうね。草十郎はそうなのよね。"
msgstr ""

#. Occurrence 6_6:3407:8184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0101; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3407
msgctxt "text_id=8184 | speaker=aoko"
msgid "　簡単に信じてもらえるコトが信じられない、なんて、私たちの方がどうかしてたわ」"
msgstr ""

#. Occurrence 6_6:3419:8185: scene=6_6
#: 6_6:3419
msgctxt "text_id=8185 | speaker=unknown"
msgid "　……たとえば、初めて出逢った時のように。"
msgstr ""

#. Occurrence 6_6:3424:8186: scene=6_6
#: 6_6:3424
msgctxt "text_id=8186 | speaker=unknown"
msgid "　あの教室でも、この少年は全ての出来事を<是|よし>と受けとめていたんだと、少女は懐かしく苦笑した。"
msgstr ""

#. Occurrence 6_6:3506:8187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0102; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3506
msgctxt "text_id=8187 | speaker=aoko"
msgid "「じゃ、気を取り直してっと……"
msgstr ""

#. Occurrence 6_6:3512:8188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0103; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3512
msgctxt "text_id=8188 | speaker=aoko"
msgid "　草十郎の疑問だけどね。魔術師も色々あって、協会に属していない連中もいるの。"
msgstr ""

#. Occurrence 6_6:3519:8189: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0104; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3519
msgctxt "text_id=8189 | speaker=aoko"
msgid "こういった連中は協会の目を盗んでやりたい放題で、利益目的で他の魔術師にケンカを売ってくる。あの人形の持ち主もその<類|たぐい>」"
msgstr ""

#. Occurrence 6_6:3560:8190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0105; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3560
msgctxt "text_id=8190 | speaker=aoko"
msgid "「そんな連中にとって、私たちは都合のいい、格好のカモなのよ。"
msgstr ""

#. Occurrence 6_6:3567:8191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0106; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3567
msgctxt "text_id=8191 | speaker=aoko"
msgid "私たちは協会と協定関係にあるだけで門下ってワケじゃないから。私たちが殺されたところで、協会は助けてくれないしね」"
msgstr ""

#. Occurrence 6_6:3603:8192: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0028; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3603
msgctxt "text_id=8192 | speaker=soujuurou"
msgid "「？　でも、魔術師が魔術を使うのは禁じてるんだろ？」"
msgstr ""

#. Occurrence 6_6:3628:8193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0107; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3628
msgctxt "text_id=8193 | speaker=aoko"
msgid "「それが<公|おおやけ>にならないのなら、協会は目をつむるわ。"
msgstr ""

#. Occurrence 6_6:3634:8194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0108; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3634
msgctxt "text_id=8194 | speaker=aoko"
msgid "　むしろ、バレなければ魔術師同士の争いを<奨励|しょうれい>してるぐらいよ。技術も使わないと<錆|さ>びるってね。"
msgstr ""

#. Occurrence 6_6:3640:8195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0109; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3640
msgctxt "text_id=8195 | speaker=aoko"
msgid "　……まあ。私たちが襲われてるのはそれとは別の話で、たんに土地を持ってるからなんだけど」"
msgstr ""

#. Occurrence 6_6:3681:8196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0029; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3681
msgctxt "text_id=8196 | speaker=soujuurou"
msgid "「……土地って、この家？」"
msgstr ""

#. Occurrence 6_6:3694:8197: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0110; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3694
msgctxt "text_id=8197 | speaker=aoko"
msgid "「まさか。この三咲市一帯の管理地の権利を持ってるのよ、私と有珠は」"
msgstr ""

#. Occurrence 6_6:3785:8198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0030; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3785
msgctxt "text_id=8198 | speaker=soujuurou"
msgid "「管理地って、つまり土地の利権―――！？」"
msgstr ""

#. Occurrence 6_6:3848:8199: scene=6_6
#: 6_6:3848
msgctxt "text_id=8199 | speaker=unknown"
msgid "　眩しい、と目を<背|そむ>ける草十郎。"
msgstr ""

#. Occurrence 6_6:3853:8200: scene=6_6
#: 6_6:3853
msgctxt "text_id=8200 | speaker=unknown"
msgid "　いま、彼が見ている青子には確実に<後光|ごこう>が差している。"
msgstr ""

#. Occurrence 6_6:3858:8201: scene=6_6
#: 6_6:3858
msgctxt "text_id=8201 | speaker=unknown"
msgid "　貸しアパート生活いまだ二週間の草十郎だが、都会において土地の権利がいかに偉大なものか、ほんと身をもって知っていたからだ。"
msgstr ""

#. Occurrence 6_6:3908:8202: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0031; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3908
msgctxt "text_id=8202 | speaker=soujuurou"
msgid "「お……おお……」"
msgstr ""

#. Occurrence 6_6:3914:8203: scene=6_6
#: 6_6:3914
msgctxt "text_id=8203 | speaker=unknown"
msgid "　お金、持ちだ―――！"
msgstr ""

#. Occurrence 6_6:3919:8204: scene=6_6
#: 6_6:3919
msgctxt "text_id=8204 | speaker=unknown"
msgid "　などと、草十郎はよく分からない感動でワナワナ震えている。"
msgstr ""

#. Occurrence 6_6:3954:8205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0111; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3954
msgctxt "text_id=8205 | speaker=aoko"
msgid "「……悪いけど、そういうんじゃないから。"
msgstr ""

#. Occurrence 6_6:3960:8206: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0112; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3960
msgctxt "text_id=8206 | speaker=aoko"
msgid "　私たちで土地って言ったら、魔術師としての霊地の所有権、支配権のコトを言うの。"
msgstr ""

#. Occurrence 6_6:3972:8207: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0113; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3972
msgctxt "text_id=8207 | speaker=aoko"
msgid "　<蒼崎|うち>はマイナーだけど古くからこのあたりに根を下ろしてた魔術師で、三咲町もうちの管理下ってワケ」"
msgstr ""

#. Occurrence 6_6:4005:8208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0114; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4005
msgctxt "text_id=8208 | speaker=aoko"
msgid "「管理地って言うのはね、霊的な力が<歪|ゆが>んで、集まりやすい土地のコト。そういう土地は昔から貴重で、魔術の実践、実験には不可欠でもある。"
msgstr ""

#. Occurrence 6_6:4011:8209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0115; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4011
msgctxt "text_id=8209 | speaker=aoko"
msgid "　成功への絶対条件は優れた霊地、堅固な工房、多くの弟子たちってね。"
msgstr ""

#. Occurrence 6_6:4017:8210: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0116; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4017
msgctxt "text_id=8210 | speaker=aoko"
msgid "　魔術師たちにとって、土地つき館つきの住み家を持つのは一つの野望なんだから」"
msgstr ""

#. Occurrence 6_6:4056:8211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0033; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4056
msgctxt "text_id=8211 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_6:4061:8212: scene=6_6
#: 6_6:4061
msgctxt "text_id=8212 | speaker=unknown"
msgid "　その野望を二つも叶えている青子たちは何様なんだろう、と思いつつ草十郎は先を<促|うなが>した。"
msgstr ""

#. Occurrence 6_6:4105:8213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0117; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4105
msgctxt "text_id=8213 | speaker=aoko"
msgid "「でも、その管理地は大部分が協会に仕切られてて、もう余っている土地はないの。"
msgstr ""

#. Occurrence 6_6:4111:8214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0118; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4111
msgctxt "text_id=8214 | speaker=aoko"
msgid "　はぐれ魔術師や土地のない魔術師は、協会に毎月寄付金を納めて土地を借りるしかない。ま、ていよく協会のお偉いさんたちに尽くす働きバチってところね」"
msgstr ""

#. Occurrence 6_6:4145:8215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0119; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4145
msgctxt "text_id=8215 | speaker=aoko"
msgid "「でも、ここの土地は何百年も前から蒼崎の物だから協会とは関係がないの。"
msgstr ""

#. Occurrence 6_6:4151:8216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0120; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4151
msgctxt "text_id=8216 | speaker=aoko"
msgid "　ここまで言えば分かるでしょ？"
msgstr ""

#. Occurrence 6_6:4157:8217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0121; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4157
msgctxt "text_id=8217 | speaker=aoko"
msgid "　そういったフリーの連中からすれば、私たちの管理地はこの上ないご馳走なんだって」"
msgstr ""

#. Occurrence 6_6:4177:8218: scene=6_6
#: 6_6:4177
msgctxt "text_id=8218 | speaker=unknown"
msgid "　……物騒なんだか所帯染みているのか微妙な話になってきたな、と内心うなずく草十郎。"
msgstr ""

#. Occurrence 6_6:4197:8219: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8219 | speaker=soujuurou"
msgid "「よく分かった。"
msgstr ""

#. Occurrence 6_6:4197:8220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8220 | speaker=soujuurou"
msgid "　蒼崎たちは土地の奪い合いをしているんだな？」"
msgstr ""

#. Occurrence 6_6:4231:8221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0122; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4231
msgctxt "text_id=8221 | speaker=aoko"
msgid "「そういう事。"
msgstr ""

#. Occurrence 6_6:4238:8222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0123; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4238
msgctxt "text_id=8222 | speaker=aoko"
msgid "ただ三咲の管理地はマイナーのさらにマイナーだから、やってくる挑戦者も三流ばっかりよ。"
msgstr ""

#. Occurrence 6_6:4244:8223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0124; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4244
msgctxt "text_id=8223 | speaker=aoko"
msgid "　今回の敵だって、どっかの三流魔術師がここなら楽に奪えると思ってやってきたんだろうし。ま、それもアンタの乱入で休戦してるんだけど」"
msgstr ""

#. Occurrence 6_6:4286:8224: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0004; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4286
msgctxt "text_id=8224 | speaker=alice"
msgid "「……管理地の話はそれで十分よ、青子。"
msgstr ""

#. Occurrence 6_6:4299:8225: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0005; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4299
msgctxt "text_id=8225 | speaker=alice"
msgid "　静希君も、他に魔術師がいると分かってくれたようだし。"
msgstr ""

#. Occurrence 6_6:4305:8226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0006; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4305
msgctxt "text_id=8226 | speaker=alice"
msgid "　危険があるとすれば、わたしたちの戦いに彼が巻きこまれる可能性だけど」"
msgstr ""

#. Occurrence 6_6:4349:8227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0125; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4349
msgctxt "text_id=8227 | speaker=aoko"
msgid "「それは大丈夫でしょ。"
msgstr ""

#. Occurrence 6_6:4355:8228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0126; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4355
msgctxt "text_id=8228 | speaker=aoko"
msgid "　だってコイツ、魔力の欠片もないじゃない。魔力感知にはひっかからないし、番犬以下の人間は戦力って言わないから、狙われる事もないだろうし。"
msgstr ""

#. Occurrence 6_6:4361:8229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0127; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4361
msgctxt "text_id=8229 | speaker=aoko"
msgid "　私たちはただ、忘却のルーンを見つけるまでコイツを逃がさなければいいだけでしょ」"
msgstr ""

#. Occurrence 6_6:4402:8230: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0007; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4402
msgctxt "text_id=8230 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 6_6:4408:8231: scene=6_6
#: 6_6:4408
msgctxt "text_id=8231 | speaker=unknown"
msgid "　有珠は無言で、相棒である少女を見つめる。"
msgstr ""

#. Occurrence 6_6:4413:8232: scene=6_6
#: 6_6:4413
msgctxt "text_id=8232 | speaker=unknown"
msgid "　有珠の言う“巻きこまれる”と、青子の言う“巻きこまれる”は、その深刻さ、過酷さが違っていた。"
msgstr ""

#. Occurrence 6_6:4454:8233: scene=6_6
#: 6_6:4454
msgctxt "text_id=8233 | speaker=unknown"
msgid "　青子はその浅い経験から、彼が直接的な戦いには巻きこまれないと断じている。"
msgstr ""

#. Occurrence 6_6:4459:8234: scene=6_6
#: 6_6:4459
msgctxt "text_id=8234 | speaker=unknown"
msgid "　清廉潔白で合理的。"
msgstr ""

#. Occurrence 6_6:4465:8235: scene=6_6
#: 6_6:4465
msgctxt "text_id=8235 | speaker=unknown"
msgid "無駄を嫌う彼女は、敵にも同じ効率を求めてしまう節がある。"
msgstr ""

#. Occurrence 6_6:4470:8236: scene=6_6
#: 6_6:4470
msgctxt "text_id=8236 | speaker=unknown"
msgid "　だが―――世の中には、そも事を終えるまで、自らの正否を量れぬ者もいる。"
msgstr ""

#. Occurrence 6_6:4519:8237: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0008; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4519
msgctxt "text_id=8237 | speaker=alice"
msgid "「…………先の事は誰にも分からないから。"
msgstr ""

#. Occurrence 6_6:4525:8238: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0009; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4525
msgctxt "text_id=8238 | speaker=alice"
msgid "　その時になって、後悔がなければいいけれど」"
msgstr ""

#. Occurrence 6_6:4540:8239: scene=6_6
#: 6_6:4540
msgctxt "text_id=8239 | speaker=unknown"
msgid "　陰鬱なため息をついて、有珠は席を立った。"
msgstr ""

#. Occurrence 6_6:4580:8240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0128; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4580
msgctxt "text_id=8240 | speaker=aoko"
msgid "「ちょっと。何のために<長話|ながばなし>したと思ってるのよ。"
msgstr ""

#. Occurrence 6_6:4586:8241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0129; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4586
msgctxt "text_id=8241 | speaker=aoko"
msgid "　いちばん重要なアンタの<同意|いけん>、聞いてないんですけど？」"
msgstr ""

#. Occurrence 6_6:4609:8242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0010; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4609
msgctxt "text_id=8242 | speaker=alice"
msgid "「貴女が貴女の方針を守るというのなら、それでいいわ。"
msgstr ""

#. Occurrence 6_6:4615:8243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0011; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4615
msgctxt "text_id=8243 | speaker=alice"
msgid "　わたしも好きにするだけよ」"
msgstr ""

#. Occurrence 6_6:4649:8244: scene=6_6
#: 6_6:4649
msgctxt "text_id=8244 | speaker=unknown"
msgid "　音もなく扉に向かう有珠。"
msgstr ""

#. Occurrence 6_6:4693:8245: scene=6_6
#: 6_6:4693
msgctxt "text_id=8245 | speaker=unknown"
msgid "　黒衣の少女は扉を開け、薄暗い廊下の前で立ち止まった。"
msgstr ""

#. Occurrence 6_6:4698:8246: scene=6_6
#: 6_6:4698
msgctxt "text_id=8246 | speaker=unknown"
msgid "　同時に、"
msgstr ""

#. Occurrence 6_6:4762:8247: scene=6_6
#: 6_6:4762
msgctxt "text_id=8247 | speaker=unknown"
msgid "　つい、と。"
msgstr ""

#. Occurrence 6_6:4776:8248: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0035; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4776
msgctxt "text_id=8248 | speaker=soujuurou"
msgid "「！？」"
msgstr ""

#. Occurrence 6_6:4781:8249: scene=6_6
#: 6_6:4781
msgctxt "text_id=8249 | speaker=unknown"
msgid "　少女の足取りに合わせるよう、テーブルにあった小瓶が<宙|ちゅう>に浮き―――慈悲も<躊躇|ためら>いもなく、無惨に砕け散った。"
msgstr ""

#. Occurrence 6_6:4913:8250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0012; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4913
msgctxt "text_id=8250 | speaker=alice"
msgid "「……あの時、こうしておけばよかった」"
msgstr ""

#. Occurrence 6_6:4919:8251: scene=6_6
#: 6_6:4919
msgctxt "text_id=8251 | speaker=unknown"
msgid "　さらりとした声に、顔面蒼白になる草十郎。"
msgstr ""

#. Occurrence 6_6:4924:8252: scene=6_6
#: 6_6:4924
msgctxt "text_id=8252 | speaker=unknown"
msgid "　有珠の声は静かすぎて、本気なのか冗談なのかまったく読み取れない。"
msgstr ""

#. Occurrence 6_6:4982:8253: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0013; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4982
msgctxt "text_id=8253 | speaker=alice"
msgid "「わたしも言い忘れていたけど」"
msgstr ""

#. Occurrence 6_6:4994:8254: scene=6_6
#: 6_6:4994
msgctxt "text_id=8254 | speaker=unknown"
msgid "　少女の横顔が、いっそう冷たく青子と草十郎を流し見る。"
msgstr ""

#. Occurrence 6_6:4999:8255: scene=6_6
#: 6_6:4999
msgctxt "text_id=8255 | speaker=unknown"
msgid "　洋館の主は、その表情よりなお冷たい声で、"
msgstr ""

#. Occurrence 6_6:5026:8256: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0014; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:5026
msgctxt "text_id=8256 | speaker=alice"
msgid "「まだ、<認|みと>めていないから」"
msgstr ""

#. Occurrence 6_6:5066:8257: scene=6_6
#: 6_6:5066
msgctxt "text_id=8257 | speaker=unknown"
msgid "　あまりにも前途多難な伝言を残していった。"
msgstr ""

#. Occurrence 6_7:53:8258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0000; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:53
msgctxt "text_id=8258 | speaker=aoko"
msgid "「……ったく、往生際が悪い」"
msgstr ""

#. Occurrence 6_7:60:8259: scene=6_7
#: 6_7:60
msgctxt "text_id=8259 | speaker=unknown"
msgid "　ソファーにもたれながら悪態をつく青子。"
msgstr ""

#. Occurrence 6_7:65:8260: scene=6_7
#: 6_7:65
msgctxt "text_id=8260 | speaker=unknown"
msgid "　不機嫌そうな顔は、普段よりイライラ度を増している。"
msgstr ""

#. Occurrence 6_7:86:8261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0001; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:86
msgctxt "text_id=8261 | speaker=aoko"
msgid "「見逃すのと<洋館|ここ>に住まわせるのは別問題よって、じゃあそれ以外にどんな方法があるってのよ。"
msgstr ""

#. Occurrence 6_7:92:8262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0002; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:92
msgctxt "text_id=8262 | speaker=aoko"
msgid "　……譲る気もなさそうだし。この分じゃ実力行使に出るかもね、あの<娘|こ>」"
msgstr ""

#. Occurrence 6_7:125:8263: scene=6_7
#: 6_7:125
msgctxt "text_id=8263 | speaker=unknown"
msgid "　ぶつぶつと呟く青子に、草十郎は不審げな視線を送る。"
msgstr ""

#. Occurrence 6_7:154:8264: scene=6_7
#: 6_7:154
msgctxt "text_id=8264 | speaker=unknown"
msgid "　今の決意表明―――小瓶を粉々にする―――はどういう^事なのか、と。"
msgstr ""

#. Occurrence 6_7:184:8265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0003; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:184
msgctxt "text_id=8265 | speaker=aoko"
msgid "「草十郎には“記憶を無くしてもらう”ってコトで話はつけたけど、心の底から納得してないってコトでしょ。"
msgstr ""

#. Occurrence 6_7:190:8266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0004; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:190
msgctxt "text_id=8266 | speaker=aoko"
msgid "　……有珠にしちゃあ珍しく他人を意識してたけど、やっぱりここに住まわせるとなると難しいみたい。"
msgstr ""

#. Occurrence 6_7:196:8267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0005; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:196
msgctxt "text_id=8267 | speaker=aoko"
msgid "　寝てる分には良かったけど、起きてるアンタを見たらこう、<得|え>も言わぬ<嗜虐心|しぎゃくしん>を刺激されたとかさ」"
msgstr ""

#. Occurrence 6_7:224:8268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0006; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:224
msgctxt "text_id=8268 | speaker=aoko"
msgid "「気をつけてね草十郎。"
msgstr ""

#. Occurrence 6_7:230:8269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0007; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:230
msgctxt "text_id=8269 | speaker=aoko"
msgid "　あの娘、アンタを殺しにくるかもしれないから」"
msgstr ""

#. Occurrence 6_7:236:8270: scene=6_7
#: 6_7:236
msgctxt "text_id=8270 | speaker=unknown"
msgid "　などと忠告しつつ、青子自身、これ以上有珠を説得する気はなさそうだった。"
msgstr ""

#. Occurrence 6_7:273:8271: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0000; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:273
msgctxt "text_id=8271 | speaker=soujuurou"
msgid "「……なんか、状況はあの夜からあまり変わってないようだね、蒼崎」"
msgstr ""

#. Occurrence 6_7:279:8272: scene=6_7
#: 6_7:279
msgctxt "text_id=8272 | speaker=unknown"
msgid "　思わず呟いた一言に、青子はそう？　と軽く視線を返す。"
msgstr ""

#. Occurrence 6_7:313:8273: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0001; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:313
msgctxt "text_id=8273 | speaker=soujuurou"
msgid "「そう？　じゃないぞ。"
msgstr ""

#. Occurrence 6_7:319:8274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0002; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:319
msgctxt "text_id=8274 | speaker=soujuurou"
msgid "　蒼崎の次はあの娘がやる気満々じゃないか。さっきみたいな目にあったら逃げることもできない。"
msgstr ""

#. Occurrence 6_7:325:8275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0003; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:325
msgctxt "text_id=8275 | speaker=soujuurou"
msgid "　こういうの、生殺しって言うんじゃないか？」"
msgstr ""

#. Occurrence 6_7:365:8276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0008; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:365
msgctxt "text_id=8276 | speaker=aoko"
msgid "「そうならないように努力するのね。"
msgstr ""

#. Occurrence 6_7:371:8277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0009; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:371
msgctxt "text_id=8277 | speaker=aoko"
msgid "　ま、有珠の理由は遊園地の時ほど切迫したものじゃないから、そのうち<諦|あきら>めてくれるとは思うんだけど」"
msgstr ""

#. Occurrence 6_7:399:8278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0004; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:399
msgctxt "text_id=8278 | speaker=soujuurou"
msgid "「蒼崎の時とは違う、有珠の理由……？」"
msgstr ""

#. Occurrence 6_7:443:8279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0010; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:443
msgctxt "text_id=8279 | speaker=aoko"
msgid "「ええ。遊園地の時は秘密厳守のためだったけど、それは一応解決してる。アンタが底抜けに律儀なヤツだってのは、有珠だってもう分かってるし。"
msgstr ""

#. Occurrence 6_7:449:8280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0011; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:449
msgctxt "text_id=8280 | speaker=aoko"
msgid "　なんで、秘密厳守云々であそこまで反対する理由はないの。あの娘は単にね、ここに住んでほしくないだけなのよ。それだけで、有珠はアンタを殺したがってる」"
msgstr ""

#. Occurrence 6_7:500:8281: scene=6_7
#: 6_7:500
msgctxt "text_id=8281 | speaker=unknown"
msgid "　きっぱりと言う青子の目は真剣そのものだ。"
msgstr ""

#. Occurrence 6_7:505:8282: scene=6_7
#: 6_7:505
msgctxt "text_id=8282 | speaker=unknown"
msgid "　そこには嘘も<誇張|こちょう>も影すらない。困った事に。"
msgstr ""

#. Occurrence 6_7:538:8283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0005; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:538
msgctxt "text_id=8283 | speaker=soujuurou"
msgid "「たしかに、あの娘はそんな素振りだったけど。"
msgstr ""

#. Occurrence 6_7:544:8284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0006; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:544
msgctxt "text_id=8284 | speaker=soujuurou"
msgid "　……変だね、それならもっと他の手段をとればいいのに」"
msgstr ""

#. Occurrence 6_7:550:8285: scene=6_7
#: 6_7:550
msgctxt "text_id=8285 | speaker=unknown"
msgid "　有珠に申し訳ないものを感じているのか、柄にもなく深刻に悩む草十郎。"
msgstr ""

#. Occurrence 6_7:555:8286: scene=6_7
#: 6_7:555
msgctxt "text_id=8286 | speaker=unknown"
msgid "　その言葉の意味を、青子は瞬時に読み取った。"
msgstr ""

#. Occurrence 6_7:599:8287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0012; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:599
msgctxt "text_id=8287 | speaker=aoko"
msgid "「例えば、記憶を消す魔術が見つかるまで、さっきの小瓶の中に閉じこめておくとか？」"
msgstr ""

#. Occurrence 6_7:630:8288: scene=6_7
#: 6_7:630
msgctxt "text_id=8288 | speaker=unknown"
msgid "　青子の声に、先ほどまでの<気怠|けだる>さはない。"
msgstr ""

#. Occurrence 6_7:647:8289: scene=6_7
#: 6_7:647
msgctxt "text_id=8289 | speaker=unknown"
msgid "　草十郎は頷きだけで答えた。"
msgstr ""

#. Occurrence 6_7:652:8290: scene=6_7
#: 6_7:652
msgctxt "text_id=8290 | speaker=unknown"
msgid "　事実、彼女たちにとってそれが最も<安易|イージー>な方法である事は間違いない。"
msgstr ""

#. Occurrence 6_7:657:8291: scene=6_7
#: 6_7:657
msgctxt "text_id=8291 | speaker=unknown"
msgid "　だが、"
msgstr ""

#. Occurrence 6_7:690:8292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0013; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:690
msgctxt "text_id=8292 | speaker=aoko"
msgid "「草十郎。私、約束は破らないの。覚えておいて」"
msgstr ""

#. Occurrence 6_7:696:8293: scene=6_7
#: 6_7:696
msgctxt "text_id=8293 | speaker=unknown"
msgid "　その安易さを、彼女は嫌った。"
msgstr ""

#. Occurrence 6_7:701:8294: scene=6_7
#: 6_7:701
msgctxt "text_id=8294 | speaker=unknown"
msgid "　静かな言葉にはかすかな怒りがある。"
msgstr ""

#. Occurrence 6_7:706:8295: scene=6_7
#: 6_7:706
msgctxt "text_id=8295 | speaker=unknown"
msgid "　その怒りが何に対して向けられているのか、草十郎には痛いほどよく分かった。"
msgstr ""

#. Occurrence 6_7:711:8296: scene=6_7
#: 6_7:711
msgctxt "text_id=8296 | speaker=unknown"
msgid "　胸の痛みは、彼女にそんな台詞を言わせてしまった後悔によるものだ。"
msgstr ""

#. Occurrence 6_7:745:8297: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0007; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:745
msgctxt "text_id=8297 | speaker=soujuurou"
msgid "「すまない。考えが足りなかった」"
msgstr ""

#. Occurrence 6_7:772:8298: scene=6_7
#: 6_7:772
msgctxt "text_id=8298 | speaker=unknown"
msgid "　草十郎の突然の謝罪に、青子はいつもの不機嫌そうな表情に戻る。"
msgstr ""

#. Occurrence 6_7:777:8299: scene=6_7
#: 6_7:777
msgctxt "text_id=8299 | speaker=unknown"
msgid "　青子本人、自分が怒った理由はおろか、怒っていた事すら気付いていない。"
msgstr ""

#. Occurrence 6_7:782:8300: scene=6_7
#: 6_7:782
msgctxt "text_id=8300 | speaker=unknown"
msgid "　そんな青子からすると、草十郎の謝罪はまさに寝耳に水だ。"
msgstr ""

#. Occurrence 6_7:817:8301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8301 | speaker=aoko"
msgid "「……アンタって、ほんと分かんないわね。"
msgstr ""

#. Occurrence 6_7:817:8302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8302 | speaker=aoko"
msgid "　なんでそこで謝るのよ」"
msgstr ""

#. Occurrence 6_7:822:8303: scene=6_7
#: 6_7:822
msgctxt "text_id=8303 | speaker=unknown"
msgid "　青子はまじまじと草十郎を見る。"
msgstr ""

#. Occurrence 6_7:844:8304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0008; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:844
msgctxt "text_id=8304 | speaker=soujuurou"
msgid "「？　……あれ、そうだな。自分でもよく分からない。"
msgstr ""

msgctxt "text_id=8305 | speaker=unknown"
msgid "　たぶん、そういう気分になったからだろう」"
msgstr ""

#. Occurrence 6_7:857:8306: scene=6_7
#: 6_7:857
msgctxt "text_id=8306 | speaker=unknown"
msgid "　よく分からない、などと言いつつ、草十郎は真剣に返答する。青子は呆れて言葉もない。"
msgstr ""

#. Occurrence 6_7:884:8307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0009; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:884
msgctxt "text_id=8307 | speaker=soujuurou"
msgid "「ただ、蒼崎の言いたい事は分かった。"
msgstr ""

#. Occurrence 6_7:890:8308: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0010; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:890
msgctxt "text_id=8308 | speaker=soujuurou"
msgid "　約束を守るっていう事は、結果じゃなく、過程を守るって事なんだな」"
msgstr ""

#. Occurrence 6_7:896:8309: scene=6_7
#: 6_7:896
msgctxt "text_id=8309 | speaker=unknown"
msgid "　恥ずかしげもなくまっすぐに、草十郎は青子に笑いかけた。"
msgstr ""

#. Occurrence 6_7:901:8310: scene=6_7
#: 6_7:901
msgctxt "text_id=8310 | speaker=unknown"
msgid "　純粋な嬉しさに満ちた笑顔は、思わず笑みを返したくなるほどだ。"
msgstr ""

#. Occurrence 6_7:943:8311: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0015; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:943
msgctxt "text_id=8311 | speaker=aoko"
msgid "「あ、当たり前じゃない。オチだけ合っていればいいなんて、恥ずかしくてできないでしょ」"
msgstr ""

#. Occurrence 6_7:949:8312: scene=6_7
#: 6_7:949
msgctxt "text_id=8312 | speaker=unknown"
msgid "　照れたように顔を背けて、青子は小さく言い返す。"
msgstr ""

#. Occurrence 6_7:954:8313: scene=6_7
#: 6_7:954
msgctxt "text_id=8313 | speaker=unknown"
msgid "　不覚にも自分の本音を言い当てられ、少しだけくすぐったかったのだ。"
msgstr ""

#. Occurrence 6_7:998:8314: scene=6_7
#: 6_7:998
msgctxt "text_id=8314 | speaker=unknown"
msgid "　いつもなら不快なだけ。"
msgstr ""

#. Occurrence 6_7:1003:8315: scene=6_7
#: 6_7:1003
msgctxt "text_id=8315 | speaker=unknown"
msgid "　が、何故か今は嬉しくて、つい顔を背けてしまった。"
msgstr ""

#. Occurrence 6_7:1008:8316: scene=6_7
#: 6_7:1008
msgctxt "text_id=8316 | speaker=unknown"
msgid "　そんな自分が余計にみっともなく、青子は誤魔化すように言葉を続ける。"
msgstr ""

#. Occurrence 6_7:1050:8317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0016; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1050
msgctxt "text_id=8317 | speaker=aoko"
msgid "「貴方を見逃すって言うなら、気持ちの問題じゃなくて、ちゃんと状況もそうなるようにするのは当たり前なの。"
msgstr ""

#. Occurrence 6_7:1056:8318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0017; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1056
msgctxt "text_id=8318 | speaker=aoko"
msgid "　草十郎をここに住まわせる事があの約束を守る事になるんなら、厄介な有珠だって言い伏せるわよ。"
msgstr ""

#. Occurrence 6_7:1062:8319: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0018; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1062
msgctxt "text_id=8319 | speaker=aoko"
msgid "　……<脅|おど>かすだけならまだしも、ずっと瓶づけなんてさせられるワケないでしょう」"
msgstr ""

#. Occurrence 6_7:1107:8320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0011; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1107
msgctxt "text_id=8320 | speaker=soujuurou"
msgid "「そっか。蒼崎があの娘を説得しない素振りなのは、もうできるだけの説得をした後だからなのか。"
msgstr ""

#. Occurrence 6_7:1120:8321: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0012; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1120
msgctxt "text_id=8321 | speaker=soujuurou"
msgid "　あ。それで彼女とは冷戦中なんだ」"
msgstr ""

#. Occurrence 6_7:1149:8322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0019; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1149
msgctxt "text_id=8322 | speaker=aoko"
msgid "「……別にアンタのためじゃないわ。私は私のために約束を守ってるだけだし。"
msgstr ""

#. Occurrence 6_7:1155:8323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0020; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1155
msgctxt "text_id=8323 | speaker=aoko"
msgid "　お察しの通り、私のやるべき事はもう終わってるし？　あとは<草十郎|そっち>が努力する番だから、勝手にすれば？」"
msgstr ""

#. Occurrence 6_7:1168:8324: scene=6_7
#: 6_7:1168
msgctxt "text_id=8324 | speaker=unknown"
msgid "　言われて、はい？　と首をかしげる草十郎。"
msgstr ""

#. Occurrence 6_7:1202:8325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0021; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1202
msgctxt "text_id=8325 | speaker=aoko"
msgid "「あのね。いい？　同居案をなんとか認めさせる事が出来るのは私だけだから、二日間ぶっ通しで有珠を言い伏せもした。けどそれ以上は無理。"
msgstr ""

#. Occurrence 6_7:1208:8326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0022; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1208
msgctxt "text_id=8326 | speaker=aoko"
msgid "　私、ここから先はノータッチだから。"
msgstr ""

#. Occurrence 6_7:1214:8327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0023; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1214
msgctxt "text_id=8327 | speaker=aoko"
msgid "　しばらくは有珠から守ってあげるけど、その間にあの子にアンタを認めさせる事は、アンタにしか出来ないんだからね、草十郎」"
msgstr ""

#. Occurrence 6_7:1290:8328: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0013; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1290
msgctxt "text_id=8328 | speaker=soujuurou"
msgid "「なんと！」"
msgstr ""

#. Occurrence 6_7:1296:8329: scene=6_7
#: 6_7:1296
msgctxt "text_id=8329 | speaker=unknown"
msgid "　そういう流れになるのか、と面食らう草十郎。"
msgstr ""

#. Occurrence 6_7:1307:8330: scene=6_7
#: 6_7:1307
msgctxt "text_id=8330 | speaker=unknown"
msgid "　久遠寺有珠。"
msgstr ""

#. Occurrence 6_7:1312:8331: scene=6_7
#: 6_7:1312
msgctxt "text_id=8331 | speaker=unknown"
msgid "　他人を寄せ付けない黒衣の少女。"
msgstr ""

#. Occurrence 6_7:1317:8332: scene=6_7
#: 6_7:1317
msgctxt "text_id=8332 | speaker=unknown"
msgid "　青子が現代に隠れ住む魔法使いなら、彼女は中世に実在した魔女さながらだ。"
msgstr ""

#. Occurrence 6_7:1346:8333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0014; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1346
msgctxt "text_id=8333 | speaker=soujuurou"
msgid "「……蒼崎。君、自分がどれだけ難しい事を言っているか分かってるか？」"
msgstr ""

#. Occurrence 6_7:1371:8334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0024; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1371
msgctxt "text_id=8334 | speaker=aoko"
msgid "「そうね。私もこの件に関してだけは同情するわ」"
msgstr ""

#. Occurrence 6_7:1412:8335: scene=6_7
#: 6_7:1412
msgctxt "text_id=8335 | speaker=unknown"
msgid "　青子はソファーから立ち上がる。"
msgstr ""

#. Occurrence 6_7:1417:8336: scene=6_7
#: 6_7:1417
msgctxt "text_id=8336 | speaker=unknown"
msgid "　とりあえず話はここまでらしい。"
msgstr ""

#. Occurrence 6_7:1455:8337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0025; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1455
msgctxt "text_id=8337 | speaker=aoko"
msgid "「私たちがどんな人間かはおおよそ<判|わか>ったでしょ。"
msgstr ""

#. Occurrence 6_7:1461:8338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0026; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1461
msgctxt "text_id=8338 | speaker=aoko"
msgid "　魔術に関してはこれ以上立ち入らない方がアンタのためだから、説明はここまでね。"
msgstr ""

#. Occurrence 6_7:1472:8339: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0027; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1472
msgctxt "text_id=8339 | speaker=aoko"
msgid "　で、肝心の今後の方針だけど、三ヶ月間ここで暮らす。"
msgstr ""

#. Occurrence 6_7:1478:8340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0028; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1478
msgctxt "text_id=8340 | speaker=aoko"
msgid "　当初の目標……というより最初の試練は、なんとか有珠に同居人として認めてもらう事」"
msgstr ""

#. Occurrence 6_7:1524:8341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0015; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1524
msgctxt "text_id=8341 | speaker=soujuurou"
msgid "「試練って言った。いま、そういうたぐいのコトを言った」"
msgstr ""

#. Occurrence 6_7:1549:8342: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0029; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1549
msgctxt "text_id=8342 | speaker=aoko"
msgid "「誤魔化してもいいコトないでしょ、この手のコトは。"
msgstr ""

#. Occurrence 6_7:1555:8343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0030; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1555
msgctxt "text_id=8343 | speaker=aoko"
msgid "　うまくいかなきゃ<粉々|こなごな>なワケだし？」"
msgstr ""

#. Occurrence 6_7:1576:8344: scene=6_7
#: 6_7:1576
msgctxt "text_id=8344 | speaker=unknown"
msgid "　血も涙もない発言をして、青子はドアへと歩きだす。"
msgstr ""

#. Occurrence 6_7:1633:8345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0031; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1633
msgctxt "text_id=8345 | speaker=aoko"
msgid "「あ、そうそう。"
msgstr ""

#. Occurrence 6_7:1639:8346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0032; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1639
msgctxt "text_id=8346 | speaker=aoko"
msgid "　草十郎の部屋だけど、三階に用意しといたから。二階のホールの裏側に階段があるから使って。ここは寮ってワケでもないし、時間は自由に使いなさい。"
msgstr ""

#. Occurrence 6_7:1650:8347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0033; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1650
msgctxt "text_id=8347 | speaker=aoko"
msgid "　ただし、西館にだけは入らないようにね。東館は私が借りてるから比較的安全だけど、それでも歩き回らない方が無難だわ。"
msgstr ""

#. Occurrence 6_7:1657:8348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0034; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1657
msgctxt "text_id=8348 | speaker=aoko"
msgid "ま、基本安全なのはアンタの部屋と<居間|ここ>だけよ」"
msgstr ""

#. Occurrence 6_7:1695:8349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0016; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1695
msgctxt "text_id=8349 | speaker=soujuurou"
msgid "「な―――<館|なか>の説明って、まさかそれだけ！？"
msgstr ""

#. Occurrence 6_7:1714:8350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0017; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1714
msgctxt "text_id=8350 | speaker=soujuurou"
msgid "　蒼崎はいろいろおかしい、魔術なんかよりもっと大事な説明があると思う！」"
msgstr ""

#. Occurrence 6_7:1720:8351: scene=6_7
#: 6_7:1720
msgctxt "text_id=8351 | speaker=unknown"
msgid "　じゃあね、とばかりに居間から出ていこうとする青子を、草十郎は決死の面持ちで呼び止める。"
msgstr ""

#. Occurrence 6_7:1749:8352: scene=6_7
#: 6_7:1749
msgctxt "text_id=8352 | speaker=unknown"
msgid "　そんな草十郎を、心底かったりー、と<憐|あわ>れむ青子。"
msgstr ""

#. Occurrence 6_7:1786:8353: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0018; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1786
msgctxt "text_id=8353 | speaker=soujuurou"
msgid "「せめてほら、案内とか」"
msgstr ""

#. Occurrence 6_7:1816:8354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0035; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1816
msgctxt "text_id=8354 | speaker=aoko"
msgid "「面倒なんでパス。お上りさんを案内するなんて二回もやれば十分よ。"
msgstr ""

#. Occurrence 6_7:1822:8355: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8355 | speaker=aoko"
msgid "　起きたばっかりだし、とりあえず今日は部屋で休んだら？"
msgstr ""

#. Occurrence 6_7:1822:8356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8356 | speaker=aoko"
msgid "　朝になったら学校まで案内してあげるから」"
msgstr ""

#. Occurrence 6_7:1849:8357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0037; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1849
msgctxt "text_id=8357 | speaker=aoko"
msgid "「もっとも、私もそう暇じゃなし、側についてあげられるのは期末試験が終わるまでってコトで。"
msgstr ""

#. Occurrence 6_7:1855:8358: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0038; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1855
msgctxt "text_id=8358 | speaker=aoko"
msgid "　一週間以内に有珠と仲良くなるなり、弱みを握るなりしないと、ま、アレよね」"
msgstr ""

#. Occurrence 6_7:1903:8359: scene=6_7
#: 6_7:1903
msgctxt "text_id=8359 | speaker=unknown"
msgid "　じゃあねー、と去っていく最終鬼畜会長。"
msgstr ""

#. Occurrence 6_7:1937:8360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0019; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1937
msgctxt "text_id=8360 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_7:1943:8361: scene=6_7
#: 6_7:1943
msgctxt "text_id=8361 | speaker=unknown"
msgid "　挙げた手を、思わずニギニギしてしまう。"
msgstr ""

#. Occurrence 6_7:1953:8362: scene=6_7
#: 6_7:1953
msgctxt "text_id=8362 | speaker=unknown"
msgid "　ひとり残されて、本気で途方にくれる草十郎。"
msgstr ""

#. Occurrence 6_7:1958:8363: scene=6_7
#: 6_7:1958
msgctxt "text_id=8363 | speaker=unknown"
msgid "　そんな彼を励ますように、"
msgstr ""

#. Occurrence 6_7:1996:8364: scene=6_7
#: 6_7:1996
msgctxt "text_id=8364 | speaker=unknown"
msgid "　チチチ、と。"
msgstr ""

#. Occurrence 6_7:2001:8365: scene=6_7
#: 6_7:2001
msgctxt "text_id=8365 | speaker=unknown"
msgid "　軽快な羽音と共に、いずこともなく現れる青い<駒鳥|コマドリ>。"
msgstr ""

#. Occurrence 6_7:2053:8366: scene=6_7
#: 6_7:2053
msgctxt "text_id=8366 | speaker=unknown"
msgid "　でっぷりとした小鳥は無邪気そうな瞳を草十郎に向けている。"
msgstr ""

#. Occurrence 6_7:2063:8367: scene=6_7
#: 6_7:2063
msgctxt "text_id=8367 | speaker=unknown"
msgid "　俗説で言うところの幸福を運ぶ青い鳥は、まるで彼の先行きを応援するように羽ばたくと、"
msgstr ""

#. Occurrence 6_7:2105:8368: scene=6_7
#: 6_7:2105
msgctxt "text_id=8368 | speaker=unknown"
msgid "　情け容赦なく、居間の電気を消したのだった。"
msgstr ""

#. Occurrence 6_8:81:8369: scene=6_8
#: 6_8:81
msgctxt "text_id=8369 | speaker=unknown"
msgid "　草十郎を居間に残したまま、青子は自室に戻ってきた。"
msgstr ""

#. Occurrence 6_8:86:8370: scene=6_8
#: 6_8:86
msgctxt "text_id=8370 | speaker=unknown"
msgid "　ドアを閉めベッドに腰を下ろすと、どっと疲れが押し寄せてくる。"
msgstr ""

#. Occurrence 6_8:91:8371: scene=6_8
#: 6_8:91
msgctxt "text_id=8371 | speaker=unknown"
msgid "　草十郎には知るよしもないが、青子は青子で臨戦態勢だったのだ。"
msgstr ""

#. Occurrence 6_8:96:8372: scene=6_8
#: 6_8:96
msgctxt "text_id=8372 | speaker=unknown"
msgid "　いつ有珠が直情にかられてプロイを持ちだしても、即座に反応できるように。"
msgstr ""

#. Occurrence 6_8:130:8373: scene=6_8
#: 6_8:130
msgctxt "text_id=8373 | speaker=unknown"
msgid "　はあ、とため息をつく。"
msgstr ""

#. Occurrence 6_8:135:8374: scene=6_8
#: 6_8:135
msgctxt "text_id=8374 | speaker=unknown"
msgid "　それは有珠との暗闘による気疲れ―――ではなく。"
msgstr ""

#. Occurrence 6_8:156:8375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0000; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:156
msgctxt "text_id=8375 | speaker=aoko"
msgid "「……ちょっと突っぱねすぎたか？」"
msgstr ""

#. Occurrence 6_8:162:8376: scene=6_8
#: 6_8:162
msgctxt "text_id=8376 | speaker=unknown"
msgid "　むう、と眉を<顰|ひそ>める。"
msgstr ""

#. Occurrence 6_8:167:8377: scene=6_8
#: 6_8:167
msgctxt "text_id=8377 | speaker=unknown"
msgid "　彼女の頭を重くしているのは、まったく別の問題だった。"
msgstr ""

#. Occurrence 6_8:201:8378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0001; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:201
msgctxt "text_id=8378 | speaker=aoko"
msgid "「……でも甘くするのはアイツのためにならないし。"
msgstr ""

#. Occurrence 6_8:207:8379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0002; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:207
msgctxt "text_id=8379 | speaker=aoko"
msgid "　基本、大人しくしてもらった方がいいワケだし……」"
msgstr ""

#. Occurrence 6_8:213:8380: scene=6_8
#: 6_8:213
msgctxt "text_id=8380 | speaker=unknown"
msgid "　安心されて我が家のように歩き回られるのも困る。"
msgstr ""

#. Occurrence 6_8:218:8381: scene=6_8
#: 6_8:218
msgctxt "text_id=8381 | speaker=unknown"
msgid "　彼にはおっかなびっくり、極力、自分の部屋に閉じこもってもらった方が安全なのだ。"
msgstr ""

#. Occurrence 6_8:245:8382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0003; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:245
msgctxt "text_id=8382 | speaker=aoko"
msgid "「ま、蒼崎は味方だ、なんて勘違いされても困るしね。"
msgstr ""

#. Occurrence 6_8:251:8383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0004; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:251
msgctxt "text_id=8383 | speaker=aoko"
msgid "　有珠同様、人でなし扱いされた方が楽だわ」"
msgstr ""

#. Occurrence 6_8:278:8384: scene=6_8
#: 6_8:278
msgctxt "text_id=8384 | speaker=unknown"
msgid "　よし、と自分の選択に納得する青子。"
msgstr ""

#. Occurrence 6_8:283:8385: scene=6_8
#: 6_8:283
msgctxt "text_id=8385 | speaker=unknown"
msgid "　彼女の方針はおおむね正しい。"
msgstr ""

#. Occurrence 6_8:302:8386: scene=6_8
#: 6_8:302
msgctxt "text_id=8386 | speaker=unknown"
msgid "　問題があるとすれば、"
msgstr ""

#. Occurrence 6_8:337:8387: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0000; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:337
msgctxt "text_id=8387 | speaker=soujuurou"
msgid "「すまない蒼崎。ひとつ聞きたい事があるんだが……」"
msgstr ""

#. Occurrence 6_8:356:8388: scene=6_8
#: 6_8:356
msgctxt "text_id=8388 | speaker=unknown"
msgid "　居間で別れてから十分弱。"
msgstr ""

#. Occurrence 6_8:361:8389: scene=6_8
#: 6_8:361
msgctxt "text_id=8389 | speaker=unknown"
msgid "　最速とも言える開き直りで青子の部屋を訪れた、静希草十郎の危機感の無さだった。"
msgstr ""

#. Occurrence 6_8:429:8390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0001; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:429
msgctxt "text_id=8390 | speaker=soujuurou"
msgid "「実は、外に出たいんだ」"
msgstr ""

#. Occurrence 6_8:435:8391: scene=6_8
#: 6_8:435
msgctxt "text_id=8391 | speaker=unknown"
msgid "　それがこの男の言い分だった。"
msgstr ""

#. Occurrence 6_8:463:8392: scene=6_8
#: 6_8:463
msgctxt "text_id=8392 | speaker=unknown"
msgid "　青子には嫌味を返す気力もない。"
msgstr ""

#. Occurrence 6_8:493:8393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0002; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:493
msgctxt "text_id=8393 | speaker=soujuurou"
msgid "「洋館の中は歩き回らないし、用を済ませたらきちんと戻ってくる。ただ、門限とかあったら聞いておこうと思って」"
msgstr ""

#. Occurrence 6_8:539:8394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0005; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:539
msgctxt "text_id=8394 | speaker=aoko"
msgid "「でも、アルバイトには行くのよね」"
msgstr ""

#. Occurrence 6_8:555:8395: scene=6_8
#: 6_8:555
msgctxt "text_id=8395 | speaker=unknown"
msgid "　なんで分かる!?　と驚く草十郎。"
msgstr ""

#. Occurrence 6_8:560:8396: scene=6_8
#: 6_8:560
msgctxt "text_id=8396 | speaker=unknown"
msgid "　正直、驚きたいのは青子の方である。"
msgstr ""

#. Occurrence 6_8:587:8397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0006; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:587
msgctxt "text_id=8397 | speaker=aoko"
msgid "「……まあいいわ。"
msgstr ""

#. Occurrence 6_8:593:8398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8398 | speaker=aoko"
msgid "　基本、午後十時まで。その時間には必ず屋敷にいること。"
msgstr ""

#. Occurrence 6_8:593:8399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8399 | speaker=aoko"
msgid "　その後は夜勤にでかけるなり、庭でバーベキューするなり、なんでも好きにしていい。"
msgstr ""

#. Occurrence 6_8:605:8400: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0008; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:605
msgctxt "text_id=8400 | speaker=aoko"
msgid "　それと、玄関に鍵はかかってないから」"
msgstr ""

#. Occurrence 6_8:629:8401: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0003; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:629
msgctxt "text_id=8401 | speaker=soujuurou"
msgid "「……気のせいじゃなければだけど。"
msgstr ""

#. Occurrence 6_8:635:8402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0004; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:635
msgctxt "text_id=8402 | speaker=soujuurou"
msgid "　蒼崎、すごく怒ってないか？」"
msgstr ""

#. Occurrence 6_8:678:8403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0009; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:678
msgctxt "text_id=8403 | speaker=aoko"
msgid "「アンタ相手に気を遣った自分に<呆|あき>れ果ててるだけよ。"
msgstr ""

#. Occurrence 6_8:690:8404: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0010; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:690
msgctxt "text_id=8404 | speaker=aoko"
msgid "　外に出るのはいいけど、その前にこの<錠剤|じょうざい>飲んで」"
msgstr ""

#. Occurrence 6_8:696:8405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0005; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:696
msgctxt "text_id=8405 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 6_8:701:8406: scene=6_8
#: 6_8:701
msgctxt "text_id=8406 | speaker=unknown"
msgid "　青子から差し出された紫色の錠剤を、半信半疑で草十郎は口に入れた。"
msgstr ""

#. Occurrence 6_8:706:8407: scene=6_8
#: 6_8:706
msgctxt "text_id=8407 | speaker=unknown"
msgid "　体に<良|い>い薬か何かだろう、と思いこんでいる風だ。"
msgstr ""

#. Occurrence 6_8:745:8408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0006; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:745
msgctxt "text_id=8408 | speaker=soujuurou"
msgid "「それじゃ行ってくる。色々ありがとう、蒼崎」"
msgstr ""

#. Occurrence 6_8:751:8409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0011; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:751
msgctxt "text_id=8409 | speaker=aoko"
msgid "「あっそ。今度は窓から出ていかないでよね」"
msgstr ""

#. Occurrence 6_8:784:8410: scene=6_8
#: 6_8:784
msgctxt "text_id=8410 | speaker=unknown"
msgid "　何が嬉しいのか、あはは、などと平和ぼけに笑って草十郎はホールへ向かっていった。"
msgstr ""

#. Occurrence 6_8:789:8411: scene=6_8
#: 6_8:789
msgctxt "text_id=8411 | speaker=unknown"
msgid "　その背中を、青子は<半|なか>ば冷たく、半ば不思議そうに観察する。"
msgstr ""

#. Occurrence 6_8:825:8412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0012; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:825
msgctxt "text_id=8412 | speaker=aoko"
msgid "「ま、予定が半日早まっただけか。"
msgstr ""

#. Occurrence 6_8:832:8413: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0013; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:832
msgctxt "text_id=8413 | speaker=aoko"
msgid "あの薬を飲ませるの、明日の朝にしてあげようと思ったのに」"
msgstr ""

#. Occurrence 6_8:896:8414: scene=6_8
#: 6_8:896
msgctxt "text_id=8414 | speaker=unknown"
msgid "　やれやれと髪をかいて自室に戻る。"
msgstr ""

#. Occurrence 6_8:901:8415: scene=6_8
#: 6_8:901
msgctxt "text_id=8415 | speaker=unknown"
msgid "　彼の行動原理なんて考えるまでもない。"
msgstr ""

#. Occurrence 6_8:906:8416: scene=6_8
#: 6_8:906
msgctxt "text_id=8416 | speaker=unknown"
msgid "　おおかた、二日間寝こんでいた自分の体より、アルバイトを休んでいた事の方が気になっていたのだろう。"
msgstr ""

#. Occurrence 6_9:91:8417: scene=6_9
#: 6_9:91
msgctxt "text_id=8417 | speaker=unknown"
msgid "　一日の仕事を終え、草十郎は洋館に戻ってきた。"
msgstr ""

#. Occurrence 6_9:113:8418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0000; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:113
msgctxt "text_id=8418 | speaker=soujuurou"
msgid "「よし。どこを探しても、二階のホールから上がれる階段はここだけだ」"
msgstr ""

#. Occurrence 6_9:119:8419: scene=6_9
#: 6_9:119
msgctxt "text_id=8419 | speaker=unknown"
msgid "　日付も替わろうとする零時前。"
msgstr ""

#. Occurrence 6_9:124:8420: scene=6_9
#: 6_9:124
msgctxt "text_id=8420 | speaker=unknown"
msgid "　くたびれた階段の先には、このような景色が広がっていた。"
msgstr ""

#. Occurrence 6_9:173:8421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0001; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:173
msgctxt "text_id=8421 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_9:179:8422: scene=6_9
#: 6_9:179
msgctxt "text_id=8422 | speaker=unknown"
msgid "　たいていのコトには驚かない……もう驚きなれてしまった……草十郎をして、それは、言葉を失う光景だった。"
msgstr ""

#. Occurrence 6_9:201:8423: scene=6_9
#: 6_9:201
msgctxt "text_id=8423 | speaker=unknown"
msgid "　草十郎にあてがわれた部屋は、"
msgstr ""

#. Occurrence 6_9:206:8424: scene=6_9
#: 6_9:206
msgctxt "text_id=8424 | speaker=unknown"
msgid "　どこをどう見ても、"
msgstr ""

#. Occurrence 6_9:211:8425: scene=6_9
#: 6_9:211
msgctxt "text_id=8425 | speaker=unknown"
msgid "　何をとりつくろうとも、"
msgstr ""

#. Occurrence 6_9:216:8426: scene=6_9
#: 6_9:216
msgctxt "text_id=8426 | speaker=unknown"
msgid "　まがうことなき屋根裏部屋でした。"
msgstr ""

#. Occurrence 6_9:238:8427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0002; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:238
msgctxt "text_id=8427 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 6_9:260:8428: scene=6_9
#: 6_9:260
msgctxt "text_id=8428 | speaker=unknown"
msgid "　むう、と己の<処遇|しょぐう>に<一抹|いちまつ>の不安を覚える。"
msgstr ""

#. Occurrence 6_9:266:8429: scene=6_9
#: 6_9:266
msgctxt "text_id=8429 | speaker=unknown"
msgid "　ただでさえ気の重いことばかりなのに、こんなんでやっていけるのかな、とシーツの敷かれたベッドに倒れこもうとした時、"
msgstr ""

#. Occurrence 6_9:273:8430: scene=6_9
#: 6_9:273
msgctxt "text_id=8430 | speaker=unknown"
msgid "　ささやかすぎて役に立たない、ちぐはぐな気遣いがあった。"
msgstr ""

#. Occurrence 6_9:296:8431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0000; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:296
msgctxt "text_id=8431 | speaker=aoko"
msgid "『寒かったら重ねて使うこと。これはサービスとする』"
msgstr ""

#. Occurrence 6_9:302:8432: scene=6_9
#: 6_9:302
msgctxt "text_id=8432 | speaker=unknown"
msgid "　メモにある文字は、几帳面な性格がにじみ出ている。"
msgstr ""

#. Occurrence 6_9:307:8433: scene=6_9
#: 6_9:307
msgctxt "text_id=8433 | speaker=unknown"
msgid "　布団は十分用意されていた。"
msgstr ""

#. Occurrence 6_9:314:8434: scene=6_9
#: 6_9:314
msgctxt "text_id=8434 | speaker=unknown"
msgid "　その上で、念のためにと置かれた毛布を大事そうに<端|はし>にどけて、草十郎は空を仰いだ。"
msgstr ""

#. Occurrence 6_9:377:8435: scene=6_9
#: 6_9:377
msgctxt "text_id=8435 | speaker=unknown"
msgid "　おぼろげではあるが、天窓には星が<瞬|またた>いている。"
msgstr ""

#. Occurrence 6_9:382:8436: scene=6_9
#: 6_9:382
msgctxt "text_id=8436 | speaker=unknown"
msgid "　山育ちである彼にすれば、不満はあれ十分な明かりといえる。"
msgstr ""

#. Occurrence 6_9:387:8437: scene=6_9
#: 6_9:387
msgctxt "text_id=8437 | speaker=unknown"
msgid "　居間との格差から面食らってしまったが、冷静になれば落胆するコトでもない。"
msgstr ""

#. Occurrence 6_9:407:8438: scene=6_9
#: 6_9:407
msgctxt "text_id=8438 | speaker=unknown"
msgid "　この部屋はこの部屋で彼の性格に合っているのだし。"
msgstr ""

#. Occurrence 6_9:412:8439: scene=6_9
#: 6_9:412
msgctxt "text_id=8439 | speaker=unknown"
msgid "　いまだ勝手の分からない建物だとしても、町の建物よりは安心できた。"
msgstr ""

#. Occurrence 6_9:417:8440: scene=6_9
#: 6_9:417
msgctxt "text_id=8440 | speaker=unknown"
msgid "　丘の上、森の中に建っているからだろう。"
msgstr ""

#. Occurrence 6_9:422:8441: scene=6_9
#: 6_9:422
msgctxt "text_id=8441 | speaker=unknown"
msgid "　ここは少しだけ彼の住んでいた山の空気に近いのだ。"
msgstr ""

#. Occurrence 6_9:443:8442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0003; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:443
msgctxt "text_id=8442 | speaker=soujuurou"
msgid "「……あ。でも、家の中に霧が出るのはどうなんだろう？」"
msgstr ""

#. Occurrence 6_9:468:8443: scene=6_9
#: 6_9:468
msgctxt "text_id=8443 | speaker=unknown"
msgid "　先ほどの光景を思い返して首をかしげる。"
msgstr ""

#. Occurrence 6_9:473:8444: scene=6_9
#: 6_9:473
msgctxt "text_id=8444 | speaker=unknown"
msgid "　草十郎はここに来る途中、二階のホールで霧らしきものを見かけていた。"
msgstr ""

#. Occurrence 6_9:544:8445: scene=6_9
#: 6_9:544
msgctxt "text_id=8445 | speaker=unknown"
msgid "　白い霧は廊下の一部分にだけ漂っていて、<藪蚊|やぶか>の群を思わせた。"
msgstr ""

#. Occurrence 6_9:555:8446: scene=6_9
#: 6_9:555
msgctxt "text_id=8446 | speaker=unknown"
msgid "　じっと見ていると、おかしな風景が見えた気がして近寄ったのだが、"
msgstr ""

#. Occurrence 6_9:568:8447: scene=6_9
#: 6_9:568
msgctxt "text_id=8447 | speaker=unknown"
msgid "　これまたとつぜん、不自然なことに青い小鳥が目の前を横切ったのだ。館内で。"
msgstr ""

#. Occurrence 6_9:634:8448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0004; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:634
msgctxt "text_id=8448 | speaker=soujuurou"
msgid "「―――鳥？」"
msgstr ""

#. Occurrence 6_9:640:8449: scene=6_9
#: 6_9:640
msgctxt "text_id=8449 | speaker=unknown"
msgid "　小鳥に気を取られて立ち止まる。"
msgstr ""

#. Occurrence 6_9:645:8450: scene=6_9
#: 6_9:645
msgctxt "text_id=8450 | speaker=unknown"
msgid "　もう一度霧を見ると、おかしな風景は消えていた。"
msgstr ""

#. Occurrence 6_9:695:8451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8451 | speaker=soujuurou"
msgid "「……この家、隙間でもあるのかな。"
msgstr ""

#. Occurrence 6_9:695:8452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8452 | speaker=soujuurou"
msgid "　明日、蒼崎に訊いてみるか」"
msgstr ""

#. Occurrence 6_9:701:8453: scene=6_9
#: 6_9:701
msgctxt "text_id=8453 | speaker=unknown"
msgid "　ベッドに腰掛けながら呟く。"
msgstr ""

#. Occurrence 6_9:706:8454: scene=6_9
#: 6_9:706
msgctxt "text_id=8454 | speaker=unknown"
msgid "　天窓から<覗|のぞ>く星の光は、ささやかではあるが気持ちを落ち着かせてくれた。"
msgstr ""

#. Occurrence 6_9:733:8455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0006; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:733
msgctxt "text_id=8455 | speaker=soujuurou"
msgid "「うん、これなら―――」"
msgstr ""

#. Occurrence 6_9:746:8456: scene=6_9
#: 6_9:746
msgctxt "text_id=8456 | speaker=unknown"
msgid "　ほう、と息を吐いてベッドに体を預ける。"
msgstr ""

#. Occurrence 6_9:751:8457: scene=6_9
#: 6_9:751
msgctxt "text_id=8457 | speaker=unknown"
msgid "　とりあえず衣食住はあるのだし、ベッドは見た目より何倍も柔らかいし。"
msgstr ""

#. Occurrence 6_9:756:8458: scene=6_9
#: 6_9:756
msgctxt "text_id=8458 | speaker=unknown"
msgid "　心配事はあまりないな、と草十郎は速やかに眠りに落ちていった。"
msgstr ""

#. Occurrence 6_9:805:8459: scene=6_9
#: 6_9:805
msgctxt "text_id=8459 | speaker=unknown"
msgid "　以上が、彼の目覚めてから眠るまでの話。"
msgstr ""

#. Occurrence 6_9:811:8460: scene=6_9
#: 6_9:811
msgctxt "text_id=8460 | speaker=unknown"
msgid "　長い夜のあとの、短い夜はこうして終わった。"
msgstr ""

#. Occurrence 6_9:817:8461: scene=6_9
#: 6_9:817
msgctxt "text_id=8461 | speaker=unknown"
msgid "　……どうあれ。"
msgstr ""

#. Occurrence 6_9:822:8462: scene=6_9
#: 6_9:822
msgctxt "text_id=8462 | speaker=unknown"
msgid "　楽観的すぎるけれど、やっていけない事はなさそうだ。"
msgstr ""

#. Occurrence 6_9:873:8463: scene=6_9
#: 6_9:873
msgctxt "text_id=8463 | speaker=unknown"
msgid "　そんな、踏まれても踏まれても応えない<天然草|てんねんそう>の話から、時間は五時間ほどさかのぼる。"
msgstr ""

#. Occurrence 6_9:939:8464: scene=6_9
#: 6_9:939
msgctxt "text_id=8464 | speaker=unknown"
msgid "　魔術師の当事者ふたりと、おまけの少年の不毛な話し合いが終わった午後七時。"
msgstr ""

#. Occurrence 6_9:944:8465: scene=6_9
#: 6_9:944
msgctxt "text_id=8465 | speaker=unknown"
msgid "　居間に<同居人|あおこ>と<闖入者|そうじゅうろう>を残したまま、少女はひとりロビーを歩いていた。"
msgstr ""

#. Occurrence 6_9:949:8466: scene=6_9
#: 6_9:949
msgctxt "text_id=8466 | speaker=unknown"
msgid "　向かう先は館の西館。"
msgstr ""

#. Occurrence 6_9:954:8467: scene=6_9
#: 6_9:954
msgctxt "text_id=8467 | speaker=unknown"
msgid "　同居人である蒼崎青子でさえ滅多に足を踏み入れない、久遠寺有珠の居住区である。"
msgstr ""

#. Occurrence 6_9:998:8468: scene=6_9
#: 6_9:998
msgctxt "text_id=8468 | speaker=unknown"
msgid "　月明かりだけのロビー。"
msgstr ""

#. Occurrence 6_9:1003:8469: scene=6_9
#: 6_9:1003
msgctxt "text_id=8469 | speaker=unknown"
msgid "　寒々しい明かりの下、硬い足音が<木霊|こだま>している。"
msgstr ""

#. Occurrence 6_9:1008:8470: scene=6_9
#: 6_9:1008
msgctxt "text_id=8470 | speaker=unknown"
msgid "　洋風の屋敷では靴を脱ぐ習慣はない。"
msgstr ""

#. Occurrence 6_9:1013:8471: scene=6_9
#: 6_9:1013
msgctxt "text_id=8471 | speaker=unknown"
msgid "　有珠はブーツのままロビーを横断する。"
msgstr ""

#. Occurrence 6_9:1018:8472: scene=6_9
#: 6_9:1018
msgctxt "text_id=8472 | speaker=unknown"
msgid "　彼女が靴を脱ぐのは寝室で休む時だけだ。"
msgstr ""

#. Occurrence 6_9:1080:8473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0000; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1080
msgctxt "text_id=8473 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 6_9:1086:8474: scene=6_9
#: 6_9:1086
msgctxt "text_id=8474 | speaker=unknown"
msgid "　……ふと、有珠は子供の頃の出来事を思い出した。"
msgstr ""

#. Occurrence 6_9:1091:8475: scene=6_9
#: 6_9:1091
msgctxt "text_id=8475 | speaker=unknown"
msgid "　冷たい床の感覚を楽しみたくて、日射しの強い日は裸足でこのロビーを歩いた。"
msgstr ""

#. Occurrence 6_9:1096:8476: scene=6_9
#: 6_9:1096
msgctxt "text_id=8476 | speaker=unknown"
msgid "　それを父に優しく<咎|とが>められて以来、彼女は裸足で歩く事はなくなったのだが―――"
msgstr ""

#. Occurrence 6_9:1141:8477: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0001; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1141
msgctxt "text_id=8477 | speaker=alice"
msgid "「……そうだったわね。青子は結局、守らなかった」"
msgstr ""

#. Occurrence 6_9:1147:8478: scene=6_9
#: 6_9:1147
msgctxt "text_id=8478 | speaker=unknown"
msgid "　かすかなため息がもれる。"
msgstr ""

#. Occurrence 6_9:1152:8479: scene=6_9
#: 6_9:1152
msgctxt "text_id=8479 | speaker=unknown"
msgid "　日本に来てから得た新しい同居人は、有珠の言いつけには従わなかった。"
msgstr ""

#. Occurrence 6_9:1193:8480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0001; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:1193
msgctxt "text_id=8480 | speaker=aoko"
msgid "“落ち着かないものはしょうがない”"
msgstr ""

#. Occurrence 6_9:1199:8481: scene=6_9
#: 6_9:1199
msgctxt "text_id=8481 | speaker=unknown"
msgid "　と、青子はスリッパに履き替える事がある。"
msgstr ""

#. Occurrence 6_9:1204:8482: scene=6_9
#: 6_9:1204
msgctxt "text_id=8482 | speaker=unknown"
msgid "　中学生まで一般家屋で暮らしていた青子にすれば自然なのだろうが、あのペタペタいう足音でロビーを移動される度に、有珠は彼女との共同生活を破棄したくなったものだ。"
msgstr ""

#. Occurrence 6_9:1240:8483: scene=6_9
#: 6_9:1240
msgctxt "text_id=8483 | speaker=unknown"
msgid "　それも今ではさして気にはならない。"
msgstr ""

#. Occurrence 6_9:1245:8484: scene=6_9
#: 6_9:1245
msgctxt "text_id=8484 | speaker=unknown"
msgid "　人間の順応性は時に優秀で、不義理だ。"
msgstr ""

#. Occurrence 6_9:1250:8485: scene=6_9
#: 6_9:1250
msgctxt "text_id=8485 | speaker=unknown"
msgid "　現実の<忙|いそが>しさの前には、昔からの思い入れなんて<脆|もろ>すぎる。"
msgstr ""

#. Occurrence 6_9:1294:8486: scene=6_9
#: 6_9:1294
msgctxt "text_id=8486 | speaker=unknown"
msgid "　階段の手すりには青い小鳥が止まっていた。"
msgstr ""

#. Occurrence 6_9:1302:8487: scene=6_9
#: 6_9:1302
msgctxt "text_id=8487 | speaker=unknown"
msgid "　小さな鳴き声に、少女は足を止めて視線を向ける。"
msgstr ""

#. Occurrence 6_9:1319:8488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0002; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1319
msgctxt "text_id=8488 | speaker=alice"
msgid "「……今夜は放っておくわ。今は青子の問題よ」"
msgstr ""

#. Occurrence 6_9:1371:8489: scene=6_9
#: 6_9:1371
msgctxt "text_id=8489 | speaker=unknown"
msgid "　感情の乏しい声に、小鳥は首をかしげながら鳴いた。"
msgstr ""

#. Occurrence 6_9:1377:8490: scene=6_9
#: 6_9:1377
msgctxt "text_id=8490 | speaker=unknown"
msgid "　チチチ、と。"
msgstr ""

#. Occurrence 6_9:1382:8491: scene=6_9
#: 6_9:1382
msgctxt "text_id=8491 | speaker=unknown"
msgid "　いつもの<主人|アリス>からは考えつかない、懐の深さを<訝|いぶか>しむように。"
msgstr ""

#. Occurrence 6_9:1423:8492: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0003; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1423
msgctxt "text_id=8492 | speaker=alice"
msgid "「約束は約束よ。今夜ぐらいは大目に見ないと。"
msgstr ""

#. Occurrence 6_9:1429:8493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0004; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1429
msgctxt "text_id=8493 | speaker=alice"
msgid "　……青子と彼は、それだけの活躍をしたのだし」"
msgstr ""

#. Occurrence 6_9:1435:8494: scene=6_9
#: 6_9:1435
msgctxt "text_id=8494 | speaker=unknown"
msgid "　小鳥に言い聞かせる声は、内容とは裏腹に不機嫌気味だ。"
msgstr ""

#. Occurrence 6_9:1440:8495: scene=6_9
#: 6_9:1440
msgctxt "text_id=8495 | speaker=unknown"
msgid "“勝負に勝てば見逃してあげる”"
msgstr ""

#. Occurrence 6_9:1445:8496: scene=6_9
#: 6_9:1445
msgctxt "text_id=8496 | speaker=unknown"
msgid "　その約束を守ってはいるものの、少女の胸には消しがたい戦意が灯っている。"
msgstr ""

#. Occurrence 6_9:1480:8497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0005; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1480
msgctxt "text_id=8497 | speaker=alice"
msgid "「……でも、その後の処遇は別の話。"
msgstr ""

#. Occurrence 6_9:1486:8498: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0006; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1486
msgctxt "text_id=8498 | speaker=alice"
msgid "　条件付きのゲームに勝ったぐらいで、いつまでも得意げでいられるのは心外だわ」"
msgstr ""

#. Occurrence 6_9:1492:8499: scene=6_9
#: 6_9:1492
msgctxt "text_id=8499 | speaker=unknown"
msgid "　潔癖性からくる完全主義か。"
msgstr ""

#. Occurrence 6_9:1497:8500: scene=6_9
#: 6_9:1497
msgctxt "text_id=8500 | speaker=unknown"
msgid "　こう見えて久遠寺有珠は負けず嫌いらしい。"
msgstr ""

#. Occurrence 6_9:1502:8501: scene=6_9
#: 6_9:1502
msgctxt "text_id=8501 | speaker=unknown"
msgid "　魔術の優劣などどうでもいいが、ゲームに負けた事が今も不満で仕方がないのだ。"
msgstr ""

#. Occurrence 6_9:1548:8502: scene=6_9
#: 6_9:1548
msgctxt "text_id=8502 | speaker=unknown"
msgid "　シュタ、と翼をあげて同意する小鳥。"
msgstr ""

#. Occurrence 6_9:1553:8503: scene=6_9
#: 6_9:1553
msgctxt "text_id=8503 | speaker=unknown"
msgid "　有珠の嫌悪感を汲んで、<草十郎|がいてき>を打ちのめさんとやる気に満ちている。"
msgstr ""

#. Occurrence 6_9:1558:8504: scene=6_9
#: 6_9:1558
msgctxt "text_id=8504 | speaker=unknown"
msgid "　その<羽繕|はづくろ>いは、上官に<敬礼|けいれい>する仕草に見えなくもない。"
msgstr ""

#. Occurrence 6_9:1618:8505: scene=6_9
#: 6_9:1618
msgctxt "text_id=8505 | speaker=unknown"
msgid "　かくして、青い小鳥は主人に向き直る。"
msgstr ""

#. Occurrence 6_9:1625:8506: scene=6_9
#: 6_9:1625
msgctxt "text_id=8506 | speaker=unknown"
msgid "　チチチ、チチチ。"
msgstr ""

#. Occurrence 6_9:1630:8507: scene=6_9
#: 6_9:1630
msgctxt "text_id=8507 | speaker=unknown"
msgid "　軽快な鳴き声は、明日の朝一番で<草十郎|アイツ>をヤりましょう、と宣言するかのようだ。"
msgstr ""

#. Occurrence 6_9:1677:8508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0007; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1677
msgctxt "text_id=8508 | speaker=alice"
msgid "「…………そうね。理由さえできたのなら、瓶なり本なりに入ってもらいましょう」"
msgstr ""

#. Occurrence 6_9:1706:8509: scene=6_9
#: 6_9:1706
msgctxt "text_id=8509 | speaker=unknown"
msgid "　だが、少女の声には張りがなかった。"
msgstr ""

#. Occurrence 6_9:1712:8510: scene=6_9
#: 6_9:1712
msgctxt "text_id=8510 | speaker=unknown"
msgid "　魔女らしい、容赦のない台詞だったが、よくよく考えてみれば<生温|なまぬる>いコトこの上ない。コマドリ的に。"
msgstr ""

#. Occurrence 6_9:1747:8511: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0008; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1747
msgctxt "text_id=8511 | speaker=alice"
msgid "「しばらくの話よ。けど、それも<一時|いっとき>だけ。わたしの我慢も長くは続かないし。"
msgstr ""

#. Occurrence 6_9:1753:8512: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0009; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1753
msgctxt "text_id=8512 | speaker=alice"
msgid "　……だいたい、青子も人にかまけていられる立場じゃないわ。五日もすれば思い知るでしょう。そうすれば―――」"
msgstr ""

#. Occurrence 6_9:1792:8513: scene=6_9
#: 6_9:1792
msgctxt "text_id=8513 | speaker=unknown"
msgid "　その時こそ、彼を<排斥|はいせき>するのは<容易|たやす>い。"
msgstr ""

#. Occurrence 6_9:1797:8514: scene=6_9
#: 6_9:1797
msgctxt "text_id=8514 | speaker=unknown"
msgid "　同居人が夢のない合理主義者である事を、有珠はよく分かっている。"
msgstr ""

#. Occurrence 6_9:1817:8515: scene=6_9
#: 6_9:1817
msgctxt "text_id=8515 | speaker=unknown"
msgid "　青子の置かれた状況は、いつまでもあんな余分を許しはしない。"
msgstr ""

#. Occurrence 6_9:1822:8516: scene=6_9
#: 6_9:1822
msgctxt "text_id=8516 | speaker=unknown"
msgid "　あの少年の保護に割り当てる<時間|よゆう>は、せいぜい三日から四日ほど。"
msgstr ""

#. Occurrence 6_9:1827:8517: scene=6_9
#: 6_9:1827
msgctxt "text_id=8517 | speaker=unknown"
msgid "　それを過ぎれば青子の方から“あとは有珠の判断に任せる”と折れるだろう。"
msgstr ""

#. Occurrence 6_9:1848:8518: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0010; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1848
msgctxt "text_id=8518 | speaker=alice"
msgid "「それまで待つか、あるいはわたしの我慢がきかなくなるか。"
msgstr ""

#. Occurrence 6_9:1854:8519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0011; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1854
msgctxt "text_id=8519 | speaker=alice"
msgid "　どちらにしても結果は変わらないわ」"
msgstr ""

#. Occurrence 6_9:1860:8520: scene=6_9
#: 6_9:1860
msgctxt "text_id=8520 | speaker=unknown"
msgid "　久遠寺有珠はこれ以上の厄介事を許さない。"
msgstr ""

#. Occurrence 6_9:1867:8521: scene=6_9
#: 6_9:1867
msgctxt "text_id=8521 | speaker=unknown"
msgid "　目撃者の保護や、まして、この洋館に住まわせるなんてもってのほかで―――"
msgstr ""

#. Occurrence 6_9:1936:8522: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0012; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1936
msgctxt "text_id=8522 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 6_9:1942:8523: scene=6_9
#: 6_9:1942
msgctxt "text_id=8523 | speaker=unknown"
msgid "　<漏|も>れだした<濃霧|のうむ>に引かれるよう、有珠は視線を上げた。"
msgstr ""

#. Occurrence 6_9:1947:8524: scene=6_9
#: 6_9:1947
msgctxt "text_id=8524 | speaker=unknown"
msgid "　暖炉の上には一枚の鏡がある。"
msgstr ""

#. Occurrence 6_9:1998:8525: scene=6_9
#: 6_9:1998
msgctxt "text_id=8525 | speaker=unknown"
msgid "　本来なら絵画が飾られるだろう壁には、直径一メートルほどの鏡。"
msgstr ""

#. Occurrence 6_9:2003:8526: scene=6_9
#: 6_9:2003
msgctxt "text_id=8526 | speaker=unknown"
msgid "　鏡の表面はぼんやりと<曇|くも>り、ロビーの様子を<曖昧|あいまい>に映している。"
msgstr ""

#. Occurrence 6_9:2032:8527: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0013; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2032
msgctxt "text_id=8527 | speaker=alice"
msgid "「……スナークを<喪|な>くした影響でしょうね。"
msgstr ""

#. Occurrence 6_9:2038:8528: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0014; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2038
msgctxt "text_id=8528 | speaker=alice"
msgid "　鏡の機能、しばらくは制御できないみたい」"
msgstr ""

#. Occurrence 6_9:2067:8529: scene=6_9
#: 6_9:2067
msgctxt "text_id=8529 | speaker=unknown"
msgid "　主人の呟きに、小鳥は喜びの<鳴|こえ>をあげた。"
msgstr ""

#. Occurrence 6_9:2072:8530: scene=6_9
#: 6_9:2072
msgctxt "text_id=8530 | speaker=unknown"
msgid "　それなら自分たちが手を下すまでもなく、邪魔者は鏡に落ちて退場すると。"
msgstr ""

#. Occurrence 6_9:2099:8531: scene=6_9
#: 6_9:2099
msgctxt "text_id=8531 | speaker=unknown"
msgid "　……あるいは。"
msgstr ""

#. Occurrence 6_9:2104:8532: scene=6_9
#: 6_9:2104
msgctxt "text_id=8532 | speaker=unknown"
msgid "　この小鳥さえそんな鳴き声をあげなければ、有珠も同じ意見だっただろう。"
msgstr ""

#. Occurrence 6_9:2131:8533: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0015; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2131
msgctxt "text_id=8533 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 6_9:2137:8534: scene=6_9
#: 6_9:2137
msgctxt "text_id=8534 | speaker=unknown"
msgid "　少女はなんとなしに、先ほどの会話を思い出した。"
msgstr ""

#. Occurrence 6_9:2204:8535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0016; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2204
msgctxt "text_id=8535 | speaker=alice"
msgid "“これでも一番、無難だと思う？”"
msgstr ""

#. Occurrence 6_9:2210:8536: scene=6_9
#: 6_9:2210
msgctxt "text_id=8536 | speaker=unknown"
msgid "　そう問うた少女に、小瓶の中の少年は肩をすくめながら答えた。"
msgstr ""

#. Occurrence 6_9:2236:8537: scene=6_9
#: 6_9:2236
msgctxt "text_id=8537 | speaker=unknown"
msgid "　自分にとっては町も<洋|こ><館|こ>も変わらない、と。"
msgstr ""

#. Occurrence 6_9:2242:8538: scene=6_9
#: 6_9:2242
msgctxt "text_id=8538 | speaker=unknown"
msgid "　なんでも、田舎から出てきたばかりの彼にすれば、あらゆるものが“見たこともないもの”なのだそうだ。"
msgstr ""

#. Occurrence 6_9:2263:8539: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0007; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2263
msgctxt "text_id=8539 | speaker=soujuurou"
msgid "『自慢できるコトじゃないが、まだ書き物さえ満足にできないし、都会のルールは複雑すぎて、何が正しいのかさえ区別がつかない』"
msgstr ""

#. Occurrence 6_9:2269:8540: scene=6_9
#: 6_9:2269
msgctxt "text_id=8540 | speaker=unknown"
msgid "　……あれは恥ずかしさより、<憤|いきどお>りに満ちた声だった。"
msgstr ""

#. Occurrence 6_9:2274:8541: scene=6_9
#: 6_9:2274
msgctxt "text_id=8541 | speaker=unknown"
msgid "　彼が何に対して怒っているのか、有珠には読み取れない。"
msgstr ""

#. Occurrence 6_9:2279:8542: scene=6_9
#: 6_9:2279
msgctxt "text_id=8542 | speaker=unknown"
msgid "　ただ、"
msgstr ""

#. Occurrence 6_9:2347:8543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0008; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2347
msgctxt "text_id=8543 | speaker=soujuurou"
msgid "『だから、どこにいても危ない事に変わりはないんだ。"
msgstr ""

#. Occurrence 6_9:2353:8544: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0009; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2353
msgctxt "text_id=8544 | speaker=soujuurou"
msgid "　極端な話、道を歩くだけでも、人と話すだけでも不安になる。俺は、どこでだろうと上手くやっていける保証はないんだよ。"
msgstr ""

#. Occurrence 6_9:2359:8545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0010; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2359
msgctxt "text_id=8545 | speaker=soujuurou"
msgid "　けど、ここにはそんなヤツに気を遣ってくれる人がいる。気遣ってくれる理由は物騒なものっぽいけど、それは本当に、贅沢なコトだと思うんだ』"
msgstr ""

#. Occurrence 6_9:2416:8546: scene=6_9
#: 6_9:2416
msgctxt "text_id=8546 | speaker=unknown"
msgid "　……少女の瞳がわずかに曇る。"
msgstr ""

#. Occurrence 6_9:2421:8547: scene=6_9
#: 6_9:2421
msgctxt "text_id=8547 | speaker=unknown"
msgid "　静かにこぼれたあの言葉は、無視できるものではなかった。"
msgstr ""

#. Occurrence 6_9:2426:8548: scene=6_9
#: 6_9:2426
msgctxt "text_id=8548 | speaker=unknown"
msgid "　だって、きちんと筋が通っている。"
msgstr ""

#. Occurrence 6_9:2431:8549: scene=6_9
#: 6_9:2431
msgctxt "text_id=8549 | speaker=unknown"
msgid "　彼にとって都会はどこであろうと危険なら、この洋館ですら“何も”変わらないのだ。"
msgstr ""

#. Occurrence 6_9:2451:8550: scene=6_9
#: 6_9:2451
msgctxt "text_id=8550 | speaker=unknown"
msgid "　本当に、この洋館を恐れるだけの理由がない。"
msgstr ""

#. Occurrence 6_9:2456:8551: scene=6_9
#: 6_9:2456
msgctxt "text_id=8551 | speaker=unknown"
msgid "　外との違いがあるとしたら、それは味方になってくれる誰かがいるかいないかという点だけ。"
msgstr ""

#. Occurrence 6_9:2476:8552: scene=6_9
#: 6_9:2476
msgctxt "text_id=8552 | speaker=unknown"
msgid "　その説でいけば、彼は何ひとつ嘘を言っていない。"
msgstr ""

#. Occurrence 6_9:2483:8553: scene=6_9
#: 6_9:2483
msgctxt "text_id=8553 | speaker=unknown"
msgid "　久遠寺有珠へのご機嫌とりでもなく、"
msgstr ""

msgctxt "text_id=8554 | speaker=unknown"
msgid "　蒼崎青子に頼ろうとしたのでもなく。"
msgstr ""

#. Occurrence 6_9:2491:8555: scene=6_9
#: 6_9:2491
msgctxt "text_id=8555 | speaker=unknown"
msgid "　心から、『ここがいい』と告げたのだ。"
msgstr ""

#. Occurrence 6_9:2540:8556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0017; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2540
msgctxt "text_id=8556 | speaker=alice"
msgid "「……いま、鏡に迷いこまれるのは迷惑ね。"
msgstr ""

#. Occurrence 6_9:2546:8557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0018; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2546
msgctxt "text_id=8557 | speaker=alice"
msgid "　鏡の機能は侵入者の探索に専念させたいし、彼が迷いこみそうになったら止めてあげて」"
msgstr ""

#. Occurrence 6_9:2558:8558: scene=6_9
#: 6_9:2558
msgctxt "text_id=8558 | speaker=unknown"
msgid "　予想外の言葉に小鳥の羽が震える。"
msgstr ""

#. Occurrence 6_9:2599:8559: scene=6_9
#: 6_9:2599
msgctxt "text_id=8559 | speaker=unknown"
msgid "　少女は鏡から視線を逸らして歩きだした。"
msgstr ""

#. Occurrence 6_9:2646:8560: scene=6_9
#: 6_9:2646
msgctxt "text_id=8560 | speaker=unknown"
msgid "　抗議の<鳴|こえ>をあげる小鳥。"
msgstr ""

#. Occurrence 6_9:2652:8561: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0019; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2652
msgctxt "text_id=8561 | speaker=alice"
msgid "「貴方の仕事よロビン。それぐらいの役には立って」"
msgstr ""

#. Occurrence 6_9:2659:8562: scene=6_9
#: 6_9:2659
msgctxt "text_id=8562 | speaker=unknown"
msgid "　それに冷たい言葉を返して、少女は西館に消えていった。"
msgstr ""

#. Occurrence 6_9:2723:8563: scene=6_9
#: 6_9:2723
msgctxt "text_id=8563 | speaker=unknown"
msgid "　後に残されたのは月の明かりと、"
msgstr ""

#. Occurrence 6_9:2743:8564: scene=6_9
#: 6_9:2743
msgctxt "text_id=8564 | speaker=unknown"
msgid "　かつてない変化の予兆に激震する、青い小鳥だけだった。"
msgstr ""

#. Occurrence 7_1:78:8565: scene=7_1
#: 7_1:78
msgctxt "text_id=8565 | speaker=unknown"
msgid "　　　　　　むかし、うつくしい鳥を見た。"
msgstr ""

#. Occurrence 7_1:98:8566: scene=7_1
#: 7_1:98
msgctxt "text_id=8566 | speaker=unknown"
msgid "　はるかな青い空を、ぐるぐると、回るように飛んでいる。"
msgstr ""

#. Occurrence 7_1:166:8567: scene=7_1
#: 7_1:166
msgctxt "text_id=8567 | speaker=unknown"
msgid "　もう鳥たちの時代も終わって、"
msgstr ""

#. Occurrence 7_1:171:8568: scene=7_1
#: 7_1:171
msgctxt "text_id=8568 | speaker=unknown"
msgid "　とっくに人間の時代になっているのに。"
msgstr ""

#. Occurrence 7_1:177:8569: scene=7_1
#: 7_1:177
msgctxt "text_id=8569 | speaker=unknown"
msgid "　あの鳥は地上で増え続けるわたしたちのことも、"
msgstr ""

#. Occurrence 7_1:182:8570: scene=7_1
#: 7_1:182
msgctxt "text_id=8570 | speaker=unknown"
msgid "　より高さを増していくわたしたちの家にも、"
msgstr ""

#. Occurrence 7_1:187:8571: scene=7_1
#: 7_1:187
msgctxt "text_id=8571 | speaker=unknown"
msgid "　工場の煙突から<煤|すす>をまき散らすわたしたちの文明にも、"
msgstr ""

#. Occurrence 7_1:192:8572: scene=7_1
#: 7_1:192
msgctxt "text_id=8572 | speaker=unknown"
msgid "　まるで関心がないようだった。"
msgstr ""

#. Occurrence 7_1:252:8573: scene=7_1
#: 7_1:252
msgctxt "text_id=8573 | speaker=unknown"
msgid "　いつまでも、いつまでも。"
msgstr ""

#. Occurrence 7_1:258:8574: scene=7_1
#: 7_1:258
msgctxt "text_id=8574 | speaker=unknown"
msgid "　大空はもう誰のものでもないのに。"
msgstr ""

#. Occurrence 7_1:263:8575: scene=7_1
#: 7_1:263
msgctxt "text_id=8575 | speaker=unknown"
msgid "　鳥は<気高|けだか>く。"
msgstr ""

#. Occurrence 7_1:268:8576: scene=7_1
#: 7_1:268
msgctxt "text_id=8576 | speaker=unknown"
msgid "　古い野生の空のまま、力強く羽ばたいていた。"
msgstr ""

#. Occurrence 7_1:326:8577: scene=7_1
#: 7_1:326
msgctxt "text_id=8577 | speaker=unknown"
msgid "　……けれど、鉄の音は響いて。"
msgstr ""

#. Occurrence 7_1:331:8578: scene=7_1
#: 7_1:331
msgctxt "text_id=8578 | speaker=unknown"
msgid "　羽は撃たれて、シンメトリは失われ。"
msgstr ""

#. Occurrence 7_1:336:8579: scene=7_1
#: 7_1:336
msgctxt "text_id=8579 | speaker=unknown"
msgid "　地に落ちた姿はずるずると無惨に映り。"
msgstr ""

#. Occurrence 7_1:389:8580: scene=7_1
#: 7_1:389
msgctxt "text_id=8580 | speaker=unknown"
msgid "　ああ―――それでも彼は、最後まで鳥として羽ばたいて。"
msgstr ""

#. Occurrence 7_1:395:8581: scene=7_1
#: 7_1:395
msgctxt "text_id=8581 | speaker=unknown"
msgid "　わずかに風をきって、瞳を<北|ソラ>に向けたまま、乾いた地面に墜落した。"
msgstr ""

#. Occurrence 7_1:435:8582: scene=7_1
#: 7_1:435
msgctxt "text_id=8582 | speaker=unknown"
msgid "　……そんな光景を、今になって夢に見た。"
msgstr ""

#. Occurrence 7_1:440:8583: scene=7_1
#: 7_1:440
msgctxt "text_id=8583 | speaker=unknown"
msgid "　あんなにも心に残ったのに、どうしてか、よく覚えていない。"
msgstr ""

#. Occurrence 7_1:465:8584: scene=7_1
#: 7_1:465
msgctxt "text_id=8584 | speaker=unknown"
msgid "　あの鳥は―――どんなカタチをしていただろう？"
msgstr ""

#. Occurrence 7_1:528:8585: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0000; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:528
msgctxt "text_id=8585 | speaker=yamashiro"
msgid "「はい、今日の授業はここまで。"
msgstr ""

#. Occurrence 7_1:550:8586: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0001; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:550
msgctxt "text_id=8586 | speaker=yamashiro"
msgid "　試験範囲の総まとめなんかやっちゃいましたけど、これ、うちのクラスだけですから。よそのクラスには内密にお願いしますね。担任特権と思ってください。"
msgstr ""

#. Occurrence 7_1:558:8587: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0002; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:558
msgctxt "text_id=8587 | speaker=yamashiro"
msgid "　ほら、現国の平均点ぐらいは学年一番にしておくと、皆さんも鼻が高いと思いまして」"
msgstr ""

#. Occurrence 7_1:583:8588: scene=7_1
#: 7_1:583
msgctxt "text_id=8588 | speaker=unknown"
msgid "　ははは、と穏和な笑顔で語りかける山城教諭。"
msgstr ""

#. Occurrence 7_1:588:8589: scene=7_1
#: 7_1:588
msgctxt "text_id=8589 | speaker=unknown"
msgid "　２－Ｃの担任らしい、心温まる気遣いに教室中が和むのであった。"
msgstr ""

#. Occurrence 7_1:610:8590: voice_id=D90_7_1_0000; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:610
msgctxt "text_id=8590 | speaker=unknown"
msgid "「せんせい、口元に本音出てるー。鼻を高くしたいのはあたしたちじゃないですよねー」"
msgstr ""

#. Occurrence 7_1:621:8591: voice_id=E20_7_1_9000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:621
msgctxt "text_id=8591 | speaker=unknown"
msgid "「鼻っていうか面子ですよねー。センセ、里中先生に嫌味言われてばっかりだしー」"
msgstr ""

#. Occurrence 7_1:627:8592: voice_id=E30_7_1_0000; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:627
msgctxt "text_id=8592 | speaker=unknown"
msgid "「つーかハッキリ言えばいいんすよ、オマエらあたま悪すぎだってー。いやあまあ、うちのクラス見事なまでに体育会系ばっかりだけどさー！」"
msgstr ""

#. Occurrence 7_1:661:8593: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0003; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:661
msgctxt "text_id=8593 | speaker=yamashiro"
msgid "「いえいえ。テストの点数だけが学生生活ではありませんから、僕から言うべきコトは何も。"
msgstr ""

#. Occurrence 7_1:667:8594: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0004; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:667
msgctxt "text_id=8594 | speaker=yamashiro"
msgid "　先生方もそこまで目くじらたててるワケじゃないので、別にクラス全員が赤点でも僕の人生には何ら関わりはないんですけどねー。"
msgstr ""

#. Occurrence 7_1:673:8595: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0005; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:673
msgctxt "text_id=8595 | speaker=yamashiro"
msgid "　しかし一方ではひとり、厄介な御仁がおりまして」"
msgstr ""

#. Occurrence 7_1:703:8596: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0006; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:703
msgctxt "text_id=8596 | speaker=yamashiro"
msgid "「皆さんが選んだ全校生徒代表の方なんですが、これが恐ろしいのなんの。"
msgstr ""

#. Occurrence 7_1:709:8597: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0007; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:709
msgctxt "text_id=8597 | speaker=yamashiro"
msgid "“テストの点数が低いのは生徒ではなく教育する側が無能だからです。教育委員会への報告準備はいつでも出来ていますので”と日夜<脅|おど>してくるんですよ。"
msgstr ""

#. Occurrence 7_1:720:8598: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0008; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:720
msgctxt "text_id=8598 | speaker=yamashiro"
msgid "　それでも生徒たちが直らないようなら、その時は直接私が監督します、とか。生徒としてどうなんですかね、アレ」"
msgstr ""

#. Occurrence 7_1:758:8599: voice_id=D80_7_1_0000; voice_prefix=D80; voice_category=0; scene=7_1
#: 7_1:758
msgctxt "text_id=8599 | speaker=unknown"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_1:764:8600: scene=7_1
#: 7_1:764
msgctxt "text_id=8600 | speaker=unknown"
msgid "　<和気藹々|わきあいあい>としていた空気が、一瞬にして氷点下まで落ちこんでいく。"
msgstr ""

#. Occurrence 7_1:770:8601: scene=7_1
#: 7_1:770
msgctxt "text_id=8601 | speaker=unknown"
msgid "　２－Ｃ組の生徒たちも、誰が本当の敵なのかなんとなく悟ったようだ。"
msgstr ""

#. Occurrence 7_1:800:8602: voice_id=E20_7_1_9001; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:800
msgctxt "text_id=8602 | speaker=unknown"
msgid "「あー……そっか、山城センセ生徒会の顧問だったっけ……南無南無」"
msgstr ""

#. Occurrence 7_1:806:8603: voice_id=E30_7_1_0001; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:806
msgctxt "text_id=8603 | speaker=unknown"
msgid "「さすがは応援団を立ち直らせた女傑。教師一人退職に追いこむなど造作もねぇ……」"
msgstr ""

#. Occurrence 7_1:846:8604: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8604 | speaker=kinomi"
msgid "「やっぱりなあ。会長、ぜったい歳サバ読んでるって。"
msgstr ""

#. Occurrence 7_1:846:8605: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8605 | speaker=kinomi"
msgid "　あの迫力、同年代と思えねーし！"
msgstr ""

#. Occurrence 7_1:854:8606: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0001; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:854
msgctxt "text_id=8606 | speaker=kinomi"
msgid "　"
msgstr ""

msgctxt "text_id=8607 | speaker=unknown"
msgid "ほら、うちの女子と比べると特に。こう、おっぱい的に」"
msgstr ""

#. Occurrence 7_1:880:8608: voice_id=D90_7_1_0002; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:880
msgctxt "text_id=8608 | speaker=unknown"
msgid "「せんせー、木乃美だけでもＡ組に引き取ってもらえませんかー。そりゃ男子はみんなサルですけど、コイツだけレベルの違うサルですよ絶対！」"
msgstr ""

#. Occurrence 7_1:901:8609: voice_id=E30_7_1_0002; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:901
msgctxt "text_id=8609 | speaker=unknown"
msgid "「あれ。でも女史、Ａ組だけどあんまり成績よくねえよな？　中の上ぐらいじゃなかったっけ？」"
msgstr ""

#. Occurrence 7_1:907:8610: voice_id=E20_7_1_0000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:907
msgctxt "text_id=8610 | speaker=unknown"
msgid "「そうだけど、別にいいんじゃない？　塾もいってないし、生徒会しきって、たまにバイトまでしてるんだから。あれで学年トップだったら逆に気持ち悪すぎ」"
msgstr ""

#. Occurrence 7_1:913:8611: voice_id=E40_7_1_0000; voice_prefix=E40; voice_category=0; scene=7_1
#: 7_1:913
msgctxt "text_id=8611 | speaker=unknown"
msgid "「だよなー。首位は副会長に任せとけばいいんだよー」"
msgstr ""

#. Occurrence 7_1:943:8612: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0009; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:943
msgctxt "text_id=8612 | speaker=yamashiro"
msgid "「はっはっは。まあまあ皆さん、うわさ話はそのあたりで。地獄耳という言葉もありますから。"
msgstr ""

#. Occurrence 7_1:949:8613: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0010; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:949
msgctxt "text_id=8613 | speaker=yamashiro"
msgid "　じゃ、それなりに復習をよろしく。あんまり点数が悪いと冬休みそのものがなくなりますからねぇ。"
msgstr ""

#. Occurrence 7_1:960:8614: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0011; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:960
msgctxt "text_id=8614 | speaker=yamashiro"
msgid "　あ、それと静希君、ちょっといいですか？」"
msgstr ""

#. Occurrence 7_1:999:8615: scene=7_1
#: 7_1:999
msgctxt "text_id=8615 | speaker=unknown"
msgid "　山城教諭は教材をまとめると、草十郎に手招きをしながら廊下に出て行った。"
msgstr ""

#. Occurrence 7_1:1048:8616: scene=7_1
#: 7_1:1048
msgctxt "text_id=8616 | speaker=unknown"
msgid "　休み時間だというのに、廊下に生徒の姿は見られない。"
msgstr ""

#. Occurrence 7_1:1053:8617: scene=7_1
#: 7_1:1053
msgctxt "text_id=8617 | speaker=unknown"
msgid "　生徒たちの騒ぎ声は聞こえるものの、廊下はひっそりと落ち着いている。"
msgstr ""

#. Occurrence 7_1:1058:8618: scene=7_1
#: 7_1:1058
msgctxt "text_id=8618 | speaker=unknown"
msgid "　窓のない廊下は閉塞感があるためだろう。"
msgstr ""

#. Occurrence 7_1:1063:8619: scene=7_1
#: 7_1:1063
msgctxt "text_id=8619 | speaker=unknown"
msgid "　生徒たちにとって休み時間の憩いの場は教室内か、そのベランダになっていた。"
msgstr ""

#. Occurrence 7_1:1084:8620: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0000; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1084
msgctxt "text_id=8620 | speaker=soujuurou"
msgid "「なんですか、山城先生？」"
msgstr ""

#. Occurrence 7_1:1107:8621: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0012; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1107
msgctxt "text_id=8621 | speaker=yamashiro"
msgid "「いえ、そう大した用事じゃないんですけどね。"
msgstr ""

#. Occurrence 7_1:1113:8622: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0013; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1113
msgctxt "text_id=8622 | speaker=yamashiro"
msgid "　試験前にこんな話をするのもデリカシーがないんですが、気になったので。どうだろう、学校には慣れたかな？」"
msgstr ""

#. Occurrence 7_1:1138:8623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0001; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1138
msgctxt "text_id=8623 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_1:1172:8624: scene=7_1
#: 7_1:1172
msgctxt "text_id=8624 | speaker=unknown"
msgid "　担任の気遣いに驚きつつも、なんとなく嬉しくなる草十郎だった。"
msgstr ""

#. Occurrence 7_1:1177:8625: scene=7_1
#: 7_1:1177
msgctxt "text_id=8625 | speaker=unknown"
msgid "　さもありなん。"
msgstr ""

#. Occurrence 7_1:1183:8626: scene=7_1
#: 7_1:1183
msgctxt "text_id=8626 | speaker=unknown"
msgid "ここのところ不条理な人間に振り回されてばかりだったので、<些細|ささい>な<心配|こころくば>りでもぐっっと励まされるのだ。"
msgstr ""

#. Occurrence 7_1:1221:8627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0002; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1221
msgctxt "text_id=8627 | speaker=soujuurou"
msgid "「はい。学校の造りや決まりなら、自分なりに分かってきました。友達も増えましたし」"
msgstr ""

#. Occurrence 7_1:1227:8628: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0014; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1227
msgctxt "text_id=8628 | speaker=yamashiro"
msgid "「そっか、それは良かった。うちのクラスは口の悪い面々だけど、その分気を遣わなくていいからね。静希君と相性がよくて助かったよ」"
msgstr ""

#. Occurrence 7_1:1262:8629: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0003; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1262
msgctxt "text_id=8629 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_1:1267:8630: scene=7_1
#: 7_1:1267
msgctxt "text_id=8630 | speaker=unknown"
msgid "　おお、と草十郎は目を輝かせる。"
msgstr ""

#. Occurrence 7_1:1272:8631: scene=7_1
#: 7_1:1272
msgctxt "text_id=8631 | speaker=unknown"
msgid "　蒼崎青子に『憎むべき<昼行灯|ひるあんどん>、教師にあるまじきのれんに腕押し野郎』と酷評される山城教諭だが、彼は彼なりに気配りの人なのだった。"
msgstr ""

#. Occurrence 7_1:1310:8632: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0015; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1310
msgctxt "text_id=8632 | speaker=yamashiro"
msgid "「アルバイトもほどほどにね。試験前だって言えばたいていのところは休ませてくれるから、あまり無理はしないように。"
msgstr ""

#. Occurrence 7_1:1316:8633: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0016; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1316
msgctxt "text_id=8633 | speaker=yamashiro"
msgid "　また、試験で困ったコトがあったら周りに相談しなさい。ひとりで悩んでいても時間の無駄だよ。ほら、学校っていうのは話し相手にだけは困らないから」"
msgstr ""

#. Occurrence 7_1:1355:8634: scene=7_1
#: 7_1:1355
msgctxt "text_id=8634 | speaker=unknown"
msgid "　それじゃあ、と手を挙げて山城教諭は去っていった。"
msgstr ""

#. Occurrence 7_1:1367:8635: scene=7_1
#: 7_1:1367
msgctxt "text_id=8635 | speaker=unknown"
msgid "　純朴な少年は昼行灯な忠告をまっすぐに受けとめ、なるほど、と頷きながら教室に引き返す。"
msgstr ""

#. Occurrence 7_1:1427:8636: scene=7_1
#: 7_1:1427
msgctxt "text_id=8636 | speaker=unknown"
msgid "　そうして、"
msgstr ""

#. Occurrence 7_1:1444:8637: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0002; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1444
msgctxt "text_id=8637 | speaker=kinomi"
msgid "「ちょっ、女のコトで相談だあ！？」"
msgstr ""

#. Occurrence 7_1:1451:8638: scene=7_1
#: 7_1:1451
msgctxt "text_id=8638 | speaker=unknown"
msgid "　一分も待たず、山城教諭から受けたアドバイスを実行した。"
msgstr ""

#. Occurrence 7_1:1485:8639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0004; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1485
msgctxt "text_id=8639 | speaker=soujuurou"
msgid "「そうらしい。難問にぶち当たっているんだ。"
msgstr ""

#. Occurrence 7_1:1492:8640: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0005; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1492
msgctxt "text_id=8640 | speaker=soujuurou"
msgid "深く考えてみて気付いたんだが、どうも、自分は発想が貧困らしい」"
msgstr ""

#. Occurrence 7_1:1503:8641: scene=7_1
#: 7_1:1503
msgctxt "text_id=8641 | speaker=unknown"
msgid "　いまじねーしょんがよわいのだ、と無念そうに目を伏せる草十郎。"
msgstr ""

#. Occurrence 7_1:1524:8642: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0003; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1524
msgctxt "text_id=8642 | speaker=kinomi"
msgid "「いや、豊かだと思ってたコトがビックリなんだけど……まあいい、こっちこい」"
msgstr ""

#. Occurrence 7_1:1580:8643: scene=7_1
#: 7_1:1580
msgctxt "text_id=8643 | speaker=unknown"
msgid "　木乃美は呆れながらも草十郎の肩をつかみ、教室の<端|はし>に移動した。"
msgstr ""

#. Occurrence 7_1:1585:8644: scene=7_1
#: 7_1:1585
msgctxt "text_id=8644 | speaker=unknown"
msgid "　真顔で「女の子は難しいと訊く」と切り出された時は吹きそうになった木乃美だが、考えてみると草十郎が自分から相談ごとにくるのは初めてだ。"
msgstr ""

#. Occurrence 7_1:1636:8645: scene=7_1
#: 7_1:1636
msgctxt "text_id=8645 | speaker=unknown"
msgid "　バイト先でもたいていのものは辛抱強くこなしてしまうこの男が悩んでいるのだ。"
msgstr ""

#. Occurrence 7_1:1641:8646: scene=7_1
#: 7_1:1641
msgctxt "text_id=8646 | speaker=unknown"
msgid "　これは、よっぽどのコトとかからねばなるまい。"
msgstr ""

#. Occurrence 7_1:1667:8647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0004; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1667
msgctxt "text_id=8647 | speaker=kinomi"
msgid "「で。なんかやっちまったのか、ｙｏｕ」"
msgstr ""

#. Occurrence 7_1:1678:8648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0006; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1678
msgctxt "text_id=8648 | speaker=soujuurou"
msgid "「……。これから、やるのかもしれない」"
msgstr ""

#. Occurrence 7_1:1723:8649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0007; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1723
msgctxt "text_id=8649 | speaker=soujuurou"
msgid "「木乃美。たとえばの話、まっどべあにハリセンボンみたいな女の子が入ってきたとする。"
msgstr ""

#. Occurrence 7_1:1730:8650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0008; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1730
msgctxt "text_id=8650 | speaker=soujuurou"
msgid "その子は俺が嫌いで、まっどべあから出ていってほしいようなんだけど、俺はまっどべあを辞めるワケにはいかない」"
msgstr ""

#. Occurrence 7_1:1755:8651: scene=7_1
#: 7_1:1755
msgctxt "text_id=8651 | speaker=unknown"
msgid "　なによりお金のために、と草十郎は熱弁する。"
msgstr ""

#. Occurrence 7_1:1770:8652: scene=7_1
#: 7_1:1770
msgctxt "text_id=8652 | speaker=unknown"
msgid "　とりあえず頷くしかない木乃美だった。"
msgstr ""

#. Occurrence 7_1:1810:8653: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0005; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1810
msgctxt "text_id=8653 | speaker=kinomi"
msgid "「……つまり、その女を追い出したいと？」"
msgstr ""

#. Occurrence 7_1:1834:8654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0009; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1834
msgctxt "text_id=8654 | speaker=soujuurou"
msgid "「逆だ。なんとか認めてもらいたい。"
msgstr ""

#. Occurrence 7_1:1840:8655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0010; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1840
msgctxt "text_id=8655 | speaker=soujuurou"
msgid "　隠していたけど、俺はその女の子が嫌いというワケじゃなくて……」"
msgstr ""

#. Occurrence 7_1:1865:8656: scene=7_1
#: 7_1:1865
msgctxt "text_id=8656 | speaker=unknown"
msgid "　草十郎はむう、と眉間に<皺|しわ>を寄せる。"
msgstr ""

#. Occurrence 7_1:1870:8657: scene=7_1
#: 7_1:1870
msgctxt "text_id=8657 | speaker=unknown"
msgid "　この男らしからぬ歯切れの悪さに、木乃美はははあんと事情を察した。"
msgstr ""

#. Occurrence 7_1:1893:8658: scene=7_1
#: 7_1:1893
msgctxt "text_id=8658 | speaker=unknown"
msgid "　こと女性関係においてのみ、木乃美芳助の巡りの良さは三倍以上になるのである。"
msgstr ""

#. Occurrence 7_1:1920:8659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0006; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1920
msgctxt "text_id=8659 | speaker=kinomi"
msgid "「―――ははあん。はっはっーん。"
msgstr ""

#. Occurrence 7_1:1926:8660: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0007; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1926
msgctxt "text_id=8660 | speaker=kinomi"
msgid "　なんだよ、ようはナンパかよ。むしろ仲良くなりたいってワケ？」"
msgstr ""

#. Occurrence 7_1:1958:8661: scene=7_1
#: 7_1:1958
msgctxt "text_id=8661 | speaker=unknown"
msgid "　木乃美の指摘に、む？　と思案する草十郎。"
msgstr ""

#. Occurrence 7_1:1968:8662: scene=7_1
#: 7_1:1968
msgctxt "text_id=8662 | speaker=unknown"
msgid "　彼本人、それがどういうコトなのかよく分からないまま、こくんと頷いた。"
msgstr ""

#. Occurrence 7_1:1995:8663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0011; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1995
msgctxt "text_id=8663 | speaker=soujuurou"
msgid "「けど、どうすればいいのか分からない。そもそもどうやって、同い年の女の子と仲良く話ができるんだ？」"
msgstr ""

#. Occurrence 7_1:2006:8664: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0008; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2006
msgctxt "text_id=8664 | speaker=kinomi"
msgid "「クラスの女どもとは話してんじゃん。あれでいいんだっつの、オレは羨ましいっつの。"
msgstr ""

#. Occurrence 7_1:2017:8665: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0009; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2017
msgctxt "text_id=8665 | speaker=kinomi"
msgid "　持ち前の天然系で押してけばいいべ。"
msgstr ""

#. Occurrence 7_1:2023:8666: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0010; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2023
msgctxt "text_id=8666 | speaker=kinomi"
msgid "　山育ちってのは稀少なアイデンティティだと思うぜ？　珍しいものは<活|い>かさないとさー」"
msgstr ""

#. Occurrence 7_1:2050:8667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0012; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2050
msgctxt "text_id=8667 | speaker=soujuurou"
msgid "「そうかな。珍しいというのは、あんまりいいコトじゃない気がする。"
msgstr ""

#. Occurrence 7_1:2080:8668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0013; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2080
msgctxt "text_id=8668 | speaker=soujuurou"
msgid "　だいたい、そもそも嫌われている場合はどうすればいいんだ？　クラスのみんなは親切だけど、相手はハリセンボンだ。いや、このさいハリネズミでもいい」"
msgstr ""

#. Occurrence 7_1:2104:8669: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0011; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2104
msgctxt "text_id=8669 | speaker=kinomi"
msgid "「そういう場合はめげなきゃいいんだよ。相手が折れるのを待つって寸法だな。トゲだけに」"
msgstr ""

#. Occurrence 7_1:2130:8670: scene=7_1
#: 7_1:2130
msgctxt "text_id=8670 | speaker=unknown"
msgid "　むむう、と草十郎の皺はますます深くなる。"
msgstr ""

#. Occurrence 7_1:2154:8671: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0014; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2154
msgctxt "text_id=8671 | speaker=soujuurou"
msgid "「このたとえ話は、ダメだ」"
msgstr ""

#. Occurrence 7_1:2159:8672: scene=7_1
#: 7_1:2159
msgctxt "text_id=8672 | speaker=unknown"
msgid "　などと右往左往するものの、他にうまい喩えが見つからない模様。"
msgstr ""

#. Occurrence 7_1:2207:8673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0012; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2207
msgctxt "text_id=8673 | speaker=kinomi"
msgid "「ばっか。女なんてのは機嫌を取ってればいいんだよ。"
msgstr ""

#. Occurrence 7_1:2213:8674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0013; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2213
msgctxt "text_id=8674 | speaker=kinomi"
msgid "　まずは女の趣味とか、大事にしてるもんとか聞いて、そこをフォローすればいい。自分の都合より相手の都合だ。まずは<外堀|そとぼり>から攻めろってコトだな」"
msgstr ""

#. Occurrence 7_1:2224:8675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0015; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2224
msgctxt "text_id=8675 | speaker=soujuurou"
msgid "「外堀……外回りか」"
msgstr ""

#. Occurrence 7_1:2251:8676: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0014; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2251
msgctxt "text_id=8676 | speaker=kinomi"
msgid "「もち。その後は、ま、結局はこれが一番効果的なんだけどな。袖の下ってヤツ？　プレゼントで釣れ。"
msgstr ""

#. Occurrence 7_1:2257:8677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0015; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2257
msgctxt "text_id=8677 | speaker=kinomi"
msgid "　そん時の<需要|じゅよう>と<供給|きょうきゅう>さえ合えば、嫌われてても受け取ってもらえる。受け取らせちまえば、あとはそれが義理になるってもんだ」"
msgstr ""

#. Occurrence 7_1:2272:8678: scene=7_1
#: 7_1:2272
msgctxt "text_id=8678 | speaker=unknown"
msgid "　いまのところオレはこれで連戦連敗さ！　と力強く語る友人に、何か間違った頼もしさを覚える草十郎だった。"
msgstr ""

#. Occurrence 7_1:2327:8679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0016; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2327
msgctxt "text_id=8679 | speaker=soujuurou"
msgid "「―――けど問題がある木乃美。"
msgstr ""

#. Occurrence 7_1:2333:8680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0017; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2333
msgctxt "text_id=8680 | speaker=soujuurou"
msgid "　たしかにごはんとか、そういうのをおごってもらうと嬉しい。けど」"
msgstr ""

#. Occurrence 7_1:2360:8681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0016; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2360
msgctxt "text_id=8681 | speaker=kinomi"
msgid "「そんな<余裕|かね>はないってんだろ。分かってる分かってる。"
msgstr ""

#. Occurrence 7_1:2366:8682: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0017; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2366
msgctxt "text_id=8682 | speaker=kinomi"
msgid "　……ひひひ、仕方ないねぇ。そういう静希君のために、いっちょ割のいいバイトを紹介してやろうじゃねえのよ」"
msgstr ""

#. Occurrence 7_1:2378:8683: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0018; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2378
msgctxt "text_id=8683 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 7_1:2430:8684: scene=7_1
#: 7_1:2430
msgctxt "text_id=8684 | speaker=unknown"
msgid "　教室の<端|はし>から、さらに<隅|すみ>へ。"
msgstr ""

#. Occurrence 7_1:2440:8685: scene=7_1
#: 7_1:2440
msgctxt "text_id=8685 | speaker=unknown"
msgid "　木乃美は人気のないロッカーの前まで草十郎を連れこんだ。"
msgstr ""

#. Occurrence 7_1:2445:8686: scene=7_1
#: 7_1:2445
msgctxt "text_id=8686 | speaker=unknown"
msgid "　それが他人には聞かせられない、悪質な勧誘の<類|たぐい>であるコトを草十郎が知るのは、これより何日か後の話である。"
msgstr ""

#. Occurrence 7_1:2496:8687: scene=7_1
#: 7_1:2496
msgctxt "text_id=8687 | speaker=unknown"
msgid "　その夜。"
msgstr ""

#. Occurrence 7_1:2502:8688: scene=7_1
#: 7_1:2502
msgctxt "text_id=8688 | speaker=unknown"
msgid "　洋館の夕食は、一面のパン尽くしだった。"
msgstr ""

#. Occurrence 7_1:2548:8689: scene=7_1
#: 7_1:2548
msgctxt "text_id=8689 | speaker=unknown"
msgid "　テーブルの中央にはカットされたソフトブレッドが積まれ、"
msgstr ""

#. Occurrence 7_1:2554:8690: scene=7_1
#: 7_1:2554
msgctxt "text_id=8690 | speaker=unknown"
msgid "　周りには色とりどりのジャムが置かれ、"
msgstr ""

#. Occurrence 7_1:2559:8691: scene=7_1
#: 7_1:2559
msgctxt "text_id=8691 | speaker=unknown"
msgid "　ボウルにはレタスを中心にしたサラダ、"
msgstr ""

#. Occurrence 7_1:2564:8692: scene=7_1
#: 7_1:2564
msgctxt "text_id=8692 | speaker=unknown"
msgid "　小皿には太さがマチマチなハムが並んでいた。"
msgstr ""

#. Occurrence 7_1:2604:8693: scene=7_1
#: 7_1:2604
msgctxt "text_id=8693 | speaker=unknown"
msgid "　一般家庭の夕食、その平均をまだ知らない草十郎ではあるが、これがおかしな<夕食|もの>であるコトは感じ取れる。"
msgstr ""

#. Occurrence 7_1:2610:8694: scene=7_1
#: 7_1:2610
msgctxt "text_id=8694 | speaker=unknown"
msgid "　率直に言って、手を抜いているコトこの上ない。"
msgstr ""

#. Occurrence 7_1:2649:8695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0000; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2649
msgctxt "text_id=8695 | speaker=aoko"
msgid "「あ。チョコのペースト切れたままじゃん。"
msgstr ""

#. Occurrence 7_1:2655:8696: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0001; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2655
msgctxt "text_id=8696 | speaker=aoko"
msgid "　有珠、新しいの買っておいてって言わなかった？」"
msgstr ""

#. Occurrence 7_1:2674:8697: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0000; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2674
msgctxt "text_id=8697 | speaker=alice"
msgid "「……今日は一日、部屋に籠もっていたから。"
msgstr ""

#. Occurrence 7_1:2680:8698: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0001; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2680
msgctxt "text_id=8698 | speaker=alice"
msgid "　第一、チョコレイトを食べるのは貴女だけよ。自分のものは自分で調達をするべきね」"
msgstr ""

#. Occurrence 7_1:2718:8699: scene=7_1
#: 7_1:2718
msgctxt "text_id=8699 | speaker=unknown"
msgid "　が、彼女たち的に、この夕食は普通らしい。"
msgstr ""

#. Occurrence 7_1:2724:8700: scene=7_1
#: 7_1:2724
msgctxt "text_id=8700 | speaker=unknown"
msgid "　食事の準備は変則的な当番制で、今夜は久遠寺有珠のターンだった。"
msgstr ""

#. Occurrence 7_1:2729:8701: scene=7_1
#: 7_1:2729
msgctxt "text_id=8701 | speaker=unknown"
msgid "　有珠にとって食事当番とは、平時は手間暇を最小限に抑える作業であり、祝時のみ腕によりをかけて調理する……ものだった。"
msgstr ""

#. Occurrence 7_1:2773:8702: scene=7_1
#: 7_1:2773
msgctxt "text_id=8702 | speaker=unknown"
msgid "　無論、そんな有珠の哲学を草十郎が知るよしもない。"
msgstr ""

#. Occurrence 7_1:2778:8703: scene=7_1
#: 7_1:2778
msgctxt "text_id=8703 | speaker=unknown"
msgid "　草十郎から見ても簡素な食事。"
msgstr ""

#. Occurrence 7_1:2783:8704: scene=7_1
#: 7_1:2783
msgctxt "text_id=8704 | speaker=unknown"
msgid "　加えて、"
msgstr ""

#. Occurrence 7_1:2837:8705: scene=7_1
#: 7_1:2837
msgctxt "text_id=8705 | speaker=unknown"
msgid "　ふたりの間にはこれといった会話はない。"
msgstr ""

#. Occurrence 7_1:2842:8706: scene=7_1
#: 7_1:2842
msgctxt "text_id=8706 | speaker=unknown"
msgid "　食器の音、椅子ずれの音、時計の音だけが、サンルームに流れている。"
msgstr ""

#. Occurrence 7_1:2867:8707: scene=7_1
#: 7_1:2867
msgctxt "text_id=8707 | speaker=unknown"
msgid "　ちなみに草十郎はと言うと、夕食は済ませていたので居間からサンルームの様子を眺めているだけだった。"
msgstr ""

#. Occurrence 7_1:2904:8708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0002; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2904
msgctxt "text_id=8708 | speaker=aoko"
msgid "「草十郎、九時からアルバイトでしょ。行ってらっしゃい。私たちの事は気にしないでいいから」"
msgstr ""

#. Occurrence 7_1:2930:8709: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0019; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2930
msgctxt "text_id=8709 | speaker=soujuurou"
msgid "「ああ。じゃあ行ってくる」"
msgstr ""

#. Occurrence 7_1:2980:8710: scene=7_1
#: 7_1:2980
msgctxt "text_id=8710 | speaker=unknown"
msgid "　青子の声に頷いて、コートを羽織る。"
msgstr ""

#. Occurrence 7_1:2997:8711: scene=7_1
#: 7_1:2997
msgctxt "text_id=8711 | speaker=unknown"
msgid "　草十郎がもう一度サンルームに目をやると、"
msgstr ""

#. Occurrence 7_1:3023:8712: scene=7_1
#: 7_1:3023
msgctxt "text_id=8712 | speaker=unknown"
msgid "　気のせいか、ばったりと有珠と視線が合った。"
msgstr ""

#. Occurrence 7_1:3070:8713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0020; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3070
msgctxt "text_id=8713 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 7_1:3076:8714: scene=7_1
#: 7_1:3076
msgctxt "text_id=8714 | speaker=unknown"
msgid "　今日一日、有珠は草十郎を無視し続けた。"
msgstr ""

#. Occurrence 7_1:3081:8715: scene=7_1
#: 7_1:3081
msgctxt "text_id=8715 | speaker=unknown"
msgid "　視界にさえ入れない、という徹底ぶりである。"
msgstr ""

#. Occurrence 7_1:3086:8716: scene=7_1
#: 7_1:3086
msgctxt "text_id=8716 | speaker=unknown"
msgid "　邪魔者として睨まれているのであれば合点がいくが、先ほどの視線に敵意はなかった。"
msgstr ""

#. Occurrence 7_1:3112:8717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0021; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3112
msgctxt "text_id=8717 | speaker=soujuurou"
msgid "「……居間の様子を見てた、のかな」"
msgstr ""

#. Occurrence 7_1:3190:8718: scene=7_1
#: 7_1:3190
msgctxt "text_id=8718 | speaker=unknown"
msgid "　きょろきょろと居間を見渡して、草十郎はロビーへと向かっていった。"
msgstr ""

#. Occurrence 7_1:3243:8719: scene=7_1
#: 7_1:3243
msgctxt "text_id=8719 | speaker=unknown"
msgid "　草十郎の退出を認めると、有珠は不自然だった視線を戻す。"
msgstr ""

#. Occurrence 7_1:3263:8720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0003; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3263
msgctxt "text_id=8720 | speaker=aoko"
msgid "「―――はあ、めんどくさ」"
msgstr ""

#. Occurrence 7_1:3268:8721: scene=7_1
#: 7_1:3268
msgctxt "text_id=8721 | speaker=unknown"
msgid "　青子からすれば露骨すぎて呆れてしまう。"
msgstr ""

#. Occurrence 7_1:3273:8722: scene=7_1
#: 7_1:3273
msgctxt "text_id=8722 | speaker=unknown"
msgid "　無関心を装っているのがバレバレなのだ。"
msgstr ""

#. Occurrence 7_1:3314:8723: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0002; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3314
msgctxt "text_id=8723 | speaker=alice"
msgid "「……なに。<献立|こんだて>に不満でもあるの、青子」"
msgstr ""

#. Occurrence 7_1:3320:8724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0004; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3320
msgctxt "text_id=8724 | speaker=aoko"
msgid "「もちろんあるけど、いつもの事だし慣れてるわよ。"
msgstr ""

#. Occurrence 7_1:3339:8725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0005; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3339
msgctxt "text_id=8725 | speaker=aoko"
msgid "　私が呆れてるのはアンタの意地の悪さの方。"
msgstr ""

#. Occurrence 7_1:3345:8726: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0006; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3345
msgctxt "text_id=8726 | speaker=aoko"
msgid "　徹底的に無視してるクセに、相手の反応を<窺|うかが>ってるなんて女々しくない？　罠張って待ち受けるようなもんじゃない」"
msgstr ""

#. Occurrence 7_1:3378:8727: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0003; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3378
msgctxt "text_id=8727 | speaker=alice"
msgid "「彼の反応なんて探ってないわ。そもそも興味がないもの。それと、今のは差別発言ね。女々しいという表現は女性軽視にすぎるわ。"
msgstr ""

#. Occurrence 7_1:3385:8728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0004; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3385
msgctxt "text_id=8728 | speaker=alice"
msgid "今の場合なら、貴女は矛盾している、と言ってちょうだい」"
msgstr ""

#. Occurrence 7_1:3407:8729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0007; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3407
msgctxt "text_id=8729 | speaker=aoko"
msgid "「うわ、自覚ありときた」"
msgstr ""

#. Occurrence 7_1:3446:8730: scene=7_1
#: 7_1:3446
msgctxt "text_id=8730 | speaker=unknown"
msgid "　同居人の指摘を聞き流して、有珠は夕食を再開する。"
msgstr ""

#. Occurrence 7_1:3451:8731: scene=7_1
#: 7_1:3451
msgctxt "text_id=8731 | speaker=unknown"
msgid "　青子は呆れ顔のまま、ソフトブレッドをちぎっては食べ、ちぎっては食べるのだった。"
msgstr ""

#. Occurrence 7_1:3488:8732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0008; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3488
msgctxt "text_id=8732 | speaker=aoko"
msgid "「じゃあここからは蒼崎青子としてじゃなく、共犯者としての質問ね。"
msgstr ""

#. Occurrence 7_1:3512:8733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0009; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3512
msgctxt "text_id=8733 | speaker=aoko"
msgid "　有珠的に、彼を見逃していいと思える判断材料はない？"
msgstr ""

#. Occurrence 7_1:3518:8734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0010; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3518
msgctxt "text_id=8734 | speaker=aoko"
msgid "　ありえないけど、実は彼も魔術師でした、なんてオチであったとしても、<洋|こ><館|こ>に住まわせるのは容認できない？」"
msgstr ""

#. Occurrence 7_1:3558:8735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0005; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3558
msgctxt "text_id=8735 | speaker=alice"
msgid "「その理由なら認めるわ。彼を許すのではなく、そんな事に気付かなかったわたしたちへのペナルティとして。"
msgstr ""

#. Occurrence 7_1:3570:8736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0006; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3570
msgctxt "text_id=8736 | speaker=alice"
msgid "　……そうね。今のは絶対にありえない話だけど、それと同じに、絶対の結論もまたないわ。"
msgstr ""

#. Occurrence 7_1:3576:8737: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0007; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3576
msgctxt "text_id=8737 | speaker=alice"
msgid "　彼がここに住む選択を呑む場合すらあるかもしれない。気の迷いは、わたしにだってあるのだし」"
msgstr ""

#. Occurrence 7_1:3613:8738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0011; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3613
msgctxt "text_id=8738 | speaker=aoko"
msgid "「ええそう、そういうコトよ。"
msgstr ""

#. Occurrence 7_1:3619:8739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0012; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3619
msgctxt "text_id=8739 | speaker=aoko"
msgid "　今は私との義理とかプライドで冷静をたもってるアンタだけど、アイツの努力次第で少しは、」"
msgstr ""

#. Occurrence 7_1:3654:8740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0008; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3654
msgctxt "text_id=8740 | speaker=alice"
msgid "「それは諦めて。彼が何をしようと無駄だから。"
msgstr ""

#. Occurrence 7_1:3660:8741: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0009; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3660
msgctxt "text_id=8741 | speaker=alice"
msgid "　貴女も知っていると思うけど―――」"
msgstr ""

#. Occurrence 7_1:3681:8742: scene=7_1
#: 7_1:3681
msgctxt "text_id=8742 | speaker=unknown"
msgid "　そもそも、この少女は他人に気を許す事が出来ない。"
msgstr ""

#. Occurrence 7_1:3686:8743: scene=7_1
#: 7_1:3686
msgctxt "text_id=8743 | speaker=unknown"
msgid "　多くの器物、多くの童話を再現する代償として、魔女は人間を嫌うものなのだ。"
msgstr ""

#. Occurrence 7_1:3725:8744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0013; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3725
msgctxt "text_id=8744 | speaker=aoko"
msgid "「そんなのアンタ個人のトラウマでしょ。自分の意固地さを魔女の血統云々で棚上げするのはそれこそ女々しいわ。"
msgstr ""

#. Occurrence 7_1:3731:8745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0014; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3731
msgctxt "text_id=8745 | speaker=aoko"
msgid "　いいじゃない、嫌いなら嫌いでハッキリしてれば。"
msgstr ""

#. Occurrence 7_1:3743:8746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0015; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3743
msgctxt "text_id=8746 | speaker=aoko"
msgid "　私が気にくわないのはね、アンタのどっちつかずの態度よ有珠」"
msgstr ""

#. Occurrence 7_1:3768:8747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0010; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3768
msgctxt "text_id=8747 | speaker=alice"
msgid "「どっちつかずの態度……？」"
msgstr ""

#. Occurrence 7_1:3804:8748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0016; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3804
msgctxt "text_id=8748 | speaker=aoko"
msgid "「そ。無視するなら徹底して無視してやれって言ってるの。"
msgstr ""

#. Occurrence 7_1:3810:8749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0017; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3810
msgctxt "text_id=8749 | speaker=aoko"
msgid "　ガチガチに守りをかためて、そのクセ城門だけ開けて、獲物が油断して入ってきたら串刺しにする気満々とか、相棒として見てられないわ。"
msgstr ""

#. Occurrence 7_1:3821:8750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0018; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3821
msgctxt "text_id=8750 | speaker=aoko"
msgid "　アイツにできるコトなんて閉ざされた門をあける事ぐらいだっていうのに、その機会さえ無くすのはどうなの？」"
msgstr ""

#. Occurrence 7_1:3868:8751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0011; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3868
msgctxt "text_id=8751 | speaker=alice"
msgid "「……ごめんなさい青子。もう少し簡単に言って。"
msgstr ""

#. Occurrence 7_1:3874:8752: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0012; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3874
msgctxt "text_id=8752 | speaker=alice"
msgid "　その喩えは、ちょっと……」"
msgstr ""

#. Occurrence 7_1:3880:8753: scene=7_1
#: 7_1:3880
msgctxt "text_id=8753 | speaker=unknown"
msgid "　何を比喩しているのか分からない、と言いよどむ有珠。"
msgstr ""

#. Occurrence 7_1:3905:8754: scene=7_1
#: 7_1:3905
msgctxt "text_id=8754 | speaker=unknown"
msgid "　そんな相棒の無自覚さに、青子の苛立ちは一瞬だけ沸点を超えたようだ。"
msgstr ""

#. Occurrence 7_1:3939:8755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0019; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3939
msgctxt "text_id=8755 | speaker=aoko"
msgid "「だから興味ないとか言っておきながらコナかけるなってコト！　あんなにチラチラ盗み見たら、アイツ、ヘンに勘違いしちゃうかもしれないでしょ？"
msgstr ""

#. Occurrence 7_1:3951:8756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_0; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3951
msgctxt "text_id=8756 | speaker=aoko"
msgid "“有珠はああ見えて、本当は自分と仲直りしたがっているに違いない。じゃあさっそく部屋に押しかけてみよう”"
msgstr ""

#. Occurrence 7_1:3963:8757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_1; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3963
msgctxt "text_id=8757 | speaker=aoko"
msgid "とか！」"
msgstr ""

#. Occurrence 7_1:4015:8758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0013; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4015
msgctxt "text_id=8758 | speaker=alice"
msgid "「―――そういうコトに、なるの？」"
msgstr ""

#. Occurrence 7_1:4039:8759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0021; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4039
msgctxt "text_id=8759 | speaker=aoko"
msgid "「なる。少なくとも、私だったらいいかげんイライラして“話があるなら校舎裏まで来い”って決着つけかねないレベル。この<毒婦|どくふ>」"
msgstr ""

#. Occurrence 7_1:4079:8760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0014; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4079
msgctxt "text_id=8760 | speaker=alice"
msgid "「……そうだったのね。気をつけるわ。"
msgstr ""

#. Occurrence 7_1:4085:8761: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0015; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4085
msgctxt "text_id=8761 | speaker=alice"
msgid "　別に、彼と話をする気はないんだし。わたしも、彼を見ていたというより、彼の手足を見ていたのだし」"
msgstr ""

#. Occurrence 7_1:4108:8762: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0022; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4108
msgctxt "text_id=8762 | speaker=aoko"
msgid "「？　手足って、なんで？」"
msgstr ""

#. Occurrence 7_1:4143:8763: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0016; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4143
msgctxt "text_id=8763 | speaker=alice"
msgid "「手足は手足よ。彼個人には思うところはないけど、あの夜の出来事はまだ記憶に新しいから。"
msgstr ""

#. Occurrence 7_1:4155:8764: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0017; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4155
msgctxt "text_id=8764 | speaker=alice"
msgid "それが少しだけ気になって、つい視線で追っていたのね」"
msgstr ""

#. Occurrence 7_1:4177:8765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0023; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4177
msgctxt "text_id=8765 | speaker=aoko"
msgid "「あの夜って、遊園地のこと？　なんかしたっけアイツ？」"
msgstr ""

#. Occurrence 7_1:4218:8766: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0018; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4218
msgctxt "text_id=8766 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 7_1:4241:8767: scene=7_1
#: 7_1:4241
msgctxt "text_id=8767 | speaker=unknown"
msgid "　有珠の表情が見るからに不機嫌になる。"
msgstr ""

#. Occurrence 7_1:4246:8768: scene=7_1
#: 7_1:4246
msgctxt "text_id=8768 | speaker=unknown"
msgid "　遊園地での敗北をいまだ引きずっているらしい。"
msgstr ""

#. Occurrence 7_1:4267:8769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0019; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4267
msgctxt "text_id=8769 | speaker=alice"
msgid "「飛んだでしょう、彼。"
msgstr ""

#. Occurrence 7_1:4273:8770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0020; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4273
msgctxt "text_id=8770 | speaker=alice"
msgid "　レールの上から、私のダンプティに向かって」"
msgstr ""

#. Occurrence 7_1:4285:8771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0024; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4285
msgctxt "text_id=8771 | speaker=aoko"
msgid "「ええ、そんなコト言ってたわね。勢いでつい、一メートルぐらいだから飛んじゃったー、とか」"
msgstr ""

#. Occurrence 7_1:4311:8772: scene=7_1
#: 7_1:4311
msgctxt "text_id=8772 | speaker=unknown"
msgid "　幸運な事に、青子はあの現場を見ていない。"
msgstr ""

#. Occurrence 7_1:4316:8773: scene=7_1
#: 7_1:4316
msgctxt "text_id=8773 | speaker=unknown"
msgid "　草十郎が死のジャンプをこなした理由のひとつが、<自分|あおこ>がかけた暗示によるもの、としか知らないのだ。"
msgstr ""

#. Occurrence 7_1:4383:8774: scene=7_1
#: 7_1:4383
msgctxt "text_id=8774 | speaker=unknown"
msgid "　一方、有珠はあの光景を時計台から目撃していた。"
msgstr ""

#. Occurrence 7_1:4388:8775: scene=7_1
#: 7_1:4388
msgctxt "text_id=8775 | speaker=unknown"
msgid "　本当にわずか一瞬だけだったが、"
msgstr ""

#. Occurrence 7_1:4393:8776: scene=7_1
#: 7_1:4393
msgctxt "text_id=8776 | speaker=unknown"
msgid "　崩れ去るスナークよりも"
msgstr ""

#. Occurrence 7_1:4398:8777: scene=7_1
#: 7_1:4398
msgctxt "text_id=8777 | speaker=unknown"
msgid "　地上で月を落とす青子よりも、"
msgstr ""

#. Occurrence 7_1:4403:8778: scene=7_1
#: 7_1:4403
msgctxt "text_id=8778 | speaker=unknown"
msgid "　目を奪ったその光景。"
msgstr ""

#. Occurrence 7_1:4441:8779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0025; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4441
msgctxt "text_id=8779 | speaker=aoko"
msgid "「でも、それがどうしたの？　卵の仇討ちってワケ？」"
msgstr ""

#. Occurrence 7_1:4463:8780: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_0; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4463
msgctxt "text_id=8780 | speaker=alice"
msgid "「ダンプティは壊れるのが仕事だから、仇討ちも何もないわ。"
msgstr ""

#. Occurrence 7_1:4476:8781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_1; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4476
msgctxt "text_id=8781 | speaker=alice"
msgid "ただ……人間の体って、あんな風に動くんだなって」"
msgstr ""

#. Occurrence 7_1:4509:8782: scene=7_1
#: 7_1:4509
msgctxt "text_id=8782 | speaker=unknown"
msgid "　そう。"
msgstr ""

#. Occurrence 7_1:4515:8783: scene=7_1
#: 7_1:4515
msgctxt "text_id=8783 | speaker=unknown"
msgid "人付き合いの少ない有珠にとって、草十郎の跳躍は初めて見る衝撃だった。"
msgstr ""

#. Occurrence 7_1:4542:8784: scene=7_1
#: 7_1:4542
msgctxt "text_id=8784 | speaker=unknown"
msgid "　森の動物たちより何倍もバランスの悪い、二本の手足。"
msgstr ""

#. Occurrence 7_1:4547:8785: scene=7_1
#: 7_1:4547
msgctxt "text_id=8785 | speaker=unknown"
msgid "　あんな頼りのない足なのに、あんなに無力な両手だったのに、鳥のように虚空を駆った人のカタチ。"
msgstr ""

#. Occurrence 7_1:4553:8786: scene=7_1
#: 7_1:4553
msgctxt "text_id=8786 | speaker=unknown"
msgid "　それは都市で暮らす人間が、野生の<動物|ピューマ>の躍動を見る感動に近かった。"
msgstr ""

#. Occurrence 7_1:4604:8787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0022; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4604
msgctxt "text_id=8787 | speaker=alice"
msgid "「……気にしないで。機会があるなら、もう一度見たいと思っただけ。"
msgstr ""

#. Occurrence 7_1:4611:8788: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0023; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4611
msgctxt "text_id=8788 | speaker=alice"
msgid "別に、彼に何を期待しているワケじゃないわ」"
msgstr ""

#. Occurrence 7_1:4635:8789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0026; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4635
msgctxt "text_id=8789 | speaker=aoko"
msgid "「……なるほど。有珠のプロイってだいたいが人型じゃないしね。たんに物珍しさで見ていただけか」"
msgstr ""

#. Occurrence 7_1:4659:8790: scene=7_1
#: 7_1:4659
msgctxt "text_id=8790 | speaker=unknown"
msgid "　はーあ、と両肩を落とす青子。"
msgstr ""

#. Occurrence 7_1:4664:8791: scene=7_1
#: 7_1:4664
msgctxt "text_id=8791 | speaker=unknown"
msgid "　有珠の思わせぶりな態度が、新しい玩具を欲しがる子供の好奇心と知って落胆したのだ。"
msgstr ""

#. Occurrence 7_1:4698:8792: scene=7_1
#: 7_1:4698
msgctxt "text_id=8792 | speaker=unknown"
msgid "　そんな同居人の態度に、有珠も異論を唱えなかった。"
msgstr ""

#. Occurrence 7_1:4703:8793: scene=7_1
#: 7_1:4703
msgctxt "text_id=8793 | speaker=unknown"
msgid "　彼女自身、自分の抱いた感動が何なのか、よく分かっていなかったからだ。"
msgstr ""

#. Occurrence 7_1:4755:8794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0027; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4755
msgctxt "text_id=8794 | speaker=aoko"
msgid "「夕食、明日は私が作るから。"
msgstr ""

#. Occurrence 7_1:4761:8795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0028; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4761
msgctxt "text_id=8795 | speaker=aoko"
msgid "　試験前だってのにこんなしょぼくれたもん食べさせられたら、一夜漬けする気合いも湧かないわよ」"
msgstr ""

#. Occurrence 7_1:4792:8796: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0024; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4792
msgctxt "text_id=8796 | speaker=alice"
msgid "「ご自由に。わたしも手が空いて助かるわ」"
msgstr ""

#. Occurrence 7_1:4844:8797: scene=7_1
#: 7_1:4844
msgctxt "text_id=8797 | speaker=unknown"
msgid "　洋館の夜は過ぎていく。"
msgstr ""

#. Occurrence 7_1:4849:8798: scene=7_1
#: 7_1:4849
msgctxt "text_id=8798 | speaker=unknown"
msgid "　幸か不幸か、異物混入による変化は、まだ表面化していないようだ。"
msgstr ""

#. Occurrence 7_1:4960:8799: scene=7_1
#: 7_1:4960
msgctxt "text_id=8799 | speaker=unknown"
msgid "　翌朝、空に白みがかかりだした午前六時半。"
msgstr ""

#. Occurrence 7_1:4965:8800: scene=7_1
#: 7_1:4965
msgctxt "text_id=8800 | speaker=unknown"
msgid "　冷えこんだ空気の中、なぜか草十郎は青子と一緒に登校していた。"
msgstr ""

#. Occurrence 7_1:5012:8801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0029; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5012
msgctxt "text_id=8801 | speaker=aoko"
msgid "“いい？　洋館にいる時は、極力一人にならない事。”"
msgstr ""

#. Occurrence 7_1:5018:8802: scene=7_1
#: 7_1:5018
msgctxt "text_id=8802 | speaker=unknown"
msgid "　青子はその忠告通り、こうして洋館を出るまでは草十郎の安全を確保している。"
msgstr ""

#. Occurrence 7_1:5023:8803: scene=7_1
#: 7_1:5023
msgctxt "text_id=8803 | speaker=unknown"
msgid "　……にしても、"
msgstr ""

#. Occurrence 7_1:5062:8804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0030; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5062
msgctxt "text_id=8804 | speaker=aoko"
msgid "「眠い。六時から登校とか、アンタも働き者ね」"
msgstr ""

#. Occurrence 7_1:5068:8805: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0022; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5068
msgctxt "text_id=8805 | speaker=soujuurou"
msgid "「そうでもないよ。三十分<仕|し><出|だ>しを手伝うだけだし」"
msgstr ""

#. Occurrence 7_1:5113:8806: scene=7_1
#: 7_1:5113
msgctxt "text_id=8806 | speaker=unknown"
msgid "　期末試験を控えた状況とは思えない、<逞|たくま>しいまでの労働意欲である。"
msgstr ""

#. Occurrence 7_1:5140:8807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8807 | speaker=soujuurou"
msgid "「それより蒼崎、無理してないか？"
msgstr ""

#. Occurrence 7_1:5140:8808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8808 | speaker=soujuurou"
msgid "　別に、こっちに付き合う事ないんだぞ」"
msgstr ""

#. Occurrence 7_1:5176:8809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8809 | speaker=aoko"
msgid "「ご心配なく、生徒会室で仮眠とるから。"
msgstr ""

#. Occurrence 7_1:5176:8810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8810 | speaker=aoko"
msgid "　約束だし、門までは一緒に行くわよ」"
msgstr ""

#. Occurrence 7_1:5241:8811: scene=7_1
#: 7_1:5241
msgctxt "text_id=8811 | speaker=unknown"
msgid "　青子は思う。"
msgstr ""

#. Occurrence 7_1:5246:8812: scene=7_1
#: 7_1:5246
msgctxt "text_id=8812 | speaker=unknown"
msgid "　はたして、同居人がどんな罠を仕掛けているか。"
msgstr ""

#. Occurrence 7_1:5251:8813: scene=7_1
#: 7_1:5251
msgctxt "text_id=8813 | speaker=unknown"
msgid "　まさか森の中まで<禁忌|タブー>を仕掛けているとは思えないが、念のためだ。"
msgstr ""

#. Occurrence 7_1:5256:8814: scene=7_1
#: 7_1:5256
msgctxt "text_id=8814 | speaker=unknown"
msgid "　せめて行き道ぐらいは草十郎の味方になろう、と決めた青子である。"
msgstr ""

#. Occurrence 7_1:5317:8815: scene=7_1
#: 7_1:5317
msgctxt "text_id=8815 | speaker=unknown"
msgid "　罠があるのなら行き道で解除すればいい。"
msgstr ""

#. Occurrence 7_1:5322:8816: scene=7_1
#: 7_1:5322
msgctxt "text_id=8816 | speaker=unknown"
msgid "　一度解除……といっても青子には壊す程度しかできないのだが……してしまえば、しばらくは安全になるだろう。"
msgstr ""

#. Occurrence 7_1:5370:8817: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0032; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5370
msgctxt "text_id=8817 | speaker=aoko"
msgid "「ま、帰り道に関しては、有珠もそこまで暇ではないと信じるしかないんだけど」"
msgstr ""

#. Occurrence 7_1:5383:8818: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0024; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5383
msgctxt "text_id=8818 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 7_1:5455:8819: scene=7_1
#: 7_1:5455
msgctxt "text_id=8819 | speaker=unknown"
msgid "　夜に罠を仕掛けて、解除されたら休むことなく日中に仕掛けてまわる……なんてマメさを発揮されてはお手上げだ。"
msgstr ""

#. Occurrence 7_1:5460:8820: scene=7_1
#: 7_1:5460
msgctxt "text_id=8820 | speaker=unknown"
msgid "　その時はその時。"
msgstr ""

#. Occurrence 7_1:5465:8821: scene=7_1
#: 7_1:5465
msgctxt "text_id=8821 | speaker=unknown"
msgid "　久遠寺有珠にとって、静希草十郎はそこまでするほどの外敵だっただけの話だ。"
msgstr ""

#. Occurrence 7_1:5470:8822: scene=7_1
#: 7_1:5470
msgctxt "text_id=8822 | speaker=unknown"
msgid "　あの少女が頑なに守ってきた、魔女としての<矜持|プライド>を台無しにしてもいい程の。"
msgstr ""

#. Occurrence 7_1:5553:8823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0033; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5553
msgctxt "text_id=8823 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_1:5558:8824: scene=7_1
#: 7_1:5558
msgctxt "text_id=8824 | speaker=unknown"
msgid "　そもそも、その場合は青子がどれだけ尽力してもこの少年は守りきれない。日中のコトまで気を回すのは意味がなかった。"
msgstr ""

#. Occurrence 7_1:5563:8825: scene=7_1
#: 7_1:5563
msgctxt "text_id=8825 | speaker=unknown"
msgid "　自分にできるかぎりの事ならするが、自分の範疇を超えた事はあっさりと切り捨てるのが青子の人間性である。"
msgstr ""

#. Occurrence 7_1:5568:8826: scene=7_1
#: 7_1:5568
msgctxt "text_id=8826 | speaker=unknown"
msgid "　彼女にとっては、この方針が最大限の譲歩だった。"
msgstr ""

#. Occurrence 7_1:5633:8827: scene=7_1
#: 7_1:5633
msgctxt "text_id=8827 | speaker=unknown"
msgid "　久遠寺の敷地から出る。"
msgstr ""

#. Occurrence 7_1:5638:8828: scene=7_1
#: 7_1:5638
msgctxt "text_id=8828 | speaker=unknown"
msgid "　坂を下りて住宅地に出るまでふたり一緒だ。"
msgstr ""

#. Occurrence 7_1:5643:8829: scene=7_1
#: 7_1:5643
msgctxt "text_id=8829 | speaker=unknown"
msgid "　ふと、青子は傍らの少年を盗み見る。"
msgstr ""

#. Occurrence 7_1:5650:8830: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0034; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5650
msgctxt "text_id=8830 | speaker=aoko"
msgid "「ところで、何か考えてる？」"
msgstr ""

#. Occurrence 7_1:5691:8831: scene=7_1
#: 7_1:5691
msgctxt "text_id=8831 | speaker=unknown"
msgid "　青子は気まぐれで問いただしたが、意外な事に草十郎は質問の意図を察していた。"
msgstr ""

#. Occurrence 7_1:5697:8832: scene=7_1
#: 7_1:5697
msgctxt "text_id=8832 | speaker=unknown"
msgid "“有珠をどう納得させるのか”"
msgstr ""

#. Occurrence 7_1:5703:8833: scene=7_1
#: 7_1:5703
msgctxt "text_id=8833 | speaker=unknown"
msgid "　その難問を、彼は彼なりに考えていたらしい。"
msgstr ""

#. Occurrence 7_1:5752:8834: scene=7_1
#: 7_1:5752
msgctxt "text_id=8834 | speaker=unknown"
msgid "　友人曰く。"
msgstr ""

#. Occurrence 7_1:5757:8835: scene=7_1
#: 7_1:5757
msgctxt "text_id=8835 | speaker=unknown"
msgid "　この手の難問には大きく三通りの対応法があるという。"
msgstr ""

#. Occurrence 7_1:5762:8836: scene=7_1
#: 7_1:5762
msgctxt "text_id=8836 | speaker=unknown"
msgid "　一つは外回り。"
msgstr ""

#. Occurrence 7_1:5789:8837: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0018; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5789
msgctxt "text_id=8837 | speaker=kinomi"
msgid "“こいつは時間がかかるが、もっとも自然だ。"
msgstr ""

#. Occurrence 7_1:5795:8838: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0019; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5795
msgctxt "text_id=8838 | speaker=kinomi"
msgid "　人間ってのは自分が好きなものを大切にされると、コロッと気を許しちまう。仲間意識ってヤツだな！”"
msgstr ""

#. Occurrence 7_1:5801:8839: scene=7_1
#: 7_1:5801
msgctxt "text_id=8839 | speaker=unknown"
msgid "　つまり、ターゲット本人ではなく、ターゲットが大事にしているものに気を遣え、というコトらしい。"
msgstr ""

#. Occurrence 7_1:5826:8840: scene=7_1
#: 7_1:5826
msgctxt "text_id=8840 | speaker=unknown"
msgid "　木乃美らしからぬ大人な意見ではあったが、残念なことに、草十郎は有珠の<嗜好|しこう>を知らなかった。"
msgstr ""

#. Occurrence 7_1:5831:8841: scene=7_1
#: 7_1:5831
msgctxt "text_id=8841 | speaker=unknown"
msgid "　洋館を大切にしているコトは感じ取っているが、ここで洋館の掃除などをしても逆効果な気がする。"
msgstr ""

#. Occurrence 7_1:5836:8842: scene=7_1
#: 7_1:5836
msgctxt "text_id=8842 | speaker=unknown"
msgid "　草十郎としては、大切すぎるものには簡単に触れて欲しくないのではないか、と思うのだ。"
msgstr ""

#. Occurrence 7_1:5856:8843: scene=7_1
#: 7_1:5856
msgctxt "text_id=8843 | speaker=unknown"
msgid "　二つめは内回り。"
msgstr ""

#. Occurrence 7_1:5871:8844: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0020; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5871
msgctxt "text_id=8844 | speaker=kinomi"
msgid "“でも、やっぱり本人を落とすのが一番早い。オレたちに魅力がないのなら、魅力のある外付け装備に頼るのだ。"
msgstr ""

#. Occurrence 7_1:5877:8845: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0021; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5877
msgctxt "text_id=8845 | speaker=kinomi"
msgid "　―――そう、プレゼントなンだよ静希クン！”"
msgstr ""

#. Occurrence 7_1:5889:8846: scene=7_1
#: 7_1:5889
msgctxt "text_id=8846 | speaker=unknown"
msgid "　即ち短期決戦。かつ、一撃必殺。"
msgstr ""

#. Occurrence 7_1:5894:8847: scene=7_1
#: 7_1:5894
msgctxt "text_id=8847 | speaker=unknown"
msgid "　高価な贈り物で相手の意識を変えろ、というコトらしい。"
msgstr ""

#. Occurrence 7_1:5919:8848: scene=7_1
#: 7_1:5919
msgctxt "text_id=8848 | speaker=unknown"
msgid "　素晴らしい作戦だ、と草十郎も思う。"
msgstr ""

#. Occurrence 7_1:5924:8849: scene=7_1
#: 7_1:5924
msgctxt "text_id=8849 | speaker=unknown"
msgid "　なによりシンプルなのがいい。わかりやすいのは彼にとってありがたい。"
msgstr ""

#. Occurrence 7_1:5929:8850: scene=7_1
#: 7_1:5929
msgctxt "text_id=8850 | speaker=unknown"
msgid "　しかし―――つまるところ、それも一つ目の作戦と同じ気がする。"
msgstr ""

#. Occurrence 7_1:5934:8851: scene=7_1
#: 7_1:5934
msgctxt "text_id=8851 | speaker=unknown"
msgid "　なにより、先立つものがないのが致命的だ。"
msgstr ""

#. Occurrence 7_1:5963:8852: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_0; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5963
#. Occurrence 7_1:5970:8852: scene=7_1
#: 7_1:5970
msgctxt "text_id=8852 | speaker=kinomi"
msgid "“あとは……まあ、<見|ケン>ってヤツ？"
msgstr ""

#. Occurrence 7_1:5983:8853: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_1; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5983
msgctxt "text_id=8853 | speaker=kinomi"
msgid "　オレにはよくわかんねえけどさー、やりすぎると悪い印象を持たれるとか殿下がいってたなー。"
msgstr ""

#. Occurrence 7_1:5995:8854: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0023; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5995
msgctxt "text_id=8854 | speaker=kinomi"
msgid "　アタシ、いま落とされてる！　って意識させちゃダメなんだとよ。付き合った後で、アレ、アタシ落とされた？　と気づかせるのが上等なんだとか”"
msgstr ""

#. Occurrence 7_1:6027:8855: scene=7_1
#: 7_1:6027
msgctxt "text_id=8855 | speaker=unknown"
msgid "　言わんとするところはまったく分からないが、要は無理をするな、というコトらしい。"
msgstr ""

#. Occurrence 7_1:6032:8856: scene=7_1
#: 7_1:6032
msgctxt "text_id=8856 | speaker=unknown"
msgid "　まったく同感だ。"
msgstr ""

#. Occurrence 7_1:6043:8857: scene=7_1
#: 7_1:6043
msgctxt "text_id=8857 | speaker=unknown"
msgid "　気に入られる為に努力するのは正しい。"
msgstr ""

#. Occurrence 7_1:6048:8858: scene=7_1
#: 7_1:6048
msgctxt "text_id=8858 | speaker=unknown"
msgid "　けれど、それにも段階があるのでは、と草十郎は思うのだ。"
msgstr ""

#. Occurrence 7_1:6076:8859: scene=7_1
#: 7_1:6076
msgctxt "text_id=8859 | speaker=unknown"
msgid "　昔、山で見知らぬ狐のテリトリーに入ってしまったコトを思いだす。"
msgstr ""

#. Occurrence 7_1:6081:8860: scene=7_1
#: 7_1:6081
msgctxt "text_id=8860 | speaker=unknown"
msgid "　あの時は手持ちの食べ物などを置いてしまったが、それ以降、狐の気配はなくなってしまった。"
msgstr ""

#. Occurrence 7_1:6086:8861: scene=7_1
#: 7_1:6086
msgctxt "text_id=8861 | speaker=unknown"
msgid "　善意、懇意のカタチは人それぞれ。"
msgstr ""

#. Occurrence 7_1:6091:8862: scene=7_1
#: 7_1:6091
msgctxt "text_id=8862 | speaker=unknown"
msgid "　一方的な善意は時として重荷になる。"
msgstr ""

#. Occurrence 7_1:6096:8863: scene=7_1
#: 7_1:6096
msgctxt "text_id=8863 | speaker=unknown"
msgid "　なので、"
msgstr ""

#. Occurrence 7_1:6142:8864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0025; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6142
msgctxt "text_id=8864 | speaker=soujuurou"
msgid "「大丈夫、考えてるよ。とりあえず自分にできるコトとか、したいコトをしようと思う。"
msgstr ""

#. Occurrence 7_1:6149:8865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0026; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6149
msgctxt "text_id=8865 | speaker=soujuurou"
msgid "安心してくれ。蒼崎に忠告されたコトすら、きちんと守る方針だ」"
msgstr ""

#. Occurrence 7_1:6178:8866: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0035; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:6178
msgctxt "text_id=8866 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_1:6185:8867: scene=7_1
#: 7_1:6185
msgctxt "text_id=8867 | speaker=unknown"
msgid "　まかせろ、と胸を張る草十郎。"
msgstr ""

#. Occurrence 7_1:6190:8868: scene=7_1
#: 7_1:6190
msgctxt "text_id=8868 | speaker=unknown"
msgid "　まったく頼り甲斐のない返答に、ほんと大丈夫かコイツ、とつい親身になってしまう青子だった。"
msgstr ""

#. Occurrence 7_1:6244:8869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0000; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6244
msgctxt "text_id=8869 | speaker=kojika"
msgid "「学校にあるような<箒|ほうき>がほしい？」"
msgstr ""

#. Occurrence 7_1:6289:8870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0027; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6289
msgctxt "text_id=8870 | speaker=soujuurou"
msgid "「そうなんだ。できれば安く買えるところ」"
msgstr ""

#. Occurrence 7_1:6301:8871: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0001; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6301
msgctxt "text_id=8871 | speaker=kojika"
msgid "「……静希の家、アパートよね。箒なんてモノ必要とは思えないけど」"
msgstr ""

#. Occurrence 7_1:6327:8872: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0028; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6327
msgctxt "text_id=8872 | speaker=soujuurou"
msgid "「いや、ちょっと気になるところがあって掃除がしたいんだ。ゴミ袋もあると助かる」"
msgstr ""

#. Occurrence 7_1:6374:8873: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0002; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6374
msgctxt "text_id=8873 | speaker=kojika"
msgid "「無駄な出費はできないって言ってたクセに。"
msgstr ""

#. Occurrence 7_1:6380:8874: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0003; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6380
msgctxt "text_id=8874 | speaker=kojika"
msgid "　ま、どうでもいいけど。うちのでよければ使う？　貸してあげましょうか？」"
msgstr ""

#. Occurrence 7_1:6391:8875: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0029; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6391
msgctxt "text_id=8875 | speaker=soujuurou"
msgid "「たぶん一日じゃ終わらないから自分で買うよ。"
msgstr ""

#. Occurrence 7_1:6397:8876: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0030; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6397
msgctxt "text_id=8876 | speaker=soujuurou"
msgid "　もとから欲しかったものだし。あると便利だよ、箒」"
msgstr ""

#. Occurrence 7_1:6449:8877: scene=7_1
#: 7_1:6449
msgctxt "text_id=8877 | speaker=unknown"
msgid "　学校が終わってから、アルバイトの帰り道。"
msgstr ""

#. Occurrence 7_1:6467:8878: scene=7_1
#: 7_1:6467
msgctxt "text_id=8878 | speaker=unknown"
msgid "　時刻はバイト終了時間から二時間ほど早い午後四時。"
msgstr ""

#. Occurrence 7_1:6472:8879: scene=7_1
#: 7_1:6472
msgctxt "text_id=8879 | speaker=unknown"
msgid "　試験前日に学生を拘束するとは何事か、とお店の会計係に叱られたまっどべあ料理長は泣く泣く草十郎を送りだしてくれた。"
msgstr ""

#. Occurrence 7_1:6491:8880: scene=7_1
#: 7_1:6491
msgctxt "text_id=8880 | speaker=unknown"
msgid "　そして。"
msgstr ""

#. Occurrence 7_1:6496:8881: scene=7_1
#: 7_1:6496
msgctxt "text_id=8881 | speaker=unknown"
msgid "　この二時間のタイムラグこそが、草十郎の明暗を分けるのだ。多分。"
msgstr ""

#. Occurrence 7_1:6530:8882: scene=7_1
#: 7_1:6530
msgctxt "text_id=8882 | speaker=unknown"
msgid "　本来の予定では、草十郎は生徒会の作業を終えてから下校する青子と合流し、久遠寺邸に向かわなければならない。"
msgstr ""

#. Occurrence 7_1:6551:8883: scene=7_1
#: 7_1:6551
msgctxt "text_id=8883 | speaker=unknown"
msgid "　が、何を思ったか草十郎はバイト仲間の同期生に、この近くで竹箒を売っている店はないかと訊ねていた。"
msgstr ""

#. Occurrence 7_1:6584:8884: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0004; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6584
msgctxt "text_id=8884 | speaker=kojika"
msgid "「田舎者の趣味って理解不能ね。<酔狂|すいきょう>すぎ。"
msgstr ""

#. Occurrence 7_1:6590:8885: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0005; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6590
msgctxt "text_id=8885 | speaker=kojika"
msgid "　<三咲高|うち>の近くにまっずいラーメン屋あるでしょ。あそこの通りを終わりまで行けば沖田って<金物|かなもの>店がある。"
msgstr ""

#. Occurrence 7_1:6597:8886: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0006; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6597
msgctxt "text_id=8886 | speaker=kojika"
msgid "一式揃えるなら西口のホームセンターより安くあがるわ。"
msgstr ""

#. Occurrence 7_1:6618:8887: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0007; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6618
msgctxt "text_id=8887 | speaker=kojika"
msgid "　……どうでもいいけど、わたしの<自転車|チャリ>使う？　どうせ試験明けまで使わないし」"
msgstr ""

#. Occurrence 7_1:6652:8888: scene=7_1
#: 7_1:6652
msgctxt "text_id=8888 | speaker=unknown"
msgid "　思わぬ助け船に目を輝かせるが、久遠寺邸までの坂道を自転車で、しかも荷物を抱えて走るのは難しそうだ。"
msgstr ""

#. Occurrence 7_1:6663:8889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0031; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6663
msgctxt "text_id=8889 | speaker=soujuurou"
msgid "「いや、自転車には乗ってみたいけど、今回は遠慮するよ。じゃあまた明日、学校で」"
msgstr ""

#. Occurrence 7_1:6700:8890: scene=7_1
#: 7_1:6700
msgctxt "text_id=8890 | speaker=unknown"
msgid "　少女に礼を言って金物店に向かう。"
msgstr ""

#. Occurrence 7_1:6710:8891: scene=7_1
#: 7_1:6710
msgctxt "text_id=8891 | speaker=unknown"
msgid "　目的は安くて丈夫な竹箒と、大型のチリ取り。"
msgstr ""

#. Occurrence 7_1:6715:8892: scene=7_1
#: 7_1:6715
msgctxt "text_id=8892 | speaker=unknown"
msgid "　できれば台車や添え木用の棒もほしい、といざ考えだすと色々なものが欲しい草十郎だった。"
msgstr ""

#. Occurrence 7_1:6753:8893: scene=7_1
#: 7_1:6753
msgctxt "text_id=8893 | speaker=unknown"
msgid "　<午睡|ごすい>から目を覚ますと、少女は作業を再開した。"
msgstr ""

#. Occurrence 7_1:6786:8894: scene=7_1
#: 7_1:6786
msgctxt "text_id=8894 | speaker=unknown"
msgid "　久遠寺邸には別館があり、その内部は図書室になっている。"
msgstr ""

#. Occurrence 7_1:6791:8895: scene=7_1
#: 7_1:6791
msgctxt "text_id=8895 | speaker=unknown"
msgid "　少女の母から受け継いだ書物を収蔵したそこは、同居人である蒼崎青子も立ち入る事を<躊躇|ちゅうちょ>する領域だ。"
msgstr ""

#. Occurrence 7_1:6796:8896: scene=7_1
#: 7_1:6796
msgctxt "text_id=8896 | speaker=unknown"
msgid "　久遠寺邸が時代に取り残された魔女の館なら、"
msgstr ""

#. Occurrence 7_1:6801:8897: scene=7_1
#: 7_1:6801
msgctxt "text_id=8897 | speaker=unknown"
msgid "　この図書室は時代に忘れ去られた<御伽|おとぎ>の部屋。"
msgstr ""

#. Occurrence 7_1:6806:8898: scene=7_1
#: 7_1:6806
msgctxt "text_id=8898 | speaker=unknown"
msgid "　童話を操る幼い魔女からすれば、必然、相性の良い聖域と言える。"
msgstr ""

#. Occurrence 7_1:6864:8899: scene=7_1
#: 7_1:6864
msgctxt "text_id=8899 | speaker=unknown"
msgid "　少女は記憶を頼りに本棚を巡っていく。"
msgstr ""

#. Occurrence 7_1:6869:8900: scene=7_1
#: 7_1:6869
msgctxt "text_id=8900 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence 7_1:6880:8901: scene=7_1
#: 7_1:6880
msgctxt "text_id=8901 | speaker=unknown"
msgid "　なんとなしに顔を上げた時、おかしな風景を見てしまった。"
msgstr ""

#. Occurrence 7_1:6914:8902: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0025; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:6914
msgctxt "text_id=8902 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 7_1:6920:8903: scene=7_1
#: 7_1:6920
msgctxt "text_id=8903 | speaker=unknown"
msgid "　優美な眉が不満げに寄せられる。"
msgstr ""

#. Occurrence 7_1:6930:8904: scene=7_1
#: 7_1:6930
msgctxt "text_id=8904 | speaker=unknown"
msgid "　その後の予定は、なにひとつ守れなかった。"
msgstr ""

#. Occurrence 7_1:6935:8905: scene=7_1
#: 7_1:6935
msgctxt "text_id=8905 | speaker=unknown"
msgid "　少女は日が暮れるまで眉のカタチを変えず、じっと、窓の外のおかしな景色を眺めていたからだ。"
msgstr ""

#. Occurrence 7_1:7026:8906: scene=7_1
#: 7_1:7026
msgctxt "text_id=8906 | speaker=unknown"
msgid "　―――とまあ。"
msgstr ""

#. Occurrence 7_1:7032:8907: scene=7_1
#: 7_1:7032
msgctxt "text_id=8907 | speaker=unknown"
msgid "　丘の上の洋館で寝泊りするようになっても、草十郎の日常に、とりわけ大きな変化は訪れなかった。"
msgstr ""

#. Occurrence 7_1:7052:8908: scene=7_1
#: 7_1:7052
msgctxt "text_id=8908 | speaker=unknown"
msgid "　起床、"
msgstr ""

msgctxt "text_id=8909 | speaker=unknown"
msgid "アルバイト、"
msgstr ""

msgctxt "text_id=8910 | speaker=unknown"
msgid "朝食、"
msgstr ""

msgctxt "text_id=8911 | speaker=unknown"
msgid "登校。"
msgstr ""

#. Occurrence 7_1:7106:8912: scene=7_1
#: 7_1:7106
msgctxt "text_id=8912 | speaker=unknown"
msgid "　慣れない授業、"
msgstr ""

msgctxt "text_id=8913 | speaker=unknown"
msgid "数少ない憩いの休み時間、"
msgstr ""

msgctxt "text_id=8914 | speaker=unknown"
msgid "放課後。"
msgstr ""

#. Occurrence 7_1:7147:8915: scene=7_1
#: 7_1:7147
msgctxt "text_id=8915 | speaker=unknown"
msgid "　下校、"
msgstr ""

msgctxt "text_id=8916 | speaker=unknown"
msgid "アルバイト、"
msgstr ""

msgctxt "text_id=8917 | speaker=unknown"
msgid "仮眠、"
msgstr ""

msgctxt "text_id=8918 | speaker=unknown"
msgid "起床、"
msgstr ""

msgctxt "text_id=8919 | speaker=unknown"
msgid "試験勉強。"
msgstr ""

#. Occurrence 7_1:7240:8920: scene=7_1
#: 7_1:7240
msgctxt "text_id=8920 | speaker=unknown"
msgid "　ささやかな少年のささやかな日常は、本人の努力とは正反対に、<為|な>す<術|すべ>なく流れていく。"
msgstr ""

#. Occurrence 7_1:7260:8921: scene=7_1
#: 7_1:7260
msgctxt "text_id=8921 | speaker=unknown"
msgid "　状況は一向に変わらない。"
msgstr ""

#. Occurrence 7_1:7265:8922: scene=7_1
#: 7_1:7265
msgctxt "text_id=8922 | speaker=unknown"
msgid "　館内では頻繁に青子が隣にいたり、"
msgstr ""

#. Occurrence 7_1:7270:8923: scene=7_1
#: 7_1:7270
msgctxt "text_id=8923 | speaker=unknown"
msgid "　眠る前に有珠の用意した薬を飲まされたりするのも同じ。"
msgstr ""

#. Occurrence 7_1:7276:8924: scene=7_1
#: 7_1:7276
msgctxt "text_id=8924 | speaker=unknown"
msgid "　前者は草十郎の安全を考慮した青子のフォローであり、"
msgstr ""

#. Occurrence 7_1:7281:8925: scene=7_1
#: 7_1:7281
msgctxt "text_id=8925 | speaker=unknown"
msgid "　後者は、理屈は分からないが、やっぱり彼の安全のためだという。"
msgstr ""

#. Occurrence 7_1:7328:8926: scene=7_1
#: 7_1:7328
msgctxt "text_id=8926 | speaker=unknown"
msgid "　そして。今朝も今朝とて何の変化もない状況に頭を悩ませつつ、草十郎は朝の紅茶を淹れていた。"
msgstr ""

#. Occurrence 7_1:7335:8927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0032; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:7335
msgctxt "text_id=8927 | speaker=soujuurou"
msgid "「…………ああ、そう言えば」"
msgstr ""

#. Occurrence 7_1:7341:8928: scene=7_1
#: 7_1:7341
msgctxt "text_id=8928 | speaker=unknown"
msgid "　有珠との関係に変化はないが、大きな変化はここにある。草十郎の朝の一服は、煎茶から紅茶に変わっていた。"
msgstr ""

#. Occurrence 7_1:7373:8929: scene=7_1
#: 7_1:7373
msgctxt "text_id=8929 | speaker=unknown"
msgid "　台所には様々な紅茶の葉があるが、ビギナーである草十郎には無用の長物だ。"
msgstr ""

#. Occurrence 7_1:7379:8930: scene=7_1
#: 7_1:7379
msgctxt "text_id=8930 | speaker=unknown"
msgid "　彼の用意する紅茶は当然ティーバッグで、自分用に一杯<淹|い>れて<食卓|サンルーム>に移動する。"
msgstr ""

#. Occurrence 7_1:7399:8931: scene=7_1
#: 7_1:7399
msgctxt "text_id=8931 | speaker=unknown"
msgid "　テーブルには先客が二名。"
msgstr ""

#. Occurrence 7_1:7404:8932: scene=7_1
#: 7_1:7404
msgctxt "text_id=8932 | speaker=unknown"
msgid "　青子と有珠は無言で朝食を<摂|と>っている。"
msgstr ""

#. Occurrence 7_1:7410:8933: scene=7_1
#: 7_1:7410
msgctxt "text_id=8933 | speaker=unknown"
msgid "　久遠寺邸において、朝食は完全個人主義だ。"
msgstr ""

#. Occurrence 7_1:7415:8934: scene=7_1
#: 7_1:7415
msgctxt "text_id=8934 | speaker=unknown"
msgid "　ふたりの朝食は<婉曲|えんきょく>に言えば質素な―――真実を言うと用意に二秒もかからない、堅そうな石窯パン一つきりである。"
msgstr ""

#. Occurrence 7_1:7449:8935: scene=7_1
#: 7_1:7449
msgctxt "text_id=8935 | speaker=unknown"
msgid "　青子たちは<時折|ときおり>言葉を交わすと、最後に紅茶を一口だけ<啜|すす>って席を立つ。"
msgstr ""

#. Occurrence 7_1:7460:8936: scene=7_1
#: 7_1:7460
msgctxt "text_id=8936 | speaker=unknown"
msgid "　有珠はもう高校が冬休みに入っているのでそのまま自室へ戻り、"
msgstr ""

msgctxt "text_id=8937 | speaker=unknown"
msgid "青子はこれから学校なので鞄を片手に玄関へ。"
msgstr ""

#. Occurrence 7_1:7479:8938: scene=7_1
#: 7_1:7479
msgctxt "text_id=8938 | speaker=unknown"
msgid "　草十郎も食器を片づけた後、青子の後を追って洋館を後にする。"
msgstr ""

#. Occurrence 7_1:7484:8939: scene=7_1
#: 7_1:7484
msgctxt "text_id=8939 | speaker=unknown"
msgid "　ふたりは長い坂を下りて学校へ。"
msgstr ""

#. Occurrence 7_1:7513:8940: scene=7_1
#: 7_1:7513
msgctxt "text_id=8940 | speaker=unknown"
msgid "　三日間はこんな風に、実に簡潔に過ぎてしまった。"
msgstr ""

#. Occurrence 7_1:7559:8941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0036; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7559
msgctxt "text_id=8941 | speaker=aoko"
msgid "「ところで、あれから動きはあった？」"
msgstr ""

#. Occurrence 7_1:7583:8942: scene=7_1
#: 7_1:7583
msgctxt "text_id=8942 | speaker=unknown"
msgid "　授業も終えた夕刻時。"
msgstr ""

#. Occurrence 7_1:7588:8943: scene=7_1
#: 7_1:7588
msgctxt "text_id=8943 | speaker=unknown"
msgid "　青子の問いに、有珠は掴んだバターロールもそのままに、首を横に振るだけで『いいえ』と答えた。"
msgstr ""

#. Occurrence 7_1:7610:8944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8944 | speaker=aoko"
msgid "「そう。なら、<敵側|あっち>も次の手を考えているんでしょうね。"
msgstr ""

#. Occurrence 7_1:7610:8945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8945 | speaker=aoko"
msgid "　魔術師本体の居場所は見当ついてる？」"
msgstr ""

#. Occurrence 7_1:7631:8946: scene=7_1
#: 7_1:7631
msgctxt "text_id=8946 | speaker=unknown"
msgid "　返答はまったく同じ。"
msgstr ""

#. Occurrence 7_1:7653:8947: scene=7_1
#: 7_1:7653
msgctxt "text_id=8947 | speaker=unknown"
msgid "　落胆した風もなく、青子はバターロールを一口噛んでからサラダにフォークを突き刺した。"
msgstr ""

#. Occurrence 7_1:7681:8948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0038; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7681
msgctxt "text_id=8948 | speaker=aoko"
msgid "「そ。私も試験が終わったら手伝うから、それまで悪いけどひとりでやってて。今日からあのバカを一夜漬けにしなくちゃいけないんで、余裕ないの」"
msgstr ""

#. Occurrence 7_1:7704:8949: scene=7_1
#: 7_1:7704
msgctxt "text_id=8949 | speaker=unknown"
msgid "　それには思うところがあるのか、有珠はわずかに顔を曇らせた。"
msgstr ""

#. Occurrence 7_1:7740:8950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0039; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7740
msgctxt "text_id=8950 | speaker=aoko"
msgid "「？　問題ないでしょ、有珠はもう休みに入ってるんだから。一日ぜんぶ使えるじゃない」"
msgstr ""

#. Occurrence 7_1:7778:8951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0026; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7778
msgctxt "text_id=8951 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 7_1:7783:8952: scene=7_1
#: 7_1:7783
msgctxt "text_id=8952 | speaker=unknown"
msgid "　たしかに有珠は冬休み中で、一日のすべてを魔術師としての生活に<費|つい>やしている。"
msgstr ""

#. Occurrence 7_1:7788:8953: scene=7_1
#: 7_1:7788
msgctxt "text_id=8953 | speaker=unknown"
msgid "　ただ、ここ数日はある理由で図書室に籠もりきりだった。"
msgstr ""

#. Occurrence 7_1:7793:8954: scene=7_1
#: 7_1:7793
msgctxt "text_id=8954 | speaker=unknown"
msgid "　青子の言う“挑戦者への対策”に徹していたワケでもない。"
msgstr ""

#. Occurrence 7_1:7839:8955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0040; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7839
msgctxt "text_id=8955 | speaker=aoko"
msgid "「有珠？　聞いてる？」"
msgstr ""

#. Occurrence 7_1:7872:8956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0027; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7872
msgctxt "text_id=8956 | speaker=alice"
msgid "「……分かってる。今夜から、そっちもやるから」"
msgstr ""

#. Occurrence 7_1:7883:8957: scene=7_1
#: 7_1:7883
msgctxt "text_id=8957 | speaker=unknown"
msgid "　ため息まじりに返答して席を立つ。"
msgstr ""

#. Occurrence 7_1:7914:8958: scene=7_1
#: 7_1:7914
msgctxt "text_id=8958 | speaker=unknown"
msgid "　……何が気になって、何が言いたかったのか。"
msgstr ""

#. Occurrence 7_1:7919:8959: scene=7_1
#: 7_1:7919
msgctxt "text_id=8959 | speaker=unknown"
msgid "　ほんの二時間前、彼女が何をしていたのか。"
msgstr ""

#. Occurrence 7_1:7935:8960: scene=7_1
#: 7_1:7935
msgctxt "text_id=8960 | speaker=unknown"
msgid "　それらの出来事を飲みこんで、有珠は食卓から去っていった。"
msgstr ""

msgctxt "text_id=8961 | speaker=unknown"
msgid "　その、二時間前の話―――"
msgstr ""

msgctxt "text_id=8962 | speaker=unknown"
msgid "　眠りに落ちて見る夢は、"
msgstr ""

msgctxt "text_id=8963 | speaker=unknown"
msgid "　たいてい、幼い頃の記憶だった。"
msgstr ""

msgctxt "text_id=8964 | speaker=unknown"
msgid "　イングランドの北西部。"
msgstr ""

msgctxt "text_id=8965 | speaker=unknown"
msgid "　深い霧に覆われたオークの森。"
msgstr ""

msgctxt "text_id=8966 | speaker=unknown"
msgid "　二十世紀にあっても人を寄せ付けない、鳥と獣たちの王国。"
msgstr ""

msgctxt "text_id=8967 | speaker=unknown"
msgid "　その一角に、彼女の生まれ育った家があった。"
msgstr ""

msgctxt "text_id=8968 | speaker=unknown"
msgid "　何代と続いてきた古い生き物。"
msgstr ""

msgctxt "text_id=8969 | speaker=unknown"
msgid "　偉大な、あるいは愚かな先祖の言いつけ通り、かたくなに純潔を守り続けた、原初の魔女の<末裔|まつえい>たち。"
msgstr ""

msgctxt "text_id=8970 | speaker=unknown"
msgid "　先代たちがどれほどの年月を重ねてきたのか、少女は正確に把握していない。"
msgstr ""

msgctxt "text_id=8971 | speaker=unknown"
msgid "　少女の母までは確かに伝わっていたが、少女には<口伝|くでん>でしか教えられなかった。"
msgstr ""

msgctxt "text_id=8972 | speaker=unknown"
msgid "　だから、彼女たちがその土地に根を下ろしてどれほどの年月が経っていたのか、知るものはもう誰もいない。"
msgstr ""

msgctxt "text_id=8973 | speaker=unknown"
msgid "　伝統はすっかり<剥|は>がれ落ちて、"
msgstr ""

msgctxt "text_id=8974 | speaker=unknown"
msgid "　角をいただいた白馬も、"
msgstr ""

msgctxt "text_id=8975 | speaker=unknown"
msgid "　虹色にはばたく鳥も、"
msgstr ""

msgctxt "text_id=8976 | speaker=unknown"
msgid "　少女が生まれた時には影も形も見あたらなかった。"
msgstr ""

msgctxt "text_id=8977 | speaker=unknown"
msgid "　代わりにあるものと言えば、少女の家には不釣り合いな、近代的な家具の数々だった。"
msgstr ""

msgctxt "text_id=8978 | speaker=unknown"
msgid "　それらは森の空気にも少女の肌にも合わなかったが、決して不快なものではなかったと憶えている。"
msgstr ""

msgctxt "text_id=8979 | speaker=unknown"
msgid "　時代遅れの母と、"
msgstr ""

msgctxt "text_id=8980 | speaker=unknown"
msgid "　時代遅れの自分に贈られた記念品。"
msgstr ""

msgctxt "text_id=8981 | speaker=unknown"
msgid "　それらに愛情を抱いたのは、"
msgstr ""

msgctxt "text_id=8982 | speaker=unknown"
msgid "　一週間に一度、<近くの都市|マンチェスター>からやってくる男性からの贈り物である事を、子供心に分かっていたからだろう。"
msgstr ""

msgctxt "text_id=8983 | speaker=unknown"
msgid "　……それも、今では失われた。"
msgstr ""

msgctxt "text_id=8984 | speaker=unknown"
msgid "　きらきら光る運転手付きの<高級車|キャデラック>も、"
msgstr ""

msgctxt "text_id=8985 | speaker=unknown"
msgid "　お城のような<花園|ガーデン>も、"
msgstr ""

msgctxt "text_id=8986 | speaker=unknown"
msgid "　たくさんの大人たちも、"
msgstr ""

msgctxt "text_id=8987 | speaker=unknown"
msgid "　<霧|きり>のように消えてしまった。"
msgstr ""

msgctxt "text_id=8988 | speaker=unknown"
msgid "　あるいは、霧の中に消えてしまった。"
msgstr ""

msgctxt "text_id=8989 | speaker=unknown"
msgid "　幸せに満ちた母の笑顔も、"
msgstr ""

msgctxt "text_id=8990 | speaker=unknown"
msgid "　はにかむような父の笑顔もない。"
msgstr ""

msgctxt "text_id=8991 | speaker=unknown"
msgid "　そんなもの、初めから森が<赦|ゆる>しはしなかったのだ。"
msgstr ""

msgctxt "text_id=8992 | speaker=unknown"
msgid "　……今はただ、疑問だけが残っている。"
msgstr ""

msgctxt "text_id=8993 | speaker=unknown"
msgid "　洋館には不釣り合いだった数々の異物。"
msgstr ""

msgctxt "text_id=8994 | speaker=unknown"
msgid "　何ひとつ自分が望んだわけではない高級品。"
msgstr ""

msgctxt "text_id=8995 | speaker=unknown"
msgid "　ただ<厭|いや>らしいだけの贈り物。"
msgstr ""

msgctxt "text_id=8996 | speaker=unknown"
msgid "　それを、あんなにも<愛|いと>おしく<触|ふ>れていたのは、一体どんな気の迷いだったのか―――"
msgstr ""

msgctxt "text_id=8997 | speaker=unknown"
msgid "「――――――」"
msgstr ""

msgctxt "text_id=8998 | speaker=unknown"
msgid "　閉じられた<目蓋|まぶた>がかすかに動く。"
msgstr ""

msgctxt "text_id=8999 | speaker=unknown"
msgid "　日が<翳|かげ>りだす前の午後。"
msgstr ""

msgctxt "text_id=9000 | speaker=unknown"
msgid "　少女は自分の耳ではなく、館が聞き届けた音に反応して、うっすらと意識を起こした。"
msgstr ""

msgctxt "text_id=9001 | speaker=unknown"
msgid "　辛そうに目蓋を押さえる少女を気遣ってか、鳴き声をあげる青い小鳥。"
msgstr ""

msgctxt "text_id=9002 | speaker=unknown"
msgid "　少女はぼんやりとした目で、"
msgstr ""

msgctxt "text_id=9003 | speaker=unknown"
msgid "「……不思議ね。ずっと昔の、鳥の夢を見たわ」"
msgstr ""

msgctxt "text_id=9004 | speaker=unknown"
msgid "　薄れていく夢の<内容|きおく>に<縋|すが>るように、独り言を口にした。"
msgstr ""

msgctxt "text_id=9005 | speaker=unknown"
msgid "　鳥と聞いて、我が事のようにはしゃぐ駒鳥。"
msgstr ""

msgctxt "text_id=9006 | speaker=unknown"
msgid "「……安心して。ほとんど覚えていないけど、貴方じゃない事だけは確かだから。"
msgstr ""

msgctxt "text_id=9007 | speaker=unknown"
msgid "　それよりこの音、なに？」"
msgstr ""

msgctxt "text_id=9008 | speaker=unknown"
msgid "　<肩|はね>を落としてがっかりする駒鳥に、少女は冷たい目のまま追及する。"
msgstr ""

msgctxt "text_id=9009 | speaker=unknown"
msgid "　……彼女が目を覚ました原因。"
msgstr ""

msgctxt "text_id=9010 | speaker=unknown"
msgid "　館の裏庭の方から響く、<耳障|みみざわ>りな雑音について。"
msgstr ""

msgctxt "text_id=9011 | speaker=unknown"
msgid "　裏庭からの雑音がなんなのか熟知していた駒鳥は、胸を張って主人に報告する。"
msgstr ""

msgctxt "text_id=9012 | speaker=unknown"
msgid "　聞いて。少女の眠気は、今度こそ霧散した。"
msgstr ""

msgctxt "text_id=9013 | speaker=unknown"
msgid "「…………そう。<目障|めざわ>りなだけでなく、<耳障|みみざわ>りにまでさせてくれるのね、彼」"
msgstr ""

msgctxt "text_id=9014 | speaker=unknown"
msgid "　つまらなげに漏らした言葉は、魔女としての責務とはまた違う、いわれのない個人的な<感情|いらだち>を含んでいた。"
msgstr ""

msgctxt "text_id=9015 | speaker=unknown"
msgid "　長らく使われていなかったポンプが、ギッコギッコと音を立てる。"
msgstr ""

msgctxt "text_id=9016 | speaker=unknown"
msgid "　久遠寺邸の裏庭。"
msgstr ""

msgctxt "text_id=9017 | speaker=unknown"
msgid "　じき日没を迎える森には<痩身|そうしん>の人影があった。"
msgstr ""

msgctxt "text_id=9018 | speaker=unknown"
msgid "　人影はきょろきょろと森を見渡しながら、草むらに埋もれたビニール袋や不法投棄された自転車を片付けたり、まれに、折れかかった木の枝などを補強したり、ひと思いに伐採などしていたりする。"
msgstr ""

msgctxt "text_id=9019 | speaker=unknown"
msgid "「む、これはひどい」"
msgstr ""

msgctxt "text_id=9020 | speaker=unknown"
msgid "　おそらく洋館に住んでいる人物、どちらかの手によるものだろう。"
msgstr ""

msgctxt "text_id=9021 | speaker=unknown"
msgid "　館の物置に放置されたゴミ袋が野犬によってここまで運ばれ、無惨に食い散らかされていた。"
msgstr ""

msgctxt "text_id=9022 | speaker=unknown"
msgid "　彼は持参した竹箒を片手に、黙々とゴミを片づける。"
msgstr ""

msgctxt "text_id=9023 | speaker=unknown"
msgid "「………………」"
msgstr ""

msgctxt "text_id=9024 | speaker=unknown"
msgid "　有珠は散歩中という<体|てい>で、その人影に出くわした。"
msgstr ""

msgctxt "text_id=9025 | speaker=unknown"
msgid "　<一月|ひとつき>に一度あるかないかの森の散歩が今である理由は、あえて語るまでもない。"
msgstr ""

msgctxt "text_id=9026 | speaker=unknown"
msgid "「静希君」"
msgstr ""

msgctxt "text_id=9027 | speaker=unknown"
msgid "「こんにちは。今から外出？」"
msgstr ""

msgctxt "text_id=9028 | speaker=unknown"
msgid "　気軽に挨拶など返される。"
msgstr ""

msgctxt "text_id=9029 | speaker=unknown"
msgid "　有珠は努めて視線を冷たくして、森の様子を観察した。"
msgstr ""

msgctxt "text_id=9030 | speaker=unknown"
msgid "「出かけないわ。"
msgstr ""

msgctxt "text_id=9031 | speaker=unknown"
msgid "そういう貴方は何を？　青子と一緒に帰ってくるものと思っていたけど、青子は？」"
msgstr ""

msgctxt "text_id=9032 | speaker=unknown"
msgid "「蒼崎ならまだ学校。こっちはバイトが早めに終わったんで、ここで暇を潰している。"
msgstr ""

msgctxt "text_id=9033 | speaker=unknown"
msgid "夕方になったら正門で蒼崎と合流して、洋館に戻るよ」"
msgstr ""

msgctxt "text_id=9034 | speaker=unknown"
msgid "「……そう。でも、貴方が先に帰ってきている事を、青子には伝えてあるの？」"
msgstr ""

msgctxt "text_id=9035 | speaker=unknown"
msgid "「あ」"
msgstr ""

msgctxt "text_id=9036 | speaker=unknown"
msgid "　しまった、と草十郎は不安げに言葉を切った。"
msgstr ""

msgctxt "text_id=9037 | speaker=unknown"
msgid "“いい？　洋館の正門前、五時だからね！”"
msgstr ""

msgctxt "text_id=9038 | speaker=unknown"
msgid "　その約束は当然守る気満々だった。"
msgstr ""

msgctxt "text_id=9039 | speaker=unknown"
msgid "　が、今にして思うと、それは“五時まで洋館に入るな”というコトだったのかもしれない。"
msgstr ""

msgctxt "text_id=9040 | speaker=unknown"
msgid "「……申し訳ない。蒼崎には黙っていてくれると助かる」"
msgstr ""

msgctxt "text_id=9041 | speaker=unknown"
msgid "「別に。青子との会話で、貴方の話題があがる事はないから気にしないで。"
msgstr ""

msgctxt "text_id=9042 | speaker=unknown"
msgid "　……それより何をしているの？　貴方と青子、今日から期末試験でしょう？　勉強、しなくていいの？」"
msgstr ""

msgctxt "text_id=9043 | speaker=unknown"
msgid "「うん？　勉強ならちゃんとするよ。"
msgstr ""

msgctxt "text_id=9044 | speaker=unknown"
msgid "　寝る前にきちんと、二時間」"
msgstr ""

msgctxt "text_id=9045 | speaker=unknown"
msgid "　どうも、彼にはまだ“試験前は念入りに復習をする”知恵がないようだ。"
msgstr ""

msgctxt "text_id=9046 | speaker=unknown"
msgid "　その考えはこの数時間後に<改|あらた>められる事になるが、今はまだ先の話だ。"
msgstr ""

msgctxt "text_id=9047 | speaker=unknown"
msgid "「それより森の荒れ具合が気になって。"
msgstr ""

msgctxt "text_id=9048 | speaker=unknown"
msgid "　この丘、どのくらいほったらかしだったんだ？」"
msgstr ""

msgctxt "text_id=9049 | speaker=unknown"
msgid "「…………」"
msgstr ""

msgctxt "text_id=9050 | speaker=unknown"
msgid "　有珠は答えない。"
msgstr ""

msgctxt "text_id=9051 | speaker=unknown"
msgid "　彼女がこの土地に住みはじめて三年ほど経つが、口にする必要はない。"
msgstr ""

msgctxt "text_id=9052 | speaker=unknown"
msgid "　沈黙する有珠が気にならないのか、草十郎はひょいひょいとマイペースにゴミを拾っていく。"
msgstr ""

msgctxt "text_id=9053 | speaker=unknown"
msgid "　少女から見ると<厚|あつ>かましいコトこの上ない。"
msgstr ""

msgctxt "text_id=9054 | speaker=unknown"
msgid "「―――貴方」"
msgstr ""

msgctxt "text_id=9055 | speaker=unknown"
msgid "　今すぐ消えて、と続きかねない声。"
msgstr ""

msgctxt "text_id=9056 | speaker=unknown"
msgid "「あいたっ」"
msgstr ""

msgctxt "text_id=9057 | speaker=unknown"
msgid "　それを、間の抜けた声が押し止めた。"
msgstr ""

msgctxt "text_id=9058 | speaker=unknown"
msgid "「いたた……なんか硬いの蹴ったぞ、今」"
msgstr ""

msgctxt "text_id=9059 | speaker=unknown"
msgid "　草十郎の足下には、錆びた金属の固まりが埋もれていた。"
msgstr ""

msgctxt "text_id=9060 | speaker=unknown"
msgid "「鉄の……なんだろう、このギサギザ。危ないけど、これ閉じるのか？」"
msgstr ""

msgctxt "text_id=9061 | speaker=unknown"
msgid "　不思議そうに足下の危険物を観察する。"
msgstr ""

msgctxt "text_id=9062 | speaker=unknown"
msgid "　それが野生の獣の<脚|あし>を捕らえる<道具|ワナ>である事を、彼は知らないらしい。"
msgstr ""

msgctxt "text_id=9063 | speaker=unknown"
msgid "「……<虎挟|とらばさ>みね。昔、この山には野犬が多くいたというから、その頃のものでしょう。"
msgstr ""

msgctxt "text_id=9064 | speaker=unknown"
msgid "　街の人たちが忘れていったのよ、きっと」"
msgstr ""

msgctxt "text_id=9065 | speaker=unknown"
msgid "「野犬……これ、犬を捕まえる道具なのか？」"
msgstr ""

msgctxt "text_id=9066 | speaker=unknown"
msgid "「ええ。踏みつけると、その口みたいなのがバネで閉じると聞いたわ。"
msgstr ""

msgctxt "text_id=9067 | speaker=unknown"
msgid "実際に稼働するところは見た事がないけれど」"
msgstr ""

msgctxt "text_id=9068 | speaker=unknown"
msgid "「そうなのか。でもこんな見え見えの仕掛け、引っかかる動物がいるのかな」"
msgstr ""

msgctxt "text_id=9069 | speaker=unknown"
msgid "　素朴な疑問に、たしかに、と有珠は頷いた。"
msgstr ""

msgctxt "text_id=9070 | speaker=unknown"
msgid "　虎挟みなんてものを見たのは子供の時以来だが、彼女も前から妙に思っていたのだ。"
msgstr ""

msgctxt "text_id=9071 | speaker=unknown"
msgid "　有珠は獣たちの<賢|かしこ>さを知っている。"
msgstr ""

msgctxt "text_id=9072 | speaker=unknown"
msgid "　なのにどうして、彼らはこんなあからさまな罠に食いつかれて、人間の手にかかってきたのか？"
msgstr ""

msgctxt "text_id=9073 | speaker=unknown"
msgid "「…………食べ物とか、置くのかも」"
msgstr ""

msgctxt "text_id=9074 | speaker=unknown"
msgid "　つい、思いつきが声にでる。"
msgstr ""

msgctxt "text_id=9075 | speaker=unknown"
msgid "「食べ物ほしさに、こんな、見るからに痛そうなものに近づくかな」"
msgstr ""

msgctxt "text_id=9076 | speaker=unknown"
msgid "「それはそうだけど、時と場合によるでしょう。"
msgstr ""

msgctxt "text_id=9077 | speaker=unknown"
msgid "　動物だって、死にそうなぐらいお腹が減っていたら、誘惑には勝てないわ。"
msgstr ""

msgctxt "text_id=9078 | speaker=unknown"
msgid "　罠にかかっても傷つくのは片足だけでしょうし。危ないと分かっていても、飢えて死ぬよりはいいと食べてしまうのではないかしら」"
msgstr ""

msgctxt "text_id=9079 | speaker=unknown"
msgid "　……そう。"
msgstr ""

msgctxt "text_id=9080 | speaker=unknown"
msgid "　たとえその後、猟師の手による死が待っていようと、目前の飢餓には耐えられない。"
msgstr ""

msgctxt "text_id=9081 | speaker=unknown"
msgid "　それが子供を養う親だったら尚更だ。"
msgstr ""

msgctxt "text_id=9082 | speaker=unknown"
msgid "　親犬は子供のために片足を犠牲にして、餌を手に入れた代償として狩られてしまう。"
msgstr ""

msgctxt "text_id=9083 | speaker=unknown"
msgid "　はじめから危険と分かった上での挑戦……なのかもしれない。"
msgstr ""

msgctxt "text_id=9084 | speaker=unknown"
msgid "　動物たちは生き残る為なら片足ぐらいと決断して、結果的に殺されてしまうだけの話。"
msgstr ""

msgctxt "text_id=9085 | speaker=unknown"
msgid "「人間と変わらないわ。"
msgstr ""

msgctxt "text_id=9086 | speaker=unknown"
msgid "　片手を失うことで死なずに済むのなら、それぐらいの取捨選択はすると思う」"
msgstr ""

msgctxt "text_id=9087 | speaker=unknown"
msgid "　自分を納得させるように少女は断言する。"
msgstr ""

msgctxt "text_id=9088 | speaker=unknown"
msgid "　それを、"
msgstr ""

msgctxt "text_id=9089 | speaker=unknown"
msgid "「どうだろう。人間と動物は、ちょっと違うんじゃないかな」"
msgstr ""

msgctxt "text_id=9090 | speaker=unknown"
msgid "　再度、自信なげな声が押し止めた。"
msgstr ""

msgctxt "text_id=9091 | speaker=unknown"
msgid "「……違うって、なにが？」"
msgstr ""

msgctxt "text_id=9092 | speaker=unknown"
msgid "「片足を犠牲にして助かろうってところ、かな。"
msgstr ""

msgctxt "text_id=9093 | speaker=unknown"
msgid "　動物には無駄がない。あれこれ考える知恵もない。"
msgstr ""

msgctxt "text_id=9094 | speaker=unknown"
msgid "　だから俺たちみたいに、<無|・><く|・><な|・><っ|・><た|・><ら|・><別|・><の|・><物|・><で|・><補|・><う|・>、なんて選択が、そもそもないんだ」"
msgstr ""

msgctxt "text_id=9095 | speaker=unknown"
msgid "「動物にとって、片足を無くすコトは命を無くすコトと変わらない。"
msgstr ""

msgctxt "text_id=9096 | speaker=unknown"
msgid "無駄がないという在り方は、何も失えない在り方なんだと思う。動物はみんな、少しでも自分の<価値|からだ>が欠けたら、もう生きていけない事を知っている」"
msgstr ""

msgctxt "text_id=9097 | speaker=unknown"
msgid "「……だから、この罠を見て、それでも進もうとした時、彼らには“足ぐらいなくなっても”なんて思いはないんじゃないかな。"
msgstr ""

msgctxt "text_id=9098 | speaker=unknown"
msgid "　はじめから助かる気はない。片足を失うと認めた時点で、彼らは自分の命そのものを差しだしている」"
msgstr ""

msgctxt "text_id=9099 | speaker=unknown"
msgid "　予想外の意見だったが、なるほど、と少女は受け入れた。"
msgstr ""

msgctxt "text_id=9100 | speaker=unknown"
msgid "　この少年は都会生まれではなく、まだ自然と共存している山村で育った人間だ。"
msgstr ""

msgctxt "text_id=9101 | speaker=unknown"
msgid "　文明で武装し、弱いもの、老いたものを助けてくれる社会に生まれたものではない。"
msgstr ""

msgctxt "text_id=9102 | speaker=unknown"
msgid "　これまでの彼の在り方は、創意工夫に満ちた便利な日々ではなく、自然との共存による生活だったのだろう。"
msgstr ""

msgctxt "text_id=9103 | speaker=unknown"
msgid "　そんな草十郎にとって、傷とは傷のまま、永遠に残るものだったに違いない。"
msgstr ""

msgctxt "text_id=9104 | speaker=unknown"
msgid "　そうでなければ、自然に生きる動物の在り方を口にできない。"
msgstr ""

msgctxt "text_id=9105 | speaker=unknown"
msgid "　……彼の言うことはもっともだ。"
msgstr ""

msgctxt "text_id=9106 | speaker=unknown"
msgid "　足を負傷して走れなくなった馬は、もう「馬」として機能せず、人々からも「馬」として見られないように。"
msgstr ""

msgctxt "text_id=9107 | speaker=unknown"
msgid "　野生の獣は、その手足を走らせる機能を<損|そこ>なった時点で、<生命|いのち>より先に己の<意義|かち>を<喪|うしな>うのだ―――"
msgstr ""

msgctxt "text_id=9108 | speaker=unknown"
msgid "「でもコレ、一度でも獲物を捕まえたコトがあるのかな」"
msgstr ""

msgctxt "text_id=9109 | speaker=unknown"
msgid "「さあ。仕掛けたのはわたしじゃないから」"
msgstr ""

msgctxt "text_id=9110 | speaker=unknown"
msgid "　親しげに話しかけられ、有珠は気を引き締めて返答した。"
msgstr ""

msgctxt "text_id=9111 | speaker=unknown"
msgid "　つい話し込んでしまったが、有珠にとってみれば虎挟みよりこの少年の方が何倍も邪魔なのだ。"
msgstr ""

msgctxt "text_id=9112 | speaker=unknown"
msgid "「それより。森の手入れをしているようだけど、何のつもり？　わたしへのご機嫌<伺|うかが>い？」"
msgstr ""

msgctxt "text_id=9113 | speaker=unknown"
msgid "　少女の瞳に敵意がともる。"
msgstr ""

msgctxt "text_id=9114 | speaker=unknown"
msgid "　自分に媚びへつらった時点で、有珠は草十郎を自分流に処置しようと決めていた。"
msgstr ""

msgctxt "text_id=9115 | speaker=unknown"
msgid "　不義理もいい。絶交もいい。裏切りもいい。"
msgstr ""

msgctxt "text_id=9116 | speaker=unknown"
msgid "　けれど、心にもない言葉で話しかけられる事だけは許せない。"
msgstr ""

msgctxt "text_id=9117 | speaker=unknown"
msgid "　それは少女にとって、何よりも重い侮辱だった。"
msgstr ""

msgctxt "text_id=9118 | speaker=unknown"
msgid "「うん？　森の手入れをすると、なんでそっちの機嫌が良くなるんだ？"
msgstr ""

msgctxt "text_id=9119 | speaker=unknown"
msgid "　こんなに荒れ放題なんだから、ふたりともこの森はあんまり好きじゃないんだろ。森がきれいになって気分が良くなるのは、俺だけだと思うけど」"
msgstr ""

msgctxt "text_id=9120 | speaker=unknown"
msgid "　が。有珠の敵意も、この少年にはまったく伝わらなかったようだ。"
msgstr ""

msgctxt "text_id=9121 | speaker=unknown"
msgid "「……待って。たしかに森には手を入れていないけれど、嫌いな訳じゃない。愛情はそれなりにあるわ」"
msgstr ""

msgctxt "text_id=9122 | speaker=unknown"
msgid "「それはヘンだ。なら、どうして放っておく」"
msgstr ""

msgctxt "text_id=9123 | speaker=unknown"
msgid "「愛情はあっても愛着はないだけよ。"
msgstr ""

msgctxt "text_id=9124 | speaker=unknown"
msgid "……でも反省したわ。これからは森の手入れも日課にいれる。"
msgstr ""

msgctxt "text_id=9125 | speaker=unknown"
msgid "　けど、貴方だっておかしいでしょう？"
msgstr ""

msgctxt "text_id=9126 | speaker=unknown"
msgid "　この森のどこに、貴方が気に入るものがあるの？」"
msgstr ""

msgctxt "text_id=9127 | speaker=unknown"
msgid "「おかしくはない。"
msgstr ""

msgctxt "text_id=9128 | speaker=unknown"
msgid "森はたいてい好きだし、この丘、ちょっと故郷の山に似ているし。"
msgstr ""

msgctxt "text_id=9129 | speaker=unknown"
msgid "　ほら。好きだった子にそっくりな子が困ってたら、なんとかしてあげようと思わないか？」"
msgstr ""

msgctxt "text_id=9130 | speaker=unknown"
msgid "“なんというか、人間として”"
msgstr ""

msgctxt "text_id=9131 | speaker=unknown"
msgid "　などと締めくくる草十郎。"
msgstr ""

msgctxt "text_id=9132 | speaker=unknown"
msgid "　その余計な一言は、有珠の心をかき乱すには十分だった。"
msgstr ""

msgctxt "text_id=9133 | speaker=unknown"
msgid "「……納得いかない。それだけで大切に扱うの？"
msgstr ""

msgctxt "text_id=9134 | speaker=unknown"
msgid "　本当はわたしへの当てつけなんでしょう？"
msgstr ""

msgctxt "text_id=9135 | speaker=unknown"
msgid "　だいたい、こんな森が好きなんておかしいわ。オークの木も根付かない、どこにでもある普通の森なのに」"
msgstr ""

msgctxt "text_id=9136 | speaker=unknown"
msgid "「？　別にそれでいいじゃないか。"
msgstr ""

msgctxt "text_id=9137 | speaker=unknown"
msgid "　森は普通にあるだけでいいんだ。なにもおかしくない。きれいなものをきれいと思うのは、いい事だと思うんだが」"
msgstr ""

msgctxt "text_id=9138 | speaker=unknown"
msgid "「……明確な理由もないのに？　この世のすべての森が好きだっていうの？"
msgstr ""

msgctxt "text_id=9139 | speaker=unknown"
msgid "　貴方とこの森には何の因果関係もないわ。"
msgstr ""

msgctxt "text_id=9140 | speaker=unknown"
msgid "　文脈として、貴方がこの森を好きになる理由がない。"
msgstr ""

msgctxt "text_id=9141 | speaker=unknown"
msgid "　理由がないなら、それはわたしへの―――」"
msgstr ""

msgctxt "text_id=9142 | speaker=unknown"
msgid "「？　好きってコトに理由は必要なのか？」"
msgstr ""

msgctxt "text_id=9143 | speaker=unknown"
msgid "「え―――」"
msgstr ""

msgctxt "text_id=9144 | speaker=unknown"
msgid "　不思議なものを見るように少年は言った。"
msgstr ""

msgctxt "text_id=9145 | speaker=unknown"
msgid "　それは、愛情に理由はいらない、という意味ではなく。"
msgstr ""

msgctxt "text_id=9146 | speaker=unknown"
msgid "　理由のない<感|も><情|の>はすべて嘘なのかと、問い返すような言葉だった。"
msgstr ""

msgctxt "text_id=9147 | speaker=unknown"
msgid "　……カッと沸き立っていた胸が冷めていく。"
msgstr ""

msgctxt "text_id=9148 | speaker=unknown"
msgid "　少女は声を荒らげた自分を恥じて、一歩、少年から身を引いた。"
msgstr ""

msgctxt "text_id=9149 | speaker=unknown"
msgid "「――――――」"
msgstr ""

msgctxt "text_id=9150 | speaker=unknown"
msgid "「………………」"
msgstr ""

msgctxt "text_id=9151 | speaker=unknown"
msgid "　気まずい沈黙。"
msgstr ""

msgctxt "text_id=9152 | speaker=unknown"
msgid "　有珠は何か、自分なりの<矜持|きょうじ>を示そうと言葉を探していた。"
msgstr ""

msgctxt "text_id=9153 | speaker=unknown"
msgid "　やりこめられたままでは立場が逆だ。"
msgstr ""

msgctxt "text_id=9154 | speaker=unknown"
msgid "　何しろここは自分の森、彼女の世界。"
msgstr ""

msgctxt "text_id=9155 | speaker=unknown"
msgid "　こんな、ただの人間に言い負かされたままでは魔女の<沽券|こけん>に関わると唇を噛んでいる。"
msgstr ""

msgctxt "text_id=9156 | speaker=unknown"
msgid "「ところで。これは残しておく？」"
msgstr ""

msgctxt "text_id=9157 | speaker=unknown"
msgid "　一方。そんな彼女の戦意もどこ吹く風で、草十郎は虎挟みに手を伸ばす。"
msgstr ""

msgctxt "text_id=9158 | speaker=unknown"
msgid "「……必要ないわ。わたしのものではないと言ったでしょう」"
msgstr ""

msgctxt "text_id=9159 | speaker=unknown"
msgid "「そっか。なら回収しよう。もう錆びて動かないけど、犬の歯みたいで物騒だ。残しておくと夢に見そうだし」"
msgstr ""

msgctxt "text_id=9160 | speaker=unknown"
msgid "　よいしょ、と重い鉄の塊を持ち上げる草十郎。"
msgstr ""

msgctxt "text_id=9161 | speaker=unknown"
msgid "　少年はそのまま木の陰まで歩いていくと、おかしなモノに虎挟みを放りこんだ。"
msgstr ""

msgctxt "text_id=9162 | speaker=unknown"
msgid "「……静希君。そのリヤカー、どこにあったの？」"
msgstr ""

msgctxt "text_id=9163 | speaker=unknown"
msgid "「どこって、町のお店だよ。"
msgstr ""

msgctxt "text_id=9164 | speaker=unknown"
msgid "　もしかしたらと思って買ってきて正解だった。ここのところ、どうしてか悪い予感だけはあたるんだ」"
msgstr ""

msgctxt "text_id=9165 | speaker=unknown"
msgid "　嬉しそうにリヤカーを移動させる、謎のボランティアマスター。"
msgstr ""

msgctxt "text_id=9166 | speaker=unknown"
msgid "　その笑顔を見て、この少年につっかかるのがどれだけ時間の無駄なのか、有珠はようやく悟った。"
msgstr ""

msgctxt "text_id=9167 | speaker=unknown"
msgid "「………そう。話しかけたわたしが、どうかしていたわ」"
msgstr ""

msgctxt "text_id=9168 | speaker=unknown"
msgid "　少年に背を向けて、洋館に足を向ける。"
msgstr ""

msgctxt "text_id=9169 | speaker=unknown"
msgid "　……まったく、青子の言うとおりだ。"
msgstr ""

msgctxt "text_id=9170 | speaker=unknown"
msgid "　余計な時間を使ったと反省しながら、有珠は徹底的に、あの少年は無視しようと<自|みずか>らに言い聞かせた。"
msgstr ""

#. Occurrence 7_2:49:9171: scene=7_2
#: 7_2:49
msgctxt "text_id=9171 | speaker=unknown"
msgid "　私立という事もあって、三咲高校の冬休みは早い。"
msgstr ""

#. Occurrence 7_2:54:9172: scene=7_2
#: 7_2:54
msgctxt "text_id=9172 | speaker=unknown"
msgid "　十二月の<半|なか>ばには終業式を<迎|むか>え、校舎と生徒たちはつかの間、二学期までの疲れを癒す事になる。"
msgstr ""

#. Occurrence 7_2:59:9173: scene=7_2
#: 7_2:59
msgctxt "text_id=9173 | speaker=unknown"
msgid "　無論。"
msgstr ""

#. Occurrence 7_2:64:9174: scene=7_2
#: 7_2:64
msgctxt "text_id=9174 | speaker=unknown"
msgid "　彼らにとっては恒例の関門、幸せな長期休日の前に立ちはだかる<期末試験|みっかかん>を無事に乗り越えられたら、の話であるが。"
msgstr ""

#. Occurrence 7_2:122:9175: scene=7_2
#: 7_2:122
msgctxt "text_id=9175 | speaker=unknown"
msgid "　深夜放送を受信するラジオ。"
msgstr ""

#. Occurrence 7_2:127:9176: scene=7_2
#: 7_2:127
msgctxt "text_id=9176 | speaker=unknown"
msgid "　<台所|した>まで下りる手間をはぶく、紅茶用の魔法瓶。"
msgstr ""

#. Occurrence 7_2:132:9177: scene=7_2
#: 7_2:132
msgctxt "text_id=9177 | speaker=unknown"
msgid "　冬の寒さから足を守る電気毛布と、夜食のカニパン。"
msgstr ""

#. Occurrence 7_2:150:9178: scene=7_2
#: 7_2:150
msgctxt "text_id=9178 | speaker=unknown"
msgid "　このように。"
msgstr ""

#. Occurrence 7_2:155:9179: scene=7_2
#: 7_2:155
msgctxt "text_id=9179 | speaker=unknown"
msgid "　青子の部屋は<一分|いちぶ>の<隙|すき>もない、一夜漬け強制空間になっていた。"
msgstr ""

#. Occurrence 7_2:187:9180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0000; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:187
msgctxt "text_id=9180 | speaker=aoko"
msgid "「期末試験一日目、ご苦労さま。"
msgstr ""

#. Occurrence 7_2:193:9181: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0001; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:193
msgctxt "text_id=9181 | speaker=aoko"
msgid "　それで、生まれ変わる覚悟はできた？」"
msgstr ""

#. Occurrence 7_2:214:9182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0000; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:214
msgctxt "text_id=9182 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_2:219:9183: scene=7_2
#: 7_2:219
msgctxt "text_id=9183 | speaker=unknown"
msgid "　こくこく、と頷く草十郎。"
msgstr ""

#. Occurrence 7_2:224:9184: scene=7_2
#: 7_2:224
msgctxt "text_id=9184 | speaker=unknown"
msgid "　アルバイトから戻ってきた彼を待っていたのは、魔術師ではなく、鬼の生徒会長としての蒼崎青子だった。"
msgstr ""

#. Occurrence 7_2:257:9185: scene=7_2
#: 7_2:257
msgctxt "text_id=9185 | speaker=unknown"
msgid "　時をさかのぼること半日前。"
msgstr ""

#. Occurrence 7_2:275:9186: scene=7_2
#: 7_2:275
msgctxt "text_id=9186 | speaker=unknown"
msgid "　期末試験一日目を終え、かねてからの計画を実行しようと洋館に向かう草十郎の前に、"
msgstr ""

#. Occurrence 7_2:300:9187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0002; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:300
msgctxt "text_id=9187 | speaker=aoko"
msgid "「今夜、私の部屋で監禁ね。"
msgstr ""

#. Occurrence 7_2:306:9188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0003; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:306
msgctxt "text_id=9188 | speaker=aoko"
msgid "　あ、夕方からのアルバイトは当然キャンセル。ちょっと本気で、あの点数はあり得ないから」"
msgstr ""

#. Occurrence 7_2:316:9189: scene=7_2
#: 7_2:316
msgctxt "text_id=9189 | speaker=unknown"
msgid "　青い炎に包まれた笑顔が現れたのである。"
msgstr ""

#. Occurrence 7_2:321:9190: scene=7_2
#: 7_2:321
msgctxt "text_id=9190 | speaker=unknown"
msgid "　その手にはしわくちゃに握りしめられた静希草十郎のテスト用紙。"
msgstr ""

#. Occurrence 7_2:361:9191: scene=7_2
#: 7_2:361
msgctxt "text_id=9191 | speaker=unknown"
msgid "　おそらく職員室で山城教諭から"
msgstr ""

#. Occurrence 7_2:367:9192: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_2_0000; voice_prefix=B60; voice_category=7; scene=7_2
#: 7_2:367
msgctxt "text_id=9192 | speaker=yamashiro"
msgid "『ま、転校してきたばかりだし、しょうがないよね』"
msgstr ""

#. Occurrence 7_2:372:9193: scene=7_2
#: 7_2:372
msgctxt "text_id=9193 | speaker=unknown"
msgid "　と見せられたものを、<勢|いきお>い<奪|うば>い取ってきたに違いない。"
msgstr ""

#. Occurrence 7_2:419:9194: scene=7_2
#: 7_2:419
msgctxt "text_id=9194 | speaker=unknown"
msgid "　かくして、今日まで屋根裏部屋で寝泊りしていた草十郎は、この日にかぎって青子の部屋に通された。"
msgstr ""

#. Occurrence 7_2:439:9195: scene=7_2
#: 7_2:439
msgctxt "text_id=9195 | speaker=unknown"
msgid "　色々疑問視する点はあるものの、青子とて年頃の女学生である。"
msgstr ""

#. Occurrence 7_2:445:9196: scene=7_2
#: 7_2:445
msgctxt "text_id=9196 | speaker=unknown"
msgid "同年代の男子を自分の部屋に立ち入らせることに抵抗はある。"
msgstr ""

#. Occurrence 7_2:450:9197: scene=7_2
#: 7_2:450
msgctxt "text_id=9197 | speaker=unknown"
msgid "　が、それ以上に草十郎の答案用紙はあり得なかったのだ。"
msgstr ""

#. Occurrence 7_2:455:9198: scene=7_2
#: 7_2:455
msgctxt "text_id=9198 | speaker=unknown"
msgid "　なので、今日の不機嫌度は五割増し。彼女のこめかみから怒りマークがとれないのも無理からぬ事である。"
msgstr ""

#. Occurrence 7_2:480:9199: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0004; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:480
msgctxt "text_id=9199 | speaker=aoko"
msgid "「先に自分の復習、済ませる。"
msgstr ""

#. Occurrence 7_2:486:9200: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0005; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:486
msgctxt "text_id=9200 | speaker=aoko"
msgid "　アンタはそのテーブル使ってて」"
msgstr ""

#. Occurrence 7_2:496:9201: scene=7_2
#: 7_2:496
msgctxt "text_id=9201 | speaker=unknown"
msgid "　青子はテーブルに背を向け、愛用の机に向かった。"
msgstr ""

#. Occurrence 7_2:501:9202: scene=7_2
#: 7_2:501
msgctxt "text_id=9202 | speaker=unknown"
msgid "　一方、草十郎の前には安物のガラステーブルが一つ。"
msgstr ""

#. Occurrence 7_2:526:9203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0001; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:526
msgctxt "text_id=9203 | speaker=soujuurou"
msgid "「……なんか色々と慣れないな。"
msgstr ""

#. Occurrence 7_2:545:9204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0002; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:545
msgctxt "text_id=9204 | speaker=soujuurou"
msgid "　なあ蒼崎、この青いのなんだ？」"
msgstr ""

#. Occurrence 7_2:551:9205: scene=7_2
#: 7_2:551
msgctxt "text_id=9205 | speaker=unknown"
msgid "　落ち着かないのか、草十郎は部屋の隅にたてかけられたギターを眺める。"
msgstr ""

#. Occurrence 7_2:587:9206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0003; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:587
msgctxt "text_id=9206 | speaker=soujuurou"
msgid "「なんか薄いし青いしとんがってるし、きっと蒼崎の事だし。"
msgstr ""

#. Occurrence 7_2:594:9207: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0004; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:594
msgctxt "text_id=9207 | speaker=soujuurou"
msgid "……もしかしなくても、武器か？」"
msgstr ""

#. Occurrence 7_2:600:9208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0006; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:600
msgctxt "text_id=9208 | speaker=aoko"
msgid "「楽器よそれ。エレキはともかく、アコギは音楽室で似たようなのあったでしょう。あとこれ以上<青青|あおあお>言ったら、そのとんがってるので殴るからね」"
msgstr ""

#. Occurrence 7_2:632:9209: scene=7_2
#: 7_2:632
msgctxt "text_id=9209 | speaker=unknown"
msgid "　やっぱり武器じゃないか、という感想を<堪|こら>えて、草十郎もクッションに腰を下ろす。"
msgstr ""

#. Occurrence 7_2:684:9210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0005; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:684
msgctxt "text_id=9210 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_2:706:9211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0007; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:706
msgctxt "text_id=9211 | speaker=aoko"
msgid "「ちょっとは落ち着きなさいよ。いつもは耳の遠い大型犬みたいに鈍感なクセに。何か気になるものでもあるの？」"
msgstr ""

#. Occurrence 7_2:725:9212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0006; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:725
msgctxt "text_id=9212 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 7_2:730:9213: scene=7_2
#: 7_2:730
msgctxt "text_id=9213 | speaker=unknown"
msgid "　この場合、鈍感なのは青子の方なのだが、"
msgstr ""

#. Occurrence 7_2:735:9214: scene=7_2
#: 7_2:735
msgctxt "text_id=9214 | speaker=unknown"
msgid "　草十郎もなぜ自分が落ち着かないのか分かっていないので、鈍感なのはお互い様である。"
msgstr ""

#. Occurrence 7_2:759:9215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0008; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:759
msgctxt "text_id=9215 | speaker=aoko"
msgid "「あ、もしかして内装？　この部屋の家具のグレードが居間とは違うから不思議がってるのね。"
msgstr ""

#. Occurrence 7_2:765:9216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0009; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:765
msgctxt "text_id=9216 | speaker=aoko"
msgid "　ここ、ベッド以外は私の家から持ちこんだ物なの。引っ越してから二年経つけど、まだ屋敷には馴染んでないでしょ？」"
msgstr ""

#. Occurrence 7_2:801:9217: scene=7_2
#: 7_2:801
msgctxt "text_id=9217 | speaker=unknown"
msgid "　そわそわと落ち着かない草十郎の心情を曲解、納得いったのか、青子は自分の勉強を始めてしまう。"
msgstr ""

#. Occurrence 7_2:806:9218: scene=7_2
#: 7_2:806
msgctxt "text_id=9218 | speaker=unknown"
msgid "　早送りのようにめくられていくノートと教科書。"
msgstr ""

#. Occurrence 7_2:811:9219: scene=7_2
#: 7_2:811
msgctxt "text_id=9219 | speaker=unknown"
msgid "　そこに余人の立ち入る隙間はない。"
msgstr ""

#. Occurrence 7_2:831:9220: scene=7_2
#: 7_2:831
msgctxt "text_id=9220 | speaker=unknown"
msgid "　青子の背中から立ち上るオーラに圧倒され、草十郎も気を引き締めてテーブルに向かった。"
msgstr ""

#. Occurrence 7_2:836:9221: scene=7_2
#: 7_2:836
msgctxt "text_id=9221 | speaker=unknown"
msgid "　完全に無視されていながら平然と自分の作業に入れるあたり、草十郎も只者ではない。"
msgstr ""

#. Occurrence 7_2:885:9222: scene=7_2
#: 7_2:885
msgctxt "text_id=9222 | speaker=unknown"
msgid "　それから二時間。"
msgstr ""

#. Occurrence 7_2:908:9223: scene=7_2
#: 7_2:908
msgctxt "text_id=9223 | speaker=unknown"
msgid "　十一時近くなって、ようやく青子の<集中力|スピード>が減速していった。"
msgstr ""

#. Occurrence 7_2:913:9224: scene=7_2
#: 7_2:913
msgctxt "text_id=9224 | speaker=unknown"
msgid "　それを<頃合|ころあ>いと見て、草十郎は凛と伸びた青子の背中に話しかけた。"
msgstr ""

#. Occurrence 7_2:934:9225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0007; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:934
msgctxt "text_id=9225 | speaker=soujuurou"
msgid "「蒼崎、ちょっといいかな」"
msgstr ""

#. Occurrence 7_2:940:9226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0010; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:940
msgctxt "text_id=9226 | speaker=aoko"
msgid "「ん、なに？」"
msgstr ""

#. Occurrence 7_2:946:9227: scene=7_2
#: 7_2:946
msgctxt "text_id=9227 | speaker=unknown"
msgid "　遠慮がちな声に、青子は振り向かずに応えた。"
msgstr ""

#. Occurrence 7_2:951:9228: scene=7_2
#: 7_2:951
msgctxt "text_id=9228 | speaker=unknown"
msgid "　減速しているといっても、青子のノートをめくる動作は止まらない。"
msgstr ""

#. Occurrence 7_2:972:9229: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0008; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:972
msgctxt "text_id=9229 | speaker=soujuurou"
msgid "「この三日間、蒼崎たちの夕食事情を見てきたけど。"
msgstr ""

#. Occurrence 7_2:978:9230: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0009; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:978
msgctxt "text_id=9230 | speaker=soujuurou"
msgid "　君たちの食事はいつもああなのか？」"
msgstr ""

#. Occurrence 7_2:984:9231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0011; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:984
msgctxt "text_id=9231 | speaker=aoko"
msgid "「そうだけど、おかしい？」"
msgstr ""

#. Occurrence 7_2:1000:9232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0010; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1000
msgctxt "text_id=9232 | speaker=soujuurou"
msgid "「む……そう言われると困るな。"
msgstr ""

#. Occurrence 7_2:1011:9233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0011; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1011
msgctxt "text_id=9233 | speaker=soujuurou"
msgid "　ただ、学校じゃみんな楽しそうだった。誰かと食事を摂るって事は、ああいう風になるコトだって思ってた。だから、もしかすると」"
msgstr ""

#. Occurrence 7_2:1045:9234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0012; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1045
msgctxt "text_id=9234 | speaker=aoko"
msgid "「もしかしないわよ。別にアンタのせいで有珠と話さないワケじゃないわ。私たちはいつもああだから」"
msgstr ""

#. Occurrence 7_2:1051:9235: scene=7_2
#: 7_2:1051
msgctxt "text_id=9235 | speaker=unknown"
msgid "　平然と語る青子の背中は、そんな事実をどうも思っていないようだった。"
msgstr ""

#. Occurrence 7_2:1082:9236: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0012; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1082
msgctxt "text_id=9236 | speaker=soujuurou"
msgid "「張りつめた食卓だな。"
msgstr ""

#. Occurrence 7_2:1088:9237: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0013; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1088
msgctxt "text_id=9237 | speaker=soujuurou"
msgid "　蒼崎と有珠は、仲がいいと思ってたのに」"
msgstr ""

#. Occurrence 7_2:1094:9238: scene=7_2
#: 7_2:1094
msgctxt "text_id=9238 | speaker=unknown"
msgid "　青子は否定も肯定もしない。"
msgstr ""

#. Occurrence 7_2:1099:9239: scene=7_2
#: 7_2:1099
msgctxt "text_id=9239 | speaker=unknown"
msgid "　ただ、草十郎の残念そうな呟きが、少しだけ意外だった。"
msgstr ""

#. Occurrence 7_2:1120:9240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0013; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1120
msgctxt "text_id=9240 | speaker=aoko"
msgid "「ま、張りつめた食卓っていうのは合ってるわね。"
msgstr ""

#. Occurrence 7_2:1126:9241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0014; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1126
msgctxt "text_id=9241 | speaker=aoko"
msgid "　有珠が何回アンタの飲み物にメスカリンを入れてたかなんてもう覚えてないし、昨日なんか堂々とサラダの中にナナカマドなんか混ざってるし。"
msgstr ""

#. Occurrence 7_2:1132:9242: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0015; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1132
msgctxt "text_id=9242 | speaker=aoko"
msgid "　……ほんと、あの娘なに考えてるんだろう」"
msgstr ""

#. Occurrence 7_2:1137:9243: scene=7_2
#: 7_2:1137
msgctxt "text_id=9243 | speaker=unknown"
msgid "　思い出すように苦笑しながら、青子は教科書をめくっていく。"
msgstr ""

#. Occurrence 7_2:1163:9244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0014; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1163
msgctxt "text_id=9244 | speaker=soujuurou"
msgid "「メスカリン……？」"
msgstr ""

#. Occurrence 7_2:1169:9245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0016; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1169
msgctxt "text_id=9245 | speaker=aoko"
msgid "「サボテンからとれる<植物塩基|アルカロイド>よ。有珠が使う以上、ただの幻覚剤じゃないでしょうけどね。……っと、私はこんなもんでいっか」"
msgstr ""

#. Occurrence 7_2:1178:9246: scene=7_2
#: 7_2:1178
msgctxt "text_id=9246 | speaker=unknown"
msgid "　そう言う彼女の手元で、ぱたん、と四冊目の教科書が閉じられた。"
msgstr ""

#. Occurrence 7_2:1184:9247: scene=7_2
#: 7_2:1184
msgctxt "text_id=9247 | speaker=unknown"
msgid "　今まで微動だにしなかった背中がくるりと反転する。"
msgstr ""

#. Occurrence 7_2:1221:9248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0017; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1221
msgctxt "text_id=9248 | speaker=aoko"
msgid "「さ、今度はアンタを仕込まなくちゃね。"
msgstr ""

#. Occurrence 7_2:1227:9249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0018; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1227
msgctxt "text_id=9249 | speaker=aoko"
msgid "　今日の四科目の答案、実に草十郎らしい出来栄えで卒倒しそうになったわ、私」"
msgstr ""

#. Occurrence 7_2:1233:9250: scene=7_2
#: 7_2:1233
msgctxt "text_id=9250 | speaker=unknown"
msgid "　口調は楽しそうに、けれど視線は不機嫌そうに、青子はあぐらをかく草十郎を見つめる。"
msgstr ""

#. Occurrence 7_2:1254:9251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0019; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1254
msgctxt "text_id=9251 | speaker=aoko"
msgid "「現国、地理、数学、電子工学。"
msgstr ""

#. Occurrence 7_2:1260:9252: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0020; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1260
msgctxt "text_id=9252 | speaker=aoko"
msgid "　あの調子であと二日続けたら、冬休みが消えるのは当然でしょうね。そうなると困るのは私なのよ、実際」"
msgstr ""

#. Occurrence 7_2:1295:9253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0015; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1295
msgctxt "text_id=9253 | speaker=soujuurou"
msgid "「いや、俺も困るぞ。休みなのに学校に行くのは、なんか気が乗らない」"
msgstr ""

#. Occurrence 7_2:1300:9254: scene=7_2
#: 7_2:1300
msgctxt "text_id=9254 | speaker=unknown"
msgid "　冷静に誤りを訂正する草十郎。"
msgstr ""

#. Occurrence 7_2:1322:9255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0021; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1322
msgctxt "text_id=9255 | speaker=aoko"
msgid "「そりゃあ私の台詞だ！　アンタが学校に行くってコトは、必然、こっちまでとばっちりがくるっての！」"
msgstr ""

#. Occurrence 7_2:1327:9256: scene=7_2
#: 7_2:1327
msgctxt "text_id=9256 | speaker=unknown"
msgid "　思い出したくもない、山城教諭のニヤニヤ顔を想像してしまう青子だった。"
msgstr ""

#. Occurrence 7_2:1353:9257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0022; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1353
msgctxt "text_id=9257 | speaker=aoko"
msgid "「それ以前に、私の目が黒いうちはオール赤なんて<生徒|ヤツ>は許さない。"
msgstr ""

#. Occurrence 7_2:1359:9258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0023; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1359
msgctxt "text_id=9258 | speaker=aoko"
msgid "　本来なら性根から叩き直すところだけど……」"
msgstr ""

#. Occurrence 7_2:1380:9259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0024; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1380
msgctxt "text_id=9259 | speaker=aoko"
msgid "「ま、アンタは色々事情があるから、とりあえず点数だけで勘弁してあげる。"
msgstr ""

#. Occurrence 7_2:1391:9260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0025; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1391
msgctxt "text_id=9260 | speaker=aoko"
msgid "　私もテストは一夜漬けで片付ける方だから、アンタ一人仕込むのに、そう時間はかからないだろうし」"
msgstr ""

#. Occurrence 7_2:1412:9261: scene=7_2
#: 7_2:1412
msgctxt "text_id=9261 | speaker=unknown"
msgid "　青子の宣言に、草十郎は露骨に表情を曇らせる。"
msgstr ""

#. Occurrence 7_2:1412:9262: scene=7_2
#: 7_2:1412
msgctxt "text_id=9262 | speaker=unknown"
msgid "　そんなお節介はいらない、とでも言いたげな顔である。"
msgstr ""

#. Occurrence 7_2:1446:9263: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0026; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1446
msgctxt "text_id=9263 | speaker=aoko"
msgid "「アンタね。苦労するのは私と貴方、どっちだと思う？」"
msgstr ""

#. Occurrence 7_2:1451:9264: scene=7_2
#: 7_2:1451
msgctxt "text_id=9264 | speaker=unknown"
msgid "　間違いなく自分だな、と運命的に悟りながらも草十郎は静かにうなだれた。"
msgstr ""

#. Occurrence 7_2:1456:9265: scene=7_2
#: 7_2:1456
msgctxt "text_id=9265 | speaker=unknown"
msgid "　どのみち断ったところで断りきれるはずがないし、青子の言う通り、苦労の度合いは彼女の方が大きいだろう。"
msgstr ""

#. Occurrence 7_2:1493:9266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0016; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1493
msgctxt "text_id=9266 | speaker=soujuurou"
msgid "「……この度は、ご迷惑をおかけします」"
msgstr ""

#. Occurrence 7_2:1499:9267: scene=7_2
#: 7_2:1499
msgctxt "text_id=9267 | speaker=unknown"
msgid "　観念と感謝の意をこめて、ぺこりと一礼する草十郎。"
msgstr ""

#. Occurrence 7_2:1535:9268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0027; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1535
msgctxt "text_id=9268 | speaker=aoko"
msgid "「よろしい。"
msgstr ""

#. Occurrence 7_2:1542:9269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0028; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1542
msgctxt "text_id=9269 | speaker=aoko"
msgid "安心なさい、私だって鬼じゃないから。"
msgstr ""

#. Occurrence 7_2:1548:9270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0029; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1548
msgctxt "text_id=9270 | speaker=aoko"
msgid "　別に平均点狙うってワケでもなし、予定通りこなしていけば三時には眠れるわよ」"
msgstr ""

#. Occurrence 7_2:1568:9271: scene=7_2
#: 7_2:1568
msgctxt "text_id=9271 | speaker=unknown"
msgid "　殊勝な教え子の態度に、青子は満足そうに頷いた。"
msgstr ""

#. Occurrence 7_2:1578:9272: scene=7_2
#: 7_2:1578
msgctxt "text_id=9272 | speaker=unknown"
msgid "　ほんとうに色々問題のある草十郎だが、この素直さがあれば大抵のコトはなんとか出来てしまうだろう、と。"
msgstr ""

#. Occurrence 7_2:1604:9273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0030; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1604
msgctxt "text_id=9273 | speaker=aoko"
msgid "「……って、なにホトケ心だしてるんだ私。"
msgstr ""

#. Occurrence 7_2:1623:9274: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0031; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1623
msgctxt "text_id=9274 | speaker=aoko"
msgid "　いい、静希君？　このあと頼られちゃたまんないから<釘|くぎ>さしておくけど、私がマンツーマンで誰かを仕込むなんてコト、滅多にないから。"
msgstr ""

#. Occurrence 7_2:1629:9275: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0032; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1629
msgctxt "text_id=9275 | speaker=aoko"
msgid "　これはあくまで、異例中の異例だって覚えておいてね」"
msgstr ""

#. Occurrence 7_2:1659:9276: scene=7_2
#: 7_2:1659
msgctxt "text_id=9276 | speaker=unknown"
msgid "　自分に言い聞かせるような青子の宣言に、えー、と顔を曇らせる草十郎。"
msgstr ""

#. Occurrence 7_2:1678:9277: scene=7_2
#: 7_2:1678
msgctxt "text_id=9277 | speaker=unknown"
msgid "　その顔の上に“拾ってください”なんて単語を連想してしまい、自らの甘さにうなだれる青子だった。"
msgstr ""

#. Occurrence 7_2:1686:9278: scene=7_2
#: 7_2:1686
msgctxt "text_id=9278 | speaker=unknown"
msgid "　そう言えば、初めて出会った日は雨だったっけ、などと思いながら。"
msgstr ""

#. Occurrence 7_3:39:9279: scene=7_3
#: 7_3:39
msgctxt "text_id=9279 | speaker=unknown"
msgid "　……時間は、砂が落ちるようにすぎていく。"
msgstr ""

#. Occurrence 7_3:103:9280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_9000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:103
msgctxt "text_id=9280 | speaker=aoko"
msgid "「―――結局」"
msgstr ""

#. Occurrence 7_3:108:9281: scene=7_3
#: 7_3:108
msgctxt "text_id=9281 | speaker=unknown"
msgid "　窓から差しこむ朝の光に目を細めて、青子は何杯目かの紅茶を飲み干した。"
msgstr ""

#. Occurrence 7_3:123:9282: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0001; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:123
msgctxt "text_id=9282 | speaker=soujuurou"
msgid "「一晩かかったね、蒼崎」"
msgstr ""

#. Occurrence 7_3:128:9283: scene=7_3
#: 7_3:128
msgctxt "text_id=9283 | speaker=unknown"
msgid "　不思議だ、とばかりに青子の独白を拾う草十郎。"
msgstr ""

#. Occurrence 7_3:148:9284: scene=7_3
#: 7_3:148
msgctxt "text_id=9284 | speaker=unknown"
msgid "　青子にはいつもの覇気がない。"
msgstr ""

#. Occurrence 7_3:153:9285: scene=7_3
#: 7_3:153
msgctxt "text_id=9285 | speaker=unknown"
msgid "　徹夜明けプラス、一晩じゅう草十郎を怒鳴りつけた疲労のためだ。"
msgstr ""

#. Occurrence 7_3:158:9286: scene=7_3
#: 7_3:158
msgctxt "text_id=9286 | speaker=unknown"
msgid "　一方、草十郎は昨夜とまったく同じ顔色である。"
msgstr ""

#. Occurrence 7_3:188:9287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:188
msgctxt "text_id=9287 | speaker=aoko"
msgid "「……ええ。甘く見てたわ、アンタの事を」"
msgstr ""

#. Occurrence 7_3:199:9288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0002; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:199
msgctxt "text_id=9288 | speaker=soujuurou"
msgid "「だから、誉めても何も出ないって」"
msgstr ""

#. Occurrence 7_3:210:9289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0001; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:210
msgctxt "text_id=9289 | speaker=aoko"
msgid "「ある意味、誉めるに値するかもね……」"
msgstr ""

#. Occurrence 7_3:220:9290: scene=7_3
#: 7_3:220
msgctxt "text_id=9290 | speaker=unknown"
msgid "　呆れる青子だが、半分は本気で感心していた。"
msgstr ""

#. Occurrence 7_3:257:9291: scene=7_3
#: 7_3:257
msgctxt "text_id=9291 | speaker=unknown"
msgid "　この山奥育ちには下積みがなさすぎる。"
msgstr ""

#. Occurrence 7_3:262:9292: scene=7_3
#: 7_3:262
msgctxt "text_id=9292 | speaker=unknown"
msgid "　控えめに言うと、かろうじて中学生レベルの学力だ。"
msgstr ""

#. Occurrence 7_3:267:9293: scene=7_3
#: 7_3:267
msgctxt "text_id=9293 | speaker=unknown"
msgid "　なので、理解、修得を目的にした試験勉強は諦めるしかない。"
msgstr ""

#. Occurrence 7_3:272:9294: scene=7_3
#: 7_3:272
msgctxt "text_id=9294 | speaker=unknown"
msgid "　基本は点数稼ぎの暗記だけ。"
msgstr ""

#. Occurrence 7_3:277:9295: scene=7_3
#: 7_3:277
msgctxt "text_id=9295 | speaker=unknown"
msgid "　明日になれば忘れるハリボテの一夜漬けでいい、と青子は教官役を買ってでたのだ。"
msgstr ""

#. Occurrence 7_3:297:9296: scene=7_3
#: 7_3:297
msgctxt "text_id=9296 | speaker=unknown"
msgid "　……誤算だったのは、思いの外、この生徒が優秀だった事だろう。"
msgstr ""

#. Occurrence 7_3:302:9297: scene=7_3
#: 7_3:302
msgctxt "text_id=9297 | speaker=unknown"
msgid "　四教科の試験範囲を終えるのに一晩かかってしまったが、それでもここまで熱心に、覚えたことを無駄にしないよう真剣に取り組むとは思わなかった。"
msgstr ""

#. Occurrence 7_3:339:9298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0002; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:339
msgctxt "text_id=9298 | speaker=aoko"
msgid "「でもねぇ。真面目なのはいいコトだけど、アンタ、暗記するのに時間かかりすぎ」"
msgstr ""

#. Occurrence 7_3:352:9299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0003; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:352
msgctxt "text_id=9299 | speaker=soujuurou"
msgid "「そこは大目に見てほしい。今まで、頭より体で覚えるコトのが多かったんだ」"
msgstr ""

#. Occurrence 7_3:388:9300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0003; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:388
msgctxt "text_id=9300 | speaker=aoko"
msgid "「…………」"
msgstr ""

#. Occurrence 7_3:393:9301: scene=7_3
#: 7_3:393
msgctxt "text_id=9301 | speaker=unknown"
msgid "　青子は仕方なさげにため息をつく。"
msgstr ""

#. Occurrence 7_3:398:9302: scene=7_3
#: 7_3:398
msgctxt "text_id=9302 | speaker=unknown"
msgid "　たしかに、山奥での生活で重要なのは知識ではなく経験則なのだろう、と。"
msgstr ""

#. Occurrence 7_3:424:9303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0004; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:424
msgctxt "text_id=9303 | speaker=aoko"
msgid "「……まあいいわ。これで山城からアンタの成績について相談される事もないでしょうし。"
msgstr ""

#. Occurrence 7_3:430:9304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0005; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:430
msgctxt "text_id=9304 | speaker=aoko"
msgid "　紅茶、もう一杯<淹|い>れてくれる？」"
msgstr ""

#. Occurrence 7_3:448:9305: scene=7_3
#: 7_3:448
msgctxt "text_id=9305 | speaker=unknown"
msgid "　疲れきって背中を伸ばす青子に、はいはいと応えて立ち上がる草十郎。"
msgstr ""

#. Occurrence 7_3:453:9306: scene=7_3
#: 7_3:453
msgctxt "text_id=9306 | speaker=unknown"
msgid "　ティーバッグの紅茶は大量に買いこんでいたらしく、まだ十分に余っている。"
msgstr ""

#. Occurrence 7_3:486:9307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0004; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:486
msgctxt "text_id=9307 | speaker=soujuurou"
msgid "「まったく。無駄遣いだな、蒼崎は」"
msgstr ""

#. Occurrence 7_3:492:9308: scene=7_3
#: 7_3:492
msgctxt "text_id=9308 | speaker=unknown"
msgid "　青子に聞こえないよう呟く。"
msgstr ""

#. Occurrence 7_3:497:9309: scene=7_3
#: 7_3:497
msgctxt "text_id=9309 | speaker=unknown"
msgid "　一晩<厳|きび>しく教えられた反撃か、青子のだらしのない点が見られて嬉しいらしい。"
msgstr ""

#. Occurrence 7_3:502:9310: scene=7_3
#: 7_3:502
msgctxt "text_id=9310 | speaker=unknown"
msgid "　……その買いすぎたティーバッグは失敗ではなく、<今|・><夜|・>の補給物資になる事を、この時点では想像もできない草十郎だった。"
msgstr ""

#. Occurrence 7_3:541:9311: scene=7_3
#: 7_3:541
msgctxt "text_id=9311 | speaker=unknown"
msgid "　そんな平和ぼけしまくった草十郎を、青子は弛緩した面持ちで眺めている。"
msgstr ""

#. Occurrence 7_3:568:9312: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0006; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:568
msgctxt "text_id=9312 | speaker=aoko"
msgid "「……悪くないけど。せめて、リーフティーで淹れられるように仕込まなくちゃダメかな……」"
msgstr ""

#. Occurrence 7_3:573:9313: scene=7_3
#: 7_3:573
msgctxt "text_id=9313 | speaker=unknown"
msgid "　独り言じみた青子の所感が聞こえたのか、草十郎はひょいと青子を振り返る。"
msgstr ""

#. Occurrence 7_3:610:9314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0005; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:610
msgctxt "text_id=9314 | speaker=soujuurou"
msgid "「やっぱり味は違うのか？」"
msgstr ""

#. Occurrence 7_3:631:9315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0007; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:631
msgctxt "text_id=9315 | speaker=aoko"
msgid "「違う違う、もうぜーんぜん。"
msgstr ""

#. Occurrence 7_3:637:9316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0008; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:637
msgctxt "text_id=9316 | speaker=aoko"
msgid "　……ま、正直私はどうでもいいんだけど、有珠はね、かなりお茶にはうるさいよ。"
msgstr ""

#. Occurrence 7_3:648:9317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0009; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:648
msgctxt "text_id=9317 | speaker=aoko"
msgid "　―――そうだ。草十郎、有珠と上手くいってる？」"
msgstr ""

#. Occurrence 7_3:668:9318: scene=7_3
#: 7_3:668
msgctxt "text_id=9318 | speaker=unknown"
msgid "　まだ教科書やらテキストやらが散乱しているテーブルに体を寝かせて、楽しそうに青子は言う。"
msgstr ""

#. Occurrence 7_3:673:9319: scene=7_3
#: 7_3:673
msgctxt "text_id=9319 | speaker=unknown"
msgid "　そんな彼女に、草十郎は恨みがましい視線を送った。"
msgstr ""

#. Occurrence 7_3:712:9320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0006; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:712
msgctxt "text_id=9320 | speaker=soujuurou"
msgid "「彼女と会えるのは食事の時だけで、食事といったらアレだろう。どうやって仲良くなれって言うんだ」"
msgstr ""

#. Occurrence 7_3:733:9321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0010; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:733
msgctxt "text_id=9321 | speaker=aoko"
msgid "「そう？　私はじゅうぶん脈アリだと思ったけど。"
msgstr ""

#. Occurrence 7_3:739:9322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0011; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:739
msgctxt "text_id=9322 | speaker=aoko"
msgid "　<草|そ><十|っ><郎|ち>は有珠を恐がってないし、有珠は<草|そ><十|っ><郎|ち>を追い出す理由を見つけようと躍起になってるし。"
msgstr ""

#. Occurrence 7_3:745:9323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0012; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:745
msgctxt "text_id=9323 | speaker=aoko"
msgid "　いい条件よ、これって」"
msgstr ""

#. Occurrence 7_3:782:9324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0007; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:782
msgctxt "text_id=9324 | speaker=soujuurou"
msgid "「……ぜんぜん分からないな。"
msgstr ""

#. Occurrence 7_3:788:9325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0008; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:788
msgctxt "text_id=9325 | speaker=soujuurou"
msgid "　あの娘とこっちの関係は、遊園地前の蒼崎と俺の関係と同じじゃないか。いったいドコがいい条件なんだ？」"
msgstr ""

#. Occurrence 7_3:820:9326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0013; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:820
msgctxt "text_id=9326 | speaker=aoko"
msgid "「とりあえず反目しあってはいないでしょ？"
msgstr ""

#. Occurrence 7_3:826:9327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0014; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:826
msgctxt "text_id=9327 | speaker=aoko"
msgid "　一方通行の関係だけど、それはそれ、有珠にしちゃあ上出来っていうか。理由を探している時点で可能性アリってね。"
msgstr ""

#. Occurrence 7_3:832:9328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0015; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:832
msgctxt "text_id=9328 | speaker=aoko"
msgid "　あの娘は反感に応える事がクセになっちゃってるから、大抵、相手を自滅させちゃうのよ」"
msgstr ""

#. Occurrence 7_3:873:9329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0009; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:873
msgctxt "text_id=9329 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 7_3:878:9330: scene=7_3
#: 7_3:878
msgctxt "text_id=9330 | speaker=unknown"
msgid "　抽象的な青子の言に、草十郎はますます首を傾げる。"
msgstr ""

#. Occurrence 7_3:899:9331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0016; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:899
msgctxt "text_id=9331 | speaker=aoko"
msgid "「知ってしまえば単純な話なんだけどね、あの娘の場合。"
msgstr ""

#. Occurrence 7_3:905:9332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0017; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:905
msgctxt "text_id=9332 | speaker=aoko"
msgid "　ただ―――」"
msgstr ""

#. Occurrence 7_3:910:9333: scene=7_3
#: 7_3:910
msgctxt "text_id=9333 | speaker=unknown"
msgid "　知ったところで、そのスタンスを実践できるかは別の話。"
msgstr ""

#. Occurrence 7_3:943:9334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0010; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:943
msgctxt "text_id=9334 | speaker=soujuurou"
msgid "「難しいよ、蒼崎は」"
msgstr ""

#. Occurrence 7_3:949:9335: scene=7_3
#: 7_3:949
msgctxt "text_id=9335 | speaker=unknown"
msgid "　言いつつ、草十郎はふたり分のティーカップを持ってテーブルに戻る。"
msgstr ""

#. Occurrence 7_3:955:9336: scene=7_3
#: 7_3:955
msgctxt "text_id=9336 | speaker=unknown"
msgid "青子はカップを受け取ると、疲れを打ち消すようにと口に運んだ。"
msgstr ""

#. Occurrence 7_3:986:9337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0011; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:986
msgctxt "text_id=9337 | speaker=soujuurou"
msgid "「でも、たしかに君の言う通りだ。"
msgstr ""

#. Occurrence 7_3:992:9338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0012; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:992
msgctxt "text_id=9338 | speaker=soujuurou"
msgid "　俺はまだ、あの<娘|こ>の顔しか知らない。久遠寺有珠という名前すら<定|さだ>かじゃないのは、問題があるね」"
msgstr ""

#. Occurrence 7_3:998:9339: scene=7_3
#: 7_3:998
msgctxt "text_id=9339 | speaker=unknown"
msgid "　青子に<倣|なら>ってカップに口をつける。"
msgstr ""

#. Occurrence 7_3:1004:9340: scene=7_3
#: 7_3:1004
msgctxt "text_id=9340 | speaker=unknown"
msgid "草十郎のカップに注がれたのは紅茶ではなく、ただのお湯だ。"
msgstr ""

#. Occurrence 7_3:1029:9341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0018; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1029
msgctxt "text_id=9341 | speaker=aoko"
msgid "「ふーん。あの娘のこと、教えてほしい？」"
msgstr ""

#. Occurrence 7_3:1034:9342: scene=7_3
#: 7_3:1034
msgctxt "text_id=9342 | speaker=unknown"
msgid "　真横に座った草十郎を<覗|のぞ>きこむ青子。"
msgstr ""

#. Occurrence 7_3:1039:9343: scene=7_3
#: 7_3:1039
msgctxt "text_id=9343 | speaker=unknown"
msgid "　まっとうな人間なら見惚れかねない青子の仕草に、"
msgstr ""

#. Occurrence 7_3:1051:9344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0013; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1051
msgctxt "text_id=9344 | speaker=soujuurou"
msgid "「いや。そういう事は、本人に訊いてあげるべきだと思う」"
msgstr ""

#. Occurrence 7_3:1056:9345: scene=7_3
#: 7_3:1056
msgctxt "text_id=9345 | speaker=unknown"
msgid "　彼は真摯に、居もしない少女に語りかけるよう、きっぱりと返答した。"
msgstr ""

#. Occurrence 7_3:1083:9346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0019; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1083
msgctxt "text_id=9346 | speaker=aoko"
msgid "「……そうね。"
msgstr ""

#. Occurrence 7_3:1090:9347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0020; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1090
msgctxt "text_id=9347 | speaker=aoko"
msgid "ほんと、アンタって有珠好みの対応をするわ。"
msgstr ""

#. Occurrence 7_3:1102:9348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0021; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1102
msgctxt "text_id=9348 | speaker=aoko"
msgid "　ね。前から気になってたけど、客室で有珠に何を言ったの？　いくら私との約束とはいえ、あの娘が部外者を半日も放置するなんてあり得ないのよ？」"
msgstr ""

#. Occurrence 7_3:1113:9349: scene=7_3
#: 7_3:1113
msgctxt "text_id=9349 | speaker=unknown"
msgid "　あの時―――"
msgstr ""

#. Occurrence 7_3:1174:9350: scene=7_3
#: 7_3:1174
msgctxt "text_id=9350 | speaker=unknown"
msgid "　客室で目が覚めて、有珠と交わした二、三の言葉を草十郎は思い出した。"
msgstr ""

#. Occurrence 7_3:1179:9351: scene=7_3
#: 7_3:1179
msgctxt "text_id=9351 | speaker=unknown"
msgid "　あの会話が特別なものであったとは思えないが、だからといって、気軽に話すことはできない。"
msgstr ""

#. Occurrence 7_3:1184:9352: scene=7_3
#: 7_3:1184
msgctxt "text_id=9352 | speaker=unknown"
msgid "　あれは、その―――"
msgstr ""

#. Occurrence 7_3:1220:9353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0022; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1220
msgctxt "text_id=9353 | speaker=aoko"
msgid "「ね、どんな台詞であの娘の気を変えたの？」"
msgstr ""

#. Occurrence 7_3:1225:9354: scene=7_3
#: 7_3:1225
msgctxt "text_id=9354 | speaker=unknown"
msgid "　教えなさい、と詰め寄ってくる青子。"
msgstr ""

#. Occurrence 7_3:1231:9355: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0014; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1231
msgctxt "text_id=9355 | speaker=soujuurou"
msgid "「―――」"
msgstr ""

#. Occurrence 7_3:1236:9356: scene=7_3
#: 7_3:1236
msgctxt "text_id=9356 | speaker=unknown"
msgid "　草十郎はむう、と難しそうに眉をひそめる。"
msgstr ""

#. Occurrence 7_3:1241:9357: scene=7_3
#: 7_3:1241
msgctxt "text_id=9357 | speaker=unknown"
msgid "　有珠にとってどうであったかは不明だが、彼にとって、あれは<侵|おか>しがたいものだった。"
msgstr ""

#. Occurrence 7_3:1246:9358: scene=7_3
#: 7_3:1246
msgctxt "text_id=9358 | speaker=unknown"
msgid "　ある一点。なにを、誰に対して気遣ったか。"
msgstr ""

#. Occurrence 7_3:1272:9359: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9359 | speaker=aoko"
msgid "「ほら、白状しなさいってば。"
msgstr ""

#. Occurrence 7_3:1272:9360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9360 | speaker=aoko"
msgid "　隠しごとなんて似合わないわよ？」"
msgstr ""

#. Occurrence 7_3:1293:9361: scene=7_3
#: 7_3:1293
msgctxt "text_id=9361 | speaker=unknown"
msgid "　意地の悪い笑顔が、ずいっとにじり寄る。"
msgstr ""

#. Occurrence 7_3:1299:9362: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0015; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1299
msgctxt "text_id=9362 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 7_3:1304:9363: scene=7_3
#: 7_3:1304
msgctxt "text_id=9363 | speaker=unknown"
msgid "　どうにも黙秘ではやり過ごせそうにない。"
msgstr ""

#. Occurrence 7_3:1309:9364: scene=7_3
#: 7_3:1309
msgctxt "text_id=9364 | speaker=unknown"
msgid "　草十郎もいずれ知ることになるが、蒼崎青子はこれでゴシップ好きの困った一面があったりするのだ。"
msgstr ""

#. Occurrence 7_3:1349:9365: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0016; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1349
msgctxt "text_id=9365 | speaker=soujuurou"
msgid "「―――まあ。あの<娘|こ>と何を話したかは言わないけど。"
msgstr ""

#. Occurrence 7_3:1355:9366: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0017; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1355
msgctxt "text_id=9366 | speaker=soujuurou"
msgid "　今の蒼崎に比べれば、花も浪漫もなかったのだけは確かかな。"
msgstr ""

#. Occurrence 7_3:1362:9367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0018; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1362
msgctxt "text_id=9367 | speaker=soujuurou"
msgid "さっきまでは蒼崎が鬼みたいだったから、いいもんだなって気が付かなかった」"
msgstr ""

#. Occurrence 7_3:1368:9368: scene=7_3
#: 7_3:1368
msgctxt "text_id=9368 | speaker=unknown"
msgid "　横から覗きこんでいる青子に、草十郎は真顔で視線を返す。"
msgstr ""

#. Occurrence 7_3:1405:9369: scene=7_3
#: 7_3:1405
msgctxt "text_id=9369 | speaker=unknown"
msgid "　慌てて飛びのく青子。"
msgstr ""

#. Occurrence 7_3:1410:9370: scene=7_3
#: 7_3:1410
msgctxt "text_id=9370 | speaker=unknown"
msgid "　言われてみれば、さっきまで体が触れ合うぐらい近寄っていた気がする。"
msgstr ""

#. Occurrence 7_3:1437:9371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0024; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1437
msgctxt "text_id=9371 | speaker=aoko"
msgid "「し、仕方ないでしょ、この方が効率良かったんだから。"
msgstr ""

#. Occurrence 7_3:1460:9372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0025; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1460
msgctxt "text_id=9372 | speaker=aoko"
msgid "　アンタ、横にいないとすぐ間違えるし」"
msgstr ""

#. Occurrence 7_3:1474:9373: scene=7_3
#: 7_3:1474
msgctxt "text_id=9373 | speaker=unknown"
msgid "　悪態を吐きつつ青子は立ち上がった。"
msgstr ""

#. Occurrence 7_3:1509:9374: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0019; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1509
msgctxt "text_id=9374 | speaker=soujuurou"
msgid "「そうだね。なんか昔みたいで、久しぶりに集中できた。"
msgstr ""

#. Occurrence 7_3:1515:9375: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0020; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1515
msgctxt "text_id=9375 | speaker=soujuurou"
msgid "　これが異例中の異例っていうのが、本当に残念だ」"
msgstr ""

#. Occurrence 7_3:1548:9376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0026; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1548
msgctxt "text_id=9376 | speaker=aoko"
msgid "「……余裕あるじゃない。その分じゃ今日のテストだけじゃなく、有珠との話し合いも上手くいきそうね、草十郎？」"
msgstr ""

#. Occurrence 7_3:1566:9377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0021; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1566
msgctxt "text_id=9377 | speaker=soujuurou"
msgid "「ああ、それはもちろん」"
msgstr ""

#. Occurrence 7_3:1590:9378: scene=7_3
#: 7_3:1590
msgctxt "text_id=9378 | speaker=unknown"
msgid "　爽やかな返答に、青子はつい絶句する。"
msgstr ""

#. Occurrence 7_3:1595:9379: scene=7_3
#: 7_3:1595
msgctxt "text_id=9379 | speaker=unknown"
msgid "　嫌味のつもりだったのに、まさか笑顔で返されるとは思ってもいなかったのだ。"
msgstr ""

#. Occurrence 7_3:1629:9380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9380 | speaker=soujuurou"
msgid "「方針変更だ。まずは近くで話しかけてみるよ。"
msgstr ""

#. Occurrence 7_3:1629:9381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9381 | speaker=soujuurou"
msgid "　嫌なことは、いずれ終わるって分かったから」"
msgstr ""

#. Occurrence 7_3:1635:9382: scene=7_3
#: 7_3:1635
msgctxt "text_id=9382 | speaker=unknown"
msgid "　そう言って立ち上がる草十郎の姿を、青子は絶句したまま見つめた。"
msgstr ""

#. Occurrence 7_3:1640:9383: scene=7_3
#: 7_3:1640
msgctxt "text_id=9383 | speaker=unknown"
msgid "　……頼りがいがある姿というか、きちんと芯の通った振る舞いというか。不覚にも、少しだけ尊敬してしまった程だ。"
msgstr ""

#. Occurrence 7_3:1664:9384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0023; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1664
msgctxt "text_id=9384 | speaker=soujuurou"
msgid "「とりあえず今日はひとりで帰って、有珠と話してみる。"
msgstr ""

#. Occurrence 7_3:1670:9385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0024; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1670
msgctxt "text_id=9385 | speaker=soujuurou"
msgid "　蒼崎は放課後、生徒会だろう？」"
msgstr ""

#. Occurrence 7_3:1679:9386: scene=7_3
#: 7_3:1679
msgctxt "text_id=9386 | speaker=unknown"
msgid "　草十郎の言う通り、青子には冬休み直前の最後の会議が待ち受けていた。"
msgstr ""

#. Occurrence 7_3:1684:9387: scene=7_3
#: 7_3:1684
msgctxt "text_id=9387 | speaker=unknown"
msgid "　本来なら会議の終わりまで待つか、学校からそのままアルバイトに行くのが草十郎の日課である。"
msgstr ""

#. Occurrence 7_3:1702:9388: scene=7_3
#: 7_3:1702
msgctxt "text_id=9388 | speaker=unknown"
msgid "　それも、ひとえに洋館で草十郎と有珠が二人きりにならないよう、青子なりの配慮なのだが―――"
msgstr ""

#. Occurrence 7_3:1724:9389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0027; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1724
msgctxt "text_id=9389 | speaker=aoko"
msgid "「……待った。まさかアンタ、ひとりで有珠とやりあうつもりなの？」"
msgstr ""

#. Occurrence 7_3:1740:9390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0025; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1740
msgctxt "text_id=9390 | speaker=soujuurou"
msgid "「別にやりあうつもりはないぞ。<試|し><合|あ>っても勝てないだろ、有珠には」"
msgstr ""

#. Occurrence 7_3:1745:9391: scene=7_3
#: 7_3:1745
msgctxt "text_id=9391 | speaker=unknown"
msgid "　驚く青子に、平然と草十郎は返答する。"
msgstr ""

#. Occurrence 7_3:1771:9392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0026; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1771
msgctxt "text_id=9392 | speaker=soujuurou"
msgid "「でも、蒼崎がいたら話が複雑になるのは目に見えてるんだ。そんなワケで、今日はゆっくり鳶丸の相手でもしててくれ」"
msgstr ""

#. Occurrence 7_3:1795:9393: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0028; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1795
msgctxt "text_id=9393 | speaker=aoko"
msgid "「…………本気？」"
msgstr ""

#. Occurrence 7_3:1815:9394: scene=7_3
#: 7_3:1815
msgctxt "text_id=9394 | speaker=unknown"
msgid "　試すような青子の問いに、草十郎は気軽に頷いた。"
msgstr ""

#. Occurrence 7_3:1820:9395: scene=7_3
#: 7_3:1820
msgctxt "text_id=9395 | speaker=unknown"
msgid "　事の深刻さを理解している青子と、"
msgstr ""

#. Occurrence 7_3:1825:9396: scene=7_3
#: 7_3:1825
msgctxt "text_id=9396 | speaker=unknown"
msgid "　その深刻さは<要|い>らないと語る草十郎。"
msgstr ""

#. Occurrence 7_3:1830:9397: scene=7_3
#: 7_3:1830
msgctxt "text_id=9397 | speaker=unknown"
msgid "　窓から差しこむ朝の光が、立ったまま話し合うふたりを光と影とに<別|わ>けている。"
msgstr ""

#. Occurrence 7_3:1870:9398: scene=7_3
#: 7_3:1870
msgctxt "text_id=9398 | speaker=unknown"
msgid "　どちらが光に照らされているのか、"
msgstr ""

#. Occurrence 7_3:1875:9399: scene=7_3
#: 7_3:1875
msgctxt "text_id=9399 | speaker=unknown"
msgid "　どちらが影に佇んでいるかは、語るまでもない。"
msgstr ""

#. Occurrence 7_3:1881:9400: scene=7_3
#: 7_3:1881
msgctxt "text_id=9400 | speaker=unknown"
msgid "　短かな、ほんの数秒ほどの沈黙。"
msgstr ""

#. Occurrence 7_3:1886:9401: scene=7_3
#: 7_3:1886
msgctxt "text_id=9401 | speaker=unknown"
msgid "　青子は草十郎を真顔で見つめて、"
msgstr ""

#. Occurrence 7_3:1921:9402: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0029; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1921
msgctxt "text_id=9402 | speaker=aoko"
msgid "「そ。なら止めはしないわ」"
msgstr ""

#. Occurrence 7_3:1928:9403: scene=7_3
#: 7_3:1928
msgctxt "text_id=9403 | speaker=unknown"
msgid "　青子はそう口にした。"
msgstr ""

#. Occurrence 7_3:1933:9404: scene=7_3
#: 7_3:1933
msgctxt "text_id=9404 | speaker=unknown"
msgid "　先ほどまでの沈黙の意図も、わずかな葛藤も感じさせない、彼女らしい<冷徹|ドライ>さ。"
msgstr ""

#. Occurrence 7_3:1966:9405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0027; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1966
msgctxt "text_id=9405 | speaker=soujuurou"
msgid "「……なんか怒ってないか、蒼崎？」"
msgstr ""

#. Occurrence 7_3:1984:9406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0030; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1984
msgctxt "text_id=9406 | speaker=aoko"
msgid "「別に。それで、何か考えはあるの？　下手な考えは通じないわよ、あの娘には」"
msgstr ""

#. Occurrence 7_3:2003:9407: scene=7_3
#: 7_3:2003
msgctxt "text_id=9407 | speaker=unknown"
msgid "　む、と眉をよせて考えこむ草十郎。"
msgstr ""

#. Occurrence 7_3:2008:9408: scene=7_3
#: 7_3:2008
msgctxt "text_id=9408 | speaker=unknown"
msgid "　たしかに会話だけで有珠と親しくなるのは難しい。というか、不可能な気さえする。"
msgstr ""

#. Occurrence 7_3:2029:9409: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_3_0000; voice_prefix=B50; voice_category=6; scene=7_3
#: 7_3:2029
msgctxt "text_id=9409 | speaker=kinomi"
msgid "“言葉で落ちないヤツは物で釣れ”"
msgstr ""

#. Occurrence 7_3:2035:9410: scene=7_3
#: 7_3:2035
msgctxt "text_id=9410 | speaker=unknown"
msgid "　彼の数少ない相談相手（勘違い含む）である木乃美芳助はそんな助言をしてくれた。"
msgstr ""

#. Occurrence 7_3:2040:9411: scene=7_3
#: 7_3:2040
msgctxt "text_id=9411 | speaker=unknown"
msgid "　ちなみに木乃美の助言は対青子用のものだったが、その時の草十郎の感想は、"
msgstr ""

#. Occurrence 7_3:2045:9412: scene=7_3
#: 7_3:2045
msgctxt "text_id=9412 | speaker=unknown"
msgid "“蒼崎を物で釣ると、後が恐そうだ”である。"
msgstr ""

#. Occurrence 7_3:2081:9413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0028; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2081
msgctxt "text_id=9413 | speaker=soujuurou"
msgid "「……む。だいたい、有珠の趣味も分からないじゃないか。"
msgstr ""

#. Occurrence 7_3:2087:9414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0029; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2087
msgctxt "text_id=9414 | speaker=soujuurou"
msgid "　考えてみると、今の自分と彼女はまるで接点がない」"
msgstr ""

#. Occurrence 7_3:2093:9415: scene=7_3
#: 7_3:2093
msgctxt "text_id=9415 | speaker=unknown"
msgid "　困ったな、と腕を組む草十郎。"
msgstr ""

#. Occurrence 7_3:2126:9416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0031; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2126
msgctxt "text_id=9416 | speaker=aoko"
msgid "「いつもの事だけど、何も考えてなかったワケね」"
msgstr ""

#. Occurrence 7_3:2139:9417: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0030; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2139
msgctxt "text_id=9417 | speaker=soujuurou"
msgid "「うん。でもまあ、あれこれ考えなくてもいいと思う。"
msgstr ""

#. Occurrence 7_3:2159:9418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0031; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2159
msgctxt "text_id=9418 | speaker=soujuurou"
msgid "　有珠にはあれこれ説明するとか、分かってもらおうとか、そういうんじゃなくて、なんていうか―――」"
msgstr ""

#. Occurrence 7_3:2179:9419: scene=7_3
#: 7_3:2179
msgctxt "text_id=9419 | speaker=unknown"
msgid "　言葉にできない印象を、なんとか言葉にしようと悩む。"
msgstr ""

#. Occurrence 7_3:2179:9420: scene=7_3
#: 7_3:2179
msgctxt "text_id=9420 | speaker=unknown"
msgid "　思考時間は短かった。"
msgstr ""

#. Occurrence 7_3:2184:9421: scene=7_3
#: 7_3:2184
msgctxt "text_id=9421 | speaker=unknown"
msgid "　草十郎はああ、と小さく頷いて、"
msgstr ""

#. Occurrence 7_3:2191:9422: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0032; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2191
msgctxt "text_id=9422 | speaker=soujuurou"
msgid "「要は、俺が彼女を好きかどうかって事じゃないか？」"
msgstr ""

#. Occurrence 7_3:2197:9423: scene=7_3
#: 7_3:2197
msgctxt "text_id=9423 | speaker=unknown"
msgid "　あっさりと、言いづらい感想を口にした。"
msgstr ""

#. Occurrence 7_3:2229:9424: scene=7_3
#: 7_3:2229
msgctxt "text_id=9424 | speaker=unknown"
msgid "　確かに、それは全ての前提だ。"
msgstr ""

#. Occurrence 7_3:2234:9425: scene=7_3
#: 7_3:2234
msgctxt "text_id=9425 | speaker=unknown"
msgid "　認められるために話すのではなく、"
msgstr ""

#. Occurrence 7_3:2239:9426: scene=7_3
#: 7_3:2239
msgctxt "text_id=9426 | speaker=unknown"
msgid "　見返りを求めての求愛でもない。"
msgstr ""

#. Occurrence 7_3:2244:9427: scene=7_3
#: 7_3:2244
msgctxt "text_id=9427 | speaker=unknown"
msgid "　まずその人が好きだから、触れ合ってみようと思う。"
msgstr ""

#. Occurrence 7_3:2249:9428: scene=7_3
#: 7_3:2249
msgctxt "text_id=9428 | speaker=unknown"
msgid "　それは打算のない、清潔な心のあり方だ。"
msgstr ""

#. Occurrence 7_3:2269:9429: scene=7_3
#: 7_3:2269
msgctxt "text_id=9429 | speaker=unknown"
msgid "　けれど、それが人間として幸福かどうかは、また別の話。"
msgstr ""

#. Occurrence 7_3:2275:9430: scene=7_3
#: 7_3:2275
msgctxt "text_id=9430 | speaker=unknown"
msgid "　計算と妥協、我欲と食い合い。"
msgstr ""

#. Occurrence 7_3:2280:9431: scene=7_3
#: 7_3:2280
msgctxt "text_id=9431 | speaker=unknown"
msgid "　道徳が非人間と<糾|うた>うものこそが正しい人間性と信じる者には、その清潔さは目に痛い。"
msgstr ""

#. Occurrence 7_3:2285:9432: scene=7_3
#: 7_3:2285
msgctxt "text_id=9432 | speaker=unknown"
msgid "　……いや、正しくは。"
msgstr ""

#. Occurrence 7_3:2291:9433: scene=7_3
#: 7_3:2291
msgctxt "text_id=9433 | speaker=unknown"
msgid "そう信じざるを得なくなってしまった者にとっては。"
msgstr ""

#. Occurrence 7_3:2333:9434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0032; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2333
msgctxt "text_id=9434 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 7_3:2339:9435: scene=7_3
#: 7_3:2339
msgctxt "text_id=9435 | speaker=unknown"
msgid "　草十郎の言葉に何も返さず、青子は音もなく歩きだした。"
msgstr ""

#. Occurrence 7_3:2344:9436: scene=7_3
#: 7_3:2344
msgctxt "text_id=9436 | speaker=unknown"
msgid "　長い髪を揺らして、草十郎の前を通り過ぎる。"
msgstr ""

#. Occurrence 7_3:2365:9437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0033; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2365
msgctxt "text_id=9437 | speaker=soujuurou"
msgid "「蒼崎？」"
msgstr ""

#. Occurrence 7_3:2370:9438: scene=7_3
#: 7_3:2370
msgctxt "text_id=9438 | speaker=unknown"
msgid "　どこか冷たい素振りの彼女を、草十郎は呼び止める。"
msgstr ""

#. Occurrence 7_3:2375:9439: scene=7_3
#: 7_3:2375
msgctxt "text_id=9439 | speaker=unknown"
msgid "　青子はもう部屋のドアを開けていた。"
msgstr ""

#. Occurrence 7_3:2409:9440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9440 | speaker=aoko"
msgid "「下でシャワー浴びてくるから。"
msgstr ""

#. Occurrence 7_3:2409:9441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9441 | speaker=aoko"
msgid "　貴方は自分の部屋に戻ってて」"
msgstr ""

#. Occurrence 7_3:2415:9442: scene=7_3
#: 7_3:2415
msgctxt "text_id=9442 | speaker=unknown"
msgid "　<抑揚|よくよう>のない台詞。"
msgstr ""

#. Occurrence 7_3:2420:9443: scene=7_3
#: 7_3:2420
msgctxt "text_id=9443 | speaker=unknown"
msgid "　それに戸惑いながらも草十郎は頷いた。"
msgstr ""

#. Occurrence 7_3:2441:9444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0034; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2441
msgctxt "text_id=9444 | speaker=soujuurou"
msgid "「いいけど……やっぱり怒ってないか、蒼崎？」"
msgstr ""

#. Occurrence 7_3:2454:9445: scene=7_3
#: 7_3:2454
msgctxt "text_id=9445 | speaker=unknown"
msgid "　言われて、青子の顔に表情が戻る。"
msgstr ""

#. Occurrence 7_3:2459:9446: scene=7_3
#: 7_3:2459
msgctxt "text_id=9446 | speaker=unknown"
msgid "　それはいつもの、もう見慣れた不機嫌そうな顔ではなかった。"
msgstr ""

#. Occurrence 7_3:2487:9447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0034; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2487
msgctxt "text_id=9447 | speaker=aoko"
msgid "「……そうね。アンタ流に言えば、たぶん私は怒ってる。"
msgstr ""

#. Occurrence 7_3:2493:9448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0035; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2493
msgctxt "text_id=9448 | speaker=aoko"
msgid "　何に対してのものかは、あんまり言いたくないけど」"
msgstr ""

#. Occurrence 7_3:2511:9449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0035; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2511
msgctxt "text_id=9449 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 7_3:2517:9450: scene=7_3
#: 7_3:2517
msgctxt "text_id=9450 | speaker=unknown"
msgid "　その原因が自分である事すら草十郎には分からない。"
msgstr ""

#. Occurrence 7_3:2522:9451: scene=7_3
#: 7_3:2522
msgctxt "text_id=9451 | speaker=unknown"
msgid "　そんな草十郎を見て、彼女はほんの一瞬だけ、今まで草十郎が見たことのない表情を見せた。"
msgstr ""

#. Occurrence 7_3:2556:9452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0036; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2556
msgctxt "text_id=9452 | speaker=aoko"
msgid "「じゃあね。これが最後になるかも知れないから、お別れぐらいは言っておくわ。"
msgstr ""

#. Occurrence 7_3:2562:9453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0037; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2562
msgctxt "text_id=9453 | speaker=aoko"
msgid "　貴方は有珠を甘く見すぎてる。"
msgstr ""

#. Occurrence 7_3:2568:9454: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0038; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2568
msgctxt "text_id=9454 | speaker=aoko"
msgid "　……でも、それが同時にアンタの強みなのよね。私たちには、毒にしかならないけれど」"
msgstr ""

#. Occurrence 7_3:2595:9455: scene=7_3
#: 7_3:2595
msgctxt "text_id=9455 | speaker=unknown"
msgid "　バタン、と音をたてて閉められるドア。"
msgstr ""

#. Occurrence 7_3:2600:9456: scene=7_3
#: 7_3:2600
msgctxt "text_id=9456 | speaker=unknown"
msgid "　壁ごしに歩み去っていく足音が聞こえてくる。"
msgstr ""

#. Occurrence 7_3:2605:9457: scene=7_3
#: 7_3:2605
msgctxt "text_id=9457 | speaker=unknown"
msgid "　暖房のない廊下は冷蔵庫なみの寒さのはずだが、青子は慣れているようだった。"
msgstr ""

#. Occurrence 7_3:2653:9458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0039; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2653
msgctxt "text_id=9458 | speaker=aoko"
msgid "「―――って、なんで私から出ていくんだっ。"
msgstr ""

#. Occurrence 7_3:2659:9459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0040; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2659
msgctxt "text_id=9459 | speaker=aoko"
msgid "　順番が逆！　普通、先に出てくのは<男子|そっち>じゃない」"
msgstr ""

#. Occurrence 7_3:2701:9460: scene=7_3
#: 7_3:2701
msgctxt "text_id=9460 | speaker=unknown"
msgid "　しっしっ、と青子にうながされ、部屋からほっぽり出される草十郎。"
msgstr ""

#. Occurrence 7_3:2711:9461: scene=7_3
#: 7_3:2711
msgctxt "text_id=9461 | speaker=unknown"
msgid "　バタン、と閉じられる木製の扉。"
msgstr ""

#. Occurrence 7_3:2716:9462: scene=7_3
#: 7_3:2716
msgctxt "text_id=9462 | speaker=unknown"
msgid "　思っていたほど廊下は冷えこんでいなかった。"
msgstr ""

#. Occurrence 7_3:2722:9463: scene=7_3
#: 7_3:2722
msgctxt "text_id=9463 | speaker=unknown"
msgid "　―――まあ、冷蔵庫よりはマシな程度には。"
msgstr ""

#. Occurrence 7_5:123:9464: scene=7_5
#: 7_5:123
msgctxt "text_id=9464 | speaker=unknown"
msgid "　二日目の期末試験が終わって、草十郎はひとり洋館への帰路についた。"
msgstr ""

#. Occurrence 7_5:128:9465: scene=7_5
#: 7_5:128
msgctxt "text_id=9465 | speaker=unknown"
msgid "　坂道は上に行くほど傾斜を増していき、森も深さを増していく。"
msgstr ""

#. Occurrence 7_5:133:9466: scene=7_5
#: 7_5:133
msgctxt "text_id=9466 | speaker=unknown"
msgid "　それが二十分以上も続くのだから、地域住人たちにとって久遠寺邸のある丘は山以外の何物でもない。"
msgstr ""

#. Occurrence 7_5:153:9467: scene=7_5
#: 7_5:153
msgctxt "text_id=9467 | speaker=unknown"
msgid "　一方、草十郎にすれば歩くだけで踏破できる森を山と呼ぶには抵抗がある。"
msgstr ""

#. Occurrence 7_5:158:9468: scene=7_5
#: 7_5:158
msgctxt "text_id=9468 | speaker=unknown"
msgid "　舗装された道があり、"
msgstr ""

#. Occurrence 7_5:163:9469: scene=7_5
#: 7_5:163
msgctxt "text_id=9469 | speaker=unknown"
msgid "　日射しで方角を確かめられる程度の森であり、"
msgstr ""

#. Occurrence 7_5:168:9470: scene=7_5
#: 7_5:168
msgctxt "text_id=9470 | speaker=unknown"
msgid "　急な斜面も、<茂|しげ>みに<潜|ひそ>む動物の姿もない。"
msgstr ""

#. Occurrence 7_5:173:9471: scene=7_5
#: 7_5:173
msgctxt "text_id=9471 | speaker=unknown"
msgid "　ここでは遭難の恐れはおろか、迷う事を心配する必要もないのだから。"
msgstr ""

#. Occurrence 7_5:205:9472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0000; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:205
msgctxt "text_id=9472 | speaker=soujuurou"
msgid "「……情けない。まだ未練ばっかりだ」"
msgstr ""

#. Occurrence 7_5:211:9473: scene=7_5
#: 7_5:211
msgctxt "text_id=9473 | speaker=unknown"
msgid "　知らず知らずのうち回想していた自分を、草十郎は静かに罵倒した。"
msgstr ""

#. Occurrence 7_5:216:9474: scene=7_5
#: 7_5:216
msgctxt "text_id=9474 | speaker=unknown"
msgid "　町に引っ越してきてからの数週間は、山と町を比較してばかりだった。"
msgstr ""

#. Occurrence 7_5:236:9475: scene=7_5
#: 7_5:236
msgctxt "text_id=9475 | speaker=unknown"
msgid "　その時はこんな風に自分を叱る事もなかったが、"
msgstr ""

#. Occurrence 7_5:236:9476: scene=7_5
#: 7_5:236
msgctxt "text_id=9476 | speaker=unknown"
msgid "　ここ数日―――蒼崎青子と知り合ってからは、それが後ろ向きだという事にようやく気が付いたのだ。"
msgstr ""

#. Occurrence 7_5:241:9477: scene=7_5
#: 7_5:241
msgctxt "text_id=9477 | speaker=unknown"
msgid "　理由、理念はどうあれ立ち止まらない少女。"
msgstr ""

#. Occurrence 7_5:250:9478: scene=7_5
#: 7_5:250
msgctxt "text_id=9478 | speaker=unknown"
msgid "　その姿を目で追ううちに、自分も自然と早足になっていたらしい。"
msgstr ""

#. Occurrence 7_5:290:9479: scene=7_5
#: 7_5:290
msgctxt "text_id=9479 | speaker=unknown"
msgid "　その青子が住む洋館は、活き活きとした彼女には不釣り合いな<趣|おもむき>だ。"
msgstr ""

#. Occurrence 7_5:295:9480: scene=7_5
#: 7_5:295
msgctxt "text_id=9480 | speaker=unknown"
msgid "　三咲町の中でも<一際|ひときわ>異彩な建物。"
msgstr ""

#. Occurrence 7_5:300:9481: scene=7_5
#: 7_5:300
msgctxt "text_id=9481 | speaker=unknown"
msgid "　幽霊屋敷と呼ばれる洋館。"
msgstr ""

#. Occurrence 7_5:305:9482: scene=7_5
#: 7_5:305
msgctxt "text_id=9482 | speaker=unknown"
msgid "　実際住んでいるのは幽霊ではなく魔法使いなのだけど、どっちもどっちなので、世論というのはわりと正しいのかもしれない。"
msgstr ""

#. Occurrence 7_5:347:9483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0001; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:347
msgctxt "text_id=9483 | speaker=soujuurou"
msgid "「……そう言えば。幽霊と魔法使いっていうのは、どっちが常識はずれなんだろう？」"
msgstr ""

#. Occurrence 7_5:353:9484: scene=7_5
#: 7_5:353
msgctxt "text_id=9484 | speaker=unknown"
msgid "　都会の生活に慣れていない自分を棚に上げて、草十郎ははて、と首をひねる。"
msgstr ""

#. Occurrence 7_5:358:9485: scene=7_5
#: 7_5:358
msgctxt "text_id=9485 | speaker=unknown"
msgid "　ともあれ、どちらにしてもやるべき事は変わらない。"
msgstr ""

#. Occurrence 7_5:378:9486: scene=7_5
#: 7_5:378
msgctxt "text_id=9486 | speaker=unknown"
msgid "　期末試験は明日で終わりだ。"
msgstr ""

#. Occurrence 7_5:383:9487: scene=7_5
#: 7_5:383
msgctxt "text_id=9487 | speaker=unknown"
msgid "　青子が責任持って草十郎を保護する、といったリミットまであとわずか。"
msgstr ""

#. Occurrence 7_5:388:9488: scene=7_5
#: 7_5:388
msgctxt "text_id=9488 | speaker=unknown"
msgid "　可能であるなら今日のうちに、草十郎は洋館の主に同居人として認められなくてはいけない。"
msgstr ""

#. Occurrence 7_5:426:9489: scene=7_5
#: 7_5:426
msgctxt "text_id=9489 | speaker=unknown"
msgid "　館をぐるりと囲む木々の隙間、自然の並木道を通って、草十郎は玄関まで歩いていく。"
msgstr ""

#. Occurrence 7_5:435:9490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0002; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:435
msgctxt "text_id=9490 | speaker=soujuurou"
msgid "「――――――よし」"
msgstr ""

#. Occurrence 7_5:440:9491: scene=7_5
#: 7_5:440
msgctxt "text_id=9491 | speaker=unknown"
msgid "　玄関の前で一度だけ深呼吸をし、草十郎は館内へと入っていった。"
msgstr ""

#. Occurrence 7_5:445:9492: scene=7_5
#: 7_5:445
msgctxt "text_id=9492 | speaker=unknown"
msgid "　目指すは有珠がいるであろう居間である。"
msgstr ""

#. Occurrence 7_5:483:9493: scene=7_5
#: 7_5:483
msgctxt "text_id=9493 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 7_5:488:9494: scene=7_5
#: 7_5:488
msgctxt "text_id=9494 | speaker=unknown"
msgid "　そんな草十郎を迎えたのは、予想外の光景だった。"
msgstr ""

#. Occurrence 7_5:508:9495: scene=7_5
#: 7_5:508
msgctxt "text_id=9495 | speaker=unknown"
msgid "　少し歩いて、玄関から館のホールであるロビーに辿り着く。"
msgstr ""

#. Occurrence 7_5:528:9496: scene=7_5
#: 7_5:528
msgctxt "text_id=9496 | speaker=unknown"
msgid "　そのロビーにひとつ、大きな違和感がある。"
msgstr ""

#. Occurrence 7_5:533:9497: scene=7_5
#: 7_5:533
msgctxt "text_id=9497 | speaker=unknown"
msgid "　中世の城を思わせる洋館のロビー。"
msgstr ""

#. Occurrence 7_5:538:9498: scene=7_5
#: 7_5:538
msgctxt "text_id=9498 | speaker=unknown"
msgid "　人工の明かりは一切なく、冬の肌寒い日射しが、さあ、と天窓から影を落としている。"
msgstr ""

#. Occurrence 7_5:574:9499: scene=7_5
#: 7_5:574
msgctxt "text_id=9499 | speaker=unknown"
msgid "　緑薫る、木製のタイル。"
msgstr ""

#. Occurrence 7_5:592:9500: scene=7_5
#: 7_5:592
msgctxt "text_id=9500 | speaker=unknown"
msgid "　四角い大樹によりそう黒衣。"
msgstr ""

#. Occurrence 7_5:610:9501: scene=7_5
#: 7_5:610
msgctxt "text_id=9501 | speaker=unknown"
msgid "　少女は文字通り、洋館に体を預けている。"
msgstr ""

#. Occurrence 7_5:628:9502: scene=7_5
#: 7_5:628
msgctxt "text_id=9502 | speaker=unknown"
msgid "　母親の子守歌か、穏やかな揺りかごか。"
msgstr ""

#. Occurrence 7_5:646:9503: scene=7_5
#: 7_5:646
msgctxt "text_id=9503 | speaker=unknown"
msgid "　洋館は少女の眠りを守るように、空気のざわめきさえ飲みこんでいた。"
msgstr ""

#. Occurrence 7_5:680:9504: scene=7_5
#: 7_5:680
msgctxt "text_id=9504 | speaker=unknown"
msgid "　館の影で眠る少女。"
msgstr ""

#. Occurrence 7_5:685:9505: scene=7_5
#: 7_5:685
msgctxt "text_id=9505 | speaker=unknown"
msgid "　余人の目から隠された有珠の姿は、このロビーで最も鮮明に、見る者を魅了する。"
msgstr ""

#. Occurrence 7_5:706:9506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0003; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:706
msgctxt "text_id=9506 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_5:711:9507: scene=7_5
#: 7_5:711
msgctxt "text_id=9507 | speaker=unknown"
msgid "　草十郎は当惑から、つい天井をあおいでしまった。"
msgstr ""

#. Occurrence 7_5:717:9508: scene=7_5
#: 7_5:717
msgctxt "text_id=9508 | speaker=unknown"
msgid "　……だって、不意打ちにも程がある。"
msgstr ""

#. Occurrence 7_5:722:9509: scene=7_5
#: 7_5:722
msgctxt "text_id=9509 | speaker=unknown"
msgid "　少女は暖炉の傍で、その細い体を預けて眠っている。"
msgstr ""

#. Occurrence 7_5:727:9510: scene=7_5
#: 7_5:727
msgctxt "text_id=9510 | speaker=unknown"
msgid "　いかに美しい絵画のようでも、この状況は心臓に悪い。"
msgstr ""

#. Occurrence 7_5:761:9511: scene=7_5
#: 7_5:761
msgctxt "text_id=9511 | speaker=unknown"
msgid "　……命を感じさせない眠り。"
msgstr ""

#. Occurrence 7_5:766:9512: scene=7_5
#: 7_5:766
msgctxt "text_id=9512 | speaker=unknown"
msgid "　あまりにも静かで、取り除くもののないカタチ。"
msgstr ""

#. Occurrence 7_5:780:9513: scene=7_5
#: 7_5:780
msgctxt "text_id=9513 | speaker=unknown"
msgid "　この寒空の下、冷たい柱にしなだれているのに、彼女は幸福に包まれていた。"
msgstr ""

#. Occurrence 7_5:786:9514: scene=7_5
#: 7_5:786
msgctxt "text_id=9514 | speaker=unknown"
msgid "　死という名の永眠を、見る者に思わせてしまうほどの。"
msgstr ""

#. Occurrence 7_5:859:9515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0004; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:859
msgctxt "text_id=9515 | speaker=soujuurou"
msgid "「……寒くないのかな、この子は」"
msgstr ""

#. Occurrence 7_5:865:9516: scene=7_5
#: 7_5:865
msgctxt "text_id=9516 | speaker=unknown"
msgid "　ぼんやりと有珠を眺めながら、ぽつりと呟く。"
msgstr ""

#. Occurrence 7_5:870:9517: scene=7_5
#: 7_5:870
msgctxt "text_id=9517 | speaker=unknown"
msgid "　毛布でも持ってくる……なんて気の利いた案を、彼は微塵も考えなかった。"
msgstr ""

#. Occurrence 7_5:886:9518: scene=7_5
#: 7_5:886
msgctxt "text_id=9518 | speaker=unknown"
msgid "　代わりに思いついた事は、なぜか、ふたり分のお茶を淹れる事だった。"
msgstr ""

#. Occurrence 7_5:927:9519: scene=7_5
#: 7_5:927
msgctxt "text_id=9519 | speaker=unknown"
msgid "　静かにドアを開けて居間に移動する。"
msgstr ""

#. Occurrence 7_5:932:9520: scene=7_5
#: 7_5:932
msgctxt "text_id=9520 | speaker=unknown"
msgid "　テーブルの上には三粒の錠剤。"
msgstr ""

#. Occurrence 7_5:937:9521: scene=7_5
#: 7_5:937
msgctxt "text_id=9521 | speaker=unknown"
msgid "　毎日帰ってきたら飲むように、と青子から言われている薬である。"
msgstr ""

#. Occurrence 7_5:942:9522: scene=7_5
#: 7_5:942
msgctxt "text_id=9522 | speaker=unknown"
msgid "　わずかに甘い錠剤を飲みこんで台所に足を運び、数ある紅茶の箱からひとつを選んで、ふたり分の紅茶を淹れる。"
msgstr ""

#. Occurrence 7_5:958:9523: scene=7_5
#: 7_5:958
msgctxt "text_id=9523 | speaker=unknown"
msgid "　そうしてロビーに戻ってみても、少女は眠ったままだった。"
msgstr ""

#. Occurrence 7_5:1005:9524: scene=7_5
#: 7_5:1005
msgctxt "text_id=9524 | speaker=unknown"
msgid "　物音に少しだけ気を配って床に腰を下ろす。"
msgstr ""

#. Occurrence 7_5:1010:9525: scene=7_5
#: 7_5:1010
msgctxt "text_id=9525 | speaker=unknown"
msgid "　ズボン越しに伝わってくる床の<感触|つめたさ>にビックリする。"
msgstr ""

#. Occurrence 7_5:1015:9526: scene=7_5
#: 7_5:1015
msgctxt "text_id=9526 | speaker=unknown"
msgid "　暖炉の<傍|そば>なら温かいのでは、と考えもしたが、青子曰く、あの暖炉は無用の長物とかなんとか。"
msgstr ""

#. Occurrence 7_5:1020:9527: scene=7_5
#: 7_5:1020
msgctxt "text_id=9527 | speaker=unknown"
msgid "　青子も有珠も手入れの仕方を知らないらしい。"
msgstr ""

#. Occurrence 7_5:1053:9528: scene=7_5
#: 7_5:1053
msgctxt "text_id=9528 | speaker=unknown"
msgid "　草十郎は盆に載せたティーカップを有珠と自分の前に置くと、おもむろに鞄から古典の教科書を取り出した。"
msgstr ""

#. Occurrence 7_5:1074:9529: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0005; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1074
msgctxt "text_id=9529 | speaker=soujuurou"
msgid "「……蒼崎、怒ってたからな」"
msgstr ""

#. Occurrence 7_5:1080:9530: scene=7_5
#: 7_5:1080
msgctxt "text_id=9530 | speaker=unknown"
msgid "　今朝の青子の顔を思い出して、つい独白する。"
msgstr ""

#. Occurrence 7_5:1085:9531: scene=7_5
#: 7_5:1085
msgctxt "text_id=9531 | speaker=unknown"
msgid "　彼女が怒っていた理由も、あの一瞬の顔もまったく意味不明のままだ。"
msgstr ""

#. Occurrence 7_5:1105:9532: scene=7_5
#: 7_5:1105
msgctxt "text_id=9532 | speaker=unknown"
msgid "　それはそれとして、明日にそなえて復習をしなくてはいけない事だけはハッキリしていた。"
msgstr ""

#. Occurrence 7_5:1110:9533: scene=7_5
#: 7_5:1110
msgctxt "text_id=9533 | speaker=unknown"
msgid "　青子のおかげで今日のテストは幾分ましになったけれど、明日の科目はさらに難敵だ。"
msgstr ""

#. Occurrence 7_5:1115:9534: scene=7_5
#: 7_5:1115
msgctxt "text_id=9534 | speaker=unknown"
msgid "　今朝から怒っている彼女が今夜も手伝ってくれるとは思えない。"
msgstr ""

#. Occurrence 7_5:1143:9535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0006; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1143
msgctxt "text_id=9535 | speaker=soujuurou"
msgid "「そのくせ点数悪いと怒るし。別に、蒼崎が怒る筋合いじゃないと思う」"
msgstr ""

#. Occurrence 7_5:1150:9536: scene=7_5
#: 7_5:1150
msgctxt "text_id=9536 | speaker=unknown"
msgid "　文句を言いつつ教科書を開く。"
msgstr ""

#. Occurrence 7_5:1168:9537: scene=7_5
#: 7_5:1168
msgctxt "text_id=9537 | speaker=unknown"
msgid "　有珠の目が覚めるまで、そうやって待つつもりらしい。"
msgstr ""

#. Occurrence 7_5:1188:9538: scene=7_5
#: 7_5:1188
msgctxt "text_id=9538 | speaker=unknown"
msgid "　ホールにはページをめくる音だけが響いていく。"
msgstr ""

#. Occurrence 7_5:1193:9539: scene=7_5
#: 7_5:1193
msgctxt "text_id=9539 | speaker=unknown"
msgid "　時計の針も、森のざわめきも届かない<午睡|ごすい>。"
msgstr ""

#. Occurrence 7_5:1199:9540: scene=7_5
#: 7_5:1199
msgctxt "text_id=9540 | speaker=unknown"
msgid "　……数時間が経って、草十郎は静かに立ち上がった。"
msgstr ""

#. Occurrence 7_5:1204:9541: scene=7_5
#: 7_5:1204
msgctxt "text_id=9541 | speaker=unknown"
msgid "　ロビーに差しこむ日射しは、白から赤に変わりつつある。"
msgstr ""

#. Occurrence 7_5:1225:9542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0007; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1225
msgctxt "text_id=9542 | speaker=soujuurou"
msgid "「そろそろバイトの時間か」"
msgstr ""

#. Occurrence 7_5:1244:9543: scene=7_5
#: 7_5:1244
msgctxt "text_id=9543 | speaker=unknown"
msgid "　固まった背筋を伸ばして、草十郎はちらりと有珠を見た。"
msgstr ""

#. Occurrence 7_5:1249:9544: scene=7_5
#: 7_5:1249
msgctxt "text_id=9544 | speaker=unknown"
msgid "　眠りは変わらず穏やかだ。"
msgstr ""

#. Occurrence 7_5:1255:9545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0008; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1255
msgctxt "text_id=9545 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 7_5:1260:9546: scene=7_5
#: 7_5:1260
msgctxt "text_id=9546 | speaker=unknown"
msgid "　む、と草十郎は真剣に眉をよせる。"
msgstr ""

#. Occurrence 7_5:1265:9547: scene=7_5
#: 7_5:1265
msgctxt "text_id=9547 | speaker=unknown"
msgid "　このまま寝かせておいていいのか、有珠の日常を知らない彼には悩みどころだ。"
msgstr ""

#. Occurrence 7_5:1286:9548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0009; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1286
msgctxt "text_id=9548 | speaker=soujuurou"
msgid "「……いや。蒼崎も帰ってくるだろうし、いらぬ世話かな」"
msgstr ""

#. Occurrence 7_5:1304:9549: scene=7_5
#: 7_5:1304
msgctxt "text_id=9549 | speaker=unknown"
msgid "　いかなる思考が生み出した結論か、草十郎はひとり頷いて洋館を後にした。"
msgstr ""

#. Occurrence 7_5:1320:9550: scene=7_5
#: 7_5:1320
msgctxt "text_id=9550 | speaker=unknown"
msgid "　今日のバイト先は三咲町商店街にある、中華飯店まっどべあである。"
msgstr ""

#. Occurrence 7_6:69:9551: scene=7_6
#: 7_6:69
msgctxt "text_id=9551 | speaker=unknown"
msgid "　その制服は、輝かんばかりの色彩センスで作られていた。"
msgstr ""

#. Occurrence 7_6:74:9552: scene=7_6
#: 7_6:74
msgctxt "text_id=9552 | speaker=unknown"
msgid "　オレンジ一色のエプロンにはデフォルメされた白熊が一頭、その強靱な爪で中華鍋を<爆砕|ばくさい>している。"
msgstr ""

#. Occurrence 7_6:79:9553: scene=7_6
#: 7_6:79
msgctxt "text_id=9553 | speaker=unknown"
msgid "　三咲町周辺では他の追随を許さないほど独創的な、山岳地帯の標識と見まがうデザインだ。"
msgstr ""

#. Occurrence 7_6:115:9554: scene=7_6
#: 7_6:115
msgctxt "text_id=9554 | speaker=unknown"
msgid "　ここは中華飯店まっどべあ。"
msgstr ""

#. Occurrence 7_6:120:9555: scene=7_6
#: 7_6:120
msgctxt "text_id=9555 | speaker=unknown"
msgid "　地域密着型の、名前とロゴ以外はどこにでもある大衆食堂。"
msgstr ""

#. Occurrence 7_6:125:9556: scene=7_6
#: 7_6:125
msgctxt "text_id=9556 | speaker=unknown"
msgid "　近年増えはじめているファミリーレストランに押されはじめているものの、食事処として日々絶賛営業中の老舗である。"
msgstr ""

#. Occurrence 7_6:145:9557: scene=7_6
#: 7_6:145
msgctxt "text_id=9557 | speaker=unknown"
msgid "　近隣住民との触れ合いを大切にする彼らは、サービスの一環として出張配達も行っていた。"
msgstr ""

#. Occurrence 7_6:150:9558: scene=7_6
#: 7_6:150
msgctxt "text_id=9558 | speaker=unknown"
msgid "　人呼んで『<Ｑ|クイック>　<Ｋ|キラー>　<Ｓ|サービス>　・森のクマさん』。"
msgstr ""

#. Occurrence 7_6:155:9559: scene=7_6
#: 7_6:155
msgctxt "text_id=9559 | speaker=unknown"
msgid "　現在、草十郎のおもな仕事はその出前役である。"
msgstr ""

#. Occurrence 7_6:160:9560: scene=7_6
#: 7_6:160
msgctxt "text_id=9560 | speaker=unknown"
msgid "　自転車で宅配が可能な三咲丘周辺は彼の受け持ちで、出前先が遠くなると先輩方の愛車・万能50ccキングサーモン号の出番となるがどうでもいい。"
msgstr ""

#. Occurrence 7_6:193:9561: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0000; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:193
msgctxt "text_id=9561 | speaker=kinomi"
msgid "「<社木|やしろぎ>のダチから聞いたんだけどな」"
msgstr ""

#. Occurrence 7_6:199:9562: scene=7_6
#: 7_6:199
msgctxt "text_id=9562 | speaker=unknown"
msgid "　出前待機中の配達人は、暇さえあればウェイターと洗い物を一身に引き受ける。"
msgstr ""

#. Occurrence 7_6:204:9563: scene=7_6
#: 7_6:204
msgctxt "text_id=9563 | speaker=unknown"
msgid "　今日はまだ夕飯時になっていないので、宅配専門の彼らは厨房で仲良く皿洗いをしていた。"
msgstr ""

#. Occurrence 7_6:236:9564: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0001; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:236
msgctxt "text_id=9564 | speaker=kinomi"
msgid "「聞いてるか、静希」"
msgstr ""

#. Occurrence 7_6:242:9565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0000; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:242
msgctxt "text_id=9565 | speaker=soujuurou"
msgid "「聞いてるよ、木乃美」"
msgstr ""

#. Occurrence 7_6:248:9566: scene=7_6
#: 7_6:248
msgctxt "text_id=9566 | speaker=unknown"
msgid "　学生バイトである彼らは大きな流し台に両手をつっこんだまま、熱心に仕事をしている……フリをしながら話しこんでいる。"
msgstr ""

#. Occurrence 7_6:274:9567: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0002; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:274
msgctxt "text_id=9567 | speaker=kinomi"
msgid "「和食のケニヤだけじゃねえんだってよ。三咲町の<大帝都|だいていと>にもメシアンにもその手の注文があったらしいぜ。"
msgstr ""

#. Occurrence 7_6:280:9568: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0003; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:280
msgctxt "text_id=9568 | speaker=kinomi"
msgid "　そんなに肉がほしいなら<下市|したいち>に行けばいいのにな。なんだって、生肉だの大物の鮭まるごとだのを出前させやがるのか。"
msgstr ""

#. Occurrence 7_6:291:9569: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0004; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:291
msgctxt "text_id=9569 | speaker=kinomi"
msgid "　どうよ。こう、露骨にやばそうな話じゃねえ？　ワニとかアザラシでも飼ってるんじゃねえかな、そいつ」"
msgstr ""

#. Occurrence 7_6:312:9570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0001; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:312
msgctxt "text_id=9570 | speaker=soujuurou"
msgid "「他に比べてみると、たしかに珍しい話だと思う。ところで木乃美、ワニってなんだ？」"
msgstr ""

#. Occurrence 7_6:335:9571: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0005; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:335
msgctxt "text_id=9571 | speaker=kinomi"
msgid "「ワニはワニだろー。だっせぇ、実物見たコトないのかよー。まあオレもねえけどな。"
msgstr ""

#. Occurrence 7_6:346:9572: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0006; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:346
msgctxt "text_id=9572 | speaker=kinomi"
msgid "　んー、今度がくがく動物ランドのアフリカ特集ビデオを貸してやるから、見とけよ」"
msgstr ""

#. Occurrence 7_6:351:9573: scene=7_6
#: 7_6:351
msgctxt "text_id=9573 | speaker=unknown"
msgid "　木乃美も慣れたもので、草十郎への対応が板に付いてきている。"
msgstr ""

#. Occurrence 7_6:387:9574: scene=7_6
#: 7_6:387
msgctxt "text_id=9574 | speaker=unknown"
msgid "　そんなとりとめのない会話をしていると、出前の注文を告げる電話が鳴った。マネージャーが素早く受話器を取り、注文と住所を確認する。"
msgstr ""

#. Occurrence 7_6:392:9575: scene=7_6
#: 7_6:392
msgctxt "text_id=9575 | speaker=unknown"
msgid "　受話器が置かれると、厨房に集まっている宅配者たちはみんなそっぽを向いた。"
msgstr ""

#. Occurrence 7_6:397:9576: scene=7_6
#: 7_6:397
msgctxt "text_id=9576 | speaker=unknown"
msgid "　この寒空の中、風をきって出前に行くのは誰だって嫌なものだ。"
msgstr ""

#. Occurrence 7_6:420:9577: voice_id=D20_7_6_0000; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:420
msgctxt "text_id=9577 | speaker=unknown"
msgid "「静希くん。ちょっと遠いけど、配達お願い」"
msgstr ""

#. Occurrence 7_6:426:9578: scene=7_6
#: 7_6:426
msgctxt "text_id=9578 | speaker=unknown"
msgid "　そんな根性無しのアルバイターたちに失望する様子もなく、マネージャーは草十郎へ声をかけた。"
msgstr ""

#. Occurrence 7_6:447:9579: voice_id=D20_7_6_0001; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:447
msgctxt "text_id=9579 | speaker=unknown"
msgid "「はいこれ、届けるもののリスト。異例だからあまり他のバイトには他言しないようにね」"
msgstr ""

#. Occurrence 7_6:453:9580: scene=7_6
#: 7_6:453
msgctxt "text_id=9580 | speaker=unknown"
msgid "　マネージャーの手には注文と住所を書き留めたメモ用紙が一枚。"
msgstr ""

#. Occurrence 7_6:458:9581: scene=7_6
#: 7_6:458
msgctxt "text_id=9581 | speaker=unknown"
msgid "　それを受け取って、草十郎は静かに顔をしかめた。"
msgstr ""

#. Occurrence 7_6:487:9582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0002; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:487
msgctxt "text_id=9582 | speaker=soujuurou"
msgid "「マネージャー」"
msgstr ""

#. Occurrence 7_6:493:9583: voice_id=D20_7_6_0002; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:493
msgctxt "text_id=9583 | speaker=unknown"
msgid "「なんだい？」"
msgstr ""

#. Occurrence 7_6:498:9584: scene=7_6
#: 7_6:498
msgctxt "text_id=9584 | speaker=unknown"
msgid "　言いたい事は分かっている、とばかりにマネージャーは草十郎を見つめ返す。"
msgstr ""

#. Occurrence 7_6:519:9585: voice_id=D20_7_6_0003; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:519
msgctxt "text_id=9585 | speaker=unknown"
msgid "「君の疑問はもっともだ。しかし、まあ、長いことこの商売をやっていると、時にはこんな馬鹿な話が転がってくる事もある。そうおかしなコトじゃない。"
msgstr ""

#. Occurrence 7_6:525:9586: voice_id=D20_7_6_0004; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:525
msgctxt "text_id=9586 | speaker=unknown"
msgid "　じゃ、冷蔵庫から品物持ってくるから」"
msgstr ""

#. Occurrence 7_6:530:9587: scene=7_6
#: 7_6:530
msgctxt "text_id=9587 | speaker=unknown"
msgid "　ごく自然に厨房を後にする黒服のマネージャーの姿を、なるほど、と感心して草十郎は眺めた。"
msgstr ""

#. Occurrence 7_6:535:9588: scene=7_6
#: 7_6:535
msgctxt "text_id=9588 | speaker=unknown"
msgid "　どんな所でも、おかしな話はあるものらしい。"
msgstr ""

#. Occurrence 7_6:624:9589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0000; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:624
msgctxt "text_id=9589 | speaker=aoko"
msgid "「遅いっ！」"
msgstr ""

#. Occurrence 7_6:652:9590: scene=7_6
#: 7_6:652
msgctxt "text_id=9590 | speaker=unknown"
msgid "　午後十時過ぎ。"
msgstr ""

#. Occurrence 7_6:657:9591: scene=7_6
#: 7_6:657
msgctxt "text_id=9591 | speaker=unknown"
msgid "　アルバイトを終え、ちょっとした寄り道をしてきた草十郎を迎えたのは、ごらんの通り、<怒|いか>れる蒼崎青子だった。"
msgstr ""

#. Occurrence 7_6:691:9592: scene=7_6
#: 7_6:691
msgctxt "text_id=9592 | speaker=unknown"
msgid "　目に見えて不機嫌そうな彼女を見て、草十郎はホッと胸をなで下ろす。"
msgstr ""

#. Occurrence 7_6:696:9593: scene=7_6
#: 7_6:696
msgctxt "text_id=9593 | speaker=unknown"
msgid "　青子がなぜ怒っているのか不明だが、今朝の分かりづらい怒りとは別種のものだったからだ。"
msgstr ""

#. Occurrence 7_6:722:9594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9594 | speaker=soujuurou"
msgid "「遅いって、まだ十時になったばかりだろう。"
msgstr ""

#. Occurrence 7_6:722:9595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9595 | speaker=soujuurou"
msgid "　どうしたんだ、蒼崎」"
msgstr ""

#. Occurrence 7_6:744:9596: scene=7_6
#: 7_6:744
msgctxt "text_id=9596 | speaker=unknown"
msgid "　両手に抱えたダンボールを床に下ろしながら、草十郎は暖炉のあたりに視線を向ける。"
msgstr ""

#. Occurrence 7_6:749:9597: scene=7_6
#: 7_6:749
msgctxt "text_id=9597 | speaker=unknown"
msgid "　ひとり眠っていた少女の姿はない。"
msgstr ""

#. Occurrence 7_6:783:9598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0001; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:783
msgctxt "text_id=9598 | speaker=aoko"
msgid "「違うわ。もう十時になった、の間違いでしょ。"
msgstr ""

#. Occurrence 7_6:789:9599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0002; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:789
msgctxt "text_id=9599 | speaker=aoko"
msgid "　アンタってほんと、自分がどんな状態にあるか分かってないのね」"
msgstr ""

#. Occurrence 7_6:807:9600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0004; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:807
msgctxt "text_id=9600 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 7_6:813:9601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0003; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:813
msgctxt "text_id=9601 | speaker=aoko"
msgid "「いいから、居間に来て」"
msgstr ""

#. Occurrence 7_6:849:9602: scene=7_6
#: 7_6:849
msgctxt "text_id=9602 | speaker=unknown"
msgid "　首を傾げる草十郎をよそに、青子はスタスタと居間へと歩いて行く。"
msgstr ""

#. Occurrence 7_6:854:9603: scene=7_6
#: 7_6:854
msgctxt "text_id=9603 | speaker=unknown"
msgid "　ダンボール箱を抱え直し、草十郎もいそいそと後に続く。"
msgstr ""

#. Occurrence 7_6:901:9604: scene=7_6
#: 7_6:901
msgctxt "text_id=9604 | speaker=unknown"
msgid "　草十郎はコートを脱いで、コートハンガーに掛けながら居間に入った。"
msgstr ""

#. Occurrence 7_6:906:9605: scene=7_6
#: 7_6:906
msgctxt "text_id=9605 | speaker=unknown"
msgid "　有珠は自室に引きこもっているようだ。"
msgstr ""

#. Occurrence 7_6:911:9606: scene=7_6
#: 7_6:911
msgctxt "text_id=9606 | speaker=unknown"
msgid "　テーブルの上にはお馴染みの錠剤が置かれている。"
msgstr ""

#. Occurrence 7_6:947:9607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0004; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:947
msgctxt "text_id=9607 | speaker=aoko"
msgid "「……説明しなかった私も悪いけど、貴方も帰ってくる時間は守ってよね。こっちはそのつもりで作ってるんだから」"
msgstr ""

#. Occurrence 7_6:959:9608: scene=7_6
#: 7_6:959
msgctxt "text_id=9608 | speaker=unknown"
msgid "　はい、とテーブル上の錠剤と、水の入ったコップを差しだす青子。"
msgstr ""

#. Occurrence 7_6:992:9609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9609 | speaker=soujuurou"
msgid "「？　薬なら出かける前に飲んだけど。"
msgstr ""

#. Occurrence 7_6:992:9610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9610 | speaker=soujuurou"
msgid "　体の調子だって悪くないし、そんなにあわてるコトか？」"
msgstr ""

#. Occurrence 7_6:1011:9611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0005; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1011
msgctxt "text_id=9611 | speaker=aoko"
msgid "「は？　なんだって私たちがアンタの健康気にかけなくちゃいけないのよ」"
msgstr ""

#. Occurrence 7_6:1058:9612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0006; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1058
msgctxt "text_id=9612 | speaker=aoko"
msgid "「勘違いしてるようだけど、アンタが帰ってくる度に飲んでるのって、平たく言えば毒よ？"
msgstr ""

#. Occurrence 7_6:1064:9613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0007; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1064
msgctxt "text_id=9613 | speaker=aoko"
msgid "　速効性じゃないから効き目は半日すると出てくるんだけど、その前に新しい<錠剤|どくやく>を飲んでおかないと、古い毒が体に回ってばったり逝くって寸法ね。"
msgstr ""

#. Occurrence 7_6:1102:9614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0008; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1102
msgctxt "text_id=9614 | speaker=aoko"
msgid "　有珠のヤツ、これぐらいしないと信用できないって言い張ったのよ」"
msgstr ""

#. Occurrence 7_6:1142:9615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0009; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1142
msgctxt "text_id=9615 | speaker=aoko"
msgid "「ほら、分かったらさっさと飲む。"
msgstr ""

#. Occurrence 7_6:1155:9616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0010; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1155
msgctxt "text_id=9616 | speaker=aoko"
msgid "　……ま、私もこれ、面倒だと思うし。"
msgstr ""

#. Occurrence 7_6:1161:9617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0011; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1161
msgctxt "text_id=9617 | speaker=aoko"
msgid "　近いうちもっと形のある方法を考えてみるから、それまでこの方法で我慢して」"
msgstr ""

#. Occurrence 7_6:1209:9618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0006; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1209
msgctxt "text_id=9618 | speaker=soujuurou"
msgid "「……言ってる事は支離滅裂だが、とにかく今までよくない物を飲んでたんだな？」"
msgstr ""

#. Occurrence 7_6:1249:9619: scene=7_6
#: 7_6:1249
msgctxt "text_id=9619 | speaker=unknown"
msgid "　青子から錠剤を受け取って、草十郎は一口で飲みこんだ。"
msgstr ""

#. Occurrence 7_6:1274:9620: scene=7_6
#: 7_6:1274
msgctxt "text_id=9620 | speaker=unknown"
msgid "　毒物だと聞いて<怯|ひる>んだ素振りもない。"
msgstr ""

#. Occurrence 7_6:1279:9621: scene=7_6
#: 7_6:1279
msgctxt "text_id=9621 | speaker=unknown"
msgid "　どうも、青子たちの横暴を非難する気はないらしい。"
msgstr ""

#. Occurrence 7_6:1318:9622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0007; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1318
msgctxt "text_id=9622 | speaker=soujuurou"
msgid "「まったく。毒をもって毒を制するなんて、また古風な真似するな、蒼崎も有珠も」"
msgstr ""

#. Occurrence 7_6:1324:9623: scene=7_6
#: 7_6:1324
msgctxt "text_id=9623 | speaker=unknown"
msgid "　笑いのツボに入ったらしく、草十郎は頬を<緩|ゆる>ませる。"
msgstr ""

#. Occurrence 7_6:1344:9624: scene=7_6
#: 7_6:1344
msgctxt "text_id=9624 | speaker=unknown"
msgid "　一方、青子的には、どうしてそこで笑うのかまったくもって理解不能なのだった。"
msgstr ""

#. Occurrence 7_6:1373:9625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0008; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1373
msgctxt "text_id=9625 | speaker=soujuurou"
msgid "「今日帰りが遅れたのは、アパートまで荷物を取りにいっていたからなんだ。そういうコトなら、電話のひとつでもすればよかった」"
msgstr ""

#. Occurrence 7_6:1385:9626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0012; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1385
msgctxt "text_id=9626 | speaker=aoko"
msgid "「……荷物って、まさかそれじゃないでしょうね」"
msgstr ""

#. Occurrence 7_6:1391:9627: scene=7_6
#: 7_6:1391
msgctxt "text_id=9627 | speaker=unknown"
msgid "　持ってきたダンボール箱を指差され、草十郎はもちろん、と頷く。"
msgstr ""

#. Occurrence 7_6:1426:9628: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0009; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1426
msgctxt "text_id=9628 | speaker=soujuurou"
msgid "「住んでいないのに家賃を払うのは馬鹿らしいから、今日で引き上げてきた。いちおう、いつでも戻れるように話はつけてあるから、三ヶ月ぐらいは大丈夫だよ」"
msgstr ""

#. Occurrence 7_6:1445:9629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0013; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1445
msgctxt "text_id=9629 | speaker=aoko"
msgid "「家賃……？"
msgstr ""

#. Occurrence 7_6:1475:9630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_0; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1475
msgctxt "text_id=9630 | speaker=aoko"
msgid "　あ、そっか。そうよね、"
msgstr ""

#. Occurrence 7_6:1488:9631: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_1; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1488
msgctxt "text_id=9631 | speaker=aoko"
msgid "私ってばなんでそんな事を忘れてたんだろう。有珠が聞いたら喜ぶわ、そりゃ」"
msgstr ""

#. Occurrence 7_6:1513:9632: scene=7_6
#: 7_6:1513
msgctxt "text_id=9632 | speaker=unknown"
msgid "　華のような笑顔、とはこのコトか。"
msgstr ""

#. Occurrence 7_6:1518:9633: scene=7_6
#: 7_6:1518
msgctxt "text_id=9633 | speaker=unknown"
msgid "　一点の曇りもない、ズバリ、新しい<悪巧|わるだく>みを思いついた子供のような笑顔である。"
msgstr ""

#. Occurrence 7_6:1523:9634: scene=7_6
#: 7_6:1523
msgctxt "text_id=9634 | speaker=unknown"
msgid "　不吉なコトこの上ない、と来るべき脅威に震える草十郎だった。"
msgstr ""

#. Occurrence 7_6:1571:9635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0015; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1571
msgctxt "text_id=9635 | speaker=aoko"
msgid "「けど随分少ないのね、荷物。ダンボール一箱分しかないの？」"
msgstr ""

#. Occurrence 7_6:1577:9636: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0010; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1577
msgctxt "text_id=9636 | speaker=soujuurou"
msgid "「そうかな、十分多いだろ。それより有珠は自室か？」"
msgstr ""

#. Occurrence 7_6:1583:9637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0016; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1583
msgctxt "text_id=9637 | speaker=aoko"
msgid "「ちょっと前に戻ったわ。珍しく食後もここに残ってたんだけど、待ちきれなかったみたいね」"
msgstr ""

#. Occurrence 7_6:1600:9638: scene=7_6
#: 7_6:1600
msgctxt "text_id=9638 | speaker=unknown"
msgid "　青子は不敵な笑顔のまま、意味ありげな視線を草十郎に投げかける。"
msgstr ""

#. Occurrence 7_6:1649:9639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0011; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1649
msgctxt "text_id=9639 | speaker=soujuurou"
msgid "「待ちきれなかったって、何を」"
msgstr ""

#. Occurrence 7_6:1689:9640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0017; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1689
msgctxt "text_id=9640 | speaker=aoko"
msgid "「そりゃあ、有珠が眠ってるのをいいことに在庫のないフォションとブルーキャリコを勝手に使ってくれた、どこかの誰かさんにお仕置きするためなんじゃない？」"
msgstr ""

#. Occurrence 7_6:1734:9641: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0012; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1734
msgctxt "text_id=9641 | speaker=soujuurou"
msgid "「フォション……って、あのお茶の葉？」"
msgstr ""

#. Occurrence 7_6:1740:9642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0018; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1740
msgctxt "text_id=9642 | speaker=aoko"
msgid "「そう。私もびっくりしたけどね。有珠がどっかで寝入るのはよくある事だけど、紅茶を用意して眠るなんてのは初めてだったから。"
msgstr ""

#. Occurrence 7_6:1746:9643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0019; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1746
msgctxt "text_id=9643 | speaker=aoko"
msgid "　どんな心境の変化か知りたくて起こしたら、有珠の方が驚いてたわ。一体、誰の仕業なんだって」"
msgstr ""

#. Occurrence 7_6:1771:9644: scene=7_6
#: 7_6:1771
msgctxt "text_id=9644 | speaker=unknown"
msgid "　ぽん、と手を叩く草十郎。"
msgstr ""

#. Occurrence 7_6:1782:9645: scene=7_6
#: 7_6:1782
msgctxt "text_id=9645 | speaker=unknown"
msgid "　お茶の用意はしたけれど、<後|あと><片付|かたづ>けをした記憶はまったくない。"
msgstr ""

#. Occurrence 7_6:1802:9646: scene=7_6
#: 7_6:1802
msgctxt "text_id=9646 | speaker=unknown"
msgid "　まずいな、という顔をする草十郎と、そんな彼を見て楽しむ青子。"
msgstr ""

#. Occurrence 7_6:1837:9647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0013; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1837
msgctxt "text_id=9647 | speaker=soujuurou"
msgid "「そうか……それじゃあ、有珠は怒っていただろう」"
msgstr ""

#. Occurrence 7_6:1856:9648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0020; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1856
msgctxt "text_id=9648 | speaker=aoko"
msgid "「当然。駒鳥がとばっちりでドリブルされてたしね」"
msgstr ""

#. Occurrence 7_6:1869:9649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0014; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1869
msgctxt "text_id=9649 | speaker=soujuurou"
msgid "「ああ、俺でも怒る。片付けをきちんとしないなんて、だらしないにもほどがある」"
msgstr ""

#. Occurrence 7_6:1880:9650: scene=7_6
#: 7_6:1880
msgctxt "text_id=9650 | speaker=unknown"
msgid "　なんたる失態、と草十郎は激しく自分を責めた。"
msgstr ""

#. Occurrence 7_6:1904:9651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0021; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1904
msgctxt "text_id=9651 | speaker=aoko"
msgid "「論点違うっ！　あのね、寝顔をまぢかで見られたから怒ってるのよ有珠は！」"
msgstr ""

#. Occurrence 7_6:1989:9652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0015; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1989
msgctxt "text_id=9652 | speaker=soujuurou"
msgid "「え…………そうかな。有珠は、そういうのは気にしないと思うんだけど」"
msgstr ""

#. Occurrence 7_6:2029:9653: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0022; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2029
msgctxt "text_id=9653 | speaker=aoko"
msgid "「アンタはそうかもしれないけど、私たちは気にするの！」"
msgstr ""

#. Occurrence 7_6:2070:9654: scene=7_6
#: 7_6:2070
msgctxt "text_id=9654 | speaker=unknown"
msgid "　ぎりり、とガラスを裂く擬音のような目で睨む青子。"
msgstr ""

#. Occurrence 7_6:2075:9655: scene=7_6
#: 7_6:2075
msgctxt "text_id=9655 | speaker=unknown"
msgid "　私たち、という響きに言いようのない迫力を感じる草十郎だった。"
msgstr ""

#. Occurrence 7_6:2126:9656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0016; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2126
msgctxt "text_id=9656 | speaker=soujuurou"
msgid "「それは蒼崎たち限定の話か？」"
msgstr ""

#. Occurrence 7_6:2166:9657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0023; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2166
msgctxt "text_id=9657 | speaker=aoko"
msgid "「世間一般での常識よ。自分が気にしないからって他人もそうだと思ってると、いつか火傷するからね」"
msgstr ""

#. Occurrence 7_6:2206:9658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0017; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2206
msgctxt "text_id=9658 | speaker=soujuurou"
msgid "「む。でもそれだったら、ロビーで寝ている有珠にだって問題ないか？　見かけたら放っておけないだろう、あんなの」"
msgstr ""

#. Occurrence 7_6:2233:9659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0024; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2233
msgctxt "text_id=9659 | speaker=aoko"
msgid "「……その心意気は立派だけど、そこはそれ、この館の持ち主は彼女だから。"
msgstr ""

#. Occurrence 7_6:2239:9660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0025; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2239
msgctxt "text_id=9660 | speaker=aoko"
msgid "　この洋館内で貴方が出会ったあらゆる<不義|ふぎ><不始末|ふしまつ>、<失敗|しっぱい><失|しっ><態|たい>の責任は草十郎に押しつけられるの。"
msgstr ""

#. Occurrence 7_6:2245:9661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0026; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2245
msgctxt "text_id=9661 | speaker=aoko"
msgid "　この意味、分かる？」"
msgstr ""

#. Occurrence 7_6:2262:9662: scene=7_6
#: 7_6:2262
msgctxt "text_id=9662 | speaker=unknown"
msgid "　あんまりな青子の言葉に、草十郎はむむ、と考えこんで、"
msgstr ""

#. Occurrence 7_6:2304:9663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0018; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2304
msgctxt "text_id=9663 | speaker=soujuurou"
msgid "「―――つまり、ここは有珠の自治領なんだな？」"
msgstr ""

#. Occurrence 7_6:2316:9664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9664 | speaker=aoko"
msgid "「はい、よくできました。正確には私と有珠のだけどね。"
msgstr ""

#. Occurrence 7_6:2316:9665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9665 | speaker=aoko"
msgid "　領主は何をやっても許されるってコトよ」"
msgstr ""

#. Occurrence 7_6:2363:9666: scene=7_6
#: 7_6:2363
msgctxt "text_id=9666 | speaker=unknown"
msgid "　笑顔で言って、青子はソファーに腰を下ろした。"
msgstr ""

#. Occurrence 7_6:2368:9667: scene=7_6
#: 7_6:2368
msgctxt "text_id=9667 | speaker=unknown"
msgid "　草十郎は青子の向かいのソファーの後ろに立ったまま、今の会話を振り返っていた。"
msgstr ""

#. Occurrence 7_6:2373:9668: scene=7_6
#: 7_6:2373
msgctxt "text_id=9668 | speaker=unknown"
msgid "　有珠の自治領、青子の自治領と言うが、そもそも彼女の家族、実家はどうなっているのか。"
msgstr ""

#. Occurrence 7_6:2409:9669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0019; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2409
msgctxt "text_id=9669 | speaker=soujuurou"
msgid "「蒼崎。君、ご両親はどうしてるんだ？」"
msgstr ""

#. Occurrence 7_6:2414:9670: scene=7_6
#: 7_6:2414
msgctxt "text_id=9670 | speaker=unknown"
msgid "　草十郎はつい、思いついた疑問を口にする。"
msgstr ""

#. Occurrence 7_6:2435:9671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0028; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2435
msgctxt "text_id=9671 | speaker=aoko"
msgid "「生きてるわよ。三咲町から下りに四駅いった<陶川|とうかわ>ってところの地主。師は祖父だけど、今は隠居して両親と一緒の土地に住んでるわ」"
msgstr ""

#. Occurrence 7_6:2468:9672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0020; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2468
msgctxt "text_id=9672 | speaker=soujuurou"
msgid "「……む。そう聞くと、なんだか普通の家庭だな」"
msgstr ""

#. Occurrence 7_6:2473:9673: scene=7_6
#: 7_6:2473
msgctxt "text_id=9673 | speaker=unknown"
msgid "　魔法使いの一族というから、草十郎はもっと破天荒なものを想像していたらしい。"
msgstr ""

#. Occurrence 7_6:2494:9674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0029; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2494
msgctxt "text_id=9674 | speaker=aoko"
msgid "「両親はね。父さんにはあんまり魔術回路は作られなかったみたいだから。その分、私には二世代分の潜在能力があるって祖父は言ってるけど、どうだか。"
msgstr ""

#. Occurrence 7_6:2510:9675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0030; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2510
msgctxt "text_id=9675 | speaker=aoko"
msgid "　草十郎の期待してるような一族は、どっちかって言うと有珠のほうよ。私と違って英国出身だからね、彼女」"
msgstr ""

#. Occurrence 7_6:2522:9676: scene=7_6
#: 7_6:2522
msgctxt "text_id=9676 | speaker=unknown"
msgid "　そこまで口にして、いけない、と青子は会話を止めた。"
msgstr ""

#. Occurrence 7_6:2527:9677: scene=7_6
#: 7_6:2527
msgctxt "text_id=9677 | speaker=unknown"
msgid "　有珠の事は本人から訊く―――目の前の少年はそう言った。その方針を、こんなところで台無しにする訳にはいかない。"
msgstr ""

#. Occurrence 7_6:2555:9678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0031; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2555
msgctxt "text_id=9678 | speaker=aoko"
msgid "「ま、詳しくは本人から訊きなさい。有珠の紅茶好きもそこからきてるんだし。"
msgstr ""

#. Occurrence 7_6:2579:9679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0032; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2579
msgctxt "text_id=9679 | speaker=aoko"
msgid "　……そう言えば、なんで今日にかぎってリーフティーなんか淹れたの？　ティーバッグを使ったほうがまだマシだったでしょうに」"
msgstr ""

#. Occurrence 7_6:2606:9680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9680 | speaker=soujuurou"
msgid "「蒼崎が、そっちの方がいいって言ったじゃないか。"
msgstr ""

#. Occurrence 7_6:2606:9681: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9681 | speaker=soujuurou"
msgid "　有珠は紅茶にうるさいって」"
msgstr ""

#. Occurrence 7_6:2630:9682: scene=7_6
#: 7_6:2630
msgctxt "text_id=9682 | speaker=unknown"
msgid "　むう、と自らの失言に青子は言いよどむ。"
msgstr ""

#. Occurrence 7_6:2635:9683: scene=7_6
#: 7_6:2635
msgctxt "text_id=9683 | speaker=unknown"
msgid "　大雑把に見えて細かい事を覚えているヤツめ、と。"
msgstr ""

#. Occurrence 7_6:2662:9684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0033; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2662
msgctxt "text_id=9684 | speaker=aoko"
msgid "「……ま、いいわ。それより明日の放課後だけど、またひとりで帰ってくれない？"
msgstr ""

#. Occurrence 7_6:2668:9685: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0034; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2668
msgctxt "text_id=9685 | speaker=aoko"
msgid "　年明けの行事があるんだけど、その場しのぎで言った<餅|もち>つき大会が通っちゃってさ。明日も忙しいのよ、私」"
msgstr ""

#. Occurrence 7_6:2691:9686: scene=7_6
#: 7_6:2691
msgctxt "text_id=9686 | speaker=unknown"
msgid "　了解、と頷く草十郎。"
msgstr ""

#. Occurrence 7_6:2696:9687: scene=7_6
#: 7_6:2696
msgctxt "text_id=9687 | speaker=unknown"
msgid "　青子に言われずともそのつもりだったらしい。"
msgstr ""

#. Occurrence 7_6:2724:9688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0022; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2724
msgctxt "text_id=9688 | speaker=soujuurou"
msgid "「それはいいけど、体は大丈夫か蒼崎？　昨日から寝てないだろう」"
msgstr ""

#. Occurrence 7_6:2750:9689: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0035; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2750
msgctxt "text_id=9689 | speaker=aoko"
msgid "「夕方に三時間ちょい仮眠をとったから調子はいいわ。"
msgstr ""

#. Occurrence 7_6:2756:9690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0036; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2756
msgctxt "text_id=9690 | speaker=aoko"
msgid "　そう言うアンタこそ体は<保|も>つんでしょうね？　もう少ししたら昨日の続き、始めるわよ」"
msgstr ""

#. Occurrence 7_6:2793:9691: scene=7_6
#: 7_6:2793
msgctxt "text_id=9691 | speaker=unknown"
msgid "　昨日の続き、とはマンツーマンによる一夜漬けだ。"
msgstr ""

#. Occurrence 7_6:2798:9692: scene=7_6
#: 7_6:2798
msgctxt "text_id=9692 | speaker=unknown"
msgid "　あれから一睡もしていない草十郎にとって、厳しい荒行なのは言うまでもないが―――"
msgstr ""

#. Occurrence 7_6:2835:9693: scene=7_6
#: 7_6:2835
msgctxt "text_id=9693 | speaker=unknown"
msgid "　それ以上に、嬉しくてつい頬が緩んでしまう。"
msgstr ""

#. Occurrence 7_6:2840:9694: scene=7_6
#: 7_6:2840
msgctxt "text_id=9694 | speaker=unknown"
msgid "　転校当時、物陰からはらはらと自分の行動を監視していた彼女の、分かりづらい心遣いが思い出される。"
msgstr ""

#. Occurrence 7_6:2867:9695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9695 | speaker=soujuurou"
msgid "「いいよ。どのみち苦労するのは蒼崎の方だし。"
msgstr ""

#. Occurrence 7_6:2867:9696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9696 | speaker=soujuurou"
msgid "　異例中の異例は、有り難く受け取っておくとしよう」"
msgstr ""

#. Occurrence 7_6:2907:9697: scene=7_6
#: 7_6:2907
msgctxt "text_id=9697 | speaker=unknown"
msgid "　晴れ晴れとした顔で返され、青子は小さく呆れながら、"
msgstr ""

#. Occurrence 7_6:2930:9698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0037; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2930
msgctxt "text_id=9698 | speaker=aoko"
msgid "「……ほんと。くだらない事だけは、しつこく覚えてるんだから」"
msgstr ""

#. Occurrence 7_6:2936:9699: scene=7_6
#: 7_6:2936
msgctxt "text_id=9699 | speaker=unknown"
msgid "　その笑顔から視線を逸らすように、やれやれと肩をすくめるのだった。"
msgstr ""

#. Occurrence 7_7:86:9700: scene=7_7
#: 7_7:86
msgctxt "text_id=9700 | speaker=unknown"
msgid "　翌日。"
msgstr ""

#. Occurrence 7_7:91:9701: scene=7_7
#: 7_7:91
msgctxt "text_id=9701 | speaker=unknown"
msgid "　期末試験、その最終日は滞りなく終了した。"
msgstr ""

#. Occurrence 7_7:106:9702: scene=7_7
#: 7_7:106
msgctxt "text_id=9702 | speaker=unknown"
msgid "　多くの学生たちにとって十二月最大の難問は、晴れて過去の歴史と消え去った。"
msgstr ""

#. Occurrence 7_7:111:9703: scene=7_7
#: 7_7:111
msgctxt "text_id=9703 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence 7_7:126:9704: scene=7_7
#: 7_7:126
msgctxt "text_id=9704 | speaker=unknown"
msgid "　草十郎にとって最大の難問は、この後にこそ控えている。"
msgstr ""

#. Occurrence 7_7:169:9705: scene=7_7
#: 7_7:169
msgctxt "text_id=9705 | speaker=unknown"
msgid "　明日の終業式に向けて浮き足立つクラスメイトたちと町中で別れを告げ、白犬塚の森の中へ。"
msgstr ""

#. Occurrence 7_7:174:9706: scene=7_7
#: 7_7:174
msgctxt "text_id=9706 | speaker=unknown"
msgid "　昨日通りの帰宅風景、"
msgstr ""

#. Occurrence 7_7:179:9707: scene=7_7
#: 7_7:179
msgctxt "text_id=9707 | speaker=unknown"
msgid "　昨日の焼き直しのような気分で、草十郎は坂道を登っていく。"
msgstr ""

#. Occurrence 7_7:223:9708: scene=7_7
#: 7_7:223
msgctxt "text_id=9708 | speaker=unknown"
msgid "　草十郎とて確固たる決意に燃えている。"
msgstr ""

#. Occurrence 7_7:228:9709: scene=7_7
#: 7_7:228
msgctxt "text_id=9709 | speaker=unknown"
msgid "　今日が最終期限であるし、なにより草十郎自身、あの少女の<話|こえ>を聞きたがっていた。"
msgstr ""

#. Occurrence 7_7:233:9710: scene=7_7
#: 7_7:233
msgctxt "text_id=9710 | speaker=unknown"
msgid "　多少邪険に扱われても、とことん無視されても、果ては“怒らせると鏡の国に放りこまれるわよ”とニヤけ顔で笑う青子の忠告を実現させる事になったとしても、挨拶ぐらいはしたいのである。"
msgstr ""

#. Occurrence 7_7:275:9711: scene=7_7
#: 7_7:275
msgctxt "text_id=9711 | speaker=unknown"
msgid "　―――しかし。"
msgstr ""

#. Occurrence 7_7:281:9712: scene=7_7
#: 7_7:281
msgctxt "text_id=9712 | speaker=unknown"
msgid "　草十郎を待ち受けていたものは、半分以上、なんとなく予感していた通りの光景だった。"
msgstr ""

#. Occurrence 7_7:315:9713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0000; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:315
msgctxt "text_id=9713 | speaker=soujuurou"
msgid "「…………よく寝る子だな、ほんと」"
msgstr ""

#. Occurrence 7_7:350:9714: scene=7_7
#: 7_7:350
msgctxt "text_id=9714 | speaker=unknown"
msgid "　目眩を覚えるほどの既視感。"
msgstr ""

#. Occurrence 7_7:355:9715: scene=7_7
#: 7_7:355
msgctxt "text_id=9715 | speaker=unknown"
msgid "　見た目だけなら昨日と何ら変わらない風景に迎えられて、草十郎は素直な感想を漏らした。"
msgstr ""

#. Occurrence 7_7:375:9716: scene=7_7
#: 7_7:375
msgctxt "text_id=9716 | speaker=unknown"
msgid "　少女は今日も暖炉の<傍|そば>で眠っている。"
msgstr ""

#. Occurrence 7_7:380:9717: scene=7_7
#: 7_7:380
msgctxt "text_id=9717 | speaker=unknown"
msgid "　正座から横にしなだれ落ちた両足は、絵本で見る少女の座り方に似ていた。"
msgstr ""

#. Occurrence 7_7:385:9718: scene=7_7
#: 7_7:385
msgctxt "text_id=9718 | speaker=unknown"
msgid "　昨日よりは<幾分|いくぶん>居心地のいい座り方だろう。"
msgstr ""

#. Occurrence 7_7:403:9719: scene=7_7
#: 7_7:403
msgctxt "text_id=9719 | speaker=unknown"
msgid "　たまに奇跡的な察しの良さを発揮する彼は、それで事の<絡|から><繰|くり>が読めてしまった。"
msgstr ""

#. Occurrence 7_7:424:9720: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0001; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:424
msgctxt "text_id=9720 | speaker=soujuurou"
msgid "『……学校で、鳶丸はひとり何をしているんだろう……』"
msgstr ""

#. Occurrence 7_7:438:9721: scene=7_7
#: 7_7:438
msgctxt "text_id=9721 | speaker=unknown"
msgid "　ちらりと入ってきた玄関へ視線を投げて、よし、と気合いを入れて腕まくりをする。"
msgstr ""

#. Occurrence 7_7:443:9722: scene=7_7
#: 7_7:443
msgctxt "text_id=9722 | speaker=unknown"
msgid "　何もかも昨日の通りなら、自分もそれに合わせてみようと思ったのか。"
msgstr ""

#. Occurrence 7_7:448:9723: scene=7_7
#: 7_7:448
msgctxt "text_id=9723 | speaker=unknown"
msgid "　草十郎は鞄を置いて台所に向かった。"
msgstr ""

#. Occurrence 7_7:453:9724: scene=7_7
#: 7_7:453
msgctxt "text_id=9724 | speaker=unknown"
msgid "　もちろん昨日と同じ、不出来な紅茶を淹れるために。"
msgstr ""

#. Occurrence 7_7:494:9725: scene=7_7
#: 7_7:494
msgctxt "text_id=9725 | speaker=unknown"
msgid "　フォションは怒られたので、今日は反省してジャクソンのフルーツハーブを手に取る。"
msgstr ""

#. Occurrence 7_7:500:9726: scene=7_7
#: 7_7:500
msgctxt "text_id=9726 | speaker=unknown"
msgid "　……悲しいかな、これが今の草十郎の限界だった。"
msgstr ""

#. Occurrence 7_7:505:9727: scene=7_7
#: 7_7:505
msgctxt "text_id=9727 | speaker=unknown"
msgid "　お茶の葉の種類で怒られたのではなく、それを使いこなせなかった事が問題だったと気付いていない。"
msgstr ""

#. Occurrence 7_7:551:9728: scene=7_7
#: 7_7:551
msgctxt "text_id=9728 | speaker=unknown"
msgid "　ポットに紅茶を淹れてロビーに戻る。"
msgstr ""

#. Occurrence 7_7:557:9729: scene=7_7
#: 7_7:557
msgctxt "text_id=9729 | speaker=unknown"
msgid "　白い息をこぼして草十郎は暖炉の前にあぐらをかいた。"
msgstr ""

#. Occurrence 7_7:562:9730: scene=7_7
#: 7_7:562
msgctxt "text_id=9730 | speaker=unknown"
msgid "　自分で淹れたフルーツミックスを口にし、鞄から教科書を取りだす。"
msgstr ""

#. Occurrence 7_7:567:9731: scene=7_7
#: 7_7:567
msgctxt "text_id=9731 | speaker=unknown"
msgid "　期末試験は終わったけれど、一日目の科目はいくつか補習を宣言されたので、やっぱりこうなる運命なのだ。"
msgstr ""

#. Occurrence 7_7:597:9732: scene=7_7
#: 7_7:597
msgctxt "text_id=9732 | speaker=unknown"
msgid "　ロビーは外より<幾分|いくぶん>暖かいが、快適にはほど遠い。何らかの暖が恋しくなる寒さだ。"
msgstr ""

#. Occurrence 7_7:602:9733: scene=7_7
#: 7_7:602
msgctxt "text_id=9733 | speaker=unknown"
msgid "　冬の寒気を色濃く残すホールで、草十郎は電子工学のテキストに没頭した。"
msgstr ""

#. Occurrence 7_7:607:9734: scene=7_7
#: 7_7:607
msgctxt "text_id=9734 | speaker=unknown"
msgid "　選択する生徒が少ないという理由で勧められた科目だが、高校から基礎が始まる分、他の科目より少しだけ面白い。"
msgstr ""

#. Occurrence 7_7:628:9735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0002; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:628
msgctxt "text_id=9735 | speaker=soujuurou"
msgid "『けど、蒼崎の言う通り』"
msgstr ""

#. Occurrence 7_7:634:9736: scene=7_7
#: 7_7:634
msgctxt "text_id=9736 | speaker=unknown"
msgid "　味の分からない紅茶を空にして、カップに二杯目を注ぐ。"
msgstr ""

#. Occurrence 7_7:639:9737: scene=7_7
#: 7_7:639
msgctxt "text_id=9737 | speaker=unknown"
msgid "　陶磁器のポットは保温性に勝れているので、紅茶はまだ温かい。"
msgstr ""

#. Occurrence 7_7:645:9738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0003; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:645
msgctxt "text_id=9738 | speaker=soujuurou"
msgid "『文字で物事を覚えるのは、苦手みたいだ』"
msgstr ""

#. Occurrence 7_7:663:9739: scene=7_7
#: 7_7:663
msgctxt "text_id=9739 | speaker=unknown"
msgid "　ぼんやりと思いながら、草十郎は文字の羅列を読み進める。"
msgstr ""

#. Occurrence 7_7:683:9740: scene=7_7
#: 7_7:683
msgctxt "text_id=9740 | speaker=unknown"
msgid "　ロビーに電灯はなく、天窓からの日射しだけが頼りだ。"
msgstr ""

#. Occurrence 7_7:688:9741: scene=7_7
#: 7_7:688
msgctxt "text_id=9741 | speaker=unknown"
msgid "　斜に差しこむ光はロビーに明暗を作り、壁際の暖炉はじき影に沈もうとしている。"
msgstr ""

#. Occurrence 7_7:722:9742: scene=7_7
#: 7_7:722
msgctxt "text_id=9742 | speaker=unknown"
msgid "　見ようによっては、灰に<浸|ひた>された廃墟の風景。"
msgstr ""

#. Occurrence 7_7:727:9743: scene=7_7
#: 7_7:727
msgctxt "text_id=9743 | speaker=unknown"
msgid "　あるいは、くすんだ童話の中に忘れられた、色あせた挿し絵の世界。"
msgstr ""

#. Occurrence 7_7:733:9744: scene=7_7
#: 7_7:733
msgctxt "text_id=9744 | speaker=unknown"
msgid "　白い城壁の部屋で、時間は人知れず、太陽の目を盗むようにこつこつと流れていった。"
msgstr ""

#. Occurrence 7_7:808:9745: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0004; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:808
msgctxt "text_id=9745 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_7:814:9746: scene=7_7
#: 7_7:814
msgctxt "text_id=9746 | speaker=unknown"
msgid "　そうして、ゆるやかに時間が過ぎたあと。"
msgstr ""

#. Occurrence 7_7:820:9747: scene=7_7
#: 7_7:820
msgctxt "text_id=9747 | speaker=unknown"
msgid "　ぱたんと教科書を閉じた音が、くすんだ風景を現実に引き戻した。"
msgstr ""

#. Occurrence 7_7:825:9748: scene=7_7
#: 7_7:825
msgctxt "text_id=9748 | speaker=unknown"
msgid "　草十郎は腕を伸ばして肩の凝りをほぐすと、いそいそと後片づけをはじめる。"
msgstr ""

#. Occurrence 7_7:846:9749: scene=7_7
#: 7_7:846
msgctxt "text_id=9749 | speaker=unknown"
msgid "　本を鞄にしまい、"
msgstr ""

msgctxt "text_id=9750 | speaker=unknown"
msgid "　有珠のカップはそのまま床に残し、"
msgstr ""

msgctxt "text_id=9751 | speaker=unknown"
msgid "　自分の使ったカップをトレイに載せて立ち上がって、"
msgstr ""

#. Occurrence 7_7:859:9752: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0005; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:859
msgctxt "text_id=9752 | speaker=soujuurou"
msgid "「バイトの時間だ」"
msgstr ""

#. Occurrence 7_7:864:9753: scene=7_7
#: 7_7:864
msgctxt "text_id=9753 | speaker=unknown"
msgid "　あっさりと。"
msgstr ""

#. Occurrence 7_7:882:9754: scene=7_7
#: 7_7:882
msgctxt "text_id=9754 | speaker=unknown"
msgid "　そういう事なら仕方ない、と納得するように口にして、眠るロビーを後にした。"
msgstr ""

#. Occurrence 7_7:917:9755: scene=7_7
#: 7_7:917
msgctxt "text_id=9755 | speaker=unknown"
msgid "　―――その直前。"
msgstr ""

#. Occurrence 7_7:927:9756: scene=7_7
#: 7_7:927
msgctxt "text_id=9756 | speaker=unknown"
msgid "　背後からの物音を聞いて、草十郎は足を止めた。"
msgstr ""

#. Occurrence 7_7:942:9757: scene=7_7
#: 7_7:942
msgctxt "text_id=9757 | speaker=unknown"
msgid "　鞄を<脇|わき>に挟んだままトレイ片手に振り返る。"
msgstr ""

#. Occurrence 7_7:957:9758: scene=7_7
#: 7_7:957
msgctxt "text_id=9758 | speaker=unknown"
msgid "　有珠用のカップに注がれた紅茶に波ひとつ立てず、"
msgstr ""

#. Occurrence 7_7:976:9759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0006; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:976
msgctxt "text_id=9759 | speaker=soujuurou"
msgid "「や」"
msgstr ""

#. Occurrence 7_7:981:9760: scene=7_7
#: 7_7:981
msgctxt "text_id=9760 | speaker=unknown"
msgid "　気軽な口振りで、草十郎はそう語りかけた。"
msgstr ""

#. Occurrence 7_7:1000:9761: scene=7_7
#: 7_7:1000
msgctxt "text_id=9761 | speaker=unknown"
msgid "　暖炉の横で座ったままの、黒い瞳の眠り姫に。"
msgstr ""

#. Occurrence 7_7:1031:9762: scene=7_7
#: 7_7:1031
msgctxt "text_id=9762 | speaker=unknown"
msgid "　有珠は彫像のようだった寝顔と変わらない静かさで草十郎を見ている。"
msgstr ""

#. Occurrence 7_7:1036:9763: scene=7_7
#: 7_7:1036
msgctxt "text_id=9763 | speaker=unknown"
msgid "　それを見て、草十郎は今更ながら有珠と青子の違いに気が付いた。"
msgstr ""

#. Occurrence 7_7:1070:9764: scene=7_7
#: 7_7:1070
msgctxt "text_id=9764 | speaker=unknown"
msgid "　青子は、その思考経路は謎としても、実に分かりやすい意思表示をしてくれる。"
msgstr ""

#. Occurrence 7_7:1075:9765: scene=7_7
#: 7_7:1075
msgctxt "text_id=9765 | speaker=unknown"
msgid "　トレードマークである不機嫌そうな顔は、何に不機嫌なのかはさておくとして、常に意思を反映している。"
msgstr ""

#. Occurrence 7_7:1080:9766: scene=7_7
#: 7_7:1080
msgctxt "text_id=9766 | speaker=unknown"
msgid "　対して、有珠はそもそも感情が読めない。"
msgstr ""

#. Occurrence 7_7:1085:9767: scene=7_7
#: 7_7:1085
msgctxt "text_id=9767 | speaker=unknown"
msgid "　怒っているのか悲しんでいるのかさえ表れない。"
msgstr ""

#. Occurrence 7_7:1106:9768: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0000; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1106
msgctxt "text_id=9768 | speaker=alice"
msgid "「何の、つもり―――？」"
msgstr ""

#. Occurrence 7_7:1123:9769: scene=7_7
#: 7_7:1123
msgctxt "text_id=9769 | speaker=unknown"
msgid "　沈みこむような問いかけ。"
msgstr ""

#. Occurrence 7_7:1128:9770: scene=7_7
#: 7_7:1128
msgctxt "text_id=9770 | speaker=unknown"
msgid "　敵意なのか疑問なのかすら、草十郎には判別がつかない。"
msgstr ""

#. Occurrence 7_7:1133:9771: scene=7_7
#: 7_7:1133
msgctxt "text_id=9771 | speaker=unknown"
msgid "　もし前者なら、有珠を相手にあの夜の再現になるかもしれない。"
msgstr ""

#. Occurrence 7_7:1163:9772: scene=7_7
#: 7_7:1163
msgctxt "text_id=9772 | speaker=unknown"
msgid "　粉々に散った小瓶が草十郎の脳裏をよぎる。"
msgstr ""

#. Occurrence 7_7:1168:9773: scene=7_7
#: 7_7:1168
msgctxt "text_id=9773 | speaker=unknown"
msgid "　返答次第では無事では済まないと承知して、"
msgstr ""

#. Occurrence 7_7:1173:9774: scene=7_7
#: 7_7:1173
msgctxt "text_id=9774 | speaker=unknown"
msgid "　しばし迷ったあと、草十郎は覚悟を決めた。"
msgstr ""

#. Occurrence 7_7:1178:9775: scene=7_7
#: 7_7:1178
msgctxt "text_id=9775 | speaker=unknown"
msgid "　と、言うより―――"
msgstr ""

#. Occurrence 7_7:1211:9776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0007; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1211
msgctxt "text_id=9776 | speaker=soujuurou"
msgid "「そうだな。一口じゃ説明できないから、座るよ」"
msgstr ""

#. Occurrence 7_7:1217:9777: scene=7_7
#: 7_7:1217
msgctxt "text_id=9777 | speaker=unknown"
msgid "　何が正しい選択か考えもつかなかったので、単純に、自分のしたい事をする事にした。"
msgstr ""

#. Occurrence 7_7:1251:9778: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0001; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1251
msgctxt "text_id=9778 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 7_7:1256:9779: scene=7_7
#: 7_7:1256
msgctxt "text_id=9779 | speaker=unknown"
msgid "　返事はない。"
msgstr ""

#. Occurrence 7_7:1261:9780: scene=7_7
#: 7_7:1261
msgctxt "text_id=9780 | speaker=unknown"
msgid "　黒衣の少女は嫌がっているようにも見えたが、草十郎はあえて無視した。"
msgstr ""

#. Occurrence 7_7:1296:9781: scene=7_7
#: 7_7:1296
msgctxt "text_id=9781 | speaker=unknown"
msgid "　もう一度床に座ってトレイを置くと、ふたりの視線はぴったりと合った。"
msgstr ""

#. Occurrence 7_7:1301:9782: scene=7_7
#: 7_7:1301
msgctxt "text_id=9782 | speaker=unknown"
msgid "　底の見えない有珠の瞳は、依然として余人を寄せつけない。"
msgstr ""

#. Occurrence 7_7:1318:9783: scene=7_7
#: 7_7:1318
msgctxt "text_id=9783 | speaker=unknown"
msgid "　が。肝心の草十郎は、そんな重圧をまったく感じてはいないようだった。"
msgstr ""

#. Occurrence 7_7:1355:9784: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0002; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1355
msgctxt "text_id=9784 | speaker=alice"
msgid "「それで、なに……？」"
msgstr ""

#. Occurrence 7_7:1361:9785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0008; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1361
msgctxt "text_id=9785 | speaker=soujuurou"
msgid "「ああ。遅くなったけど、こうして話がしたかったんだ、有珠と」"
msgstr ""

#. Occurrence 7_7:1373:9786: scene=7_7
#: 7_7:1373
msgctxt "text_id=9786 | speaker=unknown"
msgid "　一口じゃ説明できないらしいのに、草十郎はあっさりと一口で説明した。"
msgstr ""

#. Occurrence 7_7:1400:9787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0003; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1400
msgctxt "text_id=9787 | speaker=alice"
msgid "「わたしと……？　青子とではなく？」"
msgstr ""

#. Occurrence 7_7:1406:9788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0009; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1406
msgctxt "text_id=9788 | speaker=soujuurou"
msgid "「ん？　そうだね、蒼崎とはもっと話したいところだけど、それよりは三人で話してみたい」"
msgstr ""

#. Occurrence 7_7:1412:9789: scene=7_7
#: 7_7:1412
msgctxt "text_id=9789 | speaker=unknown"
msgid "　草十郎の意図が読めず、戸惑う有珠。"
msgstr ""

#. Occurrence 7_7:1417:9790: scene=7_7
#: 7_7:1417
msgctxt "text_id=9790 | speaker=unknown"
msgid "　そんな有珠の困惑に気付かず、草十郎はしかつめらしく話を続ける。"
msgstr ""

#. Occurrence 7_7:1451:9791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0010; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1451
msgctxt "text_id=9791 | speaker=soujuurou"
msgid "「蒼崎は普段から有珠とは会話がないって言うんだ。それが俺のせいなら困るし、俺のせいじゃないならもっと困る。"
msgstr ""

#. Occurrence 7_7:1457:9792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0011; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1457
msgctxt "text_id=9792 | speaker=soujuurou"
msgid "　せっかく同じ場所に居るのに会話がないなんて、もったいないと思うんだ」"
msgstr ""

#. Occurrence 7_7:1477:9793: scene=7_7
#: 7_7:1477
msgctxt "text_id=9793 | speaker=unknown"
msgid "　噛みしめるような、やけに情感の籠もった声。"
msgstr ""

#. Occurrence 7_7:1482:9794: scene=7_7
#: 7_7:1482
msgctxt "text_id=9794 | speaker=unknown"
msgid "　有珠には少年の意図はこれっぽっちも掴めない。"
msgstr ""

#. Occurrence 7_7:1487:9795: scene=7_7
#: 7_7:1487
msgctxt "text_id=9795 | speaker=unknown"
msgid "　けれど、彼が自分に対して強く、何かを願っているのは感じ取れる。"
msgstr ""

#. Occurrence 7_7:1502:9796: scene=7_7
#: 7_7:1502
msgctxt "text_id=9796 | speaker=unknown"
msgid "　……それが。"
msgstr ""

#. Occurrence 7_7:1507:9797: scene=7_7
#: 7_7:1507
msgctxt "text_id=9797 | speaker=unknown"
msgid "　恐れに起因するものでない事が、彼女には意外だった。"
msgstr ""

#. Occurrence 7_7:1542:9798: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0004; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1542
msgctxt "text_id=9798 | speaker=alice"
msgid "「貴方は、わたしが恐くないの……？」"
msgstr ""

#. Occurrence 7_7:1564:9799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0012; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1564
msgctxt "text_id=9799 | speaker=soujuurou"
msgid "「ああ。だってそう言えるほど、俺は君をよく知らない」"
msgstr ""

#. Occurrence 7_7:1600:9800: scene=7_7
#: 7_7:1600
msgctxt "text_id=9800 | speaker=unknown"
msgid "　見開いた瞳は<玻|は><璃|り>細工のように。"
msgstr ""

#. Occurrence 7_7:1605:9801: scene=7_7
#: 7_7:1605
msgctxt "text_id=9801 | speaker=unknown"
msgid "　少女にとって、少年の予想外さはもう驚きの域だった。"
msgstr ""

#. Occurrence 7_7:1610:9802: scene=7_7
#: 7_7:1610
msgctxt "text_id=9802 | speaker=unknown"
msgid "　あまりにも素直な、脊髄反射のような答え。"
msgstr ""

#. Occurrence 7_7:1615:9803: scene=7_7
#: 7_7:1615
msgctxt "text_id=9803 | speaker=unknown"
msgid "　そんな無遠慮極まりない言葉が、なぜか不快と感じない。"
msgstr ""

#. Occurrence 7_7:1661:9804: scene=7_7
#: 7_7:1661
msgctxt "text_id=9804 | speaker=unknown"
msgid "　ふたりの会話はそこで途絶えた。"
msgstr ""

#. Occurrence 7_7:1688:9805: scene=7_7
#: 7_7:1688
msgctxt "text_id=9805 | speaker=unknown"
msgid "　いや、もとより会話は成立していない。"
msgstr ""

#. Occurrence 7_7:1705:9806: scene=7_7
#: 7_7:1705
msgctxt "text_id=9806 | speaker=unknown"
msgid "　不思議と居心地のいい沈黙を嫌うように、少女は気を引き締める。"
msgstr ""

#. Occurrence 7_7:1710:9807: scene=7_7
#: 7_7:1710
msgctxt "text_id=9807 | speaker=unknown"
msgid "　少年はそんな少女の視線を、怯えることなく受けとめる。"
msgstr ""

#. Occurrence 7_7:1731:9808: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0005; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1731
msgctxt "text_id=9808 | speaker=alice"
msgid "「…………話」"
msgstr ""

#. Occurrence 7_7:1750:9809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0013; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1750
msgctxt "text_id=9809 | speaker=soujuurou"
msgid "「ん？」"
msgstr ""

#. Occurrence 7_7:1768:9810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0006; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1768
msgctxt "text_id=9810 | speaker=alice"
msgid "「わたしと話をしたいと言ったでしょう。"
msgstr ""

#. Occurrence 7_7:1774:9811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0007; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1774
msgctxt "text_id=9811 | speaker=alice"
msgid "　なら、好きにしてみたら……？」"
msgstr ""

#. Occurrence 7_7:1808:9812: scene=7_7
#: 7_7:1808
msgctxt "text_id=9812 | speaker=unknown"
msgid "　できるものならしてみろ、という少女の誘い。"
msgstr ""

#. Occurrence 7_7:1813:9813: scene=7_7
#: 7_7:1813
msgctxt "text_id=9813 | speaker=unknown"
msgid "　草十郎には彼女に話しかける話題も、親密さもない。"
msgstr ""

#. Occurrence 7_7:1818:9814: scene=7_7
#: 7_7:1818
msgctxt "text_id=9814 | speaker=unknown"
msgid "　意地の悪い少女の挑発は、しかし。"
msgstr ""

#. Occurrence 7_7:1853:9815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0014; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1853
msgctxt "text_id=9815 | speaker=soujuurou"
msgid "「じゃあ、あの鳥の話を。ほら、そこにいる青い鳥。"
msgstr ""

#. Occurrence 7_7:1859:9816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0015; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1859
msgctxt "text_id=9816 | speaker=soujuurou"
msgid "　たまに見かけるんだけど、君の飼い鳥か？"
msgstr ""

#. Occurrence 7_7:1865:9817: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0016; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1865
msgctxt "text_id=9817 | speaker=soujuurou"
msgid "　それともほら、なんて言ったかな。プロイ、だっけ。あの鳥も有珠の使い魔？」"
msgstr ""

#. Occurrence 7_7:1885:9818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0008; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1885
msgctxt "text_id=9818 | speaker=alice"
msgid "「っ―――」"
msgstr ""

#. Occurrence 7_7:1890:9819: scene=7_7
#: 7_7:1890
msgctxt "text_id=9819 | speaker=unknown"
msgid "　一瞬、少女の瞳に人間らしい色が灯る。"
msgstr ""

#. Occurrence 7_7:1895:9820: scene=7_7
#: 7_7:1895
msgctxt "text_id=9820 | speaker=unknown"
msgid "　あの厄介者、と睨みつけるような視線だった。"
msgstr ""

#. Occurrence 7_7:1943:9821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0009; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1943
msgctxt "text_id=9821 | speaker=alice"
msgid "「……アレもプロイだけど、わたしとは何の関係もない<駄鳥|だちょう>。ずいぶん古くから<在|い>るだけで、わたしもよく知らないわ」"
msgstr ""

#. Occurrence 7_7:1962:9822: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0017; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1962
msgctxt "text_id=9822 | speaker=soujuurou"
msgid "「？　じゃあ勝手に住んでるのか、この家に？」"
msgstr ""

#. Occurrence 7_7:1995:9823: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0010; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1995
msgctxt "text_id=9823 | speaker=alice"
msgid "「勝手になんて、わたしが許す筈がないでしょう。"
msgstr ""

#. Occurrence 7_7:2001:9824: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0011; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2001
msgctxt "text_id=9824 | speaker=alice"
msgid "　……ロビンは本当に役に立たないけど、あんなのでも母から譲り受けたものだから。失敗続きでも、特別に住まわせてあげてるの」"
msgstr ""

#. Occurrence 7_7:2038:9825: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0018; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2038
msgctxt "text_id=9825 | speaker=soujuurou"
msgid "「そっか、安心した。ここに住むの、役に立たなきゃダメってワケでもないんだね」"
msgstr ""

#. Occurrence 7_7:2058:9826: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0012; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2058
msgctxt "text_id=9826 | speaker=alice"
msgid "「っ―――」"
msgstr ""

#. Occurrence 7_7:2092:9827: scene=7_7
#: 7_7:2092
msgctxt "text_id=9827 | speaker=unknown"
msgid "　無防備な笑顔を向けられて、少女は顔を<逸|そ>らして黙りこんでしまった。"
msgstr ""

#. Occurrence 7_7:2097:9828: scene=7_7
#: 7_7:2097
msgctxt "text_id=9828 | speaker=unknown"
msgid "　あとの時間は、草十郎が喋るだけの一方通行だ。"
msgstr ""

#. Occurrence 7_7:2102:9829: scene=7_7
#: 7_7:2102
msgctxt "text_id=9829 | speaker=unknown"
msgid "　日々のアルバイトのこと。学校のこと。遊園地でのこと。町のこと。家賃のこと。"
msgstr ""

#. Occurrence 7_7:2107:9830: scene=7_7
#: 7_7:2107
msgctxt "text_id=9830 | speaker=unknown"
msgid "　そんな益体のない話をすること二十分。"
msgstr ""

#. Occurrence 7_7:2112:9831: scene=7_7
#: 7_7:2112
msgctxt "text_id=9831 | speaker=unknown"
msgid "　さすがにこれ以上は延ばせない、と少年は会話を切った。"
msgstr ""

#. Occurrence 7_7:2144:9832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0019; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2144
msgctxt "text_id=9832 | speaker=soujuurou"
msgid "「ごめん。アルバイトがあるから、もう行くよ」"
msgstr ""

#. Occurrence 7_7:2162:9833: scene=7_7
#: 7_7:2162
msgctxt "text_id=9833 | speaker=unknown"
msgid "　……この通り。"
msgstr ""

#. Occurrence 7_7:2167:9834: scene=7_7
#: 7_7:2167
msgctxt "text_id=9834 | speaker=unknown"
msgid "　せっかくの機会をあっさり諦めるあたり、本当に何も考えていなかったらしい。"
msgstr ""

#. Occurrence 7_7:2200:9835: scene=7_7
#: 7_7:2200
msgctxt "text_id=9835 | speaker=unknown"
msgid "　草十郎はトレイを厨房に戻し、鞄をロビーに置いて玄関に向かう。"
msgstr ""

#. Occurrence 7_7:2205:9836: scene=7_7
#: 7_7:2205
msgctxt "text_id=9836 | speaker=unknown"
msgid "　有珠は彼のそんな淡泊さを知らなかった。"
msgstr ""

#. Occurrence 7_7:2210:9837: scene=7_7
#: 7_7:2210
msgctxt "text_id=9837 | speaker=unknown"
msgid "　なので、意表をつかれて見届けそうになって、つい、"
msgstr ""

#. Occurrence 7_7:2229:9838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0013; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2229
msgctxt "text_id=9838 | speaker=alice"
msgid "「―――待って」"
msgstr ""

#. Occurrence 7_7:2235:9839: scene=7_7
#: 7_7:2235
msgctxt "text_id=9839 | speaker=unknown"
msgid "　必要もないのに、その背中を呼び止めていた。"
msgstr ""

#. Occurrence 7_7:2268:9840: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0020; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2268
msgctxt "text_id=9840 | speaker=soujuurou"
msgid "「ん、なに？」"
msgstr ""

#. Occurrence 7_7:2288:9841: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0014; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2288
msgctxt "text_id=9841 | speaker=alice"
msgid "「…………その。"
msgstr ""

#. Occurrence 7_7:2300:9842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0015; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2300
msgctxt "text_id=9842 | speaker=alice"
msgid "　今日は、ポットがあったけど」"
msgstr ""

#. Occurrence 7_7:2320:9843: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0021; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2320
msgctxt "text_id=9843 | speaker=soujuurou"
msgid "「あ、うん。昨日の反省点だったから。結局、使ったのは自分だけだけど」"
msgstr ""

#. Occurrence 7_7:2354:9844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0016; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2354
msgctxt "text_id=9844 | speaker=alice"
msgid "「そう。……そのポットはコーヒーとの兼用だから、ハーブティーには合わないわ」"
msgstr ""

#. Occurrence 7_7:2360:9845: scene=7_7
#: 7_7:2360
msgctxt "text_id=9845 | speaker=unknown"
msgid "　む、と目を見張る草十郎。"
msgstr ""

#. Occurrence 7_7:2365:9846: scene=7_7
#: 7_7:2365
msgctxt "text_id=9846 | speaker=unknown"
msgid "　言われてみれば、紅茶のポットとカップは何種類もあった。どうも各紅茶には専用のティーセットが定められているらしい。"
msgstr ""

#. Occurrence 7_7:2386:9847: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0022; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2386
msgctxt "text_id=9847 | speaker=soujuurou"
msgid "「……なかなかに奥深い。"
msgstr ""

#. Occurrence 7_7:2392:9848: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0023; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2392
msgctxt "text_id=9848 | speaker=soujuurou"
msgid "　あれかな、慣れない事はするもんじゃないってコトか」"
msgstr ""

#. Occurrence 7_7:2397:9849: scene=7_7
#: 7_7:2397
msgctxt "text_id=9849 | speaker=unknown"
msgid "　やれやれと嘆息する。"
msgstr ""

#. Occurrence 7_7:2416:9850: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0017; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2416
msgctxt "text_id=9850 | speaker=alice"
msgid "「……どうして、わたしを起こさなかったの？」"
msgstr ""

#. Occurrence 7_7:2421:9851: scene=7_7
#: 7_7:2421
msgctxt "text_id=9851 | speaker=unknown"
msgid "　草十郎の言葉なんて聞いていないのか、それとも、それが本当に訊ねたかった事なのか。"
msgstr ""

#. Occurrence 7_7:2426:9852: scene=7_7
#: 7_7:2426
msgctxt "text_id=9852 | speaker=unknown"
msgid "　有珠は彼の言葉を<遮|さえぎ>って問いただした。"
msgstr ""

#. Occurrence 7_7:2465:9853: scene=7_7
#: 7_7:2465
msgctxt "text_id=9853 | speaker=unknown"
msgid "　草十郎はむ、と自問するように黙りこむ。"
msgstr ""

#. Occurrence 7_7:2470:9854: scene=7_7
#: 7_7:2470
msgctxt "text_id=9854 | speaker=unknown"
msgid "　言われて見れば、昨日も今日も“有珠を起こす”という発想に、まったく思い至らなかったからだ。"
msgstr ""

#. Occurrence 7_7:2502:9855: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0018; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2502
msgctxt "text_id=9855 | speaker=alice"
msgid "「……言って。"
msgstr ""

#. Occurrence 7_7:2509:9856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0019; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2509
msgctxt "text_id=9856 | speaker=alice"
msgid "起こす気も、起きることも期待していなかったのは、なぜ？」"
msgstr ""

#. Occurrence 7_7:2515:9857: scene=7_7
#: 7_7:2515
msgctxt "text_id=9857 | speaker=unknown"
msgid "　その視線には殺意すら含まれている。"
msgstr ""

#. Occurrence 7_7:2520:9858: scene=7_7
#: 7_7:2520
msgctxt "text_id=9858 | speaker=unknown"
msgid "　深い瞳にはどんな嘘も通用しない。"
msgstr ""

#. Occurrence 7_7:2525:9859: scene=7_7
#: 7_7:2525
msgctxt "text_id=9859 | speaker=unknown"
msgid "　夕暮れのロビーは一転して、生死を分かつ法廷になっていた。"
msgstr ""

#. Occurrence 7_7:2557:9860: scene=7_7
#: 7_7:2557
msgctxt "text_id=9860 | speaker=unknown"
msgid "　嘘も、つまらない答えも許さない。"
msgstr ""

#. Occurrence 7_7:2562:9861: scene=7_7
#: 7_7:2562
msgctxt "text_id=9861 | speaker=unknown"
msgid "　何を口にしようと心臓を貫かれそうな雰囲気の中、草十郎が抱いた感情は恐れより痛みだった。"
msgstr ""

#. Occurrence 7_7:2567:9862: scene=7_7
#: 7_7:2567
msgctxt "text_id=9862 | speaker=unknown"
msgid "　久遠寺有珠の声は冷たく、また、回答を拒絶している。"
msgstr ""

#. Occurrence 7_7:2572:9863: scene=7_7
#: 7_7:2572
msgctxt "text_id=9863 | speaker=unknown"
msgid "　少年は漠然と、地面に落ちながら<独|ひと>り立ちしたひな鳥を連想した。"
msgstr ""

#. Occurrence 7_7:2578:9864: scene=7_7
#: 7_7:2578
msgctxt "text_id=9864 | speaker=unknown"
msgid "　一縷の希望を待ちながら、その希望の<在処|ありか>を憎む、取り残されたモノの喘ぎ。"
msgstr ""

#. Occurrence 7_7:2611:9865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0024; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2611
msgctxt "text_id=9865 | speaker=soujuurou"
msgid "「言わなきゃいけないか？」"
msgstr ""

#. Occurrence 7_7:2616:9866: scene=7_7
#: 7_7:2616
msgctxt "text_id=9866 | speaker=unknown"
msgid "　有珠はこくりと頷く。"
msgstr ""

#. Occurrence 7_7:2629:9867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9867 | speaker=soujuurou"
msgid "「じゃあ言うけど、別に深い考えがあったワケじゃない。"
msgstr ""

#. Occurrence 7_7:2629:9868: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9868 | speaker=soujuurou"
msgid "　単に、寝た子を起こすのはよくないだろ」"
msgstr ""

#. Occurrence 7_7:2635:9869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0020; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2635
msgctxt "text_id=9869 | speaker=alice"
msgid "「……冗談は聞いてないわ」"
msgstr ""

#. Occurrence 7_7:2641:9870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0026; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2641
msgctxt "text_id=9870 | speaker=soujuurou"
msgid "「冗談じゃないよ。眠っているのならそのままでいいと思ったんだ。話はしたいけど、それはまた、目が覚めた次の機会にするべきだって」"
msgstr ""

#. Occurrence 7_7:2677:9871: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0021; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2677
msgctxt "text_id=9871 | speaker=alice"
msgid "「……ずいぶんと悠長なのね。青子が貴方を守るのは今日までだって聞いているけど。"
msgstr ""

#. Occurrence 7_7:2683:9872: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0022; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2683
msgctxt "text_id=9872 | speaker=alice"
msgid "　わたしに取り入る機会はこれが最後なのに。"
msgstr ""

#. Occurrence 7_7:2689:9873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0023; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2689
msgctxt "text_id=9873 | speaker=alice"
msgid "　それとも―――あれだけ忠告されておいて、まだ何も分かっていないの？」"
msgstr ""

#. Occurrence 7_7:2710:9874: scene=7_7
#: 7_7:2710
msgctxt "text_id=9874 | speaker=unknown"
msgid "　何も分かっていない。"
msgstr ""

#. Occurrence 7_7:2715:9875: scene=7_7
#: 7_7:2715
msgctxt "text_id=9875 | speaker=unknown"
msgid "　約束はした、事情も分かった、同じ人間として話し合えた。だから―――もう殺される事はないはずだ、と。"
msgstr ""

#. Occurrence 7_7:2720:9876: scene=7_7
#: 7_7:2720
msgctxt "text_id=9876 | speaker=unknown"
msgid "　そんな良識、常識からの判断なら、少女はこの場で魔女としての鉄槌を振り下ろす。"
msgstr ""

#. Occurrence 7_7:2725:9877: scene=7_7
#: 7_7:2725
msgctxt "text_id=9877 | speaker=unknown"
msgid "　くだらない勘違いは、どちらにとっても害にしかならないからだ。"
msgstr ""

#. Occurrence 7_7:2759:9878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0027; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2759
msgctxt "text_id=9878 | speaker=soujuurou"
msgid "「そりゃ何も分からないよ。魔術とか魔法とか、たった数日で分かるもんか。"
msgstr ""

#. Occurrence 7_7:2765:9879: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0028; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2765
msgctxt "text_id=9879 | speaker=soujuurou"
msgid "　はっきりしているのは、有珠も蒼崎も言った事はきっちり守るってコトだけだ」"
msgstr ""

#. Occurrence 7_7:2785:9880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0024; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2785
msgctxt "text_id=9880 | speaker=alice"
msgid "「なら、どうして」"
msgstr ""

#. Occurrence 7_7:2790:9881: scene=7_7
#: 7_7:2790
msgctxt "text_id=9881 | speaker=unknown"
msgid "　眠っている自分を起こして、命を<乞|こ>わなかったのかと視線で問う。"
msgstr ""

#. Occurrence 7_7:2824:9882: scene=7_7
#: 7_7:2824
msgctxt "text_id=9882 | speaker=unknown"
msgid "　有珠は知っている。"
msgstr ""

#. Occurrence 7_7:2842:9883: scene=7_7
#: 7_7:2842
msgctxt "text_id=9883 | speaker=unknown"
msgid "　この少年が自分を起こさず立ち去ろうとした時に見せた表情を。"
msgstr ""

#. Occurrence 7_7:2877:9884: scene=7_7
#: 7_7:2877
msgctxt "text_id=9884 | speaker=unknown"
msgid "“そういう事なら仕方がない―――”"
msgstr ""

#. Occurrence 7_7:2882:9885: scene=7_7
#: 7_7:2882
msgctxt "text_id=9885 | speaker=unknown"
msgid "　あの顔は、一体どういう意味だったのか。"
msgstr ""

#. Occurrence 7_7:2917:9886: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0029; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2917
msgctxt "text_id=9886 | speaker=soujuurou"
msgid "「どうしてって、そう言われても困る。"
msgstr ""

#. Occurrence 7_7:2933:9887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0030; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2933
msgctxt "text_id=9887 | speaker=soujuurou"
msgid "　……そうだな。機会が訪れなかったのなら、それはそういう事だと思ったのかもしれない。"
msgstr ""

#. Occurrence 7_7:2945:9888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0031; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2945
msgctxt "text_id=9888 | speaker=soujuurou"
msgid "　君の寝顔はそれぐらい、なんていうか判断に困った。蒼崎とは違う意味で、簡単には関われないと思ったんだ」"
msgstr ""

#. Occurrence 7_7:2965:9889: scene=7_7
#: 7_7:2965
msgctxt "text_id=9889 | speaker=unknown"
msgid "　うまく言葉にできないながらも、草十郎はあの時の気持ちを口にする。"
msgstr ""

#. Occurrence 7_7:2984:9890: scene=7_7
#: 7_7:2984
msgctxt "text_id=9890 | speaker=unknown"
msgid "　誰かを必要としているクセに誰も望んでいない、眠りの森の少女の姿を。"
msgstr ""

#. Occurrence 7_7:3005:9891: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0025; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3005
msgctxt "text_id=9891 | speaker=alice"
msgid "「……そう。でも、静希君は関わろうとしているのね。"
msgstr ""

#. Occurrence 7_7:3011:9892: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0026; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3011
msgctxt "text_id=9892 | speaker=alice"
msgid "　その機会は、訪れなかったのに」"
msgstr ""

#. Occurrence 7_7:3044:9893: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0032; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3044
msgctxt "text_id=9893 | speaker=soujuurou"
msgid "「機会はやってきたよ。なんで、こっちも今日ぐらいは自分の勝手にして、無茶をしたくなったんだ」"
msgstr ""

#. Occurrence 7_7:3061:9894: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0027; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3061
msgctxt "text_id=9894 | speaker=alice"
msgid "「静希君の言う通りなら、わたしは貴方を拒絶するしかないのに？」"
msgstr ""

#. Occurrence 7_7:3082:9895: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0033; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3082
msgctxt "text_id=9895 | speaker=soujuurou"
msgid "「まあ、そこが難しいところなんだけど」"
msgstr ""

#. Occurrence 7_7:3099:9896: scene=7_7
#: 7_7:3099
msgctxt "text_id=9896 | speaker=unknown"
msgid "　草十郎はちらりと玄関に視線を向ける。"
msgstr ""

#. Occurrence 7_7:3104:9897: scene=7_7
#: 7_7:3104
msgctxt "text_id=9897 | speaker=unknown"
msgid "　今は何の意味もない行為だが、そうせずにはいられなかったのだ。"
msgstr ""

#. Occurrence 7_7:3111:9898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0034; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3111
msgctxt "text_id=9898 | speaker=soujuurou"
msgid "「たぶん、そこを解決したがってるのは俺だけじゃないと思うよ」"
msgstr ""

#. Occurrence 7_7:3144:9899: scene=7_7
#: 7_7:3144
msgctxt "text_id=9899 | speaker=unknown"
msgid "　自問めいた答えは少女に対して向けられたものでもある。"
msgstr ""

#. Occurrence 7_7:3149:9900: scene=7_7
#: 7_7:3149
msgctxt "text_id=9900 | speaker=unknown"
msgid "　それが大きな間違いだという事を、有珠は分かっている。"
msgstr ""

#. Occurrence 7_7:3154:9901: scene=7_7
#: 7_7:3154
msgctxt "text_id=9901 | speaker=unknown"
msgid "　全て彼の勘違い。"
msgstr ""

#. Occurrence 7_7:3159:9902: scene=7_7
#: 7_7:3159
msgctxt "text_id=9902 | speaker=unknown"
msgid "　死に瀕した子猫に手を伸ばそうとする程度の、清らかで浅ましい、小さな善性。"
msgstr ""

#. Occurrence 7_7:3164:9903: scene=7_7
#: 7_7:3164
msgctxt "text_id=9903 | speaker=unknown"
msgid "　それが、有珠には<茨|いばら>のようにいとわしかった。"
msgstr ""

#. Occurrence 7_7:3170:9904: scene=7_7
#: 7_7:3170
msgctxt "text_id=9904 | speaker=unknown"
msgid "　……久しぶりに、胸に痛いと感じたのだ。"
msgstr ""

#. Occurrence 7_7:3205:9905: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0028; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3205
msgctxt "text_id=9905 | speaker=alice"
msgid "「……けど、わたしは貴方の同居を認めてはいないわ」"
msgstr ""

#. Occurrence 7_7:3223:9906: scene=7_7
#: 7_7:3223
msgctxt "text_id=9906 | speaker=unknown"
msgid "　そんな心を隠すように、うつむき加減に有珠は言った。"
msgstr ""

#. Occurrence 7_7:3228:9907: scene=7_7
#: 7_7:3228
msgctxt "text_id=9907 | speaker=unknown"
msgid "　立っている草十郎からでは、今の有珠が、あの時の青子と同じ顔をしている事には気づけない。"
msgstr ""

#. Occurrence 7_7:3262:9908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0035; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3262
msgctxt "text_id=9908 | speaker=soujuurou"
msgid "「だろうな。それはきっと、今は解決できない問題だ。"
msgstr ""

#. Occurrence 7_7:3268:9909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0036; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3268
msgctxt "text_id=9909 | speaker=soujuurou"
msgid "　でもそのうち、何かの気まぐれであっさり終わるものかもしれない。だからその時まで、有珠はずっと、俺を嫌っていていいんだと思う」"
msgstr ""

#. Occurrence 7_7:3289:9910: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0029; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3289
msgctxt "text_id=9910 | speaker=alice"
msgid "「―――――――――」"
msgstr ""

#. Occurrence 7_7:3295:9911: scene=7_7
#: 7_7:3295
msgctxt "text_id=9911 | speaker=unknown"
msgid "　息を飲む気配は、それこそ声のように。"
msgstr ""

#. Occurrence 7_7:3300:9912: scene=7_7
#: 7_7:3300
msgctxt "text_id=9912 | speaker=unknown"
msgid "　その時まで、嫌ってもいいと。"
msgstr ""

#. Occurrence 7_7:3305:9913: scene=7_7
#: 7_7:3305
msgctxt "text_id=9913 | speaker=unknown"
msgid "　そんな言葉を、少女は今まで、いや、一度だけ、強く願った事があって―――"
msgstr ""

#. Occurrence 7_7:3332:9914: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0037; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3332
msgctxt "text_id=9914 | speaker=soujuurou"
msgid "「だいたいだぞ。有珠だけじゃなく、蒼崎も同居を認めてない節があるじゃないか。"
msgstr ""

#. Occurrence 7_7:3338:9915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0038; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3338
msgctxt "text_id=9915 | speaker=soujuurou"
msgid "　だから、認めてもらう、なんて意気ごみ自体が間違いなんだ。どうあっても俺は蒼崎や君たちとは違うんだし。"
msgstr ""

#. Occurrence 7_7:3344:9916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0039; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3344
msgctxt "text_id=9916 | speaker=soujuurou"
msgid "　となると、あとは我慢してもらうしかない。"
msgstr ""

#. Occurrence 7_7:3351:9917: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0040; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3351
msgctxt "text_id=9917 | speaker=soujuurou"
msgid "難しい話だけど、一緒にいても邪魔にならないぐらいなら、その可能性はあがらないか？」"
msgstr ""

#. Occurrence 7_7:3383:9918: scene=7_7
#: 7_7:3383
msgctxt "text_id=9918 | speaker=unknown"
msgid "　たしかにその通りなのだけど、それが出来るのなら苦労はしない―――と、そこまで思って、有珠はなるほど、と頷いてしまった。"
msgstr ""

#. Occurrence 7_7:3388:9919: scene=7_7
#: 7_7:3388
msgctxt "text_id=9919 | speaker=unknown"
msgid "　彼が企んだ訳ではないのだろうが。"
msgstr ""

#. Occurrence 7_7:3393:9920: scene=7_7
#: 7_7:3393
msgctxt "text_id=9920 | speaker=unknown"
msgid "　こうして会話が成立している時点で、自分は術中に<嵌|はま>ってしまったのだ。"
msgstr ""

#. Occurrence 7_7:3426:9921: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0030; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3426
msgctxt "text_id=9921 | speaker=alice"
msgid "「例えば、貴方が<隣|となり>にいても眠っていられるぐらいに？」"
msgstr ""

#. Occurrence 7_7:3444:9922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0041; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3444
msgctxt "text_id=9922 | speaker=soujuurou"
msgid "「そうだね、例えばの話」"
msgstr ""

#. Occurrence 7_7:3461:9923: scene=7_7
#: 7_7:3461
msgctxt "text_id=9923 | speaker=unknown"
msgid "　笑顔で返して草十郎はロビーを後にする。"
msgstr ""

#. Occurrence 7_7:3466:9924: scene=7_7
#: 7_7:3466
msgctxt "text_id=9924 | speaker=unknown"
msgid "　その後ろ姿を有珠はもう止めなかった。"
msgstr ""

#. Occurrence 7_7:3518:9925: scene=7_7
#: 7_7:3518
msgctxt "text_id=9925 | speaker=unknown"
msgid "　玄関から外に出た少年は、心機一転してアルバイト先に足を向ける。"
msgstr ""

#. Occurrence 7_7:3523:9926: scene=7_7
#: 7_7:3523
msgctxt "text_id=9926 | speaker=unknown"
msgid "　ただ、その前に。"
msgstr ""

#. Occurrence 7_7:3530:9927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0042; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3530
msgctxt "text_id=9927 | speaker=soujuurou"
msgid "「じっさい、覗き見は趣味が悪いと思う」"
msgstr ""

#. Occurrence 7_7:3536:9928: scene=7_7
#: 7_7:3536
msgctxt "text_id=9928 | speaker=unknown"
msgid "　誰かに告げるように、そんな文句を呟いた。"
msgstr ""

#. Occurrence 7_8:49:9929: scene=7_8
#: 7_8:49
msgctxt "text_id=9929 | speaker=unknown"
msgid "　草十郎が洋館を後にしてから二分ほど経った後、足音を忍ばせて、長い髪の人影がロビーに入ってきた。"
msgstr ""

#. Occurrence 7_8:54:9930: scene=7_8
#: 7_8:54
msgctxt "text_id=9930 | speaker=unknown"
msgid "　今まで外から様子を<窺|うかが>っていた、蒼崎青子その人である。"
msgstr ""

#. Occurrence 7_8:86:9931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0000; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:86
msgctxt "text_id=9931 | speaker=alice"
msgid "「……帰ってたの？」"
msgstr ""

#. Occurrence 7_8:104:9932: scene=7_8
#: 7_8:104
msgctxt "text_id=9932 | speaker=unknown"
msgid "　むっとした目付きで、有珠は青子に語りかけた。"
msgstr ""

#. Occurrence 7_8:109:9933: scene=7_8
#: 7_8:109
msgctxt "text_id=9933 | speaker=unknown"
msgid "　どれほど外に居たのか、青子の体は寒さで震えている。"
msgstr ""

#. Occurrence 7_8:114:9934: scene=7_8
#: 7_8:114
msgctxt "text_id=9934 | speaker=unknown"
msgid "　手袋は悪、と公言している青子は、よほどの寒さでなければ手袋はつけない。それが災いして、長い指が哀れなほど赤くなっていた。"
msgstr ""

#. Occurrence 7_8:150:9935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0000; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:150
msgctxt "text_id=9935 | speaker=aoko"
msgid "「ちょっと前にね。それでどうだったの有珠？　ずいぶんと話してたみたいだけど」"
msgstr ""

#. Occurrence 7_8:156:9936: scene=7_8
#: 7_8:156
msgctxt "text_id=9936 | speaker=unknown"
msgid "　吐息で両手を温めながら、青子はどこか楽しそうに問いただす。"
msgstr ""

#. Occurrence 7_8:192:9937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0001; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:192
msgctxt "text_id=9937 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 7_8:197:9938: scene=7_8
#: 7_8:197
msgctxt "text_id=9938 | speaker=unknown"
msgid "　その意地の悪い顔で、有珠は事の<絡繰|からくり>を読み取った。"
msgstr ""

#. Occurrence 7_8:224:9939: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0002; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:224
msgctxt "text_id=9939 | speaker=alice"
msgid "「……貴女がここまで過保護とは思わなかったわ。"
msgstr ""

#. Occurrence 7_8:230:9940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0003; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:230
msgctxt "text_id=9940 | speaker=alice"
msgid "　意地？　それとも義務？」"
msgstr ""

#. Occurrence 7_8:249:9941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0001; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:249
msgctxt "text_id=9941 | speaker=aoko"
msgid "「どっちかっていうと成り行きね。"
msgstr ""

#. Occurrence 7_8:255:9942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0002; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:255
msgctxt "text_id=9942 | speaker=aoko"
msgid "　で、どうだったのよ結果は。気にくわなかったら実力行使に出るって言ってたじゃない」"
msgstr ""

#. Occurrence 7_8:300:9943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0004; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:300
msgctxt "text_id=9943 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 7_8:305:9944: scene=7_8
#: 7_8:305
msgctxt "text_id=9944 | speaker=unknown"
msgid "　上機嫌な青子を前に、有珠はますます面持ちを暗くしていく。"
msgstr ""

#. Occurrence 7_8:338:9945: scene=7_8
#: 7_8:338
msgctxt "text_id=9945 | speaker=unknown"
msgid "　話は昨日の夕食までさかのぼる。"
msgstr ""

#. Occurrence 7_8:343:9946: scene=7_8
#: 7_8:343
msgctxt "text_id=9946 | speaker=unknown"
msgid "　ロビーでの一件で草十郎への不信感、および関心がメーターを振り切ったのか、有珠は“明日も彼をひとりで帰して”と青子に強要した。"
msgstr ""

#. Occurrence 7_8:363:9947: scene=7_8
#: 7_8:363
msgctxt "text_id=9947 | speaker=unknown"
msgid "　今日の眠りは薬による擬似的なもので、意図的に昨日の状況を再現したものである。"
msgstr ""

#. Occurrence 7_8:368:9948: scene=7_8
#: 7_8:368
msgctxt "text_id=9948 | speaker=unknown"
msgid "　状況はうまくいったが結果は彼女の予想から外れ、また、お節介な同居人が壁越しに手に汗握っていた、というのも面白くない。"
msgstr ""

#. Occurrence 7_8:373:9949: scene=7_8
#: 7_8:373
msgctxt "text_id=9949 | speaker=unknown"
msgid "　さらに付け足すのなら、そんなどうでもいい事に腹を立てている自分にも呆れてしまう有珠だった。"
msgstr ""

#. Occurrence 7_8:403:9950: scene=7_8
#: 7_8:403
msgctxt "text_id=9950 | speaker=unknown"
msgid "　床に置かれたティーカップを見つめる有珠。"
msgstr ""

#. Occurrence 7_8:408:9951: scene=7_8
#: 7_8:408
msgctxt "text_id=9951 | speaker=unknown"
msgid "　その白い指が冷えたカップの<縁|ふち>をなぞっていく。"
msgstr ""

#. Occurrence 7_8:425:9952: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0005; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:425
msgctxt "text_id=9952 | speaker=alice"
msgid "「……青子の言う通り、害にはならない人ね。"
msgstr ""

#. Occurrence 7_8:431:9953: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0006; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:431
msgctxt "text_id=9953 | speaker=alice"
msgid "　あくまで、今のところの話だけど」"
msgstr ""

#. Occurrence 7_8:436:9954: scene=7_8
#: 7_8:436
msgctxt "text_id=9954 | speaker=unknown"
msgid "　青子に内心の苛立ちを見せないよう、有珠は冷淡な感想を述べた。"
msgstr ""

#. Occurrence 7_8:441:9955: scene=7_8
#: 7_8:441
msgctxt "text_id=9955 | speaker=unknown"
msgid "　その時点で、もう結論は出ているようなものだが。"
msgstr ""

#. Occurrence 7_8:476:9956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0003; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:476
msgctxt "text_id=9956 | speaker=aoko"
msgid "「あら、それだけ？　有珠にしては長く話してたのに」"
msgstr ""

#. Occurrence 7_8:481:9957: scene=7_8
#: 7_8:481
msgctxt "text_id=9957 | speaker=unknown"
msgid "　白状しろ、とばかりに青子はしつこく繰り返す。"
msgstr ""

#. Occurrence 7_8:486:9958: scene=7_8
#: 7_8:486
msgctxt "text_id=9958 | speaker=unknown"
msgid "　有珠はそんな同居人を冷徹に見据えると、"
msgstr ""

#. Occurrence 7_8:507:9959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0007; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:507
msgctxt "text_id=9959 | speaker=alice"
msgid "「青子。貴女、隠していたわね」"
msgstr ""

#. Occurrence 7_8:512:9960: scene=7_8
#: 7_8:512
msgctxt "text_id=9960 | speaker=unknown"
msgid "　敵意すらこめて、彼女の不義を糾弾した。"
msgstr ""

#. Occurrence 7_8:549:9961: scene=7_8
#: 7_8:549
msgctxt "text_id=9961 | speaker=unknown"
msgid "　ロビーの空気が凍る。"
msgstr ""

#. Occurrence 7_8:554:9962: scene=7_8
#: 7_8:554
msgctxt "text_id=9962 | speaker=unknown"
msgid "　ふたりの少女は相手の出方を探るように見つめ合った。"
msgstr ""

#. Occurrence 7_8:591:9963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0004; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:591
msgctxt "text_id=9963 | speaker=aoko"
msgid "「…………流石ね。よくそこに気が付いたもんだわ。でも、こればかりは譲れないのよ」"
msgstr ""

#. Occurrence 7_8:597:9964: scene=7_8
#: 7_8:597
msgctxt "text_id=9964 | speaker=unknown"
msgid "　じり、と腰を落として有珠を睨む青子。"
msgstr ""

#. Occurrence 7_8:631:9965: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0008; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:631
msgctxt "text_id=9965 | speaker=alice"
msgid "「なにも全て奪うとは言っていないわ。……そうね。貴女にも三割ぐらいは回すつもり」"
msgstr ""

#. Occurrence 7_8:637:9966: scene=7_8
#: 7_8:637
msgctxt "text_id=9966 | speaker=unknown"
msgid "　戦闘態勢に入った青子に動じず、有珠は視線だけで青子を牽制する。"
msgstr ""

#. Occurrence 7_8:676:9967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0005; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:676
msgctxt "text_id=9967 | speaker=aoko"
msgid "「ふん。十が三に化けちゃあ、ちょっと黙ってらんないわね」"
msgstr ""

#. Occurrence 7_8:697:9968: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0009; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:697
msgctxt "text_id=9968 | speaker=alice"
msgid "「高望みは命取りよ、青子」"
msgstr ""

#. Occurrence 7_8:703:9969: scene=7_8
#: 7_8:703
msgctxt "text_id=9969 | speaker=unknown"
msgid "　凛とした姿勢のままで有珠は動かない。"
msgstr ""

#. Occurrence 7_8:746:9970: scene=7_8
#: 7_8:746
msgctxt "text_id=9970 | speaker=unknown"
msgid "　そうして無言のまま、両者は長いこと見つめ合った。"
msgstr ""

#. Occurrence 7_8:751:9971: scene=7_8
#: 7_8:751
msgctxt "text_id=9971 | speaker=unknown"
msgid "　ぎり、と悔しげに歯を鳴らす青子。"
msgstr ""

#. Occurrence 7_8:759:9972: scene=7_8
#: 7_8:759
msgctxt "text_id=9972 | speaker=unknown"
msgid "　このままでは外敵との対決を前にして、仲間割れという形で幕は下りかねない。"
msgstr ""

#. Occurrence 7_8:791:9973: scene=7_8
#: 7_8:791
msgctxt "text_id=9973 | speaker=unknown"
msgid "　……加えて。"
msgstr ""

#. Occurrence 7_8:796:9974: scene=7_8
#: 7_8:796
msgctxt "text_id=9974 | speaker=unknown"
msgid "　どう考えても、分が悪いのは自分だった。"
msgstr ""

#. Occurrence 7_8:840:9975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0006; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:840
msgctxt "text_id=9975 | speaker=aoko"
msgid "「…………けち」"
msgstr ""

#. Occurrence 7_8:845:9976: scene=7_8
#: 7_8:845
msgctxt "text_id=9976 | speaker=unknown"
msgid "　青子はちっ、と舌打ちして敗北を認める。"
msgstr ""

#. Occurrence 7_8:875:9977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0007; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:875
msgctxt "text_id=9977 | speaker=aoko"
msgid "「悔しいけど有珠が六、私が四で手を打つわ」"
msgstr ""

#. Occurrence 7_8:881:9978: scene=7_8
#: 7_8:881
msgctxt "text_id=9978 | speaker=unknown"
msgid "　無念げに妥協する青子と、満足げにうなずく有珠。"
msgstr ""

#. Occurrence 7_8:916:9979: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0010; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:916
msgctxt "text_id=9979 | speaker=alice"
msgid "「そうね。<家主|やぬし>はわたしだけど、彼を招いたのは青子だから。そのかわり、<家賃|やちん>の取り立ては貴女の役割ね」"
msgstr ""

#. Occurrence 7_8:935:9980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0008; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:935
msgctxt "text_id=9980 | speaker=aoko"
msgid "「……いいけど。あーあ、情けない。こんな事なら錬金術でもかじっておくんだった。そうすれば、こんな思いをしなくてもすんだのに」"
msgstr ""

#. Occurrence 7_8:941:9981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0011; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:941
msgctxt "text_id=9981 | speaker=alice"
msgid "「そうでもないわ。彼ら、バブルが弾けて大変だって話よ」"
msgstr ""

#. Occurrence 7_8:969:9982: scene=7_8
#: 7_8:969
msgctxt "text_id=9982 | speaker=unknown"
msgid "　妙に実感のこもった有珠の言葉に、青子ははいはいと空返事をする。"
msgstr ""

#. Occurrence 7_8:974:9983: scene=7_8
#: 7_8:974
msgctxt "text_id=9983 | speaker=unknown"
msgid "　ふたりは草十郎を住まわせた後の、彼が支払う家賃の取り分を真剣に議論していたのだ。"
msgstr ""

#. Occurrence 7_8:980:9984: scene=7_8
#: 7_8:980
msgctxt "text_id=9984 | speaker=unknown"
msgid "　魔術師にあるまじき口論である。"
msgstr ""

#. Occurrence 7_8:985:9985: scene=7_8
#: 7_8:985
msgctxt "text_id=9985 | speaker=unknown"
msgid "　無理やり同居を強制しておいて家賃を取るあたり、詐欺を通り越してもはや暴力と言っていいレベル。"
msgstr ""

#. Occurrence 7_8:1018:9986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0009; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1018
msgctxt "text_id=9986 | speaker=aoko"
msgid "「でも、そんな台詞が出るって事は有珠もようやく認めたってコトね」"
msgstr ""

#. Occurrence 7_8:1023:9987: scene=7_8
#: 7_8:1023
msgctxt "text_id=9987 | speaker=unknown"
msgid "　よしよし、と満足する青子。"
msgstr ""

#. Occurrence 7_8:1040:9988: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0012; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1040
msgctxt "text_id=9988 | speaker=alice"
msgid "「……認めてはいないけど、公園での夜、彼を結界で捕捉しなかった責任があるから。"
msgstr ""

#. Occurrence 7_8:1046:9989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0013; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1046
msgctxt "text_id=9989 | speaker=alice"
msgid "　彼と約束をした青子だけを責められないでしょう」"
msgstr ""

#. Occurrence 7_8:1081:9990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0010; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1081
msgctxt "text_id=9990 | speaker=aoko"
msgid "「……約束、か」"
msgstr ""

#. Occurrence 7_8:1087:9991: scene=7_8
#: 7_8:1087
msgctxt "text_id=9991 | speaker=unknown"
msgid "　遊園地の夜を思い出すように、青子は天井を見上げた。"
msgstr ""

#. Occurrence 7_8:1092:9992: scene=7_8
#: 7_8:1092
msgctxt "text_id=9992 | speaker=unknown"
msgid "　たかだか一週間ほど前の出来事なのに、あれから随分と草十郎との縁が強くなった気がする。"
msgstr ""

#. Occurrence 7_8:1097:9993: scene=7_8
#: 7_8:1097
msgctxt "text_id=9993 | speaker=unknown"
msgid "　それとも、初めて会ったあの時から縁は強いものだったのだろうか。"
msgstr ""

#. Occurrence 7_8:1102:9994: scene=7_8
#: 7_8:1102
msgctxt "text_id=9994 | speaker=unknown"
msgid "　未来視ではない青子には、とうてい預かり知らぬコトではあるが。"
msgstr ""

#. Occurrence 7_8:1136:9995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0011; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1136
msgctxt "text_id=9995 | speaker=aoko"
msgid "「ま、縁とか運とかはともかく。"
msgstr ""

#. Occurrence 7_8:1142:9996: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0012; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1142
msgctxt "text_id=9996 | speaker=aoko"
msgid "　変だけどいい奴よね、あいつ」"
msgstr ""

#. Occurrence 7_8:1148:9997: scene=7_8
#: 7_8:1148
msgctxt "text_id=9997 | speaker=unknown"
msgid "　有珠に同意を求めるワケでもなく呟く青子。"
msgstr ""

#. Occurrence 7_8:1167:9998: scene=7_8
#: 7_8:1167
msgctxt "text_id=9998 | speaker=unknown"
msgid "　それを有珠は不機嫌そうに眺める。"
msgstr ""

#. Occurrence 7_8:1172:9999: scene=7_8
#: 7_8:1172
msgctxt "text_id=9999 | speaker=unknown"
msgid "　なにか、今の台詞が気に入らなかったのかも知れない。"
msgstr ""

#. Occurrence 7_8:1199:10000: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0014; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1199
msgctxt "text_id=10000 | speaker=alice"
msgid "「青子、あの傷を知ってる？」"
msgstr ""

#. Occurrence 7_8:1205:10001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0013; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1205
msgctxt "text_id=10001 | speaker=aoko"
msgid "「傷……？」"
msgstr ""

#. Occurrence 7_8:1217:10002: scene=7_8
#: 7_8:1217
msgctxt "text_id=10002 | speaker=unknown"
msgid "　思わず口にでた声を、有珠は細い指で押し止めた。"
msgstr ""

#. Occurrence 7_8:1222:10003: scene=7_8
#: 7_8:1222
msgctxt "text_id=10003 | speaker=unknown"
msgid "　感情的に出てしまった質問。"
msgstr ""

#. Occurrence 7_8:1227:10004: scene=7_8
#: 7_8:1227
msgctxt "text_id=10004 | speaker=unknown"
msgid "　人に話す事ではないと分かっていたのに訊かずには―――知らさずにはいられなかった、自分しか知らない秘密。"
msgstr ""

#. Occurrence 7_8:1261:10005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0014; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1261
msgctxt "text_id=10005 | speaker=aoko"
msgid "「？？」"
msgstr ""

#. Occurrence 7_8:1266:10006: scene=7_8
#: 7_8:1266
msgctxt "text_id=10006 | speaker=unknown"
msgid "　有珠の問いに首を傾げる青子。"
msgstr ""

#. Occurrence 7_8:1286:10007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0015; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1286
msgctxt "text_id=10007 | speaker=alice"
msgid "「―――そう」"
msgstr ""

#. Occurrence 7_8:1291:10008: scene=7_8
#: 7_8:1291
msgctxt "text_id=10008 | speaker=unknown"
msgid "　なぜか胸を撫でおろす。"
msgstr ""

#. Occurrence 7_8:1296:10009: scene=7_8
#: 7_8:1296
msgctxt "text_id=10009 | speaker=unknown"
msgid "　青子に感じた突発的な反感も、それで晴れてくれたようだ。"
msgstr ""

#. Occurrence 7_8:1330:10010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0016; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1330
msgctxt "text_id=10010 | speaker=alice"
msgid "「―――<倖|しあわ>せな人」"
msgstr ""

#. Occurrence 7_8:1336:10011: scene=7_8
#: 7_8:1336
msgctxt "text_id=10011 | speaker=unknown"
msgid "　そうして。"
msgstr ""

#. Occurrence 7_8:1341:10012: scene=7_8
#: 7_8:1341
msgctxt "text_id=10012 | speaker=unknown"
msgid "　誰がどう倖せなのか口にせず、有珠は冷めきった紅茶を口にした。"
msgstr ""

#. Occurrence 7_8:1359:10013: scene=7_8
#: 7_8:1359
msgctxt "text_id=10013 | speaker=unknown"
msgid "　とたん、その可憐な顔が苦々しい<貌|かお>を作る。"
msgstr ""

#. Occurrence 7_8:1391:10014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0017; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1391
msgctxt "text_id=10014 | speaker=alice"
msgid "「……まずい」"
msgstr ""

#. Occurrence 7_8:1402:10015: scene=7_8
#: 7_8:1402
msgctxt "text_id=10015 | speaker=unknown"
msgid "　無情にも床に放置されるカップ。"
msgstr ""

#. Occurrence 7_8:1408:10016: scene=7_8
#: 7_8:1408
msgctxt "text_id=10016 | speaker=unknown"
msgid "　少女の黒衣がおごそかに揺れる。"
msgstr ""

#. Occurrence 7_8:1413:10017: scene=7_8
#: 7_8:1413
msgctxt "text_id=10017 | speaker=unknown"
msgid "　未熟な紅茶を一口だけ飲んだ有珠は、口直しとばかりに居間へと歩いていってしまった。"
msgstr ""

#. Occurrence 7_8:1445:10018: scene=7_8
#: 7_8:1445
msgctxt "text_id=10018 | speaker=unknown"
msgid "　それを見送った後、ためらいながらも青子は残されたティーカップを手に取った。"
msgstr ""

#. Occurrence 7_8:1450:10019: scene=7_8
#: 7_8:1450
msgctxt "text_id=10019 | speaker=unknown"
msgid "　よせばいいのに、有珠の酷評を受けた草十郎のお茶を飲む気になったのだ。"
msgstr ""

#. Occurrence 7_8:1461:10020: scene=7_8
#: 7_8:1461
msgctxt "text_id=10020 | speaker=unknown"
msgid "　くいと一口に試した後、青子も静かにカップを戻す。"
msgstr ""

#. Occurrence 7_8:1502:10021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0015; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1502
msgctxt "text_id=10021 | speaker=aoko"
msgid "「……だからティーバッグにしろって言ったのに、あの莫迦」"
msgstr ""

#. Occurrence 7_8:1508:10022: scene=7_8
#: 7_8:1508
msgctxt "text_id=10022 | speaker=unknown"
msgid "　有珠と同じ、苦いような困ったような顔をして、青子はそう呟いた。"
msgstr ""

#. Occurrence 7_EX:97:10023: scene=7_EX
#: 7_EX:97
msgctxt "text_id=10023 | speaker=unknown"
msgid "　夜中、洋館を歩いていると不思議なコトに遭遇する。"
msgstr ""

#. Occurrence 7_EX:131:10024: scene=7_EX
#: 7_EX:131
msgctxt "text_id=10024 | speaker=unknown"
msgid "　館内にただよう霧や、"
msgstr ""

#. Occurrence 7_EX:171:10025: scene=7_EX
#: 7_EX:171
msgctxt "text_id=10025 | speaker=unknown"
msgid "　増えたり減ったりするドア。"
msgstr ""

#. Occurrence 7_EX:210:10026: scene=7_EX
#: 7_EX:210
msgctxt "text_id=10026 | speaker=unknown"
msgid "　絨毯の手入れをする子豚っぽい影を見たかと思えば、このように、"
msgstr ""

#. Occurrence 7_EX:236:10027: scene=7_EX
#: 7_EX:236
msgctxt "text_id=10027 | speaker=unknown"
msgid "　サンルームに向かってはかき消える、鳥たちの羽音を聞いたりもする。"
msgstr ""

#. Occurrence 7_EX:285:10028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0000; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:285
msgctxt "text_id=10028 | speaker=soujuurou"
msgid "「なにごと……！？」"
msgstr ""

#. Occurrence 7_EX:294:10029: scene=7_EX
#: 7_EX:294
msgctxt "text_id=10029 | speaker=unknown"
msgid "　たいていの事は見ざる聞かざるな草十郎も、今の羽音は聞き過ごせなかった。"
msgstr ""

#. Occurrence 7_EX:315:10030: scene=7_EX
#: 7_EX:315
msgctxt "text_id=10030 | speaker=unknown"
msgid "　一羽や二羽の話ではないのだ。"
msgstr ""

#. Occurrence 7_EX:320:10031: scene=7_EX
#: 7_EX:320
msgctxt "text_id=10031 | speaker=unknown"
msgid "　十羽単位の鳥がサンルームに突撃したとすれば、窓ガラスとて無事では済むまい。"
msgstr ""

#. Occurrence 7_EX:337:10032: scene=7_EX
#: 7_EX:337
msgctxt "text_id=10032 | speaker=unknown"
msgid "　いてもたってもいられず、草十郎はちり取りと<箒|ほうき>を手にして走りだした。"
msgstr ""

#. Occurrence 7_EX:342:10033: scene=7_EX
#: 7_EX:342
msgctxt "text_id=10033 | speaker=unknown"
msgid "　生来の小姑根性か、せいいっぱいの自己防衛か。"
msgstr ""

#. Occurrence 7_EX:347:10034: scene=7_EX
#: 7_EX:347
msgctxt "text_id=10034 | speaker=unknown"
msgid "　今日の授業でたまたま、"
msgstr ""

#. Occurrence 7_EX:380:10035: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0000; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:380
msgctxt "text_id=10035 | speaker=yamashiro"
msgid "「皆さんも部屋の整頓は心がけてくださいね。人間の自制心って環境に流されるらしいですから。"
msgstr ""

#. Occurrence 7_EX:387:10036: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0001; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:387
msgctxt "text_id=10036 | speaker=yamashiro"
msgid "ほら、それまで犯罪の少ない街だったのに、一つボロボロの家が出来ただけで近隣住人がみーんな自堕落になるというアレ。"
msgstr ""

#. Occurrence 7_EX:393:10037: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0002; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:393
msgctxt "text_id=10037 | speaker=yamashiro"
msgid "　環境への無関心さがすさんだ精神を作り上げるとか眉唾ですけど、正直なところ、ブームだからって盗んだバイクで走り回ったり、学校の廊下の窓ガラスとか割ってまわっちゃダメですよ。先生の仕事が増えますから」"
msgstr ""

#. Occurrence 7_EX:433:10038: scene=7_EX
#: 7_EX:433
msgctxt "text_id=10038 | speaker=unknown"
msgid "　時に、校内暴力がある種の若者にとってステータスになっていた時代の話である。"
msgstr ""

#. Occurrence 7_EX:473:10039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0001; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:473
msgctxt "text_id=10039 | speaker=soujuurou"
msgid "「窓が割れると、心が荒れる」"
msgstr ""

#. Occurrence 7_EX:479:10040: scene=7_EX
#: 7_EX:479
msgctxt "text_id=10040 | speaker=unknown"
msgid "　草十郎はなるほど、と今日聞いた話を<反芻|はんすう>する。"
msgstr ""

#. Occurrence 7_EX:484:10041: scene=7_EX
#: 7_EX:484
msgctxt "text_id=10041 | speaker=unknown"
msgid "　割れ窓理論を聞いていた彼にとって、洋館内のモラル低下は放っておけない。"
msgstr ""

#. Occurrence 7_EX:529:10042: scene=7_EX
#: 7_EX:529
msgctxt "text_id=10042 | speaker=unknown"
msgid "　……同居人は<既|すで>にして十分なほど凶暴だが、これ以上<横暴|おうぼう>さが増しては、なにより本人の為にならない。また学校でよからぬ噂が流れてしまう。"
msgstr ""

#. Occurrence 7_EX:547:10043: scene=7_EX
#: 7_EX:547
msgctxt "text_id=10043 | speaker=unknown"
msgid "　我らが生徒会長の名誉を守る為。"
msgstr ""

#. Occurrence 7_EX:552:10044: scene=7_EX
#: 7_EX:552
msgctxt "text_id=10044 | speaker=unknown"
msgid "　ひいては実害から自分の身を守る為、草十郎はサンルームの掃除に向かったのだが―――"
msgstr ""

#. Occurrence 7_EX:621:10045: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0002; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:621
msgctxt "text_id=10045 | speaker=soujuurou"
msgid "「む？」"
msgstr ""

#. Occurrence 7_EX:628:10046: scene=7_EX
#: 7_EX:628
msgctxt "text_id=10046 | speaker=unknown"
msgid "　この通り、サンルームには鳥の姿はおろか、鳴き声さえ有りはしなかった。"
msgstr ""

#. Occurrence 7_EX:666:10047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0000; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:666
msgctxt "text_id=10047 | speaker=aoko"
msgid "「あら」"
msgstr ""

#. Occurrence 7_EX:685:10048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:685
msgctxt "text_id=10048 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 7_EX:706:10049: scene=7_EX
#: 7_EX:706
msgctxt "text_id=10049 | speaker=unknown"
msgid "　中庭を<臨|のぞ>むテーブルには、午後のお茶を<愉|たの>しむ蒼崎青子と久遠寺有珠の姿のみ。"
msgstr ""

#. Occurrence 7_EX:711:10050: scene=7_EX
#: 7_EX:711
msgctxt "text_id=10050 | speaker=unknown"
msgid "　草十郎ソナー探知で十八羽は居たであろう鳥の気配はどこにもない。"
msgstr ""

#. Occurrence 7_EX:753:10051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0003; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:753
msgctxt "text_id=10051 | speaker=soujuurou"
msgid "「いまここに鳥がこなかった！？」"
msgstr ""

#. Occurrence 7_EX:789:10052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0001; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:789
msgctxt "text_id=10052 | speaker=aoko"
msgid "「有珠、見た？」"
msgstr ""

#. Occurrence 7_EX:801:10053: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0001; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:801
msgctxt "text_id=10053 | speaker=alice"
msgid "「さあ。もう見えないのなら、いないという事でしょう」"
msgstr ""

#. Occurrence 7_EX:813:10054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0002; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:813
msgctxt "text_id=10054 | speaker=aoko"
msgid "「だって。いないよ、鳥」"
msgstr ""

#. Occurrence 7_EX:848:10055: scene=7_EX
#: 7_EX:848
msgctxt "text_id=10055 | speaker=unknown"
msgid "　草十郎ですら感じ取れる、<清々|すがすが>しいまでの嘘である。"
msgstr ""

#. Occurrence 7_EX:885:10056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0004; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:885
msgctxt "text_id=10056 | speaker=soujuurou"
msgid "「そんなバカな」"
msgstr ""

#. Occurrence 7_EX:899:10057: scene=7_EX
#: 7_EX:899
msgctxt "text_id=10057 | speaker=unknown"
msgid "　さっきの羽音は聞き間違いではない。"
msgstr ""

#. Occurrence 7_EX:904:10058: scene=7_EX
#: 7_EX:904
msgctxt "text_id=10058 | speaker=unknown"
msgid "　こと野生動物の生態については<一家言|いっかげん>あるのか、草十郎は急ぎ足で窓まで移動し、ますます眉を<曇|くも>らせた。"
msgstr ""

#. Occurrence 7_EX:909:10059: scene=7_EX
#: 7_EX:909
msgctxt "text_id=10059 | speaker=unknown"
msgid "　窓ガラスには鳥の跡はおろか、羽の一枚すら落ちていない。"
msgstr ""

#. Occurrence 7_EX:962:10060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0003; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:962
msgctxt "text_id=10060 | speaker=aoko"
msgid "「あ。夕食、<鶏|とり>鍋？」"
msgstr ""

#. Occurrence 7_EX:976:10061: scene=7_EX
#: 7_EX:976
msgctxt "text_id=10061 | speaker=unknown"
msgid "　鳥を探す草十郎を見て、なぜその発想にいきつくのか。"
msgstr ""

#. Occurrence 7_EX:1017:10062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0005; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1017
msgctxt "text_id=10062 | speaker=soujuurou"
msgid "「あいにく、今日のバイトは魚屋さんだ。<鰯|いわし>でよければ土産にするけど」"
msgstr ""

#. Occurrence 7_EX:1039:10063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0004; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1039
msgctxt "text_id=10063 | speaker=aoko"
msgid "「鰯……鰯か……私、あのパイ嫌いなのよね……。"
msgstr ""

#. Occurrence 7_EX:1051:10064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0005; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1051
msgctxt "text_id=10064 | speaker=aoko"
msgid "　いえ、むしろ鰯のパイとか食べたコトないのよね……」"
msgstr ""

#. Occurrence 7_EX:1084:10065: scene=7_EX
#: 7_EX:1084
msgctxt "text_id=10065 | speaker=unknown"
msgid "　青子の<独|ひと>り芸は、この時代ではあまりに高度すぎたようだ。"
msgstr ""

#. Occurrence 7_EX:1103:10066: scene=7_EX
#: 7_EX:1103
msgctxt "text_id=10066 | speaker=unknown"
msgid "　草十郎は窓ガラスから離れ、とぼとぼサンルームを後にし、"
msgstr ""

#. Occurrence 7_EX:1127:10067: scene=7_EX
#: 7_EX:1127
msgctxt "text_id=10067 | speaker=unknown"
msgid "　今まで幾度とあった、有珠からのよく分からない視線を感じた。"
msgstr ""

#. Occurrence 7_EX:1207:10068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0006; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1207
msgctxt "text_id=10068 | speaker=soujuurou"
msgid "「なんだい、<有|アリ>―――」"
msgstr ""

#. Occurrence 7_EX:1213:10069: scene=7_EX
#: 7_EX:1213
msgctxt "text_id=10069 | speaker=unknown"
msgid "　何か聞きたい事でもあるのだろうか、と声をかけ、"
msgstr ""

#. Occurrence 7_EX:1247:10070: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0007; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1247
msgctxt "text_id=10070 | speaker=soujuurou"
msgid "「あいたっ」"
msgstr ""

#. Occurrence 7_EX:1254:10071: scene=7_EX
#: 7_EX:1254
msgctxt "text_id=10071 | speaker=unknown"
msgid "　そんな草十郎の頭部に、青い流星が直撃した。"
msgstr ""

#. Occurrence 7_EX:1311:10072: scene=7_EX
#: 7_EX:1311
msgctxt "text_id=10072 | speaker=unknown"
msgid "　流星の正体は言うまでもない。"
msgstr ""

#. Occurrence 7_EX:1318:10073: scene=7_EX
#: 7_EX:1318
msgctxt "text_id=10073 | speaker=unknown"
msgid "　洋館に出没する謎の駒鳥である。"
msgstr ""

#. Occurrence 7_EX:1376:10074: scene=7_EX
#: 7_EX:1376
msgctxt "text_id=10074 | speaker=unknown"
msgid "　チチチチチチ、と甲高く駒鳥は<訴|うった>える。"
msgstr ""

#. Occurrence 7_EX:1382:10075: scene=7_EX
#: 7_EX:1382
msgctxt "text_id=10075 | speaker=unknown"
msgid "　……実のところ。"
msgstr ""

#. Occurrence 7_EX:1387:10076: scene=7_EX
#: 7_EX:1387
msgctxt "text_id=10076 | speaker=unknown"
msgid "　草十郎に激突するコレこそが洋館の七不思議、その最たるものだった。"
msgstr ""

#. Occurrence 7_EX:1547:10077: scene=7_EX
#: 7_EX:1547
msgctxt "text_id=10077 | speaker=unknown"
msgid "　アルバイトに向かう途中、多くの人々とすれ違う。"
msgstr ""

#. Occurrence 7_EX:1554:10078: scene=7_EX
#: 7_EX:1554
msgctxt "text_id=10078 | speaker=unknown"
msgid "　まだ都会慣れしていない草十郎にとって、駅前通りの人の流れは圧巻だ。"
msgstr ""

#. Occurrence 7_EX:1559:10079: scene=7_EX
#: 7_EX:1559
msgctxt "text_id=10079 | speaker=unknown"
msgid "　誰一人として、同じ服装や歩き方の人間がいない。"
msgstr ""

#. Occurrence 7_EX:1564:10080: scene=7_EX
#: 7_EX:1564
msgctxt "text_id=10080 | speaker=unknown"
msgid "　ここまで人が多ければ似たような外見の人間がいそうなものだが、ただの一人も<被|かぶ>っていない。"
msgstr ""

#. Occurrence 7_EX:1569:10081: scene=7_EX
#: 7_EX:1569
msgctxt "text_id=10081 | speaker=unknown"
msgid "　多種多様な街の<賑|にぎ>わいに、子供のように感心してしまう。"
msgstr ""

#. Occurrence 7_EX:1619:10082: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0008; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1619
msgctxt "text_id=10082 | speaker=soujuurou"
msgid "「―――いや」"
msgstr ""

#. Occurrence 7_EX:1625:10083: scene=7_EX
#: 7_EX:1625
msgctxt "text_id=10083 | speaker=unknown"
msgid "　草十郎は目を閉じて反省した。"
msgstr ""

#. Occurrence 7_EX:1630:10084: scene=7_EX
#: 7_EX:1630
msgctxt "text_id=10084 | speaker=unknown"
msgid "　こんな事で感心しているようじゃまだまだ田舎者だ、とため息をつく。"
msgstr ""

#. Occurrence 7_EX:1671:10085: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0000; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1671
msgctxt "text_id=10085 | speaker=kojika"
msgid "「ちょっと。青信号で突っ立ってられるの、邪魔なんだけど。なにガラにもなく<黄昏|たそが>れてるんだか」"
msgstr ""

#. Occurrence 7_EX:1677:10086: scene=7_EX
#: 7_EX:1677
msgctxt "text_id=10086 | speaker=unknown"
msgid "　と。ややセンチになっていた背中に、聞き覚えのある、刺々しい声がかけられた。"
msgstr ""

#. Occurrence 7_EX:1736:10087: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0001; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1736
msgctxt "text_id=10087 | speaker=kojika"
msgid "「なんだ、まっどべあに行く途中だったんだ。"
msgstr ""

#. Occurrence 7_EX:1748:10088: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0002; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1748
msgctxt "text_id=10088 | speaker=kojika"
msgid "　……ふーん。わたしはコンビニのバイト。こっちは五時からだけど、静希は？」"
msgstr ""

#. Occurrence 7_EX:1760:10089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0009; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1760
msgctxt "text_id=10089 | speaker=soujuurou"
msgid "「同じく五時から。<久|く><万|ま><梨|り>はどこか寄るところでも？」"
msgstr ""

#. Occurrence 7_EX:1787:10090: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0003; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1787
msgctxt "text_id=10090 | speaker=kojika"
msgid "「本屋に寄った帰り。読みたかった本がなくなってたから、仕方なく出歩いてたところよ」"
msgstr ""

#. Occurrence 7_EX:1799:10091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0010; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1799
msgctxt "text_id=10091 | speaker=soujuurou"
msgid "「なるほど。時間を持て余しているところも同じだね」"
msgstr ""

#. Occurrence 7_EX:1850:10092: scene=7_EX
#: 7_EX:1850
msgctxt "text_id=10092 | speaker=unknown"
msgid "　声をかけてきたのはバイト先の知り合いでもあり、同期生でもある<久万梨|くまり><金鹿|こじか>だった。"
msgstr ""

#. Occurrence 7_EX:1855:10093: scene=7_EX
#: 7_EX:1855
msgctxt "text_id=10093 | speaker=unknown"
msgid "　声をかけてきた、というよりは因縁をつけてきた、という表現の方が正しいのだが。"
msgstr ""

#. Occurrence 7_EX:1888:10094: scene=7_EX
#: 7_EX:1888
msgctxt "text_id=10094 | speaker=unknown"
msgid "　久万梨は草十郎にとってはじめての先輩でもある。"
msgstr ""

#. Occurrence 7_EX:1933:10095: scene=7_EX
#: 7_EX:1933
msgctxt "text_id=10095 | speaker=unknown"
msgid "　最初のアルバイト先で知り合い、"
msgstr ""

#. Occurrence 7_EX:1974:10096: scene=7_EX
#: 7_EX:1974
msgctxt "text_id=10096 | speaker=unknown"
msgid "　レジ打ちを間違え続けた事からコンビニは向いてないから辞めろと本気で軽蔑され、なぜか最後に、"
msgstr ""

#. Occurrence 7_EX:1999:10097: scene=7_EX
#: 7_EX:1999
msgctxt "text_id=10097 | speaker=unknown"
msgid "“こっちの方が貴方に向いてる”と<中華飯店|まっどべあ>を紹介してくれた人物だ。"
msgstr ""

#. Occurrence 7_EX:2036:10098: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0004; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2036
msgctxt "text_id=10098 | speaker=kojika"
msgid "「なにその無理矢理な顔。なんか元気ない。いつも以上にイラっとくるわ。"
msgstr ""

#. Occurrence 7_EX:2042:10099: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0005; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2042
msgctxt "text_id=10099 | speaker=kojika"
msgid "　静希のいいところなんて、いつもピシッとしている背筋ぐらいなのに、みっともなく丸まってるし。"
msgstr ""

#. Occurrence 7_EX:2101:10100: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0006; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2101
msgctxt "text_id=10100 | speaker=kojika"
msgid "　もしかして悩みとかあるの？　……まっどべあに質の悪い先輩でもいるとか。それなら話ぐらいは聞いてあげるから、言ってみたら？」"
msgstr ""

#. Occurrence 7_EX:2142:10101: scene=7_EX
#: 7_EX:2142
msgctxt "text_id=10101 | speaker=unknown"
msgid "　態度こそ厳しいものの、久万梨の目は真剣である。"
msgstr ""

#. Occurrence 7_EX:2147:10102: scene=7_EX
#: 7_EX:2147
msgctxt "text_id=10102 | speaker=unknown"
msgid "　都会育ちの久万梨にとって、静希草十郎という人間はそのすべてが癪に障るらしい。"
msgstr ""

#. Occurrence 7_EX:2152:10103: scene=7_EX
#: 7_EX:2152
msgctxt "text_id=10103 | speaker=unknown"
msgid "　が、それはそれとして、彼女は草十郎を対等の知人として捉えている。"
msgstr ""

#. Occurrence 7_EX:2157:10104: scene=7_EX
#: 7_EX:2157
msgctxt "text_id=10104 | speaker=unknown"
msgid "　バイト先を紹介してくれたのも、そういう彼女の生真面目さ故だった。"
msgstr ""

#. Occurrence 7_EX:2210:10105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0011; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2210
msgctxt "text_id=10105 | speaker=soujuurou"
msgid "「いや、別に悩みとかそういうんじゃなくて。不思議なコトがあったというか、珍しいものを見たというか……」"
msgstr ""

#. Occurrence 7_EX:2262:10106: scene=7_EX
#: 7_EX:2262
msgctxt "text_id=10106 | speaker=unknown"
msgid "　どう説明するべきか考えながら、草十郎は用件だけを口にした。"
msgstr ""

#. Occurrence 7_EX:2267:10107: scene=7_EX
#: 7_EX:2267
msgctxt "text_id=10107 | speaker=unknown"
msgid "　まっどべあには何の問題もない。"
msgstr ""

#. Occurrence 7_EX:2272:10108: scene=7_EX
#: 7_EX:2272
msgctxt "text_id=10108 | speaker=unknown"
msgid "　商店街の<魚達|ウオタツ>と同じぐらい好い職場だ。"
msgstr ""

#. Occurrence 7_EX:2277:10109: scene=7_EX
#: 7_EX:2277
msgctxt "text_id=10109 | speaker=unknown"
msgid "　そういった仕事の話とはまったく関係なく、"
msgstr ""

#. Occurrence 7_EX:2282:10110: scene=7_EX
#: 7_EX:2282
msgctxt "text_id=10110 | speaker=unknown"
msgid "　最近、青い鳥によくつっつかれるのだと。"
msgstr ""

#. Occurrence 7_EX:2320:10111: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0007; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2320
msgctxt "text_id=10111 | speaker=kojika"
msgid "「鳥につっつかれる？　なにそれ、小さい悩み。"
msgstr ""

#. Occurrence 7_EX:2326:10112: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0008; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2326
msgctxt "text_id=10112 | speaker=kojika"
msgid "　……でもまあ、青い鳥っていうのは確かに珍しいわね」"
msgstr ""

#. Occurrence 7_EX:2332:10113: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0012; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2332
msgctxt "text_id=10113 | speaker=soujuurou"
msgid "「いや、珍しいのは外見の話じゃなくて……」"
msgstr ""

#. Occurrence 7_EX:2338:10114: scene=7_EX
#: 7_EX:2338
msgctxt "text_id=10114 | speaker=unknown"
msgid "　うまく説明できず言いよどむ。"
msgstr ""

#. Occurrence 7_EX:2380:10115: scene=7_EX
#: 7_EX:2380
msgctxt "text_id=10115 | speaker=unknown"
msgid "　あの青い鳥の、でっぷりとした外見や鳴き声を、人語でどう表現したものだろうか？"
msgstr ""

#. Occurrence 7_EX:2427:10116: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0009; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2427
msgctxt "text_id=10116 | speaker=kojika"
msgid "「……ふーん。綺麗な青色といったらマウンテンブルーバードだけど、日本にはいないわよね。"
msgstr ""

#. Occurrence 7_EX:2433:10117: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0010; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2433
msgctxt "text_id=10117 | speaker=kojika"
msgid "　青いツバメだったらいるかもしれないけど」"
msgstr ""

#. Occurrence 7_EX:2444:10118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0013; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2444
msgctxt "text_id=10118 | speaker=soujuurou"
msgid "「いや、ツバメじゃなくて、丸っこいんだ。図鑑で調べたんだけど、どうもコマドリっぽい。けど」"
msgstr ""

#. Occurrence 7_EX:2471:10119: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0011; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2471
msgctxt "text_id=10119 | speaker=kojika"
msgid "「うん、青色のコマドリは存在しない。"
msgstr ""

#. Occurrence 7_EX:2483:10120: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0012; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2483
msgctxt "text_id=10120 | speaker=kojika"
msgid "　……静希は縁日の青ひよこって知ってる？　知らないわよね。いい、そう面白い話じゃないから忘れて。"
msgstr ""

#. Occurrence 7_EX:2489:10121: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0013; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2489
msgctxt "text_id=10121 | speaker=kojika"
msgid "　それより、そのコマドリって一羽だけなの？」"
msgstr ""

#. Occurrence 7_EX:2524:10122: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0014; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2524
msgctxt "text_id=10122 | speaker=soujuurou"
msgid "「ああ、一羽だけだ。つがいは見あたらない」"
msgstr ""

#. Occurrence 7_EX:2545:10123: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0014; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2545
msgctxt "text_id=10123 | speaker=kojika"
msgid "「ふーん。突然変異だとしたらちょっと可哀想ね。"
msgstr ""

#. Occurrence 7_EX:2551:10124: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0015; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2551
msgctxt "text_id=10124 | speaker=kojika"
msgid "　……生まれた時から最後の一羽だなんて、孤独にもほどがあるわ。"
msgstr ""

#. Occurrence 7_EX:2563:10125: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0016; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2563
msgctxt "text_id=10125 | speaker=kojika"
msgid "　どんな鳥かは知らないけど、次に見かけたら優しくしてあげたら？　自販機で十円を拾う、ぐらいの幸運は運んでくれるかもよ」"
msgstr ""

#. Occurrence 7_EX:2601:10126: scene=7_EX
#: 7_EX:2601
msgctxt "text_id=10126 | speaker=unknown"
msgid "　久万梨の言い分は優しさあふれるものだが、あの駒鳥につっつかれる草十郎としては、何とも頷きがたいものだった。"
msgstr ""

#. Occurrence 7_EX:2606:10127: scene=7_EX
#: 7_EX:2606
msgctxt "text_id=10127 | speaker=unknown"
msgid "　そもそも孤独なんて、あの駒鳥にもっとも似合わない表現ではないだろうか？"
msgstr ""

#. Occurrence 7_EX:2643:10128: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0017; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2643
msgctxt "text_id=10128 | speaker=kojika"
msgid "「いいじゃない、小鳥一羽ぐらい。"
msgstr ""

#. Occurrence 7_EX:2649:10129: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0018; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2649
msgctxt "text_id=10129 | speaker=kojika"
msgid "　そりゃ都会で鳥につつかれるのは珍しいけど、いい方の珍事よ、それ。これがゴミ袋をあさるカラスの大軍だったら困りものでしょうけど」"
msgstr ""

#. Occurrence 7_EX:2669:10130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0015; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2669
msgctxt "text_id=10130 | speaker=soujuurou"
msgid "「あ。そういえば、他にも気になる事が」"
msgstr ""

#. Occurrence 7_EX:2689:10131: scene=7_EX
#: 7_EX:2689
msgctxt "text_id=10131 | speaker=unknown"
msgid "　久万梨の言葉から、草十郎は久遠寺邸・とり集団失踪事件を思い出した。"
msgstr ""

#. Occurrence 7_EX:2694:10132: scene=7_EX
#: 7_EX:2694
msgctxt "text_id=10132 | speaker=unknown"
msgid "　あの鳥たちも不思議と言えば不思議すぎる。"
msgstr ""

#. Occurrence 7_EX:2761:10133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0016; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2761
msgctxt "text_id=10133 | speaker=soujuurou"
msgid "「実は今、あそこに見える丘に住んでるんだけど。"
msgstr ""

#. Occurrence 7_EX:2767:10134: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0017; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2767
msgctxt "text_id=10134 | speaker=soujuurou"
msgid "　でるんだ、大量のムクドリが頻繁に。そのクセ、街に出ると見かけない」"
msgstr ""

#. Occurrence 7_EX:2788:10135: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0019; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2788
msgctxt "text_id=10135 | speaker=kojika"
msgid "「当たり前でしょ。町じゃ鳥なんて見かけないし、あそこは山だから動物は多いんじゃない？"
msgstr ""

#. Occurrence 7_EX:2821:10136: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0020; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2821
msgctxt "text_id=10136 | speaker=kojika"
msgid "　それより貴方、あの山に引っ越したの？　前のアパートは引き払ったって聞いてたけど。……学校まで通うの、大変じゃない。なんだってあんな<辺鄙|へんぴ>なところに」"
msgstr ""

#. Occurrence 7_EX:2857:10137: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0018; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2857
msgctxt "text_id=10137 | speaker=soujuurou"
msgid "「ちょっとした成り行きだよ。それに通うのは大変じゃない。大変なのは中の話なんだ」"
msgstr ""

#. Occurrence 7_EX:2868:10138: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0021; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2868
msgctxt "text_id=10138 | speaker=kojika"
msgid "「？」"
msgstr ""

#. Occurrence 7_EX:2873:10139: scene=7_EX
#: 7_EX:2873
msgctxt "text_id=10139 | speaker=unknown"
msgid "　街に出るまで徒歩三十分。"
msgstr ""

#. Occurrence 7_EX:2878:10140: scene=7_EX
#: 7_EX:2878
msgctxt "text_id=10140 | speaker=unknown"
msgid "　近場のコンビニエンスストアまで四十分はかかる立地条件だが、草十郎にとって交通の不便さはそう問題ではない。"
msgstr ""

#. Occurrence 7_EX:2883:10141: scene=7_EX
#: 7_EX:2883
msgctxt "text_id=10141 | speaker=unknown"
msgid "　問題は住んでいる建物の人外魔境っぷりである。"
msgstr ""

#. Occurrence 7_EX:2920:10142: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0019; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2920
msgctxt "text_id=10142 | speaker=soujuurou"
msgid "「すまない、それは久万梨に話すことじゃなかった。"
msgstr ""

#. Occurrence 7_EX:2932:10143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0020; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2932
msgctxt "text_id=10143 | speaker=soujuurou"
msgid "　それより今の話だ。町には鳥が少ないと言ったけど、どうして？」"
msgstr ""

#. Occurrence 7_EX:2958:10144: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0022; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2958
msgctxt "text_id=10144 | speaker=kojika"
msgid "「……たんに、環境に適応できなかったのよ。"
msgstr ""

#. Occurrence 7_EX:2982:10145: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0023; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2982
msgctxt "text_id=10145 | speaker=kojika"
msgid "　なに、鳥の話には随分と食いつくわね。静希、動物好き？」"
msgstr ""

#. Occurrence 7_EX:3001:10146: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0021; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3001
msgctxt "text_id=10146 | speaker=soujuurou"
msgid "「どちらかというと好きな方だけど」"
msgstr ""

#. Occurrence 7_EX:3022:10147: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0024; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3022
msgctxt "text_id=10147 | speaker=kojika"
msgid "「そ。わたしは嫌い。そんなわたしに鳥の話とかしてほしい？」"
msgstr ""

#. Occurrence 7_EX:3072:10148: scene=7_EX
#: 7_EX:3072
msgctxt "text_id=10148 | speaker=unknown"
msgid "　久万梨の言葉は矛盾に満ちている。"
msgstr ""

#. Occurrence 7_EX:3077:10149: scene=7_EX
#: 7_EX:3077
msgctxt "text_id=10149 | speaker=unknown"
msgid "　動物嫌いという彼女が、なぜ先ほど“鳥には優しく”と口にしたのか。"
msgstr ""

#. Occurrence 7_EX:3112:10150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0022; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3112
msgctxt "text_id=10150 | speaker=soujuurou"
msgid "「そうだな。嫌いなだけで苦手でないのなら、知ってる範囲で聞かせてほしい」"
msgstr ""

#. Occurrence 7_EX:3133:10151: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0025; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3133
msgctxt "text_id=10151 | speaker=kojika"
msgid "「痛いトコつくじゃない。"
msgstr ""

#. Occurrence 7_EX:3162:10152: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0026; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3162
msgctxt "text_id=10152 | speaker=kojika"
msgid "　いいわ、バイトまでの時間つぶしにしてあげる。"
msgstr ""

#. Occurrence 7_EX:3168:10153: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0027; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3168
msgctxt "text_id=10153 | speaker=kojika"
msgid "　さっきの続き。環境に適応できるかできないかってところからね」"
msgstr ""

#. Occurrence 7_EX:3221:10154: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0028; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3221
msgctxt "text_id=10154 | speaker=kojika"
msgid "「今でこそこんなだけど、三咲はここまで大きな町じゃなかったんだって。"
msgstr ""

#. Occurrence 7_EX:3227:10155: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0029; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3227
msgctxt "text_id=10155 | speaker=kojika"
msgid "　昔はその半分が森だったから、彼らはもともと森に適した生活をしていたのよ」"
msgstr ""

#. Occurrence 7_EX:3247:10156: scene=7_EX
#: 7_EX:3247
msgctxt "text_id=10156 | speaker=unknown"
msgid "　久万梨は鳥たちを「彼ら」と呼んだ。"
msgstr ""

#. Occurrence 7_EX:3252:10157: scene=7_EX
#: 7_EX:3252
msgctxt "text_id=10157 | speaker=unknown"
msgid "　好きか嫌いかはともかく、鳥たちに敬意を払っている証だろう。"
msgstr ""

#. Occurrence 7_EX:3286:10158: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0030; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3286
msgctxt "text_id=10158 | speaker=kojika"
msgid "「でも近代化した街じゃ自然のサイクルも成り立たない。人間ってのは、まず環境を自分たちの都合に変えるから。"
msgstr ""

#. Occurrence 7_EX:3292:10159: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0031; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3292
msgctxt "text_id=10159 | speaker=kojika"
msgid "　<藪蚊|やぶか>が多いって事で小さな川の流れを変えたり、町中コンクリートで塗り固めちゃえば鳥的にはお手上げよ。"
msgstr ""

#. Occurrence 7_EX:3298:10160: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0032; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3298
msgctxt "text_id=10160 | speaker=kojika"
msgid "　虫も森も少ないんじゃもう山に逃げるしかない。彼らは故郷を追われて、この森から山に移った。"
msgstr ""

#. Occurrence 7_EX:3304:10161: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0033; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3304
msgctxt "text_id=10161 | speaker=kojika"
msgid "　人間にとって都合のいい町は、鳥たちが生きるコロニーにはなり得ないから」"
msgstr ""

#. Occurrence 7_EX:3345:10162: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0023; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3345
msgctxt "text_id=10162 | speaker=soujuurou"
msgid "「……そんな事ぐらいで減るものか？"
msgstr ""

#. Occurrence 7_EX:3351:10163: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0024; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3351
msgctxt "text_id=10163 | speaker=soujuurou"
msgid "　その、姿を見なくなるぐらいに？」"
msgstr ""

#. Occurrence 7_EX:3362:10164: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0034; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3362
msgctxt "text_id=10164 | speaker=kojika"
msgid "「そこまで極端じゃない……とは思う。現に貴方だってムクドリを見てるでしょう？"
msgstr ""

#. Occurrence 7_EX:3368:10165: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0035; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3368
msgctxt "text_id=10165 | speaker=kojika"
msgid "　比較の問題よ。町には人間が多いから、鳥の姿はよけい稀少に感じるだけ。たまに見かけるだけで、珍しいと思えるぐらいにね」"
msgstr ""

#. Occurrence 7_EX:3403:10166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0025; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3403
msgctxt "text_id=10166 | speaker=soujuurou"
msgid "「ああ、たしかに。じゃあ鳥は町から居なくなっただけで、あの山に移り住んで―――」"
msgstr ""

#. Occurrence 7_EX:3409:10167: scene=7_EX
#: 7_EX:3409
msgctxt "text_id=10167 | speaker=unknown"
msgid "　目立たないだけで、きちんと今も生き続けている。"
msgstr ""

#. Occurrence 7_EX:3414:10168: scene=7_EX
#: 7_EX:3414
msgctxt "text_id=10168 | speaker=unknown"
msgid "　時代と共に、その在り方、カタチは変わっても、まったくの無に帰する事はない。"
msgstr ""

#. Occurrence 7_EX:3419:10169: scene=7_EX
#: 7_EX:3419
msgctxt "text_id=10169 | speaker=unknown"
msgid "　そう安心して気を取り直す草十郎を、久万梨は冷めた顔で否定した。"
msgstr ""

#. Occurrence 7_EX:3453:10170: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0036; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3453
msgctxt "text_id=10170 | speaker=kojika"
msgid "「あの山に天敵がいなければね。"
msgstr ""

#. Occurrence 7_EX:3459:10171: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0037; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3459
msgctxt "text_id=10171 | speaker=kojika"
msgid "　人間の手による<乱獲|らんかく>か、移った先にいる生態系との衝突か。どちらにせよ、居場所を失った彼らの寿命は短いと思う。一世紀持てばいい方かもしれない。"
msgstr ""

#. Occurrence 7_EX:3465:10172: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0038; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3465
msgctxt "text_id=10172 | speaker=kojika"
msgid "　……リョコウバトの例もあるし。気が付いた時には取り返しつかないのが動物と人間の関係よ」"
msgstr ""

#. Occurrence 7_EX:3500:10173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0026; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3500
msgctxt "text_id=10173 | speaker=soujuurou"
msgid "「リョコウバト……？」"
msgstr ""

#. Occurrence 7_EX:3517:10174: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0039; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3517
msgctxt "text_id=10174 | speaker=kojika"
msgid "「そ、リョコウバト。体長は四十センチほどもある、大型のきれいな鳥。"
msgstr ""

#. Occurrence 7_EX:3523:10175: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0040; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3523
msgctxt "text_id=10175 | speaker=kojika"
msgid "　オスの翼は深い青色で、胸は鮮やかな<臙脂|えんじ>色。オレンジ色の目は嘘みたいに愛らしくて、その羽は時速百キロで長い距離を旅するの」"
msgstr ""

#. Occurrence 7_EX:3543:10176: scene=7_EX
#: 7_EX:3543
msgctxt "text_id=10176 | speaker=unknown"
msgid "　久万梨の声は、少しだけ優しい。"
msgstr ""

#. Occurrence 7_EX:3548:10177: scene=7_EX
#: 7_EX:3548
msgctxt "text_id=10177 | speaker=unknown"
msgid "　彼女は図鑑でしか観ることのない鳥の姿を、ひとり夢想しているようだった。"
msgstr ""

#. Occurrence 7_EX:3593:10178: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0041; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3593
msgctxt "text_id=10178 | speaker=kojika"
msgid "「北アメリカにいた<鳩|ハト>でね、春は南から北へ、冬は冬越えのために北から南に移動するの。"
msgstr ""

#. Occurrence 7_EX:3599:10179: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0042; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3599
msgctxt "text_id=10179 | speaker=kojika"
msgid "　今から百年以上も前の話よ。"
msgstr ""

#. Occurrence 7_EX:3605:10180: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0043; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3605
msgctxt "text_id=10180 | speaker=kojika"
msgid "　彼らはかつて地上でもっとも繁殖した高等動物だった。"
msgstr ""

#. Occurrence 7_EX:3611:10181: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0044; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3611
msgctxt "text_id=10181 | speaker=kojika"
msgid "　なにしろその数は五十億。当時の総人口より多かったっていうんだから、圧巻よね」"
msgstr ""

#. Occurrence 7_EX:3645:10182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0027; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3645
msgctxt "text_id=10182 | speaker=soujuurou"
msgid "「なんと。人間より数の多い動物がいたっていうのか？」"
msgstr ""

#. Occurrence 7_EX:3667:10183: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0045; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3667
msgctxt "text_id=10183 | speaker=kojika"
msgid "「うん。でも彼らは絶滅したわ。他ならぬ人間の手によって。"
msgstr ""

#. Occurrence 7_EX:3673:10184: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0046; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3673
msgctxt "text_id=10184 | speaker=kojika"
msgid "　１６世紀にヨーロッパからアメリカ大陸にやってきた探検家たちは、空を覆いつくすほどの鳥の群を見た。"
msgstr ""

#. Occurrence 7_EX:3679:10185: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0047; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3679
msgctxt "text_id=10185 | speaker=kojika"
msgid "　それがリョコウバトを<記|しる>した、一番古くて確かな記録」"
msgstr ""

#. Occurrence 7_EX:3714:10186: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0048; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3714
msgctxt "text_id=10186 | speaker=kojika"
msgid "「……まあ、わたしも本で知った知識だけど。"
msgstr ""

#. Occurrence 7_EX:3720:10187: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0049; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3720
msgctxt "text_id=10187 | speaker=kojika"
msgid "　太陽を隠して、そのおびただしい数で森を覆って、雪のように糞を落としていく光景なんて、今じゃもう夢物語でしょうね。"
msgstr ""

#. Occurrence 7_EX:3726:10188: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0050; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3726
msgctxt "text_id=10188 | speaker=kojika"
msgid "　でも当時の人にとっては悪夢だった。"
msgstr ""

#. Occurrence 7_EX:3732:10189: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0051; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3732
msgctxt "text_id=10189 | speaker=kojika"
msgid "　リョコウバト一羽一羽は美しいフォルムをしていても、それだけの数が集まれば、それはもう暴力なんだから」"
msgstr ""

#. Occurrence 7_EX:3766:10190: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0052; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3766
msgctxt "text_id=10190 | speaker=kojika"
msgid "「彼らはその時点では、森を破壊し、人間を脅かす悪魔のような存在だった。"
msgstr ""

#. Occurrence 7_EX:3772:10191: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0053; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3772
msgctxt "text_id=10191 | speaker=kojika"
msgid "　営巣地は十キロメートルにまでおよんで、一コロニーにつき五万羽近い鳥の鳴き声が響いたのよ。"
msgstr ""

#. Occurrence 7_EX:3778:10192: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0054; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3778
msgctxt "text_id=10192 | speaker=kojika"
msgid "　一瞬にして風景を変えるほどの鳥の群れと、世界を覆うほどの鳴き声。冒険家たちが<竦|すく>んだのもうなずけるわね」"
msgstr ""

#. Occurrence 7_EX:3814:10193: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0028; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3814
msgctxt "text_id=10193 | speaker=soujuurou"
msgid "「一つの住み処に五万羽―――」"
msgstr ""

#. Occurrence 7_EX:3820:10194: scene=7_EX
#: 7_EX:3820
msgctxt "text_id=10194 | speaker=unknown"
msgid "　草十郎は指折り数えながら絶句した。"
msgstr ""

#. Occurrence 7_EX:3825:10195: scene=7_EX
#: 7_EX:3825
msgctxt "text_id=10195 | speaker=unknown"
msgid "　駅前の人の流れだけで手一杯な彼では、想像が追いつかないらしい。"
msgstr ""

#. Occurrence 7_EX:3851:10196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0029; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3851
msgctxt "text_id=10196 | speaker=soujuurou"
msgid "「でも、そんな数の鳥を、人間の手でどうやって？」"
msgstr ""

#. Occurrence 7_EX:3862:10197: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0055; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3862
msgctxt "text_id=10197 | speaker=kojika"
msgid "「ええ。当時、誰もがそう思ったんでしょうね。"
msgstr ""

#. Occurrence 7_EX:3868:10198: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0056; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3868
msgctxt "text_id=10198 | speaker=kojika"
msgid "　でも話は簡単だったの。人間にとってリョコウバトは脅威でもあったけど、同時に安価な<実|みの>りでもあったから」"
msgstr ""

#. Occurrence 7_EX:3904:10199: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0057; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3904
msgctxt "text_id=10199 | speaker=kojika"
msgid "「渡り鳥の胸肉は美味しいでしょ。よく鍛えられてるから。"
msgstr ""

#. Occurrence 7_EX:3910:10200: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0058; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3910
msgctxt "text_id=10200 | speaker=kojika"
msgid "　そんな食材が、空に向かって鉄砲を撃つだけでバタバタと落ちてきたとしたら、貴方はどうする？"
msgstr ""

#. Occurrence 7_EX:3916:10201: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0059; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3916
msgctxt "text_id=10201 | speaker=kojika"
msgid "　ま―――身もフタもないコトを言えば、リョコウバトって鳥は、簡単にお金にできる生き物だった」"
msgstr ""

#. Occurrence 7_EX:3965:10202: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0060; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3965
msgctxt "text_id=10202 | speaker=kojika"
msgid "「かくして、狩りは延々と続けられた。"
msgstr ""

#. Occurrence 7_EX:3971:10203: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0061; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3971
msgctxt "text_id=10203 | speaker=kojika"
msgid "　落ちた鳥は羽をむしられて、塩漬けのタルにおしこまれて、次々と出荷された」"
msgstr ""

#. Occurrence 7_EX:3992:10204: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0062; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3992
msgctxt "text_id=10204 | speaker=kojika"
msgid "「それはもう狩りですらなかった。ただの消費。人間側は労働の実感も、作業の手間すら感じなくなっていた。"
msgstr ""

#. Occurrence 7_EX:3998:10205: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0063; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3998
msgctxt "text_id=10205 | speaker=kojika"
msgid "　その頃、リョコウバトは一羽一セントで手に入れる事が出来たんだって。ここでいうならたった一円。"
msgstr ""

#. Occurrence 7_EX:4004:10206: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0064; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4004
msgctxt "text_id=10206 | speaker=kojika"
msgid "　―――ほんと、信じられる？"
msgstr ""

#. Occurrence 7_EX:4010:10207: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0065; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4010
msgctxt "text_id=10207 | speaker=kojika"
msgid "　その国最小の通貨一枚で売買される命が、この地球にはあったなんて」"
msgstr ""

#. Occurrence 7_EX:4061:10208: scene=7_EX
#: 7_EX:4061
msgctxt "text_id=10208 | speaker=unknown"
msgid "　久万梨はあくまで他人事のように語る。"
msgstr ""

#. Occurrence 7_EX:4066:10209: scene=7_EX
#: 7_EX:4066
msgctxt "text_id=10209 | speaker=unknown"
msgid "　……なのに、声にかすかな翳りがあるのは、鳥たちへの謝罪か、同種への嫌悪からか。"
msgstr ""

#. Occurrence 7_EX:4071:10210: scene=7_EX
#: 7_EX:4071
msgctxt "text_id=10210 | speaker=unknown"
msgid "　どちらにせよ人間らしい、身勝手な<諧謔|かいぎゃく>だ。"
msgstr ""

#. Occurrence 7_EX:4076:10211: scene=7_EX
#: 7_EX:4076
msgctxt "text_id=10211 | speaker=unknown"
msgid "　一方。そんな人間らしさを、草十郎はまだ理解できないでいる。"
msgstr ""

#. Occurrence 7_EX:4115:10212: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0066; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4115
msgctxt "text_id=10212 | speaker=kojika"
msgid "「けど、それはまだまだ序の口で、本番は１９世紀に入ってからだった。"
msgstr ""

#. Occurrence 7_EX:4121:10213: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0067; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4121
msgctxt "text_id=10213 | speaker=kojika"
msgid "　人間のリョコウバト狩りはますます熱狂していった。"
msgstr ""

#. Occurrence 7_EX:4127:10214: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0068; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4127
msgctxt "text_id=10214 | speaker=kojika"
msgid "　学校で習ったでしょ。ゴールドラッシュ、南北戦争を経て、アメリカ合衆国は急激に成長していく。"
msgstr ""

#. Occurrence 7_EX:4133:10215: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0069; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4133
msgctxt "text_id=10215 | speaker=kojika"
msgid "　西欧からの移民は増え続け、１８７０年には４０００万もの人口に達していたわ。そんな移民たちの胃袋と財布を満たす材料として、リョコウバトは最高の獲物だった」"
msgstr ""

#. Occurrence 7_EX:4175:10216: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0070; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4175
msgctxt "text_id=10216 | speaker=kojika"
msgid "「で、もっと最悪な事に、人間は工夫する生き物だった。"
msgstr ""

#. Occurrence 7_EX:4181:10217: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0071; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4181
msgctxt "text_id=10217 | speaker=kojika"
msgid "　彼らはより速く、より多く、より簡単にリョコウバトを乱獲する手段を競い合った。"
msgstr ""

#. Occurrence 7_EX:4187:10218: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0072; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4187
msgctxt "text_id=10218 | speaker=kojika"
msgid "　目を潰したハトを囮にして集団を誘いこんで、一日で一万羽以上捕らえたヤツさえいた。それでも彼らは乱獲に疑問すら持たなかった。"
msgstr ""

#. Occurrence 7_EX:4193:10219: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0073; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4193
msgctxt "text_id=10219 | speaker=kojika"
msgid "　―――繁殖と狩猟のバランスは、誰が見ても明らかに狂っていたのに」"
msgstr ""

#. Occurrence 7_EX:4242:10220: scene=7_EX
#: 7_EX:4242
msgctxt "text_id=10220 | speaker=unknown"
msgid "　淡々と、努めて冷静でいるように淡々と、久万梨は語る。"
msgstr ""

#. Occurrence 7_EX:4247:10221: scene=7_EX
#: 7_EX:4247
msgctxt "text_id=10221 | speaker=unknown"
msgid "　一方、草十郎はただ感心するばかりだった。"
msgstr ""

#. Occurrence 7_EX:4252:10222: scene=7_EX
#: 7_EX:4252
msgctxt "text_id=10222 | speaker=unknown"
msgid "　山育ちである草十郎からすれば気持ちのいい話ではないのに、今は、「どうしてそうなったのか」という疑問の方が強いらしい。"
msgstr ""

#. Occurrence 7_EX:4279:10223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0030; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4279
msgctxt "text_id=10223 | speaker=soujuurou"
msgid "「それ、一方的すぎないか？　リョコウバトだって数が減ってくれば、人間には近寄らないんじゃ」"
msgstr ""

#. Occurrence 7_EX:4290:10224: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0074; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4290
msgctxt "text_id=10224 | speaker=kojika"
msgid "「そこが彼らの不幸だったのよ。"
msgstr ""

#. Occurrence 7_EX:4296:10225: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0075; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4296
msgctxt "text_id=10225 | speaker=kojika"
msgid "　リョコウバトは繁殖力が非常に弱くて、自衛手段を持たない鳥だった。大群で暮らすこと。それだけが、彼らの身を守る手段だったの」"
msgstr ""

#. Occurrence 7_EX:4330:10226: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0076; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4330
msgctxt "text_id=10226 | speaker=kojika"
msgid "「彼らが五十億の王国を築けたのは、それまで天敵がいなかったからなんでしょうね。先住民であるインディアンも彼らを乱獲する事はなかったと言うし。"
msgstr ""

#. Occurrence 7_EX:4336:10227: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0077; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4336
msgctxt "text_id=10227 | speaker=kojika"
msgid "　けど入植者たちは自然のサイクルにはてんで<疎|うと>かった。"
msgstr ""

#. Occurrence 7_EX:4342:10228: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0078; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4342
msgctxt "text_id=10228 | speaker=kojika"
msgid "　何より、あの<夥|おびただ>しい数の鳥が絶滅するなんて夢にも思わなかった。"
msgstr ""

#. Occurrence 7_EX:4348:10229: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0079; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4348
msgctxt "text_id=10229 | speaker=kojika"
msgid "　リョコウバトにしたら青天の霹靂よ。まさか何世紀も遅れて、海の向こうから天敵がやってくるなんて」"
msgstr ""

#. Occurrence 7_EX:4382:10230: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0080; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4382
msgctxt "text_id=10230 | speaker=kojika"
msgid "「そうして１８９６年。人間はようやく、熱狂を覚ますほどの現実に直面したわ。"
msgstr ""

#. Occurrence 7_EX:4388:10231: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0081; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4388
msgctxt "text_id=10231 | speaker=kojika"
msgid "　たったの２５万羽。"
msgstr ""

#. Occurrence 7_EX:4394:10232: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0082; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4394
msgctxt "text_id=10232 | speaker=kojika"
msgid "　それが確認されたリョコウバトの総数。何もかも手遅れよ。急いで保護法が作られたけど、人間の習慣はそう簡単には変わらないわ」"
msgstr ""

#. Occurrence 7_EX:4424:10233: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0083; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4424
msgctxt "text_id=10233 | speaker=kojika"
msgid "「あるいは、狩人たちはこう思ったのかもしれない。"
msgstr ""

#. Occurrence 7_EX:4430:10234: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0084; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4430
msgctxt "text_id=10234 | speaker=kojika"
msgid "　<ま|・><だ|・><２|・><５|・><万|・><羽|・><も|・><い|・><る|・><じ|・><ゃ|・><な|・><い|・><か|・>、千羽や二千羽ぐらいなら独り占めしても構わないだろう、って」"
msgstr ""

#. Occurrence 7_EX:4451:10235: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0085; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4451
msgctxt "text_id=10235 | speaker=kojika"
msgid "「そうしてハンターたちは当時最新の技術―――電報でリョコウバトたちの所在を報せあって、実に２０万羽のリョコウバトを仕留め、４万羽を傷つけた。"
msgstr ""

#. Occurrence 7_EX:4457:10236: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0086; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4457
msgctxt "text_id=10236 | speaker=kojika"
msgid "　生き延びたのは５０００羽だけ。この時点で、彼らは野生で生きられる種ではなくなったのよ」"
msgstr ""

#. Occurrence 7_EX:4489:10237: scene=7_EX
#: 7_EX:4489
msgctxt "text_id=10237 | speaker=unknown"
msgid "　草十郎は顔をしかめている。"
msgstr ""

#. Occurrence 7_EX:4494:10238: scene=7_EX
#: 7_EX:4494
msgctxt "text_id=10238 | speaker=unknown"
msgid "“野生で生きられる種ではない。”"
msgstr ""

#. Occurrence 7_EX:4499:10239: scene=7_EX
#: 7_EX:4499
msgctxt "text_id=10239 | speaker=unknown"
msgid "　その言葉の意味を、彼は言われるまでもなく知っているからだ。"
msgstr ""

#. Occurrence 7_EX:4519:10240: scene=7_EX
#: 7_EX:4519
msgctxt "text_id=10240 | speaker=unknown"
msgid "　野生動物は単体で生き続けるものではない。"
msgstr ""

#. Occurrence 7_EX:4524:10241: scene=7_EX
#: 7_EX:4524
msgctxt "text_id=10241 | speaker=unknown"
msgid "　全体の数と、それを支える餌場を一定数維持できなければ、存続する事ができない。"
msgstr ""

#. Occurrence 7_EX:4529:10242: scene=7_EX
#: 7_EX:4529
msgctxt "text_id=10242 | speaker=unknown"
msgid "　<大|・><群|・><で|・><あ|・><る|・><事|・>がリョコウバトのシステムであったのなら、もうその時点で、彼らは袋小路に入っていた。"
msgstr ""

#. Occurrence 7_EX:4555:10243: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0031; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4555
msgctxt "text_id=10243 | speaker=soujuurou"
msgid "「それで、リョコウバトはどうなったんだ？」"
msgstr ""

#. Occurrence 7_EX:4575:10244: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0087; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4575
msgctxt "text_id=10244 | speaker=kojika"
msgid "「最後に保護されたリョコウバトはたったの三羽。"
msgstr ""

#. Occurrence 7_EX:4581:10245: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0088; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4581
msgctxt "text_id=10245 | speaker=kojika"
msgid "　シンシナティの動物園ではオス二羽、メス一羽のリョコウバトが飼育されたけど、一年でオスたちは死んじゃったわ。"
msgstr ""

#. Occurrence 7_EX:4587:10246: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0089; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4587
msgctxt "text_id=10246 | speaker=kojika"
msgid "　残されたのはメス一羽だけ。"
msgstr ""

#. Occurrence 7_EX:4593:10247: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0090; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4593
msgctxt "text_id=10247 | speaker=kojika"
msgid "　その時点で、彼女は地上でもっとも孤独な生き物になった」"
msgstr ""

#. Occurrence 7_EX:4614:10248: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0091; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4614
msgctxt "text_id=10248 | speaker=kojika"
msgid "「名前はマーサ。"
msgstr ""

#. Occurrence 7_EX:4620:10249: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0092; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4620
msgctxt "text_id=10249 | speaker=kojika"
msgid "　北アメリカを旅する鳥たちの最後の一羽でありながら、ただの一度も空を飛ぶ事ができなかった<籠|かご>の鳥。"
msgstr ""

#. Occurrence 7_EX:4626:10250: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0093; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4626
msgctxt "text_id=10250 | speaker=kojika"
msgid "　結局、２９年で彼女はその命を終えたわ。"
msgstr ""

#. Occurrence 7_EX:4632:10251: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0094; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4632
msgctxt "text_id=10251 | speaker=kojika"
msgid "　１９１４年９月１日午後１時。"
msgstr ""

#. Occurrence 7_EX:4638:10252: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0095; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4638
msgctxt "text_id=10252 | speaker=kojika"
msgid "　一つの種が終わる時間がここまで正確に残っている例は、今のところこれだけよ」"
msgstr ""

#. Occurrence 7_EX:4684:10253: scene=7_EX
#: 7_EX:4684
msgctxt "text_id=10253 | speaker=unknown"
msgid "　……五十億の死にまつわる話は終わった。"
msgstr ""

#. Occurrence 7_EX:4689:10254: scene=7_EX
#: 7_EX:4689
msgctxt "text_id=10254 | speaker=unknown"
msgid "　文明に飲みこまれた鳥の末路。"
msgstr ""

#. Occurrence 7_EX:4694:10255: scene=7_EX
#: 7_EX:4694
msgctxt "text_id=10255 | speaker=unknown"
msgid "　失われた鳥たちへの哀歌のような久万梨の話は、しかし、草十郎にはあまり伝わらなかったようだ。"
msgstr ""

#. Occurrence 7_EX:4724:10256: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0096; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4724
msgctxt "text_id=10256 | speaker=kojika"
msgid "「意外。できるだけ詩的に語ったつもりだけど、ウケ、悪いみたい。"
msgstr ""

#. Occurrence 7_EX:4731:10257: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0097; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4731
msgctxt "text_id=10257 | speaker=kojika"
msgid "山育ちの貴方には<憤慨|ふんがい>ものの話だと思ったのに」"
msgstr ""

#. Occurrence 7_EX:4748:10258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0032; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4748
msgctxt "text_id=10258 | speaker=soujuurou"
msgid "「え―――いや、すごい話だったけど。"
msgstr ""

#. Occurrence 7_EX:4754:10259: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0033; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4754
msgctxt "text_id=10259 | speaker=soujuurou"
msgid "　その、整理がつかなくて。当時の人たちは自分たちの手で減らしておいたのに、なんで最後は保護したのかって」"
msgstr ""

#. Occurrence 7_EX:4786:10260: scene=7_EX
#: 7_EX:4786
msgctxt "text_id=10260 | speaker=unknown"
msgid "　その呟きを聞いて、久万梨はきょとんと眉を上げた。"
msgstr ""

#. Occurrence 7_EX:4791:10261: scene=7_EX
#: 7_EX:4791
msgctxt "text_id=10261 | speaker=unknown"
msgid "　おそらく、草十郎はこう言いたかったのだ。"
msgstr ""

#. Occurrence 7_EX:4797:10262: scene=7_EX
#: 7_EX:4797
msgctxt "text_id=10262 | speaker=unknown"
msgid "“奪うために減らしたのに、なぜ最後の一羽を守ろうとしたのか”と。"
msgstr ""

#. Occurrence 7_EX:4817:10263: scene=7_EX
#: 7_EX:4817
msgctxt "text_id=10263 | speaker=unknown"
msgid "　久万梨が思い違いをしたのも無理はない。"
msgstr ""

#. Occurrence 7_EX:4822:10264: scene=7_EX
#: 7_EX:4822
msgctxt "text_id=10264 | speaker=unknown"
msgid "　都会育ちの彼女には、草十郎の疑問の危うさは理解できない。"
msgstr ""

#. Occurrence 7_EX:4860:10265: scene=7_EX
#: 7_EX:4860
msgctxt "text_id=10265 | speaker=unknown"
msgid "　この少年にはまだ、"
msgstr ""

#. Occurrence 7_EX:4865:10266: scene=7_EX
#: 7_EX:4865
msgctxt "text_id=10266 | speaker=unknown"
msgid "　人間の身勝手な行為への怒りも、"
msgstr ""

#. Occurrence 7_EX:4870:10267: scene=7_EX
#: 7_EX:4870
msgctxt "text_id=10267 | speaker=unknown"
msgid "　<住処|すみか>から移動しなかった鳥たちへの同情もない。"
msgstr ""

#. Occurrence 7_EX:4876:10268: scene=7_EX
#: 7_EX:4876
msgctxt "text_id=10268 | speaker=unknown"
msgid "　そのどちらかに肩入れする<独善|じぶん>を、ここまで育てずに暮らしてきた。"
msgstr ""

#. Occurrence 7_EX:4911:10269: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0098; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4911
msgctxt "text_id=10269 | speaker=kojika"
msgid "「……あいかわらず、よく分かんないヤツ。"
msgstr ""

#. Occurrence 7_EX:4922:10270: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0099; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4922
msgctxt "text_id=10270 | speaker=kojika"
msgid "　ま、わたしが言いたかったのは、どんなに強く美しく見えても、居場所から追われた生き物ははかないってコト。"
msgstr ""

#. Occurrence 7_EX:4933:10271: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0100; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4933
msgctxt "text_id=10271 | speaker=kojika"
msgid "　静希くん。"
msgstr ""

#. Occurrence 7_EX:4939:10272: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0101; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4939
msgctxt "text_id=10272 | speaker=kojika"
msgid "　貴方が見た鳥は、その最後の一羽かもしれないわよ？」"
msgstr ""

#. Occurrence 7_EX:4985:10273: scene=7_EX
#: 7_EX:4985
msgctxt "text_id=10273 | speaker=unknown"
msgid "　……<益体|やくたい>のない立ち話は終わった。"
msgstr ""

#. Occurrence 7_EX:4990:10274: scene=7_EX
#: 7_EX:4990
msgctxt "text_id=10274 | speaker=unknown"
msgid "　アルバイトの時間が近づき、草十郎は一足先にバイト先へ向かっていった。"
msgstr ""

#. Occurrence 7_EX:5014:10275: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0102; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5014
msgctxt "text_id=10275 | speaker=kojika"
msgid "「……らしくない。なに熱く語ってたんだろ、わたし」"
msgstr ""

#. Occurrence 7_EX:5020:10276: scene=7_EX
#: 7_EX:5020
msgctxt "text_id=10276 | speaker=unknown"
msgid "　草十郎と別れた後も、久万梨は公園に留まっていた。"
msgstr ""

#. Occurrence 7_EX:5025:10277: scene=7_EX
#: 7_EX:5025
msgctxt "text_id=10277 | speaker=unknown"
msgid "　マーサ。最後の一羽。"
msgstr ""

#. Occurrence 7_EX:5030:10278: scene=7_EX
#: 7_EX:5030
msgctxt "text_id=10278 | speaker=unknown"
msgid "　そのフレーズは青い鳥にあてられたものではなく―――"
msgstr ""

#. Occurrence 7_EX:5063:10279: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0103; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5063
msgctxt "text_id=10279 | speaker=kojika"
msgid "「やめやめ。珍しいから特別視するとか、バカみたいだし」"
msgstr ""

#. Occurrence 7_EX:5069:10280: scene=7_EX
#: 7_EX:5069
msgctxt "text_id=10280 | speaker=unknown"
msgid "　我が事のように愚痴りながら頭をかく。"
msgstr ""

#. Occurrence 7_EX:5074:10281: scene=7_EX
#: 7_EX:5074
msgctxt "text_id=10281 | speaker=unknown"
msgid "　久万梨からすれば草十郎は赤の他人で、同じクラスの仲間でもない。"
msgstr ""

#. Occurrence 7_EX:5079:10282: scene=7_EX
#: 7_EX:5079
msgctxt "text_id=10282 | speaker=unknown"
msgid "　リョコウバトの話に熱が入ったのは、嫌いなコトの話ほど熱心に調べてしまう彼女の悪癖の結果である。"
msgstr ""

#. Occurrence 7_EX:5104:10283: scene=7_EX
#: 7_EX:5104
msgctxt "text_id=10283 | speaker=unknown"
msgid "　カタチのいい眉をひそめる。"
msgstr ""

#. Occurrence 7_EX:5109:10284: scene=7_EX
#: 7_EX:5109
msgctxt "text_id=10284 | speaker=unknown"
msgid "　まっどべあで働く以上、ヘンな悩みを抱えて欲しくないので話し相手になったが、あるいは、あの少年に妙な磁力があるのだろうか？"
msgstr ""

#. Occurrence 7_EX:5114:10285: scene=7_EX
#: 7_EX:5114
msgctxt "text_id=10285 | speaker=unknown"
msgid "　話せば話すほど深みに<嵌|はま>っている気がする。"
msgstr ""

#. Occurrence 7_EX:5148:10286: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0104; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5148
msgctxt "text_id=10286 | speaker=kojika"
msgid "「まあ、見てて頼りないってのが一番だろうけど……話してみるとしっかりしすぎてるのよね、彼」"
msgstr ""

#. Occurrence 7_EX:5154:10287: scene=7_EX
#: 7_EX:5154
msgctxt "text_id=10287 | speaker=unknown"
msgid "　久万梨はそうぼやきながら、別れ際の会話を思い出した。"
msgstr ""

#. Occurrence 7_EX:5198:10288: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0105; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5198
msgctxt "text_id=10288 | speaker=kojika"
msgid "“で、少しは町に慣れた？”"
msgstr ""

#. Occurrence 7_EX:5204:10289: scene=7_EX
#: 7_EX:5204
msgctxt "text_id=10289 | speaker=unknown"
msgid "　そう訊いた久万梨に、草十郎は頼りなげに首を振った。"
msgstr ""

#. Occurrence 7_EX:5241:10290: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0034; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5241
msgctxt "text_id=10290 | speaker=soujuurou"
msgid "“全然。何にせよ、覚えなくちゃいけない事が多すぎて”"
msgstr ""

#. Occurrence 7_EX:5247:10291: scene=7_EX
#: 7_EX:5247
msgctxt "text_id=10291 | speaker=unknown"
msgid "　日々新しい出会いがあって、それを飲みこむだけで手一杯。"
msgstr ""

#. Occurrence 7_EX:5252:10292: scene=7_EX
#: 7_EX:5252
msgctxt "text_id=10292 | speaker=unknown"
msgid "　あの純朴な少年は弱々しく見えるものの、町のすべてを受け入れようと全力で立っているのだ。"
msgstr ""

#. Occurrence 7_EX:5272:10293: scene=7_EX
#: 7_EX:5272
msgctxt "text_id=10293 | speaker=unknown"
msgid "　しかし―――日々新しい出会いがある、というのは大仰すぎるのではないか。"
msgstr ""

#. Occurrence 7_EX:5277:10294: scene=7_EX
#: 7_EX:5277
msgctxt "text_id=10294 | speaker=unknown"
msgid "　出会ったものを一つも取り落とさないよう努力するのは、彼が素直すぎるからだ。"
msgstr ""

#. Occurrence 7_EX:5303:10295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0035; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5303
msgctxt "text_id=10295 | speaker=soujuurou"
msgid "“どうだろう。素直って言うのはちょっと違うと思うよ。"
msgstr ""

#. Occurrence 7_EX:5309:10296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0036; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5309
msgctxt "text_id=10296 | speaker=soujuurou"
msgid "　単に、それが良いことか悪いことか、まだ分かってないだけかもしれないし”"
msgstr ""

#. Occurrence 7_EX:5315:10297: scene=7_EX
#: 7_EX:5315
msgctxt "text_id=10297 | speaker=unknown"
msgid "　彼はばつが悪そうに返す。"
msgstr ""

#. Occurrence 7_EX:5350:10298: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0106; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5350
msgctxt "text_id=10298 | speaker=kojika"
msgid "“そうね。でも、もしかしたら、そもそも―――”"
msgstr ""

#. Occurrence 7_EX:5356:10299: scene=7_EX
#: 7_EX:5356
msgctxt "text_id=10299 | speaker=unknown"
msgid "　そこまで言いかけて、久万梨はまた今度、と手を振って別れる事にした。"
msgstr ""

#. Occurrence 7_EX:5399:10300: scene=7_EX
#: 7_EX:5399
msgctxt "text_id=10300 | speaker=unknown"
msgid "　思い返すとますますため息がでてきた。"
msgstr ""

#. Occurrence 7_EX:5404:10301: scene=7_EX
#: 7_EX:5404
msgctxt "text_id=10301 | speaker=unknown"
msgid "　コンビニエンスストアのアルバイトまであと五分ほど。"
msgstr ""

#. Occurrence 7_EX:5409:10302: scene=7_EX
#: 7_EX:5409
msgctxt "text_id=10302 | speaker=unknown"
msgid "　久万梨は頬を叩いて先ほどの会話を飲み下す。"
msgstr ""

#. Occurrence 7_EX:5414:10303: scene=7_EX
#: 7_EX:5414
msgctxt "text_id=10303 | speaker=unknown"
msgid "　他人のコトで気を病む余裕も、考察にふける義理もない。"
msgstr ""

#. Occurrence 7_EX:5419:10304: scene=7_EX
#: 7_EX:5419
msgctxt "text_id=10304 | speaker=unknown"
msgid "　彼女は彼女で、大学進学の費用を貯める野望がある。"
msgstr ""

#. Occurrence 7_EX:5424:10305: scene=7_EX
#: 7_EX:5424
msgctxt "text_id=10305 | speaker=unknown"
msgid "　<日夜|にちや>両親の反対と戦う久万梨金鹿にとって、同級生の悩みなど二の次だ。"
msgstr ""

#. Occurrence 7_EX:5457:10306: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0107; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5457
msgctxt "text_id=10306 | speaker=kojika"
msgid "「……でも、もしかしたら、そもそも、か」"
msgstr ""

#. Occurrence 7_EX:5463:10307: scene=7_EX
#: 7_EX:5463
msgctxt "text_id=10307 | speaker=unknown"
msgid "　我ながらなんて思わせぶりで、実のない言い回しかと苦笑いする。"
msgstr ""

#. Occurrence 7_EX:5489:10308: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0108; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5489
msgctxt "text_id=10308 | speaker=kojika"
msgid "「ほんと、はっきり言ってやればよかった。"
msgstr ""

#. Occurrence 7_EX:5495:10309: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0109; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5495
msgctxt "text_id=10309 | speaker=kojika"
msgid "　貴方は単に、<人の善悪|そういうの>に関わる気が、これっぽっちもないんじゃないのかって」"
msgstr ""

#. Occurrence 7_EX:5501:10310: scene=7_EX
#: 7_EX:5501
msgctxt "text_id=10310 | speaker=unknown"
msgid "　だからアイツ嫌いなのよ、と。"
msgstr ""

#. Occurrence 7_EX:5506:10311: scene=7_EX
#: 7_EX:5506
msgctxt "text_id=10311 | speaker=unknown"
msgid "　悪態にもとれるため息をこぼして、彼女は公園を後にした。"
msgstr ""

#. Occurrence 7_EX:5606:10312: scene=7_EX
#: 7_EX:5606
msgctxt "text_id=10312 | speaker=unknown"
msgid "　草十郎がアルバイトを終え、土産の<鰯|いわし>を片手に居間に入ると、ソファーには有珠の姿があった。"
msgstr ""

#. Occurrence 7_EX:5637:10313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0037; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5637
msgctxt "text_id=10313 | speaker=soujuurou"
msgid "「や。こんばんは、有珠」"
msgstr ""

#. Occurrence 7_EX:5648:10314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0038; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5648
msgctxt "text_id=10314 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 7_EX:5653:10315: scene=7_EX
#: 7_EX:5653
msgctxt "text_id=10315 | speaker=unknown"
msgid "　さすがの草十郎も、まだ「ただいま」と言えるだけの親しみはないらしい。"
msgstr ""

#. Occurrence 7_EX:5684:10316: scene=7_EX
#: 7_EX:5684
msgctxt "text_id=10316 | speaker=unknown"
msgid "　草十郎はそのまま台所に移動し、バケツに水を溜めて魚を保存しようとして、"
msgstr ""

msgctxt "text_id=10317 | speaker=unknown"
msgid "背後からイヤそうな視線を感じ、しずしずと冷蔵庫を開けた。"
msgstr ""

#. Occurrence 7_EX:5717:10318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0039; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5717
msgctxt "text_id=10318 | speaker=soujuurou"
msgid "『台所にバケツはダメなんだな……』"
msgstr ""

#. Occurrence 7_EX:5722:10319: scene=7_EX
#: 7_EX:5722
msgctxt "text_id=10319 | speaker=unknown"
msgid "　仕方ない、とお手軽に魚を冷蔵庫にしまって、草十郎は居間の様子を窺った。"
msgstr ""

#. Occurrence 7_EX:5748:10320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0040; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5748
msgctxt "text_id=10320 | speaker=soujuurou"
msgid "「有珠、蒼崎は？」"
msgstr ""

#. Occurrence 7_EX:5768:10321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_9000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:5768
msgctxt "text_id=10321 | speaker=alice"
msgid "「さあ。自分の部屋にいるか、出かけているんでしょう」"
msgstr ""

#. Occurrence 7_EX:5774:10322: scene=7_EX
#: 7_EX:5774
msgctxt "text_id=10322 | speaker=unknown"
msgid "　にべもなく返される。"
msgstr ""

#. Occurrence 7_EX:5792:10323: scene=7_EX
#: 7_EX:5792
msgctxt "text_id=10323 | speaker=unknown"
msgid "　そうかと頷いて、草十郎はやや散らかった台所を片づけはじめた。"
msgstr ""

#. Occurrence 7_EX:5797:10324: scene=7_EX
#: 7_EX:5797
msgctxt "text_id=10324 | speaker=unknown"
msgid "　特に話題もないし、無理に話をする必要性も感じなかったからだろう。"
msgstr ""

#. Occurrence 7_EX:5817:10325: scene=7_EX
#: 7_EX:5817
msgctxt "text_id=10325 | speaker=unknown"
msgid "　水回りを片づけ、まな板を洗い、包丁を拭き、食器を調理時に出しやすい位置に整理整頓する。"
msgstr ""

#. Occurrence 7_EX:5822:10326: scene=7_EX
#: 7_EX:5822
msgctxt "text_id=10326 | speaker=unknown"
msgid "　そんな、いずれ凄腕のハウスキーパーになる事を約束された、よどみのない作業っぷりを、"
msgstr ""

#. Occurrence 7_EX:5843:10327: scene=7_EX
#: 7_EX:5843
msgctxt "text_id=10327 | speaker=unknown"
msgid "　じっと観察する黒い目が、二つ。"
msgstr ""

#. Occurrence 7_EX:5863:10328: scene=7_EX
#: 7_EX:5863
msgctxt "text_id=10328 | speaker=unknown"
msgid "　草十郎がその視線に気が付くのは時間の問題だ。"
msgstr ""

#. Occurrence 7_EX:5882:10329: scene=7_EX
#: 7_EX:5882
msgctxt "text_id=10329 | speaker=unknown"
msgid "　身をかがめて、台所の収納に<寸胴|ずんどう>をしまう。"
msgstr ""

#. Occurrence 7_EX:5887:10330: scene=7_EX
#: 7_EX:5887
msgctxt "text_id=10330 | speaker=unknown"
msgid "　そのまま立ち上がれば、居間にいる有珠と視線がばったり合って、"
msgstr ""

#. Occurrence 7_EX:5922:10331: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10331 | speaker=unknown"
msgid "『メェーーーデーーーっすよーーーー！"
msgstr ""

#. Occurrence 7_EX:5922:10332: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10332 | speaker=unknown"
msgid "　小僧、今すぐロビーに顔を貸すっスーー！』"
msgstr ""

#. Occurrence 7_EX:5969:10333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0041; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5969
msgctxt "text_id=10333 | speaker=soujuurou"
msgid "「あいたっ」"
msgstr ""

#. Occurrence 7_EX:5975:10334: scene=7_EX
#: 7_EX:5975
msgctxt "text_id=10334 | speaker=unknown"
msgid "　その直前。"
msgstr ""

#. Occurrence 7_EX:5981:10335: scene=7_EX
#: 7_EX:5981
msgctxt "text_id=10335 | speaker=unknown"
msgid "立ち上がろうとした草十郎の後頭部に、青い衝撃が突き刺さった。"
msgstr ""

#. Occurrence 7_EX:6001:10336: scene=7_EX
#: 7_EX:6001
msgctxt "text_id=10336 | speaker=unknown"
msgid "　確かめるまでもない。"
msgstr ""

#. Occurrence 7_EX:6035:10337: scene=7_EX
#: 7_EX:6035
msgctxt "text_id=10337 | speaker=unknown"
msgid "　洋館内せましと飛び回る、青い駒鳥だった。"
msgstr ""

#. Occurrence 7_EX:6071:10338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0042; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6071
msgctxt "text_id=10338 | speaker=soujuurou"
msgid "「……洋館に戻ってくるなり、駒鳥に呼び出される」"
msgstr ""

#. Occurrence 7_EX:6077:10339: scene=7_EX
#: 7_EX:6077
msgctxt "text_id=10339 | speaker=unknown"
msgid "　ぼそっと呟く。"
msgstr ""

#. Occurrence 7_EX:6082:10340: scene=7_EX
#: 7_EX:6082
msgctxt "text_id=10340 | speaker=unknown"
msgid "　草十郎なりに、誰かにグチを言いたい気分だったのだろう。"
msgstr ""

#. Occurrence 7_EX:6118:10341: voice_id=BA0_7_EX_0001; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6118
msgctxt "text_id=10341 | speaker=unknown"
msgid "『小僧、ちょっとそこに座るッス』"
msgstr ""

#. Occurrence 7_EX:6124:10342: scene=7_EX
#: 7_EX:6124
msgctxt "text_id=10342 | speaker=unknown"
msgid "　チチチと駒鳥はさえずる。"
msgstr ""

#. Occurrence 7_EX:6129:10343: scene=7_EX
#: 7_EX:6129
msgctxt "text_id=10343 | speaker=unknown"
msgid "　……さて。"
msgstr ""

#. Occurrence 7_EX:6134:10344: scene=7_EX
#: 7_EX:6134
msgctxt "text_id=10344 | speaker=unknown"
msgid "　実のところ、<頻繁|ひんぱん>に激突してくるコレこそが洋館の七不思議、その最たるものだった。"
msgstr ""

#. Occurrence 7_EX:6139:10345: scene=7_EX
#: 7_EX:6139
msgctxt "text_id=10345 | speaker=unknown"
msgid "　なぜなら、"
msgstr ""

#. Occurrence 7_EX:6189:10346: voice_id=BA0_7_EX_0002; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6189
msgctxt "text_id=10346 | speaker=unknown"
msgid "『なめてるっすね？　ジブン駒鳥だってなめてるッスね？　ところで鳥鍋ってどういうコトっすか、それ美味しいんっスか、今度みまってほしいッス！』"
msgstr ""

#. Occurrence 7_EX:6195:10347: scene=7_EX
#: 7_EX:6195
msgctxt "text_id=10347 | speaker=unknown"
msgid "　この通り。"
msgstr ""

#. Occurrence 7_EX:6200:10348: scene=7_EX
#: 7_EX:6200
msgctxt "text_id=10348 | speaker=unknown"
msgid "　駒鳥が何を伝えたいのか、草十郎にはなんとなく分かってしまうのだ。"
msgstr ""

#. Occurrence 7_EX:6236:10349: scene=7_EX
#: 7_EX:6236
msgctxt "text_id=10349 | speaker=unknown"
msgid "　山育ちの草十郎にとって、これこそが悪夢だった。"
msgstr ""

#. Occurrence 7_EX:6241:10350: scene=7_EX
#: 7_EX:6241
msgctxt "text_id=10350 | speaker=unknown"
msgid "　しゃべる動物なんて聞いた事もない。"
msgstr ""

#. Occurrence 7_EX:6246:10351: scene=7_EX
#: 7_EX:6246
msgctxt "text_id=10351 | speaker=unknown"
msgid "　そりゃあ、ごく<希|まれ>に、十年以上も山で暮らしていれば鳥の気持ちが分かるような時はある。もちろん錯覚だが、ちょっとだけ友情を感じる時もあった。"
msgstr ""

#. Occurrence 7_EX:6266:10352: scene=7_EX
#: 7_EX:6266
msgctxt "text_id=10352 | speaker=unknown"
msgid "　だがこれはない。"
msgstr ""

#. Occurrence 7_EX:6271:10353: scene=7_EX
#: 7_EX:6271
msgctxt "text_id=10353 | speaker=unknown"
msgid "　都会人より動物に馴れている分、草十郎は野<生動|かれら>物に対しては徹底的なリアリストなのである。"
msgstr ""

#. Occurrence 7_EX:6302:10354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0043; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6302
msgctxt "text_id=10354 | speaker=soujuurou"
msgid "「しかし、現実だ」"
msgstr ""

#. Occurrence 7_EX:6308:10355: scene=7_EX
#: 7_EX:6308
msgctxt "text_id=10355 | speaker=unknown"
msgid "　頭を抱えて無視したいところだが、久万梨に聞いた話が脳裏をよぎる。"
msgstr ""

#. Occurrence 7_EX:6313:10356: scene=7_EX
#: 7_EX:6313
msgctxt "text_id=10356 | speaker=unknown"
msgid "　鳥には優しく。"
msgstr ""

#. Occurrence 7_EX:6318:10357: scene=7_EX
#: 7_EX:6318
msgctxt "text_id=10357 | speaker=unknown"
msgid "　それが珍しいものなら、珍しいものなりに孤独を抱えているのだとか、なんとか。"
msgstr ""

#. Occurrence 7_EX:6355:10358: voice_id=BA0_7_EX_0003; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6355
msgctxt "text_id=10358 | speaker=unknown"
msgid "『座れって言ってるのにシカトっすか。"
msgstr ""

#. Occurrence 7_EX:6361:10359: voice_id=BA0_7_EX_0004; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6361
msgctxt "text_id=10359 | speaker=unknown"
msgid "　あ、でもイスないッスねココ。じゃあ立ってるッス。小坊主だけに、廊下に立ってるのがお似合いッス。"
msgstr ""

#. Occurrence 7_EX:6367:10360: voice_id=BA0_7_EX_0005; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6367
msgctxt "text_id=10360 | speaker=unknown"
msgid "　あれ、いまウマイこと言ったっスかねジブン！？』"
msgstr ""

#. Occurrence 7_EX:6414:10361: scene=7_EX
#: 7_EX:6414
msgctxt "text_id=10361 | speaker=unknown"
msgid "　羽ばたいているのも疲れたのか、駒鳥は受話器の横に着陸する。"
msgstr ""

#. Occurrence 7_EX:6419:10362: scene=7_EX
#: 7_EX:6419
msgctxt "text_id=10362 | speaker=unknown"
msgid "　草十郎に打つ手はない。"
msgstr ""

#. Occurrence 7_EX:6424:10363: scene=7_EX
#: 7_EX:6424
msgctxt "text_id=10363 | speaker=unknown"
msgid "　基本、この鳥の鳴き声を聞くだけが対抗手段なのだった。"
msgstr ""

#. Occurrence 7_EX:6494:10364: voice_id=BA0_7_EX_0006; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6494
msgctxt "text_id=10364 | speaker=unknown"
msgid "『ジブン長いッス。プロイ<歴|れき>長いッスよ。"
msgstr ""

#. Occurrence 7_EX:6501:10365: voice_id=BA0_7_EX_0007; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6501
msgctxt "text_id=10365 | speaker=unknown"
msgid "マイ女神の頃からアリスさんに仕えてるっス。なんで青いかとかどうでもいいっス。"
msgstr ""

#. Occurrence 7_EX:6513:10366: voice_id=BA0_7_EX_0008; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6513
msgctxt "text_id=10366 | speaker=unknown"
msgid "特技はズバリ探偵役と被害者役。でも探偵であるジブンが真っ先にコロコロするんで、誰がジブンを殺したか、結局誰も分からないッス』"
msgstr ""

#. Occurrence 7_EX:6532:10367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0044; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6532
msgctxt "text_id=10367 | speaker=soujuurou"
msgid "「プロイ？　待ってくれ、それには聞き覚えがある。プロイってなんなんだ？」"
msgstr ""

#. Occurrence 7_EX:6571:10368: voice_id=BA0_7_EX_0009; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6571
msgctxt "text_id=10368 | speaker=unknown"
msgid "『？？？　なんなんだと言われても困るッス。"
msgstr ""

#. Occurrence 7_EX:6577:10369: voice_id=BA0_7_EX_0010; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6577
msgctxt "text_id=10369 | speaker=unknown"
msgid "　エロイ、とかヤクイ、とかの最上級じゃないっスか？』"
msgstr ""

#. Occurrence 7_EX:6606:10370: scene=7_EX
#: 7_EX:6606
msgctxt "text_id=10370 | speaker=unknown"
msgid "　ふむふむと話し合う久遠寺邸最弱のコンビ。"
msgstr ""

#. Occurrence 7_EX:6611:10371: scene=7_EX
#: 7_EX:6611
msgctxt "text_id=10371 | speaker=unknown"
msgid "　かくして、"
msgstr ""

#. Occurrence 7_EX:6616:10372: scene=7_EX
#: 7_EX:6616
msgctxt "text_id=10372 | speaker=unknown"
msgid "　鳥と人間は分かり合えたらしい。"
msgstr ""

#. Occurrence 7_EX:6636:10373: scene=7_EX
#: 7_EX:6636
msgctxt "text_id=10373 | speaker=unknown"
msgid "　いちいち悩むのも疲れたのか、無視するのも体力がいると気が付いたのか。"
msgstr ""

#. Occurrence 7_EX:6641:10374: scene=7_EX
#: 7_EX:6641
msgctxt "text_id=10374 | speaker=unknown"
msgid "　観念した草十郎が合いの手を入れはじめたところ、二人はすっかりうち解けていた。"
msgstr ""

#. Occurrence 7_EX:6647:10375: scene=7_EX
#: 7_EX:6647
msgctxt "text_id=10375 | speaker=unknown"
msgid "　草十郎は珍しい話し相手として、"
msgstr ""

#. Occurrence 7_EX:6652:10376: scene=7_EX
#: 7_EX:6652
msgctxt "text_id=10376 | speaker=unknown"
msgid "　駒鳥は<排斥|はいせき>すべきライバルとして、ではあるが。"
msgstr ""

#. Occurrence 7_EX:6689:10377: voice_id=BA0_7_EX_0011; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6689
msgctxt "text_id=10377 | speaker=unknown"
msgid "『いいんスよ、細けぇ事は。そんなコトよりマイ天使・アリスさんの話をするッス』"
msgstr ""

#. Occurrence 7_EX:6731:10378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0045; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6731
msgctxt "text_id=10378 | speaker=soujuurou"
msgid "「なんと。有珠って天使なのか？」"
msgstr ""

#. Occurrence 7_EX:6737:10379: scene=7_EX
#: 7_EX:6737
msgctxt "text_id=10379 | speaker=unknown"
msgid "　ところで天使ってなんだ、と続けないあたり、草十郎にも学習の跡が見られる。"
msgstr ""

#. Occurrence 7_EX:6758:10380: voice_id=BA0_7_EX_0012; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6758
msgctxt "text_id=10380 | speaker=unknown"
msgid "『ヒユっす。ジブンにとって天使のような存在ってコトっす。下界の喧噪とか、ジブンの言葉をガン無視するところとかマジ天使。"
msgstr ""

#. Occurrence 7_EX:6769:10381: voice_id=BA0_7_EX_0013; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6769
msgctxt "text_id=10381 | speaker=unknown"
msgid "　アリスさんは神聖<不可侵|ふかしん>にして冷酷非道。マイ女神であったところの<母君|ははぎみ>とはちょっと、毛色が違うッス。"
msgstr ""

#. Occurrence 7_EX:6775:10382: voice_id=BA0_7_EX_0014; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6775
msgctxt "text_id=10382 | speaker=unknown"
msgid "　ショージキ<女神|ははぎみ>、ちょっと育てかた間違ったッスね』"
msgstr ""

#. Occurrence 7_EX:6819:10383: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0046; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6819
msgctxt "text_id=10383 | speaker=soujuurou"
msgid "「そうか。そりゃあ有珠にもお母さんはいるんだよな。"
msgstr ""

#. Occurrence 7_EX:6825:10384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0047; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6825
msgctxt "text_id=10384 | speaker=soujuurou"
msgid "　この家にはいないようだけど」"
msgstr ""

#. Occurrence 7_EX:6848:10385: voice_id=BA0_7_EX_0015; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6848
msgctxt "text_id=10385 | speaker=unknown"
msgid "『イエス、悲しいコトにみまかられたっス。あの頃は全英の鳥が泣いたッス。アリスさんに負けないぐらい美しかったッス。あ、後でアルバムとか見るッスか？　６ペンスで手を打つッスよ』"
msgstr ""

#. Occurrence 7_EX:6883:10386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0048; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6883
msgctxt "text_id=10386 | speaker=soujuurou"
msgid "「いや。そういうのは、本人の許しがないと」"
msgstr ""

#. Occurrence 7_EX:6889:10387: scene=7_EX
#: 7_EX:6889
msgctxt "text_id=10387 | speaker=unknown"
msgid "　いけないんじゃないかな？　と首をかしげる草十郎。"
msgstr ""

#. Occurrence 7_EX:6894:10388: scene=7_EX
#: 7_EX:6894
msgctxt "text_id=10388 | speaker=unknown"
msgid "　やや弱気なのは、以前と比べて有珠への興味が高まっているせいだ。"
msgstr ""

#. Occurrence 7_EX:6899:10389: scene=7_EX
#: 7_EX:6899
msgctxt "text_id=10389 | speaker=unknown"
msgid "　人畜無害な顔をして、彼も健康な青年男子であるらしい。"
msgstr ""

#. Occurrence 7_EX:6941:10390: voice_id=BA0_7_EX_0016; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6941
msgctxt "text_id=10390 | speaker=unknown"
msgid "『イエス、それはそうッスね。"
msgstr ""

#. Occurrence 7_EX:6947:10391: voice_id=BA0_7_EX_0017; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6947
msgctxt "text_id=10391 | speaker=unknown"
msgid "　おまえ、シャバ僧のわりにいいコト言うッス。人の<過去話|カコバナ>とかみだりにしちゃいけないッス。"
msgstr ""

#. Occurrence 7_EX:6953:10392: voice_id=BA0_7_EX_0018; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6953
msgctxt "text_id=10392 | speaker=unknown"
msgid "　―――ところでアリスさんの子供時代の話とかしていいっスか？　ジブン、シャバ僧の知らないアリスさんを<赤裸々|せきらら>にアピールして、精神的上位に立ちたいッス』"
msgstr ""

#. Occurrence 7_EX:6964:10393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0049; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6964
msgctxt "text_id=10393 | speaker=soujuurou"
msgid "「あ、いや、だからそういう話は」"
msgstr ""

#. Occurrence 7_EX:7010:10394: voice_id=BA0_7_EX_0019; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7010
msgctxt "text_id=10394 | speaker=unknown"
msgid "『安心しろっス、アリスさんには黙っておいてやるっスから。"
msgstr ""

#. Occurrence 7_EX:7017:10395: voice_id=BA0_7_EX_0020; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7017
msgctxt "text_id=10395 | speaker=unknown"
msgid "まずはアレすね、ジブンとアリスさんが初めて出会った時のメモリーを聞くっスよ。アリスさんああ見えて友達一人しかいなかったッスから、もっぱらジブンが話し相手っつーか。"
msgstr ""

#. Occurrence 7_EX:7023:10396: voice_id=BA0_7_EX_0021; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7023
msgctxt "text_id=10396 | speaker=unknown"
msgid "　ほら、壁相手にカコンカコーンってピンポン玉打ち返すゲーム。あんな感じっス。アリスさんのメモリーはおよそ十四年分。じゃあ一年目から行くッスよ』"
msgstr ""

#. Occurrence 7_EX:7049:10397: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0050; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7049
msgctxt "text_id=10397 | speaker=soujuurou"
msgid "「あ、いや、だから」"
msgstr ""

#. Occurrence 7_EX:7075:10398: voice_id=BA0_7_EX_0022; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7075
msgctxt "text_id=10398 | speaker=unknown"
msgid "『行くッスよー！"
msgstr ""

#. Occurrence 7_EX:7081:10399: voice_id=BA0_7_EX_0023; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7081
msgctxt "text_id=10399 | speaker=unknown"
msgid "　もう誰もジブンを止められないッスー！』"
msgstr ""

#. Occurrence 7_EX:7115:10400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0051; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7115
msgctxt "text_id=10400 | speaker=soujuurou"
msgid "「――――――っ」"
msgstr ""

#. Occurrence 7_EX:7121:10401: scene=7_EX
#: 7_EX:7121
msgctxt "text_id=10401 | speaker=unknown"
msgid "　この鳥は、まずい。"
msgstr ""

#. Occurrence 7_EX:7126:10402: scene=7_EX
#: 7_EX:7126
msgctxt "text_id=10402 | speaker=unknown"
msgid "　<鳥頭|とりあたま>にも程がある。"
msgstr ""

#. Occurrence 7_EX:7131:10403: scene=7_EX
#: 7_EX:7131
msgctxt "text_id=10403 | speaker=unknown"
msgid "　加えて、このまま話を聞いていたら取り返しのつかないコトになる、と察する草十郎だった。"
msgstr ""

#. Occurrence 7_EX:7164:10404: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0052; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7164
msgctxt "text_id=10404 | speaker=soujuurou"
msgid "「すまない。そろそろいいかな」"
msgstr ""

#. Occurrence 7_EX:7172:10405: scene=7_EX
#: 7_EX:7172
msgctxt "text_id=10405 | speaker=unknown"
msgid "　草十郎は手をあげて、じゃあ、と三階の屋根裏部屋への逃走を試みた。"
msgstr ""

#. Occurrence 7_EX:7207:10406: voice_id=BA0_7_EX_0024; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7207
msgctxt "text_id=10406 | speaker=unknown"
msgid "『ちょっ、待つッスーーー！　ここからがいいところなのにナンデ去るっスか。スカーレットオハラっすか。激動の主人公気取りっスか！"
msgstr ""

#. Occurrence 7_EX:7218:10407: voice_id=BA0_7_EX_0025; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7218
msgctxt "text_id=10407 | speaker=unknown"
msgid "　そのあたりジブン、なんか納得いかないッス。まだうちに入ったばかりの新参ものが、なんでアリスさんの視線をひとりじめしてるっスか？　許せないスけど、その秘訣を教えてほしいっス。<切実|せつじつ>に。ジブン、本気だしたら凄いッスよ』"
msgstr ""

#. Occurrence 7_EX:7252:10408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0053; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7252
msgctxt "text_id=10408 | speaker=soujuurou"
msgid "「なに？」"
msgstr ""

#. Occurrence 7_EX:7259:10409: scene=7_EX
#: 7_EX:7259
msgctxt "text_id=10409 | speaker=unknown"
msgid "　もう半分ほど登っていた階段から、草十郎はトコトコと舞い戻る。"
msgstr ""

#. Occurrence 7_EX:7270:10410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0054; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7270
msgctxt "text_id=10410 | speaker=soujuurou"
msgid "「君。いまのはどういう？」"
msgstr ""

#. Occurrence 7_EX:7304:10411: voice_id=BA0_7_EX_0026; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7304
msgctxt "text_id=10411 | speaker=unknown"
msgid "『だからアリスさん、スキあらばオマエを見てるッス。"
msgstr ""

#. Occurrence 7_EX:7310:10412: voice_id=BA0_7_EX_0027; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7310
msgctxt "text_id=10412 | speaker=unknown"
msgid "　思い出したッスよ、そもそもジブン、熱視線でサーチされてるからってつけあがるなと釘刺しにきたんス。"
msgstr ""

#. Occurrence 7_EX:7321:10413: voice_id=BA0_7_EX_0028; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7321
msgctxt "text_id=10413 | speaker=unknown"
msgid "　だいたい草の字は何度もジブンに助けられてるッス。"
msgstr ""

#. Occurrence 7_EX:7327:10414: voice_id=BA0_7_EX_0029; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7327
msgctxt "text_id=10414 | speaker=unknown"
msgid "　アリスさんの命令がなかったら、今ごろ草の字、鏡の中でおだぶつっス。コレなんスかね。人間の感情とかわかんないっスけど、魚へんに里とか描くっスかね？』"
msgstr ""

#. Occurrence 7_EX:7393:10415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0055; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7393
msgctxt "text_id=10415 | speaker=soujuurou"
msgid "「助けられてるって、俺が？」"
msgstr ""

#. Occurrence 7_EX:7400:10416: voice_id=BA0_7_EX_0030; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7400
msgctxt "text_id=10416 | speaker=unknown"
msgid "『まあ、殺そうとしてるのもアリスさんっスけどね！"
msgstr ""

#. Occurrence 7_EX:7407:10417: voice_id=BA0_7_EX_0031_0; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7407
msgctxt "text_id=10417 | speaker=unknown"
msgid "　アリスさんはこう言ったっス。彼が鏡の中に迷いこみそうになったら助けてあげて、危険なモノには近寄らないように誘導もしてあげて、ええ、でも思い上がらないコトねシズキクン、別にアンタのコトが心配なワケ"
msgstr ""

#. Occurrence 7_EX:7422:10418: voice_id=BA0_7_EX_0031_1; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7422
msgctxt "text_id=10418 | speaker=unknown"
msgid "じゃぶきゃっ！？』"
msgstr ""

#. Occurrence 7_EX:7442:10419: scene=7_EX
#: 7_EX:7442
msgctxt "text_id=10419 | speaker=unknown"
msgid "　一瞬の早技だった。"
msgstr ""

#. Occurrence 7_EX:7447:10420: scene=7_EX
#: 7_EX:7447
msgctxt "text_id=10420 | speaker=unknown"
msgid "　突如ロビーにやってきた有珠は、一瞬の<躊躇|ちゅうちょ>もなく受話器台の駒鳥を片手で粉砕した。"
msgstr ""

#. Occurrence 7_EX:7452:10421: scene=7_EX
#: 7_EX:7452
msgctxt "text_id=10421 | speaker=unknown"
msgid "　もとい、片手で押さえつけた。"
msgstr ""

#. Occurrence 7_EX:7472:10422: scene=7_EX
#: 7_EX:7472
msgctxt "text_id=10422 | speaker=unknown"
msgid "　青い鳥はぶにゃ、と潰されたカラーボールのように変形しながら、"
msgstr ""

#. Occurrence 7_EX:7483:10423: voice_id=BA0_7_EX_0032; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7483
msgctxt "text_id=10423 | speaker=unknown"
msgid "『ちょっ、アリスさん暗いッスー！"
msgstr ""

#. Occurrence 7_EX:7489:10424: voice_id=BA0_7_EX_0033; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7489
msgctxt "text_id=10424 | speaker=unknown"
msgid "　そして痛い、体中の血液がくちばしからこう、右方向に流れていく感覚とかー！』"
msgstr ""

#. Occurrence 7_EX:7495:10425: scene=7_EX
#: 7_EX:7495
msgctxt "text_id=10425 | speaker=unknown"
msgid "　たくましい鳴き声をあげている。"
msgstr ""

#. Occurrence 7_EX:7550:10426: scene=7_EX
#: 7_EX:7550
msgctxt "text_id=10426 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence 7_EX:7558:10427: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0002; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:7558
msgctxt "text_id=10427 | speaker=alice"
msgid "コレの言うことは、気にしないで」"
msgstr ""

#. Occurrence 7_EX:7580:10428: scene=7_EX
#: 7_EX:7580
msgctxt "text_id=10428 | speaker=unknown"
msgid "　駒鳥を回収し、居間に去っていく有珠。"
msgstr ""

#. Occurrence 7_EX:7585:10429: scene=7_EX
#: 7_EX:7585
msgctxt "text_id=10429 | speaker=unknown"
msgid "　その後ろ姿は駒鳥とは正反対の、暗い<翳|かげ>りを帯びている。"
msgstr ""

#. Occurrence 7_EX:7618:10430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0056; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7618
msgctxt "text_id=10430 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 7_EX:7623:10431: scene=7_EX
#: 7_EX:7623
msgctxt "text_id=10431 | speaker=unknown"
msgid "　草十郎は困った顔のまま腕を組んで、"
msgstr ""

#. Occurrence 7_EX:7634:10432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0057; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7634
msgctxt "text_id=10432 | speaker=soujuurou"
msgid "「こうして、ますます疑問は増えていくのだった」"
msgstr ""

#. Occurrence 7_EX:7640:10433: scene=7_EX
#: 7_EX:7640
msgctxt "text_id=10433 | speaker=unknown"
msgid "　ひとり、天窓から<覗|のぞ>く夜空に呟いた。"
msgstr ""

#. Occurrence 8_1:54:10434: scene=8_1
#: 8_1:54
msgctxt "text_id=10434 | speaker=unknown"
msgid "　三咲高校の冬休みは十二月の中旬から始まる。"
msgstr ""

#. Occurrence 8_1:61:10435: scene=8_1
#: 8_1:61
msgctxt "text_id=10435 | speaker=unknown"
msgid "　全国に名を馳せる運動部もなく、熱心な進学校でもない学校の静けさは清潔感すらある。"
msgstr ""

#. Occurrence 8_1:66:10436: scene=8_1
#: 8_1:66
msgctxt "text_id=10436 | speaker=unknown"
msgid "　<人気|ひとけ>の<絶|た>えた新築の建物は、冬の湖に舞い下りた白鳥を思わせる。"
msgstr ""

#. Occurrence 8_1:71:10437: scene=8_1
#: 8_1:71
msgctxt "text_id=10437 | speaker=unknown"
msgid "　近代化の進んだ校舎は、その血液である生徒を<欠|か>いても在り方を損なわず、粛々と<佇|たたず>んでいる。"
msgstr ""

#. Occurrence 8_1:92:10438: scene=8_1
#: 8_1:92
msgctxt "text_id=10438 | speaker=unknown"
msgid "　だが、生徒の多くはその前身を知らない。"
msgstr ""

#. Occurrence 8_1:97:10439: scene=8_1
#: 8_1:97
msgctxt "text_id=10439 | speaker=unknown"
msgid "　今の姿とは比べようのない、木造の小さな<学舎|まなびや>。"
msgstr ""

#. Occurrence 8_1:102:10440: scene=8_1
#: 8_1:102
msgctxt "text_id=10440 | speaker=unknown"
msgid "　その旧校舎は取り壊される事もなく、今でも<鎮|しず>かに眠っている。"
msgstr ""

#. Occurrence 8_1:107:10441: scene=8_1
#: 8_1:107
msgctxt "text_id=10441 | speaker=unknown"
msgid "　裏山に<延々|えんえん>と続く森のただ中に、ひっそりとその身を隠すように。"
msgstr ""

#. Occurrence 8_1:143:10442: scene=8_1
#: 8_1:143
msgctxt "text_id=10442 | speaker=unknown"
msgid "　枯葉を<掃|は>く竹ぼうきの音が響く。"
msgstr ""

#. Occurrence 8_1:148:10443: scene=8_1
#: 8_1:148
msgctxt "text_id=10443 | speaker=unknown"
msgid "　裏山に枯れ落ちた葉は、砂浜に打ち寄せる波のようだ。掃いても掃いてもきりがない。"
msgstr ""

#. Occurrence 8_1:153:10444: scene=8_1
#: 8_1:153
msgctxt "text_id=10444 | speaker=unknown"
msgid "　なにしろ二年間以上放置された魔境である。"
msgstr ""

#. Occurrence 8_1:158:10445: scene=8_1
#: 8_1:158
msgctxt "text_id=10445 | speaker=unknown"
msgid "　仮に校内あげての清掃を始めたところで、一日二日でどうにかなるものではない。"
msgstr ""

#. Occurrence 8_1:163:10446: scene=8_1
#: 8_1:163
msgctxt "text_id=10446 | speaker=unknown"
msgid "　<況|いわ>んや、"
msgstr ""

#. Occurrence 8_1:197:10447: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0000; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:197
msgctxt "text_id=10447 | speaker=kinomi"
msgid "「あー、ほんとだりぃー、存在価値がみいだせねぇー。"
msgstr ""

#. Occurrence 8_1:203:10448: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0001; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:203
msgctxt "text_id=10448 | speaker=kinomi"
msgid "　バッカじゃねえの、冬休みは短いってのに、なんでこんな事やらせんだよ生徒会は」"
msgstr ""

#. Occurrence 8_1:216:10449: scene=8_1
#: 8_1:216
msgctxt "text_id=10449 | speaker=unknown"
msgid "　その参加者がこのような<不心得|ふこころえ><者|もの>では、裏山の美化など望むべくもないのだった。"
msgstr ""

#. Occurrence 8_1:246:10450: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0002; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:246
msgctxt "text_id=10450 | speaker=kinomi"
msgid "「っていうかジャージでやらせんなよ、ジャンパーぐらい着させろよなー。"
msgstr ""

#. Occurrence 8_1:253:10451: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0003; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:253
msgctxt "text_id=10451 | speaker=kinomi"
msgid "なにこれ、もしかして体育の補習？　寒中マラソン？　オレ体育だけはサボったコトねぇんスけどねー！」"
msgstr ""

#. Occurrence 8_1:259:10452: scene=8_1
#: 8_1:259
msgctxt "text_id=10452 | speaker=unknown"
msgid "　なげやりに竹ぼうきをブンブンと振り回し、<罵詈|ばり><雑言|ぞうごん>をまき散らす<木乃美|きのみ><芳助|ほうすけ>。"
msgstr ""

#. Occurrence 8_1:276:10453: scene=8_1
#: 8_1:276
msgctxt "text_id=10453 | speaker=unknown"
msgid "　それを横目にしながら、草十郎は無言でざっざっと竹ぼうきを動かしていた。"
msgstr ""

#. Occurrence 8_1:310:10454: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0004; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:310
msgctxt "text_id=10454 | speaker=kinomi"
msgid "「おい、なに真面目にやってんだよ。こんなの適当でいいんだって。だいたい四十人しかいねえのに、こんな山みたいな庭の掃除なんか終わるかってんだ」"
msgstr ""

#. Occurrence 8_1:316:10455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0000; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:316
msgctxt "text_id=10455 | speaker=soujuurou"
msgid "「終わらない事なんてない。少しうるさいぞ、木乃美は」"
msgstr ""

#. Occurrence 8_1:324:10456: scene=8_1
#: 8_1:324
msgctxt "text_id=10456 | speaker=unknown"
msgid "　振り向きもせず<窘|たしな>める草十郎に、木乃美はますます詰まらなそうに竹ぼうきを振り回した。"
msgstr ""

#. Occurrence 8_1:354:10457: scene=8_1
#: 8_1:354
msgctxt "text_id=10457 | speaker=unknown"
msgid "　朝の裏山は寒い。"
msgstr ""

#. Occurrence 8_1:359:10458: scene=8_1
#: 8_1:359
msgctxt "text_id=10458 | speaker=unknown"
msgid "　曇った空には太陽の影もなく、灰色の光が裏庭を照らしていた。真冬の見本みたいな寒さは、軍手ごしにも手をかじかませる。"
msgstr ""

#. Occurrence 8_1:364:10459: scene=8_1
#: 8_1:364
msgctxt "text_id=10459 | speaker=unknown"
msgid "　こんな日は部屋でぬくんでいるべきなのに、何の因果か、彼らは裏山の掃除なんてやっていた。"
msgstr ""

#. Occurrence 8_1:384:10460: scene=8_1
#: 8_1:384
msgctxt "text_id=10460 | speaker=unknown"
msgid "　冬期特別清掃班。"
msgstr ""

#. Occurrence 8_1:404:10461: scene=8_1
#: 8_1:404
msgctxt "text_id=10461 | speaker=unknown"
msgid "　それは、いいかげん荒れ放題の裏山をどうにかしようと集結した有志たちによる、決死隊の呼称である。"
msgstr ""

#. Occurrence 8_1:409:10462: scene=8_1
#: 8_1:409
msgctxt "text_id=10462 | speaker=unknown"
msgid "　一般生徒は彼らを美化という名の神に信心を捧げた、鋼のお掃除部隊と思うだろう。"
msgstr ""

#. Occurrence 8_1:429:10463: scene=8_1
#: 8_1:429
msgctxt "text_id=10463 | speaker=unknown"
msgid "　しかし、その実態は期末試験の補習の一貫として用意された、ただの罰ゲーム部隊だった。"
msgstr ""

#. Occurrence 8_1:434:10464: scene=8_1
#: 8_1:434
msgctxt "text_id=10464 | speaker=unknown"
msgid "　今年度の生徒会が力技で実行した、一年計画の犠牲者である。"
msgstr ""

#. Occurrence 8_1:467:10465: scene=8_1
#: 8_1:467
msgctxt "text_id=10465 | speaker=unknown"
msgid "　そろそろ雪が降ってもおかしくないこの季節に、誰が好き好んで枯葉拾いなぞやるものか。"
msgstr ""

#. Occurrence 8_1:472:10466: scene=8_1
#: 8_1:472
msgctxt "text_id=10466 | speaker=unknown"
msgid "　結局集まった四十人のうち一人を除いて、有志でもなんでもなかったりする。"
msgstr ""

#. Occurrence 8_1:506:10467: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0005; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:506
msgctxt "text_id=10467 | speaker=kinomi"
msgid "「げ。おい見ろよ<静希|しずき>。<赤羽|あかばね>たち、向こうで焼き芋とかレトロなマネしてやがる！"
msgstr ""

#. Occurrence 8_1:522:10468: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0006; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:522
msgctxt "text_id=10468 | speaker=kinomi"
msgid "　んが、二番煎じはいかにもあたま悪いしな。そうだ、オレたちはイカでも焼かねぇ？」"
msgstr ""

#. Occurrence 8_1:542:10469: scene=8_1
#: 8_1:542
msgctxt "text_id=10469 | speaker=unknown"
msgid "　もとより掃除をする気のない木乃美はしきりに草十郎を懐柔しようとしていた。"
msgstr ""

#. Occurrence 8_1:559:10470: scene=8_1
#: 8_1:559
msgctxt "text_id=10470 | speaker=unknown"
msgid "　清掃班はグループに分けられており、草十郎と木乃美は体育館裏の担当だ。"
msgstr ""

#. Occurrence 8_1:564:10471: scene=8_1
#: 8_1:564
msgctxt "text_id=10471 | speaker=unknown"
msgid "　リーダーは草十郎で、一般兵士は木乃美である。"
msgstr ""

#. Occurrence 8_1:588:10472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0001; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:588
msgctxt "text_id=10472 | speaker=soujuurou"
msgid "「ああ。こことあっちの垣根をきれいにしたら、焼き芋だろうと焼きイカだろうとネコ鍋だろうと好きにしよう。その頃にはちょうどお昼だ」"
msgstr ""

#. Occurrence 8_1:609:10473: scene=8_1
#: 8_1:609
msgctxt "text_id=10473 | speaker=unknown"
msgid "　草十郎は慣れた手つきで、かき集めた枯葉をビニールのゴミ袋に詰めていく。"
msgstr ""

#. Occurrence 8_1:618:10474: scene=8_1
#: 8_1:618
msgctxt "text_id=10474 | speaker=unknown"
msgid "　うっすらと霧が立ち籠める朝七時から集まって、すでに二時間。"
msgstr ""

#. Occurrence 8_1:623:10475: scene=8_1
#: 8_1:623
msgctxt "text_id=10475 | speaker=unknown"
msgid "　誰もが<音|ね>を上げてだらけ始めている中、草十郎は開始時と同じペースで黙々と働いていた。"
msgstr ""

#. Occurrence 8_1:628:10476: scene=8_1
#: 8_1:628
msgctxt "text_id=10476 | speaker=unknown"
msgid "　掃除用に着替えたジャージはえらく寒いのに、泣き言一つないのは運動量の多さ故だろう。"
msgstr ""

#. Occurrence 8_1:661:10477: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0007; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:661
msgctxt "text_id=10477 | speaker=kinomi"
msgid "「なー、やめようぜ。みろ、そこの池……スケートリンク……？　いや、やっぱ池……？"
msgstr ""

#. Occurrence 8_1:668:10478: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0008; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:668
msgctxt "text_id=10478 | speaker=kinomi"
msgid "　とにかく、そこの池らしきモノだってカチカチに凍ってるぐらいなんだぜ？"
msgstr ""

#. Occurrence 8_1:674:10479: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0009; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:674
msgctxt "text_id=10479 | speaker=kinomi"
msgid "　こんな雪原じゃ人体はフツー動かねえよ、機械伯爵でもなきゃだよ、そろそろ人間狩りがはじまるよー」"
msgstr ""

#. Occurrence 8_1:716:10480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0010; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:716
msgctxt "text_id=10480 | speaker=kinomi"
msgid "「なんで、いいかげん休憩しねえ？"
msgstr ""

#. Occurrence 8_1:722:10481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0011; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:722
msgctxt "text_id=10481 | speaker=kinomi"
msgid "　せっかく枯葉集めたんだから、燃やして暖まんないとさー。どうせ監視役は殿下しかいないんだしさー。な、焼きイカやろうぜ、焼きイカー」"
msgstr ""

#. Occurrence 8_1:742:10482: scene=8_1
#: 8_1:742
msgctxt "text_id=10482 | speaker=unknown"
msgid "　イカに思い入れがあるのか、木乃美はしつこく主張する。"
msgstr ""

#. Occurrence 8_1:747:10483: scene=8_1
#: 8_1:747
msgctxt "text_id=10483 | speaker=unknown"
msgid "　相棒の泣き言を黙って受けとめていた草十郎だが、それもそろそろ限界らしかった。"
msgstr ""

#. Occurrence 8_1:775:10484: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0002; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:775
msgctxt "text_id=10484 | speaker=soujuurou"
msgid "「木乃美、頼むから……」"
msgstr ""

#. Occurrence 8_1:817:10485: scene=8_1
#: 8_1:817
msgctxt "text_id=10485 | speaker=unknown"
msgid "　その時、草十郎は相棒の背後に死神の姿を認めた。"
msgstr ""

#. Occurrence 8_1:822:10486: scene=8_1
#: 8_1:822
msgctxt "text_id=10486 | speaker=unknown"
msgid "　手に持っている物が竹ぼうきではなくクマデなのがまたらしい。"
msgstr ""

#. Occurrence 8_1:848:10487: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0000; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:848
msgctxt "text_id=10487 | speaker=tobimaru"
msgid "「いいぜ。おまえがイカなんてモンを用意してるほどの大人物だってんなら、<謹|つつし>んでイカ焼きぐらい許可してやるよ。なんなら醤油はこっちで用意してやろう」"
msgstr ""

#. Occurrence 8_1:867:10488: scene=8_1
#: 8_1:867
msgctxt "text_id=10488 | speaker=unknown"
msgid "　背中からの声に、木乃美はびくり、と背筋を伸ばし、"
msgstr ""

#. Occurrence 8_1:873:10489: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0012; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:873
msgctxt "text_id=10489 | speaker=kinomi"
msgid "「ひゃあ！　その物言い、槻司<某|なにがし>―――！」"
msgstr ""

#. Occurrence 8_1:879:10490: scene=8_1
#: 8_1:879
msgctxt "text_id=10490 | speaker=unknown"
msgid "　時代劇めいた台詞を吐いて、振り向きざまに竹ぼうきを振るう。"
msgstr ""

#. Occurrence 8_1:887:10491: scene=8_1
#: 8_1:887
msgctxt "text_id=10491 | speaker=unknown"
msgid "　それを鳶丸はクマデでがっしりと受けとめた。"
msgstr ""

#. Occurrence 8_1:913:10492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0001; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:913
msgctxt "text_id=10492 | speaker=tobimaru"
msgid "「ああ？　テメエ、やる気十分じゃねえか。あふれる労働意欲を抑えきれないってワケか？　なんなら<特別|シベリア>コースにでも行っちまうか？」"
msgstr ""

#. Occurrence 8_1:931:10493: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0013; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:931
msgctxt "text_id=10493 | speaker=kinomi"
msgid "「はん。女ども集めて焼却炉に陣どってる野郎の言葉なんざ聞かねえよ。真冬に南国気分とかマジ寒いわ」"
msgstr ""

#. Occurrence 8_1:970:10494: scene=8_1
#: 8_1:970
msgctxt "text_id=10494 | speaker=unknown"
msgid "　竹ぼうきとクマデを交差させて、ふたりは不敵な笑みを浮かべている。"
msgstr ""

#. Occurrence 8_1:975:10495: scene=8_1
#: 8_1:975
msgctxt "text_id=10495 | speaker=unknown"
msgid "　これでも学園内限定で仲のいいコンビだった。"
msgstr ""

#. Occurrence 8_1:1020:10496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0003; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1020
msgctxt "text_id=10496 | speaker=soujuurou"
msgid "「鳶丸。いちおう、彼は戦力なんだから邪魔しないでくれ」"
msgstr ""

#. Occurrence 8_1:1026:10497: scene=8_1
#: 8_1:1026
msgctxt "text_id=10497 | speaker=unknown"
msgid "　チ、と心底忌々しそうに舌打ちし、矛を納める両者。"
msgstr ""

#. Occurrence 8_1:1031:10498: scene=8_1
#: 8_1:1031
msgctxt "text_id=10498 | speaker=unknown"
msgid "　なんというか、ゴミ袋片手に、俗世のコトなど関心ありません、と掃除をする草十郎の<言|げん>には逆らえない。"
msgstr ""

#. Occurrence 8_1:1068:10499: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0004; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1068
msgctxt "text_id=10499 | speaker=soujuurou"
msgid "「それで、何しに来たんだ鳶丸。"
msgstr ""

#. Occurrence 8_1:1074:10500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0005; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1074
msgctxt "text_id=10500 | speaker=soujuurou"
msgid "　君はあったかい焼却炉の前で、永遠に火の管理をすると豪語していたんじゃなかったっけ？」"
msgstr ""

#. Occurrence 8_1:1080:10501: scene=8_1
#: 8_1:1080
msgctxt "text_id=10501 | speaker=unknown"
msgid "　もとい。"
msgstr ""

#. Occurrence 8_1:1085:10502: scene=8_1
#: 8_1:1085
msgctxt "text_id=10502 | speaker=unknown"
msgid "　この男も、多少は俗世に関心があったらしい。"
msgstr ""

#. Occurrence 8_1:1118:10503: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0002; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1118
msgctxt "text_id=10503 | speaker=tobimaru"
msgid "「なんてこった……善良な生徒ですら、俺をそんな目で見るのか……」"
msgstr ""

#. Occurrence 8_1:1124:10504: scene=8_1
#: 8_1:1124
msgctxt "text_id=10504 | speaker=unknown"
msgid "　悲しそうに鳶丸は言う。"
msgstr ""

#. Occurrence 8_1:1129:10505: scene=8_1
#: 8_1:1129
msgctxt "text_id=10505 | speaker=unknown"
msgid "　が、集められた落ち葉を燃やして<暖|だん>を取りながら、女子の清掃班を手伝いと称してはべらせている以上、かける情けは落ち葉一枚分もないのである。"
msgstr ""

#. Occurrence 8_1:1165:10506: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0014; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1165
msgctxt "text_id=10506 | speaker=kinomi"
msgid "「いいから用件を言えよ。殿下と違ってオレらはヒマじゃねえんだ」"
msgstr ""

#. Occurrence 8_1:1181:10507: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10507 | speaker=tobimaru"
msgid "「ああそうかよ。草十郎、そろそろ小休止だ。"
msgstr ""

#. Occurrence 8_1:1181:10508: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10508 | speaker=tobimaru"
msgid "　向こうで<暖|あたた>まろうや」"
msgstr ""

#. Occurrence 8_1:1201:10509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0015; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1201
msgctxt "text_id=10509 | speaker=kinomi"
msgid "「お、なんだブレイクかよ！　話せるじゃん、殿下！」"
msgstr ""

#. Occurrence 8_1:1234:10510: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0004; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1234
msgctxt "text_id=10510 | speaker=tobimaru"
msgid "「あ？　テメエは除外に決まってんだろ。特権は功労者にのみ与えられるモンだ。"
msgstr ""

#. Occurrence 8_1:1240:10511: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0005; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1240
msgctxt "text_id=10511 | speaker=tobimaru"
msgid "　焼却炉の前に来たけりゃ、それ相応の貢ぎ物を持ってきやがれ。具体的に言うと、リヤカー一台分のゴミ袋な」"
msgstr ""

#. Occurrence 8_1:1265:10512: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0016; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1265
msgctxt "text_id=10512 | speaker=kinomi"
msgid "「ひっでぇ、生徒会横暴ー！」"
msgstr ""

#. Occurrence 8_1:1285:10513: scene=8_1
#: 8_1:1285
msgctxt "text_id=10513 | speaker=unknown"
msgid "　木乃美の抗議は当然のように届かない。"
msgstr ""

#. Occurrence 8_1:1290:10514: scene=8_1
#: 8_1:1290
msgctxt "text_id=10514 | speaker=unknown"
msgid "　清掃班の指揮役として<抜擢|ばってき>された鳶丸には、こんなんでも絶対的な権力があった。"
msgstr ""

#. Occurrence 8_1:1295:10515: scene=8_1
#: 8_1:1295
msgctxt "text_id=10515 | speaker=unknown"
msgid "　彼がちょっと記録に手を加えれば、木乃美は明日も明後日も清掃班に参加する事になる。"
msgstr ""

#. Occurrence 8_1:1335:10516: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0006; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1335
msgctxt "text_id=10516 | speaker=tobimaru"
msgid "「さ、行くぞ。誰の趣味かしらねえが、なぜかしるこの缶が山ほどあってな。中華まんの一つでもあった方が気が利くってもんなんだがねぇ。アレか、遭難用のチョコレートみたいなもんか？"
msgstr ""

#. Occurrence 8_1:1341:10517: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0007; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1341
msgctxt "text_id=10517 | speaker=tobimaru"
msgid "　……ったく、アイツの考えはいまだに分かんねぇなあ」"
msgstr ""

#. Occurrence 8_1:1357:10518: scene=8_1
#: 8_1:1357
msgctxt "text_id=10518 | speaker=unknown"
msgid "　それはそれで気が利いているのでは、と感心する草十郎。"
msgstr ""

#. Occurrence 8_1:1391:10519: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0008; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1391
msgctxt "text_id=10519 | speaker=tobimaru"
msgid "「ん？　なんだよ、行かねえのか草十郎？」"
msgstr ""

#. Occurrence 8_1:1397:10520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0006; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1397
msgctxt "text_id=10520 | speaker=soujuurou"
msgid "「ああ、自分はここに残るよ。<暖|だん>なら木乃美の言うように葉を燃やせばいい。そこに池もある。火の始末なら安心だ」"
msgstr ""

#. Occurrence 8_1:1420:10521: scene=8_1
#: 8_1:1420
msgctxt "text_id=10521 | speaker=unknown"
msgid "　木乃美に気をつかっての返答である。"
msgstr ""

#. Occurrence 8_1:1425:10522: scene=8_1
#: 8_1:1425
msgctxt "text_id=10522 | speaker=unknown"
msgid "　鳶丸は眉をひそめ、木乃美はプルプル震えている。"
msgstr ""

#. Occurrence 8_1:1463:10523: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0017; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1463
msgctxt "text_id=10523 | speaker=kinomi"
msgid "「おお……ぉおおお……！"
msgstr ""

#. Occurrence 8_1:1475:10524: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0018; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1475
msgctxt "text_id=10524 | speaker=kinomi"
msgid "　オ、オレはいま友情ってもんを実感している！　すげえな、真心ってほんとにあったんだ！"
msgstr ""

#. Occurrence 8_1:1482:10525: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0019; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1482
msgctxt "text_id=10525 | speaker=kinomi"
msgid "　クソ、待ってろ静希！　いま赤羽たちからイモ奪ってくる！」"
msgstr ""

#. Occurrence 8_1:1495:10526: scene=8_1
#: 8_1:1495
msgctxt "text_id=10526 | speaker=unknown"
msgid "　根は照れ屋なのか、木乃美はとなりの班の集まりへ走っていった。"
msgstr ""

#. Occurrence 8_1:1529:10527: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0009; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1529
msgctxt "text_id=10527 | speaker=tobimaru"
msgid "「……ま、予想はしてたけどな。ほらよ」"
msgstr ""

#. Occurrence 8_1:1548:10528: scene=8_1
#: 8_1:1548
msgctxt "text_id=10528 | speaker=unknown"
msgid "　やれやれと頭をかきながら、鳶丸はジャージのポケットからホット缶を取りだした。"
msgstr ""

#. Occurrence 8_1:1553:10529: scene=8_1
#: 8_1:1553
msgctxt "text_id=10529 | speaker=unknown"
msgid "　左右のポケットと、ズボンの後ろ、合わせて三本。"
msgstr ""

#. Occurrence 8_1:1574:10530: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10530 | speaker=tobimaru"
msgid "「さっさと焚火の用意をしようぜ。"
msgstr ""

#. Occurrence 8_1:1574:10531: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10531 | speaker=tobimaru"
msgid "　俺もこっちで休む事にするわ」"
msgstr ""

#. Occurrence 8_1:1590:10532: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0007; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1590
msgctxt "text_id=10532 | speaker=soujuurou"
msgid "「付き合いがいいのはお互いさまだな」"
msgstr ""

#. Occurrence 8_1:1601:10533: scene=8_1
#: 8_1:1601
msgctxt "text_id=10533 | speaker=unknown"
msgid "　草十郎は手早く焚火の用意を済ませる。"
msgstr ""

#. Occurrence 8_1:1612:10534: scene=8_1
#: 8_1:1612
msgctxt "text_id=10534 | speaker=unknown"
msgid "　落ち葉を集め、きちんと<燻|くすぶ>るよう、あっさりと燃やしてみせた。"
msgstr ""

#. Occurrence 8_1:1641:10535: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0011; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1641
msgctxt "text_id=10535 | speaker=tobimaru"
msgid "「…………慣れてるな」"
msgstr ""

#. Occurrence 8_1:1647:10536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0008; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1647
msgctxt "text_id=10536 | speaker=soujuurou"
msgid "「マッチがあるから、楽なんだ」"
msgstr ""

#. Occurrence 8_1:1653:10537: scene=8_1
#: 8_1:1653
msgctxt "text_id=10537 | speaker=unknown"
msgid "　草十郎は火をつけた落ち葉の前にしゃがみこんで、かじかんだ両手をかざした。"
msgstr ""

#. Occurrence 8_1:1658:10538: scene=8_1
#: 8_1:1658
msgctxt "text_id=10538 | speaker=unknown"
msgid "　寒そうな素振りは見られなかったが、草十郎は草十郎なりに寒かったらしい。"
msgstr ""

#. Occurrence 8_1:1678:10539: scene=8_1
#: 8_1:1678
msgctxt "text_id=10539 | speaker=unknown"
msgid "　ぱちぱちと煙る落ち葉の山を、懐かしむように草十郎は眺めている。"
msgstr ""

#. Occurrence 8_1:1694:10540: scene=8_1
#: 8_1:1694
msgctxt "text_id=10540 | speaker=unknown"
msgid "　……その姿に、鳶丸は一抹の不安を感じた。"
msgstr ""

#. Occurrence 8_1:1699:10541: scene=8_1
#: 8_1:1699
msgctxt "text_id=10541 | speaker=unknown"
msgid "　望郷や追想。住む場所を奪われ追われた、異邦人のような暗い<翳|かげ>りを、その姿に見たからだ。"
msgstr ""

#. Occurrence 8_1:1720:10542: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0012; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1720
msgctxt "text_id=10542 | speaker=tobimaru"
msgid "「元気ねえな、草十郎」"
msgstr ""

#. Occurrence 8_1:1726:10543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0009; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1726
msgctxt "text_id=10543 | speaker=soujuurou"
msgid "「……まあね。少し、疲れてる」"
msgstr ""

#. Occurrence 8_1:1746:10544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0013; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1746
msgctxt "text_id=10544 | speaker=tobimaru"
msgid "「悩みごとなら相談にのるぜ。気が向いたら話してくれ」"
msgstr ""

#. Occurrence 8_1:1753:10545: scene=8_1
#: 8_1:1753
msgctxt "text_id=10545 | speaker=unknown"
msgid "　お汁粉缶を開けて、人差し指に残ったリングプルを持て余しながら鳶丸は続ける。"
msgstr ""

#. Occurrence 8_1:1758:10546: scene=8_1
#: 8_1:1758
msgctxt "text_id=10546 | speaker=unknown"
msgid "　草十郎は焚火に意識を向けたままだ。"
msgstr ""

#. Occurrence 8_1:1793:10547: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0014; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1793
msgctxt "text_id=10547 | speaker=tobimaru"
msgid "「そういえばな。おまえが学校休んでる時、蒼崎に殴られたぜ。なんでも俺は大ぼら吹きだそうだ」"
msgstr ""

#. Occurrence 8_1:1811:10548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0010; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1811
msgctxt "text_id=10548 | speaker=soujuurou"
msgid "「すごいな、大抜擢じゃないか」"
msgstr ""

#. Occurrence 8_1:1828:10549: scene=8_1
#: 8_1:1828
msgctxt "text_id=10549 | speaker=unknown"
msgid "　草十郎の返答は、時々このように脈絡がない。"
msgstr ""

#. Occurrence 8_1:1838:10550: scene=8_1
#: 8_1:1838
msgctxt "text_id=10550 | speaker=unknown"
msgid "　おそらく文化圏の違いだろう、と鳶丸は気にしない事にした。"
msgstr ""

#. Occurrence 8_1:1864:10551: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0015; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1864
msgctxt "text_id=10551 | speaker=tobimaru"
msgid "「なあ、蒼崎とはどうなってんだ？　テスト前は駅まで一緒に帰ってただろ。うまくいってんのか、あれから？」"
msgstr ""

#. Occurrence 8_1:1869:10552: scene=8_1
#: 8_1:1869
msgctxt "text_id=10552 | speaker=unknown"
msgid "　そんなハズはあるまい、と誰よりも分かっているクセに問いただす。そんな鳶丸に、"
msgstr ""

#. Occurrence 8_1:1891:10553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0011; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1891
msgctxt "text_id=10553 | speaker=soujuurou"
msgid "「ああ、今は一緒に住んでるよ」"
msgstr ""

#. Occurrence 8_1:1897:10554: scene=8_1
#: 8_1:1897
msgctxt "text_id=10554 | speaker=unknown"
msgid "　草十郎はあっさりと真実を告げるのだった。"
msgstr ""

#. Occurrence 8_1:1934:10555: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0016; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1934
msgctxt "text_id=10555 | speaker=tobimaru"
msgid "「ほー。そうか、一緒ときたか」"
msgstr ""

#. Occurrence 8_1:1939:10556: scene=8_1
#: 8_1:1939
msgctxt "text_id=10556 | speaker=unknown"
msgid "　あまりに自然な返答にハハハ、と鳶丸は相づちを打ち、"
msgstr ""

#. Occurrence 8_1:1987:10557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0017; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1987
msgctxt "text_id=10557 | speaker=tobimaru"
msgid "「あん、一緒に住んでるだぁーー！？」"
msgstr ""

#. Occurrence 8_1:2022:10558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0012; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2022
msgctxt "text_id=10558 | speaker=soujuurou"
msgid "「どうした鳶丸。火でも飛んだか？」"
msgstr ""

#. Occurrence 8_1:2038:10559: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0018; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2038
msgctxt "text_id=10559 | speaker=tobimaru"
msgid "「飛んでねえし、それより怖ぇ。おい、今の聞き捨てならねえ<戯言|たわごと>はホントの話か？」"
msgstr ""

#. Occurrence 8_1:2048:10560: scene=8_1
#: 8_1:2048
msgctxt "text_id=10560 | speaker=unknown"
msgid "　戯言とは何事だ、と草十郎は無言で抗議。"
msgstr ""

#. Occurrence 8_1:2074:10561: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0019; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2074
msgctxt "text_id=10561 | speaker=tobimaru"
msgid "「っ―――その余裕、マジか……女に興味なさそうな顔してて、やる事やってんじゃねえかテメエ」"
msgstr ""

#. Occurrence 8_1:2080:10562: scene=8_1
#: 8_1:2080
msgctxt "text_id=10562 | speaker=unknown"
msgid "　物理的に先を越された訳でもないのに、なぜか精神的に先を越された気がする鳶丸だった。"
msgstr ""

#. Occurrence 8_1:2085:10563: scene=8_1
#: 8_1:2085
msgctxt "text_id=10563 | speaker=unknown"
msgid "　そんな彼に、草十郎は珍しく怒りの視線を向ける。"
msgstr ""

#. Occurrence 8_1:2111:10564: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0013; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2111
msgctxt "text_id=10564 | speaker=soujuurou"
msgid "「こっちこそ聞き捨てならない。"
msgstr ""

#. Occurrence 8_1:2117:10565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0014; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2117
msgctxt "text_id=10565 | speaker=soujuurou"
msgid "　なんだ、その女に興味はないってのは」"
msgstr ""

#. Occurrence 8_1:2123:10566: scene=8_1
#: 8_1:2123
msgctxt "text_id=10566 | speaker=unknown"
msgid "　本気で怒っているらしく言葉も冷たい。"
msgstr ""

#. Occurrence 8_1:2128:10567: scene=8_1
#: 8_1:2128
msgctxt "text_id=10567 | speaker=unknown"
msgid "　草十郎のかつてない不機嫌さに、鳶丸も平静さを取り戻す。"
msgstr ""

#. Occurrence 8_1:2155:10568: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_0; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2155
msgctxt "text_id=10568 | speaker=tobimaru"
msgid "「いや、悪い。そんな雰囲気あったんだよ、おまえさんは。それは謝る。"
msgstr ""

#. Occurrence 8_1:2167:10569: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_1; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2167
msgctxt "text_id=10569 | speaker=tobimaru"
msgid "けどよ、蒼崎と一緒に住んでるってどういうことだ？　いくらなんでも<一足|いっそく>飛びすぎだろ」"
msgstr ""

#. Occurrence 8_1:2193:10570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0015; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2193
msgctxt "text_id=10570 | speaker=soujuurou"
msgid "「別に、君が期待しているような事はない。彼女が住んでいるところの部屋を借りる事になっただけだ。"
msgstr ""

#. Occurrence 8_1:2199:10571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0016; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2199
msgctxt "text_id=10571 | speaker=soujuurou"
msgid "　屋根の裏にある部屋なんだけど、板張で山小屋を思い出すんで気に入ってる」"
msgstr ""

#. Occurrence 8_1:2205:10572: scene=8_1
#: 8_1:2205
msgctxt "text_id=10572 | speaker=unknown"
msgid "　それは屋根裏部屋というのだが、あえて鳶丸はスルーした。"
msgstr ""

#. Occurrence 8_1:2239:10573: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0021; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2239
msgctxt "text_id=10573 | speaker=tobimaru"
msgid "「屋敷って、あの久遠寺の屋敷か……？"
msgstr ""

#. Occurrence 8_1:2245:10574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0022; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2245
msgctxt "text_id=10574 | speaker=tobimaru"
msgid "　それこそまさかだぜ。草十郎。おまえ、いったいどんな手品を使いやがった？」"
msgstr ""

#. Occurrence 8_1:2251:10575: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0017; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2251
msgctxt "text_id=10575 | speaker=soujuurou"
msgid "「？　鳶丸こそ、あの家を知ってるのか？」"
msgstr ""

#. Occurrence 8_1:2257:10576: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0023; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2257
msgctxt "text_id=10576 | speaker=tobimaru"
msgid "「そりゃあな。これでも槻司家期待の跡取り候補だぜ、俺は。久遠寺グループのご令嬢が住んでる屋敷ぐらいは知ってるさ。礼園女学院の二年生だろ、たしか」"
msgstr ""

#. Occurrence 8_1:2289:10577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0018; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2289
msgctxt "text_id=10577 | speaker=soujuurou"
msgid "「久遠寺……なに？」"
msgstr ""

#. Occurrence 8_1:2294:10578: scene=8_1
#: 8_1:2294
msgctxt "text_id=10578 | speaker=unknown"
msgid "　ますます首をかしげる草十郎に、鳶丸はやれやれと説明を続けた。もちろん、草十郎が分かるレベルに落としこんで。"
msgstr ""

#. Occurrence 8_1:2327:10579: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0024; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2327
msgctxt "text_id=10579 | speaker=tobimaru"
msgid "「久遠寺グループ……つーか財団だな。"
msgstr ""

#. Occurrence 8_1:2333:10580: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0025; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2333
msgctxt "text_id=10580 | speaker=tobimaru"
msgid "　平たく言えば一族全部がお金持ちで、仲良く会社を経営してる連中だと思えばいい。複合企業とまではいかないが、輸出業じゃあかなりのもんだ」"
msgstr ""

#. Occurrence 8_1:2354:10581: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0026; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2354
msgctxt "text_id=10581 | speaker=tobimaru"
msgid "「ホームグラウンドは国外で、先代の会長の英国びいきがたたって一時期は沈みかけてたんだが、五年くらい前かね。本拠地をこっちに移してからはご存じの通りだ。"
msgstr ""

#. Occurrence 8_1:2360:10582: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0027; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2360
msgctxt "text_id=10582 | speaker=tobimaru"
msgid "　会長が息子に移ってからはきちんと持ち直して、今や町の名士だろ。ここでも久遠寺の名前はそこかしこで目に入る。この学校の建て直し予算の半分は連中からだしな」"
msgstr ""

#. Occurrence 8_1:2392:10583: scene=8_1
#: 8_1:2392
msgctxt "text_id=10583 | speaker=unknown"
msgid "　極めて簡単に言ったのだが、それでも草十郎には早すぎたようだ。"
msgstr ""

#. Occurrence 8_1:2397:10584: scene=8_1
#: 8_1:2397
msgctxt "text_id=10584 | speaker=unknown"
msgid "　仕方なく鳶丸は話をきる。"
msgstr ""

#. Occurrence 8_1:2430:10585: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0028; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2430
msgctxt "text_id=10585 | speaker=tobimaru"
msgid "「あれだ、想像もできない金持ちってコト。"
msgstr ""

#. Occurrence 8_1:2436:10586: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0029; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2436
msgctxt "text_id=10586 | speaker=tobimaru"
msgid "　草の字が働いてる喫茶店だって、久遠寺が向こうから持ってきたブランドだぜ？　今じゃ全国チェーンになっちまったがな」"
msgstr ""

#. Occurrence 8_1:2442:10587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0019; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2442
msgctxt "text_id=10587 | speaker=soujuurou"
msgid "「つまりすごく偉いんだね。……おかしいな、ならなんであんなに倹約してるんだろう……」"
msgstr ""

#. Occurrence 8_1:2457:10588: scene=8_1
#: 8_1:2457
msgctxt "text_id=10588 | speaker=unknown"
msgid "　ぶつぶつと呟く草十郎。"
msgstr ""

#. Occurrence 8_1:2462:10589: scene=8_1
#: 8_1:2462
msgctxt "text_id=10589 | speaker=unknown"
msgid "　そんな草十郎に、鳶丸は羨ましいような、心底から同情しているような、複雑な顔を向ける。"
msgstr ""

#. Occurrence 8_1:2483:10590: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0030; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2483
msgctxt "text_id=10590 | speaker=tobimaru"
msgid "「しっかし、うまい事やったな草十郎。"
msgstr ""

#. Occurrence 8_1:2503:10591: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0031; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2503
msgctxt "text_id=10591 | speaker=tobimaru"
msgid "　それで、本当のところはどうなんだ？　男と女が同じ屋根の下にいれば、やる事はひとつだろう？」"
msgstr ""

#. Occurrence 8_1:2514:10592: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0020; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2514
msgctxt "text_id=10592 | speaker=soujuurou"
msgid "「あんがい古いな、鳶丸も」"
msgstr ""

#. Occurrence 8_1:2525:10593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0032; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2525
msgctxt "text_id=10593 | speaker=tobimaru"
msgid "「ぬかせ。そのあたりを誤魔化してたら男なんざやってらんねえ」"
msgstr ""

#. Occurrence 8_1:2536:10594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0021; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2536
msgctxt "text_id=10594 | speaker=soujuurou"
msgid "「そりゃごもっとも。実を言うと、正直な話―――」"
msgstr ""

#. Occurrence 8_1:2574:10595: scene=8_1
#: 8_1:2574
msgctxt "text_id=10595 | speaker=unknown"
msgid "　今のところまったく色気のない雑居ではあるが、同じ家で生活している以上、不意打ち気味のニアミスはある。"
msgstr ""

#. Occurrence 8_1:2579:10596: scene=8_1
#: 8_1:2579
msgctxt "text_id=10596 | speaker=unknown"
msgid "　あるのではあるが、しかし―――"
msgstr ""

#. Occurrence 8_1:2618:10597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10597 | speaker=soujuurou"
msgid "「驚くぐらい、そういうコトにはなってない。"
msgstr ""

#. Occurrence 8_1:2618:10598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10598 | speaker=soujuurou"
msgid "　あの屋敷、すごく広いし」"
msgstr ""

#. Occurrence 8_1:2624:10599: scene=8_1
#: 8_1:2624
msgctxt "text_id=10599 | speaker=unknown"
msgid "　青子たちも草十郎も私用で忙しいため、そんな浮き足だった状況にはなっていなかった。"
msgstr ""

#. Occurrence 8_1:2650:10600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0023; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2650
msgctxt "text_id=10600 | speaker=soujuurou"
msgid "「そもそもだな。もし鳶丸だったら、下宿先が同じって理由だけで、蒼崎に言い寄る気になるかい？」"
msgstr ""

#. Occurrence 8_1:2661:10601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0033; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2661
msgctxt "text_id=10601 | speaker=tobimaru"
msgid "「……いや。ならねえな、そりゃあ」"
msgstr ""

#. Occurrence 8_1:2666:10602: scene=8_1
#: 8_1:2666
msgctxt "text_id=10602 | speaker=unknown"
msgid "　数々の彼女の戦歴を思い出しているのか、感慨深くうなずく鳶丸。"
msgstr ""

#. Occurrence 8_1:2710:10603: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0034; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2710
msgctxt "text_id=10603 | speaker=tobimaru"
msgid "「いや、健全だな」"
msgstr ""

#. Occurrence 8_1:2716:10604: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0024; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2716
msgctxt "text_id=10604 | speaker=soujuurou"
msgid "「ああ、健全だろ」"
msgstr ""

#. Occurrence 8_1:2722:10605: scene=8_1
#: 8_1:2722
msgctxt "text_id=10605 | speaker=unknown"
msgid "　虚脱感のある鳶丸の呟きに、のんびりと焚火にあたりながら短く同意する草十郎。"
msgstr ""

#. Occurrence 8_1:2727:10606: scene=8_1
#: 8_1:2727
msgctxt "text_id=10606 | speaker=unknown"
msgid "　もっとも。"
msgstr ""

#. Occurrence 8_1:2732:10607: scene=8_1
#: 8_1:2732
msgctxt "text_id=10607 | speaker=unknown"
msgid "　健全であるかは別にして、あの洋館に寝泊りし、青子と有珠相手に平静を保てているのは、間違いなく草十郎の<人柄|さいのう>だろう。"
msgstr ""

#. Occurrence 8_1:2765:10608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0025; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2765
msgctxt "text_id=10608 | speaker=soujuurou"
msgid "「でも、それとは別の話で蒼崎には頭があがらないんだ。"
msgstr ""

#. Occurrence 8_1:2771:10609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0026; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2771
msgctxt "text_id=10609 | speaker=soujuurou"
msgid "　彼女には、もう返せない借りがあってさ」"
msgstr ""

#. Occurrence 8_1:2777:10610: scene=8_1
#: 8_1:2777
msgctxt "text_id=10610 | speaker=unknown"
msgid "　ぼんやりとしていた彼の瞳が、少しだけ真剣になって焚火を見詰める。"
msgstr ""

#. Occurrence 8_1:2782:10611: scene=8_1
#: 8_1:2782
msgctxt "text_id=10611 | speaker=unknown"
msgid "　それが額面通りの意味でない事は、鳶丸にも感じ取れた。"
msgstr ""

#. Occurrence 8_1:2803:10612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0035; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2803
msgctxt "text_id=10612 | speaker=tobimaru"
msgid "「もう返せない借りだあ？」"
msgstr ""

#. Occurrence 8_1:2809:10613: scene=8_1
#: 8_1:2809
msgctxt "text_id=10613 | speaker=unknown"
msgid "　繰り返す鳶丸に、草十郎は無言でうなずく。"
msgstr ""

#. Occurrence 8_1:2827:10614: scene=8_1
#: 8_1:2827
msgctxt "text_id=10614 | speaker=unknown"
msgid "　―――と。"
msgstr ""

#. Occurrence 8_1:2832:10615: scene=8_1
#: 8_1:2832
msgctxt "text_id=10615 | speaker=unknown"
msgid "　深刻な沈黙を破るように、森の奥から妙な叫び声が届いてきた。"
msgstr ""

#. Occurrence 8_1:2858:10616: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0036; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2858
msgctxt "text_id=10616 | speaker=tobimaru"
msgid "「……なんか聞こえたな？」"
msgstr ""

#. Occurrence 8_1:2867:10617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0027; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2867
msgctxt "text_id=10617 | speaker=soujuurou"
msgid "「ああ、木乃美だ」"
msgstr ""

#. Occurrence 8_1:2873:10618: scene=8_1
#: 8_1:2873
msgctxt "text_id=10618 | speaker=unknown"
msgid "　答えるより早く草十郎は立ち上がる。"
msgstr ""

#. Occurrence 8_1:2892:10619: scene=8_1
#: 8_1:2892
msgctxt "text_id=10619 | speaker=unknown"
msgid "　そのまま凍った池まで走り、竹ぼうきで氷を叩き割り、"
msgstr ""

msgctxt "text_id=10620 | speaker=unknown"
msgid "バケツに水を汲んで焚火にぶちまける。十秒足らずの早技だった。"
msgstr ""

#. Occurrence 8_1:2915:10621: scene=8_1
#: 8_1:2915
msgctxt "text_id=10621 | speaker=unknown"
msgid "　草十郎は絶叫が聞こえた森の奥へと走り出す。"
msgstr ""

#. Occurrence 8_1:2920:10622: scene=8_1
#: 8_1:2920
msgctxt "text_id=10622 | speaker=unknown"
msgid "　何事かとあわてながら鳶丸も後を追う。"
msgstr ""

#. Occurrence 8_1:2971:10623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0028; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2971
msgctxt "text_id=10623 | speaker=soujuurou"
msgid "「鳶丸、この先に何かあるのか？」"
msgstr ""

#. Occurrence 8_1:2977:10624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0037; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2977
msgctxt "text_id=10624 | speaker=tobimaru"
msgid "「たしか旧校舎が残ってるはずだ」"
msgstr ""

#. Occurrence 8_1:2983:10625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0029; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2983
msgctxt "text_id=10625 | speaker=soujuurou"
msgid "「他には？　野犬の住みかとか、そういうイヤな話は？」"
msgstr ""

#. Occurrence 8_1:2989:10626: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0038; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2989
msgctxt "text_id=10626 | speaker=tobimaru"
msgid "「はあ？　いや、いるとしても鹿か兎じゃねえか？」"
msgstr ""

#. Occurrence 8_1:2995:10627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0030; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2995
msgctxt "text_id=10627 | speaker=soujuurou"
msgid "「なら怖がるコトもないか。急ごう、鳶丸」"
msgstr ""

#. Occurrence 8_1:3015:10628: scene=8_1
#: 8_1:3015
msgctxt "text_id=10628 | speaker=unknown"
msgid "　山育ちで慣れているのか、草十郎は腐葉土の上でも軽々と走っていく。"
msgstr ""

#. Occurrence 8_1:3020:10629: scene=8_1
#: 8_1:3020
msgctxt "text_id=10629 | speaker=unknown"
msgid "　鳶丸も足には自信がある方だが、森の中では草十郎には付いていけない。"
msgstr ""

#. Occurrence 8_1:3066:10630: scene=8_1
#: 8_1:3066
msgctxt "text_id=10630 | speaker=unknown"
msgid "　そうして、いつしか草十郎はひとりきりで走っていた。"
msgstr ""

#. Occurrence 8_1:3071:10631: scene=8_1
#: 8_1:3071
msgctxt "text_id=10631 | speaker=unknown"
msgid "　木々の葉で閉ざされた獣道を、時には両手で力強く払い除けながら、時には柳のように擦り抜けながら。"
msgstr ""

#. Occurrence 8_1:3076:10632: scene=8_1
#: 8_1:3076
msgctxt "text_id=10632 | speaker=unknown"
msgid "　この程度の緑の深さなら慣れたものらしい。"
msgstr ""

#. Occurrence 8_1:3125:10633: scene=8_1
#: 8_1:3125
msgctxt "text_id=10633 | speaker=unknown"
msgid "　数分後、草十郎はその広場に辿り着いた。"
msgstr ""

#. Occurrence 8_1:3130:10634: scene=8_1
#: 8_1:3130
msgctxt "text_id=10634 | speaker=unknown"
msgid "　木々の壁はここで終わっている。"
msgstr ""

#. Occurrence 8_1:3135:10635: scene=8_1
#: 8_1:3135
msgctxt "text_id=10635 | speaker=unknown"
msgid "　山の中腹に<拓|ひら>かれた人工の広場。"
msgstr ""

#. Occurrence 8_1:3140:10636: scene=8_1
#: 8_1:3140
msgctxt "text_id=10636 | speaker=unknown"
msgid "　遠くに見える木造の建物が旧校舎だろう。"
msgstr ""

#. Occurrence 8_1:3145:10637: scene=8_1
#: 8_1:3145
msgctxt "text_id=10637 | speaker=unknown"
msgid "　小学校ほどの、小さいが趣のある建物が、人知れず冬の荒れ野に埋没していた。"
msgstr ""

#. Occurrence 8_1:3178:10638: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0031; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3178
msgctxt "text_id=10638 | speaker=soujuurou"
msgid "「木乃美」"
msgstr ""

#. Occurrence 8_1:3183:10639: scene=8_1
#: 8_1:3183
msgctxt "text_id=10639 | speaker=unknown"
msgid "　その旧校舎のグラウンドに、木乃美はひとりで立ちつくしていた。"
msgstr ""

#. Occurrence 8_1:3192:10640: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0020; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3192
msgctxt "text_id=10640 | speaker=kinomi"
msgid "「お？　なんで静希まで追いかけてきたん？」"
msgstr ""

#. Occurrence 8_1:3197:10641: scene=8_1
#: 8_1:3197
msgctxt "text_id=10641 | speaker=unknown"
msgid "　不思議そうに首をかしげる木乃美に、草十郎はむっと顔をしかめる。"
msgstr ""

#. Occurrence 8_1:3203:10642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0032; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3203
msgctxt "text_id=10642 | speaker=soujuurou"
msgid "「そっちこそどうしたんだ。へんな声あげて」"
msgstr ""

#. Occurrence 8_1:3234:10643: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0021; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3234
msgctxt "text_id=10643 | speaker=kinomi"
msgid "「声ぇ？　いや、そりゃガキ相手に怒鳴ったけどよ。"
msgstr ""

#. Occurrence 8_1:3240:10644: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0022; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3240
msgctxt "text_id=10644 | speaker=kinomi"
msgid "　ほら、あのガキだよ。イモ持ってるだろ……ってああ、中に逃げこみやがった！」"
msgstr ""

#. Occurrence 8_1:3246:10645: scene=8_1
#: 8_1:3246
msgctxt "text_id=10645 | speaker=unknown"
msgid "　旧校舎を指差しながら<憤慨|ふんがい>する木乃美。"
msgstr ""

#. Occurrence 8_1:3251:10646: scene=8_1
#: 8_1:3251
msgctxt "text_id=10646 | speaker=unknown"
msgid "　確かに、百メートルほど離れた旧校舎の入り口に、人影らしきものが立っている。"
msgstr ""

#. Occurrence 8_1:3277:10647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0023; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3277
msgctxt "text_id=10647 | speaker=kinomi"
msgid "「ったく、こんな上まで来やがって。いつから子供の遊び場になってんだ、ここ」"
msgstr ""

#. Occurrence 8_1:3283:10648: scene=8_1
#: 8_1:3283
msgctxt "text_id=10648 | speaker=unknown"
msgid "　まあどうでもいいけど、と木乃美は肩をすくめる。"
msgstr ""

#. Occurrence 8_1:3288:10649: scene=8_1
#: 8_1:3288
msgctxt "text_id=10649 | speaker=unknown"
msgid "　ここの森は深くはあるが、遭難するほどの場所でもない。"
msgstr ""

#. Occurrence 8_1:3293:10650: scene=8_1
#: 8_1:3293
msgctxt "text_id=10650 | speaker=unknown"
msgid "　草十郎は森の中をつっきってきたが、外にはコンクリートで舗装された道があるのだ。"
msgstr ""

#. Occurrence 8_1:3298:10651: scene=8_1
#: 8_1:3298
msgctxt "text_id=10651 | speaker=unknown"
msgid "　木乃美はそちらを使って登ってきたようだ。"
msgstr ""

#. Occurrence 8_1:3333:10652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0033; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3333
msgctxt "text_id=10652 | speaker=soujuurou"
msgid "「んー……子供………？」"
msgstr ""

#. Occurrence 8_1:3338:10653: scene=8_1
#: 8_1:3338
msgctxt "text_id=10653 | speaker=unknown"
msgid "　目を細めて草十郎は呟く。"
msgstr ""

#. Occurrence 8_1:3356:10654: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0024; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3356
msgctxt "text_id=10654 | speaker=kinomi"
msgid "「ああ。金髪なんでさっきはちょっと驚いたけどな。外国人の子供って、なんか怖いだろ？」"
msgstr ""

#. Occurrence 8_1:3376:10655: scene=8_1
#: 8_1:3376
msgctxt "text_id=10655 | speaker=unknown"
msgid "　地方都市において、まだ外国人の姿は珍しい。"
msgstr ""

#. Occurrence 8_1:3381:10656: scene=8_1
#: 8_1:3381
msgctxt "text_id=10656 | speaker=unknown"
msgid "　テレビならいざしらず、生で外国の子供を見た事がない草十郎にはよけい不思議な感覚だった。"
msgstr ""

#. Occurrence 8_1:3419:10657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0034; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3419
msgctxt "text_id=10657 | speaker=soujuurou"
msgid "「それで、木乃美はなんでここまで？」"
msgstr ""

#. Occurrence 8_1:3439:10658: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0025; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3439
msgctxt "text_id=10658 | speaker=kinomi"
msgid "「いや、赤羽たちがよ、ガキに食料奪われたって言うからここまで追いかけてきたんだ。"
msgstr ""

#. Occurrence 8_1:3446:10659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0026; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3446
msgctxt "text_id=10659 | speaker=kinomi"
msgid "そういう事だから、ふたりがかりであのお子さまとっちめようぜ」"
msgstr ""

#. Occurrence 8_1:3464:10660: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0035; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3464
msgctxt "text_id=10660 | speaker=soujuurou"
msgid "「怖いことを考えるな、木乃美は」"
msgstr ""

#. Occurrence 8_1:3470:10661: scene=8_1
#: 8_1:3470
msgctxt "text_id=10661 | speaker=unknown"
msgid "　賛同しかねる、と草十郎。"
msgstr ""

#. Occurrence 8_1:3475:10662: scene=8_1
#: 8_1:3475
msgctxt "text_id=10662 | speaker=unknown"
msgid "　<多勢|たぜい>に<無勢|ぶぜい>は義に反する、といわんばかりである。"
msgstr ""

#. Occurrence 8_1:3501:10663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0036; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3501
msgctxt "text_id=10663 | speaker=soujuurou"
msgid "「いいから帰ろう。あの子、こっちを睨んでるじゃないか。"
msgstr ""

#. Occurrence 8_1:3507:10664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0037; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3507
msgctxt "text_id=10664 | speaker=soujuurou"
msgid "　それに、鳶丸にこんなところ見られたら冬休み中ずっと山の掃除で終わる事になるぞ？」"
msgstr ""

#. Occurrence 8_1:3542:10665: scene=8_1
#: 8_1:3542
msgctxt "text_id=10665 | speaker=unknown"
msgid "　ぽん、と木乃美の肩に手を置いて、草十郎はもと来た道を戻りはじめた。"
msgstr ""

#. Occurrence 8_1:3547:10666: scene=8_1
#: 8_1:3547
msgctxt "text_id=10666 | speaker=unknown"
msgid "　木乃美は口惜しげに旧校舎に視線を投げて、草十郎に付いていく。"
msgstr ""

#. Occurrence 8_1:3579:10667: scene=8_1
#: 8_1:3579
msgctxt "text_id=10667 | speaker=unknown"
msgid "　そんなふたりを出迎えるように、息を切らした鳶丸が登ってきた。"
msgstr ""

#. Occurrence 8_1:3613:10668: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0039; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3613
msgctxt "text_id=10668 | speaker=tobimaru"
msgid "「は、速いな、草十郎」"
msgstr ""

#. Occurrence 8_1:3619:10669: scene=8_1
#: 8_1:3619
msgctxt "text_id=10669 | speaker=unknown"
msgid "　鳶丸の息は乱れている。"
msgstr ""

#. Occurrence 8_1:3624:10670: scene=8_1
#: 8_1:3624
msgctxt "text_id=10670 | speaker=unknown"
msgid "　草十郎に遅れること三分弱だが、十分に健脚だ。"
msgstr ""

#. Occurrence 8_1:3645:10671: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0040; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3645
msgctxt "text_id=10671 | speaker=tobimaru"
msgid "「それでどうした。木乃美、無事か？」"
msgstr ""

#. Occurrence 8_1:3666:10672: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0027; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3666
msgctxt "text_id=10672 | speaker=kinomi"
msgid "「？　無事も何も、殿下こそどったん？」"
msgstr ""

#. Occurrence 8_1:3672:10673: scene=8_1
#: 8_1:3672
msgctxt "text_id=10673 | speaker=unknown"
msgid "　鳶丸に心配されるコトなど初めてなのか、目をしばたたく木乃美。"
msgstr ""

#. Occurrence 8_1:3709:10674: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0041; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3709
msgctxt "text_id=10674 | speaker=tobimaru"
msgid "「なんだそりゃ。テメェ、あれだけの大声をあげておいてしらばっくれる気か？　上で何かあったんだろうが」"
msgstr ""

#. Occurrence 8_1:3737:10675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0038; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3737
msgctxt "text_id=10675 | speaker=soujuurou"
msgid "「すまない、こっちの早とちりだった。"
msgstr ""

#. Occurrence 8_1:3743:10676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0039; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3743
msgctxt "text_id=10676 | speaker=soujuurou"
msgid "　鳶丸は知らないだろうけど、木乃美は時々、バイト先でも奇声をあげる癖があるんだ」"
msgstr ""

#. Occurrence 8_1:3748:10677: scene=8_1
#: 8_1:3748
msgctxt "text_id=10677 | speaker=unknown"
msgid "　堂々と言う草十郎の横で、木乃美は不満げに顔をしかめる。彼的に、そんな噂は初耳だった。"
msgstr ""

#. Occurrence 8_1:3792:10678: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0042; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3792
msgctxt "text_id=10678 | speaker=tobimaru"
msgid "「……怪しいな。また良からぬ事でも企んでるんじゃねえか、そこの？」"
msgstr ""

#. Occurrence 8_1:3809:10679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0040; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3809
msgctxt "text_id=10679 | speaker=soujuurou"
msgid "「無いよ。戻って掃除の続きをするぞ、鳶丸」"
msgstr ""

#. Occurrence 8_1:3815:10680: scene=8_1
#: 8_1:3815
msgctxt "text_id=10680 | speaker=unknown"
msgid "　ぽんぽんと鳶丸の肩を叩いて草十郎は歩きだす。"
msgstr ""

#. Occurrence 8_1:3820:10681: scene=8_1
#: 8_1:3820
msgctxt "text_id=10681 | speaker=unknown"
msgid "　そんな草十郎に、鳶丸は不審げな眼差しを向けた。"
msgstr ""

#. Occurrence 8_1:3825:10682: scene=8_1
#: 8_1:3825
msgctxt "text_id=10682 | speaker=unknown"
msgid "　なんとなく、草十郎が木乃美の悪事を<庇|かば>っているように思えたからだ。"
msgstr ""

#. Occurrence 8_1:3861:10683: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0043; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3861
msgctxt "text_id=10683 | speaker=tobimaru"
msgid "「まさか、旧校舎に火なんてつけてないだろうな？」"
msgstr ""

#. Occurrence 8_1:3867:10684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0041; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3867
msgctxt "text_id=10684 | speaker=soujuurou"
msgid "「誰もしないよ、そんな事は」"
msgstr ""

#. Occurrence 8_1:3874:10685: scene=8_1
#: 8_1:3874
msgctxt "text_id=10685 | speaker=unknown"
msgid "　さっさと掃除に戻りたいらしく、草十郎は背後の鳶丸を振り向きもせず歩いていく。"
msgstr ""

#. Occurrence 8_1:3879:10686: scene=8_1
#: 8_1:3879
msgctxt "text_id=10686 | speaker=unknown"
msgid "　鳶丸と木乃美は首をかしげながらも、めずらしく強引な草十郎に従った。"
msgstr ""

#. Occurrence 8_2:47:10687: scene=8_2
#: 8_2:47
msgctxt "text_id=10687 | speaker=unknown"
msgid "　これといった快事も不祥事もなく、本日の特別清掃班の活動は終了した。"
msgstr ""

#. Occurrence 8_2:52:10688: scene=8_2
#: 8_2:52
msgctxt "text_id=10688 | speaker=unknown"
msgid "　ただいまの時刻、午後三時。"
msgstr ""

#. Occurrence 8_2:57:10689: scene=8_2
#: 8_2:57
msgctxt "text_id=10689 | speaker=unknown"
msgid "　別れ際、草十郎は木乃美たちから遊びに誘われたが、夕方からアルバイトが入っている、と丁寧に断った。"
msgstr ""

#. Occurrence 8_2:78:10690: scene=8_2
#: 8_2:78
msgctxt "text_id=10690 | speaker=unknown"
msgid "　夕方からのバイトまであと二時間ほど。"
msgstr ""

#. Occurrence 8_2:83:10691: scene=8_2
#: 8_2:83
msgctxt "text_id=10691 | speaker=unknown"
msgid "　遊ぶほどの時間はないが、さりとて、暇つぶしには持て余す長さと言える。"
msgstr ""

#. Occurrence 8_2:110:10692: scene=8_2
#: 8_2:110
msgctxt "text_id=10692 | speaker=unknown"
msgid "　公園で体を休める、という考えも浮かんだが、町中でも冬の寒さはそれなりに堪えるので却下。"
msgstr ""

#. Occurrence 8_2:130:10693: scene=8_2
#: 8_2:130
msgctxt "text_id=10693 | speaker=unknown"
msgid "　ちなみに、例の錠剤は朝のうちに青子から手渡されていた。"
msgstr ""

#. Occurrence 8_2:135:10694: scene=8_2
#: 8_2:135
msgctxt "text_id=10694 | speaker=unknown"
msgid "　青子の読みはまったく正しい。今から洋館に戻ってもすぐとんぼ返りになるだけである。"
msgstr ""

#. Occurrence 8_2:140:10695: scene=8_2
#: 8_2:140
msgctxt "text_id=10695 | speaker=unknown"
msgid "　骨折り損のなんとやらで、アルバイトを終えるまで洋館に戻る必要はまったくない。"
msgstr ""

#. Occurrence 8_2:183:10696: scene=8_2
#: 8_2:183
msgctxt "text_id=10696 | speaker=unknown"
msgid "　―――まったくないのだが、草十郎はすんなり帰途についていた。"
msgstr ""

#. Occurrence 8_2:188:10697: scene=8_2
#: 8_2:188
msgctxt "text_id=10697 | speaker=unknown"
msgid "　山奥育ちにとって、二時間程度の散歩は苦でもなんでもないのである。"
msgstr ""

#. Occurrence 8_2:221:10698: scene=8_2
#: 8_2:221
msgctxt "text_id=10698 | speaker=unknown"
msgid "　この三咲町は三咲市の中でも閑静な住宅地に入る。"
msgstr ""

#. Occurrence 8_2:226:10699: scene=8_2
#: 8_2:226
msgctxt "text_id=10699 | speaker=unknown"
msgid "　その中でひときわ異質なのがここ白犬塚だ。"
msgstr ""

#. Occurrence 8_2:231:10700: scene=8_2
#: 8_2:231
msgctxt "text_id=10700 | speaker=unknown"
msgid "　森に向かうひとつきりの坂道。"
msgstr ""

#. Occurrence 8_2:236:10701: scene=8_2
#: 8_2:236
msgctxt "text_id=10701 | speaker=unknown"
msgid "　住宅地の奥にそびえる山影は、物言わずとも人々の営みを威圧している。"
msgstr ""

#. Occurrence 8_2:256:10702: scene=8_2
#: 8_2:256
msgctxt "text_id=10702 | speaker=unknown"
msgid "　近代化の進む現代においても、自然への<崇拝|すうはい>は住民たちの心に根付いている。"
msgstr ""

#. Occurrence 8_2:261:10703: scene=8_2
#: 8_2:261
msgctxt "text_id=10703 | speaker=unknown"
msgid "　あの洋館も、何らかの<社|やしろ>であれば幽霊屋敷などではなく、霊験あらたかな観光名所になっていたかもしれない。"
msgstr ""

#. Occurrence 8_2:282:10704: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0000; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:282
msgctxt "text_id=10704 | speaker=soujuurou"
msgid "「……というより、今さら気付いたけど……」"
msgstr ""

#. Occurrence 8_2:288:10705: scene=8_2
#: 8_2:288
msgctxt "text_id=10705 | speaker=unknown"
msgid "　白犬塚周辺の家は、どれもたいへん立派である。"
msgstr ""

#. Occurrence 8_2:293:10706: scene=8_2
#: 8_2:293
msgctxt "text_id=10706 | speaker=unknown"
msgid "　人々の住む坂の下から、森の中にある洋館の屋根を見上げ、なるほど、と草十郎は納得した。"
msgstr ""

#. Occurrence 8_2:298:10707: scene=8_2
#: 8_2:298
msgctxt "text_id=10707 | speaker=unknown"
msgid "　鳶丸の言う通り、あの洋館を所有する久遠寺家はこの町一番のお金持ちなのだ、と。"
msgstr ""

#. Occurrence 8_2:319:10708: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0001; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:319
msgctxt "text_id=10708 | speaker=soujuurou"
msgid "「……そのわりに家賃を取るところを見ると、やっぱり嫌われていると見るべきか」"
msgstr ""

#. Occurrence 8_2:325:10709: scene=8_2
#: 8_2:325
msgctxt "text_id=10709 | speaker=unknown"
msgid "　ふむ、とそんな事を考えつつ、草十郎は洋館への坂道を歩きはじめた。"
msgstr ""

#. Occurrence 8_2:330:10710: scene=8_2
#: 8_2:330
msgctxt "text_id=10710 | speaker=unknown"
msgid "　土の感触のないアスファルトの道が少し<淋|さみ>しい。"
msgstr ""

#. Occurrence 8_2:375:10711: scene=8_2
#: 8_2:375
msgctxt "text_id=10711 | speaker=unknown"
msgid "　舗装された道を十分ほど歩いて、森の鉄柵にたどり着く。"
msgstr ""

#. Occurrence 8_2:380:10712: scene=8_2
#: 8_2:380
msgctxt "text_id=10712 | speaker=unknown"
msgid "　この先は久遠寺の私有地だ。"
msgstr ""

#. Occurrence 8_2:385:10713: scene=8_2
#: 8_2:385
msgctxt "text_id=10713 | speaker=unknown"
msgid "　関係者以外立ち入り禁止、といった不粋な看板はない。"
msgstr ""

#. Occurrence 8_2:390:10714: scene=8_2
#: 8_2:390
msgctxt "text_id=10714 | speaker=unknown"
msgid "　ただ、訪れた者の精神を圧迫する、いかつい鉄柵が<人避|ひとよ>けの結界となっている。"
msgstr ""

#. Occurrence 8_2:423:10715: scene=8_2
#: 8_2:423
msgctxt "text_id=10715 | speaker=unknown"
msgid "　そんな鉄柵を、草十郎は気軽に押し開ける。"
msgstr ""

#. Occurrence 8_2:428:10716: scene=8_2
#: 8_2:428
msgctxt "text_id=10716 | speaker=unknown"
msgid "　期末試験が終わってからまだ二日しか経っていないのに、ひとりでこの森に入る事に慣れきった風である。"
msgstr ""

#. Occurrence 8_2:458:10717: scene=8_2
#: 8_2:458
msgctxt "text_id=10717 | speaker=unknown"
msgid "　森から洋館までの林道は、やはり蛇のように曲がりくねっている。"
msgstr ""

#. Occurrence 8_2:463:10718: scene=8_2
#: 8_2:463
msgctxt "text_id=10718 | speaker=unknown"
msgid "　林道を使うと洋館の敷地まで約十五分。"
msgstr ""

#. Occurrence 8_2:468:10719: scene=8_2
#: 8_2:468
msgctxt "text_id=10719 | speaker=unknown"
msgid "　なだらかな坂道を無視して森を一直線に歩いてもいいのだが、その場合、疲労は何倍にもなる。火急の用でもないかぎり、林道を使うのが常識的だ。"
msgstr ""

#. Occurrence 8_2:542:10720: scene=8_2
#: 8_2:542
msgctxt "text_id=10720 | speaker=unknown"
msgid "　ロビーに入ると、居間から話し声が聞こえてきた。"
msgstr ""

#. Occurrence 8_2:547:10721: scene=8_2
#: 8_2:547
msgctxt "text_id=10721 | speaker=unknown"
msgid "　青子と有珠のものであるのは間違いなく、とりあえず草十郎は居間へと向かう。"
msgstr ""

#. Occurrence 8_2:582:10722: scene=8_2
#: 8_2:582
msgctxt "text_id=10722 | speaker=unknown"
msgid "　期末試験が終わった日から、青子と有珠の生活スタイルは日常から非日常へと切り替わっていた。"
msgstr ""

#. Occurrence 8_2:589:10723: scene=8_2
#: 8_2:589
msgctxt "text_id=10723 | speaker=unknown"
msgid "　青子が有珠の部屋……館の西館、左翼一帯……に行ったきり戻ってこなかったり、"
msgstr ""

#. Occurrence 8_2:596:10724: scene=8_2
#: 8_2:596
msgctxt "text_id=10724 | speaker=unknown"
msgid "　有珠が青子の部屋に入ったきり出てこなかったりと、"
msgstr ""

#. Occurrence 8_2:601:10725: scene=8_2
#: 8_2:601
msgctxt "text_id=10725 | speaker=unknown"
msgid "　絶対立ち入り禁止とされる屋敷裏手に回る廊下の先に向かったりと、草十郎の知らないところで絶賛活動中だ。"
msgstr ""

#. Occurrence 8_2:635:10726: scene=8_2
#: 8_2:635
msgctxt "text_id=10726 | speaker=unknown"
msgid "　もっとも、草十郎はそれに関わる気もないし、青子たちも関わらせる気もないので、今のところ問題はない。"
msgstr ""

#. Occurrence 8_2:640:10727: scene=8_2
#: 8_2:640
msgctxt "text_id=10727 | speaker=unknown"
msgid "　久遠寺邸はとりあえず平穏である。"
msgstr ""

#. Occurrence 8_2:698:10728: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0002; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:698
msgctxt "text_id=10728 | speaker=soujuurou"
msgid "「ただいま」"
msgstr ""

#. Occurrence 8_2:704:10729: scene=8_2
#: 8_2:704
msgctxt "text_id=10729 | speaker=unknown"
msgid "　草十郎は静かに居間の扉を開けた。"
msgstr ""

#. Occurrence 8_2:709:10730: scene=8_2
#: 8_2:709
msgctxt "text_id=10730 | speaker=unknown"
msgid "　お互い関わらないようにしているといっても、挨拶はきちんとする。それが彼の方針である。"
msgstr ""

#. Occurrence 8_2:744:10731: scene=8_2
#: 8_2:744
msgctxt "text_id=10731 | speaker=unknown"
msgid "　ふたりは向かい合うかたちでソファーに座っていた。"
msgstr ""

#. Occurrence 8_2:749:10732: scene=8_2
#: 8_2:749
msgctxt "text_id=10732 | speaker=unknown"
msgid "　テーブルの上には豪華な装飾をした、大きな鏡が置かれている。"
msgstr ""

#. Occurrence 8_2:754:10733: scene=8_2
#: 8_2:754
msgctxt "text_id=10733 | speaker=unknown"
msgid "　青子の服装は動きやすさを重視したもので、下はスカートではなくジーンズを穿いていた。"
msgstr ""

#. Occurrence 8_2:759:10734: scene=8_2
#: 8_2:759
msgctxt "text_id=10734 | speaker=unknown"
msgid "　そんな青子とは対照的に、有珠はいつもの黒衣のままだ。"
msgstr ""

#. Occurrence 8_2:764:10735: scene=8_2
#: 8_2:764
msgctxt "text_id=10735 | speaker=unknown"
msgid "　学校はとっくに休みに入っているというが、<頑|かたく>なにあの黒衣を通している。"
msgstr ""

#. Occurrence 8_2:800:10736: scene=8_2
#: 8_2:800
msgctxt "text_id=10736 | speaker=unknown"
msgid "　青子曰く、「単に面倒だからでしょ」とのコト。"
msgstr ""

#. Occurrence 8_2:805:10737: scene=8_2
#: 8_2:805
msgctxt "text_id=10737 | speaker=unknown"
msgid "　少しは違う服装を見たいな、と思う草十郎である。"
msgstr ""

#. Occurrence 8_2:836:10738: scene=8_2
#: 8_2:836
msgctxt "text_id=10738 | speaker=unknown"
msgid "　何か口論していたようで、居間の雰囲気はどこか張り詰めていた。"
msgstr ""

#. Occurrence 8_2:841:10739: scene=8_2
#: 8_2:841
msgctxt "text_id=10739 | speaker=unknown"
msgid "　草十郎の挨拶にも反応しない。"
msgstr ""

#. Occurrence 8_2:846:10740: scene=8_2
#: 8_2:846
msgctxt "text_id=10740 | speaker=unknown"
msgid "　ただ有珠がちらり、と草十郎に視線を向けただけだった。"
msgstr ""

#. Occurrence 8_2:876:10741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0000; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:876
msgctxt "text_id=10741 | speaker=aoko"
msgid "「じゃあ<陶川|とうかわ>の<支点|してん>は？　あそこの柱は白色だし、そう簡単には奪われないでしょう？」"
msgstr ""

#. Occurrence 8_2:890:10742: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10742 | speaker=alice"
msgid "「……ええ。今のところ陶川は侵食されていないけど、ひとつ隣りの<鈴穂|すずほ>の支点が消された以上、楽観はできないわ。"
msgstr ""

#. Occurrence 8_2:890:10743: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10743 | speaker=alice"
msgid "　残りの割り出しは今までより早くなる」"
msgstr ""

#. Occurrence 8_2:910:10744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0001; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:910
msgctxt "text_id=10744 | speaker=aoko"
msgid "「そっか。一個釣れれば、あとは芋づる式だもんね。"
msgstr ""

#. Occurrence 8_2:927:10745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0002; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:927
msgctxt "text_id=10745 | speaker=aoko"
msgid "　……反省したわ。甘く見てたのはこっちの方だった。ここからは、一週間単位の攻防になるわね」"
msgstr ""

#. Occurrence 8_2:963:10746: scene=8_2
#: 8_2:963
msgctxt "text_id=10746 | speaker=unknown"
msgid "　テーブルを挟んでの会話は続く。"
msgstr ""

#. Occurrence 8_2:968:10747: scene=8_2
#: 8_2:968
msgctxt "text_id=10747 | speaker=unknown"
msgid "　青子は帰ってきた草十郎を見ようともしない。"
msgstr ""

#. Occurrence 8_2:973:10748: scene=8_2
#: 8_2:973
msgctxt "text_id=10748 | speaker=unknown"
msgid "　それとも話に集中するため、気を配る必要性を感じていないだけか。"
msgstr ""

#. Occurrence 8_2:1017:10749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0003; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1017
msgctxt "text_id=10749 | speaker=aoko"
msgid "「……でも解せないな。"
msgstr ""

#. Occurrence 8_2:1023:10750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0004; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1023
msgctxt "text_id=10750 | speaker=aoko"
msgid "　あの夜に人形をだしてくるタイミングといい、隠し方だけは一級品なうちの支点を短期間で特定する事といい、コイツ、まず間違いなく市内に<隠れ家|アジト>を敷いてるわよね。"
msgstr ""

#. Occurrence 8_2:1029:10751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0005; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1029
msgctxt "text_id=10751 | speaker=aoko"
msgid "　なのになんで結界に異常がないんだろう。三咲市一帯の索敵網は、もう百年近く破られた事がないのに」"
msgstr ""

#. Occurrence 8_2:1058:10752: scene=8_2
#: 8_2:1058
msgctxt "text_id=10752 | speaker=unknown"
msgid "　爪をかむ青子に、有珠は小さくうなずいた。"
msgstr ""

#. Occurrence 8_2:1063:10753: scene=8_2
#: 8_2:1063
msgctxt "text_id=10753 | speaker=unknown"
msgid "　彼女も青子と同じ疑問を持っているらしい。"
msgstr ""

#. Occurrence 8_2:1090:10754: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0001; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1090
msgctxt "text_id=10754 | speaker=alice"
msgid "「……母もここの結界には触れなかった。"
msgstr ""

#. Occurrence 8_2:1096:10755: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0002; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1096
msgctxt "text_id=10755 | speaker=alice"
msgid "　三咲の結界をかいくぐるには貴女のお<祖父|じい>さんか、それ以上の技量を持つ魔術師でないと難しい。"
msgstr ""

#. Occurrence 8_2:1103:10756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0003; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1103
msgctxt "text_id=10756 | speaker=alice"
msgid "けど、それほどの魔術師なら逆に<魔力|けはい>は隠しきれない。"
msgstr ""

#. Occurrence 8_2:1115:10757: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0004; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1115
msgctxt "text_id=10757 | speaker=alice"
msgid "　……なにか特殊な<隠行法|おんぎょうほう>かもしれないわね。ここ数年、新しい<妖精環|サークル>の話は聞かないけど」"
msgstr ""

#. Occurrence 8_2:1151:10758: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0006; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1151
msgctxt "text_id=10758 | speaker=aoko"
msgid "「なに、シャーウッドの森？　<皐|メ><月|イ><の|キ><王|ン><様|グ>なら以前、有珠の霧が粉砕したじゃない。アレ以上の隠行があるっていうの？」"
msgstr ""

#. Occurrence 8_2:1170:10759: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0005; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1170
msgctxt "text_id=10759 | speaker=alice"
msgid "「例えばの話よ。今回の相手はこちら以上の技量を持っているか、こちらの知らない技術を持っているか。"
msgstr ""

#. Occurrence 8_2:1188:10760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0006; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1188
msgctxt "text_id=10760 | speaker=alice"
msgid "　どちらにせよ評価を改めるべきね。わたしたち、気づかないうちに追い詰められているのかも」"
msgstr ""

#. Occurrence 8_2:1218:10761: scene=8_2
#: 8_2:1218
msgctxt "text_id=10761 | speaker=unknown"
msgid "　ふたりはそれきり黙りこむ。"
msgstr ""

#. Occurrence 8_2:1223:10762: scene=8_2
#: 8_2:1223
msgctxt "text_id=10762 | speaker=unknown"
msgid "　草十郎はしばし迷ってから、もう一度声をかけてみる事にした。"
msgstr ""

#. Occurrence 8_2:1258:10763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0003; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1258
msgctxt "text_id=10763 | speaker=soujuurou"
msgid "「やあ、ただいま」"
msgstr ""

#. Occurrence 8_2:1263:10764: scene=8_2
#: 8_2:1263
msgctxt "text_id=10764 | speaker=unknown"
msgid "　遠慮がちなその一言に、青子はようやく草十郎に視線を向けた。"
msgstr ""

#. Occurrence 8_2:1294:10765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0007; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1294
msgctxt "text_id=10765 | speaker=aoko"
msgid "「いいからお風呂に入ってきたら？　汚れてるわよ、草十郎」"
msgstr ""

#. Occurrence 8_2:1324:10766: scene=8_2
#: 8_2:1324
msgctxt "text_id=10766 | speaker=unknown"
msgid "　それだけ言って、青子は鏡に視線を戻す。"
msgstr ""

#. Occurrence 8_2:1329:10767: scene=8_2
#: 8_2:1329
msgctxt "text_id=10767 | speaker=unknown"
msgid "　有珠はもう一度だけちらりと草十郎に視線を向けたあと、テーブルの上の鏡に見入った。"
msgstr ""

#. Occurrence 8_2:1347:10768: scene=8_2
#: 8_2:1347
msgctxt "text_id=10768 | speaker=unknown"
msgid "　とりあえず挨拶を済ませて満足したのか、草十郎はぱたんと扉を閉め、居間を<後|あと>にした。"
msgstr ""

#. Occurrence 8_2:1393:10769: scene=8_2
#: 8_2:1393
msgctxt "text_id=10769 | speaker=unknown"
msgid "　青子の言う通り、服の端々はわずかに汚れていた。"
msgstr ""

#. Occurrence 8_2:1399:10770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0004; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1399
msgctxt "text_id=10770 | speaker=soujuurou"
msgid "「……そうだな。もったいないけど、確かに」"
msgstr ""

#. Occurrence 8_2:1410:10771: scene=8_2
#: 8_2:1410
msgctxt "text_id=10771 | speaker=unknown"
msgid "　別に汗をかいた訳でもないが、この寒さの中での湯浴みはちょっと楽しそうだ、と草十郎は自室に戻る。"
msgstr ""

#. Occurrence 8_2:1457:10772: scene=8_2
#: 8_2:1457
msgctxt "text_id=10772 | speaker=unknown"
msgid "　ロビーから二階へ、さらに階段を上がって屋根裏の部屋に入る。"
msgstr ""

#. Occurrence 8_2:1498:10773: scene=8_2
#: 8_2:1498
msgctxt "text_id=10773 | speaker=unknown"
msgid "　ここは他の部屋と違い余計な装飾がない。"
msgstr ""

#. Occurrence 8_2:1503:10774: scene=8_2
#: 8_2:1503
msgctxt "text_id=10774 | speaker=unknown"
msgid "　暮らすにはいささか不便だが、草十郎にとっては落ち着ける場所でもある。"
msgstr ""

#. Occurrence 8_2:1508:10775: scene=8_2
#: 8_2:1508
msgctxt "text_id=10775 | speaker=unknown"
msgid "　洋館はどこもかしこも豪華すぎて気を遣うのだろう。"
msgstr ""

#. Occurrence 8_2:1513:10776: scene=8_2
#: 8_2:1513
msgctxt "text_id=10776 | speaker=unknown"
msgid "　経緯はどうあれ寝泊りする部屋に関してなら、草十郎はたいへん満足していた。"
msgstr ""

#. Occurrence 8_2:1547:10777: scene=8_2
#: 8_2:1547
msgctxt "text_id=10777 | speaker=unknown"
msgid "　屋根裏には電気は通っていない。"
msgstr ""

#. Occurrence 8_2:1552:10778: scene=8_2
#: 8_2:1552
msgctxt "text_id=10778 | speaker=unknown"
msgid "　明かりは小さな天窓だけだ。"
msgstr ""

#. Occurrence 8_2:1557:10779: scene=8_2
#: 8_2:1557
msgctxt "text_id=10779 | speaker=unknown"
msgid "　が、そもそも電灯に馴染めない草十郎にとって、それはどうでもいい事だ。"
msgstr ""

#. Occurrence 8_2:1562:10780: scene=8_2
#: 8_2:1562
msgctxt "text_id=10780 | speaker=unknown"
msgid "　冬の暗い日射しだけをたよりに着替えとタオルを用意して、ロビーへとって返す。"
msgstr ""

#. Occurrence 8_2:1608:10781: scene=8_2
#: 8_2:1608
msgctxt "text_id=10781 | speaker=unknown"
msgid "　これだけ大きな建物なのに、館には浴場が一つしかない。"
msgstr ""

#. Occurrence 8_2:1613:10782: scene=8_2
#: 8_2:1613
msgctxt "text_id=10782 | speaker=unknown"
msgid "　その浴場もあまり広くないので、館の設計者は風呂を重要視しなかったのだろう。あるいは、湯浴みに馴染みがなかったのか。"
msgstr ""

#. Occurrence 8_2:1645:10783: scene=8_2
#: 8_2:1645
msgctxt "text_id=10783 | speaker=unknown"
msgid "　草十郎はロビーまで下り、階段の裏側に回りこむ。"
msgstr ""

#. Occurrence 8_2:1651:10784: scene=8_2
#: 8_2:1651
msgctxt "text_id=10784 | speaker=unknown"
msgid "　浴場へ続く扉をノックする。当然ながら返事はない。二人はいまも居間で会議中である。"
msgstr ""

#. Occurrence 8_2:1657:10785: scene=8_2
#: 8_2:1657
msgctxt "text_id=10785 | speaker=unknown"
msgid "　それを確認して、軽い足取りで草十郎は中へと入っていった。"
msgstr ""

#. Occurrence 8_2:1703:10786: scene=8_2
#: 8_2:1703
msgctxt "text_id=10786 | speaker=unknown"
msgid "　彼らしい話ではあるが。"
msgstr ""

#. Occurrence 8_2:1708:10787: scene=8_2
#: 8_2:1708
msgctxt "text_id=10787 | speaker=unknown"
msgid "　山から下りて出来た唯一の趣味が湯浴みであるという事を、草十郎本人はまだ自覚していなかった。"
msgstr ""

#. Occurrence 8_2:1771:10788: scene=8_2
#: 8_2:1771
msgctxt "text_id=10788 | speaker=unknown"
msgid "　草十郎が去った後も、少女たちの協議は続いていた。"
msgstr ""

#. Occurrence 8_2:1777:10789: scene=8_2
#: 8_2:1777
msgctxt "text_id=10789 | speaker=unknown"
msgid "　議題は言うまでもなく、先月から三咲市に現れた外部の魔術師について。"
msgstr ""

#. Occurrence 8_2:1782:10790: scene=8_2
#: 8_2:1782
msgctxt "text_id=10790 | speaker=unknown"
msgid "　<目撃者|そうじゅうろう>の一件で中断されていた、彼女たち本来の責務……管理地を奪いに来た略奪者への対応、その排除である。"
msgstr ""

#. Occurrence 8_2:1814:10791: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0008; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1814
msgctxt "text_id=10791 | speaker=aoko"
msgid "「……今までは囮にばっかり食いついてたから甘く見てたけど……それも計算尽くだったのかしらね。"
msgstr ""

#. Occurrence 8_2:1821:10792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0009; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1821
msgctxt "text_id=10792 | speaker=aoko"
msgid "こっちが油断してる隙に、本命を一つ奪われた。"
msgstr ""

#. Occurrence 8_2:1833:10793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0010; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1833
msgctxt "text_id=10793 | speaker=aoko"
msgid "　この<魔|あ><術|い><師|て>との戦いは、これからが本番ってコトか」"
msgstr ""

#. Occurrence 8_2:1865:10794: scene=8_2
#: 8_2:1865
msgctxt "text_id=10794 | speaker=unknown"
msgid "　事態は深刻化している。"
msgstr ""

#. Occurrence 8_2:1870:10795: scene=8_2
#: 8_2:1870
msgctxt "text_id=10795 | speaker=unknown"
msgid "　敵魔術師は二日前までの散漫的な小競り合いから、巧みな攻勢に転じてきていた。"
msgstr ""

#. Occurrence 8_2:1890:10796: scene=8_2
#: 8_2:1890
msgctxt "text_id=10796 | speaker=unknown"
msgid "　青子たちには、大きく分けて二つの結界の守りがある。"
msgstr ""

#. Occurrence 8_2:1906:10797: scene=8_2
#: 8_2:1906
msgctxt "text_id=10797 | speaker=unknown"
msgid "　一つは三咲市一帯に張られた、魔力・魔術の働きを測定する大結界。"
msgstr ""

#. Occurrence 8_2:1911:10798: scene=8_2
#: 8_2:1911
msgctxt "text_id=10798 | speaker=unknown"
msgid "　これは外部からの来訪者を把握、監視する為のもので、管理地のオーナーである蒼崎の先祖が敷いた、消しようのない機能だ。"
msgstr ""

#. Occurrence 8_2:1931:10799: scene=8_2
#: 8_2:1931
msgctxt "text_id=10799 | speaker=unknown"
msgid "　もう一つは土地の霊脈を生かし、その力を管理するもの。"
msgstr ""

#. Occurrence 8_2:1936:10800: scene=8_2
#: 8_2:1936
msgctxt "text_id=10800 | speaker=unknown"
msgid "　大地に刻まれた五つの支点によって、そのサークルの内部を守る典型的な方陣である。"
msgstr ""

#. Occurrence 8_2:1953:10801: scene=8_2
#: 8_2:1953
msgctxt "text_id=10801 | speaker=unknown"
msgid "　人為的に<大|マ><源|ナ>の流れに手を加え、その力の終点が久遠寺邸に集まる―――ありていにいえば、三咲市における魔力を独占する為の結界だ。"
msgstr ""

#. Occurrence 8_2:1973:10802: scene=8_2
#: 8_2:1973
msgctxt "text_id=10802 | speaker=unknown"
msgid "　支点は久遠寺邸を中心にして、全部で五点。"
msgstr ""

#. Occurrence 8_2:1978:10803: scene=8_2
#: 8_2:1978
msgctxt "text_id=10803 | speaker=unknown"
msgid "　これを全て退去させられた場合、青子たちの『管理地の持ち主』という事実は、文字通り、ただの肩書きになり下がる。"
msgstr ""

#. Occurrence 8_2:1984:10804: scene=8_2
#: 8_2:1984
msgctxt "text_id=10804 | speaker=unknown"
msgid "　土地のバックアップを失った管理人は、外部から現れた略奪者と同じ条件になり―――個人の力量だけで、敵を撃退しなければならなくなるのだ。"
msgstr ""

#. Occurrence 8_2:2016:10805: scene=8_2
#: 8_2:2016
msgctxt "text_id=10805 | speaker=unknown"
msgid "　有珠はともかく、まだ未熟な青子が管理地を死守できているのは、この二つに頼るところが大きい。"
msgstr ""

#. Occurrence 8_2:2022:10806: scene=8_2
#: 8_2:2022
msgctxt "text_id=10806 | speaker=unknown"
msgid "　とくに蒼崎に伝わる<索敵網|だいけっかい>は彼女の生命線ですらある。"
msgstr ""

#. Occurrence 8_2:2027:10807: scene=8_2
#: 8_2:2027
msgctxt "text_id=10807 | speaker=unknown"
msgid "　が、今回の敵はこの大結界の目をかいくぐり、好き勝手<町|まち>を<跋扈|ばっこ>していた。"
msgstr ""

#. Occurrence 8_2:2032:10808: scene=8_2
#: 8_2:2032
msgctxt "text_id=10808 | speaker=unknown"
msgid "　結果、彼女たちはこうして受けに回っている。"
msgstr ""

#. Occurrence 8_2:2075:10809: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0007; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2075
msgctxt "text_id=10809 | speaker=alice"
msgid "「……どちらにせよ時間の問題ね。"
msgstr ""

#. Occurrence 8_2:2082:10810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_0; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2082
msgctxt "text_id=10810 | speaker=alice"
msgid "　支点がすべて潰されたら、いよいよ<洋|こ><館|こ>での籠城になるけど……"
msgstr ""

#. Occurrence 8_2:2094:10811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_1; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2094
msgctxt "text_id=10811 | speaker=alice"
msgid "いいの、青子？」"
msgstr ""

#. Occurrence 8_2:2135:10812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0011; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2135
msgctxt "text_id=10812 | speaker=aoko"
msgid "「？　別にいいんじゃないの？　有珠の言う通り、残りの支点を消されるのは時間の問題なんだし。"
msgstr ""

#. Occurrence 8_2:2147:10813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0012; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2147
msgctxt "text_id=10813 | speaker=aoko"
msgid "　そりゃ<魔術師|てき>の<隠れ家|アジト>を発見できれば御の字だけど、それは絶対必要ってワケでもないでしょ。支点を消されても私にはあんまり関係ないし」"
msgstr ""

#. Occurrence 8_2:2174:10814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0013; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2174
msgctxt "text_id=10814 | speaker=aoko"
msgid "「なにより、館の守りはアンタがいるかぎり万全だしね。"
msgstr ""

#. Occurrence 8_2:2180:10815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0014; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2180
msgctxt "text_id=10815 | speaker=aoko"
msgid "　あっちの方からやって来てくれるなら、それこそ飛んで火にいる、よ。"
msgstr ""

#. Occurrence 8_2:2202:10816: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0015; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2202
msgctxt "text_id=10816 | speaker=aoko"
msgid "　他に心配事なんてないでしょ？」"
msgstr ""

#. Occurrence 8_2:2263:10817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0009; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2263
msgctxt "text_id=10817 | speaker=alice"
msgid "「……そうね。敵が一人だけなら、その時は鏡の範囲を<洋館|ここ>に集中させて、戦場にすればいい。わたしたちにとって、その方が有利だったわ」"
msgstr ""

#. Occurrence 8_2:2293:10818: scene=8_2
#: 8_2:2293
msgctxt "text_id=10818 | speaker=unknown"
msgid "　有珠はその白い指で、テーブルに置かれた鏡に触れる。"
msgstr ""

#. Occurrence 8_2:2298:10819: scene=8_2
#: 8_2:2298
msgctxt "text_id=10819 | speaker=unknown"
msgid "　途端、水のように波立つ鏡面。"
msgstr ""

#. Occurrence 8_2:2386:10820: scene=8_2
#: 8_2:2386
msgctxt "text_id=10820 | speaker=unknown"
msgid "　蒼崎の結界とは別の、三咲市の守り神。"
msgstr ""

#. Occurrence 8_2:2391:10821: scene=8_2
#: 8_2:2391
msgctxt "text_id=10821 | speaker=unknown"
msgid "　正しくは三咲市ではなく、久遠寺有珠だけを守る“童話の怪物”。濃霧を生み、訪れる者をゲーム盤の世界に<誘|いざな>う招待状。"
msgstr ""

#. Occurrence 8_2:2396:10822: scene=8_2
#: 8_2:2396
msgctxt "text_id=10822 | speaker=unknown"
msgid "　持ち主である少女は鏡とだけ呼び、"
msgstr ""

#. Occurrence 8_2:2401:10823: scene=8_2
#: 8_2:2401
msgctxt "text_id=10823 | speaker=unknown"
msgid "　少女の友人に<午睡|ごすい>の鏡と名付けられた、"
msgstr ""

#. Occurrence 8_2:2406:10824: scene=8_2
#: 8_2:2406
msgctxt "text_id=10824 | speaker=unknown"
msgid "　久遠寺有珠の扱う魔術である。"
msgstr ""

#. Occurrence 8_2:2459:10825: scene=8_2
#: 8_2:2459
msgctxt "text_id=10825 | speaker=unknown"
msgid "　波打つ鏡面には、一つの城と多くの森、平原と川が浮かび上がっている。"
msgstr ""

#. Occurrence 8_2:2464:10826: scene=8_2
#: 8_2:2464
msgctxt "text_id=10826 | speaker=unknown"
msgid "　その様子を無言で眺めていた青子だったが、"
msgstr ""

#. Occurrence 8_2:2491:10827: scene=8_2
#: 8_2:2491
msgctxt "text_id=10827 | speaker=unknown"
msgid "　突然、よし、とばかりにソファーから立ち上がった。"
msgstr ""

#. Occurrence 8_2:2526:10828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0016; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2526
msgctxt "text_id=10828 | speaker=aoko"
msgid "「そうと決まれば、<後|あと>は行動あるのみね。"
msgstr ""

#. Occurrence 8_2:2532:10829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0017; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2532
msgctxt "text_id=10829 | speaker=aoko"
msgid "　出かけるわよ有珠。とにかく現場を見ない事には始まらない」"
msgstr ""

#. Occurrence 8_2:2563:10830: scene=8_2
#: 8_2:2563
msgctxt "text_id=10830 | speaker=unknown"
msgid "　決意に満ちた青子の声に、有珠は気だるげに吐息をもらして、鏡面をさらりと<撫|な>でる。"
msgstr ""

#. Occurrence 8_2:2570:10831: scene=8_2
#: 8_2:2570
msgctxt "text_id=10831 | speaker=unknown"
msgid "　……とぷ、と水の騒ぐ音。"
msgstr ""

#. Occurrence 8_2:2575:10832: scene=8_2
#: 8_2:2575
msgctxt "text_id=10832 | speaker=unknown"
msgid "　鏡は有珠の<一|ひと><撫|な>でで濃霧に包まれ、テーブルに沈み消えた。"
msgstr ""

#. Occurrence 8_2:2609:10833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0010; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2609
msgctxt "text_id=10833 | speaker=alice"
msgid "「順番に回るのなら、帰るのは朝になるわね」"
msgstr ""

#. Occurrence 8_2:2634:10834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0018; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2634
msgctxt "text_id=10834 | speaker=aoko"
msgid "「まあまあ、そう億劫がらないで。"
msgstr ""

#. Occurrence 8_2:2646:10835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0019; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2646
msgctxt "text_id=10835 | speaker=aoko"
msgid "　ところで有珠、火の五芒星の退去ってこうだっけ」"
msgstr ""

#. Occurrence 8_2:2665:10836: scene=8_2
#: 8_2:2665
msgctxt "text_id=10836 | speaker=unknown"
msgid "　青子は中空に指を滑らせる。"
msgstr ""

#. Occurrence 8_2:2670:10837: scene=8_2
#: 8_2:2670
msgctxt "text_id=10837 | speaker=unknown"
msgid "　上から始まって右下へ、右下から左上、左上から……と星型の軌跡が描かれる。"
msgstr ""

#. Occurrence 8_2:2696:10838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0011; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2696
msgctxt "text_id=10838 | speaker=alice"
msgid "「……そろそろ壊すこと以外も覚えないと駄目よ、青子」"
msgstr ""

#. Occurrence 8_2:2717:10839: scene=8_2
#: 8_2:2717
msgctxt "text_id=10839 | speaker=unknown"
msgid "　ため息をつきながら、有珠もソファーから腰をあげる。"
msgstr ""

#. Occurrence 8_2:2743:10840: scene=8_2
#: 8_2:2743
msgctxt "text_id=10840 | speaker=unknown"
msgid "　ふたりは<上着掛け|コートハンガー>からそれぞれのコートを手に取り、居間を後にする。"
msgstr ""

#. Occurrence 8_2:2787:10841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0020; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2787
msgctxt "text_id=10841 | speaker=aoko"
msgid "「失礼ね、私だって日々成長してるわよ。"
msgstr ""

#. Occurrence 8_2:2794:10842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0021; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2794
msgctxt "text_id=10842 | speaker=aoko"
msgid "この<間|あいだ>のお<呪|まじな>いだってちゃんと成功したんだから」"
msgstr ""

#. Occurrence 8_2:2812:10843: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0012; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2812
msgctxt "text_id=10843 | speaker=alice"
msgid "「……お呪い？」"
msgstr ""

#. Occurrence 8_2:2829:10844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0022; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2829
msgctxt "text_id=10844 | speaker=aoko"
msgid "「簡単な暗示の呪文。"
msgstr ""

#. Occurrence 8_2:2835:10845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0023; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2835
msgctxt "text_id=10845 | speaker=aoko"
msgid "　ほら、有珠が教えてくれた、空<気のおも|かるく、よわく>り、胸<のふる|うまく、はやく>え。ひ<かりは先|チクタクチクタク>立つ、か<げは遅れ|いそげやいそげ>る。ってヤツ」"
msgstr ""

#. Occurrence 8_2:2867:10846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0013; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2867
msgctxt "text_id=10846 | speaker=alice"
msgid "「………………それ、本当？」"
msgstr ""

#. Occurrence 8_2:2873:10847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0024; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2873
msgctxt "text_id=10847 | speaker=aoko"
msgid "「ホントもホント。後で草十郎に聞いてみなさい」"
msgstr ""

#. Occurrence 8_2:2884:10848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0014; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2884
msgctxt "text_id=10848 | speaker=alice"
msgid "「…………………………」"
msgstr ""

#. Occurrence 8_2:2889:10849: scene=8_2
#: 8_2:2889
msgctxt "text_id=10849 | speaker=unknown"
msgid "　有珠は納得のいかない面持ちで、喉まで出かけた言葉を飲みこんだ。"
msgstr ""

#. Occurrence 8_2:2894:10850: scene=8_2
#: 8_2:2894
msgctxt "text_id=10850 | speaker=unknown"
msgid "　特に話題にする事でもない、とギリギリで疑問を止められたのだろう。"
msgstr ""

#. Occurrence 8_2:2920:10851: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0015; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2920
msgctxt "text_id=10851 | speaker=alice"
msgid "「……けど。留守中、その彼はどうするの？」"
msgstr ""

#. Occurrence 8_2:2939:10852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0025; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2939
msgctxt "text_id=10852 | speaker=aoko"
msgid "「大丈夫でしょ。有珠の西館と開かずの間に入らなきゃ即死するような事は……」"
msgstr ""

#. Occurrence 8_2:2946:10853: scene=8_2
#: 8_2:2946
msgctxt "text_id=10853 | speaker=unknown"
msgid "　青子は答えながらロビーに通じる扉を開ける。"
msgstr ""

#. Occurrence 8_2:2977:10854: scene=8_2
#: 8_2:2977
msgctxt "text_id=10854 | speaker=unknown"
msgid "　直後。"
msgstr ""

#. Occurrence 8_2:2982:10855: scene=8_2
#: 8_2:2982
msgctxt "text_id=10855 | speaker=unknown"
msgid "　突然の疑問に声をあげる有珠のように、青子の喉は凍りついた。"
msgstr ""

#. Occurrence 8_3:130:10856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0000; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:130
msgctxt "text_id=10856 | speaker=aoko"
msgid "「……………、ですって？」"
msgstr ""

#. Occurrence 8_3:136:10857: scene=8_3
#: 8_3:136
msgctxt "text_id=10857 | speaker=unknown"
msgid "　それが誰なのか、青子は咄嗟に思いつけなかった。"
msgstr ""

#. Occurrence 8_3:171:10858: scene=8_3
#: 8_3:171
msgctxt "text_id=10858 | speaker=unknown"
msgid "　不意打ち気味の<当惑|とうわく>に<眩|くら>みながら、午後の<斜光|さしび>を眺めている事しかできない。"
msgstr ""

#. Occurrence 8_3:178:10859: scene=8_3
#: 8_3:178
msgctxt "text_id=10859 | speaker=unknown"
msgid "　びっくり箱に驚いた時のような、"
msgstr ""

#. Occurrence 8_3:200:10860: scene=8_3
#: 8_3:200
msgctxt "text_id=10860 | speaker=unknown"
msgid "　寝起きの時のような空白。"
msgstr ""

#. Occurrence 8_3:205:10861: scene=8_3
#: 8_3:205
msgctxt "text_id=10861 | speaker=unknown"
msgid "　そんな沈黙がどれだけ続いたのか、正確に知り得たのは、当の人影だけだろう。"
msgstr ""

#. Occurrence 8_3:251:10862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0001; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:251
msgctxt "text_id=10862 | speaker=aoko"
msgid "「……アンタ、こんなところで何してるのよ、いったい」"
msgstr ""

#. Occurrence 8_3:257:10863: scene=8_3
#: 8_3:257
msgctxt "text_id=10863 | speaker=unknown"
msgid "　どれほどか経って、ようやく青子は口を開いた。"
msgstr ""

#. Occurrence 8_3:297:10864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0000; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:297
msgctxt "text_id=10864 | speaker=soujuurou"
msgid "「何って、着替えてるんだけど」"
msgstr ""

#. Occurrence 8_3:303:10865: scene=8_3
#: 8_3:303
msgctxt "text_id=10865 | speaker=unknown"
msgid "　青子の質問に、その人影は平然と答えた。"
msgstr ""

#. Occurrence 8_3:308:10866: scene=8_3
#: 8_3:308
msgctxt "text_id=10866 | speaker=unknown"
msgid "　なぜ脱衣場ではなくロビーで着替えているのか、その経緯を説明しないまま。"
msgstr ""

#. Occurrence 8_3:348:10867: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0002; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:348
msgctxt "text_id=10867 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 8_3:353:10868: scene=8_3
#: 8_3:353
msgctxt "text_id=10868 | speaker=unknown"
msgid "　そんな草十郎に一声……率直に言うと怒鳴り……あげなくてはいけないのに、青子は言葉を止めてしまう。"
msgstr ""

#. Occurrence 8_3:389:10869: scene=8_3
#: 8_3:389
msgctxt "text_id=10869 | speaker=unknown"
msgid "　今まで浴場にいたであろう彼は、ちょうどシャツを着ようとしているところだった。"
msgstr ""

#. Occurrence 8_3:394:10870: scene=8_3
#: 8_3:394
msgctxt "text_id=10870 | speaker=unknown"
msgid "　上半身<裸|はだか>で、首には布が巻かれている。"
msgstr ""

#. Occurrence 8_3:399:10871: scene=8_3
#: 8_3:399
msgctxt "text_id=10871 | speaker=unknown"
msgid "　髪は濡れているものの、肌に上気したところは見られない。おそらく水で体を洗ったのだろう。"
msgstr ""

#. Occurrence 8_3:426:10872: scene=8_3
#: 8_3:426
msgctxt "text_id=10872 | speaker=unknown"
msgid "　この寒空によく、と呆れるところだが、そんな<所感|しょかん>は些細な事だ。"
msgstr ""

#. Occurrence 8_3:431:10873: scene=8_3
#: 8_3:431
msgctxt "text_id=10873 | speaker=unknown"
msgid "　<沈黙|おどろき>は、純粋に彼の体に起因する。"
msgstr ""

#. Occurrence 8_3:458:10874: scene=8_3
#: 8_3:458
msgctxt "text_id=10874 | speaker=unknown"
msgid "　今まで線の細い人畜無害っぷりだったのに、<装飾|ようふく>を取ればこの通り、弱々しいイメージなど見られない。"
msgstr ""

#. Occurrence 8_3:463:10875: scene=8_3
#: 8_3:463
msgctxt "text_id=10875 | speaker=unknown"
msgid "　何事も体が資本な山育ちなら、むしろ鍛え方が足りないのかもしれないが、青子にとっては予想外の体つきだった。"
msgstr ""

#. Occurrence 8_3:468:10876: scene=8_3
#: 8_3:468
msgctxt "text_id=10876 | speaker=unknown"
msgid "　それと、おまけに、"
msgstr ""

#. Occurrence 8_3:515:10877: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0003; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:515
msgctxt "text_id=10877 | speaker=aoko"
msgid "「……それ、傷跡なの？」"
msgstr ""

#. Occurrence 8_3:521:10878: scene=8_3
#: 8_3:521
msgctxt "text_id=10878 | speaker=unknown"
msgid "　青子は恐る恐る口にする。"
msgstr ""

#. Occurrence 8_3:537:10879: scene=8_3
#: 8_3:537
msgctxt "text_id=10879 | speaker=unknown"
msgid "　草十郎はうん？　と視線を落とした。"
msgstr ""

#. Occurrence 8_3:542:10880: scene=8_3
#: 8_3:542
msgctxt "text_id=10880 | speaker=unknown"
msgid "　彼の腕にはうっすらと火傷の跡らしきものがある。"
msgstr ""

#. Occurrence 8_3:547:10881: scene=8_3
#: 8_3:547
msgctxt "text_id=10881 | speaker=unknown"
msgid "　青子の魔術刻印のような秩序のある紋様ではなく、不幸な事故を思わせる<斑|まだら>模様。"
msgstr ""

#. Occurrence 8_3:582:10882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0001; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:582
msgctxt "text_id=10882 | speaker=soujuurou"
msgid "「ああ、これか。ずいぶん前に野犬の群れに襲われて、噛みつかれたんだ。命があっただけでも幸運だから、傷跡ぐらいはご愛敬だ」"
msgstr ""

#. Occurrence 8_3:602:10883: scene=8_3
#: 8_3:602
msgctxt "text_id=10883 | speaker=unknown"
msgid "　……ずいぶん前、とは子供の頃の出来事らしい。"
msgstr ""

#. Occurrence 8_3:607:10884: scene=8_3
#: 8_3:607
msgctxt "text_id=10884 | speaker=unknown"
msgid "　<一命|いちめい>は取り留めたものの、彼の住んでいた山奥では満足な治療もできなかったのだろう。"
msgstr ""

#. Occurrence 8_3:640:10885: scene=8_3
#: 8_3:640
msgctxt "text_id=10885 | speaker=unknown"
msgid "　その傷跡は消えていない。"
msgstr ""

#. Occurrence 8_3:645:10886: scene=8_3
#: 8_3:645
msgctxt "text_id=10886 | speaker=unknown"
msgid "　何年も前に受けてあの状態なら、もう一<生涯|しょうがい>変わらないだろう。"
msgstr ""

#. Occurrence 8_3:650:10887: scene=8_3
#: 8_3:650
msgctxt "text_id=10887 | speaker=unknown"
msgid "　……半面、肌に残る野性の<傷|あ><痕|と>は、無駄のない体に相応しかった。直視した彼女が、たとえ一瞬だけだろうと、感じ入った程度には。"
msgstr ""

#. Occurrence 8_3:683:10888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10888 | speaker=soujuurou"
msgid "「……たしかにあまり気持ちのいいものじゃないな。"
msgstr ""

#. Occurrence 8_3:683:10889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10889 | speaker=soujuurou"
msgid "　自分の部屋で着替えるべきだった」"
msgstr ""

#. Occurrence 8_3:689:10890: scene=8_3
#: 8_3:689
msgctxt "text_id=10890 | speaker=unknown"
msgid "　無言で固まった青子を見て、草十郎はシャツを着ながら、少しだけ恥じ入るように弁明した。"
msgstr ""

#. Occurrence 8_3:694:10891: scene=8_3
#: 8_3:694
msgctxt "text_id=10891 | speaker=unknown"
msgid "　ふたりからは何の返答もない。"
msgstr ""

#. Occurrence 8_3:704:10892: scene=8_3
#: 8_3:704
msgctxt "text_id=10892 | speaker=unknown"
msgid "　草十郎は自分の部屋に戻ろうと階段に向かう。"
msgstr ""

#. Occurrence 8_3:749:10893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0004; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:749
msgctxt "text_id=10893 | speaker=aoko"
msgid "「ちょ、ちょっと待って、草十郎」"
msgstr ""

#. Occurrence 8_3:762:10894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0003; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:762
msgctxt "text_id=10894 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 8_3:767:10895: scene=8_3
#: 8_3:767
msgctxt "text_id=10895 | speaker=unknown"
msgid "　足を止めて振り返る草十郎。"
msgstr ""

#. Occurrence 8_3:779:10896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0005; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:779
msgctxt "text_id=10896 | speaker=aoko"
msgid "「え―――あ、うん、なんていうか―――」"
msgstr ""

#. Occurrence 8_3:790:10897: scene=8_3
#: 8_3:790
msgctxt "text_id=10897 | speaker=unknown"
msgid "　自分でも呼び止めた意図が分からず、青子は気まずそうに視線を逸らす。"
msgstr ""

#. Occurrence 8_3:827:10898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0004; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:827
msgctxt "text_id=10898 | speaker=soujuurou"
msgid "「？？　……なんか蒼崎らしくない。"
msgstr ""

#. Occurrence 8_3:833:10899: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10899 | speaker=soujuurou"
msgid "　さっきからヘンだけど、熱でもあるんじゃないのか？"
msgstr ""

#. Occurrence 8_3:833:10900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10900 | speaker=soujuurou"
msgid "　あれから満足に寝てないだろ、ふたりとも」"
msgstr ""

#. Occurrence 8_3:839:10901: scene=8_3
#: 8_3:839
msgctxt "text_id=10901 | speaker=unknown"
msgid "　あれから、とは期末試験からの話である。"
msgstr ""

#. Occurrence 8_3:844:10902: scene=8_3
#: 8_3:844
msgctxt "text_id=10902 | speaker=unknown"
msgid "　草十郎から見ると、青子の働きぶりは“おかしい”“ヘンな人”レベルの扱いになっているらしい。"
msgstr ""

#. Occurrence 8_3:880:10903: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0006; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:880
msgctxt "text_id=10903 | speaker=aoko"
msgid "「ね、熱なんてないったらっ！"
msgstr ""

#. Occurrence 8_3:886:10904: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0007; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:886
msgctxt "text_id=10904 | speaker=aoko"
msgid "　そうじゃなくて―――ど、どうしてこんなところで着替えてたのよ、アンタはっ！」"
msgstr ""

#. Occurrence 8_3:912:10905: scene=8_3
#: 8_3:912
msgctxt "text_id=10905 | speaker=unknown"
msgid "　目に見えてとりつくろう青子。"
msgstr ""

#. Occurrence 8_3:917:10906: scene=8_3
#: 8_3:917
msgctxt "text_id=10906 | speaker=unknown"
msgid "　一方―――"
msgstr ""

#. Occurrence 8_3:941:10907: scene=8_3
#: 8_3:941
msgctxt "text_id=10907 | speaker=unknown"
msgid "　なぜか、そんな青子以上に言いよどむ草十郎。"
msgstr ""

#. Occurrence 8_3:962:10908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0006; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:962
msgctxt "text_id=10908 | speaker=soujuurou"
msgid "「それは、その。"
msgstr ""

#. Occurrence 8_3:968:10909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0007; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:968
msgctxt "text_id=10909 | speaker=soujuurou"
msgid "　……言いづらいんだが、下着の管理は、きちんとした方がいいと思う。どっちだかは知らないけど」"
msgstr ""

#. Occurrence 8_3:996:10910: scene=8_3
#: 8_3:996
msgctxt "text_id=10910 | speaker=unknown"
msgid "　草十郎の台詞に、今まで青子の後ろで黙っていた有珠がぴくりと反応した。"
msgstr ""

#. Occurrence 8_3:1001:10911: scene=8_3
#: 8_3:1001
msgctxt "text_id=10911 | speaker=unknown"
msgid "　我関せずを貫くつもりだった彼女も、今の台詞は無視できなかったらしい。"
msgstr ""

#. Occurrence 8_3:1042:10912: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0000; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1042
msgctxt "text_id=10912 | speaker=alice"
msgid "「言っておくけど、それは青子だから」"
msgstr ""

#. Occurrence 8_3:1048:10913: scene=8_3
#: 8_3:1048
msgctxt "text_id=10913 | speaker=unknown"
msgid "　あまりにも素早い正当性の主張だった。"
msgstr ""

#. Occurrence 8_3:1090:10914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0008; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1090
msgctxt "text_id=10914 | speaker=aoko"
msgid "「……洗濯の当番は、たしかに私だったけど」"
msgstr ""

#. Occurrence 8_3:1096:10915: scene=8_3
#: 8_3:1096
msgctxt "text_id=10915 | speaker=unknown"
msgid "　その後に何か続きそうな、険悪極まりない青子の切り返しである。"
msgstr ""

#. Occurrence 8_3:1117:10916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0008; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:1117
msgctxt "text_id=10916 | speaker=soujuurou"
msgid "「とにかく、もうすぐアルバイトだから着替えてくる」"
msgstr ""

#. Occurrence 8_3:1123:10917: scene=8_3
#: 8_3:1123
msgctxt "text_id=10917 | speaker=unknown"
msgid "　そんなふたりの言い合いに破滅の前兆を感じ取り、素早く戦場から離脱する草十郎。"
msgstr ""

#. Occurrence 8_3:1159:10918: scene=8_3
#: 8_3:1159
msgctxt "text_id=10918 | speaker=unknown"
msgid "　かくて、人騒がせな人影は早足で去っていった。"
msgstr ""

#. Occurrence 8_3:1233:10919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0009; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1233
msgctxt "text_id=10919 | speaker=aoko"
msgid "「……………有珠」"
msgstr ""

#. Occurrence 8_3:1244:10920: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0001; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1244
msgctxt "text_id=10920 | speaker=alice"
msgid "「……………とりあえず、片づけてくるわ」"
msgstr ""

#. Occurrence 8_3:1255:10921: scene=8_3
#: 8_3:1255
msgctxt "text_id=10921 | speaker=unknown"
msgid "　一見して冷静なまま、有珠は脱衣場に消えていった。"
msgstr ""

#. Occurrence 8_3:1292:10922: scene=8_3
#: 8_3:1292
msgctxt "text_id=10922 | speaker=unknown"
msgid "　数分後。"
msgstr ""

#. Occurrence 8_3:1308:10923: scene=8_3
#: 8_3:1308
msgctxt "text_id=10923 | speaker=unknown"
msgid "　気を取り直し、魔術師として外出しようとする直前、思いだしたように青子は相方の少女に訊ねた。"
msgstr ""

#. Occurrence 8_3:1329:10924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0010; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1329
msgctxt "text_id=10924 | speaker=aoko"
msgid "「そうだ有珠。傷ってアレの事？」"
msgstr ""

#. Occurrence 8_3:1344:10925: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0002; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1344
msgctxt "text_id=10925 | speaker=alice"
msgid "「……アレは傷跡じゃないわ。"
msgstr ""

#. Occurrence 8_3:1350:10926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0003; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1350
msgctxt "text_id=10926 | speaker=alice"
msgid "　だって、あんなにも誇らしいもの」"
msgstr ""

#. Occurrence 8_3:1370:10927: scene=8_3
#: 8_3:1370
msgctxt "text_id=10927 | speaker=unknown"
msgid "　たしかに、と青子は思う。"
msgstr ""

#. Occurrence 8_3:1375:10928: scene=8_3
#: 8_3:1375
msgctxt "text_id=10928 | speaker=unknown"
msgid "　あの傷跡に感じ入ったのは、彼本人が過去の出来事として受け入れ、何の後悔も持っていなかったからだ。"
msgstr ""

#. Occurrence 8_3:1391:10929: scene=8_3
#: 8_3:1391
msgctxt "text_id=10929 | speaker=unknown"
msgid "　それを有珠のように誇らしい、とは思えなかった青子だが、一瞬だけよぎった印象に間違いはなかったらしい。"
msgstr ""

#. Occurrence 8_3:1396:10930: scene=8_3
#: 8_3:1396
msgctxt "text_id=10930 | speaker=unknown"
msgid "　それと、もう一つ。"
msgstr ""

#. Occurrence 8_3:1422:10931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0011; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1422
msgctxt "text_id=10931 | speaker=aoko"
msgid "「でも一つだけはっきりしたわ。"
msgstr ""

#. Occurrence 8_3:1428:10932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0012; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1428
msgctxt "text_id=10932 | speaker=aoko"
msgid "　それじゃあ、不覚にも見惚れてたのは私ひとりじゃなかったってコトよね、有珠？」"
msgstr ""

#. Occurrence 8_3:1464:10933: scene=8_3
#: 8_3:1464
msgctxt "text_id=10933 | speaker=unknown"
msgid "　<悪戯|いたずら>の共犯の事実を求めるように、青子は楽しげに問いかける。"
msgstr ""

#. Occurrence 8_3:1469:10934: scene=8_3
#: 8_3:1469
msgctxt "text_id=10934 | speaker=unknown"
msgid "　一部始終、我関せずと無視していた少女に向かって。"
msgstr ""

#. Occurrence 8_3:1474:10935: scene=8_3
#: 8_3:1474
msgctxt "text_id=10935 | speaker=unknown"
msgid "　有珠は答えず、ただ視線を逸らしただけだった。"
msgstr ""

#. Occurrence 8_3:1479:10936: scene=8_3
#: 8_3:1479
msgctxt "text_id=10936 | speaker=unknown"
msgid "　それで満足いったのか、青子はくすりと<微笑|わら>って玄関へ歩きだす。"
msgstr ""

#. Occurrence 8_3:1524:10937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10937 | speaker=aoko"
msgid "「じゃ、行こうか。まずはあの公園からでいいでしょ？"
msgstr ""

#. Occurrence 8_3:1524:10938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10938 | speaker=aoko"
msgid "　今回の件は、あそこから全てが始まったわけだし」"
msgstr ""

#. Occurrence 8_3:1530:10939: scene=8_3
#: 8_3:1530
msgctxt "text_id=10939 | speaker=unknown"
msgid "　三咲町の公園。"
msgstr ""

#. Occurrence 8_3:1550:10940: scene=8_3
#: 8_3:1550
msgctxt "text_id=10940 | speaker=unknown"
msgid "　奇しくもそこは、敵の人形とも、草十郎とも関わりが始まった因縁の土地である。"
msgstr ""

#. Occurrence 8_4:64:10941: scene=8_4
#: 8_4:64
msgctxt "text_id=10941 | speaker=unknown"
msgid "　翌日、早朝。"
msgstr ""

#. Occurrence 8_4:69:10942: scene=8_4
#: 8_4:69
msgctxt "text_id=10942 | speaker=unknown"
msgid "　まだ多くの人々が眠りについている午前五時。"
msgstr ""

#. Occurrence 8_4:74:10943: scene=8_4
#: 8_4:74
msgctxt "text_id=10943 | speaker=unknown"
msgid "　去年あたりから二十四時間営業のコンビニエンスストアがぽつぽつと現れてはいるが、三咲町は古き良き八十年代前期の色が濃い。"
msgstr ""

#. Occurrence 8_4:79:10944: scene=8_4
#: 8_4:79
msgctxt "text_id=10944 | speaker=unknown"
msgid "　商店街で一番の早起きと言われる豆腐屋ですら、店開きは六時からだ。"
msgstr ""

#. Occurrence 8_4:99:10945: scene=8_4
#: 8_4:99
msgctxt "text_id=10945 | speaker=unknown"
msgid "　八十年代後半。"
msgstr ""

#. Occurrence 8_4:104:10946: scene=8_4
#: 8_4:104
msgctxt "text_id=10946 | speaker=unknown"
msgid "　バブル末期と言えど、地方都市の人々の生活はいまだ不夜城にはほど遠い。"
msgstr ""

#. Occurrence 8_4:109:10947: scene=8_4
#: 8_4:109
msgctxt "text_id=10947 | speaker=unknown"
msgid "　住宅地は静まりかえり、道を行く会社員の姿もなく、自動車の音すらしない。"
msgstr ""

#. Occurrence 8_4:114:10948: scene=8_4
#: 8_4:114
msgctxt "text_id=10948 | speaker=unknown"
msgid "　太陽は地平線に半身を残している。"
msgstr ""

#. Occurrence 8_4:119:10949: scene=8_4
#: 8_4:119
msgctxt "text_id=10949 | speaker=unknown"
msgid "　町が目覚めるには、あと半刻ばかりの眠りが必要だった。"
msgstr ""

#. Occurrence 8_4:153:10950: scene=8_4
#: 8_4:153
msgctxt "text_id=10950 | speaker=unknown"
msgid "　そんな中、久遠寺邸に足を踏み入れる影がひとつ。"
msgstr ""

#. Occurrence 8_4:158:10951: scene=8_4
#: 8_4:158
msgctxt "text_id=10951 | speaker=unknown"
msgid "　冬休みという事で深夜割り当てのアルバイトに精を出し、たったいま帰ってきた草十郎である。"
msgstr ""

#. Occurrence 8_4:172:10952: scene=8_4
#: 8_4:172
msgctxt "text_id=10952 | speaker=unknown"
msgid "　それぞれ自室で眠っているであろう青子と有珠を起こさないように、草十郎は静かに居間へ移動する。"
msgstr ""

#. Occurrence 8_4:218:10953: scene=8_4
#: 8_4:218
msgctxt "text_id=10953 | speaker=unknown"
msgid "　話は変わるが、久遠寺邸には幾つかのルールがある。"
msgstr ""

#. Occurrence 8_4:223:10954: scene=8_4
#: 8_4:223
msgctxt "text_id=10954 | speaker=unknown"
msgid "　その一つがノーモア日本茶。"
msgstr ""

#. Occurrence 8_4:228:10955: scene=8_4
#: 8_4:228
msgctxt "text_id=10955 | speaker=unknown"
msgid "　この、まったく新しい法案が可決されたのは三日前。"
msgstr ""

#. Occurrence 8_4:233:10956: scene=8_4
#: 8_4:233
msgctxt "text_id=10956 | speaker=unknown"
msgid "　ある夕食後、台所でのほほんとほうじ茶を飲んでいた草十郎を見て、久遠寺有珠が「あ」と発音した事に由来する。"
msgstr ""

#. Occurrence 8_4:268:10957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0000; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:268
msgctxt "text_id=10957 | speaker=alice"
msgid "「あ」"
msgstr ""

#. Occurrence 8_4:302:10958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0000; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:302
msgctxt "text_id=10958 | speaker=soujuurou"
msgid "「あ？」"
msgstr ""

#. Occurrence 8_4:327:10959: scene=8_4
#: 8_4:327
msgctxt "text_id=10959 | speaker=unknown"
msgid "　思えば、突然の出来事だった。"
msgstr ""

#. Occurrence 8_4:332:10960: scene=8_4
#: 8_4:332
msgctxt "text_id=10960 | speaker=unknown"
msgid "　背後からの声は有珠の一言であり、"
msgstr ""

#. Occurrence 8_4:360:10961: scene=8_4
#: 8_4:360
msgctxt "text_id=10961 | speaker=unknown"
msgid "　彼女は頭痛を堪えるような仕草をした後、青子を呼びつけて、以後、この洋館における番茶・梅昆布茶の錬成を禁止させた。"
msgstr ""

#. Occurrence 8_4:365:10962: scene=8_4
#: 8_4:365
msgctxt "text_id=10962 | speaker=unknown"
msgid "　青子の交渉で、夏場の麦茶だけはＯＫ、と<言|げん>をとれたのは奇跡と言えるだろう。"
msgstr ""

#. Occurrence 8_4:410:10963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0000; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:410
msgctxt "text_id=10963 | speaker=aoko"
msgid "“だいたい、イギリスさんだって初めはグリーンティーが主流だったじゃない”"
msgstr ""

#. Occurrence 8_4:416:10964: scene=8_4
#: 8_4:416
msgctxt "text_id=10964 | speaker=unknown"
msgid "　といった青子の反撃が、痛いところをついた結果である。"
msgstr ""

#. Occurrence 8_4:434:10965: scene=8_4
#: 8_4:434
msgctxt "text_id=10965 | speaker=unknown"
msgid "　ちなみに、「あ」は「ありえない」の「あ」ではないか、と蒼崎青子は睨んでいる。"
msgstr ""

#. Occurrence 8_4:486:10966: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0001; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:486
msgctxt "text_id=10966 | speaker=soujuurou"
msgid "「そこまで嫌がらなくてもなあ……お茶はなんだって美味しいのに」"
msgstr ""

#. Occurrence 8_4:492:10967: scene=8_4
#: 8_4:492
msgctxt "text_id=10967 | speaker=unknown"
msgid "　ひとり呟きながら、温かい緑茶を飲む草十郎。"
msgstr ""

#. Occurrence 8_4:508:10968: scene=8_4
#: 8_4:508
msgctxt "text_id=10968 | speaker=unknown"
msgid "　紅茶用のカップにほうじ茶を注いだ事が有珠のわななきの最たる理由であった事を、彼は知らない。"
msgstr ""

#. Occurrence 8_4:513:10969: scene=8_4
#: 8_4:513
msgctxt "text_id=10969 | speaker=unknown"
msgid "　また彼の名誉のために付け加えると、使ったティーカップは有珠が草十郎に使ってもよい、と許可したものである。"
msgstr ""

#. Occurrence 8_4:533:10970: scene=8_4
#: 8_4:533
msgctxt "text_id=10970 | speaker=unknown"
msgid "　ともあれ、今は彼だけの幸福空間だ。"
msgstr ""

#. Occurrence 8_4:538:10971: scene=8_4
#: 8_4:538
msgctxt "text_id=10971 | speaker=unknown"
msgid "　内緒で持ちこんだ日本茶セット一式を使って、草十郎は労働後の<一時|ひととき>にひたりきる。"
msgstr ""

#. Occurrence 8_4:558:10972: scene=8_4
#: 8_4:558
msgctxt "text_id=10972 | speaker=unknown"
msgid "　特別、本を読むワケでも、テレビをつけるワケでもなく、窓越しの庭……というより密林……を、<慈|いつく>しみの目で眺める。"
msgstr ""

#. Occurrence 8_4:563:10973: scene=8_4
#: 8_4:563
msgctxt "text_id=10973 | speaker=unknown"
msgid "　アレはなんとかしたいなー、などと思いつつ、まったりし続ける草十郎だった。"
msgstr ""

#. Occurrence 8_4:631:10974: scene=8_4
#: 8_4:631
msgctxt "text_id=10974 | speaker=unknown"
msgid "　彼がぼんやりすること、約半刻。"
msgstr ""

#. Occurrence 8_4:636:10975: scene=8_4
#: 8_4:636
msgctxt "text_id=10975 | speaker=unknown"
msgid "　疲れがじゅうぶんにとれた頃、ホールから物音が聞こえてきた。"
msgstr ""

#. Occurrence 8_4:672:10976: scene=8_4
#: 8_4:672
msgctxt "text_id=10976 | speaker=unknown"
msgid "　それが青子と有珠の話し声と知って、草十郎は神速で湯呑みや急須、お茶の葉をキッチンに隠す。"
msgstr ""

#. Occurrence 8_4:677:10977: scene=8_4
#: 8_4:677
msgctxt "text_id=10977 | speaker=unknown"
msgid "　台所には使われていない棚が山ほどあるので<隠蔽|いんぺい>自体は簡単だ。むしろ、青子たちの食事事情を如実に語る台所の在り方に困る草十郎である。"
msgstr ""

#. Occurrence 8_4:730:10978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0001; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:730
msgctxt "text_id=10978 | speaker=aoko"
msgid "「あら。早いのね、草十郎」"
msgstr ""

#. Occurrence 8_4:740:10979: scene=8_4
#: 8_4:740
msgctxt "text_id=10979 | speaker=unknown"
msgid "　青子は白いダウンジャケットを脱ぎながら声をかけた。"
msgstr ""

#. Occurrence 8_4:746:10980: scene=8_4
#: 8_4:746
msgctxt "text_id=10980 | speaker=unknown"
msgid "　彼女の横では、有珠が無言で黒いコートを脱いでいる。"
msgstr ""

#. Occurrence 8_4:770:10981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0002; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:770
msgctxt "text_id=10981 | speaker=soujuurou"
msgid "「いや、いま帰ってきたんだ。<天城浜|あまぎはま>の食品工場に深夜のパートで入ることになって、その帰り」"
msgstr ""

#. Occurrence 8_4:780:10982: scene=8_4
#: 8_4:780
msgctxt "text_id=10982 | speaker=unknown"
msgid "　台所から顔をだしながら、さも今からお湯を沸かしますよー、というジェスチャーをする草十郎。"
msgstr ""

#. Occurrence 8_4:809:10983: scene=8_4
#: 8_4:809
msgctxt "text_id=10983 | speaker=unknown"
msgid "　それに有珠は<微|かす>かに首を傾げた。"
msgstr ""

#. Occurrence 8_4:814:10984: scene=8_4
#: 8_4:814
msgctxt "text_id=10984 | speaker=unknown"
msgid "　……別に、草十郎のジェスチャーが彼女の笑いのツボに入った訳ではない。"
msgstr ""

#. Occurrence 8_4:825:10985: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0001; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:825
msgctxt "text_id=10985 | speaker=alice"
msgid "「天城浜から……？」"
msgstr ""

#. Occurrence 8_4:830:10986: scene=8_4
#: 8_4:830
msgctxt "text_id=10986 | speaker=unknown"
msgid "　有珠はちらりと居間の時計を見て、いっそう表情を曇らせる。"
msgstr ""

#. Occurrence 8_4:864:10987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0002; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:864
msgctxt "text_id=10987 | speaker=aoko"
msgid "「どうしたの、有珠？」"
msgstr ""

#. Occurrence 8_4:869:10988: scene=8_4
#: 8_4:869
msgctxt "text_id=10988 | speaker=unknown"
msgid "　いち早くソファーに腰を下ろした青子が、立ったままの有珠に問いかけた。"
msgstr ""

#. Occurrence 8_4:878:10989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0002; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:878
msgctxt "text_id=10989 | speaker=alice"
msgid "「別に」"
msgstr ""

#. Occurrence 8_4:888:10990: scene=8_4
#: 8_4:888
msgctxt "text_id=10990 | speaker=unknown"
msgid "　素っ気なく答えて、有珠もソファーに腰を下ろす。"
msgstr ""

#. Occurrence 8_4:918:10991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0003; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:918
msgctxt "text_id=10991 | speaker=aoko"
msgid "「草十郎ー。砂糖は一杯だけだからねー」"
msgstr ""

#. Occurrence 8_4:924:10992: scene=8_4
#: 8_4:924
msgctxt "text_id=10992 | speaker=unknown"
msgid "　青子はごく当然とばかりに、台所に声を投げた。"
msgstr ""

#. Occurrence 8_4:929:10993: scene=8_4
#: 8_4:929
msgctxt "text_id=10993 | speaker=unknown"
msgid "　返事はないが、あっちはそれで了解しているらしい。"
msgstr ""

#. Occurrence 8_4:934:10994: scene=8_4
#: 8_4:934
msgctxt "text_id=10994 | speaker=unknown"
msgid "　有珠には<与|あずか>り知れない、二晩にわたる一夜漬けの成果だった。"
msgstr ""

#. Occurrence 8_4:961:10995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0004; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:961
msgctxt "text_id=10995 | speaker=aoko"
msgid "「有珠は？」"
msgstr ""

#. Occurrence 8_4:982:10996: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0003; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:982
msgctxt "text_id=10996 | speaker=alice"
msgid "「……わたしは、ミルクだけでいいけど」"
msgstr ""

#. Occurrence 8_4:987:10997: scene=8_4
#: 8_4:987
msgctxt "text_id=10997 | speaker=unknown"
msgid "　仕方なく答える有珠に、"
msgstr ""

#. Occurrence 8_4:1006:10998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0003; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1006
msgctxt "text_id=10998 | speaker=soujuurou"
msgid "「了解、ミルクティーだね」"
msgstr ""

#. Occurrence 8_4:1011:10999: scene=8_4
#: 8_4:1011
msgctxt "text_id=10999 | speaker=unknown"
msgid "　と、なぜか律儀に返ってくる声があった。"
msgstr ""

#. Occurrence 8_4:1049:11000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0005; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1049
msgctxt "text_id=11000 | speaker=aoko"
msgid "「ま、いいけど。いちいちつっこんでたらキリがないし。"
msgstr ""

#. Occurrence 8_4:1071:11001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0006; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1071
msgctxt "text_id=11001 | speaker=aoko"
msgid "　それより珍しいじゃない。有珠がティーバッグのお茶飲むなんて」"
msgstr ""

#. Occurrence 8_4:1090:11002: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0004; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1090
msgctxt "text_id=11002 | speaker=alice"
msgid "「……今日は疲れたから、たまには」"
msgstr ""

#. Occurrence 8_4:1095:11003: scene=8_4
#: 8_4:1095
msgctxt "text_id=11003 | speaker=unknown"
msgid "　人の厚意を受け取ろう、と思ったらしい。"
msgstr ""

#. Occurrence 8_4:1116:11004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0007; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1116
msgctxt "text_id=11004 | speaker=aoko"
msgid "「ふーん。ま、いいか。それより草十郎ー。"
msgstr ""

#. Occurrence 8_4:1132:11005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0008; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1132
msgctxt "text_id=11005 | speaker=aoko"
msgid "　アンタ、さっきおかしなこと言わなかった？」"
msgstr ""

#. Occurrence 8_4:1151:11006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0004; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1151
msgctxt "text_id=11006 | speaker=soujuurou"
msgid "「？　別に言ってないぞ、そんな事」"
msgstr ""

#. Occurrence 8_4:1171:11007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0009; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1171
msgctxt "text_id=11007 | speaker=aoko"
msgid "「そう？　ならいいんだけど」"
msgstr ""

#. Occurrence 8_4:1176:11008: scene=8_4
#: 8_4:1176
msgctxt "text_id=11008 | speaker=unknown"
msgid "　居間と台所、実に四メートルもの距離で会話をするふたり。"
msgstr ""

#. Occurrence 8_4:1181:11009: scene=8_4
#: 8_4:1181
msgctxt "text_id=11009 | speaker=unknown"
msgid "　それに、ぽつりと有珠は付け足した。"
msgstr ""

#. Occurrence 8_4:1217:11010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0005; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1217
msgctxt "text_id=11010 | speaker=alice"
msgid "「……静希君がおかしな事を言わない日はないと思うわ、わたし」"
msgstr ""

#. Occurrence 8_4:1223:11011: scene=8_4
#: 8_4:1223
msgctxt "text_id=11011 | speaker=unknown"
msgid "　あんまりな有珠の声は、幸運なことに、台所にいる草十郎には聞こえなかった。"
msgstr ""

#. Occurrence 8_4:1262:11012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0010; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1262
msgctxt "text_id=11012 | speaker=aoko"
msgid "「そりゃあそうだけど、いま、ちょっと変だったでしょ？"
msgstr ""

#. Occurrence 8_4:1274:11013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0011; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1274
msgctxt "text_id=11013 | speaker=aoko"
msgid "　……いや、何が引っかかったのかまでは分からないんだけどさ」"
msgstr ""

#. Occurrence 8_4:1297:11014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0006; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1297
msgctxt "text_id=11014 | speaker=alice"
msgid "「そうね。会話自体は普通だったけれど、内容を考えてみると、どこかおかしいわね」"
msgstr ""

#. Occurrence 8_4:1330:11015: scene=8_4
#: 8_4:1330
msgctxt "text_id=11015 | speaker=unknown"
msgid "　要領のつかめない会話に、ますます不機嫌さをます青子。"
msgstr ""

#. Occurrence 8_4:1336:11016: scene=8_4
#: 8_4:1336
msgctxt "text_id=11016 | speaker=unknown"
msgid "　そこへ、三人分のティーカップをトレイに載せて草十郎が現れた。"
msgstr ""

#. Occurrence 8_4:1376:11017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11017 | speaker=soujuurou"
msgid "「なにを話してるんだ。"
msgstr ""

#. Occurrence 8_4:1376:11018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11018 | speaker=soujuurou"
msgid "　単に、新しいアルバイトを始めただけだろ」"
msgstr ""

#. Occurrence 8_4:1395:11019: scene=8_4
#: 8_4:1395
msgctxt "text_id=11019 | speaker=unknown"
msgid "　音をたてず、黒テーブルにカップを置く草十郎。"
msgstr ""

#. Occurrence 8_4:1400:11020: scene=8_4
#: 8_4:1400
msgctxt "text_id=11020 | speaker=unknown"
msgid "　ウェイターのアルバイトもやっているらしく、その折り目正しさは有珠をして文句のつけどころがない。"
msgstr ""

#. Occurrence 8_4:1434:11021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0007; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1434
msgctxt "text_id=11021 | speaker=alice"
msgid "「…………」"
msgstr ""

#. Occurrence 8_4:1439:11022: scene=8_4
#: 8_4:1439
msgctxt "text_id=11022 | speaker=unknown"
msgid "　お礼までは口にしないが、かすかに<顎|あご>を引いて感謝の意を示す有珠。"
msgstr ""

#. Occurrence 8_4:1444:11023: scene=8_4
#: 8_4:1444
msgctxt "text_id=11023 | speaker=unknown"
msgid "　一方、"
msgstr ""

#. Occurrence 8_4:1468:11024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0012; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1468
msgctxt "text_id=11024 | speaker=aoko"
msgid "「天城浜だっけ？　あそこってスタジアムがある所でしょ。ツアーの会場になるから時々行くけど」"
msgstr ""

#. Occurrence 8_4:1479:11025: scene=8_4
#: 8_4:1479
msgctxt "text_id=11025 | speaker=unknown"
msgid "　全校生徒の見本になるべき生徒会長は、あろう事かロックバンドの話に夢中だった。"
msgstr ""

#. Occurrence 8_4:1499:11026: scene=8_4
#: 8_4:1499
msgctxt "text_id=11026 | speaker=unknown"
msgid "　青子は密かなバンド好きで、中学の頃は暇さえあれば遠出して小さなライブハウスに入り浸っていたらしい。"
msgstr ""

#. Occurrence 8_4:1519:11027: scene=8_4
#: 8_4:1519
msgctxt "text_id=11027 | speaker=unknown"
msgid "　もちろん、草十郎にはよく分からない世界である。"
msgstr ""

#. Occurrence 8_4:1556:11028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0013; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1556
msgctxt "text_id=11028 | speaker=aoko"
msgid "「それよりまた新しいバイトはじめたんだ。そんなに働いてどうする気なのよ、草十郎は」"
msgstr ""

#. Occurrence 8_4:1597:11029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0006; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1597
msgctxt "text_id=11029 | speaker=soujuurou"
msgid "「……ああ、よく聞いてくれたね。"
msgstr ""

#. Occurrence 8_4:1603:11030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0007; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1603
msgctxt "text_id=11030 | speaker=soujuurou"
msgid "　本人の名誉のために名前は伏せるけど、誰かさんと誰かさんが俺の少ない収入を無慈悲に奪っていくから、働く先を増やしたんだ」"
msgstr ""

#. Occurrence 8_4:1613:11031: scene=8_4
#: 8_4:1613
msgctxt "text_id=11031 | speaker=unknown"
msgid "　静希草十郎、せいいっぱいの抵抗だった。"
msgstr ""

#. Occurrence 8_4:1618:11032: scene=8_4
#: 8_4:1618
msgctxt "text_id=11032 | speaker=unknown"
msgid "　そんな草十郎の独白をまったく聞いていないように、青子はティーカップを口に運ぶ。"
msgstr ""

#. Occurrence 8_4:1659:11033: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0008; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1659
msgctxt "text_id=11033 | speaker=alice"
msgid "「それは大変ね」"
msgstr ""

#. Occurrence 8_4:1664:11034: scene=8_4
#: 8_4:1664
msgctxt "text_id=11034 | speaker=unknown"
msgid "　ことり、と静かにカップを置く有珠。"
msgstr ""

#. Occurrence 8_4:1669:11035: scene=8_4
#: 8_4:1669
msgctxt "text_id=11035 | speaker=unknown"
msgid "　……彼女にいたっては、本気で分かっていない節もある。"
msgstr ""

#. Occurrence 8_4:1692:11036: scene=8_4
#: 8_4:1692
msgctxt "text_id=11036 | speaker=unknown"
msgid "　そんな有珠と草十郎を見て、青子はくっくっと笑いを堪えていた。"
msgstr ""

#. Occurrence 8_4:1728:11037: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0008; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1728
msgctxt "text_id=11037 | speaker=soujuurou"
msgid "「……はあ。言った自分が未熟だった」"
msgstr ""

#. Occurrence 8_4:1734:11038: scene=8_4
#: 8_4:1734
msgctxt "text_id=11038 | speaker=unknown"
msgid "　がっくりと肩を落とし紅茶を一口飲んでみる。"
msgstr ""

#. Occurrence 8_4:1752:11039: scene=8_4
#: 8_4:1752
msgctxt "text_id=11039 | speaker=unknown"
msgid "　やっぱり、彼にはいまいち不鮮明な味わいだ。"
msgstr ""

#. Occurrence 8_4:1789:11040: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0009; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1789
msgctxt "text_id=11040 | speaker=soujuurou"
msgid "「ま、アルバイトが多いって分かってくれるだけでいいか。"
msgstr ""

#. Occurrence 8_4:1795:11041: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0010; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1795
msgctxt "text_id=11041 | speaker=soujuurou"
msgid "　そういったワケだから、冬休み中は夜も留守にする。例の薬はアルバイト先で飲むしかないんだけど―――」"
msgstr ""

#. Occurrence 8_4:1821:11042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0014; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1821
msgctxt "text_id=11042 | speaker=aoko"
msgid "「ああ、それなら心配いらないわ。もうあれは止めたから。"
msgstr ""

#. Occurrence 8_4:1833:11043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0015; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1833
msgctxt "text_id=11043 | speaker=aoko"
msgid "　いちいち作るのも面倒だし、もっと静希クンに似合うのを見付けてきたの」"
msgstr ""

#. Occurrence 8_4:1869:11044: scene=8_4
#: 8_4:1869
msgctxt "text_id=11044 | speaker=unknown"
msgid "　ニマア、と性悪<極|きわ>まりない笑み。"
msgstr ""

#. Occurrence 8_4:1875:11045: scene=8_4
#: 8_4:1875
msgctxt "text_id=11045 | speaker=unknown"
msgid "　青子はジャケットのポケットに手をいれて、愛らしい紙袋を取り出した。"
msgstr ""

#. Occurrence 8_4:1880:11046: scene=8_4
#: 8_4:1880
msgctxt "text_id=11046 | speaker=unknown"
msgid "　直径二十センチもない円形の何かを、プレゼント用の袋で包んでいる。"
msgstr ""

#. Occurrence 8_4:1928:11047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0016; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1928
msgctxt "text_id=11047 | speaker=aoko"
msgid "「はい、これは入居祝い。これからはそれを付けておくのよ、草十郎」"
msgstr ""

#. Occurrence 8_4:1934:11048: scene=8_4
#: 8_4:1934
msgctxt "text_id=11048 | speaker=unknown"
msgid "　紙袋を開ける草十郎。"
msgstr ""

#. Occurrence 8_4:1964:11049: scene=8_4
#: 8_4:1964
msgctxt "text_id=11049 | speaker=unknown"
msgid "　出てきたのは白色のベルトだった。"
msgstr ""

#. Occurrence 8_4:1969:11050: scene=8_4
#: 8_4:1969
msgctxt "text_id=11050 | speaker=unknown"
msgid "　ズボンの腰に付けるものではない。"
msgstr ""

#. Occurrence 8_4:1974:11051: scene=8_4
#: 8_4:1974
msgctxt "text_id=11051 | speaker=unknown"
msgid "　嘘偽りなく、極めて端的に説明すると、首輪以外の何物でもないのだった。"
msgstr ""

#. Occurrence 8_4:2010:11052: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0009; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2010
msgctxt "text_id=11052 | speaker=alice"
msgid "「青子……」"
msgstr ""

#. Occurrence 8_4:2016:11053: scene=8_4
#: 8_4:2016
msgctxt "text_id=11053 | speaker=unknown"
msgid "　さすがにどうかと思ったのか、有珠は顔を曇らせる。"
msgstr ""

#. Occurrence 8_4:2021:11054: scene=8_4
#: 8_4:2021
msgctxt "text_id=11054 | speaker=unknown"
msgid "　友人の人の悪さに呆れたのか、草十郎への同情かは不明である。"
msgstr ""

#. Occurrence 8_4:2060:11055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0017; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2060
msgctxt "text_id=11055 | speaker=aoko"
msgid "「どう、気に入った？」"
msgstr ""

#. Occurrence 8_4:2066:11056: scene=8_4
#: 8_4:2066
msgctxt "text_id=11056 | speaker=unknown"
msgid "　一方、青子は明らかに正気ではない。"
msgstr ""

#. Occurrence 8_4:2071:11057: scene=8_4
#: 8_4:2071
msgctxt "text_id=11057 | speaker=unknown"
msgid "　もとい、本気ではない。"
msgstr ""

#. Occurrence 8_4:2076:11058: scene=8_4
#: 8_4:2076
msgctxt "text_id=11058 | speaker=unknown"
msgid "　これは冗談半分の<悪戯|いたずら>で、嫌がる草十郎の反応を期待しているだけなのは見え見えだ。"
msgstr ""

#. Occurrence 8_4:2109:11059: scene=8_4
#: 8_4:2109
msgctxt "text_id=11059 | speaker=unknown"
msgid "　―――が。"
msgstr ""

#. Occurrence 8_4:2126:11060: scene=8_4
#: 8_4:2126
msgctxt "text_id=11060 | speaker=unknown"
msgid "　贈られた本人である草十郎は、わりかし真剣に首輪を見つめているのだった。"
msgstr ""

#. Occurrence 8_4:2138:11061: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0011; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2138
msgctxt "text_id=11061 | speaker=soujuurou"
msgid "「うん。意味は掴みかねるけど、こういうものを人から貰うのは、これが初めてだ」"
msgstr ""

#. Occurrence 8_4:2158:11062: scene=8_4
#: 8_4:2158
msgctxt "text_id=11062 | speaker=unknown"
msgid "　……幸せな思い出にひたるような呟き。"
msgstr ""

#. Occurrence 8_4:2182:11063: scene=8_4
#: 8_4:2182
msgctxt "text_id=11063 | speaker=unknown"
msgid "　それを横で見ながら、何か間違っていると有珠は目を細める。"
msgstr ""

#. Occurrence 8_4:2214:11064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0012; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2214
msgctxt "text_id=11064 | speaker=soujuurou"
msgid "「けど、これは何に使うんだ？」"
msgstr ""

#. Occurrence 8_4:2240:11065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0018; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2240
msgctxt "text_id=11065 | speaker=aoko"
msgid "「簡単よ。<緊箍児|きんこじ>と同じで、飼い犬が主人に逆らうと首を絞めるの。あっちは頭につけてたけど、それよりは首のがマシでしょう？」"
msgstr ""

#. Occurrence 8_4:2245:11066: scene=8_4
#: 8_4:2245
msgctxt "text_id=11066 | speaker=unknown"
msgid "　む、とようやく青子の意地悪さに気が付く草十郎。"
msgstr ""

#. Occurrence 8_4:2250:11067: scene=8_4
#: 8_4:2250
msgctxt "text_id=11067 | speaker=unknown"
msgid "　その緊箍児とやらは一体どんな経緯で、どんな悪党が使用するに至ったのか、ぜひ聞かせてほしいところである。"
msgstr ""

#. Occurrence 8_4:2286:11068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0013; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2286
msgctxt "text_id=11068 | speaker=soujuurou"
msgid "「……つまり、秘密をばらしたり逆らったりしたら首が絞まる、と。"
msgstr ""

#. Occurrence 8_4:2292:11069: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0014; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2292
msgctxt "text_id=11069 | speaker=soujuurou"
msgid "　―――やっぱり熱でもあるんじゃないのか、蒼崎は」"
msgstr ""

#. Occurrence 8_4:2314:11070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0019; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2314
msgctxt "text_id=11070 | speaker=aoko"
msgid "「あら、首輪はいや？　せっかく草十郎に似合いそうな物を見付けたのに」"
msgstr ""

#. Occurrence 8_4:2334:11071: scene=8_4
#: 8_4:2334
msgctxt "text_id=11071 | speaker=unknown"
msgid "　からかいの入った微笑み。"
msgstr ""

#. Occurrence 8_4:2339:11072: scene=8_4
#: 8_4:2339
msgctxt "text_id=11072 | speaker=unknown"
msgid "　しかし。青子本人、半ば冗談のつもりで用意したソレを、"
msgstr ""

#. Occurrence 8_4:2380:11073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0015; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2380
msgctxt "text_id=11073 | speaker=soujuurou"
msgid "「……それもそうか。毎日毒を飲むよりはましだし、このベルト自体、いいものだし。"
msgstr ""

#. Occurrence 8_4:2391:11074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0016; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2391
msgctxt "text_id=11074 | speaker=soujuurou"
msgid "　うん、気に入った。ありがとう蒼崎」"
msgstr ""

#. Occurrence 8_4:2413:11075: scene=8_4
#: 8_4:2413
msgctxt "text_id=11075 | speaker=unknown"
msgid "　お世辞ではなく、彼は本気でそう言った。"
msgstr ""

#. Occurrence 8_4:2423:11076: scene=8_4
#: 8_4:2423
msgctxt "text_id=11076 | speaker=unknown"
msgid "　さすがに青子も意表をつかれたのか、ほんと？　と小声で聞き返す。"
msgstr ""

#. Occurrence 8_4:2457:11077: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0017; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2457
msgctxt "text_id=11077 | speaker=soujuurou"
msgid "「人の厚意はどんなものだって嬉しいよ。"
msgstr ""

#. Occurrence 8_4:2463:11078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0018; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2463
msgctxt "text_id=11078 | speaker=soujuurou"
msgid "　それに、それが蒼崎なら尚更だ」"
msgstr ""

#. Occurrence 8_4:2492:11079: scene=8_4
#: 8_4:2492
msgctxt "text_id=11079 | speaker=unknown"
msgid "　言って、草十郎は<首輪|ベルト>を首に巻いた。"
msgstr ""

#. Occurrence 8_4:2497:11080: scene=8_4
#: 8_4:2497
msgctxt "text_id=11080 | speaker=unknown"
msgid "　首に巻いた布を覆うように。"
msgstr ""

#. Occurrence 8_4:2520:11081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0019; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2520
msgctxt "text_id=11081 | speaker=soujuurou"
msgid "「こんな感じかな。きついけど、そのうち慣れるだろ」"
msgstr ""

#. Occurrence 8_4:2526:11082: scene=8_4
#: 8_4:2526
msgctxt "text_id=11082 | speaker=unknown"
msgid "　言いつつ、居心地が悪そうにベルトをずらす。"
msgstr ""

#. Occurrence 8_4:2531:11083: scene=8_4
#: 8_4:2531
msgctxt "text_id=11083 | speaker=unknown"
msgid "　その仕草はどことなく倒錯的で、言い出した青子本人も赤面してしまった。"
msgstr ""

#. Occurrence 8_4:2536:11084: scene=8_4
#: 8_4:2536
msgctxt "text_id=11084 | speaker=unknown"
msgid "　昨日見た傷跡が、鮮明に思い出されたせいかもしれない。"
msgstr ""

#. Occurrence 8_4:2574:11085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0020; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2574
msgctxt "text_id=11085 | speaker=soujuurou"
msgid "「よし。留め方はこれでいいのか」"
msgstr ""

#. Occurrence 8_4:2602:11086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0020; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2602
msgctxt "text_id=11086 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_4:2607:11087: scene=8_4
#: 8_4:2607
msgctxt "text_id=11087 | speaker=unknown"
msgid "　確認のために近寄る草十郎に、うっ、と罪悪感から後退する青子。"
msgstr ""

#. Occurrence 8_4:2642:11088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0021; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2642
msgctxt "text_id=11088 | speaker=soujuurou"
msgid "「？　黙ってちゃ分からないのに。"
msgstr ""

#. Occurrence 8_4:2648:11089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0022; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2648
msgctxt "text_id=11089 | speaker=soujuurou"
msgid "　いいよ、有珠に聞くから」"
msgstr ""

#. Occurrence 8_4:2688:11090: scene=8_4
#: 8_4:2688
msgctxt "text_id=11090 | speaker=unknown"
msgid "　青子から有珠に視線を移す草十郎。"
msgstr ""

#. Occurrence 8_4:2693:11091: scene=8_4
#: 8_4:2693
msgctxt "text_id=11091 | speaker=unknown"
msgid "　有珠はしみじみと首輪をした草十郎を見つめて、"
msgstr ""

#. Occurrence 8_4:2720:11092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0010; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2720
msgctxt "text_id=11092 | speaker=alice"
msgid "「―――ロックね。青子、趣味に走りすぎよ」"
msgstr ""

#. Occurrence 8_4:2745:11093: scene=8_4
#: 8_4:2745
msgctxt "text_id=11093 | speaker=unknown"
msgid "　同居人へのとどめを口にした。"
msgstr ""

#. Occurrence 8_4:2774:11094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0021; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2774
msgctxt "text_id=11094 | speaker=aoko"
msgid "「や、"
msgstr ""

msgctxt "text_id=11095 | speaker=unknown"
msgid "やかましい、そんなんじゃないっ！"
msgstr ""

#. Occurrence 8_4:2803:11096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0022; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2803
msgctxt "text_id=11096 | speaker=aoko"
msgid "　もういい、とにかくそういう事よ！　これからはその首輪が薬の代わりよ、せいぜい秘密を守ることね！」"
msgstr ""

#. Occurrence 8_4:2838:11097: scene=8_4
#: 8_4:2838
msgctxt "text_id=11097 | speaker=unknown"
msgid "　なぜか語尾を強調して、青子はドスドスと廊下に向かう。"
msgstr ""

#. Occurrence 8_4:2876:11098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0023; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2876
msgctxt "text_id=11098 | speaker=aoko"
msgid "「それと、これからお昼まで仮眠をとるけど、くだらないコトで起こしたら殺すから！」"
msgstr ""

#. Occurrence 8_4:2888:11099: scene=8_4
#: 8_4:2888
msgctxt "text_id=11099 | speaker=unknown"
msgid "　壁よ砕けよとばかりに扉を閉め、青子は居間を後にした。"
msgstr ""

#. Occurrence 8_4:2893:11100: scene=8_4
#: 8_4:2893
msgctxt "text_id=11100 | speaker=unknown"
msgid "　そんな青子を、草十郎は不思議そうに見送っている。"
msgstr ""

#. Occurrence 8_4:2924:11101: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0023; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2924
msgctxt "text_id=11101 | speaker=soujuurou"
msgid "「……なんで蒼崎は、いつもいきなり怒るんだろう」"
msgstr ""

#. Occurrence 8_4:2929:11102: scene=8_4
#: 8_4:2929
msgctxt "text_id=11102 | speaker=unknown"
msgid "　有珠が目前にいる事を忘れて、つい呟く草十郎。"
msgstr ""

#. Occurrence 8_4:2954:11103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11103 | speaker=alice"
msgid "「静希君には悪意が通じないからでしょう。"
msgstr ""

#. Occurrence 8_4:2954:11104: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11104 | speaker=alice"
msgid "　気にする必要はないわ」"
msgstr ""

#. Occurrence 8_4:2990:11105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0024; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2990
msgctxt "text_id=11105 | speaker=soujuurou"
msgid "「悪意って、今のが？」"
msgstr ""

#. Occurrence 8_4:3010:11106: scene=8_4
#: 8_4:3010
msgctxt "text_id=11106 | speaker=unknown"
msgid "　聞き返されて、有珠はハッと顔を上げた。"
msgstr ""

#. Occurrence 8_4:3015:11107: scene=8_4
#: 8_4:3015
msgctxt "text_id=11107 | speaker=unknown"
msgid "　その目は、今の自分の行為に驚いたものだ。"
msgstr ""

#. Occurrence 8_4:3044:11108: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0012; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3044
msgctxt "text_id=11108 | speaker=alice"
msgid "「……なんでもないから、気にしないで」"
msgstr ""

#. Occurrence 8_4:3050:11109: scene=8_4
#: 8_4:3050
msgctxt "text_id=11109 | speaker=unknown"
msgid "　簡潔に答えて、いつもの無表情に戻る有珠。"
msgstr ""

#. Occurrence 8_4:3055:11110: scene=8_4
#: 8_4:3055
msgctxt "text_id=11110 | speaker=unknown"
msgid "　青子の気持ちなど、いちいち説明するまでもない。"
msgstr ""

#. Occurrence 8_4:3074:11111: scene=8_4
#: 8_4:3074
msgctxt "text_id=11111 | speaker=unknown"
msgid "　青子は草十郎の困る顔が見たくて首輪を買ってきたのに、その悪戯心が素直に喜ばれ、自らの良心に背中をくすぐられただけなのだ。"
msgstr ""

#. Occurrence 8_4:3094:11112: scene=8_4
#: 8_4:3094
msgctxt "text_id=11112 | speaker=unknown"
msgid "　草十郎は青子に怒られたと勘違いしているが、今のは青子の自爆にすぎない。"
msgstr ""

#. Occurrence 8_4:3111:11113: scene=8_4
#: 8_4:3111
msgctxt "text_id=11113 | speaker=unknown"
msgid "　その微笑ましい行き違いを、有珠は草十郎に語らない。"
msgstr ""

#. Occurrence 8_4:3116:11114: scene=8_4
#: 8_4:3116
msgctxt "text_id=11114 | speaker=unknown"
msgid "　面倒だからではなく―――そもそも『意味のない会話をする』思考そのものがない。"
msgstr ""

#. Occurrence 8_4:3136:11115: scene=8_4
#: 8_4:3136
msgctxt "text_id=11115 | speaker=unknown"
msgid "　久遠寺有珠はそういう風に育てられている。"
msgstr ""

#. Occurrence 8_4:3163:11116: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0013; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3163
msgctxt "text_id=11116 | speaker=alice"
msgid "「……静希君は、これからどうするの？」"
msgstr ""

#. Occurrence 8_4:3169:11117: scene=8_4
#: 8_4:3169
msgctxt "text_id=11117 | speaker=unknown"
msgid "　唐突に、有珠はそんな事を問いただした。"
msgstr ""

#. Occurrence 8_4:3195:11118: scene=8_4
#: 8_4:3195
msgctxt "text_id=11118 | speaker=unknown"
msgid "　草十郎はしばし考えこんで、"
msgstr ""

#. Occurrence 8_4:3231:11119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0025; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3231
msgctxt "text_id=11119 | speaker=soujuurou"
msgid "「夕方までゆっくりするよ。ここのところ忙しすぎた。"
msgstr ""

#. Occurrence 8_4:3237:11120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0026; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3237
msgctxt "text_id=11120 | speaker=soujuurou"
msgid "　せっかくだからテレビも見ていたいし、お昼には蒼崎を起こさないといけないだろ？」"
msgstr ""

#. Occurrence 8_4:3273:11121: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0014; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3273
msgctxt "text_id=11121 | speaker=alice"
msgid "「……そう。なら静かにしていて」"
msgstr ""

#. Occurrence 8_4:3284:11122: scene=8_4
#: 8_4:3284
msgctxt "text_id=11122 | speaker=unknown"
msgid "　有珠は小さくため息をついて立ち上がった。"
msgstr ""

#. Occurrence 8_4:3289:11123: scene=8_4
#: 8_4:3289
msgctxt "text_id=11123 | speaker=unknown"
msgid "　静かにしていて。"
msgstr ""

#. Occurrence 8_4:3306:11124: scene=8_4
#: 8_4:3306
msgctxt "text_id=11124 | speaker=unknown"
msgid "　その言葉が何を示していたのか、草十郎は数分後に実感する事になる。"
msgstr ""

#. Occurrence 8_5:62:11125: scene=8_5
#: 8_5:62
msgctxt "text_id=11125 | speaker=unknown"
msgid "　窓からの日射しが明るい。"
msgstr ""

#. Occurrence 8_5:67:11126: scene=8_5
#: 8_5:67
msgctxt "text_id=11126 | speaker=unknown"
msgid "　そろそろテレビのお茶の間番組にエンジンがかかってくる午前九時。"
msgstr ""

#. Occurrence 8_5:72:11127: scene=8_5
#: 8_5:72
msgctxt "text_id=11127 | speaker=unknown"
msgid "　草十郎はソファーに座って、外の様子を眺めていた。"
msgstr ""

#. Occurrence 8_5:95:11128: scene=8_5
#: 8_5:95
msgctxt "text_id=11128 | speaker=unknown"
msgid "　隣室のサンルームから見える中庭の荒廃ぶりは、とても一言では表せない。"
msgstr ""

#. Occurrence 8_5:100:11129: scene=8_5
#: 8_5:100
msgctxt "text_id=11129 | speaker=unknown"
msgid "　あるがままの自然は<尊|とうと>いが、人の手によって整頓された自然にも理解のある草十郎である。"
msgstr ""

#. Occurrence 8_5:121:11130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0000; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:121
msgctxt "text_id=11130 | speaker=soujuurou"
msgid "“……アレは、近いうちになんとかせねばなるまい”"
msgstr ""

#. Occurrence 8_5:136:11131: scene=8_5
#: 8_5:136
msgctxt "text_id=11131 | speaker=unknown"
msgid "　などと、こぢんまりとした野望に燃えながら、教科書のページをまた一枚めくる。"
msgstr ""

#. Occurrence 8_5:141:11132: scene=8_5
#: 8_5:141
msgctxt "text_id=11132 | speaker=unknown"
msgid "　テーブルには数学のテキストと青子印のノート。"
msgstr ""

#. Occurrence 8_5:152:11133: scene=8_5
#: 8_5:152
msgctxt "text_id=11133 | speaker=unknown"
msgid "　一見して休日も予習を怠らない優等生……ではあるが、その実、これは妥協の結果である。"
msgstr ""

#. Occurrence 8_5:157:11134: scene=8_5
#: 8_5:157
msgctxt "text_id=11134 | speaker=unknown"
msgid "　草十郎が第一目的とした朝のテレビ観賞は、ある理由から断念されてしまったからだ。"
msgstr ""

#. Occurrence 8_5:188:11135: scene=8_5
#: 8_5:188
msgctxt "text_id=11135 | speaker=unknown"
msgid "　理由は言うまでもない。"
msgstr ""

#. Occurrence 8_5:211:11136: scene=8_5
#: 8_5:211
msgctxt "text_id=11136 | speaker=unknown"
msgid "　こうして、今も草十郎の正面で読書に没頭する、久遠寺有珠に気を遣っての事だ。"
msgstr ""

#. Occurrence 8_5:216:11137: scene=8_5
#: 8_5:216
msgctxt "text_id=11137 | speaker=unknown"
msgid "　てっきり自室に引きこもると思われていた彼女は、古びた本を持ち出して読書を始めてしまった。"
msgstr ""

#. Occurrence 8_5:235:11138: scene=8_5
#: 8_5:235
msgctxt "text_id=11138 | speaker=unknown"
msgid "　静かにしていて、とはこういう事で、もはや無遠慮にテレビをつける事は難しい。"
msgstr ""

#. Occurrence 8_5:259:11139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0001; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:259
msgctxt "text_id=11139 | speaker=soujuurou"
msgid "“……とりあえず、しばらくテレビは控えよう”"
msgstr ""

#. Occurrence 8_5:265:11140: scene=8_5
#: 8_5:265
msgctxt "text_id=11140 | speaker=unknown"
msgid "　そんな結論に達し、それじゃあ、と草十郎は赤点の補習課題に手を出したのだ。"
msgstr ""

#. Occurrence 8_5:270:11141: scene=8_5
#: 8_5:270
msgctxt "text_id=11141 | speaker=unknown"
msgid "　なぜか居間で。"
msgstr ""

#. Occurrence 8_5:276:11142: scene=8_5
#: 8_5:276
msgctxt "text_id=11142 | speaker=unknown"
msgid "ここに留まる理由もなかったが、自室に戻る理由も、同じぐらいなかったらしい。"
msgstr ""

#. Occurrence 8_5:301:11143: scene=8_5
#: 8_5:301
msgctxt "text_id=11143 | speaker=unknown"
msgid "　かくて、彼は有珠がいるにも拘わらず、<暢気|のんき>に<教科書|テキスト>に蛍光ペンなどを引いていたりする。"
msgstr ""

#. Occurrence 8_5:306:11144: scene=8_5
#: 8_5:306
msgctxt "text_id=11144 | speaker=unknown"
msgid "　草十郎にしてみれば屋根裏の自室も、有珠のいる居間もそう変わりはない。"
msgstr ""

#. Occurrence 8_5:311:11145: scene=8_5
#: 8_5:311
msgctxt "text_id=11145 | speaker=unknown"
msgid "　波乱の予兆さえなければ人食い虎とでも同居する―――"
msgstr ""

#. Occurrence 8_5:316:11146: scene=8_5
#: 8_5:316
msgctxt "text_id=11146 | speaker=unknown"
msgid "　それが静希草十郎の、最大にして最悪の長所だった。"
msgstr ""

#. Occurrence 8_5:363:11147: scene=8_5
#: 8_5:363
msgctxt "text_id=11147 | speaker=unknown"
msgid "　気が付けば、時計の針が十一時を指していた。"
msgstr ""

#. Occurrence 8_5:368:11148: scene=8_5
#: 8_5:368
msgctxt "text_id=11148 | speaker=unknown"
msgid "　二時間近くかけても、数学の課題は半分も終わらない。"
msgstr ""

#. Occurrence 8_5:373:11149: scene=8_5
#: 8_5:373
msgctxt "text_id=11149 | speaker=unknown"
msgid "　この程度で音をあげる自分の根性の無さに、草十郎は消沈する。"
msgstr ""

#. Occurrence 8_5:391:11150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0002; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:391
msgctxt "text_id=11150 | speaker=soujuurou"
msgid "『……それにくらべて、蒼崎は頑張ってる』"
msgstr ""

#. Occurrence 8_5:396:11151: scene=8_5
#: 8_5:396
msgctxt "text_id=11151 | speaker=unknown"
msgid "　ぽん、とノートの上を転がっていくシャープペン。"
msgstr ""

#. Occurrence 8_5:422:11152: scene=8_5
#: 8_5:422
msgctxt "text_id=11152 | speaker=unknown"
msgid "　試験が終わってからこっち、青子たちが何やら活動している事は知っている。"
msgstr ""

#. Occurrence 8_5:427:11153: scene=8_5
#: 8_5:427
msgctxt "text_id=11153 | speaker=unknown"
msgid "　それで彼女がほとんど眠っていない事も、"
msgstr ""

#. Occurrence 8_5:432:11154: scene=8_5
#: 8_5:432
msgctxt "text_id=11154 | speaker=unknown"
msgid "　試験中、自分を無視していればもっと楽になっていたであろう事も、分かっていた。"
msgstr ""

#. Occurrence 8_5:452:11155: scene=8_5
#: 8_5:452
msgctxt "text_id=11155 | speaker=unknown"
msgid "　今日の仮眠だって、青子にとっては何日かぶりのまともな睡眠だろう。"
msgstr ""

#. Occurrence 8_5:457:11156: scene=8_5
#: 8_5:457
msgctxt "text_id=11156 | speaker=unknown"
msgid "　疲労はとうにピークの筈だ。なのに、そんな素振りも見せないで青子はきびきびと歩いている。"
msgstr ""

#. Occurrence 8_5:488:11157: scene=8_5
#: 8_5:488
msgctxt "text_id=11157 | speaker=unknown"
msgid "　弱音を吐かない、のではなく。"
msgstr ""

#. Occurrence 8_5:493:11158: scene=8_5
#: 8_5:493
msgctxt "text_id=11158 | speaker=unknown"
msgid "　弱音そのものが浮かんでいない、前向きで強い<信念|こころ>。"
msgstr ""

#. Occurrence 8_5:498:11159: scene=8_5
#: 8_5:498
msgctxt "text_id=11159 | speaker=unknown"
msgid "　彼女が時に理不尽として映るのは、そのまっすぐさ故だろう。"
msgstr ""

#. Occurrence 8_5:531:11160: scene=8_5
#: 8_5:531
msgctxt "text_id=11160 | speaker=unknown"
msgid "　それを言うなら目前の有珠だって同じかもしれない。"
msgstr ""

#. Occurrence 8_5:556:11161: scene=8_5
#: 8_5:556
msgctxt "text_id=11161 | speaker=unknown"
msgid "　目的に向かってひた走る彼女たちを見ていると、漠然と自分の中途半端さを考えてしまう。"
msgstr ""

#. Occurrence 8_5:562:11162: scene=8_5
#: 8_5:562
msgctxt "text_id=11162 | speaker=unknown"
msgid "　今までは新生活に慣れようと必死だったけれど、もし慣れてしまったのなら、その後はどうする気なのか、と。"
msgstr ""

#. Occurrence 8_5:597:11163: scene=8_5
#: 8_5:597
msgctxt "text_id=11163 | speaker=unknown"
msgid "　それを思うと、草十郎の心は暗い影に<覆|おお>われる。"
msgstr ""

#. Occurrence 8_5:602:11164: scene=8_5
#: 8_5:602
msgctxt "text_id=11164 | speaker=unknown"
msgid "　自分は彼女たちのような、明確な目的はもう見つからない気がするからだ。"
msgstr ""

#. Occurrence 8_5:618:11165: scene=8_5
#: 8_5:618
msgctxt "text_id=11165 | speaker=unknown"
msgid "　……山から下りた時から。"
msgstr ""

#. Occurrence 8_5:623:11166: scene=8_5
#: 8_5:623
msgctxt "text_id=11166 | speaker=unknown"
msgid "　彼の糸は断ち切れて、二度と戻ることはない。"
msgstr ""

#. Occurrence 8_5:643:11167: scene=8_5
#: 8_5:643
msgctxt "text_id=11167 | speaker=unknown"
msgid "　糸の切れた<凧|たこ>は<惰性|だせい>で流れていくだけだ。"
msgstr ""

#. Occurrence 8_5:658:11168: scene=8_5
#: 8_5:658
msgctxt "text_id=11168 | speaker=unknown"
msgid "　その先には何もないと分かっていても、地に足がついていないのでどうにもならない。"
msgstr ""

#. Occurrence 8_5:663:11169: scene=8_5
#: 8_5:663
msgctxt "text_id=11169 | speaker=unknown"
msgid "　いずれ空にまぎれて、地上から見えなくなる。"
msgstr ""

#. Occurrence 8_5:697:11170: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0003; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:697
msgctxt "text_id=11170 | speaker=soujuurou"
msgid "『……そうだな。便利な物はあふれているけど、本当に望むものは―――』"
msgstr ""

#. Occurrence 8_5:703:11171: scene=8_5
#: 8_5:703
msgctxt "text_id=11171 | speaker=unknown"
msgid "　町を歩くだけで山ほどある筈なのに、どうしても見つけ出せない。"
msgstr ""

#. Occurrence 8_5:723:11172: scene=8_5
#: 8_5:723
msgctxt "text_id=11172 | speaker=unknown"
msgid "　もう何度も繰り返した自問。"
msgstr ""

#. Occurrence 8_5:728:11173: scene=8_5
#: 8_5:728
msgctxt "text_id=11173 | speaker=unknown"
msgid "　自分に言い聞かせたところで気持ちは晴れるどころか、暗くなっていく一方だった。"
msgstr ""

#. Occurrence 8_5:733:11174: scene=8_5
#: 8_5:733
msgctxt "text_id=11174 | speaker=unknown"
msgid "　それとも、あるいは。"
msgstr ""

#. Occurrence 8_5:738:11175: scene=8_5
#: 8_5:738
msgctxt "text_id=11175 | speaker=unknown"
msgid "　己の半端さを嘆くほどには、いつか、希望らしきものが見つかると<縋|すが>っているのだろうか……？"
msgstr ""

#. Occurrence 8_5:765:11176: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0004; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:765
msgctxt "text_id=11176 | speaker=soujuurou"
msgid "「―――――はあ」"
msgstr ""

#. Occurrence 8_5:772:11177: scene=8_5
#: 8_5:772
msgctxt "text_id=11177 | speaker=unknown"
msgid "　自分の弱音に呆れて、草十郎はノートを閉じた。"
msgstr ""

#. Occurrence 8_5:788:11178: scene=8_5
#: 8_5:788
msgctxt "text_id=11178 | speaker=unknown"
msgid "　ふと視線をあげると、ブラウン管に自分の顔が映っている。"
msgstr ""

#. Occurrence 8_5:793:11179: scene=8_5
#: 8_5:793
msgctxt "text_id=11179 | speaker=unknown"
msgid "　昨日まではなかった首の飾りは、まだ居心地が悪そうに巻かれていた。"
msgstr ""

#. Occurrence 8_5:840:11180: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0005; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:840
msgctxt "text_id=11180 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_5:846:11181: scene=8_5
#: 8_5:846
msgctxt "text_id=11181 | speaker=unknown"
msgid "　なるほど。他人の強さを見て自分の弱さを嘆く馬鹿者には、首輪の一つも着けていなくては危なっかしい。"
msgstr ""

#. Occurrence 8_5:875:11182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0006; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:875
msgctxt "text_id=11182 | speaker=soujuurou"
msgid "『まったくだ。悩むのはいっちょ前になってから』"
msgstr ""

#. Occurrence 8_5:887:11183: scene=8_5
#: 8_5:887
msgctxt "text_id=11183 | speaker=unknown"
msgid "　弱音を振り払って、背中を伸ばす。"
msgstr ""

#. Occurrence 8_5:892:11184: scene=8_5
#: 8_5:892
msgctxt "text_id=11184 | speaker=unknown"
msgid "　<鈍|にぶ>った体に活を入れて、草十郎は立ち上がった。"
msgstr ""

#. Occurrence 8_5:933:11185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0007; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:933
msgctxt "text_id=11185 | speaker=soujuurou"
msgid "「よし。何か作るけど、有珠は？」"
msgstr ""

#. Occurrence 8_5:939:11186: scene=8_5
#: 8_5:939
msgctxt "text_id=11186 | speaker=unknown"
msgid "　ついでに。"
msgstr ""

#. Occurrence 8_5:945:11187: scene=8_5
#: 8_5:945
msgctxt "text_id=11187 | speaker=unknown"
msgid "今までやりたい放題していた草十郎だが、きちんと有珠を気にかけていたらしい。"
msgstr ""

#. Occurrence 8_5:985:11188: scene=8_5
#: 8_5:985
msgctxt "text_id=11188 | speaker=unknown"
msgid "　名前を呼ばれて、有珠はハッとあたりを見渡した。"
msgstr ""

#. Occurrence 8_5:990:11189: scene=8_5
#: 8_5:990
msgctxt "text_id=11189 | speaker=unknown"
msgid "　草十郎とは逆に、完全に草十郎を失念していたようだ。"
msgstr ""

#. Occurrence 8_5:1017:11190: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0000; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1017
msgctxt "text_id=11190 | speaker=alice"
msgid "「わ、わたし……？」"
msgstr ""

#. Occurrence 8_5:1038:11191: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0008; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:1038
msgctxt "text_id=11191 | speaker=soujuurou"
msgid "「ああ。有珠、朝から紅茶しか飲んでないだろ。どうせ作るなら、いっぱい作った方がお得なんだ」"
msgstr ""

#. Occurrence 8_5:1064:11192: scene=8_5
#: 8_5:1064
msgctxt "text_id=11192 | speaker=unknown"
msgid "　有珠の返事も待たず、草十郎はエプロンをしながら台所へと歩いていく。"
msgstr ""

#. Occurrence 8_5:1070:11193: scene=8_5
#: 8_5:1070
msgctxt "text_id=11193 | speaker=unknown"
msgid "　それを有珠は手だけで呼び止めるが、草十郎はもう台所に移動していた。"
msgstr ""

#. Occurrence 8_5:1117:11194: scene=8_5
#: 8_5:1117
msgctxt "text_id=11194 | speaker=unknown"
msgid "　……わざわざ台所まで足を運び、自分の分はいらない、というのも<躊躇|ためら>われる。"
msgstr ""

#. Occurrence 8_5:1122:11195: scene=8_5
#: 8_5:1122
msgctxt "text_id=11195 | speaker=unknown"
msgid "　というか、空腹なのは事実なのだ。"
msgstr ""

#. Occurrence 8_5:1127:11196: scene=8_5
#: 8_5:1127
msgctxt "text_id=11196 | speaker=unknown"
msgid "　草十郎の提案は、今の彼女の健康状態から見れば合理的である。"
msgstr ""

#. Occurrence 8_5:1147:11197: scene=8_5
#: 8_5:1147
msgctxt "text_id=11197 | speaker=unknown"
msgid "　有珠は空腹で、草十郎は昼食を作る。"
msgstr ""

#. Occurrence 8_5:1152:11198: scene=8_5
#: 8_5:1152
msgctxt "text_id=11198 | speaker=unknown"
msgid "　一緒に作るのなら、別々に昼食を用意する時間を短縮できる。"
msgstr ""

#. Occurrence 8_5:1157:11199: scene=8_5
#: 8_5:1157
msgctxt "text_id=11199 | speaker=unknown"
msgid "　感情論を除けば、有珠にはまったく反論の余地がない。"
msgstr ""

#. Occurrence 8_5:1185:11200: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0001; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1185
msgctxt "text_id=11200 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_5:1191:11201: scene=8_5
#: 8_5:1191
msgctxt "text_id=11201 | speaker=unknown"
msgid "　喉まで出た声を飲みこんで、有珠は草十郎を黙認する事にした。"
msgstr ""

#. Occurrence 8_5:1248:11202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0002; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1248
msgctxt "text_id=11202 | speaker=alice"
msgid "『……変な人』"
msgstr ""

#. Occurrence 8_5:1253:11203: scene=8_5
#: 8_5:1253
msgctxt "text_id=11203 | speaker=unknown"
msgid "　わずかに間をおいて、誰に聞かせるでもなく、控えめに呟きながら。"
msgstr ""

#. Occurrence 8_6:64:11204: scene=8_6
#: 8_6:64
msgctxt "text_id=11204 | speaker=unknown"
msgid "　とは言いつつも実のところ。"
msgstr ""

#. Occurrence 8_6:69:11205: scene=8_6
#: 8_6:69
msgctxt "text_id=11205 | speaker=unknown"
msgid "　今朝からこっち、久遠寺有珠はたいへん立腹していた。"
msgstr ""

#. Occurrence 8_6:130:11206: scene=8_6
#: 8_6:130
msgctxt "text_id=11206 | speaker=unknown"
msgid "　三咲市の支点をチェックして回り、始発の電車で陶川から帰ってくる時から、彼女はずっと、今日は居間で日が暮れるまで読書、文字がゲシュタルトるまで読書、と決めていたのである。"
msgstr ""

#. Occurrence 8_6:135:11207: scene=8_6
#: 8_6:135
msgctxt "text_id=11207 | speaker=unknown"
msgid "　そんな鉄の意志は、居間に余人がいたところで<覆|くつがえ>されるものではない。"
msgstr ""

#. Occurrence 8_6:158:11208: scene=8_6
#: 8_6:158
msgctxt "text_id=11208 | speaker=unknown"
msgid "　ましてや自分は館の主人なのだから、草十郎の為に自室に引きこもるなんてもっての外だ。"
msgstr ""

#. Occurrence 8_6:178:11209: scene=8_6
#: 8_6:178
msgctxt "text_id=11209 | speaker=unknown"
msgid "　……しかし。"
msgstr ""

#. Occurrence 8_6:184:11210: scene=8_6
#: 8_6:184
msgctxt "text_id=11210 | speaker=unknown"
msgid "そうは言いつつも、理由なく草十郎を追い出すのもなんだか間違っている。"
msgstr ""

#. Occurrence 8_6:200:11211: scene=8_6
#: 8_6:200
msgctxt "text_id=11211 | speaker=unknown"
msgid "　現状において、草十郎はたしかに“静かに”している。"
msgstr ""

#. Occurrence 8_6:205:11212: scene=8_6
#: 8_6:205
msgctxt "text_id=11212 | speaker=unknown"
msgid "　彼に問題はない。それでもひとりでいたいなら、有珠の方が自室に戻るべきなのである。"
msgstr ""

#. Occurrence 8_6:251:11213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0000; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:251
msgctxt "text_id=11213 | speaker=alice"
msgid "“……静かにして、じゃなくて、ひとりにさせて、と言うべきだった―――”"
msgstr ""

#. Occurrence 8_6:257:11214: scene=8_6
#: 8_6:257
msgctxt "text_id=11214 | speaker=unknown"
msgid "　そんなジレンマに陥りながら、少しだけ意地になって有珠は居間に残ったのだ。"
msgstr ""

#. Occurrence 8_6:262:11215: scene=8_6
#: 8_6:262
msgctxt "text_id=11215 | speaker=unknown"
msgid "　どうせ、草十郎の方が音をあげて屋根裏部屋に逃げこむだろうと予想して。"
msgstr ""

#. Occurrence 8_6:299:11216: scene=8_6
#: 8_6:299
msgctxt "text_id=11216 | speaker=unknown"
msgid "　結果、予想は大きく外れる事になった。"
msgstr ""

#. Occurrence 8_6:304:11217: scene=8_6
#: 8_6:304
msgctxt "text_id=11217 | speaker=unknown"
msgid "　彼は居間から退散しなかったし、"
msgstr ""

#. Occurrence 8_6:309:11218: scene=8_6
#: 8_6:309
msgctxt "text_id=11218 | speaker=unknown"
msgid "　不思議なことに、少女も草十郎の<存在|こと>が気にならなくなったからだ。"
msgstr ""

#. Occurrence 8_6:329:11219: scene=8_6
#: 8_6:329
msgctxt "text_id=11219 | speaker=unknown"
msgid "　彼は有珠を意識する事なく、また、無視しているわけでもなかった。"
msgstr ""

#. Occurrence 8_6:337:11220: scene=8_6
#: 8_6:337
msgctxt "text_id=11220 | speaker=unknown"
msgid "　お互い無言でいたのに、それで気まずいという事もない。"
msgstr ""

#. Occurrence 8_6:342:11221: scene=8_6
#: 8_6:342
msgctxt "text_id=11221 | speaker=unknown"
msgid "　ひとりでいるような解放感があるのに、誰かが<傍|そば>にいるという安心感がある。"
msgstr ""

#. Occurrence 8_6:362:11222: scene=8_6
#: 8_6:362
msgctxt "text_id=11222 | speaker=unknown"
msgid "　……言葉にすると、静希草十郎という人間はそんな感じだった。"
msgstr ""

#. Occurrence 8_6:380:11223: scene=8_6
#: 8_6:380
msgctxt "text_id=11223 | speaker=unknown"
msgid "　だからこそ、すぐ傍に他人がいたのに眠り続ける、なんて事が出来たのかも知れない。"
msgstr ""

#. Occurrence 8_6:432:11224: scene=8_6
#: 8_6:432
msgctxt "text_id=11224 | speaker=unknown"
msgid "　そんな有珠の内面も知らず、草十郎は台所で何やら調理を続けている。"
msgstr ""

#. Occurrence 8_6:437:11225: scene=8_6
#: 8_6:437
msgctxt "text_id=11225 | speaker=unknown"
msgid "　居間からは見えないけれど、有珠には気楽に調理している後ろ姿が容易に想像できた。"
msgstr ""

#. Occurrence 8_6:473:11226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0001; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:473
msgctxt "text_id=11226 | speaker=alice"
msgid "「……変な人ね、ほんとうに」"
msgstr ""

#. Occurrence 8_6:479:11227: scene=8_6
#: 8_6:479
msgctxt "text_id=11227 | speaker=unknown"
msgid "　二度目の所感を漏らして、有珠は読書を再開した。"
msgstr ""

#. Occurrence 8_6:484:11228: scene=8_6
#: 8_6:484
msgctxt "text_id=11228 | speaker=unknown"
msgid "　居間から差しこむ光はじき正午である事を示している。"
msgstr ""

#. Occurrence 8_6:489:11229: scene=8_6
#: 8_6:489
msgctxt "text_id=11229 | speaker=unknown"
msgid "　冬の曇った天気にしては、その日射しはどこか温かそうだった。"
msgstr ""

#. Occurrence 8_6:536:11230: scene=8_6
#: 8_6:536
msgctxt "text_id=11230 | speaker=unknown"
msgid "　ちょうど正午にさしかかろうとした時、草十郎は二人分の食器を持って居間へ戻ってきた。"
msgstr ""

#. Occurrence 8_6:541:11231: scene=8_6
#: 8_6:541
msgctxt "text_id=11231 | speaker=unknown"
msgid "　大きなクリーム色のお皿には、なんとも言えない色合いの料理が盛られている。"
msgstr ""

#. Occurrence 8_6:597:11232: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0002; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:597
msgctxt "text_id=11232 | speaker=alice"
msgid "「これ、は―――」"
msgstr ""

#. Occurrence 8_6:603:11233: scene=8_6
#: 8_6:603
msgctxt "text_id=11233 | speaker=unknown"
msgid "　期待など、してはいなかった。"
msgstr ""

#. Occurrence 8_6:608:11234: scene=8_6
#: 8_6:608
msgctxt "text_id=11234 | speaker=unknown"
msgid "　期待などしてはいなかったので、粗末なものがきたらそれを理由に断ろう―――"
msgstr ""

#. Occurrence 8_6:613:11235: scene=8_6
#: 8_6:613
msgctxt "text_id=11235 | speaker=unknown"
msgid "　なんて<覚悟|かくご><装填|そうてん>済みの有珠をして、それは、絶句させるに足る魔料理だった。"
msgstr ""

#. Occurrence 8_6:662:11236: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0003; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:662
msgctxt "text_id=11236 | speaker=alice"
msgid "「これ、は、なに？」"
msgstr ""

#. Occurrence 8_6:667:11237: scene=8_6
#: 8_6:667
msgctxt "text_id=11237 | speaker=unknown"
msgid "　おそるおそる口にする有珠。"
msgstr ""

#. Occurrence 8_6:709:11238: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0000; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:709
msgctxt "text_id=11238 | speaker=soujuurou"
msgid "「ん？　なにって、焼きうどんになんか掛けてみた」"
msgstr ""

#. Occurrence 8_6:743:11239: scene=8_6
#: 8_6:743
msgctxt "text_id=11239 | speaker=unknown"
msgid "　青子がいたら鉄拳制裁ものの発言である。"
msgstr ""

#. Occurrence 8_6:765:11240: scene=8_6
#: 8_6:765
msgctxt "text_id=11240 | speaker=unknown"
msgid "　草十郎はなに恥じらう事なく、どん、どん、とテーブルに大皿を置いていく。"
msgstr ""

#. Occurrence 8_6:770:11241: scene=8_6
#: 8_6:770
msgctxt "text_id=11241 | speaker=unknown"
msgid "　ごうごうと立ち上る、<恐山|おそれざん>の憤怒のごとき湯気。"
msgstr ""

#. Occurrence 8_6:775:11242: scene=8_6
#: 8_6:775
msgctxt "text_id=11242 | speaker=unknown"
msgid "　どろどろとドロドロする、エトナ火山の<溶岩|マグマ>のごときなんか。"
msgstr ""

#. Occurrence 8_6:780:11243: scene=8_6
#: 8_6:780
msgctxt "text_id=11243 | speaker=unknown"
msgid "　その下に身を潜める、ごんぶとな無数の<触手|うどん>たち。"
msgstr ""

#. Occurrence 8_6:800:11244: scene=8_6
#: 8_6:800
msgctxt "text_id=11244 | speaker=unknown"
msgid "　……もはや語るまでもない。"
msgstr ""

#. Occurrence 8_6:805:11245: scene=8_6
#: 8_6:805
msgctxt "text_id=11245 | speaker=unknown"
msgid "　これは質より量を重視する、一人暮らしの男子学生にのみ伝わる味わい。"
msgstr ""

#. Occurrence 8_6:825:11246: scene=8_6
#: 8_6:825
msgctxt "text_id=11246 | speaker=unknown"
msgid "　必要なものはレシピとやる気と材料だけ。"
msgstr ""

#. Occurrence 8_6:830:11247: scene=8_6
#: 8_6:830
msgctxt "text_id=11247 | speaker=unknown"
msgid "　喩えるなら、大量の焼きうどんに、大量のあんかけを組み合わせた芸術的なまでの芸術性のなさ。"
msgstr ""

#. Occurrence 8_6:835:11248: scene=8_6
#: 8_6:835
msgctxt "text_id=11248 | speaker=unknown"
msgid "　そう、これこそは紛うことなき<男|おとこ>料理。"
msgstr ""

#. Occurrence 8_6:841:11249: scene=8_6
#: 8_6:841
msgctxt "text_id=11249 | speaker=unknown"
msgid "　またの名をまかないとも言う。"
msgstr ""

#. Occurrence 8_6:905:11250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0004; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:905
msgctxt "text_id=11250 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 8_6:910:11251: scene=8_6
#: 8_6:910
msgctxt "text_id=11251 | speaker=unknown"
msgid "　一時間も何をやっていたかと思えば、せっせとあんかけを作っていたらしい。"
msgstr ""

#. Occurrence 8_6:915:11252: scene=8_6
#: 8_6:915
msgctxt "text_id=11252 | speaker=unknown"
msgid "　焼きうどんだけで十分なのに、もう<一手間|ひとてま>加えたのは草十郎なりに真心だろう。"
msgstr ""

#. Occurrence 8_6:920:11253: scene=8_6
#: 8_6:920
msgctxt "text_id=11253 | speaker=unknown"
msgid "　草十郎は小さくおじぎをしてから箸を手にとった。"
msgstr ""

#. Occurrence 8_6:925:11254: scene=8_6
#: 8_6:925
msgctxt "text_id=11254 | speaker=unknown"
msgid "　有珠にはフォークが用意されている。"
msgstr ""

#. Occurrence 8_6:949:11255: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0005; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:949
msgctxt "text_id=11255 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 8_6:957:11256: scene=8_6
#: 8_6:957
msgctxt "text_id=11256 | speaker=unknown"
msgid "　フォークを手にとって、有珠はあんかけに半分埋まっている麺をつついてみる。"
msgstr ""

#. Occurrence 8_6:962:11257: scene=8_6
#: 8_6:962
msgctxt "text_id=11257 | speaker=unknown"
msgid "　毒見にしか見えない有珠の様子を気にした風もなく、草十郎は行儀よく食べはじめていた。"
msgstr ""

#. Occurrence 8_6:1019:11258: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0006; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1019
msgctxt "text_id=11258 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 8_6:1024:11259: scene=8_6
#: 8_6:1024
msgctxt "text_id=11259 | speaker=unknown"
msgid "　有珠的には挑戦と映ったのか、むっと眉をひそめながら、大雑把すぎる料理を口に運ぶ。"
msgstr ""

#. Occurrence 8_6:1077:11260: scene=8_6
#: 8_6:1077
msgctxt "text_id=11260 | speaker=unknown"
msgid "　……形容し辛い味ではあるが、食べられないほど不味くはない。あえて批評するのなら、わりとクセになる味、というところだった。"
msgstr ""

#. Occurrence 8_6:1125:11261: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0001; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1125
msgctxt "text_id=11261 | speaker=soujuurou"
msgid "「ひとつ、聞きたいんだけど」"
msgstr ""

#. Occurrence 8_6:1143:11262: scene=8_6
#: 8_6:1143
msgctxt "text_id=11262 | speaker=unknown"
msgid "　焼きうどんを食べるのを中断して、草十郎は有珠に語りかけた。"
msgstr ""

#. Occurrence 8_6:1149:11263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0002; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1149
msgctxt "text_id=11263 | speaker=soujuurou"
msgid "「実際の話。魔術師の話はともかくとして、蒼崎はまだ誰にも手をだしてないんじゃないか？」"
msgstr ""

#. Occurrence 8_6:1190:11264: scene=8_6
#: 8_6:1190
msgctxt "text_id=11264 | speaker=unknown"
msgid "　唐突な問いに、有珠は静かに顔を上げた。"
msgstr ""

#. Occurrence 8_6:1195:11265: scene=8_6
#: 8_6:1195
msgctxt "text_id=11265 | speaker=unknown"
msgid "　今まで男料理の観察にうつむいていた有珠の視線が、まっすぐに草十郎と向き合う。"
msgstr ""

#. Occurrence 8_6:1236:11266: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0007; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1236
msgctxt "text_id=11266 | speaker=alice"
msgid "「……おかしな事を訊くのね、静希君は」"
msgstr ""

#. Occurrence 8_6:1255:11267: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0003; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1255
msgctxt "text_id=11267 | speaker=soujuurou"
msgid "「有珠には悪いけど、これは蒼崎本人には訊きようのない事だから。言いたくなければ答えないでくれ」"
msgstr ""

#. Occurrence 8_6:1287:11268: scene=8_6
#: 8_6:1287
msgctxt "text_id=11268 | speaker=unknown"
msgid "　有珠からの返答はない。"
msgstr ""

#. Occurrence 8_6:1292:11269: scene=8_6
#: 8_6:1292
msgctxt "text_id=11269 | speaker=unknown"
msgid "　それを残念に思う事もなく、草十郎は食事を再開した。"
msgstr ""

#. Occurrence 8_6:1297:11270: scene=8_6
#: 8_6:1297
msgctxt "text_id=11270 | speaker=unknown"
msgid "　つるつると麺を食べていく草十郎を、有珠は何の感情もなく眺めている。"
msgstr ""

#. Occurrence 8_6:1302:11271: scene=8_6
#: 8_6:1302
msgctxt "text_id=11271 | speaker=unknown"
msgid "　少女は何度か<逡巡|しゅんじゅん>した後、"
msgstr ""

#. Occurrence 8_6:1342:11272: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0008; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1342
msgctxt "text_id=11272 | speaker=alice"
msgid "「……静希君の言う通り、青子はまだ人を殺した事はないわ。"
msgstr ""

#. Occurrence 8_6:1349:11273: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0009; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1349
msgctxt "text_id=11273 | speaker=alice"
msgid "その行為自体は、何回かこなしてはいるけれど」"
msgstr ""

#. Occurrence 8_6:1355:11274: scene=8_6
#: 8_6:1355
msgctxt "text_id=11274 | speaker=unknown"
msgid "　途切れがちに有珠は言う。"
msgstr ""

#. Occurrence 8_6:1360:11275: scene=8_6
#: 8_6:1360
msgctxt "text_id=11275 | speaker=unknown"
msgid "　それに、草十郎はまた困ったように顔をしかめた。"
msgstr ""

#. Occurrence 8_6:1395:11276: scene=8_6
#: 8_6:1395
msgctxt "text_id=11276 | speaker=unknown"
msgid "　彼は会話の内容にではなく、有珠に対してすまなそうに顔を曇らせている。"
msgstr ""

#. Occurrence 8_6:1400:11277: scene=8_6
#: 8_6:1400
msgctxt "text_id=11277 | speaker=unknown"
msgid "　言いたくなければ、答えなくてよかったのに、と。"
msgstr ""

#. Occurrence 8_6:1405:11278: scene=8_6
#: 8_6:1405
msgctxt "text_id=11278 | speaker=unknown"
msgid "　そんな草十郎の顔に動じず、有珠は淡々と続けていく。"
msgstr ""

#. Occurrence 8_6:1426:11279: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0010; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1426
msgctxt "text_id=11279 | speaker=alice"
msgid "「静希君が見た公園での出来事が、青子にとって初めての殺人行為よ。あいにく相手は人形だったけど」"
msgstr ""

#. Occurrence 8_6:1454:11280: scene=8_6
#: 8_6:1454
msgctxt "text_id=11280 | speaker=unknown"
msgid "　静かに頷く草十郎。"
msgstr ""

#. Occurrence 8_6:1459:11281: scene=8_6
#: 8_6:1459
msgctxt "text_id=11281 | speaker=unknown"
msgid "　その仕草に、有珠は不審そうに目を細めた。"
msgstr ""

#. Occurrence 8_6:1496:11282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0011; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1496
msgctxt "text_id=11282 | speaker=alice"
msgid "「まるで、はじめから分かっていた素振りね」"
msgstr ""

#. Occurrence 8_6:1515:11283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0004; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1515
msgctxt "text_id=11283 | speaker=soujuurou"
msgid "「そうじゃな……いや、そうなのかな。"
msgstr ""

#. Occurrence 8_6:1521:11284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0005; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1521
msgctxt "text_id=11284 | speaker=soujuurou"
msgid "　たまにその手の台詞を言うけど、何か違う気がしたんだ。……だからたぶん、蒼崎はまだ人殺しというのを体験していないんじゃないかって。"
msgstr ""

#. Occurrence 8_6:1527:11285: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0006; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1527
msgctxt "text_id=11285 | speaker=soujuurou"
msgid "　でもまあ、そんな事よりもっと確かなのは」"
msgstr ""

#. Occurrence 8_6:1552:11286: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0012; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1552
msgctxt "text_id=11286 | speaker=alice"
msgid "「静希君が、いま生きているという事ね」"
msgstr ""

#. Occurrence 8_6:1571:11287: scene=8_6
#: 8_6:1571
msgctxt "text_id=11287 | speaker=unknown"
msgid "　ご名答、とばかりに草十郎は苦笑した。"
msgstr ""

#. Occurrence 8_6:1621:11288: scene=8_6
#: 8_6:1621
msgctxt "text_id=11288 | speaker=unknown"
msgid "　……そう。"
msgstr ""

#. Occurrence 8_6:1626:11289: scene=8_6
#: 8_6:1626
msgctxt "text_id=11289 | speaker=unknown"
msgid "　あの夜、もし彼女がそういった<手応|てごた>えを知っていたのなら、あんな回りくどい事にはならなかった。"
msgstr ""

#. Occurrence 8_6:1631:11290: scene=8_6
#: 8_6:1631
msgctxt "text_id=11290 | speaker=unknown"
msgid "　草十郎は青子の顔を見る事なく殺されていただろう。"
msgstr ""

#. Occurrence 8_6:1636:11291: scene=8_6
#: 8_6:1636
msgctxt "text_id=11291 | speaker=unknown"
msgid "　幸か不幸か、あれだけの非情さと行動力を持っていながら、蒼崎青子はいまだ<そ|・><の|・><感|・><覚|・>を知らないのだ。"
msgstr ""

#. Occurrence 8_6:1669:11292: scene=8_6
#: 8_6:1669
msgctxt "text_id=11292 | speaker=unknown"
msgid "　ホッと肩を下ろす草十郎。"
msgstr ""

#. Occurrence 8_6:1674:11293: scene=8_6
#: 8_6:1674
msgctxt "text_id=11293 | speaker=unknown"
msgid "　今まで苦々しかった表情も、いつも通りのぼんやりとしたものに戻る。"
msgstr ""

#. Occurrence 8_6:1679:11294: scene=8_6
#: 8_6:1679
msgctxt "text_id=11294 | speaker=unknown"
msgid "　そこへ、"
msgstr ""

#. Occurrence 8_6:1721:11295: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0013; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1721
msgctxt "text_id=11295 | speaker=alice"
msgid "「―――でも、そんな事は関係ないわ。"
msgstr ""

#. Occurrence 8_6:1727:11296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0014; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1727
msgctxt "text_id=11296 | speaker=alice"
msgid "　あの子はそのあたりが異常だから。行為は理性に、経験は知識でたやすく補ってしまう。"
msgstr ""

#. Occurrence 8_6:1753:11297: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0015; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1753
msgctxt "text_id=11297 | speaker=alice"
msgid "　……そうね。青子はその気になれば、迷う事なく<他人|ひと>の命に手をだせる。静希君ふうに言うのなら、だけど」"
msgstr ""

#. Occurrence 8_6:1773:11298: scene=8_6
#: 8_6:1773
msgctxt "text_id=11298 | speaker=unknown"
msgid "　それだけ言って、有珠はまたフォークで麺をコネコネする。"
msgstr ""

#. Occurrence 8_6:1791:11299: scene=8_6
#: 8_6:1791
msgctxt "text_id=11299 | speaker=unknown"
msgid "　……もしかして楽しくてやっているのだろうか、などと思いながら、草十郎は有珠の言葉を<反芻|はんすう>していた。"
msgstr ""

#. Occurrence 8_6:1816:11300: scene=8_6
#: 8_6:1816
msgctxt "text_id=11300 | speaker=unknown"
msgid "　道徳を犯す自分を容認できる理性と、"
msgstr ""

#. Occurrence 8_6:1821:11301: scene=8_6
#: 8_6:1821
msgctxt "text_id=11301 | speaker=unknown"
msgid "　実経験から得られる確信を超える知性。"
msgstr ""

#. Occurrence 8_6:1826:11302: scene=8_6
#: 8_6:1826
msgctxt "text_id=11302 | speaker=unknown"
msgid "　そんな理屈だけの絵空事を実現できるように、青子は育てられてきたのだろうか。"
msgstr ""

#. Occurrence 8_6:1843:11303: scene=8_6
#: 8_6:1843
msgctxt "text_id=11303 | speaker=unknown"
msgid "　それなら、確かに―――彼女たちが自分と違うのは、納得のいく事ではあるが。"
msgstr ""

#. Occurrence 8_6:1864:11304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0007; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1864
msgctxt "text_id=11304 | speaker=soujuurou"
msgid "「……すまない。こんなことを訊いたのは、蒼崎には内緒にしておいてくれないか？」"
msgstr ""

#. Occurrence 8_6:1882:11305: scene=8_6
#: 8_6:1882
msgctxt "text_id=11305 | speaker=unknown"
msgid "　反省するような、思い詰めた顔。"
msgstr ""

#. Occurrence 8_6:1903:11306: scene=8_6
#: 8_6:1903
msgctxt "text_id=11306 | speaker=unknown"
msgid "　有珠の表情に変化はないが、彼女も初めからそのつもりだったようだ。"
msgstr ""

#. Occurrence 8_6:1937:11307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0008; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1937
msgctxt "text_id=11307 | speaker=soujuurou"
msgid "「ありがとう。なんだか、有珠には内緒話ばかりたまっていくね」"
msgstr ""

#. Occurrence 8_6:1974:11308: scene=8_6
#: 8_6:1974
msgctxt "text_id=11308 | speaker=unknown"
msgid "　草十郎は食事を再開する。"
msgstr ""

#. Occurrence 8_6:1992:11309: scene=8_6
#: 8_6:1992
msgctxt "text_id=11309 | speaker=unknown"
msgid "　まだ有珠は一口しか食べていないのに、彼はそれでたいらげてしまっていた。"
msgstr ""

#. Occurrence 8_6:2013:11310: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0009; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2013
msgctxt "text_id=11310 | speaker=soujuurou"
msgid "「そういえば蒼崎にも訊いたんだけど、有珠と蒼崎はいつもああなのか？」"
msgstr ""

#. Occurrence 8_6:2038:11311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0016; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2038
msgctxt "text_id=11311 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_6:2043:11312: scene=8_6
#: 8_6:2043
msgctxt "text_id=11312 | speaker=unknown"
msgid "　先ほどまでの会話など何処へやら、草十郎はまったく違う話をはじめた。"
msgstr ""

#. Occurrence 8_6:2048:11313: scene=8_6
#: 8_6:2048
msgctxt "text_id=11313 | speaker=unknown"
msgid "　どこかドライな青子と有珠の関係。"
msgstr ""

#. Occurrence 8_6:2053:11314: scene=8_6
#: 8_6:2053
msgctxt "text_id=11314 | speaker=unknown"
msgid "　青子はそれが普通だと語っていたが、有珠からならまた別の見解があるかもしれない。"
msgstr ""

#. Occurrence 8_6:2081:11315: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0017; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2081
msgctxt "text_id=11315 | speaker=alice"
msgid "「……会話が少ない事を言っているのなら、そうなるわ。"
msgstr ""

#. Occurrence 8_6:2087:11316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0018; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2087
msgctxt "text_id=11316 | speaker=alice"
msgid "　けど、別に不便じゃないから」"
msgstr ""

#. Occurrence 8_6:2093:11317: scene=8_6
#: 8_6:2093
msgctxt "text_id=11317 | speaker=unknown"
msgid "　簡潔に答えて、有珠はフォークで麺をくるくると巻いている。"
msgstr ""

#. Occurrence 8_6:2098:11318: scene=8_6
#: 8_6:2098
msgctxt "text_id=11318 | speaker=unknown"
msgid "　巻いてはいるけど、食べるそぶりはまったくなかった。"
msgstr ""

#. Occurrence 8_6:2139:11319: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0010; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2139
msgctxt "text_id=11319 | speaker=soujuurou"
msgid "「不便じゃないって……そういうの、仲がいいって言わないんじゃないか？」"
msgstr ""

#. Occurrence 8_6:2145:11320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0019; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2145
msgctxt "text_id=11320 | speaker=alice"
msgid "「……？　わたしと青子の仲が良くないと、静希君は困るの？」"
msgstr ""

#. Occurrence 8_6:2183:11321: scene=8_6
#: 8_6:2183
msgctxt "text_id=11321 | speaker=unknown"
msgid "　不思議そうに言う有珠に、草十郎は言葉を呑んでしまった。"
msgstr ""

#. Occurrence 8_6:2188:11322: scene=8_6
#: 8_6:2188
msgctxt "text_id=11322 | speaker=unknown"
msgid "　実はかなり困るのだけど、そんな風に素直に聞かれると答えにも困る。"
msgstr ""

#. Occurrence 8_6:2222:11323: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11323 | speaker=soujuurou"
msgid "「……いや、なんかこっちの考え方が悪かったみたいだ。"
msgstr ""

#. Occurrence 8_6:2222:11324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11324 | speaker=soujuurou"
msgid "　もうその話題には触れない事にしたから忘れてくれ。"
msgstr ""

#. Occurrence 8_6:2233:11325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0012; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2233
msgctxt "text_id=11325 | speaker=soujuurou"
msgid "　それより、有珠」"
msgstr ""

#. Occurrence 8_6:2253:11326: scene=8_6
#: 8_6:2253
msgctxt "text_id=11326 | speaker=unknown"
msgid "　今までのどんな時よりも真剣な、<射|い><貫|ぬ>くような視線で草十郎は有珠を見る。"
msgstr ""

#. Occurrence 8_6:2279:11327: scene=8_6
#: 8_6:2279
msgctxt "text_id=11327 | speaker=unknown"
msgid "　彼には似合わない、強い視線を前にして有珠は少し体を引いてしまう。"
msgstr ""

#. Occurrence 8_6:2345:11328: scene=8_6
#: 8_6:2345
msgctxt "text_id=11328 | speaker=unknown"
msgid "　かすかな緊張が有珠の頬を紅潮させる。"
msgstr ""

#. Occurrence 8_6:2350:11329: scene=8_6
#: 8_6:2350
msgctxt "text_id=11329 | speaker=unknown"
msgid "　他人にここまで強く見つめられる事なんて、青子以外なかったからだ。"
msgstr ""

#. Occurrence 8_6:2393:11330: scene=8_6
#: 8_6:2393
msgctxt "text_id=11330 | speaker=unknown"
msgid "　有珠の緊張を知ってか知らずか、草十郎はしばらく黙ってから、ゆっくりと、偽りのない気持ちを口にした。"
msgstr ""

#. Occurrence 8_6:2417:11331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0013; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2417
msgctxt "text_id=11331 | speaker=soujuurou"
msgid "「それ、食べないなら欲しいんだけど」"
msgstr ""

#. Occurrence 8_6:2527:11332: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0020; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2527
msgctxt "text_id=11332 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence 8_6:2532:11333: scene=8_6
#: 8_6:2532
msgctxt "text_id=11333 | speaker=unknown"
msgid "　どこか気まずい沈黙が流れる。"
msgstr ""

#. Occurrence 8_6:2558:11334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0021; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2558
msgctxt "text_id=11334 | speaker=alice"
msgid "「悪いけど。これ、わたしのだから」"
msgstr ""

#. Occurrence 8_6:2564:11335: scene=8_6
#: 8_6:2564
msgctxt "text_id=11335 | speaker=unknown"
msgid "　作ったのは静希君だけど、とにかくそういうコトだから、と有珠は切り捨てる。"
msgstr ""

#. Occurrence 8_6:2569:11336: scene=8_6
#: 8_6:2569
msgctxt "text_id=11336 | speaker=unknown"
msgid "　多少、自分でもよく分からない怒気をこめて。"
msgstr ""

#. Occurrence 8_6:2605:11337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0014; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2605
msgctxt "text_id=11337 | speaker=soujuurou"
msgid "「そうだね。少し意地汚かった」"
msgstr ""

#. Occurrence 8_6:2612:11338: scene=8_6
#: 8_6:2612
msgctxt "text_id=11338 | speaker=unknown"
msgid "　すとん、とソファーに戻る草十郎。"
msgstr ""

#. Occurrence 8_6:2617:11339: scene=8_6
#: 8_6:2617
msgctxt "text_id=11339 | speaker=unknown"
msgid "　その仕草があまりにも哀れだったからか。"
msgstr ""

#. Occurrence 8_6:2624:11340: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0022; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2624
msgctxt "text_id=11340 | speaker=alice"
msgid "「……その、材料はもう残ってないの？」"
msgstr ""

#. Occurrence 8_6:2648:11341: scene=8_6
#: 8_6:2648
msgctxt "text_id=11341 | speaker=unknown"
msgid "　つい口にして、あわてて有珠は口を<塞|ふさ>いだ。"
msgstr ""

#. Occurrence 8_6:2653:11342: scene=8_6
#: 8_6:2653
msgctxt "text_id=11342 | speaker=unknown"
msgid "　そんな事を訊くなんて、まったく彼女らしくない。"
msgstr ""

#. Occurrence 8_6:2674:11343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0015; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2674
msgctxt "text_id=11343 | speaker=soujuurou"
msgid "「残ってないよ。蒼崎の分も作っちゃったから」"
msgstr ""

#. Occurrence 8_6:2680:11344: scene=8_6
#: 8_6:2680
msgctxt "text_id=11344 | speaker=unknown"
msgid "　まだ未練があるのか、有珠のお皿を見ながら草十郎は答える。"
msgstr ""

#. Occurrence 8_6:2685:11345: scene=8_6
#: 8_6:2685
msgctxt "text_id=11345 | speaker=unknown"
msgid "　その言葉も有珠的に無視できなかったのか、よせばいいのに、彼女は再度声をかけてしまった。"
msgstr ""

#. Occurrence 8_6:2711:11346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0023; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2711
msgctxt "text_id=11346 | speaker=alice"
msgid "「……青子なら、眠っているけど」"
msgstr ""

#. Occurrence 8_6:2733:11347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0016; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2733
msgctxt "text_id=11347 | speaker=soujuurou"
msgid "「いや、もうすぐ起こすから。起きた後で作らされるより、一緒に作っておいた方が楽だしね。"
msgstr ""

#. Occurrence 8_6:2744:11348: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0017; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2744
msgctxt "text_id=11348 | speaker=soujuurou"
msgid "　……と、もうすぐ一時か。ちょうどいい、行って起こしてくるよ」"
msgstr ""

#. Occurrence 8_6:2797:11349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0024; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2797
msgctxt "text_id=11349 | speaker=alice"
msgid "「青子は、起こしたら殺すって言ってたけど」"
msgstr ""

#. Occurrence 8_6:2802:11350: scene=8_6
#: 8_6:2802
msgctxt "text_id=11350 | speaker=unknown"
msgid "　なんでそんな事をするのか疑問、と有珠は首を傾げる。"
msgstr ""

#. Occurrence 8_6:2807:11351: scene=8_6
#: 8_6:2807
msgctxt "text_id=11351 | speaker=unknown"
msgid "　まったくだ、と同意しながらも草十郎は歩きだす。"
msgstr ""

#. Occurrence 8_6:2847:11352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0018; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2847
msgctxt "text_id=11352 | speaker=soujuurou"
msgid "「でもさ。いま起こしておかないと、やっぱり後で殺される運命にあると思うんだ」"
msgstr ""

#. Occurrence 8_6:2853:11353: scene=8_6
#: 8_6:2853
msgctxt "text_id=11353 | speaker=unknown"
msgid "　悪態なのに、親愛に満ちた言葉。"
msgstr ""

#. Occurrence 8_6:2863:11354: scene=8_6
#: 8_6:2863
msgctxt "text_id=11354 | speaker=unknown"
msgid "　同情に値する言葉を残して、草十郎は青子の部屋へと向かっていった。"
msgstr ""

#. Occurrence 8_6:2905:11355: scene=8_6
#: 8_6:2905
msgctxt "text_id=11355 | speaker=unknown"
msgid "　それを無言で見送ってから、有珠はあんかけ焼きうどんを一口食べてみる。"
msgstr ""

#. Occurrence 8_6:2924:11356: scene=8_6
#: 8_6:2924
msgctxt "text_id=11356 | speaker=unknown"
msgid "　ちらりと廊下への扉に目をやって、誰も来そうにない事を確認すると、さらに一口。"
msgstr ""

#. Occurrence 8_6:2942:11357: scene=8_6
#: 8_6:2942
msgctxt "text_id=11357 | speaker=unknown"
msgid "　そんな事を何回も繰り返すうちにクリーム色のお皿は空になって、二階から青子の怒鳴り声が聞こえた気がした。"
msgstr ""

#. Occurrence 8_6:2962:11358: scene=8_6
#: 8_6:2962
msgctxt "text_id=11358 | speaker=unknown"
msgid "　それに少しだけ同情して、厳かな仕草で、有珠は自分と草十郎の食器を片付けはじめた。"
msgstr ""

#. Occurrence 8_6:2978:11359: scene=8_6
#: 8_6:2978
msgctxt "text_id=11359 | speaker=unknown"
msgid "　そんな気はなかったけれど、これぐらいはしてあげないといけない、と思ったらしい。"
msgstr ""

#. Occurrence 8_6:2999:11360: scene=8_6
#: 8_6:2999
msgctxt "text_id=11360 | speaker=unknown"
msgid "　……不覚にも。"
msgstr ""

#. Occurrence 8_6:3013:11361: scene=8_6
#: 8_6:3013
msgctxt "text_id=11361 | speaker=unknown"
msgid "　はじめて食べた彼の手料理は、紅茶の不出来な淹れ方を忘れさせるほどには、まあ、悪くはない味だったのだから。"
msgstr ""

#. Occurrence 8_EX:80:11362: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0000; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:80
msgctxt "text_id=11362 | speaker=kojika"
msgid "「失礼します。２－Ｄの<久万梨|くまり>です。"
msgstr ""

#. Occurrence 8_EX:86:11363: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0001; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:86
msgctxt "text_id=11363 | speaker=kojika"
msgid "　体育館倉庫の鍵、職員室に返してきました」"
msgstr ""

#. Occurrence 8_EX:92:11364: scene=8_EX
#: 8_EX:92
msgctxt "text_id=11364 | speaker=unknown"
msgid "　<久万梨|くまり><金鹿|こじか>が第二生徒会室に入ると、室内にいるのは蒼崎青子だけだった。"
msgstr ""

#. Occurrence 8_EX:127:11365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11365 | speaker=aoko"
msgid "「おつかれ。"
msgstr ""

#. Occurrence 8_EX:127:11366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11366 | speaker=aoko"
msgid "　もうちょっとでバイト終わるから、そこ座ってて」"
msgstr ""

#. Occurrence 8_EX:133:11367: scene=8_EX
#: 8_EX:133
msgctxt "text_id=11367 | speaker=unknown"
msgid "　青子は長テーブルに陣取って、大量の教科書に囲まれながら、スラスラとリズムよくボールペンを走らせていた。"
msgstr ""

#. Occurrence 8_EX:138:11368: scene=8_EX
#: 8_EX:138
msgctxt "text_id=11368 | speaker=unknown"
msgid "　机上にあるのは学校指定のノートではなく、こじゃれたレポート用紙である。"
msgstr ""

#. Occurrence 8_EX:170:11369: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0002; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:170
msgctxt "text_id=11369 | speaker=kojika"
msgid "「なにしてんの蒼崎。課題？　それとも補習？"
msgstr ""

#. Occurrence 8_EX:176:11370: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0003; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:176
msgctxt "text_id=11370 | speaker=kojika"
msgid "　どっちにしても真面目なこと。冬休み、始まったばかりなのに。そりゃあ、こんなところで特別清掃なんかに付き合わされているけどさ」"
msgstr ""

#. Occurrence 8_EX:195:11371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0001; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:195
msgctxt "text_id=11371 | speaker=aoko"
msgid "「んー、これは別件。知り合いの大学生から流してもらった代筆のバイト。"
msgstr ""

#. Occurrence 8_EX:202:11372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0002; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:202
msgctxt "text_id=11372 | speaker=aoko"
msgid "何年も前に提出されたレポートを丸写しにして、卒論クリアしようって話」"
msgstr ""

#. Occurrence 8_EX:235:11373: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0004; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:235
msgctxt "text_id=11373 | speaker=kojika"
msgid "「チッ、写本ならぬ写レポートかよ。結構な量だなオイ。"
msgstr ""

#. Occurrence 8_EX:241:11374: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0005; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:241
msgctxt "text_id=11374 | speaker=kojika"
msgid "　それ、どこの大学生？　まさか<渠裸|みぞら>大じゃないでしょうね」"
msgstr ""

#. Occurrence 8_EX:262:11375: scene=8_EX
#: 8_EX:262
msgctxt "text_id=11375 | speaker=unknown"
msgid "　不快さを隠しもせず、久万梨は青子の傍らにあるレポートをめくっていく。"
msgstr ""

#. Occurrence 8_EX:267:11376: scene=8_EX
#: 8_EX:267
msgctxt "text_id=11376 | speaker=unknown"
msgid "　やや茶色に変色したレポート用紙は、少なく見積もっても十年は前の物だ。"
msgstr ""

#. Occurrence 8_EX:304:11377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0003; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:304
msgctxt "text_id=11377 | speaker=aoko"
msgid "「そのまさかよ。知り合いの大学生なんてミゾラ以外にいるかっていうの。"
msgstr ""

#. Occurrence 8_EX:310:11378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0004; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:310
msgctxt "text_id=11378 | speaker=aoko"
msgid "　安心なさい、クマの兄貴たちからの仕事じゃないから。そもそもアンタの兄貴軍団、今年も<留年|のこ>る気満々なんでしょ？」"
msgstr ""

#. Occurrence 8_EX:316:11379: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0006; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:316
msgctxt "text_id=11379 | speaker=kojika"
msgid "「クマ言わないで。軍団もやめろ」"
msgstr ""

#. Occurrence 8_EX:336:11380: scene=8_EX
#: 8_EX:336
msgctxt "text_id=11380 | speaker=unknown"
msgid "　久万梨の声は刺々しい。"
msgstr ""

#. Occurrence 8_EX:341:11381: scene=8_EX
#: 8_EX:341
msgctxt "text_id=11381 | speaker=unknown"
msgid "　いつも不機嫌な青子が言える事ではないが、この女生徒も青子に負けず劣らずの愛想の無さである。"
msgstr ""

#. Occurrence 8_EX:346:11382: scene=8_EX
#: 8_EX:346
msgctxt "text_id=11382 | speaker=unknown"
msgid "　平時は素っ気ない口調の久万梨は、本音がむき出しになると乱暴な口調になる。"
msgstr ""

#. Occurrence 8_EX:351:11383: scene=8_EX
#: 8_EX:351
msgctxt "text_id=11383 | speaker=unknown"
msgid "　どうも父親<譲|ゆず>りの癖らしい。本人はその癖を改善しようと努めているが、小学生までの習慣は中々抜けない。"
msgstr ""

#. Occurrence 8_EX:402:11384: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0007; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:402
msgctxt "text_id=11384 | speaker=kojika"
msgid "「けどこれ、どうなのよ。丸写しにしても古すぎて通らないんじゃない？」"
msgstr ""

#. Occurrence 8_EX:425:11385: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0005; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:425
msgctxt "text_id=11385 | speaker=aoko"
msgid "「そこはそれ、腐っても鯛というか。"
msgstr ""

#. Occurrence 8_EX:431:11386: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0006; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:431
msgctxt "text_id=11386 | speaker=aoko"
msgid "“技術的に古い部分はピックアップしてあるから、<教科書|テキスト>参考にして数字だけ変えておいて”だってさ」"
msgstr ""

#. Occurrence 8_EX:468:11387: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0008; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:468
msgctxt "text_id=11387 | speaker=kojika"
msgid "「なにそれ、ホントにバカじゃないの？　そこまで分かってるなら自分でやればいいのに。で、いつからやってるの」"
msgstr ""

#. Occurrence 8_EX:492:11388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11388 | speaker=aoko"
msgid "「今日の朝から。半日の稼ぎにしちゃあ悪くないわよ。"
msgstr ""

#. Occurrence 8_EX:492:11389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11389 | speaker=aoko"
msgid "　レポート一冊分で一万円」"
msgstr ""

#. Occurrence 8_EX:516:11390: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11390 | speaker=kojika"
msgid "「ケッ、生徒会長が内職かよ。"
msgstr ""

#. Occurrence 8_EX:516:11391: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11391 | speaker=kojika"
msgid "　どうりで槻司に監督を任せたワケだ」"
msgstr ""

#. Occurrence 8_EX:539:11392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0008; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:539
msgctxt "text_id=11392 | speaker=aoko"
msgid "「はい。他言は無用でお願いします」"
msgstr ""

#. Occurrence 8_EX:574:11393: scene=8_EX
#: 8_EX:574
msgctxt "text_id=11393 | speaker=unknown"
msgid "　爽やかな笑顔で返されて毒気を抜かれたのか、久万梨はぶすっとした顔のままパイプ椅子に腰を掛けた。"
msgstr ""

#. Occurrence 8_EX:594:11394: scene=8_EX
#: 8_EX:594
msgctxt "text_id=11394 | speaker=unknown"
msgid "　生徒会室にはボールペンの音だけ。"
msgstr ""

#. Occurrence 8_EX:613:11395: scene=8_EX
#: 8_EX:613
msgctxt "text_id=11395 | speaker=unknown"
msgid "　ふと見上げた空は青く高く、裏庭にはジャージ姿で野球をしている男子たちの姿があった。"
msgstr ""

#. Occurrence 8_EX:618:11396: scene=8_EX
#: 8_EX:618
msgctxt "text_id=11396 | speaker=unknown"
msgid "　特別清掃も終わり、なし崩し的に遊び始めたらしい。"
msgstr ""

#. Occurrence 8_EX:624:11397: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0010; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:624
msgctxt "text_id=11397 | speaker=kojika"
msgid "「この寒いのによくもまあ。"
msgstr ""

#. Occurrence 8_EX:630:11398: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0011; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:630
msgctxt "text_id=11398 | speaker=kojika"
msgid "　―――って、アレ二年の男どもだ」"
msgstr ""

#. Occurrence 8_EX:650:11399: scene=8_EX
#: 8_EX:650
msgctxt "text_id=11399 | speaker=unknown"
msgid "　十分な人数が集まらなかったのか、彼らは五人一チームで試合をしている。"
msgstr ""

#. Occurrence 8_EX:655:11400: scene=8_EX
#: 8_EX:655
msgctxt "text_id=11400 | speaker=unknown"
msgid "　凡打、三振の多いグダグダな試合内容だが、当人たちはたいへん盛り上がっているようだ。"
msgstr ""

#. Occurrence 8_EX:660:11401: scene=8_EX
#: 8_EX:660
msgctxt "text_id=11401 | speaker=unknown"
msgid "　聞こえてくる喚声は口汚いものばかりだが、罵声をあびせながらもみな笑っているあたり、ホントに男子はバカばっかりだ。"
msgstr ""

#. Occurrence 8_EX:692:11402: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0012; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:692
msgctxt "text_id=11402 | speaker=kojika"
msgid "「あれ。<芳助|ほうすけ>と<静希|しずき>が一緒なのは分かるけど、<槻司|つきじ>も一緒じゃん。蒼崎、あいつら仲いいの？」"
msgstr ""

#. Occurrence 8_EX:710:11403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0009; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:710
msgctxt "text_id=11403 | speaker=aoko"
msgid "「はあ？　なんで<Ｃ|よ><組|そ>のクラスの集まりに顔だしてんのよ<鳶|ア><丸|イツ>。……まあ、裏山の清掃が終わってるなら文句はないけど」"
msgstr ""

#. Occurrence 8_EX:727:11404: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0013; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:727
msgctxt "text_id=11404 | speaker=kojika"
msgid "「あ、投げた。槻司、ピッチャーできるんだ」"
msgstr ""

#. Occurrence 8_EX:748:11405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0010; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:748
msgctxt "text_id=11405 | speaker=aoko"
msgid "「基本、<鳶丸|アイツ>はなんでもできるからねー。"
msgstr ""

#. Occurrence 8_EX:754:11406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0011; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:754
msgctxt "text_id=11406 | speaker=aoko"
msgid "　本人さぼり症でめったに動かないけど、本気だせば何だってこなすのよ。唯一足りない才能があるとしたら、子供らしさってヤツでしょうね」"
msgstr ""

#. Occurrence 8_EX:772:11407: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0014; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:772
msgctxt "text_id=11407 | speaker=kojika"
msgid "「ふーん。詳しいじゃない。"
msgstr ""

#. Occurrence 8_EX:778:11408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0015; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:778
msgctxt "text_id=11408 | speaker=kojika"
msgid "　……蒼崎、槻司と付き合ってるってホント？」"
msgstr ""

#. Occurrence 8_EX:811:11409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0012; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:811
msgctxt "text_id=11409 | speaker=aoko"
msgid "「アイツと付き合うぐらいならアンタと付き合うわ。"
msgstr ""

#. Occurrence 8_EX:817:11410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0013; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:817
msgctxt "text_id=11410 | speaker=aoko"
msgid "　顔の良い男は好きじゃないし。やっぱり男はシュワちゃんぐらいじゃないと」"
msgstr ""

#. Occurrence 8_EX:839:11411: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0016; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:839
msgctxt "text_id=11411 | speaker=kojika"
msgid "「シュワ……誰それ？」"
msgstr ""

#. Occurrence 8_EX:845:11412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0014; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:845
msgctxt "text_id=11412 | speaker=aoko"
msgid "「グレートの方のコナンの主役やった人」"
msgstr ""

#. Occurrence 8_EX:856:11413: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0017; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:856
msgctxt "text_id=11413 | speaker=kojika"
msgid "「へえ、アゴ割れてないとダメなんだ。蒼崎って面食いかと思ってたけど、ごっつい系が趣味なの？」"
msgstr ""

#. Occurrence 8_EX:877:11414: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0015; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:877
msgctxt "text_id=11414 | speaker=aoko"
msgid "「……別にそういうワケじゃないけど。"
msgstr ""

#. Occurrence 8_EX:883:11415: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0016; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:883
msgctxt "text_id=11415 | speaker=aoko"
msgid "　教訓よ、教訓。なよっとしたヤツとか、やけに口がうまいヤツとか、気軽な男はほんと信用ならないっていうか」"
msgstr ""

#. Occurrence 8_EX:920:11416: scene=8_EX
#: 8_EX:920
msgctxt "text_id=11416 | speaker=unknown"
msgid "　青子はレポート用紙を、"
msgstr ""

#. Occurrence 8_EX:926:11417: scene=8_EX
#: 8_EX:926
msgctxt "text_id=11417 | speaker=unknown"
msgid "　久万梨は校庭を眺めながら、とりとめのない会話をする。"
msgstr ""

#. Occurrence 8_EX:931:11418: scene=8_EX
#: 8_EX:931
msgctxt "text_id=11418 | speaker=unknown"
msgid "　ふたりが知り合ったのは高校生になってからだが、根本的なところで気が合うらしく、今ではこうして<駄弁|だべ>りあう仲になっていた。"
msgstr ""

#. Occurrence 8_EX:952:11419: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0018; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:952
msgctxt "text_id=11419 | speaker=kojika"
msgid "「蒼崎、冬休みはどうする？　予定、ある？」"
msgstr ""

#. Occurrence 8_EX:958:11420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0017; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:958
msgctxt "text_id=11420 | speaker=aoko"
msgid "「うーん、一回ぐらいは遊びに行きたいんだけど、ちょい忙しくて。年明けに時間つくるから、それまで待って。"
msgstr ""

#. Occurrence 8_EX:964:11421: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0018; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:964
msgctxt "text_id=11421 | speaker=aoko"
msgid "　あ、Ｂ組の山瀬さんたち誘う？　たしか去年も冬休みに上京してたでしょ、彼女ら」"
msgstr ""

#. Occurrence 8_EX:985:11422: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0019; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:985
msgctxt "text_id=11422 | speaker=kojika"
msgid "「あー、ありゃわたしたちと系統が違う。生粋のお嬢さまだからねぇ。蒼崎の趣味知ったらドン引きされるから、やめといた方がいい」"
msgstr ""

#. Occurrence 8_EX:1013:11423: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0020; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1013
msgctxt "text_id=11423 | speaker=kojika"
msgid "「あ、打たれた。"
msgstr ""

#. Occurrence 8_EX:1020:11424: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0021; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1020
msgctxt "text_id=11424 | speaker=kojika"
msgid "あ、<柵|さく>越えた。"
msgstr ""

#. Occurrence 8_EX:1027:11425: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0022; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1027
msgctxt "text_id=11425 | speaker=kojika"
msgid "あれってホームランってヤツだ。やるじゃん静希。槻司から一本とるなんて、運動神経<抜群|ばつぐん>ね」"
msgstr ""

#. Occurrence 8_EX:1048:11426: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0019; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1048
msgctxt "text_id=11426 | speaker=aoko"
msgid "「そりゃ山育ちだし、それぐらい取り柄がないと。"
msgstr ""

#. Occurrence 8_EX:1054:11427: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0020; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1054
msgctxt "text_id=11427 | speaker=aoko"
msgid "　来年の身体測定、鳶丸とトップ争うんじゃない？　山じゃ二時間歩きっぱなしとかザラだったそうだし。水泳部じゃなく陸上部に紹介すればよかった」"
msgstr ""

#. Occurrence 8_EX:1060:11428: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0023; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1060
msgctxt "text_id=11428 | speaker=kojika"
msgid "「ふーん。詳しいのね。もしかして付き合ってるのあっちとか。あ、いや、さすがにないかー」"
msgstr ""

#. Occurrence 8_EX:1091:11429: scene=8_EX
#: 8_EX:1091
msgctxt "text_id=11429 | speaker=unknown"
msgid "　よどみのなかったボールペンの音が止まる。"
msgstr ""

#. Occurrence 8_EX:1108:11430: scene=8_EX
#: 8_EX:1108
msgctxt "text_id=11430 | speaker=unknown"
msgid "　青子はごく自然な仕草で席を立ち、"
msgstr ""

msgctxt "text_id=11431 | speaker=unknown"
msgid "小休止といわんばかりにお茶を淹れて、"
msgstr ""

msgctxt "text_id=11432 | speaker=unknown"
msgid "何事もなかったように作業に戻った。"
msgstr ""

#. Occurrence 8_EX:1144:11433: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0021; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1144
msgctxt "text_id=11433 | speaker=aoko"
msgid "「冬休みの予定だけど。久万梨、何かリクエストある？」"
msgstr ""

#. Occurrence 8_EX:1162:11434: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0024; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1162
msgctxt "text_id=11434 | speaker=kojika"
msgid "「別に。見たい映画がたまってるだけ。<三咲|こっち>じゃ上映しない映画をハシゴしたい。蒼崎は？」"
msgstr ""

#. Occurrence 8_EX:1180:11435: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0022; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1180
msgctxt "text_id=11435 | speaker=aoko"
msgid "「私は新しい冬物とＣＤ買えればいいかな。デヴィッドボウイの。あ、その前にまずはＣＤプレーヤーか。そろそろ三万円きるはずなのよ、アレ」"
msgstr ""

#. Occurrence 8_EX:1215:11436: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0025; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1215
msgctxt "text_id=11436 | speaker=kojika"
msgid "「はあ。新しいもの好きよね、アンタ。ＣＤなんて高いだけで、騒がれてるのは今だけだってば。"
msgstr ""

#. Occurrence 8_EX:1221:11437: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0026; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1221
msgctxt "text_id=11437 | speaker=kojika"
msgid "　だいたい、音楽なんてレンタルしてカセットテープに落とせば５００円で済むじゃない。ベータデッキみたいにそのうち<廃|すた>れるって」"
msgstr ""

#. Occurrence 8_EX:1242:11438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0023; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1242
msgctxt "text_id=11438 | speaker=aoko"
msgid "「そう？　私、ＣＤは定番になると思うけどな。過去になるのはカセットテープの方よ、きっと」"
msgstr ""

#. Occurrence 8_EX:1248:11439: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0027; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1248
msgctxt "text_id=11439 | speaker=kojika"
msgid "「それはない。絶対ない。賭けてもいい。だって、ＣＤって録音できないんでしょ？　そんなのにカセットテープが負けるはずない」"
msgstr ""

#. Occurrence 8_EX:1278:11440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0024; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1278
msgctxt "text_id=11440 | speaker=aoko"
msgid "「クマは保守派だからなー。政権交代は何にだってあるでしょうに。"
msgstr ""

#. Occurrence 8_EX:1285:11441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0025; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1285
msgctxt "text_id=11441 | speaker=aoko"
msgid "でもまあ、その賭け乗った。生徒会の歴史に書いておくからね。十年……いえ、五年後を楽しみにしていましょう」"
msgstr ""

#. Occurrence 8_EX:1291:11442: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0028; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1291
msgctxt "text_id=11442 | speaker=kojika"
msgid "「五年後か。いいね、ちょうど大学の終わりだ。蒼崎、東京の大学に行くんでしょ？　どこ志望してるのか教えてよ」"
msgstr ""

#. Occurrence 8_EX:1312:11443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0026; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1312
msgctxt "text_id=11443 | speaker=aoko"
msgid "「実はまだ決めてないのよ。上京したいのは山々なんだけど」"
msgstr ""

#. Occurrence 8_EX:1318:11444: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0029; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1318
msgctxt "text_id=11444 | speaker=kojika"
msgid "「ありゃ意外。アンタのことだから、むこう三年分ぐらいスケジュール組んでると思ったのに」"
msgstr ""

#. Occurrence 8_EX:1350:11445: scene=8_EX
#: 8_EX:1350
msgctxt "text_id=11445 | speaker=unknown"
msgid "　あはは、と青子は苦笑いで誤魔化す。"
msgstr ""

#. Occurrence 8_EX:1355:11446: scene=8_EX
#: 8_EX:1355
msgctxt "text_id=11446 | speaker=unknown"
msgid "　生き方の方針は決まっているものの、将来の展望はいまいち考えていない青子だった。"
msgstr ""

#. Occurrence 8_EX:1360:11447: scene=8_EX
#: 8_EX:1360
msgctxt "text_id=11447 | speaker=unknown"
msgid "　やると決めた事はやる性格のため、いちいちスケジュールを紙に起こす習慣がないせいもある。"
msgstr ""

#. Occurrence 8_EX:1388:11448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11448 | speaker=aoko"
msgid "「クマ、終わったら駅前のラーメン屋付き合ってよ。"
msgstr ""

#. Occurrence 8_EX:1388:11449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11449 | speaker=aoko"
msgid "　体力つかったから、なんかお腹減ってきた」"
msgstr ""

#. Occurrence 8_EX:1407:11450: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0030; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1407
msgctxt "text_id=11450 | speaker=kojika"
msgid "「……そこは、頭つかったから甘いもの食べたくなった、にしといた方が女らしいと思うけどね。"
msgstr ""

#. Occurrence 8_EX:1418:11451: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0031; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1418
msgctxt "text_id=11451 | speaker=kojika"
msgid "　いいよ。うちでいいならサービスしとくけど、よってく？」"
msgstr ""

#. Occurrence 8_EX:1436:11452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0028; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1436
msgctxt "text_id=11452 | speaker=aoko"
msgid "「もっちろん！　持つべきものは女の友情！」"
msgstr ""

#. Occurrence 8_EX:1470:11453: scene=8_EX
#: 8_EX:1470
msgctxt "text_id=11453 | speaker=unknown"
msgid "　冬休みを間近に控えた生徒会室。"
msgstr ""

#. Occurrence 8_EX:1475:11454: scene=8_EX
#: 8_EX:1475
msgctxt "text_id=11454 | speaker=unknown"
msgid "　ふたりは他愛のない会話で放課後を消費していく。"
msgstr ""

#. Occurrence 8_EX:1480:11455: scene=8_EX
#: 8_EX:1480
msgctxt "text_id=11455 | speaker=unknown"
msgid "　夜は魔術師として歩く青子も、昼間はいたってノーマルな学生だ。友人と話すときは年相応の無邪気さを隠しもしない。"
msgstr ""

#. Occurrence 8_EX:1485:11456: scene=8_EX
#: 8_EX:1485
msgctxt "text_id=11456 | speaker=unknown"
msgid "　たとえ敵との戦いが本格化していようと、二足のわらじを履くと決めた以上、どちらも楽しむのが青子である。"
msgstr ""

#. Occurrence 8_EX:1519:11457: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0032; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1519
msgctxt "text_id=11457 | speaker=kojika"
msgid "「ところで蒼崎。さっきの賭け金はどうする？」"
msgstr ""

#. Occurrence 8_EX:1532:11458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0029; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1532
msgctxt "text_id=11458 | speaker=aoko"
msgid "「そうね。私も鬼じゃないし、その時の貯金一割で手を打つわ。根こそぎ奪うのは勘弁してあげる」"
msgstr ""

#. Occurrence 8_EX:1538:11459: scene=8_EX
#: 8_EX:1538
msgctxt "text_id=11459 | speaker=unknown"
msgid "　もっとも。"
msgstr ""

#. Occurrence 8_EX:1543:11460: scene=8_EX
#: 8_EX:1543
msgctxt "text_id=11460 | speaker=unknown"
msgid "　この通り、根本的な意地の悪さは変わらないのだが。"
msgstr ""

#. Occurrence 8_EX:1604:11461: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0000; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:1604
msgctxt "text_id=11461 | speaker=soujuurou"
msgid "「なんかゾワッときたな、今」"
msgstr ""

#. Occurrence 8_EX:1610:11462: scene=8_EX
#: 8_EX:1610
msgctxt "text_id=11462 | speaker=unknown"
msgid "　くしゅん、と気の抜けたクシャミをして、被害者Ａはそう呟いた。"
msgstr ""

#. Occurrence 8_EX:1647:11463: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0000; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1647
msgctxt "text_id=11463 | speaker=kinomi"
msgid "「なんだよ、風邪でもひいたかー静希？"
msgstr ""

#. Occurrence 8_EX:1658:11464: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0001; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1658
msgctxt "text_id=11464 | speaker=kinomi"
msgid "　よし、んじゃこんなとこで野球やっててもしょうがねえし！　町にくりだすとしましょうか！」"
msgstr ""

#. Occurrence 8_EX:1693:11465: scene=8_EX
#: 8_EX:1693
msgctxt "text_id=11465 | speaker=unknown"
msgid "　五人野球、四試合目。"
msgstr ""

#. Occurrence 8_EX:1698:11466: scene=8_EX
#: 8_EX:1698
msgctxt "text_id=11466 | speaker=unknown"
msgid "　内野ゴロはキャッチされた時点でアウト、ホームランには余ったお汁粉缶をプレゼント、という特殊ルールを聞きつけて野次馬が集まりだし、リーグ戦が始まってから既に一時間。"
msgstr ""

#. Occurrence 8_EX:1703:11467: scene=8_EX
#: 8_EX:1703
msgctxt "text_id=11467 | speaker=unknown"
msgid "　自分たちの試合がまだ先であるコトに痺れを切らした木乃美芳助は、早くも飽きはじめていた。"
msgstr ""

#. Occurrence 8_EX:1734:11468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0000; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1734
msgctxt "text_id=11468 | speaker=tobimaru"
msgid "「おまえホント猿だったんだな。先立つものがねえから野球やろうぜって言いだしたのはテメエだろうが」"
msgstr ""

#. Occurrence 8_EX:1752:11469: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0002; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1752
msgctxt "text_id=11469 | speaker=kinomi"
msgid "「えー。それはそれ、これはこれっしょ。"
msgstr ""

#. Occurrence 8_EX:1758:11470: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0003; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1758
msgctxt "text_id=11470 | speaker=kinomi"
msgid "　だってＡ組の奴らとか集まってきたしさあ、オレ、あいつら嫌いだしさあ。なんかノリが合わないっていうか」"
msgstr ""

#. Occurrence 8_EX:1791:11471: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0001; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1791
msgctxt "text_id=11471 | speaker=tobimaru"
msgid "「安心しろ、<Ａ組|あっち>もテメエとは合わねえとよ。"
msgstr ""

#. Occurrence 8_EX:1797:11472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0002; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1797
msgctxt "text_id=11472 | speaker=tobimaru"
msgid "　いい機会じゃねえか、気にくわないんなら試合で片づけてやれよ。こっちも本気でやってやるから」"
msgstr ""

#. Occurrence 8_EX:1817:11473: scene=8_EX
#: 8_EX:1817
msgctxt "text_id=11473 | speaker=unknown"
msgid "　鳶丸は壁に向かってピッチングなどしながら木乃美をたしなめる。"
msgstr ""

#. Occurrence 8_EX:1822:11474: scene=8_EX
#: 8_EX:1822
msgctxt "text_id=11474 | speaker=unknown"
msgid "　先ほどホームランを打たれてご立腹なのか、普段より当たりがきつい。"
msgstr ""

#. Occurrence 8_EX:1827:11475: scene=8_EX
#: 8_EX:1827
msgctxt "text_id=11475 | speaker=unknown"
msgid "　ちなみに、彼もＡ組の生徒であり、集まってきたＡ組男子のキャプテンに収まっている。"
msgstr ""

#. Occurrence 8_EX:1858:11476: voice_id=D50_8_EX_0000; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1858
msgctxt "text_id=11476 | speaker=unknown"
msgid "「ちょっと待った、そりゃ誤解だぜ殿下。"
msgstr ""

#. Occurrence 8_EX:1864:11477: voice_id=D50_8_EX_0001; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1864
msgctxt "text_id=11477 | speaker=unknown"
msgid "　オレたち木乃美けっこう好きよ？"
msgstr ""

#. Occurrence 8_EX:1871:11478: voice_id=D50_8_EX_0002; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1871
msgctxt "text_id=11478 | speaker=unknown"
msgid "　バカなところとか、平気で女連中の品評会ひらくところとか、合コン企画するところとか。真似できねーよ、ホント」"
msgstr ""

#. Occurrence 8_EX:1877:11479: scene=8_EX
#: 8_EX:1877
msgctxt "text_id=11479 | speaker=unknown"
msgid "　うんうん、と力強くうなずくＡ組男子一同。"
msgstr ""

#. Occurrence 8_EX:1903:11480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0004; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1903
msgctxt "text_id=11480 | speaker=kinomi"
msgid "「ざけんな、テメエらいつも美味しいところだけ持っていきやがって！"
msgstr ""

#. Occurrence 8_EX:1910:11481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0005; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1910
msgctxt "text_id=11481 | speaker=kinomi"
msgid "“カラオケ会ひらいてよー”“女の子と遊びたいよー”、"
msgstr ""

msgctxt "text_id=11482 | speaker=unknown"
msgid "　なんて甘えてきやがって、なんで気が付いたらオレ一人だけで会計してたの？　一緒にテニス部のぞきに行ったのにどうしてオレだけ悪者なの？　もしかして利用されてるだけってそろそろ気が付いていいの？」"
msgstr ""

#. Occurrence 8_EX:1947:11483: voice_id=D60_8_EX_0000; voice_prefix=D60; voice_category=0; scene=8_EX
#: 8_EX:1947
msgctxt "text_id=11483 | speaker=unknown"
msgid "「やべ、まだ気付いてなかった！　本物だ！」"
msgstr ""

#. Occurrence 8_EX:1953:11484: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11484 | speaker=unknown"
msgid "「ごめん、木乃美のおかげで僕にも彼女ができました！　彼女の口癖は“木乃美クンよりマシよ"
msgstr ""

#. Occurrence 8_EX:1953:11485: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11485 | speaker=unknown"
msgid "”です！」"
msgstr ""

#. Occurrence 8_EX:1981:11486: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11486 | speaker=kinomi"
msgid "「があー！　テメエら本気でむかつく！"
msgstr ""

#. Occurrence 8_EX:1981:11487: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11487 | speaker=kinomi"
msgid "　青くせぇ学生生活おくってんじゃねえ！」"
msgstr ""

#. Occurrence 8_EX:2005:11488: scene=8_EX
#: 8_EX:2005
msgctxt "text_id=11488 | speaker=unknown"
msgid "　木乃美はバットを振り回してＡ組男子を追い回し、Ａ組男子たちは陽気に逃げ回りながら木乃美に感謝する。"
msgstr ""

#. Occurrence 8_EX:2010:11489: scene=8_EX
#: 8_EX:2010
msgctxt "text_id=11489 | speaker=unknown"
msgid "　基本、<罵|ののし>りあいなのに<和気|わき><藹々|あいあい>としているのは、木乃美芳助の人徳のなせる業だ。"
msgstr ""

#. Occurrence 8_EX:2046:11490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0001; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2046
msgctxt "text_id=11490 | speaker=soujuurou"
msgid "「ははは。木乃美は人気者だなあ」"
msgstr ""

#. Occurrence 8_EX:2052:11491: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0003; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2052
msgctxt "text_id=11491 | speaker=tobimaru"
msgid "「ああ、バカなのが救いだな。あれで下手に<利口|りこう>だったら犯罪者になってるところだ。"
msgstr ""

#. Occurrence 8_EX:2058:11492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0004; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2058
msgctxt "text_id=11492 | speaker=tobimaru"
msgid "　いや、その前に今度こそ蒼崎にしめられるか。あいつ、小ずるいチンピラには容赦ねえからな」"
msgstr ""

#. Occurrence 8_EX:2078:11493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0002; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2078
msgctxt "text_id=11493 | speaker=soujuurou"
msgid "「そうなのか。―――ん？　今度こそ？」"
msgstr ""

#. Occurrence 8_EX:2098:11494: scene=8_EX
#: 8_EX:2098
msgctxt "text_id=11494 | speaker=unknown"
msgid "　む、と考えこむ草十郎。"
msgstr ""

#. Occurrence 8_EX:2103:11495: scene=8_EX
#: 8_EX:2103
msgctxt "text_id=11495 | speaker=unknown"
msgid "　今の言いぶりだと、木乃美に蒼崎青子に関して、なにやら前科があるようだ。"
msgstr ""

#. Occurrence 8_EX:2144:11496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0003; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2144
msgctxt "text_id=11496 | speaker=soujuurou"
msgid "「木乃美は蒼崎に、その、ケソウ、してた事があるのか？」"
msgstr ""

#. Occurrence 8_EX:2155:11497: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0005; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2155
msgctxt "text_id=11497 | speaker=tobimaru"
msgid "「あん、ケソウ？　ああ、懸想か。"
msgstr ""

#. Occurrence 8_EX:2166:11498: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0006; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2166
msgctxt "text_id=11498 | speaker=tobimaru"
msgid "　あのバカにそんな風情があるかって。ちょいとな、蒼崎と木乃美には条件反射じみた事件があったんだよ。"
msgstr ""

#. Occurrence 8_EX:2172:11499: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0007; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2172
msgctxt "text_id=11499 | speaker=tobimaru"
msgid "　ありゃあ入学式の事だ。そうだよな、木乃美！」"
msgstr ""

#. Occurrence 8_EX:2177:11500: scene=8_EX
#: 8_EX:2177
msgctxt "text_id=11500 | speaker=unknown"
msgid "　鳶丸に怒鳴られ、木乃美は足を止めて振り返る。"
msgstr ""

#. Occurrence 8_EX:2218:11501: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0007; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2218
msgctxt "text_id=11501 | speaker=kinomi"
msgid "「おう、入学式な！　すげー<身体|からだ>してる女子がいたからさあ、つい声をかけたんだよな！」"
msgstr ""

#. Occurrence 8_EX:2224:11502: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0008; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2224
msgctxt "text_id=11502 | speaker=kinomi"
msgid "“かーのじょ、どの<組|クラス>ぅ？”って。"
msgstr ""

#. Occurrence 8_EX:2235:11503: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0009; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2235
msgctxt "text_id=11503 | speaker=kinomi"
msgid "　いや、でもまさか、手が出るとは思わなかった。"
msgstr ""

#. Occurrence 8_EX:2241:11504: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0010; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2241
msgctxt "text_id=11504 | speaker=kinomi"
msgid "　オレ的には一センチ前で<寸止|すんど>めしようとしたんだけど、目測をあやまった。オレの視覚情報より、蒼崎の肉体のサイズがやや<勝|まさ>っていたというコトさね」"
msgstr ""

#. Occurrence 8_EX:2280:11505: scene=8_EX
#: 8_EX:2280
msgctxt "text_id=11505 | speaker=unknown"
msgid "　はっはっは、と遠い目で空を見上げる木乃美芳助。"
msgstr ""

#. Occurrence 8_EX:2290:11506: scene=8_EX
#: 8_EX:2290
msgctxt "text_id=11506 | speaker=unknown"
msgid "　草十郎は草十郎で、今の言葉だけで入学式に何が起きたのか、正確に把握したらしい。"
msgstr ""

#. Occurrence 8_EX:2316:11507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0004; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2316
msgctxt "text_id=11507 | speaker=soujuurou"
msgid "「―――バカな。"
msgstr ""

#. Occurrence 8_EX:2323:11508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0005; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2323
msgctxt "text_id=11508 | speaker=soujuurou"
msgid "なぜ命がある、木乃美」"
msgstr ""

#. Occurrence 8_EX:2358:11509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0011; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2358
msgctxt "text_id=11509 | speaker=kinomi"
msgid "「だろー？　オレのアゴ、垂直に跳ね上がったんだぜ!?"
msgstr ""

#. Occurrence 8_EX:2392:11510: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0012; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2392
msgctxt "text_id=11510 | speaker=kinomi"
msgid "　平手とか拳とかそういうレベルじゃねえの、下からギャーンだぜギャーン！　周りにいたギャラリーいわく、“プールで縦に沈めたビート板が浮上するように蒼崎の靴が閃いた”らしい。"
msgstr ""

#. Occurrence 8_EX:2423:11511: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0013; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2423
msgctxt "text_id=11511 | speaker=kinomi"
msgid "　…………あの、今だから言いますけど、オレ、あの後の記憶がすっぽりないのです」"
msgstr ""

#. Occurrence 8_EX:2449:11512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0006; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2449
msgctxt "text_id=11512 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_EX:2456:11513: scene=8_EX
#: 8_EX:2456
msgctxt "text_id=11513 | speaker=unknown"
msgid "　Ａ組男子を追い回すのも疲れたのか、木乃美はアゴをさすりながら戻ってきた。"
msgstr ""

#. Occurrence 8_EX:2496:11514: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0014; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2496
msgctxt "text_id=11514 | speaker=kinomi"
msgid "「そんなコトより遊びにいこうぜー。"
msgstr ""

#. Occurrence 8_EX:2496:11515: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0014; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2496
msgctxt "text_id=11515 | speaker=kinomi"
msgid "　殿下、金持ってるだろー。おごってくれよー」"
msgstr ""

#. Occurrence 8_EX:2507:11516: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0008; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2507
msgctxt "text_id=11516 | speaker=tobimaru"
msgid "「……ったく。まあ、映画なら考えない事もない。"
msgstr ""

#. Occurrence 8_EX:2513:11517: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0009; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2513
msgctxt "text_id=11517 | speaker=tobimaru"
msgid "　ちょうど見たい映画あんだよ。映画の内容より、見終わった後に文句言い合う方が楽しい部類のＢ級でな。"
msgstr ""

#. Occurrence 8_EX:2519:11518: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0010; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2519
msgctxt "text_id=11518 | speaker=tobimaru"
msgid "　犠牲者が必要なんで、この際テメエでもいいぞ」"
msgstr ""

#. Occurrence 8_EX:2545:11519: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0015; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2545
msgctxt "text_id=11519 | speaker=kinomi"
msgid "「やだー、映画とかつまんねえよ！　大の男がさあ、二時間も同じところ座ってられねえって！"
msgstr ""

#. Occurrence 8_EX:2551:11520: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0016; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2551
msgctxt "text_id=11520 | speaker=kinomi"
msgid "　そんなんだったらゲーセンか、コンビニの駐車場で駄菓子食ってる方が楽しいって！」"
msgstr ""

#. Occurrence 8_EX:2562:11521: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0011; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2562
msgctxt "text_id=11521 | speaker=tobimaru"
msgid "「……おまえ、それ今の状況と何が違うんだ？」"
msgstr ""

#. Occurrence 8_EX:2588:11522: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0017; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2588
msgctxt "text_id=11522 | speaker=kinomi"
msgid "「いいんだよ、外で<駄弁|だべ>ってれば楽しいんだって！"
msgstr ""

#. Occurrence 8_EX:2599:11523: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0018; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2599
msgctxt "text_id=11523 | speaker=kinomi"
msgid "　あ、それともバンドでもやるか。いまＵＫロックが熱い。バイト先の先輩にパンクロックなら誰でもできるときいた」"
msgstr ""

#. Occurrence 8_EX:2610:11524: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0012; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2610
msgctxt "text_id=11524 | speaker=tobimaru"
msgid "「ああそうかよ。ファッションにならねえようにな」"
msgstr ""

#. Occurrence 8_EX:2630:11525: scene=8_EX
#: 8_EX:2630
msgctxt "text_id=11525 | speaker=unknown"
msgid "　冬休みの裏庭。"
msgstr ""

#. Occurrence 8_EX:2635:11526: scene=8_EX
#: 8_EX:2635
msgctxt "text_id=11526 | speaker=unknown"
msgid "　のんびりとした労働後のひとときを、木乃美と鳶丸はどうでもいい話題で消費していく。"
msgstr ""

#. Occurrence 8_EX:2674:11527: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0019; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2674
msgctxt "text_id=11527 | speaker=kinomi"
msgid "「じゃあナンパ。駅前でナンパしようぜ！　殿下がいれば年上のお姉さんも釣れるし。"
msgstr ""

#. Occurrence 8_EX:2681:11528: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0020; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2681
msgctxt "text_id=11528 | speaker=kinomi"
msgid "そうだ。お金がないなら、レディたちにおごってもらえばいいんじゃない？」"
msgstr ""

#. Occurrence 8_EX:2687:11529: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0013; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2687
msgctxt "text_id=11529 | speaker=tobimaru"
msgid "「その歳でヒモか。テメエの人生設計、明るすぎて頭痛がするぜ」"
msgstr ""

#. Occurrence 8_EX:2722:11530: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0021; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2722
msgctxt "text_id=11530 | speaker=kinomi"
msgid "「うん、オレ将来の展望だけはできてるからね！"
msgstr ""

#. Occurrence 8_EX:2728:11531: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0022; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2728
msgctxt "text_id=11531 | speaker=kinomi"
msgid "　なあ静希、おまえからも言ってやれよー。ナンパに行こうって、女の子たちと楽しく騒ごうって！"
msgstr ""

#. Occurrence 8_EX:2734:11532: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0023; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2734
msgctxt "text_id=11532 | speaker=kinomi"
msgid "　殿下は立ってるだけでいいし、静希だって年上のお姉さんから見たら弟属性っていうの？"
msgstr ""

#. Occurrence 8_EX:2740:11533: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0024; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2740
msgctxt "text_id=11533 | speaker=kinomi"
msgid "　うまくいけば、こう―――オレの時みたいに、一時間後にはひと冬の、アヴァン、チュゥゥゥル」"
msgstr ""

#. Occurrence 8_EX:2769:11534: scene=8_EX
#: 8_EX:2769
msgctxt "text_id=11534 | speaker=unknown"
msgid "　木乃美の両手が、彼の腕からは独立した一つの触手生命のように活動する。わきわきと。"
msgstr ""

#. Occurrence 8_EX:2774:11535: scene=8_EX
#: 8_EX:2774
msgctxt "text_id=11535 | speaker=unknown"
msgid "　かつて体験した黄金時間の残像が、彼の脳髄を侵しているらしい。"
msgstr ""

#. Occurrence 8_EX:2779:11536: scene=8_EX
#: 8_EX:2779
msgctxt "text_id=11536 | speaker=unknown"
msgid "　それはともかく、"
msgstr ""

#. Occurrence 8_EX:2815:11537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0007; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2815
msgctxt "text_id=11537 | speaker=soujuurou"
msgid "「木乃美。その時、なんて言ったんだ？」"
msgstr ""

#. Occurrence 8_EX:2826:11538: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0025; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2826
msgctxt "text_id=11538 | speaker=kinomi"
msgid "「へ？　ああ、そん時の決め台詞ね。"
msgstr ""

#. Occurrence 8_EX:2832:11539: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0026; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2832
msgctxt "text_id=11539 | speaker=kinomi"
msgid "“お姉さんキレイっすね、オレ、そこのビルのオーナーの息子なんすけどちょっと遊んでいきません？”って。"
msgstr ""

#. Occurrence 8_EX:2838:11540: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0027; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2838
msgctxt "text_id=11540 | speaker=kinomi"
msgid "　嘘だってバレたら逃げられたけどな！」"
msgstr ""

#. Occurrence 8_EX:2864:11541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0008; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2864
msgctxt "text_id=11541 | speaker=soujuurou"
msgid "「そうじゃなくて、入学式」"
msgstr ""

#. Occurrence 8_EX:2875:11542: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0028; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2875
msgctxt "text_id=11542 | speaker=kinomi"
msgid "「ああそっちか。"
msgstr ""

#. Occurrence 8_EX:2881:11543: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0029; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2881
msgctxt "text_id=11543 | speaker=kinomi"
msgid "　えーと、蒼崎の首から下の部分に向かって、"
msgstr ""

#. Occurrence 8_EX:2892:11544: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0030; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2892
msgctxt "text_id=11544 | speaker=kinomi"
msgid "“うはっ、おまえ胸でかくねー？"
msgstr ""

#. Occurrence 8_EX:2892:11545: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0030; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2892
msgctxt "text_id=11545 | speaker=kinomi"
msgid "”」"
msgstr ""

#. Occurrence 8_EX:2917:11546: scene=8_EX
#: 8_EX:2917
msgctxt "text_id=11546 | speaker=unknown"
msgid "　だったかなぁあははは！　などと言いながら、<蛮勇|バカ>・木乃美芳助は頭を<欠|か>いている。"
msgstr ""

#. Occurrence 8_EX:2923:11547: scene=8_EX
#: 8_EX:2923
msgctxt "text_id=11547 | speaker=unknown"
msgid "もとい、<掻|か>いている。"
msgstr ""

#. Occurrence 8_EX:2928:11548: scene=8_EX
#: 8_EX:2928
msgctxt "text_id=11548 | speaker=unknown"
msgid "　かつての思い出に鼓舞されたのか、木乃美はひたすら陽気だ。"
msgstr ""

#. Occurrence 8_EX:2938:11549: scene=8_EX
#: 8_EX:2938
msgctxt "text_id=11549 | speaker=unknown"
msgid "　一方、草十郎は苦虫をかみつぶしたかのような、重い沈黙に包まれている。"
msgstr ""

#. Occurrence 8_EX:2964:11550: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0031; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2964
msgctxt "text_id=11550 | speaker=kinomi"
msgid "「うん？　どうした静希？"
msgstr ""

#. Occurrence 8_EX:2970:11551: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0032; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2970
msgctxt "text_id=11551 | speaker=kinomi"
msgid "　あ、やっぱりナンパとか興味ないか？」"
msgstr ""

#. Occurrence 8_EX:2990:11552: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0014; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2990
msgctxt "text_id=11552 | speaker=tobimaru"
msgid "「あったりめえだ。テメエみたいな色ボケと草十郎を一緒にするな」"
msgstr ""

#. Occurrence 8_EX:3024:11553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0009; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3024
msgctxt "text_id=11553 | speaker=soujuurou"
msgid "「いや。興味はある。"
msgstr ""

#. Occurrence 8_EX:3030:11554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0010; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3030
msgctxt "text_id=11554 | speaker=soujuurou"
msgid "　可愛い女の子は可愛いと思うし、たまに薄着なところに出くわすと目のやり場に困るだろ。ああいう時、自分が男だって事を実感するよな」"
msgstr ""

#. Occurrence 8_EX:3079:11555: scene=8_EX
#: 8_EX:3079
msgctxt "text_id=11555 | speaker=unknown"
msgid "　せいてん　の　へきれき　だった。"
msgstr ""

#. Occurrence 8_EX:3085:11556: scene=8_EX
#: 8_EX:3085
msgctxt "text_id=11556 | speaker=unknown"
msgid "　部屋に飾ってあった愛らしいテディベアが、口をあけたら中の人がフィリップ・マーロゥぐらいの衝撃だった。"
msgstr ""

#. Occurrence 8_EX:3122:11557: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0033; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3122
msgctxt "text_id=11557 | speaker=kinomi"
msgid "「―――は！？"
msgstr ""

#. Occurrence 8_EX:3128:11558: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0034; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3128
msgctxt "text_id=11558 | speaker=kinomi"
msgid "　そ、そりゃそうだよな！　すまん、見くびっていた。つまり静希も、オレたちの同士ってコトでいいんだな？」"
msgstr ""

#. Occurrence 8_EX:3139:11559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0011; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3139
msgctxt "text_id=11559 | speaker=soujuurou"
msgid "「同士？」"
msgstr ""

#. Occurrence 8_EX:3165:11560: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0035; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3165
msgctxt "text_id=11560 | speaker=kinomi"
msgid "「そうだ。たとえばこう―――夏場の女子のうなじにひかる汗とか、テニス部の女子の肩からワキにかけての清涼感とか、ぶっちゃけ水泳部の競泳水着の後ろ姿だよ！」"
msgstr ""

#. Occurrence 8_EX:3191:11561: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0012; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3191
msgctxt "text_id=11561 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 8_EX:3196:11562: scene=8_EX
#: 8_EX:3196
msgctxt "text_id=11562 | speaker=unknown"
msgid "　はてな？　と目をしばたたかせる草十郎。"
msgstr ""

#. Occurrence 8_EX:3201:11563: scene=8_EX
#: 8_EX:3201
msgctxt "text_id=11563 | speaker=unknown"
msgid "　木乃美の説明がいまいち実感できていない。"
msgstr ""

#. Occurrence 8_EX:3236:11564: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0036; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3236
msgctxt "text_id=11564 | speaker=kinomi"
msgid "「いや、だから普段は同い年のガキにしか見えない女どもでも、たまに見せる無防備な仕草とか、ぐっとくるよな？」"
msgstr ""

#. Occurrence 8_EX:3260:11565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0013; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3260
msgctxt "text_id=11565 | speaker=soujuurou"
msgid "「うん。無防備なのは、ちょっと考えてほしい」"
msgstr ""

#. Occurrence 8_EX:3277:11566: scene=8_EX
#: 8_EX:3277
msgctxt "text_id=11566 | speaker=unknown"
msgid "　無防備な誰かにか、"
msgstr ""

#. Occurrence 8_EX:3282:11567: scene=8_EX
#: 8_EX:3282
msgctxt "text_id=11567 | speaker=unknown"
msgid "　それとも、それに気を取られてしまう自分に対してか、草十郎は居づらそうに顔を曇らせた。"
msgstr ""

#. Occurrence 8_EX:3315:11568: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0037; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3315
msgctxt "text_id=11568 | speaker=kinomi"
msgid "「いいんだって、それでいいんだって！　なぜなら、高校生男子の六割は性欲で出来ていますからね！"
msgstr ""

#. Occurrence 8_EX:3321:11569: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0038; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3321
msgctxt "text_id=11569 | speaker=kinomi"
msgid "　よし、そうと決まればさっそくナンパに行こうぜ！　面子が変われば<釣果|ちょうか>も変わるってもんだ！」"
msgstr ""

#. Occurrence 8_EX:3341:11570: scene=8_EX
#: 8_EX:3341
msgctxt "text_id=11570 | speaker=unknown"
msgid "　何が嬉しいのか、木乃美は草十郎の肩を抱いて、共に駅前方面へと歩きだす。"
msgstr ""

#. Occurrence 8_EX:3374:11571: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0015; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3374
msgctxt "text_id=11571 | speaker=tobimaru"
msgid "「ちょっと待て。あまりのコトに絶句しちまったが、テメエは根本的に間違ってる。"
msgstr ""

#. Occurrence 8_EX:3380:11572: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0016; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3380
msgctxt "text_id=11572 | speaker=tobimaru"
msgid "　草十郎。そもそもナンパって言葉がなんなのか、知ってるか？」"
msgstr ""

#. Occurrence 8_EX:3386:11573: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0014; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3386
msgctxt "text_id=11573 | speaker=soujuurou"
msgid "「？？」"
msgstr ""

#. Occurrence 8_EX:3418:11574: scene=8_EX
#: 8_EX:3418
msgctxt "text_id=11574 | speaker=unknown"
msgid "【軟派】"
msgstr ""

#. Occurrence 8_EX:3424:11575: scene=8_EX
#: 8_EX:3424
msgctxt "text_id=11575 | speaker=unknown"
msgid "　①軟弱な意見の党派。「―議員」"
msgstr ""

#. Occurrence 8_EX:3429:11576: scene=8_EX
#: 8_EX:3429
msgctxt "text_id=11576 | speaker=unknown"
msgid "　②文芸上エロチシズムを主とするもの。「江戸―」"
msgstr ""

#. Occurrence 8_EX:3434:11577: scene=8_EX
#: 8_EX:3434
msgctxt "text_id=11577 | speaker=unknown"
msgid "　③社会面や文学における艶物の担当。「―記者」"
msgstr ""

#. Occurrence 8_EX:3439:11578: scene=8_EX
#: 8_EX:3439
msgctxt "text_id=11578 | speaker=unknown"
msgid "　④軟弱な風潮に同調する人々。"
msgstr ""

#. Occurrence 8_EX:3444:11579: scene=8_EX
#: 8_EX:3444
msgctxt "text_id=11579 | speaker=unknown"
msgid "　⑤転じて、女性などを誘惑すること。硬派"
msgstr ""

#. Occurrence 8_EX:3478:11580: scene=8_EX
#: 8_EX:3478
msgctxt "text_id=11580 | speaker=unknown"
msgid "「…………"
msgstr ""

msgctxt "text_id=11581 | speaker=unknown"
msgid "二番か？」"
msgstr ""

#. Occurrence 8_EX:3496:11582: scene=8_EX
#: 8_EX:3496
msgctxt "text_id=11582 | speaker=unknown"
msgid "　論外である。"
msgstr ""

#. Occurrence 8_EX:3501:11583: scene=8_EX
#: 8_EX:3501
msgctxt "text_id=11583 | speaker=unknown"
msgid "　いずれ死語になる言葉ではあるが、８０年代の高校生にとってナンパとは十中八九、五番に該当する。"
msgstr ""

#. Occurrence 8_EX:3534:11584: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0017; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3534
msgctxt "text_id=11584 | speaker=tobimaru"
msgid "「ほら見ろ。テメエとは興味の度合いが違うんだよ。"
msgstr ""

#. Occurrence 8_EX:3540:11585: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0018; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3540
msgctxt "text_id=11585 | speaker=tobimaru"
msgid "　<女|おんな>引っかけに行くなら一人で行け。ああ、あと三咲の駅前はやめとけよ、うちの評判が悪くなるから。ナンパなら隣町でやりやがれ」"
msgstr ""

#. Occurrence 8_EX:3546:11586: scene=8_EX
#: 8_EX:3546
msgctxt "text_id=11586 | speaker=unknown"
msgid "　鳶丸はシッシッと手を振って悪い虫を追い払う。"
msgstr ""

#. Occurrence 8_EX:3551:11587: scene=8_EX
#: 8_EX:3551
msgctxt "text_id=11587 | speaker=unknown"
msgid "　ちぇっ、と舌打ちして木乃美は草十郎から肩を離した。"
msgstr ""

#. Occurrence 8_EX:3589:11588: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0039; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3589
msgctxt "text_id=11588 | speaker=kinomi"
msgid "「くそ面白くねぇ。あいよ、大人しく野球やってますよ。"
msgstr ""

#. Occurrence 8_EX:3589:11589: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0039; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3589
msgctxt "text_id=11589 | speaker=kinomi"
msgid "　いつのまにかオレたちの番が回ってきたみたいだし？」"
msgstr ""

#. Occurrence 8_EX:3601:11590: scene=8_EX
#: 8_EX:3601
msgctxt "text_id=11590 | speaker=unknown"
msgid "　悪態をつきながら木乃美はマウンドに向かう。"
msgstr ""

#. Occurrence 8_EX:3606:11591: scene=8_EX
#: 8_EX:3606
msgctxt "text_id=11591 | speaker=unknown"
msgid "　それを草十郎は名残惜しそうに見送っている。"
msgstr ""

#. Occurrence 8_EX:3643:11592: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0019; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3643
msgctxt "text_id=11592 | speaker=tobimaru"
msgid "「おい。まさか、本気でナンパに行きたかったのか？」"
msgstr ""

#. Occurrence 8_EX:3654:11593: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0016; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3654
msgctxt "text_id=11593 | speaker=soujuurou"
msgid "「？　いや、ナンパはよく分からないけど、町には用があったんだ。ちょっと欲しいものがあって……"
msgstr ""

#. Occurrence 8_EX:3665:11594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0017; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3665
msgctxt "text_id=11594 | speaker=soujuurou"
msgid "　そうだ鳶丸。生徒会室にあるあの白いヤツ、どこにいけば買えるか知ってるか？」"
msgstr ""

#. Occurrence 8_EX:3676:11595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0020; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3676
msgctxt "text_id=11595 | speaker=tobimaru"
msgid "「？」"
msgstr ""

#. Occurrence 8_EX:3696:11596: scene=8_EX
#: 8_EX:3696
msgctxt "text_id=11596 | speaker=unknown"
msgid "　草十郎は両手をいっぱいに広げて、奇妙なジェスチャーをした。"
msgstr ""

#. Occurrence 8_EX:3732:11597: scene=8_EX
#: 8_EX:3732
msgctxt "text_id=11597 | speaker=unknown"
msgid "　一時間後、駅前デパート。"
msgstr ""

#. Occurrence 8_EX:3737:11598: scene=8_EX
#: 8_EX:3737
msgctxt "text_id=11598 | speaker=unknown"
msgid "　草十郎が欲しがっていたものが何であるか知った後でも、鳶丸は首をかしげていた。"
msgstr ""

#. Occurrence 8_EX:3744:11599: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0021; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3744
msgctxt "text_id=11599 | speaker=tobimaru"
msgid "「―――しかし、なんだってこんなものを？」"
msgstr ""

#. Occurrence 8_EX:3791:11600: scene=8_EX
#: 8_EX:3791
msgctxt "text_id=11600 | speaker=unknown"
msgid "　有珠の用意した夕飯があまりにも素晴らしかったからなのか。"
msgstr ""

#. Occurrence 8_EX:3796:11601: scene=8_EX
#: 8_EX:3796
msgctxt "text_id=11601 | speaker=unknown"
msgid "　久遠寺邸の夜は珍しく、三者三様に上機嫌なくつろぎ空間と化していた。"
msgstr ""

#. Occurrence 8_EX:3825:11602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0018; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3825
msgctxt "text_id=11602 | speaker=soujuurou"
msgid "「七回？　有珠の実家じゃ一日に七回も食事を<摂|と>るのか？"
msgstr ""

#. Occurrence 8_EX:3832:11603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0019; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3832
msgctxt "text_id=11603 | speaker=soujuurou"
msgid "　……いったい、どうやって？」"
msgstr ""

#. Occurrence 8_EX:3838:11604: scene=8_EX
#: 8_EX:3838
msgctxt "text_id=11604 | speaker=unknown"
msgid "　三つ目のソファー……屋敷の地下室から実力でゲットした記念品……に座りながら、草十郎はサンルームの有珠に話しかける。"
msgstr ""

#. Occurrence 8_EX:3871:11605: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0000; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3871
msgctxt "text_id=11605 | speaker=alice"
msgid "「食事を摂っているわけじゃないわ。ティータイムは一日七回行うのが理想というだけ。"
msgstr ""

#. Occurrence 8_EX:3877:11606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0001; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3877
msgctxt "text_id=11606 | speaker=alice"
msgid "　寝起きのアーリー、朝食のブレックファースト、午前のイレブンジズ、午後のミィディティーブレイク、午後の社交界アフタヌーン、夜会のハイティー、ディナー後のアフターディナー。"
msgstr ""

#. Occurrence 8_EX:3883:11607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0002; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3883
msgctxt "text_id=11607 | speaker=alice"
msgid "　この中で食事に該当するのはハイティーだけよ。田舎での話だけれど」"
msgstr ""

#. Occurrence 8_EX:3915:11608: scene=8_EX
#: 8_EX:3915
msgctxt "text_id=11608 | speaker=unknown"
msgid "　有珠はサンルームでひとり、紅茶を<愉|たの>しんでいる。"
msgstr ""

#. Occurrence 8_EX:3920:11609: scene=8_EX
#: 8_EX:3920
msgctxt "text_id=11609 | speaker=unknown"
msgid "　口にしているのはロイヤルブレンドティー。"
msgstr ""

#. Occurrence 8_EX:3925:11610: scene=8_EX
#: 8_EX:3925
msgctxt "text_id=11610 | speaker=unknown"
msgid "　ダージリン、セイロン、アッサムの<茶葉|オレンジペコー>を<配合|ブレンド>した逸品だ。"
msgstr ""

#. Occurrence 8_EX:3930:11611: scene=8_EX
#: 8_EX:3930
msgctxt "text_id=11611 | speaker=unknown"
msgid "　お茶請けには砂糖をまぶした苺を完備。"
msgstr ""

#. Occurrence 8_EX:3935:11612: scene=8_EX
#: 8_EX:3935
msgctxt "text_id=11612 | speaker=unknown"
msgid "　もう完全に自分だけの世界を形成している。"
msgstr ""

#. Occurrence 8_EX:3968:11613: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0020; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3968
msgctxt "text_id=11613 | speaker=soujuurou"
msgid "「つまり、一日中お茶を飲んでいるのか？」"
msgstr ""

#. Occurrence 8_EX:3986:11614: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0003; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3986
msgctxt "text_id=11614 | speaker=alice"
msgid "「そうね。そう暮らせるのなら、理想的ね」"
msgstr ""

#. Occurrence 8_EX:3992:11615: scene=8_EX
#: 8_EX:3992
msgctxt "text_id=11615 | speaker=unknown"
msgid "　草十郎のボケ倒しも通用しない。"
msgstr ""

#. Occurrence 8_EX:4002:11616: scene=8_EX
#: 8_EX:4002
msgctxt "text_id=11616 | speaker=unknown"
msgid "　有珠は細い指でじかに苺を摘んで、口づけるように舌に運んだ。"
msgstr ""

#. Occurrence 8_EX:4052:11617: scene=8_EX
#: 8_EX:4052
msgctxt "text_id=11617 | speaker=unknown"
msgid "　その満足げな横顔に見惚れそうになって、草十郎はぶんぶんと頭を振る。"
msgstr ""

#. Occurrence 8_EX:4057:11618: scene=8_EX
#: 8_EX:4057
msgctxt "text_id=11618 | speaker=unknown"
msgid "　昼間の話が尾を引いているのか、同居人たちが垣間見せる“異性らしさ”に、やや過敏になっているようだ。"
msgstr ""

#. Occurrence 8_EX:4092:11619: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0021; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4092
msgctxt "text_id=11619 | speaker=soujuurou"
msgid "「でもその口ぶりだと、有珠は七回できてないんだ」"
msgstr ""

#. Occurrence 8_EX:4098:11620: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0004; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4098
msgctxt "text_id=11620 | speaker=alice"
msgid "「三回が限度よ。相方が未熟だから、やらなくちゃいけない事が増えてしまって」"
msgstr ""

#. Occurrence 8_EX:4104:11621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0022; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4104
msgctxt "text_id=11621 | speaker=soujuurou"
msgid "「相方」"
msgstr ""

#. Occurrence 8_EX:4110:11622: scene=8_EX
#: 8_EX:4110
msgctxt "text_id=11622 | speaker=unknown"
msgid "　草十郎は真横に視線を移す。"
msgstr ""

#. Occurrence 8_EX:4115:11623: scene=8_EX
#: 8_EX:4115
msgctxt "text_id=11623 | speaker=unknown"
msgid "　そこには、"
msgstr ""

#. Occurrence 8_EX:4156:11624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0030; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4156
msgctxt "text_id=11624 | speaker=aoko"
msgid "「なによ、一日三回も開いてれば上出来じゃない。"
msgstr ""

#. Occurrence 8_EX:4162:11625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0031; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4162
msgctxt "text_id=11625 | speaker=aoko"
msgid "　うちの生徒会なんて黙ってお茶飲んでるだけよ？　いちいち鍋からお湯沸かして、ポット使って、たっぷり蒸らすなんて、三時のおやつと夕食後だけで十分でしょう。"
msgstr ""

#. Occurrence 8_EX:4168:11626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0032; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4168
msgctxt "text_id=11626 | speaker=aoko"
msgid "　有珠は手間をかけすぎ。私、贅沢は好きだけど、贅沢に慣れるのはご免だから」"
msgstr ""

#. Occurrence 8_EX:4174:11627: scene=8_EX
#: 8_EX:4174
msgctxt "text_id=11627 | speaker=unknown"
msgid "　有珠に反論しつつも、これまた上機嫌な青子がいる。"
msgstr ""

#. Occurrence 8_EX:4210:11628: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0005; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4210
msgctxt "text_id=11628 | speaker=alice"
msgid "「贅沢なのは青子たちの方よ。日本の水道水はこんなにも美味しいのに。どうして貴方たちは、この<軟水|おうごん>の価値に気付かないのかしら？」"
msgstr ""

#. Occurrence 8_EX:4227:11629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0033; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4227
msgctxt "text_id=11629 | speaker=aoko"
msgid "「一日七回もお茶会開く国民性じゃないからでしょ。"
msgstr ""

#. Occurrence 8_EX:4233:11630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0034; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4233
msgctxt "text_id=11630 | speaker=aoko"
msgid "　気をつけなさいね草十郎。美味しい紅茶を淹れようとしてペットボトルの水なんて買ってきたら、有珠に一時間近くお説教されるから。知識も心構えもなってない、って」"
msgstr ""

#. Occurrence 8_EX:4263:11631: scene=8_EX
#: 8_EX:4263
msgctxt "text_id=11631 | speaker=unknown"
msgid "　水が美味しければ紅茶も美味しくなるはずだ。"
msgstr ""

#. Occurrence 8_EX:4268:11632: scene=8_EX
#: 8_EX:4268
msgctxt "text_id=11632 | speaker=unknown"
msgid "　久遠寺邸に引っ越してすぐの頃、青子はそう考えてペットボトルの自然水を買ってきた。"
msgstr ""

#. Occurrence 8_EX:4273:11633: scene=8_EX
#: 8_EX:4273
msgctxt "text_id=11633 | speaker=unknown"
msgid "　これでどうよ、と自信満々の青子だったが、結果は同居人とのはじめての“人間らしい”口論だった。"
msgstr ""

#. Occurrence 8_EX:4278:11634: scene=8_EX
#: 8_EX:4278
msgctxt "text_id=11634 | speaker=unknown"
msgid "　魔術以外のコトであんなに<罵|ののし>りあい、終わった時は二人とも疲れきって、"
msgstr ""

#. Occurrence 8_EX:4309:11635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0006; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4309
msgctxt "text_id=11635 | speaker=alice"
msgid "『……蒼崎さん。夕食を作る気力、残ってる？』"
msgstr ""

#. Occurrence 8_EX:4315:11636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0035; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4315
msgctxt "text_id=11636 | speaker=aoko"
msgid "『……パス。主義に反するけど、<店屋物|てんやもの>を頼んでみよう』"
msgstr ""

#. Occurrence 8_EX:4321:11637: scene=8_EX
#: 8_EX:4321
msgctxt "text_id=11637 | speaker=unknown"
msgid "　これまたはじめて、蕎麦屋に電話で注文する経験をした。"
msgstr ""

#. Occurrence 8_EX:4326:11638: scene=8_EX
#: 8_EX:4326
msgctxt "text_id=11638 | speaker=unknown"
msgid "　以来、二人の<自堕落|じだらく>っぷりは加速の<一途|いっと>を辿ったのである。"
msgstr ""

#. Occurrence 8_EX:4369:11639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0036; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4369
msgctxt "text_id=11639 | speaker=aoko"
msgid "「いやー、あの後は悔しくってお茶について調べまくったもんだわ。有珠に質問したり競い合ってたら、いつのまにか私も紅茶党の仲間入りよ。"
msgstr ""

#. Occurrence 8_EX:4375:11640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0037; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4375
msgctxt "text_id=11640 | speaker=aoko"
msgid "　私、姉貴の影響で中学までコーヒー党だったのに」"
msgstr ""

#. Occurrence 8_EX:4405:11641: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0007; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4405
msgctxt "text_id=11641 | speaker=alice"
msgid "「……そこには感謝しているわ。"
msgstr ""

#. Occurrence 8_EX:4411:11642: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0008; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4411
msgctxt "text_id=11642 | speaker=alice"
msgid "　青子が連れ出してくれなかったら、コープランドのアンティークカップに出会えなかったもの」"
msgstr ""

#. Occurrence 8_EX:4417:11643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0038; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4417
msgctxt "text_id=11643 | speaker=aoko"
msgid "「あはは。気が付いたら骨董品回りしてたものね、去年の私たち」"
msgstr ""

#. Occurrence 8_EX:4437:11644: scene=8_EX
#: 8_EX:4437
msgctxt "text_id=11644 | speaker=unknown"
msgid "　居間とサンルーム。"
msgstr ""

#. Occurrence 8_EX:4442:11645: scene=8_EX
#: 8_EX:4442
msgctxt "text_id=11645 | speaker=unknown"
msgid "　離れてはいるものの二人は楽しげに会話をしている。"
msgstr ""

#. Occurrence 8_EX:4461:11646: scene=8_EX
#: 8_EX:4461
msgctxt "text_id=11646 | speaker=unknown"
msgid "　せっかく仲が良いんだから、居間で向き合って話をすればいいのに、と草十郎は首をかしげる。"
msgstr ""

#. Occurrence 8_EX:4466:11647: scene=8_EX
#: 8_EX:4466
msgctxt "text_id=11647 | speaker=unknown"
msgid "　離れているからこそ思い出話には興が乗ることを、彼はまだ知らないのだ。"
msgstr ""

#. Occurrence 8_EX:4492:11648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0023; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4492
msgctxt "text_id=11648 | speaker=soujuurou"
msgid "「ふうん。有珠は外に出ない子だったんだ」"
msgstr ""

#. Occurrence 8_EX:4511:11649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0039; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4511
msgctxt "text_id=11649 | speaker=aoko"
msgid "「ええ、この子ったらほーんと屋内派で、外に出るのは学校だけだったんだから。"
msgstr ""

#. Occurrence 8_EX:4511:11650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0039; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4511
msgctxt "text_id=11650 | speaker=aoko"
msgid "　今日だってずっと洋館にいたんでしょう、有珠？」"
msgstr ""

#. Occurrence 8_EX:4544:11651: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0009; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4544
msgctxt "text_id=11651 | speaker=alice"
msgid "「―――違うわ。外に用がないだけよ。"
msgstr ""

#. Occurrence 8_EX:4544:11652: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0009; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4544
msgctxt "text_id=11652 | speaker=alice"
msgid "　今日はプロイの補充に忙しかっただけだし」"
msgstr ""

#. Occurrence 8_EX:4562:11653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0024; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4562
msgctxt "text_id=11653 | speaker=soujuurou"
msgid "「それだ。プロイの補充ってコトは、遊園地の時みたいなのはここで生まれてるのか？」"
msgstr ""

#. Occurrence 8_EX:4613:11654: scene=8_EX
#: 8_EX:4613
msgctxt "text_id=11654 | speaker=unknown"
msgid "　遊園地で酷い目にあって以来、草十郎はプロイと聞くと過敏に反応する。あの時は逃げるのに手一杯だったが、時間が経つにつれ、"
msgstr ""

#. Occurrence 8_EX:4618:11655: scene=8_EX
#: 8_EX:4618
msgctxt "text_id=11655 | speaker=unknown"
msgid "“あの不思議なものはなんだったのか？”"
msgstr ""

#. Occurrence 8_EX:4623:11656: scene=8_EX
#: 8_EX:4623
msgctxt "text_id=11656 | speaker=unknown"
msgid "　と気になって仕方がなかったらしい。"
msgstr ""

#. Occurrence 8_EX:4644:11657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0040; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4644
msgctxt "text_id=11657 | speaker=aoko"
msgid "「なに、知りたい草十郎？」"
msgstr ""

#. Occurrence 8_EX:4662:11658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0025; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4662
msgctxt "text_id=11658 | speaker=soujuurou"
msgid "「教えてくれるなら知りたいけど……いや、よく考えると聞かない方がいいような、やっぱり知りたいような―――」"
msgstr ""

#. Occurrence 8_EX:4698:11659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0041; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4698
msgctxt "text_id=11659 | speaker=aoko"
msgid "「よし、そういう事なら話してあげましょう！"
msgstr ""

#. Occurrence 8_EX:4704:11660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0042; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4704
msgctxt "text_id=11660 | speaker=aoko"
msgid "　ちょっとした触りだけなら怒らないわよね、有珠？」"
msgstr ""

#. Occurrence 8_EX:4709:11661: scene=8_EX
#: 8_EX:4709
msgctxt "text_id=11661 | speaker=unknown"
msgid "　勢いよく脚を組み替える青子。"
msgstr ""

#. Occurrence 8_EX:4715:11662: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0010; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4715
msgctxt "text_id=11662 | speaker=alice"
msgid "「……別に。"
msgstr ""

#. Occurrence 8_EX:4715:11663: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0010; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4715
msgctxt "text_id=11663 | speaker=alice"
msgid "　わたしと貴女の違いを話すぐらいなら、いいけど」"
msgstr ""

#. Occurrence 8_EX:4749:11664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0043; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4749
msgctxt "text_id=11664 | speaker=aoko"
msgid "「よし決まった！"
msgstr ""

#. Occurrence 8_EX:4756:11665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0044; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4756
msgctxt "text_id=11665 | speaker=aoko"
msgid "　……ってなによアンタ、妙な顔して。自分から言っておいて尻尾まくの？」"
msgstr ""

#. Occurrence 8_EX:4772:11666: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0026; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4772
msgctxt "text_id=11666 | speaker=soujuurou"
msgid "「―――いや、そうではなく」"
msgstr ""

#. Occurrence 8_EX:4778:11667: scene=8_EX
#: 8_EX:4778
msgctxt "text_id=11667 | speaker=unknown"
msgid "　青子に正面から見つめられて、草十郎はつい視線を泳がす。"
msgstr ""

#. Occurrence 8_EX:4808:11668: scene=8_EX
#: 8_EX:4808
msgctxt "text_id=11668 | speaker=unknown"
msgid "　現状、青子との接点は食後のひとときだけなので<接触事故|ニアミス>はないのだが、たまに、こういう無防備な仕草を目にしてしまい、対応に困る草十郎だった。"
msgstr ""

#. Occurrence 8_EX:4829:11669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0027; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4829
msgctxt "text_id=11669 | speaker=soujuurou"
msgid "「いいんだ、続けてくれ。興味はある」"
msgstr ""

#. Occurrence 8_EX:4845:11670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0045; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4845
msgctxt "text_id=11670 | speaker=aoko"
msgid "「よし。じゃあ<駒鳥|コマドリ>呼ばないとね。"
msgstr ""

#. Occurrence 8_EX:4851:11671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0046; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4851
msgctxt "text_id=11671 | speaker=aoko"
msgid "　それでは特別授業、なぜなにプロイキッシャー、はじまりはじまり～」"
msgstr ""

#. Occurrence 8_EX:4873:11672: scene=8_EX
#: 8_EX:4873
msgctxt "text_id=11672 | speaker=unknown"
msgid "　青子はパチンと指を鳴らす。"
msgstr ""

#. Occurrence 8_EX:4878:11673: scene=8_EX
#: 8_EX:4878
msgctxt "text_id=11673 | speaker=unknown"
msgid "　テレビのスイッチを入れる真似ごとらしい。"
msgstr ""

#. Occurrence 8_EX:4884:11674: scene=8_EX
#: 8_EX:4884
msgctxt "text_id=11674 | speaker=unknown"
msgid "　……<一時|いっとき>の番外編。"
msgstr ""

#. Occurrence 8_EX:4889:11675: scene=8_EX
#: 8_EX:4889
msgctxt "text_id=11675 | speaker=unknown"
msgid "　久遠寺有珠監修、久遠寺有珠出演による、ある魔術系統のレクチャーはこうして始まった。"
msgstr ""

#. Occurrence 8_EX:4937:11676: scene=8_EX
#: 8_EX:4937
msgctxt "text_id=11676 | speaker=unknown"
msgid "　が。"
msgstr ""

#. Occurrence 8_EX:4942:11677: scene=8_EX
#: 8_EX:4942
msgctxt "text_id=11677 | speaker=unknown"
msgid "　せっかくの特番は三十分ほどで打ち切りと相成った。"
msgstr ""

#. Occurrence 8_EX:4947:11678: scene=8_EX
#: 8_EX:4947
msgctxt "text_id=11678 | speaker=unknown"
msgid "　聞き手である草十郎をおいてけぼりにした、あまりにマニアックな内容だったからである。"
msgstr ""

#. Occurrence 8_EX:4987:11679: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0011; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4987
msgctxt "text_id=11679 | speaker=alice"
msgid "「……分かってはいたけど。"
msgstr ""

#. Occurrence 8_EX:4993:11680: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0012; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4993
msgctxt "text_id=11680 | speaker=alice"
msgid "　静希君の覚えの悪さは、三千世界に響き渡るわね」"
msgstr ""

#. Occurrence 8_EX:4999:11681: scene=8_EX
#: 8_EX:4999
msgctxt "text_id=11681 | speaker=unknown"
msgid "　死ねばいいのに、と言葉にならないため息をつく有珠。"
msgstr ""

#. Occurrence 8_EX:5024:11682: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0047; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5024
msgctxt "text_id=11682 | speaker=aoko"
msgid "「可哀想な有珠。さすがに今回は同情するわ。"
msgstr ""

#. Occurrence 8_EX:5030:11683: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0048; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5030
msgctxt "text_id=11683 | speaker=aoko"
msgid "　ソイツにとっちゃ私の魔術も有珠の魔術も“すごく便利”でくくられちゃうものだなんて。他の魔術師が聞いたら失神ものの屈辱よ」"
msgstr ""

#. Occurrence 8_EX:5050:11684: scene=8_EX
#: 8_EX:5050
msgctxt "text_id=11684 | speaker=unknown"
msgid "　青子も本格的に呆れている。"
msgstr ""

#. Occurrence 8_EX:5055:11685: scene=8_EX
#: 8_EX:5055
msgctxt "text_id=11685 | speaker=unknown"
msgid "　もっとも、彼女の場合は反省も混じっていた。"
msgstr ""

#. Occurrence 8_EX:5060:11686: scene=8_EX
#: 8_EX:5060
msgctxt "text_id=11686 | speaker=unknown"
msgid "　考えてみればこの結果は見えていたからだ。"
msgstr ""

#. Occurrence 8_EX:5095:11687: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0028; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5095
msgctxt "text_id=11687 | speaker=soujuurou"
msgid "「そんな事はない。ちゃんと区別はつく。"
msgstr ""

#. Occurrence 8_EX:5101:11688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0029; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5101
msgctxt "text_id=11688 | speaker=soujuurou"
msgid "　蒼崎は壊すだけで、有珠はいろんなものを作って、それで壊すんだろ。有珠の方がやや生産的だ」"
msgstr ""

#. Occurrence 8_EX:5145:11689: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0013; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5145
msgctxt "text_id=11689 | speaker=alice"
msgid "「怖いわ青子。わたし、どうしてか胸が苦しい。こういうコトって本当にあるのね。"
msgstr ""

#. Occurrence 8_EX:5151:11690: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0014; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5151
msgctxt "text_id=11690 | speaker=alice"
msgid "　まるで、お気に入りのカップを割ってしまった時、通りかかったキリンに“でもトロルよりマシですよ”と<慰|なぐさ>められた気分だわ」"
msgstr ""

#. Occurrence 8_EX:5173:11691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0049; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5173
msgctxt "text_id=11691 | speaker=aoko"
msgid "「どういう意味よそれ」"
msgstr ""

#. Occurrence 8_EX:5193:11692: scene=8_EX
#: 8_EX:5193
msgctxt "text_id=11692 | speaker=unknown"
msgid "　むっと対面に座った相方を睨む青子。"
msgstr ""

#. Occurrence 8_EX:5198:11693: scene=8_EX
#: 8_EX:5198
msgctxt "text_id=11693 | speaker=unknown"
msgid "　トロルとは童話で言うところの、少々おつむの足りない暴れん坊の巨人の名だ。"
msgstr ""

#. Occurrence 8_EX:5224:11694: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0050; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5224
msgctxt "text_id=11694 | speaker=aoko"
msgid "「……ふん。今の草十郎の指摘、けっこうあってると思うけど。"
msgstr ""

#. Occurrence 8_EX:5231:11695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0051; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5231
msgctxt "text_id=11695 | speaker=aoko"
msgid "私、有珠のプロイが生活の役に立つトコ見たことないし。駒鳥も双子も最後はドジって終わりじゃない」"
msgstr ""

#. Occurrence 8_EX:5249:11696: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0015; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5249
msgctxt "text_id=11696 | speaker=alice"
msgid "「それは結果論よ。役立とうという初志は尊重するべきだわ。……だいたい。<駒鳥|アレ>や<双子|ソレ>が最後にぜんぶ台無しにするのは、わたしの責任じゃないのだし」"
msgstr ""

#. Occurrence 8_EX:5269:11697: scene=8_EX
#: 8_EX:5269
msgctxt "text_id=11697 | speaker=unknown"
msgid "　両者は互いのダメだしに余念がない。"
msgstr ""

#. Occurrence 8_EX:5274:11698: scene=8_EX
#: 8_EX:5274
msgctxt "text_id=11698 | speaker=unknown"
msgid "　こと魔術の技量に関して、両者とも譲れない一線があるようだ。"
msgstr ""

#. Occurrence 8_EX:5279:11699: scene=8_EX
#: 8_EX:5279
msgctxt "text_id=11699 | speaker=unknown"
msgid "　どちらがより厄介な壊し屋なのかを押しつける、<底辺|ていへん>の争いにしても。"
msgstr ""

#. Occurrence 8_EX:5313:11700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0030; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5313
msgctxt "text_id=11700 | speaker=soujuurou"
msgid "「いや、でも有珠の使い魔は役に立ってるぞ。"
msgstr ""

#. Occurrence 8_EX:5319:11701: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0031; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5319
msgctxt "text_id=11701 | speaker=soujuurou"
msgid "　前に森で落ち葉を集めているブタを見かけた。あれは有珠の使い魔なのに、なんで蒼崎に言ってやらないんだ。"
msgstr ""

#. Occurrence 8_EX:5325:11702: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0032; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5325
msgctxt "text_id=11702 | speaker=soujuurou"
msgid "　……まあ、いいことをしたのに黙っているのは美徳だって、山城先生は言ってたけど」"
msgstr ""

#. Occurrence 8_EX:5354:11703: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0052; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5354
msgctxt "text_id=11703 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_EX:5374:11704: scene=8_EX
#: 8_EX:5374
msgctxt "text_id=11704 | speaker=unknown"
msgid "　有珠にしてみれば慣らし運転、ただの準備運動で“お喋り双子”を森に派遣したのだが、草十郎から見れば立派な善行だったらしい。"
msgstr ""

#. Occurrence 8_EX:5379:11705: scene=8_EX
#: 8_EX:5379
msgctxt "text_id=11705 | speaker=unknown"
msgid "　有珠の勝ち、と納得する草十郎に、青子はますます面白くない。"
msgstr ""

#. Occurrence 8_EX:5406:11706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0053; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5406
msgctxt "text_id=11706 | speaker=aoko"
msgid "「ハン。掃除をしているから生産的とか、ずいぶん小さな判断ですこと。もっとこう、大きな視点で評価できないのかしらね、このお掃除マシーンは」"
msgstr ""

#. Occurrence 8_EX:5428:11707: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0033; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5428
msgctxt "text_id=11707 | speaker=soujuurou"
msgid "「大きな視点―――"
msgstr ""

msgctxt "text_id=11708 | speaker=unknown"
msgid "たとえば、お金<儲|もう>けとか？」"
msgstr ""

#. Occurrence 8_EX:5467:11709: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0054; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5467
msgctxt "text_id=11709 | speaker=aoko"
msgid "「！？」"
msgstr ""

#. Occurrence 8_EX:5485:11710: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0016; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5485
msgctxt "text_id=11710 | speaker=alice"
msgid "「ご」"
msgstr ""

#. Occurrence 8_EX:5521:11711: scene=8_EX
#: 8_EX:5521
msgctxt "text_id=11711 | speaker=unknown"
msgid "　あまりに直球な質問に、少女たちは平静を装いつつ顔を見合わせる。"
msgstr ""

#. Occurrence 8_EX:5526:11712: scene=8_EX
#: 8_EX:5526
msgctxt "text_id=11712 | speaker=unknown"
msgid "　時に、愚者の思いつきは会議を新たなステージに押し上げるのだった。"
msgstr ""

#. Occurrence 8_EX:5554:11713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0055; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5554
msgctxt "text_id=11713 | speaker=aoko"
msgid "「……呆れた。我ながらその発想はなかったわ。"
msgstr ""

#. Occurrence 8_EX:5560:11714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0056; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5560
msgctxt "text_id=11714 | speaker=aoko"
msgid "　盲点すぎたっていうか、基本、魔術って損失しか産まないものだから」"
msgstr ""

#. Occurrence 8_EX:5572:11715: scene=8_EX
#: 8_EX:5572
msgctxt "text_id=11715 | speaker=unknown"
msgid "　青子の意見に、うんうん、と頷く有珠。"
msgstr ""

#. Occurrence 8_EX:5608:11716: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0057; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5608
msgctxt "text_id=11716 | speaker=aoko"
msgid "「それで、たとえば？"
msgstr ""

#. Occurrence 8_EX:5614:11717: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0058; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5614
msgctxt "text_id=11717 | speaker=aoko"
msgid "　貴方から見て、私の魔術はどんな金策ができると思う？」"
msgstr ""

#. Occurrence 8_EX:5620:11718: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0034; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5620
msgctxt "text_id=11718 | speaker=soujuurou"
msgid "「蒼崎なら……そうだな、マグロを捕まえるのはどうだろう」"
msgstr ""

#. Occurrence 8_EX:5626:11719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0059; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5626
msgctxt "text_id=11719 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 8_EX:5631:11720: scene=8_EX
#: 8_EX:5631
msgctxt "text_id=11720 | speaker=unknown"
msgid "　しばし沈黙。"
msgstr ""

#. Occurrence 8_EX:5664:11721: scene=8_EX
#: 8_EX:5664
msgctxt "text_id=11721 | speaker=unknown"
msgid "　青子は静かに足を組み直して、"
msgstr ""

#. Occurrence 8_EX:5673:11722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0060; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5673
msgctxt "text_id=11722 | speaker=aoko"
msgid "「なんでマグロ？」"
msgstr ""

#. Occurrence 8_EX:5679:11723: scene=8_EX
#: 8_EX:5679
msgctxt "text_id=11723 | speaker=unknown"
msgid "　わりと真剣に聞き返した。"
msgstr ""

#. Occurrence 8_EX:5712:11724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0035; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5712
msgctxt "text_id=11724 | speaker=soujuurou"
msgid "「いや。<朝市|あさいち>でたいへん高価だと聞いた。"
msgstr ""

#. Occurrence 8_EX:5718:11725: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0036; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5718
msgctxt "text_id=11725 | speaker=soujuurou"
msgid "　でも捕まえるのは難しいって。あんな巨大なものが、水の中では車より速く泳ぐと」"
msgstr ""

#. Occurrence 8_EX:5724:11726: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0061; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5724
msgctxt "text_id=11726 | speaker=aoko"
msgid "「そりゃ地球が誇る大型肉食魚だからね。お寿司屋さんでも最強だし。平均時速60キロ、マックススピードは時速180キロに迫ると聞くわ」"
msgstr ""

#. Occurrence 8_EX:5730:11727: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0037; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5730
msgctxt "text_id=11727 | speaker=soujuurou"
msgid "「部長いわく、蒼崎は泳ぎがうまいって。泳いで捕まえられないか？」"
msgstr ""

#. Occurrence 8_EX:5751:11728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0062; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5751
msgctxt "text_id=11728 | speaker=aoko"
msgid "「もう魔術関係ないわねそれ。"
msgstr ""

#. Occurrence 8_EX:5757:11729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0063; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5757
msgctxt "text_id=11729 | speaker=aoko"
msgid "　仮に魔弾で迎撃できたとしても、保存できないわ。私、回転を速めるのが専門で止めるのはちょっと。有珠は？」"
msgstr ""

#. Occurrence 8_EX:5763:11730: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0017; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5763
msgctxt "text_id=11730 | speaker=alice"
msgid "「魚は苦手」"
msgstr ""

#. Occurrence 8_EX:5768:11731: scene=8_EX
#: 8_EX:5768
msgctxt "text_id=11731 | speaker=unknown"
msgid "　たまに妙に気を引くのがいるから、と小さく付け足す有珠だった。"
msgstr ""

#. Occurrence 8_EX:5797:11732: scene=8_EX
#: 8_EX:5797
msgctxt "text_id=11732 | speaker=unknown"
msgid "　そう、じゃあ無理ね、と青子は両肩を落とす。"
msgstr ""

#. Occurrence 8_EX:5823:11733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0064; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5823
msgctxt "text_id=11733 | speaker=aoko"
msgid "「ところでケンカ売ってる、静希君？」"
msgstr ""

#. Occurrence 8_EX:5843:11734: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0038; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5843
msgctxt "text_id=11734 | speaker=soujuurou"
msgid "「す、すまない。実は、ちょっとからかっ、てみた」"
msgstr ""

#. Occurrence 8_EX:5855:11735: scene=8_EX
#: 8_EX:5855
msgctxt "text_id=11735 | speaker=unknown"
msgid "　首輪の圧迫は五秒ほどで止まった。"
msgstr ""

#. Occurrence 8_EX:5860:11736: scene=8_EX
#: 8_EX:5860
msgctxt "text_id=11736 | speaker=unknown"
msgid "　微妙にシャレにならない<締め時間|チョークスリーパー>だ。"
msgstr ""

#. Occurrence 8_EX:5886:11737: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0039; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5886
msgctxt "text_id=11737 | speaker=soujuurou"
msgid "「とまあ、蒼崎には乱暴なことしか期待できないとして、有珠はどうなんだ？　"
msgstr ""

#. Occurrence 8_EX:5898:11738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0040; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5898
msgctxt "text_id=11738 | speaker=soujuurou"
msgid "何も言わないということは、魔術でお金儲けは気に入らない？」"
msgstr ""

#. Occurrence 8_EX:5916:11739: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0018; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5916
msgctxt "text_id=11739 | speaker=alice"
msgid "「……そうね。好き嫌いはともかく、お金があるのはいいことだわ。協会の目をくぐりぬける事ができるなら、青子には頑張ってほしい」"
msgstr ""

#. Occurrence 8_EX:5953:11740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0065; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5953
msgctxt "text_id=11740 | speaker=aoko"
msgid "「危ない目に<遭|あ>うのは私だけかッ！？"
msgstr ""

#. Occurrence 8_EX:5959:11741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0066; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5959
msgctxt "text_id=11741 | speaker=aoko"
msgid "　有珠のプロイにはなんかないの？　<土|つち>食べたら<金|きん>に変換するようなカバとか!?"
msgstr ""

#. Occurrence 8_EX:5965:11742: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0067; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5965
msgctxt "text_id=11742 | speaker=aoko"
msgid "　ほら、中世の貴族はお抱えの錬金術師で、日夜<金|きん>を作り出す研究をしてたっていうじゃない!?」"
msgstr ""

#. Occurrence 8_EX:6004:11743: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0019; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6004
msgctxt "text_id=11743 | speaker=alice"
msgid "「<錬金術師|アレ>はただの金食い虫。"
msgstr ""

#. Occurrence 8_EX:6010:11744: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0020; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6010
msgctxt "text_id=11744 | speaker=alice"
msgid "　……まあ、騙した貴族たちの貯蓄を食いつぶして新しい技術を生み出したから、無意味ではなかったけど。"
msgstr ""

#. Occurrence 8_EX:6016:11745: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0021; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6016
msgctxt "text_id=11745 | speaker=alice"
msgid "　このマイセンも、元々は<金|きん>を作ると豪語した錬金術師が苦し紛れに産んだ磁器なワケだし」"
msgstr ""

#. Occurrence 8_EX:6021:11746: scene=8_EX
#: 8_EX:6021
msgctxt "text_id=11746 | speaker=unknown"
msgid "　有珠は手元のティーカップの縁を指でなぞる。"
msgstr ""

#. Occurrence 8_EX:6059:11747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0068; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6059
msgctxt "text_id=11747 | speaker=aoko"
msgid "「……はあ。錬金術師ほどアテにならない奴はいないってワケか。今じゃプラハの錬金術師は証券魔術師、エジプトの方は兵器作ってるって話だしね……」"
msgstr ""

#. Occurrence 8_EX:6089:11748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0022; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6089
msgctxt "text_id=11748 | speaker=alice"
msgid "「ええ。ちょっと期待してしまったけど、もともとわたしたちは現実社会と折り合いが悪いのよ。神秘に特化しすぎているから」"
msgstr ""

#. Occurrence 8_EX:6115:11749: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0023; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6115
msgctxt "text_id=11749 | speaker=alice"
msgid "「ロンドンの名門になると、家訓と事業は別物と割り切っていて、金融専門の弟子をとっているわ。"
msgstr ""

#. Occurrence 8_EX:6121:11750: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0024; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6121
msgctxt "text_id=11750 | speaker=alice"
msgid "　……噂だけど、ある財閥の総帥は社員全員の血を吸って、情報を共有するネットワークを作っているとか。"
msgstr ""

#. Occurrence 8_EX:6127:11751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0025; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6127
msgctxt "text_id=11751 | speaker=alice"
msgid "　なんでも吸血鬼になった理由が“精神的に繋がった、決して内部闘争しない商会を作りたいから”だったとか」"
msgstr ""

#. Occurrence 8_EX:6171:11752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0069; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6171
msgctxt "text_id=11752 | speaker=aoko"
msgid "「―――極まってるなあ。要は、そこまで徹底しないと魔術でお金儲けは難しいってコトかぁ。"
msgstr ""

#. Occurrence 8_EX:6182:11753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0070; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6182
msgctxt "text_id=11753 | speaker=aoko"
msgid "　あ、有珠のプロイで遊園地をやるのはどう？」"
msgstr ""

#. Occurrence 8_EX:6201:11754: scene=8_EX
#: 8_EX:6201
msgctxt "text_id=11754 | speaker=unknown"
msgid "　ポン、と手を叩く草十郎。"
msgstr ""

#. Occurrence 8_EX:6207:11755: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0041; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6207
msgctxt "text_id=11755 | speaker=soujuurou"
msgid "「それはいい。襲われるのはもうこりごりだけど、あの遊園地なら連日連夜大盛況だ」"
msgstr ""

#. Occurrence 8_EX:6235:11756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0026; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6235
msgctxt "text_id=11756 | speaker=alice"
msgid "「わたしのプロイを見せ物にする気？」"
msgstr ""

#. Occurrence 8_EX:6258:11757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0071; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6258
msgctxt "text_id=11757 | speaker=aoko"
msgid "「でも大ウケよ、絶対。ロボットって言い張ればみんな騙されるし」"
msgstr ""

#. Occurrence 8_EX:6297:11758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0027; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6297
msgctxt "text_id=11758 | speaker=alice"
msgid "「却下よ青子。この話、もう一度したら絶交だから」"
msgstr ""

#. Occurrence 8_EX:6308:11759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0072; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6308
msgctxt "text_id=11759 | speaker=aoko"
msgid "「う、本気で怒らせたか。だってさ草十郎、遊園地はあきらめましょ。今度こそ友情を失っちゃうし」"
msgstr ""

#. Occurrence 8_EX:6341:11760: scene=8_EX
#: 8_EX:6341
msgctxt "text_id=11760 | speaker=unknown"
msgid "　冷たく拒絶する有珠と、やれやれと引き下がる青子。"
msgstr ""

#. Occurrence 8_EX:6346:11761: scene=8_EX
#: 8_EX:6346
msgctxt "text_id=11761 | speaker=unknown"
msgid "　雑談をしつつも、少女たちは互いの距離感、踏みこんではいけない線を心得ていた。"
msgstr ""

#. Occurrence 8_EX:6363:11762: scene=8_EX
#: 8_EX:6363
msgctxt "text_id=11762 | speaker=unknown"
msgid "　草十郎はそんなふたりを不思議そうに見つめている。"
msgstr ""

#. Occurrence 8_EX:6389:11763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0042; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6389
msgctxt "text_id=11763 | speaker=soujuurou"
msgid "「ちょっといいかな。いま、猛烈に気になったんだが」"
msgstr ""

#. Occurrence 8_EX:6406:11764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0073; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6406
msgctxt "text_id=11764 | speaker=aoko"
msgid "「なに？」"
msgstr ""

#. Occurrence 8_EX:6424:11765: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0043; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6424
msgctxt "text_id=11765 | speaker=soujuurou"
msgid "「いや。蒼崎も有珠も、遊園地で本気で殺し合っただろ。"
msgstr ""

#. Occurrence 8_EX:6430:11766: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0044; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6430
msgctxt "text_id=11766 | speaker=soujuurou"
msgid "　それなのに、まだ友達だったのか？」"
msgstr ""

#. Occurrence 8_EX:6491:11767: scene=8_EX
#: 8_EX:6491
msgctxt "text_id=11767 | speaker=unknown"
msgid "　失礼と言えば失礼、"
msgstr ""

#. Occurrence 8_EX:6496:11768: scene=8_EX
#: 8_EX:6496
msgctxt "text_id=11768 | speaker=unknown"
msgid "　当然と言えば当然の疑問に、青子たちは顔を見合わせる。"
msgstr ""

#. Occurrence 8_EX:6501:11769: scene=8_EX
#: 8_EX:6501
msgctxt "text_id=11769 | speaker=unknown"
msgid "　ふたりは二秒ほど見つめ合ったあと、"
msgstr ""

#. Occurrence 8_EX:6552:11770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0074; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6552
msgctxt "text_id=11770 | speaker=aoko"
msgid "「んー、ギリギリあり？」"
msgstr ""

#. Occurrence 8_EX:6563:11771: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0028; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6563
msgctxt "text_id=11771 | speaker=alice"
msgid "「まあ、ギリギリ」"
msgstr ""

#. Occurrence 8_EX:6583:11772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0045; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6583
msgctxt "text_id=11772 | speaker=soujuurou"
msgid "「ありなんだ！」"
msgstr ""

#. Occurrence 8_EX:6589:11773: scene=8_EX
#: 8_EX:6589
msgctxt "text_id=11773 | speaker=unknown"
msgid "　あまりに軽く、"
msgstr ""

#. Occurrence 8_EX:6594:11774: scene=8_EX
#: 8_EX:6594
msgctxt "text_id=11774 | speaker=unknown"
msgid "　また鉄より堅い、驚愕の友情なのだった。"
msgstr ""

#. Occurrence 8_EX:6662:11775: scene=8_EX
#: 8_EX:6662
msgctxt "text_id=11775 | speaker=unknown"
msgid "　おもいのほか長く続いたお茶会は、草十郎の退席でお開きとなった。"
msgstr ""

#. Occurrence 8_EX:6667:11776: scene=8_EX
#: 8_EX:6667
msgctxt "text_id=11776 | speaker=unknown"
msgid "　草十郎としても名残惜しいが、アルバイトは休めない。"
msgstr ""

#. Occurrence 8_EX:6691:11777: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0075; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6691
msgctxt "text_id=11777 | speaker=aoko"
msgid "「二時間も話してたなんて珍しいわね。"
msgstr ""

#. Occurrence 8_EX:6691:11778: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0075; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6691
msgctxt "text_id=11778 | speaker=aoko"
msgid "　有珠もいつになく<饒舌|じょうぜつ>だったし」"
msgstr ""

#. Occurrence 8_EX:6700:11779: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0029; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6700
msgctxt "text_id=11779 | speaker=alice"
msgid "「成り行きよ。静希君があれこれ青子に質問して、貴女がそれをわたしにも向けてきただけ。"
msgstr ""

#. Occurrence 8_EX:6706:11780: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0030; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6706
msgctxt "text_id=11780 | speaker=alice"
msgid "　……本当。わたしたちが一日なにをしているのかなんて、聞いても仕方がないのに」"
msgstr ""

#. Occurrence 8_EX:6742:11781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0046; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6742
msgctxt "text_id=11781 | speaker=soujuurou"
msgid "「いや、それがそうでもない。たいへん役に立ちました」"
msgstr ""

#. Occurrence 8_EX:6760:11782: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0076; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6760
msgctxt "text_id=11782 | speaker=aoko"
msgid "「はい？」"
msgstr ""

#. Occurrence 8_EX:6780:11783: scene=8_EX
#: 8_EX:6780
msgctxt "text_id=11783 | speaker=unknown"
msgid "　驚く青子をよそに、草十郎は廊下から何やら運んでくる。"
msgstr ""

#. Occurrence 8_EX:6798:11784: scene=8_EX
#: 8_EX:6798
msgctxt "text_id=11784 | speaker=unknown"
msgid "　生徒会室にあるタイプの、大型のホワイトボード。"
msgstr ""

#. Occurrence 8_EX:6803:11785: scene=8_EX
#: 8_EX:6803
msgctxt "text_id=11785 | speaker=unknown"
msgid "　真新しいボードには油性ペンで、以下の内容が書かれていた。"
msgstr ""

#. Occurrence 8_EX:6823:11786: scene=8_EX
#: 8_EX:6823
msgctxt "text_id=11786 | speaker=unknown"
msgid "　～これからの役割分担表～"
msgstr ""

#. Occurrence 8_EX:6829:11787: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11787 | speaker=unknown"
msgid "　　　　・館内清掃（一階東館にかぎる）"
msgstr ""

#. Occurrence 8_EX:6829:11788: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11788 | speaker=unknown"
msgid "　　　　・朝食当番"
msgstr ""

#. Occurrence 8_EX:6829:11789: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11789 | speaker=unknown"
msgid "　　　　・夕食当番"
msgstr ""

#. Occurrence 8_EX:6829:11790: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11790 | speaker=unknown"
msgid "　　　　・風呂当番"
msgstr ""

#. Occurrence 8_EX:6860:11791: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0077; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6860
msgctxt "text_id=11791 | speaker=aoko"
msgid "「な―――なんか色々と詮索してくると思ったら、そういう裏があったワケ……!?」"
msgstr ""

#. Occurrence 8_EX:6884:11792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0047; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6884
msgctxt "text_id=11792 | speaker=soujuurou"
msgid "「うん。歪みを正したかったら、まずどこがおかしいのか知らないといけないからね。"
msgstr ""

#. Occurrence 8_EX:6890:11793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0048; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6890
msgctxt "text_id=11793 | speaker=soujuurou"
msgid "　今夜の話じゃ、ふたりとも一日に一時間ぐらいは使える時間があるみたいだし。三人で一つの台所を使っているんだから、ローテーションを組んだ方がいいだろ。協力できるところは協力しないと」"
msgstr ""

#. Occurrence 8_EX:6896:11794: scene=8_EX
#: 8_EX:6896
msgctxt "text_id=11794 | speaker=unknown"
msgid "　たいしつかいぜんだ、と胸を張る草十郎。"
msgstr ""

#. Occurrence 8_EX:6937:11795: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0031; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6937
msgctxt "text_id=11795 | speaker=alice"
msgid "「待って。わたしは貴方を住まわせているだけで、協力なんてする気はないって言ったでしょう」"
msgstr ""

#. Occurrence 8_EX:6961:11796: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0049; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6961
msgctxt "text_id=11796 | speaker=soujuurou"
msgid "「うん、言ったね。"
msgstr ""

#. Occurrence 8_EX:6961:11797: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0049; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6961
msgctxt "text_id=11797 | speaker=soujuurou"
msgid "　でも“夕食を用意するならわたしの分もお願い”と言いたいのなら、<相互扶助|そうごふじょ>は当然の義務だと思うんだ。"
msgstr ""

#. Occurrence 8_EX:6973:11798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0050; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6973
msgctxt "text_id=11798 | speaker=soujuurou"
msgid "　あと、三人で食費を集めれば、その分美味しいものが食べられるよ」"
msgstr ""

#. Occurrence 8_EX:7012:11799: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0032; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7012
msgctxt "text_id=11799 | speaker=alice"
msgid "「こ」"
msgstr ""

#. Occurrence 8_EX:7018:11800: scene=8_EX
#: 8_EX:7018
msgctxt "text_id=11800 | speaker=unknown"
msgid "　今まで何度か“わたしの分もお願い”をやってしまった有珠にとって、草十郎の言葉はまさに神の鉄槌。"
msgstr ""

#. Occurrence 8_EX:7023:11801: scene=8_EX
#: 8_EX:7023
msgctxt "text_id=11801 | speaker=unknown"
msgid "　神罰に等しい、汝の罪を悔い改めよ系の攻撃だった。"
msgstr ""

#. Occurrence 8_EX:7061:11802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0078; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7061
msgctxt "text_id=11802 | speaker=aoko"
msgid "「で、でもホワイトボードを用意するコトはないんじゃない？　当番なんて、今まで口約束で決めてきたんだし……」"
msgstr ""

#. Occurrence 8_EX:7085:11803: scene=8_EX
#: 8_EX:7085
msgctxt "text_id=11803 | speaker=unknown"
msgid "　うんうん、と頷く有珠。"
msgstr ""

#. Occurrence 8_EX:7090:11804: scene=8_EX
#: 8_EX:7090
msgctxt "text_id=11804 | speaker=unknown"
msgid "　口約束ほどアテに出来ないものはない。"
msgstr ""

#. Occurrence 8_EX:7095:11805: scene=8_EX
#: 8_EX:7095
msgctxt "text_id=11805 | speaker=unknown"
msgid "　ふたりとも口にはしないものの、イザとなったらさぼる気満々の顔である。"
msgstr ""

#. Occurrence 8_EX:7133:11806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0051; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:7133
msgctxt "text_id=11806 | speaker=soujuurou"
msgid "「ダメだ。正しい生活を送るには、正しい役割を把握しないと。こういう風に書いておけば、後になっても忘れないだろ？」"
msgstr ""

#. Occurrence 8_EX:7156:11807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0079; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7156
msgctxt "text_id=11807 | speaker=aoko"
msgid "「うっ―――」"
msgstr ""

#. Occurrence 8_EX:7176:11808: scene=8_EX
#: 8_EX:7176
msgctxt "text_id=11808 | speaker=unknown"
msgid "　底の見えない笑顔にたじろぐ青子。"
msgstr ""

#. Occurrence 8_EX:7181:11809: scene=8_EX
#: 8_EX:7181
msgctxt "text_id=11809 | speaker=unknown"
msgid "　親切心で言っているのか、今から“サボらせないぞ”と<釘|くぎ>をさしているのか、まったく読めない。"
msgstr ""

#. Occurrence 8_EX:7220:11810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0033; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7220
msgctxt "text_id=11810 | speaker=alice"
msgid "「……なんてこと。証明文を書かせて、責任の所在を明らかにしようだなんて……」"
msgstr ""

#. Occurrence 8_EX:7226:11811: scene=8_EX
#: 8_EX:7226
msgctxt "text_id=11811 | speaker=unknown"
msgid "　有珠は有珠で、これから日常になるっぽい当番制に<戦慄|せんりつ>していた。"
msgstr ""

#. Occurrence 8_EX:7259:11812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0052; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:7259
msgctxt "text_id=11812 | speaker=soujuurou"
msgid "「決まりだな。誰がどこを担当するかは、また明日話しあおう。今のふたりがたいへんなのは分かってるから、しばらくの間はこっちが多目に受け持つよ」"
msgstr ""

#. Occurrence 8_EX:7271:11813: scene=8_EX
#: 8_EX:7271
msgctxt "text_id=11813 | speaker=unknown"
msgid "　それじゃ、と草十郎は去っていった。"
msgstr ""

#. Occurrence 8_EX:7276:11814: scene=8_EX
#: 8_EX:7276
msgctxt "text_id=11814 | speaker=unknown"
msgid "　残されたふたりはやるせなく、新品のホワイトボードを見つめている。"
msgstr ""

#. Occurrence 8_EX:7316:11815: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0034; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7316
msgctxt "text_id=11815 | speaker=alice"
msgid "「……こういうのを、飼い犬に手を噛まれる、というのかしら。わりと<小癪|こしゃく>な性格をしていたのね、彼」"
msgstr ""

#. Occurrence 8_EX:7327:11816: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0080; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7327
msgctxt "text_id=11816 | speaker=aoko"
msgid "「知ってた。私、アイツがそういうヤツって知ってたわ」"
msgstr ""

#. Occurrence 8_EX:7347:11817: scene=8_EX
#: 8_EX:7347
msgctxt "text_id=11817 | speaker=unknown"
msgid "　<罠|わな>にかかったと気付いても後の祭り。"
msgstr ""

#. Occurrence 8_EX:7352:11818: scene=8_EX
#: 8_EX:7352
msgctxt "text_id=11818 | speaker=unknown"
msgid "　そもそも今日の青子の朝食も、草十郎が調理したサラダを分けて貰ったものである。"
msgstr ""

#. Occurrence 8_EX:7357:11819: scene=8_EX
#: 8_EX:7357
msgctxt "text_id=11819 | speaker=unknown"
msgid "　今から“じゃあこれから助け合いはなし”と言うには、助け合いの味をしめてしまった。"
msgstr ""

#. Occurrence 8_EX:7377:11820: scene=8_EX
#: 8_EX:7377
msgctxt "text_id=11820 | speaker=unknown"
msgid "　そもそも当番制は青子の合理性に合っている。"
msgstr ""

#. Occurrence 8_EX:7382:11821: scene=8_EX
#: 8_EX:7382
msgctxt "text_id=11821 | speaker=unknown"
msgid "　ただ、できれば作業の割合を、たまにでいいから誤魔化したかっただけなのだ。"
msgstr ""

#. Occurrence 8_EX:7408:11822: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0035; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7408
msgctxt "text_id=11822 | speaker=alice"
msgid "「……青子。貴女、なにを考えているか丸わかりよ」"
msgstr ""

#. Occurrence 8_EX:7419:11823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0081; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7419
msgctxt "text_id=11823 | speaker=aoko"
msgid "「そうでしょうとも。"
msgstr ""

#. Occurrence 8_EX:7419:11824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0081; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7419
msgctxt "text_id=11824 | speaker=aoko"
msgid "　間違いなく同じコトを考えてたからね、私たち」"
msgstr ""

#. Occurrence 8_EX:7439:11825: scene=8_EX
#: 8_EX:7439
msgctxt "text_id=11825 | speaker=unknown"
msgid "　ため息まじりの返答をして、青子はホワイトボードを手に取った。全員共通の持ち物として、台所の壁に立てかける気らしい。"
msgstr ""

#. Occurrence 8_EX:7469:11826: scene=8_EX
#: 8_EX:7469
msgctxt "text_id=11826 | speaker=unknown"
msgid "　有珠はじっとホワイトボードを見ながら、"
msgstr ""

#. Occurrence 8_EX:7481:11827: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0036; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7481
msgctxt "text_id=11827 | speaker=alice"
msgid "「……せめて、新しい項目が増えなければいいけど」"
msgstr ""

#. Occurrence 8_EX:7487:11828: scene=8_EX
#: 8_EX:7487
msgctxt "text_id=11828 | speaker=unknown"
msgid "　なんて、世にも不吉な言葉を口にした。"
msgstr ""

#. Occurrence 8DOT5:38:11829: scene=8DOT5
#: 8DOT5:38
msgctxt "text_id=11829 | speaker=unknown"
msgid "　いかに多忙と言え、人間として暮らしている以上、ある程度の余分は生まれてくる。"
msgstr ""

#. Occurrence 8DOT5:56:11830: scene=8DOT5
#: 8DOT5:56
msgctxt "text_id=11830 | speaker=unknown"
msgid "　たとえば食事の前後。"
msgstr ""

#. Occurrence 8DOT5:61:11831: scene=8DOT5
#: 8DOT5:61
msgctxt "text_id=11831 | speaker=unknown"
msgid "　調理の手間と食後の<一服|ひととき>は無くす方が難しい。"
msgstr ""

#. Occurrence 8DOT5:66:11832: scene=8DOT5
#: 8DOT5:66
msgctxt "text_id=11832 | speaker=unknown"
msgid "　頭脳労働者の場合、特に顕著である。"
msgstr ""

#. Occurrence 8DOT5:71:11833: scene=8DOT5
#: 8DOT5:71
msgctxt "text_id=11833 | speaker=unknown"
msgid "　食後、体は消化にエネルギーを使うため、肝心の頭にまで血が回らない。なので、"
msgstr ""

#. Occurrence 8DOT5:105:11834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:105
msgctxt "text_id=11834 | speaker=aoko"
msgid "「ナイキはあれでしょ、ニケーのもじりでしょ？"
msgstr ""

#. Occurrence 8DOT5:105:11835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:105
msgctxt "text_id=11835 | speaker=aoko"
msgid "　アテナの持ってる、盾じゃなくて小さな勝利の女神の方。陸上競技に勝つってイメージじゃない？」"
msgstr ""

#. Occurrence 8DOT5:112:11836: voice_id=BA0_8DOT5_0000; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:112
msgctxt "text_id=11836 | speaker=unknown"
msgid "『さすがブランド品とか大好きな青子さん、どうでもいい知識だけはそれなりッスね！』"
msgstr ""

#. Occurrence 8DOT5:118:11837: scene=8DOT5
#: 8DOT5:118
msgctxt "text_id=11837 | speaker=unknown"
msgid "　洋館における頭脳労働者は、だらけきった姿勢でソファーに体を<預|あず>けているのだった。"
msgstr ""

#. Occurrence 8DOT5:155:11838: scene=8DOT5
#: 8DOT5:155
msgctxt "text_id=11838 | speaker=unknown"
msgid "　青子の話し相手はテーブルの上にいる駒鳥だ。"
msgstr ""

#. Occurrence 8DOT5:160:11839: scene=8DOT5
#: 8DOT5:160
msgctxt "text_id=11839 | speaker=unknown"
msgid "　青い鳥はパタパタと羽を鳴らしながら、食後の団らんの真似事なぞ<勤|いそ>しんでいる。"
msgstr ""

#. Occurrence 8DOT5:199:11840: scene=8DOT5
#: 8DOT5:199
msgctxt "text_id=11840 | speaker=unknown"
msgid "　有珠はサンルームで読書中。"
msgstr ""

#. Occurrence 8DOT5:204:11841: scene=8DOT5
#: 8DOT5:204
msgctxt "text_id=11841 | speaker=unknown"
msgid "　外部からやってきた敵魔術師への対策は、あと三十分ほど休んでからの話となる。"
msgstr ""

#. Occurrence 8DOT5:247:11842: voice_id=BA0_8DOT5_0001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:247
msgctxt "text_id=11842 | speaker=unknown"
msgid "『んじゃアディダスは？"
msgstr ""

#. Occurrence 8DOT5:247:11843: voice_id=BA0_8DOT5_0001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:247
msgctxt "text_id=11843 | speaker=unknown"
msgid "　もしかしてアディオスのもじりっスか？』"
msgstr ""

#. Occurrence 8DOT5:267:11844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0001; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:267
msgctxt "text_id=11844 | speaker=aoko"
msgid "「あれは普通に名前じゃなかったっけ？"
msgstr ""

#. Occurrence 8DOT5:273:11845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0002; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:273
msgctxt "text_id=11845 | speaker=aoko"
msgid "　ほら、グリム童話みたいに、作った兄弟の名前がそのままブランド名になっちゃったのよ」"
msgstr ""

#. Occurrence 8DOT5:309:11846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0000; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:309
msgctxt "text_id=11846 | speaker=alice"
msgid "「ブラザーグリムは童話を作った訳じゃないわ。"
msgstr ""

#. Occurrence 8DOT5:315:11847: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0001; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:315
msgctxt "text_id=11847 | speaker=alice"
msgid "　埋もれていた口伝を<蒐集|しゅうしゅう>して、物語に仕立て直して、丁寧に<編纂|へんさん>した人たちよ。職人というより学者の<類|たぐい>ね。"
msgstr ""

#. Occurrence 8DOT5:321:11848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0002; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:321
msgctxt "text_id=11848 | speaker=alice"
msgid "　……まあ、多少は詐欺師めいたところもあるけれど」"
msgstr ""

#. Occurrence 8DOT5:356:11849: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0003; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:356
msgctxt "text_id=11849 | speaker=aoko"
msgid "「へー。じゃあアンデルセンは？　人魚姫とか親指姫とか超メジャーだけど。ああ、あとみにくいアヒルの子」"
msgstr ""

#. Occurrence 8DOT5:362:11850: voice_id=BA0_8DOT5_0002; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:362
msgctxt "text_id=11850 | speaker=unknown"
msgid "『ジブン、裸の王様とかたまんないッス。シンパシー感じるッスよ、あの<透けてる|クリスタル>キングに』"
msgstr ""

#. Occurrence 8DOT5:396:11851: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0003; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:396
msgctxt "text_id=11851 | speaker=alice"
msgid "「アンデルセンは学者というより作家でしょうね。"
msgstr ""

#. Occurrence 8DOT5:402:11852: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0004; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:402
msgctxt "text_id=11852 | speaker=alice"
msgid "　彼の創作意欲は裕福層や大衆、平凡な幸福を得ている人々、はては女性像への<憤|いきどお>りから生まれたものだと言われているし。知的好奇心から筆をとったのではなく、感情を訴えるために筆をとった人」"
msgstr ""

#. Occurrence 8DOT5:428:11853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0005; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:428
msgctxt "text_id=11853 | speaker=alice"
msgid "「……あまり、こういう説明はしたくないのだけれど。"
msgstr ""

#. Occurrence 8DOT5:434:11854: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0006; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:434
msgctxt "text_id=11854 | speaker=alice"
msgid "　それぞれ分けて説明するなら、マザーグースは歌、ブラザーグリムは物語。アンデルセンは寓話ね」"
msgstr ""

#. Occurrence 8DOT5:464:11855: voice_id=BA0_8DOT5_0003_A; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:464
msgctxt "text_id=11855 | speaker=unknown"
msgid "『みつばちマッチはアニメっすね。"
msgstr ""

#. Occurrence 8DOT5:470:11856: voice_id=BA0_8DOT5_0004_A; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:470
msgctxt "text_id=11856 | speaker=unknown"
msgid "　ところで青子さん、アシックスの由来はなんスか』"
msgstr ""

#. Occurrence 8DOT5:506:11857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0004; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:506
msgctxt "text_id=11857 | speaker=aoko"
msgid "「え？　うーん、これは私も小学校の頃、友達に聞いたものなんで真偽は分からないんだけど。"
msgstr ""

#. Occurrence 8DOT5:512:11858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0005; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:512
msgctxt "text_id=11858 | speaker=aoko"
msgid "　アシックスって、もともと三つの会社が合併して出来た会社なのよ。で、三社の社長があつまると足が六本になるじゃない？　だから<足|アシ>、シックス　あくまで俗説だけどね」"
msgstr ""

#. Occurrence 8DOT5:547:11859: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0007; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:547
msgctxt "text_id=11859 | speaker=alice"
msgid "「っ―――――――」"
msgstr ""

#. Occurrence 8DOT5:552:11860: scene=8DOT5
#: 8DOT5:552
msgctxt "text_id=11860 | speaker=unknown"
msgid "　サンルームでは本を床に落とし、きゅっと唇を噛んでいる有珠の姿。"
msgstr ""

#. Occurrence 8DOT5:557:11861: scene=8DOT5
#: 8DOT5:557
msgctxt "text_id=11861 | speaker=unknown"
msgid "　彼女は努めて冷静に、何事もなかったように呼吸を整えている。"
msgstr ""

#. Occurrence 8DOT5:562:11862: scene=8DOT5
#: 8DOT5:562
msgctxt "text_id=11862 | speaker=unknown"
msgid "　少なくとも、本人はそう演じきれていると信じている。"
msgstr ""

#. Occurrence 8DOT5:593:11863: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0006; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:593
msgctxt "text_id=11863 | speaker=aoko"
msgid "「……あの子の笑いのツボも分かんないわね……」"
msgstr ""

#. Occurrence 8DOT5:636:11864: voice_id=BA0_8DOT5_9000; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:636
msgctxt "text_id=11864 | speaker=unknown"
msgid "『それはどうっスかね。あんまりにもつまんなかったから怒ってるのかもしれないっス。"
msgstr ""

#. Occurrence 8DOT5:658:11865: voice_id=BA0_8DOT5_9001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:658
msgctxt "text_id=11865 | speaker=unknown"
msgid "だってアリスさん、怒り心頭しても笑顔になるんスよ。ジブンたまに見るッス。アリスさんの日記を盗み見てると、後ろでそういう顔してるッス。"
msgstr ""

#. Occurrence 8DOT5:668:11866: voice_id=BA0_8DOT5_9002; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:668
msgctxt "text_id=11866 | speaker=unknown"
msgid "それ以上見ると死ぬわよって。でもカンベンしてほしいッス、見ちゃうものは見ちゃうっスよー！　ジブンから素行調査をとったら、もう帰巣本能しか残らない気もするッス』"
msgstr ""

#. Occurrence 8DOT5:702:11867: scene=8DOT5
#: 8DOT5:702
msgctxt "text_id=11867 | speaker=unknown"
msgid "　ぱたぱたと異論をはさむ駒鳥。"
msgstr ""

#. Occurrence 8DOT5:707:11868: scene=8DOT5
#: 8DOT5:707
msgctxt "text_id=11868 | speaker=unknown"
msgid "　青子はため息をつきながら、有珠も厄介な使い魔を押しつけられたもんね、と同情した。"
msgstr ""

#. Occurrence 8DOT5:734:11869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0000; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:734
msgctxt "text_id=11869 | speaker=soujuurou"
msgid "「ただいま。お、今日はふたりともいるんだな」"
msgstr ""

#. Occurrence 8DOT5:740:11870: scene=8DOT5
#: 8DOT5:740
msgctxt "text_id=11870 | speaker=unknown"
msgid "　そんな中、草十郎が顔を見せた。"
msgstr ""

#. Occurrence 8DOT5:745:11871: scene=8DOT5
#: 8DOT5:745
msgctxt "text_id=11871 | speaker=unknown"
msgid "　アルバイトから帰ってきたところらしい。"
msgstr ""

#. Occurrence 8DOT5:779:11872: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0007; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:779
msgctxt "text_id=11872 | speaker=aoko"
msgid "「おかえりー。お疲れさまー」"
msgstr ""

#. Occurrence 8DOT5:785:11873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0008; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:785
msgctxt "text_id=11873 | speaker=alice"
msgid "「……………」"
msgstr ""

#. Occurrence 8DOT5:791:11874: scene=8DOT5
#: 8DOT5:791
msgctxt "text_id=11874 | speaker=unknown"
msgid "　駒鳥の話し相手で<緩|ゆる>みきった青子の出迎えと、サンルームからのかすかな反応。"
msgstr ""

#. Occurrence 8DOT5:820:11875: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0001; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:820
msgctxt "text_id=11875 | speaker=soujuurou"
msgid "「夕食は済ませてきたから要らないよ。"
msgstr ""

#. Occurrence 8DOT5:826:11876: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0002; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:826
msgctxt "text_id=11876 | speaker=soujuurou"
msgid "　じゃ、夜のバイトにそなえてちょっと寝てくる」"
msgstr ""

#. Occurrence 8DOT5:836:11877: scene=8DOT5
#: 8DOT5:836
msgctxt "text_id=11877 | speaker=unknown"
msgid "　草十郎はサンルームの有珠にも手を振って立ち去った。"
msgstr ""

#. Occurrence 8DOT5:842:11878: scene=8DOT5
#: 8DOT5:842
msgctxt "text_id=11878 | speaker=unknown"
msgid "　廊下に消える直前、不審な物音を立てながら。"
msgstr ""

#. Occurrence 8DOT5:876:11879: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0008; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:876
msgctxt "text_id=11879 | speaker=aoko"
msgid "「おーい、なんか落ちたわよー」"
msgstr ""

#. Occurrence 8DOT5:882:11880: scene=8DOT5
#: 8DOT5:882
msgctxt "text_id=11880 | speaker=unknown"
msgid "　青子はソファーから顔だけ出して草十郎を呼び止めた。"
msgstr ""

#. Occurrence 8DOT5:920:11881: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0003; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:920
msgctxt "text_id=11881 | speaker=soujuurou"
msgid "「ああ、ポケットに入れっぱなしだった」"
msgstr ""

#. Occurrence 8DOT5:926:11882: scene=8DOT5
#: 8DOT5:926
msgctxt "text_id=11882 | speaker=unknown"
msgid "　草十郎は慌てた風もなく、ごく自然に戻ってきて、床に落ちた何か―――封筒のようなもの―――に手を伸ばす。"
msgstr ""

#. Occurrence 8DOT5:943:11883: scene=8DOT5
#: 8DOT5:943
msgctxt "text_id=11883 | speaker=unknown"
msgid "　人間の<性|さが>だろう。"
msgstr ""

#. Occurrence 8DOT5:948:11884: scene=8DOT5
#: 8DOT5:948
msgctxt "text_id=11884 | speaker=unknown"
msgid "　興味はなくとも動くものは<野次馬|やじうま>根性で追ってしまう。"
msgstr ""

#. Occurrence 8DOT5:953:11885: scene=8DOT5
#: 8DOT5:953
msgctxt "text_id=11885 | speaker=unknown"
msgid "　青子はどれどれ、と草十郎の手を目で追って―――"
msgstr ""

#. Occurrence 8DOT5:1001:11886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0009; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1001
msgctxt "text_id=11886 | speaker=aoko"
msgid "「さ―――！」"
msgstr ""

#. Occurrence 8DOT5:1007:11887: scene=8DOT5
#: 8DOT5:1007
msgctxt "text_id=11887 | speaker=unknown"
msgid "“札束、だっ！”"
msgstr ""

#. Occurrence 8DOT5:1012:11888: scene=8DOT5
#: 8DOT5:1012
msgctxt "text_id=11888 | speaker=unknown"
msgid "　などと、はしたない心の叫びを抑えつつ、青子はソファーから跳ね上がった。"
msgstr ""

#. Occurrence 8DOT5:1043:11889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0004; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1043
msgctxt "text_id=11889 | speaker=soujuurou"
msgid "「？　どうした蒼崎？」"
msgstr ""

#. Occurrence 8DOT5:1061:11890: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0010; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1061
msgctxt "text_id=11890 | speaker=aoko"
msgid "「え、どうしたって、その……」"
msgstr ""

#. Occurrence 8DOT5:1067:11891: scene=8DOT5
#: 8DOT5:1067
msgctxt "text_id=11891 | speaker=unknown"
msgid "　<汚|けが>れのない純朴な目で見つめられては、さすがの青子も言い返せない。"
msgstr ""

#. Occurrence 8DOT5:1072:11892: scene=8DOT5
#: 8DOT5:1072
msgctxt "text_id=11892 | speaker=unknown"
msgid "　相乗効果的に、お金を見て飛び上がった自分のがめつさに頭を抱えたくなるほどだ。"
msgstr ""

#. Occurrence 8DOT5:1098:11893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0011; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1098
msgctxt "text_id=11893 | speaker=aoko"
msgid "「な、なんでもないっ！"
msgstr ""

#. Occurrence 8DOT5:1104:11894: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0012; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1104
msgctxt "text_id=11894 | speaker=aoko"
msgid "　そうよね、フツーにアルバイトの給料日よね。……にしても、けっこうもらってんのね、アンタ」"
msgstr ""

#. Occurrence 8DOT5:1145:11895: scene=8DOT5
#: 8DOT5:1145
msgctxt "text_id=11895 | speaker=unknown"
msgid "　納得する青子に妙な間で笑顔を返して、草十郎は自室へ戻っていった。"
msgstr ""

#. Occurrence 8DOT5:1176:11896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0013; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1176
msgctxt "text_id=11896 | speaker=aoko"
msgid "「？」"
msgstr ""

#. Occurrence 8DOT5:1187:11897: scene=8DOT5
#: 8DOT5:1187
msgctxt "text_id=11897 | speaker=unknown"
msgid "　微妙に引っかかるものを感じながら、青子もソファーに腰を下ろす。"
msgstr ""

#. Occurrence 8DOT5:1205:11898: scene=8DOT5
#: 8DOT5:1205
msgctxt "text_id=11898 | speaker=unknown"
msgid "　―――以上が事の発端。"
msgstr ""

#. Occurrence 8DOT5:1211:11899: scene=8DOT5
#: 8DOT5:1211
msgctxt "text_id=11899 | speaker=unknown"
msgid "　のちにカーモネーギー事件と駒鳥が名付けた、ありふれた<騒動|いちにち>の始まりだった。"
msgstr ""

#. Occurrence 8DOT5:1298:11900: scene=8DOT5
#: 8DOT5:1298
msgctxt "text_id=11900 | speaker=unknown"
msgid "　翌日、昨日の一件とほぼ同じ時間。"
msgstr ""

#. Occurrence 8DOT5:1314:11901: scene=8DOT5
#: 8DOT5:1314
msgctxt "text_id=11901 | speaker=unknown"
msgid "　青子が息抜きをかねて紅茶を淹れに来ると、居間では草十郎と駒鳥が何やら議論を交わしていた。"
msgstr ""

#. Occurrence 8DOT5:1348:11902: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0005; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1348
msgctxt "text_id=11902 | speaker=soujuurou"
msgid "「その人が言うには、人と会うたびに小さな親切を尽くしてあげるべきだ、と。そうして一日が終わったら、その親切が何をもたらしたか、よくかみしめなさいって。"
msgstr ""

#. Occurrence 8DOT5:1359:11903: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0006; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1359
msgctxt "text_id=11903 | speaker=soujuurou"
msgid "　たった一回の言葉だけの親切でも、相手にとっては大きな意味があるんだそうだ。それが思いも寄らない幸福を運んでくる」"
msgstr ""

#. Occurrence 8DOT5:1404:11904: voice_id=BA0_8DOT5_0006; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1404
msgctxt "text_id=11904 | speaker=unknown"
msgid "『うはっ、だからジブンにビーフジャーキーくれたっスか！"
msgstr ""

#. Occurrence 8DOT5:1410:11905: voice_id=BA0_8DOT5_0007; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1410
msgctxt "text_id=11905 | speaker=unknown"
msgid "　でもそれ、親切じゃなくてソデノシタって言う伝統芸能じゃないっスかね？　アンダーハート見え見えッス』"
msgstr ""

#. Occurrence 8DOT5:1430:11906: scene=8DOT5
#: 8DOT5:1430
msgctxt "text_id=11906 | speaker=unknown"
msgid "　草十郎の真剣さは、雑談というより相談・勧誘の<類|たぐい>に見える。"
msgstr ""

#. Occurrence 8DOT5:1452:11907: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0014; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1452
msgctxt "text_id=11907 | speaker=aoko"
msgid "「……まあ、アイツが妙なのはいつものコトか……」"
msgstr ""

#. Occurrence 8DOT5:1457:11908: scene=8DOT5
#: 8DOT5:1457
msgctxt "text_id=11908 | speaker=unknown"
msgid "　青子は居間の様子をスルーしてサンルームに入る。"
msgstr ""

#. Occurrence 8DOT5:1462:11909: scene=8DOT5
#: 8DOT5:1462
msgctxt "text_id=11909 | speaker=unknown"
msgid "　……と、椅子には草十郎のコートがかけられていた。"
msgstr ""

#. Occurrence 8DOT5:1486:11910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0015; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1486
msgctxt "text_id=11910 | speaker=aoko"
msgid "「ちょっと草十郎、コート置きっぱなしじゃない。"
msgstr ""

#. Occurrence 8DOT5:1492:11911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0016; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1492
msgctxt "text_id=11911 | speaker=aoko"
msgid "　居間のコート掛けか、自分の部屋に持っていって―――」"
msgstr ""

#. Occurrence 8DOT5:1498:11912: scene=8DOT5
#: 8DOT5:1498
msgctxt "text_id=11912 | speaker=unknown"
msgid "　いいかけて、言葉を飲む。"
msgstr ""

#. Occurrence 8DOT5:1549:11913: scene=8DOT5
#: 8DOT5:1549
msgctxt "text_id=11913 | speaker=unknown"
msgid "　草十郎のコートのポケットから、昨日と同じような封筒が顔を覗かせていた。"
msgstr ""

#. Occurrence 8DOT5:1554:11914: scene=8DOT5
#: 8DOT5:1554
msgctxt "text_id=11914 | speaker=unknown"
msgid "　それも昨日よりいくぶん厚く、あまりにも無造作に。"
msgstr ""

#. Occurrence 8DOT5:1580:11915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0017; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1580
msgctxt "text_id=11915 | speaker=aoko"
msgid "「ふ、ふーん」"
msgstr ""

#. Occurrence 8DOT5:1585:11916: scene=8DOT5
#: 8DOT5:1585
msgctxt "text_id=11916 | speaker=unknown"
msgid "　昨日のような、大金に目を輝かす愚は犯せない。"
msgstr ""

#. Occurrence 8DOT5:1590:11917: scene=8DOT5
#: 8DOT5:1590
msgctxt "text_id=11917 | speaker=unknown"
msgid "　青子とて学園の模範生たる生徒会長の自覚はあるのだ。"
msgstr ""

#. Occurrence 8DOT5:1616:11918: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0018; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1616
msgctxt "text_id=11918 | speaker=aoko"
msgid "「さ、さーて、紅茶紅茶っと」"
msgstr ""

#. Occurrence 8DOT5:1622:11919: scene=8DOT5
#: 8DOT5:1622
msgctxt "text_id=11919 | speaker=unknown"
msgid "　無関心を装いつつ、居間の会話に聞き耳を立てる。"
msgstr ""

#. Occurrence 8DOT5:1627:11920: scene=8DOT5
#: 8DOT5:1627
msgctxt "text_id=11920 | speaker=unknown"
msgid "　青子の呼びかけが聞こえなかったのか、草十郎は駒鳥との雑談に夢中だった。"
msgstr ""

#. Occurrence 8DOT5:1660:11921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0007; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1660
msgctxt "text_id=11921 | speaker=soujuurou"
msgid "「都会の孤独は万人に平等だ。"
msgstr ""

#. Occurrence 8DOT5:1666:11922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0008; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1666
msgctxt "text_id=11922 | speaker=soujuurou"
msgid "　一見して身勝手な、暴力じみたお仕着せの善意も、長い目で見ればその人のためになる」"
msgstr ""

#. Occurrence 8DOT5:1685:11923: voice_id=BA0_8DOT5_0008; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1685
msgctxt "text_id=11923 | speaker=unknown"
msgid "『なるほどー。親切の押しつけには<一銭|いっせん>もかからないッスからね！　ジャンジャン人助けするッスよ』"
msgstr ""

#. Occurrence 8DOT5:1706:11924: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0009; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1706
msgctxt "text_id=11924 | speaker=soujuurou"
msgid "「うん。タダより高いものはないって言うけどね」"
msgstr ""

#. Occurrence 8DOT5:1727:11925: voice_id=BA0_8DOT5_0009; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1727
msgctxt "text_id=11925 | speaker=unknown"
msgid "『ハハハどっちっスかこのシャバ僧！』"
msgstr ""

#. Occurrence 8DOT5:1763:11926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0019; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1763
msgctxt "text_id=11926 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 8DOT5:1769:11927: scene=8DOT5
#: 8DOT5:1769
msgctxt "text_id=11927 | speaker=unknown"
msgid "　自分の用事……紅茶を淹れに来た……も忘れて、青子は居間からの声に耳をすませる。"
msgstr ""

#. Occurrence 8DOT5:1774:11928: scene=8DOT5
#: 8DOT5:1774
msgctxt "text_id=11928 | speaker=unknown"
msgid "　これはもう、無視できる<怪|あや>しさではない。"
msgstr ""

#. Occurrence 8DOT5:1809:11929: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0010; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1809
msgctxt "text_id=11929 | speaker=soujuurou"
msgid "「こうも言うんだ。幸福になりたければ、はじめは恨まれてもいいと。"
msgstr ""

#. Occurrence 8DOT5:1815:11930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0011; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1815
msgctxt "text_id=11930 | speaker=soujuurou"
msgid "　やれ金を返せだの詐欺師だのと言われても、いずれその人のためになると分かっていれば心を鬼にできる。"
msgstr ""

#. Occurrence 8DOT5:1822:11931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0012; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1822
msgctxt "text_id=11931 | speaker=soujuurou"
msgid "人に尽くしている喜びが、後ろめたさとか帳消しにするらしい」"
msgstr ""

#. Occurrence 8DOT5:1841:11932: voice_id=BA0_8DOT5_0010; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1841
msgctxt "text_id=11932 | speaker=unknown"
msgid "『それ知ってるッス。でも、微妙に違うような』"
msgstr ""

#. Occurrence 8DOT5:1876:11933: scene=8DOT5
#: 8DOT5:1876
msgctxt "text_id=11933 | speaker=unknown"
msgid "　不本意ではあるが、青子は駒鳥に同意する。"
msgstr ""

#. Occurrence 8DOT5:1881:11934: scene=8DOT5
#: 8DOT5:1881
msgctxt "text_id=11934 | speaker=unknown"
msgid "　今のは有名な事業家の言葉で、正しくは"
msgstr ""

#. Occurrence 8DOT5:1887:11935: scene=8DOT5
#: 8DOT5:1887
msgctxt "text_id=11935 | speaker=unknown"
msgid "“幸せになりたければ、誰が恩を返した、誰が恩を返さないなどと考えるのはやめて、人に貢献できる喜びを大切にしよう”"
msgstr ""

#. Occurrence 8DOT5:1893:11936: scene=8DOT5
#: 8DOT5:1893
msgctxt "text_id=11936 | speaker=unknown"
msgid "　だったはずだ。"
msgstr ""

#. Occurrence 8DOT5:1928:11937: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0013; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1928
msgctxt "text_id=11937 | speaker=soujuurou"
msgid "「あるいはこうとも。"
msgstr ""

#. Occurrence 8DOT5:1934:11938: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0014; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1934
msgctxt "text_id=11938 | speaker=soujuurou"
msgid "　貯金のある人は、その富を温存するよりも、会社がより豊かになるために使うべきだと」"
msgstr ""

#. Occurrence 8DOT5:1941:11939: voice_id=BA0_8DOT5_0011; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1941
msgctxt "text_id=11939 | speaker=unknown"
msgid "『それも知ってるッス。でも、もう完全に違うような』"
msgstr ""

#. Occurrence 8DOT5:1973:11940: scene=8DOT5
#: 8DOT5:1973
msgctxt "text_id=11940 | speaker=unknown"
msgid "　<甚|はなは>だ不本意ではあるが、またも青子は同意する。"
msgstr ""

#. Occurrence 8DOT5:1980:11941: scene=8DOT5
#: 8DOT5:1980
msgctxt "text_id=11941 | speaker=unknown"
msgid "　今のはより有名な実業家の言葉で、正しくは"
msgstr ""

#. Occurrence 8DOT5:1986:11942: scene=8DOT5
#: 8DOT5:1986
msgctxt "text_id=11942 | speaker=unknown"
msgid "“富める者は、その富を社会の改善のために使うべきである”"
msgstr ""

#. Occurrence 8DOT5:1992:11943: scene=8DOT5
#: 8DOT5:1992
msgctxt "text_id=11943 | speaker=unknown"
msgid "　だったはず。"
msgstr ""

#. Occurrence 8DOT5:2027:11944: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0015; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2027
msgctxt "text_id=11944 | speaker=soujuurou"
msgid "「信じられるのはお金だけなのかもしれない。"
msgstr ""

#. Occurrence 8DOT5:2033:11945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0016; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2033
msgctxt "text_id=11945 | speaker=soujuurou"
msgid "　だって奥さんも子供も、ずっと一緒にいてくれるわけじゃない。不幸な事故で先立たれるコトだってある。"
msgstr ""

#. Occurrence 8DOT5:2039:11946: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0017; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2039
msgctxt "text_id=11946 | speaker=soujuurou"
msgid "　でもお金は別だった。お金で幸福は買えないけど、幸福はお金になる。いまは人の親切と、温かい布団があればそれでいいと、その人は言った」"
msgstr ""

#. Occurrence 8DOT5:2073:11947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0020; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2073
msgctxt "text_id=11947 | speaker=aoko"
msgid "「なんか……無性にらしくないコト言ってるわね、アイツ」"
msgstr ""

#. Occurrence 8DOT5:2081:11948: scene=8DOT5
#: 8DOT5:2081
msgctxt "text_id=11948 | speaker=unknown"
msgid "　<一抹|いちまつ>の不安を覚えるものの、草十郎の発言を気にしていては日が暮れる。"
msgstr ""

#. Occurrence 8DOT5:2086:11949: scene=8DOT5
#: 8DOT5:2086
msgctxt "text_id=11949 | speaker=unknown"
msgid "　第一、今の青子には<他人|ひと>に神経をさく余裕はない。"
msgstr ""

#. Occurrence 8DOT5:2091:11950: scene=8DOT5
#: 8DOT5:2091
msgctxt "text_id=11950 | speaker=unknown"
msgid "　敵魔術師との戦いは目下、水面下で進行中なのだ。"
msgstr ""

#. Occurrence 8DOT5:2124:11951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0021; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2124
msgctxt "text_id=11951 | speaker=aoko"
msgid "「どっちにしろ私には関係ないか」"
msgstr ""

#. Occurrence 8DOT5:2130:11952: scene=8DOT5
#: 8DOT5:2130
msgctxt "text_id=11952 | speaker=unknown"
msgid "　やれやれと肩をすくめて、青子は居間から意識を逸らした。"
msgstr ""

#. Occurrence 8DOT5:2135:11953: scene=8DOT5
#: 8DOT5:2135
msgctxt "text_id=11953 | speaker=unknown"
msgid "　こんな騒ぎも明日になれば忘れるだろう、と楽観して。"
msgstr ""

#. Occurrence 8DOT5:2228:11954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0018; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2228
msgctxt "text_id=11954 | speaker=soujuurou"
msgid "「ただいまー」"
msgstr ""

#. Occurrence 8DOT5:2271:11955: scene=8DOT5
#: 8DOT5:2271
msgctxt "text_id=11955 | speaker=unknown"
msgid "　今日も今日とて笑顔で帰ってくる勤労少年。"
msgstr ""

#. Occurrence 8DOT5:2276:11956: scene=8DOT5
#: 8DOT5:2276
msgctxt "text_id=11956 | speaker=unknown"
msgid "　何であれ労働は美しい。"
msgstr ""

#. Occurrence 8DOT5:2281:11957: scene=8DOT5
#: 8DOT5:2281
msgctxt "text_id=11957 | speaker=unknown"
msgid "　なので、ソファーでくつろぐ青子の返答も自然、微笑ましいものになる。"
msgstr ""

#. Occurrence 8DOT5:2312:11958: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0022; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2312
msgctxt "text_id=11958 | speaker=aoko"
msgid "「はい、おつかれさま。"
msgstr ""

#. Occurrence 8DOT5:2318:11959: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0023; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2318
msgctxt "text_id=11959 | speaker=aoko"
msgid "　休んでていいわよ。今日は昼からずっとバイトだったんでしょ。"
msgstr ""

#. Occurrence 8DOT5:2326:11960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0024; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2326
msgctxt "text_id=11960 | speaker=aoko"
msgid "夕飯ならこれから作ってあ―――"
msgstr ""

msgctxt "text_id=11961 | speaker=unknown"
msgid "なにぃ？」"
msgstr ""

#. Occurrence 8DOT5:2339:11962: scene=8DOT5
#: 8DOT5:2339
msgctxt "text_id=11962 | speaker=unknown"
msgid "　が。その笑顔も、唐突に凍りついた。"
msgstr ""

#. Occurrence 8DOT5:2372:11963: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0019; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2372
msgctxt "text_id=11963 | speaker=soujuurou"
msgid "「ん？　どうした蒼崎、木乃美の冗談を聞いた時みたいな顔して」"
msgstr ""

#. Occurrence 8DOT5:2383:11964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0025; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2383
msgctxt "text_id=11964 | speaker=aoko"
msgid "「どうしたじゃない、いいかげん黙っていられなくなった！"
msgstr ""

#. Occurrence 8DOT5:2383:11965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0025; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2383
msgctxt "text_id=11965 | speaker=aoko"
msgid "　いいから、そのポケットの<物|もん>だしなさい！」"
msgstr ""

#. Occurrence 8DOT5:2403:11966: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0020; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2403
msgctxt "text_id=11966 | speaker=soujuurou"
msgid "「む」"
msgstr ""

#. Occurrence 8DOT5:2423:11967: scene=8DOT5
#: 8DOT5:2423
msgctxt "text_id=11967 | speaker=unknown"
msgid "　なぜ<叱|しか>られるのか納得いかないまま、草十郎はポケットの中の物を取り出した。"
msgstr ""

#. Occurrence 8DOT5:2457:11968: scene=8DOT5
#: 8DOT5:2457
msgctxt "text_id=11968 | speaker=unknown"
msgid "　テーブルに置かれる、お馴染みの茶封筒。"
msgstr ""

#. Occurrence 8DOT5:2463:11969: scene=8DOT5
#: 8DOT5:2463
msgctxt "text_id=11969 | speaker=unknown"
msgid "　しかし、それは普通の封筒と言うにはぶ厚すぎた。"
msgstr ""

#. Occurrence 8DOT5:2469:11970: scene=8DOT5
#: 8DOT5:2469
msgctxt "text_id=11970 | speaker=unknown"
msgid "　<眩|まぶ>しく、<荘厳|そうごん>で、人を惑わす魔力がありすぎた。"
msgstr ""

#. Occurrence 8DOT5:2476:11971: scene=8DOT5
#: 8DOT5:2476
msgctxt "text_id=11971 | speaker=unknown"
msgid "　なんていうか、それはまさしく札束だった。"
msgstr ""

#. Occurrence 8DOT5:2511:11972: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0009; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:2511
msgctxt "text_id=11972 | speaker=alice"
msgid "「―――まあ。これはどうしたの、静希君」"
msgstr ""

#. Occurrence 8DOT5:2517:11973: scene=8DOT5
#: 8DOT5:2517
msgctxt "text_id=11973 | speaker=unknown"
msgid "　あどけない有珠の声。"
msgstr ""

#. Occurrence 8DOT5:2522:11974: scene=8DOT5
#: 8DOT5:2522
msgctxt "text_id=11974 | speaker=unknown"
msgid "　心なしか目が輝いているように見えるが、間違いなく錯覚ではない。"
msgstr ""

#. Occurrence 8DOT5:2560:11975: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0021; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2560
msgctxt "text_id=11975 | speaker=soujuurou"
msgid "「バイト代だよ」"
msgstr ""

#. Occurrence 8DOT5:2578:11976: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0010; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:2578
msgctxt "text_id=11976 | speaker=alice"
msgid "「そう。それはいいコトだわ。明日はご馳走ね」"
msgstr ""

#. Occurrence 8DOT5:2584:11977: scene=8DOT5
#: 8DOT5:2584
msgctxt "text_id=11977 | speaker=unknown"
msgid "　札束を前にしても淡々としたふたりである。"
msgstr ""

#. Occurrence 8DOT5:2589:11978: scene=8DOT5
#: 8DOT5:2589
msgctxt "text_id=11978 | speaker=unknown"
msgid "　一方、この<館|いえ>唯一の常識人はと言うと、"
msgstr ""

#. Occurrence 8DOT5:2625:11979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0026; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2625
msgctxt "text_id=11979 | speaker=aoko"
msgid "「んなワケないでしょう！？　ちょっと草十郎、そこに正座！　どういうコトか説明なさい！」"
msgstr ""

#. Occurrence 8DOT5:2631:11980: scene=8DOT5
#: 8DOT5:2631
msgctxt "text_id=11980 | speaker=unknown"
msgid "　この通り、コトの重大さを当事者より理解していた。"
msgstr ""

#. Occurrence 8DOT5:2657:11981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0022; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2657
msgctxt "text_id=11981 | speaker=soujuurou"
msgid "「？　説明って、なにをだ？」"
msgstr ""

#. Occurrence 8DOT5:2668:11982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0027; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2668
msgctxt "text_id=11982 | speaker=aoko"
msgid "「決まってるでしょ、この札束の正体よ！"
msgstr ""

#. Occurrence 8DOT5:2674:11983: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0028; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2674
msgctxt "text_id=11983 | speaker=aoko"
msgid "　アンタいま何やってんの！？　どう考えてもまっとうな職種とは思えないんですけど！？」"
msgstr ""

#. Occurrence 8DOT5:2700:11984: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0023; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2700
msgctxt "text_id=11984 | speaker=soujuurou"
msgid "「まっとうだぞ。"
msgstr ""

#. Occurrence 8DOT5:2706:11985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0024; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2706
msgctxt "text_id=11985 | speaker=soujuurou"
msgid "　この新しいバイトは、少なくとも法には触れていないと聞いた。ちゃんとやれば危ない目にも遭わない。"
msgstr ""

#. Occurrence 8DOT5:2712:11986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0025; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2712
msgctxt "text_id=11986 | speaker=soujuurou"
msgid "　コンビニエンスストアより割がいいし、俺でも簡単にできると言う」"
msgstr ""

#. Occurrence 8DOT5:2752:11987: scene=8DOT5
#: 8DOT5:2752
msgctxt "text_id=11987 | speaker=unknown"
msgid "　クラッと。"
msgstr ""

#. Occurrence 8DOT5:2757:11988: scene=8DOT5
#: 8DOT5:2757
msgctxt "text_id=11988 | speaker=unknown"
msgid "　青子は失意を通り越した苛立ちのあまり、目眩を起こしかけた。"
msgstr ""

#. Occurrence 8DOT5:2762:11989: scene=8DOT5
#: 8DOT5:2762
msgctxt "text_id=11989 | speaker=unknown"
msgid "“少なくとも法には触れていない”"
msgstr ""

#. Occurrence 8DOT5:2767:11990: scene=8DOT5
#: 8DOT5:2767
msgctxt "text_id=11990 | speaker=unknown"
msgid "　泥酔した酔っぱらいが“酔っていない”と言い張るのと何が違おう。"
msgstr ""

#. Occurrence 8DOT5:2802:11991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0029; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2802
msgctxt "text_id=11991 | speaker=aoko"
msgid "「正気に戻れ！　日ごとお金が倍々に増えていくバイトなんてあるワケないでしょう？"
msgstr ""

#. Occurrence 8DOT5:2808:11992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0030; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2808
msgctxt "text_id=11992 | speaker=aoko"
msgid "　いいから仕事の内容を言いなさい、内容を！　アンタ、どう考えても騙されてるから！」"
msgstr ""

#. Occurrence 8DOT5:2826:11993: scene=8DOT5
#: 8DOT5:2826
msgctxt "text_id=11993 | speaker=unknown"
msgid "　む、と草十郎は口を閉ざす。"
msgstr ""

#. Occurrence 8DOT5:2831:11994: scene=8DOT5
#: 8DOT5:2831
msgctxt "text_id=11994 | speaker=unknown"
msgid "　青子の剣幕を前にして一歩も引かない構えだ。"
msgstr ""

#. Occurrence 8DOT5:2865:11995: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0026; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2865
msgctxt "text_id=11995 | speaker=soujuurou"
msgid "「だめだ。いくら蒼崎でも教えられない。あんまり<他人|ひと>に話すことでもない。"
msgstr ""

#. Occurrence 8DOT5:2871:11996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0027; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2871
msgctxt "text_id=11996 | speaker=soujuurou"
msgid "　でも安心してくれ。分類的には、ちょっとした人助けと言えるだろう。あと紹介してくれた人とは一度しか会ってないし、支払いは常に現金だ」"
msgstr ""

#. Occurrence 8DOT5:2877:11997: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0031; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2877
msgctxt "text_id=11997 | speaker=aoko"
msgid "「この田舎バカ、その文脈からして怪しすぎるんだっていうのーーー！」"
msgstr ""

#. Occurrence 8DOT5:2910:11998: scene=8DOT5
#: 8DOT5:2910
msgctxt "text_id=11998 | speaker=unknown"
msgid "　ああもう、と地団駄を踏む青子。"
msgstr ""

#. Occurrence 8DOT5:2915:11999: scene=8DOT5
#: 8DOT5:2915
msgctxt "text_id=11999 | speaker=unknown"
msgid "『新しいバイト』『割がいい、誰でもできる』『だが内容公開は断る』なんて禁句を連発されて、冷静でいられるはずがない。"
msgstr ""

#. Occurrence 8DOT5:2935:12000: scene=8DOT5
#: 8DOT5:2935
msgctxt "text_id=12000 | speaker=unknown"
msgid "　が、"
msgstr ""

#. Occurrence 8DOT5:2954:12001: scene=8DOT5
#: 8DOT5:2954
msgctxt "text_id=12001 | speaker=unknown"
msgid "　草十郎はかたくなに口を閉ざしている。"
msgstr ""

#. Occurrence 8DOT5:2959:12002: scene=8DOT5
#: 8DOT5:2959
msgctxt "text_id=12002 | speaker=unknown"
msgid "　付き合いは短いが、青子はこの少年の性格をそれなりに思い知っている。"
msgstr ""

#. Occurrence 8DOT5:2964:12003: scene=8DOT5
#: 8DOT5:2964
msgctxt "text_id=12003 | speaker=unknown"
msgid "　義理堅いというか、自分の中でこれと決めた事はちょっとやそっとでは<覆|くつがえ>らないのだ。"
msgstr ""

#. Occurrence 8DOT5:2969:12004: scene=8DOT5
#: 8DOT5:2969
msgctxt "text_id=12004 | speaker=unknown"
msgid "　こういう時の草十郎はとんでもなく口が堅い。"
msgstr ""

#. Occurrence 8DOT5:3004:12005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0032; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3004
msgctxt "text_id=12005 | speaker=aoko"
msgid "「……くぅ、厄介な……」"
msgstr ""

#. Occurrence 8DOT5:3010:12006: scene=8DOT5
#: 8DOT5:3010
msgctxt "text_id=12006 | speaker=unknown"
msgid "　無理やり<喋|しゃべ>らせるのは困難か、と青子は引き下がる。"
msgstr ""

#. Occurrence 8DOT5:3030:12007: scene=8DOT5
#: 8DOT5:3030
msgctxt "text_id=12007 | speaker=unknown"
msgid "　そんな彼女の内心をまったく分かっていないらしく、草十郎は不思議そうに、"
msgstr ""

#. Occurrence 8DOT5:3053:12008: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0028; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:3053
msgctxt "text_id=12008 | speaker=soujuurou"
msgid "「なんで蒼崎は怒ってるんだ？」"
msgstr ""

#. Occurrence 8DOT5:3077:12009: scene=8DOT5
#: 8DOT5:3077
msgctxt "text_id=12009 | speaker=unknown"
msgid "　うん、こいつは役に立たない、と諦める青子。"
msgstr ""

#. Occurrence 8DOT5:3116:12010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0033; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3116
msgctxt "text_id=12010 | speaker=aoko"
msgid "「そんなうまい話はないからよ。有珠もそう思うでしょう？」"
msgstr ""

#. Occurrence 8DOT5:3140:12011: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0011; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:3140
msgctxt "text_id=12011 | speaker=alice"
msgid "「そうね。青子の言いたいコトは分からないけど、静希君はもっとやるべきだと思う」"
msgstr ""

#. Occurrence 8DOT5:3164:12012: scene=8DOT5
#: 8DOT5:3164
msgctxt "text_id=12012 | speaker=unknown"
msgid "　そして有珠は、はじめから役に立たない。"
msgstr ""

#. Occurrence 8DOT5:3199:12013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0034; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3199
msgctxt "text_id=12013 | speaker=aoko"
msgid "「…………はあ」"
msgstr ""

#. Occurrence 8DOT5:3205:12014: scene=8DOT5
#: 8DOT5:3205
msgctxt "text_id=12014 | speaker=unknown"
msgid "　青子はソファーに腰を落とす。"
msgstr ""

#. Occurrence 8DOT5:3226:12015: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0029; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:3226
msgctxt "text_id=12015 | speaker=soujuurou"
msgid "「蒼崎」"
msgstr ""

#. Occurrence 8DOT5:3232:12016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0035; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3232
msgctxt "text_id=12016 | speaker=aoko"
msgid "「いいわよ、もう。よく分かんない理由で話す気ないんでしょ、草十郎は。"
msgstr ""

#. Occurrence 8DOT5:3238:12017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0036; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3238
msgctxt "text_id=12017 | speaker=aoko"
msgid "　考えてみればアンタなんてただの同居人なワケだし、私があれこれ文句いう筋合いはなかったわ」"
msgstr ""

#. Occurrence 8DOT5:3267:12018: scene=8DOT5
#: 8DOT5:3267
msgctxt "text_id=12018 | speaker=unknown"
msgid "　しっしっ、と手を振って草十郎を追っ払う。"
msgstr ""

#. Occurrence 8DOT5:3272:12019: scene=8DOT5
#: 8DOT5:3272
msgctxt "text_id=12019 | speaker=unknown"
msgid "　それっきり不機嫌に押し黙る青子だが、もちろん、このまま済ませる気はない。"
msgstr ""

#. Occurrence 8DOT5:3277:12020: scene=8DOT5
#: 8DOT5:3277
msgctxt "text_id=12020 | speaker=unknown"
msgid "　有珠の見解はともかく、草十郎を放っておく事はできないからだ。"
msgstr ""

#. Occurrence 8DOT5:3303:12021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0037; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3303
msgctxt "text_id=12021 | speaker=aoko"
msgid "「……アイツはどう見ても騙されてるし……最終的にとばっちりくらうのは私だし……」"
msgstr ""

#. Occurrence 8DOT5:3309:12022: scene=8DOT5
#: 8DOT5:3309
msgctxt "text_id=12022 | speaker=unknown"
msgid "　ここは心を鬼にして、今すぐにでも新しいバイトとやらを辞めさせるべきである。"
msgstr ""

#. Occurrence 8DOT5:3314:12023: scene=8DOT5
#: 8DOT5:3314
msgctxt "text_id=12023 | speaker=unknown"
msgid "　それが友人としての思いやりであり、"
msgstr ""

#. Occurrence 8DOT5:3319:12024: scene=8DOT5
#: 8DOT5:3319
msgctxt "text_id=12024 | speaker=unknown"
msgid "　生徒会長としての義務だろう。"
msgstr ""

#. Occurrence 8DOT5:3345:12025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0038; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3345
msgctxt "text_id=12025 | speaker=aoko"
msgid "「…………」"
msgstr ""

#. Occurrence 8DOT5:3351:12026: scene=8DOT5
#: 8DOT5:3351
msgctxt "text_id=12026 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence 8DOT5:3356:12027: scene=8DOT5
#: 8DOT5:3356
msgctxt "text_id=12027 | speaker=unknown"
msgid "　しかしだ、と青子は自分に言い聞かせる。"
msgstr ""

#. Occurrence 8DOT5:3361:12028: scene=8DOT5
#: 8DOT5:3361
msgctxt "text_id=12028 | speaker=unknown"
msgid "　道徳も良心も大切だが、正直なところ、仕送りだけで生きている学生として、あのお金は捨てがたい……！"
msgstr ""

#. Occurrence 8DOT5:3392:12029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0039; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3392
msgctxt "text_id=12029 | speaker=aoko"
msgid "「……そうね。最終的に辞めさせるのは絶対にしても、これまで稼いだお金を捨てるのは勿体ないし……"
msgstr ""

#. Occurrence 8DOT5:3399:12030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0040; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3399
msgctxt "text_id=12030 | speaker=aoko"
msgid "仕方ない、ここは<搦|から>め手でいくか」"
msgstr ""

#. Occurrence 8DOT5:3405:12031: scene=8DOT5
#: 8DOT5:3405
msgctxt "text_id=12031 | speaker=unknown"
msgid "　などと画策しながら、ソファーにずぶずぶと沈む悪の生徒会長。"
msgstr ""

#. Occurrence 8DOT5:3410:12032: scene=8DOT5
#: 8DOT5:3410
msgctxt "text_id=12032 | speaker=unknown"
msgid "　いちいち覚悟を決めずともデフォルトで心が<守銭奴|お　に>なのが彼女の長所であり、短所である。"
msgstr ""

#. Occurrence 8DOT5:3456:12033: scene=8DOT5
#: 8DOT5:3456
msgctxt "text_id=12033 | speaker=unknown"
msgid "　翌日、正午。"
msgstr ""

#. Occurrence 8DOT5:3496:12034: scene=8DOT5
#: 8DOT5:3496
msgctxt "text_id=12034 | speaker=unknown"
msgid "　青子は同居人たちが出かけたのを<見計|みはか>らって、ロビーの電話を手に取った。"
msgstr ""

#. Occurrence 8DOT5:3503:12035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0041; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3503
msgctxt "text_id=12035 | speaker=aoko"
msgid "「もしもし、鳶丸？　草十郎がこんなコトになってるんだけど、アンタ、心当たりない？」"
msgstr ""

#. Occurrence 8DOT5:3550:12036: scene=8DOT5
#: 8DOT5:3550
msgctxt "text_id=12036 | speaker=unknown"
msgid "　始発電車の音が遠い。"
msgstr ""

#. Occurrence 8DOT5:3555:12037: scene=8DOT5
#: 8DOT5:3555
msgctxt "text_id=12037 | speaker=unknown"
msgid "　町が目を覚ますか覚まさないか、どちらつかずの時間帯。"
msgstr ""

#. Occurrence 8DOT5:3560:12038: scene=8DOT5
#: 8DOT5:3560
msgctxt "text_id=12038 | speaker=unknown"
msgid "　<槻司|つきじ><鳶丸|とびまる>は日が<昇|のぼ>ったばかりの繁華街をそぞろ歩きながら、早朝の雑多にして清浄な空気に感心していた。"
msgstr ""

#. Occurrence 8DOT5:3590:12039: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0000; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3590
msgctxt "text_id=12039 | speaker=tobimaru"
msgid "「本当、町ってのは人間がいないだけでキレイなもんだ」"
msgstr ""

#. Occurrence 8DOT5:3596:12040: scene=8DOT5
#: 8DOT5:3596
msgctxt "text_id=12040 | speaker=unknown"
msgid "　鳶丸にとっては通例化しているぼやきである。"
msgstr ""

#. Occurrence 8DOT5:3628:12041: scene=8DOT5
#: 8DOT5:3628
msgctxt "text_id=12041 | speaker=unknown"
msgid "　派手派手しく<飾|かざ>られた<町角|まちかど>は、人間の欲望の具現だ。"
msgstr ""

#. Occurrence 8DOT5:3633:12042: scene=8DOT5
#: 8DOT5:3633
msgctxt "text_id=12042 | speaker=unknown"
msgid "　見せ物小屋と何ら変わりのない連なりだが、この時間帯だけはまったく違うものになる。"
msgstr ""

#. Occurrence 8DOT5:3638:12043: scene=8DOT5
#: 8DOT5:3638
msgctxt "text_id=12043 | speaker=unknown"
msgid "　人のいない大通り。"
msgstr ""

#. Occurrence 8DOT5:3643:12044: scene=8DOT5
#: 8DOT5:3643
msgctxt "text_id=12044 | speaker=unknown"
msgid "　静まりかえった朝の町は、祭りの後のような寂しさに染まっている。"
msgstr ""

#. Occurrence 8DOT5:3676:12045: scene=8DOT5
#: 8DOT5:3676
msgctxt "text_id=12045 | speaker=unknown"
msgid "　ふと目に入った<酒場|バー>の入り口には、けだるそうに昨夜の後始末をする黒服。"
msgstr ""

#. Occurrence 8DOT5:3681:12046: scene=8DOT5
#: 8DOT5:3681
msgctxt "text_id=12046 | speaker=unknown"
msgid "　あるいは、飲食店の裏口ではあくびをかみ殺しながら今日の仕込みをはじめる<料理人|コックコート>。"
msgstr ""

#. Occurrence 8DOT5:3686:12047: scene=8DOT5
#: 8DOT5:3686
msgctxt "text_id=12047 | speaker=unknown"
msgid "　鳥は無防備に道を歩き、"
msgstr ""

#. Occurrence 8DOT5:3691:12048: scene=8DOT5
#: 8DOT5:3691
msgctxt "text_id=12048 | speaker=unknown"
msgid "　自動車のエンジン音も途絶えている。"
msgstr ""

#. Occurrence 8DOT5:3724:12049: scene=8DOT5
#: 8DOT5:3724
msgctxt "text_id=12049 | speaker=unknown"
msgid "　この独特の清涼感は都市の朝にしかないものだ。"
msgstr ""

#. Occurrence 8DOT5:3729:12050: scene=8DOT5
#: 8DOT5:3729
msgctxt "text_id=12050 | speaker=unknown"
msgid "　生活と娯楽の狭間。"
msgstr ""

#. Occurrence 8DOT5:3734:12051: scene=8DOT5
#: 8DOT5:3734
msgctxt "text_id=12051 | speaker=unknown"
msgid "　忙しい<人間社会|ダイヤル>の中で、この時間だけは昔ながらのスピードで回っている。"
msgstr ""

#. Occurrence 8DOT5:3772:12052: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0001; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3772
msgctxt "text_id=12052 | speaker=tobimaru"
msgid "「―――チッ。そうか」"
msgstr ""

#. Occurrence 8DOT5:3778:12053: scene=8DOT5
#: 8DOT5:3778
msgctxt "text_id=12053 | speaker=unknown"
msgid "　口元に<寂|さみ>しさを感じてコートのポケットをあさったが、中にあるのはレシートばかりだ。"
msgstr ""

#. Occurrence 8DOT5:3783:12054: scene=8DOT5
#: 8DOT5:3783
msgctxt "text_id=12054 | speaker=unknown"
msgid "　鳶丸はマフラーを巻き直して、冷えきった風をやり過ごした。"
msgstr ""

#. Occurrence 8DOT5:3817:12055: scene=8DOT5
#: 8DOT5:3817
msgctxt "text_id=12055 | speaker=unknown"
msgid "　鳶丸は繁華街を適当にぶらついて、朝の魔力がきれる頃に中央公園に流れていく。"
msgstr ""

#. Occurrence 8DOT5:3822:12056: scene=8DOT5
#: 8DOT5:3822
msgctxt "text_id=12056 | speaker=unknown"
msgid "　散策に目的はない。"
msgstr ""

#. Occurrence 8DOT5:3827:12057: scene=8DOT5
#: 8DOT5:3827
msgctxt "text_id=12057 | speaker=unknown"
msgid "　健康のための散歩でもジョギングでもない。"
msgstr ""

#. Occurrence 8DOT5:3832:12058: scene=8DOT5
#: 8DOT5:3832
msgctxt "text_id=12058 | speaker=unknown"
msgid "　これは単に、夜通し遊んだ後の<自堕落|じだらく>な朝帰りだ。"
msgstr ""

#. Occurrence 8DOT5:3865:12059: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0002; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3865
msgctxt "text_id=12059 | speaker=tobimaru"
msgid "「馬鹿らしい。なにやってんだか」"
msgstr ""

#. Occurrence 8DOT5:3871:12060: scene=8DOT5
#: 8DOT5:3871
msgctxt "text_id=12060 | speaker=unknown"
msgid "　自動販売機で買った缶コーヒーを飲みながら、臆面もなく自虐する。"
msgstr ""

#. Occurrence 8DOT5:3876:12061: scene=8DOT5
#: 8DOT5:3876
msgctxt "text_id=12061 | speaker=unknown"
msgid "　夜通し遊ぶのは嫌いではないが、まだ酒も飲めないのでは退屈極まりない。"
msgstr ""

#. Occurrence 8DOT5:3882:12062: scene=8DOT5
#: 8DOT5:3882
msgctxt "text_id=12062 | speaker=unknown"
msgid "　それでも家に居るよりはマシだろう、とここ数日は朝帰りだが、いい加減、それも飽きてきたところだった。"
msgstr ""

#. Occurrence 8DOT5:3916:12063: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0003; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3916
msgctxt "text_id=12063 | speaker=tobimaru"
msgid "「……ま、年末に親戚筋が集まるのは仕方がねえし」"
msgstr ""

#. Occurrence 8DOT5:3922:12064: scene=8DOT5
#: 8DOT5:3922
msgctxt "text_id=12064 | speaker=unknown"
msgid "　言い訳がましい呟きに、いっそう苦笑いを強めてしまう。"
msgstr ""

#. Occurrence 8DOT5:3927:12065: scene=8DOT5
#: 8DOT5:3927
msgctxt "text_id=12065 | speaker=unknown"
msgid "　彼がこうして時間を潰しているのは、ある意味、帰る場所がないからだ。"
msgstr ""

#. Occurrence 8DOT5:3947:12066: scene=8DOT5
#: 8DOT5:3947
msgctxt "text_id=12066 | speaker=unknown"
msgid "　槻司家では祖父の方針で、毎年元旦に親戚会議が行われる。"
msgstr ""

#. Occurrence 8DOT5:3952:12067: scene=8DOT5
#: 8DOT5:3952
msgctxt "text_id=12067 | speaker=unknown"
msgid "　必然、数日前からちりぢりになっていた<兄姉|きょうだい>、親族筋が槻司の家に宿泊する事になる。"
msgstr ""

#. Occurrence 8DOT5:3972:12068: scene=8DOT5
#: 8DOT5:3972
msgctxt "text_id=12068 | speaker=unknown"
msgid "　そんな場で<鳶丸|じぶん>がいては火種になる。"
msgstr ""

#. Occurrence 8DOT5:3977:12069: scene=8DOT5
#: 8DOT5:3977
msgctxt "text_id=12069 | speaker=unknown"
msgid "　降りかかる火の粉を払うのはやぶさかではないが、争いごとは極力避けるため、鳶丸は家に帰らない選択をした。"
msgstr ""

#. Occurrence 8DOT5:4012:12070: scene=8DOT5
#: 8DOT5:4012
msgctxt "text_id=12070 | speaker=unknown"
msgid "　家にいては何であろうと攻撃される。"
msgstr ""

#. Occurrence 8DOT5:4017:12071: scene=8DOT5
#: 8DOT5:4017
msgctxt "text_id=12071 | speaker=unknown"
msgid "　ケンカを売られては買ってしまうのが彼の性分だ。"
msgstr ""

#. Occurrence 8DOT5:4022:12072: scene=8DOT5
#: 8DOT5:4022
msgctxt "text_id=12072 | speaker=unknown"
msgid "　その都度に相手を打ち負かしていては憎しみはつのるばかりだし、父にも面倒が及ぶ。"
msgstr ""

#. Occurrence 8DOT5:4027:12073: scene=8DOT5
#: 8DOT5:4027
msgctxt "text_id=12073 | speaker=unknown"
msgid "　そしてなにより、兄姉たちのように血眼になって相続争いをするのは、この上なく面倒で、どうでもいい話だった。"
msgstr ""

#. Occurrence 8DOT5:4078:12074: scene=8DOT5
#: 8DOT5:4078
msgctxt "text_id=12074 | speaker=unknown"
msgid "　槻司鳶丸は三咲市でも有数の地主、槻司家の五男として生まれた。"
msgstr ""

#. Occurrence 8DOT5:4083:12075: scene=8DOT5
#: 8DOT5:4083
msgctxt "text_id=12075 | speaker=unknown"
msgid "　今では大地主として君臨する槻司家だが、その大部分は戦後に財を成したもので、それ以前は小さな、没落を前にした華族にすぎなかった。"
msgstr ""

#. Occurrence 8DOT5:4088:12076: scene=8DOT5
#: 8DOT5:4088
msgctxt "text_id=12076 | speaker=unknown"
msgid "　その槻司家を立て直したのが婿養子として迎えられた槻司<喜実國|きみくに>―――現槻司家の家長にして、鳶丸の祖父にあたる人物だ。"
msgstr ""

#. Occurrence 8DOT5:4108:12077: scene=8DOT5
#: 8DOT5:4108
msgctxt "text_id=12077 | speaker=unknown"
msgid "　戦時中に力を失い、やせ細った槻司家を救ったのは、この男、喜実國の豪腕によるものである。"
msgstr ""

#. Occurrence 8DOT5:4113:12078: scene=8DOT5
#: 8DOT5:4113
msgctxt "text_id=12078 | speaker=unknown"
msgid "　<檀家|だんけ><総代|そうだい>、神職として地域を取り仕切っていた槻司家は喜実國の資産を、"
msgstr ""

#. Occurrence 8DOT5:4118:12079: scene=8DOT5
#: 8DOT5:4118
msgctxt "text_id=12079 | speaker=unknown"
msgid "　喜実國は三咲市に根を下ろすために槻司家の人脈を必要とした。"
msgstr ""

#. Occurrence 8DOT5:4171:12080: scene=8DOT5
#: 8DOT5:4171
msgctxt "text_id=12080 | speaker=unknown"
msgid "　利益目的で結びついた両者だが、槻司家の誤算は、一時だけと甘んじて迎え入れた喜実國の経営手腕が並々ならぬものだった事だろう。"
msgstr ""

#. Occurrence 8DOT5:4176:12081: scene=8DOT5
#: 8DOT5:4176
msgctxt "text_id=12081 | speaker=unknown"
msgid "　婿養子として下に置くはずだった喜実國は三咲の産業を発展させ、それを基盤として町の外に多くの会社を興していった。"
msgstr ""

#. Occurrence 8DOT5:4196:12082: scene=8DOT5
#: 8DOT5:4196
msgctxt "text_id=12082 | speaker=unknown"
msgid "　彼は三咲市の内を支配しながら、その周りを槻司の親族たちとは関わりのない、自分だけの勢力で制圧した。"
msgstr ""

#. Occurrence 8DOT5:4201:12083: scene=8DOT5
#: 8DOT5:4201
msgctxt "text_id=12083 | speaker=unknown"
msgid "　内側より先に外堀を。"
msgstr ""

#. Occurrence 8DOT5:4206:12084: scene=8DOT5
#: 8DOT5:4206
msgctxt "text_id=12084 | speaker=unknown"
msgid "　言ってしまえば経済的な兵糧攻めである。"
msgstr ""

#. Occurrence 8DOT5:4211:12085: scene=8DOT5
#: 8DOT5:4211
msgctxt "text_id=12085 | speaker=unknown"
msgid "　喜実國は経済の力で槻司家の“由緒正しい血筋”を押さえつけたのだ。"
msgstr ""

#. Occurrence 8DOT5:4246:12086: scene=8DOT5
#: 8DOT5:4246
msgctxt "text_id=12086 | speaker=unknown"
msgid "　十年を待たずして、槻司家では喜実國に対抗できる者は一人としていなくなった。"
msgstr ""

#. Occurrence 8DOT5:4251:12087: scene=8DOT5
#: 8DOT5:4251
msgctxt "text_id=12087 | speaker=unknown"
msgid "　婿養子として招かれた商人は、名実ともに槻司家の<家督|かとく>を手にしたのである。"
msgstr ""

#. Occurrence 8DOT5:4287:12088: scene=8DOT5
#: 8DOT5:4287
msgctxt "text_id=12088 | speaker=unknown"
msgid "　一方、喜実國は多くの子供を儲けていた。"
msgstr ""

#. Occurrence 8DOT5:4292:12089: scene=8DOT5
#: 8DOT5:4292
msgctxt "text_id=12089 | speaker=unknown"
msgid "　槻司の血を絶やさないこと。それが家督を継ぐ条件でもあったからだ。"
msgstr ""

#. Occurrence 8DOT5:4297:12090: scene=8DOT5
#: 8DOT5:4297
msgctxt "text_id=12090 | speaker=unknown"
msgid "　彼の三人の息子とひとり娘は槻司家縁の親戚と結婚し、喜実國によって弱体化した槻司家の<絆|きずな>をなんとか持ち直そうとした。"
msgstr ""

#. Occurrence 8DOT5:4307:12091: scene=8DOT5
#: 8DOT5:4307
msgctxt "text_id=12091 | speaker=unknown"
msgid "　その長男にあたる槻司<一義|ひとよし>の、五人目の子供が鳶丸である。"
msgstr ""

#. Occurrence 8DOT5:4359:12092: scene=8DOT5
#: 8DOT5:4359
msgctxt "text_id=12092 | speaker=unknown"
msgid "　　……だが、彼の母親は槻司家には存在しない。"
msgstr ""

#. Occurrence 8DOT5:4365:12093: scene=8DOT5
#: 8DOT5:4365
msgctxt "text_id=12093 | speaker=unknown"
msgid "　父、一義が<戯|たわむ>れに関係し生まれた<妾|めかけ>の子。"
msgstr ""

#. Occurrence 8DOT5:4371:12094: scene=8DOT5
#: 8DOT5:4371
msgctxt "text_id=12094 | speaker=unknown"
msgid "　それが槻司鳶丸の、槻司家における身分だった。"
msgstr ""

#. Occurrence 8DOT5:4391:12095: scene=8DOT5
#: 8DOT5:4391
msgctxt "text_id=12095 | speaker=unknown"
msgid "　鳶丸は父と愛人との間に生まれた子供である。"
msgstr ""

#. Occurrence 8DOT5:4396:12096: scene=8DOT5
#: 8DOT5:4396
msgctxt "text_id=12096 | speaker=unknown"
msgid "　長男である一義の子という事で最低限の威厳は守られたが、立場の弱い鳶丸が親戚、兄姉たちにどんな迫害を受けたかは想像に難くない。"
msgstr ""

#. Occurrence 8DOT5:4416:12097: scene=8DOT5
#: 8DOT5:4416
msgctxt "text_id=12097 | speaker=unknown"
msgid "　そんな幼年期の環境が、鳶丸の人となりをいち早く成長させた。"
msgstr ""

#. Occurrence 8DOT5:4421:12098: scene=8DOT5
#: 8DOT5:4421
msgctxt "text_id=12098 | speaker=unknown"
msgid "　独特の理解の早さ、自分の役回りを演じる客観性は、槻司家で生きる上で自然に<磨|みが>かれたものだろう。"
msgstr ""

#. Occurrence 8DOT5:4471:12099: scene=8DOT5
#: 8DOT5:4471
msgctxt "text_id=12099 | speaker=unknown"
msgid "　しかし、その<如才|じょさい>のなさが鳶丸により大きな問題を運んでしまった。"
msgstr ""

#. Occurrence 8DOT5:4476:12100: scene=8DOT5
#: 8DOT5:4476
msgctxt "text_id=12100 | speaker=unknown"
msgid "　槻司喜実國。"
msgstr ""

#. Occurrence 8DOT5:4481:12101: scene=8DOT5
#: 8DOT5:4481
msgctxt "text_id=12101 | speaker=unknown"
msgid "　困った事にこの大人物は今<以|もっ>て現役であり、多くの息子たちより―――鳶丸の父親である一義より、どこの女の子供とも知れない<鳶|ま><丸|ご>を気に入ってしまったのだ。"
msgstr ""

#. Occurrence 8DOT5:4501:12102: scene=8DOT5
#: 8DOT5:4501
msgctxt "text_id=12102 | speaker=unknown"
msgid "　もともと庶民の出であった喜実國は、血縁による相続を良しとしない節がある。"
msgstr ""

#. Occurrence 8DOT5:4506:12103: scene=8DOT5
#: 8DOT5:4506
msgctxt "text_id=12103 | speaker=unknown"
msgid "　加えて、この人物はいまだ息子たちに、自身の財産をこれっぽっちも譲り渡していなかった。"
msgstr ""

#. Occurrence 8DOT5:4557:12104: scene=8DOT5
#: 8DOT5:4557
msgctxt "text_id=12104 | speaker=unknown"
msgid "“この世でもっとも忌まわしいのは槻司の血だ。"
msgstr ""

#. Occurrence 8DOT5:4562:12105: scene=8DOT5
#: 8DOT5:4562
msgctxt "text_id=12105 | speaker=unknown"
msgid "　儂は貴様らなぞ作りたくもなかったわ”"
msgstr ""

#. Occurrence 8DOT5:4568:12106: scene=8DOT5
#: 8DOT5:4568
msgctxt "text_id=12106 | speaker=unknown"
msgid "　親族一同が集まるたびに出るその言葉は、嘘偽りのない本音だった。"
msgstr ""

#. Occurrence 8DOT5:4573:12107: scene=8DOT5
#: 8DOT5:4573
msgctxt "text_id=12107 | speaker=unknown"
msgid "　恒例の親戚会議のおり、喜実國はたまたま話し相手になった鳶丸を気に入り、以後、仕事の合間に帰ってきては孫と囲碁などに興じる間柄になっていた。"
msgstr ""

#. Occurrence 8DOT5:4593:12108: scene=8DOT5
#: 8DOT5:4593
msgctxt "text_id=12108 | speaker=unknown"
msgid "　その喜実國がいつ鳶丸を後継者にと言いだすか、親戚一同は気が気でない。"
msgstr ""

#. Occurrence 8DOT5:4598:12109: scene=8DOT5
#: 8DOT5:4598
msgctxt "text_id=12109 | speaker=unknown"
msgid "　喜実國の息子たちにとって鳶丸は『居る価値のない』ものから、『居てもらっては困るもの』に格上げされたワケである。"
msgstr ""

#. Occurrence 8DOT5:4633:12110: scene=8DOT5
#: 8DOT5:4633
msgctxt "text_id=12110 | speaker=unknown"
msgid "　その危機感がもはや恐怖、嫌悪の域にまで達しているのは他でもない、本来なら無条件で喜実國の跡を継ぐはずだった長男であり、鳶丸の父親である、槻司一義その人だった。"
msgstr ""

#. Occurrence 8DOT5:4665:12111: scene=8DOT5
#: 8DOT5:4665
msgctxt "text_id=12111 | speaker=unknown"
msgid "　こうして、鳶丸は実の父親にまで疎まれる立場になった。"
msgstr ""

#. Occurrence 8DOT5:4671:12112: scene=8DOT5
#: 8DOT5:4671
msgctxt "text_id=12112 | speaker=unknown"
msgid "　現在、鳶丸は父である一義と同じ家には住んでいない。"
msgstr ""

#. Occurrence 8DOT5:4676:12113: scene=8DOT5
#: 8DOT5:4676
msgctxt "text_id=12113 | speaker=unknown"
msgid "　一義は喜実國の手前、<鳶丸|むすこ>とは良好な親子関係だとアピールしているが、それも喜実國が床に臥せるか、喜実國が本格的に鳶丸を跡継ぎにすると言いだすまでだ。"
msgstr ""

#. Occurrence 8DOT5:4681:12114: scene=8DOT5
#: 8DOT5:4681
msgctxt "text_id=12114 | speaker=unknown"
msgid "　その後は戦争である。"
msgstr ""

#. Occurrence 8DOT5:4686:12115: scene=8DOT5
#: 8DOT5:4686
msgctxt "text_id=12115 | speaker=unknown"
msgid "　どちらにせよろくな話にはならないだろう。"
msgstr ""

#. Occurrence 8DOT5:4710:12116: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0004; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4710
msgctxt "text_id=12116 | speaker=tobimaru"
msgid "「……<祖|じ><父|い>さんも空気読めねぇからなあ、ホント」"
msgstr ""

#. Occurrence 8DOT5:4716:12117: scene=8DOT5
#: 8DOT5:4716
msgctxt "text_id=12117 | speaker=unknown"
msgid "　呆れながらバリバリと頭を掻く。"
msgstr ""

#. Occurrence 8DOT5:4721:12118: scene=8DOT5
#: 8DOT5:4721
msgctxt "text_id=12118 | speaker=unknown"
msgid "　といっても、鳶丸はさして苦には思っていなかった。"
msgstr ""

#. Occurrence 8DOT5:4755:12119: scene=8DOT5
#: 8DOT5:4755
msgctxt "text_id=12119 | speaker=unknown"
msgid "　表向きは仲の良い親子関係。"
msgstr ""

#. Occurrence 8DOT5:4760:12120: scene=8DOT5
#: 8DOT5:4760
msgctxt "text_id=12120 | speaker=unknown"
msgid "　裏では怨念うずまく相続争い。"
msgstr ""

#. Occurrence 8DOT5:4765:12121: scene=8DOT5
#: 8DOT5:4765
msgctxt "text_id=12121 | speaker=unknown"
msgid "　そんなもの、別に喜実國と出会う前と変わらない。"
msgstr ""

#. Occurrence 8DOT5:4785:12122: scene=8DOT5
#: 8DOT5:4785
msgctxt "text_id=12122 | speaker=unknown"
msgid "　今まで唯一の<擁護者|ようごしゃ>だった父親が最大の敵にまわっただけだ。"
msgstr ""

#. Occurrence 8DOT5:4790:12123: scene=8DOT5
#: 8DOT5:4790
msgctxt "text_id=12123 | speaker=unknown"
msgid "　家族と良質な関係を結ばなかった鳶丸にとって、いまさら敵がひとり増えたところで何をかいわんや、という境地である。"
msgstr ""

#. Occurrence 8DOT5:4822:12124: scene=8DOT5
#: 8DOT5:4822
msgctxt "text_id=12124 | speaker=unknown"
msgid "　鳶丸がこうして朝帰りを繰り返すのは、親戚一同との顔合わせを避けるためだ。"
msgstr ""

#. Occurrence 8DOT5:4827:12125: scene=8DOT5
#: 8DOT5:4827
msgctxt "text_id=12125 | speaker=unknown"
msgid "　今ではあちらが鳶丸の顔色を<窺|うかが>っている。"
msgstr ""

#. Occurrence 8DOT5:4847:12126: scene=8DOT5
#: 8DOT5:4847
msgctxt "text_id=12126 | speaker=unknown"
msgid "　見下していた親戚たちも、"
msgstr ""

#. Occurrence 8DOT5:4852:12127: scene=8DOT5
#: 8DOT5:4852
msgctxt "text_id=12127 | speaker=unknown"
msgid "　<戯|たわむ>れに暴力をふるってきた兄姉たちも、今では表だっての攻撃はしてこない。"
msgstr ""

#. Occurrence 8DOT5:4857:12128: scene=8DOT5
#: 8DOT5:4857
msgctxt "text_id=12128 | speaker=unknown"
msgid "　せいぜい嫌味を言う程度だ。"
msgstr ""

#. Occurrence 8DOT5:4885:12129: scene=8DOT5
#: 8DOT5:4885
msgctxt "text_id=12129 | speaker=unknown"
msgid "　鳶丸は基本、平和主義者である。"
msgstr ""

#. Occurrence 8DOT5:4890:12130: scene=8DOT5
#: 8DOT5:4890
msgctxt "text_id=12130 | speaker=unknown"
msgid "　面倒ごとは避けて通るのが信条だ。"
msgstr ""

#. Occurrence 8DOT5:4895:12131: scene=8DOT5
#: 8DOT5:4895
msgctxt "text_id=12131 | speaker=unknown"
msgid "　なので、今までの意趣返しをする気も、喜実國の期待に応えるつもりもない。"
msgstr ""

#. Occurrence 8DOT5:4900:12132: scene=8DOT5
#: 8DOT5:4900
msgctxt "text_id=12132 | speaker=unknown"
msgid "　<一義|ちち>の不安は杞憂であり、親戚たちは勝手に踊っているだけであり、鳶丸は放蕩息子の域から出るつもりは毛頭無い。"
msgstr ""

#. Occurrence 8DOT5:4920:12133: scene=8DOT5
#: 8DOT5:4920
msgctxt "text_id=12133 | speaker=unknown"
msgid "　しかし。その一方で、歳の近い兄弟たちは、父親たちとは違う憎しみを帯びていた。"
msgstr ""

#. Occurrence 8DOT5:4925:12134: scene=8DOT5
#: 8DOT5:4925
msgctxt "text_id=12134 | speaker=unknown"
msgid "　今まで迫害してきた負い目、あるいは立場の逆転からくる反動だろう。"
msgstr ""

#. Occurrence 8DOT5:4930:12135: scene=8DOT5
#: 8DOT5:4930
msgctxt "text_id=12135 | speaker=unknown"
msgid "『きっと、いつかやり返される』"
msgstr ""

#. Occurrence 8DOT5:4935:12136: scene=8DOT5
#: 8DOT5:4935
msgctxt "text_id=12136 | speaker=unknown"
msgid "　そう怯える彼らには、もう、鳶丸を無視する事はできないらしい。"
msgstr ""

#. Occurrence 8DOT5:4977:12137: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0005; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4977
msgctxt "text_id=12137 | speaker=tobimaru"
msgid "「……そのクセ根回しはうまくねえときた。"
msgstr ""

#. Occurrence 8DOT5:4983:12138: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0006; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4983
msgctxt "text_id=12138 | speaker=tobimaru"
msgid "　蒼崎ぐらいの大胆さでつっこんでくるんなら、まだスリルがあるってもんだがな」"
msgstr ""

#. Occurrence 8DOT5:5003:12139: scene=8DOT5
#: 8DOT5:5003
msgctxt "text_id=12139 | speaker=unknown"
msgid "　鳶丸にとって、家庭の問題はただ面倒なだけで、あれこれ悩むものではない。"
msgstr ""

#. Occurrence 8DOT5:5008:12140: scene=8DOT5
#: 8DOT5:5008
msgctxt "text_id=12140 | speaker=unknown"
msgid "　もう人間の悪意には慣れている。"
msgstr ""

#. Occurrence 8DOT5:5013:12141: scene=8DOT5
#: 8DOT5:5013
msgctxt "text_id=12141 | speaker=unknown"
msgid "　いきすぎた<兄姉|きょうだい>の暴力で死にかけた事も、"
msgstr ""

#. Occurrence 8DOT5:5018:12142: scene=8DOT5
#: 8DOT5:5018
msgctxt "text_id=12142 | speaker=unknown"
msgid "　明確な意志のもと、殺されかけた事もある。"
msgstr ""

#. Occurrence 8DOT5:5023:12143: scene=8DOT5
#: 8DOT5:5023
msgctxt "text_id=12143 | speaker=unknown"
msgid "　特権階級、選民思想にこりかたまった長兄の顕示欲から、他人の命を扱う現場を見せつけられた事もある。"
msgstr ""

#. Occurrence 8DOT5:5056:12144: scene=8DOT5
#: 8DOT5:5056
msgctxt "text_id=12144 | speaker=unknown"
msgid "　……まったく面倒くさい。"
msgstr ""

#. Occurrence 8DOT5:5061:12145: scene=8DOT5
#: 8DOT5:5061
msgctxt "text_id=12145 | speaker=unknown"
msgid "　どれも人生観を変える衝撃だったが、心の底はいつも冷めていた。"
msgstr ""

#. Occurrence 8DOT5:5066:12146: scene=8DOT5
#: 8DOT5:5066
msgctxt "text_id=12146 | speaker=unknown"
msgid "　そんなものか、と。"
msgstr ""

#. Occurrence 8DOT5:5071:12147: scene=8DOT5
#: 8DOT5:5071
msgctxt "text_id=12147 | speaker=unknown"
msgid "　そんなことのためにこの連中は躍起になっているのかと、鳶丸は白けてしまったのだ。"
msgstr ""

#. Occurrence 8DOT5:5100:12148: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0007; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5100
msgctxt "text_id=12148 | speaker=tobimaru"
msgid "「……ま、そのあたりは人それぞれか。"
msgstr ""

#. Occurrence 8DOT5:5106:12149: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0008; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5106
msgctxt "text_id=12149 | speaker=tobimaru"
msgid "　親父殿には同情するけどな。あの<祖|じ><父|い>さんの息子なんて並の根性じゃつとまらねえ」"
msgstr ""

#. Occurrence 8DOT5:5139:12150: scene=8DOT5
#: 8DOT5:5139
msgctxt "text_id=12150 | speaker=unknown"
msgid "　後継者問題なぞ鳶丸にはどうでもいい。"
msgstr ""

#. Occurrence 8DOT5:5144:12151: scene=8DOT5
#: 8DOT5:5144
msgctxt "text_id=12151 | speaker=unknown"
msgid "　彼にはまだ、明確な将来への展望はない。"
msgstr ""

#. Occurrence 8DOT5:5149:12152: scene=8DOT5
#: 8DOT5:5149
msgctxt "text_id=12152 | speaker=unknown"
msgid "　あるとしたら、二十歳になった時に彼らが信じる価値観をキレイサッパリ捨てて、あっさり自由になる事ぐらいだ。"
msgstr ""

#. Occurrence 8DOT5:5169:12153: scene=8DOT5
#: 8DOT5:5169
msgctxt "text_id=12153 | speaker=unknown"
msgid "　それまでは何事も人生経験。"
msgstr ""

#. Occurrence 8DOT5:5174:12154: scene=8DOT5
#: 8DOT5:5174
msgctxt "text_id=12154 | speaker=unknown"
msgid "　くだらない夜遊びも今のうちにちゃっかり楽しんでおこう、と自虐気味に朝の遊歩道をそぞろ歩くのだった。"
msgstr ""

#. Occurrence 8DOT5:5206:12155: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0009; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5206
msgctxt "text_id=12155 | speaker=tobimaru"
msgid "「お？」"
msgstr ""

#. Occurrence 8DOT5:5212:12156: scene=8DOT5
#: 8DOT5:5212
msgctxt "text_id=12156 | speaker=unknown"
msgid "　遊歩道から広場に出ると、ベンチには先客の姿があった。"
msgstr ""

#. Occurrence 8DOT5:5218:12157: scene=8DOT5
#: 8DOT5:5218
msgctxt "text_id=12157 | speaker=unknown"
msgid "　広場にたむろしていた、<鴉|からす>に似た黒鳥が舞い散っていく。"
msgstr ""

#. Occurrence 8DOT5:5223:12158: scene=8DOT5
#: 8DOT5:5223
msgctxt "text_id=12158 | speaker=unknown"
msgid "　ベンチに座っているのは黒い服の少女と、"
msgstr ""

#. Occurrence 8DOT5:5228:12159: scene=8DOT5
#: 8DOT5:5228
msgctxt "text_id=12159 | speaker=unknown"
msgid "　杖を手にうなだれている、身なりのいい老人だ。"
msgstr ""

#. Occurrence 8DOT5:5255:12160: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0010; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5255
msgctxt "text_id=12160 | speaker=tobimaru"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:5261:12161: scene=8DOT5
#: 8DOT5:5261
msgctxt "text_id=12161 | speaker=unknown"
msgid "　知らぬ顔でもなし、出くわしたからには挨拶をしなくてはなるまい、と鳶丸はベンチへと足を向けた。"
msgstr ""

#. Occurrence 8DOT5:5296:12162: scene=8DOT5
#: 8DOT5:5296
msgctxt "text_id=12162 | speaker=unknown"
msgid "　少女と老人は、傍から見れば祖父と孫のようだった。"
msgstr ""

#. Occurrence 8DOT5:5301:12163: scene=8DOT5
#: 8DOT5:5301
msgctxt "text_id=12163 | speaker=unknown"
msgid "　パッと見は孫の相手をしている心優しい老人。"
msgstr ""

#. Occurrence 8DOT5:5306:12164: scene=8DOT5
#: 8DOT5:5306
msgctxt "text_id=12164 | speaker=unknown"
msgid "　しかし、その実態は、"
msgstr ""

#. Occurrence 8DOT5:5342:12165: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0000; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5342
msgctxt "text_id=12165 | speaker=yurihiko"
msgid "「アリス、ボクは今でも思うんだ。いったい何がいけなかったのかって。"
msgstr ""

#. Occurrence 8DOT5:5348:12166: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0001; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5348
msgctxt "text_id=12166 | speaker=yurihiko"
msgid "　考えられるサービスはすべて実現させた。従業員への感謝も、来園者への笑顔も忘れたコトはない。"
msgstr ""

#. Occurrence 8DOT5:5354:12167: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0002; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5354
msgctxt "text_id=12167 | speaker=yurihiko"
msgid "　なのに時代はボクを選ばなかった。それどころか、ボクの内なる芸術性を否定した」"
msgstr ""

#. Occurrence 8DOT5:5389:12168: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0003; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5389
msgctxt "text_id=12168 | speaker=yurihiko"
msgid "「無念だ、死ぬがいい腐った魚のようなマスコミどもめ！"
msgstr ""

#. Occurrence 8DOT5:5395:12169: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0004; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5395
msgctxt "text_id=12169 | speaker=yurihiko"
msgid "　何が悪夢のクリーチャーか、あんな、夢にまで見そうなマスコットが他にあるだろうか？　いやあるまい。"
msgstr ""

#. Occurrence 8DOT5:5402:12170: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0005; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5402
msgctxt "text_id=12170 | speaker=yurihiko"
msgid "なのに連中ときたら、ネズミを二足歩行させれば満足ときた！"
msgstr ""

#. Occurrence 8DOT5:5413:12171: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0006; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5413
msgctxt "text_id=12171 | speaker=yurihiko"
msgid "　そもそも犬をペットにする<齧歯|げっし>類とか、冷静に考えたら怖いぞ。動物が動物をペットにするなんて、モラルが低いにも程がある。あそこはやはり、人間をペットにするべきじゃないんだろうか？」"
msgstr ""

#. Occurrence 8DOT5:5447:12172: scene=8DOT5
#: 8DOT5:5447
msgctxt "text_id=12172 | speaker=unknown"
msgid "　しかして、その実態は。"
msgstr ""

#. Occurrence 8DOT5:5452:12173: scene=8DOT5
#: 8DOT5:5452
msgctxt "text_id=12173 | speaker=unknown"
msgid "　かくも厄介な老人にからまれている、悲劇の少女の図なのだった。"
msgstr ""

#. Occurrence 8DOT5:5458:12174: scene=8DOT5
#: 8DOT5:5458
msgctxt "text_id=12174 | speaker=unknown"
msgid "老人は激した後、"
msgstr ""

#. Occurrence 8DOT5:5470:12175: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0007; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5470
msgctxt "text_id=12175 | speaker=yurihiko"
msgid "「いや、これは失礼。<由里彦|ゆりひこ>よ、紳士たれ」"
msgstr ""

#. Occurrence 8DOT5:5476:12176: scene=8DOT5
#: 8DOT5:5476
msgctxt "text_id=12176 | speaker=unknown"
msgid "　と自らに言い聞かせて、力なくうなだれる。"
msgstr ""

#. Occurrence 8DOT5:5511:12177: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0008; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5511
msgctxt "text_id=12177 | speaker=yurihiko"
msgid "「答えてくれアリス。いったい、ボクのキッツィーちゃんは何がいけなかったんだ？」"
msgstr ""

#. Occurrence 8DOT5:5533:12178: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0012; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5533
msgctxt "text_id=12178 | speaker=alice"
msgid "「角よ。角をつけるべきだったのよ」"
msgstr ""

#. Occurrence 8DOT5:5539:12179: scene=8DOT5
#: 8DOT5:5539
msgctxt "text_id=12179 | speaker=unknown"
msgid "　うなだれる老人の顔を覗きこみながら、黒衣の少女は真剣に返答する。"
msgstr ""

#. Occurrence 8DOT5:5574:12180: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0009; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5574
msgctxt "text_id=12180 | speaker=yurihiko"
msgid "「いや、角はいけない。子供たちが怪我をしてしまうからね。ボクは、傷をつけるなら体ではなく心にしたい」"
msgstr ""

#. Occurrence 8DOT5:5580:12181: scene=8DOT5
#: 8DOT5:5580
msgctxt "text_id=12181 | speaker=unknown"
msgid "　<含蓄|がんちく>のある言葉ね、と更に真剣に頷く少女。"
msgstr ""

#. Occurrence 8DOT5:5613:12182: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0011; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5613
msgctxt "text_id=12182 | speaker=tobimaru"
msgid "「…………さて」"
msgstr ""

#. Occurrence 8DOT5:5619:12183: scene=8DOT5
#: 8DOT5:5619
msgctxt "text_id=12183 | speaker=unknown"
msgid "　あの組み合わせには関わりたくない鳶丸だが、もう完全に射程圏内だ。"
msgstr ""

#. Occurrence 8DOT5:5624:12184: scene=8DOT5
#: 8DOT5:5624
msgctxt "text_id=12184 | speaker=unknown"
msgid "　このまま無視して通り過ぎれば、少女はともかく老人の方がうるさく文句を言ってくるだろう。"
msgstr ""

#. Occurrence 8DOT5:5663:12185: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0012; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5663
msgctxt "text_id=12185 | speaker=tobimaru"
msgid "「こんちは。こんな朝っぱらからジクジク後悔中かい、<土桔|ときつ>の爺さん。いつまでも引きずってると死に損なうぜ。さっさと<往生|おうじょう>して、息子たちを安心させてやんな」"
msgstr ""

#. Occurrence 8DOT5:5672:12186: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0010; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5672
msgctxt "text_id=12186 | speaker=yurihiko"
msgid "「おや、どこの悪ガキかと思えば<夜鷹|よたか>の子供か。"
msgstr ""

#. Occurrence 8DOT5:5678:12187: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0011; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5678
msgctxt "text_id=12187 | speaker=yurihiko"
msgid "　おはようトビー。君も、あいかわらず早起きだね」"
msgstr ""

#. Occurrence 8DOT5:5705:12188: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0013; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5705
msgctxt "text_id=12188 | speaker=tobimaru"
msgid "「俺は朝帰りですよ。お二人みたいに健康的じゃあない。"
msgstr ""

#. Occurrence 8DOT5:5711:12189: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0014; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5711
msgctxt "text_id=12189 | speaker=tobimaru"
msgid "　そら、久遠寺のお嬢さんもおはようさん」"
msgstr ""

#. Occurrence 8DOT5:5717:12190: scene=8DOT5
#: 8DOT5:5717
msgctxt "text_id=12190 | speaker=unknown"
msgid "　鳶丸の挨拶を聞いて、少女は静かに顔を上げる。"
msgstr ""

#. Occurrence 8DOT5:5736:12191: scene=8DOT5
#: 8DOT5:5736
msgctxt "text_id=12191 | speaker=unknown"
msgid "　ベンチに座っていたのは丘の上の魔女、久遠寺有珠その人だ。"
msgstr ""

#. Occurrence 8DOT5:5769:12192: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0015; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5769
msgctxt "text_id=12192 | speaker=tobimaru"
msgid "「ん？　こうしてまともに挨拶するのは二年前のパーティー以来か？　なんにせよ珍しいな。アンタがお付きなしで町に下りて来てるなんてよ」"
msgstr ""

#. Occurrence 8DOT5:5790:12193: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0013; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5790
msgctxt "text_id=12193 | speaker=alice"
msgid "「……そうでもないわ。この時間の公園は鳥を入れ替えるのにちょうどいいから。ひとりで、散歩によく使うの」"
msgstr ""

#. Occurrence 8DOT5:5817:12194: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0016; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5817
msgctxt "text_id=12194 | speaker=tobimaru"
msgid "「ほう、そりゃ驚いた。箱入り娘じゃなかったのか、アンタ」"
msgstr ""

#. Occurrence 8DOT5:5829:12195: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0014; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5829
msgctxt "text_id=12195 | speaker=alice"
msgid "「ええ。その証拠に、貴方がひどい顔で歩いているのを何度か見かけたわ。"
msgstr ""

#. Occurrence 8DOT5:5836:12196: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0015; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5836
msgctxt "text_id=12196 | speaker=alice"
msgid "……遊び歩くのは結構だけど、青子に迷惑かけないよう気をつけなさい」"
msgstr ""

#. Occurrence 8DOT5:5863:12197: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0017; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5863
msgctxt "text_id=12197 | speaker=tobimaru"
msgid "「ご忠告どうも。肝に<銘|めい>じておくよ」"
msgstr ""

#. Occurrence 8DOT5:5896:12198: scene=8DOT5
#: 8DOT5:5896
msgctxt "text_id=12198 | speaker=unknown"
msgid "　気軽に挨拶を交わしたものの、鳶丸は久遠寺有珠とそこまでの面識はない。父親たちに交友があるだけだ。"
msgstr ""

#. Occurrence 8DOT5:5901:12199: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12199 | speaker=unknown"
msgid "　と言っても、"
msgstr ""

#. Occurrence 8DOT5:5901:12200: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12200 | speaker=unknown"
msgid "　あくまで三咲市限定の有力者である槻司と、"
msgstr ""

#. Occurrence 8DOT5:5901:12201: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12201 | speaker=unknown"
msgid "　日本全国に広がる久遠寺では規模も歴史も違う。"
msgstr ""

#. Occurrence 8DOT5:5921:12202: scene=8DOT5
#: 8DOT5:5921
msgctxt "text_id=12202 | speaker=unknown"
msgid "　本来なら久遠寺有珠は槻司鳶丸をしても身分違いの相手である。"
msgstr ""

#. Occurrence 8DOT5:5926:12203: scene=8DOT5
#: 8DOT5:5926
msgctxt "text_id=12203 | speaker=unknown"
msgid "　その有珠とこうして話せるのも、蒼崎青子という共通の友人がいるおかげだろう。"
msgstr ""

#. Occurrence 8DOT5:5966:12204: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0012; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5966
msgctxt "text_id=12204 | speaker=yurihiko"
msgid "「バカな。トビー、君はアリスと友人関係だったのか。"
msgstr ""

#. Occurrence 8DOT5:5979:12205: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0013; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5979
msgctxt "text_id=12205 | speaker=yurihiko"
msgid "　は!?　も、ももも、ももももしかして、二人はステディな関係だとか言うまいな？"
msgstr ""

#. Occurrence 8DOT5:5991:12206: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0014; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5991
msgctxt "text_id=12206 | speaker=yurihiko"
msgid "　やめたまえ。言ったら大事になるぞトビー。ボクは心臓麻痺で急死しかねない。犯人は君であり、凶器はアリスだ。"
msgstr ""

#. Occurrence 8DOT5:6002:12207: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0015; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6002
msgctxt "text_id=12207 | speaker=yurihiko"
msgid "　無論、死因はこう書いてくれ。"
msgstr ""

#. Occurrence 8DOT5:6002:12208: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0015; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6002
msgctxt "text_id=12208 | speaker=yurihiko"
msgid "　そう、聞くも無情な、恋の、<病|やまい>と―――」"
msgstr ""

#. Occurrence 8DOT5:6029:12209: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0018; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6029
msgctxt "text_id=12209 | speaker=tobimaru"
msgid "「久遠寺のお嬢さんはどうしてこんなダメ老人と？"
msgstr ""

#. Occurrence 8DOT5:6035:12210: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0019; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6035
msgctxt "text_id=12210 | speaker=tobimaru"
msgid "　俺と同じ、親父関係の付き合いか？」"
msgstr ""

#. Occurrence 8DOT5:6047:12211: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0016; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6047
msgctxt "text_id=12211 | speaker=alice"
msgid "「この人とはペンフレンド。"
msgstr ""

#. Occurrence 8DOT5:6053:12212: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0017; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6053
msgctxt "text_id=12212 | speaker=alice"
msgid "　分不相応にいいアンティークを持っているから、青子と二人で少しずつとりあげているの」"
msgstr ""

#. Occurrence 8DOT5:6059:12213: scene=8DOT5
#: 8DOT5:6059
msgctxt "text_id=12213 | speaker=unknown"
msgid "　ほぼ初対面でありながら、鳶丸と有珠は抜群のコンビネーションで老人をスルーする。"
msgstr ""

#. Occurrence 8DOT5:6096:12214: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0016; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6096
msgctxt "text_id=12214 | speaker=yurihiko"
msgid "「はは、まいったな、アリスは照れ隠しもチャーミングだ。"
msgstr ""

#. Occurrence 8DOT5:6102:12215: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0017; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6102
msgctxt "text_id=12215 | speaker=yurihiko"
msgid "　ところで、ボクのことはユーリッヒと呼んでくれていいんだよ」"
msgstr ""

#. Occurrence 8DOT5:6107:12216: scene=8DOT5
#: 8DOT5:6107
msgctxt "text_id=12216 | speaker=unknown"
msgid "　そっと有珠の手を握る土桔老人。"
msgstr ""

#. Occurrence 8DOT5:6127:12217: scene=8DOT5
#: 8DOT5:6127
msgctxt "text_id=12217 | speaker=unknown"
msgid "　有珠は人形のような仕草で、"
msgstr ""

#. Occurrence 8DOT5:6146:12218: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0018; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6146
msgctxt "text_id=12218 | speaker=alice"
msgid "「トッキィー。わたし、いい絵付けのティーカップを探しているの。1900年代の、ラム工房のものとか、どうかしら」"
msgstr ""

#. Occurrence 8DOT5:6152:12219: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0018; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6152
msgctxt "text_id=12219 | speaker=yurihiko"
msgid "「あるとも。もちろんあるとも。今度、あのおっかないお友達と遊びにくる時までに用意しておこう」"
msgstr ""

#. Occurrence 8DOT5:6158:12220: scene=8DOT5
#: 8DOT5:6158
msgctxt "text_id=12220 | speaker=unknown"
msgid "　このように、老人の下心を華麗に誘導するのだった。"
msgstr ""

#. Occurrence 8DOT5:6190:12221: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0020; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6190
msgctxt "text_id=12221 | speaker=tobimaru"
msgid "「老いらくの恋って柄かよ。よくもまあ<身代|しんだい>潰さなかったもんだ、トッパンは」"
msgstr ""

#. Occurrence 8DOT5:6208:12222: scene=8DOT5
#: 8DOT5:6208
msgctxt "text_id=12222 | speaker=unknown"
msgid "　そう。"
msgstr ""

#. Occurrence 8DOT5:6223:12223: scene=8DOT5
#: 8DOT5:6223
msgctxt "text_id=12223 | speaker=unknown"
msgid "　この老人こそ<社木|やしろぎ>の名士であり、全国に多くの工場をかまえる土桔製パン株式会社の<元|もと>総帥にして、<現|げん>相談役の<土桔|ときつ><由|ゆ><里彦|りひこ>翁その人なのである。"
msgstr ""

#. Occurrence 8DOT5:6258:12224: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0019; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6258
msgctxt "text_id=12224 | speaker=yurihiko"
msgid "「老人とはなんだ。芸術家にとっての老いとは感性の凍結であり、しかるに我が心の火は絶えていない。"
msgstr ""

#. Occurrence 8DOT5:6270:12225: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0020; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6270
msgctxt "text_id=12225 | speaker=yurihiko"
msgid "ボクはまだ暑苦しいくらいに若いんだ。<蕾|つぼみ>のような少女と恋を語らう楽しみは残っているさ。"
msgstr ""

#. Occurrence 8DOT5:6281:12226: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0021; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6281
msgctxt "text_id=12226 | speaker=yurihiko"
msgid "　ははは、この歳になるともう世間体とかどうでもよくてね。女の子と話すことだけが人生の意味になるんだぞう」"
msgstr ""

#. Occurrence 8DOT5:6299:12227: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0021; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6299
msgctxt "text_id=12227 | speaker=tobimaru"
msgid "「若いのか爺さんなのか、どっちなんだよ」"
msgstr ""

#. Occurrence 8DOT5:6333:12228: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0022; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6333
msgctxt "text_id=12228 | speaker=yurihiko"
msgid "「おっと失言失言、最後の方のは聞き流してくれ。"
msgstr ""

#. Occurrence 8DOT5:6345:12229: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0023; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6345
msgctxt "text_id=12229 | speaker=yurihiko"
msgid "　ボクが言いたいのは、女の子と穏やかな時間を過ごすのは最高ってコトさ。"
msgstr ""

#. Occurrence 8DOT5:6358:12230: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0024; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6358
msgctxt "text_id=12230 | speaker=yurihiko"
msgid "トビー。そういうの、君も好きだろ？」"
msgstr ""

#. Occurrence 8DOT5:6393:12231: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0022; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6393
msgctxt "text_id=12231 | speaker=tobimaru"
msgid "「一緒にしないでください、あいにく俺は年上好みですよ。"
msgstr ""

#. Occurrence 8DOT5:6399:12232: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0023; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6399
msgctxt "text_id=12232 | speaker=tobimaru"
msgid "　おまけに言うなら、二回り以上も年下の女に欲情する趣味もねえワケで」"
msgstr ""

#. Occurrence 8DOT5:6411:12233: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0025; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6411
msgctxt "text_id=12233 | speaker=yurihiko"
msgid "「うん、それはそうだろう。君がやったら犯罪だ。"
msgstr ""

#. Occurrence 8DOT5:6417:12234: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0026; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6417
msgctxt "text_id=12234 | speaker=yurihiko"
msgid "　トビーは十七歳。その二回り下が何歳になるとか、口にだしたらいけないよ」"
msgstr ""

#. Occurrence 8DOT5:6437:12235: scene=8DOT5
#: 8DOT5:6437
msgctxt "text_id=12235 | speaker=unknown"
msgid "　うむ、と頷く土桔老人。"
msgstr ""

#. Occurrence 8DOT5:6442:12236: scene=8DOT5
#: 8DOT5:6442
msgctxt "text_id=12236 | speaker=unknown"
msgid "　鳶丸の無礼な発言もまったく気にしていない。"
msgstr ""

#. Occurrence 8DOT5:6452:12237: scene=8DOT5
#: 8DOT5:6452
msgctxt "text_id=12237 | speaker=unknown"
msgid "　これはこれで大人物なんだよなあ、とつい感心してしまう鳶丸だった。"
msgstr ""

#. Occurrence 8DOT5:6488:12238: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0024; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6488
msgctxt "text_id=12238 | speaker=tobimaru"
msgid "「ともかく挨拶はしましたから。邪魔者はこれで消えますよ。あとは仲良し同士、気兼ねなくどうぞ」"
msgstr ""

#. Occurrence 8DOT5:6499:12239: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0027; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6499
msgctxt "text_id=12239 | speaker=yurihiko"
msgid "「なんだトビー。これも縁だ、ゆっくりしていけばいい。"
msgstr ""

#. Occurrence 8DOT5:6499:12240: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0027; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6499
msgctxt "text_id=12240 | speaker=yurihiko"
msgid "　なんなら、今からボクの別荘に来るかね？　ヘリコ呼ぶよ？楽しいぞ？」"
msgstr ""

#. Occurrence 8DOT5:6526:12241: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0025; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6526
msgctxt "text_id=12241 | speaker=tobimaru"
msgid "「いや、お気持ちは嬉しいんですけどね。知る人が見ればとんでもなくブルジョワな面子でしょ、コレ。今は避けたい気分なんですよ、そういうの」"
msgstr ""

#. Occurrence 8DOT5:6546:12242: scene=8DOT5
#: 8DOT5:6546
msgctxt "text_id=12242 | speaker=unknown"
msgid "　鳶丸の言い回しで事情を察したのか、それは残念だ、と土桔老人は引き下がった。"
msgstr ""

#. Occurrence 8DOT5:6551:12243: scene=8DOT5
#: 8DOT5:6551
msgctxt "text_id=12243 | speaker=unknown"
msgid "　引退したとはいえ、こんなんでもトッパンを全国規模にまで発展させた偉人である。"
msgstr ""

#. Occurrence 8DOT5:6556:12244: scene=8DOT5
#: 8DOT5:6556
msgctxt "text_id=12244 | speaker=unknown"
msgid "　鳶丸の複雑な家庭環境を瞬時に察したのだろう。"
msgstr ""

#. Occurrence 8DOT5:6591:12245: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0028; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6591
msgctxt "text_id=12245 | speaker=yurihiko"
msgid "「ミックによろしく。そろそろ引退して子供たちと仲直りするよう、ボクが言っていたと伝えてくれ」"
msgstr ""

#. Occurrence 8DOT5:6609:12246: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0026; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6609
msgctxt "text_id=12246 | speaker=tobimaru"
msgid "「はいはい、<糠|ぬか>に釘だろうけど伝えておきますよ。"
msgstr ""

#. Occurrence 8DOT5:6620:12247: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0027; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6620
msgctxt "text_id=12247 | speaker=tobimaru"
msgid "　じゃあな久遠寺さん。また朝に出会うことがあったら、その時は改めて挨拶させてくれ」"
msgstr ""

#. Occurrence 8DOT5:6653:12248: scene=8DOT5
#: 8DOT5:6653
msgctxt "text_id=12248 | speaker=unknown"
msgid "　同意とも拒絶ともつかない無言の返答。"
msgstr ""

#. Occurrence 8DOT5:6658:12249: scene=8DOT5
#: 8DOT5:6658
msgctxt "text_id=12249 | speaker=unknown"
msgid "　それにやれやれと肩をすくめて、鳶丸は広場を後にした。"
msgstr ""

#. Occurrence 8DOT5:6737:12250: scene=8DOT5
#: 8DOT5:6737
msgctxt "text_id=12250 | speaker=unknown"
msgid "　公園を出て気ままに歩いていると、いつのまにか再開発地区にやってきていた。"
msgstr ""

#. Occurrence 8DOT5:6742:12251: scene=8DOT5
#: 8DOT5:6742
msgctxt "text_id=12251 | speaker=unknown"
msgid "　これは建設途中の電波塔で、この開発には槻司家も噛んでいるが、大部分の資金は外資企業からのものだった。"
msgstr ""

#. Occurrence 8DOT5:6775:12252: voice_id=D40_8DOT5_0000; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6775
msgctxt "text_id=12252 | speaker=unknown"
msgid "“この電波塔は十年先を見越しての物です。"
msgstr ""

#. Occurrence 8DOT5:6781:12253: voice_id=D40_8DOT5_0001; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6781
msgctxt "text_id=12253 | speaker=unknown"
msgid "　いずれ携帯通信は目まぐるしい進歩をとげるでしょう。"
msgstr ""

#. Occurrence 8DOT5:6787:12254: voice_id=D40_8DOT5_0002; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6787
msgctxt "text_id=12254 | speaker=unknown"
msgid "　まずはそのモデルケースとして、私どもの技術をミサキ市に普及させたいのです―――”"
msgstr ""

#. Occurrence 8DOT5:6807:12255: scene=8DOT5
#: 8DOT5:6807
msgctxt "text_id=12255 | speaker=unknown"
msgid "　外資企業から派遣された男は、そんなうたい文句で父、一義と握手を交わしていた。"
msgstr ""

#. Occurrence 8DOT5:6839:12256: voice_id=D40_8DOT5_0003; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6839
msgctxt "text_id=12256 | speaker=unknown"
msgid "“いずれは娘もミサキ市に住まわせようと思っています。"
msgstr ""

#. Occurrence 8DOT5:6845:12257: voice_id=D40_8DOT5_0004; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6845
msgctxt "text_id=12257 | speaker=unknown"
msgid "　その時は貴方の息子さんとも、ぜひ交友を深めて―――”"
msgstr ""

#. Occurrence 8DOT5:6865:12258: scene=8DOT5
#: 8DOT5:6865
msgctxt "text_id=12258 | speaker=unknown"
msgid "　白人特有の、穏やかな威圧感を持つ優男だった。"
msgstr ""

#. Occurrence 8DOT5:6870:12259: scene=8DOT5
#: 8DOT5:6870
msgctxt "text_id=12259 | speaker=unknown"
msgid "　自分の娘を鳶丸にあてがおうとするあたり、槻司家の相続問題も調査済みなのだろう。"
msgstr ""

#. Occurrence 8DOT5:6891:12260: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0028; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6891
msgctxt "text_id=12260 | speaker=tobimaru"
msgid "「親父も舐められてるって気付けよな。親父より先に俺に色目使いやがってクソヤンキーが。"
msgstr ""

#. Occurrence 8DOT5:6897:12261: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0029; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6897
msgctxt "text_id=12261 | speaker=tobimaru"
msgid "　そもそも金髪女の相手なんざ願い下げだぜ。向こうで海兵相手に<尻|ケツ>振ってろってんだ」"
msgstr ""

#. Occurrence 8DOT5:6928:12262: scene=8DOT5
#: 8DOT5:6928
msgctxt "text_id=12262 | speaker=unknown"
msgid "　そう愚痴をこぼすと鳶丸は足を止めた。"
msgstr ""

#. Occurrence 8DOT5:6933:12263: scene=8DOT5
#: 8DOT5:6933
msgctxt "text_id=12263 | speaker=unknown"
msgid "　本気の悪態が口から出るようではおしまいである。"
msgstr ""

#. Occurrence 8DOT5:6938:12264: scene=8DOT5
#: 8DOT5:6938
msgctxt "text_id=12264 | speaker=unknown"
msgid "　じゅうぶんに歩いたし、日も完全に昇ってしまった。"
msgstr ""

#. Occurrence 8DOT5:6943:12265: scene=8DOT5
#: 8DOT5:6943
msgctxt "text_id=12265 | speaker=unknown"
msgid "　これ以上の放浪は何ら得るものがない。"
msgstr ""

#. Occurrence 8DOT5:6964:12266: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0030; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6964
msgctxt "text_id=12266 | speaker=tobimaru"
msgid "「―――戻るか」"
msgstr ""

#. Occurrence 8DOT5:6971:12267: scene=8DOT5
#: 8DOT5:6971
msgctxt "text_id=12267 | speaker=unknown"
msgid "　建設途中の電波塔に背を向けて、鳶丸は家路につく。"
msgstr ""

#. Occurrence 8DOT5:7005:12268: scene=8DOT5
#: 8DOT5:7005
msgctxt "text_id=12268 | speaker=unknown"
msgid "　一時間後。"
msgstr ""

#. Occurrence 8DOT5:7011:12269: voice_id=G40_8DOT5_0000; voice_prefix=G40; voice_category=0; scene=8DOT5
#: 8DOT5:7011
msgctxt "text_id=12269 | speaker=unknown"
msgid "「坊ちゃん、お電話です」"
msgstr ""

#. Occurrence 8DOT5:7016:12270: scene=8DOT5
#: 8DOT5:7016
msgctxt "text_id=12270 | speaker=unknown"
msgid "　槻司の本邸に帰った鳶丸は、家政婦から受話器を受け取った。"
msgstr ""

#. Occurrence 8DOT5:7037:12271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0042; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7037
msgctxt "text_id=12271 | speaker=aoko"
msgid "『もしもし、鳶丸？　草十郎がこんなコトになってるんだけど、アンタ、心当たりない？』"
msgstr ""

#. Occurrence 8DOT5:7043:12272: scene=8DOT5
#: 8DOT5:7043
msgctxt "text_id=12272 | speaker=unknown"
msgid "　風雲急を告げる、蒼崎青子からの電話である。"
msgstr ""

#. Occurrence 8DOT5:7107:12273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0043; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7107
msgctxt "text_id=12273 | speaker=aoko"
msgid "「とまあ、こういう<事情|ワケ>なのよ」"
msgstr ""

#. Occurrence 8DOT5:7116:12274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0031; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7116
msgctxt "text_id=12274 | speaker=tobimaru"
msgid "「すげえな。安心できる要素がひとつもねえ」"
msgstr ""

#. Occurrence 8DOT5:7150:12275: scene=8DOT5
#: 8DOT5:7150
msgctxt "text_id=12275 | speaker=unknown"
msgid "“草十郎がおかしな<仕事|バイト>に<嵌|はま>っている模様。"
msgstr ""

#. Occurrence 8DOT5:7150:12276: scene=8DOT5
#: 8DOT5:7150
msgctxt "text_id=12276 | speaker=unknown"
msgid "　急遽相談に乗られたし。中央公園で待つ”"
msgstr ""

#. Occurrence 8DOT5:7182:12277: scene=8DOT5
#: 8DOT5:7182
msgctxt "text_id=12277 | speaker=unknown"
msgid "　そんな電話を受け、公園にとんぼ返りしてからはや十分。"
msgstr ""

#. Occurrence 8DOT5:7187:12278: scene=8DOT5
#: 8DOT5:7187
msgctxt "text_id=12278 | speaker=unknown"
msgid "　ある意味、いつかは起こるだろう、と危惧していた状況を聞かされ、槻司鳶丸は軽い<偏頭痛|へんずつう>に襲われた。"
msgstr ""

#. Occurrence 8DOT5:7192:12279: scene=8DOT5
#: 8DOT5:7192
msgctxt "text_id=12279 | speaker=unknown"
msgid "　ちなみに、ベンチに少女と老人の姿はない。"
msgstr ""

#. Occurrence 8DOT5:7223:12280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0044; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7223
msgctxt "text_id=12280 | speaker=aoko"
msgid "「そんなコト言われるまでもなく分かってるわよ。"
msgstr ""

#. Occurrence 8DOT5:7229:12281: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0045; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7229
msgctxt "text_id=12281 | speaker=aoko"
msgid "　私だって人のアルバイトにケチつけたくないけど、どう考えても普通じゃないでしょ？"
msgstr ""

#. Occurrence 8DOT5:7240:12282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0046; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7240
msgctxt "text_id=12282 | speaker=aoko"
msgid "　アンタ、アイツから何か聞いてない？」"
msgstr ""

#. Occurrence 8DOT5:7258:12283: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0032; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7258
msgctxt "text_id=12283 | speaker=tobimaru"
msgid "「悪いな、期待には応えられん。草十郎はバイトに関しちゃ秘密主義だ。任されているからには他言はできない、とかなんとかな」"
msgstr ""

#. Occurrence 8DOT5:7291:12284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0047; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7291
msgctxt "text_id=12284 | speaker=aoko"
msgid "「……そうなのよね。アイツ、他人の事情に関しちゃ缶詰みたいに義理堅いから。ガキガキにされないかぎり口割らないのよ」"
msgstr ""

#. Occurrence 8DOT5:7309:12285: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0033; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7309
msgctxt "text_id=12285 | speaker=tobimaru"
msgid "「ほう、それはそれは。蒼崎にそこまで言わせるとはね。草十郎も信頼されたもんだ」"
msgstr ""

#. Occurrence 8DOT5:7344:12286: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0048; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7344
msgctxt "text_id=12286 | speaker=aoko"
msgid "「どういう意味よそれ」"
msgstr ""

#. Occurrence 8DOT5:7355:12287: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0034; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7355
msgctxt "text_id=12287 | speaker=tobimaru"
msgid "「他意はねえ、言葉通りに受け取ってくれ。"
msgstr ""

#. Occurrence 8DOT5:7361:12288: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0035; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7361
msgctxt "text_id=12288 | speaker=tobimaru"
msgid "　おまえ、基本的に何にだって怒るだろ。そんな女が学校外で世話をやくなんて、よっぽど気に入ったのかと思ってな」"
msgstr ""

#. Occurrence 8DOT5:7396:12289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0049; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7396
msgctxt "text_id=12289 | speaker=aoko"
msgid "「違うわよ。アイツが問題を起こしたら<生徒会|わたしたち>にまで飛び火するじゃない。"
msgstr ""

#. Occurrence 8DOT5:7402:12290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0050; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7402
msgctxt "text_id=12290 | speaker=aoko"
msgid "　こんなの、誰がどう見ても、ただのリスク回避でしょう」"
msgstr ""

#. Occurrence 8DOT5:7408:12291: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0036; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7408
msgctxt "text_id=12291 | speaker=tobimaru"
msgid "「なるほど、公務として見過ごせないってワケか」"
msgstr ""

#. Occurrence 8DOT5:7429:12292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0051; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7429
msgctxt "text_id=12292 | speaker=aoko"
msgid "「そうよ。悪い？」"
msgstr ""

#. Occurrence 8DOT5:7435:12293: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0037; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7435
msgctxt "text_id=12293 | speaker=tobimaru"
msgid "「いやぁ、悪かねえさ。むしろ尊敬するよ。"
msgstr ""

#. Occurrence 8DOT5:7441:12294: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0038; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7441
msgctxt "text_id=12294 | speaker=tobimaru"
msgid "　ほんと、鉄の生徒会長だぜ。休日だっていうのに学校の評判を守るため<だ|・><け|・>に働けるとは」"
msgstr ""

#. Occurrence 8DOT5:7472:12295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0052; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7472
msgctxt "text_id=12295 | speaker=aoko"
msgid "「だけ、ってところを妙に強調するじゃない。"
msgstr ""

#. Occurrence 8DOT5:7478:12296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0053; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7478
msgctxt "text_id=12296 | speaker=aoko"
msgid "　……まあ、事実その通りだけど」"
msgstr ""

#. Occurrence 8DOT5:7486:12297: scene=8DOT5
#: 8DOT5:7486
msgctxt "text_id=12297 | speaker=unknown"
msgid "　青子は何か文句でも？　と睨みを利かせた。"
msgstr ""

#. Occurrence 8DOT5:7491:12298: scene=8DOT5
#: 8DOT5:7491
msgctxt "text_id=12298 | speaker=unknown"
msgid "　すでに草十郎と青子の雑居を知っている鳶丸からすると、その虚勢はたいへん微笑ましい。"
msgstr ""

#. Occurrence 8DOT5:7524:12299: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0039; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7524
msgctxt "text_id=12299 | speaker=tobimaru"
msgid "「べっつにぃー。しかしま、そういうコトなら副会長として付き合わなくっちゃな。"
msgstr ""

#. Occurrence 8DOT5:7530:12300: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0040; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7530
msgctxt "text_id=12300 | speaker=tobimaru"
msgid "　会長は学校のために草十郎を調査する。"
msgstr ""

#. Occurrence 8DOT5:7537:12301: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0041; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7537
msgctxt "text_id=12301 | speaker=tobimaru"
msgid "俺はそのサポートをしつつ、友人として草十郎を気に掛けるってコトで」"
msgstr ""

#. Occurrence 8DOT5:7555:12302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0054; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7555
msgctxt "text_id=12302 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:7561:12303: scene=8DOT5
#: 8DOT5:7561
msgctxt "text_id=12303 | speaker=unknown"
msgid "　鳶丸の発言は<注文|オーダー>通りなのだが、なんとなく納得のいかない青子だった。"
msgstr ""

#. Occurrence 8DOT5:7597:12304: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0042; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7597
msgctxt "text_id=12304 | speaker=tobimaru"
msgid "「んじゃ、そうと決まればさっそく始めますか。"
msgstr ""

#. Occurrence 8DOT5:7603:12305: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0043; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7603
msgctxt "text_id=12305 | speaker=tobimaru"
msgid "　蒼崎のコトだから草十郎の<勤|つと>め先ぐらい突き止めてんだろ？住所どこだよ」"
msgstr ""

#. Occurrence 8DOT5:7630:12306: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0055; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7630
msgctxt "text_id=12306 | speaker=aoko"
msgid "「それが……尾行したんだけど、うまくまかれちゃって。"
msgstr ""

#. Occurrence 8DOT5:7636:12307: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0056; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7636
msgctxt "text_id=12307 | speaker=aoko"
msgid "　駅前から二丁目方面に曲がっていったのまでは確実なんだけど」"
msgstr ""

#. Occurrence 8DOT5:7647:12308: scene=8DOT5
#: 8DOT5:7647
msgctxt "text_id=12308 | speaker=unknown"
msgid "　さすが副会長、慣れたものである。"
msgstr ""

#. Occurrence 8DOT5:7652:12309: scene=8DOT5
#: 8DOT5:7652
msgctxt "text_id=12309 | speaker=unknown"
msgid "『尾行したのかよ』なんて<批難|ツッコミ>は当然スルー。"
msgstr ""

#. Occurrence 8DOT5:7686:12310: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0044; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7686
msgctxt "text_id=12310 | speaker=tobimaru"
msgid "「二丁目か……あのあたりだとパチンコとゲームセンターぐらいしか思い当たらねえな。一日に何万も稼げる店なんざねえぞ？」"
msgstr ""

#. Occurrence 8DOT5:7692:12311: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0057; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7692
msgctxt "text_id=12311 | speaker=aoko"
msgid "「そうなのよ。というか、知ってたら私が試したい気分だわ。"
msgstr ""

#. Occurrence 8DOT5:7711:12312: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0058; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7711
msgctxt "text_id=12312 | speaker=aoko"
msgid "　鳶丸。念のために訊くけど、三咲町にある“お金の稼げる遊び場”ってパチンコだけよね？」"
msgstr ""

#. Occurrence 8DOT5:7741:12313: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0045; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7741
msgctxt "text_id=12313 | speaker=tobimaru"
msgid "「ああ。親父の話じゃ風営法にひっかかる<賭|と><場|ば>はねえとさ。"
msgstr ""

#. Occurrence 8DOT5:7747:12314: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0046; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7747
msgctxt "text_id=12314 | speaker=tobimaru"
msgid "　三咲町の顔役は話の分かるおっさんで、クリーンな<極道|ごくどう>を目指してるらしい。パチンコ経営だけで満足してるって話だ」"
msgstr ""

#. Occurrence 8DOT5:7758:12315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0059; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7758
msgctxt "text_id=12315 | speaker=aoko"
msgid "「うん、それは知ってる。一応確認しただけ」"
msgstr ""

#. Occurrence 8DOT5:7810:12316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0060; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7810
msgctxt "text_id=12316 | speaker=aoko"
msgid "「でも、そうなるとますます謎ね。"
msgstr ""

#. Occurrence 8DOT5:7816:12317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0061; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7816
msgctxt "text_id=12317 | speaker=aoko"
msgid "　ギャンブル以外でお金を倍々にしていく仕事なんて、ちょっと思い当たらないんだけど」"
msgstr ""

#. Occurrence 8DOT5:7828:12318: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0047; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7828
msgctxt "text_id=12318 | speaker=tobimaru"
msgid "「ああ、体でも売ってるとしか思えない羽振りの良さだ。一晩いくら、みたいな」"
msgstr ""

#. Occurrence 8DOT5:7849:12319: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0062; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7849
msgctxt "text_id=12319 | speaker=aoko"
msgid "「―――へ？」"
msgstr ""

#. Occurrence 8DOT5:7869:12320: scene=8DOT5
#: 8DOT5:7869
msgctxt "text_id=12320 | speaker=unknown"
msgid "　間の抜けた声がもれる。"
msgstr ""

#. Occurrence 8DOT5:7874:12321: scene=8DOT5
#: 8DOT5:7874
msgctxt "text_id=12321 | speaker=unknown"
msgid "　理解するのに数瞬を必要としたのか、青子はぽかんと口を開けた。"
msgstr ""

#. Occurrence 8DOT5:7901:12322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0063; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7901
msgctxt "text_id=12322 | speaker=aoko"
msgid "「ちょっ、か、体って、あ、アンタ！」"
msgstr ""

#. Occurrence 8DOT5:7907:12323: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0048; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7907
msgctxt "text_id=12323 | speaker=tobimaru"
msgid "「ほら、絵画のモデルとか。バイト代は高いときくぜ」"
msgstr ""

#. Occurrence 8DOT5:7933:12324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0064; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7933
msgctxt "text_id=12324 | speaker=aoko"
msgid "「あ―――うん、割はいいって言うわね。美大生ってお金持ちだし。そうよね、それぐらいなら別に」"
msgstr ""

#. Occurrence 8DOT5:7939:12325: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0049; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7939
msgctxt "text_id=12325 | speaker=tobimaru"
msgid "「まあ、ヌードなのは当然だが」"
msgstr ""

#. Occurrence 8DOT5:7950:12326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0065; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7950
msgctxt "text_id=12326 | speaker=aoko"
msgid "「結局はだかじゃない！」"
msgstr ""

#. Occurrence 8DOT5:7983:12327: scene=8DOT5
#: 8DOT5:7983
msgctxt "text_id=12327 | speaker=unknown"
msgid "　決定的な情報を欠くため、話せば話すほど核心から遠ざかっていくようだ。"
msgstr ""

#. Occurrence 8DOT5:7988:12328: scene=8DOT5
#: 8DOT5:7988
msgctxt "text_id=12328 | speaker=unknown"
msgid "　アルバイトの種類も、"
msgstr ""

#. Occurrence 8DOT5:7993:12329: scene=8DOT5
#: 8DOT5:7993
msgctxt "text_id=12329 | speaker=unknown"
msgid "　アルバイトの現場も分からないのでは話にならない。"
msgstr ""

#. Occurrence 8DOT5:8024:12330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0066; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8024
msgctxt "text_id=12330 | speaker=aoko"
msgid "「明日、もう一度草十郎を尾行するしかないわね。二人がかりなら見失うコトもないだろうし」"
msgstr ""

#. Occurrence 8DOT5:8042:12331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0050; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8042
msgctxt "text_id=12331 | speaker=tobimaru"
msgid "「そうだな。他に手がかりもねえし、明日にするか。"
msgstr ""

#. Occurrence 8DOT5:8049:12332: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0051_0; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8049
msgctxt "text_id=12332 | speaker=tobimaru"
msgid "“草十郎の羽振りがいい”だけじゃどうしようも―――"
msgstr ""

#. Occurrence 8DOT5:8062:12333: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0051_1; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8062
msgctxt "text_id=12333 | speaker=tobimaru"
msgid "あん？　羽振りがいい？」"
msgstr ""

#. Occurrence 8DOT5:8082:12334: scene=8DOT5
#: 8DOT5:8082
msgctxt "text_id=12334 | speaker=unknown"
msgid "　む、と眉を寄せて思案する鳶丸。"
msgstr ""

#. Occurrence 8DOT5:8092:12335: scene=8DOT5
#: 8DOT5:8092
msgctxt "text_id=12335 | speaker=unknown"
msgid "　考えれば考えるほどイヤな予感が満ちていくのか、その<表|か><情|お>は苦虫をかみ潰したように険しくなっていく。"
msgstr ""

#. Occurrence 8DOT5:8128:12336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0067; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8128
msgctxt "text_id=12336 | speaker=aoko"
msgid "「どうしたの鳶丸。何か思い出した？」"
msgstr ""

#. Occurrence 8DOT5:8139:12337: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0052; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8139
msgctxt "text_id=12337 | speaker=tobimaru"
msgid "「……あー、ちょっとな。そういえば、最近妙に羽振りのいいバカがひとりいたなって。"
msgstr ""

#. Occurrence 8DOT5:8145:12338: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0053; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8145
msgctxt "text_id=12338 | speaker=tobimaru"
msgid "　そいつ、三日ぐらい前から金にあかして合コンし放題って話なんだが……頭の痛いコトに、草十郎と同じクラスのバカなんだよ、これが」"
msgstr ""

#. Occurrence 8DOT5:8179:12339: scene=8DOT5
#: 8DOT5:8179
msgctxt "text_id=12339 | speaker=unknown"
msgid "　数秒、沈黙。"
msgstr ""

#. Occurrence 8DOT5:8184:12340: scene=8DOT5
#: 8DOT5:8184
msgctxt "text_id=12340 | speaker=unknown"
msgid "　青子はなるほど、と心底<合点|がてん>がいったように頷いて、"
msgstr ""

#. Occurrence 8DOT5:8196:12341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0068; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8196
msgctxt "text_id=12341 | speaker=aoko"
msgid "「―――アイツね」"
msgstr ""

#. Occurrence 8DOT5:8202:12342: scene=8DOT5
#: 8DOT5:8202
msgctxt "text_id=12342 | speaker=unknown"
msgid "　さっそく捕まえに行きましょう、と公園を後にした。"
msgstr ""

#. Occurrence 8DOT5:8253:12343: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0000; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8253
msgctxt "text_id=12343 | speaker=kinomi"
msgid "「ちゃりーす！"
msgstr ""

#. Occurrence 8DOT5:8259:12344: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0001; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8259
msgctxt "text_id=12344 | speaker=kinomi"
msgid "　およびとあらば補習だろうと即サボり、遊びのお誘いだけは断らない<木|き><乃|の><美|み>クンでーす！」"
msgstr ""

#. Occurrence 8DOT5:8291:12345: scene=8DOT5
#: 8DOT5:8291
msgctxt "text_id=12345 | speaker=unknown"
msgid "　容疑者Ａはたやすく捕獲できた。"
msgstr ""

#. Occurrence 8DOT5:8296:12346: scene=8DOT5
#: 8DOT5:8296
msgctxt "text_id=12346 | speaker=unknown"
msgid "　ターゲットが赤点の補習で学校にいる事は、生徒会であるふたりには既知の事実だったからだ。"
msgstr ""

#. Occurrence 8DOT5:8301:12347: scene=8DOT5
#: 8DOT5:8301
msgctxt "text_id=12347 | speaker=unknown"
msgid "　鳶丸が女生徒に「ちょっといい話があるから出てきてくれ」と伝言を伝えてから約十分。"
msgstr ""

#. Occurrence 8DOT5:8306:12348: scene=8DOT5
#: 8DOT5:8306
msgctxt "text_id=12348 | speaker=unknown"
msgid "　木乃美<芳助|ほうすけ>は神速の早足で正門前にやってきた。"
msgstr ""

#. Occurrence 8DOT5:8346:12349: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0054; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8346
msgctxt "text_id=12349 | speaker=tobimaru"
msgid "「おう。補習中呼び出して悪かったな」"
msgstr ""

#. Occurrence 8DOT5:8358:12350: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0002; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8358
msgctxt "text_id=12350 | speaker=kinomi"
msgid "「別に悪くないぜー？　補習を口実にバイトをさぼってみたものの、やっぱり補習もかったるかったんで、出席だけとって保健室で寝てただけだし」"
msgstr ""

#. Occurrence 8DOT5:8384:12351: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0003; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8384
msgctxt "text_id=12351 | speaker=kinomi"
msgid "「んで、ちょうど暇してたところに殿下からコールだろ。"
msgstr ""

#. Occurrence 8DOT5:8384:12352: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0003; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8384
msgctxt "text_id=12352 | speaker=kinomi"
msgid "　豪遊できると飛んできたワケさ！」"
msgstr ""

#. Occurrence 8DOT5:8390:12353: scene=8DOT5
#: 8DOT5:8390
msgctxt "text_id=12353 | speaker=unknown"
msgid "　バチィ！とサムズアップでやる気をアピール。"
msgstr ""

#. Occurrence 8DOT5:8416:12354: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0055; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8416
msgctxt "text_id=12354 | speaker=tobimaru"
msgid "「そうか。てっきり外で遊び歩いてるかと思ったが、助かったぜ。おまえ、連日ゲームセンターに入り浸りだって聞いてたからよ」"
msgstr ""

#. Occurrence 8DOT5:8458:12355: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0004; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8458
msgctxt "text_id=12355 | speaker=kinomi"
msgid "「あー、あれね。ちょうど昨日ですっからかんよ。ゲーセンでおごりまくるのは気持ちいいけど、後に残るのは空しさばかりだよなあ。"
msgstr ""

#. Occurrence 8DOT5:8464:12356: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0005; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8464
msgctxt "text_id=12356 | speaker=kinomi"
msgid "　他校のヤンキーどもと仲良くなっても嬉しくねえっつうか、女っ気カイムというか。なんで女の子はゲーセンいやがるかねぇ」"
msgstr ""

#. Occurrence 8DOT5:8491:12357: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0006; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8491
msgctxt "text_id=12357 | speaker=kinomi"
msgid "「ま、それも過去の話だけどな。しょせんポッと湧いたあぶく銭、使っちまった金の話をしてもしょうがねえ。"
msgstr ""

#. Occurrence 8DOT5:8497:12358: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0007; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8497
msgctxt "text_id=12358 | speaker=kinomi"
msgid "　オレたちは明るく今の話をしよう。そうだろう、リッチな鳶丸クン。そのありあまる財力で、今日はボクを何処に連れて行ってくれるんだい？」"
msgstr ""

#. Occurrence 8DOT5:8509:12359: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0056; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8509
msgctxt "text_id=12359 | speaker=tobimaru"
msgid "「ああ。その前に、こちらの<御仁|ごじん>がおまえに話があるってよ」"
msgstr ""

#. Occurrence 8DOT5:8515:12360: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0008; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8515
msgctxt "text_id=12360 | speaker=kinomi"
msgid "「へ？」"
msgstr ""

#. Occurrence 8DOT5:8550:12361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0069; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8550
msgctxt "text_id=12361 | speaker=aoko"
msgid "「こんにちは木乃美君。"
msgstr ""

#. Occurrence 8DOT5:8556:12362: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0070; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8556
msgctxt "text_id=12362 | speaker=aoko"
msgid "　その、あぶく銭の話を聞かせてもらえるかしら」"
msgstr ""

#. Occurrence 8DOT5:8574:12363: scene=8DOT5
#: 8DOT5:8574
msgctxt "text_id=12363 | speaker=unknown"
msgid "　木乃美の表情が停止する。"
msgstr ""

#. Occurrence 8DOT5:8579:12364: scene=8DOT5
#: 8DOT5:8579
msgctxt "text_id=12364 | speaker=unknown"
msgid "　危険に敏感な彼は、この時点で自らの終わりを察したらしい。"
msgstr ""

#. Occurrence 8DOT5:8605:12365: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0009; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8605
msgctxt "text_id=12365 | speaker=kinomi"
msgid "「アノー。ボク、勉強シタインデ、戻ッテイイデショウカ？」"
msgstr ""

#. Occurrence 8DOT5:8626:12366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0071; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8626
msgctxt "text_id=12366 | speaker=aoko"
msgid "「もちろん。洗いざらい質問に答え終わったら戻っていいわよ。こっちも時間が惜しいから、スムーズな自白を期待するわ」"
msgstr ""

#. Occurrence 8DOT5:8652:12367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0072; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8652
msgctxt "text_id=12367 | speaker=aoko"
msgid "「それで、あぶく銭って何の話？"
msgstr ""

#. Occurrence 8DOT5:8658:12368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0073; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8658
msgctxt "text_id=12368 | speaker=aoko"
msgid "　貴方の月々のバイト料は二万円前後よね。その金額で三日近くも王様の真似事は難しいと思うのだけど」"
msgstr ""

#. Occurrence 8DOT5:8664:12369: scene=8DOT5
#: 8DOT5:8664
msgctxt "text_id=12369 | speaker=unknown"
msgid "　犯罪にでも手を染めた？　と続きそうな<質問|こえ>である。"
msgstr ""

#. Occurrence 8DOT5:8703:12370: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0010; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8703
msgctxt "text_id=12370 | speaker=kinomi"
msgid "「な、なんだよ、会長には関係ないだろー！"
msgstr ""

#. Occurrence 8DOT5:8709:12371: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0011; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8709
msgctxt "text_id=12371 | speaker=kinomi"
msgid "　そもそも自白って何デスカ。いきなり犯人扱いとか、いくらなんでも横暴じゃねえの？　つーか何の事件、これ？」"
msgstr ""

#. Occurrence 8DOT5:8744:12372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0074; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8744
msgctxt "text_id=12372 | speaker=aoko"
msgid "「まだ事件かどうかは何とも。最近お金の回りがいい生徒がいると聞いて、調べはじめたばかりだから。"
msgstr ""

#. Occurrence 8DOT5:8750:12373: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0075; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8750
msgctxt "text_id=12373 | speaker=aoko"
msgid "　毎日何万円ももらえる仕事なんて学生には目の毒だし、そういったアルバイトは学校側に報告されてないしね。"
msgstr ""

#. Occurrence 8DOT5:8756:12374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0076; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8756
msgctxt "text_id=12374 | speaker=aoko"
msgid "　生徒会として、危ない仕事だったら注意してあげないと」"
msgstr ""

#. Occurrence 8DOT5:8792:12375: scene=8DOT5
#: 8DOT5:8792
msgctxt "text_id=12375 | speaker=unknown"
msgid "　青子は微笑みをキープしたまま、じりじりと木乃美に近づいていく。"
msgstr ""

#. Occurrence 8DOT5:8797:12376: scene=8DOT5
#: 8DOT5:8797
msgctxt "text_id=12376 | speaker=unknown"
msgid "　木乃美にしてみれば、入学からこっち、青子にこれほど愛想良く話しかけられた事はなく、なんというか、もうそれだけで自らの死期を悟らざるを得ない状況だった。"
msgstr ""

#. Occurrence 8DOT5:8836:12377: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0012; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8836
msgctxt "text_id=12377 | speaker=kinomi"
msgid "「へ、へえ、それは初耳だなあ。最近金回りがいい生徒ねえ。"
msgstr ""

#. Occurrence 8DOT5:8842:12378: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0013; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8842
msgctxt "text_id=12378 | speaker=kinomi"
msgid "　あ、オレのは違うよ。今まで貯めた貯金をなんとなく使っただけ。クリスマス前だから、こう派手に<浄財|じょうざい>しとこうかなって。<厄|やく>落とし的に？」"
msgstr ""

#. Occurrence 8DOT5:8870:12379: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0057; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8870
msgctxt "text_id=12379 | speaker=tobimaru"
msgid "「普通、クリスマス前は貯金するもんだけどな」"
msgstr ""

#. Occurrence 8DOT5:8904:12380: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0077; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8904
msgctxt "text_id=12380 | speaker=aoko"
msgid "「ダメよ槻司君、デリカシーが足りないわ。"
msgstr ""

#. Occurrence 8DOT5:8910:12381: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0078; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8910
msgctxt "text_id=12381 | speaker=aoko"
msgid "　残酷な事実は口にしたくはないけど、木乃美君にはイヴを過ごす相手がいないって事でしょう。学友として、そこを追及したら可哀想よ」"
msgstr ""

#. Occurrence 8DOT5:8956:12382: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0014; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8956
msgctxt "text_id=12382 | speaker=kinomi"
msgid "「い、いるわい本命ぐらい！　真剣に同情する方がデリカシーに欠けると思うよオレは！」"
msgstr ""

#. Occurrence 8DOT5:8976:12383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0079; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8976
msgctxt "text_id=12383 | speaker=aoko"
msgid "「あら。じゃあ、イヴ用の資金はとってあるの？」"
msgstr ""

#. Occurrence 8DOT5:9010:12384: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0015; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9010
msgctxt "text_id=12384 | speaker=kinomi"
msgid "「あったりめえさ。臨時収入と貯金は別。"
msgstr ""

#. Occurrence 8DOT5:9016:12385: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0016; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9016
msgctxt "text_id=12385 | speaker=kinomi"
msgid "　オレ、通帳オヤジに握られてるからさー、予定外の入金とかすぐバレて怒られるんだよ。どこで悪さしてきやがったって。部屋も妹がチェックするしさー、隠し場所とかないんだよー。天井裏に隠したエロ本すら見付けられるんだぜ、万札入った封筒とか見つかった日にゃ警察につれていかれる。だからソッコー使うしかなくってさー」"
msgstr ""

#. Occurrence 8DOT5:9036:12386: scene=8DOT5
#: 8DOT5:9036
msgctxt "text_id=12386 | speaker=unknown"
msgid "　何が恥ずかしいのか、ははは、と照れ隠しに笑う木乃美。"
msgstr ""

#. Occurrence 8DOT5:9041:12387: scene=8DOT5
#: 8DOT5:9041
msgctxt "text_id=12387 | speaker=unknown"
msgid "　基本おしゃべりで感情だだもれな性格を、本人だけは気付いていない悲劇だった。"
msgstr ""

#. Occurrence 8DOT5:9079:12388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0080; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9079
msgctxt "text_id=12388 | speaker=aoko"
msgid "「へえ、臨時収入？　さっきと話、違うみたい」"
msgstr ""

#. Occurrence 8DOT5:9093:12389: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0017; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9093
msgctxt "text_id=12389 | speaker=kinomi"
msgid "「―――あ。いや、それはほら、バイト先のボーナスみたいな。五千円ぐらい上乗せしてもらったの！　ほんのちょっと、ちょっとだけだって！　事件性とかないって！」"
msgstr ""

#. Occurrence 8DOT5:9124:12390: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0081; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9124
msgctxt "text_id=12390 | speaker=aoko"
msgid "「万札入った封筒について詳しく」"
msgstr ""

#. Occurrence 8DOT5:9150:12391: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0018; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9150
msgctxt "text_id=12391 | speaker=kinomi"
msgid "「うおお、話せば話すほど食い違っていくぜ！　なんだこれ孔明のワナか？"
msgstr ""

#. Occurrence 8DOT5:9159:12392: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0019; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9159
msgctxt "text_id=12392 | speaker=kinomi"
msgid "　ちょっ、会長近い、オーラすごい、なんか寒い！　しかもローファーじゃなくてブーツですか!?　この間合い、封じられたオレの記憶が蘇りそうなんですけどー！」"
msgstr ""

#. Occurrence 8DOT5:9179:12393: scene=8DOT5
#: 8DOT5:9179
msgctxt "text_id=12393 | speaker=unknown"
msgid "　じりじりと後退する木乃美と、"
msgstr ""

#. Occurrence 8DOT5:9202:12394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0082; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9202
msgctxt "text_id=12394 | speaker=aoko"
msgid "「木乃美君？　時間がないって言ったの、もう一度アピールするべきかしら？」"
msgstr ""

#. Occurrence 8DOT5:9215:12395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0083; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9215
msgctxt "text_id=12395 | speaker=aoko"
msgid "“直接、体に。”"
msgstr ""

#. Occurrence 8DOT5:9221:12396: scene=8DOT5
#: 8DOT5:9221
msgctxt "text_id=12396 | speaker=unknown"
msgid "　そう、ぼそっと付け足すハイキックの鬼。"
msgstr ""

#. Occurrence 8DOT5:9254:12397: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0020; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9254
msgctxt "text_id=12397 | speaker=kinomi"
msgid "「わかった、話す！　話すってばもー！"
msgstr ""

#. Occurrence 8DOT5:9260:12398: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0021; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9260
msgctxt "text_id=12398 | speaker=kinomi"
msgid "　臨時収入ってのはホントだよ！　新しいバイトがあってさ、そこに静希を紹介したら先輩にボーナスもらったんだよ！」"
msgstr ""

#. Occurrence 8DOT5:9278:12399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0084; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9278
msgctxt "text_id=12399 | speaker=aoko"
msgid "「―――なんですって？」"
msgstr ""

#. Occurrence 8DOT5:9298:12400: scene=8DOT5
#: 8DOT5:9298
msgctxt "text_id=12400 | speaker=unknown"
msgid "　仮に、木乃美が草十郎と同じバイトをしているのなら情報を引きずりだそう。"
msgstr ""

#. Occurrence 8DOT5:9303:12401: scene=8DOT5
#: 8DOT5:9303
msgctxt "text_id=12401 | speaker=unknown"
msgid "　そう考えていた青子にとって、木乃美の返答は期待通りであり、ちょっとばかり想像を超えていた。"
msgstr ""

#. Occurrence 8DOT5:9347:12402: scene=8DOT5
#: 8DOT5:9347
msgctxt "text_id=12402 | speaker=unknown"
msgid "　悪い予感に目眩を覚える。"
msgstr ""

#. Occurrence 8DOT5:9355:12403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0085; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9355
msgctxt "text_id=12403 | speaker=aoko"
msgid "「紹介したらボーナスをもらえるって、それ―――」"
msgstr ""

#. Occurrence 8DOT5:9361:12404: scene=8DOT5
#: 8DOT5:9361
msgctxt "text_id=12404 | speaker=unknown"
msgid "　悪徳商法と名高い、ネズミ講のうたい文句そのものだ。"
msgstr ""

#. Occurrence 8DOT5:9397:12405: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0022; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9397
msgctxt "text_id=12405 | speaker=kinomi"
msgid "「いや、それがさー。"
msgstr ""

#. Occurrence 8DOT5:9403:12406: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0023; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9403
msgctxt "text_id=12406 | speaker=kinomi"
msgid "　静希が稼ぎを増やしたいっていうんで、ちょい怪しいバイトを紹介したんだよね」"
msgstr ""

#. Occurrence 8DOT5:9435:12407: scene=8DOT5
#: 8DOT5:9435
msgctxt "text_id=12407 | speaker=unknown"
msgid "　事は期末試験前にさかのぼる。"
msgstr ""

#. Occurrence 8DOT5:9440:12408: scene=8DOT5
#: 8DOT5:9440
msgctxt "text_id=12408 | speaker=unknown"
msgid "　とある理由から先立つものがない、と相談してきたクラスメイトに、木乃美は先輩経由で回ってきたアルバイトを紹介した。"
msgstr ""

#. Occurrence 8DOT5:9445:12409: scene=8DOT5
#: 8DOT5:9445
msgctxt "text_id=12409 | speaker=unknown"
msgid "　先方が求めた人材が「心優しい、素直な青年」だったため、木乃美は泣く泣く出馬をあきらめ、代わりに条件の合う友人を送り出した―――という訳である。"
msgstr ""

#. Occurrence 8DOT5:9474:12410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0086; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9474
msgctxt "text_id=12410 | speaker=aoko"
msgid "「信じられない。そんな怪しい話にクラスメイトを放り出しておいて、まだ友人顔するとか。"
msgstr ""

#. Occurrence 8DOT5:9480:12411: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0087; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9480
msgctxt "text_id=12411 | speaker=aoko"
msgid "　木乃美君、普段なに考えて生きてるの？」"
msgstr ""

#. Occurrence 8DOT5:9486:12412: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0024; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9486
msgctxt "text_id=12412 | speaker=kinomi"
msgid "「えー。トモダチでも紹介するでしょ、こういうの。"
msgstr ""

#. Occurrence 8DOT5:9492:12413: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0025; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9492
msgctxt "text_id=12413 | speaker=kinomi"
msgid "　むしろ本当の友情ってこういうものよ？　静希も助かってオレも<潤|うるお>うんだからさー。無償の友情とかもうはやんないですよ？」"
msgstr ""

#. Occurrence 8DOT5:9523:12414: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0088; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9523
msgctxt "text_id=12414 | speaker=aoko"
msgid "「そりゃそうだけど、そういうのはちゃんと<責任|ケツ>持つ覚悟がある時だけ口にするものじゃないの？」"
msgstr ""

#. Occurrence 8DOT5:9529:12415: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0026; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9529
msgctxt "text_id=12415 | speaker=kinomi"
msgid "「なにそれメンドくさーい。会長、男同士の友情に幻想持ちすぎだってば。基本、オレたちみんなバカよ？」"
msgstr ""

#. Occurrence 8DOT5:9535:12416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0089; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9535
msgctxt "text_id=12416 | speaker=aoko"
msgid "「貴方を見てると本気でそう思えてくるから不思議ね。"
msgstr ""

#. Occurrence 8DOT5:9541:12417: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0090; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9541
msgctxt "text_id=12417 | speaker=aoko"
msgid "　鳶丸。アンタ、よくこんなのと<連|つる>んでるわね」"
msgstr ""

#. Occurrence 8DOT5:9572:12418: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0058; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9572
msgctxt "text_id=12418 | speaker=tobimaru"
msgid "「はいはいそこまで。説教するならまた後でな蒼崎。"
msgstr ""

#. Occurrence 8DOT5:9578:12419: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0059; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9578
msgctxt "text_id=12419 | speaker=tobimaru"
msgid "　そいつ素で<最低|バカ>だから、本気で更生させたかったら一日使うぞ」"
msgstr ""

#. Occurrence 8DOT5:9587:12420: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0027; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9587
msgctxt "text_id=12420 | speaker=kinomi"
msgid "「いや、足りますよ。ちゃんと一日で更生できますボク。"
msgstr ""

#. Occurrence 8DOT5:9599:12421: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0028; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9599
msgctxt "text_id=12421 | speaker=kinomi"
msgid "　ただ、寝ると忘れちゃうだけで」"
msgstr ""

#. Occurrence 8DOT5:9612:12422: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0091; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9612
msgctxt "text_id=12422 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:9633:12423: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0060; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9633
msgctxt "text_id=12423 | speaker=tobimaru"
msgid "「ほらな。まあ、<手前|テメエ>がバカだって自覚している分、気付いてない奴よりは付き合いやすい。"
msgstr ""

#. Occurrence 8DOT5:9640:12424: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0061; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9640
msgctxt "text_id=12424 | speaker=tobimaru"
msgid "この若さで情けは人のためならず、を<実践|じっせん>してる野郎はそうはいねえし」"
msgstr ""

#. Occurrence 8DOT5:9651:12425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0092; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9651
msgctxt "text_id=12425 | speaker=aoko"
msgid "「……納得。たしかに、アンタと気が合いそうな性格ね」"
msgstr ""

#. Occurrence 8DOT5:9684:12426: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0029; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9684
msgctxt "text_id=12426 | speaker=kinomi"
msgid "「え？　いやまいったなぁ！"
msgstr ""

#. Occurrence 8DOT5:9690:12427: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0030; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9690
msgctxt "text_id=12427 | speaker=kinomi"
msgid "　なんだよ二人とも、いくらオレでも照れるじゃんか。いま、オレのこと褒めてなかった？」"
msgstr ""

#. Occurrence 8DOT5:9696:12428: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0062; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9696
msgctxt "text_id=12428 | speaker=tobimaru"
msgid "「褒めてねえ」"
msgstr ""

#. Occurrence 8DOT5:9702:12429: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0093; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9702
msgctxt "text_id=12429 | speaker=aoko"
msgid "「褒めてないわよ」"
msgstr ""

#. Occurrence 8DOT5:9708:12430: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0031; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9708
msgctxt "text_id=12430 | speaker=kinomi"
msgid "「うん、ですよね」"
msgstr ""

#. Occurrence 8DOT5:9768:12431: scene=8DOT5
#: 8DOT5:9768
msgctxt "text_id=12431 | speaker=unknown"
msgid "　木乃美を先頭に、青子たちは問題のアルバイト先へと到着した。"
msgstr ""

#. Occurrence 8DOT5:9773:12432: scene=8DOT5
#: 8DOT5:9773
msgctxt "text_id=12432 | speaker=unknown"
msgid "　駅前の新繁華街から奥に移動し、気持ち、いかがわしい空気ただよう二丁目。"
msgstr ""

#. Occurrence 8DOT5:9778:12433: scene=8DOT5
#: 8DOT5:9778
msgctxt "text_id=12433 | speaker=unknown"
msgid "　青子が草十郎を見失った場所とぴったり符合する。"
msgstr ""

#. Occurrence 8DOT5:9800:12434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0094; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9800
msgctxt "text_id=12434 | speaker=aoko"
msgid "「このあたりね。木乃美君、そのバイト先ってどこ？」"
msgstr ""

#. Occurrence 8DOT5:9806:12435: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0032; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9806
msgctxt "text_id=12435 | speaker=kinomi"
msgid "「えーと、あのへん」"
msgstr ""

#. Occurrence 8DOT5:9823:12436: scene=8DOT5
#: 8DOT5:9823
msgctxt "text_id=12436 | speaker=unknown"
msgid "　木乃美が指さしたのは四階建てのオフィスビルだ。"
msgstr ""

#. Occurrence 8DOT5:9828:12437: scene=8DOT5
#: 8DOT5:9828
msgctxt "text_id=12437 | speaker=unknown"
msgid "　入り口は一階の端にあり、パッと見はマンションに見える。"
msgstr ""

#. Occurrence 8DOT5:9848:12438: scene=8DOT5
#: 8DOT5:9848
msgctxt "text_id=12438 | speaker=unknown"
msgid "　一階の通路はビルの裏側まで続いている。"
msgstr ""

#. Occurrence 8DOT5:9853:12439: scene=8DOT5
#: 8DOT5:9853
msgctxt "text_id=12439 | speaker=unknown"
msgid "　階段はその通路のはじめ、入り口から入ってすぐ正面に造られていた。"
msgstr ""

#. Occurrence 8DOT5:9874:12440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0095; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9874
msgctxt "text_id=12440 | speaker=aoko"
msgid "「ちょっと、そこの路地裏に入りましょう」"
msgstr ""

#. Occurrence 8DOT5:9896:12441: scene=8DOT5
#: 8DOT5:9896
msgctxt "text_id=12441 | speaker=unknown"
msgid "　ササッと人目につかない路地裏に移動する青子。"
msgstr ""

#. Occurrence 8DOT5:9901:12442: scene=8DOT5
#: 8DOT5:9901
msgctxt "text_id=12442 | speaker=unknown"
msgid "　風俗店の多い界隈で学生三人は目立つからだ。"
msgstr ""

#. Occurrence 8DOT5:9932:12443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0096; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9932
msgctxt "text_id=12443 | speaker=aoko"
msgid "「で、中はどうなってんの？"
msgstr ""

#. Occurrence 8DOT5:9938:12444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0097; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9938
msgctxt "text_id=12444 | speaker=aoko"
msgid "　事務所って言ってたけど、どんな仕事？」"
msgstr ""

#. Occurrence 8DOT5:9951:12445: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0033; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9951
msgctxt "text_id=12445 | speaker=kinomi"
msgid "「？　オレに訊いてんの？　やだなあ、オレが知ってるのはここまでだぜ？　オレだって先輩に言われただけで、中のコトなんて知らないし。草十郎をここまで連れてきたら、先輩が紹介料くれただけだし」"
msgstr ""

#. Occurrence 8DOT5:9989:12446: scene=8DOT5
#: 8DOT5:9989
msgctxt "text_id=12446 | speaker=unknown"
msgid "　最有力容疑者はここにきて無知をさらけ出した。"
msgstr ""

#. Occurrence 8DOT5:9994:12447: scene=8DOT5
#: 8DOT5:9994
msgctxt "text_id=12447 | speaker=unknown"
msgid "　共犯者、もしくは主犯と思われた木乃美芳助は、その実、はた迷惑なだけの通行人Ａにすぎなかったのである。"
msgstr ""

#. Occurrence 8DOT5:10020:12448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0098; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10020
msgctxt "text_id=12448 | speaker=aoko"
msgid "「……まいった。ここまで無責任だといっそ<清々|すがすが>しい。"
msgstr ""

#. Occurrence 8DOT5:10031:12449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0099; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10031
msgctxt "text_id=12449 | speaker=aoko"
msgid "　ところで木乃美君、西部劇とか見たコトある？"
msgstr ""

#. Occurrence 8DOT5:10031:12450: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0099; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10031
msgctxt "text_id=12450 | speaker=aoko"
msgid "　役にたたない情報提供者の末路とか、ご存じかしら？」"
msgstr ""

#. Occurrence 8DOT5:10054:12451: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0034; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10054
msgctxt "text_id=12451 | speaker=kinomi"
msgid "「い、いやあ、オレ映画って苦手なんだよ。"
msgstr ""

#. Occurrence 8DOT5:10054:12452: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0034; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10054
msgctxt "text_id=12452 | speaker=kinomi"
msgid "　でも『セーラー服と機関銃』なら見た。主演目当てで」"
msgstr ""

#. Occurrence 8DOT5:10082:12453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0100; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10082
msgctxt "text_id=12453 | speaker=aoko"
msgid "「そ、残念ね。『夕陽のガンマン』ぐらいは見とけば良かったのに。ま、どうあれ情報提供者は悲惨な死をとげるんだけど」"
msgstr ""

#. Occurrence 8DOT5:10091:12454: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0035; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10091
msgctxt "text_id=12454 | speaker=kinomi"
msgid "「ちょっ、やる気満々だぜこの女！　殿下、こんな<凶獣|きょうじゅう>ほったらかしにしちゃまずいって、首輪とかつけないとさあ！」"
msgstr ""

#. Occurrence 8DOT5:10117:12455: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0036; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10117
msgctxt "text_id=12455 | speaker=kinomi"
msgid "「……って槻司？　なんだよしけた顔しちゃって。"
msgstr ""

#. Occurrence 8DOT5:10123:12456: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0037; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10123
msgctxt "text_id=12456 | speaker=kinomi"
msgid "　あのビルがなにか知ってんの？」"
msgstr ""

#. Occurrence 8DOT5:10150:12457: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0063; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10150
msgctxt "text_id=12457 | speaker=tobimaru"
msgid "「……まずいな。"
msgstr ""

#. Occurrence 8DOT5:10156:12458: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0064; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10156
msgctxt "text_id=12458 | speaker=tobimaru"
msgid "　知ってるも何も、ありゃあ最近やってきた詐欺まがいのセールス屋だ。英会話セットの販売と何ら変わらねえ」"
msgstr ""

#. Occurrence 8DOT5:10191:12459: scene=8DOT5
#: 8DOT5:10191
msgctxt "text_id=12459 | speaker=unknown"
msgid "　やはりそうか、と憂鬱になる青子と、"
msgstr ""

#. Occurrence 8DOT5:10196:12460: scene=8DOT5
#: 8DOT5:10196
msgctxt "text_id=12460 | speaker=unknown"
msgid "　英会話セット？　と首をかしげる木乃美。"
msgstr ""

#. Occurrence 8DOT5:10231:12461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0101; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10231
msgctxt "text_id=12461 | speaker=aoko"
msgid "「それ、確かなの鳶丸？」"
msgstr ""

#. Occurrence 8DOT5:10237:12462: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0065; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10237
msgctxt "text_id=12462 | speaker=tobimaru"
msgid "「ああ。親父の秘書さんから聞いた話だ、間違いない。"
msgstr ""

#. Occurrence 8DOT5:10243:12463: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0066; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10243
msgctxt "text_id=12463 | speaker=tobimaru"
msgid "　表向きは新興宗教なんだが、やってるコトは<羽毛布団|うもうぶとん>の販売だとさ。じいさまばあさま相手に質の低い羽毛布団を高額で売りつけているらしい」"
msgstr ""

#. Occurrence 8DOT5:10264:12464: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0067; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10264
msgctxt "text_id=12464 | speaker=tobimaru"
msgid "「あの事務所も貸事務所だ。一ヶ月もこの街で稼いだらあっさりドロンするつもりだろう。"
msgstr ""

#. Occurrence 8DOT5:10270:12465: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0068; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10270
msgctxt "text_id=12465 | speaker=tobimaru"
msgid "　……間違いなく草十郎は騙されてるな。最高のカモだろ、詐欺師にとっちゃ」"
msgstr ""

#. Occurrence 8DOT5:10289:12466: scene=8DOT5
#: 8DOT5:10289
msgctxt "text_id=12466 | speaker=unknown"
msgid "　ガックリと肩を落とす鳶丸。"
msgstr ""

#. Occurrence 8DOT5:10294:12467: scene=8DOT5
#: 8DOT5:10294
msgctxt "text_id=12467 | speaker=unknown"
msgid "　一方、青子はもう完全に戦闘状態に移行していた。"
msgstr ""

#. Occurrence 8DOT5:10319:12468: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0102; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10319
msgctxt "text_id=12468 | speaker=aoko"
msgid "「よし潰す。そのあと木乃美は学校の旗のところに<吊|つる>す」"
msgstr ""

#. Occurrence 8DOT5:10333:12469: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0038; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10333
msgctxt "text_id=12469 | speaker=kinomi"
msgid "「え、<直|じか>？　今の台詞だと<縄|なわ>じゃなくて首？　<脊髄|せきずい>にぐっさり？　殺人？」"
msgstr ""

#. Occurrence 8DOT5:10346:12470: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0069; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10346
msgctxt "text_id=12470 | speaker=tobimaru"
msgid "「あ、いや待て蒼崎。それだと辻褄が合わん。"
msgstr ""

#. Occurrence 8DOT5:10352:12471: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0070; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10352
msgctxt "text_id=12471 | speaker=tobimaru"
msgid "　草十郎は大金を持ってたんだよな？　それじゃカモとは呼べねえぞ」"
msgstr ""

#. Occurrence 8DOT5:10391:12472: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0103; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10391
msgctxt "text_id=12472 | speaker=aoko"
msgid "「……そう言えばそうだった。木乃美君の発言に気を取られすぎて、あの大金のコトを忘れてた。"
msgstr ""

#. Occurrence 8DOT5:10402:12473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0104; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10402
msgctxt "text_id=12473 | speaker=aoko"
msgid "　あれ、ってコトは、まさか―――」"
msgstr ""

#. Occurrence 8DOT5:10413:12474: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0071; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10413
msgctxt "text_id=12474 | speaker=tobimaru"
msgid "「ああ。騙されている側だったら金は減っていく。"
msgstr ""

#. Occurrence 8DOT5:10419:12475: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0072; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10419
msgctxt "text_id=12475 | speaker=tobimaru"
msgid "　……だが増えてるなら話は別だ。考えたくねえが、草十郎のヤツはセールス側に回ってるんじゃないか？」"
msgstr ""

#. Occurrence 8DOT5:10460:12476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0105; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10460
msgctxt "text_id=12476 | speaker=aoko"
msgid "「……信じられない。草十郎が、詐欺グループの一員になっている、ですって―――？」"
msgstr ""

#. Occurrence 8DOT5:10473:12477: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0039; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10473
msgctxt "text_id=12477 | speaker=kinomi"
msgid "「はあ？　まっさかあ。静希に騙されるようなヤツはいねーよぉ。だいたい嘘つけないじゃんアイツ。羽毛布団を売りさばくとか、ぜったい無理だって」"
msgstr ""

#. Occurrence 8DOT5:10498:12478: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0073; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10498
msgctxt "text_id=12478 | speaker=tobimaru"
msgid "「だから、草十郎自身それが悪質なサギだと気づいてないんじゃないか？　アイツはアイツで、心からいいものだと思って売ってるんだよ。真心の固まりで」"
msgstr ""

#. Occurrence 8DOT5:10510:12479: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0040_0; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10510
msgctxt "text_id=12479 | speaker=kinomi"
msgid "「おお！　なるほど、そりゃ納得だ！　あの純真さがお年寄りに大人気ってワケだな！　やるじゃん静希、今度あったらオレもお<裾|すそ>分けしてもら、"
msgstr ""

#. Occurrence 8DOT5:10528:12480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0040_1; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10528
msgctxt "text_id=12480 | speaker=kinomi"
msgid "あいたぁ!?」"
msgstr ""

#. Occurrence 8DOT5:10573:12481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0106; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10573
msgctxt "text_id=12481 | speaker=aoko"
msgid "「……木乃美君の更生は今後の課題として。"
msgstr ""

#. Occurrence 8DOT5:10579:12482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0107; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10579
msgctxt "text_id=12482 | speaker=aoko"
msgid "　どうしよう鳶丸？　もう少し様子を見た方がいいと思う？仮に静希君が関わってたら、彼にも詐欺罪が適用される？　まだ未成年だけど」"
msgstr ""

#. Occurrence 8DOT5:10590:12483: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0074; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10590
msgctxt "text_id=12483 | speaker=tobimaru"
msgid "「あくまで従業員だから実刑はかからねえとは思うが、敵さんはアレで食ってる連中だからな。草十郎が雇われた時の、契約書の内容次第だ」"
msgstr ""

#. Occurrence 8DOT5:10629:12484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0108; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10629
msgctxt "text_id=12484 | speaker=aoko"
msgid "「そう。そうよね。下手したら草十郎自身、もう入会してるかもしれない」"
msgstr ""

#. Occurrence 8DOT5:10635:12485: scene=8DOT5
#: 8DOT5:10635
msgctxt "text_id=12485 | speaker=unknown"
msgid "　気が付けば、青子の顔つきは冷徹なものに変わっていた。"
msgstr ""

#. Occurrence 8DOT5:10647:12486: scene=8DOT5
#: 8DOT5:10647
msgctxt "text_id=12486 | speaker=unknown"
msgid "　生徒会役員として一年以上付き合ってきた鳶丸だ。"
msgstr ""

#. Occurrence 8DOT5:10652:12487: scene=8DOT5
#: 8DOT5:10652
msgctxt "text_id=12487 | speaker=unknown"
msgid "　こういう時の彼女が何を考えているか、言われずとも分かっている。"
msgstr ""

#. Occurrence 8DOT5:10685:12488: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0075; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10685
msgctxt "text_id=12488 | speaker=tobimaru"
msgid "「入会していたら脱会は難しいな。アイツ本人にその気がなくとも、<判子|はんこ>の力は絶大だ。"
msgstr ""

#. Occurrence 8DOT5:10691:12489: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0076; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10691
msgctxt "text_id=12489 | speaker=tobimaru"
msgid "　……それで蒼崎、どこまでやる気だ？」"
msgstr ""

#. Occurrence 8DOT5:10697:12490: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0109; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10697
msgctxt "text_id=12490 | speaker=aoko"
msgid "「営業停止は最低ライン。信仰は自由だっていうなら、よその土地でやってもらうまでよ」"
msgstr ""

#. Occurrence 8DOT5:10718:12491: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0077; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10718
msgctxt "text_id=12491 | speaker=tobimaru"
msgid "「だろうなあ、そんな顔してるぜおまえさん。"
msgstr ""

#. Occurrence 8DOT5:10724:12492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0078; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10724
msgctxt "text_id=12492 | speaker=tobimaru"
msgid "　で、草十郎はどうする？　とりあえず辞めさせるか？」"
msgstr ""

#. Occurrence 8DOT5:10730:12493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0110; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10730
msgctxt "text_id=12493 | speaker=aoko"
msgid "「当然。けど、もう彼だけの問題じゃないわ。そもそもうちの生徒を雇おうとした時点で私たちの問題よ。"
msgstr ""

#. Occurrence 8DOT5:10736:12494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0111; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10736
msgctxt "text_id=12494 | speaker=aoko"
msgid "　静希君とは関係なしで、あの事務所<潰|つぶ>すから」"
msgstr ""

#. Occurrence 8DOT5:10784:12495: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0079; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10784
msgctxt "text_id=12495 | speaker=tobimaru"
msgid "「……いいけどな。厄介だぞあの手の連中は。サラ金と同じで法律上は何の問題もねえ。"
msgstr ""

#. Occurrence 8DOT5:10791:12496: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0080; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10791
msgctxt "text_id=12496 | speaker=tobimaru"
msgid "警察じゃせいぜい厳重注意レベル、下手に商売の邪魔をすれば<損害|そんがい><賠償|ばいしょう>と言いだしかねん。急いては事をなんとやらだ」"
msgstr ""

#. Occurrence 8DOT5:10803:12497: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0112_0; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10803
msgctxt "text_id=12497 | speaker=aoko"
msgid "「分かってる。まずは会社の概要と社長の素性、構成員の数を調べながら被害者の洗い出し、"
msgstr ""

#. Occurrence 8DOT5:10815:12498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0112_1; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10815
msgctxt "text_id=12498 | speaker=aoko"
msgid "を―――」"
msgstr ""

#. Occurrence 8DOT5:10836:12499: scene=8DOT5
#: 8DOT5:10836
msgctxt "text_id=12499 | speaker=unknown"
msgid "　静かに、しかし大胆に密談していた青子の口が止まる。"
msgstr ""

#. Occurrence 8DOT5:10848:12500: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0081_0; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10848
msgctxt "text_id=12500 | speaker=tobimaru"
msgid "「どうした蒼崎―――って、"
msgstr ""

#. Occurrence 8DOT5:10860:12501: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0081_1; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10860
msgctxt "text_id=12501 | speaker=tobimaru"
msgid "げ」"
msgstr ""

#. Occurrence 8DOT5:10865:12502: scene=8DOT5
#: 8DOT5:10865
msgctxt "text_id=12502 | speaker=unknown"
msgid "　物陰からオフィスビルを覗いていた鳶丸もその変化に気付いたようだ。"
msgstr ""

#. Occurrence 8DOT5:10900:12503: scene=8DOT5
#: 8DOT5:10900
msgctxt "text_id=12503 | speaker=unknown"
msgid "　青子の視線は通りの雑踏に向けられている。"
msgstr ""

#. Occurrence 8DOT5:10910:12504: scene=8DOT5
#: 8DOT5:10910
msgctxt "text_id=12504 | speaker=unknown"
msgid "　見慣れたコート姿の少年がいかがわしい二丁目を歩いている。"
msgstr ""

#. Occurrence 8DOT5:10947:12505: scene=8DOT5
#: 8DOT5:10947
msgctxt "text_id=12505 | speaker=unknown"
msgid "　少年はわずかな迷いもなくオフィスビルまでやってくると、トコトコと足音をたてて入り口に消えていった。"
msgstr ""

#. Occurrence 8DOT5:10957:12506: scene=8DOT5
#: 8DOT5:10957
msgctxt "text_id=12506 | speaker=unknown"
msgid "　物陰に隠れている青子たちの気苦労もどこ吹く風。"
msgstr ""

#. Occurrence 8DOT5:10962:12507: scene=8DOT5
#: 8DOT5:10962
msgctxt "text_id=12507 | speaker=unknown"
msgid "　少年……静希草十郎は軽い足取りで、自分が騙されている事にも気付かず、今日も一日、まじめに働きに来たらしい。"
msgstr ""

#. Occurrence 8DOT5:10995:12508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0113; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10995
msgctxt "text_id=12508 | speaker=aoko"
msgid "「あ、あ、あの―――」"
msgstr ""

#. Occurrence 8DOT5:11001:12509: scene=8DOT5
#: 8DOT5:11001
msgctxt "text_id=12509 | speaker=unknown"
msgid "　青子は肩を震わせながら、<懸命|けんめい>に怒りを<堪|こら>えている。"
msgstr ""

#. Occurrence 8DOT5:11022:12510: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0082; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11022
msgctxt "text_id=12510 | speaker=tobimaru"
msgid "「待て、落ち着け蒼崎。"
msgstr ""

#. Occurrence 8DOT5:11022:12511: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0082; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11022
msgctxt "text_id=12511 | speaker=tobimaru"
msgid "　気持ちは分かるが、あいつに悪気はだな」"
msgstr ""

#. Occurrence 8DOT5:11043:12512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0114; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11043
msgctxt "text_id=12512 | speaker=aoko"
msgid "「ああもう、なんか無性にあったまきたー！」"
msgstr ""

#. Occurrence 8DOT5:11063:12513: scene=8DOT5
#: 8DOT5:11063
msgctxt "text_id=12513 | speaker=unknown"
msgid "　がばり、と俯いていた顔をあげ、拳を握る。"
msgstr ""

#. Occurrence 8DOT5:11069:12514: scene=8DOT5
#: 8DOT5:11069
msgctxt "text_id=12514 | speaker=unknown"
msgid "　そこにあるのはいつもの冷淡な彼女ではなく、"
msgstr ""

#. Occurrence 8DOT5:11074:12515: scene=8DOT5
#: 8DOT5:11074
msgctxt "text_id=12515 | speaker=unknown"
msgid "　正義と<義憤|ぎふん>と個人的な感情で燃え上がる、鉄の生徒会長の姿だった。"
msgstr ""

#. Occurrence 8DOT5:11129:12516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0115; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11129
msgctxt "text_id=12516 | speaker=aoko"
msgid "「鳶丸、応援団の<美濃|みの>先輩に連絡とって、いますぐ強面の団員二十人ほど集めてきて！"
msgstr ""

#. Occurrence 8DOT5:11136:12517: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0116; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11136
msgctxt "text_id=12517 | speaker=aoko"
msgid "　ケンカになるかもしれないから、それなりの装備こみでって！」"
msgstr ""

#. Occurrence 8DOT5:11142:12518: scene=8DOT5
#: 8DOT5:11142
msgctxt "text_id=12518 | speaker=unknown"
msgid "　言いつつ、青子は表通りに飛びだした。"
msgstr ""

#. Occurrence 8DOT5:11147:12519: scene=8DOT5
#: 8DOT5:11147
msgctxt "text_id=12519 | speaker=unknown"
msgid "　その姿は<敵陣突入|カチコミ>にいく番長そのものである。"
msgstr ""

#. Occurrence 8DOT5:11173:12520: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0083; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11173
msgctxt "text_id=12520 | speaker=tobimaru"
msgid "「美濃って応援団の団長のか!?"
msgstr ""

#. Occurrence 8DOT5:11173:12521: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0083; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11173
msgctxt "text_id=12521 | speaker=tobimaru"
msgid "　しかも二十人って、おまえいったい何する気だ!?」"
msgstr ""

#. Occurrence 8DOT5:11199:12522: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0117; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11199
msgctxt "text_id=12522 | speaker=aoko"
msgid "「決まってるでしょ、殴り込みよ！"
msgstr ""

#. Occurrence 8DOT5:11206:12523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0118_0; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11206
msgctxt "text_id=12523 | speaker=aoko"
msgid "　まずは法律面での制裁から、なんて考えが甘かった！"
msgstr ""

msgctxt "text_id=12524 | speaker=unknown"
msgid "　学生だまして私腹を肥やすような悪党には物理的な制裁で十分よ！　そもそもスケールが小さいっての！　"
msgstr ""

#. Occurrence 8DOT5:11221:12525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0118_1; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11221
msgctxt "text_id=12525 | speaker=aoko"
msgid "なによ『ほんものの光』って、こんなしけた町で羽毛布団とか売ってんなー！」"
msgstr ""

#. Occurrence 8DOT5:11248:12526: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0084; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11248
msgctxt "text_id=12526 | speaker=tobimaru"
msgid "「待て落ち着け、さっきまでの平和的な<対処法|プラン>はどこにいった!?　悪党を暴力で押さえつけていいのは警察だけだ！　いいから戻りやがれ！」"
msgstr ""

#. Occurrence 8DOT5:11271:12527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0119; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11271
msgctxt "text_id=12527 | speaker=aoko"
msgid "「ちょっ！"
msgstr ""

msgctxt "text_id=12528 | speaker=unknown"
msgid "」"
msgstr ""

#. Occurrence 8DOT5:11327:12529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0120; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11327
msgctxt "text_id=12529 | speaker=aoko"
msgid "「なによ！　その警察が使えないから私たちが出張るんじゃない！　文句あるなら代案だせ！」"
msgstr ""

#. Occurrence 8DOT5:11354:12530: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0085; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11354
msgctxt "text_id=12530 | speaker=tobimaru"
msgid "「文句はねえ、まず落ち着けって話だ！"
msgstr ""

#. Occurrence 8DOT5:11360:12531: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0086; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11360
msgctxt "text_id=12531 | speaker=tobimaru"
msgid "　そもそも代案なんざ立てるまでもねえ。おまえさん、さっきはどんな手を考えてたか口にしてみろ。まずは法律面での制裁を、とか言ってただろう」"
msgstr ""

#. Occurrence 8DOT5:11386:12532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0121; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11386
msgctxt "text_id=12532 | speaker=aoko"
msgid "「そんなのアンタだって分かってるでしょ。"
msgstr ""

#. Occurrence 8DOT5:11392:12533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0122; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11392
msgctxt "text_id=12533 | speaker=aoko"
msgid "　あの会社の調査と並行して、詐欺の被害にあった人たちを探して、私たちが間に入って連盟を作る。"
msgstr ""

#. Occurrence 8DOT5:11398:12534: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0123; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11398
msgctxt "text_id=12534 | speaker=aoko"
msgid "　ご老人ばかりを標的にしてるのは、お爺さんたちは世間の事情に<疎|うと>いとみくびってるからだろうし。"
msgstr ""

#. Occurrence 8DOT5:11404:12535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0124; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11404
msgctxt "text_id=12535 | speaker=aoko"
msgid "　なんで、お爺さんたちだけじゃ分からない問題を私たちでフォローしてあげれば、被害者の会ぐらいは作れるわ」"
msgstr ""

#. Occurrence 8DOT5:11425:12536: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0087; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11425
msgctxt "text_id=12536 | speaker=tobimaru"
msgid "「よし、その調子だ。"
msgstr ""

#. Occurrence 8DOT5:11432:12537: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0088; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11432
msgctxt "text_id=12537 | speaker=tobimaru"
msgid "たしかにひとりひとりでかけ合っても連中にとっちゃ痛くもかゆくもねえ。横の繋がりを作るのは大事だからな。"
msgstr ""

#. Occurrence 8DOT5:11438:12538: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0089; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11438
msgctxt "text_id=12538 | speaker=tobimaru"
msgid "　それで？　契約をなかった事にして、とられた金を取り戻すか？」"
msgstr ""

#. Occurrence 8DOT5:11465:12539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0125; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11465
msgctxt "text_id=12539 | speaker=aoko"
msgid "「……それは無理でしょうね。"
msgstr ""

#. Occurrence 8DOT5:11471:12540: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0126; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11471
msgctxt "text_id=12540 | speaker=aoko"
msgid "　契約書は絶対よ。あったまくるけど、書かれた事はくつがえらない。今から出来るのはこれ以上の被害を抑えるコトだけ。ローンの解約、入会の破棄、それと―――」"
msgstr ""

#. Occurrence 8DOT5:11477:12541: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0090; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11477
msgctxt "text_id=12541 | speaker=tobimaru"
msgid "「それと？」"
msgstr ""

#. Occurrence 8DOT5:11518:12542: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0127; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11518
msgctxt "text_id=12542 | speaker=aoko"
msgid "「可能なかぎり、金銭を回収する。"
msgstr ""

#. Occurrence 8DOT5:11524:12543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0128; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11524
msgctxt "text_id=12543 | speaker=aoko"
msgid "　羽毛布団ならクーリングオフが適用されるはず。全ての返品は無理でも、やるにこしたことはないわ」"
msgstr ""

#. Occurrence 8DOT5:11575:12544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0091; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11575
msgctxt "text_id=12544 | speaker=tobimaru"
msgid "「上出来だ。それで行こうぜ蒼崎。"
msgstr ""

#. Occurrence 8DOT5:11581:12545: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0092; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11581
msgctxt "text_id=12545 | speaker=tobimaru"
msgid "　何もおまえさんが悪役になる必要はねえ。せっかくの法治国家だ、平和的に解決しよう」"
msgstr ""

#. Occurrence 8DOT5:11592:12546: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0129; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11592
msgctxt "text_id=12546 | speaker=aoko"
msgid "「それはそうだけど……こんなの部外者だから言えることよ。詐欺にあった人たちからすれば、<奪|と>られたものは奪られたままなんだし……」"
msgstr ""

#. Occurrence 8DOT5:11637:12547: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0093; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11637
msgctxt "text_id=12547 | speaker=tobimaru"
msgid "「それを気に病むのは、それこそおまえの仕事じゃねえ。"
msgstr ""

#. Occurrence 8DOT5:11643:12548: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0094; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11643
msgctxt "text_id=12548 | speaker=tobimaru"
msgid "　まずは<久|く><万|ま><梨|り>に連絡しよう。あいつ、商店街の娘だからな。被害者の調査に向いているだろ」"
msgstr ""

#. Occurrence 8DOT5:11669:12549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0130; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11669
msgctxt "text_id=12549 | speaker=aoko"
msgid "「<金鹿|こじか>に？"
msgstr ""

#. Occurrence 8DOT5:11676:12550: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0131; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11676
msgctxt "text_id=12550 | speaker=aoko"
msgid "　……あんまり<荒事|あらごと>に巻きこみたくないけど、仕方ないか。"
msgstr ""

#. Occurrence 8DOT5:11683:12551: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0132; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11683
msgctxt "text_id=12551 | speaker=aoko"
msgid "ＯＫ、私の方から連絡する。鳶丸は<美|み><濃|の>先輩への電話、お願い」"
msgstr ""

#. Occurrence 8DOT5:11709:12552: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0095; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11709
msgctxt "text_id=12552 | speaker=tobimaru"
msgid "「あ？　こっちの話なら応援団、必要ねえだろ？」"
msgstr ""

#. Occurrence 8DOT5:11735:12553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0133; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11735
msgctxt "text_id=12553 | speaker=aoko"
msgid "「必要だってば。脅し要員だけじゃなく、お爺さん<間|かん>の連携に走ってもらわなくっちゃ。"
msgstr ""

#. Occurrence 8DOT5:11741:12554: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0134; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11741
msgctxt "text_id=12554 | speaker=aoko"
msgid "　先輩たち、いかつい顔して優しいでしょ？　クーリングオフは書面に起こす事が大前提。書類に弱いお爺さんたちの代わりに、先輩たちに代筆してもらうのよ」"
msgstr ""

#. Occurrence 8DOT5:11777:12555: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0096; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11777
msgctxt "text_id=12555 | speaker=tobimaru"
msgid "「なるほど、そりゃあいい！　数の暴力だな、連中も二十人からの返品は夢にも思ってねえだろうさ！」"
msgstr ""

#. Occurrence 8DOT5:11783:12556: scene=8DOT5
#: 8DOT5:11783
msgctxt "text_id=12556 | speaker=unknown"
msgid "　うんうんと頷きあう青子と鳶丸。"
msgstr ""

#. Occurrence 8DOT5:11788:12557: scene=8DOT5
#: 8DOT5:11788
msgctxt "text_id=12557 | speaker=unknown"
msgid "　端で見ている木乃美は完全に置いてけぼりだ。"
msgstr ""

#. Occurrence 8DOT5:11824:12558: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0041; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11824
msgctxt "text_id=12558 | speaker=kinomi"
msgid "「なー。クーリングオフってなんだよー？"
msgstr ""

#. Occurrence 8DOT5:11830:12559: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0042; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11830
msgctxt "text_id=12559 | speaker=kinomi"
msgid "　オレ、聞いたことねぇんだけど」"
msgstr ""

#. Occurrence 8DOT5:11843:12560: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0135; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11843
msgctxt "text_id=12560 | speaker=aoko"
msgid "「買った商品を返品して、購入時の金額を返して貰うコトよ。日本じゃ十年ぐらい前から正式に採用されてるけど、木乃美君、聞いたことない？」"
msgstr ""

#. Occurrence 8DOT5:11869:12561: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0043; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11869
msgctxt "text_id=12561 | speaker=kinomi"
msgid "「いやまったく。ただの返品と違うの？」"
msgstr ""

#. Occurrence 8DOT5:11880:12562: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0136; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11880
msgctxt "text_id=12562 | speaker=aoko"
msgid "「同じだけど、こっちは国が後ろ盾になってくれるわ。ほんものの光が法を盾にするなら、こっちも法で突き破るだけよ。"
msgstr ""

#. Occurrence 8DOT5:11886:12563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0137; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11886
msgctxt "text_id=12563 | speaker=aoko"
msgid "　お爺さんたちには馴染みのない話だろうから、そこは私たちが代わりにやるってワケ」"
msgstr ""

#. Occurrence 8DOT5:11921:12564: scene=8DOT5
#: 8DOT5:11921
msgctxt "text_id=12564 | speaker=unknown"
msgid "　実際のところ、クーリングオフの選定商品には細かい指定があり、ほんものの光が扱っている商品がその規定内かは現状<定|さだ>かではない。"
msgstr ""

#. Occurrence 8DOT5:11926:12565: scene=8DOT5
#: 8DOT5:11926
msgctxt "text_id=12565 | speaker=unknown"
msgid "　もし規定外であるならクーリングオフ制度による金銭回収はできず、青子は別の手段を講じる必要がある。"
msgstr ""

#. Occurrence 8DOT5:11946:12566: scene=8DOT5
#: 8DOT5:11946
msgctxt "text_id=12566 | speaker=unknown"
msgid "　……もっとも。"
msgstr ""

#. Occurrence 8DOT5:11951:12567: scene=8DOT5
#: 8DOT5:11951
msgctxt "text_id=12567 | speaker=unknown"
msgid "　三十分後、実際に売られた羽毛布団を調べた時点で、その不安材料は霧散することになるのだが。"
msgstr ""

#. Occurrence 8DOT5:11987:12568: scene=8DOT5
#: 8DOT5:11987
msgctxt "text_id=12568 | speaker=unknown"
msgid "　方針さえ決めてしまえば青子に迷いはない。"
msgstr ""

#. Occurrence 8DOT5:11992:12569: scene=8DOT5
#: 8DOT5:11992
msgctxt "text_id=12569 | speaker=unknown"
msgid "　オフィスビルを見渡せる喫茶店を司令室に、"
msgstr ""

#. Occurrence 8DOT5:11997:12570: scene=8DOT5
#: 8DOT5:11997
msgctxt "text_id=12570 | speaker=unknown"
msgid "　生徒会の人材を手足にし、"
msgstr ""

#. Occurrence 8DOT5:12002:12571: scene=8DOT5
#: 8DOT5:12002
msgctxt "text_id=12571 | speaker=unknown"
msgid "　一日かぎりの電撃作戦がはじまった。"
msgstr ""

#. Occurrence 8DOT5:12037:12572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0138; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12037
msgctxt "text_id=12572 | speaker=aoko"
msgid "「そうと決まれば迅速にね。"
msgstr ""

#. Occurrence 8DOT5:12045:12573: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0139; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12045
msgctxt "text_id=12573 | speaker=aoko"
msgid "　二人とも連絡係よろしく。サクッと、今日中に決着をつけましょ」"
msgstr ""

#. Occurrence 8DOT5:12079:12574: scene=8DOT5
#: 8DOT5:12079
msgctxt "text_id=12574 | speaker=unknown"
msgid "　一日で終わらせる気かよ、と呆れる副会長と、"
msgstr ""

#. Occurrence 8DOT5:12084:12575: scene=8DOT5
#: 8DOT5:12084
msgctxt "text_id=12575 | speaker=unknown"
msgid "　なんでオレまで数に入ってんの？　と嫌がる事件の発端を使いに出して、青子はクーリングオフ以外の手はないかと資料を読み<耽|ふけ>っている。"
msgstr ""

#. Occurrence 8DOT5:12090:12576: scene=8DOT5
#: 8DOT5:12090
msgctxt "text_id=12576 | speaker=unknown"
msgid "　鳶丸にはタンカを切ったものの、青子自身、クーリングオフ作戦は難しいと理解していたからだ。"
msgstr ""

#. Occurrence 8DOT5:12123:12577: scene=8DOT5
#: 8DOT5:12123
msgctxt "text_id=12577 | speaker=unknown"
msgid "　クーリングオフを成立させるには様々な条件がある。"
msgstr ""

#. Occurrence 8DOT5:12128:12578: scene=8DOT5
#: 8DOT5:12128
msgctxt "text_id=12578 | speaker=unknown"
msgid "　その中で最大のネックになるのが購買してからの経過時間だ。"
msgstr ""

#. Occurrence 8DOT5:12133:12579: scene=8DOT5
#: 8DOT5:12133
msgctxt "text_id=12579 | speaker=unknown"
msgid "　消耗品なら八日以内の返却でなければならない。"
msgstr ""

#. Occurrence 8DOT5:12138:12580: scene=8DOT5
#: 8DOT5:12138
msgctxt "text_id=12580 | speaker=unknown"
msgid "　被害者が三十人いるとしても、該当するのは一人か二人だろう。"
msgstr ""

#. Occurrence 8DOT5:12143:12581: scene=8DOT5
#: 8DOT5:12143
msgctxt "text_id=12581 | speaker=unknown"
msgid "　となると、クーリングオフ以外での、消費者の保護を扱った抜け道を探すしかない。"
msgstr ""

#. Occurrence 8DOT5:12174:12582: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0140; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12174
msgctxt "text_id=12582 | speaker=aoko"
msgid "「……なになに……安価なものを不当な金額で売りつけた場合、暴利行為として公序良俗違反で契約が無効となる場合がある……ただし公序良俗を根拠とする……って、なによこれ、ほとんど売る側の勝ちじゃない。"
msgstr ""

#. Occurrence 8DOT5:12180:12583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0141; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12180
msgctxt "text_id=12583 | speaker=aoko"
msgid "　疑わしきは罰せずが法廷の基本だし。水掛け論じゃこっちが不利だ」"
msgstr ""

#. Occurrence 8DOT5:12212:12584: scene=8DOT5
#: 8DOT5:12212
msgctxt "text_id=12584 | speaker=unknown"
msgid "　だが状況は<厳|きび>しい。"
msgstr ""

#. Occurrence 8DOT5:12217:12585: scene=8DOT5
#: 8DOT5:12217
msgctxt "text_id=12585 | speaker=unknown"
msgid "　相手が<百戦錬磨|ひゃくせんれんま>の詐欺集団なら、素人の知識では太刀打ちできまい。"
msgstr ""

#. Occurrence 8DOT5:12222:12586: scene=8DOT5
#: 8DOT5:12222
msgctxt "text_id=12586 | speaker=unknown"
msgid "　最終的には同じ土俵での戦い―――詐欺には詐欺でまるめこむ事になる。"
msgstr ""

#. Occurrence 8DOT5:12243:12587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0142; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12243
msgctxt "text_id=12587 | speaker=aoko"
msgid "「……だまし取られた金額分だけ、美味しい話でだましとるって<寸法|はなし>か……」"
msgstr ""

#. Occurrence 8DOT5:12249:12588: scene=8DOT5
#: 8DOT5:12249
msgctxt "text_id=12588 | speaker=unknown"
msgid "　その場合であっても情報は必要だ。"
msgstr ""

#. Occurrence 8DOT5:12254:12589: scene=8DOT5
#: 8DOT5:12254
msgctxt "text_id=12589 | speaker=unknown"
msgid "　青子は期末の一夜漬けもかくやという集中力で、かき集めた資料を頭に叩きこんでいく。"
msgstr ""

#. Occurrence 8DOT5:12312:12590: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0000; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12312
msgctxt "text_id=12590 | speaker=kojika"
msgid "「お待たせ。とりあえず追加候補十人分の住所と、布団の現物、持ってきたわよ」"
msgstr ""

#. Occurrence 8DOT5:12318:12591: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_9000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12318
msgctxt "text_id=12591 | speaker=aoko"
msgid "「サンキュー。さっすが久万梨、本気だせば仕事の速いこと速いこと」"
msgstr ""

#. Occurrence 8DOT5:12353:12592: scene=8DOT5
#: 8DOT5:12353
msgctxt "text_id=12592 | speaker=unknown"
msgid "　生徒会書記・久万梨金鹿から被害者のリストを受け取って、すぐさま鳶丸の小型無線機に連絡をいれる。"
msgstr ""

#. Occurrence 8DOT5:12358:12593: scene=8DOT5
#: 8DOT5:12358
msgctxt "text_id=12593 | speaker=unknown"
msgid "　小<型無線|ポケベル>機は“連絡求む”程度の短いメッセージしか送信できないが、連絡手段を公衆電話に頼っている昨今では強力な通信装置だ。"
msgstr ""

#. Occurrence 8DOT5:12363:12594: scene=8DOT5
#: 8DOT5:12363
msgctxt "text_id=12594 | speaker=unknown"
msgid "　青子は折り返しで喫茶店に連絡を入れてきた鳶丸に新しい被害者たちを伝え、鳶丸たちの現状も報告してもらう。"
msgstr ""

#. Occurrence 8DOT5:12393:12595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0143; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12393
msgctxt "text_id=12595 | speaker=aoko"
msgid "「被害者の会はできたのね？　仕切りは青山クンにやらせて。一応、相手への牽制として名刺も作ってくれると助かる。"
msgstr ""

#. Occurrence 8DOT5:12402:12596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0144; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12402
msgctxt "text_id=12596 | speaker=aoko"
msgid "　事務局はほら、文化祭の時に作ったニセ団体あるじゃない。あそこの電話番号にしておいて。電話番は山城センセに頼みこむわ」"
msgstr ""

#. Occurrence 8DOT5:12438:12597: scene=8DOT5
#: 8DOT5:12438
msgctxt "text_id=12597 | speaker=unknown"
msgid "　被害者友の会は現状で十人強。"
msgstr ""

#. Occurrence 8DOT5:12443:12598: scene=8DOT5
#: 8DOT5:12443
msgctxt "text_id=12598 | speaker=unknown"
msgid "　返品、脱会を望む人々の力になるのが会の趣旨である。"
msgstr ""

#. Occurrence 8DOT5:12448:12599: scene=8DOT5
#: 8DOT5:12448
msgctxt "text_id=12599 | speaker=unknown"
msgid "　そもそも騙されていた事すら分かっていなかった人もおり、きちんと説明すれば二十人はたやすく超えるとの事だった。"
msgstr ""

#. Occurrence 8DOT5:12453:12600: scene=8DOT5
#: 8DOT5:12453
msgctxt "text_id=12600 | speaker=unknown"
msgid "　礼儀正しい学生服の好漢が説得にあたっているのも大きい。"
msgstr ""

#. Occurrence 8DOT5:12458:12601: scene=8DOT5
#: 8DOT5:12458
msgctxt "text_id=12601 | speaker=unknown"
msgid "　おじいさんおばあさんは基本、孫に対して<寛大|かんだい>なものである。"
msgstr ""

#. Occurrence 8DOT5:12493:12602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0145; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12493
msgctxt "text_id=12602 | speaker=aoko"
msgid "「にしてもよくここまで調べたもんだわ。規定の二十人なんてあっという間だったわね」"
msgstr ""

#. Occurrence 8DOT5:12526:12603: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0002; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12526
msgctxt "text_id=12603 | speaker=kojika"
msgid "「アンタの言う条件が分かりやすかったから。"
msgstr ""

#. Occurrence 8DOT5:12532:12604: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0003; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12532
msgctxt "text_id=12604 | speaker=kojika"
msgid "　六十歳過ぎのご老人で、ひとり暮らしで、町内会に入っていない人を探せば良かったんだし。やってる事はほんものの光の販売員と一緒。"
msgstr ""

#. Occurrence 8DOT5:12543:12605: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0004; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12543
msgctxt "text_id=12605 | speaker=kojika"
msgid "　でも、こんなんでなんとかなる話じゃないと思うけど。"
msgstr ""

#. Occurrence 8DOT5:12550:12606: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_0; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12550
msgctxt "text_id=12606 | speaker=kojika"
msgid "　結局のところ、抗議するのが関の山じゃ―――"
msgstr ""

#. Occurrence 8DOT5:12562:12607: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_1; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12562
msgctxt "text_id=12607 | speaker=kojika"
msgid "蒼崎？"
msgstr ""

#. Occurrence 8DOT5:12562:12608: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_1; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12562
msgctxt "text_id=12608 | speaker=kojika"
msgid "　ちょっと、なに薄気味悪い顔で笑ってるのよ」"
msgstr ""

#. Occurrence 8DOT5:12582:12609: scene=8DOT5
#: 8DOT5:12582
msgctxt "text_id=12609 | speaker=unknown"
msgid "　友人に指摘され、青子は俯いていた顔をあげる。"
msgstr ""

#. Occurrence 8DOT5:12600:12610: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0146; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12600
msgctxt "text_id=12610 | speaker=aoko"
msgid "「いやあ、面白いもん見付けちゃって。"
msgstr ""

#. Occurrence 8DOT5:12606:12611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0147; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12606
msgctxt "text_id=12611 | speaker=aoko"
msgid "　成果の乏しい戦いになると思ってたけど、風向きが変わったわ。ほら、見てクマ。この羽毛布団のマーク」"
msgstr ""

#. Occurrence 8DOT5:12612:12612: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0006; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12612
msgctxt "text_id=12612 | speaker=kojika"
msgid "「？」"
msgstr ""

#. Occurrence 8DOT5:12643:12613: scene=8DOT5
#: 8DOT5:12643
msgctxt "text_id=12613 | speaker=unknown"
msgid "　青子は羽毛布団に縫いつけられた商品タグを久万梨に見せつけた。"
msgstr ""

#. Occurrence 8DOT5:12648:12614: scene=8DOT5
#: 8DOT5:12648
msgctxt "text_id=12614 | speaker=unknown"
msgid "　タグにはお馴染みのＪＩＳのマーク。"
msgstr ""

#. Occurrence 8DOT5:12653:12615: scene=8DOT5
#: 8DOT5:12653
msgctxt "text_id=12615 | speaker=unknown"
msgid "　工業製品の品質を表すもので、ＪＩＳのマークがある商品は国が定めた工業標準化法に基づいている、のだが……"
msgstr ""

#. Occurrence 8DOT5:12674:12616: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0007; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12674
msgctxt "text_id=12616 | speaker=kojika"
msgid "「あれ？　じぇい……える……えす？」"
msgstr ""

#. Occurrence 8DOT5:12693:12617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0148; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12693
msgctxt "text_id=12617 | speaker=aoko"
msgid "「そ。こうなると契約書が逆に武器になる。百戦錬磨かと思ったけど、実際は兎しか相手にしない素人ってコト。"
msgstr ""

#. Occurrence 8DOT5:12699:12618: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0149; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12699
msgctxt "text_id=12618 | speaker=aoko"
msgid "　……ええ、うまく話をもっていけば全額返済も夢じゃないわ。勝利の勝ちどきは、さぞ気持ちのいいものになるでしょうねぇ」"
msgstr ""

#. Occurrence 8DOT5:12723:12619: scene=8DOT5
#: 8DOT5:12723
msgctxt "text_id=12619 | speaker=unknown"
msgid "　にやりと笑って青子は席を立った。"
msgstr ""

#. Occurrence 8DOT5:12745:12620: scene=8DOT5
#: 8DOT5:12745
msgctxt "text_id=12620 | speaker=unknown"
msgid "　鳶丸へのポケベルは鳴らさず、赤電話を鼻歌まじりにダイヤルする。"
msgstr ""

#. Occurrence 8DOT5:12750:12621: scene=8DOT5
#: 8DOT5:12750
msgctxt "text_id=12621 | speaker=unknown"
msgid "　受話器からはお馴染みのコールの音がリピート中。"
msgstr ""

#. Occurrence 8DOT5:12785:12622: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0008; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12785
msgctxt "text_id=12622 | speaker=kojika"
msgid "「蒼崎？　槻司に連絡入れるんじゃないの？　作戦が変わったって」"
msgstr ""

#. Occurrence 8DOT5:12791:12623: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0150; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12791
msgctxt "text_id=12623 | speaker=aoko"
msgid "「それは後。いま大事なのは交渉役を誰にするかよ。私や鳶丸じゃさすがに貫禄不足だしね。"
msgstr ""

#. Occurrence 8DOT5:12797:12624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0151; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12797
msgctxt "text_id=12624 | speaker=aoko"
msgid "　こっちが有利になったとしても、まだ状況は五分だし。"
msgstr ""

#. Occurrence 8DOT5:12803:12625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0152; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12803
msgctxt "text_id=12625 | speaker=aoko"
msgid "　会話次第じゃひっくり返されるだろうから、被害者の会の代表は、それはもう、性根のひん曲がった悪魔でないと」"
msgstr ""

#. Occurrence 8DOT5:12829:12626: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0009; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12829
msgctxt "text_id=12626 | speaker=kojika"
msgid "「それアンタの事だと思うんだけど。違うの？」"
msgstr ""

#. Occurrence 8DOT5:12835:12627: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0153; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12835
msgctxt "text_id=12627 | speaker=aoko"
msgid "「いえいえ、こういうのは社会的立場のある大人じゃないと務まりません。"
msgstr ""

#. Occurrence 8DOT5:12841:12628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0154; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12841
msgctxt "text_id=12628 | speaker=aoko"
msgid "　安心して久万梨、ぴったりのヤツを知ってるから」"
msgstr ""

#. Occurrence 8DOT5:12875:12629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0155; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12875
msgctxt "text_id=12629 | speaker=aoko"
msgid "「ま、詐欺師には詐欺師ってね。"
msgstr ""

#. Occurrence 8DOT5:12881:12630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0156; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12881
msgctxt "text_id=12630 | speaker=aoko"
msgid "　この町には人を言い負かすのだけが仕事のヤツっていちゃったりするのよ。今日もやることなくて暇してるだろうし、たまには働いてもらわないと。"
msgstr ""

#. Occurrence 8DOT5:12887:12631: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0157; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12887
msgctxt "text_id=12631 | speaker=aoko"
msgid "　彼女にかかっちゃサラ金だろうが教祖だろうが一時間で精神崩壊、<裸足|はだし>で山に逃げこむわ」"
msgstr ""

#. Occurrence 8DOT5:12907:12632: scene=8DOT5
#: 8DOT5:12907
msgctxt "text_id=12632 | speaker=unknown"
msgid "　これ以上ない嫌味を言いながら、青子は受話器に耳を当てる。"
msgstr ""

#. Occurrence 8DOT5:12912:12633: scene=8DOT5
#: 8DOT5:12912
msgctxt "text_id=12633 | speaker=unknown"
msgid "　ちなみに、受話器から漏れていたコール音はとっくに消えていた。"
msgstr ""

#. Occurrence 8DOT5:12945:12634: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0000; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:12945
msgctxt "text_id=12634 | speaker=yuika"
msgid "『―――もしもし。まさかとは思いますが、今の話は私の事でしょうか、青子さん？』"
msgstr ""

#. Occurrence 8DOT5:12951:12635: scene=8DOT5
#: 8DOT5:12951
msgctxt "text_id=12635 | speaker=unknown"
msgid "　受話器から<流暢|りゅうちょう>な女性の声が響く。"
msgstr ""

#. Occurrence 8DOT5:12956:12636: scene=8DOT5
#: 8DOT5:12956
msgctxt "text_id=12636 | speaker=unknown"
msgid "　青子は白々しく挨拶しながら、獲物が挑発にのってくれたとほくそ笑んだ。"
msgstr ""

#. Occurrence 8DOT5:13017:12637: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0001; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13017
msgctxt "text_id=12637 | speaker=yuika"
msgid "「つねづね思っていましたが。"
msgstr ""

#. Occurrence 8DOT5:13023:12638: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0002; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13023
msgctxt "text_id=12638 | speaker=yuika"
msgid "　貴女には年長者への敬意が足りていないようですね、青子さん」"
msgstr ""

#. Occurrence 8DOT5:13047:12639: voice_id=X70_8DOT5_0000; voice_prefix=X70; voice_category=0; scene=8DOT5
#: 8DOT5:13047
msgctxt "text_id=12639 | speaker=unknown"
msgid "「「へ？」」"
msgstr ""

#. Occurrence 8DOT5:13067:12640: scene=8DOT5
#: 8DOT5:13067
msgctxt "text_id=12640 | speaker=unknown"
msgid "　役割を終えて集結していた鳶丸たちが目を見張る。"
msgstr ""

#. Occurrence 8DOT5:13072:12641: scene=8DOT5
#: 8DOT5:13072
msgctxt "text_id=12641 | speaker=unknown"
msgid "　青子の呼び出しでやってきた人物は、この場にはあまりにも不釣り合いで、予想外だったからだ。"
msgstr ""

#. Occurrence 8DOT5:13113:12642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0158; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13113
msgctxt "text_id=12642 | speaker=aoko"
msgid "「はあい、<唯架|ゆいか>さん。わざわざ来てもらって助かるわ。"
msgstr ""

#. Occurrence 8DOT5:13119:12643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0159; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13119
msgctxt "text_id=12643 | speaker=aoko"
msgid "　事情は電話で説明したけど、もう少し詳しく説明する？」"
msgstr ""

#. Occurrence 8DOT5:13130:12644: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0003; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13130
msgctxt "text_id=12644 | speaker=yuika"
msgid "「結構です。ほんものの光の事は、先ほど<律架|りつか>から報告を受けましたから。貴女に教授していただく事柄は一つもありません」"
msgstr ""

#. Occurrence 8DOT5:13156:12645: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0160; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13156
msgctxt "text_id=12645 | speaker=aoko"
msgid "「ありゃまご機嫌ななめ。良かった、そのテンションのままカチコミお願いね。一般人のひとりやふたり、唯架さんが本性をだせば睨むだけで<卒倒|そっとう>させられるでしょ？」"
msgstr ""

#. Occurrence 8DOT5:13174:12646: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0044; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13174
msgctxt "text_id=12646 | speaker=kinomi"
msgid "「うえ、そうなの!?　このお姉さん、合田教会のシスターさんだよね!?　オレ、ひそかに<憧|あこが>れてたんですけど！"
msgstr ""

#. Occurrence 8DOT5:13180:12647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0045; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13180
msgctxt "text_id=12647 | speaker=kinomi"
msgid "　あ、いや、そんな場合じゃねえ、どうも木乃美芳助ッス！　蒼崎サンとはあんまり仲良くありません！」"
msgstr ""

#. Occurrence 8DOT5:13200:12648: scene=8DOT5
#: 8DOT5:13200
msgctxt "text_id=12648 | speaker=unknown"
msgid "　咄嗟に青子とシスターの仲が悪いと察し、さりげなくポイントアップを図る木乃美。"
msgstr ""

#. Occurrence 8DOT5:13213:12649: scene=8DOT5
#: 8DOT5:13213
msgctxt "text_id=12649 | speaker=unknown"
msgid "　そんなやんちゃな青少年に、シスターは天使のような微笑みを投げるのだった。"
msgstr ""

#. Occurrence 8DOT5:13234:12650: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0004; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13234
msgctxt "text_id=12650 | speaker=yuika"
msgid "「これはご丁寧に。合田教会で僧職を勤める、<周|す><瀬|せ><唯架|ゆいか>です。はじめまして、芳助さん」"
msgstr ""

#. Occurrence 8DOT5:13246:12651: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0046; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13246
msgctxt "text_id=12651 | speaker=kinomi"
msgid "「ひゃー！　すげえ、ホントにシスターだよシスター！"
msgstr ""

#. Occurrence 8DOT5:13246:12652: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0046; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13246
msgctxt "text_id=12652 | speaker=kinomi"
msgid "　会長とんでもない隠し球つれてきたな！"
msgstr ""

#. Occurrence 8DOT5:13258:12653: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0047; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13258
msgctxt "text_id=12653 | speaker=kinomi"
msgid "　……あれ？　でも、唯架さんに何してもらうの？　いや、オレはいてくれるだけで嬉しいけど」"
msgstr ""

#. Occurrence 8DOT5:13296:12654: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0097; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13296
msgctxt "text_id=12654 | speaker=tobimaru"
msgid "「……まあ、だいたい想像できるが。"
msgstr ""

#. Occurrence 8DOT5:13307:12655: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0098; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13307
msgctxt "text_id=12655 | speaker=tobimaru"
msgid "　はじめまして、シスター唯架。三咲高校生徒会副会長、槻司鳶丸です」"
msgstr ""

#. Occurrence 8DOT5:13336:12656: scene=8DOT5
#: 8DOT5:13336
msgctxt "text_id=12656 | speaker=unknown"
msgid "　一方、事の成り行きが読めたのか、鳶丸は元気がない。"
msgstr ""

#. Occurrence 8DOT5:13341:12657: scene=8DOT5
#: 8DOT5:13341
msgctxt "text_id=12657 | speaker=unknown"
msgid "　ＪＬＳマークが違法であること。"
msgstr ""

#. Occurrence 8DOT5:13346:12658: scene=8DOT5
#: 8DOT5:13346
msgctxt "text_id=12658 | speaker=unknown"
msgid "　羽毛布団が<偽物|バッタ>ものである事が判った時点で、青子は被害者たちの支払金の全額回収と、ほんものの光を町から追い出す算段を立てた。"
msgstr ""

#. Occurrence 8DOT5:13351:12659: scene=8DOT5
#: 8DOT5:13351
msgctxt "text_id=12659 | speaker=unknown"
msgid "　その結論が、目の前のシスターだと察したからだ。"
msgstr ""

#. Occurrence 8DOT5:13384:12660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0099; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13384
msgctxt "text_id=12660 | speaker=tobimaru"
msgid "「……てっきり証拠にものをいわせて、訴えられたくなければ示談ですませろ、全額返して出て行けー、って話かと思ったが。"
msgstr ""

#. Occurrence 8DOT5:13391:12661: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0100; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13391
msgctxt "text_id=12661 | speaker=tobimaru"
msgid "……恐ろしい女だぜ。追い出すだけじゃなく、<素寒貧|すかんぴん>にして放りだそうってハラか」"
msgstr ""

#. Occurrence 8DOT5:13409:12662: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0048; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13409
msgctxt "text_id=12662 | speaker=kinomi"
msgid "「は？　なんでそうなるの？　なに、美人なだけじゃなく、シスターさんってそんな権利持ってるの？」"
msgstr ""

#. Occurrence 8DOT5:13442:12663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0161; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13442
msgctxt "text_id=12663 | speaker=aoko"
msgid "「シスターさんが、じゃなくて唯架さんの人間力と言うべきね。はい、これ被害者の会からの連名書。一応、うちの応援団の先輩たちも待機してるけど、何人か連れていく？」"
msgstr ""

#. Occurrence 8DOT5:13485:12664: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0005; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13485
msgctxt "text_id=12664 | speaker=yuika"
msgid "「……そうですね。<逆上|ぎゃくじょう>して手を上げられては後片づけが面倒ですので、抑止力として五人ほど。"
msgstr ""

#. Occurrence 8DOT5:13491:12665: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0006; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13491
msgctxt "text_id=12665 | speaker=yuika"
msgid "　あとは青子さんが同行してくれるのでしたら、私としては不満はありません」"
msgstr ""

#. Occurrence 8DOT5:13538:12666: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0049; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13538
msgctxt "text_id=12666 | speaker=kinomi"
msgid "「え？　どゆこと？　もしかしてシスターさんが話つけにいくの？　会長のがよくね？」"
msgstr ""

#. Occurrence 8DOT5:13549:12667: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0162; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13549
msgctxt "text_id=12667 | speaker=aoko"
msgid "「いいのいいの。唯架さんはこう見えて荒事の専門家なんだから。ねー、唯架さん？」"
msgstr ""

#. Occurrence 8DOT5:13598:12668: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0007; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13598
msgctxt "text_id=12668 | speaker=yuika"
msgid "「貴女ほどではありませんが。"
msgstr ""

#. Occurrence 8DOT5:13604:12669: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0008; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13604
msgctxt "text_id=12669 | speaker=yuika"
msgid "　……いいでしょう、今回は利益が一致します。あの事務所の方々が違法を働いているのは事実ですから。"
msgstr ""

#. Occurrence 8DOT5:13610:12670: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0009; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13610
msgctxt "text_id=12670 | speaker=yuika"
msgid "　罪には罰を。善良な人々を、とくに私たちの同胞を苦しめた手合いには、相応の痛みが必要です」"
msgstr ""

#. Occurrence 8DOT5:13649:12671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0163; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13649
msgctxt "text_id=12671 | speaker=aoko"
msgid "「さっすが泣く子も黙る鬼のシスター。"
msgstr ""

#. Occurrence 8DOT5:13655:12672: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0164; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13655
msgctxt "text_id=12672 | speaker=aoko"
msgid "　期待してるわ。昔っから、商売<敵|がたき>を潰すのは得意だものね、貴女たち」"
msgstr ""

#. Occurrence 8DOT5:13673:12673: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0010; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13673
msgctxt "text_id=12673 | speaker=yuika"
msgid "「言われるまでもありません。"
msgstr ""

#. Occurrence 8DOT5:13679:12674: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0011; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13679
msgctxt "text_id=12674 | speaker=yuika"
msgid "　一つの土地に、二つの教えがあっては迷惑です」"
msgstr ""

#. Occurrence 8DOT5:13748:12675: scene=8DOT5
#: 8DOT5:13748
msgctxt "text_id=12675 | speaker=unknown"
msgid "　ふたりは反目の火花を散らしながらも、肩を並べてオフィスビルへと入っていった。"
msgstr ""

#. Occurrence 8DOT5:13753:12676: scene=8DOT5
#: 8DOT5:13753
msgctxt "text_id=12676 | speaker=unknown"
msgid "　五人のむくつけき応援団員ものっしのっしと後に続く。"
msgstr ""

#. Occurrence 8DOT5:13758:12677: scene=8DOT5
#: 8DOT5:13758
msgctxt "text_id=12677 | speaker=unknown"
msgid "　残されたのは肩をすくめる鳶丸と、事情をいっさい把握できない木乃美だけ。"
msgstr ""

#. Occurrence 8DOT5:13797:12678: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0050; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13797
msgctxt "text_id=12678 | speaker=kinomi"
msgid "「……わっかんねー。"
msgstr ""

#. Occurrence 8DOT5:13797:12679: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0050; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13797
msgctxt "text_id=12679 | speaker=kinomi"
msgid "　蒼崎、あの美人さんに何やらせる気なんだよ？」"
msgstr ""

#. Occurrence 8DOT5:13821:12680: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0101; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13821
msgctxt "text_id=12680 | speaker=tobimaru"
msgid "「そりゃおまえ、口にはできない残虐行為だろ。相手の弱みをにぎったらとことん叩きのめすのが蒼崎だからな。"
msgstr ""

#. Occurrence 8DOT5:13827:12681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0102; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13827
msgctxt "text_id=12681 | speaker=tobimaru"
msgid "　違法販売をネタにして、契約解除をさせた後に告訴するって流れ。訴えるのはシスターの役目だな。"
msgstr ""

#. Occurrence 8DOT5:13834:12682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0103; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13834
msgctxt "text_id=12682 | speaker=tobimaru"
msgid "立場上、学生である蒼崎よりシスターのほうがお題目が立つ。"
msgstr ""

#. Occurrence 8DOT5:13845:12683: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0104; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13845
msgctxt "text_id=12683 | speaker=tobimaru"
msgid "　……なによりあの教会、たまにイヤな噂を聞くしなあ。連中、貯めた財産根こそぎ奪られるだけで済めばいいが」"
msgstr ""

#. Occurrence 8DOT5:13870:12684: scene=8DOT5
#: 8DOT5:13870
msgctxt "text_id=12684 | speaker=unknown"
msgid "　さて、と一息ついてから、鳶丸もオフィスビルへと足を向けた。"
msgstr ""

#. Occurrence 8DOT5:13881:12685: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0051; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13881
msgctxt "text_id=12685 | speaker=kinomi"
msgid "「え、殿下も事務所に行くの？　怖くない？」"
msgstr ""

#. Occurrence 8DOT5:13899:12686: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0105; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13899
msgctxt "text_id=12686 | speaker=tobimaru"
msgid "「いかねえよ、おっかねえ。俺のはちょっとした野暮用だ。"
msgstr ""

#. Occurrence 8DOT5:13905:12687: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0106; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13905
msgctxt "text_id=12687 | speaker=tobimaru"
msgid "　テメエも補習に戻れよ。今日の礼は、また改めてくれてやるから」"
msgstr ""

#. Occurrence 8DOT5:13938:12688: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0052; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13938
msgctxt "text_id=12688 | speaker=kinomi"
msgid "「ばっか、補習なんてもう終わってるじゃんか。気が付けばもうすぐ夕方だぜ、夕方。楽しかったからいいけどな！」"
msgstr ""

#. Occurrence 8DOT5:13956:12689: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0107; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13956
msgctxt "text_id=12689 | speaker=tobimaru"
msgid "「違いない。あっというまの半日だった」"
msgstr ""

#. Occurrence 8DOT5:13966:12690: scene=8DOT5
#: 8DOT5:13966
msgctxt "text_id=12690 | speaker=unknown"
msgid "　それじゃあ、と手を振って、鳶丸はオフィスビルの入り口に消えていった。"
msgstr ""

#. Occurrence 8DOT5:13997:12691: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0053; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13997
msgctxt "text_id=12691 | speaker=kinomi"
msgid "「？」"
msgstr ""

#. Occurrence 8DOT5:14002:12692: scene=8DOT5
#: 8DOT5:14002
msgctxt "text_id=12692 | speaker=unknown"
msgid "　それを疑問に思いながらも、"
msgstr ""

#. Occurrence 8DOT5:14014:12693: scene=8DOT5
#: 8DOT5:14014
msgctxt "text_id=12693 | speaker=unknown"
msgid "　オフィスビルの三階から響いた、どうみても窓ガラスの割れる音を聴いて、木乃美も現場を後にした。"
msgstr ""

#. Occurrence 8DOT5:14023:12694: scene=8DOT5
#: 8DOT5:14023
msgctxt "text_id=12694 | speaker=unknown"
msgid "　君子危うきに近寄らず、である。"
msgstr ""

#. Occurrence 8DOT5:14064:12695: scene=8DOT5
#: 8DOT5:14064
msgctxt "text_id=12695 | speaker=unknown"
msgid "　何事もなく話し合いは終了した。"
msgstr ""

#. Occurrence 8DOT5:14069:12696: scene=8DOT5
#: 8DOT5:14069
msgctxt "text_id=12696 | speaker=unknown"
msgid "　事務所の内部はモーゼの十戒よろしく、シスターの一蹴りによって真ん中の机の列がきれいさっぱり吹っ飛んでいるだけで、ひとりの流血もない、実に平和的な解決だった。"
msgstr ""

#. Occurrence 8DOT5:14075:12697: scene=8DOT5
#: 8DOT5:14075
msgctxt "text_id=12697 | speaker=unknown"
msgid "　そんなわけで、およそ半刻ほどで事務所の制圧を終えた蒼崎青子は、きょろきょろとあたりを見渡している。"
msgstr ""

#. Occurrence 8DOT5:14095:12698: scene=8DOT5
#: 8DOT5:14095
msgctxt "text_id=12698 | speaker=unknown"
msgid "　シスターの、鶴を思わせる手の一振りで宙に舞ったまま窓ガラスにつきささった大型デスク。"
msgstr ""

#. Occurrence 8DOT5:14100:12699: scene=8DOT5
#: 8DOT5:14100
msgctxt "text_id=12699 | speaker=unknown"
msgid "　悪魔でも見たかのように部屋の隅でガクガクと震える販売員たち。"
msgstr ""

#. Occurrence 8DOT5:14105:12700: scene=8DOT5
#: 8DOT5:14105
msgctxt "text_id=12700 | speaker=unknown"
msgid "　五人の応援団員をひきつれ、事務所の利権証明書等を押さえていくシスター。"
msgstr ""

#. Occurrence 8DOT5:14130:12701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0165; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14130
msgctxt "text_id=12701 | speaker=aoko"
msgid "「あれ？」"
msgstr ""

#. Occurrence 8DOT5:14136:12702: scene=8DOT5
#: 8DOT5:14136
msgctxt "text_id=12702 | speaker=unknown"
msgid "　しかし、青子の探しものは影も形も見あたらない。"
msgstr ""

#. Occurrence 8DOT5:14141:12703: scene=8DOT5
#: 8DOT5:14141
msgctxt "text_id=12703 | speaker=unknown"
msgid "　首をかしげながら、部屋の隅の販売員に声をかける。"
msgstr ""

#. Occurrence 8DOT5:14168:12704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0166; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14168
msgctxt "text_id=12704 | speaker=aoko"
msgid "「ちょっと。三時間ぐらい前、ここに人畜無害そうなのこなかった？　ビルから出てきてないから、まだ中にいると思うんだけど」"
msgstr ""

#. Occurrence 8DOT5:14174:12705: scene=8DOT5
#: 8DOT5:14174
msgctxt "text_id=12705 | speaker=unknown"
msgid "　販売員たちはブンブンと首をふる。"
msgstr ""

#. Occurrence 8DOT5:14179:12706: scene=8DOT5
#: 8DOT5:14179
msgctxt "text_id=12706 | speaker=unknown"
msgid "　事務所には純朴そうな学生の姿など何処にもない。"
msgstr ""

#. Occurrence 8DOT5:14205:12707: scene=8DOT5
#: 8DOT5:14205
msgctxt "text_id=12707 | speaker=unknown"
msgid "　どういう事？　とさらに首をかしげるも、"
msgstr ""

#. Occurrence 8DOT5:14218:12708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0167; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14218
msgctxt "text_id=12708 | speaker=aoko"
msgid "「でもまあ」"
msgstr ""

#. Occurrence 8DOT5:14224:12709: scene=8DOT5
#: 8DOT5:14224
msgctxt "text_id=12709 | speaker=unknown"
msgid "　イイコトしたからいっか、と満足する生徒会長なのだった。"
msgstr ""

#. Occurrence 8DOT5:14260:12710: scene=8DOT5
#: 8DOT5:14260
msgctxt "text_id=12710 | speaker=unknown"
msgid "　鳶丸はオフィスビルに足を踏み入れると、そのまま通路を直進した。"
msgstr ""

#. Occurrence 8DOT5:14265:12711: scene=8DOT5
#: 8DOT5:14265
msgctxt "text_id=12711 | speaker=unknown"
msgid "　入って正面にある上層への階段には視線を投げただけで、いくつかの<貸部屋|テナント>を通り過ぎ、ビルの裏手に出る非常口まで歩いていく。"
msgstr ""

#. Occurrence 8DOT5:14285:12712: scene=8DOT5
#: 8DOT5:14285
msgctxt "text_id=12712 | speaker=unknown"
msgid "　鳶丸はここ二丁目の地理に明るい。"
msgstr ""

#. Occurrence 8DOT5:14290:12713: scene=8DOT5
#: 8DOT5:14290
msgctxt "text_id=12713 | speaker=unknown"
msgid "　彼の記憶によると、このビルの裏手には開発の手がかかっていない、昔ながらの平屋が並んでいる。"
msgstr ""

#. Occurrence 8DOT5:14295:12714: scene=8DOT5
#: 8DOT5:14295
msgctxt "text_id=12714 | speaker=unknown"
msgid "　時代の波に取り残されたトタンの貸し屋。"
msgstr ""

#. Occurrence 8DOT5:14300:12715: scene=8DOT5
#: 8DOT5:14300
msgctxt "text_id=12715 | speaker=unknown"
msgid "　近代的な二階建てアパートの影に飲まれてはいるが、まだ十分に<活|い>きている一角だ。"
msgstr ""

#. Occurrence 8DOT5:14352:12716: scene=8DOT5
#: 8DOT5:14352
msgctxt "text_id=12716 | speaker=unknown"
msgid "　裏口から出ると、正面には下水を処理するための川があった。"
msgstr ""

#. Occurrence 8DOT5:14357:12717: scene=8DOT5
#: 8DOT5:14357
msgctxt "text_id=12717 | speaker=unknown"
msgid "　川とフェンスの向こうには平屋住宅が並んでいる。"
msgstr ""

#. Occurrence 8DOT5:14362:12718: scene=8DOT5
#: 8DOT5:14362
msgctxt "text_id=12718 | speaker=unknown"
msgid "　ビルのすぐ横には向こう岸に渡る橋がある。"
msgstr ""

#. Occurrence 8DOT5:14367:12719: scene=8DOT5
#: 8DOT5:14367
msgctxt "text_id=12719 | speaker=unknown"
msgid "　この界隈の人間しか知り得ない、ちょっとした近道のようだ。"
msgstr ""

#. Occurrence 8DOT5:14399:12720: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0108; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14399
msgctxt "text_id=12720 | speaker=tobimaru"
msgid "「……なるほど、大したショートカットだ。地図なんてアテになんねえな」"
msgstr ""

#. Occurrence 8DOT5:14405:12721: scene=8DOT5
#: 8DOT5:14405
msgctxt "text_id=12721 | speaker=unknown"
msgid "　鳶丸が橋に向かって足を進めると、平屋から見慣れた少年が出てくるところだった。"
msgstr ""

#. Occurrence 8DOT5:14414:12722: scene=8DOT5
#: 8DOT5:14414
msgctxt "text_id=12722 | speaker=unknown"
msgid "　コートに着られている姿は、間違いなく静希草十郎である。"
msgstr ""

#. Occurrence 8DOT5:14448:12723: voice_id=E60_8DOT5_0000; voice_prefix=E60; voice_category=0; scene=8DOT5
#: 8DOT5:14448
msgctxt "text_id=12723 | speaker=unknown"
msgid "「明日もまた来ておくれね」"
msgstr ""

#. Occurrence 8DOT5:14454:12724: scene=8DOT5
#: 8DOT5:14454
msgctxt "text_id=12724 | speaker=unknown"
msgid "　平屋の主人であろう、年老いた老婆に見送られて、草十郎は橋を渡る。"
msgstr ""

#. Occurrence 8DOT5:14489:12725: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0030; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14489
msgctxt "text_id=12725 | speaker=soujuurou"
msgid "「あれ、副会長？」"
msgstr ""

#. Occurrence 8DOT5:14497:12726: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0109; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14497
msgctxt "text_id=12726 | speaker=tobimaru"
msgid "「よ。奇遇だな色男」"
msgstr ""

#. Occurrence 8DOT5:14517:12727: scene=8DOT5
#: 8DOT5:14517
msgctxt "text_id=12727 | speaker=unknown"
msgid "　必然、二人は橋の上で顔を合わせた。"
msgstr ""

#. Occurrence 8DOT5:14522:12728: scene=8DOT5
#: 8DOT5:14522
msgctxt "text_id=12728 | speaker=unknown"
msgid "　草十郎の顔は心なしか元気がない。"
msgstr ""

#. Occurrence 8DOT5:14527:12729: scene=8DOT5
#: 8DOT5:14527
msgctxt "text_id=12729 | speaker=unknown"
msgid "　その様子を見て鳶丸は納得した。"
msgstr ""

#. Occurrence 8DOT5:14532:12730: scene=8DOT5
#: 8DOT5:14532
msgctxt "text_id=12730 | speaker=unknown"
msgid "　この男の新しいバイトとやらは、詐欺の片棒を担ぐより、何倍も気難しい話だったのだと。"
msgstr ""

#. Occurrence 8DOT5:14582:12731: scene=8DOT5
#: 8DOT5:14582
msgctxt "text_id=12731 | speaker=unknown"
msgid "　なんとなしにふたりは帰り道を同じにし、歩道橋の上で立ち止まった。"
msgstr ""

#. Occurrence 8DOT5:14597:12732: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0110; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14597
msgctxt "text_id=12732 | speaker=tobimaru"
msgid "「あのあたりに親戚でもいんのか？」"
msgstr ""

#. Occurrence 8DOT5:14603:12733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0031; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14603
msgctxt "text_id=12733 | speaker=soujuurou"
msgid "「いや、いない。人づてに紹介されて、おばあさんの話し相手をしていただけだ」"
msgstr ""

#. Occurrence 8DOT5:14608:12734: scene=8DOT5
#: 8DOT5:14608
msgctxt "text_id=12734 | speaker=unknown"
msgid "　青子に問いつめられても話さなかった事を、草十郎はあっさり口にした。"
msgstr ""

#. Occurrence 8DOT5:14629:12735: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0111; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14629
msgctxt "text_id=12735 | speaker=tobimaru"
msgid "「そんなに気軽に話していいのか？　守秘義務とかありそうだが」"
msgstr ""

#. Occurrence 8DOT5:14635:12736: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0032; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14635
msgctxt "text_id=12736 | speaker=soujuurou"
msgid "「いや、秘密にしなくちゃいけない話でもないんだ。"
msgstr ""

#. Occurrence 8DOT5:14635:12737: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0032; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14635
msgctxt "text_id=12737 | speaker=soujuurou"
msgid "　ただ話しちゃいけない気がしただけで。"
msgstr ""

#. Occurrence 8DOT5:14641:12738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0033; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14641
msgctxt "text_id=12738 | speaker=soujuurou"
msgid "　鳶丸には出てくるところを見られたし、正直、誰かに言いたい気持ちはあった。弱音みたいなものだから、副会長が聞いてくれるならちょうどいい」"
msgstr ""

#. Occurrence 8DOT5:14661:12739: scene=8DOT5
#: 8DOT5:14661
msgctxt "text_id=12739 | speaker=unknown"
msgid "　歩道橋の<欄干|らんかん>に寄りかかりながら、鳶丸は先を<促|うなが>した。"
msgstr ""

#. Occurrence 8DOT5:14666:12740: scene=8DOT5
#: 8DOT5:14666
msgctxt "text_id=12740 | speaker=unknown"
msgid "　草十郎の話は、フタを開けてみれば平凡なものだった。"
msgstr ""

#. Occurrence 8DOT5:14672:12741: scene=8DOT5
#: 8DOT5:14672
msgctxt "text_id=12741 | speaker=unknown"
msgid "　彼の新しいアルバイトは、あの平屋住宅の、とある家のホームヘルパーだった。"
msgstr ""

#. Occurrence 8DOT5:14677:12742: scene=8DOT5
#: 8DOT5:14677
msgctxt "text_id=12742 | speaker=unknown"
msgid "　ただ少し風向きが違うのは、その家の老婆は夫に先立たれ、息子も都会に出たまま便りをよこさなくなった事だ。"
msgstr ""

#. Occurrence 8DOT5:14712:12743: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0034; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14712
msgctxt "text_id=12743 | speaker=soujuurou"
msgid "「はじめは、ただのお手伝いだったんだけどね」"
msgstr ""

#. Occurrence 8DOT5:14718:12744: scene=8DOT5
#: 8DOT5:14718
msgctxt "text_id=12744 | speaker=unknown"
msgid "　困ったような、悔いるような笑顔で彼は言った。"
msgstr ""

#. Occurrence 8DOT5:14723:12745: scene=8DOT5
#: 8DOT5:14723
msgctxt "text_id=12745 | speaker=unknown"
msgid "　あるいは、不当な行為への嫌悪か。"
msgstr ""

#. Occurrence 8DOT5:14728:12746: scene=8DOT5
#: 8DOT5:14728
msgctxt "text_id=12746 | speaker=unknown"
msgid "　自虐的にすら見える苦笑いは、暗い<翳|かげ>りを帯びている。"
msgstr ""

#. Occurrence 8DOT5:14761:12747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0112; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14761
msgctxt "text_id=12747 | speaker=tobimaru"
msgid "「…………」"
msgstr ""

#. Occurrence 8DOT5:14772:12748: scene=8DOT5
#: 8DOT5:14772
msgctxt "text_id=12748 | speaker=unknown"
msgid "　鳶丸はかすかに驚いて、すぐに自分の頬を叩いた。"
msgstr ""

#. Occurrence 8DOT5:14777:12749: scene=8DOT5
#: 8DOT5:14777
msgctxt "text_id=12749 | speaker=unknown"
msgid "　この少年が、その手の感情を見せるとは夢にも思っていなかった―――そんな身勝手な思いこみを恥じ入って、自分自身を罰したのだ。"
msgstr ""

#. Occurrence 8DOT5:14798:12750: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0113; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14798
msgctxt "text_id=12750 | speaker=tobimaru"
msgid "「珍しくうかない顔だが。あれか、出ていった息子さんとやらに文句があるのか？　<介護|かいご>が必要なお<袋|ふくろ>さんを放って、好きかってに暮らしていることに？」"
msgstr ""

#. Occurrence 8DOT5:14816:12751: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0035; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14816
msgctxt "text_id=12751 | speaker=soujuurou"
msgid "「……どうだろう。確かにおかしな話だとは思う。"
msgstr ""

#. Occurrence 8DOT5:14822:12752: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0036; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14822
msgctxt "text_id=12752 | speaker=soujuurou"
msgid "　けど、俺はその息子さんを責める気にはなれない。だって、それは」"
msgstr ""

#. Occurrence 8DOT5:14847:12753: scene=8DOT5
#: 8DOT5:14847
msgctxt "text_id=12753 | speaker=unknown"
msgid "　言いかけて口を<噤|つぐ>む。"
msgstr ""

#. Occurrence 8DOT5:14852:12754: scene=8DOT5
#: 8DOT5:14852
msgctxt "text_id=12754 | speaker=unknown"
msgid "　おそらく、その息子は母を嫌ったのではなく、この町を嫌ったのだ。"
msgstr ""

#. Occurrence 8DOT5:14857:12755: scene=8DOT5
#: 8DOT5:14857
msgctxt "text_id=12755 | speaker=unknown"
msgid "　単に、ここより好きな場所があったら、この町から出ていっただけの話。"
msgstr ""

#. Occurrence 8DOT5:14862:12756: scene=8DOT5
#: 8DOT5:14862
msgctxt "text_id=12756 | speaker=unknown"
msgid "　草十郎はそれを<苦々|にがにが>しげに、声にせず飲みこんだ。"
msgstr ""

#. Occurrence 8DOT5:14898:12757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0037; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14898
msgctxt "text_id=12757 | speaker=soujuurou"
msgid "「お手伝いの料金は初めに全部もらってたんだ。"
msgstr ""

#. Occurrence 8DOT5:14898:12758: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0037; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14898
msgctxt "text_id=12758 | speaker=soujuurou"
msgid "　今月だけという話なのに、十万円は高すぎると思う」"
msgstr ""

#. Occurrence 8DOT5:14904:12759: scene=8DOT5
#: 8DOT5:14904
msgctxt "text_id=12759 | speaker=unknown"
msgid "　本気で、こんなにお金はいらないのに、と呟く。"
msgstr ""

#. Occurrence 8DOT5:14909:12760: scene=8DOT5
#: 8DOT5:14909
msgctxt "text_id=12760 | speaker=unknown"
msgid "　そんな少年に老婆は感謝をした。"
msgstr ""

#. Occurrence 8DOT5:14914:12761: scene=8DOT5
#: 8DOT5:14914
msgctxt "text_id=12761 | speaker=unknown"
msgid "　草十郎の頼りないところも微笑ましかったのだろう。"
msgstr ""

#. Occurrence 8DOT5:14919:12762: scene=8DOT5
#: 8DOT5:14919
msgctxt "text_id=12762 | speaker=unknown"
msgid "　老婆はすぐに心を許し、数日を待たずして草十郎を孫と同一視するようになったらしい。"
msgstr ""

#. Occurrence 8DOT5:14940:12763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0038; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14940
msgctxt "text_id=12763 | speaker=soujuurou"
msgid "「……ああ。それは素直に嬉しいんだけど、問題は」"
msgstr ""

#. Occurrence 8DOT5:14946:12764: scene=8DOT5
#: 8DOT5:14946
msgctxt "text_id=12764 | speaker=unknown"
msgid "　問題は、明日も来ておくれ、と。"
msgstr ""

#. Occurrence 8DOT5:14951:12765: scene=8DOT5
#: 8DOT5:14951
msgctxt "text_id=12765 | speaker=unknown"
msgid "　わたしを忘れないでおくれと、別れ際に草十郎に大金を手渡した事だ。"
msgstr ""

#. Occurrence 8DOT5:14986:12766: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0114; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14986
msgctxt "text_id=12766 | speaker=tobimaru"
msgid "「ああ？　それだけで大金もらってたのか？」"
msgstr ""

#. Occurrence 8DOT5:14992:12767: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0039; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14992
msgctxt "text_id=12767 | speaker=soujuurou"
msgid "「うん。お孫さんの代わりをしてほしい、と言われた。"
msgstr ""

#. Occurrence 8DOT5:14999:12768: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0040; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14999
msgctxt "text_id=12768 | speaker=soujuurou"
msgid "貴方は信じられるから、これで孫のようにふるまってくれって」"
msgstr ""

#. Occurrence 8DOT5:15026:12769: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0115; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15026
msgctxt "text_id=12769 | speaker=tobimaru"
msgid "「……なんだそりゃ。少しも信じてねえよそれ。金で動く孫がいるか。そりゃあヘルパーと変わらねえ」"
msgstr ""

#. Occurrence 8DOT5:15037:12770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0041; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15037
msgctxt "text_id=12770 | speaker=soujuurou"
msgid "「いや。おばあさんはヘルパーさんにはお金は払わないと言った。信頼できないから。あのおばあさんが信じられるのはお金だけなんだ」"
msgstr ""

#. Occurrence 8DOT5:15079:12771: scene=8DOT5
#: 8DOT5:15079
msgctxt "text_id=12771 | speaker=unknown"
msgid "　長くひとりきりで暮らしてきたからか、それとも生来の偏屈さからひとりになったのか。"
msgstr ""

#. Occurrence 8DOT5:15084:12772: scene=8DOT5
#: 8DOT5:15084
msgctxt "text_id=12772 | speaker=unknown"
msgid "　老婆は「人間の善意」をまるっきり信じられないようになっていた。"
msgstr ""

#. Occurrence 8DOT5:15089:12773: scene=8DOT5
#: 8DOT5:15089
msgctxt "text_id=12773 | speaker=unknown"
msgid "　彼女にとって、家族の絆は絵空事にすぎない。"
msgstr ""

#. Occurrence 8DOT5:15094:12774: scene=8DOT5
#: 8DOT5:15094
msgctxt "text_id=12774 | speaker=unknown"
msgid "　長年そういったものに見捨てられてきた彼女にとって、確かなものは手元に残った貯金だけ。"
msgstr ""

#. Occurrence 8DOT5:15114:12775: scene=8DOT5
#: 8DOT5:15114
msgctxt "text_id=12775 | speaker=unknown"
msgid "　……だから、逆に。"
msgstr ""

#. Occurrence 8DOT5:15119:12776: scene=8DOT5
#: 8DOT5:15119
msgctxt "text_id=12776 | speaker=unknown"
msgid "　偏屈に、<無駄遣|むだづか>いせず、最後の心の拠り所として貯めに貯めた<金|ソレ>だけが、彼女にとって、人をつなぎ止める絆になっていたのだろう。"
msgstr ""

#. Occurrence 8DOT5:15154:12777: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0116; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15154
msgctxt "text_id=12777 | speaker=tobimaru"
msgid "「……バカらしい。"
msgstr ""

#. Occurrence 8DOT5:15160:12778: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0117; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15160
msgctxt "text_id=12778 | speaker=tobimaru"
msgid "　それって結局、金で雇った他人じゃねえか。孫の代わりとは言えねえな」"
msgstr ""

#. Occurrence 8DOT5:15181:12779: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0042; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15181
msgctxt "text_id=12779 | speaker=soujuurou"
msgid "「それはおばあさんが誰よりも分かってるよ。"
msgstr ""

#. Occurrence 8DOT5:15187:12780: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0043; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15187
msgctxt "text_id=12780 | speaker=soujuurou"
msgid "　でも、偽者だと分かっていても、それぐらいしか信じられるモノはなかったんだ。"
msgstr ""

#. Occurrence 8DOT5:15193:12781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0044; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15193
msgctxt "text_id=12781 | speaker=soujuurou"
msgid "　おばあさんにとって、家によりつかなくなったお孫さんはいま一番欲しいものだから、その代償として、彼女が一番信用できるものを真心として渡してくれたんだ」"
msgstr ""

#. Occurrence 8DOT5:15214:12782: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0118; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15214
msgctxt "text_id=12782 | speaker=tobimaru"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:15220:12783: scene=8DOT5
#: 8DOT5:15220
msgctxt "text_id=12783 | speaker=unknown"
msgid "　買収ではない。"
msgstr ""

#. Occurrence 8DOT5:15225:12784: scene=8DOT5
#: 8DOT5:15225
msgctxt "text_id=12784 | speaker=unknown"
msgid "　老婆は心の底から草十郎を信頼したから、一番確かなもので感謝の気持ちを表した。"
msgstr ""

#. Occurrence 8DOT5:15231:12785: scene=8DOT5
#: 8DOT5:15231
msgctxt "text_id=12785 | speaker=unknown"
msgid "　……それが、<傍目|はため>には<醜|みにく>い行為だと気づく事もできずに。"
msgstr ""

#. Occurrence 8DOT5:15275:12786: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0119; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15275
msgctxt "text_id=12786 | speaker=tobimaru"
msgid "「……また厄介な事情に首つっこんだもんだ。"
msgstr ""

#. Occurrence 8DOT5:15281:12787: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0120; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15281
msgctxt "text_id=12787 | speaker=tobimaru"
msgid "　まあ、あんまり深く思い詰めるな。"
msgstr ""

#. Occurrence 8DOT5:15287:12788: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0121; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15287
msgctxt "text_id=12788 | speaker=tobimaru"
msgid "　いい話じゃねえか。命より金が大事だった婆さんが、今になって思い出の方に転んだワケだ。まっとうな話だよ」"
msgstr ""

#. Occurrence 8DOT5:15293:12789: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0045; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15293
msgctxt "text_id=12789 | speaker=soujuurou"
msgid "「そうかな。そうだといいけど」"
msgstr ""

#. Occurrence 8DOT5:15298:12790: scene=8DOT5
#: 8DOT5:15298
msgctxt "text_id=12790 | speaker=unknown"
msgid "　うなずく草十郎の顔には、まだ重苦しい翳りが残っている。"
msgstr ""

#. Occurrence 8DOT5:15340:12791: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0122; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15340
msgctxt "text_id=12791 | speaker=tobimaru"
msgid "「なんだよ煮えきらねえな。どうせおまえさんの事だ、もらった金は一銭も使ってねえんだろ？"
msgstr ""

#. Occurrence 8DOT5:15346:12792: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0123; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15346
msgctxt "text_id=12792 | speaker=tobimaru"
msgid "　んな事してりゃいずれ年金も底をつく。そうなった時にまるまる返すつもりだから蒼崎にも黙ってたんじゃないのか？」"
msgstr ""

#. Occurrence 8DOT5:15363:12793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0046; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15363
msgctxt "text_id=12793 | speaker=soujuurou"
msgid "「？　なんで鳶丸がそんなコト知ってるんだ？」"
msgstr ""

#. Occurrence 8DOT5:15375:12794: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0124; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15375
msgctxt "text_id=12794 | speaker=tobimaru"
msgid "「あー、いや、なんとなく。そんな気がした」"
msgstr ""

#. Occurrence 8DOT5:15409:12795: scene=8DOT5
#: 8DOT5:15409
msgctxt "text_id=12795 | speaker=unknown"
msgid "　今日一日、草十郎の為に<奔走|ほんそう>した事は黙っておくが吉だ。"
msgstr ""

#. Occurrence 8DOT5:15414:12796: scene=8DOT5
#: 8DOT5:15414
msgctxt "text_id=12796 | speaker=unknown"
msgid "　後々、なんで喋ったのか、と鉄の生徒会長に<祟|たた>られるのが目に見えている。"
msgstr ""

#. Occurrence 8DOT5:15435:12797: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0047; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15435
msgctxt "text_id=12797 | speaker=soujuurou"
msgid "「そっか。でもこの話の一番難しいところはね、鳶丸。"
msgstr ""

#. Occurrence 8DOT5:15441:12798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0048; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15441
msgctxt "text_id=12798 | speaker=soujuurou"
msgid "　その人には、お孫さんはいなかったんだ」"
msgstr ""

#. Occurrence 8DOT5:15457:12799: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0125; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15457
msgctxt "text_id=12799 | speaker=tobimaru"
msgid "「あ―――？」"
msgstr ""

#. Occurrence 8DOT5:15468:12800: scene=8DOT5
#: 8DOT5:15468
msgctxt "text_id=12800 | speaker=unknown"
msgid "　ぼんやりと口をあけて、ああ、と鳶丸は息を吐いた。"
msgstr ""

#. Occurrence 8DOT5:15473:12801: scene=8DOT5
#: 8DOT5:15473
msgctxt "text_id=12801 | speaker=unknown"
msgid "　そういう事か、と。"
msgstr ""

#. Occurrence 8DOT5:15504:12802: scene=8DOT5
#: 8DOT5:15504
msgctxt "text_id=12802 | speaker=unknown"
msgid "　夫に先立たれ、息子は町を出て、孫は寄りつきもしない。"
msgstr ""

#. Occurrence 8DOT5:15509:12803: scene=8DOT5
#: 8DOT5:15509
msgctxt "text_id=12803 | speaker=unknown"
msgid "　なんて恵まれた、スタンダードな一生だろう。"
msgstr ""

#. Occurrence 8DOT5:15514:12804: scene=8DOT5
#: 8DOT5:15514
msgctxt "text_id=12804 | speaker=unknown"
msgid "　世の中には、そんな“もしも”を信じる事でしか、立ちゆかない人生もある。"
msgstr ""

#. Occurrence 8DOT5:15519:12805: scene=8DOT5
#: 8DOT5:15519
msgctxt "text_id=12805 | speaker=unknown"
msgid "　底はない。悲惨な人生の下には、より悲惨な底が待っているだけの話。"
msgstr ""

#. Occurrence 8DOT5:15540:12806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0049; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15540
msgctxt "text_id=12806 | speaker=soujuurou"
msgid "「時々、油断すると思うんだ。この町について。"
msgstr ""

#. Occurrence 8DOT5:15546:12807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0050; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15546
msgctxt "text_id=12807 | speaker=soujuurou"
msgid "　みんな幸福そうに見えるのに、裏を覗くとそうでもないのはなんでだろうって。なんか、町全体に騙されてるみたいだ」"
msgstr ""

#. Occurrence 8DOT5:15552:12808: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0126; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15552
msgctxt "text_id=12808 | speaker=tobimaru"
msgid "「…………」"
msgstr ""

#. Occurrence 8DOT5:15557:12809: scene=8DOT5
#: 8DOT5:15557
msgctxt "text_id=12809 | speaker=unknown"
msgid "　鳶丸は<欄干|らんかん>によりかかって、賑わう町並みを見下ろしている。"
msgstr ""

#. Occurrence 8DOT5:15591:12810: scene=8DOT5
#: 8DOT5:15591
msgctxt "text_id=12810 | speaker=unknown"
msgid "　草十郎の悩みは、つまるところ環境への戸惑いだ。"
msgstr ""

#. Occurrence 8DOT5:15596:12811: scene=8DOT5
#: 8DOT5:15596
msgctxt "text_id=12811 | speaker=unknown"
msgid "　年老いるまで独りだった老婆の人生も、"
msgstr ""

#. Occurrence 8DOT5:15601:12812: scene=8DOT5
#: 8DOT5:15601
msgctxt "text_id=12812 | speaker=unknown"
msgid "　親戚一同に敵視されている鳶丸の生い立ちも、"
msgstr ""

#. Occurrence 8DOT5:15606:12813: scene=8DOT5
#: 8DOT5:15606
msgctxt "text_id=12813 | speaker=unknown"
msgid "　所詮は個人の事情でしかない。"
msgstr ""

#. Occurrence 8DOT5:15611:12814: scene=8DOT5
#: 8DOT5:15611
msgctxt "text_id=12814 | speaker=unknown"
msgid "　少年の相手は、この得体の知れない町そのものらしい。"
msgstr ""

#. Occurrence 8DOT5:15631:12815: scene=8DOT5
#: 8DOT5:15631
msgctxt "text_id=12815 | speaker=unknown"
msgid "　近代化して豊かになった分、豊かになれなかった人間の悲惨さは増している。"
msgstr ""

#. Occurrence 8DOT5:15636:12816: scene=8DOT5
#: 8DOT5:15636
msgctxt "text_id=12816 | speaker=unknown"
msgid "　それは富の差であれ、心の差であれ同じ事だ。"
msgstr ""

#. Occurrence 8DOT5:15641:12817: scene=8DOT5
#: 8DOT5:15641
msgctxt "text_id=12817 | speaker=unknown"
msgid "　大きくなった町は弱者に<厳|きび>しい。"
msgstr ""

#. Occurrence 8DOT5:15646:12818: scene=8DOT5
#: 8DOT5:15646
msgctxt "text_id=12818 | speaker=unknown"
msgid "　すべてが相互扶助でなりたっていた田舎育ちの少年にとっては、その在り方は耐え難い“なぜ”なのだろう。"
msgstr ""

#. Occurrence 8DOT5:15681:12819: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0127; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15681
msgctxt "text_id=12819 | speaker=tobimaru"
msgid "「草十郎。おまえ、この町は好きか？」"
msgstr ""

#. Occurrence 8DOT5:15687:12820: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0051; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15687
msgctxt "text_id=12820 | speaker=soujuurou"
msgid "「……まだ分からない。そういう鳶丸は？」"
msgstr ""

#. Occurrence 8DOT5:15708:12821: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0128; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15708
msgctxt "text_id=12821 | speaker=tobimaru"
msgid "「ま、似たようなもんだ。好き嫌いも半々で、たまに何もかもどうでもよくなる時はある。"
msgstr ""

#. Occurrence 8DOT5:15714:12822: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0129; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15714
msgctxt "text_id=12822 | speaker=tobimaru"
msgid "　だがまあ、おまえさんとは真逆だな。"
msgstr ""

#. Occurrence 8DOT5:15720:12823: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0130; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15720
msgctxt "text_id=12823 | speaker=tobimaru"
msgid "　俺はこの町のおかげで<手前|テメエ>の悩みなんざ無視できる。ここに比べりゃマシだってな。空虚であろうと、この忙しさ、節操のなさは捨てたもんじゃねえってな」"
msgstr ""

#. Occurrence 8DOT5:15741:12824: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0052; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15741
msgctxt "text_id=12824 | speaker=soujuurou"
msgid "「ここに比べたらマシ？」"
msgstr ""

#. Occurrence 8DOT5:15747:12825: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0131; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15747
msgctxt "text_id=12825 | speaker=tobimaru"
msgid "「……あー、違うな。マシというよりはアリって感じか。"
msgstr ""

#. Occurrence 8DOT5:15753:12826: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0132; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15753
msgctxt "text_id=12826 | speaker=tobimaru"
msgid "　バイトしてればたまに思うだろ？　町ってのは隙間を作らないように回ってるんだ。欠席にしろ空席にしろ、空きが出来たらすぐに埋められるように出来ている」"
msgstr ""

#. Occurrence 8DOT5:15785:12827: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0133; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15785
msgctxt "text_id=12827 | speaker=tobimaru"
msgid "「当たり前のようで、コイツはよく出来た共同体なんだよ。"
msgstr ""

#. Occurrence 8DOT5:15791:12828: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0134; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15791
msgctxt "text_id=12828 | speaker=tobimaru"
msgid "　昨日までは誰でもなかった他人が、明日には必要な隣人になってるかもしれない。"
msgstr ""

#. Occurrence 8DOT5:15797:12829: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0135; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15797
msgctxt "text_id=12829 | speaker=tobimaru"
msgid "　昨日まではなかった町角に、新しい建物ができている事もある」"
msgstr ""

#. Occurrence 8DOT5:15818:12830: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0136; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15818
msgctxt "text_id=12830 | speaker=tobimaru"
msgid "「まるで毎日が切った<縫|ぬ>ったの大手術だ。それでもうまく回ってる事に、真剣に感心する。"
msgstr ""

#. Occurrence 8DOT5:15824:12831: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0137; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15824
msgctxt "text_id=12831 | speaker=tobimaru"
msgid "　本当に、何かのはずみで思うんだよ。"
msgstr ""

#. Occurrence 8DOT5:15831:12832: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0138; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15831
msgctxt "text_id=12832 | speaker=tobimaru"
msgid "俺はテメエだけで生きてるんじゃなくて、どうでもいい誰かのどうでもいい頑張りのおかげで、こうしてクダまけてるんだってな。"
msgstr ""

#. Occurrence 8DOT5:15837:12833: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0139; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15837
msgctxt "text_id=12833 | speaker=tobimaru"
msgid "　持ちつ持たれつだ。そういう巡り合わせを成立させているだけでも、どんなバランスなんだって呆れるわけだ」"
msgstr ""

#. Occurrence 8DOT5:15870:12834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0053; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15870
msgctxt "text_id=12834 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:15876:12835: scene=8DOT5
#: 8DOT5:15876
msgctxt "text_id=12835 | speaker=unknown"
msgid "　山が生き物であるように、町もまた生き物だ。"
msgstr ""

#. Occurrence 8DOT5:15881:12836: scene=8DOT5
#: 8DOT5:15881
msgctxt "text_id=12836 | speaker=unknown"
msgid "　鳶丸はその生き物のカタチをいまいち気に入っていないらしい。"
msgstr ""

#. Occurrence 8DOT5:15886:12837: scene=8DOT5
#: 8DOT5:15886
msgctxt "text_id=12837 | speaker=unknown"
msgid "　ただそれでも、"
msgstr ""

#. Occurrence 8DOT5:15912:12838: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0054; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15912
msgctxt "text_id=12838 | speaker=soujuurou"
msgid "「そうか。敬意を払ってるんだな、鳶丸は」"
msgstr ""

#. Occurrence 8DOT5:15930:12839: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0140; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15930
msgctxt "text_id=12839 | speaker=tobimaru"
msgid "「……まあ。照れくさいが、そういうこった」"
msgstr ""

#. Occurrence 8DOT5:15936:12840: scene=8DOT5
#: 8DOT5:15936
msgctxt "text_id=12840 | speaker=unknown"
msgid "　町に生まれた人間として、顔も知らない人間が、顔も知らないクセに助け合っている事実に、感謝している。"
msgstr ""

#. Occurrence 8DOT5:15962:12841: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0141; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15962
msgctxt "text_id=12841 | speaker=tobimaru"
msgid "「つーか、おまえさんは贅沢すぎる！"
msgstr ""

#. Occurrence 8DOT5:15968:12842: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0142; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15968
msgctxt "text_id=12842 | speaker=tobimaru"
msgid "　はじめから好きなところに住めるヤツなんていねえだろ。生まれる場所は選べねえしな。単純な話、自分が住むって決めたところを好きになるしかねえってことだ！」"
msgstr ""

#. Occurrence 8DOT5:16004:12843: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0055; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16004
msgctxt "text_id=12843 | speaker=soujuurou"
msgid "「っ！」"
msgstr ""

#. Occurrence 8DOT5:16010:12844: scene=8DOT5
#: 8DOT5:16010
msgctxt "text_id=12844 | speaker=unknown"
msgid "　鳶丸の手が草十郎の背中を叩く。"
msgstr ""

#. Occurrence 8DOT5:16015:12845: scene=8DOT5
#: 8DOT5:16015
msgctxt "text_id=12845 | speaker=unknown"
msgid "　丸まりかけた背を叩かれて、草十郎は目を点にして跳ね起きた。"
msgstr ""

#. Occurrence 8DOT5:16062:12846: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0056; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16062
msgctxt "text_id=12846 | speaker=soujuurou"
msgid "「……でも鳶丸。そこに住むって決めても、好きになれなかったらどうするんだ？」"
msgstr ""

#. Occurrence 8DOT5:16068:12847: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0143; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16068
msgctxt "text_id=12847 | speaker=tobimaru"
msgid "「どうしても好きになれないヤツは違う土地に行けばいい。イヤなら逃げてもいいんだよ。放浪するのも人生だぜ」"
msgstr ""

#. Occurrence 8DOT5:16089:12848: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0057; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16089
msgctxt "text_id=12848 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:16094:12849: scene=8DOT5
#: 8DOT5:16094
msgctxt "text_id=12849 | speaker=unknown"
msgid "　鳶丸の発言は目から鱗だったのか、草十郎は感心して息を呑んでいる。"
msgstr ""

#. Occurrence 8DOT5:16099:12850: scene=8DOT5
#: 8DOT5:16099
msgctxt "text_id=12850 | speaker=unknown"
msgid "　イヤなら逃げていい、という言葉にではなく、"
msgstr ""

#. Occurrence 8DOT5:16104:12851: scene=8DOT5
#: 8DOT5:16104
msgctxt "text_id=12851 | speaker=unknown"
msgid "　そう言い切れる槻司鳶丸に、強い<感銘|かんめい>を受けたのだ。"
msgstr ""

#. Occurrence 8DOT5:16109:12852: scene=8DOT5
#: 8DOT5:16109
msgctxt "text_id=12852 | speaker=unknown"
msgid "　この町に生まれながら、この町をあっさり捨てられると言った彼の自由さに。"
msgstr ""

#. Occurrence 8DOT5:16153:12853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0058; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16153
msgctxt "text_id=12853 | speaker=soujuurou"
msgid "「鳶丸から、逃げるなんて言葉がでるとは思わなかった」"
msgstr ""

#. Occurrence 8DOT5:16179:12854: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0144; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16179
msgctxt "text_id=12854 | speaker=tobimaru"
msgid "「逃げる先があるなら逃げてもいいだろって話。"
msgstr ""

#. Occurrence 8DOT5:16185:12855: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0145; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16185
msgctxt "text_id=12855 | speaker=tobimaru"
msgid "　……そりゃ勝ちとか成功とか、そういう言葉に固執するのも悪くはねえさ。富と名声はいいもんだしな。"
msgstr ""

#. Occurrence 8DOT5:16191:12856: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0146; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16191
msgctxt "text_id=12856 | speaker=tobimaru"
msgid "　だが、俺にはどうも、勝ち続けるっていうのは固まるってコトに見える。息苦しくてしょうがない。蒼崎みたいにがんじがらめになっても突き進むパワーもねえしな。身上は軽い方がいいだろうよ」"
msgstr ""

#. Occurrence 8DOT5:16218:12857: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0059; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16218
msgctxt "text_id=12857 | speaker=soujuurou"
msgid "「？　人生は軽い方がいいのか？」"
msgstr ""

#. Occurrence 8DOT5:16229:12858: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0147; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16229
msgctxt "text_id=12858 | speaker=tobimaru"
msgid "「いや、軽いとか手堅いとか、そういうんじゃなくて、オレはもっと、こう、<浪漫|ろまん>あふれるっつーか……」"
msgstr ""

#. Occurrence 8DOT5:16264:12859: scene=8DOT5
#: 8DOT5:16264
msgctxt "text_id=12859 | speaker=unknown"
msgid "　言いかけて、それも違うな、と鳶丸は眉をひそめる。"
msgstr ""

#. Occurrence 8DOT5:16269:12860: scene=8DOT5
#: 8DOT5:16269
msgctxt "text_id=12860 | speaker=unknown"
msgid "　欲しいものは単純なものだ。"
msgstr ""

#. Occurrence 8DOT5:16276:12861: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0148; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16276
msgctxt "text_id=12861 | speaker=tobimaru"
msgid "「そうだな。俺はきっと、笑える人生が送りたいんだ」"
msgstr ""

#. Occurrence 8DOT5:16282:12862: scene=8DOT5
#: 8DOT5:16282
msgctxt "text_id=12862 | speaker=unknown"
msgid "　こういうものだろ、と。"
msgstr ""

#. Occurrence 8DOT5:16287:12863: scene=8DOT5
#: 8DOT5:16287
msgctxt "text_id=12863 | speaker=unknown"
msgid "　鳶丸は自分が良しとするものが、いま目の前で悩む友人の指針になればいいと願って口にした。"
msgstr ""

#. Occurrence 8DOT5:16331:12864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0060; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16331
msgctxt "text_id=12864 | speaker=soujuurou"
msgid "「………………漫才師か？」"
msgstr ""

#. Occurrence 8DOT5:16337:12865: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0149; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16337
msgctxt "text_id=12865 | speaker=tobimaru"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:16342:12866: scene=8DOT5
#: 8DOT5:16342
msgctxt "text_id=12866 | speaker=unknown"
msgid "　ガックリと肩を落とす。"
msgstr ""

#. Occurrence 8DOT5:16347:12867: scene=8DOT5
#: 8DOT5:16347
msgctxt "text_id=12867 | speaker=unknown"
msgid "　落としたものの、"
msgstr ""

#. Occurrence 8DOT5:16353:12868: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0150; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16353
msgctxt "text_id=12868 | speaker=tobimaru"
msgid "「いや、そんなもんか、実際」"
msgstr ""

#. Occurrence 8DOT5:16358:12869: scene=8DOT5
#: 8DOT5:16358
msgctxt "text_id=12869 | speaker=unknown"
msgid "　よくよく考えると的はずれでもない、と納得する鳶丸だった。"
msgstr ""

#. Occurrence 8DOT5:16378:12870: scene=8DOT5
#: 8DOT5:16378
msgctxt "text_id=12870 | speaker=unknown"
msgid "　人間、望めば望むほど果てがない。"
msgstr ""

#. Occurrence 8DOT5:16383:12871: scene=8DOT5
#: 8DOT5:16383
msgctxt "text_id=12871 | speaker=unknown"
msgid "　最高の人生なんてものは誰であろうと迎えられない。"
msgstr ""

#. Occurrence 8DOT5:16388:12872: scene=8DOT5
#: 8DOT5:16388
msgctxt "text_id=12872 | speaker=unknown"
msgid "　なら、いまわの際で「俺の人生は愉快だった」とニヤつけるなら、最後の最後で勝ち組だろうと。"
msgstr ""

#. Occurrence 8DOT5:16427:12873: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0151; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16427
msgctxt "text_id=12873 | speaker=tobimaru"
msgid "「……ったく、蒼崎の影響かねえ。考えなしの<博徒|ばくと>かっていうの。あいつ、ボニー＆クライドとか大好きなんだろうなあ」"
msgstr ""

#. Occurrence 8DOT5:16433:12874: scene=8DOT5
#: 8DOT5:16433
msgctxt "text_id=12874 | speaker=unknown"
msgid "　やれやれと鳶丸は頭を掻いた。"
msgstr ""

#. Occurrence 8DOT5:16438:12875: scene=8DOT5
#: 8DOT5:16438
msgctxt "text_id=12875 | speaker=unknown"
msgid "　一年前までは厭世的だった自分が、よくもまあここまで偉そうに語れるものだと。"
msgstr ""

#. Occurrence 8DOT5:16473:12876: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0152; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16473
msgctxt "text_id=12876 | speaker=tobimaru"
msgid "「ともかくだ。他人の事情にいちいち落ちこんでるようじゃ日が暮れるぜ。"
msgstr ""

#. Occurrence 8DOT5:16479:12877: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0153; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16479
msgctxt "text_id=12877 | speaker=tobimaru"
msgid "　いや、実際もう暮れかけてるけどな。とんだ道草だ」"
msgstr ""

#. Occurrence 8DOT5:16485:12878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0061; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16485
msgctxt "text_id=12878 | speaker=soujuurou"
msgid "「そうか。引き留めてすまなかった。鳶丸は他に用事が？」"
msgstr ""

#. Occurrence 8DOT5:16506:12879: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0154; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16506
msgctxt "text_id=12879 | speaker=tobimaru"
msgid "「……俺も大人しく家に帰るとするか。"
msgstr ""

#. Occurrence 8DOT5:16512:12880: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0155; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16512
msgctxt "text_id=12880 | speaker=tobimaru"
msgid "　そっちも日が落ちる前に帰れよ。何をしていたか聞かれたら、隠さず事情は説明しとけ。その話、おまえが思ってるほどひでえ話じゃねえから」"
msgstr ""

#. Occurrence 8DOT5:16543:12881: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0062; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16543
msgctxt "text_id=12881 | speaker=soujuurou"
msgid "「む」"
msgstr ""

#. Occurrence 8DOT5:16549:12882: scene=8DOT5
#: 8DOT5:16549
msgctxt "text_id=12882 | speaker=unknown"
msgid "　鳶丸の言葉に、眉を八の字にして黙りこむ草十郎。"
msgstr ""

#. Occurrence 8DOT5:16554:12883: scene=8DOT5
#: 8DOT5:16554
msgctxt "text_id=12883 | speaker=unknown"
msgid "　彼の中では、あの老婆にしてしまった行為の折り合いが付いていない。"
msgstr ""

#. Occurrence 8DOT5:16574:12884: scene=8DOT5
#: 8DOT5:16574
msgctxt "text_id=12884 | speaker=unknown"
msgid "　そもそも草十郎があの家を訪れなければ、彼女が自分の人生に絶望する事はなかったはずだ。"
msgstr ""

#. Occurrence 8DOT5:16579:12885: scene=8DOT5
#: 8DOT5:16579
msgctxt "text_id=12885 | speaker=unknown"
msgid "　そう悔いているからこそ、草十郎は誰かに話したかったのだ。"
msgstr ""

#. Occurrence 8DOT5:16614:12886: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0156; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16614
msgctxt "text_id=12886 | speaker=tobimaru"
msgid "「おまえ、残酷なことをしたと思ってんだろ。"
msgstr ""

#. Occurrence 8DOT5:16620:12887: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0157; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16620
msgctxt "text_id=12887 | speaker=tobimaru"
msgid "　婆さんの人生に、今からじゃ取り戻せないモノを見せつけた、とかな」"
msgstr ""

#. Occurrence 8DOT5:16639:12888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0063; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16639
msgctxt "text_id=12888 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:16644:12889: scene=8DOT5
#: 8DOT5:16644
msgctxt "text_id=12889 | speaker=unknown"
msgid "　核心をつかれて黙りこむ。"
msgstr ""

#. Occurrence 8DOT5:16649:12890: scene=8DOT5
#: 8DOT5:16649
msgctxt "text_id=12890 | speaker=unknown"
msgid "　その後悔を、鳶丸ははっきりと切り捨てた。"
msgstr ""

#. Occurrence 8DOT5:16655:12891: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0158; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16655
msgctxt "text_id=12891 | speaker=tobimaru"
msgid "「そりゃ違う。思い上がりだぜ草十郎」"
msgstr ""

#. Occurrence 8DOT5:16689:12892: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0159; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16689
msgctxt "text_id=12892 | speaker=tobimaru"
msgid "「いいか。その婆さんも、自分は人生に失敗した、なんて思ってんなら、今の自分に出来ることをさせればいい。"
msgstr ""

#. Occurrence 8DOT5:16695:12893: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0160; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16695
msgctxt "text_id=12893 | speaker=tobimaru"
msgid "　幸い、金は腐るほどあるんだろ？"
msgstr ""

#. Occurrence 8DOT5:16701:12894: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0161; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16701
msgctxt "text_id=12894 | speaker=tobimaru"
msgid "　なら、思いっきり人助けをさせてみろ。金で救える不幸なんざ山ほどあるだろ。"
msgstr ""

#. Occurrence 8DOT5:16707:12895: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0162; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16707
msgctxt "text_id=12895 | speaker=tobimaru"
msgid "　んで、婆さんがどんなもんだと胸を張れたんなら、そりゃ間違いなくいい仕事だ。少なくとも俺は気持ちがいい」"
msgstr ""

#. Occurrence 8DOT5:16733:12896: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0064; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16733
msgctxt "text_id=12896 | speaker=soujuurou"
msgid "「……む。それは、おばあさんの苦しみを解決していない」"
msgstr ""

#. Occurrence 8DOT5:16753:12897: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0163; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16753
msgctxt "text_id=12897 | speaker=tobimaru"
msgid "「解決できねえ問題は放っておけ。"
msgstr ""

#. Occurrence 8DOT5:16759:12898: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0164; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16759
msgctxt "text_id=12898 | speaker=tobimaru"
msgid "　その婆さんには今、他に解決できる問題があるんだからそれでいいじゃねえか。んで、"
msgstr ""

#. Occurrence 8DOT5:16765:12899: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0165; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16765
msgctxt "text_id=12899 | speaker=tobimaru"
msgid "『悪いけどお金はこれから世のため人のため自分のために使うから返しておくれ』となったらば婆さんの勝ち。"
msgstr ""

#. Occurrence 8DOT5:16771:12900: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0166; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16771
msgctxt "text_id=12900 | speaker=tobimaru"
msgid "　偽者の孫なんざより、よっぽどいい生き甲斐に目覚めたわけだな」"
msgstr ""

#. Occurrence 8DOT5:16792:12901: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0167; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16792
msgctxt "text_id=12901 | speaker=tobimaru"
msgid "「しかし、"
msgstr ""

#. Occurrence 8DOT5:16792:12902: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0167; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16792
msgctxt "text_id=12902 | speaker=tobimaru"
msgid "『これで満足したから残りはやっぱり貰っておくれ』"
msgstr ""

#. Occurrence 8DOT5:16798:12903: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0168; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16798
msgctxt "text_id=12903 | speaker=tobimaru"
msgid "　と言えばおまえさんの勝ち。"
msgstr ""

#. Occurrence 8DOT5:16804:12904: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0169; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16804
msgctxt "text_id=12904 | speaker=tobimaru"
msgid "　婆さんにとってはやっぱり孫の方がいいって事で、そん時は大手を振って大金もって帰りやがれ」"
msgstr ""

#. Occurrence 8DOT5:16835:12905: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0065; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16835
msgctxt "text_id=12905 | speaker=soujuurou"
msgid "「―――なるほど」"
msgstr ""

#. Occurrence 8DOT5:16840:12906: scene=8DOT5
#: 8DOT5:16840
msgctxt "text_id=12906 | speaker=unknown"
msgid "　鮮やかな大岡裁きに、ポン、と手を打つ草十郎。"
msgstr ""

#. Occurrence 8DOT5:16853:12907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0066; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16853
msgctxt "text_id=12907 | speaker=soujuurou"
msgid "「すまない。ありがとう鳶丸」"
msgstr ""

#. Occurrence 8DOT5:16858:12908: scene=8DOT5
#: 8DOT5:16858
msgctxt "text_id=12908 | speaker=unknown"
msgid "　苦笑いは既にない。"
msgstr ""

#. Occurrence 8DOT5:16863:12909: scene=8DOT5
#: 8DOT5:16863
msgctxt "text_id=12909 | speaker=unknown"
msgid "　今の一言で、彼は老婆の選択が前者になるよう、努力しようと決めたのだ。"
msgstr ""

#. Occurrence 8DOT5:16896:12910: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0170; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16896
msgctxt "text_id=12910 | speaker=tobimaru"
msgid "「――――――」"
msgstr ""

#. Occurrence 8DOT5:16901:12911: scene=8DOT5
#: 8DOT5:16901
msgctxt "text_id=12911 | speaker=unknown"
msgid "　鳶丸に言わせれば、その迷いのなさこそ、よっぽど自由に眩しく見える。"
msgstr ""

#. Occurrence 8DOT5:16912:12912: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0171; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16912
msgctxt "text_id=12912 | speaker=tobimaru"
msgid "「気にするな、礼を言うならお互いさまだ。"
msgstr ""

#. Occurrence 8DOT5:16918:12913: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0172; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16918
msgctxt "text_id=12913 | speaker=tobimaru"
msgid "　じゃあな草十郎。休み明けに、また学校で」"
msgstr ""

#. Occurrence 8DOT5:16951:12914: scene=8DOT5
#: 8DOT5:16951
msgctxt "text_id=12914 | speaker=unknown"
msgid "　愛想のない捨て台詞だったが、そんな鳶丸の態度も気にせず、草十郎は満面の笑みで手を挙げて走っていった。"
msgstr ""

#. Occurrence 8DOT5:16956:12915: scene=8DOT5
#: 8DOT5:16956
msgctxt "text_id=12915 | speaker=unknown"
msgid "　それに心底から困った笑みを浮かべて、鳶丸も歩道橋を後にする。"
msgstr ""

#. Occurrence 8DOT5:16963:12916: scene=8DOT5
#: 8DOT5:16963
msgctxt "text_id=12916 | speaker=unknown"
msgid "　時刻は午後四時半。"
msgstr ""

#. Occurrence 8DOT5:16968:12917: scene=8DOT5
#: 8DOT5:16968
msgctxt "text_id=12917 | speaker=unknown"
msgid "　真冬の町並みはほどなくして、夜の<帳|とばり>を降ろしていった。"
msgstr ""

#. Occurrence 8DOT5:17055:12918: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0067; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17055
msgctxt "text_id=12918 | speaker=soujuurou"
msgid "「ただいま。今夜はまた、一段と冷えるね」"
msgstr ""

#. Occurrence 8DOT5:17071:12919: scene=8DOT5
#: 8DOT5:17071
msgctxt "text_id=12919 | speaker=unknown"
msgid "　草十郎が戻ると、居間には青子と有珠の姿があった。"
msgstr ""

#. Occurrence 8DOT5:17076:12920: scene=8DOT5
#: 8DOT5:17076
msgctxt "text_id=12920 | speaker=unknown"
msgid "　ふたりともまだ夕食前らしい。"
msgstr ""

#. Occurrence 8DOT5:17081:12921: scene=8DOT5
#: 8DOT5:17081
msgctxt "text_id=12921 | speaker=unknown"
msgid "　青子はむすっとした顔で、"
msgstr ""

#. Occurrence 8DOT5:17098:12922: scene=8DOT5
#: 8DOT5:17098
msgctxt "text_id=12922 | speaker=unknown"
msgid "　有珠はどことなく落ち着かない様子でソファーに座っている。"
msgstr ""

#. Occurrence 8DOT5:17129:12923: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0068; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17129
msgctxt "text_id=12923 | speaker=soujuurou"
msgid "「あれ。もしかして、こっちの帰りを待っていたのか？」"
msgstr ""

#. Occurrence 8DOT5:17147:12924: scene=8DOT5
#: 8DOT5:17147
msgctxt "text_id=12924 | speaker=unknown"
msgid "　かすかに肯定する有珠と、"
msgstr ""

#. Occurrence 8DOT5:17162:12925: scene=8DOT5
#: 8DOT5:17162
msgctxt "text_id=12925 | speaker=unknown"
msgid "　あからさまに否定する青子。"
msgstr ""

#. Occurrence 8DOT5:17195:12926: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0069; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17195
msgctxt "text_id=12926 | speaker=soujuurou"
msgid "「蒼崎。俺の気のせいならいいんだけど、なんだか昨夜以上にどうかしてないか？」"
msgstr ""

#. Occurrence 8DOT5:17201:12927: scene=8DOT5
#: 8DOT5:17201
msgctxt "text_id=12927 | speaker=unknown"
msgid "　多少は空気が読めるようになった草十郎だが、言葉遣いはまだまだお粗末である。"
msgstr ""

#. Occurrence 8DOT5:17233:12928: scene=8DOT5
#: 8DOT5:17233
msgctxt "text_id=12928 | speaker=unknown"
msgid "　どうかしてるかっ！"
msgstr ""

#. Occurrence 8DOT5:17239:12929: scene=8DOT5
#: 8DOT5:17239
msgctxt "text_id=12929 | speaker=unknown"
msgid "　……と切り返したい青子ではあるが、ぐっと堪える。"
msgstr ""

#. Occurrence 8DOT5:17244:12930: scene=8DOT5
#: 8DOT5:17244
msgctxt "text_id=12930 | speaker=unknown"
msgid "　彼女は別に、草十郎が気にしているほど怒ってはいないからだ。"
msgstr ""

#. Occurrence 8DOT5:17249:12931: scene=8DOT5
#: 8DOT5:17249
msgctxt "text_id=12931 | speaker=unknown"
msgid "　が。"
msgstr ""

#. Occurrence 8DOT5:17282:12932: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0019; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17282
msgctxt "text_id=12932 | speaker=alice"
msgid "「どうかしてるの、青子？」"
msgstr ""

#. Occurrence 8DOT5:17302:12933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0168; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17302
msgctxt "text_id=12933 | speaker=aoko"
msgid "「してないわよ！　してるのは草十郎の方だっていうの！」"
msgstr ""

#. Occurrence 8DOT5:17308:12934: scene=8DOT5
#: 8DOT5:17308
msgctxt "text_id=12934 | speaker=unknown"
msgid "　有珠からの波状攻撃によって、むなしくも決壊してしまった。"
msgstr ""

#. Occurrence 8DOT5:17338:12935: scene=8DOT5
#: 8DOT5:17338
msgctxt "text_id=12935 | speaker=unknown"
msgid "　ほら、どうかしてるじゃないか、と草十郎は無言で指摘する。"
msgstr ""

#. Occurrence 8DOT5:17370:12936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0020; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17370
msgctxt "text_id=12936 | speaker=alice"
msgid "「静希君がどうかしたの？　彼、今夜は比較的まともだけど」"
msgstr ""

#. Occurrence 8DOT5:17380:12937: scene=8DOT5
#: 8DOT5:17380
msgctxt "text_id=12937 | speaker=unknown"
msgid "　その言葉もどうかと思う草十郎だった。"
msgstr ""

#. Occurrence 8DOT5:17415:12938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0169; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17415
msgctxt "text_id=12938 | speaker=aoko"
msgid "「ああもう、分かったわよ。そっちから切りだすまで黙っていようと思ったけど、私の方から訊いてあげる。"
msgstr ""

#. Occurrence 8DOT5:17421:12939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0170; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17421
msgctxt "text_id=12939 | speaker=aoko"
msgid "　草十郎。アンタ、ほんものの光って名前に聞き覚えはない？」"
msgstr ""

#. Occurrence 8DOT5:17439:12940: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0070; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17439
msgctxt "text_id=12940 | speaker=soujuurou"
msgid "「いやまったく。はじめて聞いた」"
msgstr ""

#. Occurrence 8DOT5:17470:12941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0171; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17470
msgctxt "text_id=12941 | speaker=aoko"
msgid "「でしょうね。名簿にアンタの名前はなかったもの。なんだってあんな勘違いしちゃったんだろ。"
msgstr ""

#. Occurrence 8DOT5:17476:12942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0172; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17476
msgctxt "text_id=12942 | speaker=aoko"
msgid "　骨折り損……とまではいかないけど、また良くない評判たてちゃった」"
msgstr ""

#. Occurrence 8DOT5:17496:12943: scene=8DOT5
#: 8DOT5:17496
msgctxt "text_id=12943 | speaker=unknown"
msgid "　青子は大げさにため息をついて、ソファーにぐったりとよりかかる。"
msgstr ""

#. Occurrence 8DOT5:17501:12944: scene=8DOT5
#: 8DOT5:17501
msgctxt "text_id=12944 | speaker=unknown"
msgid "　そんな青子の弱体化を好機と見たのか。"
msgstr ""

#. Occurrence 8DOT5:17506:12945: scene=8DOT5
#: 8DOT5:17506
msgctxt "text_id=12945 | speaker=unknown"
msgid "　サンルームから<颯爽|さっそう>とテーブルに飛来する青い星が一つ。"
msgstr ""

#. Occurrence 8DOT5:17557:12946: voice_id=BA0_8DOT5_0012; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:17557
msgctxt "text_id=12946 | speaker=unknown"
msgid "『ハハハ、見てたっス、ジブン見てたっス！　ご近所じゃもう尾ひれつきまくりッス！　蒼崎さんトコの娘さんがまた指一本で店潰したとかマジパネェ、指先一つでダウンとかどこまで都市伝説作る気っスかwwwwww』"
msgstr ""

#. Occurrence 8DOT5:17577:12947: scene=8DOT5
#: 8DOT5:17577
msgctxt "text_id=12947 | speaker=unknown"
msgid "　チチチ、と青子の健闘をたたえる駒鳥。"
msgstr ""

#. Occurrence 8DOT5:17696:12948: scene=8DOT5
#: 8DOT5:17696
msgctxt "text_id=12948 | speaker=unknown"
msgid "　それを指先一つで弾き飛ばして、青子はのっそりと体を起こした。"
msgstr ""

#. Occurrence 8DOT5:17742:12949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0173; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17742
msgctxt "text_id=12949 | speaker=aoko"
msgid "「……今日はお金、持ってないわね。例のアルバイトはもう終わったの？」"
msgstr ""

#. Occurrence 8DOT5:17748:12950: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0071; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17748
msgctxt "text_id=12950 | speaker=soujuurou"
msgid "「いや、まだ続いているよ。あのお金は預かりものだから、朝のうちに口座を作って預けておいた」"
msgstr ""

#. Occurrence 8DOT5:17768:12951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0174; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17768
msgctxt "text_id=12951 | speaker=aoko"
msgid "「預かりもの？」"
msgstr ""

#. Occurrence 8DOT5:17785:12952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0072; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17785
msgctxt "text_id=12952 | speaker=soujuurou"
msgid "「そう、預かりもの。きっと全額<返|かえ>すことになる」"
msgstr ""

#. Occurrence 8DOT5:17815:12953: scene=8DOT5
#: 8DOT5:17815
msgctxt "text_id=12953 | speaker=unknown"
msgid "　そうして、草十郎はコートを脱ぎながらホームヘルパーのアルバイトを説明した。"
msgstr ""

#. Occurrence 8DOT5:17820:12954: scene=8DOT5
#: 8DOT5:17820
msgctxt "text_id=12954 | speaker=unknown"
msgid "　あくまで簡素に。事の発端と、さきほど友人と一緒にだした結論だけを口にする。"
msgstr ""

#. Occurrence 8DOT5:17844:12955: scene=8DOT5
#: 8DOT5:17844
msgctxt "text_id=12955 | speaker=unknown"
msgid "　はじめは突拍子のない内容に面食らった青子だったが、終わる頃には、"
msgstr ""

#. Occurrence 8DOT5:17857:12956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0175; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17857
msgctxt "text_id=12956 | speaker=aoko"
msgid "「はいはい、やっぱりね。安心したっていうか、ガッカリしたっていうか。そうよね、どう頑張っても悪事を働ける人間じゃないわよね、貴方」"
msgstr ""

#. Occurrence 8DOT5:17863:12957: scene=8DOT5
#: 8DOT5:17863
msgctxt "text_id=12957 | speaker=unknown"
msgid "　などと、いつもの憎まれ口に戻っていた。"
msgstr ""

#. Occurrence 8DOT5:17905:12958: scene=8DOT5
#: 8DOT5:17905
msgctxt "text_id=12958 | speaker=unknown"
msgid "　一方。"
msgstr ""

#. Occurrence 8DOT5:17910:12959: scene=8DOT5
#: 8DOT5:17910
msgctxt "text_id=12959 | speaker=unknown"
msgid "　ホッと一息ついた青子の対面で、ひっそり青ざめる少女がひとり。"
msgstr ""

#. Occurrence 8DOT5:17931:12960: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0021; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17931
msgctxt "text_id=12960 | speaker=alice"
msgid "「待って。という事は、それは静希君のお金ではないの？」"
msgstr ""

#. Occurrence 8DOT5:17953:12961: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0073; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17953
msgctxt "text_id=12961 | speaker=soujuurou"
msgid "「ああ。<他人様|ひとさま>のお金だよ」"
msgstr ""

#. Occurrence 8DOT5:18000:12962: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0176; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18000
msgctxt "text_id=12962 | speaker=aoko"
msgid "「有珠？"
msgstr ""

#. Occurrence 8DOT5:18006:12963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0177; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18006
msgctxt "text_id=12963 | speaker=aoko"
msgid "　なんかとんでもない顔してるけど、どうかした？」"
msgstr ""

#. Occurrence 8DOT5:18025:12964: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0022; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18025
msgctxt "text_id=12964 | speaker=alice"
msgid "「……それが。どうかはしてないけど、出前はしたわ」"
msgstr ""

#. Occurrence 8DOT5:18031:12965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0178; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18031
msgctxt "text_id=12965 | speaker=aoko"
msgid "「はい？」"
msgstr ""

#. Occurrence 8DOT5:18037:12966: scene=8DOT5
#: 8DOT5:18037
msgctxt "text_id=12966 | speaker=unknown"
msgid "　そっと、壊れ物を扱うように蕎麦屋と喫茶店のメニューを差しだす有珠。"
msgstr ""

#. Occurrence 8DOT5:18076:12967: scene=8DOT5
#: 8DOT5:18076
msgctxt "text_id=12967 | speaker=unknown"
msgid "　それだけで事態を飲みこんでしまったのか、ざあ、と青子から血の気が引いていく。"
msgstr ""

#. Occurrence 8DOT5:18086:12968: scene=8DOT5
#: 8DOT5:18086
msgctxt "text_id=12968 | speaker=unknown"
msgid "　さらにそそっと、有珠から一枚のメモが差し出される。"
msgstr ""

#. Occurrence 8DOT5:18091:12969: scene=8DOT5
#: 8DOT5:18091
msgctxt "text_id=12969 | speaker=unknown"
msgid "　走り書きとおぼしきメモには、三人分にしては余りある量の注文が―――"
msgstr ""

#. Occurrence 8DOT5:18119:12970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0179; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18119
msgctxt "text_id=12970 | speaker=aoko"
msgid "「な―――ままま、まさかもう注文を!?」"
msgstr ""

#. Occurrence 8DOT5:18131:12971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0023; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18131
msgctxt "text_id=12971 | speaker=alice"
msgid "「……だって。そろそろ、ご馳走のタイミングかと思って」"
msgstr ""

#. Occurrence 8DOT5:18137:12972: scene=8DOT5
#: 8DOT5:18137
msgctxt "text_id=12972 | speaker=unknown"
msgid "　うなだれる有珠の視線は、どことなく草十郎を非難していた。"
msgstr ""

#. Occurrence 8DOT5:18175:12973: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0074; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18175
msgctxt "text_id=12973 | speaker=soujuurou"
msgid "「え？　俺？　なんで？」"
msgstr ""

#. Occurrence 8DOT5:18197:12974: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0180; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18197
msgctxt "text_id=12974 | speaker=aoko"
msgid "「そりゃ、アンタがいらない期待を持たせたからでしょ。有珠、あんなに喜んでたじゃない。明日はご馳走ねって」"
msgstr ""

#. Occurrence 8DOT5:18214:12975: scene=8DOT5
#: 8DOT5:18214
msgctxt "text_id=12975 | speaker=unknown"
msgid "　ポン、と本日二度目の手打ち音が響く。"
msgstr ""

#. Occurrence 8DOT5:18219:12976: scene=8DOT5
#: 8DOT5:18219
msgctxt "text_id=12976 | speaker=unknown"
msgid "　そう言えば昨日の夜、有珠はそんな事を言っていた。"
msgstr ""

#. Occurrence 8DOT5:18252:12977: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0024; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18252
msgctxt "text_id=12977 | speaker=alice"
msgid "「ええ。あの夜、静希君は同意してくれたわ」"
msgstr ""

#. Occurrence 8DOT5:18257:12978: scene=8DOT5
#: 8DOT5:18257
msgctxt "text_id=12978 | speaker=unknown"
msgid "　なので自分は悪くない、と有珠は主張する。"
msgstr ""

#. Occurrence 8DOT5:18274:12979: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0075; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18274
msgctxt "text_id=12979 | speaker=soujuurou"
msgid "「いや、それは」"
msgstr ""

#. Occurrence 8DOT5:18308:12980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0181; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18308
msgctxt "text_id=12980 | speaker=aoko"
msgid "「そうね。有珠のミスなのは確かだけど、悪いのはアンタもよ。大金を持ち歩くってのはそれだけで危険なんだから。"
msgstr ""

#. Occurrence 8DOT5:18314:12981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0182; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18314
msgctxt "text_id=12981 | speaker=aoko"
msgid "　いい教訓になったんじゃない？　観念して、二人で勘定を折半しなさいよ」"
msgstr ""

#. Occurrence 8DOT5:18351:12982: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0076; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18351
msgctxt "text_id=12982 | speaker=soujuurou"
msgid "「いや、それはできない。あのお金は預けてきたし、そもそも五百円しか持ち合わせがない」"
msgstr ""

#. Occurrence 8DOT5:18360:12983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0025; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18360
msgctxt "text_id=12983 | speaker=alice"
msgid "「……そう。合わせても足りないわね。……試した事はないけど、出前にキャンセルはきくのかしら……」"
msgstr ""

#. Occurrence 8DOT5:18380:12984: scene=8DOT5
#: 8DOT5:18380
msgctxt "text_id=12984 | speaker=unknown"
msgid "　絶望に包まれる久遠寺邸。"
msgstr ""

#. Occurrence 8DOT5:18385:12985: scene=8DOT5
#: 8DOT5:18385
msgctxt "text_id=12985 | speaker=unknown"
msgid "　それを他人事のように眺めつつ、やれやれと青子はため息をついた。"
msgstr ""

#. Occurrence 8DOT5:18390:12986: scene=8DOT5
#: 8DOT5:18390
msgctxt "text_id=12986 | speaker=unknown"
msgid "　……甘やかすのはよくないが、これも星の巡り合わせなのだろう、と。"
msgstr ""

#. Occurrence 8DOT5:18434:12987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0183; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18434
msgctxt "text_id=12987 | speaker=aoko"
msgid "「―――ま、そうなるか。"
msgstr ""

#. Occurrence 8DOT5:18440:12988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0184; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18440
msgctxt "text_id=12988 | speaker=aoko"
msgid "　いいわよ、私が出してあげる。今日は臨時収入があったから、パァーッと派手に使いましょう」"
msgstr ""

#. Occurrence 8DOT5:18468:12989: scene=8DOT5
#: 8DOT5:18468
msgctxt "text_id=12989 | speaker=unknown"
msgid "　思いがけぬ青子の提案に、ふたりは何事かと顔を上げる。"
msgstr ""

#. Occurrence 8DOT5:18489:12990: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0077; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18489
msgctxt "text_id=12990 | speaker=soujuurou"
msgid "「つまり、蒼崎のおごり？」"
msgstr ""

#. Occurrence 8DOT5:18495:12991: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0026; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18495
msgctxt "text_id=12991 | speaker=alice"
msgid "「そんな……信じられない。いいの青子……？」"
msgstr ""

#. Occurrence 8DOT5:18532:12992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0185; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18532
msgctxt "text_id=12992 | speaker=aoko"
msgid "「呼んじゃったものは今さら止められないでしょ。"
msgstr ""

#. Occurrence 8DOT5:18538:12993: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0186; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18538
msgctxt "text_id=12993 | speaker=aoko"
msgid "　さっき電話したんなら、今ごろはもう坂を登ってきてるだろうし。"
msgstr ""

#. Occurrence 8DOT5:18544:12994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0187; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18544
msgctxt "text_id=12994 | speaker=aoko"
msgid "　……まあ、そもそも。このお金も草十郎が発端だしね。人助けをしたら、被害者の会からお礼をもらっちゃったのよ」"
msgstr ""

#. Occurrence 8DOT5:18570:12995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0188; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18570
msgctxt "text_id=12995 | speaker=aoko"
msgid "「だから気にしないで。なんか居心地悪かったし、浄財と思って商店街に還元する。……本音いうと、ちょっともったいないけどね」"
msgstr ""

#. Occurrence 8DOT5:18576:12996: scene=8DOT5
#: 8DOT5:18576
msgctxt "text_id=12996 | speaker=unknown"
msgid "　おお、と<喝采|かっさい>をあげる同居人たち。"
msgstr ""

#. Occurrence 8DOT5:18586:12997: scene=8DOT5
#: 8DOT5:18586
msgctxt "text_id=12997 | speaker=unknown"
msgid "　その喜びようを見ながら、青子はぼすん、とソファーに沈みこんだ。"
msgstr ""

#. Occurrence 8DOT5:18619:12998: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0189; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18619
msgctxt "text_id=12998 | speaker=aoko"
msgid "「……あーあ。悪銭身に付かずって言うけど、ホントその通り。臨時収入は泡と消えた、か」"
msgstr ""

#. Occurrence 8DOT5:18625:12999: scene=8DOT5
#: 8DOT5:18625
msgctxt "text_id=12999 | speaker=unknown"
msgid "　……かくして。"
msgstr ""

#. Occurrence 8DOT5:18630:13000: scene=8DOT5
#: 8DOT5:18630
msgctxt "text_id=13000 | speaker=unknown"
msgid "　降って湧いた大金にまつわる、ちょっとした事件はこうして幕を下ろしたのである。"
msgstr ""

#. Occurrence 8DOT5:18650:13001: scene=8DOT5
#: 8DOT5:18650
msgctxt "text_id=13001 | speaker=unknown"
msgid "　テーブルには再度飛来する青い星。"
msgstr ""

#. Occurrence 8DOT5:18668:13002: voice_id=BA0_8DOT5_0013; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18668
msgctxt "text_id=13002 | speaker=unknown"
msgid "『……ああ。まったく、イヤな<事|ヤ><件|マ>だったぜ……』"
msgstr ""

#. Occurrence 8DOT5:18674:13003: scene=8DOT5
#: 8DOT5:18674
msgctxt "text_id=13003 | speaker=unknown"
msgid "　駒鳥はチチチと鳴き声をあげながら、煙草を吹かすジェスチャーなどに興じている。"
msgstr ""

#. Occurrence 8DOT5:18714:13004: voice_id=BA0_8DOT5_0014; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18714
msgctxt "text_id=13004 | speaker=unknown"
msgid "『まあ、それはそれとして。"
msgstr ""

#. Occurrence 8DOT5:18720:13005: voice_id=BA0_8DOT5_0015; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18720
msgctxt "text_id=13005 | speaker=unknown"
msgid "　青子さんの空回りっぷりを忘れないよう、これをカーモネーギー事件として記録しとくッスね！』"
msgstr ""

#. Occurrence 8DOT5:18726:13006: scene=8DOT5
#: 8DOT5:18726
msgctxt "text_id=13006 | speaker=unknown"
msgid "　つぶらな瞳で、今日最大の功労者に笑いかける青い鳥。"
msgstr ""

#. Occurrence 8DOT5:18775:13007: scene=8DOT5
#: 8DOT5:18775
msgctxt "text_id=13007 | speaker=unknown"
msgid "　それを指先一つでバウンドさせた頃、玄関からのノックがあった。"
msgstr ""

#. Occurrence 8DOT5:18809:13008: scene=8DOT5
#: 8DOT5:18809
msgctxt "text_id=13008 | speaker=unknown"
msgid "　有珠が頼んだメニューはお気に入りの洋食店のオムライスと、喫茶店からのケーキセット。"
msgstr ""

#. Occurrence 8DOT5:18816:13009: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0190; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18816
msgctxt "text_id=13009 | speaker=aoko"
msgid "「まあ、それなら―――」"
msgstr ""

#. Occurrence 8DOT5:18822:13010: scene=8DOT5
#: 8DOT5:18822
msgctxt "text_id=13010 | speaker=unknown"
msgid "　労働の報酬にしては悪くない、と現代の魔女はこっそり気を取り直すのだった。"
msgstr ""

#. Occurrence 9_0:47:13011: scene=9_0
#: 9_0:47
msgctxt "text_id=13011 | speaker=unknown"
msgid "　師匠も走る十二月。"
msgstr ""

#. Occurrence 9_0:52:13012: scene=9_0
#: 9_0:52
msgctxt "text_id=13012 | speaker=unknown"
msgid "　一年の総決算。"
msgstr ""

#. Occurrence 9_0:57:13013: scene=9_0
#: 9_0:57
msgctxt "text_id=13013 | speaker=unknown"
msgid "　やり残しを溜めに溜めた<不始末|ふしまつ>故か、<師走|しわす>の月日は<瞬|またた>く間に過ぎ去っていく。"
msgstr ""

#. Occurrence 9_0:79:13014: scene=9_0
#: 9_0:79
msgctxt "text_id=13014 | speaker=unknown"
msgid "　時に十二月某日。"
msgstr ""

#. Occurrence 9_0:84:13015: scene=9_0
#: 9_0:84
msgctxt "text_id=13015 | speaker=unknown"
msgid "　何をやっているんだか互いに不明であるが、青子も有珠も草十郎も、忙しげな毎日を過ごしていた。"
msgstr ""

#. Occurrence 9_0:137:13016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0000; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:137
msgctxt "text_id=13016 | speaker=aoko"
msgid "「なに、コレ」"
msgstr ""

#. Occurrence 9_0:161:13017: scene=9_0
#: 9_0:161
msgctxt "text_id=13017 | speaker=unknown"
msgid "　殺意を押し殺した、険悪<極|きわ>まりない声が響く。"
msgstr ""

#. Occurrence 9_0:194:13018: scene=9_0
#: 9_0:194
msgctxt "text_id=13018 | speaker=unknown"
msgid "　サンルームは中庭を一望できるため、天気の良い日など食堂として使われる。"
msgstr ""

#. Occurrence 9_0:199:13019: scene=9_0
#: 9_0:199
msgctxt "text_id=13019 | speaker=unknown"
msgid "　歴史のある洋館に相応しい、家具も内装も一級品で纏められた空間である。"
msgstr ""

#. Occurrence 9_0:228:13020: scene=9_0
#: 9_0:228
msgctxt "text_id=13020 | speaker=unknown"
msgid "　中国風の様式美を混ぜ合わせたチッペンデール式と、スマートながら英国の歴史を受け継ぐジョージアン式との融合は、庶民である青子ですら“ここでの非貴族的行為は自粛しよう”と誓わせる程だ。"
msgstr ""

#. Occurrence 9_0:233:13021: scene=9_0
#: 9_0:233
msgctxt "text_id=13021 | speaker=unknown"
msgid "　正直なところ<無|む><駄|だ><遣|づか>い以外の何物でもないと呆れもしているが、自分の財布が痛んだ訳でもないのでいいぞもっとやれ、という心境でもある。"
msgstr ""

#. Occurrence 9_0:253:13022: scene=9_0
#: 9_0:253
msgctxt "text_id=13022 | speaker=unknown"
msgid "　そんな高級感あふれるサンルームのテーブルに、目を疑う異物が三つ、鎮座していた。"
msgstr ""

#. Occurrence 9_0:271:13023: scene=9_0
#: 9_0:271
msgctxt "text_id=13023 | speaker=unknown"
msgid "　この部屋で見ると、得体の知れない宇宙食に見えなくもない。"
msgstr ""

#. Occurrence 9_0:297:13024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0001; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:297
msgctxt "text_id=13024 | speaker=aoko"
msgid "「草十郎。これ、なんか新しい冗談？」"
msgstr ""

#. Occurrence 9_0:303:13025: scene=9_0
#: 9_0:303
msgctxt "text_id=13025 | speaker=unknown"
msgid "　ふるふると<片手|かたて><拳|こぶし>を震わせながら、青子は今日の食事当番に問いかける。"
msgstr ""

#. Occurrence 9_0:308:13026: scene=9_0
#: 9_0:308
msgctxt "text_id=13026 | speaker=unknown"
msgid "　時刻は午後九時。"
msgstr ""

#. Occurrence 9_0:313:13027: scene=9_0
#: 9_0:313
msgctxt "text_id=13027 | speaker=unknown"
msgid "　夕食を用意したシェフはうん、と素直に頷いた。"
msgstr ""

#. Occurrence 9_0:347:13028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0000; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:347
msgctxt "text_id=13028 | speaker=soujuurou"
msgid "「コレはうちの会社の新製品。"
msgstr ""

#. Occurrence 9_0:353:13029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0001; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:353
msgctxt "text_id=13029 | speaker=soujuurou"
msgid "　パチモンくさいが中身はほんとにパチモンだ、と木乃美が言ってた。でも俺は本物よりいいと思う。"
msgstr ""

#. Occurrence 9_0:364:13030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0002; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:364
msgctxt "text_id=13030 | speaker=soujuurou"
msgid "　そんなコトより評価すべきは、社内販売なんで一個四十円をきる低価格だ。"
msgstr ""

#. Occurrence 9_0:371:13031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0003; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:371
msgctxt "text_id=13031 | speaker=soujuurou"
msgid "すごいぞ、卵をつけても六十円とか」"
msgstr ""

#. Occurrence 9_0:390:13032: scene=9_0
#: 9_0:390
msgctxt "text_id=13032 | speaker=unknown"
msgid "　驚きだ、と感心する手抜きシェフ。"
msgstr ""

#. Occurrence 9_0:405:13033: scene=9_0
#: 9_0:405
msgctxt "text_id=13033 | speaker=unknown"
msgid "　そりゃ誰だって驚くわ、とひとり吐き捨てる青子だった。"
msgstr ""

#. Occurrence 9_0:426:13034: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0002; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:426
msgctxt "text_id=13034 | speaker=aoko"
msgid "「そう、良かったわね。"
msgstr ""

#. Occurrence 9_0:432:13035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0003; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:432
msgctxt "text_id=13035 | speaker=aoko"
msgid "　ところで今日の夕飯はどこにあるの？」"
msgstr ""

#. Occurrence 9_0:461:13036: scene=9_0
#: 9_0:461
msgctxt "text_id=13036 | speaker=unknown"
msgid "　シェフは二秒ほど考えこんで、ぽん、と両手を合わせた。"
msgstr ""

#. Occurrence 9_0:472:13037: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0004; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:472
msgctxt "text_id=13037 | speaker=soujuurou"
msgid "「蒼崎、そんなに食べると太るよ」"
msgstr ""

#. Occurrence 9_0:514:13038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0004; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:514
msgctxt "text_id=13038 | speaker=aoko"
msgid "「つまり、"
msgstr ""

#. Occurrence 9_0:514:13039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0004; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:514
msgctxt "text_id=13039 | speaker=aoko"
msgid "　これが夕飯だって言い張る気なのねアンタはーっ！」"
msgstr ""

#. Occurrence 9_0:527:13040: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0005; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:527
msgctxt "text_id=13040 | speaker=soujuurou"
msgid "「言い張るも何も、これ以外用意していない」"
msgstr ""

#. Occurrence 9_0:561:13041: scene=9_0
#: 9_0:561
msgctxt "text_id=13041 | speaker=unknown"
msgid "　ふたりはそこで睨み合う。"
msgstr ""

#. Occurrence 9_0:566:13042: scene=9_0
#: 9_0:566
msgctxt "text_id=13042 | speaker=unknown"
msgid "　青子はこんなもの食べるものかと徹底抗戦の意を示し、"
msgstr ""

#. Occurrence 9_0:571:13043: scene=9_0
#: 9_0:571
msgctxt "text_id=13043 | speaker=unknown"
msgid "　草十郎は食べてもらえる事を大前提と信じており、"
msgstr ""

#. Occurrence 9_0:576:13044: scene=9_0
#: 9_0:576
msgctxt "text_id=13044 | speaker=unknown"
msgid "　あまつさえ、好き嫌いはいけないぞ、なんて教育理念まで持ち始めていた。"
msgstr ""

#. Occurrence 9_0:581:13045: scene=9_0
#: 9_0:581
msgctxt "text_id=13045 | speaker=unknown"
msgid "　相変わらず両者の思考は噛み合わない。"
msgstr ""

#. Occurrence 9_0:613:13046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0005; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:613
msgctxt "text_id=13046 | speaker=aoko"
msgid "「イヤ。私は食べないからね、こんなの」"
msgstr ""

#. Occurrence 9_0:630:13047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0006; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:630
msgctxt "text_id=13047 | speaker=soujuurou"
msgid "「お姫さまみたいなこと言うんじゃない。大体、今日の夕食代はこれで三名さま二百円未満なんだぞ」"
msgstr ""

#. Occurrence 9_0:636:13048: scene=9_0
#: 9_0:636
msgctxt "text_id=13048 | speaker=unknown"
msgid "　けいざい的だ、と胸を張る草十郎。"
msgstr ""

#. Occurrence 9_0:698:13049: scene=9_0
#: 9_0:698
msgctxt "text_id=13049 | speaker=unknown"
msgid "　有珠はふたりの言い合いと、目前に置かれた未知の食器……実物を見るのは初めてらしい……を交互に眺めていた。もはや完全に傍観者である。"
msgstr ""

#. Occurrence 9_0:735:13050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0006; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:735
msgctxt "text_id=13050 | speaker=aoko"
msgid "「し、信じられない……ひとり六十円の食事って、アンタ一体いつの生まれよ!?"
msgstr ""

#. Occurrence 9_0:742:13051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0007; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:742
msgctxt "text_id=13051 | speaker=aoko"
msgid "　このご時世、新しくできた牛丼屋ですら贅沢に原価あげてるわよ、ばか！」"
msgstr ""

#. Occurrence 9_0:755:13052: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0007; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:755
msgctxt "text_id=13052 | speaker=soujuurou"
msgid "「…………蒼崎。一ヶ月の食費が三万円だけで、あんな好き勝手な食生活をしていたら、俺が君たちに殺される前に全員が飢え死ぬと思うんだ」"
msgstr ""

#. Occurrence 9_0:814:13053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0008; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:814
msgctxt "text_id=13053 | speaker=soujuurou"
msgid "「たしかに昨日の有珠の肉料理は素晴らしかった。"
msgstr ""

#. Occurrence 9_0:820:13054: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0009; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:820
msgctxt "text_id=13054 | speaker=soujuurou"
msgid "　グラム七百円から肉は種類が変わるんだって感動した。"
msgstr ""

#. Occurrence 9_0:826:13055: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0010; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:826
msgctxt "text_id=13055 | speaker=soujuurou"
msgid "　生協の果汁百パーセントジュースだって、ちょっと本気で馬鹿にできるもんじゃないと反省したよ。"
msgstr ""

#. Occurrence 9_0:836:13056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0011; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:836
msgctxt "text_id=13056 | speaker=soujuurou"
msgid "　けど、あれが三日続いたらこの家はどうなってしまうんだい？」"
msgstr ""

#. Occurrence 9_0:856:13057: scene=9_0
#: 9_0:856
msgctxt "text_id=13057 | speaker=unknown"
msgid "　珍しく常識的な事を口にする草十郎。"
msgstr ""

#. Occurrence 9_0:861:13058: scene=9_0
#: 9_0:861
msgctxt "text_id=13058 | speaker=unknown"
msgid "　ひっそりと抗議の眼差しを向ける有珠だが、幸い、青子も草十郎も気付かなかった。"
msgstr ""

#. Occurrence 9_0:901:13059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0008; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:901
msgctxt "text_id=13059 | speaker=aoko"
msgid "「その時はその時よ。"
msgstr ""

#. Occurrence 9_0:907:13060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0009; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:907
msgctxt "text_id=13060 | speaker=aoko"
msgid "　それにね、昨日みたいなのは滅多にないの。有珠はアンタの料理に触発されて柄にもなく頑張ったみたいだけど！」"
msgstr ""

#. Occurrence 9_0:925:13061: scene=9_0
#: 9_0:925
msgctxt "text_id=13061 | speaker=unknown"
msgid "　青子の言葉に、有珠は静かに瞳を閉じる。"
msgstr ""

#. Occurrence 9_0:930:13062: scene=9_0
#: 9_0:930
msgctxt "text_id=13062 | speaker=unknown"
msgid "　……もしかすると、ああして怒りを抑えているのかもしれない。"
msgstr ""

#. Occurrence 9_0:963:13063: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0012; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:963
msgctxt "text_id=13063 | speaker=soujuurou"
msgid "「……信じられない。じゃあ、今までどんな生活してたんだ、蒼崎たちは」"
msgstr ""

#. Occurrence 9_0:982:13064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0010; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:982
msgctxt "text_id=13064 | speaker=aoko"
msgid "「その時は、それぞれでなんとかやってたわ。飢え死に一歩手前ぐらい、いい精神修行じゃない」"
msgstr ""

#. Occurrence 9_0:988:13065: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0013; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:988
msgctxt "text_id=13065 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_0:993:13066: scene=9_0
#: 9_0:993
msgctxt "text_id=13066 | speaker=unknown"
msgid "　あまりの潔さに絶句する。"
msgstr ""

#. Occurrence 9_0:1031:13067: scene=9_0
#: 9_0:1031
msgctxt "text_id=13067 | speaker=unknown"
msgid "　……また、これは後の話ではあるが、月の終わりになると頻繁に某会長が昼食をおごらせにやってくる、と某副会長は告発するのだった。"
msgstr ""

#. Occurrence 9_0:1037:13068: scene=9_0
#: 9_0:1037
msgctxt "text_id=13068 | speaker=unknown"
msgid "　それはともかくとして。"
msgstr ""

#. Occurrence 9_0:1071:13069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0011; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1071
msgctxt "text_id=13069 | speaker=aoko"
msgid "「そんな昔のコトより今のコト！"
msgstr ""

#. Occurrence 9_0:1077:13070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0012; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1077
msgctxt "text_id=13070 | speaker=aoko"
msgid "　前に見せたあの腕はどこにいったのよ草十郎!?　あれを見こんで今日の夕飯を任せたっていうのに！」"
msgstr ""

#. Occurrence 9_0:1083:13071: scene=9_0
#: 9_0:1083
msgctxt "text_id=13071 | speaker=unknown"
msgid "　……なんだかんだと、青子はそれが一番悔しいらしい。"
msgstr ""

#. Occurrence 9_0:1088:13072: scene=9_0
#: 9_0:1088
msgctxt "text_id=13072 | speaker=unknown"
msgid "　あの時の焼きうどんはいたく好評で、起きたばかりの青子の不機嫌っぷりは一口で解消してしまったほどだ。"
msgstr ""

#. Occurrence 9_0:1108:13073: scene=9_0
#: 9_0:1108
msgctxt "text_id=13073 | speaker=unknown"
msgid "　しかし草十郎は、あれが数少ないレパートリーの一つだという事を語っていない。"
msgstr ""

#. Occurrence 9_0:1113:13074: scene=9_0
#: 9_0:1113
msgctxt "text_id=13074 | speaker=unknown"
msgid "　男料理とは、基本的に<独身|ひとり>に<唯一|ひとつ>の<異能力|レシピ>なのだ。"
msgstr ""

#. Occurrence 9_0:1118:13075: scene=9_0
#: 9_0:1118
msgctxt "text_id=13075 | speaker=unknown"
msgid "　あと十五年ぐらいしたら流行りそうな特殊能力みたいなもんである。"
msgstr ""

#. Occurrence 9_0:1153:13076: scene=9_0
#: 9_0:1153
msgctxt "text_id=13076 | speaker=unknown"
msgid "　以上の誤解から、有珠と青子は草十郎の料理技術を過大評価していたりする。"
msgstr ""

#. Occurrence 9_0:1158:13077: scene=9_0
#: 9_0:1158
msgctxt "text_id=13077 | speaker=unknown"
msgid "　そこに原因があったのか、と納得する草十郎。"
msgstr ""

#. Occurrence 9_0:1193:13078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0014; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:1193
msgctxt "text_id=13078 | speaker=soujuurou"
msgid "「……分かった、自腹を切るから出前をとろう。作るにしても材料がないからな。"
msgstr ""

#. Occurrence 9_0:1204:13079: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0015; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:1204
msgctxt "text_id=13079 | speaker=soujuurou"
msgid "　そのかわり、それは回収する」"
msgstr ""

#. Occurrence 9_0:1230:13080: scene=9_0
#: 9_0:1230
msgctxt "text_id=13080 | speaker=unknown"
msgid "　うむ、と自らの勝利を喜ぶ青子。"
msgstr ""

#. Occurrence 9_0:1266:13081: scene=9_0
#: 9_0:1266
msgctxt "text_id=13081 | speaker=unknown"
msgid "　が。出前の献立を取りに行く草十郎の顔を見て、青子は自分の勘違いに気付いてしまった。"
msgstr ""

#. Occurrence 9_0:1271:13082: scene=9_0
#: 9_0:1271
msgctxt "text_id=13082 | speaker=unknown"
msgid "　青子がカチンときたのは、夕食に手を抜くとは何事か、という点が大きい。"
msgstr ""

#. Occurrence 9_0:1276:13083: scene=9_0
#: 9_0:1276
msgctxt "text_id=13083 | speaker=unknown"
msgid "　けれど草十郎にとって、この夕食は手抜きでもなんでもなく、本気で食べてみたかったのだろう。"
msgstr ""

#. Occurrence 9_0:1309:13084: scene=9_0
#: 9_0:1309
msgctxt "text_id=13084 | speaker=unknown"
msgid "　山育ちはこういう物でも喜ぶのか、と青子はつくづく感心する。"
msgstr ""

#. Occurrence 9_0:1314:13085: scene=9_0
#: 9_0:1314
msgctxt "text_id=13085 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence 9_0:1341:13086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0013; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1341
msgctxt "text_id=13086 | speaker=aoko"
msgid "「……？　有珠、何してるの？」"
msgstr ""

#. Occurrence 9_0:1347:13087: scene=9_0
#: 9_0:1347
msgctxt "text_id=13087 | speaker=unknown"
msgid "　青子はようやく、有珠がテーブルに近寄り、しっかりとどんぶりを持っている事に気がついた。"
msgstr ""

#. Occurrence 9_0:1378:13088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0014_A; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1378
msgctxt "text_id=13088 | speaker=aoko"
msgid "「もうそれはいいんだってば。"
msgstr ""

#. Occurrence 9_0:1384:13089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0015; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1384
msgctxt "text_id=13089 | speaker=aoko"
msgid "　草十郎に返して、きちんとした出前にしましょ」"
msgstr ""

#. Occurrence 9_0:1404:13090: scene=9_0
#: 9_0:1404
msgctxt "text_id=13090 | speaker=unknown"
msgid "　青子に言われても、有珠はどんぶりから手を離さない。"
msgstr ""

#. Occurrence 9_0:1409:13091: scene=9_0
#: 9_0:1409
msgctxt "text_id=13091 | speaker=unknown"
msgid "　むしろ抱くように持ちあげ、"
msgstr ""

#. Occurrence 9_0:1420:13092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_0_0000; voice_prefix=A40; voice_category=2; scene=9_0
#: 9_0:1420
msgctxt "text_id=13092 | speaker=alice"
msgid "「これ、わたしのだから」"
msgstr ""

#. Occurrence 9_0:1442:13093: scene=9_0
#: 9_0:1442
msgctxt "text_id=13093 | speaker=unknown"
msgid "　静かな有珠の声が、閑散としたサンルームに響きわたる。"
msgstr ""

#. Occurrence 9_0:1465:13094: scene=9_0
#: 9_0:1465
msgctxt "text_id=13094 | speaker=unknown"
msgid "　どうやら多数決によって、今夜の献立は決定したらしい。"
msgstr ""

#. Occurrence 9_0:1470:13095: scene=9_0
#: 9_0:1470
msgctxt "text_id=13095 | speaker=unknown"
msgid "　まさかそんな、と青子は力なく肩を落とす。"
msgstr ""

#. Occurrence 9_0:1475:13096: scene=9_0
#: 9_0:1475
msgctxt "text_id=13096 | speaker=unknown"
msgid "　そういえば、有珠の『自分の物』に対する執着心は異常なものがあったなぁ、と思い返しながら。"
msgstr ""

#. Occurrence 9_1:50:13097: scene=9_1
#: 9_1:50
msgctxt "text_id=13097 | speaker=unknown"
msgid "　十二月も残すところ十日をきった朝。"
msgstr ""

#. Occurrence 9_1:67:13098: scene=9_1
#: 9_1:67
msgctxt "text_id=13098 | speaker=unknown"
msgid "　もうじきクリスマスと浮かれる町並みに逆行するように、草十郎はアルバイトに向かっていた。"
msgstr ""

#. Occurrence 9_1:72:13099: scene=9_1
#: 9_1:72
msgctxt "text_id=13099 | speaker=unknown"
msgid "　今にも雪が降ってきそうな空の下、並木道は鮮やかに賑わっている。"
msgstr ""

#. Occurrence 9_1:77:13100: scene=9_1
#: 9_1:77
msgctxt "text_id=13100 | speaker=unknown"
msgid "　ここ数日は特に華やかだ。"
msgstr ""

#. Occurrence 9_1:82:13101: scene=9_1
#: 9_1:82
msgctxt "text_id=13101 | speaker=unknown"
msgid "　冬休みの学生たちは日々親しい友人と顔を合わせ、間近に迫ったイベントを指折り数えて待っている。"
msgstr ""

#. Occurrence 9_1:110:13102: scene=9_1
#: 9_1:110
msgctxt "text_id=13102 | speaker=unknown"
msgid "　魔よけのお札のように乱立する特製ケーキの見出し。"
msgstr ""

#. Occurrence 9_1:115:13103: scene=9_1
#: 9_1:115
msgctxt "text_id=13103 | speaker=unknown"
msgid "　ビルの壁一面に貼られた巨大広告。"
msgstr ""

#. Occurrence 9_1:120:13104: scene=9_1
#: 9_1:120
msgctxt "text_id=13104 | speaker=unknown"
msgid "　駅前広場に集まった数々の露店。"
msgstr ""

#. Occurrence 9_1:149:13105: scene=9_1
#: 9_1:149
msgctxt "text_id=13105 | speaker=unknown"
msgid "　そういった都会の町の賑わいを横目に、草十郎は電話ボックスに入る。"
msgstr ""

#. Occurrence 9_1:154:13106: scene=9_1
#: 9_1:154
msgctxt "text_id=13106 | speaker=unknown"
msgid "　中も冷えきっていたが、冬の風が入らないだけ暖かい。"
msgstr ""

#. Occurrence 9_1:172:13107: scene=9_1
#: 9_1:172
msgctxt "text_id=13107 | speaker=unknown"
msgid "　雪山にこういうのを置いたら便利なんじゃないか、などと思いつつ、"
msgstr ""

msgctxt "text_id=13108 | speaker=unknown"
msgid "草十郎は電話に十円玉を投入する。"
msgstr ""

#. Occurrence 9_1:195:13109: scene=9_1
#: 9_1:195
msgctxt "text_id=13109 | speaker=unknown"
msgid "　それなりに慣れた手つきで、暗記したナンバーをプッシュする。"
msgstr ""

#. Occurrence 9_1:200:13110: scene=9_1
#: 9_1:200
msgctxt "text_id=13110 | speaker=unknown"
msgid "　コールが鳴るまで約五秒。"
msgstr ""

#. Occurrence 9_1:206:13111: scene=9_1
#: 9_1:206
msgctxt "text_id=13111 | speaker=unknown"
msgid "　コールが鳴ってから、またも五秒。"
msgstr ""

#. Occurrence 9_1:225:13112: scene=9_1
#: 9_1:225
msgctxt "text_id=13112 | speaker=unknown"
msgid "　十秒間の待ち時間。"
msgstr ""

#. Occurrence 9_1:230:13113: scene=9_1
#: 9_1:230
msgctxt "text_id=13113 | speaker=unknown"
msgid "　電話ボックスからビルの壁に飾られた広告を見上げて、今さらながら人々の多種多様さに感心したりする。"
msgstr ""

#. Occurrence 9_1:250:13114: scene=9_1
#: 9_1:250
msgctxt "text_id=13114 | speaker=unknown"
msgid "　電話番号は槻司鳶丸のものである。"
msgstr ""

#. Occurrence 9_1:255:13115: scene=9_1
#: 9_1:255
msgctxt "text_id=13115 | speaker=unknown"
msgid "　槻司家は三咲市に深く関わりのある家―――古くからの地主、名家であるらしい。"
msgstr ""

#. Occurrence 9_1:260:13116: scene=9_1
#: 9_1:260
msgctxt "text_id=13116 | speaker=unknown"
msgid "　その豪邸は隣町である<社木|やしろぎ>にある。"
msgstr ""

#. Occurrence 9_1:278:13117: scene=9_1
#: 9_1:278
msgctxt "text_id=13117 | speaker=unknown"
msgid "　呼び出し音に取ってかわったのは、感じの良い初老の婦人の声だった。"
msgstr ""

#. Occurrence 9_1:283:13118: scene=9_1
#: 9_1:283
msgctxt "text_id=13118 | speaker=unknown"
msgid "　婦人は丁寧な挨拶の後、目的の人物に繋げてくれた。"
msgstr ""

#. Occurrence 9_1:304:13119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_1_0000; voice_prefix=A30; voice_category=3; scene=9_1
#: 9_1:304
msgctxt "text_id=13119 | speaker=soujuurou"
msgid "「おはよう、鳶丸」"
msgstr ""

#. Occurrence 9_1:310:13120: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0000; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:310
msgctxt "text_id=13120 | speaker=tobimaru"
msgid "『……あい、おはよう』"
msgstr ""

#. Occurrence 9_1:315:13121: scene=9_1
#: 9_1:315
msgctxt "text_id=13121 | speaker=unknown"
msgid "　寝惚けているのか、そんな返答が受話器ごしに返される。"
msgstr ""

#. Occurrence 9_1:321:13122: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_1_0001; voice_prefix=A30; voice_category=3; scene=9_1
#: 9_1:321
msgctxt "text_id=13122 | speaker=soujuurou"
msgid "「ひとつ相談があるんだけど、いいか？」"
msgstr ""

#. Occurrence 9_1:327:13123: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0001; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:327
msgctxt "text_id=13123 | speaker=tobimaru"
msgid "『うむ、よきにはからえ』"
msgstr ""

#. Occurrence 9_1:357:13124: scene=9_1
#: 9_1:357
msgctxt "text_id=13124 | speaker=unknown"
msgid "　……大丈夫かなこの男、と不安に思いつつ、草十郎はまっすぐ本題を切りだした。"
msgstr ""

#. Occurrence 9_1:363:13125: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0002; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:363
msgctxt "text_id=13125 | speaker=tobimaru"
msgid "『………………』"
msgstr ""

#. Occurrence 9_1:368:13126: scene=9_1
#: 9_1:368
msgctxt "text_id=13126 | speaker=unknown"
msgid "　しばらく無音。"
msgstr ""

#. Occurrence 9_1:373:13127: scene=9_1
#: 9_1:373
msgctxt "text_id=13127 | speaker=unknown"
msgid "　受話器の向こうの副会長が、どんな呆れ顔をしているかは分からない。"
msgstr ""

#. Occurrence 9_1:394:13128: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0003; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:394
msgctxt "text_id=13128 | speaker=tobimaru"
msgid "『……あのな、んな単純なコトで俺を起こすな。"
msgstr ""

#. Occurrence 9_1:400:13129: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0004; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:400
msgctxt "text_id=13129 | speaker=tobimaru"
msgid "　いいか草十郎。仲が悪けりゃ遊びに行け。機嫌をとりたきゃいいとこ見せろ。んで、それが合わなきゃ早めに手を切れ。俺ができるアドバイスはそんなもんだ』"
msgstr ""

#. Occurrence 9_1:421:13130: scene=9_1
#: 9_1:421
msgctxt "text_id=13130 | speaker=unknown"
msgid "　以上、と鳶丸は電話を切った。"
msgstr ""

#. Occurrence 9_1:426:13131: scene=9_1
#: 9_1:426
msgctxt "text_id=13131 | speaker=unknown"
msgid "　もう朝の十時だというのに、まるで朝の六時のような鳶丸の対応に、うむ、と草十郎は真剣に頷いた。"
msgstr ""

#. Occurrence 9_1:443:13132: scene=9_1
#: 9_1:443
msgctxt "text_id=13132 | speaker=unknown"
msgid "　適当にあしらわれた気はするが、たしかにそれは一番現実的な気がする、と感心しながら。"
msgstr ""

#. Occurrence 9_2:52:13133: scene=9_2
#: 9_2:52
msgctxt "text_id=13133 | speaker=unknown"
msgid "　電話ボックスの一件から買い物を済ませ、正午前。"
msgstr ""

#. Occurrence 9_2:57:13134: scene=9_2
#: 9_2:57
msgctxt "text_id=13134 | speaker=unknown"
msgid "　草十郎が洋館に戻ると、青子と有珠は暗い面持ちで黙りこんでいた。"
msgstr ""

#. Occurrence 9_2:77:13135: scene=9_2
#: 9_2:77
msgctxt "text_id=13135 | speaker=unknown"
msgid "　事情を知らない第三者が見れば喧嘩の後にしか見えない。"
msgstr ""

#. Occurrence 9_2:107:13136: scene=9_2
#: 9_2:107
msgctxt "text_id=13136 | speaker=unknown"
msgid "　それは<吹雪|ふぶ>くような、チクチク痛いやらヒリヒリ寒いやらな、沈黙による暴力である。"
msgstr ""

#. Occurrence 9_2:112:13137: scene=9_2
#: 9_2:112
msgctxt "text_id=13137 | speaker=unknown"
msgid "　居間は巨大な冷蔵庫と化している。"
msgstr ""

#. Occurrence 9_2:117:13138: scene=9_2
#: 9_2:117
msgctxt "text_id=13138 | speaker=unknown"
msgid "　ちょっと天井を見上げれば、<氷柱|つらら>が垂れていても不思議ではないぐらいだ。"
msgstr ""

#. Occurrence 9_2:157:13139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0000; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:157
msgctxt "text_id=13139 | speaker=soujuurou"
msgid "“やっぱり、今日もか”"
msgstr ""

#. Occurrence 9_2:169:13140: scene=9_2
#: 9_2:169
msgctxt "text_id=13140 | speaker=unknown"
msgid "　アライグマとペンギンの仲違いに心痛める飼育員……"
msgstr ""

msgctxt "text_id=13141 | speaker=unknown"
msgid "つい先日、日雇いで動物園の清掃をしてきた草十郎である……"
msgstr ""

msgctxt "text_id=13142 | speaker=unknown"
msgid "のような顔つきで、草十郎は青子たちを流し見る。"
msgstr ""

#. Occurrence 9_2:194:13143: scene=9_2
#: 9_2:194
msgctxt "text_id=13143 | speaker=unknown"
msgid "　言うまでもなく、ふたりは喧嘩などしていない。"
msgstr ""

#. Occurrence 9_2:199:13144: scene=9_2
#: 9_2:199
msgctxt "text_id=13144 | speaker=unknown"
msgid "　食事以外では終始この調子なだけだ。"
msgstr ""

#. Occurrence 9_2:204:13145: scene=9_2
#: 9_2:204
msgctxt "text_id=13145 | speaker=unknown"
msgid "　<草十郎|じぶん>の知らないところでの問題――他所からやってきた魔術師との戦いは、日に日に厳しいものになっているらしい。"
msgstr ""

#. Occurrence 9_2:225:13146: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0001; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:225
msgctxt "text_id=13146 | speaker=soujuurou"
msgid "“もっとも、有珠はいつも通りだけど”"
msgstr ""

#. Occurrence 9_2:246:13147: scene=9_2
#: 9_2:246
msgctxt "text_id=13147 | speaker=unknown"
msgid "　瞑想っぽく口を閉ざしている青子に対して、有珠は古ぼけた本を両膝に置いて読む、いつものスタンスである。"
msgstr ""

#. Occurrence 9_2:251:13148: scene=9_2
#: 9_2:251
msgctxt "text_id=13148 | speaker=unknown"
msgid "　違うところといえば、その本が今までの物より遥かに重そうな物であるコトぐらい。"
msgstr ""

#. Occurrence 9_2:286:13149: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0002; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:286
msgctxt "text_id=13149 | speaker=soujuurou"
msgid "「ただいま。煮詰まってるな、ここんところ」"
msgstr ""

#. Occurrence 9_2:291:13150: scene=9_2
#: 9_2:291
msgctxt "text_id=13150 | speaker=unknown"
msgid "　コートを脱ぎつつ青子たちに声をかける。"
msgstr ""

#. Occurrence 9_2:307:13151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0000; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:307
msgctxt "text_id=13151 | speaker=aoko"
msgid "「煮詰まるぐらい事態が進んでるなら、まだ面白みもあるんでしょうけどね。"
msgstr ""

#. Occurrence 9_2:318:13152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0001; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:318
msgctxt "text_id=13152 | speaker=aoko"
msgid "　今の誤用よ、草十郎」"
msgstr ""

#. Occurrence 9_2:351:13153: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0003; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:351
msgctxt "text_id=13153 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence 9_2:356:13154: scene=9_2
#: 9_2:356
msgctxt "text_id=13154 | speaker=unknown"
msgid "　青子の言わんとするところが分からず、草十郎は首をかしげる。"
msgstr ""

#. Occurrence 9_2:361:13155: scene=9_2
#: 9_2:361
msgctxt "text_id=13155 | speaker=unknown"
msgid "　考えすぎはよくないぞ、とリラックスさせるつもりが、逆に注意されてしまった。"
msgstr ""

#. Occurrence 9_2:400:13156: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0002; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:400
msgctxt "text_id=13156 | speaker=aoko"
msgid "「煮詰まってるってコトはもうじき完成ってコトでしょ。"
msgstr ""

#. Occurrence 9_2:406:13157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0003; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:406
msgctxt "text_id=13157 | speaker=aoko"
msgid "　進展がないって意味合いなら、行き詰まってると言うべきね」"
msgstr ""

#. Occurrence 9_2:418:13158: scene=9_2
#: 9_2:418
msgctxt "text_id=13158 | speaker=unknown"
msgid "　草十郎を叱る余裕もないのか、青子は邪険に手を振って“余所にいってて”とジェスチャーする。"
msgstr ""

#. Occurrence 9_2:423:13159: scene=9_2
#: 9_2:423
msgctxt "text_id=13159 | speaker=unknown"
msgid "　無論、"
msgstr ""

#. Occurrence 9_2:457:13160: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0004; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:457
msgctxt "text_id=13160 | speaker=soujuurou"
msgid "「じゃあ言い直して。"
msgstr ""

#. Occurrence 9_2:463:13161: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0005; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:463
msgctxt "text_id=13161 | speaker=soujuurou"
msgid "　やあ、あれから進展はあったかい？」"
msgstr ""

#. Occurrence 9_2:469:13162: scene=9_2
#: 9_2:469
msgctxt "text_id=13162 | speaker=unknown"
msgid "　それぐらいでめげる草十郎ではないのだった。"
msgstr ""

#. Occurrence 9_2:502:13163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0004; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:502
msgctxt "text_id=13163 | speaker=aoko"
msgid "「草十郎には関係ないわ。"
msgstr ""

#. Occurrence 9_2:508:13164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0005; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:508
msgctxt "text_id=13164 | speaker=aoko"
msgid "　<魔術|こっち>の事情に関しては不可侵だって、言わなかった？」"
msgstr ""

#. Occurrence 9_2:514:13165: scene=9_2
#: 9_2:514
msgctxt "text_id=13165 | speaker=unknown"
msgid "　静かではあるがトゲのある返答。"
msgstr ""

#. Occurrence 9_2:519:13166: scene=9_2
#: 9_2:519
msgctxt "text_id=13166 | speaker=unknown"
msgid "　ご機嫌斜めなのはいつものコトだが、今日は六割増しのようだ。"
msgstr ""

#. Occurrence 9_2:554:13167: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0006; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:554
msgctxt "text_id=13167 | speaker=soujuurou"
msgid "「もちろん聞いてる。ところで、お昼はまだだろう？」"
msgstr ""

#. Occurrence 9_2:560:13168: scene=9_2
#: 9_2:560
msgctxt "text_id=13168 | speaker=unknown"
msgid "　そんな青子の不機嫌さも気にせず、草十郎は食い下がった。"
msgstr ""

#. Occurrence 9_2:566:13169: scene=9_2
#: 9_2:566
msgctxt "text_id=13169 | speaker=unknown"
msgid "青子が六割増しなら、彼の<暢気|のんき>さは二倍に増強というところ。"
msgstr ""

#. Occurrence 9_2:585:13170: scene=9_2
#: 9_2:585
msgctxt "text_id=13170 | speaker=unknown"
msgid "　その強引さに、さすがの青子もわずかに怯む。"
msgstr ""

#. Occurrence 9_2:611:13171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0006; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:611
msgctxt "text_id=13171 | speaker=aoko"
msgid "「どうしたの、今日は。なにかいい事でもあったわけ？」"
msgstr ""

#. Occurrence 9_2:616:13172: scene=9_2
#: 9_2:616
msgctxt "text_id=13172 | speaker=unknown"
msgid "　別に、と草十郎は首をふる。"
msgstr ""

#. Occurrence 9_2:640:13173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0007; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:640
msgctxt "text_id=13173 | speaker=soujuurou"
msgid "「まだなんだ。じゃあちょっと、提案がある」"
msgstr ""

#. Occurrence 9_2:660:13174: scene=9_2
#: 9_2:660
msgctxt "text_id=13174 | speaker=unknown"
msgid "　言って、ハンガーにかけたコートのポケットをあさる。"
msgstr ""

#. Occurrence 9_2:665:13175: scene=9_2
#: 9_2:665
msgctxt "text_id=13175 | speaker=unknown"
msgid "　今日にかぎって積極的な草十郎の様子を、青子は訝しげに見据え、有珠は本を読みながら聞き耳をたてている。"
msgstr ""

#. Occurrence 9_2:697:13176: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0008; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:697
msgctxt "text_id=13176 | speaker=soujuurou"
msgid "「実は今日、給料日だったんだ。"
msgstr ""

#. Occurrence 9_2:697:13177: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0008; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:697
msgctxt "text_id=13177 | speaker=soujuurou"
msgid "　お金も入った事だし、外に遊びにいこう」"
msgstr ""

#. Occurrence 9_2:715:13178: scene=9_2
#: 9_2:715
msgctxt "text_id=13178 | speaker=unknown"
msgid "　コートから財布を取り出し、心温まる笑顔で言う。"
msgstr ""

#. Occurrence 9_2:746:13179: scene=9_2
#: 9_2:746
msgctxt "text_id=13179 | speaker=unknown"
msgid "　一方、ふたりは複雑な顔である。"
msgstr ""

#. Occurrence 9_2:786:13180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0007; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:786
msgctxt "text_id=13180 | speaker=aoko"
msgid "「……草十郎」"
msgstr ""

#. Occurrence 9_2:792:13181: scene=9_2
#: 9_2:792
msgctxt "text_id=13181 | speaker=unknown"
msgid "　何か文句を言ってやりたかったけど、それと同じぐらい青子は草十郎に同情した。"
msgstr ""

#. Occurrence 9_2:797:13182: scene=9_2
#: 9_2:797
msgctxt "text_id=13182 | speaker=unknown"
msgid "　彼はいまだ不仲な有珠と融和するため、なけなしの給料をはたいて行動に出たのだろう。"
msgstr ""

#. Occurrence 9_2:829:13183: scene=9_2
#: 9_2:829
msgctxt "text_id=13183 | speaker=unknown"
msgid "　考え自体は悪くない。"
msgstr ""

#. Occurrence 9_2:834:13184: scene=9_2
#: 9_2:834
msgctxt "text_id=13184 | speaker=unknown"
msgid "　そんな事じゃ有珠の“とりあえず今は黙っていてあげるけど、何か目障りな事をしたら消す”感は消えないと分かっていても、その健気な努力に応援ぐらいはしてあげたい。"
msgstr ""

#. Occurrence 9_2:839:13185: scene=9_2
#: 9_2:839
msgctxt "text_id=13185 | speaker=unknown"
msgid "　けれど、今は三人で街を歩いている気分じゃないし、状況でもないのだ。"
msgstr ""

#. Occurrence 9_2:865:13186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0008; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:865
msgctxt "text_id=13186 | speaker=aoko"
msgid "「悪いけど、いま忙しいの。暇になったら思い出してあげるから、しばらく我慢して」"
msgstr ""

#. Occurrence 9_2:883:13187: scene=9_2
#: 9_2:883
msgctxt "text_id=13187 | speaker=unknown"
msgid "　何も言わないが有珠も同意見らしい。"
msgstr ""

#. Occurrence 9_2:888:13188: scene=9_2
#: 9_2:888
msgctxt "text_id=13188 | speaker=unknown"
msgid "　そんな重苦しい空気にもめげず、"
msgstr ""

#. Occurrence 9_2:920:13189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0009; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:920
msgctxt "text_id=13189 | speaker=soujuurou"
msgid "「忙しいって、ここで黙りあってるだけじゃないか。"
msgstr ""

#. Occurrence 9_2:926:13190: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0010; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:926
msgctxt "text_id=13190 | speaker=soujuurou"
msgid "　徹夜漬けの時、気分転換は必要だって言ったのは蒼崎だろ。行き詰まったら回れ右して戻らないと、どこにも行けない」"
msgstr ""

#. Occurrence 9_2:957:13191: scene=9_2
#: 9_2:957
msgctxt "text_id=13191 | speaker=unknown"
msgid "　いつになく強気に言って、草十郎は財布から二枚のチケットを取り出し、とん、とテーブルに置いた。"
msgstr ""

#. Occurrence 9_2:962:13192: scene=9_2
#: 9_2:962
msgctxt "text_id=13192 | speaker=unknown"
msgid "　それは映画の前売券……なんてありきたりなものではなく、有名な水族館のチケットだった。"
msgstr ""

#. Occurrence 9_2:982:13193: scene=9_2
#: 9_2:982
msgctxt "text_id=13193 | speaker=unknown"
msgid "　行き先は、快速と地下鉄を乗り継いだ先にある、三咲市より何倍も近代化の進んだ街。"
msgstr ""

#. Occurrence 9_2:987:13194: scene=9_2
#: 9_2:987
msgctxt "text_id=13194 | speaker=unknown"
msgid "　県内最大をうたうショッピングモールだけでなく、来年開場予定の、国際的な規模の演劇、講演を可能とする多目的ホールまで造られているという。"
msgstr ""

#. Occurrence 9_2:1019:13195: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0011; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1019
msgctxt "text_id=13195 | speaker=soujuurou"
msgid "「それと、夜はメシアンでカレーでも食べてくれ」"
msgstr ""

#. Occurrence 9_2:1038:13196: scene=9_2
#: 9_2:1038
msgctxt "text_id=13196 | speaker=unknown"
msgid "　さらに、見ようによっては黄金にも見えるお札を二枚ほどぽん、とテーブルにそえる。"
msgstr ""

#. Occurrence 9_2:1043:13197: scene=9_2
#: 9_2:1043
msgctxt "text_id=13197 | speaker=unknown"
msgid "　そういえば、夕食の食事当番は草十郎だった。"
msgstr ""

#. Occurrence 9_2:1111:13198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0012; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1111
msgctxt "text_id=13198 | speaker=soujuurou"
msgid "「じゃ、そういう事で」"
msgstr ""

#. Occurrence 9_2:1118:13199: scene=9_2
#: 9_2:1118
msgctxt "text_id=13199 | speaker=unknown"
msgid "　草十郎は用件だけ告げ、財布をコートに戻す。"
msgstr ""

#. Occurrence 9_2:1123:13200: scene=9_2
#: 9_2:1123
msgctxt "text_id=13200 | speaker=unknown"
msgid "　それで、青子はようやく自分の間違いに気が付いた。"
msgstr ""

#. Occurrence 9_2:1158:13201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0009; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1158
msgctxt "text_id=13201 | speaker=aoko"
msgid "「ちょっと待った！　そういうアンタはどうするのよ」"
msgstr ""

#. Occurrence 9_2:1164:13202: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0013; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1164
msgctxt "text_id=13202 | speaker=soujuurou"
msgid "「今日はアルバイト」"
msgstr ""

#. Occurrence 9_2:1175:13203: scene=9_2
#: 9_2:1175
msgctxt "text_id=13203 | speaker=unknown"
msgid "　さらっと答える草十郎に、そういうコト、と察する青子。"
msgstr ""

#. Occurrence 9_2:1200:13204: scene=9_2
#: 9_2:1200
msgctxt "text_id=13204 | speaker=unknown"
msgid "　草十郎は自分の為でなく、ここのところギスギスしている青子と有珠の仲をほぐそうとしているのだ。"
msgstr ""

#. Occurrence 9_2:1210:13205: scene=9_2
#: 9_2:1210
msgctxt "text_id=13205 | speaker=unknown"
msgid "　そんなのは彼の勝手な勘違いで、言ってしまえば迷惑なお節介に分類される。"
msgstr ""

#. Occurrence 9_2:1215:13206: scene=9_2
#: 9_2:1215
msgctxt "text_id=13206 | speaker=unknown"
msgid "　……しかし。"
msgstr ""

#. Occurrence 9_2:1220:13207: scene=9_2
#: 9_2:1220
msgctxt "text_id=13207 | speaker=unknown"
msgid "　そんな風に気を配ってくれた事と、なにより、そこまで気を遣わせてしまった自分の未熟さに反省する。"
msgstr ""

#. Occurrence 9_2:1260:13208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0010; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1260
msgctxt "text_id=13208 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_2:1266:13209: scene=9_2
#: 9_2:1266
msgctxt "text_id=13209 | speaker=unknown"
msgid "　青子は対面に座る有珠を覗き見た。"
msgstr ""

#. Occurrence 9_2:1295:13210: scene=9_2
#: 9_2:1295
msgctxt "text_id=13210 | speaker=unknown"
msgid "　すると、ちょうど有珠も青子に視線を投げかけているところだった。"
msgstr ""

#. Occurrence 9_2:1326:13211: scene=9_2
#: 9_2:1326
msgctxt "text_id=13211 | speaker=unknown"
msgid "　ふたりはしばし無言で見つめ合う。"
msgstr ""

#. Occurrence 9_2:1366:13212: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_2_0000; voice_prefix=A40; voice_category=2; scene=9_2
#: 9_2:1366
msgctxt "text_id=13212 | speaker=alice"
msgid "「……わたしはかまわないけど。"
msgstr ""

#. Occurrence 9_2:1366:13213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_2_0000; voice_prefix=A40; voice_category=2; scene=9_2
#: 9_2:1366
msgctxt "text_id=13213 | speaker=alice"
msgid "　いまやれる事は全部やってあるし」"
msgstr ""

#. Occurrence 9_2:1384:13214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0011; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1384
msgctxt "text_id=13214 | speaker=aoko"
msgid "「そうね。そういう事なら、せっかくだし」"
msgstr ""

#. Occurrence 9_2:1403:13215: scene=9_2
#: 9_2:1403
msgctxt "text_id=13215 | speaker=unknown"
msgid "　観念したように言って、青子はソファーから立ち上がる。"
msgstr ""

#. Occurrence 9_2:1419:13216: scene=9_2
#: 9_2:1419
msgctxt "text_id=13216 | speaker=unknown"
msgid "　そんなふたりを、草十郎は満足げに眺めていた。"
msgstr ""

#. Occurrence 9_3:46:13217: scene=9_3
#: 9_3:46
msgctxt "text_id=13217 | speaker=unknown"
msgid "　それから二十分ほど後。"
msgstr ""

#. Occurrence 9_3:51:13218: scene=9_3
#: 9_3:51
msgctxt "text_id=13218 | speaker=unknown"
msgid "　青子と有珠は外出の支度を済ませ、居間にいる草十郎に声をかけた。"
msgstr ""

#. Occurrence 9_3:72:13219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0000; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:72
msgctxt "text_id=13219 | speaker=aoko"
msgid "「それじゃ出かけてくるからアンタもバイト―――草十郎？」"
msgstr ""

#. Occurrence 9_3:104:13220: scene=9_3
#: 9_3:104
msgctxt "text_id=13220 | speaker=unknown"
msgid "　立ち寄ったふたりに気付かず、草十郎はなにやらテレビの前にしゃがみこんでいる。"
msgstr ""

#. Occurrence 9_3:111:13221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0001; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:111
msgctxt "text_id=13221 | speaker=aoko"
msgid "「もしかして、ビデオいじってるの？」"
msgstr ""

#. Occurrence 9_3:144:13222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0000; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:144
msgctxt "text_id=13222 | speaker=soujuurou"
msgid "「ああ、ちょうど良かった。蒼崎、これ―――」"
msgstr ""

#. Occurrence 9_3:150:13223: scene=9_3
#: 9_3:150
msgctxt "text_id=13223 | speaker=unknown"
msgid "　作業を中断し、青子たちに振り向く草十郎。"
msgstr ""

#. Occurrence 9_3:242:13224: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0001; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:242
msgctxt "text_id=13224 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_3:247:13225: scene=9_3
#: 9_3:247
msgctxt "text_id=13225 | speaker=unknown"
msgid "　振り向いて、驚きのあまり言葉を失った。"
msgstr ""

#. Occurrence 9_3:289:13226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0002; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:289
msgctxt "text_id=13226 | speaker=aoko"
msgid "「？　私たち、お言葉に甘えて出かけてくるけど……どうしたのよ、一体。<棚|たな>の後ろに落とし物でもしたの？」"
msgstr ""

#. Occurrence 9_3:295:13227: scene=9_3
#: 9_3:295
msgctxt "text_id=13227 | speaker=unknown"
msgid "　固まっている草十郎を青子は不思議そうに見る。"
msgstr ""

#. Occurrence 9_3:305:13228: scene=9_3
#: 9_3:305
msgctxt "text_id=13228 | speaker=unknown"
msgid "　その挙動不審さに有珠もうんうん、と無言で同意した。"
msgstr ""

#. Occurrence 9_3:310:13229: scene=9_3
#: 9_3:310
msgctxt "text_id=13229 | speaker=unknown"
msgid "　……実際、頷いてはいなかったが。"
msgstr ""

#. Occurrence 9_3:349:13230: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0002; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:349
msgctxt "text_id=13230 | speaker=soujuurou"
msgid "「―――いや。"
msgstr ""

#. Occurrence 9_3:371:13231: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0003; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:371
msgctxt "text_id=13231 | speaker=soujuurou"
msgid "　なんか、"
msgstr ""

msgctxt "text_id=13232 | speaker=unknown"
msgid "こう」"
msgstr ""

#. Occurrence 9_3:411:13233: scene=9_3
#: 9_3:411
msgctxt "text_id=13233 | speaker=unknown"
msgid "　すごく驚いたんだ、と続くところを、草十郎は喉を絞めて押し伏せた。"
msgstr ""

#. Occurrence 9_3:416:13234: scene=9_3
#: 9_3:416
msgctxt "text_id=13234 | speaker=unknown"
msgid "　その驚きが感動に由来するものである事を、彼はまだ知り得なかったからである。"
msgstr ""

#. Occurrence 9_3:449:13235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0003; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:449
msgctxt "text_id=13235 | speaker=aoko"
msgid "「それじゃ分からないってば。"
msgstr ""

#. Occurrence 9_3:460:13236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0004; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:460
msgctxt "text_id=13236 | speaker=aoko"
msgid "　まったく、落ち着いてるクセに妙に挙動不審なんだから。有珠に<煙|けむ>たがられても仕方ないって言うか―――」"
msgstr ""

#. Occurrence 9_3:485:13237: scene=9_3
#: 9_3:485
msgctxt "text_id=13237 | speaker=unknown"
msgid "　有珠は無言で観察している。"
msgstr ""

#. Occurrence 9_3:490:13238: scene=9_3
#: 9_3:490
msgctxt "text_id=13238 | speaker=unknown"
msgid "　あわてるのでもなく、ぼんやりするのでもなく、こんな風に固まる草十郎を見るのは初めてだったからだ。"
msgstr ""

#. Occurrence 9_3:526:13239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0005; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:526
msgctxt "text_id=13239 | speaker=aoko"
msgid "「それで、何かあったの？」"
msgstr ""

#. Occurrence 9_3:543:13240: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0004; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:543
msgctxt "text_id=13240 | speaker=soujuurou"
msgid "「ああ、いや―――これなんだけど。"
msgstr ""

#. Occurrence 9_3:549:13241: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0005; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:549
msgctxt "text_id=13241 | speaker=soujuurou"
msgid "　蒼崎、ビデオってどう使うんだ？」"
msgstr ""

#. Occurrence 9_3:554:13242: scene=9_3
#: 9_3:554
msgctxt "text_id=13242 | speaker=unknown"
msgid "　動揺が顔に出ないよう気を取り直し、草十郎はビデオデッキを指さした。"
msgstr ""

#. Occurrence 9_3:559:13243: scene=9_3
#: 9_3:559
msgctxt "text_id=13243 | speaker=unknown"
msgid "　テレビの下にはＶＨＳ型のビデオデッキが置かれている。"
msgstr ""

#. Occurrence 9_3:592:13244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0006; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:592
msgctxt "text_id=13244 | speaker=aoko"
msgid "「なに、タイマー録画でもするの？」"
msgstr ""

#. Occurrence 9_3:598:13245: scene=9_3
#: 9_3:598
msgctxt "text_id=13245 | speaker=unknown"
msgid "　青子はテレビの前でしゃがんでいる草十郎のとなりへ歩いていく。"
msgstr ""

#. Occurrence 9_3:631:13246: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0006; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:631
msgctxt "text_id=13246 | speaker=soujuurou"
msgid "「いや、木乃美からビデオを借りたんだけど、映らない」"
msgstr ""

#. Occurrence 9_3:643:13247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0007; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:643
msgctxt "text_id=13247 | speaker=aoko"
msgid "「……まず、テレビの電源が入ってない」"
msgstr ""

#. Occurrence 9_3:714:13248: scene=9_3
#: 9_3:714
msgctxt "text_id=13248 | speaker=unknown"
msgid "　ぱちり、と音を立ててブラウン管に光がともる。"
msgstr ""

#. Occurrence 9_3:742:13249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0008; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:742
msgctxt "text_id=13249 | speaker=aoko"
msgid "「次、チャンネルを外線に合わせて……"
msgstr ""

#. Occurrence 9_3:764:13250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0009; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:764
msgctxt "text_id=13250 | speaker=aoko"
msgid "　あら、意外にも真っ黒。木乃美くんの事だからテープ頭から録画してると思ったけど」"
msgstr ""

#. Occurrence 9_3:781:13251: scene=9_3
#: 9_3:781
msgctxt "text_id=13251 | speaker=unknown"
msgid "　この時代、ビデオテープはそれなりに高価である。"
msgstr ""

#. Occurrence 9_3:786:13252: scene=9_3
#: 9_3:786
msgctxt "text_id=13252 | speaker=unknown"
msgid "　120分の記録容量をフルに使うため、せっかちな人間なら一秒も無駄にしたがらないのが常だった。"
msgstr ""

#. Occurrence 9_3:819:13253: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0010; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:819
msgctxt "text_id=13253 | speaker=aoko"
msgid "「わりと趣味には気を遣う性格なのね。じゃ、早送りっと」"
msgstr ""

#. Occurrence 9_3:837:13254: scene=9_3
#: 9_3:837
msgctxt "text_id=13254 | speaker=unknown"
msgid "　小さなリモコンを手にとって、青子はささっと早送りボタンを押す。"
msgstr ""

#. Occurrence 9_3:855:13255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0011; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:855
msgctxt "text_id=13255 | speaker=aoko"
msgid "「ん？」"
msgstr ""

#. Occurrence 9_3:867:13256: scene=9_3
#: 9_3:867
msgctxt "text_id=13256 | speaker=unknown"
msgid "　ビデオデッキからの反応はない。"
msgstr ""

#. Occurrence 9_3:872:13257: scene=9_3
#: 9_3:872
msgctxt "text_id=13257 | speaker=unknown"
msgid "　ガチャンガチャン、と内部でモーターの空回る音がする。"
msgstr ""

#. Occurrence 9_3:904:13258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0007; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:904
msgctxt "text_id=13258 | speaker=soujuurou"
msgid "「……壊してないぞ、たぶん」"
msgstr ""

#. Occurrence 9_3:909:13259: scene=9_3
#: 9_3:909
msgctxt "text_id=13259 | speaker=unknown"
msgid "　そういう事を言う人間の多くが電気機器を破壊する特殊技能を有しているのだが、それは置いておいて。"
msgstr ""

#. Occurrence 9_3:943:13260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0012; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:943
msgctxt "text_id=13260 | speaker=aoko"
msgid "「……おまけに、テープが入ってない」"
msgstr ""

#. Occurrence 9_3:948:13261: scene=9_3
#: 9_3:948
msgctxt "text_id=13261 | speaker=unknown"
msgid "　青子はトドメとばかりに言い捨てた。"
msgstr ""

#. Occurrence 9_3:968:13262: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0008; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:968
msgctxt "text_id=13262 | speaker=soujuurou"
msgid "「テープ？」"
msgstr ""

#. Occurrence 9_3:973:13263: scene=9_3
#: 9_3:973
msgctxt "text_id=13263 | speaker=unknown"
msgid "　両面か？　などとベタな思案をする草十郎。"
msgstr ""

#. Occurrence 9_3:1006:13264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0013; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1006
msgctxt "text_id=13264 | speaker=aoko"
msgid "「草十郎。木乃美くんから、何か渡されなかった？」"
msgstr ""

#. Occurrence 9_3:1023:13265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0009; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1023
msgctxt "text_id=13265 | speaker=soujuurou"
msgid "「渡されたけど。ほら、テーブルの上」"
msgstr ""

#. Occurrence 9_3:1041:13266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0014; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1041
msgctxt "text_id=13266 | speaker=aoko"
msgid "「……………………」"
msgstr ""

#. Occurrence 9_3:1046:13267: scene=9_3
#: 9_3:1046
msgctxt "text_id=13267 | speaker=unknown"
msgid "　慣れたとはいえ、時々こいつわざとやってるんじゃないのか、と疑うほどのボケっぷりだった。"
msgstr ""

#. Occurrence 9_3:1082:13268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0015; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1082
msgctxt "text_id=13268 | speaker=aoko"
msgid "「木乃美くんがなんて言ったか、覚えてる？」"
msgstr ""

#. Occurrence 9_3:1099:13269: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0010; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1099
msgctxt "text_id=13269 | speaker=soujuurou"
msgid "「テープ貸してやるから、家に帰ったらビデオを見ろ、と……」"
msgstr ""

#. Occurrence 9_3:1127:13270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0016; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1127
msgctxt "text_id=13270 | speaker=aoko"
msgid "「一番大事な言葉が抜けてたワケね。"
msgstr ""

#. Occurrence 9_3:1140:13271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0017; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1140
msgctxt "text_id=13271 | speaker=aoko"
msgid "　……はあ。失望を通り越して怖くなるわ。あっさり順応しているように見えてこれだものね。どんだけ<綱渡|つなわた>りな毎日送ってんのよ、アンタは」"
msgstr ""

#. Occurrence 9_3:1184:13272: scene=9_3
#: 9_3:1184
msgctxt "text_id=13272 | speaker=unknown"
msgid "　ちょっと疲れて、青子は問題のテープを手に取った。"
msgstr ""

#. Occurrence 9_3:1189:13273: scene=9_3
#: 9_3:1189
msgctxt "text_id=13273 | speaker=unknown"
msgid "　ラベルにはサインペンで『GAKUGAKU動物ランド暗黒大陸編』と書かれている。"
msgstr ""

#. Occurrence 9_3:1227:13274: scene=9_3
#: 9_3:1227
msgctxt "text_id=13274 | speaker=unknown"
msgid "　……生徒会における木乃美芳助の評価レベルをひとつ下げる青子だった。"
msgstr ""

#. Occurrence 9_3:1261:13275: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0018; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1261
msgctxt "text_id=13275 | speaker=aoko"
msgid "「……で、このテープをデッキに入れて、再生すればいいの。ツメは折ってないから、録画ボタンだけは押さないようにね」"
msgstr ""

#. Occurrence 9_3:1267:13276: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0011; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1267
msgctxt "text_id=13276 | speaker=soujuurou"
msgid "「ツメとは？」"
msgstr ""

#. Occurrence 9_3:1288:13277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0019; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1288
msgctxt "text_id=13277 | speaker=aoko"
msgid "「ここ。テープの側面にへこみがあるでしょ。これをカバーしているのがツメ。"
msgstr ""

#. Occurrence 9_3:1295:13278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0020; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1295
msgctxt "text_id=13278 | speaker=aoko"
msgid "これを切り取っておくと、もうそのテープは上書き録画できなくなるのよ。"
msgstr ""

#. Occurrence 9_3:1301:13279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0021; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1301
msgctxt "text_id=13279 | speaker=aoko"
msgid "　えーと……そうね、喩えるなら授業のノート。"
msgstr ""

#. Occurrence 9_3:1307:13280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0022; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1307
msgctxt "text_id=13280 | speaker=aoko"
msgid "　大事なものだから、消しゴムで消えないようにフィキサチーフをかけたっていうか。ヒューマンエラーを物理的に防止する、<力技|アナログ>な防御法ってワケ」"
msgstr ""

#. Occurrence 9_3:1328:13281: scene=9_3
#: 9_3:1328
msgctxt "text_id=13281 | speaker=unknown"
msgid "　デッキにビデオを入れ、草十郎にリモコンを手渡す。"
msgstr ""

#. Occurrence 9_3:1345:13282: scene=9_3
#: 9_3:1345
msgctxt "text_id=13282 | speaker=unknown"
msgid "　たったこれだけの事でひどく精神力を消耗してしまった。"
msgstr ""

#. Occurrence 9_3:1364:13283: scene=9_3
#: 9_3:1364
msgctxt "text_id=13283 | speaker=unknown"
msgid "　そんな青子の気苦労も知らず、ピッと再生ボタンを押して喜ぶ草十郎。"
msgstr ""

#. Occurrence 9_3:1397:13284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0023; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1397
msgctxt "text_id=13284 | speaker=aoko"
msgid "「……はあ。前から危なっかしいと思ってたけど、まさかここまでとはね。時代錯誤にも程がある。"
msgstr ""

#. Occurrence 9_3:1413:13285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0024; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1413
msgctxt "text_id=13285 | speaker=aoko"
msgid "　アンタ、山で何やってたの？　空手家じゃあるまいし、熊を倒す修業でもしてた、とか言わないでしょうね？」"
msgstr ""

#. Occurrence 9_3:1430:13286: scene=9_3
#: 9_3:1430
msgctxt "text_id=13286 | speaker=unknown"
msgid "　さすがにこれは嫌味だと分かったのか、草十郎は批難の目を青子に向けた。"
msgstr ""

#. Occurrence 9_3:1456:13287: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0012; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1456
msgctxt "text_id=13287 | speaker=soujuurou"
msgid "「それは、もしかして俺を馬鹿にしてるのか？」"
msgstr ""

#. Occurrence 9_3:1462:13288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0025; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1462
msgctxt "text_id=13288 | speaker=aoko"
msgid "「心外ね、事実馬鹿にしてるんだけど」"
msgstr ""

#. Occurrence 9_3:1473:13289: scene=9_3
#: 9_3:1473
msgctxt "text_id=13289 | speaker=unknown"
msgid "　きっぱりと青子は答える。"
msgstr ""

#. Occurrence 9_3:1478:13290: scene=9_3
#: 9_3:1478
msgctxt "text_id=13290 | speaker=unknown"
msgid "　テレビでは問題のワニがむはぁー、とあくびをしているところだった。"
msgstr ""

#. Occurrence 9_3:1504:13291: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0013; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1504
msgctxt "text_id=13291 | speaker=soujuurou"
msgid "「そんな馬鹿な話があるもんか。なんで熊を倒すために修業しなくちゃいけないんだ？」"
msgstr ""

#. Occurrence 9_3:1514:13292: scene=9_3
#: 9_3:1514
msgctxt "text_id=13292 | speaker=unknown"
msgid "　ぷいっと顔をテレビに逸らす草十郎。"
msgstr ""

#. Occurrence 9_3:1531:13293: scene=9_3
#: 9_3:1531
msgctxt "text_id=13293 | speaker=unknown"
msgid "　彼にしては珍しく怒ったのだが、顔を背けた先で大口を開けるワニの映像と向き合い、びくっと後退したりする。"
msgstr ""

#. Occurrence 9_3:1568:13294: scene=9_3
#: 9_3:1568
msgctxt "text_id=13294 | speaker=unknown"
msgid "　そんな光景を見て、青子は嬉しげに口元を緩めた。"
msgstr ""

#. Occurrence 9_3:1573:13295: scene=9_3
#: 9_3:1573
msgctxt "text_id=13295 | speaker=unknown"
msgid "　この少年はやっぱりこうでなくてはいけない、と安心するように。"
msgstr ""

#. Occurrence 9_3:1608:13296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0014; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1608
msgctxt "text_id=13296 | speaker=soujuurou"
msgid "「けど蒼崎。この機械、ずいぶんほこりがつもっているけど、掃除はしていないのか？」"
msgstr ""

#. Occurrence 9_3:1641:13297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0026; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1641
msgctxt "text_id=13297 | speaker=aoko"
msgid "「私はあんまり使わないし、有珠は見ないから今までほっぽってただけよ。"
msgstr ""

#. Occurrence 9_3:1647:13298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0027; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1647
msgctxt "text_id=13298 | speaker=aoko"
msgid "　ダメもとでトレーニング用に買ってもらったんだけど、飽きちゃった。イメージでどうにかできる問題じゃなかったっていうか」"
msgstr ""

#. Occurrence 9_3:1679:13299: scene=9_3
#: 9_3:1679
msgctxt "text_id=13299 | speaker=unknown"
msgid "　昔の自分の浅はかさを<嗤|わら>うように、青子は両肩をすくめる。"
msgstr ""

#. Occurrence 9_3:1699:13300: scene=9_3
#: 9_3:1699
msgctxt "text_id=13300 | speaker=unknown"
msgid "　またひとつ、ビデオデッキは飽きるもの、という間違った単語を覚える草十郎である。"
msgstr ""

#. Occurrence 9_3:1735:13301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0028; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1735
msgctxt "text_id=13301 | speaker=aoko"
msgid "「それじゃ、留守番お願いね。"
msgstr ""

#. Occurrence 9_3:1741:13302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0029; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1741
msgctxt "text_id=13302 | speaker=aoko"
msgid "　バイト、ほんとは無いんでしょう？」"
msgstr ""

#. Occurrence 9_3:1762:13303: scene=9_3
#: 9_3:1762
msgctxt "text_id=13303 | speaker=unknown"
msgid "　微笑みながら言って、青子は居間から立ち去っていった。"
msgstr ""

#. Occurrence 9_3:1793:13304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0015; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1793
msgctxt "text_id=13304 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 9_3:1798:13305: scene=9_3
#: 9_3:1798
msgctxt "text_id=13305 | speaker=unknown"
msgid "　青子の笑顔に虚を突かれて、言葉につまる草十郎。"
msgstr ""

#. Occurrence 9_3:1803:13306: scene=9_3
#: 9_3:1803
msgctxt "text_id=13306 | speaker=unknown"
msgid "　やっぱり、あんな嘘が通じる相手ではなかったのだ、と頬をかく。"
msgstr ""

#. Occurrence 9_3:1836:13307: scene=9_3
#: 9_3:1836
msgctxt "text_id=13307 | speaker=unknown"
msgid "　そんなふたりのやりとりを最後まで傍観してから、有珠もロビーに向かっていった。"
msgstr ""

#. Occurrence 9_3:1871:13308: scene=9_3
#: 9_3:1871
msgctxt "text_id=13308 | speaker=unknown"
msgid "　ひとり居間に残され、さて、と草十郎はソファーに座る。"
msgstr ""

#. Occurrence 9_3:1876:13309: scene=9_3
#: 9_3:1876
msgctxt "text_id=13309 | speaker=unknown"
msgid "　……まあ。"
msgstr ""

#. Occurrence 9_3:1881:13310: scene=9_3
#: 9_3:1881
msgctxt "text_id=13310 | speaker=unknown"
msgid "　とりあえず、やりたいコトはきちんと機能したのだし。"
msgstr ""

#. Occurrence 9_3:1886:13311: scene=9_3
#: 9_3:1886
msgctxt "text_id=13311 | speaker=unknown"
msgid "　あとは彼女たちが帰ってくるまで、こうしてワニを観察していよう、と思いながら。"
msgstr ""

#. Occurrence 9_3C:89:13312: scene=9_3C
#: 9_3C:89
msgctxt "text_id=13312 | speaker=unknown"
msgid "　三咲町から地下鉄線で六駅分。"
msgstr ""

#. Occurrence 9_3C:94:13313: scene=9_3C
#: 9_3C:94
msgctxt "text_id=13313 | speaker=unknown"
msgid "　そこから更に快速で三駅分。"
msgstr ""

#. Occurrence 9_3C:100:13314: scene=9_3C
#: 9_3C:100
msgctxt "text_id=13314 | speaker=unknown"
msgid "　一時間ほどかけて、青子と有珠は<有坂|ありさか>駅に到着した。"
msgstr ""

#. Occurrence 9_3C:120:13315: scene=9_3C
#: 9_3C:120
msgctxt "text_id=13315 | speaker=unknown"
msgid "　有坂は政令指定によって一から開発された都市だ。"
msgstr ""

#. Occurrence 9_3C:125:13316: scene=9_3C
#: 9_3C:125
msgctxt "text_id=13316 | speaker=unknown"
msgid "　三咲町は古きを残し、新しきを築く方針で生まれ変わった町だが、有坂は何もなかった土地に<高層建築|ビルディング>を築き上げた街である。"
msgstr ""

#. Occurrence 9_3C:184:13317: scene=9_3C
#: 9_3C:184
msgctxt "text_id=13317 | speaker=unknown"
msgid "　十二月末、冬休みまっただ中。"
msgstr ""

#. Occurrence 9_3C:189:13318: scene=9_3C
#: 9_3C:189
msgctxt "text_id=13318 | speaker=unknown"
msgid "　午後を過ぎた有坂の街の賑わいは、三咲町とは比べものにならない。"
msgstr ""

#. Occurrence 9_3C:194:13319: scene=9_3C
#: 9_3C:194
msgctxt "text_id=13319 | speaker=unknown"
msgid "　なにしろ大型デパートや各種専門店、多目的ホールで賑わう、県内有数の近代都市だ。"
msgstr ""

#. Occurrence 9_3C:199:13320: scene=9_3C
#: 9_3C:199
msgctxt "text_id=13320 | speaker=unknown"
msgid "　その結果、有坂駅前は地元の人々より、遠方からの来訪者が集まる歓楽地になっていた。"
msgstr ""

#. Occurrence 9_3C:257:13321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0000; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:257
msgctxt "text_id=13321 | speaker=aoko"
msgid "「へえ、あれが新しい演劇ホールかあ。"
msgstr ""

#. Occurrence 9_3C:257:13322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0000; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:257
msgctxt "text_id=13322 | speaker=aoko"
msgid "　県内最大のコンサートホールらしいけど、中はどうなってんだろ。なんか周りのビルより背が高くない？」"
msgstr ""

#. Occurrence 9_3C:320:13323: scene=9_3C
#: 9_3C:320
msgctxt "text_id=13323 | speaker=unknown"
msgid "　目当ての水族館に向かう途中、多くの人々とすれ違う。"
msgstr ""

#. Occurrence 9_3C:325:13324: scene=9_3C
#: 9_3C:325
msgctxt "text_id=13324 | speaker=unknown"
msgid "　青子は雑踏に慣れたものだが、"
msgstr ""

#. Occurrence 9_3C:330:13325: scene=9_3C
#: 9_3C:330
msgctxt "text_id=13325 | speaker=unknown"
msgid "　<傍|かたわ>らの有珠は終始無言だ。"
msgstr ""

#. Occurrence 9_3C:364:13326: scene=9_3C
#: 9_3C:364
msgctxt "text_id=13326 | speaker=unknown"
msgid "　有珠自身も、有珠とすれ違う人々も、道を行く白い少女の姿に違和感を覚えている。"
msgstr ""

#. Occurrence 9_3C:431:13327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0001_0; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:431
msgctxt "text_id=13327 | speaker=aoko"
msgid "「来年夏にはビッグアーティストも来日予定……"
msgstr ""

#. Occurrence 9_3C:444:13328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0001_1; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:444
msgctxt "text_id=13328 | speaker=aoko"
msgid "って、ピンクトゥルーデが入ってない！？"
msgstr ""

msgctxt "text_id=13329 | speaker=unknown"
msgid "　ちょっと、これ日本初ライブよ有珠！？」"
msgstr ""

#. Occurrence 9_3C:457:13330: scene=9_3C
#: 9_3C:457
msgctxt "text_id=13330 | speaker=unknown"
msgid "　看板にある予定表に一喜一憂する青子。"
msgstr ""

#. Occurrence 9_3C:500:13331: scene=9_3C
#: 9_3C:500
msgctxt "text_id=13331 | speaker=unknown"
msgid "　青子的に注目株のロックバンドらしいのだが、当然、有珠はあまり関心を持っていない。"
msgstr ""

#. Occurrence 9_3C:532:13332: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0000; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:532
msgctxt "text_id=13332 | speaker=alice"
msgid "「それより、セレモニーに予定されてるポーランド楽団の方が驚きだと思うけど。"
msgstr ""

#. Occurrence 9_3C:538:13333: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0001; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:538
msgctxt "text_id=13333 | speaker=alice"
msgid "　随分とお金がかかっているようね。"
msgstr ""

#. Occurrence 9_3C:545:13334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0002; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:545
msgctxt "text_id=13334 | speaker=alice"
msgid "……本当、懲りない人」"
msgstr ""

#. Occurrence 9_3C:600:13335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0002; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:600
msgctxt "text_id=13335 | speaker=aoko"
msgid "「あ」"
msgstr ""

#. Occurrence 9_3C:610:13336: scene=9_3C
#: 9_3C:610
msgctxt "text_id=13336 | speaker=unknown"
msgid "　しまった、と口を<塞|ふさ>いで青子は足を速めた。"
msgstr ""

#. Occurrence 9_3C:655:13337: scene=9_3C
#: 9_3C:655
msgctxt "text_id=13337 | speaker=unknown"
msgid "　建設予定図の下にはお馴染みの、久遠寺財閥ゆかりの企業名があったからだ。"
msgstr ""

#. Occurrence 9_3C:721:13338: scene=9_3C
#: 9_3C:721
msgctxt "text_id=13338 | speaker=unknown"
msgid "　お目当ての水族館は、高層ビルの最上階に造られていた。"
msgstr ""

#. Occurrence 9_3C:762:13339: scene=9_3C
#: 9_3C:762
msgctxt "text_id=13339 | speaker=unknown"
msgid "　もう目新しさはないのか、"
msgstr ""

#. Occurrence 9_3C:767:13340: scene=9_3C
#: 9_3C:767
msgctxt "text_id=13340 | speaker=unknown"
msgid "　階下の映画館に客足をとられているのか。"
msgstr ""

#. Occurrence 9_3C:772:13341: scene=9_3C
#: 9_3C:772
msgctxt "text_id=13341 | speaker=unknown"
msgid "　エントランスの人影はまばらで、館内の空気は落ち着いている。"
msgstr ""

#. Occurrence 9_3C:792:13342: scene=9_3C
#: 9_3C:792
msgctxt "text_id=13342 | speaker=unknown"
msgid "　無音というほど寂しくはなく、"
msgstr ""

#. Occurrence 9_3C:797:13343: scene=9_3C
#: 9_3C:797
msgctxt "text_id=13343 | speaker=unknown"
msgid "　町中ほど騒がしくはない。"
msgstr ""

#. Occurrence 9_3C:802:13344: scene=9_3C
#: 9_3C:802
msgctxt "text_id=13344 | speaker=unknown"
msgid "　そんな美術館さながらの<趣|おもむき>が気に入ったのか。"
msgstr ""

#. Occurrence 9_3C:824:13345: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0003; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:824
msgctxt "text_id=13345 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_3C:829:13346: scene=9_3C
#: 9_3C:829
msgctxt "text_id=13346 | speaker=unknown"
msgid "　有珠は静かに、感じ入るように息を呑んでいた。"
msgstr ""

#. Occurrence 9_3C:849:13347: scene=9_3C
#: 9_3C:849
msgctxt "text_id=13347 | speaker=unknown"
msgid "　はじめてサーカスを見た子供のようだ。"
msgstr ""

#. Occurrence 9_3C:854:13348: scene=9_3C
#: 9_3C:854
msgctxt "text_id=13348 | speaker=unknown"
msgid "　驚きと期待に、知らず、目を見開かせている。"
msgstr ""

#. Occurrence 9_3C:883:13349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0003; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:883
msgctxt "text_id=13349 | speaker=aoko"
msgid "「お、気に入ったみたいね。良かった良かった。"
msgstr ""

#. Occurrence 9_3C:889:13350: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0004; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:889
msgctxt "text_id=13350 | speaker=aoko"
msgid "　草十郎お薦めの物件は、気むずかしい有珠さんのお眼鏡にかないましたか」"
msgstr ""

#. Occurrence 9_3C:895:13351: scene=9_3C
#: 9_3C:895
msgctxt "text_id=13351 | speaker=unknown"
msgid "　青子もつられて笑顔になる。"
msgstr ""

#. Occurrence 9_3C:921:13352: scene=9_3C
#: 9_3C:921
msgctxt "text_id=13352 | speaker=unknown"
msgid "　有珠の驚きはそれぐらい微笑ましいものだったのだ。"
msgstr ""

#. Occurrence 9_3C:965:13353: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0004; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:965
msgctxt "text_id=13353 | speaker=alice"
msgid "「……別に。屋上にある水族館が珍しいだけ」"
msgstr ""

#. Occurrence 9_3C:971:13354: scene=9_3C
#: 9_3C:971
msgctxt "text_id=13354 | speaker=unknown"
msgid "　水族館のエントランスは久遠寺邸のホールほどの大きさで、壁には館内の見取り図が展示されている。"
msgstr ""

#. Occurrence 9_3C:1006:13355: scene=9_3C
#: 9_3C:1006
msgctxt "text_id=13355 | speaker=unknown"
msgid "　野外のペンギンショウは休演中だった。ペンギンのペン太くんが怪我につき治療中らしい。"
msgstr ""

#. Occurrence 9_3C:1011:13356: scene=9_3C
#: 9_3C:1011
msgctxt "text_id=13356 | speaker=unknown"
msgid "　少し残念だが、有珠は気にとめず館内案内を目で追う。彼女にとってペンギンはそう珍しいものではないらしい。"
msgstr ""

#. Occurrence 9_3C:1021:13357: scene=9_3C
#: 9_3C:1021
msgctxt "text_id=13357 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence 9_3C:1072:13358: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0005; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1072
msgctxt "text_id=13358 | speaker=alice"
msgid "「―――、え」"
msgstr ""

#. Occurrence 9_3C:1078:13359: scene=9_3C
#: 9_3C:1078
msgctxt "text_id=13359 | speaker=unknown"
msgid "“そんな、嘘よ”……と。"
msgstr ""

#. Occurrence 9_3C:1083:13360: scene=9_3C
#: 9_3C:1083
msgctxt "text_id=13360 | speaker=unknown"
msgid "　有珠は悲鳴を飲みこむように喉を鳴らすのだった。"
msgstr ""

#. Occurrence 9_3C:1104:13361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0005; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1104
msgctxt "text_id=13361 | speaker=aoko"
msgid "「なになに、どうしたの？」"
msgstr ""

#. Occurrence 9_3C:1138:13362: scene=9_3C
#: 9_3C:1138
msgctxt "text_id=13362 | speaker=unknown"
msgid "　館内案内を見る青子。"
msgstr ""

#. Occurrence 9_3C:1143:13363: scene=9_3C
#: 9_3C:1143
msgctxt "text_id=13363 | speaker=unknown"
msgid "　屋敷内ではたまに見られるが、外で有珠が取り乱すのはまずあり得ない。"
msgstr ""

#. Occurrence 9_3C:1148:13364: scene=9_3C
#: 9_3C:1148
msgctxt "text_id=13364 | speaker=unknown"
msgid "　一体なにが有珠を<戦|おのの>かせたのか。"
msgstr ""

#. Occurrence 9_3C:1153:13365: scene=9_3C
#: 9_3C:1153
msgctxt "text_id=13365 | speaker=unknown"
msgid "　案内にはこれといって珍しい部分はないが……"
msgstr ""

#. Occurrence 9_3C:1193:13366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0006; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1193
msgctxt "text_id=13366 | speaker=alice"
msgid "「ゾウガメがいない」"
msgstr ""

#. Occurrence 9_3C:1229:13367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0006; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1229
msgctxt "text_id=13367 | speaker=aoko"
msgid "「え？」"
msgstr ""

#. Occurrence 9_3C:1240:13368: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0007; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1240
msgctxt "text_id=13368 | speaker=alice"
msgid "「話が違うわ青子。"
msgstr ""

#. Occurrence 9_3C:1240:13369: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0007; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1240
msgctxt "text_id=13369 | speaker=alice"
msgid "　どうしてゾウガメの展示スペースがないの？」"
msgstr ""

#. Occurrence 9_3C:1280:13370: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0007; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1280
msgctxt "text_id=13370 | speaker=aoko"
msgid "「どうしてって……そりゃあ、ゾウガメぐらいになったらもうほとんど陸上生物だからじゃない？　大きいし」"
msgstr ""

#. Occurrence 9_3C:1298:13371: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0008; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1298
msgctxt "text_id=13371 | speaker=alice"
msgid "「なんで。ペンギンはいるのに、不公平よ。"
msgstr ""

#. Occurrence 9_3C:1305:13372: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0009; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1305
msgctxt "text_id=13372 | speaker=alice"
msgid "イルカだって許せないわ」"
msgstr ""

#. Occurrence 9_3C:1311:13373: scene=9_3C
#: 9_3C:1311
msgctxt "text_id=13373 | speaker=unknown"
msgid "　なんだかぜんぜん納得できない。"
msgstr ""

#. Occurrence 9_3C:1316:13374: scene=9_3C
#: 9_3C:1316
msgctxt "text_id=13374 | speaker=unknown"
msgid "　ゾウガメが不在ならイルカだって不在であるべきだ、と妙な公正さからメラメラ瞳を燃やす有珠だった。"
msgstr ""

#. Occurrence 9_3C:1352:13375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0008; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1352
msgctxt "text_id=13375 | speaker=aoko"
msgid "「あー……言われてみれば、確かに。"
msgstr ""

#. Occurrence 9_3C:1358:13376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0009; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1358
msgctxt "text_id=13376 | speaker=aoko"
msgid "　ペンギンとイルカは定番なのに、なぜゾウガメだけ外されるのか。ちょっとした日常の落とし穴ね」"
msgstr ""

#. Occurrence 9_3C:1364:13377: scene=9_3C
#: 9_3C:1364
msgctxt "text_id=13377 | speaker=unknown"
msgid "　ま、単に不人気だからだろうけど。"
msgstr ""

#. Occurrence 9_3C:1369:13378: scene=9_3C
#: 9_3C:1369
msgctxt "text_id=13378 | speaker=unknown"
msgid "　そんな感想を心の中だけに留める青子。彼女なりに空気を読んだ結果である。"
msgstr ""

#. Occurrence 9_3C:1413:13379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0010; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1413
msgctxt "text_id=13379 | speaker=aoko"
msgid "「有珠、こっち。チケットはあるから、<販売機|そっち>に並ぶことはないわよ」"
msgstr ""

#. Occurrence 9_3C:1436:13380: scene=9_3C
#: 9_3C:1436
msgctxt "text_id=13380 | speaker=unknown"
msgid "　ゾウガメ論争から一分後。"
msgstr ""

#. Occurrence 9_3C:1441:13381: scene=9_3C
#: 9_3C:1441
msgctxt "text_id=13381 | speaker=unknown"
msgid "　草十郎から貰ったチケットを受付に渡して、<人気|ひとけ>の途絶えた入り口に向かう。"
msgstr ""

#. Occurrence 9_3C:1446:13382: scene=9_3C
#: 9_3C:1446
msgctxt "text_id=13382 | speaker=unknown"
msgid "　青一色で染められたエントランスとは対照的に、ゲートから延びる通路は暗く細長い。"
msgstr ""

#. Occurrence 9_3C:1489:13383: scene=9_3C
#: 9_3C:1489
msgctxt "text_id=13383 | speaker=unknown"
msgid "　ここから先は隣人の顔も見えない密閉空間。"
msgstr ""

#. Occurrence 9_3C:1494:13384: scene=9_3C
#: 9_3C:1494
msgctxt "text_id=13384 | speaker=unknown"
msgid "　魔術の手でもなく魔法の手でもない、文明の手によって現実と切り離された小宇宙だ。"
msgstr ""

#. Occurrence 9_3C:1556:13385: scene=9_3C
#: 9_3C:1556
msgctxt "text_id=13385 | speaker=unknown"
msgid "　水槽だけがライトアップされた、影と水色の世界。"
msgstr ""

#. Occurrence 9_3C:1561:13386: scene=9_3C
#: 9_3C:1561
msgctxt "text_id=13386 | speaker=unknown"
msgid "　ガラス一枚<隔|へだ>てた人工の海を眺めながら、ふたりの魔女は歩を進ませる。"
msgstr ""

#. Occurrence 9_3C:1581:13387: scene=9_3C
#: 9_3C:1581
msgctxt "text_id=13387 | speaker=unknown"
msgid "　百の<異世界|コロニー>を<航|わた>る旅。"
msgstr ""

#. Occurrence 9_3C:1587:13388: scene=9_3C
#: 9_3C:1587
msgctxt "text_id=13388 | speaker=unknown"
msgid "　それぞれ温度も環境も違う水槽たち。"
msgstr ""

#. Occurrence 9_3C:1592:13389: scene=9_3C
#: 9_3C:1592
msgctxt "text_id=13389 | speaker=unknown"
msgid "　ひとつひとつが同じようで別の時間。"
msgstr ""

#. Occurrence 9_3C:1597:13390: scene=9_3C
#: 9_3C:1597
msgctxt "text_id=13390 | speaker=unknown"
msgid "　光の屈折する<水底|みなそこ>では方角は不確かで、彼女たちの会話でさえ、断片的に消えていく。"
msgstr ""

#. Occurrence 9_3C:1647:13391: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0011; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1647
msgctxt "text_id=13391 | speaker=aoko"
msgid "「そういえば、有珠の家ってあれだけ大きいのにプールとかないわよね。なんで？」"
msgstr ""

#. Occurrence 9_3C:1671:13392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0010; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1671
msgctxt "text_id=13392 | speaker=alice"
msgid "「……呆れた。水槽を観て何を想像したのかは聞かないけど。"
msgstr ""

#. Occurrence 9_3C:1677:13393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0011; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1677
msgctxt "text_id=13393 | speaker=alice"
msgid "　必要ないものを欲しがるのは貴女の悪い癖ね、青子」"
msgstr ""

#. Occurrence 9_3C:1701:13394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0012; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1701
msgctxt "text_id=13394 | speaker=aoko"
msgid "「えー、必要ないってコトはないんじゃない？　水遊びは<日|こ><本|っち>より<英国|そっち>の方が馴染み深いでしょうに。"
msgstr ""

#. Occurrence 9_3C:1707:13395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0013; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1707
msgctxt "text_id=13395 | speaker=aoko"
msgid "　あ。もしかして有珠、泳げない？」"
msgstr ""

#. Occurrence 9_3C:1746:13396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0012; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1746
msgctxt "text_id=13396 | speaker=alice"
msgid "「泳ぎの経験ぐらいあるわ。夏は湖で何度も遊んだもの。"
msgstr ""

#. Occurrence 9_3C:1753:13397: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0013; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1753
msgctxt "text_id=13397 | speaker=alice"
msgid "わたし、大型のセントバーナードにだって負けなかったのよ」"
msgstr ""

#. Occurrence 9_3C:1777:13398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0014; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1777
msgctxt "text_id=13398 | speaker=aoko"
msgid "「セントバーナードって……有珠さんったら、もしかして<息|いき><継|つ>ぎとか苦手かしら？」"
msgstr ""

#. Occurrence 9_3C:1796:13399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0014; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1796
msgctxt "text_id=13399 | speaker=alice"
msgid "「この世でもっとも聞きたくない言葉のひとつね。"
msgstr ""

#. Occurrence 9_3C:1802:13400: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0015; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1802
msgctxt "text_id=13400 | speaker=alice"
msgid "　クロールとかバタフライとか、発明した人は半魚人になればいいのに」"
msgstr ""

#. Occurrence 9_3C:1839:13401: scene=9_3C
#: 9_3C:1839
msgctxt "text_id=13401 | speaker=unknown"
msgid "　かつ、かつ、かつ。"
msgstr ""

#. Occurrence 9_3C:1845:13402: scene=9_3C
#: 9_3C:1845
msgctxt "text_id=13402 | speaker=unknown"
msgid "　海を巡る足取りは、普段のものよりおごそかに、繊細に。"
msgstr ""

#. Occurrence 9_3C:1850:13403: scene=9_3C
#: 9_3C:1850
msgctxt "text_id=13403 | speaker=unknown"
msgid "　少女たちの会話はうわのそら。"
msgstr ""

#. Occurrence 9_3C:1855:13404: scene=9_3C
#: 9_3C:1855
msgctxt "text_id=13404 | speaker=unknown"
msgid "　ここでは、視線は青いスクリーンにのみ向けられるので。"
msgstr ""

#. Occurrence 9_3C:1885:13405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0015; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1885
msgctxt "text_id=13405 | speaker=aoko"
msgid "「でも驚いた。あんなにあっさり館の留守を任せるなんて。アイツがこっそり西館に入るかも、とか考えなかった？」"
msgstr ""

#. Occurrence 9_3C:1891:13406: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0016; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1891
msgctxt "text_id=13406 | speaker=alice"
msgid "「……彼、そこまで考えなしじゃないでしょう。"
msgstr ""

#. Occurrence 9_3C:1897:13407: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0017; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1897
msgctxt "text_id=13407 | speaker=alice"
msgid "　それに―――」"
msgstr ""

#. Occurrence 9_3C:1915:13408: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0016; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1915
msgctxt "text_id=13408 | speaker=aoko"
msgid "「それに、それならそれで手間が省けてせいせいした？」"
msgstr ""

#. Occurrence 9_3C:1940:13409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0018; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1940
msgctxt "text_id=13409 | speaker=alice"
msgid "「……そうじゃなくて。"
msgstr ""

#. Occurrence 9_3C:1960:13410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0019; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1960
msgctxt "text_id=13410 | speaker=alice"
msgid "　一度交わした約束は、破らないんじゃないかって」"
msgstr ""

#. Occurrence 9_3C:1997:13411: scene=9_3C
#: 9_3C:1997
msgctxt "text_id=13411 | speaker=unknown"
msgid "　なるほど、そういうコトもあるだろう。"
msgstr ""

#. Occurrence 9_3C:2002:13412: scene=9_3C
#: 9_3C:2002
msgctxt "text_id=13412 | speaker=unknown"
msgid "　長い髪の少女は感心したように頷いた。"
msgstr ""

#. Occurrence 9_3C:2007:13413: scene=9_3C
#: 9_3C:2007
msgctxt "text_id=13413 | speaker=unknown"
msgid "　ちょっとだけ目が開いたところを見ると、驚きも何割か。"
msgstr ""

#. Occurrence 9_3C:2013:13414: scene=9_3C
#: 9_3C:2013
msgctxt "text_id=13414 | speaker=unknown"
msgid "　少女たちは次の世界にふわふわと。"
msgstr ""

#. Occurrence 9_3C:2019:13415: scene=9_3C
#: 9_3C:2019
msgctxt "text_id=13415 | speaker=unknown"
msgid "　かつ、かつ、かつ。"
msgstr ""

#. Occurrence 9_3C:2055:13416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0017; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2055
msgctxt "text_id=13416 | speaker=aoko"
msgid "「ところで、水族館は初めて？」"
msgstr ""

#. Occurrence 9_3C:2061:13417: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0020; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2061
msgctxt "text_id=13417 | speaker=alice"
msgid "「これで二度目。昔、友達とふたりで行ったきりよ」"
msgstr ""

#. Occurrence 9_3C:2085:13418: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0018; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2085
msgctxt "text_id=13418 | speaker=aoko"
msgid "「うそ、ほんと？」"
msgstr ""

#. Occurrence 9_3C:2109:13419: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0021; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2109
msgctxt "text_id=13419 | speaker=alice"
msgid "「本当。六年以上も前。まだイギリスにいた頃」"
msgstr ""

#. Occurrence 9_3C:2115:13420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0019; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2115
msgctxt "text_id=13420 | speaker=aoko"
msgid "「そうじゃなくて友達の方。アンタ、友人はいないって言ったじゃない」"
msgstr ""

#. Occurrence 9_3C:2154:13421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0022; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2154
msgctxt "text_id=13421 | speaker=alice"
msgid "「……昔の話よ。わたしたち、同じ名前だったの。"
msgstr ""

#. Occurrence 9_3C:2160:13422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0023; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2160
msgctxt "text_id=13422 | speaker=alice"
msgid "　それが縁でよく遊んでいたけれど、長続きはしなかったわ」"
msgstr ""

#. Occurrence 9_3C:2184:13423: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0020; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2184
msgctxt "text_id=13423 | speaker=aoko"
msgid "「そっか、あっちじゃそう珍しくない名前なのね、アリスって。こっちでいうところの良子とか、花子みたいなもの？」"
msgstr ""

#. Occurrence 9_3C:2203:13424: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0024; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2203
msgctxt "text_id=13424 | speaker=alice"
msgid "「ええ。<青子|あおこ>とか<赤子|あかこ>とか、<黒子|くろこ>とか<白子|しらこ>みたいなものよ」"
msgstr ""

#. Occurrence 9_3C:2221:13425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0021; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2221
msgctxt "text_id=13425 | speaker=aoko"
msgid "「……後半はみんな普通名詞なんですけど」"
msgstr ""

#. Occurrence 9_3C:2258:13426: scene=9_3C
#: 9_3C:2258
msgctxt "text_id=13426 | speaker=unknown"
msgid "　ひとつひとつに名前があるのが彼らの社会。"
msgstr ""

#. Occurrence 9_3C:2263:13427: scene=9_3C
#: 9_3C:2263
msgctxt "text_id=13427 | speaker=unknown"
msgid "　水の中もくるくると目まぐるしいけれど、"
msgstr ""

#. Occurrence 9_3C:2268:13428: scene=9_3C
#: 9_3C:2268
msgctxt "text_id=13428 | speaker=unknown"
msgid "　人間も人間で、いろいろどうでも忙しいよう。"
msgstr ""

#. Occurrence 9_3C:2274:13429: scene=9_3C
#: 9_3C:2274
msgctxt "text_id=13429 | speaker=unknown"
msgid "　少女たちは手を振りながら、次の世界にかつ、かつと。"
msgstr ""

#. Occurrence 9_3C:2304:13430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0025; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2304
msgctxt "text_id=13430 | speaker=alice"
msgid "「そう言う青子は、彼をどうするつもりなの？」"
msgstr ""

#. Occurrence 9_3C:2322:13431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0022; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2322
msgctxt "text_id=13431 | speaker=aoko"
msgid "「どうって、今の一件を終わらせるまで大人しくしてもらって、落ち着いたら忘却のルーン探して、なかった事にするだけでしょ？　これ以上迷惑かけられないわよ」"
msgstr ""

#. Occurrence 9_3C:2328:13432: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0026; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2328
msgctxt "text_id=13432 | speaker=alice"
msgid "「……それは、わたしに？」"
msgstr ""

#. Occurrence 9_3C:2362:13433: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0023_0; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2362
msgctxt "text_id=13433 | speaker=aoko"
msgid "「へ……？　―――あ、うん、そう。そうに決まってるじゃない。"
msgstr ""

#. Occurrence 9_3C:2381:13434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0023_1; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2381
msgctxt "text_id=13434 | speaker=aoko"
msgid "ところでこの魚、キレイよね。なんか泳ぎたくなってくる。有珠、来年の夏は海にでも行ってみよっか？」"
msgstr ""

#. Occurrence 9_3C:2421:13435: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0027; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2421
msgctxt "text_id=13435 | speaker=alice"
msgid "「海って……あの、海？」"
msgstr ""

#. Occurrence 9_3C:2445:13436: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0024; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2445
msgctxt "text_id=13436 | speaker=aoko"
msgid "「もちろん。夏の海っていったら灼熱の太陽と砂浜、水平線に沈む夕日ってね。"
msgstr ""

#. Occurrence 9_3C:2451:13437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0025; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2451
msgctxt "text_id=13437 | speaker=aoko"
msgid "　今年は行けなかったけど、来年は一緒に行かない？」"
msgstr ""

#. Occurrence 9_3C:2470:13438: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0028; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2470
msgctxt "text_id=13438 | speaker=alice"
msgid "「呆れた。本当、貴女って楽観的。"
msgstr ""

#. Occurrence 9_3C:2476:13439: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0029; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2476
msgctxt "text_id=13439 | speaker=alice"
msgid "　……でも、そうね。夏まで生きていられたのなら、そういう事もあるかもしれない」"
msgstr ""

#. Occurrence 9_3C:2513:13440: scene=9_3C
#: 9_3C:2513
msgctxt "text_id=13440 | speaker=unknown"
msgid "　かつ、かつ、かつ。"
msgstr ""

#. Occurrence 9_3C:2519:13441: scene=9_3C
#: 9_3C:2519
msgctxt "text_id=13441 | speaker=unknown"
msgid "　人間の少女たちは次の水場に跳んでいく。"
msgstr ""

#. Occurrence 9_3C:2524:13442: scene=9_3C
#: 9_3C:2524
msgctxt "text_id=13442 | speaker=unknown"
msgid "　眺めていたのはお互いさま。"
msgstr ""

#. Occurrence 9_3C:2529:13443: scene=9_3C
#: 9_3C:2529
msgctxt "text_id=13443 | speaker=unknown"
msgid "　冬の海に訪れた客人は、涼しい顔で消えていった。"
msgstr ""

#. Occurrence 9_3C:2535:13444: scene=9_3C
#: 9_3C:2535
msgctxt "text_id=13444 | speaker=unknown"
msgid "　それではさよなら、かつ、かつ、ばたん。"
msgstr ""

#. Occurrence 9_3C:2624:13445: scene=9_3C
#: 9_3C:2624
msgctxt "text_id=13445 | speaker=unknown"
msgid "　……徒歩による航海は一時間に及んだ。"
msgstr ""

#. Occurrence 9_3C:2641:13446: scene=9_3C
#: 9_3C:2641
msgctxt "text_id=13446 | speaker=unknown"
msgid "　展示物の多さもさることながら、入り組んだ通路は迷路のようで、気付かないうちに一フロア上の階層にあがっていたりもした。"
msgstr ""

#. Occurrence 9_3C:2646:13447: scene=9_3C
#: 9_3C:2646
msgctxt "text_id=13447 | speaker=unknown"
msgid "　最上階と聞いていた事もあり、青子も二層構造と気付いた時は感心したものだ。"
msgstr ""

#. Occurrence 9_3C:2690:13448: scene=9_3C
#: 9_3C:2690
msgctxt "text_id=13448 | speaker=unknown"
msgid "　おそらく、本当の最上階には水族館からしか行けない作りになっているのだろう。"
msgstr ""

#. Occurrence 9_3C:2695:13449: scene=9_3C
#: 9_3C:2695
msgctxt "text_id=13449 | speaker=unknown"
msgid "　どのようなアトラクションであれ、サプライズはあるに越したことはない。"
msgstr ""

#. Occurrence 9_3C:2736:13450: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0026; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2736
msgctxt "text_id=13450 | speaker=aoko"
msgid "「有珠？」"
msgstr ""

#. Occurrence 9_3C:2763:13451: scene=9_3C
#: 9_3C:2763
msgctxt "text_id=13451 | speaker=unknown"
msgid "　ふと振り返ると有珠の姿がない。"
msgstr ""

#. Occurrence 9_3C:2768:13452: scene=9_3C
#: 9_3C:2768
msgctxt "text_id=13452 | speaker=unknown"
msgid "　さっきまで一緒にいたのに、と同居人の姿を探す。"
msgstr ""

#. Occurrence 9_3C:2791:13453: scene=9_3C
#: 9_3C:2791
msgctxt "text_id=13453 | speaker=unknown"
msgid "　探し人はすぐに見つかった。"
msgstr ""

#. Occurrence 9_3C:2796:13454: scene=9_3C
#: 9_3C:2796
msgctxt "text_id=13454 | speaker=unknown"
msgid "　闇に映える白い<外套|コート>が、ライトアップされた水槽の前に佇んでいる。"
msgstr ""

#. Occurrence 9_3C:2836:13455: scene=9_3C
#: 9_3C:2836
msgctxt "text_id=13455 | speaker=unknown"
msgid "　少女はじっと青い水槽を見つめていた。"
msgstr ""

#. Occurrence 9_3C:2841:13456: scene=9_3C
#: 9_3C:2841
msgctxt "text_id=13456 | speaker=unknown"
msgid "　散漫と、ありきたりな風景を見つめるように。"
msgstr ""

#. Occurrence 9_3C:2862:13457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0027; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2862
msgctxt "text_id=13457 | speaker=aoko"
msgid "「どうしたの有珠？　気分でも悪くなった？」"
msgstr ""

#. Occurrence 9_3C:2868:13458: scene=9_3C
#: 9_3C:2868
msgctxt "text_id=13458 | speaker=unknown"
msgid "　微妙な様子の変化を感じて声をかける。"
msgstr ""

#. Occurrence 9_3C:2873:13459: scene=9_3C
#: 9_3C:2873
msgctxt "text_id=13459 | speaker=unknown"
msgid "　有珠の体にある、いつもの張りつめた空気がなくなっている気がしたからだ。"
msgstr ""

#. Occurrence 9_3C:2940:13460: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0028; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2940
msgctxt "text_id=13460 | speaker=aoko"
msgid "「珍しい魚でもいた？　それ、余り物を端においやりましたって感じの水槽だけど」"
msgstr ""

#. Occurrence 9_3C:2946:13461: scene=9_3C
#: 9_3C:2946
msgctxt "text_id=13461 | speaker=unknown"
msgid "　有珠はそうね、とだけ返答した。"
msgstr ""

#. Occurrence 9_3C:2951:13462: scene=9_3C
#: 9_3C:2951
msgctxt "text_id=13462 | speaker=unknown"
msgid "　少女の視線の先にあるのはひとつの影。"
msgstr ""

#. Occurrence 9_3C:3011:13463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0029; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3011
msgctxt "text_id=13463 | speaker=aoko"
msgid "「ワォ、マンボウ」"
msgstr ""

#. Occurrence 9_3C:3017:13464: scene=9_3C
#: 9_3C:3017
msgctxt "text_id=13464 | speaker=unknown"
msgid "　芝居がかった青子の声に、有珠は無言でうなずく。"
msgstr ""

#. Occurrence 9_3C:3022:13465: scene=9_3C
#: 9_3C:3022
msgctxt "text_id=13465 | speaker=unknown"
msgid "　この、端においやられた水槽のさらに端っこで、彼は静かに漂っていた。"
msgstr ""

#. Occurrence 9_3C:3078:13466: scene=9_3C
#: 9_3C:3078
msgctxt "text_id=13466 | speaker=unknown"
msgid "　一般的に言って、マンボウはカタチのいい魚ではない。"
msgstr ""

#. Occurrence 9_3C:3083:13467: scene=9_3C
#: 9_3C:3083
msgctxt "text_id=13467 | speaker=unknown"
msgid "　海を泳ぐ生物として、なぜこんな進化を？　と聞きたくなる形状だ。"
msgstr ""

#. Occurrence 9_3C:3088:13468: scene=9_3C
#: 9_3C:3088
msgctxt "text_id=13468 | speaker=unknown"
msgid "　平べったい魚身の上下にある舵びれで泳ぐらしいが、他の魚のようなスピードは期待できまい。"
msgstr ""

#. Occurrence 9_3C:3093:13469: scene=9_3C
#: 9_3C:3093
msgctxt "text_id=13469 | speaker=unknown"
msgid "　青子からすれば、体も目も、その在り方ものっぺりとした不思議生物である。"
msgstr ""

#. Occurrence 9_3C:3098:13470: scene=9_3C
#: 9_3C:3098
msgctxt "text_id=13470 | speaker=unknown"
msgid "　が。"
msgstr ""

#. Occurrence 9_3C:3153:13471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0030; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3153
msgctxt "text_id=13471 | speaker=aoko"
msgid "「ね。有珠、あっちの水槽みない？　ジンベエザメの回遊とか、<見|み><目|め><麗|うるわ>しいわよ？」"
msgstr ""

#. Occurrence 9_3C:3191:13472: scene=9_3C
#: 9_3C:3191
msgctxt "text_id=13472 | speaker=unknown"
msgid "　有珠はこのように、マンボウに夢中である。"
msgstr ""

#. Occurrence 9_3C:3211:13473: scene=9_3C
#: 9_3C:3211
msgctxt "text_id=13473 | speaker=unknown"
msgid "　ふらふらと漂う魚界の<金平糖|こんぺいとう>を見つめ、彼がうまく<転回|ターン>できずコツコツと水槽にぶつかる度に、"
msgstr ""

#. Occurrence 9_3C:3227:13474: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0030; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3227
msgctxt "text_id=13474 | speaker=alice"
msgid "「青子。この子、泳ぐのが下手だわ」"
msgstr ""

#. Occurrence 9_3C:3281:13475: scene=9_3C
#: 9_3C:3281
msgctxt "text_id=13475 | speaker=unknown"
msgid "　水槽に触れようと指を伸ばし、大人げないと引っ込めていた。"
msgstr ""

#. Occurrence 9_3C:3310:13476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0031; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3310
msgctxt "text_id=13476 | speaker=aoko"
msgid "「……ま、いっか。<愛嬌|あいきょう>だけはあるしね、マンボウ」"
msgstr ""

#. Occurrence 9_3C:3316:13477: scene=9_3C
#: 9_3C:3316
msgctxt "text_id=13477 | speaker=unknown"
msgid "　こうなっては有珠はテコでも動かない。"
msgstr ""

#. Occurrence 9_3C:3329:13478: scene=9_3C
#: 9_3C:3329
msgctxt "text_id=13478 | speaker=unknown"
msgid "　仕方ないと観念して、青子は有珠に付き合い、<座布団|ざぶとん>のような硬骨魚を眺めるのだった。"
msgstr ""

#. Occurrence 9_3C:3358:13479: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0032; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3358
msgctxt "text_id=13479 | speaker=aoko"
msgid "「へー。マンボウってフグ目だったんだ。なになに、マンボウのメスは一度に三億個の卵を海中に放出する、地上でもっとも多くの卵を産む脊椎動物である……なるほどねー。"
msgstr ""

#. Occurrence 9_3C:3364:13480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0033; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3364
msgctxt "text_id=13480 | speaker=aoko"
msgid "　他の魚たちにとっちゃ格好のエサになるから、多く産むこと、それ自体が生存のための手段になるワケか」"
msgstr ""

#. Occurrence 9_3C:3424:13481: scene=9_3C
#: 9_3C:3424
msgctxt "text_id=13481 | speaker=unknown"
msgid "　興味深く解説を読む青子だが、有珠はマンボウの生態はどうでもいいらしい。"
msgstr ""

#. Occurrence 9_3C:3429:13482: scene=9_3C
#: 9_3C:3429
msgctxt "text_id=13482 | speaker=unknown"
msgid "　平たい魚影がコツコツと水槽の壁に当たるたび、目を輝かせたり、落ちこんだりする。"
msgstr ""

#. Occurrence 9_3C:3434:13483: scene=9_3C
#: 9_3C:3434
msgctxt "text_id=13483 | speaker=unknown"
msgid "　そんな中、不意に少女は呟いた。"
msgstr ""

#. Occurrence 9_3C:3440:13484: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0031; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3440
msgctxt "text_id=13484 | speaker=alice"
msgid "「さっきの話だけど」"
msgstr ""

#. Occurrence 9_3C:3468:13485: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0034; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3468
msgctxt "text_id=13485 | speaker=aoko"
msgid "「へ？　さっきの話って、なに？」"
msgstr ""

#. Occurrence 9_3C:3491:13486: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0032; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3491
msgctxt "text_id=13486 | speaker=alice"
msgid "「彼について。留守を任せるとか、そういうの」"
msgstr ""

#. Occurrence 9_3C:3511:13487: scene=9_3C
#: 9_3C:3511
msgctxt "text_id=13487 | speaker=unknown"
msgid "　気が付けば、少女はいつもの姿に戻っていた。"
msgstr ""

#. Occurrence 9_3C:3516:13488: scene=9_3C
#: 9_3C:3516
msgctxt "text_id=13488 | speaker=unknown"
msgid "　張りつめた空気。"
msgstr ""

#. Occurrence 9_3C:3521:13489: scene=9_3C
#: 9_3C:3521
msgctxt "text_id=13489 | speaker=unknown"
msgid "　何処であろうと、あの洋館の中であろうと、<頑|かたく>なに人を拒む冷たさに。"
msgstr ""

#. Occurrence 9_3C:3542:13490: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0033; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3542
msgctxt "text_id=13490 | speaker=alice"
msgid "「わたしの気が変わった訳じゃないわ。"
msgstr ""

#. Occurrence 9_3C:3548:13491: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0034; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3548
msgctxt "text_id=13491 | speaker=alice"
msgid "　依然として彼の事は分からないもの。分からない人を、どうやって信頼すればいいの？」"
msgstr ""

#. Occurrence 9_3C:3573:13492: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0035; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3573
msgctxt "text_id=13492 | speaker=aoko"
msgid "「……まあね。でも、じゃあどうして？」"
msgstr ""

#. Occurrence 9_3C:3579:13493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0035; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3579
msgctxt "text_id=13493 | speaker=alice"
msgid "「青子の事は分かるわ。貴女はいつも正しい選択をする。……だから、青子を信じる彼の人間性は、信じてもいい」"
msgstr ""

#. Occurrence 9_3C:3600:13494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0036; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3600
msgctxt "text_id=13494 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence 9_3C:3641:13495: scene=9_3C
#: 9_3C:3641
msgctxt "text_id=13495 | speaker=unknown"
msgid "　草十郎の事は分からないし、理解する気もない。"
msgstr ""

#. Occurrence 9_3C:3646:13496: scene=9_3C
#: 9_3C:3646
msgctxt "text_id=13496 | speaker=unknown"
msgid "　けれど、<有珠|じぶん>の協力者である青子を信じているのなら、その選択に免じて許してもいい。"
msgstr ""

#. Occurrence 9_3C:3652:13497: scene=9_3C
#: 9_3C:3652
msgctxt "text_id=13497 | speaker=unknown"
msgid "　有珠は今の自分の感情を、そう落としこんだらしい。"
msgstr ""

#. Occurrence 9_3C:3685:13498: scene=9_3C
#: 9_3C:3685
msgctxt "text_id=13498 | speaker=unknown"
msgid "　分からない人は信頼できない、と少女は言う。"
msgstr ""

#. Occurrence 9_3C:3690:13499: scene=9_3C
#: 9_3C:3690
msgctxt "text_id=13499 | speaker=unknown"
msgid "　けれど逆に言えば、それは―――誰かを信じたいから、深く理解したいと望んでいるようにもとれた。"
msgstr ""

#. Occurrence 9_3C:3724:13500: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0037; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3724
msgctxt "text_id=13500 | speaker=aoko"
msgid "「……ま、口にするのは何だからつっこまないけどね。"
msgstr ""

#. Occurrence 9_3C:3766:13501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0038; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3766
msgctxt "text_id=13501 | speaker=aoko"
msgid "　それより、なに？　そんなに私のこと信頼してくれてたの、有珠？」"
msgstr ""

#. Occurrence 9_3C:3772:13502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0036; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3772
msgctxt "text_id=13502 | speaker=alice"
msgid "「……ええ。好意はともかく、信頼だけはしているわ。"
msgstr ""

#. Occurrence 9_3C:3778:13503: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0037; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3778
msgctxt "text_id=13503 | speaker=alice"
msgid "　だって共犯者でしょう、わたしたち」"
msgstr ""

#. Occurrence 9_3C:3863:13504: scene=9_3C
#: 9_3C:3863
msgctxt "text_id=13504 | speaker=unknown"
msgid "　白いコートが揺れる。"
msgstr ""

#. Occurrence 9_3C:3868:13505: scene=9_3C
#: 9_3C:3868
msgctxt "text_id=13505 | speaker=unknown"
msgid "　……ひとときの旅は終わった。"
msgstr ""

#. Occurrence 9_3C:3873:13506: scene=9_3C
#: 9_3C:3873
msgctxt "text_id=13506 | speaker=unknown"
msgid "　水の国の出口はすぐそこだ。"
msgstr ""

#. Occurrence 9_3C:3878:13507: scene=9_3C
#: 9_3C:3878
msgctxt "text_id=13507 | speaker=unknown"
msgid "　少女は水槽から視線を逸らして、付き合いのいい同居人へと歩きだした。"
msgstr ""

#. Occurrence 9_3C:3939:13508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0038; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3939
msgctxt "text_id=13508 | speaker=alice"
msgid "「……優しい顔をしているのに、傷だらけね」"
msgstr ""

#. Occurrence 9_3C:3951:13509: scene=9_3C
#: 9_3C:3951
msgctxt "text_id=13509 | speaker=unknown"
msgid "　最後に小さく。"
msgstr ""

#. Occurrence 9_3C:3956:13510: scene=9_3C
#: 9_3C:3956
msgctxt "text_id=13510 | speaker=unknown"
msgid "　水槽の孤影に別れを告げるよう、呟いて。"
msgstr ""

#. Occurrence 9_4:67:13511: scene=9_4
#: 9_4:67
msgctxt "text_id=13511 | speaker=unknown"
msgid "　冬の日没は早い。"
msgstr ""

#. Occurrence 9_4:72:13512: scene=9_4
#: 9_4:72
msgctxt "text_id=13512 | speaker=unknown"
msgid "　午後の斜陽が完全に失われた午後四時。"
msgstr ""

#. Occurrence 9_4:77:13513: scene=9_4
#: 9_4:77
msgctxt "text_id=13513 | speaker=unknown"
msgid "　洋館は町中よりいくぶん早く夕暮れを迎えようとしている。"
msgstr ""

#. Occurrence 9_4:107:13514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0000; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:107
msgctxt "text_id=13514 | speaker=soujuurou"
msgid "「―――なるほど。君の生態はよく解った」"
msgstr ""

#. Occurrence 9_4:113:13515: scene=9_4
#: 9_4:113
msgctxt "text_id=13515 | speaker=unknown"
msgid "　冷えこんできた中、お茶だけを<暖|だん>にして草十郎はひとりうなずいた。"
msgstr ""

#. Occurrence 9_4:129:13516: scene=9_4
#: 9_4:129
msgctxt "text_id=13516 | speaker=unknown"
msgid "　いいかげんワニは飽きたのか、ソファーに身を預けて、ぼんやりと窓の外を眺めている。"
msgstr ""

#. Occurrence 9_4:160:13517: scene=9_4
#: 9_4:160
msgctxt "text_id=13517 | speaker=unknown"
msgid "　一度やってみたかったのか、ソファーに寝そべったまま草十郎は動かない。"
msgstr ""

#. Occurrence 9_4:165:13518: scene=9_4
#: 9_4:165
msgctxt "text_id=13518 | speaker=unknown"
msgid "　三時間近くワニを観察していた影響か、あんなふうに日がな一日横になって暮らすのはどんな気持ちなのか、と真剣に悩んでいるようにも見える。"
msgstr ""

#. Occurrence 9_4:186:13519: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0001; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:186
msgctxt "text_id=13519 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 9_4:192:13520: scene=9_4
#: 9_4:192
msgctxt "text_id=13520 | speaker=unknown"
msgid "　いい機会だし、いっそ青子たちが帰ってくるまでソファーで眠ってみようか、などと草十郎が考えた矢先、洋館には不釣り合いな怪音が響いてきた。"
msgstr ""

#. Occurrence 9_4:225:13521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0002; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:225
msgctxt "text_id=13521 | speaker=soujuurou"
msgid "「……？」"
msgstr ""

#. Occurrence 9_4:231:13522: scene=9_4
#: 9_4:231
msgctxt "text_id=13522 | speaker=unknown"
msgid "　<四足|ワニ>から<二足|ヒト>に進化するように、のっそりと起き上がる。"
msgstr ""

#. Occurrence 9_4:236:13523: scene=9_4
#: 9_4:236
msgctxt "text_id=13523 | speaker=unknown"
msgid "　ごんごん、という音は辛抱強く定期的に続いていた。"
msgstr ""

#. Occurrence 9_4:241:13524: scene=9_4
#: 9_4:241
msgctxt "text_id=13524 | speaker=unknown"
msgid "　アパート暮らしの時に何度か経験した、玄関からの呼び音である。"
msgstr ""

#. Occurrence 9_4:263:13525: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0003; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:263
msgctxt "text_id=13525 | speaker=soujuurou"
msgid "「……むう。新聞の勧誘か？」"
msgstr ""

#. Occurrence 9_4:269:13526: scene=9_4
#: 9_4:269
msgctxt "text_id=13526 | speaker=unknown"
msgid "　こんな丘の上までたいしたもんだ、と感心しながら草十郎はロビーに向かった。"
msgstr ""

#. Occurrence 9_4:311:13527: scene=9_4
#: 9_4:311
msgctxt "text_id=13527 | speaker=unknown"
msgid "　音は妙に響き渡る。"
msgstr ""

#. Occurrence 9_4:316:13528: scene=9_4
#: 9_4:316
msgctxt "text_id=13528 | speaker=unknown"
msgid "　あの玄関には呼び鈴らしきものはないし、来訪者はいかなる道具で扉を叩いているのか。"
msgstr ""

#. Occurrence 9_4:321:13529: scene=9_4
#: 9_4:321
msgctxt "text_id=13529 | speaker=unknown"
msgid "　手だとしたら、なんていうか、<畏|い><怖|ふ>すべき鉄拳勧誘である。"
msgstr ""

#. Occurrence 9_4:368:13530: scene=9_4
#: 9_4:368
msgctxt "text_id=13530 | speaker=unknown"
msgid "　館の入り口にあたる玄関は、草十郎から見れば要塞の如き堅固さ、豪華さだ。"
msgstr ""

#. Occurrence 9_4:373:13531: scene=9_4
#: 9_4:373
msgctxt "text_id=13531 | speaker=unknown"
msgid "　両開きの扉は頑丈で、<破城鎚|はじょうづち>でも持ってこないかぎり破られる事はないだろう。"
msgstr ""

#. Occurrence 9_4:385:13532: scene=9_4
#: 9_4:385
msgctxt "text_id=13532 | speaker=unknown"
msgid "　そんな扉が、何度目かのノックで悲鳴を上げるように軋んでいる。"
msgstr ""

#. Occurrence 9_4:405:13533: scene=9_4
#: 9_4:405
msgctxt "text_id=13533 | speaker=unknown"
msgid "　どうも相手は、このまま出てこないのなら城門突破も<辞|じ>さないかまえらしい。"
msgstr ""

#. Occurrence 9_4:410:13534: scene=9_4
#: 9_4:410
msgctxt "text_id=13534 | speaker=unknown"
msgid "　新聞の勧誘バイトも経験済みの草十郎である。なので、"
msgstr ""

#. Occurrence 9_4:430:13535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0004; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:430
msgctxt "text_id=13535 | speaker=soujuurou"
msgid "「はーい、いま開けまーす」"
msgstr ""

#. Occurrence 9_4:436:13536: scene=9_4
#: 9_4:436
msgctxt "text_id=13536 | speaker=unknown"
msgid "　彼らは彼らなりに必死な事を知っているので、別段そこには驚かなかった。"
msgstr ""

#. Occurrence 9_4:537:13537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0005; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:537
msgctxt "text_id=13537 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence 9_4:543:13538: scene=9_4
#: 9_4:543
msgctxt "text_id=13538 | speaker=unknown"
msgid "　それは本日二度目の、正体不明の驚きだった。"
msgstr ""

#. Occurrence 9_4:548:13539: scene=9_4
#: 9_4:548
msgctxt "text_id=13539 | speaker=unknown"
msgid "　草十郎は言葉なく立ち尽くす。"
msgstr ""

#. Occurrence 9_4:582:13540: scene=9_4
#: 9_4:582
msgctxt "text_id=13540 | speaker=unknown"
msgid "　新聞の勧誘にしては珍しく、若い女性だったから……ではない。"
msgstr ""

#. Occurrence 9_4:587:13541: scene=9_4
#: 9_4:587
msgctxt "text_id=13541 | speaker=unknown"
msgid "　日没前の中庭を背景にした女性の姿は、自分なんかよりよほど、この洋館に相応しく思えたからだ。"
msgstr ""

#. Occurrence 9_4:622:13542: scene=9_4
#: 9_4:622
msgctxt "text_id=13542 | speaker=unknown"
msgid "　細いが、しかし、凛とした女性だった。"
msgstr ""

#. Occurrence 9_4:627:13543: scene=9_4
#: 9_4:627
msgctxt "text_id=13543 | speaker=unknown"
msgid "　背の程は草十郎よりやや低い。女性としては長身の部類だろう。"
msgstr ""

#. Occurrence 9_4:632:13544: scene=9_4
#: 9_4:632
msgctxt "text_id=13544 | speaker=unknown"
msgid "　緑色の服は地味な色彩のクセに派手で、この国の文化とは系統が違っていた。"
msgstr ""

#. Occurrence 9_4:652:13545: scene=9_4
#: 9_4:652
msgctxt "text_id=13545 | speaker=unknown"
msgid "　<清楚|せいそ>なのに堂々としている。"
msgstr ""

#. Occurrence 9_4:657:13546: scene=9_4
#: 9_4:657
msgctxt "text_id=13546 | speaker=unknown"
msgid "　華やかなようで、その実、強い芯が通っている感じ。"
msgstr ""

#. Occurrence 9_4:684:13547: scene=9_4
#: 9_4:684
msgctxt "text_id=13547 | speaker=unknown"
msgid "　そんな、本来ならあまり混ざらない要素を持つ女性を、草十郎はよく知っている。"
msgstr ""

#. Occurrence 9_4:725:13548: scene=9_4
#: 9_4:725
msgctxt "text_id=13548 | speaker=unknown"
msgid "　ただ、草十郎の知っている彼女と違い、この女性は威圧より優しさの方が際だっていた。"
msgstr ""

#. Occurrence 9_4:730:13549: scene=9_4
#: 9_4:730
msgctxt "text_id=13549 | speaker=unknown"
msgid "　中性的に見えるのは短髪だからだろう。"
msgstr ""

#. Occurrence 9_4:735:13550: scene=9_4
#: 9_4:735
msgctxt "text_id=13550 | speaker=unknown"
msgid "　見るも鮮やかなブラウンの髪はうなじまでしかない。"
msgstr ""

#. Occurrence 9_4:740:13551: scene=9_4
#: 9_4:740
msgctxt "text_id=13551 | speaker=unknown"
msgid "　呆然と、もったいないな、と思う草十郎だった。"
msgstr ""

#. Occurrence 9_4:765:13552: scene=9_4
#: 9_4:765
msgctxt "text_id=13552 | speaker=unknown"
msgid "　そんな草十郎を見て、女性は小さく微笑んだ。"
msgstr ""

#. Occurrence 9_4:770:13553: scene=9_4
#: 9_4:770
msgctxt "text_id=13553 | speaker=unknown"
msgid "　ずいぶん年上のように見えるのに、そんな仕草が悪戯っぽくて可愛いことこの上ない。"
msgstr ""

#. Occurrence 9_4:809:13554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0006; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:809
msgctxt "text_id=13554 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_4:814:13555: scene=9_4
#: 9_4:814
msgctxt "text_id=13555 | speaker=unknown"
msgid "　自分は惚れっぽい<性質|たち>ではないと信じていた草十郎だが、なんだかそれも怪しいな、とうなだれる。"
msgstr ""

#. Occurrence 9_4:819:13556: scene=9_4
#: 9_4:819
msgctxt "text_id=13556 | speaker=unknown"
msgid "　ともあれ、こうして黙りこんでいては失礼だ。"
msgstr ""

#. Occurrence 9_4:855:13557: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0007; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:855
msgctxt "text_id=13557 | speaker=soujuurou"
msgid "「ええと、どちら様でしょうか」"
msgstr ""

#. Occurrence 9_4:861:13558: scene=9_4
#: 9_4:861
msgctxt "text_id=13558 | speaker=unknown"
msgid "　微妙にドギマギしている心臓を落ち着けて問いかける。"
msgstr ""

#. Occurrence 9_4:866:13559: scene=9_4
#: 9_4:866
msgctxt "text_id=13559 | speaker=unknown"
msgid "　それに、"
msgstr ""

#. Occurrence 9_4:905:13560: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0000; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:905
msgctxt "text_id=13560 | speaker=touko"
msgid "「こんばんは。青子います？」"
msgstr ""

#. Occurrence 9_4:929:13561: scene=9_4
#: 9_4:929
msgctxt "text_id=13561 | speaker=unknown"
msgid "　女性は青子という言葉に親しみをこめて、笑顔で返してきたのだった。"
msgstr ""

#. Occurrence 9_4:980:13562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0008; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:980
msgctxt "text_id=13562 | speaker=soujuurou"
msgid "「蒼崎はいないんです」"
msgstr ""

#. Occurrence 9_4:1015:13563: scene=9_4
#: 9_4:1015
msgctxt "text_id=13563 | speaker=unknown"
msgid "　青子の留守を告げる草十郎に、女性はあら、という意外そうな顔をした。"
msgstr ""

#. Occurrence 9_4:1042:13564: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0001; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1042
msgctxt "text_id=13564 | speaker=touko"
msgid "「それじゃあ久遠寺さんも留守なんだ」"
msgstr ""

#. Occurrence 9_4:1048:13565: scene=9_4
#: 9_4:1048
msgctxt "text_id=13565 | speaker=unknown"
msgid "　草十郎はしばし戸惑う。"
msgstr ""

#. Occurrence 9_4:1053:13566: scene=9_4
#: 9_4:1053
msgctxt "text_id=13566 | speaker=unknown"
msgid "　有珠を『久遠寺』と呼ぶ人間は今までいなかった。それも親しげに、十年来の友人のようにだ。"
msgstr ""

#. Occurrence 9_4:1081:13567: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0002; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1081
msgctxt "text_id=13567 | speaker=touko"
msgid "「そっかあ。夜ならともかく、日中から二人で出かけるとは感心感心。"
msgstr ""

#. Occurrence 9_4:1088:13568: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0003; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1088
msgctxt "text_id=13568 | speaker=touko"
msgid "カタチだけの雑居だろうと思ったけど、ちゃんと上手くいってるのね」"
msgstr ""

#. Occurrence 9_4:1108:13569: scene=9_4
#: 9_4:1108
msgctxt "text_id=13569 | speaker=unknown"
msgid "　にこりと微笑まれて、つい頷く草十郎。"
msgstr ""

#. Occurrence 9_4:1113:13570: scene=9_4
#: 9_4:1113
msgctxt "text_id=13570 | speaker=unknown"
msgid "　青子たちと面識がありそうなのも驚きだが、この女性はそもそも印象がおかしい。"
msgstr ""

#. Occurrence 9_4:1118:13571: scene=9_4
#: 9_4:1118
msgctxt "text_id=13571 | speaker=unknown"
msgid "　歳の頃は二十代前半だろうけれど、そう<草十郎|じぶん>と歳が離れている気がしない。"
msgstr ""

#. Occurrence 9_4:1123:13572: scene=9_4
#: 9_4:1123
msgctxt "text_id=13572 | speaker=unknown"
msgid "　屈託のない口調と明るい表情が、本来の美貌を<曖昧|あいまい>にしているような。"
msgstr ""

#. Occurrence 9_4:1151:13573: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0004; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1151
msgctxt "text_id=13573 | speaker=touko"
msgid "「それじゃあ、帰ってくるにしても夜？」"
msgstr ""

#. Occurrence 9_4:1169:13574: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0009; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1169
msgctxt "text_id=13574 | speaker=soujuurou"
msgid "「はい。終電前には帰ってくると思いますけど」"
msgstr ""

#. Occurrence 9_4:1175:13575: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0005; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1175
msgctxt "text_id=13575 | speaker=touko"
msgid "「そう。ところで君、誰？」"
msgstr ""

#. Occurrence 9_4:1181:13576: scene=9_4
#: 9_4:1181
msgctxt "text_id=13576 | speaker=unknown"
msgid "　それはこっちの台詞なんだけど、と心の中でちょっとだけ困る草十郎だった。"
msgstr ""

#. Occurrence 9_4:1186:13577: scene=9_4
#: 9_4:1186
msgctxt "text_id=13577 | speaker=unknown"
msgid "　誰？　という問いへの返答は、草十郎には難しすぎる。"
msgstr ""

#. Occurrence 9_4:1207:13578: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0010; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1207
msgctxt "text_id=13578 | speaker=soujuurou"
msgid "「すみません。誰か、と言われてもよく分からなくて。"
msgstr ""

#. Occurrence 9_4:1213:13579: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0011; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1213
msgctxt "text_id=13579 | speaker=soujuurou"
msgid "　とりあえず、今は留守番してますけど、実は蒼崎の友人なんです」"
msgstr ""

#. Occurrence 9_4:1219:13580: scene=9_4
#: 9_4:1219
msgctxt "text_id=13580 | speaker=unknown"
msgid "　まったく頼り気のない返答。"
msgstr ""

#. Occurrence 9_4:1224:13581: scene=9_4
#: 9_4:1224
msgctxt "text_id=13581 | speaker=unknown"
msgid "　馬鹿にしているとしか思えない少年に、女性はぱあ、と顔を明るくした。"
msgstr ""

#. Occurrence 9_4:1258:13582: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0006; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1258
msgctxt "text_id=13582 | speaker=touko"
msgid "「へえ、面白いこと言うのね君。名前はなんて言うの？」"
msgstr ""

#. Occurrence 9_4:1264:13583: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0012; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1264
msgctxt "text_id=13583 | speaker=soujuurou"
msgid "「あの……静希草十郎、と言うのですが」"
msgstr ""

#. Occurrence 9_4:1287:13584: scene=9_4
#: 9_4:1287
msgctxt "text_id=13584 | speaker=unknown"
msgid "　さらに自信なげな答えに、女性は笑いだしてしまった。"
msgstr ""

#. Occurrence 9_4:1292:13585: scene=9_4
#: 9_4:1292
msgctxt "text_id=13585 | speaker=unknown"
msgid "　草十郎にはどのあたりが可笑しかったのか分からなかったが、そう気分の悪い笑い声ではない。そこには卑下するものはなく、包むような温かさがあったからだ。"
msgstr ""

#. Occurrence 9_4:1312:13586: scene=9_4
#: 9_4:1312
msgctxt "text_id=13586 | speaker=unknown"
msgid "　そうして。"
msgstr ""

#. Occurrence 9_4:1317:13587: scene=9_4
#: 9_4:1317
msgctxt "text_id=13587 | speaker=unknown"
msgid "　女性はひとしきり笑った後、やけに親しげな眼差しで草十郎を見つめ直した。"
msgstr ""

#. Occurrence 9_4:1355:13588: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0007; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1355
msgctxt "text_id=13588 | speaker=touko"
msgid "「いや、気に入ったわ。えーと、草十郎くんだっけ？"
msgstr ""

#. Occurrence 9_4:1383:13589: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0008; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1383
msgctxt "text_id=13589 | speaker=touko"
msgid "　君には合わない名前だけど、それも暗示的で素敵だし。じゃ、そういうワケでお茶でも淹れてくれない？」"
msgstr ""

#. Occurrence 9_4:1389:13590: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0013; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1389
msgctxt "text_id=13590 | speaker=soujuurou"
msgid "「？　あ、いや」"
msgstr ""

#. Occurrence 9_4:1395:13591: scene=9_4
#: 9_4:1395
msgctxt "text_id=13591 | speaker=unknown"
msgid "　女性は草十郎を置き去りに、堂々と玄関を抜けていく。"
msgstr ""

#. Occurrence 9_4:1431:13592: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0009; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1431
msgctxt "text_id=13592 | speaker=touko"
msgid "「うわ、呆れた。ほんと以前のまんまじゃない。"
msgstr ""

#. Occurrence 9_4:1437:13593: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0010; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1437
msgctxt "text_id=13593 | speaker=touko"
msgid "　せっかくこっちに持ってきたんだから、悪いところは<修復|リフォーム>したものと思ったけど。なにも柱の歪みまで再現しなくてもいいのにねー」"
msgstr ""

#. Occurrence 9_4:1473:13594: scene=9_4
#: 9_4:1473
msgctxt "text_id=13594 | speaker=unknown"
msgid "　女性は楽しげにロビーを観察する。"
msgstr ""

#. Occurrence 9_4:1482:13595: scene=9_4
#: 9_4:1482
msgctxt "text_id=13595 | speaker=unknown"
msgid "　草十郎は玄関に置き去り状態。"
msgstr ""

#. Occurrence 9_4:1487:13596: scene=9_4
#: 9_4:1487
msgctxt "text_id=13596 | speaker=unknown"
msgid "　<靴|ヒール>の音はロビーを横切って、居間に続く扉に向かっていく。"
msgstr ""

#. Occurrence 9_4:1520:13597: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0011; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1520
msgctxt "text_id=13597 | speaker=touko"
msgid "「どうしたの？　こっちでしょ、居間は」"
msgstr ""

#. Occurrence 9_4:1530:13598: scene=9_4
#: 9_4:1530
msgctxt "text_id=13598 | speaker=unknown"
msgid "　勝手知ったる<他人|ひと>の家状態で、女性は迷いなく居間に続く廊下に消えていった。"
msgstr ""

#. Occurrence 9_4:1563:13599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0014; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1563
msgctxt "text_id=13599 | speaker=soujuurou"
msgid "「蒼崎か有珠、どっちかの先輩……かな？」"
msgstr ""

#. Occurrence 9_4:1568:13600: scene=9_4
#: 9_4:1568
msgctxt "text_id=13600 | speaker=unknown"
msgid "　ぽつりと呟いて、草十郎も居間に向かった。"
msgstr ""

#. Occurrence 9_4:1614:13601: scene=9_4
#: 9_4:1614
msgctxt "text_id=13601 | speaker=unknown"
msgid "　草十郎が居間に入ると、女性は感心しきった顔で、居間中を<漫|すず>ろ歩いていた。"
msgstr ""

#. Occurrence 9_4:1625:13602: scene=9_4
#: 9_4:1625
msgctxt "text_id=13602 | speaker=unknown"
msgid "　公園の並木道を散策するような、"
msgstr ""

#. Occurrence 9_4:1630:13603: scene=9_4
#: 9_4:1630
msgctxt "text_id=13603 | speaker=unknown"
msgid "　懐かしい空気を吸って踊りだしそうな、"
msgstr ""

#. Occurrence 9_4:1635:13604: scene=9_4
#: 9_4:1635
msgctxt "text_id=13604 | speaker=unknown"
msgid "　女性というより少女らしい軽やかさで。"
msgstr ""

#. Occurrence 9_4:1669:13605: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0012; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1669
msgctxt "text_id=13605 | speaker=touko"
msgid "「ん？　よく見れば、このテレビって―――」"
msgstr ""

#. Occurrence 9_4:1678:13606: scene=9_4
#: 9_4:1678
msgctxt "text_id=13606 | speaker=unknown"
msgid "　３０インチのテレビが珍しいのか、女性は食い入るように居間に不釣り合いなテレビを見つめた。"
msgstr ""

#. Occurrence 9_4:1698:13607: scene=9_4
#: 9_4:1698
msgctxt "text_id=13607 | speaker=unknown"
msgid "　……間の悪いことに、ブラウン管には流しっぱなしのがくがく動物ランドの映像。"
msgstr ""

#. Occurrence 9_4:1703:13608: scene=9_4
#: 9_4:1703
msgctxt "text_id=13608 | speaker=unknown"
msgid "　ちゃんと停止ボタンを押しておけば良かった、と草十郎は悔やみつつ反省した。"
msgstr ""

#. Occurrence 9_4:1737:13609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0015; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1737
msgctxt "text_id=13609 | speaker=soujuurou"
msgid "「あの、もし」"
msgstr ""

#. Occurrence 9_4:1742:13610: scene=9_4
#: 9_4:1742
msgctxt "text_id=13610 | speaker=unknown"
msgid "　気を取り直して話しかける。"
msgstr ""

#. Occurrence 9_4:1747:13611: scene=9_4
#: 9_4:1747
msgctxt "text_id=13611 | speaker=unknown"
msgid "　とりあえず色々問題はある気はするけど、まず<女性|あいて>の名前ぐらいは聞かなければ、と意を決したのだ。"
msgstr ""

#. Occurrence 9_4:1752:13612: scene=9_4
#: 9_4:1752
msgctxt "text_id=13612 | speaker=unknown"
msgid "　そんな草十郎に、女性は一転して冷たい視線を向けた。"
msgstr ""

#. Occurrence 9_4:1757:13613: scene=9_4
#: 9_4:1757
msgctxt "text_id=13613 | speaker=unknown"
msgid "　細く長い眉と、相手を圧倒する瞳が、眼鏡ごしに草十郎を睨む。"
msgstr ""

#. Occurrence 9_4:1789:13614: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0013; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1789
msgctxt "text_id=13614 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_4:1800:13615: scene=9_4
#: 9_4:1800
msgctxt "text_id=13615 | speaker=unknown"
msgid "　そんなつもりはなかったけど、自分に重大な落ち度があったらしい―――と思うしかない批難の眼差しだった。"
msgstr ""

#. Occurrence 9_4:1820:13616: scene=9_4
#: 9_4:1820
msgctxt "text_id=13616 | speaker=unknown"
msgid "　草十郎は申し訳なさそうに言葉を失う。"
msgstr ""

#. Occurrence 9_4:1825:13617: scene=9_4
#: 9_4:1825
msgctxt "text_id=13617 | speaker=unknown"
msgid "　そこへ、"
msgstr ""

#. Occurrence 9_4:1852:13618: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0014; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1852
msgctxt "text_id=13618 | speaker=touko"
msgid "「やだなあ草十郎くん。もし、なんてかしこまって。"
msgstr ""

#. Occurrence 9_4:1858:13619: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0015; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1858
msgctxt "text_id=13619 | speaker=touko"
msgid "　私、そんなおばさんに見える？」"
msgstr ""

#. Occurrence 9_4:1863:13620: scene=9_4
#: 9_4:1863
msgctxt "text_id=13620 | speaker=unknown"
msgid "　くすりと。"
msgstr ""

#. Occurrence 9_4:1868:13621: scene=9_4
#: 9_4:1868
msgctxt "text_id=13621 | speaker=unknown"
msgid "　鋭い眼差しを崩して、からかうように女性は笑った。"
msgstr ""

#. Occurrence 9_4:1914:13622: scene=9_4
#: 9_4:1914
msgctxt "text_id=13622 | speaker=unknown"
msgid "　もちろんそんな事は全然なくて、比喩するならお姉さんという単語がぴったりくる。"
msgstr ""

#. Occurrence 9_4:1919:13623: scene=9_4
#: 9_4:1919
msgctxt "text_id=13623 | speaker=unknown"
msgid "　そんな気持ちを全身で表現する草十郎に、女性は満足気に微笑んだ。"
msgstr ""

#. Occurrence 9_4:1948:13624: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0016; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1948
msgctxt "text_id=13624 | speaker=touko"
msgid "「よろしい。なら、そんな他人行儀な話し方はやめましょ。つまらないし、<柄|がら>じゃないわ」"
msgstr ""

#. Occurrence 9_4:1967:13625: scene=9_4
#: 9_4:1967
msgctxt "text_id=13625 | speaker=unknown"
msgid "　言って、彼女はソファーに腰を下ろした。"
msgstr ""

#. Occurrence 9_4:1972:13626: scene=9_4
#: 9_4:1972
msgctxt "text_id=13626 | speaker=unknown"
msgid "　あくまで自然に、優雅に、物音ひとつ立てずに。"
msgstr ""

#. Occurrence 9_4:1979:13627: scene=9_4
#: 9_4:1979
msgctxt "text_id=13627 | speaker=unknown"
msgid "　その、あまりにも洗練された動作と姿勢が、"
msgstr ""

#. Occurrence 9_4:1984:13628: scene=9_4
#: 9_4:1984
msgctxt "text_id=13628 | speaker=unknown"
msgid "『さあ、早くお茶淹れてきて』と語っている。"
msgstr ""

#. Occurrence 9_4:2015:13629: scene=9_4
#: 9_4:2015
msgctxt "text_id=13629 | speaker=unknown"
msgid "　疑問は究明されないまま、仕方なく草十郎は台所に向かった。"
msgstr ""

#. Occurrence 9_4:2021:13630: scene=9_4
#: 9_4:2021
msgctxt "text_id=13630 | speaker=unknown"
msgid "とにかくお茶を淹れないと話は進まないらしい。"
msgstr ""

#. Occurrence 9_4:2042:13631: scene=9_4
#: 9_4:2042
msgctxt "text_id=13631 | speaker=unknown"
msgid "　葉は以前、無断使用の<咎|とが>で弁償させられたフォションを選んだ。"
msgstr ""

#. Occurrence 9_4:2047:13632: scene=9_4
#: 9_4:2047
msgctxt "text_id=13632 | speaker=unknown"
msgid "　カップは青子を訪ねてきた人なので、青子の持ち物であるセーブルのカップで紅茶を淹れる事にする。"
msgstr ""

#. Occurrence 9_4:2052:13633: scene=9_4
#: 9_4:2052
msgctxt "text_id=13633 | speaker=unknown"
msgid "　深海を思わせるカップにお茶をそそいで、草十郎は居間へとまい戻った。"
msgstr ""

#. Occurrence 9_4:2083:13634: scene=9_4
#: 9_4:2083
msgctxt "text_id=13634 | speaker=unknown"
msgid "　<恭|うやうや>しくティーカップをテーブルにおいて、草十郎は女性を見る。"
msgstr ""

#. Occurrence 9_4:2119:13635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0016; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2119
msgctxt "text_id=13635 | speaker=soujuurou"
msgid "「あの。訊ねるのが遅れましたけど、蒼崎の知り合い……かな？」"
msgstr ""

#. Occurrence 9_4:2125:13636: scene=9_4
#: 9_4:2125
msgctxt "text_id=13636 | speaker=unknown"
msgid "　言われた事はすぐに直す草十郎だが、この女性にはつい丁寧語になってしまった。"
msgstr ""

#. Occurrence 9_4:2130:13637: scene=9_4
#: 9_4:2130
msgctxt "text_id=13637 | speaker=unknown"
msgid "　ので、強引に語尾を砕けたものにする。"
msgstr ""

#. Occurrence 9_4:2135:13638: scene=9_4
#: 9_4:2135
msgctxt "text_id=13638 | speaker=unknown"
msgid "　それが不満だったのか、女性はまたも眼差しを険しくした。"
msgstr ""

#. Occurrence 9_4:2167:13639: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0017; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2167
msgctxt "text_id=13639 | speaker=touko"
msgid "「それ。その蒼崎って言うの、やめてくれない？　なんだかくすぐったくて。青子でいいでしょ、呼び方は」"
msgstr ""

#. Occurrence 9_4:2205:13640: scene=9_4
#: 9_4:2205
msgctxt "text_id=13640 | speaker=unknown"
msgid "　女性はすました顔でカップを手にして、一口だけ口をつけた。"
msgstr ""

#. Occurrence 9_4:2210:13641: scene=9_4
#: 9_4:2210
msgctxt "text_id=13641 | speaker=unknown"
msgid "　青子たちには下手、苦い、と不評なソレを、女性は笑顔ひとつで受け流す。"
msgstr ""

#. Occurrence 9_4:2215:13642: scene=9_4
#: 9_4:2215
msgctxt "text_id=13642 | speaker=unknown"
msgid "　<結果|あじ>はどうあれ頑張ったで賞、という温情が存在する事を、のちに知る草十郎なのだった。"
msgstr ""

#. Occurrence 9_4:2249:13643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0018; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2249
msgctxt "text_id=13643 | speaker=touko"
msgid "「ほら、立ってないで座って。"
msgstr ""

#. Occurrence 9_4:2249:13644: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0018; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2249
msgctxt "text_id=13644 | speaker=touko"
msgid "　見下ろされるのは好きじゃないんだ、私」"
msgstr ""

#. Occurrence 9_4:2266:13645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0017; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2266
msgctxt "text_id=13645 | speaker=soujuurou"
msgid "「……？」"
msgstr ""

#. Occurrence 9_4:2272:13646: scene=9_4
#: 9_4:2272
msgctxt "text_id=13646 | speaker=unknown"
msgid "　よく知る同居人に似た話し方に、ますます首をかしげる草十郎。"
msgstr ""

#. Occurrence 9_4:2278:13647: scene=9_4
#: 9_4:2278
msgctxt "text_id=13647 | speaker=unknown"
msgid "そう言えば―――唐突ではあるが、この光景にも見覚えのあるような―――"
msgstr ""

#. Occurrence 9_4:2316:13648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0018; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2316
msgctxt "text_id=13648 | speaker=soujuurou"
msgid "「…………あれ？」"
msgstr ""

#. Occurrence 9_4:2322:13649: scene=9_4
#: 9_4:2322
msgctxt "text_id=13649 | speaker=unknown"
msgid "　ソファーに座っている女性の姿から、忘れかけていた記憶が蘇る。"
msgstr ""

#. Occurrence 9_4:2340:13650: scene=9_4
#: 9_4:2340
msgctxt "text_id=13650 | speaker=unknown"
msgid "　そんな彼を、女性は楽しげに見上げている。"
msgstr ""

#. Occurrence 9_4:2373:13651: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0019; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2373
msgctxt "text_id=13651 | speaker=touko"
msgid "「思い出した？　私もちょっと驚いたわ。"
msgstr ""

#. Occurrence 9_4:2380:13652: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0020; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2380
msgctxt "text_id=13652 | speaker=touko"
msgid "青子を訪ねにきたら、いつか見た君が出迎えてくるんだから」"
msgstr ""

#. Occurrence 9_4:2386:13653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0019; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2386
msgctxt "text_id=13653 | speaker=soujuurou"
msgid "「――――――、あ」"
msgstr ""

#. Occurrence 9_4:2417:13654: scene=9_4
#: 9_4:2417
msgctxt "text_id=13654 | speaker=unknown"
msgid "　くすくすと笑う女性を見て、草十郎は完全に思い出した。"
msgstr ""

#. Occurrence 9_4:2436:13655: scene=9_4
#: 9_4:2436
msgctxt "text_id=13655 | speaker=unknown"
msgid "　あの時は一瞬しか見ていなかったが、間違いない。"
msgstr ""

#. Occurrence 9_4:2441:13656: scene=9_4
#: 9_4:2441
msgctxt "text_id=13656 | speaker=unknown"
msgid "　この女性こそ、いつかのパチンコ屋でフィーバーを出していた長い煙草の<達人|ひと>……！"
msgstr ""

#. Occurrence 9_4:2480:13657: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0021; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2480
msgctxt "text_id=13657 | speaker=touko"
msgid "「あの時は私もショックだったなぁ。"
msgstr ""

#. Occurrence 9_4:2486:13658: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0022; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2486
msgctxt "text_id=13658 | speaker=touko"
msgid "　草十郎くん、目が合うなりいきなり逃げ出したでしょ？"
msgstr ""

#. Occurrence 9_4:2492:13659: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0023; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2492
msgctxt "text_id=13659 | speaker=touko"
msgid "　そんなに私ってこわもてなのかしらって、あの日の晩は真剣に悩んだんだから」"
msgstr ""

#. Occurrence 9_4:2512:13660: scene=9_4
#: 9_4:2512
msgctxt "text_id=13660 | speaker=unknown"
msgid "　そんな思い出話を、女性は楽しそうに語る。"
msgstr ""

#. Occurrence 9_4:2517:13661: scene=9_4
#: 9_4:2517
msgctxt "text_id=13661 | speaker=unknown"
msgid "　そう。あの時は青子の秘密を知った翌日で、草十郎は公園にいた<青子|ひとかげ>を、この女性と勘違いして逃げだしたのだ。"
msgstr ""

#. Occurrence 9_4:2523:13662: scene=9_4
#: 9_4:2523
msgctxt "text_id=13662 | speaker=unknown"
msgid "　結局は人違いだったけど、あの時、なぜあんな事を思ったかと言うと―――"
msgstr ""

#. Occurrence 9_4:2556:13663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0020; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2556
msgctxt "text_id=13663 | speaker=soujuurou"
msgid "『……そうか。雰囲気が似てるんだ』"
msgstr ""

#. Occurrence 9_4:2569:13664: scene=9_4
#: 9_4:2569
msgctxt "text_id=13664 | speaker=unknown"
msgid "　そこまで思って、草十郎はやっと来客の正体に気が付いた。ちょっと考えればすぐに分かった事じゃないか、と自分を叱りながら。"
msgstr ""

#. Occurrence 9_4:2607:13665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0021; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2607
msgctxt "text_id=13665 | speaker=soujuurou"
msgid "「それじゃあ、あなたは」"
msgstr ""

#. Occurrence 9_4:2613:13666: scene=9_4
#: 9_4:2613
msgctxt "text_id=13666 | speaker=unknown"
msgid "　言い掛ける草十郎の口を塞ぐように、女性は片手を上げた。"
msgstr ""

#. Occurrence 9_4:2624:13667: scene=9_4
#: 9_4:2624
msgctxt "text_id=13667 | speaker=unknown"
msgid "　人差し指で草十郎の顔をばん、と射つように。"
msgstr ""

#. Occurrence 9_4:2657:13668: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0024; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2657
msgctxt "text_id=13668 | speaker=touko"
msgid "「ごめんなさい。君の仕草がちょっと可愛くて、からかいがすぎちゃった。"
msgstr ""

#. Occurrence 9_4:2663:13669: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0025; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2663
msgctxt "text_id=13669 | speaker=touko"
msgid "　自己紹介が遅れたけど、私は蒼崎<橙子|とうこ>。"
msgstr ""

#. Occurrence 9_4:2681:13670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0026; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2681
msgctxt "text_id=13670 | speaker=touko"
msgid "　率直に言うと、青子の実の姉ってワケね」"
msgstr ""

#. Occurrence 9_4:2701:13671: scene=9_4
#: 9_4:2701
msgctxt "text_id=13671 | speaker=unknown"
msgid "　なるほど、見惚れるはずだと納得する。"
msgstr ""

#. Occurrence 9_4:2706:13672: scene=9_4
#: 9_4:2706
msgctxt "text_id=13672 | speaker=unknown"
msgid "　見るものを勇気づける笑顔を持った女性は、確かに青子の未来の姿を映していたのだから。"
msgstr ""

#. Occurrence 9_4:2737:13673: scene=9_4
#: 9_4:2737
msgctxt "text_id=13673 | speaker=unknown"
msgid "　……もっとも。"
msgstr ""

#. Occurrence 9_4:2742:13674: scene=9_4
#: 9_4:2742
msgctxt "text_id=13674 | speaker=unknown"
msgid "　常に前向きな青子と違って、この人物はななめ前あたりを面白がって眺めているタイプのようだけど。"
msgstr ""

#. Occurrence 9_4:2775:13675: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0027; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2775
msgctxt "text_id=13675 | speaker=touko"
msgid "「あの子が困ってるって聞いてね。"
msgstr ""

#. Occurrence 9_4:2781:13676: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0028; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2781
msgctxt "text_id=13676 | speaker=touko"
msgid "　いいかげん忠告してあげる気で、はるばるやってきたわけなのでした」"
msgstr ""

#. Occurrence 9_4:2799:13677: scene=9_4
#: 9_4:2799
msgctxt "text_id=13677 | speaker=unknown"
msgid "　ふふ、と妖しい笑みを浮かべて、青子のお姉さんは紅茶を一口。"
msgstr ""

#. Occurrence 9_4:2805:13678: scene=9_4
#: 9_4:2805
msgctxt "text_id=13678 | speaker=unknown"
msgid "　その仕草に釣られて、草十郎もソファーに腰を下ろした。急な来客に驚いてばかりだったが、そういうコトなら安心できる。"
msgstr ""

#. Occurrence 9_4:2835:13679: scene=9_4
#: 9_4:2835
msgctxt "text_id=13679 | speaker=unknown"
msgid "　そうして、時刻は午後五時前。"
msgstr ""

#. Occurrence 9_4:2840:13680: scene=9_4
#: 9_4:2840
msgctxt "text_id=13680 | speaker=unknown"
msgid "　遠出した青子たちも、そろそろ帰途につく頃だった。"
msgstr ""

#. Occurrence 9_5:57:13681: scene=9_5
#: 9_5:57
msgctxt "text_id=13681 | speaker=unknown"
msgid "　三咲市唯一の地下鉄線。"
msgstr ""

#. Occurrence 9_5:62:13682: scene=9_5
#: 9_5:62
msgctxt "text_id=13682 | speaker=unknown"
msgid "　開通からまだ半年ほどしか経っていない真新しいホームの先端に、彼女たちは<佇|たたず>んでいた。"
msgstr ""

#. Occurrence 9_5:67:13683: scene=9_5
#: 9_5:67
msgctxt "text_id=13683 | speaker=unknown"
msgid "　時刻は午後六時半。"
msgstr ""

#. Occurrence 9_5:73:13684: scene=9_5
#: 9_5:73
msgctxt "text_id=13684 | speaker=unknown"
msgid "　有坂から戻ってきた青子たちは地上には上がらず、既に二十分近い時間をここで浪費していた。"
msgstr ""

#. Occurrence 9_5:94:13685: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0000; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:94
msgctxt "text_id=13685 | speaker=alice"
msgid "「青子」"
msgstr ""

#. Occurrence 9_5:111:13686: scene=9_5
#: 9_5:111
msgctxt "text_id=13686 | speaker=unknown"
msgid "　呆れ声で有珠は語りかける。"
msgstr ""

#. Occurrence 9_5:121:13687: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0000; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:121
msgctxt "text_id=13687 | speaker=aoko"
msgid "「ちょっと待って。あともう一回だけ、ね？」"
msgstr ""

#. Occurrence 9_5:141:13688: scene=9_5
#: 9_5:141
msgctxt "text_id=13688 | speaker=unknown"
msgid "　寒さに震えながら、両手を合わせて有珠にお願いする。"
msgstr ""

#. Occurrence 9_5:146:13689: scene=9_5
#: 9_5:146
msgctxt "text_id=13689 | speaker=unknown"
msgid "　彼女がここまで甘える事は珍しい。"
msgstr ""

#. Occurrence 9_5:151:13690: scene=9_5
#: 9_5:151
msgctxt "text_id=13690 | speaker=unknown"
msgid "　鳶丸あたりが見たら可愛いというより不気味だと用心するに違いない。"
msgstr ""

#. Occurrence 9_5:184:13691: scene=9_5
#: 9_5:184
msgctxt "text_id=13691 | speaker=unknown"
msgid "　青子はホームの先端―――深い闇になっている、レールの先を見つめている。"
msgstr ""

#. Occurrence 9_5:201:13692: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0001; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:201
msgctxt "text_id=13692 | speaker=alice"
msgid "「……貴女の趣味、変わってるわ」"
msgstr ""

#. Occurrence 9_5:218:13693: scene=9_5
#: 9_5:218
msgctxt "text_id=13693 | speaker=unknown"
msgid "　呟いて、仕方なく有珠はベンチに座った。"
msgstr ""

#. Occurrence 9_5:238:13694: scene=9_5
#: 9_5:238
msgctxt "text_id=13694 | speaker=unknown"
msgid "　いつもならひとりで先に帰るところだが、今日は気分がいいので付き合う事にしたらしい。"
msgstr ""

#. Occurrence 9_5:243:13695: scene=9_5
#: 9_5:243
msgctxt "text_id=13695 | speaker=unknown"
msgid "　できるのなら今日はこのまま、すぐに溶けてしまう雪のような手触りであっても、幸せな気分のまま帰りたい。"
msgstr ""

#. Occurrence 9_5:248:13696: scene=9_5
#: 9_5:248
msgctxt "text_id=13696 | speaker=unknown"
msgid "　……穏やかに閉じられた有珠の<目蓋|まぶた>は、そんな気持ちを代弁しているようだった。"
msgstr ""

#. Occurrence 9_5:277:13697: scene=9_5
#: 9_5:277
msgctxt "text_id=13697 | speaker=unknown"
msgid "　かくして、人影のない地下鉄のホームで、ふたりは乗る予定のない電車を待つ事となった。"
msgstr ""

#. Occurrence 9_5:297:13698: scene=9_5
#: 9_5:297
msgctxt "text_id=13698 | speaker=unknown"
msgid "　開通したばかりの地下鉄。"
msgstr ""

#. Occurrence 9_5:302:13699: scene=9_5
#: 9_5:302
msgctxt "text_id=13699 | speaker=unknown"
msgid "　高めの料金設定や、そもそも地下鉄に馴染みのない三咲市の人々の気質もあって、利用客はまだまだ少ない。"
msgstr ""

#. Occurrence 9_5:307:13700: scene=9_5
#: 9_5:307
msgctxt "text_id=13700 | speaker=unknown"
msgid "　活気がないのは問題だが、そのおかげでホームはいまだ新品同様だ。"
msgstr ""

#. Occurrence 9_5:327:13701: scene=9_5
#: 9_5:327
msgctxt "text_id=13701 | speaker=unknown"
msgid "　思えば、人のいない地下鉄はこの上なく原始的だ。"
msgstr ""

#. Occurrence 9_5:333:13702: scene=9_5
#: 9_5:333
msgctxt "text_id=13702 | speaker=unknown"
msgid "　此処はもともと人の住まぬ<安寧|あんねい>の地。"
msgstr ""

#. Occurrence 9_5:338:13703: scene=9_5
#: 9_5:338
msgctxt "text_id=13703 | speaker=unknown"
msgid "　無音にして無生。"
msgstr ""

#. Occurrence 9_5:343:13704: scene=9_5
#: 9_5:343
msgctxt "text_id=13704 | speaker=unknown"
msgid "　物言わぬ微生物たちが息づく、生者には辿り着けぬ<根|ね>の国である。"
msgstr ""

#. Occurrence 9_5:373:13705: scene=9_5
#: 9_5:373
msgctxt "text_id=13705 | speaker=unknown"
msgid "　真白すぎる人工の明かりは生命を感じさせない。"
msgstr ""

#. Occurrence 9_5:378:13706: scene=9_5
#: 9_5:378
msgctxt "text_id=13706 | speaker=unknown"
msgid "　はっきりと光と影に分かれた空洞。"
msgstr ""

#. Occurrence 9_5:383:13707: scene=9_5
#: 9_5:383
msgctxt "text_id=13707 | speaker=unknown"
msgid "　<電車|ふね>は乗客のないまま闇に出航する。"
msgstr ""

#. Occurrence 9_5:388:13708: scene=9_5
#: 9_5:388
msgctxt "text_id=13708 | speaker=unknown"
msgid "　レールに挟まれたホームは、地底の海に造られた桟橋のようだ。"
msgstr ""

#. Occurrence 9_5:393:13709: scene=9_5
#: 9_5:393
msgctxt "text_id=13709 | speaker=unknown"
msgid "　そんな、地上の風景とはかけ離れた場所で、青子は目を<瞑|つむ>って<振動|ふなで>を待つ。"
msgstr ""

#. Occurrence 9_5:428:13710: scene=9_5
#: 9_5:428
msgctxt "text_id=13710 | speaker=unknown"
msgid "　青子は帰宅を少し遅らせて、ホームで休もうと提案した。"
msgstr ""

#. Occurrence 9_5:433:13711: scene=9_5
#: 9_5:433
msgctxt "text_id=13711 | speaker=unknown"
msgid "　理由は単純。"
msgstr ""

#. Occurrence 9_5:438:13712: scene=9_5
#: 9_5:438
msgctxt "text_id=13712 | speaker=unknown"
msgid "　蒼崎青子は地下鉄の通過音に安らぎを覚える、奇妙な趣味を持っていたからだ。"
msgstr ""

#. Occurrence 9_5:470:13713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0001; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:470
msgctxt "text_id=13713 | speaker=aoko"
msgid "「今年はもうライブハウスに行けそうもないし、これぐらいのワガママはいいでしょ」"
msgstr ""

#. Occurrence 9_5:476:13714: scene=9_5
#: 9_5:476
msgctxt "text_id=13714 | speaker=unknown"
msgid "　青子は目を閉じたまま有珠に語りかける。"
msgstr ""

#. Occurrence 9_5:493:13715: scene=9_5
#: 9_5:493
msgctxt "text_id=13715 | speaker=unknown"
msgid "　付き合いで三回ほど電車を見送っている有珠はうなずきもしない。"
msgstr ""

#. Occurrence 9_5:524:13716: scene=9_5
#: 9_5:524
msgctxt "text_id=13716 | speaker=unknown"
msgid "　それきり静寂。"
msgstr ""

#. Occurrence 9_5:529:13717: scene=9_5
#: 9_5:529
msgctxt "text_id=13717 | speaker=unknown"
msgid "　青子はあと数分後の電車の到着を心待ちにしながら。"
msgstr ""

#. Occurrence 9_5:534:13718: scene=9_5
#: 9_5:534
msgctxt "text_id=13718 | speaker=unknown"
msgid "　有珠は、そんな青子に付き合いながらも地下鉄の壁を見つめながら。"
msgstr ""

#. Occurrence 9_5:554:13719: scene=9_5
#: 9_5:554
msgctxt "text_id=13719 | speaker=unknown"
msgid "　掲示板によると、次の電車は五分後に到着予定。"
msgstr ""

#. Occurrence 9_5:559:13720: scene=9_5
#: 9_5:559
msgctxt "text_id=13720 | speaker=unknown"
msgid "　暗い穴からは、カタカタと風の音が響いてくる。"
msgstr ""

#. Occurrence 9_5:593:13721: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0002; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:593
msgctxt "text_id=13721 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_5:598:13722: scene=9_5
#: 9_5:598
msgctxt "text_id=13722 | speaker=unknown"
msgid "　地下鉄のホームは人工の結界だ。"
msgstr ""

#. Occurrence 9_5:606:13723: scene=9_5
#: 9_5:606
msgctxt "text_id=13723 | speaker=unknown"
msgid "　駅員の姿はなく、出入り口にあたる通路はあまりにも狭く、少ない。"
msgstr ""

#. Occurrence 9_5:614:13724: scene=9_5
#: 9_5:614
msgctxt "text_id=13724 | speaker=unknown"
msgid "　結界を張るまでもなく<人避|ひとよ>けは成立している。"
msgstr ""

#. Occurrence 9_5:634:13725: scene=9_5
#: 9_5:634
msgctxt "text_id=13725 | speaker=unknown"
msgid "　地上に通じる階段の前には、いつのまにか六人ほどの人影が立っていた。"
msgstr ""

#. Occurrence 9_5:654:13726: scene=9_5
#: 9_5:654
msgctxt "text_id=13726 | speaker=unknown"
msgid "　―――ただし、全員同じ顔。"
msgstr ""

#. Occurrence 9_5:659:13727: scene=9_5
#: 9_5:659
msgctxt "text_id=13727 | speaker=unknown"
msgid "　一歩も動かず、三日月のような笑顔のまま、ホームにいる有珠たちを眺めている。"
msgstr ""

#. Occurrence 9_5:696:13728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0003; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:696
msgctxt "text_id=13728 | speaker=alice"
msgid "「……<鈍|にぶ>っているにも、程があるわね」"
msgstr ""

#. Occurrence 9_5:702:13729: scene=9_5
#: 9_5:702
msgctxt "text_id=13729 | speaker=unknown"
msgid "　自分への落胆から、静かに有珠はため息をついた。"
msgstr ""

#. Occurrence 9_5:737:13730: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0002; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:737
msgctxt "text_id=13730 | speaker=aoko"
msgid "「？　どうかした、有珠」"
msgstr ""

#. Occurrence 9_5:757:13731: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0004; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:757
msgctxt "text_id=13731 | speaker=alice"
msgid "「……どうもなにも。この駅で降りたのは貴女とわたしだけなの、気付いていた？」"
msgstr ""

#. Occurrence 9_5:778:13732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0003; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:778
msgctxt "text_id=13732 | speaker=aoko"
msgid "「そりゃあね。相変わらず、ここの地下鉄ってば利用客が少ないって…………」"
msgstr ""

#. Occurrence 9_5:783:13733: scene=9_5
#: 9_5:783
msgctxt "text_id=13733 | speaker=unknown"
msgid "　そこまで言いかけて、青子はち、と舌を鳴らした。"
msgstr ""

#. Occurrence 9_5:810:13734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0004; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:810
msgctxt "text_id=13734 | speaker=aoko"
msgid "「で。そう言う有珠はいつ気が付いたの？」"
msgstr ""

#. Occurrence 9_5:826:13735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0005; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:826
msgctxt "text_id=13735 | speaker=alice"
msgid "「……憂鬱なコトにたった今よ。"
msgstr ""

#. Occurrence 9_5:832:13736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0006; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:832
msgctxt "text_id=13736 | speaker=alice"
msgid "　青子ばかり責められないわね。貴女とわたしが一つなら、こんな事もなかったのに」"
msgstr ""

#. Occurrence 9_5:844:13737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0005; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:844
msgctxt "text_id=13737 | speaker=aoko"
msgid "「つまらない喩え話は口にしない」"
msgstr ""

#. Occurrence 9_5:879:13738: scene=9_5
#: 9_5:879
msgctxt "text_id=13738 | speaker=unknown"
msgid "　淡々と、視線も合わさず言葉を交わすふたり。"
msgstr ""

#. Occurrence 9_5:884:13739: scene=9_5
#: 9_5:884
msgctxt "text_id=13739 | speaker=unknown"
msgid "　そんな彼女たちとは対照的に、階段を<塞|ふさ>いでいた人影が動きはじめた。"
msgstr ""

#. Occurrence 9_5:899:13740: scene=9_5
#: 9_5:899
msgctxt "text_id=13740 | speaker=unknown"
msgid "　彼らは一律、二足歩行の生き物である事を忘れたように倒れこみ、四つんばいになって前進する。"
msgstr ""

#. Occurrence 9_5:919:13741: scene=9_5
#: 9_5:919
msgctxt "text_id=13741 | speaker=unknown"
msgid "　……その姿は巨大な<蟻|あり>そのものだ。"
msgstr ""

#. Occurrence 9_5:924:13742: scene=9_5
#: 9_5:924
msgctxt "text_id=13742 | speaker=unknown"
msgid "　ぞろぞろと、次々と。"
msgstr ""

#. Occurrence 9_5:929:13743: scene=9_5
#: 9_5:929
msgctxt "text_id=13743 | speaker=unknown"
msgid "　階段のみならず、レールのある洞穴からもカタカタと音を響かせて大挙してくる。"
msgstr ""

#. Occurrence 9_5:982:13744: scene=9_5
#: 9_5:982
msgctxt "text_id=13744 | speaker=unknown"
msgid "　その数、目測で三十体以上。"
msgstr ""

#. Occurrence 9_5:987:13745: scene=9_5
#: 9_5:987
msgctxt "text_id=13745 | speaker=unknown"
msgid "　おぞましい事に、響いてくる足音は増していくばかりだ。"
msgstr ""

#. Occurrence 9_5:1031:13746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0006; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1031
msgctxt "text_id=13746 | speaker=aoko"
msgid "「信じられない。これだけの自動人形、集めたら<三咲|うち>どころか南<仏|フランス>の一等地も買えるんじゃない？」"
msgstr ""

#. Occurrence 9_5:1049:13747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0007; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1049
msgctxt "text_id=13747 | speaker=alice"
msgid "「……ええ。もっとも、こんな出来じゃ買手は見つからないでしょうけど」"
msgstr ""

#. Occurrence 9_5:1075:13748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0007; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1075
msgctxt "text_id=13748 | speaker=aoko"
msgid "「なんだ、ガラクタはガラクタか」"
msgstr ""

#. Occurrence 9_5:1095:13749: scene=9_5
#: 9_5:1095
msgctxt "text_id=13749 | speaker=unknown"
msgid "　青子の罵倒に応じて、人影の一体が飛び跳ねる。"
msgstr ""

#. Occurrence 9_5:1151:13750: scene=9_5
#: 9_5:1151
msgctxt "text_id=13750 | speaker=unknown"
msgid "　ダンプカーに<撥|は>ねられたような、唐突な突進。"
msgstr ""

#. Occurrence 9_5:1156:13751: scene=9_5
#: 9_5:1156
msgctxt "text_id=13751 | speaker=unknown"
msgid "　有珠は動かず。"
msgstr ""

#. Occurrence 9_5:1181:13752: scene=9_5
#: 9_5:1181
msgctxt "text_id=13752 | speaker=unknown"
msgid "　青子はそれを待っていたかのように、振り向きながら右腕を振るった。"
msgstr ""

#. Occurrence 9_5:1295:13753: scene=9_5
#: 9_5:1295
msgctxt "text_id=13753 | speaker=unknown"
msgid "　青い光弾はたやすく外皮に防がれた。"
msgstr ""

#. Occurrence 9_5:1309:13754: scene=9_5
#: 9_5:1309
msgctxt "text_id=13754 | speaker=unknown"
msgid "　魔力を弾いただけの<魔弾|スナップ>では、この人形たちには通用しない。"
msgstr ""

#. Occurrence 9_5:1315:13755: scene=9_5
#: 9_5:1315
msgctxt "text_id=13755 | speaker=unknown"
msgid "　人影はカエルのように地面に這い、首をくるりと一回転させて<獲物|あおこ>を探し求めている。"
msgstr ""

#. Occurrence 9_5:1336:13756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0008; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1336
msgctxt "text_id=13756 | speaker=aoko"
msgid "「……全部で三十か。悪いけど一人でやらせてもらうわよ有珠。この前のを実力と思われたままじゃ不愉快だ」"
msgstr ""

#. Occurrence 9_5:1360:13757: scene=9_5
#: 9_5:1360
msgctxt "text_id=13757 | speaker=unknown"
msgid "　ホームの端にまで移動して、青子はベンチに座ったままの少女に語りかけた。"
msgstr ""

#. Occurrence 9_5:1380:13758: scene=9_5
#: 9_5:1380
msgctxt "text_id=13758 | speaker=unknown"
msgid "　あの遊園地での反省は山ほどあるが、特に痛恨なのはミラーハウスでの一戦だ。"
msgstr ""

#. Occurrence 9_5:1385:13759: scene=9_5
#: 9_5:1385
msgctxt "text_id=13759 | speaker=unknown"
msgid "　人形戦に関して言うと、青子はまったく戦闘準備をしていなかった。"
msgstr ""

#. Occurrence 9_5:1405:13760: scene=9_5
#: 9_5:1405
msgctxt "text_id=13760 | speaker=unknown"
msgid "　けれど今日は万全の態勢で、フォロー役として有珠までいる。"
msgstr ""

#. Occurrence 9_5:1461:13761: scene=9_5
#: 9_5:1461
msgctxt "text_id=13761 | speaker=unknown"
msgid "　ここで思う存分、雪辱を果たそうと青子は魔術刻印に火を灯し―――。"
msgstr ""

#. Occurrence 9_5:1483:13762: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0008; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1483
msgctxt "text_id=13762 | speaker=alice"
msgid "「私の後ろまで下がって青子。そこにいたら、貴女まで食べてしまう」"
msgstr ""

#. Occurrence 9_5:1489:13763: scene=9_5
#: 9_5:1489
msgctxt "text_id=13763 | speaker=unknown"
msgid "　有珠はそれを、持ち上げた一指だけで停止させた。"
msgstr ""

#. Occurrence 9_5:1564:13764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0009; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1564
msgctxt "text_id=13764 | speaker=aoko"
msgid "「待って―――有珠、それは」"
msgstr ""

#. Occurrence 9_5:1587:13765: scene=9_5
#: 9_5:1587
msgctxt "text_id=13765 | speaker=unknown"
msgid "　地中の深海に、夜の鐘が響いていく。"
msgstr ""

#. Occurrence 9_5:1610:13766: scene=9_5
#: 9_5:1610
msgctxt "text_id=13766 | speaker=unknown"
msgid "　桟橋は<海神|わだつみ>の腕に抱かれるように、"
msgstr ""

#. Occurrence 9_5:1616:13767: scene=9_5
#: 9_5:1616
msgctxt "text_id=13767 | speaker=unknown"
msgid "　白い、"
msgstr ""

msgctxt "text_id=13768 | speaker=unknown"
msgid "　白い粒子に覆われていく。"
msgstr ""

#. Occurrence 9_5:1639:13769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0009; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1639
msgctxt "text_id=13769 | speaker=alice"
msgid "「……青子のやり方じゃ<疵痕|あと>が残るでしょう。"
msgstr ""

#. Occurrence 9_5:1645:13770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0010; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1645
msgctxt "text_id=13770 | speaker=alice"
msgid "　もうじき次の電車も来るし、それに―――」"
msgstr ""

#. Occurrence 9_5:1673:13771: scene=9_5
#: 9_5:1673
msgctxt "text_id=13771 | speaker=unknown"
msgid "　白いヴェールの向こうで、不確かに伸び上がる少女のカタチ。"
msgstr ""

#. Occurrence 9_5:1728:13772: scene=9_5
#: 9_5:1728
msgctxt "text_id=13772 | speaker=unknown"
msgid "　悲壮な<群舞|バレエ>のようだ。"
msgstr ""

#. Occurrence 9_5:1733:13773: scene=9_5
#: 9_5:1733
msgctxt "text_id=13773 | speaker=unknown"
msgid "　<主役|プリマ>の周りを囲む人形たちは異常を察してざわめいている。"
msgstr ""

#. Occurrence 9_5:1738:13774: scene=9_5
#: 9_5:1738
msgctxt "text_id=13774 | speaker=unknown"
msgid "　彼らとて人間外の、神秘に属する器物である。"
msgstr ""

#. Occurrence 9_5:1743:13775: scene=9_5
#: 9_5:1743
msgctxt "text_id=13775 | speaker=unknown"
msgid "　あの少女が恐れるに足りるモノだと、人間である青子より何倍も悟っている。"
msgstr ""

#. Occurrence 9_5:1802:13776: scene=9_5
#: 9_5:1802
msgctxt "text_id=13776 | speaker=unknown"
msgid "　なので逃げる。"
msgstr ""

#. Occurrence 9_5:1807:13777: scene=9_5
#: 9_5:1807
msgctxt "text_id=13777 | speaker=unknown"
msgid "　人形たちの主人も、危険を感じたのなら撤退しろと言っていたのだ。"
msgstr ""

#. Occurrence 9_5:1844:13778: scene=9_5
#: 9_5:1844
msgctxt "text_id=13778 | speaker=unknown"
msgid "　けれど、"
msgstr ""

msgctxt "text_id=13779 | speaker=unknown"
msgid "もう動けない。<主役|プリマ>を見守るダンサーたちは、のきなみ、"
msgstr ""

msgctxt "text_id=13780 | speaker=unknown"
msgid "アキレス腱を外されてしまったらしい。"
msgstr ""

#. Occurrence 9_5:1872:13781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0011; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1872
msgctxt "text_id=13781 | speaker=alice"
msgid "「―――それに。"
msgstr ""

#. Occurrence 9_5:1922:13782: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0012; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1922
msgctxt "text_id=13782 | speaker=alice"
msgid "　気分を台無しにされたのは、貴女だけじゃないわ」"
msgstr ""

#. Occurrence 9_5:1942:13783: scene=9_5
#: 9_5:1942
msgctxt "text_id=13783 | speaker=unknown"
msgid "　外される黒い手袋。"
msgstr ""

#. Occurrence 9_5:1947:13784: scene=9_5
#: 9_5:1947
msgctxt "text_id=13784 | speaker=unknown"
msgid "　洋館の中とは一変して、外では異常な寒がりである彼女の防寒ぶりは凄まじい。"
msgstr ""

#. Occurrence 9_5:1952:13785: scene=9_5
#: 9_5:1952
msgctxt "text_id=13785 | speaker=unknown"
msgid "　二枚重ねの手袋が、ぱさりとホームに落ちる。"
msgstr ""

#. Occurrence 9_5:1986:13786: scene=9_5
#: 9_5:1986
msgctxt "text_id=13786 | speaker=unknown"
msgid "　濃度を増していく白い闇。"
msgstr ""

#. Occurrence 9_5:2016:13787: scene=9_5
#: 9_5:2016
msgctxt "text_id=13787 | speaker=unknown"
msgid "　<見|ギ><逃|チ><し|ギ><て|チ><く|ギ><れ|チ>、と悲鳴をあげる影の集団。"
msgstr ""

#. Occurrence 9_5:2102:13788: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0013; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2102
msgctxt "text_id=13788 | speaker=alice"
msgid "　　　　“さあ―――ごっこ遊びをしましょう”"
msgstr ""

#. Occurrence 9_5:2122:13789: scene=9_5
#: 9_5:2122
msgctxt "text_id=13789 | speaker=unknown"
msgid "　何もかも不確かな、濃霧に映し出される暗黒童話。"
msgstr ""

#. Occurrence 9_5:2127:13790: scene=9_5
#: 9_5:2127
msgctxt "text_id=13790 | speaker=unknown"
msgid "　その中で。"
msgstr ""

#. Occurrence 9_5:2134:13791: scene=9_5
#: 9_5:2134
msgctxt "text_id=13791 | speaker=unknown"
msgid "　<凶歌|まがうた>のような彼女の声だけが、血のように<鮮明|リアル>だった。"
msgstr ""

#. Occurrence 9_5:2226:13792: scene=9_5
#: 9_5:2226
msgctxt "text_id=13792 | speaker=unknown"
msgid "　がつがつ／ざりざり／ぎしゃむ。"
msgstr ""

#. Occurrence 9_5:2236:13793: scene=9_5
#: 9_5:2236
msgctxt "text_id=13793 | speaker=unknown"
msgid "　最後に残った人影が消失した。"
msgstr ""

#. Occurrence 9_5:2251:13794: scene=9_5
#: 9_5:2251
msgctxt "text_id=13794 | speaker=unknown"
msgid "　壁には／床には／天井には／"
msgstr ""

#. Occurrence 9_5:2260:13795: scene=9_5
#: 9_5:2260
msgctxt "text_id=13795 | speaker=unknown"
msgid "　あえなく、異質な<擬音|オノマトペ>が染みついている。"
msgstr ""

#. Occurrence 9_5:2307:13796: scene=9_5
#: 9_5:2307
msgctxt "text_id=13796 | speaker=unknown"
msgid "　……彼らの悲鳴は、<拭|ぬぐ>っても消えない血の跡のようだ。"
msgstr ""

#. Occurrence 9_5:2312:13797: scene=9_5
#: 9_5:2312
msgctxt "text_id=13797 | speaker=unknown"
msgid "　三十体におよぶ人形たちは、速やかに、けれど味わうようにゆっくりと、得体の知れない怪物に<咀嚼|そしゃく>された。"
msgstr ""

#. Occurrence 9_5:2317:13798: scene=9_5
#: 9_5:2317
msgctxt "text_id=13798 | speaker=unknown"
msgid "　わずか一体分……それも片腕一本だけが、淋しくホームに残されている。"
msgstr ""

#. Occurrence 9_5:2354:13799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0010; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2354
msgctxt "text_id=13799 | speaker=aoko"
msgid "「……持ってきてたの、アレ？」"
msgstr ""

#. Occurrence 9_5:2360:13800: scene=9_5
#: 9_5:2360
msgctxt "text_id=13800 | speaker=unknown"
msgid "　青子は嫌悪を隠さずに、傍らの少女に語りかける。"
msgstr ""

#. Occurrence 9_5:2406:13801: scene=9_5
#: 9_5:2406
msgctxt "text_id=13801 | speaker=unknown"
msgid "　―――濃霧の怪物。"
msgstr ""

#. Occurrence 9_5:2412:13802: scene=9_5
#: 9_5:2412
msgctxt "text_id=13802 | speaker=unknown"
msgid "　三体の<貴重品|プロイキッシャー>の一つ、マインスターの薔薇の猟犬。"
msgstr ""

#. Occurrence 9_5:2417:13803: scene=9_5
#: 9_5:2417
msgctxt "text_id=13803 | speaker=unknown"
msgid "　それが、いま吹き荒れた暴力の名称だ。"
msgstr ""

#. Occurrence 9_5:2429:13804: scene=9_5
#: 9_5:2429
msgctxt "text_id=13804 | speaker=unknown"
msgid "　青子の言葉に刺があるのは、有珠が、その正体にあたる器物を持ち歩いていたからだ。"
msgstr ""

#. Occurrence 9_5:2461:13805: scene=9_5
#: 9_5:2461
msgctxt "text_id=13805 | speaker=unknown"
msgid "　三大のプロイはそれだけで強力な呪力を放つ。"
msgstr ""

#. Occurrence 9_5:2466:13806: scene=9_5
#: 9_5:2466
msgctxt "text_id=13806 | speaker=unknown"
msgid "　防衛戦ならともかく、今日のようなプライベートで持ち歩かれては、相方である青子も面白くはない。"
msgstr ""

#. Occurrence 9_5:2472:13807: scene=9_5
#: 9_5:2472
msgctxt "text_id=13807 | speaker=unknown"
msgid "　大げさな表現ではなく、外食の際、巨大な爆弾を忍ばせているようなものなのだから。"
msgstr ""

#. Occurrence 9_5:2508:13808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0011; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2508
msgctxt "text_id=13808 | speaker=aoko"
msgid "「ま、次からは一言お願いね。"
msgstr ""

#. Occurrence 9_5:2514:13809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0012; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2514
msgctxt "text_id=13809 | speaker=aoko"
msgid "　他のプロイならいいけど、今の<玩具|ヤツ>だけは別よ。できれば洋館限定にしてほしいぐらい」"
msgstr ""

#. Occurrence 9_5:2556:13810: scene=9_5
#: 9_5:2556
msgctxt "text_id=13810 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence 9_5:2569:13811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0014; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2569
msgctxt "text_id=13811 | speaker=alice"
msgid "悪かったわ。でも、最近なにも食べさせてなかったから」"
msgstr ""

#. Occurrence 9_5:2600:13812: scene=9_5
#: 9_5:2600
msgctxt "text_id=13812 | speaker=unknown"
msgid "　有珠はホームに転がった人形の腕へと歩いていく。"
msgstr ""

#. Occurrence 9_5:2605:13813: scene=9_5
#: 9_5:2605
msgctxt "text_id=13813 | speaker=unknown"
msgid "　たしかに、今のは食事以外の何物でもなかった。"
msgstr ""

#. Occurrence 9_5:2628:13814: scene=9_5
#: 9_5:2628
msgctxt "text_id=13814 | speaker=unknown"
msgid "　食べる者も見えなければ、食べられる物も血を流さないプラスチックな<情事|もの>だったけれど。"
msgstr ""

#. Occurrence 9_5:2649:13815: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0015; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2649
msgctxt "text_id=13815 | speaker=alice"
msgid "「青子、ちょっと」"
msgstr ""

#. Occurrence 9_5:2669:13816: scene=9_5
#: 9_5:2669
msgctxt "text_id=13816 | speaker=unknown"
msgid "　残された人形の右腕を拾い上げ、青子を呼びつける。"
msgstr ""

#. Occurrence 9_5:2708:13817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0016; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2708
msgctxt "text_id=13817 | speaker=alice"
msgid "「これを見て。わたしたちは今まで、相手を人形<遣|つか>いと思っていたけど―――正確には違ったみたい。"
msgstr ""

#. Occurrence 9_5:2720:13818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0017; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2720
msgctxt "text_id=13818 | speaker=alice"
msgid "　分かる？　この人形たちは新しすぎる。"
msgstr ""

#. Occurrence 9_5:2732:13819: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0018; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2732
msgctxt "text_id=13819 | speaker=alice"
msgid "　この子たちが造られたのは十七世紀以後よ。……それはそれで、信じがたいコトだけど」"
msgstr ""

#. Occurrence 9_5:2744:13820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0013; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2744
msgctxt "text_id=13820 | speaker=aoko"
msgid "「なんですって？」"
msgstr ""

#. Occurrence 9_5:2791:13821: scene=9_5
#: 9_5:2791
msgctxt "text_id=13821 | speaker=unknown"
msgid "　……矛盾した話ではあるが、<自動人形|オートマタ>は古いものほど性能が良い。"
msgstr ""

#. Occurrence 9_5:2796:13822: scene=9_5
#: 9_5:2796
msgctxt "text_id=13822 | speaker=unknown"
msgid "　十七世紀以後、人形・人体模造の魔術概念が衰退した結果、魔術戦に堪えうる<自動人形|オートマタ>の製造は困難になったからだ。"
msgstr ""

#. Occurrence 9_5:2820:13823: scene=9_5
#: 9_5:2820
msgctxt "text_id=13823 | speaker=unknown"
msgid "　近年ではオートマタを一体造るのなら、たとえ低級でも使い魔を錬成した方が遥かにコストが安く、優秀な出来になる。"
msgstr ""

#. Occurrence 9_5:2825:13824: scene=9_5
#: 9_5:2825
msgctxt "text_id=13824 | speaker=unknown"
msgid "　故に、この時代の人形遣いは十七世紀以前に造られた作品を蒐集し、手足とするのが常になっていた。"
msgstr ""

#. Occurrence 9_5:2830:13825: scene=9_5
#: 9_5:2830
msgctxt "text_id=13825 | speaker=unknown"
msgid "　自動人形に高値がつくのは、戦闘品としては時代遅れだが、稀少品としての価値がある為である。"
msgstr ""

#. Occurrence 9_5:2863:13826: scene=9_5
#: 9_5:2863
msgctxt "text_id=13826 | speaker=unknown"
msgid "　が。"
msgstr ""

#. Occurrence 9_5:2870:13827: scene=9_5
#: 9_5:2870
msgctxt "text_id=13827 | speaker=unknown"
msgid "その稀少品を、敵魔術師は湯水のように、それこそ使い捨てのコマのように扱ってきた。"
msgstr ""

#. Occurrence 9_5:2875:13828: scene=9_5
#: 9_5:2875
msgctxt "text_id=13828 | speaker=unknown"
msgid "　その事実から、今回の敵は“莫大な資金とコレクションを持ちながら、管理地を与えられていない成り上がり者の魔術師である”"
msgstr ""

#. Occurrence 9_5:2880:13829: scene=9_5
#: 9_5:2880
msgctxt "text_id=13829 | speaker=unknown"
msgid "　そう有珠たちは予想していたのだが―――"
msgstr ""

#. Occurrence 9_5:2901:13830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0019; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2901
msgctxt "text_id=13830 | speaker=alice"
msgid "「それともう一つ。"
msgstr ""

#. Occurrence 9_5:2927:13831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0020; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2927
msgctxt "text_id=13831 | speaker=alice"
msgid "　この内部<術式|こうぞう>は三咲市の結界に似ているわ。"
msgstr ""

#. Occurrence 9_5:2939:13832: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0021; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2939
msgctxt "text_id=13832 | speaker=alice"
msgid "　……まるで自分たちこそが、この街を守る兵士だって主張するぐらい」"
msgstr ""

#. Occurrence 9_5:2959:13833: scene=9_5
#: 9_5:2959
msgctxt "text_id=13833 | speaker=unknown"
msgid "　霧を払いながらやってきた青子へ、有珠は証拠品を差しだした。"
msgstr ""

#. Occurrence 9_5:3012:13834: scene=9_5
#: 9_5:3012
msgctxt "text_id=13834 | speaker=unknown"
msgid "　心底からの驚きと、瞬間の理解。"
msgstr ""

#. Occurrence 9_5:3052:13835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0014; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3052
msgctxt "text_id=13835 | speaker=aoko"
msgid "「……そう。"
msgstr ""

msgctxt "text_id=13836 | speaker=unknown"
msgid "そういう事なのね」"
msgstr ""

#. Occurrence 9_5:3082:13837: scene=9_5
#: 9_5:3082
msgctxt "text_id=13837 | speaker=unknown"
msgid "　青子はいまいましげに呟くと、人形の腕をホームに叩きつけた。"
msgstr ""

#. Occurrence 9_5:3087:13838: scene=9_5
#: 9_5:3087
msgctxt "text_id=13838 | speaker=unknown"
msgid "　彼女の顔には怒りと、かすかな恐れが混ざっている。"
msgstr ""

#. Occurrence 9_5:3108:13839: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0015; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3108
msgctxt "text_id=13839 | speaker=aoko"
msgid "「惜し気もなく骨董品を出してくると思ったら、そもそも出し惜しむ程のものじゃなかったワケか。"
msgstr ""

#. Occurrence 9_5:3141:13840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0016; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3141
msgctxt "text_id=13840 | speaker=aoko"
msgid "　……チッ。たしかにあの女なら<祖父|まち>の結界にも反応しないし、私の欠点も知ってて当然。支点の退去だって簡単にやってのけるわよね。"
msgstr ""

#. Occurrence 9_5:3147:13841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0017; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3147
msgctxt "text_id=13841 | speaker=aoko"
msgid "　だって―――」"
msgstr ""

#. Occurrence 9_5:3187:13842: scene=9_5
#: 9_5:3187
msgctxt "text_id=13842 | speaker=unknown"
msgid "　狂気を含んだ独白に、有珠は静かに瞳を曇らせる。"
msgstr ""

#. Occurrence 9_5:3199:13843: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0022; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:3199
msgctxt "text_id=13843 | speaker=alice"
msgid "「青子。これを造ったのは、そうなの？」"
msgstr ""

#. Occurrence 9_5:3220:13844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0018; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3220
msgctxt "text_id=13844 | speaker=aoko"
msgid "「ええ。昔から物を造る事に関しちゃズバ抜けていたからね、あの人は」"
msgstr ""

#. Occurrence 9_5:3243:13845: scene=9_5
#: 9_5:3243
msgctxt "text_id=13845 | speaker=unknown"
msgid "　青子は人形の腕を睨みつける。"
msgstr ""

#. Occurrence 9_5:3248:13846: scene=9_5
#: 9_5:3248
msgctxt "text_id=13846 | speaker=unknown"
msgid "　人形の持ち主と、今までそれに気が付かなかった自分自身を責めるように。"
msgstr ""

#. Occurrence 9_5:3277:13847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0019; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3277
msgctxt "text_id=13847 | speaker=aoko"
msgid "「……でも、ようやく合点がいった。"
msgstr ""

#. Occurrence 9_5:3283:13848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0020; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3283
msgctxt "text_id=13848 | speaker=aoko"
msgid "　認めたくないけど、今回の敵は間違いなく私の<姉貴|あねき>。"
msgstr ""

#. Occurrence 9_5:3289:13849: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0021; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3289
msgctxt "text_id=13849 | speaker=aoko"
msgid "　この土地の<元|もと>継承者、蒼崎<橙子|とうこ>その人よ、有珠」"
msgstr ""

#. Occurrence 9_5:3347:13850: scene=9_5
#: 9_5:3347
msgctxt "text_id=13850 | speaker=unknown"
msgid "　人気の絶えた地下の歩廊で。"
msgstr ""

#. Occurrence 9_5:3352:13851: scene=9_5
#: 9_5:3352
msgctxt "text_id=13851 | speaker=unknown"
msgid "　負の念を噛むように、青子はそう言い切った。"
msgstr ""

#. Occurrence 9_6:97:13852: scene=9_6
#: 9_6:97
msgctxt "text_id=13852 | speaker=unknown"
msgid "　少しだけ時間を巻き戻して、久遠寺邸。"
msgstr ""

#. Occurrence 9_6:102:13853: scene=9_6
#: 9_6:102
msgctxt "text_id=13853 | speaker=unknown"
msgid "　再生していたビデオが終わる。"
msgstr ""

#. Occurrence 9_6:107:13854: scene=9_6
#: 9_6:107
msgctxt "text_id=13854 | speaker=unknown"
msgid "　耳障りなノイズは停止ボタンを押すまでもなく、自動的に停止した。"
msgstr ""

#. Occurrence 9_6:132:13855: scene=9_6
#: 9_6:132
msgctxt "text_id=13855 | speaker=unknown"
msgid "　ブラウン管に映るのは、テーブルをはさんで談話する草十郎と、蒼崎橙子の姿だけ。"
msgstr ""

#. Occurrence 9_6:162:13856: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0000; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:162
msgctxt "text_id=13856 | speaker=touko"
msgid "「……秘密を知られたから宣誓なしの直接攻撃、ね……懐柔策を考えもしないのは青子らしいけど」"
msgstr ""

#. Occurrence 9_6:182:13857: scene=9_6
#: 9_6:182
msgctxt "text_id=13857 | speaker=unknown"
msgid "　呆れているのか、どうでもいいのか。"
msgstr ""

#. Occurrence 9_6:200:13858: scene=9_6
#: 9_6:200
msgctxt "text_id=13858 | speaker=unknown"
msgid "　蒼崎橙子は紅茶を口にしながら、草十郎の体験談を聞いている。"
msgstr ""

#. Occurrence 9_6:205:13859: scene=9_6
#: 9_6:205
msgctxt "text_id=13859 | speaker=unknown"
msgid "　失敗だらけだった遊園地での逸話を、不出来な紅茶で飲み下すように。"
msgstr ""

#. Occurrence 9_6:239:13860: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0001; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:239
msgctxt "text_id=13860 | speaker=touko"
msgid "「ありがとう、参考になったわ。"
msgstr ""

#. Occurrence 9_6:245:13861: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0002; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:245
msgctxt "text_id=13861 | speaker=touko"
msgid "　ここしばらく青子とは顔を合わせていなかったから、あの子がどんな風に成長したかなんて、想像するしかなかったし」"
msgstr ""

#. Occurrence 9_6:277:13862: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0003; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:277
msgctxt "text_id=13862 | speaker=touko"
msgid "「それと、いちおう肉親としてあやまっておかないとね。"
msgstr ""

#. Occurrence 9_6:283:13863: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0004; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:283
msgctxt "text_id=13863 | speaker=touko"
msgid "　災難に付き合わせて悪かったわ草十郎くん。"
msgstr ""

#. Occurrence 9_6:290:13864: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0005; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:290
msgctxt "text_id=13864 | speaker=touko"
msgid "ほんと、あの子ったら昔っから迷いってものがなかったから」"
msgstr ""

#. Occurrence 9_6:309:13865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0000; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:309
msgctxt "text_id=13865 | speaker=soujuurou"
msgid "「なさすぎると思います」"
msgstr ""

#. Occurrence 9_6:329:13866: scene=9_6
#: 9_6:329
msgctxt "text_id=13866 | speaker=unknown"
msgid "　草十郎は憮然とした顔で抗議するも、会話そのものは楽しいものだった。"
msgstr ""

#. Occurrence 9_6:346:13867: scene=9_6
#: 9_6:346
msgctxt "text_id=13867 | speaker=unknown"
msgid "　ふたりきりになってもう一時間近く経過するが、話題には事欠かない。"
msgstr ""

#. Occurrence 9_6:351:13868: scene=9_6
#: 9_6:351
msgctxt "text_id=13868 | speaker=unknown"
msgid "　話にのぼるのは青子の事だけだったが、その青子が何かと話題になりやすかったのだ。"
msgstr ""

#. Occurrence 9_6:385:13869: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0006; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:385
msgctxt "text_id=13869 | speaker=touko"
msgid "「ところで、さっきから気になってる事があるんだけど。"
msgstr ""

#. Occurrence 9_6:385:13870: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0006; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:385
msgctxt "text_id=13870 | speaker=touko"
msgid "　訊いていいかな？」"
msgstr ""

#. Occurrence 9_6:391:13871: scene=9_6
#: 9_6:391
msgctxt "text_id=13871 | speaker=unknown"
msgid "　礼儀正しい姿勢のまま、目だけが好奇心に輝いている。"
msgstr ""

#. Occurrence 9_6:396:13872: scene=9_6
#: 9_6:396
msgctxt "text_id=13872 | speaker=unknown"
msgid "　その人あたりの良さに、やっぱりドギマギしてしまう草十郎だった。"
msgstr ""

#. Occurrence 9_6:431:13873: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0001; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:431
msgctxt "text_id=13873 | speaker=soujuurou"
msgid "「気になってる事……ですか？」"
msgstr ""

#. Occurrence 9_6:437:13874: scene=9_6
#: 9_6:437
msgctxt "text_id=13874 | speaker=unknown"
msgid "　結果、気をつけても敬語調になってしまう。"
msgstr ""

#. Occurrence 9_6:442:13875: scene=9_6
#: 9_6:442
msgctxt "text_id=13875 | speaker=unknown"
msgid "　そんな草十郎が微笑ましいのか、橙子は親しみをこめて頷いた。"
msgstr ""

#. Occurrence 9_6:474:13876: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0007; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:474
msgctxt "text_id=13876 | speaker=touko"
msgid "「ええ。一度目はダッシュで逃げられて驚いたけど、今日は違った意味で驚かされた。"
msgstr ""

#. Occurrence 9_6:493:13877: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0008; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:493
msgctxt "text_id=13877 | speaker=touko"
msgid "　ね、そういうのが若い子たちの<流行|はやり>なの？」"
msgstr ""

#. Occurrence 9_6:517:13878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0002; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:517
msgctxt "text_id=13878 | speaker=soujuurou"
msgid "「はい？」"
msgstr ""

#. Occurrence 9_6:539:13879: scene=9_6
#: 9_6:539
msgctxt "text_id=13879 | speaker=unknown"
msgid "　橙子の視線は草十郎の首……青子から貰った首輪に向けられている。"
msgstr ""

#. Occurrence 9_6:569:13880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0009; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:569
msgctxt "text_id=13880 | speaker=touko"
msgid "「新手のチョーカー？　でも、どこから見ても、ほら」"
msgstr ""

#. Occurrence 9_6:575:13881: scene=9_6
#: 9_6:575
msgctxt "text_id=13881 | speaker=unknown"
msgid "　言いにくそうに言葉をにごす眼鏡の美女。"
msgstr ""

#. Occurrence 9_6:580:13882: scene=9_6
#: 9_6:580
msgctxt "text_id=13882 | speaker=unknown"
msgid "　年頃の少年がこういった<装飾|アクセ>をするのはあと十年……<Ｖ系|ヴィジュアル　 　>の台頭を待たねばならないのだが、それは置いておくとして。"
msgstr ""

#. Occurrence 9_6:617:13883: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0003; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:617
msgctxt "text_id=13883 | speaker=soujuurou"
msgid "「まさか。どこから見ても首輪ですよ。犬用の」"
msgstr ""

#. Occurrence 9_6:636:13884: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0010; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:636
msgctxt "text_id=13884 | speaker=touko"
msgid "「やっぱり？　けどその首輪、すごく可愛いわ。よく似合ってるけど、自分でつけたの？」"
msgstr ""

#. Occurrence 9_6:664:13885: scene=9_6
#: 9_6:664
msgctxt "text_id=13885 | speaker=unknown"
msgid "　まじまじとベルトを観察する橙子。"
msgstr ""

#. Occurrence 9_6:669:13886: scene=9_6
#: 9_6:669
msgctxt "text_id=13886 | speaker=unknown"
msgid "　今までは何も感じなかったクセに、草十郎は少しだけ照れている。"
msgstr ""

#. Occurrence 9_6:690:13887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0004; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:690
msgctxt "text_id=13887 | speaker=soujuurou"
msgid "「はい。つけたのは、自分ですけど」"
msgstr ""

#. Occurrence 9_6:702:13888: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0011; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:702
msgctxt "text_id=13888 | speaker=touko"
msgid "「そうじゃなくて、誰から貰ったの？　青子？　それとも久遠寺さん？」"
msgstr ""

#. Occurrence 9_6:722:13889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0005; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:722
msgctxt "text_id=13889 | speaker=soujuurou"
msgid "「くれたのは青子ですね」"
msgstr ""

#. Occurrence 9_6:727:13890: scene=9_6
#: 9_6:727
msgctxt "text_id=13890 | speaker=unknown"
msgid "　きっぱりと答える草十郎に、橙子はそう、と満足げに呟いた。"
msgstr ""

#. Occurrence 9_6:769:13891: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0012; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:769
msgctxt "text_id=13891 | speaker=touko"
msgid "「……つまり、君は青子の持ち物な訳か」"
msgstr ""

#. Occurrence 9_6:775:13892: scene=9_6
#: 9_6:775
msgctxt "text_id=13892 | speaker=unknown"
msgid "　呟いた声は冷たい。それこそ、ここまで打ち解けた雰囲気を一変させるような。"
msgstr ""

#. Occurrence 9_6:794:13893: scene=9_6
#: 9_6:794
msgctxt "text_id=13893 | speaker=unknown"
msgid "　そんな橙子の鋭さに気づきもしないで、草十郎は頷いた。"
msgstr ""

#. Occurrence 9_6:805:13894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0006; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:805
msgctxt "text_id=13894 | speaker=soujuurou"
msgid "「なんでも所有されてるそうです」"
msgstr ""

#. Occurrence 9_6:848:13895: scene=9_6
#: 9_6:848
msgctxt "text_id=13895 | speaker=unknown"
msgid "　他人事のように言う草十郎に、橙子はまた笑いだした。"
msgstr ""

#. Occurrence 9_6:867:13896: scene=9_6
#: 9_6:867
msgctxt "text_id=13896 | speaker=unknown"
msgid "　些細な事に笑いだす奇癖を、この人物は持っているらしい。"
msgstr ""

#. Occurrence 9_6:872:13897: scene=9_6
#: 9_6:872
msgctxt "text_id=13897 | speaker=unknown"
msgid "　ひとしきり笑い終わった後、橙子は<空|から>になったティーカップを手に取った。"
msgstr ""

#. Occurrence 9_6:904:13898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0013; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:904
msgctxt "text_id=13898 | speaker=touko"
msgid "「じゃ、これも青子のでしょ？　青っていう名前にコンプレックスがある癖に、青い物がわりと好きだから」"
msgstr ""

#. Occurrence 9_6:910:13899: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0007; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:910
msgctxt "text_id=13899 | speaker=soujuurou"
msgid "「そうですけど。……おかわりしますか？"
msgstr ""

#. Occurrence 9_6:916:13900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0008; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:916
msgctxt "text_id=13900 | speaker=soujuurou"
msgid "　ふたりとも、まだ帰ってきそうにありませんから」"
msgstr ""

#. Occurrence 9_6:933:13901: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0014; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:933
msgctxt "text_id=13901 | speaker=touko"
msgid "「いいえ、そろそろ帰ってくる頃よ。そういう風に仕向けたから」"
msgstr ""

#. Occurrence 9_6:954:13902: scene=9_6
#: 9_6:954
msgctxt "text_id=13902 | speaker=unknown"
msgid "　あ、そうなんですか、と草十郎は相づちを打つ。"
msgstr ""

#. Occurrence 9_6:959:13903: scene=9_6
#: 9_6:959
msgctxt "text_id=13903 | speaker=unknown"
msgid "　……打って、今の言葉のおかしさに首を傾げた。"
msgstr ""

#. Occurrence 9_6:990:13904: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0009; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:990
msgctxt "text_id=13904 | speaker=soujuurou"
msgid "「橙子さん？」"
msgstr ""

#. Occurrence 9_6:995:13905: scene=9_6
#: 9_6:995
msgctxt "text_id=13905 | speaker=unknown"
msgid "　聞き返す草十郎に、橙子は一度だけ嘆息する。"
msgstr ""

#. Occurrence 9_6:1029:13906: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0015; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1029
msgctxt "text_id=13906 | speaker=touko"
msgid "「ごめんね、草十郎くん。眼鏡、外してもいいかしら？」"
msgstr ""

#. Occurrence 9_6:1035:13907: scene=9_6
#: 9_6:1035
msgctxt "text_id=13907 | speaker=unknown"
msgid "　なんでそんな事を謝るんだろう、と思いつつ、草十郎はどうぞ、と促す。"
msgstr ""

#. Occurrence 9_6:1047:13908: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0016; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1047
msgctxt "text_id=13908 | speaker=touko"
msgid "「それじゃあ、お言葉に甘えて。"
msgstr ""

#. Occurrence 9_6:1053:13909: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0017; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1053
msgctxt "text_id=13909 | speaker=touko"
msgid "　もう少しぐらいは、君の反応を見ていたかったけど」"
msgstr ""

#. Occurrence 9_6:1088:13910: scene=9_6
#: 9_6:1088
msgctxt "text_id=13910 | speaker=unknown"
msgid "　橙子の指が眼鏡の<蔓|つる>に触れる。"
msgstr ""

#. Occurrence 9_6:1093:13911: scene=9_6
#: 9_6:1093
msgctxt "text_id=13911 | speaker=unknown"
msgid "　彼女の長い指は、よく見ると傷があった。"
msgstr ""

#. Occurrence 9_6:1098:13912: scene=9_6
#: 9_6:1098
msgctxt "text_id=13912 | speaker=unknown"
msgid "　細かな、年月を積み重ねた切り傷だ。"
msgstr ""

#. Occurrence 9_6:1125:13913: scene=9_6
#: 9_6:1125
msgctxt "text_id=13913 | speaker=unknown"
msgid "　その指が眼鏡を外すより早く、彼女の眼鏡はひとりでに壊れて落ちた。"
msgstr ""

#. Occurrence 9_6:1130:13914: scene=9_6
#: 9_6:1130
msgctxt "text_id=13914 | speaker=unknown"
msgid "　驚く暇もない。"
msgstr ""

#. Occurrence 9_6:1135:13915: scene=9_6
#: 9_6:1135
msgctxt "text_id=13915 | speaker=unknown"
msgid "　フレームは粉々に砕けて、眼鏡は彼女の顔を滑り落ちて、その<両股|あし>に不時着する。"
msgstr ""

#. Occurrence 9_6:1203:13916: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0018; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1203
msgctxt "text_id=13916 | speaker=touko"
msgid "「……やるもんだ。三十体を一瞬とはね」"
msgstr ""

#. Occurrence 9_6:1209:13917: scene=9_6
#: 9_6:1209
msgctxt "text_id=13917 | speaker=unknown"
msgid "　そう呟いた橙子は、今までの彼女ではなかった。"
msgstr ""

#. Occurrence 9_6:1217:13918: scene=9_6
#: 9_6:1217
msgctxt "text_id=13918 | speaker=unknown"
msgid "　眼鏡が外れただけ。それだけなのに、今までの彼女の趣は完全に消え去っていた。"
msgstr ""

#. Occurrence 9_6:1237:13919: scene=9_6
#: 9_6:1237
msgctxt "text_id=13919 | speaker=unknown"
msgid "　先ほどまでの温かな印象は何処にもない。"
msgstr ""

#. Occurrence 9_6:1242:13920: scene=9_6
#: 9_6:1242
msgctxt "text_id=13920 | speaker=unknown"
msgid "　そこにいるのは、<在|い>るだけで空気を黒く<淀|よど>ませる、ひとりの醜悪な魔術師だった。"
msgstr ""

#. Occurrence 9_6:1294:13921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0010; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1294
msgctxt "text_id=13921 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence 9_6:1299:13922: scene=9_6
#: 9_6:1299
msgctxt "text_id=13922 | speaker=unknown"
msgid "　草十郎はソファーに座ったままで、言葉もない。"
msgstr ""

#. Occurrence 9_6:1314:13923: scene=9_6
#: 9_6:1314
msgctxt "text_id=13923 | speaker=unknown"
msgid "　もはや別人になった橙子は、そんな草十郎を性悪そうに眺めている。"
msgstr ""

#. Occurrence 9_6:1334:13924: scene=9_6
#: 9_6:1334
msgctxt "text_id=13924 | speaker=unknown"
msgid "　青子が彼を殺そうとした時以上の敵意と魔力を、これみよがしに立ち<昇|のぼ>らせる。"
msgstr ""

#. Occurrence 9_6:1354:13925: scene=9_6
#: 9_6:1354
msgctxt "text_id=13925 | speaker=unknown"
msgid "　この少年が自分の変化にどんな反応を示すのか、その怯えや豹変を楽しむように。"
msgstr ""

#. Occurrence 9_6:1371:13926: scene=9_6
#: 9_6:1371
msgctxt "text_id=13926 | speaker=unknown"
msgid "　しかし。そんなまっとうな<愉悦|かんがえ>は、彼にはまったく適用されなかった。"
msgstr ""

#. Occurrence 9_6:1407:13927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0011; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1407
msgctxt "text_id=13927 | speaker=soujuurou"
msgid "「眼鏡、壊れましたね」"
msgstr ""

#. Occurrence 9_6:1412:13928: scene=9_6
#: 9_6:1412
msgctxt "text_id=13928 | speaker=unknown"
msgid "　いやぁ驚いた、とばかりに口走る草十郎。"
msgstr ""

#. Occurrence 9_6:1431:13929: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0019; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1431
msgctxt "text_id=13929 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_6:1436:13930: scene=9_6
#: 9_6:1436
msgctxt "text_id=13930 | speaker=unknown"
msgid "　<予想|テンポ>を崩したのか、<煙草|シガレット>を取りだそうとした橙子の手が止まってしまう。"
msgstr ""

#. Occurrence 9_6:1470:13931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0012; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1470
msgctxt "text_id=13931 | speaker=soujuurou"
msgid "「もったいない。大丈夫ですか、それ」"
msgstr ""

#. Occurrence 9_6:1477:13932: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0020; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1477
msgctxt "text_id=13932 | speaker=touko"
msgid "「……いや、そんな物はいいんだ。多少、視力が落ちたところで大事にはならないし。"
msgstr ""

#. Occurrence 9_6:1492:13933: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0021; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1492
msgctxt "text_id=13933 | speaker=touko"
msgid "　そもそも<我欲|わたし>があるかぎり、五感による情報にすら主観が入る。全てこの世は霧の中だ。もともと目に見える<だ|・><け|・>のものは信じていない<質|たち>でね」"
msgstr ""

#. Occurrence 9_6:1522:13934: scene=9_6
#: 9_6:1522
msgctxt "text_id=13934 | speaker=unknown"
msgid "　橙子は口調まで中性的なものに変わっている。"
msgstr ""

#. Occurrence 9_6:1527:13935: scene=9_6
#: 9_6:1527
msgctxt "text_id=13935 | speaker=unknown"
msgid "　それすらも草十郎は気にしてはいないようだ。"
msgstr ""

#. Occurrence 9_6:1561:13936: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0013; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1561
msgctxt "text_id=13936 | speaker=soujuurou"
msgid "「そうですか。それで、さっきの言葉の意味ですけど」"
msgstr ""

#. Occurrence 9_6:1577:13937: scene=9_6
#: 9_6:1577
msgctxt "text_id=13937 | speaker=unknown"
msgid "　変わらずに訊ねてくる草十郎と、"
msgstr ""

#. Occurrence 9_6:1594:13938: scene=9_6
#: 9_6:1594
msgctxt "text_id=13938 | speaker=unknown"
msgid "　苦虫をかむように沈黙する橙子。"
msgstr ""

#. Occurrence 9_6:1599:13939: scene=9_6
#: 9_6:1599
msgctxt "text_id=13939 | speaker=unknown"
msgid "　少しの思案の末、橙子はこの少年にははっきり言わないと駄目なんだな、という真理に到達した。"
msgstr ""

#. Occurrence 9_6:1615:13940: scene=9_6
#: 9_6:1615
msgctxt "text_id=13940 | speaker=unknown"
msgid "　何の因果か、おかしな頭痛に悩まされる姉妹である。"
msgstr ""

#. Occurrence 9_6:1649:13941: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0022; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1649
msgctxt "text_id=13941 | speaker=touko"
msgid "「意味も何もない。青子たちの帰り道に、多少の障害を置いただけだ。私がここにいる間は、外で足止めをするように。"
msgstr ""

#. Occurrence 9_6:1665:13942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_0; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1665
msgctxt "text_id=13942 | speaker=touko"
msgid "　君は青子の持ち物だと言ったな。"
msgstr ""

#. Occurrence 9_6:1675:13943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_1; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1675
msgctxt "text_id=13943 | speaker=touko"
msgid "なら、<殊更|ことさら>丁寧に教えてやる必要もない。"
msgstr ""

#. Occurrence 9_6:1696:13944: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_2; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1696
msgctxt "text_id=13944 | speaker=touko"
msgid "告白してしまうとね、草十郎くん。私が君たちの敵なんだ」"
msgstr ""

#. Occurrence 9_6:1778:13945: scene=9_6
#: 9_6:1778
msgctxt "text_id=13945 | speaker=unknown"
msgid "　草十郎が橙子の発言を理解するのに、たっぷり秒針二周分の時間がかかった。"
msgstr ""

#. Occurrence 9_6:1783:13946: scene=9_6
#: 9_6:1783
msgctxt "text_id=13946 | speaker=unknown"
msgid "　ソファーに座ったまま、ふたりは互いに見つめ合う。"
msgstr ""

#. Occurrence 9_6:1788:13947: scene=9_6
#: 9_6:1788
msgctxt "text_id=13947 | speaker=unknown"
msgid "　草十郎の両肩に緊張らしき力みが入る。"
msgstr ""

#. Occurrence 9_6:1793:13948: scene=9_6
#: 9_6:1793
msgctxt "text_id=13948 | speaker=unknown"
msgid "　彼にもようやく、この場がどれほど危険なのか理解できたらしい。"
msgstr ""

#. Occurrence 9_6:1837:13949: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0024; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1837
msgctxt "text_id=13949 | speaker=touko"
msgid "「驚いた？」"
msgstr ""

#. Occurrence 9_6:1843:13950: scene=9_6
#: 9_6:1843
msgctxt "text_id=13950 | speaker=unknown"
msgid "　楽しげに微笑む橙子。"
msgstr ""

#. Occurrence 9_6:1860:13951: scene=9_6
#: 9_6:1860
msgctxt "text_id=13951 | speaker=unknown"
msgid "　カタチは同じなのに、眼鏡がないだけで冷たい微笑に変わっている。"
msgstr ""

#. Occurrence 9_6:1881:13952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0014; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1881
msgctxt "text_id=13952 | speaker=soujuurou"
msgid "「あなたは、蒼崎の姉なのに……？」"
msgstr ""

#. Occurrence 9_6:1901:13953: scene=9_6
#: 9_6:1901
msgctxt "text_id=13953 | speaker=unknown"
msgid "　橙子の微笑に圧されながら、草十郎はそんな、当然の疑問を口にした。"
msgstr ""

#. Occurrence 9_6:1906:13954: scene=9_6
#: 9_6:1906
msgctxt "text_id=13954 | speaker=unknown"
msgid "　この状況で自身の安全ではなく<他人事|ひとごと>の質問をする草十郎に、しかし橙子は驚かない。"
msgstr ""

#. Occurrence 9_6:1911:13955: scene=9_6
#: 9_6:1911
msgctxt "text_id=13955 | speaker=unknown"
msgid "　彼女は彼以上に、この一時間で静希草十郎という人間を把握していた。"
msgstr ""

#. Occurrence 9_6:1940:13956: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0025; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1940
msgctxt "text_id=13956 | speaker=touko"
msgid "「逆だよ。姉だから敵なんだ。私には青子からあらゆる権利を奪う義務がある。"
msgstr ""

#. Occurrence 9_6:1947:13957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0026; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1947
msgctxt "text_id=13957 | speaker=touko"
msgid "物質的な物も、精神的な物も、その全てを踏みにじらなければ気が済まない。"
msgstr ""

#. Occurrence 9_6:1963:13958: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0027; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1963
msgctxt "text_id=13958 | speaker=touko"
msgid "　尺度として言うなら、もし青子がこの街に頼っていたのなら、まず街から壊していたぐらい。"
msgstr ""

#. Occurrence 9_6:1974:13959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0028; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1974
msgctxt "text_id=13959 | speaker=touko"
msgid "　―――けど、君の事は予想外だった」"
msgstr ""

#. Occurrence 9_6:2007:13960: scene=9_6
#: 9_6:2007
msgctxt "text_id=13960 | speaker=unknown"
msgid "　橙子は<悼|いた>むように瞳を閉じる。"
msgstr ""

#. Occurrence 9_6:2012:13961: scene=9_6
#: 9_6:2012
msgctxt "text_id=13961 | speaker=unknown"
msgid "　その顔は静かな葛藤に満ちている。"
msgstr ""

#. Occurrence 9_6:2042:13962: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0029; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2042
msgctxt "text_id=13962 | speaker=touko"
msgid "「……世の平等に怒るべきか、<幸運|ぐうぜん>の出会いとやらに嘆くべきか。これも抑止力というヤツかな。"
msgstr ""

#. Occurrence 9_6:2048:13963: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0030; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2048
msgctxt "text_id=13963 | speaker=touko"
msgid "　無垢な部外者を手に掛けるのは世の常だが、この手合いに会ったのは初めてだ。"
msgstr ""

#. Occurrence 9_6:2054:13964: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0031; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2054
msgctxt "text_id=13964 | speaker=touko"
msgid "　いや。そもそも居るなどと、考えた事すらなかったな」"
msgstr ""

#. Occurrence 9_6:2077:13965: scene=9_6
#: 9_6:2077
msgctxt "text_id=13965 | speaker=unknown"
msgid "　まったく、と空に向かってグチをこぼし、橙子は体を起こす。"
msgstr ""

#. Occurrence 9_6:2082:13966: scene=9_6
#: 9_6:2082
msgctxt "text_id=13966 | speaker=unknown"
msgid "　彼女が予想もしていなかった類の迷いは、それで断ち切れたらしい。"
msgstr ""

#. Occurrence 9_6:2117:13967: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0032; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2117
msgctxt "text_id=13967 | speaker=touko"
msgid "「君は青子の切札には見えない。"
msgstr ""

#. Occurrence 9_6:2123:13968: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0033; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2123
msgctxt "text_id=13968 | speaker=touko"
msgid "　排除しておくまでもない、善良かつ無能な部外者だ。"
msgstr ""

#. Occurrence 9_6:2134:13969: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0034; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2134
msgctxt "text_id=13969 | speaker=touko"
msgid "　だから放っておきたいのだけど、私の六感がこう告げているんだ。君を逃すな、いいからさっさと済ませてしまえ、と」"
msgstr ""

#. Occurrence 9_6:2166:13970: scene=9_6
#: 9_6:2166
msgctxt "text_id=13970 | speaker=unknown"
msgid "　分かりやすく言うと『よし、いま殺そう』という意味らしい。"
msgstr ""

#. Occurrence 9_6:2171:13971: scene=9_6
#: 9_6:2171
msgctxt "text_id=13971 | speaker=unknown"
msgid "　過大評価をしてくれる分には嬉しいけれどいきすぎるのも問題で、それより何より、なんだかんだと<青子|いもうと>と同じ結論になるあたり姉妹の<業|ごう>を感じる草十郎である。"
msgstr ""

#. Occurrence 9_6:2217:13972: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0015; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2217
msgctxt "text_id=13972 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence 9_6:2223:13973: scene=9_6
#: 9_6:2223
msgctxt "text_id=13973 | speaker=unknown"
msgid "　しかし、悠長に感想を述べている場合でもない。"
msgstr ""

#. Occurrence 9_6:2229:13974: scene=9_6
#: 9_6:2229
msgctxt "text_id=13974 | speaker=unknown"
msgid "　草十郎はできるだけさりげなく―――具体的には逃げだそうとしているのが見え見えな慎重さで―――ソファーから腰をあげようと努力する。"
msgstr ""

#. Occurrence 9_6:2256:13975: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0035; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2256
msgctxt "text_id=13975 | speaker=touko"
msgid "「バカもの、こういう時は半端に動くな。逃げるならサッサと逃げる、交渉するならテコでも動くな。"
msgstr ""

#. Occurrence 9_6:2268:13976: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0036; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2268
msgctxt "text_id=13976 | speaker=touko"
msgid "　……なんというか、そんな風に動かれるとその気がなくともつい反応してしまうだろう。ほら、命が惜しいのなら大人しく固まっていなさい」"
msgstr ""

#. Occurrence 9_6:2304:13977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0016; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2304
msgctxt "text_id=13977 | speaker=soujuurou"
msgid "「えっと……殺さない、んですか？」"
msgstr ""

#. Occurrence 9_6:2323:13978: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0037; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2323
msgctxt "text_id=13978 | speaker=touko"
msgid "「今のところはね。私は君が気に入ったし。"
msgstr ""

#. Occurrence 9_6:2329:13979: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0038; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2329
msgctxt "text_id=13979 | speaker=touko"
msgid "　いや、違うな、正しくはこう。私ぐらいしか、君を救ってあげられないのかも、かな」"
msgstr ""

#. Occurrence 9_6:2335:13980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0017; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2335
msgctxt "text_id=13980 | speaker=soujuurou"
msgid "「―――はい？」"
msgstr ""

#. Occurrence 9_6:2374:13981: scene=9_6
#: 9_6:2374
msgctxt "text_id=13981 | speaker=unknown"
msgid "　当惑する草十郎を、正面から見据える橙子。"
msgstr ""

#. Occurrence 9_6:2379:13982: scene=9_6
#: 9_6:2379
msgctxt "text_id=13982 | speaker=unknown"
msgid "　赤くさえ見える茶色の瞳は、剣のような鋭さで目前の少年を捕らえている。"
msgstr ""

#. Occurrence 9_6:2438:13983: scene=9_6
#: 9_6:2438
msgctxt "text_id=13983 | speaker=unknown"
msgid "　一瞬、草十郎は軽い<眩暈|めまい>に襲われた。"
msgstr ""

#. Occurrence 9_6:2443:13984: scene=9_6
#: 9_6:2443
msgctxt "text_id=13984 | speaker=unknown"
msgid "　正体のつかめない浮遊感と、脳の痺れ。"
msgstr ""

#. Occurrence 9_6:2448:13985: scene=9_6
#: 9_6:2448
msgctxt "text_id=13985 | speaker=unknown"
msgid "　魔物のような眠気、というのがもっとも近いイメージだった。"
msgstr ""

#. Occurrence 9_6:2473:13986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0018; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2473
msgctxt "text_id=13986 | speaker=soujuurou"
msgid "「―――、――――――」"
msgstr ""

#. Occurrence 9_6:2479:13987: scene=9_6
#: 9_6:2479
msgctxt "text_id=13987 | speaker=unknown"
msgid "　草十郎は歯を食いしばって意識を保つ。"
msgstr ""

#. Occurrence 9_6:2503:13988: scene=9_6
#: 9_6:2503
msgctxt "text_id=13988 | speaker=unknown"
msgid "　目前にはあまりにも深い、底なし沼のような橙子の瞳。"
msgstr ""

#. Occurrence 9_6:2523:13989: scene=9_6
#: 9_6:2523
msgctxt "text_id=13989 | speaker=unknown"
msgid "　……それで、草十郎は漠然と理解した。"
msgstr ""

#. Occurrence 9_6:2529:13990: scene=9_6
#: 9_6:2529
msgctxt "text_id=13990 | speaker=unknown"
msgid "　アレは青子の姉とかそういったモノでなく、"
msgstr ""

#. Occurrence 9_6:2534:13991: scene=9_6
#: 9_6:2534
msgctxt "text_id=13991 | speaker=unknown"
msgid "　有珠たちの敵というモノでもない。"
msgstr ""

#. Occurrence 9_6:2539:13992: scene=9_6
#: 9_6:2539
msgctxt "text_id=13992 | speaker=unknown"
msgid "　彼女たちの事情とは別の次元で、蒼崎橙子という人物は自分にとって<危|あや>うい生き物なのだと。"
msgstr ""

#. Occurrence 9_6:2572:13993: scene=9_6
#: 9_6:2572
msgctxt "text_id=13993 | speaker=unknown"
msgid "　何故なら―――"
msgstr ""

#. Occurrence 9_6:2577:13994: scene=9_6
#: 9_6:2577
msgctxt "text_id=13994 | speaker=unknown"
msgid "　たった一時間足らずの会話で、理由もないのに他人に心底から共感してしまうのは、良くないことだ。"
msgstr ""

#. Occurrence 9_6:2582:13995: scene=9_6
#: 9_6:2582
msgctxt "text_id=13995 | speaker=unknown"
msgid "　それはただ、同じ<金型|カタチ>のものが、空洞を埋める為だけに、同じものを求めているにすぎない。"
msgstr ""

#. Occurrence 9_6:2616:13996: scene=9_6
#: 9_6:2616
msgctxt "text_id=13996 | speaker=unknown"
msgid "　これまで感じた事のない危機感に身を引く草十郎だが、体はまったく言う事をきかない。"
msgstr ""

#. Occurrence 9_6:2621:13997: scene=9_6
#: 9_6:2621
msgctxt "text_id=13997 | speaker=unknown"
msgid "　そんな草十郎を見つめて、橙子は微かにうなずいた。"
msgstr ""

#. Occurrence 9_6:2655:13998: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0039; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2655
msgctxt "text_id=13998 | speaker=touko"
msgid "「君の思う通り、私は君と似たところがある。それとも君が私に近いのかな。なに、食べ物の好き嫌い程度の類似だが、軽視する事でもない。"
msgstr ""

#. Occurrence 9_6:2673:13999: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0040; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2673
msgctxt "text_id=13999 | speaker=touko"
msgid "　問題は、君が私より<偏|かたよ>っている、という事でね」"
msgstr ""

#. Occurrence 9_6:2693:14000: scene=9_6
#: 9_6:2693
msgctxt "text_id=14000 | speaker=unknown"
msgid "　偏っている。"
msgstr ""

#. Occurrence 9_6:2709:14001: scene=9_6
#: 9_6:2709
msgctxt "text_id=14001 | speaker=unknown"
msgid "　その言葉を、草十郎は違う意味にしかとれなかった。"
msgstr ""

#. Occurrence 9_6:2732:14002: scene=9_6
#: 9_6:2732
msgctxt "text_id=14002 | speaker=unknown"
msgid "　偏っている。"
msgstr ""

msgctxt "text_id=14003 | speaker=unknown"
msgid "傍には誰もいない。"
msgstr ""

msgctxt "text_id=14004 | speaker=unknown"
msgid "おまえはこの町では、仲間外れの異邦人だと。"
msgstr ""

#. Occurrence 9_6:2742:14005: scene=9_6
#: 9_6:2742
msgctxt "text_id=14005 | speaker=unknown"
msgid "　急激な反感が、温厚な彼の<性格|こころ>を沸騰させる。"
msgstr ""

#. Occurrence 9_6:2782:14006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0019; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2782
msgctxt "text_id=14006 | speaker=soujuurou"
msgid "「俺、ひとりじゃないですけど」"
msgstr ""

#. Occurrence 9_6:2790:14007: scene=9_6
#: 9_6:2790
msgctxt "text_id=14007 | speaker=unknown"
msgid "　心底からの嫌悪をこめて、草十郎は言い返す。"
msgstr ""

#. Occurrence 9_6:2795:14008: scene=9_6
#: 9_6:2795
msgctxt "text_id=14008 | speaker=unknown"
msgid "　蒼崎橙子と名乗る目前の魔女に。"
msgstr ""

#. Occurrence 9_6:2800:14009: scene=9_6
#: 9_6:2800
msgctxt "text_id=14009 | speaker=unknown"
msgid "　そう言い返さなければ、彼女の目から逃れられなくなりそうで恐ろしかった。"
msgstr ""

#. Occurrence 9_6:2837:14010: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0041; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2837
msgctxt "text_id=14010 | speaker=touko"
msgid "「だろうな。だからこそ君は偏っているんだ。早くそれに気付きなさい。一番てっとり早い解決は、それでいいんだと認める事だ。"
msgstr ""

#. Occurrence 9_6:2844:14011: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0042; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2844
msgctxt "text_id=14011 | speaker=touko"
msgid "人間なんて逞しいもんでね。別に、何もかも放り投げても上手くいくものなのさ。"
msgstr ""

#. Occurrence 9_6:2850:14012: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0043; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2850
msgctxt "text_id=14012 | speaker=touko"
msgid "　けれど―――青子にはそれは許せない。アレは他人であれ、あらゆる事を許さない人間だからな」"
msgstr ""

#. Occurrence 9_6:2881:14013: scene=9_6
#: 9_6:2881
msgctxt "text_id=14013 | speaker=unknown"
msgid "　言って、橙子はテーブルに身を乗り出した。"
msgstr ""

#. Occurrence 9_6:2887:14014: scene=9_6
#: 9_6:2887
msgctxt "text_id=14014 | speaker=unknown"
msgid "　片手を伸ばして草十郎の首輪を掴むと、力任せに自分へと引き寄せる。"
msgstr ""

#. Occurrence 9_6:2919:14015: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0044; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2919
msgctxt "text_id=14015 | speaker=touko"
msgid "「いや、そんな事はいいんだ。ただ純粋に、私は君が欲しいと思った。君が、自分の名前すら定かではないと名乗った時にね」"
msgstr ""

#. Occurrence 9_6:2940:14016: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0045; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2940
msgctxt "text_id=14016 | speaker=touko"
msgid "「自分の認識が不明で、自分自身が不能と感じる。"
msgstr ""

#. Occurrence 9_6:2946:14017: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0046; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2946
msgctxt "text_id=14017 | speaker=touko"
msgid "　未来というものが、とても自分に関わりのある事とは思えない。となれば必然、心情は過去への逆行を試みる。"
msgstr ""

#. Occurrence 9_6:2955:14018: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0047; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2955
msgctxt "text_id=14018 | speaker=touko"
msgid "　しかし、所詮<大我|ソア>の前の<小我|モア>のように、正常な流れの前には時間旅行は押し戻されてしまう。"
msgstr ""

#. Occurrence 9_6:2961:14019: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0048; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2961
msgctxt "text_id=14019 | speaker=touko"
msgid "　それも私にあって君にある物だ。"
msgstr ""

#. Occurrence 9_6:2972:14020: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0049; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2972
msgctxt "text_id=14020 | speaker=touko"
msgid "　ああ、なんて無様な私。なんて哀れな―――」"
msgstr ""

#. Occurrence 9_6:2997:14021: scene=9_6
#: 9_6:2997
msgctxt "text_id=14021 | speaker=unknown"
msgid "　言いかけて、橙子は口を塞ぐ。"
msgstr ""

#. Occurrence 9_6:3006:14022: scene=9_6
#: 9_6:3006
msgctxt "text_id=14022 | speaker=unknown"
msgid "　引き寄せられた草十郎の目に映るのは、橙子の目に映った、憐れみの表情をうかべた自分だけだった。"
msgstr ""

#. Occurrence 9_6:3026:14023: scene=9_6
#: 9_6:3026
msgctxt "text_id=14023 | speaker=unknown"
msgid "　草十郎は思う。"
msgstr ""

#. Occurrence 9_6:3031:14024: scene=9_6
#: 9_6:3031
msgctxt "text_id=14024 | speaker=unknown"
msgid "　この女性に敵意はない。"
msgstr ""

#. Occurrence 9_6:3036:14025: scene=9_6
#: 9_6:3036
msgctxt "text_id=14025 | speaker=unknown"
msgid "　殺意も、失意もない。"
msgstr ""

#. Occurrence 9_6:3041:14026: scene=9_6
#: 9_6:3041
msgctxt "text_id=14026 | speaker=unknown"
msgid "　あるのは怒りと、行く当てのない<憐憫|れんびん>だけだ。"
msgstr ""

#. Occurrence 9_6:3046:14027: scene=9_6
#: 9_6:3046
msgctxt "text_id=14027 | speaker=unknown"
msgid "　出来れば彼女の望む答えを口にしてやりたい。"
msgstr ""

#. Occurrence 9_6:3051:14028: scene=9_6
#: 9_6:3051
msgctxt "text_id=14028 | speaker=unknown"
msgid "　けれど―――"
msgstr ""

#. Occurrence 9_6:3087:14029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0020; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3087
msgctxt "text_id=14029 | speaker=soujuurou"
msgid "「あなたの言っている事は、よく分からない」"
msgstr ""

#. Occurrence 9_6:3104:14030: scene=9_6
#: 9_6:3104
msgctxt "text_id=14030 | speaker=unknown"
msgid "　申し訳ないように草十郎は返答した。"
msgstr ""

#. Occurrence 9_6:3109:14031: scene=9_6
#: 9_6:3109
msgctxt "text_id=14031 | speaker=unknown"
msgid "　視線で問われた事を、はっきりと言葉にして。"
msgstr ""

#. Occurrence 9_6:3114:14032: scene=9_6
#: 9_6:3114
msgctxt "text_id=14032 | speaker=unknown"
msgid "　橙子に落胆の色はない。"
msgstr ""

#. Occurrence 9_6:3119:14033: scene=9_6
#: 9_6:3119
msgctxt "text_id=14033 | speaker=unknown"
msgid "　むしろ楽しげに、かすかに唇をつり上げた。"
msgstr ""

#. Occurrence 9_6:3157:14034: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0050; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3157
msgctxt "text_id=14034 | speaker=touko"
msgid "「そうか。君には言葉の<魔術|あんじ>は通じないんだな。"
msgstr ""

#. Occurrence 9_6:3163:14035: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0051; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3163
msgctxt "text_id=14035 | speaker=touko"
msgid "　意味深な台詞回しで丸飲みにしてやろうとも思ったが、いや、失敗失敗。<小奇麗|こぎれい>な建前は逆効果だった。君には剥き出しの、原始的な語りの方が良かったんだな。"
msgstr ""

#. Occurrence 9_6:3179:14036: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0052; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3179
msgctxt "text_id=14036 | speaker=touko"
msgid "　―――いいよ、ますます気に入った」"
msgstr ""

#. Occurrence 9_6:3213:14037: scene=9_6
#: 9_6:3213
msgctxt "text_id=14037 | speaker=unknown"
msgid "　首輪を掴む指が、革を引き裂くように喉元に食いこむ。"
msgstr ""

#. Occurrence 9_6:3218:14038: scene=9_6
#: 9_6:3218
msgctxt "text_id=14038 | speaker=unknown"
msgid "　それを裂いてしまえば、この少年は自分の物になると言うかのように。"
msgstr ""

#. Occurrence 9_6:3255:14039: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0053; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3255
msgctxt "text_id=14039 | speaker=touko"
msgid "「―――少年。青子なぞより私のもとにこい。"
msgstr ""

#. Occurrence 9_6:3261:14040: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0054; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3261
msgctxt "text_id=14040 | speaker=touko"
msgid "　使い道はないが保護ぐらいはしてやろう。手が空いた時なら、気晴らしに愛してやってもいい」"
msgstr ""

#. Occurrence 9_6:3281:14041: scene=9_6
#: 9_6:3281
msgctxt "text_id=14041 | speaker=unknown"
msgid "　色々回り道はしたが、それが彼女の結論らしい。"
msgstr ""

#. Occurrence 9_6:3286:14042: scene=9_6
#: 9_6:3286
msgctxt "text_id=14042 | speaker=unknown"
msgid "　誘われている草十郎は、そこまで買われている事が不思議でしようがない。嬉しくないというのも嘘になる。"
msgstr ""

#. Occurrence 9_6:3291:14043: scene=9_6
#: 9_6:3291
msgctxt "text_id=14043 | speaker=unknown"
msgid "　しかし、それはそれとして、"
msgstr ""

#. Occurrence 9_6:3298:14044: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0021; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3298
msgctxt "text_id=14044 | speaker=soujuurou"
msgid "「それは、お断りします」"
msgstr ""

#. Occurrence 9_6:3304:14045: scene=9_6
#: 9_6:3304
msgctxt "text_id=14045 | speaker=unknown"
msgid "　またもきっぱりと、草十郎は即答した。"
msgstr ""

#. Occurrence 9_6:3332:14046: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0055; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3332
msgctxt "text_id=14046 | speaker=touko"
msgid "「―――なぜ？」"
msgstr ""

#. Occurrence 9_6:3338:14047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0022; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3338
msgctxt "text_id=14047 | speaker=soujuurou"
msgid "「だって、貴方のためにならない」"
msgstr ""

#. Occurrence 9_6:3357:14048: scene=9_6
#: 9_6:3357
msgctxt "text_id=14048 | speaker=unknown"
msgid "　それだけは胸を張って断言できる。"
msgstr ""

#. Occurrence 9_6:3362:14049: scene=9_6
#: 9_6:3362
msgctxt "text_id=14049 | speaker=unknown"
msgid "　橙子の過大評価はともかく、草十郎は、自分がこの人物をどうにかしてはいけない、と強く感じていた。"
msgstr ""

#. Occurrence 9_6:3367:14050: scene=9_6
#: 9_6:3367
msgctxt "text_id=14050 | speaker=unknown"
msgid "　結論を出すのは彼女本人か、彼女が<拘|こだわ>っている相手の手でなければ間違っている、と。"
msgstr ""

#. Occurrence 9_6:3407:14051: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0056; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3407
msgctxt "text_id=14051 | speaker=touko"
msgid "「………………」"
msgstr ""

#. Occurrence 9_6:3413:14052: scene=9_6
#: 9_6:3413
msgctxt "text_id=14052 | speaker=unknown"
msgid "　直感を通り越した、信念めいた少年の断言。"
msgstr ""

#. Occurrence 9_6:3428:14053: scene=9_6
#: 9_6:3428
msgctxt "text_id=14053 | speaker=unknown"
msgid "　橙子はそっと首輪から指をぬいて、とん、と近寄っていた草十郎をソファーへと押し戻した。"
msgstr ""

#. Occurrence 9_6:3460:14054: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0057; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3460
msgctxt "text_id=14054 | speaker=touko"
msgid "「そうか。なら仕方がない。"
msgstr ""

#. Occurrence 9_6:3466:14055: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0058; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3466
msgctxt "text_id=14055 | speaker=touko"
msgid "　君も、青子の大切な持ち物として考える事にしよう」"
msgstr ""

#. Occurrence 9_6:3486:14056: scene=9_6
#: 9_6:3486
msgctxt "text_id=14056 | speaker=unknown"
msgid "　橙色の魔術師は静かに立ち上がる。"
msgstr ""

#. Occurrence 9_6:3510:14057: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0059; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3510
msgctxt "text_id=14057 | speaker=touko"
msgid "「青子が帰ってくる頃だから、私は行くよ。"
msgstr ""

#. Occurrence 9_6:3517:14058: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0060; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3517
msgctxt "text_id=14058 | speaker=touko"
msgid "青子では私には勝てない、とだけ伝えておいてくれればいい」"
msgstr ""

#. Occurrence 9_6:3523:14059: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0023; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3523
msgctxt "text_id=14059 | speaker=soujuurou"
msgid "「それはいいんですけど」"
msgstr ""

#. Occurrence 9_6:3555:14060: scene=9_6
#: 9_6:3555
msgctxt "text_id=14060 | speaker=unknown"
msgid "　ソファーに座ったまま、草十郎は立ち去ろうとする橙子を呼び止めた。"
msgstr ""

#. Occurrence 9_6:3560:14061: scene=9_6
#: 9_6:3560
msgctxt "text_id=14061 | speaker=unknown"
msgid "　そうして、師匠に質問する弟子のように控え目に、橙子が持っている物を指差す。"
msgstr ""

#. Occurrence 9_6:3586:14062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0024; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3586
msgctxt "text_id=14062 | speaker=soujuurou"
msgid "「……あの。そのカップ、どうするんです？」"
msgstr ""

#. Occurrence 9_6:3592:14063: scene=9_6
#: 9_6:3592
msgctxt "text_id=14063 | speaker=unknown"
msgid "　頼りのない弟子の指摘に、ああ、と橙子は右手に持ったティーカップに視線を落とした。"
msgstr ""

#. Occurrence 9_6:3597:14064: scene=9_6
#: 9_6:3597
msgctxt "text_id=14064 | speaker=unknown"
msgid "　橙子本人、自分がカップを持っていた事実を意識していなかったとしか思えない。"
msgstr ""

#. Occurrence 9_6:3630:14065: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0061; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3630
msgctxt "text_id=14065 | speaker=touko"
msgid "「これ？　うん、せっかくだから貰っていく」"
msgstr ""

#. Occurrence 9_6:3636:14066: scene=9_6
#: 9_6:3636
msgctxt "text_id=14066 | speaker=unknown"
msgid "　……持ち主の許しもなく持っていくのは『貰う』ではなく『奪う』という。"
msgstr ""

#. Occurrence 9_6:3641:14067: scene=9_6
#: 9_6:3641
msgctxt "text_id=14067 | speaker=unknown"
msgid "　けれど、青子と橙子の間ではそれぐらいの交流は普通なのかも知れない。あの妹にしてこの姉あり、みたいな。"
msgstr ""

#. Occurrence 9_6:3674:14068: scene=9_6
#: 9_6:3674
msgctxt "text_id=14068 | speaker=unknown"
msgid "　なるほど、と草十郎は頷く。"
msgstr ""

#. Occurrence 9_6:3679:14069: scene=9_6
#: 9_6:3679
msgctxt "text_id=14069 | speaker=unknown"
msgid "　そんな、真面目なんだか不真面目なんだか分からない草十郎の仕草に、橙子は眼鏡を外してから二度目の、楽しげな笑みをこぼすのだった。"
msgstr ""

#. Occurrence 9_6:3715:14070: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0062; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3715
msgctxt "text_id=14070 | speaker=touko"
msgid "「やはり変わり種だね、君は。逸材かどうかは別の話だが」"
msgstr ""

#. Occurrence 9_6:3736:14071: scene=9_6
#: 9_6:3736
msgctxt "text_id=14071 | speaker=unknown"
msgid "　一瞬だけ、彼女は眼鏡をはずす前の、穏和な蒼崎橙子に戻っていた。"
msgstr ""

#. Occurrence 9_6:3741:14072: scene=9_6
#: 9_6:3741
msgctxt "text_id=14072 | speaker=unknown"
msgid "　その微笑みを最後にして、橙子は洋館から去っていった。"
msgstr ""

#. Occurrence 9_6:3760:14073: scene=9_6
#: 9_6:3760
msgctxt "text_id=14073 | speaker=unknown"
msgid "　居間のテーブルに、壊れた眼鏡を残したままで。"
msgstr ""

#. Occurrence 9_7:89:14074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0000; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:89
msgctxt "text_id=14074 | speaker=aoko"
msgid "「ただいまー！」"
msgstr ""

#. Occurrence 9_7:96:14075: scene=9_7
#: 9_7:96
msgctxt "text_id=14075 | speaker=unknown"
msgid "　不意の来客と入れ替わるように、青子たちは帰ってきた。"
msgstr ""

#. Occurrence 9_7:101:14076: scene=9_7
#: 9_7:101
msgctxt "text_id=14076 | speaker=unknown"
msgid "　青子の表情は不機嫌ながらも活き活きとしている。"
msgstr ""

#. Occurrence 9_7:106:14077: scene=9_7
#: 9_7:106
msgctxt "text_id=14077 | speaker=unknown"
msgid "　とりあえず問題は山積みだけど目的が決まってスッキリした、と言いたげなハイテンションさだ。"
msgstr ""

#. Occurrence 9_7:126:14078: scene=9_7
#: 9_7:126
msgctxt "text_id=14078 | speaker=unknown"
msgid "　一方、傍らの有珠はいつも通り。"
msgstr ""

#. Occurrence 9_7:131:14079: scene=9_7
#: 9_7:131
msgctxt "text_id=14079 | speaker=unknown"
msgid "　相棒の暴走っぷりをフォローできるよう裏方に徹している……と見えなくもない。"
msgstr ""

#. Occurrence 9_7:136:14080: scene=9_7
#: 9_7:136
msgctxt "text_id=14080 | speaker=unknown"
msgid "　ふたりの颯爽とした登場はテレビの映像のように思えて、草十郎はお帰りと言うのも忘れてしまった。"
msgstr ""

#. Occurrence 9_7:170:14081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0001; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:170
msgctxt "text_id=14081 | speaker=aoko"
msgid "「草十郎、留守中なにかあった？」"
msgstr ""

#. Occurrence 9_7:176:14082: scene=9_7
#: 9_7:176
msgctxt "text_id=14082 | speaker=unknown"
msgid "　青子は上着を脱ぎながら、社交辞令じみた質問をした。"
msgstr ""

#. Occurrence 9_7:181:14083: scene=9_7
#: 9_7:181
msgctxt "text_id=14083 | speaker=unknown"
msgid "　それには答えず、草十郎はソファーから立ち上がる。"
msgstr ""

#. Occurrence 9_7:205:14084: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0000; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:205
msgctxt "text_id=14084 | speaker=soujuurou"
msgid "「そりゃあ半日分の出来事はあったけど。"
msgstr ""

#. Occurrence 9_7:211:14085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0001; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:211
msgctxt "text_id=14085 | speaker=soujuurou"
msgid "　それより寒かっただろう。お茶を淹れようか？」"
msgstr ""

#. Occurrence 9_7:222:14086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0002; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:222
msgctxt "text_id=14086 | speaker=aoko"
msgid "「あ、お願い。"
msgstr ""

#. Occurrence 9_7:222:14087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0002; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:222
msgctxt "text_id=14087 | speaker=aoko"
msgid "　こっちも一から作戦練り上げようってトコだから」"
msgstr ""

#. Occurrence 9_7:264:14088: scene=9_7
#: 9_7:264
msgctxt "text_id=14088 | speaker=unknown"
msgid "　上機嫌な青子の台詞を聞き流して、草十郎は台所に向かい、二人分の紅茶を淹れはじめる。"
msgstr ""

#. Occurrence 9_7:271:14089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0002; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:271
msgctxt "text_id=14089 | speaker=soujuurou"
msgid "「……なんだろう。どこか、変だ」"
msgstr ""

#. Occurrence 9_7:276:14090: scene=9_7
#: 9_7:276
msgctxt "text_id=14090 | speaker=unknown"
msgid "　いつもの手順で紅茶を淹れているのに、作っている実感が湧かない。"
msgstr ""

#. Occurrence 9_7:282:14091: scene=9_7
#: 9_7:282
msgctxt "text_id=14091 | speaker=unknown"
msgid "　<夢現|ゆめうつつ>な気分で、草十郎は青子たちがくつろいでいる居間に戻り、テーブルにティーカップを置く。"
msgstr ""

#. Occurrence 9_7:316:14092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0000; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:316
msgctxt "text_id=14092 | speaker=alice"
msgid "「これからどうするつもりなの、青子」"
msgstr ""

#. Occurrence 9_7:322:14093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0003; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:322
msgctxt "text_id=14093 | speaker=aoko"
msgid "「とりあえず足で探すしかないわね。あいつ相手に守りに入るのは良くない。こっちが城壁を作ってる間に、一個師団の人形をこさえかねないわ」"
msgstr ""

#. Occurrence 9_7:342:14094: scene=9_7
#: 9_7:342
msgctxt "text_id=14094 | speaker=unknown"
msgid "　ふたりは草十郎を無視して話をしている。"
msgstr ""

#. Occurrence 9_7:347:14095: scene=9_7
#: 9_7:347
msgctxt "text_id=14095 | speaker=unknown"
msgid "　それをつっ立ったまま聞きながら、ぽつりと草十郎は話しかけた。"
msgstr ""

#. Occurrence 9_7:380:14096: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0003; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:380
msgctxt "text_id=14096 | speaker=soujuurou"
msgid "「探すって、橙子さんを？」"
msgstr ""

#. Occurrence 9_7:398:14097: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0004; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:398
msgctxt "text_id=14097 | speaker=aoko"
msgid "「それ以外誰を探すって―――"
msgstr ""

#. Occurrence 9_7:410:14098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0005; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:410
msgctxt "text_id=14098 | speaker=aoko"
msgid "　ちょっと。アンタ、今なんて言ったの？」"
msgstr ""

#. Occurrence 9_7:416:14099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0004; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:416
msgctxt "text_id=14099 | speaker=soujuurou"
msgid "「橙子さんなんだろ、蒼崎たちの敵は。さっきまでここにいたよ」"
msgstr ""

#. Occurrence 9_7:436:14100: scene=9_7
#: 9_7:436
msgctxt "text_id=14100 | speaker=unknown"
msgid "　呆然とする青子に、平然と答える草十郎。"
msgstr ""

#. Occurrence 9_7:452:14101: scene=9_7
#: 9_7:452
msgctxt "text_id=14101 | speaker=unknown"
msgid "　そんな間の抜けたふたりを余所に、有珠はソファーから立ち上がった。"
msgstr ""

#. Occurrence 9_7:457:14102: scene=9_7
#: 9_7:457
msgctxt "text_id=14102 | speaker=unknown"
msgid "　可憐な顔立ちを、厳しい叱責の<貌|かたち>に変えて。"
msgstr ""

#. Occurrence 9_7:491:14103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0001; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:491
msgctxt "text_id=14103 | speaker=alice"
msgid "「静希君。その人、何かしていった？」"
msgstr ""

#. Occurrence 9_7:512:14104: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0005_0; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:512
msgctxt "text_id=14104 | speaker=soujuurou"
msgid "「お茶を飲んで、眼鏡を外して帰っていっただけだけど。"
msgstr ""

#. Occurrence 9_7:524:14105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0005_1; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:524
msgctxt "text_id=14105 | speaker=soujuurou"
msgid "あれ……よく、思い出せないな……」"
msgstr ""

#. Occurrence 9_7:530:14106: scene=9_7
#: 9_7:530
msgctxt "text_id=14106 | speaker=unknown"
msgid "　さっきまで確かだった記憶が、消しゴムにかけられるように消えていく。"
msgstr ""

#. Occurrence 9_7:535:14107: scene=9_7
#: 9_7:535
msgctxt "text_id=14107 | speaker=unknown"
msgid "　草十郎は、つい先ほど感じた、眠気のような目眩に襲われて、"
msgstr ""

#. Occurrence 9_7:580:14108: scene=9_7
#: 9_7:580
msgctxt "text_id=14108 | speaker=unknown"
msgid "　ぱん、と乾いた音が居間に響く。"
msgstr ""

#. Occurrence 9_7:585:14109: scene=9_7
#: 9_7:585
msgctxt "text_id=14109 | speaker=unknown"
msgid "　草十郎の目眩を止めたのは、彼が思ってもいなかった有珠の平手打ちだった。"
msgstr ""

#. Occurrence 9_7:613:14110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0002; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:613
msgctxt "text_id=14110 | speaker=alice"
msgid "「―――二度は言わないわ。"
msgstr ""

#. Occurrence 9_7:613:14111: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0002; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:613
msgctxt "text_id=14111 | speaker=alice"
msgid "　他人を、わたしの家に立ち入らせないで」"
msgstr ""

#. Occurrence 9_7:642:14112: scene=9_7
#: 9_7:642
msgctxt "text_id=14112 | speaker=unknown"
msgid "　有珠の目には、<潜|ひそ>めた、けれど激情が灯っている。"
msgstr ""

#. Occurrence 9_7:647:14113: scene=9_7
#: 9_7:647
msgctxt "text_id=14113 | speaker=unknown"
msgid "　それが怒りだけのものではないと気付いて、草十郎はようやく、自分の軽率さを悔いた。"
msgstr ""

#. Occurrence 9_7:668:14114: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0006; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:668
msgctxt "text_id=14114 | speaker=soujuurou"
msgid "「……すまない。有珠にとってここが大事な場所なのは、分かってたのに」"
msgstr ""

#. Occurrence 9_7:689:14115: scene=9_7
#: 9_7:689
msgctxt "text_id=14115 | speaker=unknown"
msgid "　重い沈黙。"
msgstr ""

#. Occurrence 9_7:707:14116: scene=9_7
#: 9_7:707
msgctxt "text_id=14116 | speaker=unknown"
msgid "　有珠も草十郎も、自分への後悔に縛られて動けない。"
msgstr ""

#. Occurrence 9_7:738:14117: scene=9_7
#: 9_7:738
msgctxt "text_id=14117 | speaker=unknown"
msgid "　放っておけば一晩中そうやっていそうなふたりを、青子は呆れて眺めている。"
msgstr ""

#. Occurrence 9_7:766:14118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0006; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:766
msgctxt "text_id=14118 | speaker=aoko"
msgid "「あのね。姉貴を通した草十郎も悪いけど、言ってなかった有珠も悪いでしょ。"
msgstr ""

#. Occurrence 9_7:772:14119: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0007; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:772
msgctxt "text_id=14119 | speaker=aoko"
msgid "　子供じゃないんだからいつまでも反省してないで、もっと前向きに話をしない？」"
msgstr ""

#. Occurrence 9_7:799:14120: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0003; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:799
msgctxt "text_id=14120 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence 9_7:824:14121: scene=9_7
#: 9_7:824
msgctxt "text_id=14121 | speaker=unknown"
msgid "　青子に促され、有珠はうつむきがちにソファーに座った。"
msgstr ""

#. Occurrence 9_7:829:14122: scene=9_7
#: 9_7:829
msgctxt "text_id=14122 | speaker=unknown"
msgid "　草十郎は立ったままで、有珠に叩かれた右頬に手を当てた。"
msgstr ""

#. Occurrence 9_7:834:14123: scene=9_7
#: 9_7:834
msgctxt "text_id=14123 | speaker=unknown"
msgid "　痛む事は痛むけど、体の痛みには慣れている。"
msgstr ""

#. Occurrence 9_7:850:14124: scene=9_7
#: 9_7:850
msgctxt "text_id=14124 | speaker=unknown"
msgid "　それよりいま重要なのは、有珠の平手で記憶が鮮明になったという事だ。"
msgstr ""

#. Occurrence 9_7:871:14125: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0007; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:871
msgctxt "text_id=14125 | speaker=soujuurou"
msgid "「思い出した。青子じゃ私には勝てないって、伝えておいてほしいって」"
msgstr ""

#. Occurrence 9_7:887:14126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0008; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:887
msgctxt "text_id=14126 | speaker=aoko"
msgid "「ふーん、大した自信ね。他には？」"
msgstr ""

#. Occurrence 9_7:928:14127: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0008; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:928
msgctxt "text_id=14127 | speaker=soujuurou"
msgid "「他は……基本的に世間話だったというか……ああ、そあとかもあとか、よく分からないコトを口にしてたな」"
msgstr ""

#. Occurrence 9_7:950:14128: scene=9_7
#: 9_7:950
msgctxt "text_id=14128 | speaker=unknown"
msgid "　それはともかく、世間話の大半が青子の失敗談だった事は墓まで持っていこう、と誓う草十郎だった。"
msgstr ""

#. Occurrence 9_7:971:14129: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0009; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:971
msgctxt "text_id=14129 | speaker=aoko"
msgid "「大我と小我？　あの人、インドにでも行ってたのかしら。"
msgstr ""

#. Occurrence 9_7:977:14130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0010; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:977
msgctxt "text_id=14130 | speaker=aoko"
msgid "　ところで草十郎。アンタ、姉貴に何かされたわね」"
msgstr ""

#. Occurrence 9_7:995:14131: scene=9_7
#: 9_7:995
msgctxt "text_id=14131 | speaker=unknown"
msgid "　じろり、と鋭い視線を青子は向ける。"
msgstr ""

#. Occurrence 9_7:1000:14132: scene=9_7
#: 9_7:1000
msgctxt "text_id=14132 | speaker=unknown"
msgid "　後ろめたい事は何もないのに、草十郎はそれについ顔を背けてしまった。"
msgstr ""

#. Occurrence 9_7:1021:14133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0009; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1021
msgctxt "text_id=14133 | speaker=soujuurou"
msgid "「何かって、何さ」"
msgstr ""

#. Occurrence 9_7:1033:14134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0011_0; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1033
msgctxt "text_id=14134 | speaker=aoko"
msgid "「思い出せない、とか言ってたでしょ。さっきまでの態度もふわふわしてたし。"
msgstr ""

#. Occurrence 9_7:1045:14135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0011_1; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1045
msgctxt "text_id=14135 | speaker=aoko"
msgid "……そうか、眼鏡を外したまでは覚えてたって事は、魔眼にでも魅入られたか」"
msgstr ""

#. Occurrence 9_7:1065:14136: scene=9_7
#: 9_7:1065
msgctxt "text_id=14136 | speaker=unknown"
msgid "　そうやって勝手に結論に辿り着くと、青子はもう興味なし、とばかりに黙りこむ。"
msgstr ""

#. Occurrence 9_7:1070:14137: scene=9_7
#: 9_7:1070
msgctxt "text_id=14137 | speaker=unknown"
msgid "　しっくりいかないのは草十郎である。"
msgstr ""

#. Occurrence 9_7:1111:14138: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0010; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1111
msgctxt "text_id=14138 | speaker=soujuurou"
msgid "「蒼崎、まがんって何だ？」"
msgstr ""

#. Occurrence 9_7:1139:14139: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0012; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1139
msgctxt "text_id=14139 | speaker=aoko"
msgid "「……魔力を帯びた目の事よ。簡単な物は一時的な混乱を、上級な物は睨んだだけで相手を殺す、とかね。"
msgstr ""

#. Occurrence 9_7:1145:14140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0013; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1145
msgctxt "text_id=14140 | speaker=aoko"
msgid "　……ま、バロールみたいな魔眼の持ち主なんて伝説だけだろうし、そもそもそんな魔眼持ちが生まれてくるなら私たちの悩みもあっさり終わるってものだけど」"
msgstr ""

#. Occurrence 9_7:1182:14141: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0011; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1182
msgctxt "text_id=14141 | speaker=soujuurou"
msgid "「……？」"
msgstr ""

#. Occurrence 9_7:1188:14142: scene=9_7
#: 9_7:1188
msgctxt "text_id=14142 | speaker=unknown"
msgid "　青子の説明は事情を知らない<草十郎|いちげんさん>にはさっぱりである。"
msgstr ""

#. Occurrence 9_7:1221:14143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0014; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1221
msgctxt "text_id=14143 | speaker=aoko"
msgid "「……んー、そうね。"
msgstr ""

#. Occurrence 9_7:1228:14144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0015; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1228
msgctxt "text_id=14144 | speaker=aoko"
msgid "分かりやすく言うと、私の魔弾みたいなのを目から照射するようなもんよ」"
msgstr ""

#. Occurrence 9_7:1248:14145: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0012; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1248
msgctxt "text_id=14145 | speaker=soujuurou"
msgid "「目から……蒼崎……が？」"
msgstr ""

#. Occurrence 9_7:1254:14146: scene=9_7
#: 9_7:1254
msgctxt "text_id=14146 | speaker=unknown"
msgid "　退屈そうな青子とは反対に、草十郎の混乱はより深くなっていく。"
msgstr ""

#. Occurrence 9_7:1296:14147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0016; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1296
msgctxt "text_id=14147 | speaker=aoko"
msgid "「だから！　貴方、一度目を閉じた後の橙子の目を見たんでしょ？　その一瞬で姉貴の魔眼に捕まったってコト！"
msgstr ""

#. Occurrence 9_7:1302:14148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0017; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1302
msgctxt "text_id=14148 | speaker=aoko"
msgid "　目を猫目石に入れ替える魔術師もいるけど、姉貴はそんな事する必要はないから。"
msgstr ""

#. Occurrence 9_7:1308:14149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0018; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1308
msgctxt "text_id=14149 | speaker=aoko"
msgid "　あの人、生まれながらの魔眼持ちだしね。さしたる準備も詠唱もなしで、<閉塞|シャッター>するだけで切り替え自由なの」"
msgstr ""

#. Occurrence 9_7:1348:14150: scene=9_7
#: 9_7:1348
msgctxt "text_id=14150 | speaker=unknown"
msgid "　ぽん、と手を叩く草十郎。"
msgstr ""

#. Occurrence 9_7:1353:14151: scene=9_7
#: 9_7:1353
msgctxt "text_id=14151 | speaker=unknown"
msgid "　たしかに、橙子はそんな仕草をしていた気がする。"
msgstr ""

#. Occurrence 9_7:1358:14152: scene=9_7
#: 9_7:1358
msgctxt "text_id=14152 | speaker=unknown"
msgid "　あの直後から心が惑わされたのは、魔眼とやらの力が大きいらしい。"
msgstr ""

#. Occurrence 9_7:1385:14153: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0013; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1385
msgctxt "text_id=14153 | speaker=soujuurou"
msgid "「……その話は分かったけど。"
msgstr ""

#. Occurrence 9_7:1412:14154: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0014; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1412
msgctxt "text_id=14154 | speaker=soujuurou"
msgid "　橙子さんは蒼崎のお姉さんなんだろう？　なんで<姉妹|しまい>で殺し合いをしてるんだ」"
msgstr ""

#. Occurrence 9_7:1424:14155: scene=9_7
#: 9_7:1424
msgctxt "text_id=14155 | speaker=unknown"
msgid "　聞くべきではない事と分かっていても、あえて草十郎は問いただした。"
msgstr ""

#. Occurrence 9_7:1444:14156: scene=9_7
#: 9_7:1444
msgctxt "text_id=14156 | speaker=unknown"
msgid "　条約違反である質問。"
msgstr ""

#. Occurrence 9_7:1471:14157: scene=9_7
#: 9_7:1471
msgctxt "text_id=14157 | speaker=unknown"
msgid "　彼には関係のない、関わらせてはいけない争い。"
msgstr ""

#. Occurrence 9_7:1487:14158: scene=9_7
#: 9_7:1487
msgctxt "text_id=14158 | speaker=unknown"
msgid "　青子はしばし瞳を閉じて状況を整理し―――"
msgstr ""

#. Occurrence 9_7:1492:14159: scene=9_7
#: 9_7:1492
msgctxt "text_id=14159 | speaker=unknown"
msgid "　ここでつっぱねるより、概要だけ話して黙らせる方がお互いの為と判断した。"
msgstr ""

#. Occurrence 9_7:1513:14160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0019; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1513
msgctxt "text_id=14160 | speaker=aoko"
msgid "「いいわ、話してあげる。姉貴に関わった以上、事情を説明しておかないと危ないし。"
msgstr ""

#. Occurrence 9_7:1519:14161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0020; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1519
msgctxt "text_id=14161 | speaker=aoko"
msgid "　けど、なんであれ聞き返すのはナシね。この件に関しては、私は私の事情を話すだけだから」"
msgstr ""

#. Occurrence 9_7:1551:14162: scene=9_7
#: 9_7:1551
msgctxt "text_id=14162 | speaker=unknown"
msgid "　物わかり良さげに頷く草十郎に、どうだか、と青子は疑いの視線を向けた。"
msgstr ""

#. Occurrence 9_7:1556:14163: scene=9_7
#: 9_7:1556
msgctxt "text_id=14163 | speaker=unknown"
msgid "　草十郎の性格は、それなりに把握できている。"
msgstr ""

#. Occurrence 9_7:1566:14164: scene=9_7
#: 9_7:1566
msgctxt "text_id=14164 | speaker=unknown"
msgid "　またヘンに親身になったりするのは目に見えているが、話すと言ったからには話そう、と青子は姿勢を切り替えた。"
msgstr ""

#. Occurrence 9_7:1593:14165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0021; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1593
msgctxt "text_id=14165 | speaker=aoko"
msgid "「……姉貴の話をするってコトは、私と蒼崎の家の話と、なにより魔術と魔法の話をしないといけない。"
msgstr ""

#. Occurrence 9_7:1599:14166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0022; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1599
msgctxt "text_id=14166 | speaker=aoko"
msgid "　少し遠回りになるし他言無用な内容だけど、いずれアンタの記憶は消えるから問題ないってコトで」"
msgstr ""

#. Occurrence 9_7:1621:14167: scene=9_7
#: 9_7:1621
msgctxt "text_id=14167 | speaker=unknown"
msgid "　誰に対しての断りか、そういう前提付きだから話してあげるのよ、と青子は念を押す。"
msgstr ""

#. Occurrence 9_7:1657:14168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0023; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1657
msgctxt "text_id=14168 | speaker=aoko"
msgid "「魔術っていうのはね、草十郎。いわば共通のルールなのよ。"
msgstr ""

#. Occurrence 9_7:1664:14169: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0024; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1664
msgctxt "text_id=14169 | speaker=aoko"
msgid "ルーンやカバラといった魔術系統はそれぞれの科目……世界共通の<教科書|マニュアル>だと思えばいい。"
msgstr ""

#. Occurrence 9_7:1670:14170: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0025; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1670
msgctxt "text_id=14170 | speaker=aoko"
msgid "　教科書さえきちんと持っているのなら、あとは血脈次第で誰でも魔術師にはなれるわ。"
msgstr ""

#. Occurrence 9_7:1676:14171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0026; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1676
msgctxt "text_id=14171 | speaker=aoko"
msgid "　けど魔法を使うのは別。"
msgstr ""

#. Occurrence 9_7:1682:14172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0027; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1682
msgctxt "text_id=14172 | speaker=aoko"
msgid "　魔法は魔術みたいに『根源の渦』から派生した写本じゃなくて、根源の渦に直接つながる物だから」"
msgstr ""

#. Occurrence 9_7:1714:14173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0028_0; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1714
msgctxt "text_id=14173 | speaker=aoko"
msgid "「この根源の渦っていうのは……"
msgstr ""

#. Occurrence 9_7:1727:14174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0028_1; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1727
msgctxt "text_id=14174 | speaker=aoko"
msgid "あー、草十郎の分かるレベルに落としこむと……ま、太陽みたいなものと考えて。"
msgstr ""

#. Occurrence 9_7:1739:14175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0029; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1739
msgctxt "text_id=14175 | speaker=aoko"
msgid "　遠くにあって、なにより初めにあるもので、それなくしては私たちは生活できない、といった」"
msgstr ""

#. Occurrence 9_7:1797:14176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0030; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1797
msgctxt "text_id=14176 | speaker=aoko"
msgid "「魔術っていうのは、この太陽からの恩恵を利用しただけのものよ。"
msgstr ""

#. Occurrence 9_7:1803:14177: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0031; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1803
msgctxt "text_id=14177 | speaker=aoko"
msgid "　自然現象の模倣、ないし代償が魔術の本質だから。神秘を学び、実践し、再現するけど、神秘そのものを作る事はできない。"
msgstr ""

#. Occurrence 9_7:1814:14178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0032; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1814
msgctxt "text_id=14178 | speaker=aoko"
msgid "　いえ、研究の末にたどり着くんでしょうけど、そこには大きな壁がある。人知では超えられない、リミッターみたいな壁がね」"
msgstr ""

#. Occurrence 9_7:1841:14179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0033; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1841
msgctxt "text_id=14179 | speaker=aoko"
msgid "「で、魔法っていうのは太陽そのものを扱うコト。"
msgstr ""

#. Occurrence 9_7:1859:14180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0034; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1859
msgctxt "text_id=14180 | speaker=aoko"
msgid "　誰にも到達できない場所に行って、"
msgstr ""

#. Occurrence 9_7:1865:14181: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0035; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1865
msgctxt "text_id=14181 | speaker=aoko"
msgid "　何者にも<再現|マネ>できない奇跡を起こす。"
msgstr ""

#. Occurrence 9_7:1871:14182: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0036; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1871
msgctxt "text_id=14182 | speaker=aoko"
msgid "　お金をかけようが時間をかけようが、今の人類には到達できない技術―――それが魔法」"
msgstr ""

#. Occurrence 9_7:1894:14183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0037; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1894
msgctxt "text_id=14183 | speaker=aoko"
msgid "「次元の壁を越えるっていうか。最後まで走ってみたら、まったく違うルールで出来た世界があって、そのルールを学んじゃった……ってとこかしら」"
msgstr ""

#. Occurrence 9_7:1915:14184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0038; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1915
msgctxt "text_id=14184 | speaker=aoko"
msgid "「前に、魔術に限界はないって言ったでしょ。あれは人知の及ぶ範囲なら限界はない、って意味ね。"
msgstr ""

#. Occurrence 9_7:1921:14185: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0039; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1921
msgctxt "text_id=14185 | speaker=aoko"
msgid "　対して、魔法は限界だらけ―――っていうか、ひとつの事しかできないけど、それも当然なの。だってこの宇宙の<概念|しくみ>から仲間はずれの、ひとつっきりの光点なんだから」"
msgstr ""

#. Occurrence 9_7:1967:14186: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0015; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1967
msgctxt "text_id=14186 | speaker=soujuurou"
msgid "「……魔術より魔法の方が凄い……というのは、流れ的に分かるんだけど。"
msgstr ""

#. Occurrence 9_7:1974:14187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0016; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1974
msgctxt "text_id=14187 | speaker=soujuurou"
msgid "限界だらけ、なんだよな？」"
msgstr ""

#. Occurrence 9_7:2001:14188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0040; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2001
msgctxt "text_id=14188 | speaker=aoko"
msgid "「限界っていうか特例、特権、越権の類ね。"
msgstr ""

#. Occurrence 9_7:2007:14189: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0041; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2007
msgctxt "text_id=14189 | speaker=aoko"
msgid "　汎用性はないけど、誰にも出来ない事を可能とする時点で、魔術世界にとっては万能とされる」"
msgstr ""

#. Occurrence 9_7:2034:14190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0042; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2034
msgctxt "text_id=14190 | speaker=aoko"
msgid "「そもそも魔法は『根源の渦』にたどり着いた魔術師へのご褒美みたいなもので、たとえその術者に魔法を使うだけの肉体性能がなくても、根源への<路|パス>ができただけで魔術的にはやりたい放題ってわけ。"
msgstr ""

#. Occurrence 9_7:2046:14191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0043; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2046
msgctxt "text_id=14191 | speaker=aoko"
msgid "　要は、地球で一番のお金持ちになるってコト」"
msgstr ""

#. Occurrence 9_7:2086:14192: scene=9_7
#: 9_7:2086
msgctxt "text_id=14192 | speaker=unknown"
msgid "　力強い発言に、おお、と感動する草十郎。"
msgstr ""

#. Occurrence 9_7:2111:14193: scene=9_7
#: 9_7:2111
msgctxt "text_id=14193 | speaker=unknown"
msgid "　一方、青子の暴論を色々改めたくて仕方のない有珠。"
msgstr ""

#. Occurrence 9_7:2144:14194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0017; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2144
msgctxt "text_id=14194 | speaker=soujuurou"
msgid "「一番の大金持ちか……じゃあ、どんなにお金持ちでも、一番目でない以上は魔法は貰えないんだな？」"
msgstr ""

#. Occurrence 9_7:2184:14195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0044; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2184
msgctxt "text_id=14195 | speaker=aoko"
msgid "「―――まあ、そういう事。"
msgstr ""

#. Occurrence 9_7:2196:14196: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0045; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2196
msgctxt "text_id=14196 | speaker=aoko"
msgid "　……時々とんでもない角度で核心をつくわね、コイツ……アンタの言う通り、同じ<理論|ルート>、同じ方法で根源に辿り着いても、一番目じゃないと魔法にはたどり着けない。"
msgstr ""

#. Occurrence 9_7:2202:14197: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0046; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2202
msgctxt "text_id=14197 | speaker=aoko"
msgid "　どんなに優れていても二番目以降には意味がないのよ」"
msgstr ""

#. Occurrence 9_7:2233:14198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0047; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2233
msgctxt "text_id=14198 | speaker=aoko"
msgid "「魔法使いが五人……いえ、四人か。"
msgstr ""

#. Occurrence 9_7:2239:14199: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0048; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2239
msgctxt "text_id=14199 | speaker=aoko"
msgid "　現存する魔法使いが四人しかいないのは、一度使われた<未|ル><知|ート>は<確定|とざ>されてしまうから。"
msgstr ""

#. Occurrence 9_7:2245:14200: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0049; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2245
msgctxt "text_id=14200 | speaker=aoko"
msgid "　大昔はそうでもなかったって話だけどね。"
msgstr ""

#. Occurrence 9_7:2251:14201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0050; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2251
msgctxt "text_id=14201 | speaker=aoko"
msgid "　根源への路……真理への到達に壁を作ったのは、皮肉なことに人間自身だった」"
msgstr ""

#. Occurrence 9_7:2276:14202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0051; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2276
msgctxt "text_id=14202 | speaker=aoko"
msgid "「未知を解明すればするほどルートが閉じていくなんて、昔の魔術師たちは思いもしなかったんでしょう。"
msgstr ""

#. Occurrence 9_7:2282:14203: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0052; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2282
msgctxt "text_id=14203 | speaker=aoko"
msgid "　でも結果はこの通り、気が付いた時には後の祭りっていうか。多くの研鑽の末、この世から魔法は消えていっちゃったワケ」"
msgstr ""

#. Occurrence 9_7:2327:14204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0018; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2327
msgctxt "text_id=14204 | speaker=soujuurou"
msgid "「……ふーん。それは、山と町の関係に似てる……と思っていいのかな」"
msgstr ""

#. Occurrence 9_7:2360:14205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0053; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2360
msgctxt "text_id=14205 | speaker=aoko"
msgid "「ミクロな視点で言うなら、似たようなものよ。"
msgstr ""

#. Occurrence 9_7:2372:14206: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0054; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2372
msgctxt "text_id=14206 | speaker=aoko"
msgid "　で―――つい最近まで、現代の魔術師たちは残された最後の席を求めていたけど、それもちょっと前にどこぞの田舎者が横取りしちゃって、イス取りゲームはあえなく終了。"
msgstr ""

#. Occurrence 9_7:2378:14207: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0055; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2378
msgctxt "text_id=14207 | speaker=aoko"
msgid "　あとは魔法抜きで根源にたどり着くため、地味で無意味な魔術の研究を続ける事になった」"
msgstr ""

#. Occurrence 9_7:2405:14208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0056; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2405
msgctxt "text_id=14208 | speaker=aoko"
msgid "「……ま、もともと魔法なんてのを優先してたのは一部の魔術師だけで、他のまっとうな連中はとっくに見切りをつけてたんだけどね。"
msgstr ""

#. Occurrence 9_7:2417:14209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0057; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2417
msgctxt "text_id=14209 | speaker=aoko"
msgid "　だって、魔術師にとって最終目的は根源の渦への到達であって魔法じゃないし。"
msgstr ""

#. Occurrence 9_7:2423:14210: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0058; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2423
msgctxt "text_id=14210 | speaker=aoko"
msgid "　そのあたりいつのまにかごっちゃになっちゃったんでしょ。卵が先か鶏が先かって話」"
msgstr ""

#. Occurrence 9_7:2466:14211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0019; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2466
msgctxt "text_id=14211 | speaker=soujuurou"
msgid "「……よし。まったく分からないってコトは分かったんで、そろそろ本題に入ってくれ。"
msgstr ""

#. Occurrence 9_7:2478:14212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0020; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2478
msgctxt "text_id=14212 | speaker=soujuurou"
msgid "　あ。けど、一番目の人間しか魔法使いになれないのに、魔法使いは何人もいるのか？」"
msgstr ""

#. Occurrence 9_7:2524:14213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0059; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2524
msgctxt "text_id=14213 | speaker=aoko"
msgid "「五人いたわ。最終的に、人間に残される最後の課題は五つだろうって一番初めの―――」"
msgstr ""

#. Occurrence 9_7:2552:14214: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0004; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:2552
msgctxt "text_id=14214 | speaker=alice"
msgid "「青子」"
msgstr ""

#. Occurrence 9_7:2598:14215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0060; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2598
msgctxt "text_id=14215 | speaker=aoko"
msgid "「―――じゃ、本題ね。"
msgstr ""

#. Occurrence 9_7:2604:14216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0061; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2604
msgctxt "text_id=14216 | speaker=aoko"
msgid "　魔法と魔術の関係が分かったところで、ようやくうちの話になるんだけど」"
msgstr ""

#. Occurrence 9_7:2631:14217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0062; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2631
msgctxt "text_id=14217 | speaker=aoko"
msgid "「蒼崎の家が代々魔術師だったのは前に言ったでしょ？"
msgstr ""

#. Occurrence 9_7:2637:14218: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0063; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2637
msgctxt "text_id=14218 | speaker=aoko"
msgid "　歴史的には浅いけど、運と才能には恵まれていたのね。"
msgstr ""

#. Occurrence 9_7:2643:14219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0064; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2643
msgctxt "text_id=14219 | speaker=aoko"
msgid "　蒼崎は、なんだかんだって魔法にまで辿り着いたんだから」"
msgstr ""

#. Occurrence 9_7:2678:14220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0021; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2678
msgctxt "text_id=14220 | speaker=soujuurou"
msgid "「―――ちょっと待った。じゃあ、蒼崎が、その、」"
msgstr ""

#. Occurrence 9_7:2705:14221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0065; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2705
msgctxt "text_id=14221 | speaker=aoko"
msgid "「私はあくまで魔術師見習い。"
msgstr ""

#. Occurrence 9_7:2711:14222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0066; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2711
msgctxt "text_id=14222 | speaker=aoko"
msgid "　使えないし、使う気もないわよ、魔法なんて。私はただ、蒼崎の家を継いだだけだもの」"
msgstr ""

#. Occurrence 9_7:2741:14223: scene=9_7
#: 9_7:2741
msgctxt "text_id=14223 | speaker=unknown"
msgid "　青子は簡潔に、感情のない声で言い切った。"
msgstr ""

#. Occurrence 9_7:2746:14224: scene=9_7
#: 9_7:2746
msgctxt "text_id=14224 | speaker=unknown"
msgid "　魔法使いになるために魔術師になったのではなく、"
msgstr ""

#. Occurrence 9_7:2751:14225: scene=9_7
#: 9_7:2751
msgctxt "text_id=14225 | speaker=unknown"
msgid "　蒼崎の家を継ぐコトになったから、魔術師として生きていく道を選んだのだと。"
msgstr ""

#. Occurrence 9_7:2786:14226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0067; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2786
msgctxt "text_id=14226 | speaker=aoko"
msgid "「……ま、とにかく。"
msgstr ""

#. Occurrence 9_7:2825:14227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0068; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2825
msgctxt "text_id=14227 | speaker=aoko"
msgid "　根源の渦に辿り着くには、何代も何代も魔術を研究しなくちゃいけない。自分独自の川を造るようなものなんだから、もちろんその過程は果てがない。"
msgstr ""

#. Occurrence 9_7:2837:14228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0069; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2837
msgctxt "text_id=14228 | speaker=aoko"
msgid "　よほどの天賦か天啓でもないかぎり魔法を創るなんてできないしね」"
msgstr ""

#. Occurrence 9_7:2873:14229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0070; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2873
msgctxt "text_id=14229 | speaker=aoko"
msgid "「そしてもし根源に辿り着いても、相応しい後継者がいなければ一代かぎりの奇跡で終わってしまう。"
msgstr ""

#. Occurrence 9_7:2879:14230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0071; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2879
msgctxt "text_id=14230 | speaker=aoko"
msgid "　だから魔術師は血脈を重ねて、代々の魔力を次代に積み重ねていく。自分より勝れた後継者を生むために」"
msgstr ""

#. Occurrence 9_7:2899:14231: scene=9_7
#: 9_7:2899
msgctxt "text_id=14231 | speaker=unknown"
msgid "　要するにサラブレッドを作っているのよ、と青子は一度話を切った。"
msgstr ""

#. Occurrence 9_7:2904:14232: scene=9_7
#: 9_7:2904
msgctxt "text_id=14232 | speaker=unknown"
msgid "　もともと草十郎に理解させる気はこれっぽっちもないので、サラブレッド？　と首をひねる草十郎を華麗にスルーする。"
msgstr ""

#. Occurrence 9_7:2933:14233: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0072; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2933
msgctxt "text_id=14233 | speaker=aoko"
msgid "「そうやって代を重ねて、魔術師は作り上げた独自の神秘、守り続けた魔術を次の世代に伝えていくの。"
msgstr ""

#. Occurrence 9_7:2939:14234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0073; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2939
msgctxt "text_id=14234 | speaker=aoko"
msgid "　きっと最後の最後に、全ての疑問を打ち消すに足る答えがある筈だって」"
msgstr ""

#. Occurrence 9_7:2967:14235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0074; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2967
msgctxt "text_id=14235 | speaker=aoko"
msgid "「でも魔術師―――いえ、魔法使いだって、みんな悟ってるのよ。"
msgstr ""

#. Occurrence 9_7:2973:14236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0075; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2973
msgctxt "text_id=14236 | speaker=aoko"
msgid "　自分の代でも、その次の代でも、きっと最後の最後の最後まで、誰もゴールには辿り着けないって結末を。"
msgstr ""

#. Occurrence 9_7:2999:14237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0076; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2999
msgctxt "text_id=14237 | speaker=aoko"
msgid "　それを解っていながら魔術を研究していくのが神秘学に取り憑かれた者の宿命だって、祖父はよく口にしてた。"
msgstr ""

#. Occurrence 9_7:3005:14238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0077; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3005
msgctxt "text_id=14238 | speaker=aoko"
msgid "　けど、私の姉はそうじゃなかったみたい」"
msgstr ""

#. Occurrence 9_7:3045:14239: scene=9_7
#: 9_7:3045
msgctxt "text_id=14239 | speaker=unknown"
msgid "　その気持ちも分かるけどね、と青子はひとり呟く。"
msgstr ""

#. Occurrence 9_7:3064:14240: scene=9_7
#: 9_7:3064
msgctxt "text_id=14240 | speaker=unknown"
msgid "　有珠はそれには無反応だ。"
msgstr ""

#. Occurrence 9_7:3079:14241: scene=9_7
#: 9_7:3079
msgctxt "text_id=14241 | speaker=unknown"
msgid "　魔法を伝える蒼崎の家。"
msgstr ""

#. Occurrence 9_7:3088:14242: scene=9_7
#: 9_7:3088
msgctxt "text_id=14242 | speaker=unknown"
msgid "　その後継者となった青子。"
msgstr ""

#. Occurrence 9_7:3102:14243: scene=9_7
#: 9_7:3102
msgctxt "text_id=14243 | speaker=unknown"
msgid "　そして―――青子の姉である蒼崎橙子。"
msgstr ""

#. Occurrence 9_7:3123:14244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0078; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3123
msgctxt "text_id=14244 | speaker=aoko"
msgid "「……ほんとは、蒼崎の後継者は姉貴だった。"
msgstr ""

#. Occurrence 9_7:3129:14245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0079; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3129
msgctxt "text_id=14245 | speaker=aoko"
msgid "　私もうちの家業がなんであるかは教えられてきたけど、実践する事はなかったのよ。"
msgstr ""

#. Occurrence 9_7:3135:14246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0080; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3135
msgctxt "text_id=14246 | speaker=aoko"
msgid "　魔術師の家系はよっぽど裕福でもないかぎり、基本的に一子相伝だからね。うち、ホント財力的には一般家庭レベルだし」"
msgstr ""

#. Occurrence 9_7:3183:14247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0081; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3183
msgctxt "text_id=14247 | speaker=aoko"
msgid "「で、後継者にはより魔術に適した者が選ばれるワケだけど……姉貴はたしかに天才だった。"
msgstr ""

#. Occurrence 9_7:3189:14248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0082; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3189
msgctxt "text_id=14248 | speaker=aoko"
msgid "　けどそれは、蒼崎の後継者にはいらない才能だった」"
msgstr ""

#. Occurrence 9_7:3216:14249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0083; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3216
msgctxt "text_id=14249 | speaker=aoko"
msgid "「そのかわり、私は心底蒼崎の後継者として相応しかったみたい。"
msgstr ""

#. Occurrence 9_7:3222:14250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0084; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3222
msgctxt "text_id=14250 | speaker=aoko"
msgid "　……まあ、それはそれでどうも思わないけど、祖父がはっきりと私に鞍替えしたのが十五歳の冬の頃でさ。"
msgstr ""

#. Occurrence 9_7:3228:14251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0085; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3228
msgctxt "text_id=14251 | speaker=aoko"
msgid "　姉貴はいきなり、四つ年下で、今まで魔術に関わってなかった妹に魔法の相続権利を奪われたってワケよ」"
msgstr ""

#. Occurrence 9_7:3263:14252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0022; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3263
msgctxt "text_id=14252 | speaker=soujuurou"
msgid "「…………そうか、それで」"
msgstr ""

#. Occurrence 9_7:3281:14253: scene=9_7
#: 9_7:3281
msgctxt "text_id=14253 | speaker=unknown"
msgid "　……私にはその<義|・><務|・>がある、と。"
msgstr ""

#. Occurrence 9_7:3300:14254: scene=9_7
#: 9_7:3300
msgctxt "text_id=14254 | speaker=unknown"
msgid "　蒼崎橙子は、憎しみに満ちた声で言い切ったのだ。"
msgstr ""

#. Occurrence 9_7:3341:14255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0086; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3341
msgctxt "text_id=14255 | speaker=aoko"
msgid "「<姉貴|あのひと>がどんな思いをしたか、私は本人じゃないから知らないけど。"
msgstr ""

#. Occurrence 9_7:3347:14256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0087; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3347
msgctxt "text_id=14256 | speaker=aoko"
msgid "　祖父と言い争って、今まで愛用してた眼鏡を叩き壊して家を出ていったのが三年と半年前。"
msgstr ""

#. Occurrence 9_7:3353:14257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0088; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3353
msgctxt "text_id=14257 | speaker=aoko"
msgid "　それからまったく消息なしで、私は姉の代わりになったの。これが、私と姉貴の争う原因でしょうね」"
msgstr ""

#. Occurrence 9_7:3391:14258: scene=9_7
#: 9_7:3391
msgctxt "text_id=14258 | speaker=unknown"
msgid "　かなり重い話だと草十郎は思うのだけど、青子の声はさっぱりしている。"
msgstr ""

#. Occurrence 9_7:3396:14259: scene=9_7
#: 9_7:3396
msgctxt "text_id=14259 | speaker=unknown"
msgid "　それが幼い頃から植え付けられた魔術師の思考だとしたら、同情すべきはどちらにあるのだろうか。"
msgstr ""

#. Occurrence 9_7:3433:14260: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0023; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3433
msgctxt "text_id=14260 | speaker=soujuurou"
msgid "「……眼鏡を壊した、か」"
msgstr ""

#. Occurrence 9_7:3452:14261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0089; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3452
msgctxt "text_id=14261 | speaker=aoko"
msgid "「そう。あの人、昔はすっごく目が良かった。生まれながら魔眼を持ってたって化物だからね。"
msgstr ""

#. Occurrence 9_7:3458:14262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0090; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3458
msgctxt "text_id=14262 | speaker=aoko"
msgid "　けど祖父の期待に応えようとして、無理して頑張ったあげく視力が下がっちゃったみたい」"
msgstr ""

#. Occurrence 9_7:3496:14263: scene=9_7
#: 9_7:3496
msgctxt "text_id=14263 | speaker=unknown"
msgid "　なんだかねー、と呆れる青子。"
msgstr ""

#. Occurrence 9_7:3517:14264: scene=9_7
#: 9_7:3517
msgctxt "text_id=14264 | speaker=unknown"
msgid "　青子の冷徹さを知っている草十郎だが、さすがに今のは見ていて気持ちのいいものではない。"
msgstr ""

#. Occurrence 9_7:3549:14265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0091; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3549
msgctxt "text_id=14265 | speaker=aoko"
msgid "「けど、あれに何の意味があったんだろう。"
msgstr ""

#. Occurrence 9_7:3555:14266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0092; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3555
msgctxt "text_id=14266 | speaker=aoko"
msgid "　眼鏡を<祖父|じじい>に叩きつけるぐらいなら、フィンの一撃でも叩きこめば良かったのに。"
msgstr ""

#. Occurrence 9_7:3561:14267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0093; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3561
msgctxt "text_id=14267 | speaker=aoko"
msgid "　あの人、あの頃が才能のピークだったんだし、<耄碌|もうろく>した<祖|じ><父|じい>なんてそれこそ一撃だったと思うんだけど……」"
msgstr ""

#. Occurrence 9_7:3602:14268: scene=9_7
#: 9_7:3602
msgctxt "text_id=14268 | speaker=unknown"
msgid "　はて、と今更ながら考えこむ青子に、草十郎はうつむいて批難する。"
msgstr ""

#. Occurrence 9_7:3630:14269: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0024; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3630
msgctxt "text_id=14269 | speaker=soujuurou"
msgid "「恨み辛みの話じゃない。"
msgstr ""

#. Occurrence 9_7:3642:14270: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0025; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3642
msgctxt "text_id=14270 | speaker=soujuurou"
msgid "　……その眼鏡は、大事な物だったんだ。だってそれは、誰にだって分かる努力の証なんだから。"
msgstr ""

#. Occurrence 9_7:3648:14271: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0026; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3648
msgctxt "text_id=14271 | speaker=soujuurou"
msgid "　それを叩きつけたんだ。痛かったんだろうな、橙子さんは。思い出を、自分で壊さなくちゃいけないぐらいに」"
msgstr ""

#. Occurrence 9_7:3688:14272: scene=9_7
#: 9_7:3688
msgctxt "text_id=14272 | speaker=unknown"
msgid "　そう語る草十郎自身、痛みをかみ殺している事に青子も有珠も気付かない。"
msgstr ""

#. Occurrence 9_7:3693:14273: scene=9_7
#: 9_7:3693
msgctxt "text_id=14273 | speaker=unknown"
msgid "　というより、二人には草十郎の心情が理解できない。"
msgstr ""

#. Occurrence 9_7:3698:14274: scene=9_7
#: 9_7:3698
msgctxt "text_id=14274 | speaker=unknown"
msgid "　魔術師として育てられ、戦うべき敵として認識しあう彼女たちには、そういった感傷は必要ないからだ。"
msgstr ""

#. Occurrence 9_7:3735:14275: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0005; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:3735
msgctxt "text_id=14275 | speaker=alice"
msgid "「……けど、どうして今ごろになって戻ってきたのかしら。青子の言う通り、橙子さんならもっと早く三咲市を奪えたのに」"
msgstr ""

#. Occurrence 9_7:3755:14276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0094; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3755
msgctxt "text_id=14276 | speaker=aoko"
msgid "「そうね。そんなに土地が欲しかったのなら、三年前に私を殺せば後継者に戻れたのに。"
msgstr ""

#. Occurrence 9_7:3767:14277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0095; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3767
msgctxt "text_id=14277 | speaker=aoko"
msgid "　……世間の荒波にもまれて気が変わったとか……？」"
msgstr ""

#. Occurrence 9_7:3788:14278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0027; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3788
msgctxt "text_id=14278 | speaker=soujuurou"
msgid "「違う。蒼崎は本当に分からないのか」"
msgstr ""

#. Occurrence 9_7:3808:14279: scene=9_7
#: 9_7:3808
msgctxt "text_id=14279 | speaker=unknown"
msgid "　微かな<憤|いきどお>りが草十郎を揺り動かす。"
msgstr ""

#. Occurrence 9_7:3813:14280: scene=9_7
#: 9_7:3813
msgctxt "text_id=14280 | speaker=unknown"
msgid "　その声は、二人の知っている少年とは少しだけ違っていた。"
msgstr ""

#. Occurrence 9_7:3855:14281: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0096; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3855
msgctxt "text_id=14281 | speaker=aoko"
msgid "「な、なによ。アンタなら分かるっていうの？」"
msgstr ""

#. Occurrence 9_7:3861:14282: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0028; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3861
msgctxt "text_id=14282 | speaker=soujuurou"
msgid "「誰だって分かる。"
msgstr ""

#. Occurrence 9_7:3887:14283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0029; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3887
msgctxt "text_id=14283 | speaker=soujuurou"
msgid "　橙子さんは、蒼崎が一人前になるまで待っていたんだ。自分が失った物と同じぐらい、大切な物を無くさせるために。そうしないとどうにもならない。そこまでしなくちゃいけないほど、あの人の怒りは深かったんだ」"
msgstr ""

#. Occurrence 9_7:3966:14284: scene=9_7
#: 9_7:3966
msgctxt "text_id=14284 | speaker=unknown"
msgid "　なんでそれが分からない、と草十郎は二人を見据える。"
msgstr ""

#. Occurrence 9_7:3971:14285: scene=9_7
#: 9_7:3971
msgctxt "text_id=14285 | speaker=unknown"
msgid "　だが、分かっていないのは彼の方だ。"
msgstr ""

#. Occurrence 9_7:3976:14286: scene=9_7
#: 9_7:3976
msgctxt "text_id=14286 | speaker=unknown"
msgid "　そういった人間らしい関係を、彼女たちは、何より蒼崎橙子は、一番初めに断っているのだから。"
msgstr ""

#. Occurrence 9_7:4008:14287: scene=9_7
#: 9_7:4008
msgctxt "text_id=14287 | speaker=unknown"
msgid "　橙子を動かしているのは憎しみではない。"
msgstr ""

#. Occurrence 9_7:4013:14288: scene=9_7
#: 9_7:4013
msgctxt "text_id=14288 | speaker=unknown"
msgid "　たしかにそれもあるにはあるが、彼女を突き動かす最大の理由は魔法に至ること一点。"
msgstr ""

#. Occurrence 9_7:4018:14289: scene=9_7
#: 9_7:4018
msgctxt "text_id=14289 | speaker=unknown"
msgid "　彼女は貪欲で優秀な魔術師であり、憎しみなど後付の<外皮|りゆう>でしかない。"
msgstr ""

#. Occurrence 9_7:4023:14290: scene=9_7
#: 9_7:4023
msgctxt "text_id=14290 | speaker=unknown"
msgid "　それを間違えては、なにより、魔術に己を捧げた姉を侮辱する事になる。"
msgstr ""

#. Occurrence 9_7:4056:14291: scene=9_7
#: 9_7:4056
msgctxt "text_id=14291 | speaker=unknown"
msgid "　そう口にしようとして、青子は止めた。"
msgstr ""

#. Occurrence 9_7:4061:14292: scene=9_7
#: 9_7:4061
msgctxt "text_id=14292 | speaker=unknown"
msgid "　魔術師でもない草十郎に言っても意味がないし、彼にその事実を突きつけるのは面白くない。"
msgstr ""

#. Occurrence 9_7:4066:14293: scene=9_7
#: 9_7:4066
msgctxt "text_id=14293 | speaker=unknown"
msgid "　言語化できないが、それはしたくないと思ってしまった。"
msgstr ""

#. Occurrence 9_7:4071:14294: scene=9_7
#: 9_7:4071
msgctxt "text_id=14294 | speaker=unknown"
msgid "　なので―――"
msgstr ""

#. Occurrence 9_7:4105:14295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0097; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4105
msgctxt "text_id=14295 | speaker=aoko"
msgid "「ふーん。やけに姉貴の肩を持つじゃない、草十郎。"
msgstr ""

#. Occurrence 9_7:4111:14296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0098; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4111
msgctxt "text_id=14296 | speaker=aoko"
msgid "　もしかして、一目惚れでもした？」"
msgstr ""

#. Occurrence 9_7:4136:14297: scene=9_7
#: 9_7:4136
msgctxt "text_id=14297 | speaker=unknown"
msgid "　自分でも卑怯と思う方法で、青子は逃げた。"
msgstr ""

#. Occurrence 9_7:4141:14298: scene=9_7
#: 9_7:4141
msgctxt "text_id=14298 | speaker=unknown"
msgid "　にやっと笑う青子。"
msgstr ""

#. Occurrence 9_7:4182:14299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0030; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4182
msgctxt "text_id=14299 | speaker=soujuurou"
msgid "「肩ぐらい持つ。あの人は、可哀相な人だからな」"
msgstr ""

#. Occurrence 9_7:4236:14300: scene=9_7
#: 9_7:4236
msgctxt "text_id=14300 | speaker=unknown"
msgid "　しかし、草十郎はまったく動じていなかった。"
msgstr ""

#. Occurrence 9_7:4241:14301: scene=9_7
#: 9_7:4241
msgctxt "text_id=14301 | speaker=unknown"
msgid "　そこまで言われては青子もカチンとくる。"
msgstr ""

#. Occurrence 9_7:4253:14302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0099; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4253
msgctxt "text_id=14302 | speaker=aoko"
msgid "「なぜ？」"
msgstr ""

#. Occurrence 9_7:4258:14303: scene=9_7
#: 9_7:4258
msgctxt "text_id=14303 | speaker=unknown"
msgid "　作り笑いを消して、真剣な眼差しで青子は問いかけた。"
msgstr ""

#. Occurrence 9_7:4278:14304: scene=9_7
#: 9_7:4278
msgctxt "text_id=14304 | speaker=unknown"
msgid "　草十郎に<躊躇|ためら>いはない。"
msgstr ""

#. Occurrence 9_7:4283:14305: scene=9_7
#: 9_7:4283
msgctxt "text_id=14305 | speaker=unknown"
msgid "　彼は当然のように、"
msgstr ""

#. Occurrence 9_7:4310:14306: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0031; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4310
msgctxt "text_id=14306 | speaker=soujuurou"
msgid "「だって実の妹と争わなくちゃいけないんだろ。"
msgstr ""

#. Occurrence 9_7:4336:14307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0032; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4336
msgctxt "text_id=14307 | speaker=soujuurou"
msgid "　それは可哀相な事じゃないのか？」"
msgstr ""

#. Occurrence 9_7:4359:14308: scene=9_7
#: 9_7:4359
msgctxt "text_id=14308 | speaker=unknown"
msgid "　何に対して怒っているのかを明言した。"
msgstr ""

#. Occurrence 9_7:4387:14309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0100; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4387
msgctxt "text_id=14309 | speaker=aoko"
msgid "「…………たしかに、ね」"
msgstr ""

#. Occurrence 9_7:4393:14310: scene=9_7
#: 9_7:4393
msgctxt "text_id=14310 | speaker=unknown"
msgid "　知らず、青子は目を細めた。"
msgstr ""

#. Occurrence 9_7:4398:14311: scene=9_7
#: 9_7:4398
msgctxt "text_id=14311 | speaker=unknown"
msgid "　胸を衝かれた事実を隠すように。"
msgstr ""

#. Occurrence 9_7:4403:14312: scene=9_7
#: 9_7:4403
msgctxt "text_id=14312 | speaker=unknown"
msgid "　コイツは毒だな、と思いながら。"
msgstr ""

#. Occurrence 9_7:4408:14313: scene=9_7
#: 9_7:4408
msgctxt "text_id=14313 | speaker=unknown"
msgid "　薬にもなりはしない。この男の言葉は、知らず知らずのうちに自分の弱い部分を浮き彫りにする、と。"
msgstr ""

#. Occurrence 9_7:4441:14314: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0101; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4441
msgctxt "text_id=14314 | speaker=aoko"
msgid "「だけど私も姉貴も、それをなんとも思ってないのよ。"
msgstr ""

#. Occurrence 9_7:4447:14315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0102; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4447
msgctxt "text_id=14315 | speaker=aoko"
msgid "　だって、それ以外に解決策はないんだから」"
msgstr ""

#. Occurrence 9_7:4453:14316: scene=9_7
#: 9_7:4453
msgctxt "text_id=14316 | speaker=unknown"
msgid "　青子の答えに、草十郎はそうか、と表情を曇らせる。"
msgstr ""

#. Occurrence 9_7:4458:14317: scene=9_7
#: 9_7:4458
msgctxt "text_id=14317 | speaker=unknown"
msgid "「それも、悲しい話だね」と呟いて。"
msgstr ""

#. Occurrence 9_8:81:14318: scene=9_8
#: 9_8:81
msgctxt "text_id=14318 | speaker=unknown"
msgid "　夜の<帳|とばり>はとっくに落ちている。"
msgstr ""

#. Occurrence 9_8:101:14319: scene=9_8
#: 9_8:101
msgctxt "text_id=14319 | speaker=unknown"
msgid "　橙子が去ってからまだ一時間も経っていないのに、草十郎には彼女の顔がひどく遠いものに感じられた。"
msgstr ""

#. Occurrence 9_8:106:14320: scene=9_8
#: 9_8:106
msgctxt "text_id=14320 | speaker=unknown"
msgid "　青子と有珠にしてみれば、現在の蒼崎橙子の姿は幻よりさらに遠いに違いない。"
msgstr ""

#. Occurrence 9_8:138:14321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0000; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:138
msgctxt "text_id=14321 | speaker=aoko"
msgid "「とにかく！　姉貴が敵だって事は草十郎にも分かったでしょう？　ならつべこべ言わず、君子危うきに近寄らずよ！"
msgstr ""

#. Occurrence 9_8:144:14322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0001; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:144
msgctxt "text_id=14322 | speaker=aoko"
msgid "　……ま、姉貴もアンタと会って、私たちとはまったくの無関係だって分かっただろうから、そっちには手を出してこないでしょうけど」"
msgstr ""

#. Occurrence 9_8:177:14323: scene=9_8
#: 9_8:177
msgctxt "text_id=14323 | speaker=unknown"
msgid "　だから安全、気にするな、と青子は胸を張る。"
msgstr ""

#. Occurrence 9_8:182:14324: scene=9_8
#: 9_8:182
msgctxt "text_id=14324 | speaker=unknown"
msgid "　おかしな話だが、たとえ敵であっても橙子の合理性を青子は信頼しきっていた。"
msgstr ""

#. Occurrence 9_8:224:14325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0000_0; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:224
msgctxt "text_id=14325 | speaker=soujuurou"
msgid "「……そうかな。……そうなのかな。"
msgstr ""

#. Occurrence 9_8:251:14326: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0000_1; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:251
msgctxt "text_id=14326 | speaker=soujuurou"
msgid "……そうだといいんだけどな」"
msgstr ""

#. Occurrence 9_8:257:14327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0002; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:257
msgctxt "text_id=14327 | speaker=aoko"
msgid "「そうだから安心なさい。昔から要らない物には手を出さないんだから、あの人は」"
msgstr ""

#. Occurrence 9_8:283:14328: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0001; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:283
msgctxt "text_id=14328 | speaker=soujuurou"
msgid "「そっか。蒼崎がそこまで言うなら安心する。"
msgstr ""

#. Occurrence 9_8:294:14329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0002; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:294
msgctxt "text_id=14329 | speaker=soujuurou"
msgid "　あ、要らない物っていえば、橙子さんが蒼崎のティーカップを貰うって。セーブルのやつ」"
msgstr ""

#. Occurrence 9_8:326:14330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0003; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:326
msgctxt "text_id=14330 | speaker=aoko"
msgid "「え……ちょ、ちょっと待って！"
msgstr ""

#. Occurrence 9_8:332:14331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0004; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:332
msgctxt "text_id=14331 | speaker=aoko"
msgid "　アンタ、それを黙って見てたっていうの!?」"
msgstr ""

#. Occurrence 9_8:338:14332: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0003; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:338
msgctxt "text_id=14332 | speaker=soujuurou"
msgid "「そうだけど。……む。やっぱりあれは奪っていったのか」"
msgstr ""

#. Occurrence 9_8:379:14333: scene=9_8
#: 9_8:379
msgctxt "text_id=14333 | speaker=unknown"
msgid "　怒る青子に、草十郎はなるほど、と納得する。"
msgstr ""

#. Occurrence 9_8:384:14334: scene=9_8
#: 9_8:384
msgctxt "text_id=14334 | speaker=unknown"
msgid "　さっきまでの深刻な顔つきと口調はどこへいったのか。"
msgstr ""

#. Occurrence 9_8:389:14335: scene=9_8
#: 9_8:389
msgctxt "text_id=14335 | speaker=unknown"
msgid "　今ここにいやがるのは、いつものぼんやりとした草十郎だった。"
msgstr ""

#. Occurrence 9_8:439:14336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0005; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:439
msgctxt "text_id=14336 | speaker=aoko"
msgid "「しかもセーブルのカップって、私の一番のお気に入り……」"
msgstr ""

#. Occurrence 9_8:445:14337: scene=9_8
#: 9_8:445
msgctxt "text_id=14337 | speaker=unknown"
msgid "　ぬぬぬ、と拳を震わす青子だが、草十郎の<暢気顔|のんきがお>を殴りつけるワケにもいかない。"
msgstr ""

#. Occurrence 9_8:450:14338: scene=9_8
#: 9_8:450
msgctxt "text_id=14338 | speaker=unknown"
msgid "　もし草十郎が橙子を止めていたら大惨事だったろうし、なにより草十郎に、あの姉を止められた筈もないのである。"
msgstr ""

#. Occurrence 9_8:496:14339: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0006; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:496
msgctxt "text_id=14339 | speaker=aoko"
msgid "「……仕方ないか。そういえばあの人、よく私の持ち物を奪っていったっけ。"
msgstr ""

#. Occurrence 9_8:503:14340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0007; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:503
msgctxt "text_id=14340 | speaker=aoko"
msgid "他人の物を欲しがるクセ、まだ治ってないんだ」"
msgstr ""

#. Occurrence 9_8:509:14341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0004; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:509
msgctxt "text_id=14341 | speaker=soujuurou"
msgid "「？　子供の頃は、みんなそうなんじゃないのか？」"
msgstr ""

#. Occurrence 9_8:530:14342: scene=9_8
#: 9_8:530
msgctxt "text_id=14342 | speaker=unknown"
msgid "　つい聞き返してしまう草十郎。"
msgstr ""

#. Occurrence 9_8:569:14343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0008; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:569
msgctxt "text_id=14343 | speaker=aoko"
msgid "「そうかな。私のクレヨンとか人形とかとっても仕方ないと思うけど。どうせ粉々にしちゃうんだし」"
msgstr ""

#. Occurrence 9_8:575:14344: scene=9_8
#: 9_8:575
msgctxt "text_id=14344 | speaker=unknown"
msgid "　その言葉に草十郎は息を呑んだ。"
msgstr ""

#. Occurrence 9_8:580:14345: scene=9_8
#: 9_8:580
msgctxt "text_id=14345 | speaker=unknown"
msgid "　なにかいま、不吉な意味が含まれていた気がする。"
msgstr ""

#. Occurrence 9_8:601:14346: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0005; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:601
msgctxt "text_id=14346 | speaker=soujuurou"
msgid "「………それは、どういう？」"
msgstr ""

#. Occurrence 9_8:622:14347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0009; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:622
msgctxt "text_id=14347 | speaker=aoko"
msgid "「だから、あの人って私の持ち物を横取りしてはぶっ壊すのが趣味なのよ。苦節十四年、姉貴に目をつけられて無事だった物なんてひとつも無いもの」"
msgstr ""

#. Occurrence 9_8:644:14348: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0006; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:644
msgctxt "text_id=14348 | speaker=soujuurou"
msgid "「…………………………」"
msgstr ""

#. Occurrence 9_8:664:14349: scene=9_8
#: 9_8:664
msgctxt "text_id=14349 | speaker=unknown"
msgid "　青子の独白を聞いて、草十郎は橙子との会話を思い出す。"
msgstr ""

#. Occurrence 9_8:669:14350: scene=9_8
#: 9_8:669
msgctxt "text_id=14350 | speaker=unknown"
msgid "　……気のせいだといいのだけど、彼女はしきりに静希草十郎を、誰かさんの持ち物だと決め付けていたような……。"
msgstr ""

#. Occurrence 9_8:695:14351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0007; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:695
msgctxt "text_id=14351 | speaker=soujuurou"
msgid "「……それは……ちょっと、難儀だな」"
msgstr ""

#. Occurrence 9_8:701:14352: scene=9_8
#: 9_8:701
msgctxt "text_id=14352 | speaker=unknown"
msgid "　手強い難問に出会った刑事よろしく、顔をしかめて呟く草十郎。"
msgstr ""

#. Occurrence 9_8:706:14353: scene=9_8
#: 9_8:706
msgctxt "text_id=14353 | speaker=unknown"
msgid "　解決策がまったく見つからないあたりまで、ホントよく似ている。"
msgstr ""

#. Occurrence 9_8:738:14354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0010; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:738
msgctxt "text_id=14354 | speaker=aoko"
msgid "「でしょ？　ひどい姉貴なのよ、あの人って」"
msgstr ""

#. Occurrence 9_8:744:14355: scene=9_8
#: 9_8:744
msgctxt "text_id=14355 | speaker=unknown"
msgid "　草十郎の気持ちも知らず、青子は気楽に答えて紅茶を飲んだ。"
msgstr ""

#. Occurrence 9_8:749:14356: scene=9_8
#: 9_8:749
msgctxt "text_id=14356 | speaker=unknown"
msgid "　肩をすくめる青子を半眼で見つめながら、草十郎は居間の時計に目をやった。気分がどんなに<陰欝|いんうつ>でも、時間だけはきっちりと回っている。"
msgstr ""

#. Occurrence 9_8:781:14357: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0008; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:781
msgctxt "text_id=14357 | speaker=soujuurou"
msgid "「……明日から、大変になるね」"
msgstr ""

#. Occurrence 9_8:787:14358: scene=9_8
#: 9_8:787
msgctxt "text_id=14358 | speaker=unknown"
msgid "　ぽつりと呟く本日最大の被害者。"
msgstr ""

#. Occurrence 9_8:792:14359: scene=9_8
#: 9_8:792
msgctxt "text_id=14359 | speaker=unknown"
msgid "　そこに、青子はからっとした趣で付け足した。"
msgstr ""

#. Occurrence 9_8:834:14360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0011; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:834
msgctxt "text_id=14360 | speaker=aoko"
msgid "「そうね。でも今は、そんな事より今日の夕飯のが楽しみなんだ、私」"
msgstr ""

#. Occurrence 9_8:874:14361: scene=9_8
#: 9_8:874
msgctxt "text_id=14361 | speaker=unknown"
msgid "　青子の意見に、有珠も賛同するように黙りこんでいる。"
msgstr ""

#. Occurrence 9_8:879:14362: scene=9_8
#: 9_8:879
msgctxt "text_id=14362 | speaker=unknown"
msgid "　ゆったりくつろぐふたりは、夕飯が用意されるまでソファーから動く意志が、見事なまでに皆無だった。"
msgstr ""

#. Occurrence 9_8:914:14363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0009; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:914
msgctxt "text_id=14363 | speaker=soujuurou"
msgid "「……………………」"
msgstr ""

#. Occurrence 9_8:920:14364: scene=9_8
#: 9_8:920
msgctxt "text_id=14364 | speaker=unknown"
msgid "　たしかに夜のアルバイトはない。"
msgstr ""

#. Occurrence 9_8:925:14365: scene=9_8
#: 9_8:925
msgctxt "text_id=14365 | speaker=unknown"
msgid "　けれど深夜となると話は別だ。"
msgstr ""

#. Occurrence 9_8:930:14366: scene=9_8
#: 9_8:930
msgctxt "text_id=14366 | speaker=unknown"
msgid "　これから本当にアルバイトが待っている草十郎にとって、ふたりの期待は苛酷な命令以外の何物でもない。"
msgstr ""

#. Occurrence 9_8:950:14367: scene=9_8
#: 9_8:950
msgctxt "text_id=14367 | speaker=unknown"
msgid "　そもそも、今から調理したら食べるのは一時間後になってしまう。"
msgstr ""

#. Occurrence 9_8:955:14368: scene=9_8
#: 9_8:955
msgctxt "text_id=14368 | speaker=unknown"
msgid "　そんなコトを何やら疲れきったふたりが容認するはずもなく、となると結局、残された手段は出前のみ。"
msgstr ""

#. Occurrence 9_8:988:14369: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0010; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:988
msgctxt "text_id=14369 | speaker=soujuurou"
msgid "“……なんと。橙子さんに付いていけば良かったかもしれないな、俺”"
msgstr ""

#. Occurrence 9_8:995:14370: scene=9_8
#: 9_8:995
msgctxt "text_id=14370 | speaker=unknown"
msgid "　グチをこぼしつつ、草十郎はお財布の中身を確かめた。"
msgstr ""

#. Occurrence 9_8:1000:14371: scene=9_8
#: 9_8:1000
msgctxt "text_id=14371 | speaker=unknown"
msgid "　慎ましげに残っている三枚目の諭吉は、別れを惜しむようにしかめっ面をしている。"
msgstr ""

#. Occurrence 9_8:1005:14372: scene=9_8
#: 9_8:1005
msgctxt "text_id=14372 | speaker=unknown"
msgid "　それが、草十郎にはちょこっとだけ痛かった。"
msgstr ""

#. Occurrence A_0:44:14373: scene=A_0
#: A_0:44
msgctxt "text_id=14373 | speaker=unknown"
msgid "　とりあえずは、そんな日常の話から。"
msgstr ""

#. Occurrence A_0:129:14374: scene=A_0
#: A_0:129
msgctxt "text_id=14374 | speaker=unknown"
msgid "　星の運びは、今日一日を労働に<捧|ささ>げるべしと告げていた。"
msgstr ""

#. Occurrence A_0:134:14375: scene=A_0
#: A_0:134
msgctxt "text_id=14375 | speaker=unknown"
msgid "　具体的に言うと庭の清掃。"
msgstr ""

#. Occurrence A_0:139:14376: scene=A_0
#: A_0:139
msgctxt "text_id=14376 | speaker=unknown"
msgid "　草十郎にとって、これ以上アレを放置しておくのは精神衛生上よろしくない。"
msgstr ""

#. Occurrence A_0:144:14377: scene=A_0
#: A_0:144
msgctxt "text_id=14377 | speaker=unknown"
msgid "　幸い、アルバイトの<当番|シフト>は丸一日オフ。"
msgstr ""

#. Occurrence A_0:149:14378: scene=A_0
#: A_0:149
msgctxt "text_id=14378 | speaker=unknown"
msgid "　彼にとって今日はまたとない好機だった。"
msgstr ""

#. Occurrence A_0:194:14379: scene=A_0
#: A_0:194
msgctxt "text_id=14379 | speaker=unknown"
msgid "　―――しかし。洋館の<園|にわ>は本気で広い。"
msgstr ""

#. Occurrence A_0:200:14380: scene=A_0
#: A_0:200
msgctxt "text_id=14380 | speaker=unknown"
msgid "　荒れ放題なのは中庭だけでなく、館の正面玄関まわりですら手入れが行き届いていなかった。"
msgstr ""

#. Occurrence A_0:205:14381: scene=A_0
#: A_0:205
msgctxt "text_id=14381 | speaker=unknown"
msgid "　本気で掃除をするのなら、一週間単位で計画を組まなくてはいけない広さである。"
msgstr ""

#. Occurrence A_0:227:14382: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0000; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:227
msgctxt "text_id=14382 | speaker=soujuurou"
msgid "「よし。まずは地ならしだな」"
msgstr ""

#. Occurrence A_0:233:14383: scene=A_0
#: A_0:233
msgctxt "text_id=14383 | speaker=unknown"
msgid "　理想は一日で成し遂げられるものではない。"
msgstr ""

#. Occurrence A_0:238:14384: scene=A_0
#: A_0:238
msgctxt "text_id=14384 | speaker=unknown"
msgid "　今日は雑草の除去だけに専念しよう、と草十郎は決意を新たに荒れ野に踏み出した。"
msgstr ""

#. Occurrence A_0:274:14385: scene=A_0
#: A_0:274
msgctxt "text_id=14385 | speaker=unknown"
msgid "　朝も早くから館の周りの雑草を引き抜いていく。"
msgstr ""

#. Occurrence A_0:280:14386: scene=A_0
#: A_0:280
msgctxt "text_id=14386 | speaker=unknown"
msgid "　計算によれば、午後までには玄関付近、中庭、裏庭をぐるりと一回りし、一休みできる予定になっていた。"
msgstr ""

#. Occurrence A_0:496:14387: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0000; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:496
msgctxt "text_id=14387 | speaker=alice"
msgid "「どうしたの、彼」"
msgstr ""

#. Occurrence A_0:536:14388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0000; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:536
msgctxt "text_id=14388 | speaker=aoko"
msgid "「さあ。草摘みが趣味ってワケじゃなさそうだけど」"
msgstr ""

#. Occurrence A_0:542:14389: scene=A_0
#: A_0:542
msgctxt "text_id=14389 | speaker=unknown"
msgid "　正午前のサンルーム。"
msgstr ""

#. Occurrence A_0:554:14390: scene=A_0
#: A_0:554
msgctxt "text_id=14390 | speaker=unknown"
msgid "　有珠が本を片手にやってきた時、先客である青子は優雅に紅茶を飲みつつ、ファッション誌を読んでいた。"
msgstr ""

#. Occurrence A_0:598:14391: scene=A_0
#: A_0:598
msgctxt "text_id=14391 | speaker=unknown"
msgid "　窓ガラスの向こうには、しゃがみこんだまま後退していく人影がひとつ。"
msgstr ""

#. Occurrence A_0:627:14392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0001; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:627
msgctxt "text_id=14392 | speaker=aoko"
msgid "「朝からやってるみたいよ。"
msgstr ""

#. Occurrence A_0:633:14393: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0002; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:633
msgctxt "text_id=14393 | speaker=aoko"
msgid "　起きてカーテンを開けたら、もうあの格好でスパスパやってたから。ついでに焼却炉の掃除も言いつけといたけど、いいでしょ？」"
msgstr ""

#. Occurrence A_0:647:14394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0001; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:647
msgctxt "text_id=14394 | speaker=alice"
msgid "「いいけど。……頑張るのね、彼。外はあんなにも寒いのに」"
msgstr ""

#. Occurrence A_0:701:14395: scene=A_0
#: A_0:701
msgctxt "text_id=14395 | speaker=unknown"
msgid "　有珠は静かに腰を下ろした。"
msgstr ""

#. Occurrence A_0:707:14396: scene=A_0
#: A_0:707
msgctxt "text_id=14396 | speaker=unknown"
msgid "　テーブルには彼女の分のティーカップも用意されていた。"
msgstr ""

#. Occurrence A_0:712:14397: scene=A_0
#: A_0:712
msgctxt "text_id=14397 | speaker=unknown"
msgid "　有珠はポットからカップに紅茶を注いで、持ちこんだ本を開く。"
msgstr ""

#. Occurrence A_0:758:14398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0003; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:758
msgctxt "text_id=14398 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence A_0:773:14399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0002; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:773
msgctxt "text_id=14399 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence A_0:781:14400: scene=A_0
#: A_0:781
msgctxt "text_id=14400 | speaker=unknown"
msgid "　二人は無言で時間を過ごす。"
msgstr ""

#. Occurrence A_0:786:14401: scene=A_0
#: A_0:786
msgctxt "text_id=14401 | speaker=unknown"
msgid "　青子も有珠も気まぐれに、部屋で休むのだったらサンルームでお茶にしよう、とやって来ただけだった。"
msgstr ""

#. Occurrence A_0:791:14402: scene=A_0
#: A_0:791
msgctxt "text_id=14402 | speaker=unknown"
msgid "　談話のネタもなく、夜にそなえての役割分担も既に済んでいる。"
msgstr ""

#. Occurrence A_0:820:14403: scene=A_0
#: A_0:820
msgctxt "text_id=14403 | speaker=unknown"
msgid "　青子は雑誌をパラ読みしながら、基本的には窓の外の風景を眺め、"
msgstr ""

#. Occurrence A_0:825:14404: scene=A_0
#: A_0:825
msgctxt "text_id=14404 | speaker=unknown"
msgid "　有珠はルーン魔術に関する書物に没頭しながら、時折、思い出したように顔をあげる。"
msgstr ""

#. Occurrence A_0:897:14405: scene=A_0
#: A_0:897
msgctxt "text_id=14405 | speaker=unknown"
msgid "　ティーカップに口をつけ、二人は申し合わせたように窓の外に視線を送った。"
msgstr ""

#. Occurrence A_0:902:14406: scene=A_0
#: A_0:902
msgctxt "text_id=14406 | speaker=unknown"
msgid "　手伝う気など爪の先ほどもないのか、少女たちは他人事のように庭職人（駆け出し）の動きを観察する。"
msgstr ""

#. Occurrence A_0:907:14407: scene=A_0
#: A_0:907
msgctxt "text_id=14407 | speaker=unknown"
msgid "　草十郎の動きは緩慢ではあるけれど、なぜか作業は<迅速|じんそく>にこなされていった。"
msgstr ""

#. Occurrence A_0:952:14408: scene=A_0
#: A_0:952
msgctxt "text_id=14408 | speaker=unknown"
msgid "　……ふと青子が視線を逸らすと、対面の相方と目が合った。"
msgstr ""

#. Occurrence A_0:1024:14409: scene=A_0
#: A_0:1024
msgctxt "text_id=14409 | speaker=unknown"
msgid "　有珠は取り<繕|つくろ>うように書物に視線を戻し、"
msgstr ""

#. Occurrence A_0:1024:14410: scene=A_0
#: A_0:1024
msgctxt "text_id=14410 | speaker=unknown"
msgid "　しばらくした後、もう一度顔をあげて、"
msgstr ""

#. Occurrence A_0:1279:14411: scene=A_0
#: A_0:1279
msgctxt "text_id=14411 | speaker=unknown"
msgid "「―――、"
msgstr ""

#. Occurrence A_0:1287:14412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0003; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1287
msgctxt "text_id=14412 | speaker=alice"
msgid "ぽこ」"
msgstr ""

#. Occurrence A_0:1357:14413: scene=A_0
#: A_0:1357
msgctxt "text_id=14413 | speaker=unknown"
msgid "　コホンと咳払いをして、読書に集中しようと目を伏せる。"
msgstr ""

#. Occurrence A_0:1377:14414: scene=A_0
#: A_0:1377
msgctxt "text_id=14414 | speaker=unknown"
msgid "　……有珠が驚くのも無理はない。"
msgstr ""

#. Occurrence A_0:1390:14415: scene=A_0
#: A_0:1390
msgctxt "text_id=14415 | speaker=unknown"
msgid "　草十郎は三十分も経たないうちに中庭を横断して、あれほど見苦しかった雑草を綺麗に片付けてしまったのだ。"
msgstr ""

#. Occurrence A_0:1395:14416: scene=A_0
#: A_0:1395
msgctxt "text_id=14416 | speaker=unknown"
msgid "　謎の庭師は休憩も入れず、白い息を吐きながら、中庭から退場していった。"
msgstr ""

#. Occurrence A_0:1400:14417: scene=A_0
#: A_0:1400
msgctxt "text_id=14417 | speaker=unknown"
msgid "　立つ鳥跡を<濁|にご>さず、どころの話ではない。"
msgstr ""

#. Occurrence A_0:1421:14418: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0004; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1421
msgctxt "text_id=14418 | speaker=aoko"
msgid "「……プロかしらね、あいつ」"
msgstr ""

#. Occurrence A_0:1448:14419: scene=A_0
#: A_0:1448
msgctxt "text_id=14419 | speaker=unknown"
msgid "　青子はその一部始終を見届けて、ぽつりと呟く。"
msgstr ""

#. Occurrence A_0:1453:14420: scene=A_0
#: A_0:1453
msgctxt "text_id=14420 | speaker=unknown"
msgid "　あまりにも迷いのない、鉄人の作業だった。"
msgstr ""

#. Occurrence A_0:1458:14421: scene=A_0
#: A_0:1458
msgctxt "text_id=14421 | speaker=unknown"
msgid "　良くできた映画を見た気分にすらなって、青子は感心……を通り越して、草十郎の無駄な芸達者ぶりに呆れている。"
msgstr ""

#. Occurrence A_0:1463:14422: scene=A_0
#: A_0:1463
msgctxt "text_id=14422 | speaker=unknown"
msgid "　一方、有珠は顔をあげて時計を確認していた。"
msgstr ""

#. Occurrence A_0:1504:14423: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0004; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1504
msgctxt "text_id=14423 | speaker=alice"
msgid "「……焼却炉、今から手入れをしたら夕方ね」"
msgstr ""

#. Occurrence A_0:1524:14424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0005; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1524
msgctxt "text_id=14424 | speaker=aoko"
msgid "「そっちはもう終わってるわ。朝、上から見てたもの。"
msgstr ""

#. Occurrence A_0:1524:14425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0005; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1524
msgctxt "text_id=14425 | speaker=aoko"
msgid "　壊されちゃいけないからあれこれ指示だしてね。"
msgstr ""

#. Occurrence A_0:1535:14426: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0006; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1535
msgctxt "text_id=14426 | speaker=aoko"
msgid "　いやあ、窓開けてさんざん怒鳴ったから部屋が冷えるコト冷えるコト」"
msgstr ""

#. Occurrence A_0:1577:14427: scene=A_0
#: A_0:1577
msgctxt "text_id=14427 | speaker=unknown"
msgid "　青子が居間にやって来た理由は、自分の部屋が冷えきってしまったから、と推測される。"
msgstr ""

#. Occurrence A_0:1582:14428: scene=A_0
#: A_0:1582
msgctxt "text_id=14428 | speaker=unknown"
msgid "　……部屋から指図をするのと外で掃除をするのとでは、どちらが<極寒|ハード>か言うまでもない。"
msgstr ""

#. Occurrence A_0:1609:14429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0005; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1609
msgctxt "text_id=14429 | speaker=alice"
msgid "「静希君、何か言ってこなかった？」"
msgstr ""

#. Occurrence A_0:1631:14430: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0007; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1631
msgctxt "text_id=14430 | speaker=aoko"
msgid "「言ってたけど、よく聞こえなかったわ」"
msgstr ""

#. Occurrence A_0:1658:14431: scene=A_0
#: A_0:1658
msgctxt "text_id=14431 | speaker=unknown"
msgid "　つまり、草十郎の文句は一切<効|き>かなかったという事か。"
msgstr ""

#. Occurrence A_0:1703:14432: scene=A_0
#: A_0:1703
msgctxt "text_id=14432 | speaker=unknown"
msgid "　共通の話題もなくなって、二人は読書を再開する。"
msgstr ""

#. Occurrence A_0:1749:14433: scene=A_0
#: A_0:1749
msgctxt "text_id=14433 | speaker=unknown"
msgid "　そんな、少しだけ張りつめた沈黙を破るように、掃除を終えた草十郎がやってきた。"
msgstr ""

#. Occurrence A_0:1800:14434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0001; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1800
msgctxt "text_id=14434 | speaker=soujuurou"
msgid "「……………………」"
msgstr ""

#. Occurrence A_0:1805:14435: scene=A_0
#: A_0:1805
msgctxt "text_id=14435 | speaker=unknown"
msgid "　気に食わない事があったのか、草十郎は険しい目で青子たちを一瞥する。"
msgstr ""

#. Occurrence A_0:1851:14436: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0002; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1851
msgctxt "text_id=14436 | speaker=soujuurou"
msgid "「あったかそうだね、蒼崎」"
msgstr ""

#. Occurrence A_0:1874:14437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0008; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1874
msgctxt "text_id=14437 | speaker=aoko"
msgid "「外よりは幾分ね。廊下の気温は外とあまり変わらないけど。"
msgstr ""

#. Occurrence A_0:1880:14438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0009; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1880
msgctxt "text_id=14438 | speaker=aoko"
msgid "　それで、どうして庭の掃除なんてはじめたのよ、草十郎」"
msgstr ""

#. Occurrence A_0:1912:14439: scene=A_0
#: A_0:1912
msgctxt "text_id=14439 | speaker=unknown"
msgid "　草十郎の嫌味なんてこれっぽっちも効いていない。"
msgstr ""

#. Occurrence A_0:1917:14440: scene=A_0
#: A_0:1917
msgctxt "text_id=14440 | speaker=unknown"
msgid "　<青子|てき>の丈夫さに、草十郎は今更ながらガッカリと肩を落とした。"
msgstr ""

#. Occurrence A_0:1955:14441: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0003; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1955
msgctxt "text_id=14441 | speaker=soujuurou"
msgid "「今日は本当に寒い。明日あたり雪でも降ってくるだろうから、外の掃除は早くに済ませたかったのに。"
msgstr ""

#. Occurrence A_0:1961:14442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0004; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1961
msgctxt "text_id=14442 | speaker=soujuurou"
msgid "　……焼却炉は予定外だったぞ」"
msgstr ""

#. Occurrence A_0:1990:14443: scene=A_0
#: A_0:1990
msgctxt "text_id=14443 | speaker=unknown"
msgid "　恨みがましく言うが、草十郎にとって焼却炉の掃除などお菓子のおまけみたいな物だった。"
msgstr ""

#. Occurrence A_0:1995:14444: scene=A_0
#: A_0:1995
msgctxt "text_id=14444 | speaker=unknown"
msgid "　彼が不満に思っているのは、誰も手伝いにこなかった、お寒い事実だけである。"
msgstr ""

#. Occurrence A_0:2016:14445: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0010; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2016
msgctxt "text_id=14445 | speaker=aoko"
msgid "「いいじゃない、焼却炉はみんな使うんだから。"
msgstr ""

#. Occurrence A_0:2039:14446: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0011; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2039
msgctxt "text_id=14446 | speaker=aoko"
msgid "　じゃ、その殊勝な心がけついでに、二階の廊下に掃除機かけといてね。"
msgstr ""

#. Occurrence A_0:2045:14447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0012; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2045
msgctxt "text_id=14447 | speaker=aoko"
msgid "　それと裏庭のブナの添え木、壊れかけてたでしょ。工具箱はアンタの<屋根裏|へや>に置きっぱなしだから、それを使うこと」"
msgstr ""

#. Occurrence A_0:2071:14448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0013; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2071
msgctxt "text_id=14448 | speaker=aoko"
msgid "「で、ぜんぶ終わったら私の部屋に来てくれる？"
msgstr ""

#. Occurrence A_0:2071:14449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0013; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2071
msgctxt "text_id=14449 | speaker=aoko"
msgid "　いらない物まとめておくから、焼却炉で焼いておいて」"
msgstr ""

#. Occurrence A_0:2103:14450: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0005; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2103
msgctxt "text_id=14450 | speaker=soujuurou"
msgid "「……………………」"
msgstr ""

#. Occurrence A_0:2109:14451: scene=A_0
#: A_0:2109
msgctxt "text_id=14451 | speaker=unknown"
msgid "　そのために焼却炉の手入れをさせたらしい。"
msgstr ""

#. Occurrence A_0:2114:14452: scene=A_0
#: A_0:2114
msgctxt "text_id=14452 | speaker=unknown"
msgid "　憎らしいぐらいの段取りの良さである。"
msgstr ""

#. Occurrence A_0:2151:14453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0006; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2151
msgctxt "text_id=14453 | speaker=soujuurou"
msgid "「それで蒼崎、君は何をするんだ？」"
msgstr ""

#. Occurrence A_0:2157:14454: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0014; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2157
msgctxt "text_id=14454 | speaker=aoko"
msgid "「そうね、やる事もないしギターにでも触ってようかしら」"
msgstr ""

#. Occurrence A_0:2181:14455: scene=A_0
#: A_0:2181
msgctxt "text_id=14455 | speaker=unknown"
msgid "　うーん、と有意義な午後の過ごし方を模索する青子。"
msgstr ""

#. Occurrence A_0:2186:14456: scene=A_0
#: A_0:2186
msgctxt "text_id=14456 | speaker=unknown"
msgid "　嫌味に対して嫌味で返しているワケではない。"
msgstr ""

#. Occurrence A_0:2191:14457: scene=A_0
#: A_0:2191
msgctxt "text_id=14457 | speaker=unknown"
msgid "　きっと、彼女の予定には『掃除』という単語が存在しないのだ。"
msgstr ""

#. Occurrence A_0:2227:14458: scene=A_0
#: A_0:2227
msgctxt "text_id=14458 | speaker=unknown"
msgid "　この洋館はなぜ荒れ果てているのか。"
msgstr ""

#. Occurrence A_0:2232:14459: scene=A_0
#: A_0:2232
msgctxt "text_id=14459 | speaker=unknown"
msgid "　その理由を、はっきりと草十郎は思い知った。"
msgstr ""

#. Occurrence A_0:2261:14460: scene=A_0
#: A_0:2261
msgctxt "text_id=14460 | speaker=unknown"
msgid "　……それにしても二階の廊下は長い。"
msgstr ""

#. Occurrence A_0:2266:14461: scene=A_0
#: A_0:2266
msgctxt "text_id=14461 | speaker=unknown"
msgid "　おまけに青子の言う通り、廊下の気温は外とそう変わりはない極寒だ。"
msgstr ""

#. Occurrence A_0:2297:14462: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0007; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2297
msgctxt "text_id=14462 | speaker=soujuurou"
msgid "「……そうか、あくまで掃除をする気はないんだな蒼崎。"
msgstr ""

#. Occurrence A_0:2303:14463: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0008; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2303
msgctxt "text_id=14463 | speaker=soujuurou"
msgid "　まあ、掃除はしたいからするけど、こう、なんだろう。"
msgstr ""

#. Occurrence A_0:2331:14464: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0009; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2331
msgctxt "text_id=14464 | speaker=soujuurou"
msgid "　一緒に住んでる人間をそこまでこき使って良心は痛まないか？　それとも、わりと気付いてはいたけど、良心そのものがないのか？」"
msgstr ""

#. Occurrence A_0:2390:14465: scene=A_0
#: A_0:2390
msgctxt "text_id=14465 | speaker=unknown"
msgid "　相変わらず、一言多い男である。"
msgstr ""

#. Occurrence A_0:2409:14466: scene=A_0
#: A_0:2409
msgctxt "text_id=14466 | speaker=unknown"
msgid "　草十郎の的確すぎる指摘に、青子はファッション誌を置いて向き直る。"
msgstr ""

#. Occurrence A_0:2425:14467: scene=A_0
#: A_0:2425
msgctxt "text_id=14467 | speaker=unknown"
msgid "　透き通る青い目が、苛立ちをこめて草十郎を直視する。"
msgstr ""

#. Occurrence A_0:2457:14468: scene=A_0
#: A_0:2457
msgctxt "text_id=14468 | speaker=unknown"
msgid "　その目力に、正義は１００パーセント自分側にありながら、つい気合い負けをする草十郎だった。"
msgstr ""

#. Occurrence A_0:2479:14469: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0015; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2479
msgctxt "text_id=14469 | speaker=aoko"
msgid "「草十郎。"
msgstr ""

msgctxt "text_id=14470 | speaker=unknown"
msgid "何度も言うようだけど」"
msgstr ""

#. Occurrence A_0:2493:14471: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0010; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2493
msgctxt "text_id=14471 | speaker=soujuurou"
msgid "「はい」"
msgstr ""

#. Occurrence A_0:2498:14472: scene=A_0
#: A_0:2498
msgctxt "text_id=14472 | speaker=unknown"
msgid "　落ち着いた青子の声に、反射的に背中を伸ばす草十郎。"
msgstr ""

#. Occurrence A_0:2535:14473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0016; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2535
msgctxt "text_id=14473 | speaker=aoko"
msgid "「勘違いはしないで。私たちはアンタを同居させてあげてるんじゃない。"
msgstr ""

#. Occurrence A_0:2541:14474: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0017; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2541
msgctxt "text_id=14474 | speaker=aoko"
msgid "　これ以上ないって譲歩の末、仕方なく飼ってあげてるだけなんだからね」"
msgstr ""

#. Occurrence A_0:2557:14475: scene=A_0
#: A_0:2557
msgctxt "text_id=14475 | speaker=unknown"
msgid "　きっぱりと青子は言う。"
msgstr ""

#. Occurrence A_0:2562:14476: scene=A_0
#: A_0:2562
msgctxt "text_id=14476 | speaker=unknown"
msgid "　草十郎はなるほど、と頷いた。"
msgstr ""

#. Occurrence A_0:2604:14477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0011; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2604
msgctxt "text_id=14477 | speaker=soujuurou"
msgid "「そうか、飼ってもらってるのか」"
msgstr ""

#. Occurrence A_0:2626:14478: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0018; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2626
msgctxt "text_id=14478 | speaker=aoko"
msgid "「そ。番犬にもならないだろうけど」"
msgstr ""

#. Occurrence A_0:2632:14479: scene=A_0
#: A_0:2632
msgctxt "text_id=14479 | speaker=unknown"
msgid "　草十郎の呟きに、青子はつまらなそうに言い返す。"
msgstr ""

#. Occurrence A_0:2637:14480: scene=A_0
#: A_0:2637
msgctxt "text_id=14480 | speaker=unknown"
msgid "　それはそれで事実なのだが、草十郎にも一つや二つ反論もあるというもの。"
msgstr ""

#. Occurrence A_0:2674:14481: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0012; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2674
msgctxt "text_id=14481 | speaker=soujuurou"
msgid "「しかし一方、番犬は間違っても自分の食い<扶持|ぶち>を入れたり、あまつさえ家賃を払ったりしないのも事実であった」"
msgstr ""

#. Occurrence A_0:2691:14482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0019; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2691
msgctxt "text_id=14482 | speaker=aoko"
msgid "「何か言った？」"
msgstr ""

#. Occurrence A_0:2741:14483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0013; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2741
msgctxt "text_id=14483 | speaker=soujuurou"
msgid "「いや。負け犬の遠吠えを、少しばかり」"
msgstr ""

#. Occurrence A_0:2747:14484: scene=A_0
#: A_0:2747
msgctxt "text_id=14484 | speaker=unknown"
msgid "　参りました、とばかりに手をあげる草十郎。"
msgstr ""

#. Occurrence A_0:2752:14485: scene=A_0
#: A_0:2752
msgctxt "text_id=14485 | speaker=unknown"
msgid "　自虐的なセリフは、彼が言うと間の抜けた冗談にしか聞こえない。"
msgstr ""

#. Occurrence A_0:2797:14486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0020; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2797
msgctxt "text_id=14486 | speaker=aoko"
msgid "「……草十郎。アンタ、ほんとに分かってる？」"
msgstr ""

#. Occurrence A_0:2803:14487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0014; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2803
msgctxt "text_id=14487 | speaker=soujuurou"
msgid "「そうだな。君たちがどうあっても掃除をする気がないぐらいは、なんとか」"
msgstr ""

#. Occurrence A_0:2815:14488: scene=A_0
#: A_0:2815
msgctxt "text_id=14488 | speaker=unknown"
msgid "　それだけ理解していれば上等である。"
msgstr ""

#. Occurrence A_0:2826:14489: scene=A_0
#: A_0:2826
msgctxt "text_id=14489 | speaker=unknown"
msgid "　そんな草十郎の態度に、青子はにっこりと笑みをうかべた。"
msgstr ""

#. Occurrence A_0:2831:14490: scene=A_0
#: A_0:2831
msgctxt "text_id=14490 | speaker=unknown"
msgid "　どうも、今の返答がたいへんお気に召した模様。"
msgstr ""

#. Occurrence A_0:2853:14491: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0021; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2853
msgctxt "text_id=14491 | speaker=aoko"
msgid "「ふーん。余裕あるんだ、静希くんってば」"
msgstr ""

#. Occurrence A_0:2887:14492: scene=A_0
#: A_0:2887
msgctxt "text_id=14492 | speaker=unknown"
msgid "　楽しげな青子の笑みと同時に、草十郎の顔が<曇|くも>る。"
msgstr ""

#. Occurrence A_0:2927:14493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0015; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2927
msgctxt "text_id=14493 | speaker=soujuurou"
msgid "「……蒼崎。なんだか、息ができないんだけど」"
msgstr ""

#. Occurrence A_0:2933:14494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0022; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2933
msgctxt "text_id=14494 | speaker=aoko"
msgid "「このまま放っておくとそんなコトも言ってられなくなるんだけど、試してみる？」"
msgstr ""

#. Occurrence A_0:2938:14495: scene=A_0
#: A_0:2938
msgctxt "text_id=14495 | speaker=unknown"
msgid "　草十郎は顔をますます曇らせながら、いや、と首を横に振って答えた。"
msgstr ""

#. Occurrence A_0:2988:14496: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0023; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2988
msgctxt "text_id=14496 | speaker=aoko"
msgid "「賢明ね。私も窒息死体なんて見たくないもの」"
msgstr ""

#. Occurrence A_0:3025:14497: scene=A_0
#: A_0:3025
msgctxt "text_id=14497 | speaker=unknown"
msgid "　耳障りな音が途絶える。"
msgstr ""

#. Occurrence A_0:3030:14498: scene=A_0
#: A_0:3030
msgctxt "text_id=14498 | speaker=unknown"
msgid "　草十郎はそろりと首に手を当てる。"
msgstr ""

#. Occurrence A_0:3035:14499: scene=A_0
#: A_0:3035
msgctxt "text_id=14499 | speaker=unknown"
msgid "　さっきまで独りでに絞まってきた首輪は、今ではもとのサイズに戻っていた。"
msgstr ""

#. Occurrence A_0:3075:14500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0016; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3075
msgctxt "text_id=14500 | speaker=soujuurou"
msgid "「……気管が<塞|ふさ>がれた時の苦しさを知らないんだろ、蒼崎は。本当に抵抗できなくなるんだぞ、あれは」"
msgstr ""

#. Occurrence A_0:3097:14501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0024; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3097
msgctxt "text_id=14501 | speaker=aoko"
msgid "「だから、そのための首輪だって言ったでしょ。"
msgstr ""

#. Occurrence A_0:3103:14502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0025; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3103
msgctxt "text_id=14502 | speaker=aoko"
msgid "　今まで実践したコトなかったし、アンタはあいかわらず危機感ないし。ここらで一度<躾|しつ>けておいたの。"
msgstr ""

#. Occurrence A_0:3130:14503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0026; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3130
msgctxt "text_id=14503 | speaker=aoko"
msgid "　―――それより掃除。急がないと日が暮れるんじゃないの？」"
msgstr ""

#. Occurrence A_0:3163:14504: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0017; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3163
msgctxt "text_id=14504 | speaker=soujuurou"
msgid "「……はあ。わかったよ。"
msgstr ""

#. Occurrence A_0:3169:14505: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0018; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3169
msgctxt "text_id=14505 | speaker=soujuurou"
msgid "　結局、今日はこうなる星の運びだったんだ」"
msgstr ""

#. Occurrence A_0:3211:14506: scene=A_0
#: A_0:3211
msgctxt "text_id=14506 | speaker=unknown"
msgid "　負け犬よろしく肩を落として、草十郎はサンルームから立ち去っていった。"
msgstr ""

#. Occurrence A_0:3224:14507: scene=A_0
#: A_0:3224
msgctxt "text_id=14507 | speaker=unknown"
msgid "　それを見送った後、何事もなかったように青子は雑誌に視線を戻す。"
msgstr ""

#. Occurrence A_0:3258:14508: scene=A_0
#: A_0:3258
msgctxt "text_id=14508 | speaker=unknown"
msgid "　以上のやりとりを、有珠は我関せずと聞き流していた。"
msgstr ""

#. Occurrence A_0:3263:14509: scene=A_0
#: A_0:3263
msgctxt "text_id=14509 | speaker=unknown"
msgid "　何度目かの沈黙。"
msgstr ""

#. Occurrence A_0:3268:14510: scene=A_0
#: A_0:3268
msgctxt "text_id=14510 | speaker=unknown"
msgid "　刻々と時計の針が回る中、不意に、ページをめくる有珠の手が止まった。"
msgstr ""

#. Occurrence A_0:3289:14511: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0006; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:3289
msgctxt "text_id=14511 | speaker=alice"
msgid "「ねえ。どうして彼を酷使するの？」"
msgstr ""

#. Occurrence A_0:3295:14512: scene=A_0
#: A_0:3295
msgctxt "text_id=14512 | speaker=unknown"
msgid "　独り言のような問い。"
msgstr ""

#. Occurrence A_0:3300:14513: scene=A_0
#: A_0:3300
msgctxt "text_id=14513 | speaker=unknown"
msgid "　青子は雑誌をめくる手を止めず、"
msgstr ""

#. Occurrence A_0:3335:14514: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0027; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3335
msgctxt "text_id=14514 | speaker=aoko"
msgid "「別に。最後には記憶を消させてもらうんだから、楽しかったら困るじゃない」"
msgstr ""

#. Occurrence A_0:3341:14515: scene=A_0
#: A_0:3341
msgctxt "text_id=14515 | speaker=unknown"
msgid "　極めて分かりにくい、彼女らしい誠実さを口にした。"
msgstr ""

#. Occurrence A_0:3374:14516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0007; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:3374
msgctxt "text_id=14516 | speaker=alice"
msgid "「…………そう。言われてみれば、そうだったわね」"
msgstr ""

#. Occurrence A_0:3380:14517: scene=A_0
#: A_0:3380
msgctxt "text_id=14517 | speaker=unknown"
msgid "　……そんなコトを、忘れていた自分に驚いてしまう。"
msgstr ""

#. Occurrence A_0:3385:14518: scene=A_0
#: A_0:3385
msgctxt "text_id=14518 | speaker=unknown"
msgid "　有珠は静かに顔を上げ、硝子ごしの風景を眺めた。"
msgstr ""

#. Occurrence A_0:3430:14519: scene=A_0
#: A_0:3430
msgctxt "text_id=14519 | speaker=unknown"
msgid "　窓から見える彼女の中庭は、十年前の故郷を思わせる。"
msgstr ""

#. Occurrence A_0:3435:14520: scene=A_0
#: A_0:3435
msgctxt "text_id=14520 | speaker=unknown"
msgid "　あの頃に比べれば何もかも<見窄|みすぼ>らしい、荒れ野とさえ言える庭。"
msgstr ""

#. Occurrence A_0:3440:14521: scene=A_0
#: A_0:3440
msgctxt "text_id=14521 | speaker=unknown"
msgid "　なのに、どうして面影が重なるのか。"
msgstr ""

#. Occurrence A_0:3479:14522: scene=A_0
#: A_0:3479
msgctxt "text_id=14522 | speaker=unknown"
msgid "　ただ大切に、真心だけで手入れをされた彼女の庭。"
msgstr ""

#. Occurrence A_0:3485:14523: scene=A_0
#: A_0:3485
msgctxt "text_id=14523 | speaker=unknown"
msgid "　それが今日半日の、草十郎の成果だった。"
msgstr ""

#. Occurrence A_1:42:14524: scene=A_1
#: A_1:42
msgctxt "text_id=14524 | speaker=unknown"
msgid "　イヴの日に、雪はしんしんと降りはじめた。"
msgstr ""

#. Occurrence A_1:83:14525: scene=A_1
#: A_1:83
msgctxt "text_id=14525 | speaker=unknown"
msgid "　自らの価値を知っていたのか、今年の初雪は誰もが喜ぶ記念日に顔を見せた。"
msgstr ""

#. Occurrence A_1:88:14526: scene=A_1
#: A_1:88
msgctxt "text_id=14526 | speaker=unknown"
msgid "　大通りでの<賑|にぎ>わいは白く寒く、それでいて明るいものになっているだろう。"
msgstr ""

#. Occurrence A_1:108:14527: scene=A_1
#: A_1:108
msgctxt "text_id=14527 | speaker=unknown"
msgid "　トナカイを<象|かたど>るイルミネーション。"
msgstr ""

#. Occurrence A_1:113:14528: scene=A_1
#: A_1:113
msgctxt "text_id=14528 | speaker=unknown"
msgid "　子供たちの足を弾ませるジングルベル。"
msgstr ""

#. Occurrence A_1:118:14529: scene=A_1
#: A_1:118
msgctxt "text_id=14529 | speaker=unknown"
msgid "　レンガの道を行く人々は、一様に満ち足りた微笑みをうかべている。"
msgstr ""

#. Occurrence A_1:162:14530: scene=A_1
#: A_1:162
msgctxt "text_id=14530 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence A_1:167:14531: scene=A_1
#: A_1:167
msgctxt "text_id=14531 | speaker=unknown"
msgid "　そんな街の<彩|いろど>りも、丘の上の洋館には届かない。"
msgstr ""

#. Occurrence A_1:172:14532: scene=A_1
#: A_1:172
msgctxt "text_id=14532 | speaker=unknown"
msgid "　人里から離れた館は静かに。"
msgstr ""

#. Occurrence A_1:177:14533: scene=A_1
#: A_1:177
msgctxt "text_id=14533 | speaker=unknown"
msgid "　森は白い粉雪に覆われ、いっそう影を濃くしていた。"
msgstr ""

#. Occurrence A_1:183:14534: scene=A_1
#: A_1:183
msgctxt "text_id=14534 | speaker=unknown"
msgid "　いずれ来るであろう<黄昏時|たそがれどき>。"
msgstr ""

#. Occurrence A_1:188:14535: scene=A_1
#: A_1:188
msgctxt "text_id=14535 | speaker=unknown"
msgid "　人々が<家路|いえじ>に就き、街頭から<人気|ひとけ>の絶える静夜を、じっと待ち続けるように。"
msgstr ""

#. Occurrence A_1:260:14536: scene=A_1
#: A_1:260
msgctxt "text_id=14536 | speaker=unknown"
msgid "　その日の洋館は、朝から空気が違っていた。"
msgstr ""

#. Occurrence A_1:265:14537: scene=A_1
#: A_1:265
msgctxt "text_id=14537 | speaker=unknown"
msgid "　嵐の前の静けさである。"
msgstr ""

#. Occurrence A_1:290:14538: scene=A_1
#: A_1:290
msgctxt "text_id=14538 | speaker=unknown"
msgid "　敵の正体―――蒼崎橙子の存在が明らかになってから二日。"
msgstr ""

#. Occurrence A_1:295:14539: scene=A_1
#: A_1:295
msgctxt "text_id=14539 | speaker=unknown"
msgid "　青子も有珠も自室に閉じこもる事が多くなり、食事<時|どき>の談話も目に見えて少なくなった。"
msgstr ""

#. Occurrence A_1:300:14540: scene=A_1
#: A_1:300
msgctxt "text_id=14540 | speaker=unknown"
msgid "　役割分担を終えた少女たちは、それぞれの仕事を<全|まっと>うするため、自分の事だけで手一杯なのだ。"
msgstr ""

#. Occurrence A_1:359:14541: scene=A_1
#: A_1:359
msgctxt "text_id=14541 | speaker=unknown"
msgid "　そんな二人が、今日は朝から居間でくつろいでいる。"
msgstr ""

#. Occurrence A_1:364:14542: scene=A_1
#: A_1:364
msgctxt "text_id=14542 | speaker=unknown"
msgid "　張りつめた様子もない。"
msgstr ""

#. Occurrence A_1:369:14543: scene=A_1
#: A_1:369
msgctxt "text_id=14543 | speaker=unknown"
msgid "　だから逆に今夜がそうなのだと、草十郎は悟ってしまった。"
msgstr ""

#. Occurrence A_1:403:14544: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0000; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:403
msgctxt "text_id=14544 | speaker=soujuurou"
msgid "「雪が明日なら良かったのに」"
msgstr ""

#. Occurrence A_1:410:14545: scene=A_1
#: A_1:410
msgctxt "text_id=14545 | speaker=unknown"
msgid "　草十郎はソファーに座った二人に話しかける。"
msgstr ""

#. Occurrence A_1:415:14546: scene=A_1
#: A_1:415
msgctxt "text_id=14546 | speaker=unknown"
msgid "　返事は期待していない。"
msgstr ""

#. Occurrence A_1:420:14547: scene=A_1
#: A_1:420
msgctxt "text_id=14547 | speaker=unknown"
msgid "　大体、雪が明日になったところで彼女たちに変化があるわけでもない。"
msgstr ""

#. Occurrence A_1:425:14548: scene=A_1
#: A_1:425
msgctxt "text_id=14548 | speaker=unknown"
msgid "　クリスマスが、ホワイトクリスマスになるだけの話である。"
msgstr ""

#. Occurrence A_1:457:14549: scene=A_1
#: A_1:457
msgctxt "text_id=14549 | speaker=unknown"
msgid "　青子から言葉はなかった。"
msgstr ""

#. Occurrence A_1:462:14550: scene=A_1
#: A_1:462
msgctxt "text_id=14550 | speaker=unknown"
msgid "　無視しているのではなく、単純に、そこまでの余裕がないだけだ。"
msgstr ""

#. Occurrence A_1:467:14551: scene=A_1
#: A_1:467
msgctxt "text_id=14551 | speaker=unknown"
msgid "　分かり切った事とはいえ少し淋しいな、と草十郎はサンルームに視線を投げる。"
msgstr ""

#. Occurrence A_1:502:14552: scene=A_1
#: A_1:502
msgctxt "text_id=14552 | speaker=unknown"
msgid "　何日か前に手入れをした中庭は、白一色に染まっている。"
msgstr ""

#. Occurrence A_1:507:14553: scene=A_1
#: A_1:507
msgctxt "text_id=14553 | speaker=unknown"
msgid "　粉雪は降ったり止んだりと気まぐれだが、この分ではかなりの厚さで地面に残るに違いない。"
msgstr ""

#. Occurrence A_1:512:14554: scene=A_1
#: A_1:512
msgctxt "text_id=14554 | speaker=unknown"
msgid "　夜には一面の銀世界になるだろう。"
msgstr ""

#. Occurrence A_1:517:14555: scene=A_1
#: A_1:517
msgctxt "text_id=14555 | speaker=unknown"
msgid "　伝わる寒気から身を暖めるように、青子たちは紅茶を口に運んでいる。"
msgstr ""

#. Occurrence A_1:522:14556: scene=A_1
#: A_1:522
msgctxt "text_id=14556 | speaker=unknown"
msgid "　思えばそれだけが、今の彼女たちの行動だった。"
msgstr ""

#. Occurrence A_1:555:14557: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0001; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:555
msgctxt "text_id=14557 | speaker=soujuurou"
msgid "「そういえば、橙子さんの髪の色は蒼崎より濃かったね。"
msgstr ""

#. Occurrence A_1:555:14558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0001; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:555
msgctxt "text_id=14558 | speaker=soujuurou"
msgid "　あんな綺麗な赤毛は初めて見た。短くしてるのはもったいなかったな」"
msgstr ""

#. Occurrence A_1:560:14559: scene=A_1
#: A_1:560
msgctxt "text_id=14559 | speaker=unknown"
msgid "　これも返事は期待せず、ぼんやりと呟く草十郎。"
msgstr ""

#. Occurrence A_1:565:14560: scene=A_1
#: A_1:565
msgctxt "text_id=14560 | speaker=unknown"
msgid "　しかし。"
msgstr ""

#. Occurrence A_1:592:14561: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0000; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:592
msgctxt "text_id=14561 | speaker=aoko"
msgid "「……短かったって、姉貴の髪が……？」"
msgstr ""

#. Occurrence A_1:598:14562: scene=A_1
#: A_1:598
msgctxt "text_id=14562 | speaker=unknown"
msgid "　心ここにあらずだった青子の表情が、普段の鋭さを取り戻した。"
msgstr ""

#. Occurrence A_1:633:14563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0001; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:633
msgctxt "text_id=14563 | speaker=aoko"
msgid "「それどういうこと？　短くしてるって、髪の毛の事よね？」"
msgstr ""

#. Occurrence A_1:652:14564: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0002; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:652
msgctxt "text_id=14564 | speaker=soujuurou"
msgid "「ああ。有珠より短かったけど、それがどうしたんだ？」"
msgstr ""

#. Occurrence A_1:658:14565: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0002; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:658
msgctxt "text_id=14565 | speaker=aoko"
msgid "「別に。あの人、前は私より長かったってだけ。"
msgstr ""

#. Occurrence A_1:678:14566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0003; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:678
msgctxt "text_id=14566 | speaker=aoko"
msgid "　―――そう。あの髪を切ったのね、姉貴は」"
msgstr ""

#. Occurrence A_1:684:14567: scene=A_1
#: A_1:684
msgctxt "text_id=14567 | speaker=unknown"
msgid "　深刻な独白。"
msgstr ""

#. Occurrence A_1:689:14568: scene=A_1
#: A_1:689
msgctxt "text_id=14568 | speaker=unknown"
msgid "　有珠も関心があるのか、黒い瞳を草十郎に向けていた。"
msgstr ""

#. Occurrence A_1:748:14569: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0003; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:748
msgctxt "text_id=14569 | speaker=soujuurou"
msgid "「……普通じゃないな。髪を切ったぐらいでどうしたんだ、一体。橙子さんの髪が短いと蒼崎が困るのか？」"
msgstr ""

#. Occurrence A_1:767:14570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0004; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:767
msgctxt "text_id=14570 | speaker=aoko"
msgid "「…………まあ、その通りだけど。"
msgstr ""

#. Occurrence A_1:779:14571: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0005; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:779
msgctxt "text_id=14571 | speaker=aoko"
msgid "　いいわ、どうせ夜まで暇だし、説明ぐらいはしてあげる。"
msgstr ""

#. Occurrence A_1:785:14572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0006; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:785
msgctxt "text_id=14572 | speaker=aoko"
msgid "　アンタがそんなコト言わなければ、未知数のまま橙子と戦うはめになっただろうし」"
msgstr ""

#. Occurrence A_1:817:14573: scene=A_1
#: A_1:817
msgctxt "text_id=14573 | speaker=unknown"
msgid "　ま、ご褒美ね、と青子は有珠を一瞥した。"
msgstr ""

#. Occurrence A_1:822:14574: scene=A_1
#: A_1:822
msgctxt "text_id=14574 | speaker=unknown"
msgid "　おそらく有珠に同意を求めているのだろう。"
msgstr ""

#. Occurrence A_1:827:14575: scene=A_1
#: A_1:827
msgctxt "text_id=14575 | speaker=unknown"
msgid "　有珠はやっぱり無表情で、青子の視線に肯定も否定もしない。"
msgstr ""

#. Occurrence A_1:859:14576: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0007; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:859
msgctxt "text_id=14576 | speaker=aoko"
msgid "「簡単に言うと、魔術師にとっては髪の毛も武器ってコトよ。"
msgstr ""

#. Occurrence A_1:865:14577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0008; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:865
msgctxt "text_id=14577 | speaker=aoko"
msgid "　昔っから人間の髪や目は魔術の材料になりやすいの。女の場合は<殊更|ことさら>にね。"
msgstr ""

#. Occurrence A_1:871:14578: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0009; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:871
msgctxt "text_id=14578 | speaker=aoko"
msgid "　瞳の色は<多彩|おおい>ほどいいし、髪も長いほど質がいい。"
msgstr ""

#. Occurrence A_1:877:14579: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0010; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:877
msgctxt "text_id=14579 | speaker=aoko"
msgid "　髪の毛は自身と同一視しやすいし、長い年月をかけて育てられる、原始的で強力な“原料”と思ってくれていいわ。"
msgstr ""

#. Occurrence A_1:896:14580: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0011; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:896
msgctxt "text_id=14580 | speaker=aoko"
msgid "　私が髪を伸ばしてるのはまあ、そういうこと。手入れが大変なんだけど、そこは女だから半分趣味みたいなもんよね」"
msgstr ""

#. Occurrence A_1:916:14581: scene=A_1
#: A_1:916
msgctxt "text_id=14581 | speaker=unknown"
msgid "　……はて。そうなると有珠はどうなのだろうか、と草十郎は有珠の横顔を盗み見る。"
msgstr ""

#. Occurrence A_1:934:14582: scene=A_1
#: A_1:934
msgctxt "text_id=14582 | speaker=unknown"
msgid "　青子の言う通り、手入れが面倒なので切ってしまったのか。"
msgstr ""

#. Occurrence A_1:939:14583: scene=A_1
#: A_1:939
msgctxt "text_id=14583 | speaker=unknown"
msgid "　バカらしい考えだが、有珠ならありうるな、と草十郎は内心うなずいた。"
msgstr ""

#. Occurrence A_1:977:14584: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0004; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:977
msgctxt "text_id=14584 | speaker=soujuurou"
msgid "「ん？　じゃあ蒼崎としてはいい事じゃないか。"
msgstr ""

#. Occurrence A_1:983:14585: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0005; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:983
msgctxt "text_id=14585 | speaker=soujuurou"
msgid "　橙子さんの髪、短いんだから」"
msgstr ""

#. Occurrence A_1:1017:14586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0012; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1017
msgctxt "text_id=14586 | speaker=aoko"
msgid "「それが<三咲町|ここ>に来る前に使い切ったものならいいんだけど。"
msgstr ""

#. Occurrence A_1:1023:14587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0013; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1023
msgctxt "text_id=14587 | speaker=aoko"
msgid "　伸ばした髪には色々と使い道があるのよ。"
msgstr ""

#. Occurrence A_1:1029:14588: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0014; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1029
msgctxt "text_id=14588 | speaker=aoko"
msgid "　私は瞬間的な術の強化にしか使えないけど、姉貴だったら恒久的な術の補佐に使うはず。"
msgstr ""

#. Occurrence A_1:1047:14589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0015; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1047
msgctxt "text_id=14589 | speaker=aoko"
msgid "　年月と想念を蓄えた髪は魔術師の分身とも言える。"
msgstr ""

#. Occurrence A_1:1053:14590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0016; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1053
msgctxt "text_id=14590 | speaker=aoko"
msgid "　そういった物をね、死んじゃった犬だの猫だのを反魂させる時に与えると、術者に<服従|ふくじゅう>する使い魔が出来上がるの」"
msgstr ""

#. Occurrence A_1:1086:14591: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0017; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1086
msgctxt "text_id=14591 | speaker=aoko"
msgid "「生前魔力のなかった使い魔……例えば猫とか、犬ね。これらは術者の髪を取りこんで独自の魔術回路を得る。"
msgstr ""

#. Occurrence A_1:1092:14592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0018; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1092
msgctxt "text_id=14592 | speaker=aoko"
msgid "　新生する事でまったく違う生き物―――<猫|・><の|・><魔|・><術|・><師|・>になるってコト。たとえば人語を解したり、人間に化けてみたりって。"
msgstr ""

#. Occurrence A_1:1098:14593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0019; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1098
msgctxt "text_id=14593 | speaker=aoko"
msgid "　行動原理も変わってしまって、たいていは術者に似通った性格になるわ。そうよね、有珠？」"
msgstr ""

#. Occurrence A_1:1128:14594: scene=A_1
#: A_1:1128
msgctxt "text_id=14594 | speaker=unknown"
msgid "　青子の最後の言葉は、どこか意地の悪い笑みが含まれていた。"
msgstr ""

#. Occurrence A_1:1133:14595: scene=A_1
#: A_1:1133
msgctxt "text_id=14595 | speaker=unknown"
msgid "　有珠はそれを無言で受け流す。"
msgstr ""

#. Occurrence A_1:1166:14596: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0006; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1166
msgctxt "text_id=14596 | speaker=soujuurou"
msgid "「じゃあ、橙子さんには有珠のみたいな使い魔がいると……？」"
msgstr ""

#. Occurrence A_1:1172:14597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0020; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1172
msgctxt "text_id=14597 | speaker=aoko"
msgid "「そう見るのが妥当でしょうね。"
msgstr ""

#. Occurrence A_1:1178:14598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0021; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1178
msgctxt "text_id=14598 | speaker=aoko"
msgid "　姉貴は二十年以上伸ばし続けた髪と引き替えに、強力な使い魔を用意したってことよ」"
msgstr ""

#. Occurrence A_1:1199:14599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0007; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1199
msgctxt "text_id=14599 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence A_1:1219:14600: scene=A_1
#: A_1:1219
msgctxt "text_id=14600 | speaker=unknown"
msgid "　遊園地での戦い。"
msgstr ""

#. Occurrence A_1:1239:14601: scene=A_1
#: A_1:1239
msgctxt "text_id=14601 | speaker=unknown"
msgid "　久遠寺有珠が解放したフラットスナークを思い出して、草十郎は息を呑む。"
msgstr ""

#. Occurrence A_1:1244:14602: scene=A_1
#: A_1:1244
msgctxt "text_id=14602 | speaker=unknown"
msgid "　あの月の油は特注も特注で、あれだけの使い魔は世界に二つとないという話だが―――"
msgstr ""

#. Occurrence A_1:1290:14603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0022; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1290
msgctxt "text_id=14603 | speaker=aoko"
msgid "「ほら、そこ心配しない、三咲町をぶっ壊す規模の使い魔なんてありっこないから。"
msgstr ""

#. Occurrence A_1:1296:14604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0023; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1296
msgctxt "text_id=14604 | speaker=aoko"
msgid "　たしかに長く歴史のある髪を使用するほど、強力な使い魔が出来上がる」"
msgstr ""

#. Occurrence A_1:1323:14605: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0024; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1323
msgctxt "text_id=14605 | speaker=aoko"
msgid "「けど、髪を使った魔術師はそれまで溜めこんできた三柱のうちの一つを、初めからやり直さないといけない。"
msgstr ""

#. Occurrence A_1:1329:14606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0025; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1329
msgctxt "text_id=14606 | speaker=aoko"
msgid "　切った髪はまた伸ばさないといけないでしょ？　使い魔を造るのは簡単だけど、そう多く従えないのはそういう事なの」"
msgstr ""

#. Occurrence A_1:1364:14607: scene=A_1
#: A_1:1364
msgctxt "text_id=14607 | speaker=unknown"
msgid "　話しているうちに何かふっきれたのか、青子は上機嫌になりつつある。"
msgstr ""

#. Occurrence A_1:1376:14608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0008; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1376
msgctxt "text_id=14608 | speaker=soujuurou"
msgid "『……犬とか猫、か……』"
msgstr ""

#. Occurrence A_1:1381:14609: scene=A_1
#: A_1:1381
msgctxt "text_id=14609 | speaker=unknown"
msgid "　一方、青子の話を聞いて首を傾げる草十郎。"
msgstr ""

#. Occurrence A_1:1386:14610: scene=A_1
#: A_1:1386
msgctxt "text_id=14610 | speaker=unknown"
msgid "　彼の想像力では、どう考えても、犬と猫から強そうなイメージは生まれないようだ。"
msgstr ""

#. Occurrence A_1:1419:14611: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0000; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1419
msgctxt "text_id=14611 | speaker=alice"
msgid "「……変ね。"
msgstr ""

#. Occurrence A_1:1425:14612: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0001; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1425
msgctxt "text_id=14612 | speaker=alice"
msgid "　橙子さんは人形師よ。使い魔を造って自分のレベルを下げるのは、どうなのかしら」"
msgstr ""

#. Occurrence A_1:1450:14613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0026; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1450
msgctxt "text_id=14613 | speaker=aoko"
msgid "「協力者がいないだけでしょ。蒼崎のお家騒動に<他人|ひと>の手を借りたくないから、自分だけで全部やるつもりなのよ」"
msgstr ""

#. Occurrence A_1:1477:14614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0027; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1477
msgctxt "text_id=14614 | speaker=aoko"
msgid "「あ……もしかして、遊園地の人形って姉貴の髪で造られたんじゃないだろうな……」"
msgstr ""

#. Occurrence A_1:1501:14615: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0002; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1501
msgctxt "text_id=14615 | speaker=alice"
msgid "「……たしかに、話に聞いたかぎりだと特注品ね。"
msgstr ""

#. Occurrence A_1:1507:14616: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0003; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1507
msgctxt "text_id=14616 | speaker=alice"
msgid "　呪いによる永久機関、両手のギミック、フィンの一撃、執念深さ。橙子さんでもゼロから造るのは難しいでしょうけど……」"
msgstr ""

#. Occurrence A_1:1528:14617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0028; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1528
msgctxt "text_id=14617 | speaker=aoko"
msgid "「けど、なによ有珠？」"
msgstr ""

#. Occurrence A_1:1561:14618: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0004; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1561
msgctxt "text_id=14618 | speaker=alice"
msgid "「……あの人は、人形に自己を投影するような人じゃないわ。"
msgstr ""

#. Occurrence A_1:1567:14619: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0005; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1567
msgctxt "text_id=14619 | speaker=alice"
msgid "　完璧な偽物なら許すけど、偽物にすぎない偽物は容赦なく壊してきた。"
msgstr ""

#. Occurrence A_1:1574:14620: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0006; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1574
msgctxt "text_id=14620 | speaker=alice"
msgid "青子から見て、その特注人形は橙子さんと同じ力量を持っていた？」"
msgstr ""

#. Occurrence A_1:1580:14621: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0029; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1580
msgctxt "text_id=14621 | speaker=aoko"
msgid "「……まさか。遠く及ばないわよ、あんなの」"
msgstr ""

#. Occurrence A_1:1607:14622: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0007; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1607
msgctxt "text_id=14622 | speaker=alice"
msgid "「なら橙子さんの髪と、あの人形は別件よ。"
msgstr ""

#. Occurrence A_1:1613:14623: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0008; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1613
msgctxt "text_id=14623 | speaker=alice"
msgid "　あの人が自分の魔力を分け与えたほどの使い魔が、あと一体はいると見るべきね」"
msgstr ""

#. Occurrence A_1:1647:14624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0030; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1647
msgctxt "text_id=14624 | speaker=aoko"
msgid "「……専門家としての意見？"
msgstr ""

#. Occurrence A_1:1653:14625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0031; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1653
msgctxt "text_id=14625 | speaker=aoko"
msgid "　つまり、その使い魔は<姉|・><貴|・><よ|・><り|・><強|・><い|・>？」"
msgstr ""

#. Occurrence A_1:1671:14626: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0009; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1671
msgctxt "text_id=14626 | speaker=alice"
msgid "「そうでないと意味がないわ。"
msgstr ""

#. Occurrence A_1:1677:14627: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0010; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1677
msgctxt "text_id=14627 | speaker=alice"
msgid "　……人手が足りないというのもあるでしょうけど。だってわたしたちは二人、彼女は一人だもの」"
msgstr ""

#. Occurrence A_1:1709:14628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0032; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1709
msgctxt "text_id=14628 | speaker=aoko"
msgid "「―――同時制圧も想定済みってワケ。"
msgstr ""

#. Occurrence A_1:1715:14629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0033; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1715
msgctxt "text_id=14629 | speaker=aoko"
msgid "　なるほどね。その場合、どっちが強い方を引き当てても恨みっこなしよ有珠。"
msgstr ""

#. Occurrence A_1:1727:14630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0034; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1727
msgctxt "text_id=14630 | speaker=aoko"
msgid "　ま、こと使い魔でアンタが後れを取るとは思えないけど」"
msgstr ""

#. Occurrence A_1:1757:14631: scene=A_1
#: A_1:1757
msgctxt "text_id=14631 | speaker=unknown"
msgid "　使い魔同士の戦いなら久遠寺有珠に敗北はない。"
msgstr ""

#. Occurrence A_1:1762:14632: scene=A_1
#: A_1:1762
msgctxt "text_id=14632 | speaker=unknown"
msgid "　そう楽観する青子に、有珠はため息まじりに忠告する。"
msgstr ""

#. Occurrence A_1:1783:14633: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0011; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1783
msgctxt "text_id=14633 | speaker=alice"
msgid "「青子。たとえ二十年間の蓄えを付与したとしても、その器が小動物では限度があるわ。"
msgstr ""

#. Occurrence A_1:1789:14634: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0012; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1789
msgctxt "text_id=14634 | speaker=alice"
msgid "　あの橙子さんが切札になる使い魔を用意したのなら、それは」"
msgstr ""

#. Occurrence A_1:1827:14635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0035; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1827
msgctxt "text_id=14635 | speaker=aoko"
msgid "「……よしてよ。"
msgstr ""

#. Occurrence A_1:1833:14636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0036; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1833
msgctxt "text_id=14636 | speaker=aoko"
msgid "　いくらなんでも、姉貴はそこまで悪趣味じゃないわ」"
msgstr ""

#. Occurrence A_1:1866:14637: scene=A_1
#: A_1:1866
msgctxt "text_id=14637 | speaker=unknown"
msgid "　意味ありげに見つめ合うふたり。"
msgstr ""

#. Occurrence A_1:1888:14638: scene=A_1
#: A_1:1888
msgctxt "text_id=14638 | speaker=unknown"
msgid "　居間に会話が戻ってきた事は嬉しいが、不穏すぎるのも困りものだ。"
msgstr ""

#. Occurrence A_1:1929:14639: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0013; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1929
msgctxt "text_id=14639 | speaker=alice"
msgid "「……そうね。けれど、人間を追いつめるのに最も効果的な相手は、やっぱり人間なのよ。"
msgstr ""

#. Occurrence A_1:1935:14640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0014; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1935
msgctxt "text_id=14640 | speaker=alice"
msgid "　橙子さんが死者を亡者にしていなくても、それと同格の相手がいる、ぐらいは覚悟しておいて」"
msgstr ""

#. Occurrence A_1:1958:14641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0037; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1958
msgctxt "text_id=14641 | speaker=aoko"
msgid "「……はいはい、分かったわよ。たしかに天才ってヤツは空気読めないから。どんな生き物の死体を用意してきても驚かないわ」"
msgstr ""

#. Occurrence A_1:1984:14642: scene=A_1
#: A_1:1984
msgctxt "text_id=14642 | speaker=unknown"
msgid "　有珠の冷たい言葉に、青子は不本意そうに頷いた。"
msgstr ""

#. Occurrence A_1:1989:14643: scene=A_1
#: A_1:1989
msgctxt "text_id=14643 | speaker=unknown"
msgid "　言うまでもなく、草十郎にはちんぷんかんぷんである。"
msgstr ""

#. Occurrence A_1:2026:14644: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0009; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:2026
msgctxt "text_id=14644 | speaker=soujuurou"
msgid "「……その、よく分からないけど。"
msgstr ""

#. Occurrence A_1:2032:14645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0010; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:2032
msgctxt "text_id=14645 | speaker=soujuurou"
msgid "　なんで蒼崎たちは死んでるって事に固執するんだ？　生きてる物じゃ駄目なのか？」"
msgstr ""

#. Occurrence A_1:2062:14646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0038; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2062
msgctxt "text_id=14646 | speaker=aoko"
msgid "「それは使い魔じゃなくて協力者でしょ。使い魔は基本、術者なくしては生きられないものにしないと。"
msgstr ""

#. Occurrence A_1:2068:14647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0039; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2068
msgctxt "text_id=14647 | speaker=aoko"
msgid "　それでいて優れた<人格|いし>を持ち、術者の死角や盲点を補える知性もある―――それが一流の使い魔の条件よ。"
msgstr ""

#. Occurrence A_1:2074:14648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0040; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2074
msgctxt "text_id=14648 | speaker=aoko"
msgid "　正直な話、それだけ都合のいいヤツは死から作り直すしかないってワケ」"
msgstr ""

#. Occurrence A_1:2107:14649: scene=A_1
#: A_1:2107
msgctxt "text_id=14649 | speaker=unknown"
msgid "　絶対服従でありながら、術者の死角……勘違いやドジをフォローする役回り。"
msgstr ""

#. Occurrence A_1:2112:14650: scene=A_1
#: A_1:2112
msgctxt "text_id=14650 | speaker=unknown"
msgid "　つまるところ、使い魔というのは今の自分とあんまり変わらない連中なのか、と草十郎は納得した。"
msgstr ""

#. Occurrence A_1:2139:14651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0041; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2139
msgctxt "text_id=14651 | speaker=aoko"
msgid "「……さて。"
msgstr ""

#. Occurrence A_1:2145:14652: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0042; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2145
msgctxt "text_id=14652 | speaker=aoko"
msgid "　姉貴は昔からルーン使いだったから戦術は予測できる。"
msgstr ""

#. Occurrence A_1:2151:14653: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0043; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2151
msgctxt "text_id=14653 | speaker=aoko"
msgid "　問題の切札もどうやら使い魔らしい。"
msgstr ""

#. Occurrence A_1:2163:14654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0044; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2163
msgctxt "text_id=14654 | speaker=aoko"
msgid "　自動人形もさすがにこの前で使いきっただろうし……」"
msgstr ""

#. Occurrence A_1:2169:14655: scene=A_1
#: A_1:2169
msgctxt "text_id=14655 | speaker=unknown"
msgid "　確認するように言いながら、青子は有珠と視線を合わせた。"
msgstr ""

#. Occurrence A_1:2174:14656: scene=A_1
#: A_1:2174
msgctxt "text_id=14656 | speaker=unknown"
msgid "　有珠は頷きだけで同意する。"
msgstr ""

#. Occurrence A_1:2201:14657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0045; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2201
msgctxt "text_id=14657 | speaker=aoko"
msgid "「じゃあ予定通り、今日で終わりにしよう。"
msgstr ""

#. Occurrence A_1:2230:14658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0046; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2230
msgctxt "text_id=14658 | speaker=aoko"
msgid "　この一ヶ月、好き放題やられた借り―――ぎったんぎったんにして、あのバカ姉貴に返してやる……！」"
msgstr ""

#. Occurrence A_1:2236:14659: scene=A_1
#: A_1:2236
msgctxt "text_id=14659 | speaker=unknown"
msgid "　ぐっと握りこぶしを作る青子。"
msgstr ""

#. Occurrence A_1:2241:14660: scene=A_1
#: A_1:2241
msgctxt "text_id=14660 | speaker=unknown"
msgid "　こうして見るとごく一般的な姉妹ゲンカにしか見えないのは、おそらく、本当に姉妹ゲンカにすぎないからだろう。"
msgstr ""

#. Occurrence A_1:2280:14661: scene=A_1
#: A_1:2280
msgctxt "text_id=14661 | speaker=unknown"
msgid "　そんな青子の様子に、草十郎はそっと安堵の息をついた。"
msgstr ""

#. Occurrence A_1:2285:14662: scene=A_1
#: A_1:2285
msgctxt "text_id=14662 | speaker=unknown"
msgid "　先日やってきた橙子と、その後の青子たちの緊張感は、本気で殺し合うような空気だった。"
msgstr ""

#. Occurrence A_1:2290:14663: scene=A_1
#: A_1:2290
msgctxt "text_id=14663 | speaker=unknown"
msgid "　が、今の青子には、そんな凄惨さはまったくない。"
msgstr ""

#. Occurrence A_1:2318:14664: scene=A_1
#: A_1:2318
msgctxt "text_id=14664 | speaker=unknown"
msgid "　結局、刀はもとの鞘に戻るのだろうな、とぼんやりと考えて、草十郎は安心したのだ。"
msgstr ""

#. Occurrence A_1:2323:14665: scene=A_1
#: A_1:2323
msgctxt "text_id=14665 | speaker=unknown"
msgid "　青子と橙子。たとえ両者が赤の他人であったとしても、彼は彼女たちの争う姿は見たくはなかった。"
msgstr ""

#. Occurrence A_1:2329:14666: scene=A_1
#: A_1:2329
msgctxt "text_id=14666 | speaker=unknown"
msgid "　……時間は緩やかに過ぎていく。"
msgstr ""

#. Occurrence A_1:2334:14667: scene=A_1
#: A_1:2334
msgctxt "text_id=14667 | speaker=unknown"
msgid "　青子の言う決着の夜―――彼の浅はかな間違いを正す、無慈悲な夜の静寂へと。"
msgstr ""

#. Occurrence A_2:51:14668: scene=A_2
#: A_2:51
msgctxt "text_id=14668 | speaker=unknown"
msgid "　夜の訪れと共に、二つのものが消え去った。"
msgstr ""

#. Occurrence A_2:57:14669: scene=A_2
#: A_2:57
msgctxt "text_id=14669 | speaker=unknown"
msgid "　一つは気まぐれな<白雪|しらゆき>。"
msgstr ""

#. Occurrence A_2:62:14670: scene=A_2
#: A_2:62
msgctxt "text_id=14670 | speaker=unknown"
msgid "　一つは、丘の上の洋館の明かりである。"
msgstr ""

#. Occurrence A_2:108:14671: scene=A_2
#: A_2:108
msgctxt "text_id=14671 | speaker=unknown"
msgid "　洋館に青子と有珠の姿はない。"
msgstr ""

#. Occurrence A_2:113:14672: scene=A_2
#: A_2:113
msgctxt "text_id=14672 | speaker=unknown"
msgid "　残っているのは草十郎だけだ。"
msgstr ""

#. Occurrence A_2:119:14673: scene=A_2
#: A_2:119
msgctxt "text_id=14673 | speaker=unknown"
msgid "　クリスマスイヴの夜。"
msgstr ""

#. Occurrence A_2:124:14674: scene=A_2
#: A_2:124
msgctxt "text_id=14674 | speaker=unknown"
msgid "　いまだ橙子の隠れ家を見つけてはいないものの、彼女たちには今日と明日が決着の日だと判っていた。"
msgstr ""

#. Occurrence A_2:170:14675: scene=A_2
#: A_2:170
msgctxt "text_id=14675 | speaker=unknown"
msgid "　祭りとは日常の中の非日常だ。"
msgstr ""

#. Occurrence A_2:175:14676: scene=A_2
#: A_2:175
msgctxt "text_id=14676 | speaker=unknown"
msgid "　終わり、蘇り、やり直しを象徴する特異点である。"
msgstr ""

#. Occurrence A_2:180:14677: scene=A_2
#: A_2:180
msgctxt "text_id=14677 | speaker=unknown"
msgid "　<聖誕祭|クリスマス>など百年程度の歴史しかなく、形骸的な記念日にすぎないとしても、営みの<環|わ>に組みこまれているのなら偽物も本物もない。"
msgstr ""

#. Occurrence A_2:185:14678: scene=A_2
#: A_2:185
msgctxt "text_id=14678 | speaker=unknown"
msgid "　祭りにおいて、土地の<魔|マ><力|ナ>の増大は<著|いちじる>しい。"
msgstr ""

#. Occurrence A_2:190:14679: scene=A_2
#: A_2:190
msgctxt "text_id=14679 | speaker=unknown"
msgid "　造るにしろ壊すにしろ、蓄えられてきた歪みは術者の魔術行使を助けるだろう。"
msgstr ""

#. Occurrence A_2:237:14680: scene=A_2
#: A_2:237
msgctxt "text_id=14680 | speaker=unknown"
msgid "　蒼崎橙子はこの土地に造られた支点……土地、人々からの魔力を集め、正しく循環させている……を壊そうとしている。"
msgstr ""

#. Occurrence A_2:243:14681: scene=A_2
#: A_2:243
msgctxt "text_id=14681 | speaker=unknown"
msgid "　草十郎もそれぐらいは青子たちの会話から聞き取っていた。"
msgstr ""

#. Occurrence A_2:248:14682: scene=A_2
#: A_2:248
msgctxt "text_id=14682 | speaker=unknown"
msgid "　五ヶ所にある支点のうち三つは既に破壊され、橙子の手に渡っている。"
msgstr ""

#. Occurrence A_2:294:14683: scene=A_2
#: A_2:294
msgctxt "text_id=14683 | speaker=unknown"
msgid "　残るは二ヶ所。"
msgstr ""

#. Occurrence A_2:299:14684: scene=A_2
#: A_2:299
msgctxt "text_id=14684 | speaker=unknown"
msgid "　これ以上の破壊は青子たちの敗北を意味する。"
msgstr ""

#. Occurrence A_2:304:14685: scene=A_2
#: A_2:304
msgctxt "text_id=14685 | speaker=unknown"
msgid "　青子と有珠は残った支点を守るため、別行動を取らざるをえない。"
msgstr ""

#. Occurrence A_2:309:14686: scene=A_2
#: A_2:309
msgctxt "text_id=14686 | speaker=unknown"
msgid "　力量的に劣る青子は、有珠の<使い魔|プロイ>を一体借り受け、最高の<魔力提供|バックアップ>を誇る陶川の支点に。"
msgstr ""

#. Occurrence A_2:314:14687: scene=A_2
#: A_2:314
msgctxt "text_id=14687 | speaker=unknown"
msgid "　有珠は万全の装備で<社木|やしろぎ>の支点へ。"
msgstr ""

#. Occurrence A_2:360:14688: scene=A_2
#: A_2:360
msgctxt "text_id=14688 | speaker=unknown"
msgid "　文明社会のくびきから逃れ、"
msgstr ""

#. Occurrence A_2:365:14689: scene=A_2
#: A_2:365
msgctxt "text_id=14689 | speaker=unknown"
msgid "　魔術が最大限の威力を発揮する深夜。"
msgstr ""

#. Occurrence A_2:371:14690: scene=A_2
#: A_2:371
msgctxt "text_id=14690 | speaker=unknown"
msgid "　幼い魔女と魔法使い見習いは、互いの健闘を祈って洋館を後にした。"
msgstr ""

#. Occurrence A_2:405:14691: scene=A_2
#: A_2:405
msgctxt "text_id=14691 | speaker=unknown"
msgid "　時刻はじき午後十時になろうとしている。"
msgstr ""

#. Occurrence A_2:410:14692: scene=A_2
#: A_2:410
msgctxt "text_id=14692 | speaker=unknown"
msgid "　彼女たちが出立してから、早い事に二時間は経っていた。"
msgstr ""

#. Occurrence A_2:461:14693: scene=A_2
#: A_2:461
msgctxt "text_id=14693 | speaker=unknown"
msgid "　青子が陶川の支点に向かう時、草十郎はロビーまで見送った。"
msgstr ""

#. Occurrence A_2:466:14694: scene=A_2
#: A_2:466
msgctxt "text_id=14694 | speaker=unknown"
msgid "　草十郎に話はなかったし、青子にだって話はなかった。"
msgstr ""

#. Occurrence A_2:471:14695: scene=A_2
#: A_2:471
msgctxt "text_id=14695 | speaker=unknown"
msgid "　<悲壮|ひそう>な空気もなく、青子は<颯爽|さっそう>と出ていった。"
msgstr ""

#. Occurrence A_2:476:14696: scene=A_2
#: A_2:476
msgctxt "text_id=14696 | speaker=unknown"
msgid "　宣言した通り、青子は草十郎を関わらせる気はないのか、それとも戦力と見ていないのか。"
msgstr ""

#. Occurrence A_2:489:14697: scene=A_2
#: A_2:489
msgctxt "text_id=14697 | speaker=unknown"
msgid "　どうしてか、それが少しだけ胸に残った。"
msgstr ""

#. Occurrence A_2:535:14698: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0000; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:535
msgctxt "text_id=14698 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence A_2:541:14699: scene=A_2
#: A_2:541
msgctxt "text_id=14699 | speaker=unknown"
msgid "　大きく息を吐く。"
msgstr ""

#. Occurrence A_2:546:14700: scene=A_2
#: A_2:546
msgctxt "text_id=14700 | speaker=unknown"
msgid "　<落胆|らくたん>でも<焦燥|しょうそう>でもない。"
msgstr ""

#. Occurrence A_2:551:14701: scene=A_2
#: A_2:551
msgctxt "text_id=14701 | speaker=unknown"
msgid "　機械的な、これといった<感|い><情|み>のない息継ぎだ。"
msgstr ""

#. Occurrence A_2:583:14702: scene=A_2
#: A_2:583
msgctxt "text_id=14702 | speaker=unknown"
msgid "　張りつくような冷たさの床に座りこんで、草十郎はぼんやりと天窓を見上げる。"
msgstr ""

#. Occurrence A_2:603:14703: scene=A_2
#: A_2:603
msgctxt "text_id=14703 | speaker=unknown"
msgid "　切り取られた空からは、雲間から覗く月の光。"
msgstr ""

#. Occurrence A_2:608:14704: scene=A_2
#: A_2:608
msgctxt "text_id=14704 | speaker=unknown"
msgid "　町に降り積もった雪は月光を照り返して、夜を真白に照らしているのだろう。"
msgstr ""

#. Occurrence A_2:613:14705: scene=A_2
#: A_2:613
msgctxt "text_id=14705 | speaker=unknown"
msgid "　その町中に、彼が立つ事はない。"
msgstr ""

#. Occurrence A_2:618:14706: scene=A_2
#: A_2:618
msgctxt "text_id=14706 | speaker=unknown"
msgid "　当然のように、初めから関わる事はない。"
msgstr ""

#. Occurrence A_2:638:14707: scene=A_2
#: A_2:638
msgctxt "text_id=14707 | speaker=unknown"
msgid "　彼女たちの世界と彼の世界は違っている。"
msgstr ""

#. Occurrence A_2:643:14708: scene=A_2
#: A_2:643
msgctxt "text_id=14708 | speaker=unknown"
msgid "　ついていく事はできないし、彼にその意志も意義も思いつかないのなら、あとは<傍観|ぼうかん>するだけだ。"
msgstr ""

#. Occurrence A_2:648:14709: scene=A_2
#: A_2:648
msgctxt "text_id=14709 | speaker=unknown"
msgid "　ただ、"
msgstr ""

#. Occurrence A_2:666:14710: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0001; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:666
msgctxt "text_id=14710 | speaker=soujuurou"
msgid "「―――そうか。"
msgstr ""

#. Occurrence A_2:673:14711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0002; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:673
msgctxt "text_id=14711 | speaker=soujuurou"
msgid "この手が必要な時は、もうないのか」"
msgstr ""

#. Occurrence A_2:678:14712: scene=A_2
#: A_2:678
msgctxt "text_id=14712 | speaker=unknown"
msgid "　独白して月を見上げる。"
msgstr ""

#. Occurrence A_2:731:14713: scene=A_2
#: A_2:731
msgctxt "text_id=14713 | speaker=unknown"
msgid "　だから、それが少しだけ、悲しかった。"
msgstr ""

#. Occurrence A_3:72:14714: scene=A_3
#: A_3:72
msgctxt "text_id=14714 | speaker=unknown"
msgid "　その公園は、人々の記憶から忘却されたかのように、白い闇に沈んでいた。"
msgstr ""

#. Occurrence A_3:77:14715: scene=A_3
#: A_3:77
msgctxt "text_id=14715 | speaker=unknown"
msgid "　人の気配は完全に絶えている。"
msgstr ""

#. Occurrence A_3:82:14716: scene=A_3
#: A_3:82
msgctxt "text_id=14716 | speaker=unknown"
msgid "　夜は普段より何倍も深く得体が知れないが、同時に、息を呑むほど清潔だ。"
msgstr ""

#. Occurrence A_3:88:14717: scene=A_3
#: A_3:88
msgctxt "text_id=14717 | speaker=unknown"
msgid "　雲間から届くかすかな月光だけで、世界のすべてを見渡せるほどに。"
msgstr ""

#. Occurrence A_3:121:14718: scene=A_3
#: A_3:121
msgctxt "text_id=14718 | speaker=unknown"
msgid "　そんな束の間の永遠に、少女の足音が響いていく。"
msgstr ""

#. Occurrence A_3:134:14719: scene=A_3
#: A_3:134
msgctxt "text_id=14719 | speaker=unknown"
msgid "　<無|む><垢|く>の<白野|ビャクヤ>に、<静寂|シジマ>を踏む靴がひとつ。"
msgstr ""

#. Occurrence A_3:139:14720: scene=A_3
#: A_3:139
msgctxt "text_id=14720 | speaker=unknown"
msgid "　夜空には蒼い闇夜と<薄墨|うすずみ>の月。"
msgstr ""

#. Occurrence A_3:144:14721: scene=A_3
#: A_3:144
msgctxt "text_id=14721 | speaker=unknown"
msgid "　少しばかりの街灯と、場違いな電話ボックスだけが、いまは文明の名残だった。"
msgstr ""

#. Occurrence A_3:187:14722: scene=A_3
#: A_3:187
msgctxt "text_id=14722 | speaker=unknown"
msgid "　現れたのは黒衣の少女。"
msgstr ""

#. Occurrence A_3:198:14723: scene=A_3
#: A_3:198
msgctxt "text_id=14723 | speaker=unknown"
msgid "　雪原で浮き彫りになる姿は、紛れもなく久遠寺有珠だ。"
msgstr ""

#. Occurrence A_3:203:14724: scene=A_3
#: A_3:203
msgctxt "text_id=14724 | speaker=unknown"
msgid "　<外套|がいとう>、帽子、手袋。"
msgstr ""

#. Occurrence A_3:208:14725: scene=A_3
#: A_3:208
msgctxt "text_id=14725 | speaker=unknown"
msgid "　その全てが黒く、瞳と髪すら、闇より深い<藍色|やみいろ>に染められている。"
msgstr ""

#. Occurrence A_3:228:14726: scene=A_3
#: A_3:228
msgctxt "text_id=14726 | speaker=unknown"
msgid "　変化は長く訪れなかった。"
msgstr ""

#. Occurrence A_3:233:14727: scene=A_3
#: A_3:233
msgctxt "text_id=14727 | speaker=unknown"
msgid "　有珠にも、その白い風景にも。"
msgstr ""

#. Occurrence A_3:238:14728: scene=A_3
#: A_3:238
msgctxt "text_id=14728 | speaker=unknown"
msgid "　雪原にたたずむ姿は一枚の絵画のように。"
msgstr ""

#. Occurrence A_3:243:14729: scene=A_3
#: A_3:243
msgctxt "text_id=14729 | speaker=unknown"
msgid "　時間だけが過ぎ、公園の周囲から、かろうじてあった家々の明かりが消えていく。"
msgstr ""

#. Occurrence A_3:289:14730: scene=A_3
#: A_3:289
msgctxt "text_id=14730 | speaker=unknown"
msgid "　ここ<社木|やしろぎ>は三咲町より近代化の進んだ街だ。"
msgstr ""

#. Occurrence A_3:296:14731: scene=A_3
#: A_3:296
msgctxt "text_id=14731 | speaker=unknown"
msgid "　公園はそんな街のただ中にありながら、街の死角になっていた。"
msgstr ""

#. Occurrence A_3:303:14732: scene=A_3
#: A_3:303
msgctxt "text_id=14732 | speaker=unknown"
msgid "　開発につまはじきにされた、利用価値のない土地。"
msgstr ""

#. Occurrence A_3:310:14733: scene=A_3
#: A_3:310
msgctxt "text_id=14733 | speaker=unknown"
msgid "　周囲に住宅は少なく、道を照らす街灯も、深夜になれば明かりを落とす。"
msgstr ""

#. Occurrence A_3:330:14734: scene=A_3
#: A_3:330
msgctxt "text_id=14734 | speaker=unknown"
msgid "　そんな、人々だけでなく機械すら眠りについた白い夜。"
msgstr ""

#. Occurrence A_3:356:14735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0000; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:356
msgctxt "text_id=14735 | speaker=alice"
msgid "『……わたしが、先なのね』"
msgstr ""

#. Occurrence A_3:367:14736: scene=A_3
#: A_3:367
msgctxt "text_id=14736 | speaker=unknown"
msgid "　消えていく灯を見つめながら、有珠は静かに呟いた。"
msgstr ""

#. Occurrence A_3:388:14737: scene=A_3
#: A_3:388
msgctxt "text_id=14737 | speaker=unknown"
msgid "　どこか遠くで、犬の遠吠えが聞こえた気がする。"
msgstr ""

#. Occurrence A_3:417:14738: scene=A_3
#: A_3:417
msgctxt "text_id=14738 | speaker=unknown"
msgid "　月にでも吠えたのだろうか。"
msgstr ""

#. Occurrence A_3:422:14739: scene=A_3
#: A_3:422
msgctxt "text_id=14739 | speaker=unknown"
msgid "　それは犬というより狼めいた強さで、長く長く、夜空に立ち上っていった。"
msgstr ""

#. Occurrence A_3:464:14740: scene=A_3
#: A_3:464
msgctxt "text_id=14740 | speaker=unknown"
msgid "　電話が鳴った。"
msgstr ""

#. Occurrence A_3:469:14741: scene=A_3
#: A_3:469
msgctxt "text_id=14741 | speaker=unknown"
msgid "　草十郎が洋館に住みだして、おそらく初めてになる電話の音は、深夜のホールに寒々しく響き渡った。"
msgstr ""

#. Occurrence A_3:501:14742: scene=A_3
#: A_3:501
msgctxt "text_id=14742 | speaker=unknown"
msgid "　草十郎はためらいがちに受話器をとる。"
msgstr ""

#. Occurrence A_3:506:14743: scene=A_3
#: A_3:506
msgctxt "text_id=14743 | speaker=unknown"
msgid "　受話器からの<音|こえ>はない。"
msgstr ""

#. Occurrence A_3:511:14744: scene=A_3
#: A_3:511
msgctxt "text_id=14744 | speaker=unknown"
msgid "　仕方なく何か言おうとして、ハタ、と草十郎は考えこんだ。"
msgstr ""

#. Occurrence A_3:516:14745: scene=A_3
#: A_3:516
msgctxt "text_id=14745 | speaker=unknown"
msgid "『もしもし、久遠寺ですが』と言えばいいのか、"
msgstr ""

#. Occurrence A_3:521:14746: scene=A_3
#: A_3:521
msgctxt "text_id=14746 | speaker=unknown"
msgid "　それとも『はい、蒼崎ですが』と言えばいいのか。"
msgstr ""

#. Occurrence A_3:526:14747: scene=A_3
#: A_3:526
msgctxt "text_id=14747 | speaker=unknown"
msgid "　そんな事を真剣に悩んでいると、受話器ごしに、消えそうなほど細い声が届けられた。"
msgstr ""

#. Occurrence A_3:559:14748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0001; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:559
msgctxt "text_id=14748 | speaker=alice"
msgid "「……静希……君？」"
msgstr ""

#. Occurrence A_3:565:14749: scene=A_3
#: A_3:565
msgctxt "text_id=14749 | speaker=unknown"
msgid "　かすれてはいるが、間違いなく久遠寺有珠の声だ。"
msgstr ""

#. Occurrence A_3:597:14750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_3_0000; voice_prefix=A30; voice_category=3; scene=A_3
#: A_3:597
msgctxt "text_id=14750 | speaker=soujuurou"
msgid "「そうだけど、有珠？」"
msgstr ""

#. Occurrence A_3:603:14751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0002; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:603
msgctxt "text_id=14751 | speaker=alice"
msgid "「………………………………………………」"
msgstr ""

#. Occurrence A_3:608:14752: scene=A_3
#: A_3:608
msgctxt "text_id=14752 | speaker=unknown"
msgid "　草十郎の声に、有珠は<応|こた>えない。"
msgstr ""

#. Occurrence A_3:613:14753: scene=A_3
#: A_3:613
msgctxt "text_id=14753 | speaker=unknown"
msgid "　……深い闇のような沈黙。"
msgstr ""

#. Occurrence A_3:618:14754: scene=A_3
#: A_3:618
msgctxt "text_id=14754 | speaker=unknown"
msgid "　ただ、受話器の向こうは騒がしく、雑踏めいたノイズに満ちている。"
msgstr ""

#. Occurrence A_3:624:14755: scene=A_3
#: A_3:624
msgctxt "text_id=14755 | speaker=unknown"
msgid "　長い沈黙の後、ようやく有珠は声を出した。"
msgstr ""

#. Occurrence A_3:645:14756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0003; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:645
msgctxt "text_id=14756 | speaker=alice"
msgid "「青子は、いる……？」"
msgstr ""

#. Occurrence A_3:662:14757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_3_0001; voice_prefix=A30; voice_category=3; scene=A_3
#: A_3:662
msgctxt "text_id=14757 | speaker=soujuurou"
msgid "「いや、まだ帰ってないけど」"
msgstr ""

#. Occurrence A_3:668:14758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0004; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:668
msgctxt "text_id=14758 | speaker=alice"
msgid "「―――そう」"
msgstr ""

#. Occurrence A_3:675:14759: scene=A_3
#: A_3:675
msgctxt "text_id=14759 | speaker=unknown"
msgid "　がしゃり、と電話は切れてしまった。"
msgstr ""

#. Occurrence A_3:680:14760: scene=A_3
#: A_3:680
msgctxt "text_id=14760 | speaker=unknown"
msgid "　何が言いたかったんだろう、と草十郎はひとり考えこんだが、答えはついにでなかった。"
msgstr ""

#. Occurrence A_4:75:14761: scene=A_4
#: A_4:75
msgctxt "text_id=14761 | speaker=unknown"
msgid "　降り積もった雪を汚すように、"
msgstr ""

msgctxt "text_id=14762 | speaker=unknown"
msgid "　<彼|・><ら|・>はゆっくりと、その包囲の輪を狭めていく。"
msgstr ""

#. Occurrence A_4:98:14763: scene=A_4
#: A_4:98
msgctxt "text_id=14763 | speaker=unknown"
msgid "　いつの間にこれほどの数が集まったのか。"
msgstr ""

#. Occurrence A_4:103:14764: scene=A_4
#: A_4:103
msgctxt "text_id=14764 | speaker=unknown"
msgid "　公園には何十匹もの野犬が<群|むら>がり、<荒|あら>い呼吸で有珠を凝視していた。"
msgstr ""

#. Occurrence A_4:124:14765: scene=A_4
#: A_4:124
msgctxt "text_id=14765 | speaker=unknown"
msgid "　野犬たちの体は寒さに凍えて、どれもみすぼらしい。"
msgstr ""

#. Occurrence A_4:129:14766: scene=A_4
#: A_4:129
msgctxt "text_id=14766 | speaker=unknown"
msgid "　反して、かちかちと鳴る牙と血走った眼は、今にも稲妻のように走りだしそうだ。"
msgstr ""

#. Occurrence A_4:134:14767: scene=A_4
#: A_4:134
msgctxt "text_id=14767 | speaker=unknown"
msgid "　その飢えた腹を満たすために、目前のか弱い少女の、あまりにも食欲をそそる温かな腹の肉へ。"
msgstr ""

#. Occurrence A_4:139:14768: scene=A_4
#: A_4:139
msgctxt "text_id=14768 | speaker=unknown"
msgid "　彼らにとって、黒衣の少女は暗い海に立つ<灯台|きぼう>にさえ見えている。"
msgstr ""

#. Occurrence A_4:206:14769: scene=A_4
#: A_4:206
msgctxt "text_id=14769 | speaker=unknown"
msgid "　そんな光景を、有珠は遠い目で眺めていた。"
msgstr ""

#. Occurrence A_4:211:14770: scene=A_4
#: A_4:211
msgctxt "text_id=14770 | speaker=unknown"
msgid "　青子が行った陶川ではなく、ここ社木が今夜の本命であるらしい。"
msgstr ""

#. Occurrence A_4:216:14771: scene=A_4
#: A_4:216
msgctxt "text_id=14771 | speaker=unknown"
msgid "　それに動じるような心構えは初めからしていないし、この程度の脅しでは予想外どころか子供<騙|だま>しにもならない。"
msgstr ""

#. Occurrence A_4:221:14772: scene=A_4
#: A_4:221
msgctxt "text_id=14772 | speaker=unknown"
msgid "　有珠が見すえるべき敵は包囲する野犬ではなく、その後方の闇に<控|ひか>える魔術師―――蒼崎橙子に他ならないのだから。"
msgstr ""

#. Occurrence A_4:265:14773: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0000; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:265
msgctxt "text_id=14773 | speaker=alice"
msgid "「酷い趣味。ここ数年で品が落ちたの？"
msgstr ""

#. Occurrence A_4:272:14774: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0001; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:272
msgctxt "text_id=14774 | speaker=alice"
msgid "　……まあ、それならそれで嬉しいけど。コレが<地金|じがね>なら、蒼崎との付き合いもいよいよ白紙に戻せるわ」"
msgstr ""

#. Occurrence A_4:277:14775: scene=A_4
#: A_4:277
msgctxt "text_id=14775 | speaker=unknown"
msgid "　<辛辣|しんらつ>な言葉に、くぐもった笑いが応える。"
msgstr ""

#. Occurrence A_4:283:14776: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0000; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:283
msgctxt "text_id=14776 | speaker=touko"
msgid "「いやいや、コレは不可抗力でね。"
msgstr ""

#. Occurrence A_4:290:14777: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0001; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:290
msgctxt "text_id=14777 | speaker=touko"
msgid "　安心しろ有珠、間違っても私の趣味じゃあない」"
msgstr ""

#. Occurrence A_4:322:14778: scene=A_4
#: A_4:322
msgctxt "text_id=14778 | speaker=unknown"
msgid "　ざくり、と積もった雪を踏みしめて、彼女はゆっくりと現れた。"
msgstr ""

#. Occurrence A_4:341:14779: scene=A_4
#: A_4:341
msgctxt "text_id=14779 | speaker=unknown"
msgid "　有珠とは対照的なモスグリーンのコート。"
msgstr ""

#. Occurrence A_4:346:14780: scene=A_4
#: A_4:346
msgctxt "text_id=14780 | speaker=unknown"
msgid "　首もとを結ぶ<絹|シルク>のスカーフ。"
msgstr ""

#. Occurrence A_4:351:14781: scene=A_4
#: A_4:351
msgctxt "text_id=14781 | speaker=unknown"
msgid "　長身と短い髪、そして<凛|りん>とした背筋が、男性より遥かに彼女を<雄|おす>らしく見せている。"
msgstr ""

#. Occurrence A_4:371:14782: scene=A_4
#: A_4:371
msgctxt "text_id=14782 | speaker=unknown"
msgid "　―――そう。"
msgstr ""

#. Occurrence A_4:413:14783: scene=A_4
#: A_4:413
msgctxt "text_id=14783 | speaker=unknown"
msgid "　この雪原に立つ者は、白い夜気より深い闇を纏っていなくてはならない。"
msgstr ""

#. Occurrence A_4:449:14784: scene=A_4
#: A_4:449
msgctxt "text_id=14784 | speaker=unknown"
msgid "　有珠がそうであるように、その敵である橙子もまた。"
msgstr ""

#. Occurrence A_4:470:14785: scene=A_4
#: A_4:470
msgctxt "text_id=14785 | speaker=unknown"
msgid "　野犬たちの呼吸が弱まる。"
msgstr ""

#. Occurrence A_4:475:14786: scene=A_4
#: A_4:475
msgctxt "text_id=14786 | speaker=unknown"
msgid "　<端役|はやく>にすぎない彼らは、登場した主役の威光から目を逸らす。"
msgstr ""

#. Occurrence A_4:482:14787: scene=A_4
#: A_4:482
msgctxt "text_id=14787 | speaker=unknown"
msgid "　そうしなければ、眼球ばかりか心臓まで<潰|つぶ>されるからだ。"
msgstr ""

#. Occurrence A_4:521:14788: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0002; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:521
msgctxt "text_id=14788 | speaker=touko"
msgid "「久しぶりだね、有珠」"
msgstr ""

#. Occurrence A_4:527:14789: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0002; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:527
msgctxt "text_id=14789 | speaker=alice"
msgid "「橙子さんも、お元気そうで」"
msgstr ""

#. Occurrence A_4:546:14790: scene=A_4
#: A_4:546
msgctxt "text_id=14790 | speaker=unknown"
msgid "　六メートルほどの距離を隔てた挨拶。"
msgstr ""

#. Occurrence A_4:551:14791: scene=A_4
#: A_4:551
msgctxt "text_id=14791 | speaker=unknown"
msgid "　親愛の情はない。"
msgstr ""

#. Occurrence A_4:556:14792: scene=A_4
#: A_4:556
msgctxt "text_id=14792 | speaker=unknown"
msgid "　あるのは倒す者と倒される者、その区分だけである。"
msgstr ""

#. Occurrence A_4:577:14793: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0003; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:577
msgctxt "text_id=14793 | speaker=touko"
msgid "「さて。どうしようか有珠？"
msgstr ""

#. Occurrence A_4:603:14794: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0004; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:603
msgctxt "text_id=14794 | speaker=touko"
msgid "　積もる話もある。君の近況にも興味がある。そもそも今回の件について、色々と説明したくてたまらない。"
msgstr ""

#. Occurrence A_4:617:14795: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0005; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:617
msgctxt "text_id=14795 | speaker=touko"
msgid "　五分ほど時間を割いても構わないか？」"
msgstr ""

#. Occurrence A_4:630:14796: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0003; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:630
msgctxt "text_id=14796 | speaker=alice"
msgid "「お断りよ。貴女と五分も話をしていたら、その隙に内臓まで売却されそう」"
msgstr ""

#. Occurrence A_4:678:14797: scene=A_4
#: A_4:678
msgctxt "text_id=14797 | speaker=unknown"
msgid "　それは一瞬の出来事。"
msgstr ""

#. Occurrence A_4:693:14798: scene=A_4
#: A_4:693
msgctxt "text_id=14798 | speaker=unknown"
msgid "　あまりにも自然に、目を奪うほど大胆に、"
msgstr ""

#. Occurrence A_4:698:14799: scene=A_4
#: A_4:698
msgctxt "text_id=14799 | speaker=unknown"
msgid "　有珠は猫の鈴をケープの裾から取り出した。"
msgstr ""

#. Occurrence A_4:729:14800: scene=A_4
#: A_4:729
msgctxt "text_id=14800 | speaker=unknown"
msgid "　落下する鐘をディドルディドル。"
msgstr ""

#. Occurrence A_4:734:14801: scene=A_4
#: A_4:734
msgctxt "text_id=14801 | speaker=unknown"
msgid "　童話の夜を助長する、久遠寺有珠の魔術の始まりである。"
msgstr ""

#. Occurrence A_4:754:14802: scene=A_4
#: A_4:754
msgctxt "text_id=14802 | speaker=unknown"
msgid "　青子の魔術行使が西部劇の<早撃ち|クイックドロウ>なら、"
msgstr ""

#. Occurrence A_4:759:14803: scene=A_4
#: A_4:759
msgctxt "text_id=14803 | speaker=unknown"
msgid "　有珠の魔術行使は手品師の<指芸|カット>のようだ。"
msgstr ""

#. Occurrence A_4:764:14804: scene=A_4
#: A_4:764
msgctxt "text_id=14804 | speaker=unknown"
msgid "　見る者の意識の隙をついて、鮮やかに大胆に、何より気づかれる事なく、目的を終えている。"
msgstr ""

#. Occurrence A_4:769:14805: scene=A_4
#: A_4:769
msgctxt "text_id=14805 | speaker=unknown"
msgid "　鈴は泉に没する<金貨|コイン>のように落下し、そして―――"
msgstr ""

#. Occurrence A_4:817:14806: scene=A_4
#: A_4:817
msgctxt "text_id=14806 | speaker=unknown"
msgid "　跡形もなく、地中に沈む前に砕け散った。"
msgstr ""

#. Occurrence A_4:858:14807: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0004; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:858
msgctxt "text_id=14807 | speaker=alice"
msgid "「ルーン―――」"
msgstr ""

#. Occurrence A_4:867:14808: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0006; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:867
msgctxt "text_id=14808 | speaker=touko"
msgid "「ああ。一日かけて公園中に<刻|きざ>ませてもらった。"
msgstr ""

#. Occurrence A_4:873:14809: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0007; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:873
msgctxt "text_id=14809 | speaker=touko"
msgid "　この公園の道はレンガだからね。手間こそかかったが簡単な仕事だった。"
msgstr ""

#. Occurrence A_4:889:14810: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0008; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:889
msgctxt "text_id=14810 | speaker=touko"
msgid "　まわりの森まで見て、ざっと四百<平米|ヘーベー>のキャンバスだ。"
msgstr ""

#. Occurrence A_4:895:14811: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0009; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:895
msgctxt "text_id=14811 | speaker=touko"
msgid "　面白いだろう？"
msgstr ""

#. Occurrence A_4:901:14812: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0010; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:901
msgctxt "text_id=14812 | speaker=touko"
msgid "　いま私たちは、三十万字以上の<太陽|ルーン>の上にいる」"
msgstr ""

#. Occurrence A_4:998:14813: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0005; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:998
msgctxt "text_id=14813 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence A_4:1003:14814: scene=A_4
#: A_4:1003
msgctxt "text_id=14814 | speaker=unknown"
msgid "　息を呑みながら一歩だけ後じさる有珠。"
msgstr ""

#. Occurrence A_4:1008:14815: scene=A_4
#: A_4:1008
msgctxt "text_id=14815 | speaker=unknown"
msgid "　地表すべてにルーンを刻んでいる？"
msgstr ""

#. Occurrence A_4:1013:14816: scene=A_4
#: A_4:1013
msgctxt "text_id=14816 | speaker=unknown"
msgid "　いま一瞬だけディドルに反応した箇所だけでも気が滅入る数のルーンを、公園すべてに？"
msgstr ""

#. Occurrence A_4:1018:14817: scene=A_4
#: A_4:1018
msgctxt "text_id=14817 | speaker=unknown"
msgid "　驚きより、強い疑問に有珠は目を細めた。"
msgstr ""

#. Occurrence A_4:1064:14818: scene=A_4
#: A_4:1064
msgctxt "text_id=14818 | speaker=unknown"
msgid "　たしかに、それは完全な“日中”だ。"
msgstr ""

#. Occurrence A_4:1069:14819: scene=A_4
#: A_4:1069
msgctxt "text_id=14819 | speaker=unknown"
msgid "　夜を呼ぶディドルディドルは、この太陽の膜に破壊されて当然だろう。"
msgstr ""

#. Occurrence A_4:1074:14820: scene=A_4
#: A_4:1074
msgctxt "text_id=14820 | speaker=unknown"
msgid "　だが―――"
msgstr ""

#. Occurrence A_4:1095:14821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0006; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1095
msgctxt "text_id=14821 | speaker=alice"
msgid "「……一体、どうやって隠していたの？」"
msgstr ""

#. Occurrence A_4:1101:14822: scene=A_4
#: A_4:1101
msgctxt "text_id=14822 | speaker=unknown"
msgid "　それだけのルーン文字。"
msgstr ""

#. Occurrence A_4:1106:14823: scene=A_4
#: A_4:1106
msgctxt "text_id=14823 | speaker=unknown"
msgid "　それだけの魔術行使の痕跡を、どうやって隠し通したのか。"
msgstr ""

#. Occurrence A_4:1146:14824: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0011; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1146
msgctxt "text_id=14824 | speaker=touko"
msgid "「ああ、ちょっと特別製。"
msgstr ""

#. Occurrence A_4:1153:14825: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0012; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1153
msgctxt "text_id=14825 | speaker=touko"
msgid "このルーンね、普段は確定していないんだ。こうしている今も変形している。パッと見はただの<疵痕|きずあと>。それが強い魔力に触れると、もとのカタチに立ち戻る。形状記憶ルーンとでも言おうかな。"
msgstr ""

#. Occurrence A_4:1164:14826: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0013; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1164
msgctxt "text_id=14826 | speaker=touko"
msgid "　そんな訳で、いかなる夜の深さをもってしても、この太陽は没しない。この通り、雪が降ってくれたおかげで視覚的な誤魔化しも万全だったしね」"
msgstr ""

#. Occurrence A_4:1186:14827: scene=A_4
#: A_4:1186
msgctxt "text_id=14827 | speaker=unknown"
msgid "　さらりと言ってのけるが、それがどれほどの執念、技術、才能を必要とするものか、有珠ですら正確に判断できない。"
msgstr ""

#. Occurrence A_4:1208:14828: scene=A_4
#: A_4:1208
msgctxt "text_id=14828 | speaker=unknown"
msgid "　一日作業だと言うなら、熟練したルーン使いが十人がかりでも可能かどうか。"
msgstr ""

#. Occurrence A_4:1213:14829: scene=A_4
#: A_4:1213
msgctxt "text_id=14829 | speaker=unknown"
msgid "　加えて、使われているルーンは協会に特許も出されていない未知の技術だ。"
msgstr ""

#. Occurrence A_4:1239:14830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0007; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1239
msgctxt "text_id=14830 | speaker=alice"
msgid "「……負け惜しみだけど。"
msgstr ""

#. Occurrence A_4:1245:14831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0008; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1245
msgctxt "text_id=14831 | speaker=alice"
msgid "　わたしみたいな小娘ひとりに大人げないわね、橙子さん」"
msgstr ""

#. Occurrence A_4:1251:14832: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0014; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1251
msgctxt "text_id=14832 | speaker=touko"
msgid "「馬鹿を言うな。君を小娘だなんて、一度も思った事はないよ。"
msgstr ""

#. Occurrence A_4:1277:14833: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0015; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1277
msgctxt "text_id=14833 | speaker=touko"
msgid "　まあ―――私<好|ごの>みの体だと、<睨|ね>め付ける事はあったがね」"
msgstr ""

#. Occurrence A_4:1441:14834: scene=A_4
#: A_4:1441
msgctxt "text_id=14834 | speaker=unknown"
msgid "　変化は一瞬だった。"
msgstr ""

#. Occurrence A_4:1446:14835: scene=A_4
#: A_4:1446
msgctxt "text_id=14835 | speaker=unknown"
msgid "　橙子の<戯言|たわごと>を、有珠は視線だけで斬って捨てた。"
msgstr ""

#. Occurrence A_4:1466:14836: scene=A_4
#: A_4:1466
msgctxt "text_id=14836 | speaker=unknown"
msgid "　深い闇色をした少女の左目は、禍々しい<紅玉|ルビー>の色に変わっている。"
msgstr ""

#. Occurrence A_4:1486:14837: scene=A_4
#: A_4:1486
msgctxt "text_id=14837 | speaker=unknown"
msgid "　最速の<一工程|シングルアクション>、視線による術式投射。"
msgstr ""

#. Occurrence A_4:1491:14838: scene=A_4
#: A_4:1491
msgctxt "text_id=14838 | speaker=unknown"
msgid "　魔眼と呼ばれる“魅了の視線”が、蒼崎橙子の姿を眼球に捕らえている。"
msgstr ""

#. Occurrence A_4:1496:14839: scene=A_4
#: A_4:1496
msgctxt "text_id=14839 | speaker=unknown"
msgid "　睨め付けていた、と語った女は、今や文字通り、少女の目によって<縫|・><い|・><付|・><け|・>られていた。"
msgstr ""

#. Occurrence A_4:1535:14840: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0016; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1535
msgctxt "text_id=14840 | speaker=touko"
msgid "「―――――――――」"
msgstr ""

#. Occurrence A_4:1540:14841: scene=A_4
#: A_4:1540
msgctxt "text_id=14841 | speaker=unknown"
msgid "　橙子は腕をあげようとしたが、体は指一本動かない。"
msgstr ""

#. Occurrence A_4:1545:14842: scene=A_4
#: A_4:1545
msgctxt "text_id=14842 | speaker=unknown"
msgid "　<抵抗|レジスト>する間もない、問答無用の有珠の魔眼だった。"
msgstr ""

#. Occurrence A_4:1550:14843: scene=A_4
#: A_4:1550
msgctxt "text_id=14843 | speaker=unknown"
msgid "　自由が許されているのは<内臓|なかみ>ぐらい。"
msgstr ""

#. Occurrence A_4:1555:14844: scene=A_4
#: A_4:1555
msgctxt "text_id=14844 | speaker=unknown"
msgid "　<内臓|なかみ>は問題なく機能している以上、<運|・><動|・>ではなく<行|・><動|・>を禁じる<魅了|まがん>であるらしい。"
msgstr ""

#. Occurrence A_4:1600:14845: scene=A_4
#: A_4:1600
msgctxt "text_id=14845 | speaker=unknown"
msgid "　……に、しても惚れ惚れするタイミングだった。"
msgstr ""

#. Occurrence A_4:1605:14846: scene=A_4
#: A_4:1605
msgctxt "text_id=14846 | speaker=unknown"
msgid "　魔眼の速度ではない。"
msgstr ""

#. Occurrence A_4:1610:14847: scene=A_4
#: A_4:1610
msgctxt "text_id=14847 | speaker=unknown"
msgid "　こちらの呼吸、次の手に入る前の<間隙|かんげき>をつく術の<巧|うま>さは、青子などとは地金が違う。"
msgstr ""

#. Occurrence A_4:1636:14848: scene=A_4
#: A_4:1636
msgctxt "text_id=14848 | speaker=unknown"
msgid "　現代に隠れ住む魔女は、蒼崎橙子以上に、魔術戦のなんたるかを熟知していた。"
msgstr ""

#. Occurrence A_4:1672:14849: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0017; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1672
msgctxt "text_id=14849 | speaker=touko"
msgid "「―――だが残念。ディドルディドルが響かないのでは、魔眼のアクロスティック化はできないようだな。"
msgstr ""

#. Occurrence A_4:1691:14850: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0018; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1691
msgctxt "text_id=14850 | speaker=touko"
msgid "　惜しいね。あの月目のプロイキッシャーなら、これで<私|・>の方はお手上げだったろうが―――」"
msgstr ""

#. Occurrence A_4:1729:14851: scene=A_4
#: A_4:1729
msgctxt "text_id=14851 | speaker=unknown"
msgid "　橙子を拘束する陣形が歪んでいく。"
msgstr ""

#. Occurrence A_4:1734:14852: scene=A_4
#: A_4:1734
msgctxt "text_id=14852 | speaker=unknown"
msgid "　手足はおろか指一本動かせない筈の魔術師は、"
msgstr ""

#. Occurrence A_4:1775:14853: scene=A_4
#: A_4:1775
msgctxt "text_id=14853 | speaker=unknown"
msgid "　瞬きだけで、有珠の魔眼を克服した。"
msgstr ""

#. Occurrence A_4:1857:14854: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0009; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1857
msgctxt "text_id=14854 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence A_4:1862:14855: scene=A_4
#: A_4:1862
msgctxt "text_id=14855 | speaker=unknown"
msgid "　黒衣が流れる。"
msgstr ""

#. Occurrence A_4:1867:14856: scene=A_4
#: A_4:1867
msgctxt "text_id=14856 | speaker=unknown"
msgid "　今の<克服|リカバー>が橙子の<魔|・><眼|・>によるものと看破し、有珠は相手の視界―――その正面に立たないように身を<翻|ひるがえ>す。"
msgstr ""

#. Occurrence A_4:1904:14857: scene=A_4
#: A_4:1904
msgctxt "text_id=14857 | speaker=unknown"
msgid "　魔眼と言えど、その根底にあるのは暗示だ。"
msgstr ""

#. Occurrence A_4:1909:14858: scene=A_4
#: A_4:1909
msgctxt "text_id=14858 | speaker=unknown"
msgid "　正面からの、相手の不意をつく<意識|マインド><制圧|ジャック>がもっとも効果的であり、<抵抗|レジスト>されにくい。"
msgstr ""

#. Occurrence A_4:1914:14859: scene=A_4
#: A_4:1914
msgctxt "text_id=14859 | speaker=unknown"
msgid "　逆に言えば、たとえ魔眼の範囲に入っていようと、正面にさえいなければ効果は半減する。"
msgstr ""

#. Occurrence A_4:1919:14860: scene=A_4
#: A_4:1919
msgctxt "text_id=14860 | speaker=unknown"
msgid "　ましてや、少女は数多の童話を従える最後の魔女。"
msgstr ""

#. Occurrence A_4:1924:14861: scene=A_4
#: A_4:1924
msgctxt "text_id=14861 | speaker=unknown"
msgid "　投写型の魔眼が相手なら、半身<逸|そ>らすだけであらゆる魔力をはじき返せる……！"
msgstr ""

#. Occurrence A_4:2006:14862: scene=A_4
#: A_4:2006
msgctxt "text_id=14862 | speaker=unknown"
msgid "　橙子の魔眼も有珠と同様、行動を封じる魅了だった。"
msgstr ""

#. Occurrence A_4:2011:14863: scene=A_4
#: A_4:2011
msgctxt "text_id=14863 | speaker=unknown"
msgid "　有珠は間一髪、正面からの視線を逸らした。"
msgstr ""

#. Occurrence A_4:2016:14864: scene=A_4
#: A_4:2016
msgctxt "text_id=14864 | speaker=unknown"
msgid "　この程度の<戒|いまし>め、少女にとっては森の小枝ほどの重みもない。"
msgstr ""

#. Occurrence A_4:2021:14865: scene=A_4
#: A_4:2021
msgctxt "text_id=14865 | speaker=unknown"
msgid "　指で払いのけるまでもなく、ただ通過するのみ―――"
msgstr ""

#. Occurrence A_4:2136:14866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0010; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2136
msgctxt "text_id=14866 | speaker=alice"
msgid "「っ―――!?」"
msgstr ""

#. Occurrence A_4:2141:14867: scene=A_4
#: A_4:2141
msgctxt "text_id=14867 | speaker=unknown"
msgid "　瞬間、有珠は信じがたい寒気に襲われた。"
msgstr ""

#. Occurrence A_4:2209:14868: scene=A_4
#: A_4:2209
msgctxt "text_id=14868 | speaker=unknown"
msgid "　これは、<詰|・><ん|・><だ|・>。"
msgstr ""

#. Occurrence A_4:2237:14869: scene=A_4
#: A_4:2237
msgctxt "text_id=14869 | speaker=unknown"
msgid "　死の感触が背中を走る。"
msgstr ""

#. Occurrence A_4:2245:14870: scene=A_4
#: A_4:2245
msgctxt "text_id=14870 | speaker=unknown"
msgid "　外套の下から青いゴムマリを逃がしながら、有珠は敵魔術師を凝視する。"
msgstr ""

#. Occurrence A_4:2289:14871: scene=A_4
#: A_4:2289
msgctxt "text_id=14871 | speaker=unknown"
msgid "　衝突する視線。"
msgstr ""

#. Occurrence A_4:2294:14872: scene=A_4
#: A_4:2294
msgctxt "text_id=14872 | speaker=unknown"
msgid "　魔眼を魔眼で押し返そうと、有珠は橙子を睨む。"
msgstr ""

#. Occurrence A_4:2314:14873: scene=A_4
#: A_4:2314
msgctxt "text_id=14873 | speaker=unknown"
msgid "　―――負ける筈がない。"
msgstr ""

#. Occurrence A_4:2332:14874: scene=A_4
#: A_4:2332
msgctxt "text_id=14874 | speaker=unknown"
msgid "　純粋な魔力量でも、魔眼の質でも、久遠寺有珠は蒼崎橙子の上にいる。"
msgstr ""

#. Occurrence A_4:2486:14875: scene=A_4
#: A_4:2486
msgctxt "text_id=14875 | speaker=unknown"
msgid "　当然の帰結として、敵の<戒|いまし>めは有珠の前で霧散した。"
msgstr ""

#. Occurrence A_4:2504:14876: scene=A_4
#: A_4:2504
msgctxt "text_id=14876 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence A_4:2509:14877: scene=A_4
#: A_4:2509
msgctxt "text_id=14877 | speaker=unknown"
msgid "　血統だの魔力量だの、そんな時代遅れの価値観は、橙子の狂気の前に砕け散った。"
msgstr ""

#. Occurrence A_4:2562:14878: scene=A_4
#: A_4:2562
msgctxt "text_id=14878 | speaker=unknown"
msgid "　目蓋ではなくその中身―――"
msgstr ""

msgctxt "text_id=14879 | speaker=unknown"
msgid "　開く<機|コ><能|ト>のない<眼球|まがん>が開く。"
msgstr ""

#. Occurrence A_4:2742:14880: scene=A_4
#: A_4:2742
msgctxt "text_id=14880 | speaker=unknown"
msgid "　魔術師の左眼―――その水晶体の中に、<底なしの穴|クラインキューブ>がうがたれていく。"
msgstr ""

#. Occurrence A_4:2813:14881: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0011; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2813
msgctxt "text_id=14881 | speaker=alice"
msgid "「、っ…………！」"
msgstr ""

#. Occurrence A_4:2818:14882: scene=A_4
#: A_4:2818
msgctxt "text_id=14882 | speaker=unknown"
msgid "　苦痛に歪む吐息。"
msgstr ""

#. Occurrence A_4:2823:14883: scene=A_4
#: A_4:2823
msgctxt "text_id=14883 | speaker=unknown"
msgid "　もはや拘束は一つではない。"
msgstr ""

#. Occurrence A_4:2870:14884: scene=A_4
#: A_4:2870
msgctxt "text_id=14884 | speaker=unknown"
msgid "　<夥|おびただ>しいまでの魔眼―――千を超える橙子の魔眼、その視線がすべて有珠に向けられている……！"
msgstr ""

#. Occurrence A_4:2922:14885: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0012; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2922
msgctxt "text_id=14885 | speaker=alice"
msgid "「っ、っ……！」"
msgstr ""

#. Occurrence A_4:2927:14886: scene=A_4
#: A_4:2927
msgctxt "text_id=14886 | speaker=unknown"
msgid "　視線の重圧はいまも増え続けている。"
msgstr ""

#. Occurrence A_4:2932:14887: scene=A_4
#: A_4:2932
msgctxt "text_id=14887 | speaker=unknown"
msgid "　そこに果てがない事を、有珠は認めた。"
msgstr ""

#. Occurrence A_4:2938:14888: scene=A_4
#: A_4:2938
msgctxt "text_id=14888 | speaker=unknown"
msgid "　アレは―――"
msgstr ""

msgctxt "text_id=14889 | speaker=unknown"
msgid "　信じがたい事に、魔眼の中に魔眼を造っている。"
msgstr ""

#. Occurrence A_4:2945:14890: scene=A_4
#: A_4:2945
msgctxt "text_id=14890 | speaker=unknown"
msgid "　橙子は自らの魔眼の内部を合わせ鏡にする事で、その<視線|こうか>を無限にしたのだ。"
msgstr ""

#. Occurrence A_4:2997:14891: scene=A_4
#: A_4:2997
msgctxt "text_id=14891 | speaker=unknown"
msgid "　魔眼の中に魔眼を造るだけでも狂気の沙汰。"
msgstr ""

#. Occurrence A_4:3002:14892: scene=A_4
#: A_4:3002
msgctxt "text_id=14892 | speaker=unknown"
msgid "　それを反射させ、次々とコピーされていく魔力を制御し、カオス化した魔力を暴走させる事なく機能させる―――"
msgstr ""

#. Occurrence A_4:3008:14893: scene=A_4
#: A_4:3008
msgctxt "text_id=14893 | speaker=unknown"
msgid "狂気なんて罵倒では飽き足らない。"
msgstr ""

#. Occurrence A_4:3045:14894: scene=A_4
#: A_4:3045
msgctxt "text_id=14894 | speaker=unknown"
msgid "　魔術を―――人間に残された最後の逃げ道である神秘を、あんな、分別なく<大量生産|マスプロダクション>してしまうのなら、あの女は魔術師と名乗るのもおこがましい―――！"
msgstr ""

#. Occurrence A_4:3093:14895: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0019; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3093
msgctxt "text_id=14895 | speaker=touko"
msgid "「……やれやれ、これもお気に召さないか。私なりにマインスターの真似事をしてみたつもりなんだが。"
msgstr ""

#. Occurrence A_4:3114:14896: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0020; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3114
msgctxt "text_id=14896 | speaker=touko"
msgid "　<巧|うま>く出来ているだろう？"
msgstr ""

#. Occurrence A_4:3120:14897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0021; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3120
msgctxt "text_id=14897 | speaker=touko"
msgid "　君のアクロのように稀少な神秘で現実をねじ曲げるのではなく、量産した神秘で現実をねじ伏せる。"
msgstr ""

#. Occurrence A_4:3135:14898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0022; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3135
msgctxt "text_id=14898 | speaker=touko"
msgid "　もの自体はただの魔眼。だがその弾数には果てがない。"
msgstr ""

#. Occurrence A_4:3142:14899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0023; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3142
msgctxt "text_id=14899 | speaker=touko"
msgid "相手がどれほどの魔力抵抗を持っていようと、それ以上の魔力で拘束する<だ|・><け|・>のモノだ」"
msgstr ""

#. Occurrence A_4:3180:14900: scene=A_4
#: A_4:3180
msgctxt "text_id=14900 | speaker=unknown"
msgid "　果てのない魔力で相手の動きを封じこめる。"
msgstr ""

#. Occurrence A_4:3185:14901: scene=A_4
#: A_4:3185
msgctxt "text_id=14901 | speaker=unknown"
msgid "　つまり、あの魔眼に囚われたが最後、無限という概念に縛られてしまうのだ。"
msgstr ""

#. Occurrence A_4:3255:14902: scene=A_4
#: A_4:3255
msgctxt "text_id=14902 | speaker=unknown"
msgid "　投写型の魔眼の欠点―――所詮は短銃であり、大砲である詠唱術式には火力・術式で敵わないという定説を、橙子は力ずくで破壊した。"
msgstr ""

#. Occurrence A_4:3283:14903: scene=A_4
#: A_4:3283
msgctxt "text_id=14903 | speaker=unknown"
msgid "　小銃が弱いのなら、数を用意する。"
msgstr ""

#. Occurrence A_4:3329:14904: scene=A_4
#: A_4:3329
msgctxt "text_id=14904 | speaker=unknown"
msgid "　９ミリの弾丸では要塞を壊せないのなら、壊せるだけの数を叩きつけてご覧にいれよう―――"
msgstr ""

#. Occurrence A_4:3334:14905: scene=A_4
#: A_4:3334
msgctxt "text_id=14905 | speaker=unknown"
msgid "　あの<積重|せきじゅう>魔眼はそれだけの原理だが、概念が力を持つ魔術世界においては完璧な兵器だった。"
msgstr ""

#. Occurrence A_4:3354:14906: scene=A_4
#: A_4:3354
msgctxt "text_id=14906 | speaker=unknown"
msgid "　アレに囚われた者は、橙子が眼を閉じるまで動けない。"
msgstr ""

#. Occurrence A_4:3359:14907: scene=A_4
#: A_4:3359
msgctxt "text_id=14907 | speaker=unknown"
msgid "　机上の空論とはいえ、理屈の上では「無限」である。"
msgstr ""

#. Occurrence A_4:3364:14908: scene=A_4
#: A_4:3364
msgctxt "text_id=14908 | speaker=unknown"
msgid "　魔力量では決して上回れない以上、魔力で抵抗する事は無意味なのだ。"
msgstr ""

#. Occurrence A_4:3416:14909: scene=A_4
#: A_4:3416
msgctxt "text_id=14909 | speaker=unknown"
msgid "　破る手段があるとしたら、まずは一つ、はじめから橙子の視界に入らないこと。"
msgstr ""

#. Occurrence A_4:3422:14910: scene=A_4
#: A_4:3422
msgctxt "text_id=14910 | speaker=unknown"
msgid "相手に気付かれる前に倒す、という対魔眼戦の基本にして最善手。"
msgstr ""

#. Occurrence A_4:3439:14911: scene=A_4
#: A_4:3439
msgctxt "text_id=14911 | speaker=unknown"
msgid "　そしてもう一つ。"
msgstr ""

#. Occurrence A_4:3444:14912: scene=A_4
#: A_4:3444
msgctxt "text_id=14912 | speaker=unknown"
msgid "　実に、単純かつ粗暴な話ではあるが―――"
msgstr ""

#. Occurrence A_4:3477:14913: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0024; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3477
msgctxt "text_id=14913 | speaker=touko"
msgid "「ともあれこれで詰みだ。何か言い残す事は？」"
msgstr ""

#. Occurrence A_4:3509:14914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0013; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3509
msgctxt "text_id=14914 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence A_4:3514:14915: scene=A_4
#: A_4:3514
msgctxt "text_id=14915 | speaker=unknown"
msgid "　もう有珠には敵の姿も見えない。"
msgstr ""

#. Occurrence A_4:3519:14916: scene=A_4
#: A_4:3519
msgctxt "text_id=14916 | speaker=unknown"
msgid "　魔眼の呪縛が視界を<覆|おお>い尽くしている。"
msgstr ""

#. Occurrence A_4:3577:14917: scene=A_4
#: A_4:3577
msgctxt "text_id=14917 | speaker=unknown"
msgid "　かろうじて見えるのは空の月だけ。"
msgstr ""

#. Occurrence A_4:3582:14918: scene=A_4
#: A_4:3582
msgctxt "text_id=14918 | speaker=unknown"
msgid "　それと、<階|きざはし>のような青い軌跡。"
msgstr ""

#. Occurrence A_4:3636:14919: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0025; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3636
msgctxt "text_id=14919 | speaker=touko"
msgid "「結構。悔いのない人生で羨ましい」"
msgstr ""

#. Occurrence A_4:3683:14920: scene=A_4
#: A_4:3683
msgctxt "text_id=14920 | speaker=unknown"
msgid "　大気中に描かれた<呪刻|ルーン>から、肌を裂く衝撃が<弾|はじ>かれる。"
msgstr ""

#. Occurrence A_4:3688:14921: scene=A_4
#: A_4:3688
msgctxt "text_id=14921 | speaker=unknown"
msgid "　風は鋭利な刃物と化して、少女の外套と、その体を八つ裂きにし―――"
msgstr ""

#. Occurrence A_4:3819:14922: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0026; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3819
msgctxt "text_id=14922 | speaker=touko"
msgid "「―――！」"
msgstr ""

#. Occurrence A_4:3874:14923: scene=A_4
#: A_4:3874
msgctxt "text_id=14923 | speaker=unknown"
msgid "　<千|ち><々|ぢ>に散る青い羽根。"
msgstr ""

#. Occurrence A_4:3879:14924: scene=A_4
#: A_4:3879
msgctxt "text_id=14924 | speaker=unknown"
msgid "　背後に気配を感じて振りかえる橙子。"
msgstr ""

#. Occurrence A_4:3884:14925: scene=A_4
#: A_4:3884
msgctxt "text_id=14925 | speaker=unknown"
msgid "　その足下に、五体の猫鈴が投げつけられる。"
msgstr ""

#. Occurrence A_4:3970:14926: scene=A_4
#: A_4:3970
msgctxt "text_id=14926 | speaker=unknown"
msgid "　無惨に砕け散る猫鈴。"
msgstr ""

#. Occurrence A_4:3975:14927: scene=A_4
#: A_4:3975
msgctxt "text_id=14927 | speaker=unknown"
msgid "　橙子が振り向いた先には、変わらぬ久遠寺有珠の姿があった。"
msgstr ""

#. Occurrence A_4:3996:14928: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0014; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3996
msgctxt "text_id=14928 | speaker=alice"
msgid "「…………そよ風みたいなルーンね。"
msgstr ""

#. Occurrence A_4:3996:14929: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0014; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3996
msgctxt "text_id=14929 | speaker=alice"
msgid "　橙子さん、本当に<鈍|にぶ>った？」"
msgstr ""

#. Occurrence A_4:4042:14930: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0027; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4042
msgctxt "text_id=14930 | speaker=touko"
msgid "「……<空蝉|うつせみ>か。術者の身代わりになるプロイの話は、聞いてなかったな」"
msgstr ""

#. Occurrence A_4:4076:14931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0015; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4076
msgctxt "text_id=14931 | speaker=alice"
msgid "「ええ。一年のうち３６５日は役立たずで、どうしてあんなのが古参なのかわたしも疑問だけど―――殺される事だけは得意なのよ、彼」"
msgstr ""

#. Occurrence A_4:4109:14932: scene=A_4
#: A_4:4109
msgctxt "text_id=14932 | speaker=unknown"
msgid "　少女の言葉に応えるように、チチチ、とどこからか鳥の鳴き声がする。"
msgstr ""

#. Occurrence A_4:4114:14933: scene=A_4
#: A_4:4114
msgctxt "text_id=14933 | speaker=unknown"
msgid "　犯人不明の<犠牲者|ブルーバード>。"
msgstr ""

#. Occurrence A_4:4130:14934: scene=A_4
#: A_4:4130
msgctxt "text_id=14934 | speaker=unknown"
msgid "『誰<が駒鳥を殺した|Who killed COCK ROBIN.>か？』を、音程はずれで唄っている。"
msgstr ""

#. Occurrence A_4:4182:14935: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0028; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4182
msgctxt "text_id=14935 | speaker=touko"
msgid "「……ああ、そんな歌もあったな。"
msgstr ""

#. Occurrence A_4:4188:14936: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0029; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4188
msgctxt "text_id=14936 | speaker=touko"
msgid "　だがアレは一度に一回しか殺されない。"
msgstr ""

#. Occurrence A_4:4194:14937: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0030; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4194
msgctxt "text_id=14937 | speaker=touko"
msgid "　二度目はないし、あったとしても―――」"
msgstr ""

#. Occurrence A_4:4220:14938: scene=A_4
#: A_4:4220
msgctxt "text_id=14938 | speaker=unknown"
msgid "　ぷぎゃ、と鳥である事を疑う断末魔が響く。"
msgstr ""

#. Occurrence A_4:4225:14939: scene=A_4
#: A_4:4225
msgctxt "text_id=14939 | speaker=unknown"
msgid "　有珠の背後の木に留まっていた駒鳥は、橙子の魔眼を受けただけで悶絶してしまった。"
msgstr ""

#. Occurrence A_4:4256:14940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0016; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4256
msgctxt "text_id=14940 | speaker=alice"
msgid "「…………本当に、使えない」"
msgstr ""

#. Occurrence A_4:4280:14941: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0031; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4280
msgctxt "text_id=14941 | speaker=touko"
msgid "「さて、ではやり直しだ。"
msgstr ""

#. Occurrence A_4:4286:14942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0032; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4286
msgctxt "text_id=14942 | speaker=touko"
msgid "　<後|あと>もつかえている、これで終わりにしよう有珠。どの道、この公園では手がないだろう？」"
msgstr ""

#. Occurrence A_4:4346:14943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0017; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4346
msgctxt "text_id=14943 | speaker=alice"
msgid "「―――そうでもないわ。"
msgstr ""

#. Occurrence A_4:4352:14944: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0018; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4352
msgctxt "text_id=14944 | speaker=alice"
msgid "　たしかに、今のわたしに貴女の魔眼は<破|やぶ>れない。"
msgstr ""

#. Occurrence A_4:4363:14945: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0019; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4363
msgctxt "text_id=14945 | speaker=alice"
msgid "　けれど―――」"
msgstr ""

#. Occurrence A_4:4403:14946: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14946 | speaker=alice"
msgid "　　　　　　『Build it up with wood and clay,"
msgstr ""

#. Occurrence A_4:4403:14947: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14947 | speaker=alice"
msgid "　　　　　　　Wood and clay,Wood and clay,"
msgstr ""

#. Occurrence A_4:4403:14948: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14948 | speaker=alice"
msgid "　　　　　　　Build it up with wood and clay,"
msgstr ""

#. Occurrence A_4:4403:14949: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14949 | speaker=alice"
msgid "　　　　　　　My fair lady.』"
msgstr ""

#. Occurrence A_4:4466:14950: scene=A_4
#: A_4:4466
msgctxt "text_id=14950 | speaker=unknown"
msgid "　その歌は地の底から。"
msgstr ""

#. Occurrence A_4:4472:14951: scene=A_4
#: A_4:4472
msgctxt "text_id=14951 | speaker=unknown"
msgid "　地面を<震|ふる>わせて、"
msgstr ""

msgctxt "text_id=14952 | speaker=unknown"
msgid "　何か、巨大なものが生まれつつある―――"
msgstr ""

#. Occurrence A_4:4550:14953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0033; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4550
msgctxt "text_id=14953 | speaker=touko"
msgid "「―――！」"
msgstr ""

#. Occurrence A_4:4636:14954: scene=A_4
#: A_4:4636
msgctxt "text_id=14954 | speaker=unknown"
msgid "　土くれの変化が完成する前に、橙子は黒衣を無限地獄に落としこむ。"
msgstr ""

#. Occurrence A_4:4641:14955: scene=A_4
#: A_4:4641
msgctxt "text_id=14955 | speaker=unknown"
msgid "　だがもう、何もかもが遅い。"
msgstr ""

#. Occurrence A_4:4714:14956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0021; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4714
msgctxt "text_id=14956 | speaker=alice"
msgid "　　　　　『Wood and clay will wash away,』"
msgstr ""

msgctxt "text_id=14957 | speaker=unknown"
msgid "　　　　　　Falling down,Falling down,"
msgstr ""

msgctxt "text_id=14958 | speaker=unknown"
msgid "　　　　　　Build it up with bricks and mortar,"
msgstr ""

msgctxt "text_id=14959 | speaker=unknown"
msgid "　　　　　　My fair lady.』"
msgstr ""

#. Occurrence A_4:4821:14960: scene=A_4
#: A_4:4821
msgctxt "text_id=14960 | speaker=unknown"
msgid "　波打つ大地。"
msgstr ""

#. Occurrence A_4:4826:14961: scene=A_4
#: A_4:4826
msgctxt "text_id=14961 | speaker=unknown"
msgid "　盛り上がる塔のような指。指。指。指。"
msgstr ""

#. Occurrence A_4:4832:14962: scene=A_4
#: A_4:4832
msgctxt "text_id=14962 | speaker=unknown"
msgid "　数多のレンガを呑みながら、石の巨人が<顕現|けんげん>する―――！"
msgstr ""

#. Occurrence A_4:4853:14963: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0034; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4853
msgctxt "text_id=14963 | speaker=touko"
msgid "「そんなバカな話があるか……！"
msgstr ""

#. Occurrence A_4:4889:14964: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0035; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4889
msgctxt "text_id=14964 | speaker=touko"
msgid "　なぜコイツが出てきやがる！？」"
msgstr ""

#. Occurrence A_4:4895:14965: scene=A_4
#: A_4:4895
msgctxt "text_id=14965 | speaker=unknown"
msgid "　困惑と怒りが、魔術師を口汚く<罵|ののし>らせる。"
msgstr ""

#. Occurrence A_4:4900:14966: scene=A_4
#: A_4:4900
msgctxt "text_id=14966 | speaker=unknown"
msgid "　橋の巨人。"
msgstr ""

#. Occurrence A_4:4905:14967: scene=A_4
#: A_4:4905
msgctxt "text_id=14967 | speaker=unknown"
msgid "　蒼崎橙子をして正面からの攻略を断念させた、マインスターの童話の怪物。"
msgstr ""

#. Occurrence A_4:4973:14968: scene=A_4
#: A_4:4973
msgctxt "text_id=14968 | speaker=unknown"
msgid "　その巨人は、強力であるが故に生成に条件が付く。"
msgstr ""

#. Occurrence A_4:4978:14969: scene=A_4
#: A_4:4978
msgctxt "text_id=14969 | speaker=unknown"
msgid "　どのような規模であれ、周囲に自然の川があること―――"
msgstr ""

#. Occurrence A_4:4983:14970: scene=A_4
#: A_4:4983
msgctxt "text_id=14970 | speaker=unknown"
msgid "　それが、この巨人を呼ぶ絶対条件だ。"
msgstr ""

#. Occurrence A_4:5026:14971: scene=A_4
#: A_4:5026
msgctxt "text_id=14971 | speaker=unknown"
msgid "　そして、この公園の周囲に天然の川はない。"
msgstr ""

#. Occurrence A_4:5044:14972: scene=A_4
#: A_4:5044
msgctxt "text_id=14972 | speaker=unknown"
msgid "　それを踏まえた上で、橙子は有珠との直接対決に乗り出したというのに……！"
msgstr ""

#. Occurrence A_4:5078:14973: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0022; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5078
msgctxt "text_id=14973 | speaker=alice"
msgid "「―――あら。"
msgstr ""

#. Occurrence A_4:5096:14974: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0023; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5096
msgctxt "text_id=14974 | speaker=alice"
msgid "　あるでしょう、すぐ<そ|・><こ|・>に。"
msgstr ""

#. Occurrence A_4:5102:14975: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0024; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5102
msgctxt "text_id=14975 | speaker=alice"
msgid "　川と呼ぶには小さな、すぐに消えてしまうものだけど」"
msgstr ""

#. Occurrence A_4:5183:14976: scene=A_4
#: A_4:5183
msgctxt "text_id=14976 | speaker=unknown"
msgid "　少女の宣言に、魔術師は足下に視線を落とした。"
msgstr ""

#. Occurrence A_4:5188:14977: scene=A_4
#: A_4:5188
msgctxt "text_id=14977 | speaker=unknown"
msgid "　ぱしゃり、と革靴が水を弾く。"
msgstr ""

#. Occurrence A_4:5209:14978: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0036; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5209
msgctxt "text_id=14978 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence A_4:5214:14979: scene=A_4
#: A_4:5214
msgctxt "text_id=14979 | speaker=unknown"
msgid "　愕然とするオレンジ色の魔術師。"
msgstr ""

#. Occurrence A_4:5219:14980: scene=A_4
#: A_4:5219
msgctxt "text_id=14980 | speaker=unknown"
msgid "　先ほどの、無意味と知った上でのディドルディドルの消費はこの為か。"
msgstr ""

#. Occurrence A_4:5272:14981: scene=A_4
#: A_4:5272
msgctxt "text_id=14981 | speaker=unknown"
msgid "　<猫鈴|ディドル>は量産できるとはいえ、少女にとっては貴重品だ。"
msgstr ""

#. Occurrence A_4:5279:14982: scene=A_4
#: A_4:5279
msgctxt "text_id=14982 | speaker=unknown"
msgid "　それを意味もなく五回。"
msgstr ""

#. Occurrence A_4:5287:14983: scene=A_4
#: A_4:5287
msgctxt "text_id=14983 | speaker=unknown"
msgid "　直線上に、道を描くよう放たれたディドルディドルは、太陽のルーンによって消滅した。"
msgstr ""

#. Occurrence A_4:5401:14984: scene=A_4
#: A_4:5401
msgctxt "text_id=14984 | speaker=unknown"
msgid "　その爪痕こそ―――"
msgstr ""

#. Occurrence A_4:5446:14985: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0037; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5446
msgctxt "text_id=14985 | speaker=touko"
msgid "「雪解けの流水か―――！」"
msgstr ""

#. Occurrence A_4:5811:14986: scene=A_4
#: A_4:5811
msgctxt "text_id=14986 | speaker=unknown"
msgid "　石畳を食らいながら、<橋の巨人|テムズトロル>の巨腕が上がる。"
msgstr ""

#. Occurrence A_4:5816:14987: scene=A_4
#: A_4:5816
msgctxt "text_id=14987 | speaker=unknown"
msgid "　上半身だけで八メートルを超える怪物。"
msgstr ""

#. Occurrence A_4:5821:14988: scene=A_4
#: A_4:5821
msgctxt "text_id=14988 | speaker=unknown"
msgid "　その構成はすべて石。"
msgstr ""

#. Occurrence A_4:5826:14989: scene=A_4
#: A_4:5826
msgctxt "text_id=14989 | speaker=unknown"
msgid "　以前、少女が森で使役した木々の巨人も怪物だった。"
msgstr ""

#. Occurrence A_4:5831:14990: scene=A_4
#: A_4:5831
msgctxt "text_id=14990 | speaker=unknown"
msgid "　だが―――目前のモノはそれを二回り上回る怪物だと、魔術師は瞬時に理解する。"
msgstr ""

#. Occurrence A_4:5895:14991: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0038; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5895
msgctxt "text_id=14991 | speaker=touko"
msgid "「「「「「止まれ―――！！！！」」」」」"
msgstr ""

#. Occurrence A_4:6027:14992: scene=A_4
#: A_4:6027
msgctxt "text_id=14992 | speaker=unknown"
msgid "　たまらず解放される積重魔眼。"
msgstr ""

#. Occurrence A_4:6032:14993: scene=A_4
#: A_4:6032
msgctxt "text_id=14993 | speaker=unknown"
msgid "　だが―――そんなものが、この巨大な一つの生命に、どれほどの意味があるのか。"
msgstr ""

#. Occurrence A_4:6127:14994: scene=A_4
#: A_4:6127
msgctxt "text_id=14994 | speaker=unknown"
msgid "　前述したが、魔眼への対応策は二つある。"
msgstr ""

#. Occurrence A_4:6132:14995: scene=A_4
#: A_4:6132
msgctxt "text_id=14995 | speaker=unknown"
msgid "　一つは身を隠し、術者の視界に入らない事。"
msgstr ""

#. Occurrence A_4:6137:14996: scene=A_4
#: A_4:6137
msgctxt "text_id=14996 | speaker=unknown"
msgid "　それが定石ではあるが、もう一つ、単純かつ絶対の対応策がある。"
msgstr ""

#. Occurrence A_4:6142:14997: scene=A_4
#: A_4:6142
msgctxt "text_id=14997 | speaker=unknown"
msgid "　いや、策というよりどうしようもない現実だ。"
msgstr ""

#. Occurrence A_4:6147:14998: scene=A_4
#: A_4:6147
msgctxt "text_id=14998 | speaker=unknown"
msgid "　魔眼とは視界、焦点に収めた対象に呪いを行う魔術。"
msgstr ""

#. Occurrence A_4:6152:14999: scene=A_4
#: A_4:6152
msgctxt "text_id=14999 | speaker=unknown"
msgid "　しかし。その対象が、<視|・><界|・><に|・><収|・><ま|・><り|・><き|・><ら|・><な|・><い|・><規格|サイズ>であったらどうなるのか？"
msgstr ""

#. Occurrence A_4:6282:15000: scene=A_4
#: A_4:6282
msgctxt "text_id=15000 | speaker=unknown"
msgid "　その答えが、これである。"
msgstr ""

#. Occurrence A_4:6287:15001: scene=A_4
#: A_4:6287
msgctxt "text_id=15001 | speaker=unknown"
msgid "　片腕を止めたところで些末なこと。"
msgstr ""

#. Occurrence A_4:6292:15002: scene=A_4
#: A_4:6292
msgctxt "text_id=15002 | speaker=unknown"
msgid "　巨人は自由気ままな右腕を持ち上げ、三十万の<太陽|ルーン>に叩き付ける。"
msgstr ""

#. Occurrence A_4:6543:15003: scene=A_4
#: A_4:6543
msgctxt "text_id=15003 | speaker=unknown"
msgid "　粉砕され、巨人の体として巻き込まれる石の欠片。"
msgstr ""

#. Occurrence A_4:6548:15004: scene=A_4
#: A_4:6548
msgctxt "text_id=15004 | speaker=unknown"
msgid "　魔術師はこう語った。"
msgstr ""

#. Occurrence A_4:6554:15005: scene=A_4
#: A_4:6554
msgctxt "text_id=15005 | speaker=unknown"
msgid "“いかなる夜をもってしても、この太陽は没しない”"
msgstr ""

#. Occurrence A_4:6561:15006: scene=A_4
#: A_4:6561
msgctxt "text_id=15006 | speaker=unknown"
msgid "　さもありなん。"
msgstr ""

#. Occurrence A_4:6566:15007: scene=A_4
#: A_4:6566
msgctxt "text_id=15007 | speaker=unknown"
msgid "　その言葉ごと、巨人は沈まぬ太陽を完膚無きまで<粉|・><砕|・><し|・><た|・>。"
msgstr ""

#. Occurrence A_4:6656:15008: scene=A_4
#: A_4:6656
msgctxt "text_id=15008 | speaker=unknown"
msgid "　……勝敗は決した。"
msgstr ""

#. Occurrence A_4:6662:15009: scene=A_4
#: A_4:6662
msgctxt "text_id=15009 | speaker=unknown"
msgid "　蒼崎橙子は魔眼を閉じ、逃げ道を確保するように後退する。"
msgstr ""

#. Occurrence A_4:6668:15010: scene=A_4
#: A_4:6668
msgctxt "text_id=15010 | speaker=unknown"
msgid "　周囲からはくぐもった野犬の<呻|うめ>き。"
msgstr ""

#. Occurrence A_4:6673:15011: scene=A_4
#: A_4:6673
msgctxt "text_id=15011 | speaker=unknown"
msgid "　集まった彼らも、そびえ立つ異形に怯えきっている。"
msgstr ""

#. Occurrence A_4:6729:15012: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0040; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6729
msgctxt "text_id=15012 | speaker=touko"
msgid "「まいったな。私ではマインスターには勝てなかったか。"
msgstr ""

#. Occurrence A_4:6735:15013: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0041; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6735
msgctxt "text_id=15013 | speaker=touko"
msgid "　まあ、そのあたりは今後の課題としよう」"
msgstr ""

#. Occurrence A_4:6764:15014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0025; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:6764
msgctxt "text_id=15014 | speaker=alice"
msgid "「……呆れた。逃げられると思っているの、橙子さん？」"
msgstr ""

#. Occurrence A_4:6770:15015: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0042; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6770
msgctxt "text_id=15015 | speaker=touko"
msgid "「まさか。そこまで鈍ってはいないよ有珠。"
msgstr ""

#. Occurrence A_4:6776:15016: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0043; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6776
msgctxt "text_id=15016 | speaker=touko"
msgid "　だいいち―――逃げるとしたら、それは私の方じゃないからね」"
msgstr ""

#. Occurrence A_4:6805:15017: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0026; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:6805
msgctxt "text_id=15017 | speaker=alice"
msgid "「……？」"
msgstr ""

#. Occurrence A_4:6844:15018: scene=A_4
#: A_4:6844
msgctxt "text_id=15018 | speaker=unknown"
msgid "　魔術師の声に虚勢はない。"
msgstr ""

#. Occurrence A_4:6861:15019: scene=A_4
#: A_4:6861
msgctxt "text_id=15019 | speaker=unknown"
msgid "　自分では傷一つ付けられない巨人を前にして、蒼崎橙子の余裕は崩れない。"
msgstr ""

#. Occurrence A_4:6866:15020: scene=A_4
#: A_4:6866
msgctxt "text_id=15020 | speaker=unknown"
msgid "　なぜなら、"
msgstr ""

#. Occurrence A_4:6918:15021: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0044; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6918
msgctxt "text_id=15021 | speaker=touko"
msgid "「ま、前座は終わりだ。―――来い、ベオ」"
msgstr ""

#. Occurrence A_4:6923:15022: scene=A_4
#: A_4:6923
msgctxt "text_id=15022 | speaker=unknown"
msgid "　技を競い合う戦いではなく、"
msgstr ""

#. Occurrence A_4:6928:15023: scene=A_4
#: A_4:6928
msgctxt "text_id=15023 | speaker=unknown"
msgid "　命を奪い合う戦いは、ここから始まるのだから。"
msgstr ""

#. Occurrence A_4:6977:15024: scene=A_4
#: A_4:6977
msgctxt "text_id=15024 | speaker=unknown"
msgid "　ぱちん、と指を鳴らす橙子。"
msgstr ""

#. Occurrence A_4:6983:15025: scene=A_4
#: A_4:6983
msgctxt "text_id=15025 | speaker=unknown"
msgid "　その呼びかけに応じて、一際高く、美しい旋律が月に伸びた。"
msgstr ""

#. Occurrence A_4:6988:15026: scene=A_4
#: A_4:6988
msgctxt "text_id=15026 | speaker=unknown"
msgid "　……どこまでも響く弦楽器。"
msgstr ""

#. Occurrence A_4:6993:15027: scene=A_4
#: A_4:6993
msgctxt "text_id=15027 | speaker=unknown"
msgid "　太古の記憶を呼び覚ます<螺旋|らせん>の<咆哮|ほうこう>。"
msgstr ""

#. Occurrence A_4:7000:15028: scene=A_4
#: A_4:7000
msgctxt "text_id=15028 | speaker=unknown"
msgid "　その音の主は、闇の中から魔術師の真横に舞い降りた。"
msgstr ""

#. Occurrence A_4:7026:15029: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0027; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:7026
msgctxt "text_id=15029 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence A_4:7031:15030: scene=A_4
#: A_4:7031
msgctxt "text_id=15030 | speaker=unknown"
msgid "　<少女|アリス>の口が、かすかにわななく。"
msgstr ""

#. Occurrence A_4:7036:15031: scene=A_4
#: A_4:7036
msgctxt "text_id=15031 | speaker=unknown"
msgid "　恐怖によるものではない。"
msgstr ""

#. Occurrence A_4:7069:15032: scene=A_4
#: A_4:7069
msgctxt "text_id=15032 | speaker=unknown"
msgid "　あれがどのような生き物なのか一目で受け入れ、感動で唇を震わせたのだ。"
msgstr ""

#. Occurrence A_4:7102:15033: scene=A_4
#: A_4:7102
msgctxt "text_id=15033 | speaker=unknown"
msgid "　あまりにも美しい<黄金|おうごん>の獣。"
msgstr ""

#. Occurrence A_4:7108:15034: scene=A_4
#: A_4:7108
msgctxt "text_id=15034 | speaker=unknown"
msgid "　魔でもなく幻でもなく、聖なるものにも留まらない。"
msgstr ""

#. Occurrence A_4:7113:15035: scene=A_4
#: A_4:7113
msgctxt "text_id=15035 | speaker=unknown"
msgid "　それは絶滅した<神代|しんだい>の<生命|いのち>。"
msgstr ""

#. Occurrence A_4:7118:15036: scene=A_4
#: A_4:7118
msgctxt "text_id=15036 | speaker=unknown"
msgid "　人智による神秘。積み重ねられた秘儀伝承。"
msgstr ""

#. Occurrence A_4:7124:15037: scene=A_4
#: A_4:7124
msgctxt "text_id=15037 | speaker=unknown"
msgid "　地に<遍|あまね>く在る奇跡の再現―――"
msgstr ""

msgctxt "text_id=15038 | speaker=unknown"
msgid "　その一切をかみ砕く、<本|・><当|・><の|・><魔|・><術|・><の|・><天|・><敵|・>。"
msgstr ""

#. Occurrence A_4:7166:15039: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0028; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:7166
msgctxt "text_id=15039 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence A_4:7171:15040: scene=A_4
#: A_4:7171
msgctxt "text_id=15040 | speaker=unknown"
msgid "　少女の眼が、静かな<諦|あきら>めに<翳|かげ>る。"
msgstr ""

#. Occurrence A_4:7177:15041: scene=A_4
#: A_4:7177
msgctxt "text_id=15041 | speaker=unknown"
msgid "　黄金の獣が駆ける。"
msgstr ""

#. Occurrence A_4:7185:15042: scene=A_4
#: A_4:7185
msgctxt "text_id=15042 | speaker=unknown"
msgid "　―――今度は詰んだとすら、思えなかった。"
msgstr ""

#. Occurrence A_5:51:15043: scene=A_5
#: A_5:51
msgctxt "text_id=15043 | speaker=unknown"
msgid "　―――すぐ<傍|そば>で、獣の息遣いが聞こえる。"
msgstr ""

#. Occurrence A_5:81:15044: scene=A_5
#: A_5:81
msgctxt "text_id=15044 | speaker=unknown"
msgid "　どうやら、意識が数秒ほど途切れていたようだ。"
msgstr ""

#. Occurrence A_5:110:15045: scene=A_5
#: A_5:110
msgctxt "text_id=15045 | speaker=unknown"
msgid "　有珠は目を開けて、息を吸う。"
msgstr ""

#. Occurrence A_5:181:15046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0000; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:181
msgctxt "text_id=15046 | speaker=alice"
msgid "「―――、―――」"
msgstr ""

#. Occurrence A_5:186:15047: scene=A_5
#: A_5:186
msgctxt "text_id=15047 | speaker=unknown"
msgid "　咳きこむように苦痛を漏らす。"
msgstr ""

#. Occurrence A_5:195:15048: scene=A_5
#: A_5:195
msgctxt "text_id=15048 | speaker=unknown"
msgid "　喉もとから逆流した血が、冷たい地面を濡らす。"
msgstr ""

#. Occurrence A_5:200:15049: scene=A_5
#: A_5:200
msgctxt "text_id=15049 | speaker=unknown"
msgid "　焦点を取り戻した視覚が、高い空と、また降りだした雪と、黄金の狼を認めていた。"
msgstr ""

#. Occurrence A_5:235:15050: scene=A_5
#: A_5:235
msgctxt "text_id=15050 | speaker=unknown"
msgid "　狼の息遣いは荒々しい。"
msgstr ""

#. Occurrence A_5:240:15051: scene=A_5
#: A_5:240
msgctxt "text_id=15051 | speaker=unknown"
msgid "　<涎|よだれ>を舌からこぼしながら、有珠の顔を覗きこんでいる。"
msgstr ""

#. Occurrence A_5:262:15052: scene=A_5
#: A_5:262
msgctxt "text_id=15052 | speaker=unknown"
msgid "　ノコギリのような牙と口。"
msgstr ""

#. Occurrence A_5:267:15053: scene=A_5
#: A_5:267
msgctxt "text_id=15053 | speaker=unknown"
msgid "　この世のどんな動物より柔らかく、艶やかな毛並み。"
msgstr ""

#. Occurrence A_5:272:15054: scene=A_5
#: A_5:272
msgctxt "text_id=15054 | speaker=unknown"
msgid "　血に染まった<前脚|あし>の爪は、まるで包丁を三本揃えたような凶悪さだ。"
msgstr ""

#. Occurrence A_5:277:15055: scene=A_5
#: A_5:277
msgctxt "text_id=15055 | speaker=unknown"
msgid "　それでも、粗野な臭いは微塵もない。"
msgstr ""

#. Occurrence A_5:282:15056: scene=A_5
#: A_5:282
msgctxt "text_id=15056 | speaker=unknown"
msgid "　この金狼の前では、人間の方が己が<獣性|じゅうせい>に恥じ入るだろう。"
msgstr ""

#. Occurrence A_5:302:15057: scene=A_5
#: A_5:302
msgctxt "text_id=15057 | speaker=unknown"
msgid "　……有珠と狼の戦いはあっけなく終わった。"
msgstr ""

#. Occurrence A_5:309:15058: scene=A_5
#: A_5:309
msgctxt "text_id=15058 | speaker=unknown"
msgid "　橋の巨人は金狼の前に破れ、有珠は逃げる事もできず、その凶悪な前脚の洗礼を受けた。"
msgstr ""

#. Occurrence A_5:314:15059: scene=A_5
#: A_5:314
msgctxt "text_id=15059 | speaker=unknown"
msgid "　剣のような横殴りの衝撃が、有珠の腹を一閃したのだ。"
msgstr ""

#. Occurrence A_5:319:15060: scene=A_5
#: A_5:319
msgctxt "text_id=15060 | speaker=unknown"
msgid "　服はもちろん、内臓まで吹き飛んだ。"
msgstr ""

#. Occurrence A_5:324:15061: scene=A_5
#: A_5:324
msgctxt "text_id=15061 | speaker=unknown"
msgid "　その決定的な瞬間でさえ、有珠は声をあげなかった。"
msgstr ""

#. Occurrence A_5:358:15062: scene=A_5
#: A_5:358
msgctxt "text_id=15062 | speaker=unknown"
msgid "　狼は有珠を押し倒し、その顔を覗きこむ。"
msgstr ""

#. Occurrence A_5:363:15063: scene=A_5
#: A_5:363
msgctxt "text_id=15063 | speaker=unknown"
msgid "　触れれば折れかねない少女の四肢にのしかかる。"
msgstr ""

#. Occurrence A_5:368:15064: scene=A_5
#: A_5:368
msgctxt "text_id=15064 | speaker=unknown"
msgid "　それが<現在|いま>の状態だ。"
msgstr ""

#. Occurrence A_5:373:15065: scene=A_5
#: A_5:373
msgctxt "text_id=15065 | speaker=unknown"
msgid "　意識を取り戻した有珠は苦しげな瞳で敵を見据える。"
msgstr ""

#. Occurrence A_5:378:15066: scene=A_5
#: A_5:378
msgctxt "text_id=15066 | speaker=unknown"
msgid "　そこに恐怖はない。"
msgstr ""

#. Occurrence A_5:383:15067: scene=A_5
#: A_5:383
msgctxt "text_id=15067 | speaker=unknown"
msgid "　あるのは、現実を受け入れる冷めた色だけだった。"
msgstr ""

#. Occurrence A_5:409:15068: scene=A_5
#: A_5:409
msgctxt "text_id=15068 | speaker=unknown"
msgid "　有珠の覚悟に感じ入ったのか、狼は振り上げた前脚を停止させる。"
msgstr ""

#. Occurrence A_5:414:15069: scene=A_5
#: A_5:414
msgctxt "text_id=15069 | speaker=unknown"
msgid "　少女の黒い瞳と、狼の眼が交差した後―――"
msgstr ""

#. Occurrence A_5:422:15070: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0000; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:422
msgctxt "text_id=15070 | speaker=beo"
msgid "「“そんなに血が出てるのに、痛くないんだ”」"
msgstr ""

#. Occurrence A_5:428:15071: scene=A_5
#: A_5:428
msgctxt "text_id=15071 | speaker=unknown"
msgid "　思いがけない声があった。"
msgstr ""

#. Occurrence A_5:433:15072: scene=A_5
#: A_5:433
msgctxt "text_id=15072 | speaker=unknown"
msgid "　それは間違いなく、目前の狼が発した<言|も><葉|の>だ。"
msgstr ""

#. Occurrence A_5:454:15073: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0001; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:454
msgctxt "text_id=15073 | speaker=beo"
msgid "「“それとも、痛いのは平気なのかな”」"
msgstr ""

#. Occurrence A_5:459:15074: scene=A_5
#: A_5:459
msgctxt "text_id=15074 | speaker=unknown"
msgid "　邪気のない、子供のようなイントネーション。"
msgstr ""

#. Occurrence A_5:464:15075: scene=A_5
#: A_5:464
msgctxt "text_id=15075 | speaker=unknown"
msgid "　狼は不釣り合いな、これまでの風格を台無しにする笑みを両眼に浮かべ、"
msgstr ""

#. Occurrence A_5:486:15076: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0002; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:486
msgctxt "text_id=15076 | speaker=beo"
msgid "「“どっちにしろ我慢強いんだね、お姉ちゃんは……！”」"
msgstr ""

#. Occurrence A_5:494:15077: scene=A_5
#: A_5:494
msgctxt "text_id=15077 | speaker=unknown"
msgid "　大口を開けて、少女の首にかぶりついた。"
msgstr ""

#. Occurrence A_5:545:15078: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0000; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:545
msgctxt "text_id=15078 | speaker=touko"
msgid "「ベオ―――！」"
msgstr ""

#. Occurrence A_5:550:15079: scene=A_5
#: A_5:550
msgctxt "text_id=15079 | speaker=unknown"
msgid "　閉じられる狼の牙より、なお鋭い橙子の<叱責|しっせき>。"
msgstr ""

#. Occurrence A_5:555:15080: scene=A_5
#: A_5:555
msgctxt "text_id=15080 | speaker=unknown"
msgid "　それに驚くような動作で、狼はびくりと停止した。"
msgstr ""

#. Occurrence A_5:600:15081: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0003; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:600
msgctxt "text_id=15081 | speaker=beo"
msgid "「“……トーコさん”」"
msgstr ""

#. Occurrence A_5:605:15082: scene=A_5
#: A_5:605
msgctxt "text_id=15082 | speaker=unknown"
msgid "　狼はゆっくりと背後を振り返る。"
msgstr ""

#. Occurrence A_5:621:15083: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0001; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:621
msgctxt "text_id=15083 | speaker=touko"
msgid "「トドメは刺すなと言ったろう。余計な仕事を増やす気か、バカモン」"
msgstr ""

#. Occurrence A_5:627:15084: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0004; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:627
msgctxt "text_id=15084 | speaker=beo"
msgid "「“ちぇっ。それはそれで楽しいのに。"
msgstr ""

#. Occurrence A_5:653:15085: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0005; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:653
msgctxt "text_id=15085 | speaker=beo"
msgid "　あーあ、たいくつー。話に聞いた橋の巨人も、結局は他の生き物と一緒だったしー”」"
msgstr ""

#. Occurrence A_5:685:15086: scene=A_5
#: A_5:685
msgctxt "text_id=15086 | speaker=unknown"
msgid "　橙子の叱責を受け、狼は有珠からトボトボと離れていった。"
msgstr ""

#. Occurrence A_5:690:15087: scene=A_5
#: A_5:690
msgctxt "text_id=15087 | speaker=unknown"
msgid "　もう何の興味もないように。"
msgstr ""

#. Occurrence A_5:695:15088: scene=A_5
#: A_5:695
msgctxt "text_id=15088 | speaker=unknown"
msgid "　あの黄金の獣にとって、有珠は道ばたの草ほどの価値もないらしい。"
msgstr ""

#. Occurrence A_5:732:15089: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0001; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:732
msgctxt "text_id=15089 | speaker=alice"
msgid "「―――、っ―――」"
msgstr ""

#. Occurrence A_5:755:15090: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0002; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:755
msgctxt "text_id=15090 | speaker=touko"
msgid "「なんだ、もう意識が戻ったのか。心もタフなら体もたいがいだな。骨まで砕いて、その程度の出血とは。マインスターの教育のたまものかい？」"
msgstr ""

#. Occurrence A_5:812:15091: scene=A_5
#: A_5:812
msgctxt "text_id=15091 | speaker=unknown"
msgid "　有珠は死に<瀕|ひん>した体で、蒼崎橙子を凝視する。"
msgstr ""

#. Occurrence A_5:817:15092: scene=A_5
#: A_5:817
msgctxt "text_id=15092 | speaker=unknown"
msgid "　<敗|やぶ>れた憎しみからではなく、なぜあんなものを連れているのか、という糾弾から。"
msgstr ""

#. Occurrence A_5:845:15093: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0003; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:845
msgctxt "text_id=15093 | speaker=touko"
msgid "「ああ、紹介が遅れたな。"
msgstr ""

#. Occurrence A_5:851:15094: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0004; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:851
msgctxt "text_id=15094 | speaker=touko"
msgid "　彼はおそらく地上で現存している最後の<人狼|じんろう>だ。"
msgstr ""

#. Occurrence A_5:858:15095: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0005; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:858
msgctxt "text_id=15095 | speaker=touko"
msgid "北欧の奥地に生きる彼らの一族の中に現れた、生粋の原種だよ。"
msgstr ""

#. Occurrence A_5:864:15096: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0006; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:864
msgctxt "text_id=15096 | speaker=touko"
msgid "　見ての通り、先祖返りなんて言葉じゃ表せない黄金の神秘でね。名前がなかったんで、分かりやすくベオウルフと呼んでいる」"
msgstr ""

#. Occurrence A_5:905:15097: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0002; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:905
msgctxt "text_id=15097 | speaker=alice"
msgid "「ベオ……ウルフ？」"
msgstr ""

#. Occurrence A_5:911:15098: scene=A_5
#: A_5:911
msgctxt "text_id=15098 | speaker=unknown"
msgid "　腹部を裂く爪にさえ乱れなかった有珠の<表|か><情|お>が、<怪訝|けげん>に<曇|くも>る。"
msgstr ""

#. Occurrence A_5:916:15099: scene=A_5
#: A_5:916
msgctxt "text_id=15099 | speaker=unknown"
msgid "　ベオウルフ。"
msgstr ""

#. Occurrence A_5:921:15100: scene=A_5
#: A_5:921
msgctxt "text_id=15100 | speaker=unknown"
msgid "　デンマークに伝わる、巨人殺しの英雄の名前。"
msgstr ""

#. Occurrence A_5:926:15101: scene=A_5
#: A_5:926
msgctxt "text_id=15101 | speaker=unknown"
msgid "　その名は古英語でいうところのミツバチと野生の獣の組み合わせで、つまるところは熊を意味する。"
msgstr ""

#. Occurrence A_5:965:15102: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0003; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:965
msgctxt "text_id=15102 | speaker=alice"
msgid "「―――なんで、そんな、ちぐはぐな名前、を」"
msgstr ""

#. Occurrence A_5:971:15103: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0007; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:971
msgctxt "text_id=15103 | speaker=touko"
msgid "「うん？　いや、可愛いからに決まってるだろ」"
msgstr ""

#. Occurrence A_5:1002:15104: scene=A_5
#: A_5:1002
msgctxt "text_id=15104 | speaker=unknown"
msgid "　それはベオウルフという名前にかかったものか、金狼自体にかかったものか。"
msgstr ""

#. Occurrence A_5:1007:15105: scene=A_5
#: A_5:1007
msgctxt "text_id=15105 | speaker=unknown"
msgid "　この女の感性は青子より分かりづらい、と有珠は痛みをかみ殺した。"
msgstr ""

#. Occurrence A_5:1062:15106: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0008; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1062
msgctxt "text_id=15106 | speaker=touko"
msgid "「ついでに説明しておくと、周りの犬どもはベオが勝手に呼び寄せたものだ。私自身、マインスターの娘がただの畜生に傷つけられるとは思ってはいないよ。"
msgstr ""

#. Occurrence A_5:1068:15107: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0009; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1068
msgctxt "text_id=15107 | speaker=touko"
msgid "　―――今のところは、ね」"
msgstr ""

#. Occurrence A_5:1115:15108: scene=A_5
#: A_5:1115
msgctxt "text_id=15108 | speaker=unknown"
msgid "　それだけ言うと、橙子は小さく微笑んだ。"
msgstr ""

#. Occurrence A_5:1120:15109: scene=A_5
#: A_5:1120
msgctxt "text_id=15109 | speaker=unknown"
msgid "　草十郎に見せた温かなものではなく、勝者が敗者に見せる無慈悲な笑みを。"
msgstr ""

#. Occurrence A_5:1125:15110: scene=A_5
#: A_5:1125
msgctxt "text_id=15110 | speaker=unknown"
msgid "　有珠の瞳にこもった批難は、今や怒りに変わっている。"
msgstr ""

#. Occurrence A_5:1164:15111: scene=A_5
#: A_5:1164
msgctxt "text_id=15111 | speaker=unknown"
msgid "　黄金の神秘。"
msgstr ""

#. Occurrence A_5:1169:15112: scene=A_5
#: A_5:1169
msgctxt "text_id=15112 | speaker=unknown"
msgid "　そう口にするのなら、なぜこんな人の世界に連れてきてしまったのかと。"
msgstr ""

#. Occurrence A_5:1190:15113: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0010; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1190
msgctxt "text_id=15113 | speaker=touko"
msgid "「なに、需要と供給だよ。"
msgstr ""

#. Occurrence A_5:1196:15114: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0011; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1196
msgctxt "text_id=15114 | speaker=touko"
msgid "　過疎化は人間だけの問題じゃあない。彼らもいい加減、昔ながらの生活には限界がきたらしくてね。話し合いの末、高額で私が買い取った。"
msgstr ""

#. Occurrence A_5:1202:15115: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0012; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1202
msgctxt "text_id=15115 | speaker=touko"
msgid "　といっても、あくまで<洞|さと>から出すだけの権利だがね。"
msgstr ""

#. Occurrence A_5:1227:15116: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0013_0; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1227
msgctxt "text_id=15116 | speaker=touko"
msgid "　お察しの通り、私の髪はベオとの契約に使いきった。自分の髪を使って<使い魔|ぶんしん>を造るより、強大な怪物を縛り付けた方がよっぽど健全―――"
msgstr ""

#. Occurrence A_5:1239:15117: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0013_1; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1239
msgctxt "text_id=15117 | speaker=touko"
msgid "む？」"
msgstr ""

#. Occurrence A_5:1260:15118: scene=A_5
#: A_5:1260
msgctxt "text_id=15118 | speaker=unknown"
msgid "　喋りながら、橙子は眼下の異常を感知した。"
msgstr ""

#. Occurrence A_5:1315:15119: scene=A_5
#: A_5:1315
msgctxt "text_id=15119 | speaker=unknown"
msgid "　……形容しがたい怪音。"
msgstr ""

#. Occurrence A_5:1320:15120: scene=A_5
#: A_5:1320
msgctxt "text_id=15120 | speaker=unknown"
msgid "　……聞く者の正気を削るような、この世には存在しない音。"
msgstr ""

#. Occurrence A_5:1325:15121: scene=A_5
#: A_5:1325
msgctxt "text_id=15121 | speaker=unknown"
msgid "　いや、してはならない音。"
msgstr ""

#. Occurrence A_5:1359:15122: scene=A_5
#: A_5:1359
msgctxt "text_id=15122 | speaker=unknown"
msgid "　それが、少女の裂かれた腹部から<零|こぼ>れている―――"
msgstr ""

#. Occurrence A_5:1380:15123: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0014; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1380
msgctxt "text_id=15123 | speaker=touko"
msgid "「もう復元が始まったか。いや、というより、これは―――」"
msgstr ""

#. Occurrence A_5:1405:15124: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0006; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:1405
msgctxt "text_id=15124 | speaker=beo"
msgid "「“ん？　ふんふんふんふん？　なにこの匂い。トーコさん、なんかワクワクするコト起きてない？”」"
msgstr ""

#. Occurrence A_5:1410:15125: scene=A_5
#: A_5:1410
msgctxt "text_id=15125 | speaker=unknown"
msgid "　なーにー？　と近寄ってくるベオウルフ。"
msgstr ""

#. Occurrence A_5:1415:15126: scene=A_5
#: A_5:1415
msgctxt "text_id=15126 | speaker=unknown"
msgid "　<玩具|オモチャ>に興味を持った子犬さながらである。"
msgstr ""

#. Occurrence A_5:1459:15127: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0015; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1459
msgctxt "text_id=15127 | speaker=touko"
msgid "「見るな、あっちに行っていろベオ。正気を失ってもしらんぞ」"
msgstr ""

#. Occurrence A_5:1464:15128: scene=A_5
#: A_5:1464
msgctxt "text_id=15128 | speaker=unknown"
msgid "　しっし、と橙子は駄犬を手で追い払う。"
msgstr ""

#. Occurrence A_5:1474:15129: scene=A_5
#: A_5:1474
msgctxt "text_id=15129 | speaker=unknown"
msgid "　ベオウルフは残念そうに、大人しく引き下がった。"
msgstr ""

#. Occurrence A_5:1513:15130: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0016; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1513
msgctxt "text_id=15130 | speaker=touko"
msgid "「……教育方針を間違ったかな。まったく、乙女の<胎|はら>を見ようなんて恥を知れ、恥を」"
msgstr ""

#. Occurrence A_5:1538:15131: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0007; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:1538
msgctxt "text_id=15131 | speaker=beo"
msgid "「“えー。トーコさんだって見てるじゃない”」"
msgstr ""

#. Occurrence A_5:1574:15132: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0017; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1574
msgctxt "text_id=15132 | speaker=touko"
msgid "「ばっか、私は乙女だからいいんだ！」"
msgstr ""

#. Occurrence A_5:1602:15133: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0004; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:1602
msgctxt "text_id=15133 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence A_5:1608:15134: scene=A_5
#: A_5:1608
msgctxt "text_id=15134 | speaker=unknown"
msgid "　青子がいたらフラットスナーク戦もかくや、という一撃を放ちかねない暴言だった。"
msgstr ""

#. Occurrence A_5:1655:15135: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0018; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1655
msgctxt "text_id=15135 | speaker=touko"
msgid "「……まあ、しかし惨いな。"
msgstr ""

#. Occurrence A_5:1661:15136: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0019; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1661
msgctxt "text_id=15136 | speaker=touko"
msgid "　<こ|・><ん|・><な|・><に|・><な|・><る|・><ま|・><で|・>放っておくとは、マインスターは人の親とはいえまいよ」"
msgstr ""

#. Occurrence A_5:1670:15137: scene=A_5
#: A_5:1670
msgctxt "text_id=15137 | speaker=unknown"
msgid "　橙子は手袋をつけたまま、鮮血に染まる有珠の腹部に手を滑らせる。"
msgstr ""

#. Occurrence A_5:1691:15138: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0005; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:1691
msgctxt "text_id=15138 | speaker=alice"
msgid "「っ………」"
msgstr ""

#. Occurrence A_5:1730:15139: scene=A_5
#: A_5:1730
msgctxt "text_id=15139 | speaker=unknown"
msgid "　小さく<零|こぼ>れる苦悶。"
msgstr ""

#. Occurrence A_5:1735:15140: scene=A_5
#: A_5:1735
msgctxt "text_id=15140 | speaker=unknown"
msgid "　悲鳴ひとつあげなかった有珠から吐息が漏れる。"
msgstr ""

#. Occurrence A_5:1740:15141: scene=A_5
#: A_5:1740
msgctxt "text_id=15141 | speaker=unknown"
msgid "　顔を<背|そむ>けたのは、恥じらいからか、痛みからか。"
msgstr ""

#. Occurrence A_5:1763:15142: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0020; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1763
msgctxt "text_id=15142 | speaker=touko"
msgid "「ほら、もう肌も復元している。骨格、血管はおろか、内臓にまで施された、<夥|おびただ>しいまでの刻印だ。"
msgstr ""

#. Occurrence A_5:1769:15143: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0021; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1769
msgctxt "text_id=15143 | speaker=touko"
msgid "　生後、肉体に魔術回路を付加する事は両刃の剣だ。"
msgstr ""

#. Occurrence A_5:1775:15144: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0022; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1775
msgctxt "text_id=15144 | speaker=touko"
msgid "　呪文を自分と一体化させる事により、詠唱の手間を省き、術者に多大な利点をもたらす魔術刻印。"
msgstr ""

#. Occurrence A_5:1781:15145: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0023; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1781
msgctxt "text_id=15145 | speaker=touko"
msgid "　しかし、それは多ければ多いほど苦痛をともなう。蒼崎の刻印は腕一本分。まあ、君に比べれば少ない方だな」"
msgstr ""

#. Occurrence A_5:1831:15146: scene=A_5
#: A_5:1831
msgctxt "text_id=15146 | speaker=unknown"
msgid "　橙子の語る魔術刻印とは、その家系の歴史を形にした遺産の事だ。"
msgstr ""

#. Occurrence A_5:1836:15147: scene=A_5
#: A_5:1836
msgctxt "text_id=15147 | speaker=unknown"
msgid "　後継者にしか刻まれない一品もの。"
msgstr ""

#. Occurrence A_5:1841:15148: scene=A_5
#: A_5:1841
msgctxt "text_id=15148 | speaker=unknown"
msgid "　蒼崎橙子が継承するはずだった刻印は、妹である青子の手に渡っている。"
msgstr ""

#. Occurrence A_5:1890:15149: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0024; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1890
msgctxt "text_id=15149 | speaker=touko"
msgid "「しかし、それも良し悪しだな。"
msgstr ""

#. Occurrence A_5:1896:15150: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0025; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1896
msgctxt "text_id=15150 | speaker=touko"
msgid "　右腕に刻印をした青子の痛みは、残る人間の体と神秘となった右腕とが反発する程度だ。"
msgstr ""

#. Occurrence A_5:1902:15151: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0026; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1902
msgctxt "text_id=15151 | speaker=touko"
msgid "　通常の肉体が右腕を否定し、抹消にかかる痛み。"
msgstr ""

#. Occurrence A_5:1908:15152: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0027; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1908
msgctxt "text_id=15152 | speaker=touko"
msgid "　精神的にも肉体的にも生じる幻痛は、原罪にも似て<拭|ぬぐ>い去る事はできない」"
msgstr ""

#. Occurrence A_5:1963:15153: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0028; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1963
msgctxt "text_id=15153 | speaker=touko"
msgid "「……だが、ここまでくると痛みも何もあるまい。"
msgstr ""

#. Occurrence A_5:1969:15154: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0029; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1969
msgctxt "text_id=15154 | speaker=touko"
msgid "　そもそも生きている実感はあるのか？"
msgstr ""

#. Occurrence A_5:1975:15155: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0030; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1975
msgctxt "text_id=15155 | speaker=touko"
msgid "　自分が人間だとまだ信じている？"
msgstr ""

#. Occurrence A_5:1999:15156: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0031_0; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1999
msgctxt "text_id=15156 | speaker=touko"
msgid "　ああ、本当に―――"
msgstr ""

#. Occurrence A_5:2007:15157: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0031_1; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2007
msgctxt "text_id=15157 | speaker=touko"
msgid "お互い、非凡な師を持つと苦労するね、有珠」"
msgstr ""

#. Occurrence A_5:2055:15158: scene=A_5
#: A_5:2055
msgctxt "text_id=15158 | speaker=unknown"
msgid "　そうして、橙子は有珠の体を抱き起こした。"
msgstr ""

#. Occurrence A_5:2060:15159: scene=A_5
#: A_5:2060
msgctxt "text_id=15159 | speaker=unknown"
msgid "　ベオウルフに裂かれた腹部はもう大部分が<塞|ふさ>がっている。"
msgstr ""

#. Occurrence A_5:2077:15160: scene=A_5
#: A_5:2077
msgctxt "text_id=15160 | speaker=unknown"
msgid "　それでも痛みは残っているのか、有珠の呼吸はあまりにもか細く、弱い。"
msgstr ""

#. Occurrence A_5:2082:15161: scene=A_5
#: A_5:2082
msgctxt "text_id=15161 | speaker=unknown"
msgid "　そんな少女の顔を、橙子は優しく持ち上げる。"
msgstr ""

#. Occurrence A_5:2136:15162: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0032; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2136
msgctxt "text_id=15162 | speaker=touko"
msgid "「マインスターには恩がある。それに、私の相手はあくまで青子ひとりだ」"
msgstr ""

#. Occurrence A_5:2171:15163: scene=A_5
#: A_5:2171
msgctxt "text_id=15163 | speaker=unknown"
msgid "　無惨に酸素を求める有珠の唇が、橙子の唇に塞がれる。"
msgstr ""

#. Occurrence A_5:2176:15164: scene=A_5
#: A_5:2176
msgctxt "text_id=15164 | speaker=unknown"
msgid "　身をよじって逃れる少女の肩を、魔術師の腕が掴み縛る。"
msgstr ""

#. Occurrence A_5:2196:15165: scene=A_5
#: A_5:2196
msgctxt "text_id=15165 | speaker=unknown"
msgid "　蒼い月の下、両者は凍り付いたように動かない。"
msgstr ""

#. Occurrence A_5:2202:15166: scene=A_5
#: A_5:2202
msgctxt "text_id=15166 | speaker=unknown"
msgid "　こくり、と嚥下する音。"
msgstr ""

#. Occurrence A_5:2231:15167: scene=A_5
#: A_5:2231
msgctxt "text_id=15167 | speaker=unknown"
msgid "　有珠の喉に滑り落ちる固形物。それきり、少女は力を失って崩れ落ちた。"
msgstr ""

#. Occurrence A_5:2282:15168: scene=A_5
#: A_5:2282
msgctxt "text_id=15168 | speaker=unknown"
msgid "　弱々しく横になった有珠を見届け、橙子は立ち上がる。"
msgstr ""

#. Occurrence A_5:2293:15169: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0033; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2293
msgctxt "text_id=15169 | speaker=touko"
msgid "「今のはナナカマドに手を加えた私の特製品だ。そう簡単に解毒はできない。魔力を流せば体の中で暴発する仕組みになっているから気をつけなさい。"
msgstr ""

#. Occurrence A_5:2306:15170: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0034; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2306
msgctxt "text_id=15170 | speaker=touko"
msgid "　―――ああ、口移しは私の趣味だから、特に気にする事はないよ」"
msgstr ""

#. Occurrence A_5:2329:15171: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0006; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:2329
msgctxt "text_id=15171 | speaker=alice"
msgid "「…………………………」"
msgstr ""

#. Occurrence A_5:2349:15172: scene=A_5
#: A_5:2349
msgctxt "text_id=15172 | speaker=unknown"
msgid "　有珠は地面に倒れたまま、必死に意識をたもって橙子を見上げる。"
msgstr ""

#. Occurrence A_5:2355:15173: scene=A_5
#: A_5:2355
msgctxt "text_id=15173 | speaker=unknown"
msgid "体の痛みより、今の口づけの方がよっぽどダメージが大きかったと睨むように。"
msgstr ""

#. Occurrence A_5:2360:15174: scene=A_5
#: A_5:2360
msgctxt "text_id=15174 | speaker=unknown"
msgid "　恨みがましい視線に振りかえる事もなく、橙子は黄金の狼を従えて歩きだす。"
msgstr ""

#. Occurrence A_5:2403:15175: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0035; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2403
msgctxt "text_id=15175 | speaker=touko"
msgid "「と。そうそう、ひとつ言い忘れていた。"
msgstr ""

#. Occurrence A_5:2409:15176: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0036; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2409
msgctxt "text_id=15176 | speaker=touko"
msgid "　ベオが呼び寄せた野犬たちだけどね、公園の外にまだ山ほどいるんだが―――困ったコトに、彼らは本来<何|・><を|・><口|・><に|・><す|・><る|・><べ|・><き|・><か|・>を思い出している。"
msgstr ""

#. Occurrence A_5:2415:15177: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0037; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2415
msgctxt "text_id=15177 | speaker=touko"
msgid "　ベオの野性に刺激されたんだろう。獣は、より強い獣に従うものだからな」"
msgstr ""

#. Occurrence A_5:2452:15178: scene=A_5
#: A_5:2452
msgctxt "text_id=15178 | speaker=unknown"
msgid "　遠回しな死刑宣告。"
msgstr ""

#. Occurrence A_5:2457:15179: scene=A_5
#: A_5:2457
msgctxt "text_id=15179 | speaker=unknown"
msgid "　自然界において、動かなくなった動物は、まだ動く動物に<肉|からだ>を捧げるのが習わしだ。"
msgstr ""

#. Occurrence A_5:2478:15180: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0038; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2478
msgctxt "text_id=15180 | speaker=touko"
msgid "「じゃあ私は行くよ。歩く事も満足にできないだろうが、無事に帰れるといいね、有珠」"
msgstr ""

#. Occurrence A_5:2513:15181: scene=A_5
#: A_5:2513
msgctxt "text_id=15181 | speaker=unknown"
msgid "　口元をいびつに歪ませて、魔術師は退場した。"
msgstr ""

#. Occurrence A_5:2547:15182: scene=A_5
#: A_5:2547
msgctxt "text_id=15182 | speaker=unknown"
msgid "　それと入れ替わるように、飢えた<彼|・><ら|・>の声が集まってくる。"
msgstr ""

#. Occurrence A_5:2568:15183: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0007; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:2568
msgctxt "text_id=15183 | speaker=alice"
msgid "「…………、――――――」"
msgstr ""

#. Occurrence A_5:2574:15184: scene=A_5
#: A_5:2574
msgctxt "text_id=15184 | speaker=unknown"
msgid "　……有珠の視界はいまだ定まらない。"
msgstr ""

#. Occurrence A_5:2579:15185: scene=A_5
#: A_5:2579
msgctxt "text_id=15185 | speaker=unknown"
msgid "　集まりだした野犬は、絵本に出てくるお化けのようだ。"
msgstr ""

#. Occurrence A_5:2612:15186: scene=A_5
#: A_5:2612
msgctxt "text_id=15186 | speaker=unknown"
msgid "　薄れゆく意識の中で、有珠は大きく息を吐いた。"
msgstr ""

#. Occurrence A_5:2617:15187: scene=A_5
#: A_5:2617
msgctxt "text_id=15187 | speaker=unknown"
msgid "　空は青く、森は高く、広場に救いはない。"
msgstr ""

#. Occurrence A_5:2652:15188: scene=A_5
#: A_5:2652
msgctxt "text_id=15188 | speaker=unknown"
msgid "　うつろな視界の隅には、場違いな電話ボックスがひとつ。"
msgstr ""

#. Occurrence A_6:39:15189: scene=A_6
#: A_6:39
msgctxt "text_id=15189 | speaker=unknown"
msgid "　電話が鳴った。"
msgstr ""

#. Occurrence A_6:55:15190: scene=A_6
#: A_6:55
msgctxt "text_id=15190 | speaker=unknown"
msgid "　草十郎にとって二回目にあたる電話の音は、深夜のロビーに寒々しく響き渡った。"
msgstr ""

#. Occurrence A_6:60:15191: scene=A_6
#: A_6:60
msgctxt "text_id=15191 | speaker=unknown"
msgid "　有珠の電話から、まだ数分と経っていない。"
msgstr ""

#. Occurrence A_6:65:15192: scene=A_6
#: A_6:65
msgctxt "text_id=15192 | speaker=unknown"
msgid "　彼女の用件はなんだったのか。"
msgstr ""

#. Occurrence A_6:81:15193: scene=A_6
#: A_6:81
msgctxt "text_id=15193 | speaker=unknown"
msgid "　ひとり考えこむ草十郎の目を覚ますように、コール音は鳴り響く。"
msgstr ""

#. Occurrence A_6:107:15194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0000; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:107
msgctxt "text_id=15194 | speaker=soujuurou"
msgid "「はい、久遠寺ですが」"
msgstr ""

#. Occurrence A_6:113:15195: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0000; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:113
msgctxt "text_id=15195 | speaker=touko"
msgid "「あら、その声は草十郎くん？」"
msgstr ""

#. Occurrence A_6:119:15196: scene=A_6
#: A_6:119
msgctxt "text_id=15196 | speaker=unknown"
msgid "　また有珠からの電話では、という草十郎の予想を裏切る明るい声。"
msgstr ""

#. Occurrence A_6:124:15197: scene=A_6
#: A_6:124
msgctxt "text_id=15197 | speaker=unknown"
msgid "　声の主は蒼崎橙子で、予想外の相手に草十郎はかすかに当惑……はしなかった。"
msgstr ""

#. Occurrence A_6:150:15198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0001; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:150
msgctxt "text_id=15198 | speaker=soujuurou"
msgid "「そうですけど。橙子さん、暇なんですか？」"
msgstr ""

#. Occurrence A_6:156:15199: scene=A_6
#: A_6:156
msgctxt "text_id=15199 | speaker=unknown"
msgid "　たしかもうじき午前零時になるな、と草十郎は時計を確認する。"
msgstr ""

#. Occurrence A_6:161:15200: scene=A_6
#: A_6:161
msgctxt "text_id=15200 | speaker=unknown"
msgid "　ここ一番でも緊張感のない男である。"
msgstr ""

#. Occurrence A_6:182:15201: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0001; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:182
msgctxt "text_id=15201 | speaker=touko"
msgid "「っ―――」"
msgstr ""

#. Occurrence A_6:187:15202: scene=A_6
#: A_6:187
msgctxt "text_id=15202 | speaker=unknown"
msgid "　受話器の向こうでは、笑いをこらえる息遣い。"
msgstr ""

#. Occurrence A_6:192:15203: scene=A_6
#: A_6:192
msgctxt "text_id=15203 | speaker=unknown"
msgid "　しばらくの呼吸困難の後、橙子はようやく落ち着いて会話を再開した。"
msgstr ""

#. Occurrence A_6:213:15204: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0002; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:213
msgctxt "text_id=15204 | speaker=touko"
msgid "「ごめんなさい、ちょっとツボはいっちゃったみたい。"
msgstr ""

#. Occurrence A_6:219:15205: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0003; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:219
msgctxt "text_id=15205 | speaker=touko"
msgid "　で、質問の返しね。これがあんまり暇じゃないな。私も今日で終わらせる予定だから忙しいんだ」"
msgstr ""

#. Occurrence A_6:225:15206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0002; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:225
msgctxt "text_id=15206 | speaker=soujuurou"
msgid "「偶然ですね。蒼崎もそんな事を言ってました」"
msgstr ""

#. Occurrence A_6:252:15207: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0004; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:252
msgctxt "text_id=15207 | speaker=touko"
msgid "「やっぱり？　そうね、こういう時は本当に姉妹だなって思うわ。昔からエンジンかけるタイミングだけは一緒だったから、あの子とは。"
msgstr ""

#. Occurrence A_6:258:15208: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0005; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:258
msgctxt "text_id=15208 | speaker=touko"
msgid "　……ところで、蒼崎はやめてって言ったでしょ。私も蒼崎だから、<擽|くすぐ>ったいのよね、そう言われるの」"
msgstr ""

#. Occurrence A_6:278:15209: scene=A_6
#: A_6:278
msgctxt "text_id=15209 | speaker=unknown"
msgid "　言われて、ああ、と草十郎は納得した。"
msgstr ""

#. Occurrence A_6:283:15210: scene=A_6
#: A_6:283
msgctxt "text_id=15210 | speaker=unknown"
msgid "　あの時の言葉はそういう意味だったのか、と。"
msgstr ""

#. Occurrence A_6:304:15211: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0006; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:304
msgctxt "text_id=15211 | speaker=touko"
msgid "「まあそんな訳だから、長話をする気はないんだ。"
msgstr ""

#. Occurrence A_6:310:15212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0007; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:310
msgctxt "text_id=15212 | speaker=touko"
msgid "　単刀直入に聞くけど、そっちに青子はいる？」"
msgstr ""

#. Occurrence A_6:316:15213: scene=A_6
#: A_6:316
msgctxt "text_id=15213 | speaker=unknown"
msgid "　それは本当に、妹の行方を心配するような質問だった。"
msgstr ""

#. Occurrence A_6:321:15214: scene=A_6
#: A_6:321
msgctxt "text_id=15214 | speaker=unknown"
msgid "　しかし、どんなに緊張感のない草十郎でも、橙子が青子たちの敵であるコトは実感している。"
msgstr ""

#. Occurrence A_6:326:15215: scene=A_6
#: A_6:326
msgctxt "text_id=15215 | speaker=unknown"
msgid "　青子と有珠を思うのなら、この質問には答えられない。"
msgstr ""

#. Occurrence A_6:347:15216: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0003; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:347
msgctxt "text_id=15216 | speaker=soujuurou"
msgid "「……さあ。なんて答えてほしいんですか、橙子さんとしては」"
msgstr ""

#. Occurrence A_6:352:15217: scene=A_6
#: A_6:352
msgctxt "text_id=15217 | speaker=unknown"
msgid "　今までの気軽な口調とは一変した質問。"
msgstr ""

#. Occurrence A_6:357:15218: scene=A_6
#: A_6:357
msgctxt "text_id=15218 | speaker=unknown"
msgid "　草十郎の言葉に、受話器の向こうにいる橙子は、まいったなあ、と呟いた。"
msgstr ""

#. Occurrence A_6:362:15219: scene=A_6
#: A_6:362
msgctxt "text_id=15219 | speaker=unknown"
msgid "　彼女が思っていた以上に、この少年は察しがいい。今は、その賢さがマイナスに働くというのにだ。"
msgstr ""

#. Occurrence A_6:383:15220: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0008; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:383
msgctxt "text_id=15220 | speaker=touko"
msgid "「そうね、君には何も答えてほしくないっていうのが正解かな。"
msgstr ""

#. Occurrence A_6:389:15221: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0009; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:389
msgctxt "text_id=15221 | speaker=touko"
msgid "　第一印象で君を無視するのはよくない気がしてたけど、やっぱり私は、草十郎くんを手にかけたくはないみたい。"
msgstr ""

#. Occurrence A_6:395:15222: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0010; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:395
msgctxt "text_id=15222 | speaker=touko"
msgid "　君は、このまま無関係でいてちょうだいね」"
msgstr ""

#. Occurrence A_6:415:15223: scene=A_6
#: A_6:415
msgctxt "text_id=15223 | speaker=unknown"
msgid "　嘘のない、親しみのこもった忠告。"
msgstr ""

#. Occurrence A_6:420:15224: scene=A_6
#: A_6:420
msgctxt "text_id=15224 | speaker=unknown"
msgid "　草十郎はそうですか、とだけ答えた。"
msgstr ""

#. Occurrence A_6:431:15225: scene=A_6
#: A_6:431
msgctxt "text_id=15225 | speaker=unknown"
msgid "　やっぱり彼女も無関係である事を望んでいる。"
msgstr ""

#. Occurrence A_6:436:15226: scene=A_6
#: A_6:436
msgctxt "text_id=15226 | speaker=unknown"
msgid "　それが彼女たちなりの誠意である事は、草十郎にも理解できる。"
msgstr ""

#. Occurrence A_6:442:15227: scene=A_6
#: A_6:442
msgctxt "text_id=15227 | speaker=unknown"
msgid "　だが。その誠意は、誰が望んだものなのか。"
msgstr ""

#. Occurrence A_6:463:15228: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0011; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:463
msgctxt "text_id=15228 | speaker=touko"
msgid "「じゃ、さよならね。私は君が思ってるほど暇じゃないから。"
msgstr ""

#. Occurrence A_6:469:15229: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0012; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:469
msgctxt "text_id=15229 | speaker=touko"
msgid "　……でも、最後にひとつだけ。君を試すようで悪いんだけど、伝えておかないと一生恨まれそうだし。"
msgstr ""

#. Occurrence A_6:475:15230: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0013; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:475
msgctxt "text_id=15230 | speaker=touko"
msgid "　なんで、そうならないように責任の半分を君に押しつけちゃおっかな」"
msgstr ""

#. Occurrence A_6:495:15231: scene=A_6
#: A_6:495
msgctxt "text_id=15231 | speaker=unknown"
msgid "　くす、と橙子は笑う。"
msgstr ""

#. Occurrence A_6:500:15232: scene=A_6
#: A_6:500
msgctxt "text_id=15232 | speaker=unknown"
msgid "　それは、はじめから<そ|・><れ|・>を伝える事だけが目的だと示す笑みだった。"
msgstr ""

#. Occurrence A_6:521:15233: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0014; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:521
msgctxt "text_id=15233 | speaker=touko"
msgid "「さっき久遠寺さんに会ってきたの。"
msgstr ""

#. Occurrence A_6:527:15234: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0015; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:527
msgctxt "text_id=15234 | speaker=touko"
msgid "　彼女から電話があったでしょう？」"
msgstr ""

#. Occurrence A_6:533:15235: scene=A_6
#: A_6:533
msgctxt "text_id=15235 | speaker=unknown"
msgid "　橙子の口調は変わらない。"
msgstr ""

#. Occurrence A_6:538:15236: scene=A_6
#: A_6:538
msgctxt "text_id=15236 | speaker=unknown"
msgid "　今の台詞にはどこにも嫌な気配はない。"
msgstr ""

#. Occurrence A_6:543:15237: scene=A_6
#: A_6:543
msgctxt "text_id=15237 | speaker=unknown"
msgid "　なのに有珠の名前を聞いた瞬間、草十郎の背筋に冷たい物が走り抜けた。"
msgstr ""

#. Occurrence A_6:564:15238: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0016; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:564
msgctxt "text_id=15238 | speaker=touko"
msgid "「彼女、今ひどい状態なんだ。満足に歩けないどころか、体中の刻印が活性化して破裂寸前。草十郎くんが骨折の痛みを知ってるなら、うまい喩えようがあるんだけどね。"
msgstr ""

#. Occurrence A_6:570:15239: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0017; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:570
msgctxt "text_id=15239 | speaker=touko"
msgid "　ま、ともかくだ。いつ気を失ってもおかしくない状態なんだけど―――災難なことに、怖い野犬に囲まれてるみたいなの。"
msgstr ""

#. Occurrence A_6:576:15240: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0018; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:576
msgctxt "text_id=15240 | speaker=touko"
msgid "　個人的な意見だけど、んー、十分もあれば骨しか残らない結末になるでしょうね」"
msgstr ""

#. Occurrence A_6:596:15241: scene=A_6
#: A_6:596
msgctxt "text_id=15241 | speaker=unknown"
msgid "　これっぽっちも信憑性のない、冗談のような話。"
msgstr ""

#. Occurrence A_6:601:15242: scene=A_6
#: A_6:601
msgctxt "text_id=15242 | speaker=unknown"
msgid "　それもとびきり出来の悪い。"
msgstr ""

#. Occurrence A_6:606:15243: scene=A_6
#: A_6:606
msgctxt "text_id=15243 | speaker=unknown"
msgid "　だが、草十郎はすべて現実だと受け入れた。"
msgstr ""

#. Occurrence A_6:611:15244: scene=A_6
#: A_6:611
msgctxt "text_id=15244 | speaker=unknown"
msgid "　橙子の言葉に嘘はない。"
msgstr ""

#. Occurrence A_6:616:15245: scene=A_6
#: A_6:616
msgctxt "text_id=15245 | speaker=unknown"
msgid "　都会の犬が人を襲うなんて話は聞かないけれど、先ほどの有珠の電話にあった違和感―――騒がしかった雑音の正体に、草十郎はようやく思い至った。"
msgstr ""

#. Occurrence A_6:627:15246: scene=A_6
#: A_6:627
msgctxt "text_id=15246 | speaker=unknown"
msgid "　あれは間違いなく、群れをなして獲物を囲む、犬たちの唸り声だったのだ。"
msgstr ""

#. Occurrence A_6:648:15247: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0004; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:648
msgctxt "text_id=15247 | speaker=soujuurou"
msgid "「っ………！」"
msgstr ""

#. Occurrence A_6:653:15248: scene=A_6
#: A_6:653
msgctxt "text_id=15248 | speaker=unknown"
msgid "　なぜあの時に気付かなかったのか。"
msgstr ""

#. Occurrence A_6:658:15249: scene=A_6
#: A_6:658
msgctxt "text_id=15249 | speaker=unknown"
msgid "　受話器を強く握り締めて、草十郎は自分を呪う。"
msgstr ""

#. Occurrence A_6:663:15250: scene=A_6
#: A_6:663
msgctxt "text_id=15250 | speaker=unknown"
msgid "　つい数分前の有珠の言葉は、彼女にとって精一杯の、助けを呼ぶ声だった。"
msgstr ""

#. Occurrence A_6:683:15251: scene=A_6
#: A_6:683
msgctxt "text_id=15251 | speaker=unknown"
msgid "　青子以上に草十郎を関わらせまいとする有珠は、絶望的な状況でも、彼に助けを求める事はしなかった。"
msgstr ""

#. Occurrence A_6:688:15252: scene=A_6
#: A_6:688
msgctxt "text_id=15252 | speaker=unknown"
msgid "　……けれど、それでも、最後の最後で助けを求めた。"
msgstr ""

#. Occurrence A_6:694:15253: scene=A_6
#: A_6:694
msgctxt "text_id=15253 | speaker=unknown"
msgid "　か細い声で、彼女が彼の名前を呼んだあの時に。"
msgstr ""

#. Occurrence A_6:715:15254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0005; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:715
msgctxt "text_id=15254 | speaker=soujuurou"
msgid "「場所は」"
msgstr ""

#. Occurrence A_6:721:15255: scene=A_6
#: A_6:721
msgctxt "text_id=15255 | speaker=unknown"
msgid "　簡潔に問いただす。"
msgstr ""

#. Occurrence A_6:726:15256: scene=A_6
#: A_6:726
msgctxt "text_id=15256 | speaker=unknown"
msgid "　橙子が敵である事を思い知った草十郎だが、彼女なら場所を教えてくれるという確信がある。"
msgstr ""

#. Occurrence A_6:731:15257: scene=A_6
#: A_6:731
msgctxt "text_id=15257 | speaker=unknown"
msgid "　そのために、橙子はここに電話をしたのだから。"
msgstr ""

#. Occurrence A_6:752:15258: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0019; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:752
msgctxt "text_id=15258 | speaker=touko"
msgid "「教えてあげてもいいけど、そうした瞬間に君は私の敵になるのよ。その覚悟はある？」"
msgstr ""

#. Occurrence A_6:758:15259: scene=A_6
#: A_6:758
msgctxt "text_id=15259 | speaker=unknown"
msgid "　そういう事か、と草十郎は納得した。"
msgstr ""

#. Occurrence A_6:763:15260: scene=A_6
#: A_6:763
msgctxt "text_id=15260 | speaker=unknown"
msgid "　たしかに、これは試されている。"
msgstr ""

#. Occurrence A_6:768:15261: scene=A_6
#: A_6:768
msgctxt "text_id=15261 | speaker=unknown"
msgid "　ここで有珠を無視すれば、自分は彼女たちと無関係だと証明できる。"
msgstr ""

#. Occurrence A_6:773:15262: scene=A_6
#: A_6:773
msgctxt "text_id=15262 | speaker=unknown"
msgid "　けれど助けに行くのなら―――"
msgstr ""

#. Occurrence A_6:794:15263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0006; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:794
msgctxt "text_id=15263 | speaker=soujuurou"
msgid "「それで、場所は？」"
msgstr ""

#. Occurrence A_6:806:15264: scene=A_6
#: A_6:806
msgctxt "text_id=15264 | speaker=unknown"
msgid "　橙子の問いには答えず、草十郎はそれだけを聞き返した。"
msgstr ""

#. Occurrence A_6:811:15265: scene=A_6
#: A_6:811
msgctxt "text_id=15265 | speaker=unknown"
msgid "　覚悟なんて一生できないし、後悔だって尽きる事はない。"
msgstr ""

#. Occurrence A_6:816:15266: scene=A_6
#: A_6:816
msgctxt "text_id=15266 | speaker=unknown"
msgid "　だいたいはじめから、彼には明確な判断基準が失われている。"
msgstr ""

#. Occurrence A_6:821:15267: scene=A_6
#: A_6:821
msgctxt "text_id=15267 | speaker=unknown"
msgid "　だから、何であれ一番初めに感じた事を大事にしようと思ったのだ。"
msgstr ""

#. Occurrence A_6:826:15268: scene=A_6
#: A_6:826
msgctxt "text_id=15268 | speaker=unknown"
msgid "　それが山から下りてきてからの、彼の数少ない<矜持|きょうじ>だった。"
msgstr ""

#. Occurrence A_6:847:15269: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0020; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:847
msgctxt "text_id=15269 | speaker=touko"
msgid "「……そ。ちょっと残念だな、私はホントに君が気に入ってたのに。ま、こうなる事は分かってたけどね。"
msgstr ""

#. Occurrence A_6:853:15270: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0021; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:853
msgctxt "text_id=15270 | speaker=touko"
msgid "　場所は社木の森林公園。受話器の下に地図があるでしょ？この前、帰りがけに栞をはさんでおいたからそれを参考にすること。"
msgstr ""

#. Occurrence A_6:859:15271: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0022; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:859
msgctxt "text_id=15271 | speaker=touko"
msgid "　繰り返すようだけど、十分持てば幸運。その後は一分ごとに奇跡の価値があがるような状況よ、今の彼女は」"
msgstr ""

#. Occurrence A_6:879:15272: scene=A_6
#: A_6:879
msgctxt "text_id=15272 | speaker=unknown"
msgid "　橙子の説明を聞きながら、ぎり、と草十郎は苛立ちで顔を歪めた。"
msgstr ""

#. Occurrence A_6:884:15273: scene=A_6
#: A_6:884
msgctxt "text_id=15273 | speaker=unknown"
msgid "　ここ三咲町から社木は一駅離れている。"
msgstr ""

#. Occurrence A_6:889:15274: scene=A_6
#: A_6:889
msgctxt "text_id=15274 | speaker=unknown"
msgid "　今から洋館を出て駅に着くまで何分かかるだろう？"
msgstr ""

#. Occurrence A_6:894:15275: scene=A_6
#: A_6:894
msgctxt "text_id=15275 | speaker=unknown"
msgid "　いつもは二十分弱。"
msgstr ""

#. Occurrence A_6:899:15276: scene=A_6
#: A_6:899
msgctxt "text_id=15276 | speaker=unknown"
msgid "　そこから電車に乗って社木に着いた頃には、もう三十分は経っている―――"
msgstr ""

#. Occurrence A_6:920:15277: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0023; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:920
msgctxt "text_id=15277 | speaker=touko"
msgid "「地図の上じゃ近いのに、区画整理された交通手段は不便よね。けど、急げば最終の電車には間に合うわ。ここで諦めた方が賢明だけど、君はもう私の敵だから。"
msgstr ""

#. Occurrence A_6:926:15278: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0024; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:926
msgctxt "text_id=15278 | speaker=touko"
msgid "　―――どっちにしたって、後悔のないようにね」"
msgstr ""

#. Occurrence A_6:947:15279: scene=A_6
#: A_6:947
msgctxt "text_id=15279 | speaker=unknown"
msgid "　電話はそこで切れた。"
msgstr ""

#. Occurrence A_6:952:15280: scene=A_6
#: A_6:952
msgctxt "text_id=15280 | speaker=unknown"
msgid "　橙子が切ったのではなく、草十郎が切ったのだ。"
msgstr ""

#. Occurrence A_6:959:15281: scene=A_6
#: A_6:959
msgctxt "text_id=15281 | speaker=unknown"
msgid "　地図を頭にいれて走りだす。"
msgstr ""

#. Occurrence A_6:965:15282: scene=A_6
#: A_6:965
msgctxt "text_id=15282 | speaker=unknown"
msgid "　上着を取りにいく時間も惜しい。草十郎は着の身着のままで、まだ雪の残る冬の夜へと駆け出していく。"
msgstr ""

#. Occurrence A_6:985:15283: scene=A_6
#: A_6:985
msgctxt "text_id=15283 | speaker=unknown"
msgid "　ホールには放り出されたままの地図だけが残っていた。"
msgstr ""

#. Occurrence A_6:990:15284: scene=A_6
#: A_6:990
msgctxt "text_id=15284 | speaker=unknown"
msgid "　開かれたページには三咲市の地図がある。"
msgstr ""

#. Occurrence A_6:995:15285: scene=A_6
#: A_6:995
msgctxt "text_id=15285 | speaker=unknown"
msgid "　この洋館から森林公園まで、距離にして約１５キロ。"
msgstr ""

#. Occurrence A_6:1007:15286: scene=A_6
#: A_6:1007
msgctxt "text_id=15286 | speaker=unknown"
msgid "　直線で結べばその三分の一もないというのに、都会の道は本当に不便だ。"
msgstr ""

#. Occurrence A_6:1012:15287: scene=A_6
#: A_6:1012
msgctxt "text_id=15287 | speaker=unknown"
msgid "　<都市|ここ>では十センチもない紙上の距離が何倍にもなってしまう事を、草十郎ははじめて呪いたくなった。"
msgstr ""

#. Occurrence A_7:79:15288: scene=A_7
#: A_7:79
msgctxt "text_id=15288 | speaker=unknown"
msgid "　有珠が裂かれたのは腹部だけではなかった。"
msgstr ""

#. Occurrence A_7:84:15289: scene=A_7
#: A_7:84
msgctxt "text_id=15289 | speaker=unknown"
msgid "　正確には腹を貫通して背中まで。"
msgstr ""

#. Occurrence A_7:90:15290: scene=A_7
#: A_7:90
msgctxt "text_id=15290 | speaker=unknown"
msgid "腰のやや上にある<脊椎|せきつい>まで砕かれた有珠の両足は、ぴくりとも動かなかった。"
msgstr ""

#. Occurrence A_7:95:15291: scene=A_7
#: A_7:95
msgctxt "text_id=15291 | speaker=unknown"
msgid "　いずれ魔術刻印によって復元するにしろ、最短であと一時間。"
msgstr ""

#. Occurrence A_7:100:15292: scene=A_7
#: A_7:100
msgctxt "text_id=15292 | speaker=unknown"
msgid "　かろうじて動くのは心臓と、細い両手だけ。"
msgstr ""

#. Occurrence A_7:141:15293: scene=A_7
#: A_7:141
msgctxt "text_id=15293 | speaker=unknown"
msgid "　その希望も、地を這って電話ボックスに入った時点で、もう満足に動かなかった。"
msgstr ""

#. Occurrence A_7:146:15294: scene=A_7
#: A_7:146
msgctxt "text_id=15294 | speaker=unknown"
msgid "　腹部の傷を癒すために起動した刻印は、凶悪な炉熱を放って、有珠の小さな体を押し潰そうとする。"
msgstr ""

#. Occurrence A_7:152:15295: scene=A_7
#: A_7:152
msgctxt "text_id=15295 | speaker=unknown"
msgid "　―――自分の体が自分の物でなく、何か得体の知れない、別の生き物に変わっていく感覚。"
msgstr ""

#. Occurrence A_7:172:15296: scene=A_7
#: A_7:172
msgctxt "text_id=15296 | speaker=unknown"
msgid "　裂かれた腹部に渦巻く猛毒は、痛いというより辛い。"
msgstr ""

#. Occurrence A_7:177:15297: scene=A_7
#: A_7:177
msgctxt "text_id=15297 | speaker=unknown"
msgid "　痛みには慣れているが、この不快感だけは慣れようがない。"
msgstr ""

#. Occurrence A_7:182:15298: scene=A_7
#: A_7:182
msgctxt "text_id=15298 | speaker=unknown"
msgid "　慣れた時には、彼女はもう彼女ではなくなっているのだから。"
msgstr ""

#. Occurrence A_7:207:15299: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0000; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:207
msgctxt "text_id=15299 | speaker=alice"
msgid "「……、―――」"
msgstr ""

#. Occurrence A_7:213:15300: scene=A_7
#: A_7:213
msgctxt "text_id=15300 | speaker=unknown"
msgid "　腹部の痛みと、魔術刻印による不快感。"
msgstr ""

#. Occurrence A_7:218:15301: scene=A_7
#: A_7:218
msgctxt "text_id=15301 | speaker=unknown"
msgid "　いつ消えてもおかしくない意識の中、有珠は受話器を手に取った。"
msgstr ""

#. Occurrence A_7:269:15302: scene=A_7
#: A_7:269
msgctxt "text_id=15302 | speaker=unknown"
msgid "　青子が帰還している可能性は低い。"
msgstr ""

#. Occurrence A_7:274:15303: scene=A_7
#: A_7:274
msgctxt "text_id=15303 | speaker=unknown"
msgid "　それを知りながら洋館に電話をしたのは、電話ボックスに集まりだした野犬達の目つきに<圧|お>されての事かもしれない。"
msgstr ""

#. Occurrence A_7:279:15304: scene=A_7
#: A_7:279
msgctxt "text_id=15304 | speaker=unknown"
msgid "　けれど、電話に出たのは草十郎だった。"
msgstr ""

#. Occurrence A_7:286:15305: scene=A_7
#: A_7:286
msgctxt "text_id=15305 | speaker=unknown"
msgid "　関係のない彼なら無言で切るべきだったのに、有珠は名前を呼んでしまった。"
msgstr ""

#. Occurrence A_7:306:15306: scene=A_7
#: A_7:306
msgctxt "text_id=15306 | speaker=unknown"
msgid "　……長い沈黙と葛藤の末、受話器ごしに凡庸な草十郎の顔が思い出されて、有珠はなんとか電話を切った。"
msgstr ""

#. Occurrence A_7:311:15307: scene=A_7
#: A_7:311
msgctxt "text_id=15307 | speaker=unknown"
msgid "　どうあっても彼を関わらせるのはいけない、そう本能が律したのだ。"
msgstr ""

#. Occurrence A_7:389:15308: scene=A_7
#: A_7:389
msgctxt "text_id=15308 | speaker=unknown"
msgid "　……それは、一般人だからとか、そんな事とは関係なく。"
msgstr ""

#. Occurrence A_7:395:15309: scene=A_7
#: A_7:395
msgctxt "text_id=15309 | speaker=unknown"
msgid "　あの日ささやかな秘密を共有した時から、少女にとって、静希草十郎はそういう風に映っていた。"
msgstr ""

#. Occurrence A_7:416:15310: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0001; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:416
msgctxt "text_id=15310 | speaker=alice"
msgid "「…………、―――――――――」"
msgstr ""

#. Occurrence A_7:422:15311: scene=A_7
#: A_7:422
msgctxt "text_id=15311 | speaker=unknown"
msgid "　喉からこぼれる息が、細い。"
msgstr ""

#. Occurrence A_7:461:15312: scene=A_7
#: A_7:461
msgctxt "text_id=15312 | speaker=unknown"
msgid "　頭上の月が薄らいでいく。"
msgstr ""

#. Occurrence A_7:467:15313: scene=A_7
#: A_7:467
msgctxt "text_id=15313 | speaker=unknown"
msgid "　降り始めた雪が遠くなっていく。"
msgstr ""

#. Occurrence A_7:472:15314: scene=A_7
#: A_7:472
msgctxt "text_id=15314 | speaker=unknown"
msgid "　周囲からは野犬たちの騒ぎ声。どん、と電話ボックスに体当たりをする音も聞こえだした。"
msgstr ""

#. Occurrence A_7:478:15315: scene=A_7
#: A_7:478
msgctxt "text_id=15315 | speaker=unknown"
msgid "　……少女は最後に大きく息をついて、目蓋を閉じる。"
msgstr ""

#. Occurrence A_7:505:15316: scene=A_7
#: A_7:505
msgctxt "text_id=15316 | speaker=unknown"
msgid "　硝子の<棺|ひつぎ>の中で意識を手放す。"
msgstr ""

#. Occurrence A_7:511:15317: scene=A_7
#: A_7:511
msgctxt "text_id=15317 | speaker=unknown"
msgid "　少年に助けを乞わなかった事を最後まで正しく、そして不思議に思いながら。"
msgstr ""

#. Occurrence A_7:536:15318: scene=A_7
#: A_7:536
msgctxt "text_id=15318 | speaker=unknown"
msgid "　　　　　―――合間。"
msgstr ""

msgctxt "text_id=15319 | speaker=unknown"
msgid "おかしな風景を見た。"
msgstr ""

#. Occurrence A_7:582:15320: scene=A_7
#: A_7:582
msgctxt "text_id=15320 | speaker=unknown"
msgid "　一面に花が咲き乱れた野原。"
msgstr ""

#. Occurrence A_7:588:15321: scene=A_7
#: A_7:588
msgctxt "text_id=15321 | speaker=unknown"
msgid "　雲ひとつない空は青すぎて、"
msgstr ""

#. Occurrence A_7:594:15322: scene=A_7
#: A_7:594
msgctxt "text_id=15322 | speaker=unknown"
msgid "　野原いっぱいの花は白すぎて、"
msgstr ""

#. Occurrence A_7:600:15323: scene=A_7
#: A_7:600
msgctxt "text_id=15323 | speaker=unknown"
msgid "　こんなにも美しいのに、目を<背|そむ>けたくて仕方がない。"
msgstr ""

#. Occurrence A_7:620:15324: scene=A_7
#: A_7:620
msgctxt "text_id=15324 | speaker=unknown"
msgid "　……それはたぶん、冬の出来事だった。"
msgstr ""

#. Occurrence A_7:626:15325: scene=A_7
#: A_7:626
msgctxt "text_id=15325 | speaker=unknown"
msgid "　冷たい風は人里離れた<桃源|とうげん>の匂いがして、太陽すら人の<手|て><垢|あか>に汚れていない。"
msgstr ""

#. Occurrence A_7:632:15326: scene=A_7
#: A_7:632
msgctxt "text_id=15326 | speaker=unknown"
msgid "　楽土と錯覚する<彼岸|ひがん>の原。"
msgstr ""

#. Occurrence A_7:637:15327: scene=A_7
#: A_7:637
msgctxt "text_id=15327 | speaker=unknown"
msgid "　そう言えば、<弔|とむら>いは悲しいものなのに、いつも<華|はな>やかな事を思い出す。"
msgstr ""

#. Occurrence A_7:658:15328: scene=A_7
#: A_7:658
msgctxt "text_id=15328 | speaker=unknown"
msgid "　……<嗚|あ><呼|あ>。"
msgstr ""

#. Occurrence A_7:663:15329: scene=A_7
#: A_7:663
msgctxt "text_id=15329 | speaker=unknown"
msgid "　なのに不釣り合いな呻き声と、<生命|いのち>の音がする。"
msgstr ""

#. Occurrence A_7:668:15330: scene=A_7
#: A_7:668
msgctxt "text_id=15330 | speaker=unknown"
msgid "　断片的にこぼれる<吐|い><息|き>は<絞|しぼ>るように。"
msgstr ""

#. Occurrence A_7:673:15331: scene=A_7
#: A_7:673
msgctxt "text_id=15331 | speaker=unknown"
msgid "　痛みを訴えるはずの<感情|しんぞう>は、<虚|うつ>ろになって機能不全。"
msgstr ""

#. Occurrence A_7:678:15332: scene=A_7
#: A_7:678
msgctxt "text_id=15332 | speaker=unknown"
msgid "　切断するかのような締め付けは胴と頭の中間に。"
msgstr ""

#. Occurrence A_7:683:15333: scene=A_7
#: A_7:683
msgctxt "text_id=15333 | speaker=unknown"
msgid "　女は泣きながら、鳴き声ひとつあげぬ幼子の―――"
msgstr ""

#. Occurrence A_7:704:15334: scene=A_7
#: A_7:704
msgctxt "text_id=15334 | speaker=unknown"
msgid "　空は高く、森は深く、人は途絶え。"
msgstr ""

#. Occurrence A_7:710:15335: scene=A_7
#: A_7:710
msgctxt "text_id=15335 | speaker=unknown"
msgid "　駆けつける足音も、助けを求める<意|こ><思|え>もない。"
msgstr ""

#. Occurrence A_7:716:15336: scene=A_7
#: A_7:716
msgctxt "text_id=15336 | speaker=unknown"
msgid "　そんな静けさの中で、無心で空を見上げていたのは、一体、誰だったのだろう―――"
msgstr ""

#. Occurrence A_7:782:15337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0002; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:782
msgctxt "text_id=15337 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence A_7:819:15338: scene=A_7
#: A_7:819
msgctxt "text_id=15338 | speaker=unknown"
msgid "　気が付くと、有珠は見慣れた坂を上っていた。"
msgstr ""

#. Occurrence A_7:824:15339: scene=A_7
#: A_7:824
msgctxt "text_id=15339 | speaker=unknown"
msgid "　夜気は冷たく、手足は凍てついたように動かない。"
msgstr ""

#. Occurrence A_7:829:15340: scene=A_7
#: A_7:829
msgctxt "text_id=15340 | speaker=unknown"
msgid "　当然と言えば当然だが、金狼によって裂かれた腹部は剥きだしで、体はしきりに震えていた。"
msgstr ""

#. Occurrence A_7:867:15341: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0003; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:867
msgctxt "text_id=15341 | speaker=alice"
msgid "「……静希……君？」"
msgstr ""

#. Occurrence A_7:873:15342: scene=A_7
#: A_7:873
msgctxt "text_id=15342 | speaker=unknown"
msgid "　自分がその人物におぶられて白犬塚の坂を登っている事を、有珠はうつろな意識で認めた。"
msgstr ""

#. Occurrence A_7:905:15343: scene=A_7
#: A_7:905
msgctxt "text_id=15343 | speaker=unknown"
msgid "　草十郎は有珠を背中におぶったまま、無言で坂を上っていた。"
msgstr ""

#. Occurrence A_7:910:15344: scene=A_7
#: A_7:910
msgctxt "text_id=15344 | speaker=unknown"
msgid "　落ち着いた瞳は、寒さのせいか辛そうな色をしている。"
msgstr ""

#. Occurrence A_7:915:15345: scene=A_7
#: A_7:915
msgctxt "text_id=15345 | speaker=unknown"
msgid "　見れば、この寒さの中で歩き回る服装ではなかった。"
msgstr ""

#. Occurrence A_7:920:15346: scene=A_7
#: A_7:920
msgctxt "text_id=15346 | speaker=unknown"
msgid "　草十郎は上着も着ておらず、首もとや手の平が哀れなほど冷えきっている。"
msgstr ""

#. Occurrence A_7:941:15347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0004; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:941
msgctxt "text_id=15347 | speaker=alice"
msgid "「……どうして、ここにいるの……？」"
msgstr ""

#. Occurrence A_7:949:15348: scene=A_7
#: A_7:949
msgctxt "text_id=15348 | speaker=unknown"
msgid "　おぶられたまま有珠は問うた。"
msgstr ""

#. Occurrence A_7:954:15349: scene=A_7
#: A_7:954
msgctxt "text_id=15349 | speaker=unknown"
msgid "　体を起こしたくても力が入らない。"
msgstr ""

#. Occurrence A_7:959:15350: scene=A_7
#: A_7:959
msgctxt "text_id=15350 | speaker=unknown"
msgid "　自分の重さがすべて他人に預けられている事が、今はひどく気にかかる。"
msgstr ""

#. Occurrence A_7:993:15351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0000; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:993
msgctxt "text_id=15351 | speaker=soujuurou"
msgid "「橙子さんから電話があった。有珠が危ないって。"
msgstr ""

#. Occurrence A_7:999:15352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0001; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:999
msgctxt "text_id=15352 | speaker=soujuurou"
msgid "　……蒼崎はともかく、有珠は意地を張りすぎだ。あの状況で助けを呼ばないのはどうかしてる。そりゃあ、自分が行っても何もできなかっただろうけど」"
msgstr ""

#. Occurrence A_7:1019:15353: scene=A_7
#: A_7:1019
msgctxt "text_id=15353 | speaker=unknown"
msgid "　草十郎は前だけを見つめて、叱るように返答した。"
msgstr ""

#. Occurrence A_7:1024:15354: scene=A_7
#: A_7:1024
msgctxt "text_id=15354 | speaker=unknown"
msgid "　その叱責は背中の少女に向けたものではなく、力になれなかった自分に対してのものだ。"
msgstr ""

#. Occurrence A_7:1071:15355: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0005; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1071
msgctxt "text_id=15355 | speaker=alice"
msgid "「…………静希君は、関係ないもの」"
msgstr ""

#. Occurrence A_7:1077:15356: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0002; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1077
msgctxt "text_id=15356 | speaker=soujuurou"
msgid "「だろうね。けど、これで関係はできた。館についたら話してもらうぞ」"
msgstr ""

#. Occurrence A_7:1097:15357: scene=A_7
#: A_7:1097
msgctxt "text_id=15357 | speaker=unknown"
msgid "　草十郎はとにかく坂を登っていく。"
msgstr ""

#. Occurrence A_7:1102:15358: scene=A_7
#: A_7:1102
msgctxt "text_id=15358 | speaker=unknown"
msgid "　……考えてみれば、洋館までの坂は段々ときつくなっていく。"
msgstr ""

#. Occurrence A_7:1107:15359: scene=A_7
#: A_7:1107
msgctxt "text_id=15359 | speaker=unknown"
msgid "　その坂を、自分を背負ったまま登っていく草十郎に、有珠は意外なものを見た気がした。"
msgstr ""

#. Occurrence A_7:1141:15360: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0006; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1141
msgctxt "text_id=15360 | speaker=alice"
msgid "「降りるわ、もう大丈夫だから」"
msgstr ""

#. Occurrence A_7:1147:15361: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0003; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1147
msgctxt "text_id=15361 | speaker=soujuurou"
msgid "「お腹をむきだしでかい。このほうが少しは暖かいよ。"
msgstr ""

#. Occurrence A_7:1153:15362: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0004; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1153
msgctxt "text_id=15362 | speaker=soujuurou"
msgid "　それに、有珠は薪より軽い。山じゃこの程度は朝飯前だから気にしないでくれ。息があがっているのは公園まで急いだからだし。"
msgstr ""

#. Occurrence A_7:1160:15363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0005; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1160
msgctxt "text_id=15363 | speaker=soujuurou"
msgid "……まあ、その意味はなかったんだが」"
msgstr ""

#. Occurrence A_7:1177:15364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0007; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1177
msgctxt "text_id=15364 | speaker=alice"
msgid "「……なぜ？」"
msgstr ""

#. Occurrence A_7:1198:15365: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0006; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1198
msgctxt "text_id=15365 | speaker=soujuurou"
msgid "「俺が着いたら、犬はさっさと散っていった。はじめから、橙子さんはそういうつもりだったんだ。"
msgstr ""

#. Occurrence A_7:1214:15366: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0007; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1214
msgctxt "text_id=15366 | speaker=soujuurou"
msgid "　有珠をどうにかするつもりもなければ、時間制限もなかった。喜ぶべき事なんだろうけど」"
msgstr ""

#. Occurrence A_7:1234:15367: scene=A_7
#: A_7:1234
msgctxt "text_id=15367 | speaker=unknown"
msgid "　憮然と言う草十郎。"
msgstr ""

#. Occurrence A_7:1239:15368: scene=A_7
#: A_7:1239
msgctxt "text_id=15368 | speaker=unknown"
msgid "　けれど、それは彼だけの勘違いだ。"
msgstr ""

#. Occurrence A_7:1244:15369: scene=A_7
#: A_7:1244
msgctxt "text_id=15369 | speaker=unknown"
msgid "　橙子に殺意はなかったが、結果として有珠が死んでしまう事には何の罪悪感もなかっただろう。"
msgstr ""

#. Occurrence A_7:1277:15370: scene=A_7
#: A_7:1277
msgctxt "text_id=15370 | speaker=unknown"
msgid "　……有珠は思う。"
msgstr ""

#. Occurrence A_7:1282:15371: scene=A_7
#: A_7:1282
msgctxt "text_id=15371 | speaker=unknown"
msgid "　この少年がどれほどの速さで公園に着いたかは知らないけれど、彼が来なければ間違いなく電話ボックスは破られて、自分は生きてはいなかったと。"
msgstr ""

#. Occurrence A_7:1322:15372: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0008; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1322
msgctxt "text_id=15372 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence A_7:1328:15373: scene=A_7
#: A_7:1328
msgctxt "text_id=15373 | speaker=unknown"
msgid "　有珠は様々な所感、感情をのど元で押し止める。"
msgstr ""

#. Occurrence A_7:1333:15374: scene=A_7
#: A_7:1333
msgctxt "text_id=15374 | speaker=unknown"
msgid "　言っても仕方のない事だし、草十郎の甘い勘違いを正すのも気が引けたからだ。"
msgstr ""

#. Occurrence A_7:1338:15375: scene=A_7
#: A_7:1338
msgctxt "text_id=15375 | speaker=unknown"
msgid "　……ただ。言いかけた<感謝|ことば>を飲み込むのは、傷を堪える事より辛かっただけ。"
msgstr ""

#. Occurrence A_7:1386:15376: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0009; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1386
msgctxt "text_id=15376 | speaker=alice"
msgid "「……もしかして、公園からずっと？」"
msgstr ""

#. Occurrence A_7:1416:15377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0008; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1416
msgctxt "text_id=15377 | speaker=soujuurou"
msgid "「仕方ないだろ。電車、終わってたんだから。タクシーを使えば良かったんだけど、あいにく持ち合わせがなくて。"
msgstr ""

#. Occurrence A_7:1422:15378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0009; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1422
msgctxt "text_id=15378 | speaker=soujuurou"
msgid "　……ほんと。今日ほどお金の不便さを思い知った日はない」"
msgstr ""

#. Occurrence A_7:1442:15379: scene=A_7
#: A_7:1442
msgctxt "text_id=15379 | speaker=unknown"
msgid "　少年はようやくため息らしきものをついた。"
msgstr ""

#. Occurrence A_7:1447:15380: scene=A_7
#: A_7:1447
msgctxt "text_id=15380 | speaker=unknown"
msgid "　休み休みとは言え、彼は実に十キロ近い距離をこうして踏破してきた。"
msgstr ""

#. Occurrence A_7:1452:15381: scene=A_7
#: A_7:1452
msgctxt "text_id=15381 | speaker=unknown"
msgid "　疲れきっているだろうに、草十郎はその困難さより、自分の頼りなさに呆れたらしい。"
msgstr ""

#. Occurrence A_7:1490:15382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0010; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1490
msgctxt "text_id=15382 | speaker=alice"
msgid "「……でも。それを言うなら、お金の大切さ、じゃない？」"
msgstr ""

#. Occurrence A_7:1496:15383: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0010; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1496
msgctxt "text_id=15383 | speaker=soujuurou"
msgid "「使えるものがあるのにお金がないだけで使えないんだから、それって不便って言わないか？」"
msgstr ""

#. Occurrence A_7:1503:15384: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0011; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1503
msgctxt "text_id=15384 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence A_7:1508:15385: scene=A_7
#: A_7:1508
msgctxt "text_id=15385 | speaker=unknown"
msgid "　純粋な疑問に、有珠は一時、傷の痛みを忘れてしまった。"
msgstr ""

#. Occurrence A_7:1513:15386: scene=A_7
#: A_7:1513
msgctxt "text_id=15386 | speaker=unknown"
msgid "　自分も、それなりに文明社会とは縁がないつもりだったけれど。"
msgstr ""

#. Occurrence A_7:1518:15387: scene=A_7
#: A_7:1518
msgctxt "text_id=15387 | speaker=unknown"
msgid "　この少年の素朴さに比べれば、ちゃんと文明人らしいのだ。"
msgstr ""

#. Occurrence A_7:1554:15388: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0012; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1554
msgctxt "text_id=15388 | speaker=alice"
msgid "「なにか、貴方らしいわ」"
msgstr ""

#. Occurrence A_7:1560:15389: scene=A_7
#: A_7:1560
msgctxt "text_id=15389 | speaker=unknown"
msgid "　気付かれない様に小さく笑う。"
msgstr ""

#. Occurrence A_7:1565:15390: scene=A_7
#: A_7:1565
msgctxt "text_id=15390 | speaker=unknown"
msgid "　有珠が顔をあずけると、こつん、と柔らかいものが頬に当たった。"
msgstr ""

#. Occurrence A_7:1570:15391: scene=A_7
#: A_7:1570
msgctxt "text_id=15391 | speaker=unknown"
msgid "　少年の首に巻かれた、青子からの首輪だった。"
msgstr ""

#. Occurrence A_7:1603:15392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0011; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1603
msgctxt "text_id=15392 | speaker=soujuurou"
msgid "「館についたら着替えるんだ。お腹の血も拭って、落ち着いたら居間で話そう。"
msgstr ""

#. Occurrence A_7:1609:15393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0012; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1609
msgctxt "text_id=15393 | speaker=soujuurou"
msgid "　橙子さんに言わせれば、俺もこれで敵らしいから」"
msgstr ""

#. Occurrence A_7:1657:15394: scene=A_7
#: A_7:1657
msgctxt "text_id=15394 | speaker=unknown"
msgid "　その言葉を有珠が聞いた時、彼はもう坂を登りきっていた。"
msgstr ""

#. Occurrence A_7:1662:15395: scene=A_7
#: A_7:1662
msgctxt "text_id=15395 | speaker=unknown"
msgid "　森の入り口にあたる正門。その奥には、月明かりの下に佇む彼女の洋館がある。"
msgstr ""

#. Occurrence A_7:1667:15396: scene=A_7
#: A_7:1667
msgctxt "text_id=15396 | speaker=unknown"
msgid "　それを見上げて、少女は少しだけ残念に思った。"
msgstr ""

#. Occurrence A_7:1719:15397: scene=A_7
#: A_7:1719
msgctxt "text_id=15397 | speaker=unknown"
msgid "　……もちろん。"
msgstr ""

#. Occurrence A_7:1724:15398: scene=A_7
#: A_7:1724
msgctxt "text_id=15398 | speaker=unknown"
msgid "　何を残念に思ったのかは、気が付く事はなかったけれど。"
msgstr ""

#. Occurrence A_8:51:15399: scene=A_8
#: A_8:51
msgctxt "text_id=15399 | speaker=unknown"
msgid "　ロビーに着くと、有珠は草十郎の背中から降り、西館に向かって歩きだした。"
msgstr ""

#. Occurrence A_8:56:15400: scene=A_8
#: A_8:56
msgctxt "text_id=15400 | speaker=unknown"
msgid "　洋館の左翼、ロビーから西は彼女の管轄である。"
msgstr ""

#. Occurrence A_8:65:15401: scene=A_8
#: A_8:65
msgctxt "text_id=15401 | speaker=unknown"
msgid "　が。有珠は数歩もしないうち、床に崩れ落ちてしまった。"
msgstr ""

#. Occurrence A_8:88:15402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0000; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:88
msgctxt "text_id=15402 | speaker=soujuurou"
msgid "「有珠……！」"
msgstr ""

#. Occurrence A_8:130:15403: scene=A_8
#: A_8:130
msgctxt "text_id=15403 | speaker=unknown"
msgid "　草十郎が駆け寄ると、有珠は座りこんだまま片手を上げた。"
msgstr ""

#. Occurrence A_8:135:15404: scene=A_8
#: A_8:135
msgctxt "text_id=15404 | speaker=unknown"
msgid "　それ以上は近付かないで、と告げるように。"
msgstr ""

#. Occurrence A_8:140:15405: scene=A_8
#: A_8:140
msgctxt "text_id=15405 | speaker=unknown"
msgid "　草十郎は苦い顔付きで足を止める。"
msgstr ""

#. Occurrence A_8:145:15406: scene=A_8
#: A_8:145
msgctxt "text_id=15406 | speaker=unknown"
msgid "　……少女の白い肌には汗がにじんでいる。"
msgstr ""

#. Occurrence A_8:150:15407: scene=A_8
#: A_8:150
msgctxt "text_id=15407 | speaker=unknown"
msgid "　いつも無表情の顔は、苦しそうに痛みに耐えていた。"
msgstr ""

#. Occurrence A_8:190:15408: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0000; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:190
msgctxt "text_id=15408 | speaker=alice"
msgid "「……平気。部屋に戻るぐらいの力は戻ったわ。服を<繕|つくろ>ってくるから、貴方はここにいて。"
msgstr ""

#. Occurrence A_8:196:15409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0001; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:196
msgctxt "text_id=15409 | speaker=alice"
msgid "　すぐに戻ってくるから、そうしたら―――」"
msgstr ""

#. Occurrence A_8:202:15410: scene=A_8
#: A_8:202
msgctxt "text_id=15410 | speaker=unknown"
msgid "　きちんと話をする、と苦しげな目が伝えてくる。"
msgstr ""

#. Occurrence A_8:235:15411: scene=A_8
#: A_8:235
msgctxt "text_id=15411 | speaker=unknown"
msgid "　そう言われては止める事もできない。"
msgstr ""

#. Occurrence A_8:240:15412: scene=A_8
#: A_8:240
msgctxt "text_id=15412 | speaker=unknown"
msgid "　辛いのは有珠の方で、断じて自分ではない、と草十郎は自分に言い聞かせる。"
msgstr ""

#. Occurrence A_8:260:15413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0001; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:260
msgctxt "text_id=15413 | speaker=soujuurou"
msgid "「……それじゃあ、戻ってきたら話を聞かせてくれ」"
msgstr ""

#. Occurrence A_8:284:15414: scene=A_8
#: A_8:284
msgctxt "text_id=15414 | speaker=unknown"
msgid "　有珠は深呼吸をしてから、確かな足取りで洋館の西館へ消えていった。"
msgstr ""

#. Occurrence A_8:341:15415: scene=A_8
#: A_8:341
msgctxt "text_id=15415 | speaker=unknown"
msgid "　……時間にすれば五分もない空白。"
msgstr ""

#. Occurrence A_8:352:15416: scene=A_8
#: A_8:352
msgctxt "text_id=15416 | speaker=unknown"
msgid "　有珠は代えの黒衣に着替えて戻ってきた。"
msgstr ""

#. Occurrence A_8:357:15417: scene=A_8
#: A_8:357
msgctxt "text_id=15417 | speaker=unknown"
msgid "　顔色は一向に良くはならない。"
msgstr ""

#. Occurrence A_8:367:15418: scene=A_8
#: A_8:367
msgctxt "text_id=15418 | speaker=unknown"
msgid "　小さく息をついて、いつかのように、ロビーの柱に背中を預けて座りこむ。"
msgstr ""

#. Occurrence A_8:400:15419: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0002; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:400
msgctxt "text_id=15419 | speaker=soujuurou"
msgid "「有珠。傷が痛むなら、無理せず横になったほうがいい」"
msgstr ""

#. Occurrence A_8:405:15420: scene=A_8
#: A_8:405
msgctxt "text_id=15420 | speaker=unknown"
msgid "　草十郎は有珠に合わせて、冷たい床に座りこむ。"
msgstr ""

#. Occurrence A_8:423:15421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0002; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:423
msgctxt "text_id=15421 | speaker=alice"
msgid "「……傷はもう痛まないわ。横になる必要もない。"
msgstr ""

#. Occurrence A_8:429:15422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0003; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:429
msgctxt "text_id=15422 | speaker=alice"
msgid "　この体の異常はナナカマドを飲まされたせいだから、どうあっても治らないもの」"
msgstr ""

#. Occurrence A_8:450:15423: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0003; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:450
msgctxt "text_id=15423 | speaker=soujuurou"
msgid "「じゃあ、せめて毛布とか」"
msgstr ""

#. Occurrence A_8:456:15424: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0004; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:456
msgctxt "text_id=15424 | speaker=alice"
msgid "「…………いいから、気遣いはしないで。ここなら寒さも関係ないから」"
msgstr ""

#. Occurrence A_8:462:15425: scene=A_8
#: A_8:462
msgctxt "text_id=15425 | speaker=unknown"
msgid "　寒さに関しては強がりではないらしい。"
msgstr ""

#. Occurrence A_8:467:15426: scene=A_8
#: A_8:467
msgctxt "text_id=15426 | speaker=unknown"
msgid "　いつかの青子の『有珠は洋館の中にいれば適温』説を思い出して、草十郎はあっさり引き下がった。"
msgstr ""

#. Occurrence A_8:500:15427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0004; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:500
msgctxt "text_id=15427 | speaker=soujuurou"
msgid "「……うん、あったかいのならいい。"
msgstr ""

#. Occurrence A_8:506:15428: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0005; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:506
msgctxt "text_id=15428 | speaker=soujuurou"
msgid "　それで、ナナカマドっていうのは？」"
msgstr ""

#. Occurrence A_8:512:15429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0005; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:512
msgctxt "text_id=15429 | speaker=alice"
msgid "「薬草の一種よ。七回<竃|かまど>で焼いても燃え残る事から付けられた名前で、効用は魔除け。"
msgstr ""

#. Occurrence A_8:531:15430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0006; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:531
msgctxt "text_id=15430 | speaker=alice"
msgid "　……普通の人にはよくない程度だけど、わたしや青子には少し厄介ね。体内での魔力生成そのものに抵抗されてしまうから、手の打ちようがない」"
msgstr ""

#. Occurrence A_8:552:15431: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0006; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:552
msgctxt "text_id=15431 | speaker=soujuurou"
msgid "「……毒、と思っていいのか？」"
msgstr ""

#. Occurrence A_8:589:15432: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0007; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:589
msgctxt "text_id=15432 | speaker=alice"
msgid "「いえ、本来は薬草よ。"
msgstr ""

#. Occurrence A_8:595:15433: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0008; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:595
msgctxt "text_id=15433 | speaker=alice"
msgid "　今は傷を治すために魔力を使っているから苦しいけど、傷が完治すれば大人しくなるわ。魔術さえ使わなければナナカマドも反応しないから。"
msgstr ""

#. Occurrence A_8:601:15434: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0009; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:601
msgctxt "text_id=15434 | speaker=alice"
msgid "　単純な話、ナナカマドを消化するまでわたしは役には立たないだけ」"
msgstr ""

#. Occurrence A_8:634:15435: scene=A_8
#: A_8:634
msgctxt "text_id=15435 | speaker=unknown"
msgid "　ただ。"
msgstr ""

#. Occurrence A_8:639:15436: scene=A_8
#: A_8:639
msgctxt "text_id=15436 | speaker=unknown"
msgid "　それが何日かかるかを、有珠は口にはしなかった。"
msgstr ""

#. Occurrence A_8:672:15437: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0010; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:672
msgctxt "text_id=15437 | speaker=alice"
msgid "「……別に、静希君が心配することじゃないわ。"
msgstr ""

#. Occurrence A_8:678:15438: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0011; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:678
msgctxt "text_id=15438 | speaker=alice"
msgid "　こんなの、血が流れる程度の痛みだから」"
msgstr ""

#. Occurrence A_8:710:15439: scene=A_8
#: A_8:710
msgctxt "text_id=15439 | speaker=unknown"
msgid "　有珠の声は努めて静かだった。"
msgstr ""

#. Occurrence A_8:715:15440: scene=A_8
#: A_8:715
msgctxt "text_id=15440 | speaker=unknown"
msgid "　青子も背中を強打されても平気な顔で走っていたし、魔術師という人種は痛みへの耐性が強いのかもしれない。"
msgstr ""

#. Occurrence A_8:715:15441: scene=A_8
#: A_8:715
msgctxt "text_id=15441 | speaker=unknown"
msgid "　それに驚きつつ、草十郎は呆れたのだ。"
msgstr ""

#. Occurrence A_8:720:15442: scene=A_8
#: A_8:720
msgctxt "text_id=15442 | speaker=unknown"
msgid "　耐えられる程度の痛みは傷じゃない、なんて考えでは、死に至る傷以外は痛みではなくなってしまう。"
msgstr ""

#. Occurrence A_8:753:15443: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0007; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:753
msgctxt "text_id=15443 | speaker=soujuurou"
msgid "「……分かった。話をするのは明日にしよう。今日はとにかく体を休めてほしい」"
msgstr ""

#. Occurrence A_8:759:15444: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0012; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:759
msgctxt "text_id=15444 | speaker=alice"
msgid "「明日になっても、わたしの容態は変わらないけど……？」"
msgstr ""

#. Occurrence A_8:765:15445: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0008; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:765
msgctxt "text_id=15445 | speaker=soujuurou"
msgid "「いいんだ、それでも。有珠はもっと体を大事にしてくれ」"
msgstr ""

#. Occurrence A_8:800:15446: scene=A_8
#: A_8:800
msgctxt "text_id=15446 | speaker=unknown"
msgid "　言って、草十郎は立ち上がった。"
msgstr ""

#. Occurrence A_8:836:15447: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0009; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:836
msgctxt "text_id=15447 | speaker=soujuurou"
msgid "「部屋まで送るよ。それとも居間で休むか？　西館には入った事はないから、有珠の部屋も分からないし」"
msgstr ""

#. Occurrence A_8:842:15448: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0013; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:842
msgctxt "text_id=15448 | speaker=alice"
msgid "「……ここでいいわ。青子を待たなくちゃいけないから」"
msgstr ""

#. Occurrence A_8:880:15449: scene=A_8
#: A_8:880
msgctxt "text_id=15449 | speaker=unknown"
msgid "　有珠は座りこんだまま、天窓を見上げている。"
msgstr ""

#. Occurrence A_8:885:15450: scene=A_8
#: A_8:885
msgctxt "text_id=15450 | speaker=unknown"
msgid "　痛みに耐える顔が月光に照らされている。"
msgstr ""

#. Occurrence A_8:916:15451: scene=A_8
#: A_8:916
msgctxt "text_id=15451 | speaker=unknown"
msgid "　廃墟の古城を思わせるこのロビーで、月と有珠だけが現実より鮮明に映っている。"
msgstr ""

#. Occurrence A_8:936:15452: scene=A_8
#: A_8:936
msgctxt "text_id=15452 | speaker=unknown"
msgid "　その張りつめた強さは、何処からくるものなのか。"
msgstr ""

#. Occurrence A_8:964:15453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0010; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:964
msgctxt "text_id=15453 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence A_8:969:15454: scene=A_8
#: A_8:969
msgctxt "text_id=15454 | speaker=unknown"
msgid "　草十郎は立ったまま、少女の在り方を眺めている。"
msgstr ""

#. Occurrence A_8:974:15455: scene=A_8
#: A_8:974
msgctxt "text_id=15455 | speaker=unknown"
msgid "　無力に夜空を見上げるしかない、有珠の視線の意味にも気付かないままで。"
msgstr ""

#. Occurrence A_8:1063:15456: scene=A_8
#: A_8:1063
msgctxt "text_id=15456 | speaker=unknown"
msgid "　……そうして、ロビーの静寂を破るように三度目の<電話|コール>が鳴り響いた。"
msgstr ""

#. Occurrence A_8:1068:15457: scene=A_8
#: A_8:1068
msgctxt "text_id=15457 | speaker=unknown"
msgid "　草十郎が動くより早く、細い影がロビーを横切る。"
msgstr ""

#. Occurrence A_8:1085:15458: scene=A_8
#: A_8:1085
msgctxt "text_id=15458 | speaker=unknown"
msgid "　それが衰弱した有珠だと草十郎が気付いた時、彼女はすでに受話器を手に取っていた。"
msgstr ""

#. Occurrence A_8:1106:15459: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0014; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:1106
msgctxt "text_id=15459 | speaker=alice"
msgid "「青子……？」"
msgstr ""

#. Occurrence A_8:1112:15460: scene=A_8
#: A_8:1112
msgctxt "text_id=15460 | speaker=unknown"
msgid "　……不安を含んだ有珠の声を、草十郎は初めて聞いた。"
msgstr ""

#. Occurrence A_8:1117:15461: scene=A_8
#: A_8:1117
msgctxt "text_id=15461 | speaker=unknown"
msgid "　痛みに耐える声より、何倍も<悲愴|ひそう>な響き。"
msgstr ""

#. Occurrence A_8:1122:15462: scene=A_8
#: A_8:1122
msgctxt "text_id=15462 | speaker=unknown"
msgid "　有珠の問いに、受話器はただ一言だけを返す。"
msgstr ""

#. Occurrence A_8:1127:15463: scene=A_8
#: A_8:1127
msgctxt "text_id=15463 | speaker=unknown"
msgid "　有珠以上に弱々しい、消え去る前の炎みたいな一言を。"
msgstr ""

#. Occurrence A_8:1175:15464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_8_0000; voice_prefix=A10; voice_category=1; scene=A_8
#: A_8:1175
msgctxt "text_id=15464 | speaker=aoko"
msgid "「……ごめん、やられた」"
msgstr ""

#. Occurrence A_8:1212:15465: scene=A_8
#: A_8:1212
msgctxt "text_id=15465 | speaker=unknown"
msgid "　受話器から遠く離れた位置で、青子らしくない言葉が、草十郎の耳に響く。"
msgstr ""

#. Occurrence A_8:1217:15466: scene=A_8
#: A_8:1217
msgctxt "text_id=15466 | speaker=unknown"
msgid "　……それだけの言葉なのに、いや、それだけの言葉だからこそ。"
msgstr ""

#. Occurrence A_8:1222:15467: scene=A_8
#: A_8:1222
msgctxt "text_id=15467 | speaker=unknown"
msgid "　草十郎には青子の<敗北|けつまつ>が、堪え難いほど実感できた。"
msgstr ""

#. Occurrence A_8:1264:15468: scene=A_8
#: A_8:1264
msgctxt "text_id=15468 | speaker=unknown"
msgid "　有珠は静かに受話器を置く。"
msgstr ""

#. Occurrence A_8:1269:15469: scene=A_8
#: A_8:1269
msgctxt "text_id=15469 | speaker=unknown"
msgid "　今まで苦痛に耐えていた彼女の体は、一転してしなやかな強さを取り戻した。"
msgstr ""

#. Occurrence A_8:1274:15470: scene=A_8
#: A_8:1274
msgctxt "text_id=15470 | speaker=unknown"
msgid "　針金の人形が、美しい彫像に変わるように。"
msgstr ""

#. Occurrence A_8:1279:15471: scene=A_8
#: A_8:1279
msgctxt "text_id=15471 | speaker=unknown"
msgid "　それを見て、草十郎はようやく気が付いた。"
msgstr ""

#. Occurrence A_8:1309:15472: scene=A_8
#: A_8:1309
msgctxt "text_id=15472 | speaker=unknown"
msgid "　有珠の痛々しく月を見上げる瞳は、自分ではもう変えようのないこの結末を、静かに受け入れる為のものだったと。"
msgstr ""

#. Occurrence B_1:49:15473: scene=B_1
#: B_1:49
msgctxt "text_id=15473 | speaker=unknown"
msgid "　青子からの電話はつながったまま、もう語りかけてくる事はなかった。"
msgstr ""

#. Occurrence B_1:58:15474: scene=B_1
#: B_1:58
msgctxt "text_id=15474 | speaker=unknown"
msgid "　有珠は電話を切ると、手早くケープを着て玄関へと歩きだす。重症の体を、気力だけで動かすようにぎこちなく。"
msgstr ""

#. Occurrence B_1:80:15475: scene=B_1
#: B_1:80
msgctxt "text_id=15475 | speaker=unknown"
msgid "　その途中、ぴたりと足を止め、何やら思案げに草十郎を凝視した。"
msgstr ""

#. Occurrence B_1:135:15476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0000; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:135
msgctxt "text_id=15476 | speaker=soujuurou"
msgid "「……青子に何かあったんだな？」"
msgstr ""

#. Occurrence B_1:160:15477: scene=B_1
#: B_1:160
msgctxt "text_id=15477 | speaker=unknown"
msgid "　有珠は一瞬だけ思案し―――"
msgstr ""

#. Occurrence B_1:194:15478: scene=B_1
#: B_1:194
msgctxt "text_id=15478 | speaker=unknown"
msgid "　緊張をとくような思いきりの良さで、自分から少年の手をとった。"
msgstr ""

#. Occurrence B_1:201:15479: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0000; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:201
msgctxt "text_id=15479 | speaker=alice"
msgid "「静希君、一緒に来て」"
msgstr ""

#. Occurrence B_1:250:15480: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0001; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:250
msgctxt "text_id=15480 | speaker=soujuurou"
msgid "「待ってくれ。一緒にって、どこに？」"
msgstr ""

#. Occurrence B_1:264:15481: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0001; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:264
msgctxt "text_id=15481 | speaker=alice"
msgid "「<合田|あいだ>教会まで。青子の方は、<詠梨|えいり>神父にお願いするしかないから」"
msgstr ""

#. Occurrence B_1:277:15482: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0002; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:277
msgctxt "text_id=15482 | speaker=soujuurou"
msgid "「合田教会って、病院の横にある？」"
msgstr ""

#. Occurrence B_1:298:15483: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0002; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:298
msgctxt "text_id=15483 | speaker=alice"
msgid "「……そう。知っているのなら問題ないわね。説明する手間も省けたわ」"
msgstr ""

#. Occurrence B_1:353:15484: scene=B_1
#: B_1:353
msgctxt "text_id=15484 | speaker=unknown"
msgid "　有珠は玄関を出て、正面の並木道に向かっていく。"
msgstr ""

#. Occurrence B_1:358:15485: scene=B_1
#: B_1:358
msgctxt "text_id=15485 | speaker=unknown"
msgid "　……気丈に振る舞ってはいるが、その瞳には苦痛の色が見え隠れしている。"
msgstr ""

#. Occurrence B_1:379:15486: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0003; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:379
msgctxt "text_id=15486 | speaker=soujuurou"
msgid "「ちょ、有珠！　連絡をするなら、電話は？」"
msgstr ""

#. Occurrence B_1:408:15487: scene=B_1
#: B_1:408
msgctxt "text_id=15487 | speaker=unknown"
msgid "　弱い、けれど逆らえない有珠の手に引かれながら、草十郎は館を振り返った。"
msgstr ""

#. Occurrence B_1:459:15488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0003; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:459
msgctxt "text_id=15488 | speaker=alice"
msgid "「教会の人になら、もう報せた。"
msgstr ""

#. Occurrence B_1:465:15489: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0004; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:465
msgctxt "text_id=15489 | speaker=alice"
msgid "　……もしかして病院のことを言っているなら、それこそ無駄よ。ハイヤーなんて言うけど空を飛ぶわけでもないし。今は助けを呼ぶより、助けに行かないと間に合わない」"
msgstr ""

#. Occurrence B_1:522:15490: scene=B_1
#: B_1:522
msgctxt "text_id=15490 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence B_1:528:15491: scene=B_1
#: B_1:528
msgctxt "text_id=15491 | speaker=unknown"
msgid "　有珠は洋館に視線を切り返し、小さく指を鳴らした。"
msgstr ""

#. Occurrence B_1:551:15492: scene=B_1
#: B_1:551
msgctxt "text_id=15492 | speaker=unknown"
msgid "　有珠の合図に呼応するかのように、いずこかの窓が開き、無数の<椋鳥|ムクドリ>が飛び立っていく。"
msgstr ""

#. Occurrence B_1:572:15493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0005; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:572
msgctxt "text_id=15493 | speaker=alice"
msgid "「一番隊は索敵。二番隊と三番隊は現場に向かって応急処置を。在庫切れになってもいいわ。"
msgstr ""

#. Occurrence B_1:579:15494: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0006; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:579
msgctxt "text_id=15494 | speaker=alice"
msgid "まだ生きているなら、青子の心臓を止めないで」"
msgstr ""

#. Occurrence B_1:584:15495: scene=B_1
#: B_1:584
msgctxt "text_id=15495 | speaker=unknown"
msgid "　有珠の声は、飛び立っていく椋鳥たちにかけられたものだ。"
msgstr ""

#. Occurrence B_1:605:15496: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0007; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:605
msgctxt "text_id=15496 | speaker=alice"
msgid "「静希君は、裏庭から青子の自転車を持ってきて」"
msgstr ""

#. Occurrence B_1:643:15497: scene=B_1
#: B_1:643
msgctxt "text_id=15497 | speaker=unknown"
msgid "　言われて、げっと草十郎は漏らした。"
msgstr ""

#. Occurrence B_1:648:15498: scene=B_1
#: B_1:648
msgctxt "text_id=15498 | speaker=unknown"
msgid "　裏庭にある赤い自転車はオーダーメイドの特注品だ。"
msgstr ""

#. Occurrence B_1:653:15499: scene=B_1
#: B_1:653
msgctxt "text_id=15499 | speaker=unknown"
msgid "　いつぞやの焼却炉の掃除の際、うっかり傷つけそうになった草十郎に、青子は怒濤の<罵詈雑言|ばりぞうごん>をみまったのである。"
msgstr ""

#. Occurrence B_1:681:15500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0004; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:681
msgctxt "text_id=15500 | speaker=soujuurou"
msgid "「……いいけど。どうするつもりなんだ、有珠は？」"
msgstr ""

#. Occurrence B_1:709:15501: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0008_0; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:709
msgctxt "text_id=15501 | speaker=alice"
msgid "「ここにいるより、教会にいたほうが静希君は安全よ。それに、わたしも急がないといけない。"
msgstr ""

#. Occurrence B_1:722:15502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0008_1; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:722
msgctxt "text_id=15502 | speaker=alice"
msgid "……静希君、ふたり乗りできる？」"
msgstr ""

#. Occurrence B_1:762:15503: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0005; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:762
msgctxt "text_id=15503 | speaker=soujuurou"
msgid "「――――――む」"
msgstr ""

#. Occurrence B_1:768:15504: scene=B_1
#: B_1:768
msgctxt "text_id=15504 | speaker=unknown"
msgid "　<見様見真似|み よ う み ま ね >でやれる自信はあるものの、いまいち自転車というものを信用できない草十郎だった。"
msgstr ""

#. Occurrence B_1:773:15505: scene=B_1
#: B_1:773
msgctxt "text_id=15505 | speaker=unknown"
msgid "　あの細い<骨格|フレーム>の乗り物に、はたして二人分の体重を支えるだけの性能があるかどうか―――"
msgstr ""

#. Occurrence B_1:800:15506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0006; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:800
msgctxt "text_id=15506 | speaker=soujuurou"
msgid "「ん？　ふたり乗りってコトは有珠が後ろに乗るのか!?」"
msgstr ""

#. Occurrence B_1:825:15507: scene=B_1
#: B_1:825
msgctxt "text_id=15507 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence B_1:837:15508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0009; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:837
msgctxt "text_id=15508 | speaker=alice"
msgid "出来ないなら、いいわ」"
msgstr ""

#. Occurrence B_1:848:15509: scene=B_1
#: B_1:848
msgctxt "text_id=15509 | speaker=unknown"
msgid "　ぷい、と顔を背けて歩きだす有珠。"
msgstr ""

#. Occurrence B_1:853:15510: scene=B_1
#: B_1:853
msgctxt "text_id=15510 | speaker=unknown"
msgid "　間の悪いコトに、草十郎の言葉をストレートに誤解したらしい。"
msgstr ""

#. Occurrence B_1:891:15511: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0007; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:891
msgctxt "text_id=15511 | speaker=soujuurou"
msgid "「いや、そういう意味じゃないんだ。有珠とはイメージが合わなかったから」"
msgstr ""

#. Occurrence B_1:897:15512: scene=B_1
#: B_1:897
msgctxt "text_id=15512 | speaker=unknown"
msgid "　草十郎の弁解にも耳を貸さず、有珠は一人でスタスタと森に向かう。"
msgstr ""

#. Occurrence B_1:902:15513: scene=B_1
#: B_1:902
msgctxt "text_id=15513 | speaker=unknown"
msgid "　どうも、有珠は自転車に乗れないらしい。"
msgstr ""

#. Occurrence B_1:907:15514: scene=B_1
#: B_1:907
msgctxt "text_id=15514 | speaker=unknown"
msgid "　目に見えて意地を張っている有珠を、草十郎は必死に呼び止めた。"
msgstr ""

#. Occurrence B_1:949:15515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0008; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:949
msgctxt "text_id=15515 | speaker=soujuurou"
msgid "「待った、今のはこっちが悪かった。すぐに持ってくるから、怒るのはツケにしておいてくれ」"
msgstr ""

#. Occurrence B_1:967:15516: scene=B_1
#: B_1:967
msgctxt "text_id=15516 | speaker=unknown"
msgid "　聞いて、ぴたりと有珠の足が止まる。"
msgstr ""

#. Occurrence B_1:1023:15517: scene=B_1
#: B_1:1023
msgctxt "text_id=15517 | speaker=unknown"
msgid "　有珠の停止を確認して、草十郎は急いで裏庭に向かった。"
msgstr ""

#. Occurrence B_1:1029:15518: scene=B_1
#: B_1:1029
msgctxt "text_id=15518 | speaker=unknown"
msgid "　納屋の鍵置き場から自転車の鍵を取って、"
msgstr ""

msgctxt "text_id=15519 | speaker=unknown"
msgid "青子愛用の自転車のロックを外す。"
msgstr ""

#. Occurrence B_1:1053:15520: scene=B_1
#: B_1:1053
msgctxt "text_id=15520 | speaker=unknown"
msgid "　自転車を引いて洋館の正面に戻ると、有珠はもう森に向かっていた。"
msgstr ""

#. Occurrence B_1:1074:15521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0009; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1074
msgctxt "text_id=15521 | speaker=soujuurou"
msgid "「……有珠の性格、なんとなく掴めてきたな……」"
msgstr ""

#. Occurrence B_1:1081:15522: scene=B_1
#: B_1:1081
msgctxt "text_id=15522 | speaker=unknown"
msgid "　呟いて、草十郎は自転車にまたがった。"
msgstr ""

#. Occurrence B_1:1086:15523: scene=B_1
#: B_1:1086
msgctxt "text_id=15523 | speaker=unknown"
msgid "　ペダルに足を置く。軽いが確かな感触。"
msgstr ""

#. Occurrence B_1:1093:15524: scene=B_1
#: B_1:1093
msgctxt "text_id=15524 | speaker=unknown"
msgid "　これなら二人分の体重が乗っても問題ない、と自転車を走らせた。"
msgstr ""

#. Occurrence B_1:1127:15525: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0010; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1127
msgctxt "text_id=15525 | speaker=soujuurou"
msgid "「有珠！」"
msgstr ""

#. Occurrence B_1:1175:15526: scene=B_1
#: B_1:1175
msgctxt "text_id=15526 | speaker=unknown"
msgid "　呼びかけに振りむく有珠。"
msgstr ""

#. Occurrence B_1:1180:15527: scene=B_1
#: B_1:1180
msgctxt "text_id=15527 | speaker=unknown"
msgid "　あきらかに草十郎を非難している眼差しである。"
msgstr ""

#. Occurrence B_1:1243:15528: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0011; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1243
msgctxt "text_id=15528 | speaker=soujuurou"
msgid "「行こう、後ろの荷台に乗ってくれ。でもクッションがないから痛いと思う。辛かったら言ってくれ、止めるから」"
msgstr ""

#. Occurrence B_1:1249:15529: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0010; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1249
msgctxt "text_id=15529 | speaker=alice"
msgid "「……わたしは大丈夫よ。静希君が、イヤじゃなければの話だけど」"
msgstr ""

#. Occurrence B_1:1260:15530: scene=B_1
#: B_1:1260
msgctxt "text_id=15530 | speaker=unknown"
msgid "　……やはり、些細な事でも怒らせると根に持つ性格なんだな、と学習する草十郎なのだった。"
msgstr ""

#. Occurrence B_1:1322:15531: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0012; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1322
msgctxt "text_id=15531 | speaker=soujuurou"
msgid "「そういうコトなら問題ないよ。有珠が後ろにいてくれるのは嬉しい。それで、行き先は合田教会でいいんだな？」"
msgstr ""

#. Occurrence B_1:1356:15532: scene=B_1
#: B_1:1356
msgctxt "text_id=15532 | speaker=unknown"
msgid "　臆面もない草十郎の返答。"
msgstr ""

#. Occurrence B_1:1361:15533: scene=B_1
#: B_1:1361
msgctxt "text_id=15533 | speaker=unknown"
msgid "　それに毒気が抜かれたのか、有珠はこくんとうなずいて、自転車の後部座席に腰を下ろした。"
msgstr ""

#. Occurrence B_1:1442:15534: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0011; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1442
msgctxt "text_id=15534 | speaker=alice"
msgid "「…………手を回すけど。わたしが触れても、平気？」"
msgstr ""

#. Occurrence B_1:1474:15535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0013; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1474
msgctxt "text_id=15535 | speaker=soujuurou"
msgid "「？　大丈夫だよ、体力があるのはさっき証明しただろ」"
msgstr ""

#. Occurrence B_1:1507:15536: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0012; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1507
msgctxt "text_id=15536 | speaker=alice"
msgid "「………………」"
msgstr ""

#. Occurrence B_1:1513:15537: scene=B_1
#: B_1:1513
msgctxt "text_id=15537 | speaker=unknown"
msgid "　有珠は無言で草十郎の体に手を回す。"
msgstr ""

#. Occurrence B_1:1519:15538: scene=B_1
#: B_1:1519
msgctxt "text_id=15538 | speaker=unknown"
msgid "　有珠の手がしっかりと自分を掴んだのを確認して、よし、"
msgstr ""

msgctxt "text_id=15539 | speaker=unknown"
msgid "と草十郎はハンドルを握った。"
msgstr ""

#. Occurrence B_1:1565:15540: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0014; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1565
msgctxt "text_id=15540 | speaker=soujuurou"
msgid "「良かった」"
msgstr ""

#. Occurrence B_1:1570:15541: scene=B_1
#: B_1:1570
msgctxt "text_id=15541 | speaker=unknown"
msgid "　なんて、小さな呟きと共に。"
msgstr ""

#. Occurrence B_1:1625:15542: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0013; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1625
msgctxt "text_id=15542 | speaker=alice"
msgid "「何が良かったの……？」"
msgstr ""

#. Occurrence B_1:1636:15543: scene=B_1
#: B_1:1636
msgctxt "text_id=15543 | speaker=unknown"
msgid "　有珠のささやきに、草十郎は曖昧な視線を返し、勢いよくペダルを踏み込んだ。"
msgstr ""

#. Occurrence B_1:1648:15544: scene=B_1
#: B_1:1648
msgctxt "text_id=15544 | speaker=unknown"
msgid "　自転車は白犬塚の急な坂道を、ノーブレーキで駆け下りていく。"
msgstr ""

#. Occurrence B_1:1715:15545: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0014; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1715
msgctxt "text_id=15545 | speaker=alice"
msgid "「っ……！」"
msgstr ""

#. Occurrence B_1:1720:15546: scene=B_1
#: B_1:1720
msgctxt "text_id=15546 | speaker=unknown"
msgid "　自分で言いだした事とはいえ、予想以上のスピードに有珠は息を呑んだ。"
msgstr ""

#. Occurrence B_1:1725:15547: scene=B_1
#: B_1:1725
msgctxt "text_id=15547 | speaker=unknown"
msgid "　あまりの急加速に、草十郎の両肩をぐっと掴んでしまったぐらいだ。"
msgstr ""

#. Occurrence B_1:1773:15548: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0015; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1773
msgctxt "text_id=15548 | speaker=alice"
msgid "「し―――」"
msgstr ""

#. Occurrence B_1:1778:15549: scene=B_1
#: B_1:1778
msgctxt "text_id=15549 | speaker=unknown"
msgid "　抗議の声をあげようと草十郎を見上げるが、草十郎は有珠以上に真剣な顔でハンドルを握っていた。"
msgstr ""

#. Occurrence B_1:1783:15550: scene=B_1
#: B_1:1783
msgctxt "text_id=15550 | speaker=unknown"
msgid "　有珠はのど元まで出かかった声をおさえて、回した手を強く握る。"
msgstr ""

#. Occurrence B_1:1788:15551: scene=B_1
#: B_1:1788
msgctxt "text_id=15551 | speaker=unknown"
msgid "　夜の坂道を下る、生真面目な操縦者を信頼するように。"
msgstr ""

#. Occurrence B_1:1931:15552: scene=B_1
#: B_1:1931
msgctxt "text_id=15552 | speaker=unknown"
msgid "　自転車は最後までブレーキもかけず、ジェットコースター顔負けの速さで三咲町の駅前まで走っていく。"
msgstr ""

#. Occurrence B_1:1936:15553: scene=B_1
#: B_1:1936
msgctxt "text_id=15553 | speaker=unknown"
msgid "　午前零時を過ぎた駅前には人の気配も車のヘッドライトもない。"
msgstr ""

#. Occurrence B_1:1956:15554: scene=B_1
#: B_1:1956
msgctxt "text_id=15554 | speaker=unknown"
msgid "　完全に眠りについた町中、いまだ雪に埋もれた道の上を、風のように駆けていく。"
msgstr ""

#. Occurrence B_1:1961:15555: scene=B_1
#: B_1:1961
msgctxt "text_id=15555 | speaker=unknown"
msgid "　そんな中、"
msgstr ""

#. Occurrence B_1:2001:15556: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0015; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:2001
msgctxt "text_id=15556 | speaker=soujuurou"
msgid "「……ほんとに良かった。ふたり乗りが思ったより簡単で」"
msgstr ""

#. Occurrence B_1:2006:15557: scene=B_1
#: B_1:2006
msgctxt "text_id=15557 | speaker=unknown"
msgid "　ホッと安堵する乗り手がひとり。"
msgstr ""

#. Occurrence B_1:2011:15558: scene=B_1
#: B_1:2011
msgctxt "text_id=15558 | speaker=unknown"
msgid "　初めて自転車に乗る少年少女は、無人の国道を激走していく。"
msgstr ""

#. Occurrence B_1:2016:15559: scene=B_1
#: B_1:2016
msgctxt "text_id=15559 | speaker=unknown"
msgid "　ゾッとする彼の呟きは、幸いにも風切り音にまぎれて、誰に届く事なく消えていった。"
msgstr ""

#. Occurrence B_2:55:15560: scene=B_2
#: B_2:55
msgctxt "text_id=15560 | speaker=unknown"
msgid "　深夜にも拘わらず、教会には明かりが灯っていた。"
msgstr ""

#. Occurrence B_2:60:15561: scene=B_2
#: B_2:60
msgctxt "text_id=15561 | speaker=unknown"
msgid "　本来、不慮の事故にそなえて眠らずの番である病院には、<仄暗|ほのぐら>い明かりが正面玄関に灯るのみ。"
msgstr ""

#. Occurrence B_2:65:15562: scene=B_2
#: B_2:65
msgctxt "text_id=15562 | speaker=unknown"
msgid "　娯楽の少ない田舎の町である。"
msgstr ""

#. Occurrence B_2:70:15563: scene=B_2
#: B_2:70
msgctxt "text_id=15563 | speaker=unknown"
msgid "　深夜の急患はそれこそ一日に一人いるかいないかで、"
msgstr ""

#. Occurrence B_2:75:15564: scene=B_2
#: B_2:75
msgctxt "text_id=15564 | speaker=unknown"
msgid "　今夜はただ、その一人が病院の手には負えない重傷者であっただけの話だ。"
msgstr ""

#. Occurrence B_2:122:15565: scene=B_2
#: B_2:122
msgctxt "text_id=15565 | speaker=unknown"
msgid "　時刻は午前一時前。"
msgstr ""

#. Occurrence B_2:127:15566: scene=B_2
#: B_2:127
msgctxt "text_id=15566 | speaker=unknown"
msgid "　自転車を外に止めて、ふたりは教会に向かう。"
msgstr ""

#. Occurrence B_2:132:15567: scene=B_2
#: B_2:132
msgctxt "text_id=15567 | speaker=unknown"
msgid "　雪をかぶり、闇夜の中でもはっきりと浮かび上がる三角屋根の建物。"
msgstr ""

#. Occurrence B_2:137:15568: scene=B_2
#: B_2:137
msgctxt "text_id=15568 | speaker=unknown"
msgid "　その入り口に、背の高い影が立っていた。"
msgstr ""

#. Occurrence B_2:173:15569: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0000; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:173
msgctxt "text_id=15569 | speaker=eiri"
msgid "「久遠寺さん」"
msgstr ""

#. Occurrence B_2:190:15570: scene=B_2
#: B_2:190
msgctxt "text_id=15570 | speaker=unknown"
msgid "　落ち着いた男性の声。"
msgstr ""

#. Occurrence B_2:195:15571: scene=B_2
#: B_2:195
msgctxt "text_id=15571 | speaker=unknown"
msgid "　マントのような<外套|がいとう>を羽織った男は、入り口で有珠を待っていた。"
msgstr ""

#. Occurrence B_2:227:15572: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0000; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:227
msgctxt "text_id=15572 | speaker=alice"
msgid "「<詠梨|えいり>神父。青子は―――」"
msgstr ""

#. Occurrence B_2:251:15573: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0001; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:251
msgctxt "text_id=15573 | speaker=eiri"
msgid "「<唯架|ゆいか>が診ています。私が駆け付けた時には手遅れでした。"
msgstr ""

#. Occurrence B_2:257:15574: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0002; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:257
msgctxt "text_id=15574 | speaker=eiri"
msgid "　蒼崎の家に伝令を願いたいのですが」"
msgstr ""

#. Occurrence B_2:278:15575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0001; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:278
msgctxt "text_id=15575 | speaker=alice"
msgid "「……青子はそれを望まないわ。それに、あちらも今は城に捕らわれているそうです。今夜の相手は、真っ先に青子の祖父の動きを封じたようですから」"
msgstr ""

#. Occurrence B_2:298:15576: scene=B_2
#: B_2:298
msgctxt "text_id=15576 | speaker=unknown"
msgid "　断片的な言葉が交わされる。"
msgstr ""

#. Occurrence B_2:303:15577: scene=B_2
#: B_2:303
msgctxt "text_id=15577 | speaker=unknown"
msgid "　草十郎は階段の手前から動かない。"
msgstr ""

#. Occurrence B_2:322:15578: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0003; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:322
msgctxt "text_id=15578 | speaker=eiri"
msgid "「おや……そちらは？」"
msgstr ""

#. Occurrence B_2:327:15579: scene=B_2
#: B_2:327
msgctxt "text_id=15579 | speaker=unknown"
msgid "　落ち着いていた男の声が、かすかに<険|けん>を含む。"
msgstr ""

#. Occurrence B_2:353:15580: scene=B_2
#: B_2:353
msgctxt "text_id=15580 | speaker=unknown"
msgid "　その視線から草十郎を庇うように、有珠は男の前に歩みでた。"
msgstr ""

#. Occurrence B_2:401:15581: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0002; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:401
msgctxt "text_id=15581 | speaker=alice"
msgid "「……彼は青子の使い魔。契約はまだ成されていないけれど」"
msgstr ""

#. Occurrence B_2:412:15582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0000; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:412
msgctxt "text_id=15582 | speaker=soujuurou"
msgid "「使い魔って、有珠」"
msgstr ""

#. Occurrence B_2:417:15583: scene=B_2
#: B_2:417
msgctxt "text_id=15583 | speaker=unknown"
msgid "　文句を言いかける草十郎に、有珠は火のような視線を向ける。"
msgstr ""

#. Occurrence B_2:444:15584: scene=B_2
#: B_2:444
msgctxt "text_id=15584 | speaker=unknown"
msgid "“いいから黙っていて”と。"
msgstr ""

#. Occurrence B_2:465:15585: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0004; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:465
msgctxt "text_id=15585 | speaker=eiri"
msgid "「そうですか。そのような申告はありませんでしたが、届けが遅れたのは不問としましょう。"
msgstr ""

#. Occurrence B_2:491:15586: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0005; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:491
msgctxt "text_id=15586 | speaker=eiri"
msgid "　外部の魔術師と交戦中でしたからね。貴女たちはその撃退を最優先にした、という事で」"
msgstr ""

#. Occurrence B_2:496:15587: scene=B_2
#: B_2:496
msgctxt "text_id=15587 | speaker=unknown"
msgid "　神父の返答に、有珠は少しだけ頭を下げた。"
msgstr ""

#. Occurrence B_2:532:15588: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0003; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:532
msgctxt "text_id=15588 | speaker=alice"
msgid "「では通ります。……彼の同行を許可しなさい」"
msgstr ""

#. Occurrence B_2:551:15589: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0006; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:551
msgctxt "text_id=15589 | speaker=eiri"
msgid "「ご自由に。私はこれより調停に向かいます。管理者が替わるのなら、両<組織|きょうかい>への資料を用意しなければいけませんので。"
msgstr ""

#. Occurrence B_2:563:15590: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0007; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:563
msgctxt "text_id=15590 | speaker=eiri"
msgid "　ああ、留守中は<律架|りつか>に任せてありますから、必要なものがあれば彼女に」"
msgstr ""

#. Occurrence B_2:589:15591: scene=B_2
#: B_2:589
msgctxt "text_id=15591 | speaker=unknown"
msgid "　詠梨神父と呼ばれた人物は、ふたりと入れ替わるように教会の敷地から外に出た。"
msgstr ""

#. Occurrence B_2:596:15592: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0001; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:596
msgctxt "text_id=15592 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence B_2:601:15593: scene=B_2
#: B_2:601
msgctxt "text_id=15593 | speaker=unknown"
msgid "　つられて、草十郎はきっかり<二間|にけん>ばかりの距離、おおげさに後退した。"
msgstr ""

#. Occurrence B_2:682:15594: scene=B_2
#: B_2:682
msgctxt "text_id=15594 | speaker=unknown"
msgid "　通り過ぎていく間、神父の風貌が明確になる。"
msgstr ""

#. Occurrence B_2:687:15595: scene=B_2
#: B_2:687
msgctxt "text_id=15595 | speaker=unknown"
msgid "　一言、美しい男だった。"
msgstr ""

#. Occurrence B_2:692:15596: scene=B_2
#: B_2:692
msgctxt "text_id=15596 | speaker=unknown"
msgid "　すっと通った<鼻梁|びりょう>と、<艶|つや>を持った唇。"
msgstr ""

#. Occurrence B_2:697:15597: scene=B_2
#: B_2:697
msgctxt "text_id=15597 | speaker=unknown"
msgid "　一点の歪みもない<面|おもて>は中性的ですらある。"
msgstr ""

#. Occurrence B_2:702:15598: scene=B_2
#: B_2:702
msgctxt "text_id=15598 | speaker=unknown"
msgid "　もっとも、それは外見だけの話で、神父の立ち振る舞いには女性らしい柔らかさは微塵もない。"
msgstr ""

#. Occurrence B_2:707:15599: scene=B_2
#: B_2:707
msgctxt "text_id=15599 | speaker=unknown"
msgid "　鍛えられた<鋼|はがね>を思わせる、頼りになるが近寄りがたい、そんな雰囲気を持っていた。"
msgstr ""

#. Occurrence B_2:739:15600: scene=B_2
#: B_2:739
msgctxt "text_id=15600 | speaker=unknown"
msgid "　神父は足音もたてず、黒い外套で月光をはじくように闇夜に消えていく。"
msgstr ""

#. Occurrence B_2:744:15601: scene=B_2
#: B_2:744
msgctxt "text_id=15601 | speaker=unknown"
msgid "　その後ろ姿を呆然と草十郎は見送った。"
msgstr ""

#. Occurrence B_2:783:15602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0002; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:783
msgctxt "text_id=15602 | speaker=soujuurou"
msgid "「……なんか、仙人みたいな人だな」"
msgstr ""

#. Occurrence B_2:789:15603: scene=B_2
#: B_2:789
msgctxt "text_id=15603 | speaker=unknown"
msgid "　呟きには草十郎なりの親しみがあった。"
msgstr ""

#. Occurrence B_2:794:15604: scene=B_2
#: B_2:794
msgctxt "text_id=15604 | speaker=unknown"
msgid "　他人を寄せ付けない雰囲気の詠梨神父に、どことなく懐かしいものを感じたらしい。"
msgstr ""

#. Occurrence B_2:818:15605: scene=B_2
#: B_2:818
msgctxt "text_id=15605 | speaker=unknown"
msgid "　一方。そんな草十郎に、有珠は厳しい視線を向ける。"
msgstr ""

#. Occurrence B_2:854:15606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0004; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:854
msgctxt "text_id=15606 | speaker=alice"
msgid "「気を許さないで。彼は教会の人間よ。"
msgstr ""

#. Occurrence B_2:860:15607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0005; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:860
msgctxt "text_id=15607 | speaker=alice"
msgid "　わたしたちを監視する側だけど、今回は彼の手を借りるしかなかっただけ。"
msgstr ""

#. Occurrence B_2:866:15608: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0006; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:866
msgctxt "text_id=15608 | speaker=alice"
msgid "　……許されるなら、真っ先に消えてほしい人間だから」"
msgstr ""

#. Occurrence B_2:907:15609: scene=B_2
#: B_2:907
msgctxt "text_id=15609 | speaker=unknown"
msgid "　<呪詛|じゅそ>とも取れる呟きを残して、有珠は礼拝堂の扉に手をかけた。"
msgstr ""

#. Occurrence B_2:912:15610: scene=B_2
#: B_2:912
msgctxt "text_id=15610 | speaker=unknown"
msgid "　扉は有珠より二倍ほど高く、重そうな両開きだ。"
msgstr ""

#. Occurrence B_2:917:15611: scene=B_2
#: B_2:917
msgctxt "text_id=15611 | speaker=unknown"
msgid "　有珠ひとりでは開けられそうにない。"
msgstr ""

#. Occurrence B_2:923:15612: scene=B_2
#: B_2:923
msgctxt "text_id=15612 | speaker=unknown"
msgid "　草十郎は階段を三段飛ばしで通過して、有珠と共に扉を押した。"
msgstr ""

#. Occurrence B_3:56:15613: scene=B_3
#: B_3:56
msgctxt "text_id=15613 | speaker=unknown"
msgid "　礼拝堂の明かりは、懐かしい油の匂いがした。"
msgstr ""

#. Occurrence B_3:61:15614: scene=B_3
#: B_3:61
msgctxt "text_id=15614 | speaker=unknown"
msgid "　高い天井。"
msgstr ""

#. Occurrence B_3:66:15615: scene=B_3
#: B_3:66
msgctxt "text_id=15615 | speaker=unknown"
msgid "　壁一面の装飾硝子。"
msgstr ""

#. Occurrence B_3:71:15616: scene=B_3
#: B_3:71
msgctxt "text_id=15616 | speaker=unknown"
msgid "　あまりにも<白々|しらじら>しく神々しい、聖霊の実在を証明する為の舞台装置。"
msgstr ""

#. Occurrence B_3:76:15617: scene=B_3
#: B_3:76
msgctxt "text_id=15617 | speaker=unknown"
msgid "　久遠寺邸のホールと同じく、礼拝堂にも暖房器具のたぐいは一切ない。<軋|きし>むような寒さが、礼拝堂をより厳格な空間へと変えている。"
msgstr ""

#. Occurrence B_3:114:15618: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0000; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:114
msgctxt "text_id=15618 | speaker=ritsuka"
msgid "「アッちゃん、こっちよ」"
msgstr ""

#. Occurrence B_3:132:15619: scene=B_3
#: B_3:132
msgctxt "text_id=15619 | speaker=unknown"
msgid "　そんな礼拝堂で、やや場違いな声が響いた。"
msgstr ""

#. Occurrence B_3:137:15620: scene=B_3
#: B_3:137
msgctxt "text_id=15620 | speaker=unknown"
msgid "　柔らかな女性の声だ。"
msgstr ""

#. Occurrence B_3:172:15621: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0000; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:172
msgctxt "text_id=15621 | speaker=alice"
msgid "「<律架|りつか>さん？　奥？」"
msgstr ""

#. Occurrence B_3:178:15622: scene=B_3
#: B_3:178
msgctxt "text_id=15622 | speaker=unknown"
msgid "　有珠は奥の祭壇に向かって、長椅子の葬列を横断する。"
msgstr ""

#. Occurrence B_3:185:15623: scene=B_3
#: B_3:185
msgctxt "text_id=15623 | speaker=unknown"
msgid "　草十郎も扉を閉めて、その背中を追いかけた。"
msgstr ""

#. Occurrence B_3:258:15624: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0001; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:258
msgctxt "text_id=15624 | speaker=ritsuka"
msgid "「早かったわね。これから迎えに行こうと思ったのに」"
msgstr ""

#. Occurrence B_3:283:15625: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0001; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:283
msgctxt "text_id=15625 | speaker=alice"
msgid "「……使える足があったから。後ろの彼」"
msgstr ""

#. Occurrence B_3:316:15626: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0002; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:316
msgctxt "text_id=15626 | speaker=ritsuka"
msgid "「足って……あれ、貴方？」"
msgstr ""

#. Occurrence B_3:345:15627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0000; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:345
msgctxt "text_id=15627 | speaker=soujuurou"
msgid "「あ」"
msgstr ""

#. Occurrence B_3:365:15628: scene=B_3
#: B_3:365
msgctxt "text_id=15628 | speaker=unknown"
msgid "　有珠の紹介を受けて顔をだす草十郎と、女性の驚きが重なる。"
msgstr ""

#. Occurrence B_3:370:15629: scene=B_3
#: B_3:370
msgctxt "text_id=15629 | speaker=unknown"
msgid "　ふたりはまじまじと、ここに居るはずのない顔を眺めるのだった。"
msgstr ""

#. Occurrence B_3:421:15630: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0002; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:421
msgctxt "text_id=15630 | speaker=alice"
msgid "「……知り合い？」"
msgstr ""

#. Occurrence B_3:447:15631: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0003; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:447
msgctxt "text_id=15631 | speaker=ritsuka"
msgid "「あ、うん、まずい事に知り合い。"
msgstr ""

#. Occurrence B_3:458:15632: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0004; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:458
msgctxt "text_id=15632 | speaker=ritsuka"
msgid "　草十郎さん、引っ越したって話だけど……もしかしてアッちゃんのところに下宿してるの？」"
msgstr ""

#. Occurrence B_3:463:15633: scene=B_3
#: B_3:463
msgctxt "text_id=15633 | speaker=unknown"
msgid "　はい、とうなずく草十郎。"
msgstr ""

#. Occurrence B_3:468:15634: scene=B_3
#: B_3:468
msgctxt "text_id=15634 | speaker=unknown"
msgid "　予想外の展開に、有珠の機嫌は目に見えて悪くなる。"
msgstr ""

#. Occurrence B_3:501:15635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0003; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:501
msgctxt "text_id=15635 | speaker=alice"
msgid "「……どういう事？　静希君、律架さんとはどういう関係？」"
msgstr ""

#. Occurrence B_3:513:15636: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0005; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:513
msgctxt "text_id=15636 | speaker=ritsuka"
msgid "「関係って、そうね……。"
msgstr ""

#. Occurrence B_3:525:15637: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0006; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:525
msgctxt "text_id=15637 | speaker=ritsuka"
msgid "　お魚屋さんでしょっちゅう割引してもらったり、"
msgstr ""

#. Occurrence B_3:531:15638: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0007; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:531
msgctxt "text_id=15638 | speaker=ritsuka"
msgid "　荷物持ちを頼んでみたり、"
msgstr ""

#. Occurrence B_3:543:15639: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0008; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:543
msgctxt "text_id=15639 | speaker=ritsuka"
msgid "　たまにお茶飲んだりする……主婦の友、みたいな？」"
msgstr ""

#. Occurrence B_3:555:15640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0004; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:555
msgctxt "text_id=15640 | speaker=alice"
msgid "「意味が分かりません。律架さん、結婚していないでしょう」"
msgstr ""

#. Occurrence B_3:581:15641: scene=B_3
#: B_3:581
msgctxt "text_id=15641 | speaker=unknown"
msgid "　無論、草十郎も主婦ではないのだが、今は自分のコトより彼女の既婚問題の方が重要らしかった。"
msgstr ""

#. Occurrence B_3:618:15642: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0009; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:618
msgctxt "text_id=15642 | speaker=ritsuka"
msgid "「うわあ、そこをつっこむのかあ……アッちゃん、わたしにだけは一切妥協がないのはどうかと思うの」"
msgstr ""

#. Occurrence B_3:624:15643: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0005; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:624
msgctxt "text_id=15643 | speaker=alice"
msgid "「律架さんの場合、どこまで本気か分からないから。おかしなところは、ぜんぶ追及しておかないといけないだけよ」"
msgstr ""

#. Occurrence B_3:651:15644: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0010; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:651
msgctxt "text_id=15644 | speaker=ritsuka"
msgid "「あら素敵。仲の良い姉妹みたいね、わたしたち。"
msgstr ""

#. Occurrence B_3:662:15645: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0011; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:662
msgctxt "text_id=15645 | speaker=ritsuka"
msgid "　じゃ、その信頼に応えてホントのコト言うと、彼とは町内会の顔見知りよ。スパイ行為とかそういうんじゃないし、そもそもそんな器用な人じゃないでしょ、草十郎さんは」"
msgstr ""

#. Occurrence B_3:699:15646: scene=B_3
#: B_3:699
msgctxt "text_id=15646 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence B_3:706:15647: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0006; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:706
msgctxt "text_id=15647 | speaker=alice"
msgid "本当？」"
msgstr ""

#. Occurrence B_3:711:15648: scene=B_3
#: B_3:711
msgctxt "text_id=15648 | speaker=unknown"
msgid "　ジトっとした目で草十郎を見据える有珠。"
msgstr ""

#. Occurrence B_3:717:15649: scene=B_3
#: B_3:717
msgctxt "text_id=15649 | speaker=unknown"
msgid "批難の目というより、隠し事をされて怒っているような目だ。"
msgstr ""

#. Occurrence B_3:762:15650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0001; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:762
msgctxt "text_id=15650 | speaker=soujuurou"
msgid "「本当だ。魚屋でバイトしてる時に知り合った人だ。"
msgstr ""

#. Occurrence B_3:768:15651: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0002; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:768
msgctxt "text_id=15651 | speaker=soujuurou"
msgid "　前に親切にしてもらったんで、お礼に鰯を一匹サービスしたら、それ以来ごひいきに」"
msgstr ""

#. Occurrence B_3:794:15652: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0007; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:794
msgctxt "text_id=15652 | speaker=alice"
msgid "「―――」"
msgstr ""

#. Occurrence B_3:806:15653: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0012; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:806
msgctxt "text_id=15653 | speaker=ritsuka"
msgid "「そうそう。商店街で買い物してればイヤでも草十郎さんとは顔見知りになるわ。"
msgstr ""

#. Occurrence B_3:818:15654: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0013; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:818
msgctxt "text_id=15654 | speaker=ritsuka"
msgid "　アッちゃんも怒るぐらいなら買い物に来ればいいのに。ひそかな商店街のアイドルです、彼」"
msgstr ""

#. Occurrence B_3:861:15655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0003; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:861
msgctxt "text_id=15655 | speaker=soujuurou"
msgid "「……アイドルとは人気者という意味で、値切りやすいカモって意味じゃない、ような」"
msgstr ""

#. Occurrence B_3:866:15656: scene=B_3
#: B_3:866
msgctxt "text_id=15656 | speaker=unknown"
msgid "　ある意味人気者なのだが、それは置いておいて。"
msgstr ""

#. Occurrence B_3:902:15657: scene=B_3
#: B_3:902
msgctxt "text_id=15657 | speaker=unknown"
msgid "　気を取り直し、有珠は奥のドアに視線を向けた。"
msgstr ""

#. Occurrence B_3:923:15658: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0008; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:923
msgctxt "text_id=15658 | speaker=alice"
msgid "「律架さんの事情は知りませんが、彼は青子の連れです。"
msgstr ""

#. Occurrence B_3:929:15659: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0009; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:929
msgctxt "text_id=15659 | speaker=alice"
msgid "　その他に説明は要りますか」"
msgstr ""

#. Occurrence B_3:953:15660: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0014; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:953
msgctxt "text_id=15660 | speaker=ritsuka"
msgid "「あー、やっぱりそういうコトなのね……。ま、言いたい事は色々あるけど、今はそれどころじゃないし。"
msgstr ""

#. Occurrence B_3:965:15661: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0015; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:965
msgctxt "text_id=15661 | speaker=ritsuka"
msgid "　ええ、了解したわ。他ならぬアッちゃんの頼みだし、特殊な例だけど、彼はこちらで保護しましょう！」"
msgstr ""

#. Occurrence B_3:971:15662: scene=B_3
#: B_3:971
msgctxt "text_id=15662 | speaker=unknown"
msgid "　律架の答えにうなずいて、有珠は奥のドアへと歩きだした。"
msgstr ""

#. Occurrence B_3:1046:15663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0004; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1046
msgctxt "text_id=15663 | speaker=soujuurou"
msgid "「有珠」"
msgstr ""

#. Occurrence B_3:1052:15664: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0016; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1052
msgctxt "text_id=15664 | speaker=ritsuka"
msgid "「だめよ、草十郎さん」"
msgstr ""

#. Occurrence B_3:1063:15665: scene=B_3
#: B_3:1063
msgctxt "text_id=15665 | speaker=unknown"
msgid "　有珠の後を追う草十郎を、割り入って止める律架。"
msgstr ""

#. Occurrence B_3:1084:15666: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0017; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1084
msgctxt "text_id=15666 | speaker=ritsuka"
msgid "「貴方は行ってはいけません。彼女たちに任せなさい」"
msgstr ""

#. Occurrence B_3:1113:15667: scene=B_3
#: B_3:1113
msgctxt "text_id=15667 | speaker=unknown"
msgid "　ぴしゃりと律架は言い放つ。"
msgstr ""

#. Occurrence B_3:1120:15668: scene=B_3
#: B_3:1120
msgctxt "text_id=15668 | speaker=unknown"
msgid "　立ち止まっている草十郎をよそに、有珠はドアを開け、礼拝堂の奥に行ってしまった。"
msgstr ""

#. Occurrence B_3:1149:15669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0005; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1149
msgctxt "text_id=15669 | speaker=soujuurou"
msgid "「行ってはいけないって、どうして」"
msgstr ""

#. Occurrence B_3:1155:15670: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0018; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1155
msgctxt "text_id=15670 | speaker=ritsuka"
msgid "「貴方のためよ。青子の容態は普通の人が見ていいものじゃない。気分を悪くするだけ。"
msgstr ""

#. Occurrence B_3:1168:15671: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0019; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1168
msgctxt "text_id=15671 | speaker=ritsuka"
msgid "　それとも……イヤな思いをしてもいいくらい、青子が心配なのかしら？」"
msgstr ""

#. Occurrence B_3:1203:15672: scene=B_3
#: B_3:1203
msgctxt "text_id=15672 | speaker=unknown"
msgid "　律架の問いかけに、草十郎はすぐには答えられなかった。"
msgstr ""

#. Occurrence B_3:1208:15673: scene=B_3
#: B_3:1208
msgctxt "text_id=15673 | speaker=unknown"
msgid "　……青子が良くない状況である事は分かっている。"
msgstr ""

#. Occurrence B_3:1213:15674: scene=B_3
#: B_3:1213
msgctxt "text_id=15674 | speaker=unknown"
msgid "　有珠の様子から察して、有珠以上の傷を負っているのかもしれない。"
msgstr ""

#. Occurrence B_3:1233:15675: scene=B_3
#: B_3:1233
msgctxt "text_id=15675 | speaker=unknown"
msgid "　そこまで承知していて、草十郎には青子のまいっている顔を想像できなかった。"
msgstr ""

#. Occurrence B_3:1266:15676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0006; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1266
msgctxt "text_id=15676 | speaker=soujuurou"
msgid "「―――蒼崎相手に心配なんかしません」"
msgstr ""

#. Occurrence B_3:1272:15677: scene=B_3
#: B_3:1272
msgctxt "text_id=15677 | speaker=unknown"
msgid "　だから、本当の意味での心配を、彼はしていなかったのだ。"
msgstr ""

#. Occurrence B_3:1293:15678: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0020; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1293
msgctxt "text_id=15678 | speaker=ritsuka"
msgid "「でも、会いにいくのね」"
msgstr ""

#. Occurrence B_3:1299:15679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0007; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1299
msgctxt "text_id=15679 | speaker=soujuurou"
msgid "「はい」"
msgstr ""

#. Occurrence B_3:1315:15680: scene=B_3
#: B_3:1315
msgctxt "text_id=15680 | speaker=unknown"
msgid "　律架の言葉に、草十郎は反射的に答えた。"
msgstr ""

#. Occurrence B_3:1321:15681: scene=B_3
#: B_3:1321
msgctxt "text_id=15681 | speaker=unknown"
msgid "　少年の未熟な勘違いにため息をつきながら、"
msgstr ""

msgctxt "text_id=15682 | speaker=unknown"
msgid "仕方なく律架は道を譲る。"
msgstr ""

#. Occurrence B_3:1364:15683: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0021; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1364
msgctxt "text_id=15683 | speaker=ritsuka"
msgid "「どうぞ、いってらっしゃい。"
msgstr ""

#. Occurrence B_3:1370:15684: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0022; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1370
msgctxt "text_id=15684 | speaker=ritsuka"
msgid "　有珠さんが使ったドアから入って、四番目の部屋よ。"
msgstr ""

#. Occurrence B_3:1376:15685: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0023; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1376
msgctxt "text_id=15685 | speaker=ritsuka"
msgid "　いま一番とりこんでる頃だから、ユイちゃんの邪魔だけはしないように」"
msgstr ""

#. Occurrence B_3:1409:15686: scene=B_3
#: B_3:1409
msgctxt "text_id=15686 | speaker=unknown"
msgid "　律架に礼を言って、草十郎は有珠の後を追った。"
msgstr ""

#. Occurrence B_3:1414:15687: scene=B_3
#: B_3:1414
msgctxt "text_id=15687 | speaker=unknown"
msgid "　礼拝堂には自称・近所のお姉さんである<周|す><瀬|せ>律架だけが残される。"
msgstr ""

#. Occurrence B_3:1459:15688: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0024; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1459
msgctxt "text_id=15688 | speaker=ritsuka"
msgid "「……さて。唯架あたりなら止めるんでしょうけど、ま、わたしは草十郎さんの味方だし、傷つく男の子とか大好物だし。"
msgstr ""

#. Occurrence B_3:1470:15689: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0025; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1470
msgctxt "text_id=15689 | speaker=ritsuka"
msgid "　少々スパルタと自覚しておりますが、これも親切な姉心と思って、草十郎さんには後悔していただきましょう！」"
msgstr ""

#. Occurrence B_3:1501:15690: scene=B_3
#: B_3:1501
msgctxt "text_id=15690 | speaker=unknown"
msgid "　力強く断言するも、もちろん、礼拝堂には律架しかいない。"
msgstr ""

#. Occurrence B_3:1515:15691: scene=B_3
#: B_3:1515
msgctxt "text_id=15691 | speaker=unknown"
msgid "　やれやれと肩をすくめながら、律架は不信心に十字を切る。"
msgstr ""

#. Occurrence B_3:1535:15692: scene=B_3
#: B_3:1535
msgctxt "text_id=15692 | speaker=unknown"
msgid "　……遠くなっていく足音。"
msgstr ""

#. Occurrence B_3:1562:15693: scene=B_3
#: B_3:1562
msgctxt "text_id=15693 | speaker=unknown"
msgid "　その<躊躇|ためらい>のなさが、律架には痛ましい。"
msgstr ""

#. Occurrence B_3:1567:15694: scene=B_3
#: B_3:1567
msgctxt "text_id=15694 | speaker=unknown"
msgid "　なぜなら、少年が振り向かないのは迷いがないからではなく。"
msgstr ""

#. Occurrence B_3:1572:15695: scene=B_3
#: B_3:1572
msgctxt "text_id=15695 | speaker=unknown"
msgid "　彼本人が意識していない根本的な恐れから、ただ目を逸らしているだけなのだから。"
msgstr ""

#. Occurrence B_3:1621:15696: scene=B_3
#: B_3:1621
msgctxt "text_id=15696 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　　　　　老人は語った。"
msgstr ""

#. Occurrence B_3:1643:15697: scene=B_3
#: B_3:1643
msgctxt "text_id=15697 | speaker=unknown"
msgid "　生き物の死と、人間の死は違うもんだ。"
msgstr ""

#. Occurrence B_3:1648:15698: scene=B_3
#: B_3:1648
msgctxt "text_id=15698 | speaker=unknown"
msgid "　同じように思えるかもしれないが、もう根本からぜんぜん違う。"
msgstr ""

#. Occurrence B_3:1653:15699: scene=B_3
#: B_3:1653
msgctxt "text_id=15699 | speaker=unknown"
msgid "　オレたちの<頭|ココ>は、はじめからそういう<区|・><別|・>をするように出来ている。"
msgstr ""

#. Occurrence B_3:1675:15700: scene=B_3
#: B_3:1675
msgctxt "text_id=15700 | speaker=unknown"
msgid "　鹿だの豚だのの<死骸|しがい>と、<同|・><じ|・><生|・><き|・><物|・>の死骸は違う。"
msgstr ""

#. Occurrence B_3:1681:15701: scene=B_3
#: B_3:1681
msgctxt "text_id=15701 | speaker=unknown"
msgid "　鉈だの斧だのを振るうのが暴力なら、"
msgstr ""

msgctxt "text_id=15702 | speaker=unknown"
msgid "　人間の死骸ってのも否応なしの暴力だ。"
msgstr ""

#. Occurrence B_3:1688:15703: scene=B_3
#: B_3:1688
msgctxt "text_id=15703 | speaker=unknown"
msgid "　なんで、そういうモンに出遭う前に、言葉でだけでも知っておけばいい。"
msgstr ""

#. Occurrence B_3:1712:15704: scene=B_3
#: B_3:1712
msgctxt "text_id=15704 | speaker=unknown"
msgid "　いいかい草<十|ぼうず>郎。"
msgstr ""

#. Occurrence B_3:1717:15705: scene=B_3
#: B_3:1717
msgctxt "text_id=15705 | speaker=unknown"
msgid "　人が死ぬ時はな、目を背けたくなるぐらい、赤い血が流れていくもんなんだ――――――"
msgstr ""

#. Occurrence B_3:1745:15706: scene=B_3
#: B_3:1745
msgctxt "text_id=15706 | speaker=unknown"
msgid "　……慣れない、石造りの通路を歩いたせいか。"
msgstr ""

#. Occurrence B_3:1750:15707: scene=B_3
#: B_3:1750
msgctxt "text_id=15707 | speaker=unknown"
msgid "　彼は幼い頃に聞いた、他愛のない話を思い出した。"
msgstr ""

#. Occurrence B_3:1815:15708: scene=B_3
#: B_3:1815
msgctxt "text_id=15708 | speaker=unknown"
msgid "　ドアを開けた瞬間、異様な、違う空気が流れている事を思い知った。"
msgstr ""

#. Occurrence B_3:1820:15709: scene=B_3
#: B_3:1820
msgctxt "text_id=15709 | speaker=unknown"
msgid "　部屋は小さな個室で、簡素なベッドと、小さな桐のタンスがあるだけだ。"
msgstr ""

#. Occurrence B_3:1825:15710: scene=B_3
#: B_3:1825
msgctxt "text_id=15710 | speaker=unknown"
msgid "　ベッドには　　が横臥している。"
msgstr ""

#. Occurrence B_3:1830:15711: scene=B_3
#: B_3:1830
msgctxt "text_id=15711 | speaker=unknown"
msgid "　　　を看病しているのは、さっき礼拝堂にいた律架という女性だった。"
msgstr ""

#. Occurrence B_3:1891:15712: scene=B_3
#: B_3:1891
msgctxt "text_id=15712 | speaker=unknown"
msgid "　……いや、それは律架によく似た女性にすぎない。"
msgstr ""

#. Occurrence B_3:1896:15713: scene=B_3
#: B_3:1896
msgctxt "text_id=15713 | speaker=unknown"
msgid "　閉じられた目蓋と、血に濡れている修道服。"
msgstr ""

#. Occurrence B_3:1901:15714: scene=B_3
#: B_3:1901
msgctxt "text_id=15714 | speaker=unknown"
msgid "　一度なり面識はある。"
msgstr ""

#. Occurrence B_3:1906:15715: scene=B_3
#: B_3:1906
msgctxt "text_id=15715 | speaker=unknown"
msgid "　彼女はこの教会のシスター、<周|す><瀬|せ><唯架|ゆいか>だ。"
msgstr ""

#. Occurrence B_3:1928:15716: scene=B_3
#: B_3:1928
msgctxt "text_id=15716 | speaker=unknown"
msgid "　唯架は横臥している　　に触れている。"
msgstr ""

#. Occurrence B_3:1933:15717: scene=B_3
#: B_3:1933
msgctxt "text_id=15717 | speaker=unknown"
msgid "　その手にはハサミと糸。"
msgstr ""

#. Occurrence B_3:1938:15718: scene=B_3
#: B_3:1938
msgctxt "text_id=15718 | speaker=unknown"
msgid "　シスターはオルガンを<弾|ひ>く静かさで、たおやかに、しかし<迅速|じんそく>に指を動かす。"
msgstr ""

#. Occurrence B_3:1943:15719: scene=B_3
#: B_3:1943
msgctxt "text_id=15719 | speaker=unknown"
msgid "　<淀|よど>みのない手順は、そういう楽譜があるかのようだ。"
msgstr ""

#. Occurrence B_3:1948:15720: scene=B_3
#: B_3:1948
msgctxt "text_id=15720 | speaker=unknown"
msgid "　包帯は次から次へと消費される。"
msgstr ""

#. Occurrence B_3:1953:15721: scene=B_3
#: B_3:1953
msgctxt "text_id=15721 | speaker=unknown"
msgid "　さきほどまで使われていた包帯がはがされ、新しい包帯が、<潰|つぶ>れた人体部分を隠していく。"
msgstr ""

#. Occurrence B_3:1973:15722: scene=B_3
#: B_3:1973
msgctxt "text_id=15722 | speaker=unknown"
msgid "　血を拭うガーゼも、いいかげん使いすぎだ。"
msgstr ""

#. Occurrence B_3:1980:15723: scene=B_3
#: B_3:1980
msgctxt "text_id=15723 | speaker=unknown"
msgid "　投げ捨てた布の色は白ではなく赤。"
msgstr ""

#. Occurrence B_3:1985:15724: scene=B_3
#: B_3:1985
msgctxt "text_id=15724 | speaker=unknown"
msgid "　床に積もった布切れは、汚れた薔薇を思わせる。"
msgstr ""

#. Occurrence B_3:1991:15725: scene=B_3
#: B_3:1991
msgctxt "text_id=15725 | speaker=unknown"
msgid "　腐った薔薇園でオルガンを演奏するシスター。"
msgstr ""

#. Occurrence B_3:1997:15726: scene=B_3
#: B_3:1997
msgctxt "text_id=15726 | speaker=unknown"
msgid "　ますます、現実味というものがない。"
msgstr ""

#. Occurrence B_3:2017:15727: scene=B_3
#: B_3:2017
msgctxt "text_id=15727 | speaker=unknown"
msgid "　空気が違う理由は明らかだ。"
msgstr ""

#. Occurrence B_3:2050:15728: scene=B_3
#: B_3:2050
msgctxt "text_id=15728 | speaker=unknown"
msgid "　この部屋の空気には匂いがついている。"
msgstr ""

#. Occurrence B_3:2055:15729: scene=B_3
#: B_3:2055
msgctxt "text_id=15729 | speaker=unknown"
msgid "　初めて体験してもそれだと判ってしまう、胸の焼け付く、重い匂い。"
msgstr ""

#. Occurrence B_3:2091:15730: scene=B_3
#: B_3:2091
msgctxt "text_id=15730 | speaker=unknown"
msgid "　彼の視線は、どうにもベッドに定まらない。"
msgstr ""

#. Occurrence B_3:2096:15731: scene=B_3
#: B_3:2096
msgctxt "text_id=15731 | speaker=unknown"
msgid "　気持ちとは裏腹に、関係のない箇所ばかり見ようとする。"
msgstr ""

#. Occurrence B_3:2116:15732: scene=B_3
#: B_3:2116
msgctxt "text_id=15732 | speaker=unknown"
msgid "　見れば、有珠はベッドの横に立っていた。"
msgstr ""

#. Occurrence B_3:2159:15733: scene=B_3
#: B_3:2159
msgctxt "text_id=15733 | speaker=unknown"
msgid "　いつもの無表情な立ち姿が、今は<卒塔婆|そとば>のように見える。"
msgstr ""

#. Occurrence B_3:2164:15734: scene=B_3
#: B_3:2164
msgctxt "text_id=15734 | speaker=unknown"
msgid "　彼女は<微|かす>かに震えていた。"
msgstr ""

#. Occurrence B_3:2169:15735: scene=B_3
#: B_3:2169
msgctxt "text_id=15735 | speaker=unknown"
msgid "　<怯|おび>えか不安、それとも憎しみによる憤怒かは、どうにも。"
msgstr ""

#. Occurrence B_3:2209:15736: scene=B_3
#: B_3:2209
msgctxt "text_id=15736 | speaker=unknown"
msgid "　その視線の先に、死に<瀕|ひん>する生き物が一つ。"
msgstr ""

#. Occurrence B_3:2257:15737: scene=B_3
#: B_3:2257
msgctxt "text_id=15737 | speaker=unknown"
msgid "　ベッドに横たわるソレが何であるか、一見では頭に入らない。"
msgstr ""

#. Occurrence B_3:2262:15738: scene=B_3
#: B_3:2262
msgctxt "text_id=15738 | speaker=unknown"
msgid "　ところどころ包帯に巻かれた人形。"
msgstr ""

#. Occurrence B_3:2282:15739: scene=B_3
#: B_3:2282
msgctxt "text_id=15739 | speaker=unknown"
msgid "　美しかった髪は乱れて、呼吸は短く小さいクセに、胸はせわしなく上下している。"
msgstr ""

#. Occurrence B_3:2287:15740: scene=B_3
#: B_3:2287
msgctxt "text_id=15740 | speaker=unknown"
msgid "　どことなく滑稽で、デパートの屋上で見た、ロデオマシーンを彷彿とさせる。"
msgstr ""

#. Occurrence B_3:2293:15741: scene=B_3
#: B_3:2293
msgctxt "text_id=15741 | speaker=unknown"
msgid "　―――ああ。"
msgstr ""

#. Occurrence B_3:2298:15742: scene=B_3
#: B_3:2298
msgctxt "text_id=15742 | speaker=unknown"
msgid "　では、麻酔とか鎮痛剤とか、そういうものは効いていないのか。"
msgstr ""

#. Occurrence B_3:2320:15743: scene=B_3
#: B_3:2320
msgctxt "text_id=15743 | speaker=unknown"
msgid "　真新しい包帯は秒刻みで朱色に<滲|にじ>んでいく。"
msgstr ""

#. Occurrence B_3:2325:15744: scene=B_3
#: B_3:2325
msgctxt "text_id=15744 | speaker=unknown"
msgid "　シーツに食いこむ五指の爪。"
msgstr ""

#. Occurrence B_3:2330:15745: scene=B_3
#: B_3:2330
msgctxt "text_id=15745 | speaker=unknown"
msgid "　苦しみに歪む顔。"
msgstr ""

#. Occurrence B_3:2335:15746: scene=B_3
#: B_3:2335
msgctxt "text_id=15746 | speaker=unknown"
msgid "　麻酔は効かず、生きているのなら、意識だってあるだろう。"
msgstr ""

#. Occurrence B_3:2340:15747: scene=B_3
#: B_3:2340
msgctxt "text_id=15747 | speaker=unknown"
msgid "　誰も不安に思わないのか、と不安になる。"
msgstr ""

#. Occurrence B_3:2345:15748: scene=B_3
#: B_3:2345
msgctxt "text_id=15748 | speaker=unknown"
msgid "　あれでは体の傷より、痛みで心が先に死ぬ。"
msgstr ""

#. Occurrence B_3:2418:15749: scene=B_3
#: B_3:2418
msgctxt "text_id=15749 | speaker=unknown"
msgid "　端的に言って。"
msgstr ""

#. Occurrence B_3:2423:15750: scene=B_3
#: B_3:2423
msgctxt "text_id=15750 | speaker=unknown"
msgid "　それは少年にとって、二度と見たくない光景だった。"
msgstr ""

#. Occurrence B_3:2492:15751: scene=B_3
#: B_3:2492
msgctxt "text_id=15751 | speaker=unknown"
msgid "　本来清潔であるべき白いベッドが、またたくまに赤く染まっていく。"
msgstr ""

#. Occurrence B_3:2497:15752: scene=B_3
#: B_3:2497
msgctxt "text_id=15752 | speaker=unknown"
msgid "　その中心で流血する人形が彼女なのだと認めて、"
msgstr ""

#. Occurrence B_3:2502:15753: scene=B_3
#: B_3:2502
msgctxt "text_id=15753 | speaker=unknown"
msgid "　体中の血管が膨張する。"
msgstr ""

#. Occurrence B_3:2507:15754: scene=B_3
#: B_3:2507
msgctxt "text_id=15754 | speaker=unknown"
msgid "　ベッドの<軋|きし>む音も、ハサミの刃がこすれる音も、彼女の苦悶も<彼岸|ひがん>の話。"
msgstr ""

#. Occurrence B_3:2528:15755: scene=B_3
#: B_3:2528
msgctxt "text_id=15755 | speaker=unknown"
msgid "　自分の鼓動だけが<耳朶|じだ>に響く。"
msgstr ""

#. Occurrence B_3:2564:15756: scene=B_3
#: B_3:2564
msgctxt "text_id=15756 | speaker=unknown"
msgid "　むせ返る血の匂いに、吐き気がする。"
msgstr ""

#. Occurrence B_3:2569:15757: scene=B_3
#: B_3:2569
msgctxt "text_id=15757 | speaker=unknown"
msgid "　膝から力が失われる感覚。"
msgstr ""

#. Occurrence B_3:2618:15758: scene=B_3
#: B_3:2618
msgctxt "text_id=15758 | speaker=unknown"
msgid "　でも、それは仕方のない事だ。"
msgstr ""

#. Occurrence B_3:2641:15759: scene=B_3
#: B_3:2641
msgctxt "text_id=15759 | speaker=unknown"
msgid "　精神の安全装置が、断りもなく意識を遮断する。"
msgstr ""

#. Occurrence B_3:2647:15760: scene=B_3
#: B_3:2647
msgctxt "text_id=15760 | speaker=unknown"
msgid "　自明の理にも程がある。"
msgstr ""

#. Occurrence B_3:2653:15761: scene=B_3
#: B_3:2653
msgctxt "text_id=15761 | speaker=unknown"
msgid "　―――だってこんなモノ、何を引き替えにしても、彼は二度と見たくはなかったのだ。"
msgstr ""

#. Occurrence B_4:58:15762: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0000; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:58
msgctxt "text_id=15762 | speaker=ritsuka"
msgid "“―――そうか。青子ちゃんは全部分かっているんだね。"
msgstr ""

#. Occurrence B_4:64:15763: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0001; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:64
msgctxt "text_id=15763 | speaker=ritsuka"
msgid "　自分だけのコトじゃなくて、"
msgstr ""

#. Occurrence B_4:70:15764: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0002; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:70
msgctxt "text_id=15764 | speaker=ritsuka"
msgid "　このあとに起きるコトも、なにが残ってなにが残らないのかも、全部まっすぐに受けとめている。"
msgstr ""

#. Occurrence B_4:76:15765: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0003; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:76
msgctxt "text_id=15765 | speaker=ritsuka"
msgid "　それでも自分であり続けられるという事は、"
msgstr ""

msgctxt "text_id=15766 | speaker=unknown"
msgid "　とても強いことなんだよ―――”"
msgstr ""

#. Occurrence B_4:118:15767: scene=B_4
#: B_4:118
msgctxt "text_id=15767 | speaker=unknown"
msgid "　などと。"
msgstr ""

#. Occurrence B_4:123:15768: scene=B_4
#: B_4:123
msgctxt "text_id=15768 | speaker=unknown"
msgid "　その人は、私がわりと好きだった笑顔で、いちばん言ってほしくない事を、誇らしげに口にした。"
msgstr ""

#. Occurrence B_4:128:15769: scene=B_4
#: B_4:128
msgctxt "text_id=15769 | speaker=unknown"
msgid "　今では遠い昔のように思える中学の卒業式。"
msgstr ""

#. Occurrence B_4:133:15770: scene=B_4
#: B_4:133
msgctxt "text_id=15770 | speaker=unknown"
msgid "　早咲きの桜が舞い散る中、私のささやかな夢は、木っ端微塵に砕け散ったのだ。"
msgstr ""

#. Occurrence B_4:185:15771: scene=B_4
#: B_4:185
msgctxt "text_id=15771 | speaker=unknown"
msgid "　だいたい、私は自分が強いなんて思った事はなかった。"
msgstr ""

#. Occurrence B_4:190:15772: scene=B_4
#: B_4:190
msgctxt "text_id=15772 | speaker=unknown"
msgid "　少なくとも、この言葉を時折思い出すようになるまでは。"
msgstr ""

#. Occurrence B_4:197:15773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_4_0000; voice_prefix=A30; voice_category=3; scene=B_4
#: B_4:197
msgctxt "text_id=15773 | speaker=soujuurou"
msgid "“蒼崎は分かってると思ってた。"
msgstr ""

#. Occurrence B_4:203:15774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_4_0001; voice_prefix=A30; voice_category=3; scene=B_4
#: B_4:203
msgctxt "text_id=15774 | speaker=soujuurou"
msgid "　いや、きっと分かってるんだな。だから、そこが強いんだろうね”"
msgstr ""

#. Occurrence B_4:223:15775: scene=B_4
#: B_4:223
msgctxt "text_id=15775 | speaker=unknown"
msgid "　……なのに最近、そんな<戯|たわ>けたコトを言った奴がいる。"
msgstr ""

#. Occurrence B_4:228:15776: scene=B_4
#: B_4:228
msgctxt "text_id=15776 | speaker=unknown"
msgid "　自分の判断基準がまわりとズレている事は知っていたけど、知り合って何日も経たない相手に指摘されたのは、ちょっとしたショックだった。"
msgstr ""

#. Occurrence B_4:233:15777: scene=B_4
#: B_4:233
msgctxt "text_id=15777 | speaker=unknown"
msgid "　おまけに台詞までそっくりで、あの時は怒りのあまり我を忘れたほどである。"
msgstr ""

#. Occurrence B_4:253:15778: scene=B_4
#: B_4:253
msgctxt "text_id=15778 | speaker=unknown"
msgid "　……今まで、私に対してそんなことを言ってきたのは彼を含めて二人だけ。"
msgstr ""

#. Occurrence B_4:258:15779: scene=B_4
#: B_4:258
msgctxt "text_id=15779 | speaker=unknown"
msgid "　けど、おそらくは姉貴も無言で言っていたのだ。"
msgstr ""

#. Occurrence B_4:264:15780: scene=B_4
#: B_4:264
msgctxt "text_id=15780 | speaker=unknown"
msgid "　おまえは、<自分|わたし>たちとは違う。"
msgstr ""

#. Occurrence B_4:270:15781: scene=B_4
#: B_4:270
msgctxt "text_id=15781 | speaker=unknown"
msgid "　私にとって、それは賛美の声ではなく、呪いにしか聞こえなかった。"
msgstr ""

#. Occurrence B_4:292:15782: scene=B_4
#: B_4:292
msgctxt "text_id=15782 | speaker=unknown"
msgid "　自分の一挙一動、意志選択、善悪基準から<迫害|はくがい><博愛|はくあい>。"
msgstr ""

#. Occurrence B_4:297:15783: scene=B_4
#: B_4:297
msgctxt "text_id=15783 | speaker=unknown"
msgid "　そのすべてを承知した上で、まだ自分が<大事|いちばん>なのか。"
msgstr ""

#. Occurrence B_4:302:15784: scene=B_4
#: B_4:302
msgctxt "text_id=15784 | speaker=unknown"
msgid "　もちろんだ。周りの為に自分を犠牲にするのなんて、どうあっても選べない。"
msgstr ""

#. Occurrence B_4:307:15785: scene=B_4
#: B_4:307
msgctxt "text_id=15785 | speaker=unknown"
msgid "　その<孤|こだわ>り、その道化ぶりを分かっていながら、自分であり続けられる事を、彼らは強いといった。"
msgstr ""

#. Occurrence B_4:327:15786: scene=B_4
#: B_4:327
msgctxt "text_id=15786 | speaker=unknown"
msgid "　幼い私は首をかしげるしかない。"
msgstr ""

#. Occurrence B_4:332:15787: scene=B_4
#: B_4:332
msgctxt "text_id=15787 | speaker=unknown"
msgid "　だって、私は違うやり方を見いだせないだけだ。"
msgstr ""

#. Occurrence B_4:337:15788: scene=B_4
#: B_4:337
msgctxt "text_id=15788 | speaker=unknown"
msgid "　悔しいぐらい、『ただ諦める』勇気を持てないだけ。"
msgstr ""

#. Occurrence B_4:343:15789: scene=B_4
#: B_4:343
msgctxt "text_id=15789 | speaker=unknown"
msgid "　なのにどうして―――"
msgstr ""

#. Occurrence B_4:348:15790: scene=B_4
#: B_4:348
msgctxt "text_id=15790 | speaker=unknown"
msgid "　そんな当たり前の事が、特別扱いされるんだろう―――？"
msgstr ""

#. Occurrence B_4:393:15791: scene=B_4
#: B_4:393
msgctxt "text_id=15791 | speaker=unknown"
msgid "　……朝の光で目を覚ます。"
msgstr ""

#. Occurrence B_4:398:15792: scene=B_4
#: B_4:398
msgctxt "text_id=15792 | speaker=unknown"
msgid "　全身を霊糸で<縫|ぬ>った痛みのせいか。"
msgstr ""

#. Occurrence B_4:403:15793: scene=B_4
#: B_4:403
msgctxt "text_id=15793 | speaker=unknown"
msgid "　他愛のない夢を、見たようだ。"
msgstr ""

#. Occurrence B_4:434:15794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0000; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:434
msgctxt "text_id=15794 | speaker=aoko"
msgid "「―――、ぁ―――」"
msgstr ""

#. Occurrence B_4:440:15795: scene=B_4
#: B_4:440
msgctxt "text_id=15795 | speaker=unknown"
msgid "　ガラガラに渇いて傷ついた喉が、大きく深呼吸をする。"
msgstr ""

#. Occurrence B_4:445:15796: scene=B_4
#: B_4:445
msgctxt "text_id=15796 | speaker=unknown"
msgid "　小さな窓から差しこむ灰色の日射しは、彼女の意識をゆっくりと覚醒させた。"
msgstr ""

#. Occurrence B_4:466:15797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0001; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:466
msgctxt "text_id=15797 | speaker=aoko"
msgid "「うわ、体中、かゆ……」"
msgstr ""

#. Occurrence B_4:473:15798: scene=B_4
#: B_4:473
msgctxt "text_id=15798 | speaker=unknown"
msgid "　耐えきれず寝返りをうってみる。"
msgstr ""

#. Occurrence B_4:478:15799: scene=B_4
#: B_4:478
msgctxt "text_id=15799 | speaker=unknown"
msgid "　が、動かせたのは右腕だけ。"
msgstr ""

#. Occurrence B_4:483:15800: scene=B_4
#: B_4:483
msgctxt "text_id=15800 | speaker=unknown"
msgid "　肘から先を持ち上げてみても、嘘のように感覚がない。"
msgstr ""

#. Occurrence B_4:489:15801: scene=B_4
#: B_4:489
msgctxt "text_id=15801 | speaker=unknown"
msgid "　腕に向けた集中をそらすと、"
msgstr ""

msgctxt "text_id=15802 | speaker=unknown"
msgid "包帯だらけの腕はぱたん、と力なくベッドに落ちた。"
msgstr ""

#. Occurrence B_4:512:15803: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0002; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:512
msgctxt "text_id=15803 | speaker=aoko"
msgid "「――――――さて」"
msgstr ""

#. Occurrence B_4:532:15804: scene=B_4
#: B_4:532
msgctxt "text_id=15804 | speaker=unknown"
msgid "　青子は視線だけで状況を確認する。"
msgstr ""

#. Occurrence B_4:552:15805: scene=B_4
#: B_4:552
msgctxt "text_id=15805 | speaker=unknown"
msgid "　……自分はベッドに眠っていたらしい。"
msgstr ""

#. Occurrence B_4:557:15806: scene=B_4
#: B_4:557
msgctxt "text_id=15806 | speaker=unknown"
msgid "　体のあちこちの感覚がなくて、ロボットか何かになった気がする。"
msgstr ""

#. Occurrence B_4:562:15807: scene=B_4
#: B_4:562
msgctxt "text_id=15807 | speaker=unknown"
msgid "　部屋は狭くて何の飾り気もない。"
msgstr ""

#. Occurrence B_4:584:15808: scene=B_4
#: B_4:584
msgctxt "text_id=15808 | speaker=unknown"
msgid "　まるで入居前のマンションだ。手入れは行き届いているところを見て、合田教会の一室だろう、とアタリをつける。"
msgstr ""

#. Occurrence B_4:604:15809: scene=B_4
#: B_4:604
msgctxt "text_id=15809 | speaker=unknown"
msgid "　外は朝というより昼に近い。"
msgstr ""

#. Occurrence B_4:609:15810: scene=B_4
#: B_4:609
msgctxt "text_id=15810 | speaker=unknown"
msgid "　空は相変わらず曇っていて、日射しは弱々しい。"
msgstr ""

#. Occurrence B_4:614:15811: scene=B_4
#: B_4:614
msgctxt "text_id=15811 | speaker=unknown"
msgid "　この分では雪解けはもっと先になってしまうだろうな、と取りとめのない事が頭によぎる。"
msgstr ""

#. Occurrence B_4:623:15812: scene=B_4
#: B_4:623
msgctxt "text_id=15812 | speaker=unknown"
msgid "　そうして最後に、青子は彼女の姿を認めた。"
msgstr ""

#. Occurrence B_4:628:15813: scene=B_4
#: B_4:628
msgctxt "text_id=15813 | speaker=unknown"
msgid "　自分の眠るベッドの横で、椅子に座ったまま動かない久遠寺有珠の姿を。"
msgstr ""

#. Occurrence B_4:649:15814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0003; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:649
msgctxt "text_id=15814 | speaker=aoko"
msgid "「……おはよ、有珠」"
msgstr ""

#. Occurrence B_4:655:15815: scene=B_4
#: B_4:655
msgctxt "text_id=15815 | speaker=unknown"
msgid "　やあ、とばかりに青子は有珠に呼びかけた。"
msgstr ""

#. Occurrence B_4:660:15816: scene=B_4
#: B_4:660
msgctxt "text_id=15816 | speaker=unknown"
msgid "　口の中がやたら<鈍|にぶ>い。"
msgstr ""

#. Occurrence B_4:684:15817: scene=B_4
#: B_4:684
msgctxt "text_id=15817 | speaker=unknown"
msgid "　有珠はあいかわらずの無表情。"
msgstr ""

#. Occurrence B_4:689:15818: scene=B_4
#: B_4:689
msgctxt "text_id=15818 | speaker=unknown"
msgid "　ただ、その瞳に同居人をいたわる<翳|かげ>りがあったのを、青子は見逃さなかった。"
msgstr ""

#. Occurrence B_4:725:15819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0004; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:725
msgctxt "text_id=15819 | speaker=aoko"
msgid "「寝てないんでしょ。肌が荒れてる」"
msgstr ""

#. Occurrence B_4:751:15820: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_4_0000; voice_prefix=A40; voice_category=2; scene=B_4
#: B_4:751
msgctxt "text_id=15820 | speaker=alice"
msgid "「……努力はしたわ。けど、橙子さんに飲まされた物が解毒されるまで眠れそうにないの。"
msgstr ""

#. Occurrence B_4:757:15821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_4_0001; voice_prefix=A40; voice_category=2; scene=B_4
#: B_4:757
msgctxt "text_id=15821 | speaker=alice"
msgid "　半端な痛みは、こういう時に<生温|なまぬる>いわね」"
msgstr ""

#. Occurrence B_4:799:15822: scene=B_4
#: B_4:799
msgctxt "text_id=15822 | speaker=unknown"
msgid "　少女らしからぬ相方の台詞を聞いて、青子はますます気持ちを生き返らせた。"
msgstr ""

#. Occurrence B_4:804:15823: scene=B_4
#: B_4:804
msgctxt "text_id=15823 | speaker=unknown"
msgid "　今は心配してくれる隣人より、ともに戦ってくれる友人の方が心強い。"
msgstr ""

#. Occurrence B_4:852:15824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0005; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:852
msgctxt "text_id=15824 | speaker=aoko"
msgid "「そ、有珠もやられたの。"
msgstr ""

#. Occurrence B_4:858:15825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0006; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:858
msgctxt "text_id=15825 | speaker=aoko"
msgid "　……状況はだいたい予想してるけど、一応、細部を聞かせてくれない？」"
msgstr ""

#. Occurrence B_4:863:15826: scene=B_4
#: B_4:863
msgctxt "text_id=15826 | speaker=unknown"
msgid "　ベッドに横になったまま、青子は凛とした口調で言う。"
msgstr ""

#. Occurrence B_4:903:15827: scene=B_4
#: B_4:903
msgctxt "text_id=15827 | speaker=unknown"
msgid "　青子の無茶を、有珠は止めもせず聞き入れた。"
msgstr ""

#. Occurrence B_4:908:15828: scene=B_4
#: B_4:908
msgctxt "text_id=15828 | speaker=unknown"
msgid "　もう二年近い付き合いだ。"
msgstr ""

#. Occurrence B_4:913:15829: scene=B_4
#: B_4:913
msgctxt "text_id=15829 | speaker=unknown"
msgid "　こういう時、蒼崎青子という少女にとって何が一番の麻酔になるのか、有珠はよく理解していた。"
msgstr ""

#. Occurrence B_5:51:15830: scene=B_5
#: B_5:51
msgctxt "text_id=15830 | speaker=unknown"
msgid "　久遠寺有珠と蒼崎橙子の戦いは、有珠の勝利で終わった。"
msgstr ""

#. Occurrence B_5:103:15831: scene=B_5
#: B_5:103
msgctxt "text_id=15831 | speaker=unknown"
msgid "　橋の巨人は“童話の怪物”の中でも特別な使い魔だ。"
msgstr ""

#. Occurrence B_5:108:15832: scene=B_5
#: B_5:108
msgctxt "text_id=15832 | speaker=unknown"
msgid "　フラットスナークのような大異能はないが、その巨体、強度、出力、どれをとってもトップランクの性能を誇る。"
msgstr ""

#. Occurrence B_5:113:15833: scene=B_5
#: B_5:113
msgctxt "text_id=15833 | speaker=unknown"
msgid "　橙子のルーン魔術では表面の<石膚|せきふ>さえ破壊できまい。"
msgstr ""

#. Occurrence B_5:119:15834: scene=B_5
#: B_5:119
msgctxt "text_id=15834 | speaker=unknown"
msgid "　それは橙子に限った話ではない。現代の魔術師、その大部分は橋の巨人の前に敗れ去るだろう。"
msgstr ""

#. Occurrence B_5:139:15835: scene=B_5
#: B_5:139
msgctxt "text_id=15835 | speaker=unknown"
msgid "　身にまとった神秘の違いだ。"
msgstr ""

#. Occurrence B_5:144:15836: scene=B_5
#: B_5:144
msgctxt "text_id=15836 | speaker=unknown"
msgid "　魔術の原則として、神秘はより強い神秘の前に敗北する。"
msgstr ""

#. Occurrence B_5:189:15837: scene=B_5
#: B_5:189
msgctxt "text_id=15837 | speaker=unknown"
msgid "　橋の巨人が持つ歴史は単体で千年<級|クラス>。"
msgstr ""

#. Occurrence B_5:194:15838: scene=B_5
#: B_5:194
msgctxt "text_id=15838 | speaker=unknown"
msgid "　その起源はイギリスがローマの支配下にあった一世紀にまで<遡|さかのぼ>る。"
msgstr ""

#. Occurrence B_5:199:15839: scene=B_5
#: B_5:199
msgctxt "text_id=15839 | speaker=unknown"
msgid "　いかにルーンが神代の技術であったとしても、悲しいかな、歴史の影に埋もれた魔術。"
msgstr ""

#. Occurrence B_5:205:15840: scene=B_5
#: B_5:205
msgctxt "text_id=15840 | speaker=unknown"
msgid "一度死んだモノを、その都度、起こして利用しているにすぎない。"
msgstr ""

#. Occurrence B_5:264:15841: scene=B_5
#: B_5:264
msgctxt "text_id=15841 | speaker=unknown"
msgid "　だが、橋の巨人、童話の怪物たちは違う。"
msgstr ""

#. Occurrence B_5:269:15842: scene=B_5
#: B_5:269
msgctxt "text_id=15842 | speaker=unknown"
msgid "　彼等は今も、久遠寺有珠の手の中で生きている。"
msgstr ""

#. Occurrence B_5:274:15843: scene=B_5
#: B_5:274
msgctxt "text_id=15843 | speaker=unknown"
msgid "　千年以上も前に詠唱され、今も機能し続ける魔術は、世界広しと言えど有珠のプロイと他に二つあるかないか。"
msgstr ""

#. Occurrence B_5:294:15844: scene=B_5
#: B_5:294
msgctxt "text_id=15844 | speaker=unknown"
msgid "　一方、ルーン魔術を扱う橙子の年齢は二十年程度。"
msgstr ""

#. Occurrence B_5:299:15845: scene=B_5
#: B_5:299
msgctxt "text_id=15845 | speaker=unknown"
msgid "　ルーンを<刻|きざ>む時間にいたっては一瞬だ。"
msgstr ""

#. Occurrence B_5:304:15846: scene=B_5
#: B_5:304
msgctxt "text_id=15846 | speaker=unknown"
msgid "　有珠の故郷、その象徴の一つであるロンドン橋の擬人化を敗れる道理がない。"
msgstr ""

#. Occurrence B_5:339:15847: scene=B_5
#: B_5:339
msgctxt "text_id=15847 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence B_5:356:15848: scene=B_5
#: B_5:356
msgctxt "text_id=15848 | speaker=unknown"
msgid "　そこに、“童話の怪物”を上回る怪物が現れた。"
msgstr ""

#. Occurrence B_5:361:15849: scene=B_5
#: B_5:361
msgctxt "text_id=15849 | speaker=unknown"
msgid "　黄金の獣、ベオウルフ。"
msgstr ""

#. Occurrence B_5:366:15850: scene=B_5
#: B_5:366
msgctxt "text_id=15850 | speaker=unknown"
msgid "　橋の巨人とは比べるべくもない、小さく非力な狼は、<果敢|かかん>にも天を<覆|おお>う石くれに立ち向かった。"
msgstr ""

#. Occurrence B_5:399:15851: scene=B_5
#: B_5:399
msgctxt "text_id=15851 | speaker=unknown"
msgid "　大地を揺るがす巨人の一撃。"
msgstr ""

#. Occurrence B_5:404:15852: scene=B_5
#: B_5:404
msgctxt "text_id=15852 | speaker=unknown"
msgid "　直撃すれば<ぺしゃんこ|ペースト>に、"
msgstr ""

#. Occurrence B_5:409:15853: scene=B_5
#: B_5:409
msgctxt "text_id=15853 | speaker=unknown"
msgid "　かするだけでも<挽肉|ミンチ>になる50トンの衝撃。"
msgstr ""

#. Occurrence B_5:414:15854: scene=B_5
#: B_5:414
msgctxt "text_id=15854 | speaker=unknown"
msgid "　それを狼は、真っ正面から<食|・><い|・><破|・><っ|・><た|・>。"
msgstr ""

#. Occurrence B_5:513:15855: scene=B_5
#: B_5:513
msgctxt "text_id=15855 | speaker=unknown"
msgid "　毛並みが逆立つ。"
msgstr ""

#. Occurrence B_5:518:15856: scene=B_5
#: B_5:518
msgctxt "text_id=15856 | speaker=unknown"
msgid "　その容姿が、流体のように変貌する。"
msgstr ""

#. Occurrence B_5:523:15857: scene=B_5
#: B_5:523
msgctxt "text_id=15857 | speaker=unknown"
msgid "　あまりにも<荘厳|そうごん>な立ち振る舞い。"
msgstr ""

#. Occurrence B_5:528:15858: scene=B_5
#: B_5:528
msgctxt "text_id=15858 | speaker=unknown"
msgid "　金狼は歓びを示すように月に吠え、文字通り、金色の光となって<爆|は>ぜ<走|ばし>る。"
msgstr ""

#. Occurrence B_5:571:15859: scene=B_5
#: B_5:571
msgctxt "text_id=15859 | speaker=unknown"
msgid "　はたして、勝負は一撃で終わった。"
msgstr ""

#. Occurrence B_5:595:15860: scene=B_5
#: B_5:595
msgctxt "text_id=15860 | speaker=unknown"
msgid "　光の槍と化した獣は巨人の胸板まで飛びかかり、その心臓に牙をたてながら<爆|・><発|・>したのだ。"
msgstr ""

#. Occurrence B_5:643:15861: scene=B_5
#: B_5:643
msgctxt "text_id=15861 | speaker=unknown"
msgid "　はじけ飛ぶ石の筋肉。"
msgstr ""

#. Occurrence B_5:671:15862: scene=B_5
#: B_5:671
msgctxt "text_id=15862 | speaker=unknown"
msgid "　拡散する光の毛並み。"
msgstr ""

#. Occurrence B_5:719:15863: scene=B_5
#: B_5:719
msgctxt "text_id=15863 | speaker=unknown"
msgid "　二つの神秘は<痕跡|こんせき>なく爆散し、収束した。"
msgstr ""

#. Occurrence B_5:725:15864: scene=B_5
#: B_5:725
msgctxt "text_id=15864 | speaker=unknown"
msgid "　……その、神話の再現のような<終|つい>に。"
msgstr ""

#. Occurrence B_5:730:15865: scene=B_5
#: B_5:730
msgctxt "text_id=15865 | speaker=unknown"
msgid "　土塊となって崩れ落ちた“童話の怪物”の中心に、"
msgstr ""

#. Occurrence B_5:806:15866: scene=B_5
#: B_5:806
msgctxt "text_id=15866 | speaker=unknown"
msgid "　燃え上がる炎のような、金狼の姿があった。"
msgstr ""

#. Occurrence B_5:866:15867: scene=B_5
#: B_5:866
msgctxt "text_id=15867 | speaker=unknown"
msgid "　その後の出来事は、もはや戦いですらない。"
msgstr ""

#. Occurrence B_5:871:15868: scene=B_5
#: B_5:871
msgctxt "text_id=15868 | speaker=unknown"
msgid "　単なる敗残兵の処理だ。"
msgstr ""

#. Occurrence B_5:876:15869: scene=B_5
#: B_5:876
msgctxt "text_id=15869 | speaker=unknown"
msgid "　金狼は有珠に飛びかかり、たやすく腹を引き裂いた。"
msgstr ""

#. Occurrence B_5:881:15870: scene=B_5
#: B_5:881
msgctxt "text_id=15870 | speaker=unknown"
msgid "　有珠のコートに<編|あ>まれた守りの呪文なぞ、金狼にとって蜘蛛の巣と変わらない。"
msgstr ""

#. Occurrence B_5:915:15871: scene=B_5
#: B_5:915
msgctxt "text_id=15871 | speaker=unknown"
msgid "　金の狼。"
msgstr ""

#. Occurrence B_5:920:15872: scene=B_5
#: B_5:920
msgctxt "text_id=15872 | speaker=unknown"
msgid "　人語を解するアレは、<人狼|ウェアウルフ>と呼ばれる魔獣に違いない。"
msgstr ""

#. Occurrence B_5:925:15873: scene=B_5
#: B_5:925
msgctxt "text_id=15873 | speaker=unknown"
msgid "　捏造され流布された怪物の王、“吸血鬼”より遥かに古い起源を持つ、西欧の“森の人”。"
msgstr ""

#. Occurrence B_5:931:15874: scene=B_5
#: B_5:931
msgctxt "text_id=15874 | speaker=unknown"
msgid "　しかし―――彼らの基準に、黄金の毛並みは存在しない。"
msgstr ""

#. Occurrence B_5:961:15875: scene=B_5
#: B_5:961
msgctxt "text_id=15875 | speaker=unknown"
msgid "　人狼の社会において、最高位の血統は銀色と言われている。"
msgstr ""

#. Occurrence B_5:966:15876: scene=B_5
#: B_5:966
msgctxt "text_id=15876 | speaker=unknown"
msgid "　銀の人狼は一族の長であり、その階位は魔獣より上、幻獣の域とされる。"
msgstr ""

#. Occurrence B_5:971:15877: scene=B_5
#: B_5:971
msgctxt "text_id=15877 | speaker=unknown"
msgid "　それを上回る金色となると、もはや人智の及ぶものではない。"
msgstr ""

#. Occurrence B_5:1003:15878: scene=B_5
#: B_5:1003
msgctxt "text_id=15878 | speaker=unknown"
msgid "　久遠寺有珠の“童話の怪物”は、人の手によって作られた究極の神秘だ。"
msgstr ""

#. Occurrence B_5:1008:15879: scene=B_5
#: B_5:1008
msgctxt "text_id=15879 | speaker=unknown"
msgid "　だがあの金狼は、星の手によって産み落とされた神秘。"
msgstr ""

#. Occurrence B_5:1013:15880: scene=B_5
#: B_5:1013
msgctxt "text_id=15880 | speaker=unknown"
msgid "　<生命|ほし>が何千年何万年と活動した末、<希|まれ>にこぼれ落ちる奇跡のような<一滴|ひとしずく>。"
msgstr ""

#. Occurrence B_5:1062:15881: scene=B_5
#: B_5:1062
msgctxt "text_id=15881 | speaker=unknown"
msgid "　おそらく、身にまとった神秘は三千年以上。"
msgstr ""

#. Occurrence B_5:1067:15882: scene=B_5
#: B_5:1067
msgctxt "text_id=15882 | speaker=unknown"
msgid "　人間の魔術師―――"
msgstr ""

#. Occurrence B_5:1072:15883: scene=B_5
#: B_5:1072
msgctxt "text_id=15883 | speaker=unknown"
msgid "　いや、現在の魔術基盤に生きる魔術師であるかぎり、あの金狼を倒す魔術は、理論上<編|あ>みだせない。"
msgstr ""

#. Occurrence B_5:1078:15884: scene=B_5
#: B_5:1078
msgctxt "text_id=15884 | speaker=unknown"
msgid "　……それは即ち、蒼崎青子と久遠寺有珠にとって、カレが最悪の敵である事を示していた。"
msgstr ""

#. Occurrence B_6:53:15885: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0000; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:53
msgctxt "text_id=15885 | speaker=aoko"
msgid "「―――そう。"
msgstr ""

#. Occurrence B_6:60:15886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0001; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:60
msgctxt "text_id=15886 | speaker=aoko"
msgid "有珠がお手上げの相手だものね、私がどうにかできる筈もなかったワケだ。"
msgstr ""

#. Occurrence B_6:77:15887: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0002; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:77
msgctxt "text_id=15887 | speaker=aoko"
msgid "　……でも、要は魔術でなければいいのよね？"
msgstr ""

#. Occurrence B_6:83:15888: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0003; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:83
msgctxt "text_id=15888 | speaker=aoko"
msgid "　テムズの動力は魔力だけど、テムズの<攻撃|パンチ>は純粋な衝撃でしょ？　当たりさえすればペシャンコじゃないの？」"
msgstr ""

#. Occurrence B_6:118:15889: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0000; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:118
msgctxt "text_id=15889 | speaker=alice"
msgid "「……残念だけど。"
msgstr ""

#. Occurrence B_6:125:15890: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0001; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:125
msgctxt "text_id=15890 | speaker=alice"
msgid "アレ、基本は狼の姿なだけで、状況によってカタチを変えるわ。テムズの腕を受け止めた時は<大猿|おおざる>みたいになっていたし。"
msgstr ""

#. Occurrence B_6:136:15891: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0002; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:136
msgctxt "text_id=15891 | speaker=alice"
msgid "　機関銃やロケットで狙っても<躱|かわ>されるか、体の硬い生き物に変化して防ぐんじゃないかしら」"
msgstr ""

#. Occurrence B_6:171:15892: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0004; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:171
msgctxt "text_id=15892 | speaker=aoko"
msgid "「……地球上の生き物なら、何にでも変われるってコトか。"
msgstr ""

#. Occurrence B_6:188:15893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0005; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:188
msgctxt "text_id=15893 | speaker=aoko"
msgid "　でもまあ、質量までは無理かな？"
msgstr ""

#. Occurrence B_6:194:15894: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0006; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:194
msgctxt "text_id=15894 | speaker=aoko"
msgid "　基本は二メートル大の生物の、いいトコどりってあたりで勘弁してほしいわね。"
msgstr ""

#. Occurrence B_6:228:15895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0007; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:228
msgctxt "text_id=15895 | speaker=aoko"
msgid "　ね。すごく関係ないけど、深海の生き物に変わられたら、ちょっと怖いと思わない？」"
msgstr ""

#. Occurrence B_6:248:15896: scene=B_6
#: B_6:248
msgctxt "text_id=15896 | speaker=unknown"
msgid "　なんというか視覚的に、とぼやく青子。"
msgstr ""

#. Occurrence B_6:266:15897: scene=B_6
#: B_6:266
msgctxt "text_id=15897 | speaker=unknown"
msgid "　話しているうちに闘志が湧いたのか、<虚|うつ>ろだった思考も、焦点の定まっていなかった瞳も、完全に元の彼女に戻っている。"
msgstr ""

#. Occurrence B_6:287:15898: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0008; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:287
msgctxt "text_id=15898 | speaker=aoko"
msgid "「で、その後は？　有珠、うまく逃げられたの？」"
msgstr ""

#. Occurrence B_6:313:15899: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0003; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:313
msgctxt "text_id=15899 | speaker=alice"
msgid "「……いいえ。わたしもあの狼にやられたわ」"
msgstr ""

#. Occurrence B_6:319:15900: scene=B_6
#: B_6:319
msgctxt "text_id=15900 | speaker=unknown"
msgid "　有珠は金狼に押し倒されてからの事を報告した。"
msgstr ""

#. Occurrence B_6:324:15901: scene=B_6
#: B_6:324
msgctxt "text_id=15901 | speaker=unknown"
msgid "　余談ではあるが、草十郎に関するコトは大幅に短縮されていた。"
msgstr ""

#. Occurrence B_6:330:15902: scene=B_6
#: B_6:330
msgctxt "text_id=15902 | speaker=unknown"
msgid "彼との出来事を青子に語らなかった理由は、有珠自身、不思議に思うほど不明だった。"
msgstr ""

#. Occurrence B_6:362:15903: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0009; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:362
msgctxt "text_id=15903 | speaker=aoko"
msgid "「ふーん……有珠の相手をした後、休む間もなく私の所に来たワケか。"
msgstr ""

#. Occurrence B_6:376:15904: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0010; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:376
msgctxt "text_id=15904 | speaker=aoko"
msgid "　初めから昨日で決着をつけるつもりだったんだ、姉貴。"
msgstr ""

#. Occurrence B_6:382:15905: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0011; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:382
msgctxt "text_id=15905 | speaker=aoko"
msgid "　……姉妹かな、ここぞって時のタイミングは一緒だったの、忘れてた……」"
msgstr ""

#. Occurrence B_6:408:15906: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0012; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:408
msgctxt "text_id=15906 | speaker=aoko"
msgid "「切札は、見せたからには敵を殲滅しなくちゃいけない。"
msgstr ""

#. Occurrence B_6:414:15907: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0013; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:414
msgctxt "text_id=15907 | speaker=aoko"
msgid "　姉貴は支点を残り二つにしておいて、自分の正体を告げて、こっちの戦力を分けさせた。"
msgstr ""

#. Occurrence B_6:420:15908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0014; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:420
msgctxt "text_id=15908 | speaker=aoko"
msgid "　……その時点で奥の手を投入してくるコトは覚悟してたけど、まさか人狼なんてキワモノとはね」"
msgstr ""

#. Occurrence B_6:460:15909: scene=B_6
#: B_6:460
msgctxt "text_id=15909 | speaker=unknown"
msgid "　はあ、と重いため息をつく。"
msgstr ""

#. Occurrence B_6:465:15910: scene=B_6
#: B_6:465
msgctxt "text_id=15910 | speaker=unknown"
msgid "　そこは有珠も同感らしく、小さく頷いていた。"
msgstr ""

#. Occurrence B_6:494:15911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0015; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:494
msgctxt "text_id=15911 | speaker=aoko"
msgid "「……それはそれとして、草十郎が有珠を助けに行くなんてね。感謝しなくちゃいけないんだろうけど、莫迦な真似してくれたわ。"
msgstr ""

#. Occurrence B_6:511:15912: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0016; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:511
msgctxt "text_id=15912 | speaker=aoko"
msgid "　私が橙子の立場なら、報復の可能性はひとつ残らず排除する。"
msgstr ""

#. Occurrence B_6:518:15913: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0017; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:518
msgctxt "text_id=15913 | speaker=aoko"
msgid "私たちがどうにかなった後、猫の手首ひねるみたいに片付けられるわよ、あいつ」"
msgstr ""

#. Occurrence B_6:550:15914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0004; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:550
msgctxt "text_id=15914 | speaker=alice"
msgid "「静希君なら、こちらで保護してもらってるけど」"
msgstr ""

#. Occurrence B_6:568:15915: scene=B_6
#: B_6:568
msgctxt "text_id=15915 | speaker=unknown"
msgid "　有珠の言葉に、青子はえっと目を驚かせた。"
msgstr ""

#. Occurrence B_6:589:15916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0018; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:589
msgctxt "text_id=15916 | speaker=aoko"
msgid "「うわ、どういう風の吹き回し？"
msgstr ""

#. Occurrence B_6:606:15917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0019; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:606
msgctxt "text_id=15917 | speaker=aoko"
msgid "　有珠があいつの世話を焼くなんて」"
msgstr ""

#. Occurrence B_6:612:15918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0005; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:612
msgctxt "text_id=15918 | speaker=alice"
msgid "「……だって。放っておいたら、青子が怒ると思って」"
msgstr ""

#. Occurrence B_6:647:15919: scene=B_6
#: B_6:647
msgctxt "text_id=15919 | speaker=unknown"
msgid "　瞳を閉じたまま有珠は答える。"
msgstr ""

#. Occurrence B_6:652:15920: scene=B_6
#: B_6:652
msgctxt "text_id=15920 | speaker=unknown"
msgid "　それに嫌そうな顔をして、青子は口を閉ざした。"
msgstr ""

#. Occurrence B_6:657:15921: scene=B_6
#: B_6:657
msgctxt "text_id=15921 | speaker=unknown"
msgid "　なんでそうなるのよ、と声にならない抗議をするように。"
msgstr ""

#. Occurrence B_6:707:15922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0020; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:707
msgctxt "text_id=15922 | speaker=aoko"
msgid "「……ま、いいけど。それじゃ今ここにいるんだ、草十郎。姿が見えないけど、どうしたの？」"
msgstr ""

#. Occurrence B_6:713:15923: scene=B_6
#: B_6:713
msgctxt "text_id=15923 | speaker=unknown"
msgid "　まだ首は動かせないのか、青子は視線だけで部屋を見回した。"
msgstr ""

#. Occurrence B_6:748:15924: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0006; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:748
msgctxt "text_id=15924 | speaker=alice"
msgid "「彼なら気分を悪くして倒れたわ。今は詠梨神父の寝室を借りているけど」"
msgstr ""

#. Occurrence B_6:787:15925: scene=B_6
#: B_6:787
msgctxt "text_id=15925 | speaker=unknown"
msgid "　倒れた、という言葉に青子は目を光らせる。"
msgstr ""

#. Occurrence B_6:792:15926: scene=B_6
#: B_6:792
msgctxt "text_id=15926 | speaker=unknown"
msgid "　では、ここに保護されたのはいいが、それでも橙子の行動が一歩早く、草十郎が始末されたのか―――？"
msgstr ""

#. Occurrence B_6:799:15927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0021; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:799
msgctxt "text_id=15927 | speaker=aoko"
msgid "「……何があったの、一体……？」"
msgstr ""

#. Occurrence B_6:832:15928: scene=B_6
#: B_6:832
msgctxt "text_id=15928 | speaker=unknown"
msgid "　真剣に問う青子に、有珠はしばし黙ってから、やや気を遣って、"
msgstr ""

#. Occurrence B_6:845:15929: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0007; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:845
msgctxt "text_id=15929 | speaker=alice"
msgid "「それが。"
msgstr ""

#. Occurrence B_6:852:15930: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0008; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:852
msgctxt "text_id=15930 | speaker=alice"
msgid "彼、あなたを見て<嘔吐|おうと>したの」"
msgstr ""

#. Occurrence B_6:892:15931: scene=B_6
#: B_6:892
msgctxt "text_id=15931 | speaker=unknown"
msgid "　きっぱりと、身も<蓋|ふた>もない真実を口にした。"
msgstr ""

#. Occurrence B_6:928:15932: scene=B_6
#: B_6:928
msgctxt "text_id=15932 | speaker=unknown"
msgid "　青子はちょっと、声もない。"
msgstr ""

#. Occurrence B_6:933:15933: scene=B_6
#: B_6:933
msgctxt "text_id=15933 | speaker=unknown"
msgid "　窓から差しこむ日射しに照らされること数秒。"
msgstr ""

#. Occurrence B_6:938:15934: scene=B_6
#: B_6:938
msgctxt "text_id=15934 | speaker=unknown"
msgid "　青子はようやく言語中枢を回復させて呟いた。"
msgstr ""

#. Occurrence B_6:969:15935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0022; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:969
msgctxt "text_id=15935 | speaker=aoko"
msgid "「……いいけど。ひどい侮辱よね、それって」"
msgstr ""

#. Occurrence B_6:975:15936: scene=B_6
#: B_6:975
msgctxt "text_id=15936 | speaker=unknown"
msgid "　そんな青子の仕草がおかしかったのか、一晩かけての看病の緊張がほぐれたのか、有珠はクスリと小さく笑った。"
msgstr ""

#. Occurrence B_6:1001:15937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0023; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1001
msgctxt "text_id=15937 | speaker=aoko"
msgid "「なによ。そんなにおかしい、有珠？」"
msgstr ""

#. Occurrence B_6:1034:15938: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0009; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1034
msgctxt "text_id=15938 | speaker=alice"
msgid "「さあ、どうかしらね。けど、静希君にも言い分はあるでしょう。今の貴女、とても見られたものじゃないわ」"
msgstr ""

#. Occurrence B_6:1071:15939: scene=B_6
#: B_6:1071
msgctxt "text_id=15939 | speaker=unknown"
msgid "　言われて、青子は自分の体を観察した。"
msgstr ""

#. Occurrence B_6:1076:15940: scene=B_6
#: B_6:1076
msgctxt "text_id=15940 | speaker=unknown"
msgid "　一枚布の患者衣。"
msgstr ""

#. Occurrence B_6:1081:15941: scene=B_6
#: B_6:1081
msgctxt "text_id=15941 | speaker=unknown"
msgid "　肌の露出より包帯の方が多いし、右足はギプスがあてられている。"
msgstr ""

#. Occurrence B_6:1087:15942: scene=B_6
#: B_6:1087
msgctxt "text_id=15942 | speaker=unknown"
msgid "　右手は動くので、包帯に巻かれた指で青子は自分の喉元に触れてみた。"
msgstr ""

#. Occurrence B_6:1110:15943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0024; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1110
msgctxt "text_id=15943 | speaker=aoko"
msgid "「そっか……思い出した。あのガキ、まず私の首元に噛み付いたんだっけ。"
msgstr ""

#. Occurrence B_6:1116:15944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0025; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1116
msgctxt "text_id=15944 | speaker=aoko"
msgid "　すごかったわよ、首が噛み砕かれるのって。ゴキンって音が頭の中に響いて、気持ち悪いったらなかったわ。"
msgstr ""

#. Occurrence B_6:1122:15945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0026; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1122
msgctxt "text_id=15945 | speaker=aoko"
msgid "　……ちっ。あそこから好き勝手やられたもんだから、つい忘れてた」"
msgstr ""

#. Occurrence B_6:1144:15946: scene=B_6
#: B_6:1144
msgctxt "text_id=15946 | speaker=unknown"
msgid "　口調は明るいものの、青子の目は明るくはない。"
msgstr ""

#. Occurrence B_6:1149:15947: scene=B_6
#: B_6:1149
msgctxt "text_id=15947 | speaker=unknown"
msgid "　……彼女の全身は、ご丁寧に“死なない”程度に壊されていた。"
msgstr ""

#. Occurrence B_6:1154:15948: scene=B_6
#: B_6:1154
msgctxt "text_id=15948 | speaker=unknown"
msgid "　切断面は一切ない。"
msgstr ""

#. Occurrence B_6:1159:15949: scene=B_6
#: B_6:1159
msgctxt "text_id=15949 | speaker=unknown"
msgid "　基本的には噛みつかれてからの打撲、骨折だ。"
msgstr ""

#. Occurrence B_6:1179:15950: scene=B_6
#: B_6:1179
msgctxt "text_id=15950 | speaker=unknown"
msgid "　青子の体には蒼崎の秘術がつまった魔術刻印がある。"
msgstr ""

#. Occurrence B_6:1184:15951: scene=B_6
#: B_6:1184
msgctxt "text_id=15951 | speaker=unknown"
msgid "　仮に<脊椎|せきつい>を折られようが、青子自身がまだ生きているのなら、刻印が無理矢理にでも青子を生かす。"
msgstr ""

#. Occurrence B_6:1189:15952: scene=B_6
#: B_6:1189
msgctxt "text_id=15952 | speaker=unknown"
msgid "　……少しは刻印からの麻酔が働いたにせよ、この痛みの恨みは金狼を百回殺しても余りある。"
msgstr ""

#. Occurrence B_6:1236:15953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0027; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1236
msgctxt "text_id=15953 | speaker=aoko"
msgid "「……支点は全部壊された。"
msgstr ""

#. Occurrence B_6:1242:15954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0028; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1242
msgctxt "text_id=15954 | speaker=aoko"
msgid "　これで三咲市の霊脈はフリーってワケね。"
msgstr ""

#. Occurrence B_6:1248:15955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0029; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1248
msgctxt "text_id=15955 | speaker=aoko"
msgid "　全容を把握してるのはうちらだけの特権だったけど、橙子は昔から知ってる以上、解析の手間もいらない、と。"
msgstr ""

#. Occurrence B_6:1281:15956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0030; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1281
msgctxt "text_id=15956 | speaker=aoko"
msgid "　―――真剣な話、所有権の書き換えまで何時間かかると思う？」"
msgstr ""

#. Occurrence B_6:1316:15957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0010; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1316
msgctxt "text_id=15957 | speaker=alice"
msgid "「橙子さんなら二日かからないでしょうね。"
msgstr ""

#. Occurrence B_6:1322:15958: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0011; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1322
msgctxt "text_id=15958 | speaker=alice"
msgid "　支点の修復は土地そのものに任せるしかない。"
msgstr ""

#. Occurrence B_6:1333:15959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0012; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1333
msgctxt "text_id=15959 | speaker=alice"
msgid "　支点の<防護陣|プロテクト>が治る頃には、この町はもう彼女の物よ」"
msgstr ""

#. Occurrence B_6:1366:15960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0031; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1366
msgctxt "text_id=15960 | speaker=aoko"
msgid "「明日の夜明けと共に破産する我が身とはねぇ。"
msgstr ""

#. Occurrence B_6:1377:15961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0032; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1377
msgctxt "text_id=15961 | speaker=aoko"
msgid "　それで有珠の方はどうなの？　まだいける？」"
msgstr ""

#. Occurrence B_6:1396:15962: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0013; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1396
msgctxt "text_id=15962 | speaker=alice"
msgid "「思考魔術だけなら、少しは。"
msgstr ""

#. Occurrence B_6:1402:15963: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0014; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1402
msgctxt "text_id=15963 | speaker=alice"
msgid "　あとは小道具に頼る事になるでしょうね」"
msgstr ""

#. Occurrence B_6:1438:15964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0033; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1438
msgctxt "text_id=15964 | speaker=aoko"
msgid "「……はあ。お話にならない、か」"
msgstr ""

#. Occurrence B_6:1481:15965: scene=B_6
#: B_6:1481
msgctxt "text_id=15965 | speaker=unknown"
msgid "　言って、青子は口を閉ざした。"
msgstr ""

#. Occurrence B_6:1486:15966: scene=B_6
#: B_6:1486
msgctxt "text_id=15966 | speaker=unknown"
msgid "　瞳はまっすぐに天井を睨んでいる。"
msgstr ""

#. Occurrence B_6:1491:15967: scene=B_6
#: B_6:1491
msgctxt "text_id=15967 | speaker=unknown"
msgid "　そこにどんな決意がこめられているのか、有珠はよく分かっていた。"
msgstr ""

#. Occurrence B_6:1512:15968: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0015; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1512
msgctxt "text_id=15968 | speaker=alice"
msgid "「それでもやるんでしょう、青子は」"
msgstr ""

#. Occurrence B_6:1518:15969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0034; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1518
msgctxt "text_id=15969 | speaker=aoko"
msgid "「まあね。私、<諦|あきら>めるのってできないから。"
msgstr ""

#. Occurrence B_6:1524:15970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0035; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1524
msgctxt "text_id=15970 | speaker=aoko"
msgid "　……で、そういう有珠はどうなのよ」"
msgstr ""

#. Occurrence B_6:1530:15971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0016; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1530
msgctxt "text_id=15971 | speaker=alice"
msgid "「わたしは、一度自分の物になった物は、決して人には渡さない」"
msgstr ""

#. Occurrence B_6:1563:15972: scene=B_6
#: B_6:1563
msgctxt "text_id=15972 | speaker=unknown"
msgid "　短い返答に、青子はそうだった、と呟く。"
msgstr ""

#. Occurrence B_6:1568:15973: scene=B_6
#: B_6:1568
msgctxt "text_id=15973 | speaker=unknown"
msgid "　有珠の、自分の物に対する執着心は青子でさえ薄ら寒くなるほどなのだ。"
msgstr ""

#. Occurrence B_6:1588:15974: scene=B_6
#: B_6:1588
msgctxt "text_id=15974 | speaker=unknown"
msgid "　自分の物になったモノは手放さない―――それは転じて、裏切りは決して許さない、少女の潔癖さの証でもある。"
msgstr ""

#. Occurrence B_6:1609:15975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0036; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1609
msgctxt "text_id=15975 | speaker=aoko"
msgid "「オッケー、決まりね。"
msgstr ""

#. Occurrence B_6:1628:15976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0037; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1628
msgctxt "text_id=15976 | speaker=aoko"
msgid "　じゃ、悪いけどもう少し休ませて。今晩までにはなんとか動けるようにするから」"
msgstr ""

#. Occurrence B_6:1648:15977: scene=B_6
#: B_6:1648
msgctxt "text_id=15977 | speaker=unknown"
msgid "　手術を担当したシスターが聞けば、その無謀さに卒倒するだろう。"
msgstr ""

#. Occurrence B_6:1653:15978: scene=B_6
#: B_6:1653
msgctxt "text_id=15978 | speaker=unknown"
msgid "　今の青子は食事すら満足にできない。"
msgstr ""

#. Occurrence B_6:1660:15979: scene=B_6
#: B_6:1660
msgctxt "text_id=15979 | speaker=unknown"
msgid "それを承知していながら、"
msgstr ""

msgctxt "text_id=15980 | speaker=unknown"
msgid "有珠は頷いて立ち上がった。"
msgstr ""

#. Occurrence B_6:1676:15981: scene=B_6
#: B_6:1676
msgctxt "text_id=15981 | speaker=unknown"
msgid "　青子がそう言うのなら、相棒として、有珠は彼女を信じるだけである。"
msgstr ""

#. Occurrence B_6:1696:15982: scene=B_6
#: B_6:1696
msgctxt "text_id=15982 | speaker=unknown"
msgid "　黒衣の少女は無言で病室を後にする。"
msgstr ""

#. Occurrence B_6:1703:15983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0017; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1703
msgctxt "text_id=15983 | speaker=alice"
msgid "「あ」"
msgstr ""

#. Occurrence B_6:1709:15984: scene=B_6
#: B_6:1709
msgctxt "text_id=15984 | speaker=unknown"
msgid "　と。ドアの前で、片手を自分の口元に当てて、唐突に立ち止まった。"
msgstr ""

#. Occurrence B_6:1740:15985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0038; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1740
msgctxt "text_id=15985 | speaker=aoko"
msgid "「有珠？」"
msgstr ""

#. Occurrence B_6:1745:15986: scene=B_6
#: B_6:1745
msgctxt "text_id=15986 | speaker=unknown"
msgid "　また何かどうでもいいコトを思いついたな、と青子は面白がって呼びかける。"
msgstr ""

#. Occurrence B_6:1750:15987: scene=B_6
#: B_6:1750
msgctxt "text_id=15987 | speaker=unknown"
msgid "　けれど。"
msgstr ""

#. Occurrence B_6:1755:15988: scene=B_6
#: B_6:1755
msgctxt "text_id=15988 | speaker=unknown"
msgid "　恥ずかしげに頬を染めるはずの有珠は、深い謎に突き当たったように眉をひそめていた。"
msgstr ""

#. Occurrence B_6:1793:15989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0039; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1793
msgctxt "text_id=15989 | speaker=aoko"
msgid "「有珠ー？」"
msgstr ""

#. Occurrence B_6:1798:15990: scene=B_6
#: B_6:1798
msgctxt "text_id=15990 | speaker=unknown"
msgid "　もしもーし、と青子は呼びかける。"
msgstr ""

#. Occurrence B_6:1803:15991: scene=B_6
#: B_6:1803
msgctxt "text_id=15991 | speaker=unknown"
msgid "　有珠は振り向かず、扉に向いたまま、"
msgstr ""

#. Occurrence B_6:1816:15992: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0018; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1816
msgctxt "text_id=15992 | speaker=alice"
msgid "「―――なんで、間に合ったのかしら」"
msgstr ""

#. Occurrence B_6:1821:15993: scene=B_6
#: B_6:1821
msgctxt "text_id=15993 | speaker=unknown"
msgid "　そんな、自問めいた声を漏らしていた。"
msgstr ""

#. Occurrence B_6:1845:15994: scene=B_6
#: B_6:1845
msgctxt "text_id=15994 | speaker=unknown"
msgid "　有珠の疑問は青子の知らないところでの出来事なので、当然、青子に分かるはずもない。"
msgstr ""

#. Occurrence B_6:1873:15995: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0019; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1873
msgctxt "text_id=15995 | speaker=alice"
msgid "「……あの時もそう。"
msgstr ""

#. Occurrence B_6:1879:15996: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0020; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1879
msgctxt "text_id=15996 | speaker=alice"
msgid "　わたしたち、始発で帰ってきたのに」"
msgstr ""

#. Occurrence B_6:1885:15997: scene=B_6
#: B_6:1885
msgctxt "text_id=15997 | speaker=unknown"
msgid "　ぶつぶつとドアに向かって語りかける。"
msgstr ""

#. Occurrence B_6:1902:15998: scene=B_6
#: B_6:1902
msgctxt "text_id=15998 | speaker=unknown"
msgid "　……結局答えは出なかったのか、有珠は物憂げに、ドアノブに手をかけた。"
msgstr ""

#. Occurrence B_6:1936:15999: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0040; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1936
msgctxt "text_id=15999 | speaker=aoko"
msgid "「……言いたくないなら別にいいけど。"
msgstr ""

#. Occurrence B_6:1942:16000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0041; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1942
msgctxt "text_id=16000 | speaker=aoko"
msgid "　何がどうしたって言うのよ、有珠」"
msgstr ""

#. Occurrence B_6:1948:16001: scene=B_6
#: B_6:1948
msgctxt "text_id=16001 | speaker=unknown"
msgid "　背中越しの問いに、有珠は答えない。"
msgstr ""

#. Occurrence B_6:1954:16002: scene=B_6
#: B_6:1954
msgctxt "text_id=16002 | speaker=unknown"
msgid "　有珠はドアを開けて部屋から出ると、去り際に一言だけ青子に告げた。"
msgstr ""

#. Occurrence B_6:1989:16003: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0021; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1989
msgctxt "text_id=16003 | speaker=alice"
msgid "「……どうでもいいコトだけど。"
msgstr ""

#. Occurrence B_6:1996:16004: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0022; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1996
msgctxt "text_id=16004 | speaker=alice"
msgid "唯架さんには静希君は見えなかったそうよ、青子」"
msgstr ""

#. Occurrence B_6:2017:16005: scene=B_6
#: B_6:2017
msgctxt "text_id=16005 | speaker=unknown"
msgid "　ばたん、とドアは閉められた。"
msgstr ""

#. Occurrence B_6:2057:16006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0042; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:2057
msgctxt "text_id=16006 | speaker=aoko"
msgid "「ふーん。そりゃまた珍しい」"
msgstr ""

#. Occurrence B_6:2063:16007: scene=B_6
#: B_6:2063
msgctxt "text_id=16007 | speaker=unknown"
msgid "　青子は横になったまま、やや嬉しげに呟いた。"
msgstr ""

#. Occurrence B_6:2092:16008: scene=B_6
#: B_6:2092
msgctxt "text_id=16008 | speaker=unknown"
msgid "　先天的に盲目だった<周|す><瀬|せ><唯架|ゆいか>は、感覚で物事をとらえる。"
msgstr ""

#. Occurrence B_6:2097:16009: scene=B_6
#: B_6:2097
msgctxt "text_id=16009 | speaker=unknown"
msgid "　特に外敵、悪意のある者には敏感だ。"
msgstr ""

#. Occurrence B_6:2102:16010: scene=B_6
#: B_6:2102
msgctxt "text_id=16010 | speaker=unknown"
msgid "　基本、彼女はあらゆる人間を“脅威”として知覚する。"
msgstr ""

#. Occurrence B_6:2107:16011: scene=B_6
#: B_6:2107
msgctxt "text_id=16011 | speaker=unknown"
msgid "　それがもっとも感じやすい気配なのだそうだ。"
msgstr ""

#. Occurrence B_6:2112:16012: scene=B_6
#: B_6:2112
msgctxt "text_id=16012 | speaker=unknown"
msgid "　そんな彼女に見えなかったという事は、草十郎は底抜けに害のない人間だと、太鼓判を<捺|お>されたようなものだった。"
msgstr ""

#. Occurrence B_7:53:16013: scene=B_7
#: B_7:53
msgctxt "text_id=16013 | speaker=unknown"
msgid "　で。"
msgstr ""

#. Occurrence B_7:67:16014: scene=B_7
#: B_7:67
msgctxt "text_id=16014 | speaker=unknown"
msgid "　その害のない<某|なにがし>は、しばらくしてから病室にやってきた。"
msgstr ""

#. Occurrence B_7:73:16015: scene=B_7
#: B_7:73
msgctxt "text_id=16015 | speaker=unknown"
msgid "　貧血一歩手前の、まったく元気のない草十郎の顔にどっちが病人なんだか、と青子は内心呟いてみる。"
msgstr ""

#. Occurrence B_7:94:16016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0000; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:94
msgctxt "text_id=16016 | speaker=aoko"
msgid "「何しにきたの、アンタ」"
msgstr ""

#. Occurrence B_7:125:16017: scene=B_7
#: B_7:125
msgctxt "text_id=16017 | speaker=unknown"
msgid "　青子はベッドに横になったまま、来訪者を突き放した。"
msgstr ""

#. Occurrence B_7:130:16018: scene=B_7
#: B_7:130
msgctxt "text_id=16018 | speaker=unknown"
msgid "　草十郎は弱り切った顔のまま、うん、などと意味不明の返答をする。"
msgstr ""

#. Occurrence B_7:161:16019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0000; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:161
msgctxt "text_id=16019 | speaker=soujuurou"
msgid "「有珠が客間で眠ったから礼拝堂にいたんだけど。人が集まりだしたんで、こっちに逃げてきた」"
msgstr ""

#. Occurrence B_7:167:16020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0001; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:167
msgctxt "text_id=16020 | speaker=aoko"
msgid "「あ、礼拝の時間か……クリスマスだってのによくやるわ」"
msgstr ""

#. Occurrence B_7:199:16021: scene=B_7
#: B_7:199
msgctxt "text_id=16021 | speaker=unknown"
msgid "　今日はクリスマスだが、ミサのピークは２４日までだ。"
msgstr ""

#. Occurrence B_7:204:16022: scene=B_7
#: B_7:204
msgctxt "text_id=16022 | speaker=unknown"
msgid "　礼拝堂に集まっている人々はよほど信心深いのだろう。"
msgstr ""

#. Occurrence B_7:209:16023: scene=B_7
#: B_7:209
msgctxt "text_id=16023 | speaker=unknown"
msgid "　三咲町に住む外国人は少ない。"
msgstr ""

#. Occurrence B_7:214:16024: scene=B_7
#: B_7:214
msgctxt "text_id=16024 | speaker=unknown"
msgid "　いや、いないとさえ言っていい。礼拝堂に集まった人々は、ここ周辺の住人だ。"
msgstr ""

#. Occurrence B_7:246:16025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0002; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:246
msgctxt "text_id=16025 | speaker=aoko"
msgid "「それで？　別にどうってコトないでしょ。探せば顔見知りもいるんじゃない？」"
msgstr ""

#. Occurrence B_7:254:16026: scene=B_7
#: B_7:254
msgctxt "text_id=16026 | speaker=unknown"
msgid "　それでも、なお冷たく青子は突っぱねる。"
msgstr ""

#. Occurrence B_7:259:16027: scene=B_7
#: B_7:259
msgctxt "text_id=16027 | speaker=unknown"
msgid "　先ほど有珠から聞いた『自分を見て吐いた』という事実は、いろんな意味で青子を意地悪にさせているようだ。"
msgstr ""

#. Occurrence B_7:279:16028: scene=B_7
#: B_7:279
msgctxt "text_id=16028 | speaker=unknown"
msgid "　もっとも、"
msgstr ""

#. Occurrence B_7:304:16029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0001; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:304
msgctxt "text_id=16029 | speaker=soujuurou"
msgid "「いや、ちょうどいい機会だから色々と聞きたくなって。"
msgstr ""

#. Occurrence B_7:311:16030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0002; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:311
msgctxt "text_id=16030 | speaker=soujuurou"
msgid "少し、話をしていいかな」"
msgstr ""

#. Occurrence B_7:317:16031: scene=B_7
#: B_7:317
msgctxt "text_id=16031 | speaker=unknown"
msgid "　青子はいつだって不機嫌なので、草十郎は彼女の微妙な変化に気付かなかった。"
msgstr ""

#. Occurrence B_7:354:16032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0003; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:354
msgctxt "text_id=16032 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence B_7:360:16033: scene=B_7
#: B_7:360
msgctxt "text_id=16033 | speaker=unknown"
msgid "　青子としては、その前に水でも飲んで自分の顔色の悪さをどうにかしろ、と言いたいのだが、草十郎に自覚はないようだ。"
msgstr ""

#. Occurrence B_7:365:16034: scene=B_7
#: B_7:365
msgctxt "text_id=16034 | speaker=unknown"
msgid "　有珠曰く、本当にひどい状態だったから、血を見慣れていない男の子ならクラっときてもおかしくない、とのコトだが……。"
msgstr ""

#. Occurrence B_7:406:16035: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0003; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:406
msgctxt "text_id=16035 | speaker=soujuurou"
msgid "「ああ、そうか。"
msgstr ""

#. Occurrence B_7:412:16036: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0004; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:412
msgctxt "text_id=16036 | speaker=soujuurou"
msgid "　話なんてまだ無理だな。すまない、出直してくる」"
msgstr ""

#. Occurrence B_7:430:16037: scene=B_7
#: B_7:430
msgctxt "text_id=16037 | speaker=unknown"
msgid "　思案していた青子の様子から、“まだ話す体力もない”と誤解したらしい。"
msgstr ""

#. Occurrence B_7:435:16038: scene=B_7
#: B_7:435
msgctxt "text_id=16038 | speaker=unknown"
msgid "　それはそれで、なんだか癪に障る青子だった。"
msgstr ""

#. Occurrence B_7:459:16039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0004; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:459
msgctxt "text_id=16039 | speaker=aoko"
msgid "「待ちなさいよ。話だけなら別にかまわないわ。やる気もて余してるし、暇つぶしがてらに相手してあげるわよ。"
msgstr ""

#. Occurrence B_7:465:16040: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0005; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:465
msgctxt "text_id=16040 | speaker=aoko"
msgid "　……まあ退屈しのぎにしてはちょっとグレード下がるけど、この際ぜいたく言ってられないし」"
msgstr ""

#. Occurrence B_7:474:16041: scene=B_7
#: B_7:474
msgctxt "text_id=16041 | speaker=unknown"
msgid "　なんか散々な言われようだが、それなら、"
msgstr ""

msgctxt "text_id=16042 | speaker=unknown"
msgid "と草十郎はベッド横の椅子に腰を下ろした。"
msgstr ""

#. Occurrence B_7:497:16043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0006; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:497
msgctxt "text_id=16043 | speaker=aoko"
msgid "「で。何が聞きたいの？」"
msgstr ""

#. Occurrence B_7:503:16044: scene=B_7
#: B_7:503
msgctxt "text_id=16044 | speaker=unknown"
msgid "　青子は患者衣の弱々しさを払拭するように、きびきびと声をあげる。"
msgstr ""

#. Occurrence B_7:508:16045: scene=B_7
#: B_7:508
msgctxt "text_id=16045 | speaker=unknown"
msgid "　どう見ても強がりなのに、そんな弱さは微塵も見せない。"
msgstr ""

#. Occurrence B_7:529:16046: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0005; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:529
msgctxt "text_id=16046 | speaker=soujuurou"
msgid "「―――うん。やっぱり蒼崎は強いな。安心した」"
msgstr ""

#. Occurrence B_7:568:16047: scene=B_7
#: B_7:568
msgctxt "text_id=16047 | speaker=unknown"
msgid "　感服してうなずく草十郎。"
msgstr ""

#. Occurrence B_7:573:16048: scene=B_7
#: B_7:573
msgctxt "text_id=16048 | speaker=unknown"
msgid "　そんな賞賛の言葉に、青子は呆れた視線を向けた。"
msgstr ""

#. Occurrence B_7:594:16049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0007; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:594
msgctxt "text_id=16049 | speaker=aoko"
msgid "「……。"
msgstr ""

#. Occurrence B_7:601:16050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0008; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:601
msgctxt "text_id=16050 | speaker=aoko"
msgid "アンタって、ほんと、間が悪いわ」"
msgstr ""

#. Occurrence B_7:613:16051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0006; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:613
msgctxt "text_id=16051 | speaker=soujuurou"
msgid "「？」"
msgstr ""

#. Occurrence B_7:619:16052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0009; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:619
msgctxt "text_id=16052 | speaker=aoko"
msgid "「いいわよ、別に。"
msgstr ""

#. Occurrence B_7:625:16053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0010; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:625
msgctxt "text_id=16053 | speaker=aoko"
msgid "　私の夢の話だから、そっちが気に病むことは―――」"
msgstr ""

#. Occurrence B_7:660:16054: scene=B_7
#: B_7:660
msgctxt "text_id=16054 | speaker=unknown"
msgid "　先ほどの夢を思いだして、つい苦い顔をする。"
msgstr ""

#. Occurrence B_7:665:16055: scene=B_7
#: B_7:665
msgctxt "text_id=16055 | speaker=unknown"
msgid "　そういえば、<教会|ここ>には夢の登場人物がほぼ揃っているコトに気付き、苦い顔は本当に不機嫌な顔になってしまった。"
msgstr ""

#. Occurrence B_7:696:16056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0011; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:696
msgctxt "text_id=16056 | speaker=aoko"
msgid "「やめやめ、こんなつまんない話。聞きたい事があるならてっとり早く済ませちゃってよ、草十郎」"
msgstr ""

#. Occurrence B_7:702:16057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0007; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:702
msgctxt "text_id=16057 | speaker=soujuurou"
msgid "「よかった。じゃあ、まず今の状況を聞かせてくれないか。"
msgstr ""

#. Occurrence B_7:708:16058: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0008; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:708
msgctxt "text_id=16058 | speaker=soujuurou"
msgid "　橙子さんの話じゃ、俺も無関係じゃないそうだし」"
msgstr ""

#. Occurrence B_7:742:16059: scene=B_7
#: B_7:742
msgctxt "text_id=16059 | speaker=unknown"
msgid "　落ち着いて問いただす草十郎だが、その意味が本当に分かっているかどうか、青子には疑問である。"
msgstr ""

#. Occurrence B_7:747:16060: scene=B_7
#: B_7:747
msgctxt "text_id=16060 | speaker=unknown"
msgid "　橙子に狙われている以上、自衛手段のない草十郎を誰かが守らなければいけない。"
msgstr ""

#. Occurrence B_7:752:16061: scene=B_7
#: B_7:752
msgctxt "text_id=16061 | speaker=unknown"
msgid "　けれど青子にも有珠にもそんな余裕はないし、この教会だって、いつまで彼を保護してくれるか知れたものではない。"
msgstr ""

#. Occurrence B_7:772:16062: scene=B_7
#: B_7:772
msgctxt "text_id=16062 | speaker=unknown"
msgid "　<青子|じぶん>たちに味方した以上、橙子にとって草十郎は無関係どころか排斥対象である。"
msgstr ""

#. Occurrence B_7:777:16063: scene=B_7
#: B_7:777
msgctxt "text_id=16063 | speaker=unknown"
msgid "　質問の答えはそれだけだ。"
msgstr ""

#. Occurrence B_7:782:16064: scene=B_7
#: B_7:782
msgctxt "text_id=16064 | speaker=unknown"
msgid "　現状を知ったところで、魔術師ではない草十郎には何も出来ない。"
msgstr ""

#. Occurrence B_7:803:16065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0012; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:803
msgctxt "text_id=16065 | speaker=aoko"
msgid "「……まあ、それでも有珠は助けられたワケだし」"
msgstr ""

#. Occurrence B_7:821:16066: scene=B_7
#: B_7:821
msgctxt "text_id=16066 | speaker=unknown"
msgid "　借りはできてしまった。"
msgstr ""

#. Occurrence B_7:826:16067: scene=B_7
#: B_7:826
msgctxt "text_id=16067 | speaker=unknown"
msgid "　その礼として、今までの経緯をまともに話すぐらいは筋ではないか、と青子は自分なりに納得する。"
msgstr ""

#. Occurrence B_7:858:16068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0013; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:858
msgctxt "text_id=16068 | speaker=aoko"
msgid "「よし、今までの経緯もふくめて軽く説明してみましょうか。"
msgstr ""

#. Occurrence B_7:864:16069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0014; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:864
msgctxt "text_id=16069 | speaker=aoko"
msgid "　私も、なにか得る物があるかもしれないし」"
msgstr ""

#. Occurrence B_7:879:16070: scene=B_7
#: B_7:879
msgctxt "text_id=16070 | speaker=unknown"
msgid "　気を取り直して青子は語り始める。"
msgstr ""

#. Occurrence B_7:884:16071: scene=B_7
#: B_7:884
msgctxt "text_id=16071 | speaker=unknown"
msgid "　十一月の終わりから始まった戦い。"
msgstr ""

#. Occurrence B_7:889:16072: scene=B_7
#: B_7:889
msgctxt "text_id=16072 | speaker=unknown"
msgid "　静希草十郎との出会いもふくめた、長かったけれど新鮮でもあった、一連の出来事を。"
msgstr ""

#. Occurrence B_7:935:16073: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0015; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:935
msgctxt "text_id=16073 | speaker=aoko"
msgid "「事の起こりは一ヶ月前。"
msgstr ""

#. Occurrence B_7:941:16074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0016; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:941
msgctxt "text_id=16074 | speaker=aoko"
msgid "　三咲市に張られた結界のはじっこが、何者かに消されたのが発端だった。"
msgstr ""

#. Occurrence B_7:947:16075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0017; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:947
msgctxt "text_id=16075 | speaker=aoko"
msgid "　私が後継ぎになってから五度目の、三咲市を狙う敵の登場ってワケ」"
msgstr ""

#. Occurrence B_7:978:16076: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0018; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:978
msgctxt "text_id=16076 | speaker=aoko"
msgid "「今回の敵は私たちとは直接戦わず、まず土地を奪うところから始めたわ。"
msgstr ""

#. Occurrence B_7:984:16077: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0019; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:984
msgctxt "text_id=16077 | speaker=aoko"
msgid "　今までのヤツは私たちを半人前と舐めていたから、たいていは真っ正面から仕掛けてきて、かってに有珠の猟犬の餌食になったんだけど、まあ、それはどうでもいいとして」"
msgstr ""

#. Occurrence B_7:1005:16078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0020; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1005
msgctxt "text_id=16078 | speaker=aoko"
msgid "「町の結界には二種類あって、侵入者を見つけるものと、土地の力を有効利用するものがあるの。"
msgstr ""

#. Occurrence B_7:1011:16079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0021; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1011
msgctxt "text_id=16079 | speaker=aoko"
msgid "　敵が壊したのは土地の結界の方で、これが全部壊されると私や有珠は土地の所有権を失ってしまう。"
msgstr ""

#. Occurrence B_7:1017:16080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0022; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1017
msgctxt "text_id=16080 | speaker=aoko"
msgid "　土地のないはぐれ魔術師と同じになっちゃうのよ」"
msgstr ""

#. Occurrence B_7:1038:16081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0023; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1038
msgctxt "text_id=16081 | speaker=aoko"
msgid "「勿論、そうならないように侵入者をあぶりだすための結界があるんだけど、こっちには何の反応もなかった。"
msgstr ""

#. Occurrence B_7:1044:16082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0024; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1044
msgctxt "text_id=16082 | speaker=aoko"
msgid "　ま、当然よね。"
msgstr ""

#. Occurrence B_7:1050:16083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0025; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1050
msgctxt "text_id=16083 | speaker=aoko"
msgid "　今回の敵は私の姉貴、蒼崎橙子その人だったんだから」"
msgstr ""

#. Occurrence B_7:1071:16084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0026; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1071
msgctxt "text_id=16084 | speaker=aoko"
msgid "「蒼崎の結界は同族である姉貴を敵と見なさなかった。"
msgstr ""

#. Occurrence B_7:1077:16085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0027; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1077
msgctxt "text_id=16085 | speaker=aoko"
msgid "　……あるいは、姉貴は結界の抜け道、構造の死角をついたのかもしれない。"
msgstr ""

#. Occurrence B_7:1083:16086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0028; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1083
msgctxt "text_id=16086 | speaker=aoko"
msgid "　もともとうちの後継者はあの人だし、それぐらいの知識はあったでしょう」"
msgstr ""

#. Occurrence B_7:1104:16087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0029; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1104
msgctxt "text_id=16087 | speaker=aoko"
msgid "「そうして、姉貴は私たちに見つかる事なく好き勝手に結界の支点を壊しはじめた。"
msgstr ""

#. Occurrence B_7:1110:16088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0030; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1110
msgctxt "text_id=16088 | speaker=aoko"
msgid "　時間をかけてゆっくり壊していったのは、“外からやってきた部外者”を演じていたからでしょうね。"
msgstr ""

#. Occurrence B_7:1116:16089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0031; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1116
msgctxt "text_id=16089 | speaker=aoko"
msgid "　さすがに連続して壊されれば、こっちも身内の犯行だと疑うし。うち、親戚である<浅葱|あさぎ>家とは仲悪いままだしさ」"
msgstr ""

#. Occurrence B_7:1147:16090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0032; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1147
msgctxt "text_id=16090 | speaker=aoko"
msgid "「……まあ、姉貴の芝居に騙された私たちが間抜けなんだけど、セオリーとして、結界崩しは長丁場になるものなの。"
msgstr ""

#. Occurrence B_7:1153:16091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0033; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1153
msgctxt "text_id=16091 | speaker=aoko"
msgid "　管理地の結界は強固に作られているからね。普通は半年単位での攻防になる」"
msgstr ""

#. Occurrence B_7:1174:16092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0034; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1174
msgctxt "text_id=16092 | speaker=aoko"
msgid "「攻める側は、まず結界を<象|かたちど>る支点が何個あるか、それがどの五大要素でくくられているか、退去の正しい順序はどれか、それらを地道に解き明かしていく。"
msgstr ""

#. Occurrence B_7:1180:16093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0035; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1180
msgctxt "text_id=16093 | speaker=aoko"
msgid "　もちろん、管理地の魔術師たちの目を盗みながら」"
msgstr ""

#. Occurrence B_7:1201:16094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0036; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1201
msgctxt "text_id=16094 | speaker=aoko"
msgid "「対して、守る側は侵入者がいるコトに気づくから、悪さをされる前に敵の拠点を見つけだして、外敵を排除する。"
msgstr ""

#. Occurrence B_7:1207:16095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0037; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1207
msgctxt "text_id=16095 | speaker=aoko"
msgid "　こんな感じで、結界崩しは長期戦、あるいは前哨戦になるものなの。"
msgstr ""

#. Occurrence B_7:1213:16096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0038; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1213
msgctxt "text_id=16096 | speaker=aoko"
msgid "　たいていは攻める側が支点を壊すぞとアピールして、土地の持ち主を<翻弄|ほんろう>、<疲弊|ひへい>させてから、魔術師同士の直接対決で決着がつくわ」"
msgstr ""

#. Occurrence B_7:1234:16097: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0039; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1234
msgctxt "text_id=16097 | speaker=aoko"
msgid "「なんで、結界を<全部|ぜんぶ>壊す必要はないのよ。"
msgstr ""

#. Occurrence B_7:1240:16098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0040; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1240
msgctxt "text_id=16098 | speaker=aoko"
msgid "　管理地の持ち主を始末した方が早いし、その後は術式さえ解読しちゃえば、土地を結界ごと横取りできる。"
msgstr ""

#. Occurrence B_7:1246:16099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0041; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1246
msgctxt "text_id=16099 | speaker=aoko"
msgid "　わざわざ壊して作り直すより、昔からある結界の方が土地に馴染んでいて強力だしで一石二鳥でしょ」"
msgstr ""

#. Occurrence B_7:1266:16100: scene=B_7
#: B_7:1266
msgctxt "text_id=16100 | speaker=unknown"
msgid "　……そういった<定石|セオリー>から、青子たちは相手の思惑を読み違えてしまった。"
msgstr ""

#. Occurrence B_7:1271:16101: scene=B_7
#: B_7:1271
msgctxt "text_id=16101 | speaker=unknown"
msgid "　まさか相手が結界の支点をすべて壊すなど、そんな無駄な労力は割くまいとタカをくくっていたのだ。"
msgstr ""

#. Occurrence B_7:1321:16102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0042; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1321
msgctxt "text_id=16102 | speaker=aoko"
msgid "「だから、私と有珠はとりあえず受けに回った。"
msgstr ""

#. Occurrence B_7:1327:16103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0043; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1327
msgctxt "text_id=16103 | speaker=aoko"
msgid "　支点を探すために街を調査している敵を待ち伏せて、これを片っ端から倒そうって。"
msgstr ""

#. Occurrence B_7:1333:16104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0044; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1333
msgctxt "text_id=16104 | speaker=aoko"
msgid "　でも、そのうちの一つがケチのつき始めだった。"
msgstr ""

#. Occurrence B_7:1339:16105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0045; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1339
msgctxt "text_id=16105 | speaker=aoko"
msgid "　三咲町の公園でヤマはって待ち受けていた時、どうでもいい第三者が覗き見してやがったのよ」"
msgstr ""

#. Occurrence B_7:1366:16106: scene=B_7
#: B_7:1366
msgctxt "text_id=16106 | speaker=unknown"
msgid "　―――そう。"
msgstr ""

#. Occurrence B_7:1371:16107: scene=B_7
#: B_7:1371
msgctxt "text_id=16107 | speaker=unknown"
msgid "　魔術世界におけるトップクラスの<禁忌|タブー>。"
msgstr ""

#. Occurrence B_7:1376:16108: scene=B_7
#: B_7:1376
msgctxt "text_id=16108 | speaker=unknown"
msgid "　関わりのない第三者に、魔術師であるコトを知られてしまったのである。"
msgstr ""

#. Occurrence B_7:1397:16109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0046; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1397
msgctxt "text_id=16109 | speaker=aoko"
msgid "「その後の事は分かるでしょう？"
msgstr ""

#. Occurrence B_7:1429:16110: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0047; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1429
msgctxt "text_id=16110 | speaker=aoko"
msgid "　私は敵との小競り合いを有珠に任せて、それより重要な目撃者狩りに専念せざるを得なくなった。"
msgstr ""

#. Occurrence B_7:1446:16111: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0048; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1446
msgctxt "text_id=16111 | speaker=aoko"
msgid "　……言っとくけど、これはアンタの事だからね。そこでワレ<関|カン>セズ、みたいな顔しないこと」"
msgstr ""

#. Occurrence B_7:1482:16112: scene=B_7
#: B_7:1482
msgctxt "text_id=16112 | speaker=unknown"
msgid "　青子にじろりと睨まれて、草十郎はそうなのか？　と目を見開いた。"
msgstr ""

#. Occurrence B_7:1487:16113: scene=B_7
#: B_7:1487
msgctxt "text_id=16113 | speaker=unknown"
msgid "　おとなしく話を聞いているものの、やはり、あまり理解していないようだ。"
msgstr ""

#. Occurrence B_7:1519:16114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0049; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1519
msgctxt "text_id=16114 | speaker=aoko"
msgid "「……ま、いいけどね。草十郎がそんなだから秘密は漏れなかったんだし。"
msgstr ""

#. Occurrence B_7:1525:16115: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0050; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1525
msgctxt "text_id=16115 | speaker=aoko"
msgid "　で、アンタっていう目撃者を消そうとした私の単独行動は、敵にしても都合のいいものだった」"
msgstr ""

#. Occurrence B_7:1571:16116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0051; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1571
msgctxt "text_id=16116 | speaker=aoko"
msgid "「強敵である有珠がいないんだから、敵はこれを機会に私を始末しようと、特注品の人形を差し向けた……"
msgstr ""

#. Occurrence B_7:1577:16117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0052; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1577
msgctxt "text_id=16117 | speaker=aoko"
msgid "　と思っていたけど、アレはただの嫌がらせね、間違いなく。"
msgstr ""

#. Occurrence B_7:1584:16118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0053; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1584
msgctxt "text_id=16118 | speaker=aoko"
msgid "そうでなきゃ私そっくりの人形なんて派遣するかっての」"
msgstr ""

#. Occurrence B_7:1603:16119: scene=B_7
#: B_7:1603
msgctxt "text_id=16119 | speaker=unknown"
msgid "　ああ、あの青子人形、と相づちを打つ草十郎。"
msgstr ""

#. Occurrence B_7:1629:16120: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0054; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1629
msgctxt "text_id=16120 | speaker=aoko"
msgid "「アレの事は忘れてちょうだい。"
msgstr ""

#. Occurrence B_7:1641:16121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0055; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1641
msgctxt "text_id=16121 | speaker=aoko"
msgid "　……まあ、そこから先はアンタも薄々知ってるでしょ。"
msgstr ""

#. Occurrence B_7:1647:16122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0056; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1647
msgctxt "text_id=16122 | speaker=aoko"
msgid "　私と有珠は敵との戦いに専念する事になって、毎日のように捜査の手を空振って、決戦の夜を迎えて、今はこうしてる。"
msgstr ""

#. Occurrence B_7:1653:16123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0057; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1653
msgctxt "text_id=16123 | speaker=aoko"
msgid "　だいたいの経緯はこんなところよ」"
msgstr ""

#. Occurrence B_7:1689:16124: scene=B_7
#: B_7:1689
msgctxt "text_id=16124 | speaker=unknown"
msgid "　振り返ってみて納得したのか、ふむ、と青子はぞんざいに自分の体を見つめていた。"
msgstr ""

#. Occurrence B_7:1694:16125: scene=B_7
#: B_7:1694
msgctxt "text_id=16125 | speaker=unknown"
msgid "　シーツの下の体は、まだところどころ包帯が巻かれているものの、少しずつ<魔力|けつえき>が<通|かよ>いだしている。"
msgstr ""

#. Occurrence B_7:1715:16126: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0009; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1715
msgctxt "text_id=16126 | speaker=soujuurou"
msgid "「……蒼崎。これまでの君たちの話は分かった。"
msgstr ""

#. Occurrence B_7:1721:16127: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0010; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1721
msgctxt "text_id=16127 | speaker=soujuurou"
msgid "　けど、肝心の今の状況はどうなっているんだ？」"
msgstr ""

#. Occurrence B_7:1761:16128: scene=B_7
#: B_7:1761
msgctxt "text_id=16128 | speaker=unknown"
msgid "　青子がここに<臥|ふ>している理由。"
msgstr ""

#. Occurrence B_7:1766:16129: scene=B_7
#: B_7:1766
msgctxt "text_id=16129 | speaker=unknown"
msgid "　草十郎にとって最大の関心は、昨日の夜、何があったかという事だ。"
msgstr ""

#. Occurrence B_7:1800:16130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0058; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1800
msgctxt "text_id=16130 | speaker=aoko"
msgid "「バカね。状況も何も、完全に私たちの負けじゃない」"
msgstr ""

#. Occurrence B_7:1806:16131: scene=B_7
#: B_7:1806
msgctxt "text_id=16131 | speaker=unknown"
msgid "　両手が満足に動けたのならバンザイでもしそうな口調で、青子はあっさり敗北宣言をした。"
msgstr ""

#. Occurrence B_7:1843:16132: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0011; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1843
msgctxt "text_id=16132 | speaker=soujuurou"
msgid "「負けた……？」"
msgstr ""

#. Occurrence B_7:1849:16133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0059; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1849
msgctxt "text_id=16133 | speaker=aoko"
msgid "「そ。事実は正しく受け止めなくっちゃね。"
msgstr ""

#. Occurrence B_7:1855:16134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0060; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1855
msgctxt "text_id=16134 | speaker=aoko"
msgid "　五つの支点がぜんぶ壊された時点で、勝負はついたの。"
msgstr ""

#. Occurrence B_7:1861:16135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0061; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1861
msgctxt "text_id=16135 | speaker=aoko"
msgid "　管理地の所有権は宙ぶらりで、明日には橙子の手に渡るでしょう。"
msgstr ""

#. Occurrence B_7:1880:16136: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0062; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1880
msgctxt "text_id=16136 | speaker=aoko"
msgid "　で、それを阻止したいこっちは、私も有珠もこの有様。"
msgstr ""

#. Occurrence B_7:1886:16137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0063; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1886
msgctxt "text_id=16137 | speaker=aoko"
msgid "　もう立場は逆転したから、これから私たちは挑戦者……つまり、はぐれ魔術師ってコトよ」"
msgstr ""

#. Occurrence B_7:1906:16138: scene=B_7
#: B_7:1906
msgctxt "text_id=16138 | speaker=unknown"
msgid "　なので、青子たちがこの教会に厄介になれるのも、あと数日だけだった。"
msgstr ""

#. Occurrence B_7:1922:16139: scene=B_7
#: B_7:1922
msgctxt "text_id=16139 | speaker=unknown"
msgid "　この合田教会は魔術協会の支部でもあり、異端を監視する聖堂教会とやらの支部でもある。"
msgstr ""

#. Occurrence B_7:1927:16140: scene=B_7
#: B_7:1927
msgctxt "text_id=16140 | speaker=unknown"
msgid "　青子たちはそのどちらにも所属していない、三咲市だけの有権者だ。"
msgstr ""

#. Occurrence B_7:1947:16141: scene=B_7
#: B_7:1947
msgctxt "text_id=16141 | speaker=unknown"
msgid "　教会が青子たちに力を貸しているのは、彼女たちが土地の管理者であったから。"
msgstr ""

#. Occurrence B_7:1952:16142: scene=B_7
#: B_7:1952
msgctxt "text_id=16142 | speaker=unknown"
msgid "　その権利を失うのなら、教会として肩入れする理由は皆無である。"
msgstr ""

#. Occurrence B_7:1975:16143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0064; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1975
msgctxt "text_id=16143 | speaker=aoko"
msgid "「詠梨神父は<中立者|こうもり>だから私を助けてくれたけど、唯架さんは教会の代行者だから、傷が塞がったなら明日にでも出ていけって言ってくる。"
msgstr ""

#. Occurrence B_7:1982:16144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0065; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1982
msgctxt "text_id=16144 | speaker=aoko"
msgid "教会にとっちゃ、魔術師なんてもともと排除すべき商売敵だからね。"
msgstr ""

#. Occurrence B_7:1990:16145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0066; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1990
msgctxt "text_id=16145 | speaker=aoko"
msgid "　バカ律架は―――まあ、泣きつけば力にはなってくれるでしょうけど」"
msgstr ""

#. Occurrence B_7:2024:16146: scene=B_7
#: B_7:2024
msgctxt "text_id=16146 | speaker=unknown"
msgid "　ぶつぶつと草十郎には分からない話をする青子。"
msgstr ""

#. Occurrence B_7:2031:16147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0012; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2031
msgctxt "text_id=16147 | speaker=soujuurou"
msgid "「そうじゃなくて、蒼崎。"
msgstr ""

#. Occurrence B_7:2038:16148: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0013; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2038
msgctxt "text_id=16148 | speaker=soujuurou"
msgid "昨日の夜、何があったんだ」"
msgstr ""

#. Occurrence B_7:2075:16149: scene=B_7
#: B_7:2075
msgctxt "text_id=16149 | speaker=unknown"
msgid "　一番聞きたい事を話したがらない青子に、草十郎は自分から切りだした。"
msgstr ""

#. Occurrence B_7:2109:16150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0067; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2109
msgctxt "text_id=16150 | speaker=aoko"
msgid "「……見て分からない？　惨敗なんてものじゃないわ。"
msgstr ""

#. Occurrence B_7:2115:16151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0068; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2115
msgctxt "text_id=16151 | speaker=aoko"
msgid "　喉に食い付かれる、体中好き放題噛まれまくる、あげくに右の<腿|もも>なんてなくなってたそうよ。"
msgstr ""

#. Occurrence B_7:2121:16152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0069; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2121
msgctxt "text_id=16152 | speaker=aoko"
msgid "　ま、有珠のチョコレイトのおかげで出血死は免れたけど」"
msgstr ""

#. Occurrence B_7:2143:16153: scene=B_7
#: B_7:2143
msgctxt "text_id=16153 | speaker=unknown"
msgid "　青子はぽん、とギプスに包まれた片足を叩いた。"
msgstr ""

#. Occurrence B_7:2148:16154: scene=B_7
#: B_7:2148
msgctxt "text_id=16154 | speaker=unknown"
msgid "　気楽に言いながらも、その奥には雪辱への闘志が見え隠れしている。"
msgstr ""

#. Occurrence B_7:2176:16155: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0014; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2176
msgctxt "text_id=16155 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_7:2182:16156: scene=B_7
#: B_7:2182
msgctxt "text_id=16156 | speaker=unknown"
msgid "　そんな青子とは反対に、彼に起きた感情は『空白』だった。"
msgstr ""

#. Occurrence B_7:2187:16157: scene=B_7
#: B_7:2187
msgctxt "text_id=16157 | speaker=unknown"
msgid "　青ざめた顔色がいっそう白く、色を削ぎ落とす。"
msgstr ""

#. Occurrence B_7:2192:16158: scene=B_7
#: B_7:2192
msgctxt "text_id=16158 | speaker=unknown"
msgid "　凄惨な行為からの逃避か、あるいは反感か。"
msgstr ""

#. Occurrence B_7:2197:16159: scene=B_7
#: B_7:2197
msgctxt "text_id=16159 | speaker=unknown"
msgid "　どちらにせよ、人間らしい感情の発露だった。"
msgstr ""

#. Occurrence B_7:2243:16160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0070; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2243
msgctxt "text_id=16160 | speaker=aoko"
msgid "「なんでそこで固まる……あ、そっか。"
msgstr ""

#. Occurrence B_7:2262:16161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0071; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2262
msgctxt "text_id=16161 | speaker=aoko"
msgid "　私を見て吐き出しちゃうぐらいナイーヴなんだっけ、草十郎ってば。大丈夫よ、今はくっついてるから。"
msgstr ""

#. Occurrence B_7:2268:16162: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0072; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2268
msgctxt "text_id=16162 | speaker=aoko"
msgid "　唯架さんは治療専門だし、私だってただやられてたワケじゃないし。復元は蒼崎の得意分野だから、あれくらい問題ないわ」"
msgstr ""

#. Occurrence B_7:2288:16163: scene=B_7
#: B_7:2288
msgctxt "text_id=16163 | speaker=unknown"
msgid "　だから心配はいらない、と視線で語る青子だが、草十郎の様子は一向に変わらない。"
msgstr ""

#. Occurrence B_7:2306:16164: scene=B_7
#: B_7:2306
msgctxt "text_id=16164 | speaker=unknown"
msgid "　……見当違いとはいえ、ここまで心配されると青子も文句は言い辛い。"
msgstr ""

#. Occurrence B_7:2311:16165: scene=B_7
#: B_7:2311
msgctxt "text_id=16165 | speaker=unknown"
msgid "　なんだか照れ臭くなって、青子は会話を再開した。"
msgstr ""

#. Occurrence B_7:2345:16166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0073; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2345
msgctxt "text_id=16166 | speaker=aoko"
msgid "「けど姉貴ったら、どうやってあんなのを<手懐|てなず>けたんだろう。金の<狼|おおかみ>なんて、伝説の中にしかいないと思ってた。"
msgstr ""

#. Occurrence B_7:2351:16167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0074; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2351
msgctxt "text_id=16167 | speaker=aoko"
msgid "　……神代の神秘であるあいつには千年クラスの魔術じゃないと太刀打ちできない。かといって殴り合いでどうにかできる相手じゃないし……」"
msgstr ""

#. Occurrence B_7:2382:16168: scene=B_7
#: B_7:2382
msgctxt "text_id=16168 | speaker=unknown"
msgid "　昨夜の惨状を思い出し、青子は悔しげに唇を噛む。"
msgstr ""

#. Occurrence B_7:2388:16169: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0015; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2388
msgctxt "text_id=16169 | speaker=soujuurou"
msgid "「金の……狼……？」"
msgstr ""

#. Occurrence B_7:2406:16170: scene=B_7
#: B_7:2406
msgctxt "text_id=16170 | speaker=unknown"
msgid "　一方、聞きなれない言葉を聞いて、草十郎はショック状態から回復したようだ。"
msgstr ""

#. Occurrence B_7:2440:16171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0075; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2440
msgctxt "text_id=16171 | speaker=aoko"
msgid "「そ、<黄金|おうごん>の<人狼|じんろう>。<金狼|きんろう>って言った方がいいのかな。"
msgstr ""

#. Occurrence B_7:2446:16172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0076; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2446
msgctxt "text_id=16172 | speaker=aoko"
msgid "　狼男……って言っても分からないわよね。人間と狼のいいとこどりみたいなヤツと思えばいいわ。"
msgstr ""

#. Occurrence B_7:2468:16173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0077; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2468
msgctxt "text_id=16173 | speaker=aoko"
msgid "　野獣というより魔獣のたぐいよ。"
msgstr ""

#. Occurrence B_7:2474:16174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0078; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2474
msgctxt "text_id=16174 | speaker=aoko"
msgid "　普通の人狼なら対抗手段はあるんだけど、橙子が連れてるのは黄金の毛並みをした怪物でさ」"
msgstr ""

#. Occurrence B_7:2495:16175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0079; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2495
msgctxt "text_id=16175 | speaker=aoko"
msgid "「あれは原初の人狼の血統で、魔獣を通り越して幻獣の域に達している。"
msgstr ""

#. Occurrence B_7:2514:16176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0080; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2514
msgctxt "text_id=16176 | speaker=aoko"
msgid "　聖域の相手には、そいつらを上回る神秘……積み重ねた時間とか、魔術の奥義……じゃないと無効化されるのよ。"
msgstr ""

#. Occurrence B_7:2520:16177: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0081; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2520
msgctxt "text_id=16177 | speaker=aoko"
msgid "　魔術は万能だけど、この“年月の差”だけは<覆|くつがえ>せない。"
msgstr ""

#. Occurrence B_7:2537:16178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0082; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2537
msgctxt "text_id=16178 | speaker=aoko"
msgid "　ま、人間の魔術師にとっては天敵みたいな自然災害ね」"
msgstr ""

#. Occurrence B_7:2557:16179: scene=B_7
#: B_7:2557
msgctxt "text_id=16179 | speaker=unknown"
msgid "　憎しみはなく、感心するように青子は語る。"
msgstr ""

#. Occurrence B_7:2562:16180: scene=B_7
#: B_7:2562
msgctxt "text_id=16180 | speaker=unknown"
msgid "　そんな呟きに、"
msgstr ""

#. Occurrence B_7:2582:16181: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0016; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2582
msgctxt "text_id=16181 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence B_7:2587:16182: scene=B_7
#: B_7:2587
msgctxt "text_id=16182 | speaker=unknown"
msgid "　なにやら意味不明な納得をする草十郎だった。"
msgstr ""

#. Occurrence B_7:2626:16183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0083; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2626
msgctxt "text_id=16183 | speaker=aoko"
msgid "「？　な、なに？」"
msgstr ""

#. Occurrence B_7:2637:16184: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0017; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2637
msgctxt "text_id=16184 | speaker=soujuurou"
msgid "「いや、要するに蒼崎たちじゃ敵わない相手なんだな。"
msgstr ""

#. Occurrence B_7:2648:16185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0018; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2648
msgctxt "text_id=16185 | speaker=soujuurou"
msgid "　……なんて酷いヤツだ。"
msgstr ""

#. Occurrence B_7:2655:16186: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0019; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2655
msgctxt "text_id=16186 | speaker=soujuurou"
msgid "有珠はお<腹|なか>が裂かれてた。蒼崎は傷ついてない<箇所|ところ>はないぐらいだ。"
msgstr ""

#. Occurrence B_7:2661:16187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0020; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2661
msgctxt "text_id=16187 | speaker=soujuurou"
msgid "　子供なのに……いや、子供だから加減がないのか」"
msgstr ""

#. Occurrence B_7:2695:16188: scene=B_7
#: B_7:2695
msgctxt "text_id=16188 | speaker=unknown"
msgid "　青ざめた顔で、<訥々|とつとつ>と呟く草十郎。"
msgstr ""

#. Occurrence B_7:2711:16189: scene=B_7
#: B_7:2711
msgctxt "text_id=16189 | speaker=unknown"
msgid "　青子は同感だ、とばかりにうなずいた。"
msgstr ""

#. Occurrence B_7:2730:16190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0084; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2730
msgctxt "text_id=16190 | speaker=aoko"
msgid "「ほーんと。"
msgstr ""

#. Occurrence B_7:2737:16191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0085; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2737
msgctxt "text_id=16191 | speaker=aoko"
msgid "人の体を何だと思っているのかしらね、あのお子さ―――なぬ？」"
msgstr ""

#. Occurrence B_7:2781:16192: scene=B_7
#: B_7:2781
msgctxt "text_id=16192 | speaker=unknown"
msgid "　そこまで言いかけて、青子はバッと顔をあげた。"
msgstr ""

#. Occurrence B_7:2786:16193: scene=B_7
#: B_7:2786
msgctxt "text_id=16193 | speaker=unknown"
msgid "　いつかのように、意外なお化けを見たように。"
msgstr ""

#. Occurrence B_7:2807:16194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0086; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2807
msgctxt "text_id=16194 | speaker=aoko"
msgid "「いま子供って言った？"
msgstr ""

#. Occurrence B_7:2813:16195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0087; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2813
msgctxt "text_id=16195 | speaker=aoko"
msgid "　アンタ、なんでそんなコトまで知ってるの？」"
msgstr ""

#. Occurrence B_7:2819:16196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0021; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2819
msgctxt "text_id=16196 | speaker=soujuurou"
msgid "「やっぱりそうなのか。金色の髪なんて二人もいないと思ったんだ。そいつなら一度見かけた事がある。"
msgstr ""

#. Occurrence B_7:2841:16197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0022; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2841
msgctxt "text_id=16197 | speaker=soujuurou"
msgid "　蒼崎が口にしたような怪物じゃなかったけど、森の奥で。"
msgstr ""

#. Occurrence B_7:2847:16198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0023; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2847
msgctxt "text_id=16198 | speaker=soujuurou"
msgid "　木乃美が二人がかりでとっちめよう、なんて怖いコト言いだしてさ。<敵|かな>いっこないから止めたんだよ」"
msgstr ""

#. Occurrence B_7:2891:16199: scene=B_7
#: B_7:2891
msgctxt "text_id=16199 | speaker=unknown"
msgid "　不思議な事を、不思議な口調で草十郎は言う。"
msgstr ""

#. Occurrence B_7:2896:16200: scene=B_7
#: B_7:2896
msgctxt "text_id=16200 | speaker=unknown"
msgid "　青子にはそれを追及する余裕もない。"
msgstr ""

#. Occurrence B_7:2901:16201: scene=B_7
#: B_7:2901
msgctxt "text_id=16201 | speaker=unknown"
msgid "　彼女的に、他にもっと重要な事がある―――"
msgstr ""

#. Occurrence B_7:2923:16202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0088; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2923
msgctxt "text_id=16202 | speaker=aoko"
msgid "「見たって、どこで！？」"
msgstr ""

#. Occurrence B_7:2937:16203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0024_0; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2937
msgctxt "text_id=16203 | speaker=soujuurou"
msgid "「学校の旧校舎。"
msgstr ""

#. Occurrence B_7:2952:16204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0024_1; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2952
msgctxt "text_id=16204 | speaker=soujuurou"
msgid "あ、そういえば挨拶ていどなら話もしたっけ。一度だけ、アルバイトの時に牛肉五十キロを生で届けた事があって……」"
msgstr ""

#. Occurrence B_7:2985:16205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0089; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2985
msgctxt "text_id=16205 | speaker=aoko"
msgid "「こ、この大馬鹿ものーーーーお！」"
msgstr ""

#. Occurrence B_7:3026:16206: scene=B_7
#: B_7:3026
msgctxt "text_id=16206 | speaker=unknown"
msgid "　すぱかーん、と心地よい音がした。"
msgstr ""

#. Occurrence B_7:3031:16207: scene=B_7
#: B_7:3031
msgctxt "text_id=16207 | speaker=unknown"
msgid "　体の傷もなんのその、青子は神速で床のスリッパを取ると、草十郎の平和そうな顔に思いっきり投げ付けた。"
msgstr ""

#. Occurrence B_7:3051:16208: scene=B_7
#: B_7:3051
msgctxt "text_id=16208 | speaker=unknown"
msgid "　はあはあと肩で息をする青子と、顔面を強襲したスリッパの衝撃で、座ったまま倒れこむ草十郎。"
msgstr ""

#. Occurrence B_7:3074:16209: scene=B_7
#: B_7:3074
msgctxt "text_id=16209 | speaker=unknown"
msgid "　しばし、ふたりはそのままで動かなかった。"
msgstr ""

#. Occurrence B_7:3109:16210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0025; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3109
msgctxt "text_id=16210 | speaker=soujuurou"
msgid "「―――なんで怒るんだ、蒼崎」"
msgstr ""

#. Occurrence B_7:3115:16211: scene=B_7
#: B_7:3115
msgctxt "text_id=16211 | speaker=unknown"
msgid "　むくりと起き上がる不屈の男。"
msgstr ""

#. Occurrence B_7:3120:16212: scene=B_7
#: B_7:3120
msgctxt "text_id=16212 | speaker=unknown"
msgid "　<小法師|こぼし>の如く<胡坐|あぐら>をかく彼を、青子は敵を見る目で睨みつける。"
msgstr ""

#. Occurrence B_7:3156:16213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0090; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3156
msgctxt "text_id=16213 | speaker=aoko"
msgid "「あったりまえじゃない！"
msgstr ""

#. Occurrence B_7:3162:16214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0091; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3162
msgctxt "text_id=16214 | speaker=aoko"
msgid "　なんでそんな怪しいコト黙ってんのよ、アンタはっ！」"
msgstr ""

#. Occurrence B_7:3175:16215: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0026; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3175
msgctxt "text_id=16215 | speaker=soujuurou"
msgid "「……言うほどの事でもない。第一、君たちにこんな話をしても怒られるだけじゃないか」"
msgstr ""

#. Occurrence B_7:3208:16216: scene=B_7
#: B_7:3208
msgctxt "text_id=16216 | speaker=unknown"
msgid "　草十郎のもっともな意見に、青子はうっと言葉を飲んだ。"
msgstr ""

#. Occurrence B_7:3228:16217: scene=B_7
#: B_7:3228
msgctxt "text_id=16217 | speaker=unknown"
msgid "　夕食中、"
msgstr ""

#. Occurrence B_7:3248:16218: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0027; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3248
msgctxt "text_id=16218 | speaker=soujuurou"
msgid "『ところで今日、牛肉の山をかついで届けたんだ。一匹丸ごと。いや、あるところにはあるものだね、お金と食欲』"
msgstr ""

#. Occurrence B_7:3271:16219: scene=B_7
#: B_7:3271
msgctxt "text_id=16219 | speaker=unknown"
msgid "　なんて話をされたら、<青子|じぶん>と有珠がどんな反応するか、考えるまでもない。"
msgstr ""

#. Occurrence B_7:3298:16220: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0092; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3298
msgctxt "text_id=16220 | speaker=aoko"
msgid "「っ……それは、そうだけど。"
msgstr ""

#. Occurrence B_7:3319:16221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0093; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3319
msgctxt "text_id=16221 | speaker=aoko"
msgid "　……ほんとに、金髪の子供が旧校舎にいたの？」"
msgstr ""

#. Occurrence B_7:3339:16222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0028; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3339
msgctxt "text_id=16222 | speaker=soujuurou"
msgid "「それが蒼崎の言うジンロウかどうか、自信はないけど。"
msgstr ""

#. Occurrence B_7:3345:16223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0029; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3345
msgctxt "text_id=16223 | speaker=soujuurou"
msgid "　少なくとも街中の料理店が入れ代わりでおかしな注文を届けてるのは事実だ。駅前の大帝都なんてお得意様だって」"
msgstr ""

#. Occurrence B_7:3379:16224: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0094; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3379
msgctxt "text_id=16224 | speaker=aoko"
msgid "「……たしかに、食事のたびにあいつを外に出してちゃ目立つだろうけど……」"
msgstr ""

#. Occurrence B_7:3385:16225: scene=B_7
#: B_7:3385
msgctxt "text_id=16225 | speaker=unknown"
msgid "　……あんまり信じたくはないが、そこが人狼の住み家である可能性は高すぎる。"
msgstr ""

#. Occurrence B_7:3390:16226: scene=B_7
#: B_7:3390
msgctxt "text_id=16226 | speaker=unknown"
msgid "　橙子なりに人狼の存在を隠したのだろうが、その方法はどこか間が抜けていた。"
msgstr ""

#. Occurrence B_7:3421:16227: scene=B_7
#: B_7:3421
msgctxt "text_id=16227 | speaker=unknown"
msgid "　……しかし、ともかくだ。"
msgstr ""

#. Occurrence B_7:3426:16228: scene=B_7
#: B_7:3426
msgctxt "text_id=16228 | speaker=unknown"
msgid "　人狼の住み家が判明した以上、探していた橙子の本拠地も判明した事になる。"
msgstr ""

#. Occurrence B_7:3431:16229: scene=B_7
#: B_7:3431
msgctxt "text_id=16229 | speaker=unknown"
msgid "　そもそも結界の張り替えには資材が保管できて、人目につかない拠点が必要なのだ。"
msgstr ""

#. Occurrence B_7:3436:16230: scene=B_7
#: B_7:3436
msgctxt "text_id=16230 | speaker=unknown"
msgid "　三咲高校の旧校舎は、その条件を備えている。"
msgstr ""

#. Occurrence B_7:3468:16231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0095; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3468
msgctxt "text_id=16231 | speaker=aoko"
msgid "「……つまり、全ての鍵はアンタが隠し持ってたってワケね」"
msgstr ""

#. Occurrence B_7:3488:16232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0030; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3488
msgctxt "text_id=16232 | speaker=soujuurou"
msgid "「隠していたんじゃない。"
msgstr ""

#. Occurrence B_7:3495:16233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0031; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3495
msgctxt "text_id=16233 | speaker=soujuurou"
msgid "だいたい、蒼崎が裏山の掃除に参加していたら、その時に分かったんじゃないか？"
msgstr ""

#. Occurrence B_7:3501:16234: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0032; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3501
msgctxt "text_id=16234 | speaker=soujuurou"
msgid "　鳶丸ひとりに任せず、蒼崎も掃除にでれば良かったんだ」"
msgstr ""

#. Occurrence B_7:3539:16235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0096; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3539
msgctxt "text_id=16235 | speaker=aoko"
msgid "「…………………………」"
msgstr ""

#. Occurrence B_7:3560:16236: scene=B_7
#: B_7:3560
msgctxt "text_id=16236 | speaker=unknown"
msgid "　……ごもっともな意見に、青子はぱちりと指を鳴らす。"
msgstr ""

#. Occurrence B_7:3594:16237: scene=B_7
#: B_7:3594
msgctxt "text_id=16237 | speaker=unknown"
msgid "　スリッパ爆弾の代わりに、白い首輪は忠実に、彼女の気持ちを代弁したのだった。"
msgstr ""

#. Occurrence B_7:3638:16238: scene=B_7
#: B_7:3638
msgctxt "text_id=16238 | speaker=unknown"
msgid "　そうして。"
msgstr ""

#. Occurrence B_7:3643:16239: scene=B_7
#: B_7:3643
msgctxt "text_id=16239 | speaker=unknown"
msgid "　草十郎がひとしきり首輪の圧迫に苦しんだあと、"
msgstr ""

#. Occurrence B_7:3648:16240: scene=B_7
#: B_7:3648
msgctxt "text_id=16240 | speaker=unknown"
msgid "　彼ははっきりと、青子の変化に気が付いた。"
msgstr ""

#. Occurrence B_7:3672:16241: scene=B_7
#: B_7:3672
msgctxt "text_id=16241 | speaker=unknown"
msgid "　ベッドの上の少女は、<凛|リン>と遠くを見据えている"
msgstr ""

#. Occurrence B_7:3677:16242: scene=B_7
#: B_7:3677
msgctxt "text_id=16242 | speaker=unknown"
msgid "　傷ついて力がなかった<面|おも>もちも、患者衣の悲愴なイメージを打ち消すぐらいシャンとしていた。"
msgstr ""

#. Occurrence B_7:3683:16243: scene=B_7
#: B_7:3683
msgctxt "text_id=16243 | speaker=unknown"
msgid "　ようするにやる気に満ちあふれているのだ、青子は。"
msgstr ""

#. Occurrence B_7:3688:16244: scene=B_7
#: B_7:3688
msgctxt "text_id=16244 | speaker=unknown"
msgid "　それが誰に対して、何に対してかは言うまでもない。"
msgstr ""

#. Occurrence B_7:3726:16245: scene=B_7
#: B_7:3726
msgctxt "text_id=16245 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence B_7:3734:16246: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0033; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3734
msgctxt "text_id=16246 | speaker=soujuurou"
msgid "蒼崎？」"
msgstr ""

#. Occurrence B_7:3754:16247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0097; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3754
msgctxt "text_id=16247 | speaker=aoko"
msgid "「ん？」"
msgstr ""

#. Occurrence B_7:3760:16248: scene=B_7
#: B_7:3760
msgctxt "text_id=16248 | speaker=unknown"
msgid "　草十郎の呼びかけに、青子は無防備な声をあげた。"
msgstr ""

#. Occurrence B_7:3765:16249: scene=B_7
#: B_7:3765
msgctxt "text_id=16249 | speaker=unknown"
msgid "　事実、不意を突いたのだろう。"
msgstr ""

#. Occurrence B_7:3770:16250: scene=B_7
#: B_7:3770
msgctxt "text_id=16250 | speaker=unknown"
msgid "　目標を定めた彼女は、完全にひとりの世界に入っていたのだから。"
msgstr ""

#. Occurrence B_7:3803:16251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0098; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3803
msgctxt "text_id=16251 | speaker=aoko"
msgid "「ありがと、草十郎」"
msgstr ""

#. Occurrence B_7:3826:16252: scene=B_7
#: B_7:3826
msgctxt "text_id=16252 | speaker=unknown"
msgid "　先ほどの不意打ちの仕返し……なんて<悪戯|いたずら>心からではない。"
msgstr ""

#. Occurrence B_7:3831:16253: scene=B_7
#: B_7:3831
msgctxt "text_id=16253 | speaker=unknown"
msgid "　青子はごく自然に感謝を口にした。"
msgstr ""

#. Occurrence B_7:3836:16254: scene=B_7
#: B_7:3836
msgctxt "text_id=16254 | speaker=unknown"
msgid "　聞きなれない言葉に、草十郎はハト<豆鉄砲|まめでっぽう>状態だ。"
msgstr ""

#. Occurrence B_7:3872:16255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0099; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3872
msgctxt "text_id=16255 | speaker=aoko"
msgid "「……あのね。とにかく、橙子の居場所が判ったのはアンタのおかげだから、礼ぐらい言っておこうと思ったの。"
msgstr ""

#. Occurrence B_7:3878:16256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0100; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3878
msgctxt "text_id=16256 | speaker=aoko"
msgid "　それがお気に召さなかった？」"
msgstr ""

#. Occurrence B_7:3900:16257: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0034; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3900
msgctxt "text_id=16257 | speaker=soujuurou"
msgid "「いや、お礼を言ってもらえるのはいい事だけど。"
msgstr ""

#. Occurrence B_7:3906:16258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0035; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3906
msgctxt "text_id=16258 | speaker=soujuurou"
msgid "　……まさか、その体で橙子さんの所に行くつもりか？」"
msgstr ""

#. Occurrence B_7:3912:16259: scene=B_7
#: B_7:3912
msgctxt "text_id=16259 | speaker=unknown"
msgid "　<労|いたわ>りより叱責の色が濃い。"
msgstr ""

#. Occurrence B_7:3917:16260: scene=B_7
#: B_7:3917
msgctxt "text_id=16260 | speaker=unknown"
msgid "　そんな問いに、青子は当然とばかりに頷いた。"
msgstr ""

#. Occurrence B_7:3965:16261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0101; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3965
msgctxt "text_id=16261 | speaker=aoko"
msgid "「取られた物は取り返すものよ、草十郎。"
msgstr ""

#. Occurrence B_7:3971:16262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0102; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3971
msgctxt "text_id=16262 | speaker=aoko"
msgid "　それもすぐに、相手の物になってしまう前にね。ぐずぐずしている暇はないわ」"
msgstr ""

#. Occurrence B_7:3977:16263: scene=B_7
#: B_7:3977
msgctxt "text_id=16263 | speaker=unknown"
msgid "　こうして我を言いきる時の青子の気迫には逆らえないものがある。"
msgstr ""

#. Occurrence B_7:3982:16264: scene=B_7
#: B_7:3982
msgctxt "text_id=16264 | speaker=unknown"
msgid "　それでも、草十郎は<頑|がん>として引かなかった。"
msgstr ""

#. Occurrence B_7:4003:16265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0036; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4003
msgctxt "text_id=16265 | speaker=soujuurou"
msgid "「勝ち目がなくてもか。暇はないと言うけど、今はそれ以上に休息が必要だろう。"
msgstr ""

#. Occurrence B_7:4010:16266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0037; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4010
msgctxt "text_id=16266 | speaker=soujuurou"
msgid "その傷だって、今は見れるけど昨日は酷かったじゃないか。生きていたのが幸運なぐらいだ」"
msgstr ""

#. Occurrence B_7:4018:16267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0103; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4018
msgctxt "text_id=16267 | speaker=aoko"
msgid "「違うわ。あれは幸運なんかじゃない。そんなタマかっていうのよ、橙子が」"
msgstr ""

#. Occurrence B_7:4030:16268: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0038; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4030
msgctxt "text_id=16268 | speaker=soujuurou"
msgid "「幸運じゃない……？」"
msgstr ""

#. Occurrence B_7:4056:16269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0104; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4056
msgctxt "text_id=16269 | speaker=aoko"
msgid "「そ。橙子はね、私が生き残れる程度の傷にとどめたのよ。今回は見逃してやるから、もう一度やってこいって意味でね。"
msgstr ""

#. Occurrence B_7:4062:16270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0105; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4062
msgctxt "text_id=16270 | speaker=aoko"
msgid "　だから私は生きてるんだし、橙子は私が行くのを待ってる。お互いが、お互いの舞台の幕を下ろすために。そうでなければここまで待った意味がないでしょう。"
msgstr ""

#. Occurrence B_7:4068:16271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0106; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4068
msgctxt "text_id=16271 | speaker=aoko"
msgid "　……イヤだけど、アンタの言葉を借りるなら、ね」"
msgstr ""

#. Occurrence B_7:4111:16272: scene=B_7
#: B_7:4111
msgctxt "text_id=16272 | speaker=unknown"
msgid "　忌ま忌ましげに語る青子の横顔は、鬼気迫るものがあった。"
msgstr ""

#. Occurrence B_7:4116:16273: scene=B_7
#: B_7:4116
msgctxt "text_id=16273 | speaker=unknown"
msgid "　草十郎から見れば、殺し合いを良しとする青子も、そうなるように仕向けている橙子も、遠い世界の住人のようだ。"
msgstr ""

#. Occurrence B_7:4144:16274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0039; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4144
msgctxt "text_id=16274 | speaker=soujuurou"
msgid "「……殺すために生かしたっていうのか、橙子さんは。"
msgstr ""

#. Occurrence B_7:4150:16275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0040; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4150
msgctxt "text_id=16275 | speaker=soujuurou"
msgid "　蒼崎はそれが分かっているのに行こうとしている」"
msgstr ""

#. Occurrence B_7:4176:16276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0107; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4176
msgctxt "text_id=16276 | speaker=aoko"
msgid "「そうよ。勝負はついたけど、まだ私たちの話は終わっていないもの。"
msgstr ""

#. Occurrence B_7:4182:16277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0108; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4182
msgctxt "text_id=16277 | speaker=aoko"
msgid "　たしかに全快してから行ったほうがいいに決まってる。けど、そうしている間に橙子は三咲の深部にたどり着く。そうなったら、私の最後の切札さえ使えなくなる。"
msgstr ""

#. Occurrence B_7:4203:16278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0109; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4203
msgctxt "text_id=16278 | speaker=aoko"
msgid "　自分にできる事を、自分から無くしてしまうのは―――」"
msgstr ""

#. Occurrence B_7:4224:16279: scene=B_7
#: B_7:4224
msgctxt "text_id=16279 | speaker=unknown"
msgid "　それは死より深い痛みではないけれど―――"
msgstr ""

#. Occurrence B_7:4230:16280: scene=B_7
#: B_7:4230
msgctxt "text_id=16280 | speaker=unknown"
msgid "　命あるかぎり逃げられない後悔だと、青い瞳が語っていた。"
msgstr ""

#. Occurrence B_7:4263:16281: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0041; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4263
msgctxt "text_id=16281 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_7:4281:16282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0110; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4281
msgctxt "text_id=16282 | speaker=aoko"
msgid "「納得いったのなら黙ってて。"
msgstr ""

#. Occurrence B_7:4287:16283: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0111; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4287
msgctxt "text_id=16283 | speaker=aoko"
msgid "　いい、これは私の戦い。アンタには何の責任も関わりもない、私の人生なの。"
msgstr ""

#. Occurrence B_7:4293:16284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0112; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4293
msgctxt "text_id=16284 | speaker=aoko"
msgid "　座して死を待つなんてまっぴらゴメンよ。勝つ気があるなら、いつまでもベッドで寝てるワケにはいかないでしょう」"
msgstr ""

#. Occurrence B_7:4313:16285: scene=B_7
#: B_7:4313
msgctxt "text_id=16285 | speaker=unknown"
msgid "　青子の返答は、草十郎への完全な拒絶だ。"
msgstr ""

#. Occurrence B_7:4318:16286: scene=B_7
#: B_7:4318
msgctxt "text_id=16286 | speaker=unknown"
msgid "　他人の関わる余地はない。"
msgstr ""

#. Occurrence B_7:4323:16287: scene=B_7
#: B_7:4323
msgctxt "text_id=16287 | speaker=unknown"
msgid "　それが優しさからくるものなのか、<嘲|あざけ>りからくるものなのか、草十郎には読み取れない。"
msgstr ""

#. Occurrence B_7:4342:16288: scene=B_7
#: B_7:4342
msgctxt "text_id=16288 | speaker=unknown"
msgid "　分かるのは、彼女を止めたければ、彼女を手にかけるだけの覚悟が必要ということ。"
msgstr ""

#. Occurrence B_7:4348:16289: scene=B_7
#: B_7:4348
msgctxt "text_id=16289 | speaker=unknown"
msgid "その覚悟がないものに、蒼崎青子を批難する事は許されない。"
msgstr ""

#. Occurrence B_7:4374:16290: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0042; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4374
msgctxt "text_id=16290 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_7:4380:16291: scene=B_7
#: B_7:4380
msgctxt "text_id=16291 | speaker=unknown"
msgid "　それでも、もう説得するのは無理だと悟ってしまっても、草十郎は最後の疑問を口にする。"
msgstr ""

#. Occurrence B_7:4385:16292: scene=B_7
#: B_7:4385
msgctxt "text_id=16292 | speaker=unknown"
msgid "　それを聞かないかぎり、自分は、この部屋を出る事さえできない気がして。"
msgstr ""

#. Occurrence B_7:4411:16293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0043; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4411
msgctxt "text_id=16293 | speaker=soujuurou"
msgid "「……分からないな。蒼崎はなんでそこまでするのか、俺には想像もできない。"
msgstr ""

#. Occurrence B_7:4418:16294: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0044; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4418
msgctxt "text_id=16294 | speaker=soujuurou"
msgid "君を縛っているのは義務と強制、どっちなんだろうね」"
msgstr ""

#. Occurrence B_7:4424:16295: scene=B_7
#: B_7:4424
msgctxt "text_id=16295 | speaker=unknown"
msgid "　草十郎の瞳は、どこか悲しい。"
msgstr ""

#. Occurrence B_7:4429:16296: scene=B_7
#: B_7:4429
msgctxt "text_id=16296 | speaker=unknown"
msgid "　それを前にしても、青子は表情を崩さなかった。"
msgstr ""

#. Occurrence B_7:4467:16297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0113; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4467
msgctxt "text_id=16297 | speaker=aoko"
msgid "「らしくなく、難しいこと訊いてくるのね。"
msgstr ""

#. Occurrence B_7:4473:16298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0114; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4473
msgctxt "text_id=16298 | speaker=aoko"
msgid "　いいわ、口にしても仕方のない事だけど答えてあげる」"
msgstr ""

#. Occurrence B_7:4506:16299: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0115; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4506
msgctxt "text_id=16299 | speaker=aoko"
msgid "「その二つはね、常に私を圧迫してるものだと思う。"
msgstr ""

#. Occurrence B_7:4512:16300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0116; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4512
msgctxt "text_id=16300 | speaker=aoko"
msgid "　けど、勘違いはしないで。義務も強制も、誇りも<畏|おそ>れも、<他人|まわり>から与えられた物じゃない。"
msgstr ""

#. Occurrence B_7:4518:16301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0117; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4518
msgctxt "text_id=16301 | speaker=aoko"
msgid "　橙子と戦うのを止めたところで祖父は私を<叱|しか>らないだろうし、有珠も文句は言わないでしょう。"
msgstr ""

#. Occurrence B_7:4524:16302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0118; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4524
msgctxt "text_id=16302 | speaker=aoko"
msgid "　ここで逃げても、それはそれで誰にとってもどうでもいい話になって終わるだけ。だから他人は関係ない。"
msgstr ""

#. Occurrence B_7:4530:16303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0119; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4530
msgctxt "text_id=16303 | speaker=aoko"
msgid "　ホントに意味なんてないのよ、何にだって」"
msgstr ""

#. Occurrence B_7:4551:16304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0120; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4551
msgctxt "text_id=16304 | speaker=aoko"
msgid "「でも私は橙子から逃げたりしない。"
msgstr ""

#. Occurrence B_7:4557:16305: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0121; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4557
msgctxt "text_id=16305 | speaker=aoko"
msgid "　これはただの、ここにいるっていう存在証明なの。"
msgstr ""

#. Occurrence B_7:4563:16306: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0122; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4563
msgctxt "text_id=16306 | speaker=aoko"
msgid "　私は単に、意味がないからこそ、できる事はぜんぶやるって決めただけなんだから」"
msgstr ""

#. Occurrence B_7:4601:16307: scene=B_7
#: B_7:4601
msgctxt "text_id=16307 | speaker=unknown"
msgid "　火のような激しさで、蒼崎青子はそう言い切った。"
msgstr ""

#. Occurrence B_7:4622:16308: scene=B_7
#: B_7:4622
msgctxt "text_id=16308 | speaker=unknown"
msgid "　―――胸にあるのは、<棘|とげ>のような反発だけ。"
msgstr ""

#. Occurrence B_7:4627:16309: scene=B_7
#: B_7:4627
msgctxt "text_id=16309 | speaker=unknown"
msgid "　なぜ青子の言葉が苛立たしいのか、草十郎には分からない。"
msgstr ""

#. Occurrence B_7:4663:16310: scene=B_7
#: B_7:4663
msgctxt "text_id=16310 | speaker=unknown"
msgid "　……ただ、同時に。"
msgstr ""

#. Occurrence B_7:4668:16311: scene=B_7
#: B_7:4668
msgctxt "text_id=16311 | speaker=unknown"
msgid "　そこまで自分を律する彼女だからこそ、自分は目を奪われたのだと思い知った。"
msgstr ""

#. Occurrence B_7:4674:16312: scene=B_7
#: B_7:4674
msgctxt "text_id=16312 | speaker=unknown"
msgid "　意味がないと言いながらも。"
msgstr ""

#. Occurrence B_7:4679:16313: scene=B_7
#: B_7:4679
msgctxt "text_id=16313 | speaker=unknown"
msgid "　その何もかもをに、意味を持たせようとする<頑|かたく>なさに。"
msgstr ""

#. Occurrence B_7:4700:16314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0045; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4700
msgctxt "text_id=16314 | speaker=soujuurou"
msgid "「……じゃあ、それが、たとえ」"
msgstr ""

#. Occurrence B_7:4715:16315: scene=B_7
#: B_7:4715
msgctxt "text_id=16315 | speaker=unknown"
msgid "　知らず、草十郎は問いかけていた。"
msgstr ""

#. Occurrence B_7:4720:16316: scene=B_7
#: B_7:4720
msgctxt "text_id=16316 | speaker=unknown"
msgid "　青子の考えを改めさせる為か、それとも、彼自身がその答えを聞きたかったからか。"
msgstr ""

#. Occurrence B_7:4727:16317: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0046; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4727
msgctxt "text_id=16317 | speaker=soujuurou"
msgid "「たとえ、他の誰も、見ていなかったとしても？」"
msgstr ""

#. Occurrence B_7:4747:16318: scene=B_7
#: B_7:4747
msgctxt "text_id=16318 | speaker=unknown"
msgid "　呟くような一言。"
msgstr ""

#. Occurrence B_7:4752:16319: scene=B_7
#: B_7:4752
msgctxt "text_id=16319 | speaker=unknown"
msgid "　……そう。誰も見ていないのなら、逃げた事は分からない。"
msgstr ""

#. Occurrence B_7:4757:16320: scene=B_7
#: B_7:4757
msgctxt "text_id=16320 | speaker=unknown"
msgid "　今の青子はそういう状況だ。それでも、彼女はあっさりと否定した。"
msgstr ""

#. Occurrence B_7:4791:16321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0123; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4791
msgctxt "text_id=16321 | speaker=aoko"
msgid "「あら、見てるわよ。少なくとも私自身がね」"
msgstr ""

#. Occurrence B_7:4810:16322: scene=B_7
#: B_7:4810
msgctxt "text_id=16322 | speaker=unknown"
msgid "　あんまりに当たり前の事を言わせたからか、青子の表情は不意をつかれたような、どこか明るいものになっていた。"
msgstr ""

#. Occurrence B_7:4815:16323: scene=B_7
#: B_7:4815
msgctxt "text_id=16323 | speaker=unknown"
msgid "　目を見張る草十郎と真逆に、青子はつまらなそうに返答する。"
msgstr ""

#. Occurrence B_7:4850:16324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0124; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4850
msgctxt "text_id=16324 | speaker=aoko"
msgid "「知らないの草十郎？"
msgstr ""

#. Occurrence B_7:4856:16325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0125; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4856
msgctxt "text_id=16325 | speaker=aoko"
msgid "　生きてく上で一番の観客っていうのはね、他ならぬ自分自身なのよ。だから人生っていうのは油断ならないんじゃない」"
msgstr ""

#. Occurrence B_7:4888:16326: scene=B_7
#: B_7:4888
msgctxt "text_id=16326 | speaker=unknown"
msgid "　呆れて語る青子に、草十郎は何も返さずに立ち上がった。"
msgstr ""

#. Occurrence B_7:4893:16327: scene=B_7
#: B_7:4893
msgctxt "text_id=16327 | speaker=unknown"
msgid "　その姿は敗北者じみた<翳|かげ>があって、実に彼らしくない。"
msgstr ""

#. Occurrence B_7:4914:16328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0126; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4914
msgctxt "text_id=16328 | speaker=aoko"
msgid "「草十郎？」"
msgstr ""

#. Occurrence B_7:4933:16329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0047; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4933
msgctxt "text_id=16329 | speaker=soujuurou"
msgid "「……すまない。君が素晴らしいことを言っているのは解るんだ。"
msgstr ""

#. Occurrence B_7:4940:16330: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0048; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4940
msgctxt "text_id=16330 | speaker=soujuurou"
msgid "けど、俺には分からない」"
msgstr ""

#. Occurrence B_7:4973:16331: scene=B_7
#: B_7:4973
msgctxt "text_id=16331 | speaker=unknown"
msgid "　足音も弱く歩いていく。"
msgstr ""

#. Occurrence B_7:4978:16332: scene=B_7
#: B_7:4978
msgctxt "text_id=16332 | speaker=unknown"
msgid "　草十郎は廊下に通じるドアに手を置いて立ち止まった。"
msgstr ""

#. Occurrence B_7:4983:16333: scene=B_7
#: B_7:4983
msgctxt "text_id=16333 | speaker=unknown"
msgid "　ほんの数秒の、何度も発言を<躊躇|ためら>わせた、短い葛藤。"
msgstr ""

#. Occurrence B_7:5004:16334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0049; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:5004
msgctxt "text_id=16334 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_7:5012:16335: scene=B_7
#: B_7:5012
msgctxt "text_id=16335 | speaker=unknown"
msgid "　結局、青子にかける言葉を口にできず、草十郎はドアを開けた。"
msgstr ""

#. Occurrence B_7:5037:16336: scene=B_7
#: B_7:5037
msgctxt "text_id=16336 | speaker=unknown"
msgid "　ドアは無機質な音をたてて開き、来訪者は部屋を後にする。"
msgstr ""

#. Occurrence B_7:5048:16337: scene=B_7
#: B_7:5048
msgctxt "text_id=16337 | speaker=unknown"
msgid "　彼の背中を無言で見送った後、青子はちらりと窓に視線を投げた。"
msgstr ""

#. Occurrence B_7:5053:16338: scene=B_7
#: B_7:5053
msgctxt "text_id=16338 | speaker=unknown"
msgid "　じき夕暮れ。"
msgstr ""

#. Occurrence B_7:5058:16339: scene=B_7
#: B_7:5058
msgctxt "text_id=16339 | speaker=unknown"
msgid "　外の町並みには、もう薄い闇がかかろうとしていた。"
msgstr ""

#. Occurrence B_8:50:16340: scene=B_8
#: B_8:50
msgctxt "text_id=16340 | speaker=unknown"
msgid "　夜になって、礼拝堂には草十郎だけが残された。"
msgstr ""

#. Occurrence B_8:56:16341: scene=B_8
#: B_8:56
msgctxt "text_id=16341 | speaker=unknown"
msgid "　少年はひとり、長椅子の端に座っている。"
msgstr ""

#. Occurrence B_8:61:16342: scene=B_8
#: B_8:61
msgctxt "text_id=16342 | speaker=unknown"
msgid "　懺悔する者のように、かたちのない無力感を持て余している。"
msgstr ""

#. Occurrence B_8:83:16343: scene=B_8
#: B_8:83
msgctxt "text_id=16343 | speaker=unknown"
msgid "　寒気の<蔦|つた>が壁を伝う。"
msgstr ""

#. Occurrence B_8:88:16344: scene=B_8
#: B_8:88
msgctxt "text_id=16344 | speaker=unknown"
msgid "　暖の無い礼拝堂では、はき出される呼吸は魂のように白い。"
msgstr ""

#. Occurrence B_8:93:16345: scene=B_8
#: B_8:93
msgctxt "text_id=16345 | speaker=unknown"
msgid "　冷気は容赦なく体から熱を奪っていく。"
msgstr ""

#. Occurrence B_8:98:16346: scene=B_8
#: B_8:98
msgctxt "text_id=16346 | speaker=unknown"
msgid "　礼拝堂の高い天井が、広い講堂が、冬の寒さを一層増しているようにしか、草十郎には思えなかった。"
msgstr ""

#. Occurrence B_8:131:16347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0000; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:131
msgctxt "text_id=16347 | speaker=soujuurou"
msgid "「………………………………」"
msgstr ""

#. Occurrence B_8:137:16348: scene=B_8
#: B_8:137
msgctxt "text_id=16348 | speaker=unknown"
msgid "　やり場のない感情を持て余して、彼は力なく天井を見つめている。"
msgstr ""

#. Occurrence B_8:142:16349: scene=B_8
#: B_8:142
msgctxt "text_id=16349 | speaker=unknown"
msgid "　思考はまったく定まらない。"
msgstr ""

#. Occurrence B_8:147:16350: scene=B_8
#: B_8:147
msgctxt "text_id=16350 | speaker=unknown"
msgid "　胸のざわつきが何であるのか、まずそれが分からない。"
msgstr ""

#. Occurrence B_8:171:16351: scene=B_8
#: B_8:171
msgctxt "text_id=16351 | speaker=unknown"
msgid "　答えのないまま時間だけが過ぎていく。"
msgstr ""

#. Occurrence B_8:176:16352: scene=B_8
#: B_8:176
msgctxt "text_id=16352 | speaker=unknown"
msgid "　その様は何かを思案しているようにも取れるし、眠っているようにも取れる。放っておけば石にでも成りかねない、見るも無惨な意気消沈。"
msgstr ""

#. Occurrence B_8:181:16353: scene=B_8
#: B_8:181
msgctxt "text_id=16353 | speaker=unknown"
msgid "　問題は、それを彼自身、まったく自覚していない事だ。"
msgstr ""

#. Occurrence B_8:202:16354: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0000; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:202
msgctxt "text_id=16354 | speaker=eiri"
msgid "「おや。夜間の礼拝とは感心です」"
msgstr ""

#. Occurrence B_8:242:16355: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0001; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:242
msgctxt "text_id=16355 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_8:247:16356: scene=B_8
#: B_8:247
msgctxt "text_id=16356 | speaker=unknown"
msgid "　突然の声に顔をあげる。"
msgstr ""

#. Occurrence B_8:252:16357: scene=B_8
#: B_8:252
msgctxt "text_id=16357 | speaker=unknown"
msgid "　……いつからそこにいたのか、祭壇の前には昨夜見た神父服の男が立っていた。"
msgstr ""

#. Occurrence B_8:277:16358: scene=B_8
#: B_8:277
msgctxt "text_id=16358 | speaker=unknown"
msgid "　乾いた音が礼拝堂に<木霊|こだま>する。"
msgstr ""

#. Occurrence B_8:282:16359: scene=B_8
#: B_8:282
msgctxt "text_id=16359 | speaker=unknown"
msgid "　いまさら立ち去るのも、そもそも立ち上がる気力もない草十郎は、歩み寄る影を見届けるしかない。"
msgstr ""

#. Occurrence B_8:303:16360: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0001; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:303
msgctxt "text_id=16360 | speaker=eiri"
msgid "「もっとも、この教会に聖霊なんていませんけどね。"
msgstr ""

#. Occurrence B_8:309:16361: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0002; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:309
msgctxt "text_id=16361 | speaker=eiri"
msgid "　ここ、座りますがよろしいですか？」"
msgstr ""

#. Occurrence B_8:327:16362: scene=B_8
#: B_8:327
msgctxt "text_id=16362 | speaker=unknown"
msgid "　神父は草十郎と同じ長椅子を指さした。"
msgstr ""

#. Occurrence B_8:332:16363: scene=B_8
#: B_8:332
msgctxt "text_id=16363 | speaker=unknown"
msgid "　草十郎とは逆位置の<端|はじ>っこに、返事を待たず腰をかける。"
msgstr ""

#. Occurrence B_8:371:16364: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0003; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:371
msgctxt "text_id=16364 | speaker=eiri"
msgid "「改めて挨拶を。私は<文柄|ふみづか><詠梨|えいり>、この教会の……なんなんでしょうかね、書類の上では持ち主になるんでしょうか。詠梨神父と呼んでください。"
msgstr ""

#. Occurrence B_8:382:16365: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0004; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:382
msgctxt "text_id=16365 | speaker=eiri"
msgid "　貴方は静希草十郎君ですか。なるほど、たしかに唯架には見えない」"
msgstr ""

#. Occurrence B_8:402:16366: scene=B_8
#: B_8:402
msgctxt "text_id=16366 | speaker=unknown"
msgid "　穏やかな口調だが、神父の声には白々しいほど感情がこもっていない。"
msgstr ""

#. Occurrence B_8:407:16367: scene=B_8
#: B_8:407
msgctxt "text_id=16367 | speaker=unknown"
msgid "　徹底した利<己主義|エゴイスト>者。"
msgstr ""

#. Occurrence B_8:434:16368: scene=B_8
#: B_8:434
msgctxt "text_id=16368 | speaker=unknown"
msgid "　こういう声をする人間を、草十郎はよく知っている。"
msgstr ""

#. Occurrence B_8:439:16369: scene=B_8
#: B_8:439
msgctxt "text_id=16369 | speaker=unknown"
msgid "　山から下りる際、彼の世話をしてくれた恩人がこういった<感|こ><情|え>をだす人物だった。"
msgstr ""

#. Occurrence B_8:460:16370: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0002; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:460
msgctxt "text_id=16370 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence B_8:465:16371: scene=B_8
#: B_8:465
msgctxt "text_id=16371 | speaker=unknown"
msgid "　座ったまま、草十郎は無関心に神父を一瞥する。"
msgstr ""

#. Occurrence B_8:470:16372: scene=B_8
#: B_8:470
msgctxt "text_id=16372 | speaker=unknown"
msgid "　心ここにあらず、といった状態だが、詠梨は気にしていないようだ。"
msgstr ""

#. Occurrence B_8:514:16373: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0005; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:514
msgctxt "text_id=16373 | speaker=eiri"
msgid "「少し君と話がしたいのですが、よろしいでしょうか？」"
msgstr ""

#. Occurrence B_8:519:16374: scene=B_8
#: B_8:519
msgctxt "text_id=16374 | speaker=unknown"
msgid "　草十郎はうなずきで答えた。"
msgstr ""

#. Occurrence B_8:524:16375: scene=B_8
#: B_8:524
msgctxt "text_id=16375 | speaker=unknown"
msgid "　それは良かった、と作り物めいた笑みの神父。"
msgstr ""

#. Occurrence B_8:545:16376: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0006; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:545
msgctxt "text_id=16376 | speaker=eiri"
msgid "「青子が心配のようですね」"
msgstr ""

#. Occurrence B_8:551:16377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0003; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:551
msgctxt "text_id=16377 | speaker=soujuurou"
msgid "「別に。律架さんにもそう聞かれましたけど、蒼崎の心配はしていないんです」"
msgstr ""

#. Occurrence B_8:557:16378: scene=B_8
#: B_8:557
msgctxt "text_id=16378 | speaker=unknown"
msgid "　神父を見ずに、前を向いたまま草十郎は返す。"
msgstr ""

#. Occurrence B_8:562:16379: scene=B_8
#: B_8:562
msgctxt "text_id=16379 | speaker=unknown"
msgid "　迷いに満ちた、彼らしからぬ弱々しい声で。"
msgstr ""

#. Occurrence B_8:608:16380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0004; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:608
msgctxt "text_id=16380 | speaker=soujuurou"
msgid "「けど、今はずっと彼女の事が気にかかっている。それが何だか分からなくて、さっきから考えてる最中です」"
msgstr ""

#. Occurrence B_8:630:16381: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0007; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:630
msgctxt "text_id=16381 | speaker=eiri"
msgid "「簡単ですよ。君は単に、青子に嫉妬しているのです」"
msgstr ""

#. Occurrence B_8:656:16382: scene=B_8
#: B_8:656
msgctxt "text_id=16382 | speaker=unknown"
msgid "　あれだけ元気のなかった少年の顔が、その一言で蘇った。"
msgstr ""

#. Occurrence B_8:661:16383: scene=B_8
#: B_8:661
msgctxt "text_id=16383 | speaker=unknown"
msgid "　草十郎は水を得た魚のように、ぽん、と両手を打って神父に顔を向ける。"
msgstr ""

#. Occurrence B_8:689:16384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0005; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:689
msgctxt "text_id=16384 | speaker=soujuurou"
msgid "「そっか。俺はたんに、蒼崎が<羨|うらや>ましかっただけなんだ。"
msgstr ""

#. Occurrence B_8:702:16385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0006; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:702
msgctxt "text_id=16385 | speaker=soujuurou"
msgid "　―――いや、でも、それは困るな。"
msgstr ""

#. Occurrence B_8:709:16386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0007; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:709
msgctxt "text_id=16386 | speaker=soujuurou"
msgid "自分の中に、そういうところがあるなんて、気づきもしなかった」"
msgstr ""

#. Occurrence B_8:715:16387: scene=B_8
#: B_8:715
msgctxt "text_id=16387 | speaker=unknown"
msgid "　懺悔のような呟きに、神父は何も返さない。"
msgstr ""

#. Occurrence B_8:743:16388: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0008; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:743
msgctxt "text_id=16388 | speaker=soujuurou"
msgid "「それで、話っていうのはなんですか？」"
msgstr ""

#. Occurrence B_8:773:16389: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0008; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:773
msgctxt "text_id=16389 | speaker=eiri"
msgid "「いえ、話というより質問です。"
msgstr ""

#. Occurrence B_8:779:16390: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0009; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:779
msgctxt "text_id=16390 | speaker=eiri"
msgid "　君は今まで山奥に住んでいたと聞きました。そこで一つ、どうしても気になる事があって」"
msgstr ""

#. Occurrence B_8:785:16391: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0009; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:785
msgctxt "text_id=16391 | speaker=soujuurou"
msgid "「気になる事、ですか？」"
msgstr ""

#. Occurrence B_8:806:16392: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0010; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:806
msgctxt "text_id=16392 | speaker=eiri"
msgid "「はい。おそらく、今まで誰も貴方にこの手の質問をしなかったのでしょう。"
msgstr ""

#. Occurrence B_8:813:16393: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0011; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:813
msgctxt "text_id=16393 | speaker=eiri"
msgid "それは貴方が、他人にその手の不安を感じさせないからです。実際私もそう思いますし。"
msgstr ""

#. Occurrence B_8:825:16394: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0012; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:825
msgctxt "text_id=16394 | speaker=eiri"
msgid "　ですから、まあ。これも縁ですし、私も肩書きが<神父|コレ>ですしねぇ。迷える子羊がいるんですから、それなりの<勤|つと>めをはたさないと後ろめたいというか」"
msgstr ""

#. Occurrence B_8:864:16395: scene=B_8
#: B_8:864
msgctxt "text_id=16395 | speaker=unknown"
msgid "　そうして、神父は穏やかな瞳を草十郎へ向けた。"
msgstr ""

#. Occurrence B_8:869:16396: scene=B_8
#: B_8:869
msgctxt "text_id=16396 | speaker=unknown"
msgid "　容赦なく暗い、罪を<暴|あば>くような瞳を。"
msgstr ""

#. Occurrence B_8:907:16397: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0010; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:907
msgctxt "text_id=16397 | speaker=soujuurou"
msgid "「おかしなコトが気になるんですね。"
msgstr ""

#. Occurrence B_8:913:16398: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0011; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:913
msgctxt "text_id=16398 | speaker=soujuurou"
msgid "　……その、質問というのは？」"
msgstr ""

#. Occurrence B_8:934:16399: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0013; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:934
msgctxt "text_id=16399 | speaker=eiri"
msgid "「いえ、ごく自然の疑問ですよ。"
msgstr ""

#. Occurrence B_8:940:16400: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0014; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:940
msgctxt "text_id=16400 | speaker=eiri"
msgid "　貴方はなぜ山から下りてきたのか。そこでなら君は幸福だったでしょうに」"
msgstr ""

#. Occurrence B_8:967:16401: scene=B_8
#: B_8:967
msgctxt "text_id=16401 | speaker=unknown"
msgid "　罪状こそ確かではないが、それは確かに告発だった。"
msgstr ""

#. Occurrence B_8:972:16402: scene=B_8
#: B_8:972
msgctxt "text_id=16402 | speaker=unknown"
msgid "　遅すぎたといえば遅すぎ、当然と言えば当然の質問。"
msgstr ""

#. Occurrence B_8:993:16403: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0012; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:993
msgctxt "text_id=16403 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence B_8:998:16404: scene=B_8
#: B_8:998
msgctxt "text_id=16404 | speaker=unknown"
msgid "　草十郎に返答はない。"
msgstr ""

#. Occurrence B_8:1003:16405: scene=B_8
#: B_8:1003
msgctxt "text_id=16405 | speaker=unknown"
msgid "　苦虫をかみつぶす少年を無視して神父は続ける。"
msgstr ""

#. Occurrence B_8:1025:16406: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0015; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1025
msgctxt "text_id=16406 | speaker=eiri"
msgid "「山での生活がいかに厳しいものかは、私も人並みには知っています。若い頃、ちょっとした手違いで遭難した事もありますしね。"
msgstr ""

#. Occurrence B_8:1031:16407: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0016; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1031
msgctxt "text_id=16407 | speaker=eiri"
msgid "　山での生活はこの上なく簡素です。なにしろ生きること以外に時間をさく余裕がない。愉しむ為に生きるのではなく、生きる為にただ生きる。生活は必要最小限を、さらに切り詰めたものとなっていく」"
msgstr ""

#. Occurrence B_8:1069:16408: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0017; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1069
msgctxt "text_id=16408 | speaker=eiri"
msgid "「山での生活に比べれば、都市の在り方は楽園以外の何物でもないでしょう。"
msgstr ""

#. Occurrence B_8:1075:16409: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0018; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1075
msgctxt "text_id=16409 | speaker=eiri"
msgid "　ですが。楽園の定義は、人それぞれです」"
msgstr ""

#. Occurrence B_8:1081:16410: scene=B_8
#: B_8:1081
msgctxt "text_id=16410 | speaker=unknown"
msgid "　草十郎は答えない。表情も何も語らない。"
msgstr ""

#. Occurrence B_8:1086:16411: scene=B_8
#: B_8:1086
msgctxt "text_id=16411 | speaker=unknown"
msgid "　ただ、神父の声だけが礼拝堂に<木霊|こだま>する。"
msgstr ""

#. Occurrence B_8:1119:16412: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0019; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1119
msgctxt "text_id=16412 | speaker=eiri"
msgid "「一粒の種の誕生すら喜びになる生活。"
msgstr ""

#. Occurrence B_8:1125:16413: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0020; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1125
msgctxt "text_id=16413 | speaker=eiri"
msgid "　電気の明かりがどれだけ暖かでも、自然のままの厳しい寒さを君は<尊|とうと>んでいた筈です。"
msgstr ""

#. Occurrence B_8:1146:16414: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0021; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1146
msgctxt "text_id=16414 | speaker=eiri"
msgid "　なのになぜ、下りてきたのですか。山にいれば、君は<倖|しあわ>せだったでしょうに」"
msgstr ""

#. Occurrence B_8:1166:16415: scene=B_8
#: B_8:1166
msgctxt "text_id=16415 | speaker=unknown"
msgid "　神父の問いが、もう一度繰り返される。"
msgstr ""

#. Occurrence B_8:1171:16416: scene=B_8
#: B_8:1171
msgctxt "text_id=16416 | speaker=unknown"
msgid "　草十郎は堅く口を閉ざしている。"
msgstr ""

#. Occurrence B_8:1181:16417: scene=B_8
#: B_8:1181
msgctxt "text_id=16417 | speaker=unknown"
msgid "　それは答えたくないのではなく、彼自身、どうしてそうなったのか未だ分からないからだ。"
msgstr ""

#. Occurrence B_8:1204:16418: scene=B_8
#: B_8:1204
msgctxt "text_id=16418 | speaker=unknown"
msgid "　……確かな事は、帰りたくとも、もう帰ってはいけないという事実だけ。"
msgstr ""

#. Occurrence B_8:1225:16419: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0022; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1225
msgctxt "text_id=16419 | speaker=eiri"
msgid "「困ったものです。そこをはっきりさせない事には、いつまでも救いがない。"
msgstr ""

#. Occurrence B_8:1243:16420: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0023; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1243
msgctxt "text_id=16420 | speaker=eiri"
msgid "　故郷を捨てた理由も分からないのに、旅先の土地を愛するコトなんて、まっとうな人間にはできませんよ。"
msgstr ""

#. Occurrence B_8:1249:16421: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0024; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1249
msgctxt "text_id=16421 | speaker=eiri"
msgid "　これは忠告ですが。すべてを無条件に肯定したところで、幸福になれるとはかぎりません。"
msgstr ""

#. Occurrence B_8:1255:16422: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0025; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1255
msgctxt "text_id=16422 | speaker=eiri"
msgid "　貴方はもう少し、自分の心を許してあげないと」"
msgstr ""

#. Occurrence B_8:1296:16423: scene=B_8
#: B_8:1296
msgctxt "text_id=16423 | speaker=unknown"
msgid "　草十郎には、神父の言葉はまったく理解できない。"
msgstr ""

#. Occurrence B_8:1301:16424: scene=B_8
#: B_8:1301
msgctxt "text_id=16424 | speaker=unknown"
msgid "　ただ、最後の言葉だけは印象的だった。"
msgstr ""

#. Occurrence B_8:1333:16425: scene=B_8
#: B_8:1333
msgctxt "text_id=16425 | speaker=unknown"
msgid "　自分の心を許せ、と言うけど。"
msgstr ""

#. Occurrence B_8:1339:16426: scene=B_8
#: B_8:1339
msgctxt "text_id=16426 | speaker=unknown"
msgid "　彼には、その心のカタチがよく分からない。"
msgstr ""

#. Occurrence B_8:1368:16427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0013; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1368
msgctxt "text_id=16427 | speaker=soujuurou"
msgid "「ああ、そう言えば―――」"
msgstr ""

#. Occurrence B_8:1374:16428: scene=B_8
#: B_8:1374
msgctxt "text_id=16428 | speaker=unknown"
msgid "　同じような事を、蒼崎橙子も口にしていた。"
msgstr ""

#. Occurrence B_8:1379:16429: scene=B_8
#: B_8:1379
msgctxt "text_id=16429 | speaker=unknown"
msgid "　橙子といい、この神父といい、口にしてもいない事をよく言い当てられるものだな、と草十郎は感心する。"
msgstr ""

#. Occurrence B_8:1425:16430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0014; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1425
msgctxt "text_id=16430 | speaker=soujuurou"
msgid "「……すごいですね。神父さんっていうのは、みんなそうなんですか」"
msgstr ""

#. Occurrence B_8:1431:16431: scene=B_8
#: B_8:1431
msgctxt "text_id=16431 | speaker=unknown"
msgid "　さっきまでの暗さはどこへいったのか、不思議そうに草十郎は言った。"
msgstr ""

#. Occurrence B_8:1436:16432: scene=B_8
#: B_8:1436
msgctxt "text_id=16432 | speaker=unknown"
msgid "　心の傷が表に<顕|あらわ>れない、ある意味、鉄の心臓がこの少年の特徴である。"
msgstr ""

#. Occurrence B_8:1473:16433: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0026; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1473
msgctxt "text_id=16433 | speaker=eiri"
msgid "「ええ。神父は悩みを<暴|あば>くのが仕事ですから。"
msgstr ""

#. Occurrence B_8:1480:16434: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0027; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1480
msgctxt "text_id=16434 | speaker=eiri"
msgid "ま、たいていは暴くだけで埋めるのに失敗するんですけどね」"
msgstr ""

#. Occurrence B_8:1501:16435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0015; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1501
msgctxt "text_id=16435 | speaker=soujuurou"
msgid "「……。悩みを暴くって、つまり相談事ですか？」"
msgstr ""

#. Occurrence B_8:1520:16436: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0028; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1520
msgctxt "text_id=16436 | speaker=eiri"
msgid "「そういうソフトなのも<承|うけたまわ>っています。私が解決できる悩みなど、タカが知れているようですけど」"
msgstr ""

#. Occurrence B_8:1546:16437: scene=B_8
#: B_8:1546
msgctxt "text_id=16437 | speaker=unknown"
msgid "　神父は困ったように肩をすくめる。"
msgstr ""

#. Occurrence B_8:1551:16438: scene=B_8
#: B_8:1551
msgctxt "text_id=16438 | speaker=unknown"
msgid "　信用できないコトこの上ないが、今の草十郎には誰であろうと後光が差して見えるのだった。"
msgstr ""

#. Occurrence B_8:1586:16439: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0016; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1586
msgctxt "text_id=16439 | speaker=soujuurou"
msgid "「あの。じゃあ、タカが知れた程度の悩みを聞いてもらえますか」"
msgstr ""

#. Occurrence B_8:1605:16440: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0029; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1605
msgctxt "text_id=16440 | speaker=eiri"
msgid "「君が青子をなぜ<羨|うらや>むか、ですね」"
msgstr ""

#. Occurrence B_8:1611:16441: scene=B_8
#: B_8:1611
msgctxt "text_id=16441 | speaker=unknown"
msgid "　人の心でも読めるのか、神父は穏やかな眼差しのまま草十郎の台詞を先読みする。"
msgstr ""

#. Occurrence B_8:1652:16442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0017; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1652
msgctxt "text_id=16442 | speaker=soujuurou"
msgid "「えっと……まあ、そういう事です。"
msgstr ""

#. Occurrence B_8:1659:16443: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0018_0; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1659
msgctxt "text_id=16443 | speaker=soujuurou"
msgid "　自分でも、どうしてそう思うのかが分からない。"
msgstr ""

#. Occurrence B_8:1672:16444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0018_1; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1672
msgctxt "text_id=16444 | speaker=soujuurou"
msgid "でも貴方なら、それを知ってそうだ」"
msgstr ""

#. Occurrence B_8:1709:16445: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0030; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1709
msgctxt "text_id=16445 | speaker=eiri"
msgid "「知りませんけど、まあ、無責任に答えましょうか。"
msgstr ""

#. Occurrence B_8:1715:16446: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0031; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1715
msgctxt "text_id=16446 | speaker=eiri"
msgid "　それはおそらく、貴方には根拠がないからですよ。"
msgstr ""

#. Occurrence B_8:1722:16447: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0032; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1722
msgctxt "text_id=16447 | speaker=eiri"
msgid "自分の色がない、と喩えた方が正確ですが」"
msgstr ""

#. Occurrence B_8:1742:16448: scene=B_8
#: B_8:1742
msgctxt "text_id=16448 | speaker=unknown"
msgid "　すっぱりと答える詠梨神父に、草十郎は難解そうに目を細めた。色がない、とはどういう意味なのだろう、と。"
msgstr ""

#. Occurrence B_8:1768:16449: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0033; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1768
msgctxt "text_id=16449 | speaker=eiri"
msgid "「ほら、そこです。君に<勝|すぐ>れた部分があるとしたら、その順応性です。"
msgstr ""

#. Occurrence B_8:1774:16450: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0034; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1774
msgctxt "text_id=16450 | speaker=eiri"
msgid "　山という異界から町に下りて、一人で暮らしていけた事。"
msgstr ""

#. Occurrence B_8:1780:16451: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0035; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1780
msgctxt "text_id=16451 | speaker=eiri"
msgid "　ようやく慣れた常識の中で、青子たちという非常識と関わっても暮らしていけた事。"
msgstr ""

#. Occurrence B_8:1787:16452: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0036; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1787
msgctxt "text_id=16452 | speaker=eiri"
msgid "……そうであれと努めているにしても、貴方の順応性は<際|きわ>だっている。"
msgstr ""

#. Occurrence B_8:1793:16453: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0037; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1793
msgctxt "text_id=16453 | speaker=eiri"
msgid "　原因は知りませんが、君には初めから、自我というものが第一に表れてはいないのです」"
msgstr ""

#. Occurrence B_8:1819:16454: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0038; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1819
msgctxt "text_id=16454 | speaker=eiri"
msgid "「何事にも対応できるものの、<朱|しゅ>に<交|まじ>わるほど器用でもない。"
msgstr ""

#. Occurrence B_8:1825:16455: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0039; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1825
msgctxt "text_id=16455 | speaker=eiri"
msgid "　しいて言うのなら、色の乗っていない空白ですかね。"
msgstr ""

#. Occurrence B_8:1831:16456: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0040; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1831
msgctxt "text_id=16456 | speaker=eiri"
msgid "　風景に溶けこむ自然さは素晴らしい人徳ですが、自我がないという事は、居場所がないという事ですから。"
msgstr ""

#. Occurrence B_8:1837:16457: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0041; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1837
msgctxt "text_id=16457 | speaker=eiri"
msgid "　いいコトばかりじゃありません」"
msgstr ""

#. Occurrence B_8:1879:16458: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0042; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1879
msgctxt "text_id=16458 | speaker=eiri"
msgid "「唯架にまで見えない、というのは予想以上でしたが。"
msgstr ""

#. Occurrence B_8:1885:16459: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0043; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1885
msgctxt "text_id=16459 | speaker=eiri"
msgid "　姿なき精霊すら捉えるアレが見えなかったのですから、君の無欲ぶりも筋金入りだ」"
msgstr ""

#. Occurrence B_8:1932:16460: scene=B_8
#: B_8:1932
msgctxt "text_id=16460 | speaker=unknown"
msgid "　なにが嬉しいのか、微笑みながら神父はそう告げた。"
msgstr ""

#. Occurrence B_8:1937:16461: scene=B_8
#: B_8:1937
msgctxt "text_id=16461 | speaker=unknown"
msgid "　草十郎には彼の言いたい事も、その笑顔の意味もさっぱり分からない。"
msgstr ""

#. Occurrence B_8:1986:16462: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0044; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1986
msgctxt "text_id=16462 | speaker=eiri"
msgid "「憶測にすぎませんが、青子は貴方を見て反感を覚えたと思いますよ。"
msgstr ""

#. Occurrence B_8:1992:16463: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0045; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1992
msgctxt "text_id=16463 | speaker=eiri"
msgid "　自分のない貴方は、自己を押し通してきた彼女にとって認めがたいものだったでしょうから。"
msgstr ""

#. Occurrence B_8:1998:16464: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0046; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1998
msgctxt "text_id=16464 | speaker=eiri"
msgid "　そして同時に、貴方は青子に、自分ではどうしても手に入れられないものを見てしまった」"
msgstr ""

#. Occurrence B_8:2037:16465: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0047; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2037
msgctxt "text_id=16465 | speaker=eiri"
msgid "「言葉にすると下らない表現になりますが、そういう事です。"
msgstr ""

#. Occurrence B_8:2043:16466: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0048; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2043
msgctxt "text_id=16466 | speaker=eiri"
msgid "　先程は嫉妬と言いましたが、それは訂正しましょう。"
msgstr ""

#. Occurrence B_8:2049:16467: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0049; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2049
msgctxt "text_id=16467 | speaker=eiri"
msgid "　君は青子に―――いや、いいです。"
msgstr ""

#. Occurrence B_8:2056:16468: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0050; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2056
msgctxt "text_id=16468 | speaker=eiri"
msgid "言葉にするのは、それこそ<野|や><暮|ぼ>だ」"
msgstr ""

#. Occurrence B_8:2088:16469: scene=B_8
#: B_8:2088
msgctxt "text_id=16469 | speaker=unknown"
msgid "　柔らかに神父は笑った。"
msgstr ""

#. Occurrence B_8:2093:16470: scene=B_8
#: B_8:2093
msgctxt "text_id=16470 | speaker=unknown"
msgid "　それは詠梨本来の年齢を思わせる、若々しい笑みだった。"
msgstr ""

#. Occurrence B_8:2111:16471: scene=B_8
#: B_8:2111
msgctxt "text_id=16471 | speaker=unknown"
msgid "　この人物は青子の事になると<神父然|しんぷぜん>とした姿勢が崩れるようだ。"
msgstr ""

#. Occurrence B_8:2116:16472: scene=B_8
#: B_8:2116
msgctxt "text_id=16472 | speaker=unknown"
msgid "　と、それはともかく。"
msgstr ""

#. Occurrence B_8:2143:16473: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0019; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2143
msgctxt "text_id=16473 | speaker=soujuurou"
msgid "「えっと、神父さん。それで結局、自分は青子のどこらへんに憧れてるんですか？」"
msgstr ""

#. Occurrence B_8:2169:16474: scene=B_8
#: B_8:2169
msgctxt "text_id=16474 | speaker=unknown"
msgid "　要領を得ない詠梨の言葉に、草十郎は真っ正面から聞き返す。"
msgstr ""

#. Occurrence B_8:2174:16475: scene=B_8
#: B_8:2174
msgctxt "text_id=16475 | speaker=unknown"
msgid "　順を追って話していた詠梨だが、この相手には冗長すぎたようだ。"
msgstr ""

#. Occurrence B_8:2212:16476: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0051; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2212
msgctxt "text_id=16476 | speaker=eiri"
msgid "「……今のでも分からない、と。"
msgstr ""

#. Occurrence B_8:2218:16477: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0052; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2218
msgctxt "text_id=16477 | speaker=eiri"
msgid "　まいりましたね。こういう事は言葉を尽くすほど実感が湧かないものですが……ま、私も神父と呼ばれる身です。少し切り口を変えて代弁してみましょう。"
msgstr ""

#. Occurrence B_8:2251:16478: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0053; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2251
msgctxt "text_id=16478 | speaker=eiri"
msgid "　貴方は青子の過去を知っていますか？」"
msgstr ""

#. Occurrence B_8:2308:16479: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0020; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2308
msgctxt "text_id=16479 | speaker=soujuurou"
msgid "「詳しくは知りません。高校デビューとか、おかしな言葉を口にしてましたけど」"
msgstr ""

#. Occurrence B_8:2360:16480: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0054; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2360
msgctxt "text_id=16480 | speaker=eiri"
msgid "「まったく知らないというコトですね。"
msgstr ""

#. Occurrence B_8:2366:16481: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0055; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2366
msgctxt "text_id=16481 | speaker=eiri"
msgid "　いいでしょう。では静希君、益体のないたとえ話ですが。"
msgstr ""

#. Occurrence B_8:2377:16482: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0056; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2377
msgctxt "text_id=16482 | speaker=eiri"
msgid "　君は、突然自殺しろと言われて従えますか？」"
msgstr ""

#. Occurrence B_8:2383:16483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0021; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2383
msgctxt "text_id=16483 | speaker=soujuurou"
msgid "「自殺……ですか？」"
msgstr ""

#. Occurrence B_8:2409:16484: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0057; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2409
msgctxt "text_id=16484 | speaker=eiri"
msgid "「そう、自殺です。神父である私が口にしていい事ではありませんが、ま、私は格好だけなのでいいでしょう。"
msgstr ""

#. Occurrence B_8:2436:16485: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0058; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2436
msgctxt "text_id=16485 | speaker=eiri"
msgid "　青子はね、近いことを求められたのです、十五歳の時に。"
msgstr ""

#. Occurrence B_8:2442:16486: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0059; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2442
msgctxt "text_id=16486 | speaker=eiri"
msgid "　彼女がそれまで積み重ねてきた努力も希望も、過去も未来もすべて捨てること。今日からおまえは違う生き物として生きろ、とね。"
msgstr ""

#. Occurrence B_8:2448:16487: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0060; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2448
msgctxt "text_id=16487 | speaker=eiri"
msgid "　どうです？　それは自己の抹消、未来の死と同じだと思いませんか？」"
msgstr ""

#. Occurrence B_8:2484:16488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0022; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2484
msgctxt "text_id=16488 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence B_8:2490:16489: scene=B_8
#: B_8:2490
msgctxt "text_id=16489 | speaker=unknown"
msgid "　神父の言葉は、たしかに青子が口にした過去と一致する。"
msgstr ""

#. Occurrence B_8:2495:16490: scene=B_8
#: B_8:2495
msgctxt "text_id=16490 | speaker=unknown"
msgid "　蒼崎青子は中学まで、普通の学生として暮らしてきた。"
msgstr ""

#. Occurrence B_8:2500:16491: scene=B_8
#: B_8:2500
msgctxt "text_id=16491 | speaker=unknown"
msgid "　それが突然、姉に代わって家を継ぐ事になってしまった。"
msgstr ""

#. Occurrence B_8:2543:16492: scene=B_8
#: B_8:2543
msgctxt "text_id=16492 | speaker=unknown"
msgid "　魔法使いになる、という事は、今までの生活を捨てる、という事らしい。"
msgstr ""

#. Occurrence B_8:2548:16493: scene=B_8
#: B_8:2548
msgctxt "text_id=16493 | speaker=unknown"
msgid "　青子は知識としてしか受けとめていなかった魔術師の観念を常識にして、今までの努力も展望も捨てて、違う生き方を余儀なくされた。"
msgstr ""

#. Occurrence B_8:2569:16494: scene=B_8
#: B_8:2569
msgctxt "text_id=16494 | speaker=unknown"
msgid "　そして、その生き方は、それまでの青子の常識からすれば、苦痛しかともなわない道だった。"
msgstr ""

#. Occurrence B_8:2596:16495: scene=B_8
#: B_8:2596
msgctxt "text_id=16495 | speaker=unknown"
msgid "　……青子の祖父は、彼女に強制はしなかった。"
msgstr ""

#. Occurrence B_8:2601:16496: scene=B_8
#: B_8:2601
msgctxt "text_id=16496 | speaker=unknown"
msgid "“姉が駄目になったので、次はおまえだ”としか言わなかったらしい。"
msgstr ""

#. Occurrence B_8:2606:16497: scene=B_8
#: B_8:2606
msgctxt "text_id=16497 | speaker=unknown"
msgid "　青子はそれを拒んだろうか……？"
msgstr ""

#. Occurrence B_8:2611:16498: scene=B_8
#: B_8:2611
msgctxt "text_id=16498 | speaker=unknown"
msgid "　草十郎には考えもつかない。"
msgstr ""

#. Occurrence B_8:2648:16499: scene=B_8
#: B_8:2648
msgctxt "text_id=16499 | speaker=unknown"
msgid "　……けれど。彼女がそのカードを、喜んで選んでいない事だけは断言できる。"
msgstr ""

#. Occurrence B_8:2654:16500: scene=B_8
#: B_8:2654
msgctxt "text_id=16500 | speaker=unknown"
msgid "　魔法使いとしての生き方が魅力的だったとしても、今までの生活をあっさりと切り捨てる事なんて、あの少女にはあり得ない。"
msgstr ""

#. Occurrence B_8:2674:16501: scene=B_8
#: B_8:2674
msgctxt "text_id=16501 | speaker=unknown"
msgid "　だって、蒼崎青子はいつだって本気で走っていた。"
msgstr ""

#. Occurrence B_8:2680:16502: scene=B_8
#: B_8:2680
msgctxt "text_id=16502 | speaker=unknown"
msgid "　必然、彼女の十五年間はその努力の分だけ、十分に報われていた筈だ。"
msgstr ""

#. Occurrence B_8:2685:16503: scene=B_8
#: B_8:2685
msgctxt "text_id=16503 | speaker=unknown"
msgid "　それまでの成果も、将来の展望も、誰もが羨むだけの輝きを持っていた筈なのだ。"
msgstr ""

#. Occurrence B_8:2691:16504: scene=B_8
#: B_8:2691
msgctxt "text_id=16504 | speaker=unknown"
msgid "それを白紙に戻して、一からやり直す決意を持てるものなのか。"
msgstr ""

#. Occurrence B_8:2718:16505: scene=B_8
#: B_8:2718
msgctxt "text_id=16505 | speaker=unknown"
msgid "　……単純に、やり直すだけではなく。"
msgstr ""

#. Occurrence B_8:2724:16506: scene=B_8
#: B_8:2724
msgctxt "text_id=16506 | speaker=unknown"
msgid "　ずっと描いていた<未来|ゆめ>を、完膚無きまでに、殺す事になったとしても。"
msgstr ""

#. Occurrence B_8:2780:16507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0023; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2780
msgctxt "text_id=16507 | speaker=soujuurou"
msgid "「……青子は、どうしたんですか？」"
msgstr ""

#. Occurrence B_8:2817:16508: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0061; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2817
msgctxt "text_id=16508 | speaker=eiri"
msgid "「いや、これがもう、まったくの頑固者でして。"
msgstr ""

#. Occurrence B_8:2823:16509: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0062; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2823
msgctxt "text_id=16509 | speaker=eiri"
msgid "　立ち会った私でさえどうかと思うぐらい、簡単に<頷|うなず>きました。"
msgstr ""

#. Occurrence B_8:2830:16510: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0063; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2830
msgctxt "text_id=16510 | speaker=eiri"
msgid "震える指を懸命に握りこんで、やってやろうじゃない、と見得を切ってね。"
msgstr ""

#. Occurrence B_8:2836:16511: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0064; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2836
msgctxt "text_id=16511 | speaker=eiri"
msgid "　彼女は祖父の期待や蒼崎の責任感からではなく、逃げる事を嫌って、魔術師の道を取ったんですよ」"
msgstr ""

#. Occurrence B_8:2885:16512: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0065; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2885
msgctxt "text_id=16512 | speaker=eiri"
msgid "「拒む事は逃げではないのでしょうが、青子にはそう思えたんでしょう。……逃避という行為は、これまでの自分の<人生|じかん>を否定する事になると。"
msgstr ""

#. Occurrence B_8:2891:16513: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0066; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2891
msgctxt "text_id=16513 | speaker=eiri"
msgid "　今までの自分を嘘にしてしまうのなら―――今までの生活に別れを告げる事を、青子は選んだのです。"
msgstr ""

#. Occurrence B_8:2897:16514: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0067; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2897
msgctxt "text_id=16514 | speaker=eiri"
msgid "　ま、極端ではありますが。アレは前に進む為なら、全てを捨てられる人間なんです」"
msgstr ""

#. Occurrence B_8:2977:16515: scene=B_8
#: B_8:2977
msgctxt "text_id=16515 | speaker=unknown"
msgid "　詠梨神父は懐かしむように微笑んだ。"
msgstr ""

#. Occurrence B_8:2982:16516: scene=B_8
#: B_8:2982
msgctxt "text_id=16516 | speaker=unknown"
msgid "　そこには青子に対する親近感というよりは、保護者としての誇らしさがうかがえた。"
msgstr ""

#. Occurrence B_8:3034:16517: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0068; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3034
msgctxt "text_id=16517 | speaker=eiri"
msgid "「……ですが、私も思い違いをしていました。結局はそうなるように、青子は育てられていたのです。"
msgstr ""

#. Occurrence B_8:3040:16518: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0069; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3040
msgctxt "text_id=16518 | speaker=eiri"
msgid "　彼女の祖父は、橙子が家を出る事も、青子が後継ぎを了解する事も読んだ上で、あの二人を育ててきた」"
msgstr ""

#. Occurrence B_8:3079:16519: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0070; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3079
msgctxt "text_id=16519 | speaker=eiri"
msgid "「カタチだけですが、私も神父としてさすがにそれはどうかと思いましてね。<柄|がら>にもなく青子を説得したものです。"
msgstr ""

#. Occurrence B_8:3085:16520: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0071; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3085
msgctxt "text_id=16520 | speaker=eiri"
msgid "　祖父の思い通りになる事はありません、なんなら私とメキシコあたりに逃げませんかと。"
msgstr ""

#. Occurrence B_8:3091:16521: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0072; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3091
msgctxt "text_id=16521 | speaker=eiri"
msgid "　―――しかしまぁ、躊躇なくフられました。"
msgstr ""

#. Occurrence B_8:3097:16522: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0073; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3097
msgctxt "text_id=16522 | speaker=eiri"
msgid "　その時の彼女の返答は、今でも一言一句覚えています」"
msgstr ""

#. Occurrence B_8:3139:16523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0000; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3139
msgctxt "text_id=16523 | speaker=aoko"
msgid "『……だって、私ひとりがどんなに泣き叫んでも今の状況は変わらないんでしょ？"
msgstr ""

#. Occurrence B_8:3145:16524: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0001; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3145
msgctxt "text_id=16524 | speaker=aoko"
msgid "　私にしかできないなら、正面から受けて立つ。"
msgstr ""

#. Occurrence B_8:3151:16525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0002; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3151
msgctxt "text_id=16525 | speaker=aoko"
msgid "　たとえ不本意で、とつぜん投げこまれた川の中でだって、出来ることはあるはずだもの。"
msgstr ""

#. Occurrence B_8:3157:16526: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0003; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3157
msgctxt "text_id=16526 | speaker=aoko"
msgid "　逃げるなんてのは最後の最後。"
msgstr ""

#. Occurrence B_8:3163:16527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0004; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3163
msgctxt "text_id=16527 | speaker=aoko"
msgid "　それまでは、せいぜい華麗に踊ってやるわ』"
msgstr ""

#. Occurrence B_8:3216:16528: scene=B_8
#: B_8:3216
msgctxt "text_id=16528 | speaker=unknown"
msgid "　過去を懐かしむように、神父は少女の台詞を暗唱した。"
msgstr ""

#. Occurrence B_8:3221:16529: scene=B_8
#: B_8:3221
msgctxt "text_id=16529 | speaker=unknown"
msgid "　それは、たしかに彼女らしい台詞だった。"
msgstr ""

#. Occurrence B_8:3226:16530: scene=B_8
#: B_8:3226
msgctxt "text_id=16530 | speaker=unknown"
msgid "　病室で青子と交わした最後の台詞は、たぶんそういう意味なのだ。"
msgstr ""

#. Occurrence B_8:3259:16531: scene=B_8
#: B_8:3259
msgctxt "text_id=16531 | speaker=unknown"
msgid "　観客はもちろんいるし、喝采も当然のように求めるべきものだ。"
msgstr ""

#. Occurrence B_8:3264:16532: scene=B_8
#: B_8:3264
msgctxt "text_id=16532 | speaker=unknown"
msgid "　けれど、それを一番初めに贈るのは自分であって、決して他人ではない。"
msgstr ""

#. Occurrence B_8:3269:16533: scene=B_8
#: B_8:3269
msgctxt "text_id=16533 | speaker=unknown"
msgid "　周りに認められるより先に、あの少女はまず、自分自身に胸を張れるよう走ってきた。"
msgstr ""

#. Occurrence B_8:3290:16534: scene=B_8
#: B_8:3290
msgctxt "text_id=16534 | speaker=unknown"
msgid "　せめて美しく。"
msgstr ""

#. Occurrence B_8:3295:16535: scene=B_8
#: B_8:3295
msgctxt "text_id=16535 | speaker=unknown"
msgid "　無くしてきた多くのものに応えられるように、たとえ地上に一人きりになっても、ああやってやせ我慢を続けるのだ。"
msgstr ""

#. Occurrence B_8:3364:16536: scene=B_8
#: B_8:3364
msgctxt "text_id=16536 | speaker=unknown"
msgid "　なぜ羨んでいるのかなんて、言葉にするまでもない。"
msgstr ""

#. Occurrence B_8:3369:16537: scene=B_8
#: B_8:3369
msgctxt "text_id=16537 | speaker=unknown"
msgid "　彼には、彼女の在り方があまりにも誇らしかった。"
msgstr ""

#. Occurrence B_8:3408:16538: scene=B_8
#: B_8:3408
msgctxt "text_id=16538 | speaker=unknown"
msgid "　全てを受け入れていながら、その実、何も手に入れていない人間がいて、"
msgstr ""

#. Occurrence B_8:3414:16539: scene=B_8
#: B_8:3414
msgctxt "text_id=16539 | speaker=unknown"
msgid "　全てを捨ててきたようで、その実、何一つ失ってはいない少女がいた。"
msgstr ""

#. Occurrence B_8:3442:16540: scene=B_8
#: B_8:3442
msgctxt "text_id=16540 | speaker=unknown"
msgid "　……まだ誰とも出会っていなかった雨の会議室。"
msgstr ""

#. Occurrence B_8:3447:16541: scene=B_8
#: B_8:3447
msgctxt "text_id=16541 | speaker=unknown"
msgid "　自らの醜さと、"
msgstr ""

#. Occurrence B_8:3452:16542: scene=B_8
#: B_8:3452
msgctxt "text_id=16542 | speaker=unknown"
msgid "　正反対の気高さを見た。"
msgstr ""

#. Occurrence B_8:3458:16543: scene=B_8
#: B_8:3458
msgctxt "text_id=16543 | speaker=unknown"
msgid "　思えばあの時。"
msgstr ""

#. Occurrence B_8:3463:16544: scene=B_8
#: B_8:3463
msgctxt "text_id=16544 | speaker=unknown"
msgid "　彼はようやく、自分の棘に気が付いたのだ。"
msgstr ""

#. Occurrence B_8:3528:16545: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0074; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3528
msgctxt "text_id=16545 | speaker=eiri"
msgid "「もういいでしょう。君は青子の容姿に感じ入ったのではなく、蒼崎青子という生き方に感じ入ったのです。"
msgstr ""

#. Occurrence B_8:3534:16546: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0075; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3534
msgctxt "text_id=16546 | speaker=eiri"
msgid "　ま、青子は青子でれっきとした美人ですが」"
msgstr ""

#. Occurrence B_8:3577:16547: scene=B_8
#: B_8:3577
msgctxt "text_id=16547 | speaker=unknown"
msgid "　少年はうなずく。"
msgstr ""

#. Occurrence B_8:3582:16548: scene=B_8
#: B_8:3582
msgctxt "text_id=16548 | speaker=unknown"
msgid "　初めて少女に出会ったあの日。"
msgstr ""

#. Occurrence B_8:3587:16549: scene=B_8
#: B_8:3587
msgctxt "text_id=16549 | speaker=unknown"
msgid "　無意識に感じた印象は、それ以外の何物でもないと。"
msgstr ""

#. Occurrence B_8:3593:16550: scene=B_8
#: B_8:3593
msgctxt "text_id=16550 | speaker=unknown"
msgid "　強い眼差しと、ただ自分であろうとする彼女の意志に、彼はあんなにも見惚れたのだ。"
msgstr ""

#. Occurrence B_8:3622:16551: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0024; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:3622
msgctxt "text_id=16551 | speaker=soujuurou"
msgid "「……なんか、すごいやせ我慢だ」"
msgstr ""

#. Occurrence B_8:3648:16552: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0076; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3648
msgctxt "text_id=16552 | speaker=eiri"
msgid "「本当に。小娘のクセに、ギネス級の頑固さです」"
msgstr ""

#. Occurrence B_8:3654:16553: scene=B_8
#: B_8:3654
msgctxt "text_id=16553 | speaker=unknown"
msgid "　神父の同意は心からのものだ。"
msgstr ""

#. Occurrence B_8:3659:16554: scene=B_8
#: B_8:3659
msgctxt "text_id=16554 | speaker=unknown"
msgid "　草十郎は小さく、この数時間の自分の馬鹿さかげんを笑うように頬をかいて、顔を上げた。"
msgstr ""

#. Occurrence B_8:3710:16555: scene=B_8
#: B_8:3710
msgctxt "text_id=16555 | speaker=unknown"
msgid "　正体不明の気持ちはまだ持て余しているが、どうもそれは解決しなくてもいいものらしい。"
msgstr ""

#. Occurrence B_8:3715:16556: scene=B_8
#: B_8:3715
msgctxt "text_id=16556 | speaker=unknown"
msgid "　いてもたってもいられず立ち上がる。"
msgstr ""

#. Occurrence B_8:3720:16557: scene=B_8
#: B_8:3720
msgctxt "text_id=16557 | speaker=unknown"
msgid "　蒼崎の家のことも、魔術師同士の争いも、死にに行こうとする青子のことも、どうでもいい。"
msgstr ""

#. Occurrence B_8:3726:16558: scene=B_8
#: B_8:3726
msgctxt "text_id=16558 | speaker=unknown"
msgid "　今はただ、彼女の顔が見たかった。"
msgstr ""

#. Occurrence B_9:52:16559: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0000; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:52
msgctxt "text_id=16559 | speaker=yuika"
msgid "「お待ちなさい。病室は立ち入り禁止です」"
msgstr ""

#. Occurrence B_9:58:16560: scene=B_9
#: B_9:58
msgctxt "text_id=16560 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence B_9:63:16561: scene=B_9
#: B_9:63
msgctxt "text_id=16561 | speaker=unknown"
msgid "　礼拝堂の奥、病室に向かう草十郎に、冷たい声が浴びせられた。"
msgstr ""

#. Occurrence B_9:79:16562: scene=B_9
#: B_9:79
msgctxt "text_id=16562 | speaker=unknown"
msgid "　祭壇の横に控えていたのか、盲目のシスターは草十郎を律するように、ドアの前に移動した。"
msgstr ""

#. Occurrence B_9:105:16563: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0000; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:105
msgctxt "text_id=16563 | speaker=soujuurou"
msgid "「唯架さん。いま、病室には入れないんですか？」"
msgstr ""

#. Occurrence B_9:116:16564: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0001; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:116
msgctxt "text_id=16564 | speaker=yuika"
msgid "「はい。しばらく<人除|ひとよ>けをしてほしいと、久遠寺様から言付かっています」"
msgstr ""

#. Occurrence B_9:122:16565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0001; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:122
msgctxt "text_id=16565 | speaker=soujuurou"
msgid "「有珠が……？」"
msgstr ""

#. Occurrence B_9:161:16566: scene=B_9
#: B_9:161
msgctxt "text_id=16566 | speaker=unknown"
msgid "　人除けとはどういう事か。"
msgstr ""

#. Occurrence B_9:166:16567: scene=B_9
#: B_9:166
msgctxt "text_id=16567 | speaker=unknown"
msgid "　傷の手当て、容態の悪化といった理由で面会謝絶になるのなら分かるが、シスターの言葉から、そういった事情は感じとれない。"
msgstr ""

#. Occurrence B_9:172:16568: scene=B_9
#: B_9:172
msgctxt "text_id=16568 | speaker=unknown"
msgid "　そもそも、治療はもう終わっていると青子自身が―――"
msgstr ""

#. Occurrence B_9:206:16569: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0000; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:206
msgctxt "text_id=16569 | speaker=eiri"
msgid "「人がいいのですね、シスター唯架は。そんな方便をしなくてもいいんですよ。"
msgstr ""

#. Occurrence B_9:212:16570: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0001; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:212
msgctxt "text_id=16570 | speaker=eiri"
msgid "　はっきり言ってあげればいい。今から病室に行っても無駄です、と。"
msgstr ""

#. Occurrence B_9:219:16571: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0002; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:219
msgctxt "text_id=16571 | speaker=eiri"
msgid "青子はとっくに出発しているんですから」"
msgstr ""

#. Occurrence B_9:245:16572: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0002; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:245
msgctxt "text_id=16572 | speaker=yuika"
msgid "「エイリ神父」"
msgstr ""

#. Occurrence B_9:302:16573: scene=B_9
#: B_9:302
msgctxt "text_id=16573 | speaker=unknown"
msgid "　長椅子に座ったまま、神父はにこやかに説明した。"
msgstr ""

#. Occurrence B_9:307:16574: scene=B_9
#: B_9:307
msgctxt "text_id=16574 | speaker=unknown"
msgid "　先ほどまでの一連のやりとり。"
msgstr ""

#. Occurrence B_9:312:16575: scene=B_9
#: B_9:312
msgctxt "text_id=16575 | speaker=unknown"
msgid "　彼はなぜ、頼まれもせず他人の悩みを解いていたのか。"
msgstr ""

#. Occurrence B_9:317:16576: scene=B_9
#: B_9:317
msgctxt "text_id=16576 | speaker=unknown"
msgid "　……その真意は、もう語るまでもない。"
msgstr ""

#. Occurrence B_9:362:16577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0002; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:362
msgctxt "text_id=16577 | speaker=soujuurou"
msgid "「初めから、そのつもりだったんですね」"
msgstr ""

#. Occurrence B_9:367:16578: scene=B_9
#: B_9:367
msgctxt "text_id=16578 | speaker=unknown"
msgid "　怒気を含んだ声を、神父は眉ひとつ動かさず受けとめる。"
msgstr ""

#. Occurrence B_9:402:16579: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0003; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:402
msgctxt "text_id=16579 | speaker=eiri"
msgid "「申し訳ありません。青子に貴方の保護を頼まれたもので。"
msgstr ""

#. Occurrence B_9:408:16580: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0004; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:408
msgctxt "text_id=16580 | speaker=eiri"
msgid "　彼女の準備が整うまでの時間稼ぎでしたが、私が貴方と話をしたかったのは事実ですよ」"
msgstr ""

#. Occurrence B_9:413:16581: scene=B_9
#: B_9:413
msgctxt "text_id=16581 | speaker=unknown"
msgid "　そこは誤解なきよう、と神父は誠意のかけらもない弁明をした。"
msgstr ""

#. Occurrence B_9:456:16582: scene=B_9
#: B_9:456
msgctxt "text_id=16582 | speaker=unknown"
msgid "　強く、激情から歯を噛み締める。"
msgstr ""

#. Occurrence B_9:462:16583: scene=B_9
#: B_9:462
msgctxt "text_id=16583 | speaker=unknown"
msgid "　……なぜ青子たちの自殺行為を止めなかったのか、なんて罵倒はない。"
msgstr ""

#. Occurrence B_9:482:16584: scene=B_9
#: B_9:482
msgctxt "text_id=16584 | speaker=unknown"
msgid "　神父もシスターも魔術師と同類だ。"
msgstr ""

#. Occurrence B_9:487:16585: scene=B_9
#: B_9:487
msgctxt "text_id=16585 | speaker=unknown"
msgid "　彼らにとって見れば青子の選択は当然であり、そもそも、この神父は青子を知っている。"
msgstr ""

#. Occurrence B_9:492:16586: scene=B_9
#: B_9:492
msgctxt "text_id=16586 | speaker=unknown"
msgid "　たとえ彼に青子を止める力があったとしても、彼はすっぱり見送っただろう。"
msgstr ""

#. Occurrence B_9:497:16587: scene=B_9
#: B_9:497
msgctxt "text_id=16587 | speaker=unknown"
msgid "　このまま教会でくすぶっている青子なんて、彼の知る蒼崎青子ではないのだから。"
msgstr ""

#. Occurrence B_9:523:16588: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0003; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:523
msgctxt "text_id=16588 | speaker=soujuurou"
msgid "「有珠は？」"
msgstr ""

#. Occurrence B_9:558:16589: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0005; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:558
msgctxt "text_id=16589 | speaker=eiri"
msgid "「青子と行きましたよ。あれから三十分は過ぎていますね」"
msgstr ""

#. Occurrence B_9:564:16590: scene=B_9
#: B_9:564
msgctxt "text_id=16590 | speaker=unknown"
msgid "　神父はご丁寧にも、時間まで口にした。"
msgstr ""

#. Occurrence B_9:585:16591: scene=B_9
#: B_9:585
msgctxt "text_id=16591 | speaker=unknown"
msgid "　三十分。ちょうど神父が現れた時間と一致する。"
msgstr ""

#. Occurrence B_9:590:16592: scene=B_9
#: B_9:590
msgctxt "text_id=16592 | speaker=unknown"
msgid "　この教会から学校までは二十分かからない。"
msgstr ""

#. Occurrence B_9:595:16593: scene=B_9
#: B_9:595
msgctxt "text_id=16593 | speaker=unknown"
msgid "　そこから三咲高校の旧校舎までなら、走れば十分たらずで到着してしまう―――"
msgstr ""

#. Occurrence B_9:616:16594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0004; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:616
msgctxt "text_id=16594 | speaker=soujuurou"
msgid "「っ…………！」"
msgstr ""

#. Occurrence B_9:621:16595: scene=B_9
#: B_9:621
msgctxt "text_id=16595 | speaker=unknown"
msgid "　草十郎は礼拝堂の玄関へと踵を返す。"
msgstr ""

#. Occurrence B_9:628:16596: scene=B_9
#: B_9:628
msgctxt "text_id=16596 | speaker=unknown"
msgid "　それを、"
msgstr ""

#. Occurrence B_9:661:16597: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0003; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:661
msgctxt "text_id=16597 | speaker=yuika"
msgid "「待ちなさい。何処へ行くつもりですか」"
msgstr ""

#. Occurrence B_9:666:16598: scene=B_9
#: B_9:666
msgctxt "text_id=16598 | speaker=unknown"
msgid "　盲目のシスターが、声だけで押し止めた。"
msgstr ""

#. Occurrence B_9:701:16599: scene=B_9
#: B_9:701
msgctxt "text_id=16599 | speaker=unknown"
msgid "　―――見えない重圧が草十郎の足を止めている。"
msgstr ""

#. Occurrence B_9:706:16600: scene=B_9
#: B_9:706
msgctxt "text_id=16600 | speaker=unknown"
msgid "　シスターの声は呪縛となって、向こう見ずな少年を<諫|いさ>めていた。"
msgstr ""

#. Occurrence B_9:733:16601: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0004; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:733
msgctxt "text_id=16601 | speaker=yuika"
msgid "「貴方は魔術師同士の争いを知りません。"
msgstr ""

#. Occurrence B_9:739:16602: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0005; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:739
msgctxt "text_id=16602 | speaker=yuika"
msgid "　何の助力にもならないばかりか、彼女たちの<足枷|あしかせ>になるだけです。"
msgstr ""

#. Occurrence B_9:745:16603: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0006; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:745
msgctxt "text_id=16603 | speaker=yuika"
msgid "　彼女たちが命を落とすのは彼女たちの業によるもの。望むままに傷つけ合えばいいでしょう。"
msgstr ""

#. Occurrence B_9:752:16604: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0007; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:752
msgctxt "text_id=16604 | speaker=yuika"
msgid "貴方のような何の<咎|とが>もない若者が、凶事に立ち会う事はありません」"
msgstr ""

#. Occurrence B_9:772:16605: scene=B_9
#: B_9:772
msgctxt "text_id=16605 | speaker=unknown"
msgid "　シスターの声には静かな怒りがある。"
msgstr ""

#. Occurrence B_9:777:16606: scene=B_9
#: B_9:777
msgctxt "text_id=16606 | speaker=unknown"
msgid "　青子たちへの嫌悪ではなく、それを承知の上で命を粗末にする草十郎を<諫|いさ>めている。"
msgstr ""

#. Occurrence B_9:826:16607: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0008; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:826
msgctxt "text_id=16607 | speaker=yuika"
msgid "「なにかしら希望があるのなら私も止めはしません。"
msgstr ""

#. Occurrence B_9:832:16608: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0009; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:832
msgctxt "text_id=16608 | speaker=yuika"
msgid "　ですがこの件は別です。貴方が行っても、彼女たちが助かる事はありません」"
msgstr ""

#. Occurrence B_9:879:16609: scene=B_9
#: B_9:879
msgctxt "text_id=16609 | speaker=unknown"
msgid "　……たしかに、草十郎が追いついたところで、何がどうなる訳でもない。"
msgstr ""

#. Occurrence B_9:884:16610: scene=B_9
#: B_9:884
msgctxt "text_id=16610 | speaker=unknown"
msgid "　遊園地の時だって、結局は役に立たなかったのだ。"
msgstr ""

#. Occurrence B_9:889:16611: scene=B_9
#: B_9:889
msgctxt "text_id=16611 | speaker=unknown"
msgid "　相手はあの夜以上の怪物だと言うなら、何が出来るかすら思いつかない。"
msgstr ""

#. Occurrence B_9:931:16612: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0010; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:931
msgctxt "text_id=16612 | speaker=yuika"
msgid "「言っておきますが、蒼崎青子は祖父に護身術を教えこまれています。魔術以外でも貴方より腕は立つ。"
msgstr ""

#. Occurrence B_9:937:16613: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0011; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:937
msgctxt "text_id=16613 | speaker=yuika"
msgid "　その彼女も、あの使い魔が相手では勝負にならない」"
msgstr ""

#. Occurrence B_9:976:16614: scene=B_9
#: B_9:976
msgctxt "text_id=16614 | speaker=unknown"
msgid "　唯一の利点である男の腕力も無駄らしい。"
msgstr ""

#. Occurrence B_9:982:16615: scene=B_9
#: B_9:982
msgctxt "text_id=16615 | speaker=unknown"
msgid "このまま行ったところで足手まといになるのは目に見えている。"
msgstr ""

#. Occurrence B_9:987:16616: scene=B_9
#: B_9:987
msgctxt "text_id=16616 | speaker=unknown"
msgid "　シスターの言はすべて正しい。"
msgstr ""

#. Occurrence B_9:992:16617: scene=B_9
#: B_9:992
msgctxt "text_id=16617 | speaker=unknown"
msgid "　それでも―――"
msgstr ""

#. Occurrence B_9:1038:16618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0005; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1038
msgctxt "text_id=16618 | speaker=soujuurou"
msgid "「でも、行かないと。青子には、返さなくちゃいけない借りがあります」"
msgstr ""

#. Occurrence B_9:1062:16619: scene=B_9
#: B_9:1062
msgctxt "text_id=16619 | speaker=unknown"
msgid "　あまりに落ち着いた、厳格な響き。"
msgstr ""

#. Occurrence B_9:1067:16620: scene=B_9
#: B_9:1067
msgctxt "text_id=16620 | speaker=unknown"
msgid "　それについ<絆|ほだ>されかけ、シスターは眉をひそめた。"
msgstr ""

#. Occurrence B_9:1077:16621: scene=B_9
#: B_9:1077
msgctxt "text_id=16621 | speaker=unknown"
msgid "　……気は乗らないがこれも少年のためだ。"
msgstr ""

#. Occurrence B_9:1082:16622: scene=B_9
#: B_9:1082
msgctxt "text_id=16622 | speaker=unknown"
msgid "　言葉で分からないのなら無理矢理にでも眠らせるしかないと、呪縛の指を草十郎に向け―――"
msgstr ""

#. Occurrence B_9:1103:16623: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0006; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1103
msgctxt "text_id=16623 | speaker=eiri"
msgid "「それを言うなら返したい借りがある、ですよ草十郎君。"
msgstr ""

#. Occurrence B_9:1165:16624: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0007; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1165
msgctxt "text_id=16624 | speaker=eiri"
msgid "　それとシスター唯架、教会内での魔術は控えてくださいね。"
msgstr ""

#. Occurrence B_9:1171:16625: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0008; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1171
msgctxt "text_id=16625 | speaker=eiri"
msgid "　使うのなら秘蹟にとどめてもらわないと、私の査定に響きます。"
msgstr ""

#. Occurrence B_9:1178:16626: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0009; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1178
msgctxt "text_id=16626 | speaker=eiri"
msgid "……まったく。大人しそうに見えて律架クンより短気なんですから、貴女は」"
msgstr ""

#. Occurrence B_9:1224:16627: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0012; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1224
msgctxt "text_id=16627 | speaker=yuika"
msgid "「エイリ神父、しかし」"
msgstr ""

#. Occurrence B_9:1230:16628: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0010; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1230
msgctxt "text_id=16628 | speaker=eiri"
msgid "「行かせてあげればいいじゃないですか。それとも貴女は、やはり青子たちに退場してほしいと？」"
msgstr ""

#. Occurrence B_9:1256:16629: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0013; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1256
msgctxt "text_id=16629 | speaker=yuika"
msgid "「……その問題と、彼の献身は別の話です。"
msgstr ""

#. Occurrence B_9:1262:16630: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0014; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1262
msgctxt "text_id=16630 | speaker=yuika"
msgid "　<改|あらた>めなさい静希さん。貴方が行っても、何も出来はしないのですから」"
msgstr ""

#. Occurrence B_9:1285:16631: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0006; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1285
msgctxt "text_id=16631 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence B_9:1305:16632: scene=B_9
#: B_9:1305
msgctxt "text_id=16632 | speaker=unknown"
msgid "　　……それは、何より彼自身が痛感している真実だった。"
msgstr ""

#. Occurrence B_9:1310:16633: scene=B_9
#: B_9:1310
msgctxt "text_id=16633 | speaker=unknown"
msgid "　それでも答えは決まっている。"
msgstr ""

#. Occurrence B_9:1315:16634: scene=B_9
#: B_9:1315
msgctxt "text_id=16634 | speaker=unknown"
msgid "　初めからそうだった。どうせ自分すら確かではないのなら、せめて、迷わないように。"
msgstr ""

#. Occurrence B_9:1320:16635: scene=B_9
#: B_9:1320
msgctxt "text_id=16635 | speaker=unknown"
msgid "　自然にうかんだ気持ちだけは貫こうと思ったのは、もうずっと以前からの事だ。"
msgstr ""

#. Occurrence B_9:1346:16636: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0007; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1346
msgctxt "text_id=16636 | speaker=soujuurou"
msgid "「分かっています。"
msgstr ""

#. Occurrence B_9:1353:16637: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0008; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1353
msgctxt "text_id=16637 | speaker=soujuurou"
msgid "……でも、行かないと。"
msgstr ""

#. Occurrence B_9:1359:16638: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0009; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1359
msgctxt "text_id=16638 | speaker=soujuurou"
msgid "　ここにいたら、本当に何もできない」"
msgstr ""

#. Occurrence B_9:1379:16639: scene=B_9
#: B_9:1379
msgctxt "text_id=16639 | speaker=unknown"
msgid "　胸にあるのは未熟な<衝動|こころ>だけ。"
msgstr ""

#. Occurrence B_9:1384:16640: scene=B_9
#: B_9:1384
msgctxt "text_id=16640 | speaker=unknown"
msgid "　神父の話を聞いた時、彼はただ、彼女に会いたいと思った。"
msgstr ""

#. Occurrence B_9:1389:16641: scene=B_9
#: B_9:1389
msgctxt "text_id=16641 | speaker=unknown"
msgid "　心配や助けなんて浮かばず、それだけしか思えなかった。"
msgstr ""

#. Occurrence B_9:1394:16642: scene=B_9
#: B_9:1394
msgctxt "text_id=16642 | speaker=unknown"
msgid "　だから―――"
msgstr ""

#. Occurrence B_9:1400:16643: scene=B_9
#: B_9:1400
msgctxt "text_id=16643 | speaker=unknown"
msgid "その後の事は、その時にしか考えられない。"
msgstr ""

#. Occurrence B_9:1453:16644: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0011; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1453
msgctxt "text_id=16644 | speaker=eiri"
msgid "「ほら。献身なんて考え自体が間違ってるんです。"
msgstr ""

#. Occurrence B_9:1459:16645: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0012; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1459
msgctxt "text_id=16645 | speaker=eiri"
msgid "　足を引っ張るといいますが、どのみち青子たちに勝ち目はないんでしょう？"
msgstr ""

#. Occurrence B_9:1467:16646: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0013; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1467
msgctxt "text_id=16646 | speaker=eiri"
msgid "　"
msgstr ""

msgctxt "text_id=16647 | speaker=unknown"
msgid "なら、彼がマイナスになってもいいじゃないですか。どうせ破産するなら、豪快に破産すれば」"
msgstr ""

#. Occurrence B_9:1505:16648: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0015; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1505
msgctxt "text_id=16648 | speaker=yuika"
msgid "「神父」"
msgstr ""

#. Occurrence B_9:1558:16649: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0014; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1558
msgctxt "text_id=16649 | speaker=eiri"
msgid "「ほら草十郎くん、行って行って。"
msgstr ""

#. Occurrence B_9:1564:16650: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0015; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1564
msgctxt "text_id=16650 | speaker=eiri"
msgid "　シスター、今の貴方の返事で心が折れましたから。"
msgstr ""

#. Occurrence B_9:1570:16651: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0016; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1570
msgctxt "text_id=16651 | speaker=eiri"
msgid "　足、動くでしょう？」"
msgstr ""

#. Occurrence B_9:1630:16652: scene=B_9
#: B_9:1630
msgctxt "text_id=16652 | speaker=unknown"
msgid "　神父に指摘され、草十郎は体を確かめる。"
msgstr ""

#. Occurrence B_9:1635:16653: scene=B_9
#: B_9:1635
msgctxt "text_id=16653 | speaker=unknown"
msgid "　肩にのしかかっていた重圧は薄れ、彼自身が抱いていたかすかな恐れ―――"
msgstr ""

#. Occurrence B_9:1641:16654: scene=B_9
#: B_9:1641
msgctxt "text_id=16654 | speaker=unknown"
msgid "自分は役に立たないどころか、青子たちを危険に<晒|さら>すだけかもしれない―――も、完全に吹き飛んでいた。"
msgstr ""

#. Occurrence B_9:1667:16655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0010; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1667
msgctxt "text_id=16655 | speaker=soujuurou"
msgid "「―――行きます。<縁|えん>が残っていれば、また」"
msgstr ""

#. Occurrence B_9:1683:16656: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_9000; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1683
msgctxt "text_id=16656 | speaker=eiri"
msgid "「はい。何であれ、後悔のない一日を」"
msgstr ""

#. Occurrence B_9:1728:16657: scene=B_9
#: B_9:1728
msgctxt "text_id=16657 | speaker=unknown"
msgid "　走りだす草十郎を、神父は満足げに見送った。"
msgstr ""

#. Occurrence B_9:1733:16658: scene=B_9
#: B_9:1733
msgctxt "text_id=16658 | speaker=unknown"
msgid "　どのみち青子を説得する事も無理なら、彼を納得させる事も無理だと分かっていたように。"
msgstr ""

#. Occurrence B_9:1771:16659: scene=B_9
#: B_9:1771
msgctxt "text_id=16659 | speaker=unknown"
msgid "　走り去っていく、がむしゃらな少年の後ろ姿。"
msgstr ""

#. Occurrence B_9:1776:16660: scene=B_9
#: B_9:1776
msgctxt "text_id=16660 | speaker=unknown"
msgid "　盲目のシスターは、その音を聞き届ける事しかできない。"
msgstr ""

#. Occurrence B_9:1781:16661: scene=B_9
#: B_9:1781
msgctxt "text_id=16661 | speaker=unknown"
msgid "　……彼女は神父とも草十郎とも違う。"
msgstr ""

#. Occurrence B_9:1786:16662: scene=B_9
#: B_9:1786
msgctxt "text_id=16662 | speaker=unknown"
msgid "　悪徳にも独善にも慈悲は見せないが、無垢な<中庸|ちゅうよう>さには<慈|じ><愛|あい>を抱くのだ。"
msgstr ""

#. Occurrence B_9:1791:16663: scene=B_9
#: B_9:1791
msgctxt "text_id=16663 | speaker=unknown"
msgid "　あの平凡な少年が天寿を全うするのは素晴らしいが、むざむざ異端たちの地獄に堕ちるのは心苦しい。"
msgstr ""

#. Occurrence B_9:1825:16664: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0016; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1825
msgctxt "text_id=16664 | speaker=yuika"
msgid "「……最悪ですね、エイリ神父。"
msgstr ""

#. Occurrence B_9:1831:16665: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0017; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1831
msgctxt "text_id=16665 | speaker=yuika"
msgid "　分別の付かない子供を導くのが、責任のある大人だと思いましたが」"
msgstr ""

#. Occurrence B_9:1837:16666: scene=B_9
#: B_9:1837
msgctxt "text_id=16666 | speaker=unknown"
msgid "　刺々しい抗議の声。"
msgstr ""

#. Occurrence B_9:1842:16667: scene=B_9
#: B_9:1842
msgctxt "text_id=16667 | speaker=unknown"
msgid "　彼女は彼女なりに、あの少年の身を案じていたのだ。"
msgstr ""

#. Occurrence B_9:1847:16668: scene=B_9
#: B_9:1847
msgctxt "text_id=16668 | speaker=unknown"
msgid "　そんなシスターの気遣いに、神父はやれやれと肩をすくめて、"
msgstr ""

#. Occurrence B_9:1888:16669: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0017; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1888
msgctxt "text_id=16669 | speaker=eiri"
msgid "「だから、色々と間違えていますよシスター唯架。"
msgstr ""

#. Occurrence B_9:1894:16670: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0018; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1894
msgctxt "text_id=16670 | speaker=eiri"
msgid "　責任のある大人、なんて言葉自体がおかしい。"
msgstr ""

#. Occurrence B_9:1900:16671: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0019; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1900
msgctxt "text_id=16671 | speaker=eiri"
msgid "　<何|・><が|・><起|・><き|・><て|・><も|・><責|・><任|・><を|・><と|・><る|・>。それが、正しい大人というものです」"
msgstr ""

#. Occurrence B_9:1942:16672: scene=B_9
#: B_9:1942
msgctxt "text_id=16672 | speaker=unknown"
msgid "　誰が死んでも構わない、と。"
msgstr ""

#. Occurrence B_9:1947:16673: scene=B_9
#: B_9:1947
msgctxt "text_id=16673 | speaker=unknown"
msgid "　神父らしい温かな笑顔のまま、彼女の間違いを訂正した。"
msgstr ""

#. Occurrence C_0:63:16674: scene=C_0
#: C_0:63
msgctxt "text_id=16674 | speaker=unknown"
msgid "　<下界|まち>の<喧噪|におい>に、ピンと耳を立てる。"
msgstr ""

#. Occurrence C_0:69:16675: scene=C_0
#: C_0:69
msgctxt "text_id=16675 | speaker=unknown"
msgid "　食事を済ませ<午睡|ごすい>に身を任せていた金色の狼は、クワア、と大きなあくびをして、退屈そうに身を丸めた。"
msgstr ""

#. Occurrence C_0:115:16676: scene=C_0
#: C_0:115
msgctxt "text_id=16676 | speaker=unknown"
msgid "　その役割を終え、久しく使われていなかった教室。"
msgstr ""

#. Occurrence C_0:120:16677: scene=C_0
#: C_0:120
msgctxt "text_id=16677 | speaker=unknown"
msgid "　積み重ねた<瓦礫|つくえ>の上で身を休めるのが、ここ一ヶ月の彼の日常だ。"
msgstr ""

#. Occurrence C_0:126:16678: scene=C_0
#: C_0:126
msgctxt "text_id=16678 | speaker=unknown"
msgid "　彼の名はルゥ・ベオウルフ。"
msgstr ""

#. Occurrence C_0:131:16679: scene=C_0
#: C_0:131
msgctxt "text_id=16679 | speaker=unknown"
msgid "　故郷では太陽の名で呼ばれ、故郷を後にしてからは勇者の名を<戴|いただ>いた、純血の人狼である。"
msgstr ""

#. Occurrence C_0:198:16680: scene=C_0
#: C_0:198
msgctxt "text_id=16680 | speaker=unknown"
msgid "　言うまでもなく、彼の故郷はこの国ではない。"
msgstr ""

#. Occurrence C_0:203:16681: scene=C_0
#: C_0:203
msgctxt "text_id=16681 | speaker=unknown"
msgid "　ヨーロッパ深部、山と森に守られた荒野が彼の<世界|ふるさと>だ。"
msgstr ""

#. Occurrence C_0:208:16682: scene=C_0
#: C_0:208
msgctxt "text_id=16682 | speaker=unknown"
msgid "　いまだ人智の及ばぬ秘境。"
msgstr ""

#. Occurrence C_0:213:16683: scene=C_0
#: C_0:213
msgctxt "text_id=16683 | speaker=unknown"
msgid "　誰一人として訪れる事のない停止した世界で、ゆるやかに絶えるだけの日々を送っていた人狼たち。"
msgstr ""

#. Occurrence C_0:233:16684: scene=C_0
#: C_0:233
msgctxt "text_id=16684 | speaker=unknown"
msgid "　その中に、<彼|ベオ>は忽然と現れた。"
msgstr ""

#. Occurrence C_0:238:16685: scene=C_0
#: C_0:238
msgctxt "text_id=16685 | speaker=unknown"
msgid "　<人狼|かれ>らの祖と同じ金の毛並みを持った子供は、村はずれの洞穴で発見された。"
msgstr ""

#. Occurrence C_0:243:16686: scene=C_0
#: C_0:243
msgctxt "text_id=16686 | speaker=unknown"
msgid "　安らかな寝息をたてて、まるで、そこに<存|い>るのが当然といった様子で。"
msgstr ""

#. Occurrence C_0:263:16687: scene=C_0
#: C_0:263
msgctxt "text_id=16687 | speaker=unknown"
msgid "　村は新しい仲間の誕生と、その貴重性に沸き立った。"
msgstr ""

#. Occurrence C_0:268:16688: scene=C_0
#: C_0:268
msgctxt "text_id=16688 | speaker=unknown"
msgid "　文明が消費を良しとしてからはや二千年。"
msgstr ""

#. Occurrence C_0:273:16689: scene=C_0
#: C_0:273
msgctxt "text_id=16689 | speaker=unknown"
msgid "　森が<暴|あば>かれ、谷が埋められ、海の<混濁|よごれ>が進むにつれ、<人狼|かれ>らの生殖機能は落ちていた。"
msgstr ""

#. Occurrence C_0:278:16690: scene=C_0
#: C_0:278
msgctxt "text_id=16690 | speaker=unknown"
msgid "　一族の者が子を<孕|はら>むだけでも十年に一度の祝い事だ。"
msgstr ""

#. Occurrence C_0:298:16691: scene=C_0
#: C_0:298
msgctxt "text_id=16691 | speaker=unknown"
msgid "　それが灰や白を飛び越え、<人狼|かれ>らが森の神とされていた頃の金の獣性を持っていたのだから、村に降りた希望がどれほどのものだったか、想像に難くない。"
msgstr ""

#. Occurrence C_0:335:16692: scene=C_0
#: C_0:335
msgctxt "text_id=16692 | speaker=unknown"
msgid "　衰退していく一族。"
msgstr ""

#. Occurrence C_0:340:16693: scene=C_0
#: C_0:340
msgctxt "text_id=16693 | speaker=unknown"
msgid "　転換を受け入れざるをえない時代。"
msgstr ""

#. Occurrence C_0:345:16694: scene=C_0
#: C_0:345
msgctxt "text_id=16694 | speaker=unknown"
msgid "　それら根本的な問題を一時でも忘れてしまうほど、その赤子は輝かしかったのだ。"
msgstr ""

#. Occurrence C_0:383:16695: scene=C_0
#: C_0:383
msgctxt "text_id=16695 | speaker=unknown"
msgid "　……だが。"
msgstr ""

#. Occurrence C_0:388:16696: scene=C_0
#: C_0:388
msgctxt "text_id=16696 | speaker=unknown"
msgid "　時が経つに連れ、喜びは失望へと変わっていった。"
msgstr ""

#. Occurrence C_0:393:16697: scene=C_0
#: C_0:393
msgctxt "text_id=16697 | speaker=unknown"
msgid "　金狼は何も救わない。"
msgstr ""

#. Occurrence C_0:398:16698: scene=C_0
#: C_0:398
msgctxt "text_id=16698 | speaker=unknown"
msgid "　ルゥ―――太陽と愛された子供は、不思議な事に発見された時から今の<カ|・><タ|・><チ|・>をしていた。"
msgstr ""

#. Occurrence C_0:434:16699: scene=C_0
#: C_0:434
msgctxt "text_id=16699 | speaker=unknown"
msgid "　そればかりか、何十年経とうと一向に成長しない。"
msgstr ""

#. Occurrence C_0:439:16700: scene=C_0
#: C_0:439
msgctxt "text_id=16700 | speaker=unknown"
msgid "　彼は不老であり、不滅であり、それ故に不遇だった。"
msgstr ""

#. Occurrence C_0:445:16701: scene=C_0
#: C_0:445
msgctxt "text_id=16701 | speaker=unknown"
msgid "　村中を探しても、彼を生んだ母親はいなかった。"
msgstr ""

#. Occurrence C_0:450:16702: scene=C_0
#: C_0:450
msgctxt "text_id=16702 | speaker=unknown"
msgid "　村中を探しても、彼を理解できる人狼はいなかった。"
msgstr ""

#. Occurrence C_0:470:16703: scene=C_0
#: C_0:470
msgctxt "text_id=16703 | speaker=unknown"
msgid "　そして彼本人も、その事実を百年かけて実感した。"
msgstr ""

#. Occurrence C_0:475:16704: scene=C_0
#: C_0:475
msgctxt "text_id=16704 | speaker=unknown"
msgid "　自分は何もかもが他の連中と違う。"
msgstr ""

#. Occurrence C_0:480:16705: scene=C_0
#: C_0:480
msgctxt "text_id=16705 | speaker=unknown"
msgid "　雄も雌もない。"
msgstr ""

#. Occurrence C_0:485:16706: scene=C_0
#: C_0:485
msgctxt "text_id=16706 | speaker=unknown"
msgid "　<強|つよ>きも<弱|よわ>きもない。"
msgstr ""

#. Occurrence C_0:490:16707: scene=C_0
#: C_0:490
msgctxt "text_id=16707 | speaker=unknown"
msgid "　生も死も、<悦|えつ>も恐れもまだ知らない。"
msgstr ""

#. Occurrence C_0:539:16708: scene=C_0
#: C_0:539
msgctxt "text_id=16708 | speaker=unknown"
msgid "『アレは自然発生した精霊だ。人狼の姿をしているが、我々とはまったく違う生きものだろう―――』"
msgstr ""

#. Occurrence C_0:581:16709: scene=C_0
#: C_0:581
msgctxt "text_id=16709 | speaker=unknown"
msgid "　陰口を言われるまでもなく、彼もそれを実感していた。"
msgstr ""

#. Occurrence C_0:586:16710: scene=C_0
#: C_0:586
msgctxt "text_id=16710 | speaker=unknown"
msgid "　完成しているからこその<閉塞感|へいそくかん>。"
msgstr ""

#. Occurrence C_0:591:16711: scene=C_0
#: C_0:591
msgctxt "text_id=16711 | speaker=unknown"
msgid "　金の獣にとって、肌に感じる世界はあまりにも狭すぎる。"
msgstr ""

#. Occurrence C_0:596:16712: scene=C_0
#: C_0:596
msgctxt "text_id=16712 | speaker=unknown"
msgid "　だからこそ―――"
msgstr ""

#. Occurrence C_0:616:16713: scene=C_0
#: C_0:616
msgctxt "text_id=16713 | speaker=unknown"
msgid "　そう、だからこそ。"
msgstr ""

#. Occurrence C_0:632:16714: scene=C_0
#: C_0:632
msgctxt "text_id=16714 | speaker=unknown"
msgid "　生命とは何かを知りたい。"
msgstr ""

#. Occurrence C_0:637:16715: scene=C_0
#: C_0:637
msgctxt "text_id=16715 | speaker=unknown"
msgid "　欠落とは何かを知りたい。"
msgstr ""

#. Occurrence C_0:642:16716: scene=C_0
#: C_0:642
msgctxt "text_id=16716 | speaker=unknown"
msgid "　万能であるのなら、万能であるが故の未知を知りたい。"
msgstr ""

#. Occurrence C_0:649:16717: scene=C_0
#: C_0:649
msgctxt "text_id=16717 | speaker=unknown"
msgid "　だってこのままでは、"
msgstr ""

msgctxt "text_id=16718 | speaker=unknown"
msgid "　生きている意味がまるで無い―――"
msgstr ""

#. Occurrence C_0:683:16719: scene=C_0
#: C_0:683
msgctxt "text_id=16719 | speaker=unknown"
msgid "　金の狼は自分自身を持て余す。"
msgstr ""

#. Occurrence C_0:688:16720: scene=C_0
#: C_0:688
msgctxt "text_id=16720 | speaker=unknown"
msgid "　そうして<人狼|かれ>らも、この太陽を持て余した。"
msgstr ""

#. Occurrence C_0:693:16721: scene=C_0
#: C_0:693
msgctxt "text_id=16721 | speaker=unknown"
msgid "　敬いはするが、同時に関わりたくもない。"
msgstr ""

#. Occurrence C_0:726:16722: scene=C_0
#: C_0:726
msgctxt "text_id=16722 | speaker=unknown"
msgid "　ルゥは自分が発見された洞穴に居を構え、神子として、一生を<独|ひと>りのまま過ごすと宿命付けられた。"
msgstr ""

#. Occurrence C_0:752:16723: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0000; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:752
msgctxt "text_id=16723 | speaker=touko"
msgid "『太陽のルゥ？　<ルー・ガルー|loup-garou>じゃなくて？"
msgstr ""

#. Occurrence C_0:758:16724: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0001; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:758
msgctxt "text_id=16724 | speaker=touko"
msgid "　ハ、そりゃ面白い！　偶然にしちゃあ出来すぎだ！』"
msgstr ""

#. Occurrence C_0:764:16725: scene=C_0
#: C_0:764
msgctxt "text_id=16725 | speaker=unknown"
msgid "　その村に、風変わりな魔術師が訪れるまでは。"
msgstr ""

#. Occurrence C_0:819:16726: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0000; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:819
msgctxt "text_id=16726 | speaker=beo"
msgid "「“……またガタガタとうるさい……トーコさんはアレだよね、派手好きなクセにマメだよね……”」"
msgstr ""

#. Occurrence C_0:826:16727: scene=C_0
#: C_0:826
msgctxt "text_id=16727 | speaker=unknown"
msgid "　瓦礫の上で身を丸めながら、ベオは廊下の様子を盗み聴く。"
msgstr ""

#. Occurrence C_0:831:16728: scene=C_0
#: C_0:831
msgctxt "text_id=16728 | speaker=unknown"
msgid "　小うるさい主人は三咲市全体の霊脈の掌握とやらに忙しい……と思いきや、飽きもせず趣味の仕掛けをこしらえているようだ。"
msgstr ""

#. Occurrence C_0:865:16729: scene=C_0
#: C_0:865
msgctxt "text_id=16729 | speaker=unknown"
msgid "　この廃屋を仮の工房に使い始めて一ヶ月。"
msgstr ""

#. Occurrence C_0:870:16730: scene=C_0
#: C_0:870
msgctxt "text_id=16730 | speaker=unknown"
msgid "　一日に一つ、新しい侵入者用のトラップを作るのが彼女のひそかな趣味らしい。"
msgstr ""

#. Occurrence C_0:891:16731: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0001; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:891
msgctxt "text_id=16731 | speaker=beo"
msgid "「“……安全を用意しておくなんて、他の生き物はタイヘンだ”」"
msgstr ""

#. Occurrence C_0:897:16732: scene=C_0
#: C_0:897
msgctxt "text_id=16732 | speaker=unknown"
msgid "　生まれながらこのカタチ―――赤子という未成熟な立場も、老衰という劣化も知らない<彼|ベオ>は、通常の生き物とは在り方も思想も違う。"
msgstr ""

#. Occurrence C_0:932:16733: scene=C_0
#: C_0:932
msgctxt "text_id=16733 | speaker=unknown"
msgid "　彼はその発生からして“完全”だった。"
msgstr ""

#. Occurrence C_0:937:16734: scene=C_0
#: C_0:937
msgctxt "text_id=16734 | speaker=unknown"
msgid "　何も引くものがなく、何も付け足すところがない。"
msgstr ""

#. Occurrence C_0:942:16735: scene=C_0
#: C_0:942
msgctxt "text_id=16735 | speaker=unknown"
msgid "　故に、あらゆる弱さを実感できない。"
msgstr ""

#. Occurrence C_0:947:16736: scene=C_0
#: C_0:947
msgctxt "text_id=16736 | speaker=unknown"
msgid "　無邪気かつ天衣無縫の気分屋で、人間としての善悪も、狼としての良し悪しも計らない。"
msgstr ""

#. Occurrence C_0:952:16737: scene=C_0
#: C_0:952
msgctxt "text_id=16737 | speaker=unknown"
msgid "　この美しい獣は、周囲と没交渉でありながら、自分以外の生き物を見下している。"
msgstr ""

#. Occurrence C_0:991:16738: scene=C_0
#: C_0:991
msgctxt "text_id=16738 | speaker=unknown"
msgid "　その例外が彼の主人、蒼崎橙子である。"
msgstr ""

#. Occurrence C_0:996:16739: scene=C_0
#: C_0:996
msgctxt "text_id=16739 | speaker=unknown"
msgid "　キラキラするモノ、美味しいモノを教えてくれたし、なにより匂いがすっきりしている。"
msgstr ""

#. Occurrence C_0:1016:16740: scene=C_0
#: C_0:1016
msgctxt "text_id=16740 | speaker=unknown"
msgid "　彼にとっての良し悪しの基準は、単純に「格好いい」か「格好悪い」か。"
msgstr ""

#. Occurrence C_0:1021:16741: scene=C_0
#: C_0:1021
msgctxt "text_id=16741 | speaker=unknown"
msgid "　趣味嗜好、外見性別は問わない。"
msgstr ""

#. Occurrence C_0:1026:16742: scene=C_0
#: C_0:1026
msgctxt "text_id=16742 | speaker=unknown"
msgid "　何であろうと、その生き方に筋が通っているのなら「格好のいい」匂いがする。"
msgstr ""

#. Occurrence C_0:1036:16743: scene=C_0
#: C_0:1036
msgctxt "text_id=16743 | speaker=unknown"
msgid "　蒼崎橙子は、色々とねじまがっているが、彼にしてみるといい匂いの人間なのだった。"
msgstr ""

#. Occurrence C_0:1081:16744: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0002; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1081
msgctxt "text_id=16744 | speaker=touko"
msgid "「ベオ、昼食は済ませたか？」"
msgstr ""

#. Occurrence C_0:1101:16745: scene=C_0
#: C_0:1101
msgctxt "text_id=16745 | speaker=unknown"
msgid "　廊下の仕掛けが済んだのか、教室に<件|くだん>の主人が入ってくる。"
msgstr ""

#. Occurrence C_0:1118:16746: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0003; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1118
msgctxt "text_id=16746 | speaker=touko"
msgid "「夜が本番だ。それまで、あまりハメを外すなよ」"
msgstr ""

#. Occurrence C_0:1124:16747: scene=C_0
#: C_0:1124
msgctxt "text_id=16747 | speaker=unknown"
msgid "　この通り少々口やかましいところがあるが、彼はこの主人を基本的に気に入っている。"
msgstr ""

#. Occurrence C_0:1144:16748: scene=C_0
#: C_0:1144
msgctxt "text_id=16748 | speaker=unknown"
msgid "　実際のところ、<彼|ベオ>を縛っている彼女の契約はさして強力なものでもない。"
msgstr ""

#. Occurrence C_0:1149:16749: scene=C_0
#: C_0:1149
msgctxt "text_id=16749 | speaker=unknown"
msgid "　<彼|・>が本気になれば<噛|か>み<千|ち><切|ぎ>れる程度のものだ。"
msgstr ""

#. Occurrence C_0:1159:16750: scene=C_0
#: C_0:1159
msgctxt "text_id=16750 | speaker=unknown"
msgid "　彼を縛り付けられる人間などいる筈がない。"
msgstr ""

#. Occurrence C_0:1221:16751: scene=C_0
#: C_0:1221
msgctxt "text_id=16751 | speaker=unknown"
msgid "　が、そうは言っても、橙子を殺して自由になる気もない。"
msgstr ""

#. Occurrence C_0:1226:16752: scene=C_0
#: C_0:1226
msgctxt "text_id=16752 | speaker=unknown"
msgid "　その理由が見あたらない。"
msgstr ""

#. Occurrence C_0:1231:16753: scene=C_0
#: C_0:1231
msgctxt "text_id=16753 | speaker=unknown"
msgid "　彼が人間社会で気ままにやっていくのには、便利な人間が必要なのだ。"
msgstr ""

#. Occurrence C_0:1236:16754: scene=C_0
#: C_0:1236
msgctxt "text_id=16754 | speaker=unknown"
msgid "　よほど彼の気分を害さないかぎり、この主人をどうこうするつもりはない。"
msgstr ""

#. Occurrence C_0:1260:16755: scene=C_0
#: C_0:1260
msgctxt "text_id=16755 | speaker=unknown"
msgid "　もっとも―――"
msgstr ""

#. Occurrence C_0:1298:16756: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0002; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1298
msgctxt "text_id=16756 | speaker=beo"
msgid "「“やっと本番か。<待|・><た|・><せ|・><す|・><ぎ|・>だよ、トーコさん”」"
msgstr ""

#. Occurrence C_0:1303:16757: scene=C_0
#: C_0:1303
msgctxt "text_id=16757 | speaker=unknown"
msgid "　彼を連れ出した時の約束と、現実が少しズレはじめている。"
msgstr ""

#. Occurrence C_0:1310:16758: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0004; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1310
msgctxt "text_id=16758 | speaker=touko"
msgid "“来い。最高の神秘と戦わせてやる”"
msgstr ""

#. Occurrence C_0:1316:16759: scene=C_0
#: C_0:1316
msgctxt "text_id=16759 | speaker=unknown"
msgid "　その口車に乗って今まで従ってきたが、そろそろ我慢の限界だ。待ちに待った昨夜の戦いは特に酷い。“最新の魔法使い”なんて、名前負けもいいところだった。"
msgstr ""

#. Occurrence C_0:1337:16760: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0005; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1337
msgctxt "text_id=16760 | speaker=touko"
msgid "「そう言うな。私も昨日は拍子抜けだったんだから」"
msgstr ""

#. Occurrence C_0:1343:16761: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0003; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1343
msgctxt "text_id=16761 | speaker=beo"
msgid "「“……いいけどね。実はあの娘、使わないんじゃなくて、使えないだけじゃないの？”」"
msgstr ""

#. Occurrence C_0:1368:16762: scene=C_0
#: C_0:1368
msgctxt "text_id=16762 | speaker=unknown"
msgid "　む、と主人の顔が険しくなる。"
msgstr ""

#. Occurrence C_0:1373:16763: scene=C_0
#: C_0:1373
msgctxt "text_id=16763 | speaker=unknown"
msgid "　彼の疑問に賛同しての事ではない。"
msgstr ""

#. Occurrence C_0:1378:16764: scene=C_0
#: C_0:1378
msgctxt "text_id=16764 | speaker=unknown"
msgid "　ソレが<あ|・><る|・>か<な|・><い|・>かの問答など、彼女はとっくに通り越している。"
msgstr ""

#. Occurrence C_0:1424:16765: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0006; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1424
msgctxt "text_id=16765 | speaker=touko"
msgid "「……いや。使うぐらいなら死んだ方がまし……なのかもな」"
msgstr ""

#. Occurrence C_0:1430:16766: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0004; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1430
msgctxt "text_id=16766 | speaker=beo"
msgid "「“？？　そんなバカな事があるの？　使わないと死んじゃう状態だったんだよ？”」"
msgstr ""

#. Occurrence C_0:1441:16767: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0007; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1441
msgctxt "text_id=16767 | speaker=touko"
msgid "「だから、そんなバカな考えが成立するぐらい―――」"
msgstr ""

#. Occurrence C_0:1464:16768: scene=C_0
#: C_0:1464
msgctxt "text_id=16768 | speaker=unknown"
msgid "　おぞましいモノなんだろう、と。"
msgstr ""

#. Occurrence C_0:1469:16769: scene=C_0
#: C_0:1469
msgctxt "text_id=16769 | speaker=unknown"
msgid "　そう口にしかけて、彼女は感傷的な自分を<嘲|わ><笑|ら>うように首を振った。"
msgstr ""

#. Occurrence C_0:1527:16770: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0008; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1527
msgctxt "text_id=16770 | speaker=touko"
msgid "「どれほどのものか想像がつかないのは確かだ。"
msgstr ""

#. Occurrence C_0:1533:16771: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0009; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1533
msgctxt "text_id=16771 | speaker=touko"
msgid "　だがまあ、根本は変わらないさ。魔法がどのような奇跡神秘の類であれ、魔術師である以上、青子に勝ち目はない」"
msgstr ""

#. Occurrence C_0:1571:16772: scene=C_0
#: C_0:1571
msgctxt "text_id=16772 | speaker=unknown"
msgid "　そう残して、彼の主人は教室を後にした。"
msgstr ""

#. Occurrence C_0:1576:16773: scene=C_0
#: C_0:1576
msgctxt "text_id=16773 | speaker=unknown"
msgid "　おまえの相手、おまえの出番は“その一点だけ”と念を押して。"
msgstr ""

#. Occurrence C_0:1654:16774: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0005; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1654
msgctxt "text_id=16774 | speaker=beo"
msgid "「“―――魔法、ねぇ―――”」"
msgstr ""

#. Occurrence C_0:1662:16775: scene=C_0
#: C_0:1662
msgctxt "text_id=16775 | speaker=unknown"
msgid "　退屈に沈んでいた彼の目が、ぐにゃりと<歪|ゆが>む。"
msgstr ""

#. Occurrence C_0:1667:16776: scene=C_0
#: C_0:1667
msgctxt "text_id=16776 | speaker=unknown"
msgid "　昨夜の少女の<腿|あじ>を思い出して、長い舌が、べろりとノコギリのような口を舐める。"
msgstr ""

#. Occurrence C_0:1706:16777: scene=C_0
#: C_0:1706
msgctxt "text_id=16777 | speaker=unknown"
msgid "　もちろん、言われるまでもなく<蹂躙|じゅうりん>しよう。"
msgstr ""

#. Occurrence C_0:1711:16778: scene=C_0
#: C_0:1711
msgctxt "text_id=16778 | speaker=unknown"
msgid "　彼は最古の人狼、黄金の森の神。"
msgstr ""

#. Occurrence C_0:1716:16779: scene=C_0
#: C_0:1716
msgctxt "text_id=16779 | speaker=unknown"
msgid "　物心ついた時―――いや、この地上に発生した時から、自身が“最も強い生き物の一つ”だと認識している。"
msgstr ""

#. Occurrence C_0:1747:16780: scene=C_0
#: C_0:1747
msgctxt "text_id=16780 | speaker=unknown"
msgid "　彼からすれば人間の手による神秘など<塵芥|ちりあくた>も同然。"
msgstr ""

#. Occurrence C_0:1752:16781: scene=C_0
#: C_0:1752
msgctxt "text_id=16781 | speaker=unknown"
msgid "　魔術など無駄であり、その上にある神秘―――人造の奇跡など無用だ。存在すら気にくわない。"
msgstr ""

#. Occurrence C_0:1801:16782: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0006; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1801
msgctxt "text_id=16782 | speaker=beo"
msgid "「“……もちろん。そういう契約だし、ちゃんと<平|たい>らげはするけれど”」"
msgstr ""

#. Occurrence C_0:1810:16783: scene=C_0
#: C_0:1810
msgctxt "text_id=16783 | speaker=unknown"
msgid "　契約はそこまで。"
msgstr ""

#. Occurrence C_0:1815:16784: scene=C_0
#: C_0:1815
msgctxt "text_id=16784 | speaker=unknown"
msgid "　魔法とやらを食い破った後、どうするかは彼の自由だ。"
msgstr ""

#. Occurrence C_0:1844:16785: scene=C_0
#: C_0:1844
msgctxt "text_id=16785 | speaker=unknown"
msgid "　……いびつな瞳に、狼の<彩|いろ>が宿る。"
msgstr ""

#. Occurrence C_0:1849:16786: scene=C_0
#: C_0:1849
msgctxt "text_id=16786 | speaker=unknown"
msgid "　それは<淫蕩|いんとう>に<耽|ふけ>る、<嗜虐|しぎゃく>に満ちた、<卑|いや>しい獣の笑みだった。"
msgstr ""

#. Occurrence C_1:63:16787: scene=C_1
#: C_1:63
msgctxt "text_id=16787 | speaker=unknown"
msgid "　午後七時過ぎ。"
msgstr ""

#. Occurrence C_1:68:16788: scene=C_1
#: C_1:68
msgctxt "text_id=16788 | speaker=unknown"
msgid "　三咲高校の校舎は、完全に<睡没|すいぼつ>していた。"
msgstr ""

#. Occurrence C_1:73:16789: scene=C_1
#: C_1:73
msgctxt "text_id=16789 | speaker=unknown"
msgid "　街から夜の明かりは届いているものの、校舎周辺の山林は静まりかえっている。"
msgstr ""

#. Occurrence C_1:116:16790: scene=C_1
#: C_1:116
msgctxt "text_id=16790 | speaker=unknown"
msgid "　それも無理からぬ事だ。"
msgstr ""

#. Occurrence C_1:121:16791: scene=C_1
#: C_1:121
msgctxt "text_id=16791 | speaker=unknown"
msgid "　冬休み中、校舎は数えるほどしか使われておらず、校庭は昨夜からの雪に包まれている。"
msgstr ""

#. Occurrence C_1:126:16792: scene=C_1
#: C_1:126
msgctxt "text_id=16792 | speaker=unknown"
msgid "　……使う者のいない建造物は、その時点で<慰霊碑|モニュメント>と変わらなくなる。"
msgstr ""

#. Occurrence C_1:131:16793: scene=C_1
#: C_1:131
msgctxt "text_id=16793 | speaker=unknown"
msgid "　いま死者に近いこの建物は、新学期まで息を吹き返す事はない。"
msgstr ""

#. Occurrence C_1:177:16794: scene=C_1
#: C_1:177
msgctxt "text_id=16794 | speaker=unknown"
msgid "　その背後に広がる森は、更に闇を増している。"
msgstr ""

#. Occurrence C_1:182:16795: scene=C_1
#: C_1:182
msgctxt "text_id=16795 | speaker=unknown"
msgid "　二週間たらずの休みで校舎が死に絶えるのなら、数年にわたり忘れ去られてきた森は如何なるものか。"
msgstr ""

#. Occurrence C_1:203:16796: scene=C_1
#: C_1:203
msgctxt "text_id=16796 | speaker=unknown"
msgid "　木々の壁の向こうは、街の喧噪はおろか、月明かりでさえ入れずにいる。"
msgstr ""

#. Occurrence C_1:208:16797: scene=C_1
#: C_1:208
msgctxt "text_id=16797 | speaker=unknown"
msgid "　人々の住まう町から、三キロも離れていない魔境。"
msgstr ""

#. Occurrence C_1:213:16798: scene=C_1
#: C_1:213
msgctxt "text_id=16798 | speaker=unknown"
msgid "　そんな、しんしんと凍てつく夜気の中、新雪を踏みしだく足音が二つ。"
msgstr ""

#. Occurrence C_1:251:16799: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0000; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:251
msgctxt "text_id=16799 | speaker=alice"
msgid "「このあたりに仕掛けはなさそうね。"
msgstr ""

#. Occurrence C_1:260:16800: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0001; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:260
msgctxt "text_id=16800 | speaker=alice"
msgid "　……それで、どうするの？　このまま旧校舎に忍びこむ？」"
msgstr ""

#. Occurrence C_1:297:16801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0000; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:297
msgctxt "text_id=16801 | speaker=aoko"
msgid "「まさか。私らがやってきたコトなんて、とっくにバレてるわ。"
msgstr ""

#. Occurrence C_1:304:16802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0001; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:304
msgctxt "text_id=16802 | speaker=aoko"
msgid "隠れても意味はないし、なにより、敵の<工房|アジト>に入ってどうするのよ。盗みが目的じゃないでしょ、今回は」"
msgstr ""

#. Occurrence C_1:338:16803: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0002; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:338
msgctxt "text_id=16803 | speaker=alice"
msgid "「……後ろから斬りつけるのは、強盗と言うのじゃなくて？」"
msgstr ""

#. Occurrence C_1:384:16804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0002; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:384
msgctxt "text_id=16804 | speaker=aoko"
msgid "「……それができれば苦労はないんだけどね。まあ、忍者の真似事は私……というか、有珠の芸風じゃないでしょ。"
msgstr ""

#. Occurrence C_1:390:16805: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0003; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:390
msgctxt "text_id=16805 | speaker=aoko"
msgid "　そもそも―――」"
msgstr ""

#. Occurrence C_1:427:16806: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0004; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:427
msgctxt "text_id=16806 | speaker=aoko"
msgid "「―――そもそも。"
msgstr ""

#. Occurrence C_1:433:16807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0005; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:433
msgctxt "text_id=16807 | speaker=aoko"
msgid "　やる気満々なのは、こっちもあっちも同じってコト」"
msgstr ""

#. Occurrence C_1:439:16808: scene=C_1
#: C_1:439
msgctxt "text_id=16808 | speaker=unknown"
msgid "　雪を踏むふたりの足音が、言い合わせたように停止する。"
msgstr ""

#. Occurrence C_1:479:16809: scene=C_1
#: C_1:479
msgctxt "text_id=16809 | speaker=unknown"
msgid "　三咲高校の裏山に残る旧校舎。"
msgstr ""

#. Occurrence C_1:484:16810: scene=C_1
#: C_1:484
msgctxt "text_id=16810 | speaker=unknown"
msgid "　かつての<校庭|グラウンド>は一面の雪原となっていた。"
msgstr ""

#. Occurrence C_1:489:16811: scene=C_1
#: C_1:489
msgctxt "text_id=16811 | speaker=unknown"
msgid "　森に取り残された建物は、もの言わぬ死者のようだ。"
msgstr ""

#. Occurrence C_1:494:16812: scene=C_1
#: C_1:494
msgctxt "text_id=16812 | speaker=unknown"
msgid "　そんな時代の残骸を<祀|まつ>るように、木々は壁となって周囲を<覆|おお>っている。"
msgstr ""

#. Occurrence C_1:532:16813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0000; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:532
msgctxt "text_id=16813 | speaker=touko"
msgid "「せっかちなお嬢さん<方|がた>だ。タイムリミットまで、あと四時間はあるというのに」"
msgstr ""

#. Occurrence C_1:568:16814: scene=C_1
#: C_1:568
msgctxt "text_id=16814 | speaker=unknown"
msgid "　その白い祭壇の中心に、橙色の魔術師が一人。"
msgstr ""

#. Occurrence C_1:573:16815: scene=C_1
#: C_1:573
msgctxt "text_id=16815 | speaker=unknown"
msgid "　森を抜けてきた少女―――蒼崎青子はわずかに腰を落として、遠方の標的を睨む。"
msgstr ""

#. Occurrence C_1:578:16816: scene=C_1
#: C_1:578
msgctxt "text_id=16816 | speaker=unknown"
msgid "　青子の<傍|かたわ>らに立つ久遠寺有珠は指一本動かさない。"
msgstr ""

#. Occurrence C_1:603:16817: scene=C_1
#: C_1:603
msgctxt "text_id=16817 | speaker=unknown"
msgid "　枝葉を落とした木々の影は<茨|いばら>を思わせる。"
msgstr ""

#. Occurrence C_1:608:16818: scene=C_1
#: C_1:608
msgctxt "text_id=16818 | speaker=unknown"
msgid "　眠り続ける姫の童話を連想した青子だが、あの魔術師はお姫さまほど<幸福|しあわせ>な性格はしていなかったらしい。"
msgstr ""

#. Occurrence C_1:613:16819: scene=C_1
#: C_1:613
msgctxt "text_id=16819 | speaker=unknown"
msgid "　王子を待つのも、眠っているのも性に合わない、と。"
msgstr ""

#. Occurrence C_1:618:16820: scene=C_1
#: C_1:618
msgctxt "text_id=16820 | speaker=unknown"
msgid "　旧校舎という城に棲んでいた姫は、現れた挑戦者を堂々と出迎えたのだから。"
msgstr ""

#. Occurrence C_1:669:16821: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0001; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:669
msgctxt "text_id=16821 | speaker=touko"
msgid "「その体で無理をして。"
msgstr ""

#. Occurrence C_1:675:16822: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0002; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:675
msgctxt "text_id=16822 | speaker=touko"
msgid "　貴女のそういうところ、姉としてどうかと思うわ青子」"
msgstr ""

#. Occurrence C_1:694:16823: scene=C_1
#: C_1:694
msgctxt "text_id=16823 | speaker=unknown"
msgid "　橙子は微笑みを浮かべている。"
msgstr ""

#. Occurrence C_1:699:16824: scene=C_1
#: C_1:699
msgctxt "text_id=16824 | speaker=unknown"
msgid "　文句のひとつでも返したい青子だが、ここは我慢と口を<噤|つぐ>んだ。"
msgstr ""

#. Occurrence C_1:704:16825: scene=C_1
#: C_1:704
msgctxt "text_id=16825 | speaker=unknown"
msgid "　有珠は一律で無言。両者の因縁に関心はないと、その態度で示している。"
msgstr ""

#. Occurrence C_1:751:16826: scene=C_1
#: C_1:751
msgctxt "text_id=16826 | speaker=unknown"
msgid "　両陣営の距離は三十メートルほど。"
msgstr ""

#. Occurrence C_1:756:16827: scene=C_1
#: C_1:756
msgctxt "text_id=16827 | speaker=unknown"
msgid "　互いの声が届くのは森の静けさと、魔術によって強化された五感の<賜|たまもの>だ。"
msgstr ""

#. Occurrence C_1:762:16828: scene=C_1
#: C_1:762
msgctxt "text_id=16828 | speaker=unknown"
msgid "　蒼崎橙子の<傍|かたわ>らに金狼の姿はない。"
msgstr ""

#. Occurrence C_1:767:16829: scene=C_1
#: C_1:767
msgctxt "text_id=16829 | speaker=unknown"
msgid "　彼女は体ひとつで青子たちと対峙している。"
msgstr ""

#. Occurrence C_1:825:16830: scene=C_1
#: C_1:825
msgctxt "text_id=16830 | speaker=unknown"
msgid "　有珠は黒い<外套|コート>に帽子をかぶった、典型的な魔術戦の出で立ち。"
msgstr ""

#. Occurrence C_1:830:16831: scene=C_1
#: C_1:830
msgctxt "text_id=16831 | speaker=unknown"
msgid "　その有珠より半歩前に出ている青子の服装は、場にそぐわない事この上ない、三咲高校の学生服だ。"
msgstr ""

#. Occurrence C_1:875:16832: scene=C_1
#: C_1:875
msgctxt "text_id=16832 | speaker=unknown"
msgid "　有珠に着替えを持ってくるよう頼んだところ、何を勘違いしたのか、私服ではなく制服を持ってきた為である。"
msgstr ""

#. Occurrence C_1:881:16833: scene=C_1
#: C_1:881
msgctxt "text_id=16833 | speaker=unknown"
msgid "　そんな些細な事情なのだが、橙子は特別な意味があると見たらしい。"
msgstr ""

#. Occurrence C_1:927:16834: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0003; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:927
msgctxt "text_id=16834 | speaker=touko"
msgid "「ところで、始める前にひとついいかな。"
msgstr ""

#. Occurrence C_1:943:16835: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0004; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:943
msgctxt "text_id=16835 | speaker=touko"
msgid "　気になって仕方がないし、この先、機会もないだろうから訊くんだけど……貴女の戦闘服ってそれなの、青子？」"
msgstr ""

#. Occurrence C_1:970:16836: scene=C_1
#: C_1:970
msgctxt "text_id=16836 | speaker=unknown"
msgid "　離れた距離も関係なく、橙子の声はよく響いた。"
msgstr ""

#. Occurrence C_1:975:16837: scene=C_1
#: C_1:975
msgctxt "text_id=16837 | speaker=unknown"
msgid "　心底から不快そうな、侮辱というより軽蔑すらこもった<韻|いん>も、のこさず聞き取れる。"
msgstr ""

#. Occurrence C_1:1005:16838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0006; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1005
msgctxt "text_id=16838 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence C_1:1010:16839: scene=C_1
#: C_1:1010
msgctxt "text_id=16839 | speaker=unknown"
msgid "　無駄話はせず、ほぼ奇襲のカタチで橙子を仕留めるつもりだった青子だが、さすがに今のは無視できない。"
msgstr ""

#. Occurrence C_1:1038:16840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0007; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1038
msgctxt "text_id=16840 | speaker=aoko"
msgid "「そんなワケないでしょ。今までこういう機会が多かっただけよ。数えるなら今日を含めて四回しかないわ。"
msgstr ""

#. Occurrence C_1:1051:16841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0008; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1051
msgctxt "text_id=16841 | speaker=aoko"
msgid "　……ま、私はまだ<現|・><役|・>だからそれも悪くはないかもしれないけど？　いつか流行るでしょ、こういうのも」"
msgstr ""

#. Occurrence C_1:1064:16842: scene=C_1
#: C_1:1064
msgctxt "text_id=16842 | speaker=unknown"
msgid "　現役、という単語を強調する青子。"
msgstr ""

#. Occurrence C_1:1069:16843: scene=C_1
#: C_1:1069
msgctxt "text_id=16843 | speaker=unknown"
msgid "　一瞬、橙子の瞳が青子もかくやといった鋭さを帯びた。"
msgstr ""

#. Occurrence C_1:1107:16844: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0005; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1107
msgctxt "text_id=16844 | speaker=touko"
msgid "「……呆れたな。あいかわらずのローセンスだ」"
msgstr ""

#. Occurrence C_1:1130:16845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0009; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1130
msgctxt "text_id=16845 | speaker=aoko"
msgid "「それはどうも、人形を実の妹に見立てる異常者にそう言われるなら、一周まわって安心よ」"
msgstr ""

#. Occurrence C_1:1143:16846: scene=C_1
#: C_1:1143
msgctxt "text_id=16846 | speaker=unknown"
msgid "　それきり、ふたりは無言で見つめ合った。"
msgstr ""

#. Occurrence C_1:1148:16847: scene=C_1
#: C_1:1148
msgctxt "text_id=16847 | speaker=unknown"
msgid "　凍える大気に、<姉妹|しまい>間<独特|どくとく>の殺意が火花を散らす。"
msgstr ""

#. Occurrence C_1:1226:16848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0003; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:1226
msgctxt "text_id=16848 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence C_1:1232:16849: scene=C_1
#: C_1:1232
msgctxt "text_id=16849 | speaker=unknown"
msgid "　ふたりが<牽制|けんせい>し合う中、有珠は<橙|て><子|き>の周囲を解析する。"
msgstr ""

#. Occurrence C_1:1252:16850: scene=C_1
#: C_1:1252
msgctxt "text_id=16850 | speaker=unknown"
msgid "　……橙子の周りに何者かが<潜|ひそ>んでいる気配はない。"
msgstr ""

#. Occurrence C_1:1257:16851: scene=C_1
#: C_1:1257
msgctxt "text_id=16851 | speaker=unknown"
msgid "　人狼はいまだ旧校舎に残っていると見るべきか。"
msgstr ""

#. Occurrence C_1:1263:16852: scene=C_1
#: C_1:1263
msgctxt "text_id=16852 | speaker=unknown"
msgid "　傷ついた青子と有珠、二人でようやく一人分の戦力と見ているのか―――"
msgstr ""

#. Occurrence C_1:1269:16853: scene=C_1
#: C_1:1269
msgctxt "text_id=16853 | speaker=unknown"
msgid "それとも本当に、この時間での反撃を予測しておらず、人狼の準備が整っていないのか。"
msgstr ""

#. Occurrence C_1:1301:16854: scene=C_1
#: C_1:1301
msgctxt "text_id=16854 | speaker=unknown"
msgid "　静かな心持ちで、有珠は前者だと判断した。"
msgstr ""

#. Occurrence C_1:1306:16855: scene=C_1
#: C_1:1306
msgctxt "text_id=16855 | speaker=unknown"
msgid "　敵は<単身|ひとり>で戦うつもりだ。"
msgstr ""

#. Occurrence C_1:1311:16856: scene=C_1
#: C_1:1311
msgctxt "text_id=16856 | speaker=unknown"
msgid "　<橙|て><子|き>の武装は、魔眼と修得しているルーン。"
msgstr ""

#. Occurrence C_1:1316:16857: scene=C_1
#: C_1:1316
msgctxt "text_id=16857 | speaker=unknown"
msgid "　それだけで現状の青子と有珠を処理して余りあるのだから。"
msgstr ""

#. Occurrence C_1:1336:16858: scene=C_1
#: C_1:1336
msgctxt "text_id=16858 | speaker=unknown"
msgid "“―――有珠。初撃で決めるから”"
msgstr ""

#. Occurrence C_1:1362:16859: scene=C_1
#: C_1:1362
msgctxt "text_id=16859 | speaker=unknown"
msgid "　青子は背後の有珠へ、指先の動きだけでそう伝えた。"
msgstr ""

#. Occurrence C_1:1367:16860: scene=C_1
#: C_1:1367
msgctxt "text_id=16860 | speaker=unknown"
msgid "　有珠に異論はない。"
msgstr ""

#. Occurrence C_1:1372:16861: scene=C_1
#: C_1:1372
msgctxt "text_id=16861 | speaker=unknown"
msgid "　……当初の予定では人狼は有珠が引き付け、"
msgstr ""

#. Occurrence C_1:1377:16862: scene=C_1
#: C_1:1377
msgctxt "text_id=16862 | speaker=unknown"
msgid "　青子は『鏡』のバックアップを受けつつ、橙子を奇襲する算段だった。"
msgstr ""

#. Occurrence C_1:1397:16863: scene=C_1
#: C_1:1397
msgctxt "text_id=16863 | speaker=unknown"
msgid "　他にも幾つか奥の手はあったが、青子たちが魔術師である以上、何であれ人狼には通じない。"
msgstr ""

#. Occurrence C_1:1402:16864: scene=C_1
#: C_1:1402
msgctxt "text_id=16864 | speaker=unknown"
msgid "　なので人狼は無視し、橙子のみを標的にする。"
msgstr ""

#. Occurrence C_1:1407:16865: scene=C_1
#: C_1:1407
msgctxt "text_id=16865 | speaker=unknown"
msgid "　都合のいい作戦ではあるが、ふたりにはそれしか選択の余地はなかったのだ。"
msgstr ""

#. Occurrence C_1:1456:16866: scene=C_1
#: C_1:1456
msgctxt "text_id=16866 | speaker=unknown"
msgid "　……が、事態は想定していたものと違っていた。"
msgstr ""

#. Occurrence C_1:1461:16867: scene=C_1
#: C_1:1461
msgctxt "text_id=16867 | speaker=unknown"
msgid "　橙子は自軍の有利性から、人狼の出陣を<渋|しぶ>っている。"
msgstr ""

#. Occurrence C_1:1467:16868: scene=C_1
#: C_1:1467
msgctxt "text_id=16868 | speaker=unknown"
msgid "　ならば、と青子は即断した。"
msgstr ""

#. Occurrence C_1:1472:16869: scene=C_1
#: C_1:1472
msgctxt "text_id=16869 | speaker=unknown"
msgid "　<和気藹々|わきあいあい>とした姉妹の談話の隙をついて、人狼が出てくる前に決着をつけるのみ、と。"
msgstr ""

#. Occurrence C_1:1516:16870: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0011; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1516
msgctxt "text_id=16870 | speaker=aoko"
msgid "「じゃあ今度はこっちの番ね。"
msgstr ""

#. Occurrence C_1:1560:16871: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0012; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1560
msgctxt "text_id=16871 | speaker=aoko"
msgid "　どう、結界の張り直しは進んでる？」"
msgstr ""

#. Occurrence C_1:1599:16872: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0006; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1599
msgctxt "text_id=16872 | speaker=touko"
msgid "「まさか、昨日の今日よ。まだ手を付けてもいない。<急|せ>いては事をし損じる。"
msgstr ""

#. Occurrence C_1:1606:16873: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0007; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1606
msgctxt "text_id=16873 | speaker=touko"
msgid "だいたい、私の目的は霊脈の奥にあるもので結界そのものじゃない。張り直しは予定にないさ。"
msgstr ""

#. Occurrence C_1:1617:16874: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0008; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1617
msgctxt "text_id=16874 | speaker=touko"
msgid "　まあ―――土地を<暴|あば>くなんて面倒な真似をするより、<貴女|おまえ>を暴いた方が早いのかもしれないが」"
msgstr ""

#. Occurrence C_1:1668:16875: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0013; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1668
msgctxt "text_id=16875 | speaker=aoko"
msgid "「ふん、やっぱりそれが目的だったのね。"
msgstr ""

#. Occurrence C_1:1674:16876: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0014; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1674
msgctxt "text_id=16876 | speaker=aoko"
msgid "　……なら尚のこと、アンタを魔法使いにするワケにはいかないわ」"
msgstr ""

#. Occurrence C_1:1718:16877: scene=C_1
#: C_1:1718
msgctxt "text_id=16877 | speaker=unknown"
msgid "　青い瞳に明確な戦意が<宿|やど>る。"
msgstr ""

#. Occurrence C_1:1723:16878: scene=C_1
#: C_1:1723
msgctxt "text_id=16878 | speaker=unknown"
msgid "　今まさに仕掛けてきそうな妹の様子を見ても、橙子に動きはない。その唇が皮肉げに動くだけだ。"
msgstr ""

#. Occurrence C_1:1744:16879: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0009; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1744
msgctxt "text_id=16879 | speaker=touko"
msgid "「魔法使い、か。たしかにまだ執着はあるね。"
msgstr ""

#. Occurrence C_1:1750:16880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0010; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1750
msgctxt "text_id=16880 | speaker=touko"
msgid "　私には移植されなかった魔術刻印と、蒼崎の伝える魔法の正体。"
msgstr ""

#. Occurrence C_1:1757:16881: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0011; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1757
msgctxt "text_id=16881 | speaker=touko"
msgid "だがもういいよ。欲しくはあるが、<到|・><達|・><す|・><れ|・><ば|・>どちらも自分で用意できる。"
msgstr ""

#. Occurrence C_1:1784:16882: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0012; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1784
msgctxt "text_id=16882 | speaker=touko"
msgid "　それとも……今ここで、私の為に魔法の正体を見せてくれるのかい、青子？」"
msgstr ""

#. Occurrence C_1:1804:16883: scene=C_1
#: C_1:1804
msgctxt "text_id=16883 | speaker=unknown"
msgid "　橙子の瞳は、言葉とは裏腹に青子を<嘲|あざけ>っていた。"
msgstr ""

#. Occurrence C_1:1814:16884: scene=C_1
#: C_1:1814
msgctxt "text_id=16884 | speaker=unknown"
msgid "　……青子が<橙|て><子|き>を排除したいのなら、正体の分からない『魔法』を使うのが最良であり、確実だ。"
msgstr ""

#. Occurrence C_1:1819:16885: scene=C_1
#: C_1:1819
msgctxt "text_id=16885 | speaker=unknown"
msgid "　だが青子にはそれが出来ない。"
msgstr ""

#. Occurrence C_1:1824:16886: scene=C_1
#: C_1:1824
msgctxt "text_id=16886 | speaker=unknown"
msgid "　出来るのなら昨夜の窮地で使用している。"
msgstr ""

#. Occurrence C_1:1872:16887: scene=C_1
#: C_1:1872
msgctxt "text_id=16887 | speaker=unknown"
msgid "　蒼崎青子は魔法を使用できない。"
msgstr ""

#. Occurrence C_1:1877:16888: scene=C_1
#: C_1:1877
msgctxt "text_id=16888 | speaker=unknown"
msgid "　橙子はそれを何らかの条件付けと考えた。"
msgstr ""

#. Occurrence C_1:1882:16889: scene=C_1
#: C_1:1882
msgctxt "text_id=16889 | speaker=unknown"
msgid "　祖父の<術式防護|プロテクト>が、安易な奇跡の発現を禁じているのだと。"
msgstr ""

#. Occurrence C_1:1889:16890: scene=C_1
#: C_1:1889
msgctxt "text_id=16890 | speaker=unknown"
msgid "　だが―――あの<祖父|おとこ>は、人の世を<顧|かえり>みる人格者ではない。"
msgstr ""

#. Occurrence C_1:1895:16891: scene=C_1
#: C_1:1895
msgctxt "text_id=16891 | speaker=unknown"
msgid "　大げさな話でなく、魔法の発現でこの街が消え去っても何の感慨も浮かべまい。"
msgstr ""

#. Occurrence C_1:1915:16892: scene=C_1
#: C_1:1915
msgctxt "text_id=16892 | speaker=unknown"
msgid "　初めから、<魔|・><法|・><に|・><条|・><件|・><付|・><け|・><な|・><ど|・><な|・><い|・>。"
msgstr ""

#. Occurrence C_1:1963:16893: scene=C_1
#: C_1:1963
msgctxt "text_id=16893 | speaker=unknown"
msgid "　青子を縛っているものはトラウマにすぎない。"
msgstr ""

#. Occurrence C_1:1968:16894: scene=C_1
#: C_1:1968
msgctxt "text_id=16894 | speaker=unknown"
msgid "　地上でただ五つの特権を、精神的な<枷|かせ>で縛っている。"
msgstr ""

#. Occurrence C_1:1973:16895: scene=C_1
#: C_1:1973
msgctxt "text_id=16895 | speaker=unknown"
msgid "　故に、橙子の瞳は未熟な妹を<嘲|あざけ>るのだ。"
msgstr ""

#. Occurrence C_1:1978:16896: scene=C_1
#: C_1:1978
msgctxt "text_id=16896 | speaker=unknown"
msgid "　その弱さ。人の身に背負いきれない『魔法』なぞ、一振りの剣にも劣ると。"
msgstr ""

#. Occurrence C_1:2049:16897: scene=C_1
#: C_1:2049
msgctxt "text_id=16897 | speaker=unknown"
msgid "　それを何よりも自覚しているからこそ、青子にはその嘲笑は許せない。"
msgstr ""

#. Occurrence C_1:2054:16898: scene=C_1
#: C_1:2054
msgctxt "text_id=16898 | speaker=unknown"
msgid "　魔法を使ってみせろ？"
msgstr ""

#. Occurrence C_1:2091:16899: scene=C_1
#: C_1:2091
msgctxt "text_id=16899 | speaker=unknown"
msgid "　なんて安い挑発。"
msgstr ""

#. Occurrence C_1:2096:16900: scene=C_1
#: C_1:2096
msgctxt "text_id=16900 | speaker=unknown"
msgid "　そんなもの、言われるまでもなく―――"
msgstr ""

#. Occurrence C_1:2119:16901: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0015; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:2119
msgctxt "text_id=16901 | speaker=aoko"
msgid "「ええ、お望みとあらばね――――――！」"
msgstr ""

#. Occurrence C_1:2182:16902: scene=C_1
#: C_1:2182
msgctxt "text_id=16902 | speaker=unknown"
msgid "　切りつけんばかりの殺気と共に、青子はスタートをきった。"
msgstr ""

#. Occurrence C_1:2199:16903: scene=C_1
#: C_1:2199
msgctxt "text_id=16903 | speaker=unknown"
msgid "　―――<未到|みとう>の雪原に、無色の靴が駆け抜ける。"
msgstr ""

#. Occurrence C_1:2250:16904: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0013; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2250
msgctxt "text_id=16904 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_1:2255:16905: scene=C_1
#: C_1:2255
msgctxt "text_id=16905 | speaker=unknown"
msgid "　まるで<水面|みなも>の飛び石だ。"
msgstr ""

#. Occurrence C_1:2260:16906: scene=C_1
#: C_1:2260
msgctxt "text_id=16906 | speaker=unknown"
msgid "　高速で橙子に向かう青子の体は、完全に“消失”していた。"
msgstr ""

#. Occurrence C_1:2280:16907: scene=C_1
#: C_1:2280
msgctxt "text_id=16907 | speaker=unknown"
msgid "　足跡だけが<弾痕|だんこん>のように迫ってくる。"
msgstr ""

#. Occurrence C_1:2285:16908: scene=C_1
#: C_1:2285
msgctxt "text_id=16908 | speaker=unknown"
msgid "　それを橙子は不動のまま待ち受けた。"
msgstr ""

#. Occurrence C_1:2316:16909: scene=C_1
#: C_1:2316
msgctxt "text_id=16909 | speaker=unknown"
msgid "　姿隠しは簡単な魔術だ。"
msgstr ""

#. Occurrence C_1:2321:16910: scene=C_1
#: C_1:2321
msgctxt "text_id=16910 | speaker=unknown"
msgid "　おそらくは有珠が用意した小道具の力だろう。"
msgstr ""

#. Occurrence C_1:2326:16911: scene=C_1
#: C_1:2326
msgctxt "text_id=16911 | speaker=unknown"
msgid "　単純だが、効果的な魔眼対策である。"
msgstr ""

#. Occurrence C_1:2331:16912: scene=C_1
#: C_1:2331
msgctxt "text_id=16912 | speaker=unknown"
msgid "　<捕縛|ロック>の呪いに特化した橙子の魔眼は、不正を<見|み><抜|ぬ>き<明|あき>らかにする“<真理|ロゴス>”の特性を持っていない。"
msgstr ""

#. Occurrence C_1:2336:16913: scene=C_1
#: C_1:2336
msgctxt "text_id=16913 | speaker=unknown"
msgid "　仕組みを知られた魔術は、このようにたやすく打破される。"
msgstr ""

#. Occurrence C_1:2388:16914: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0014; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2388
msgctxt "text_id=16914 | speaker=touko"
msgid "“足癖が悪いのも変わらず、か”"
msgstr ""

#. Occurrence C_1:2394:16915: scene=C_1
#: C_1:2394
msgctxt "text_id=16915 | speaker=unknown"
msgid "　既に四秒。十メートルもの距離を<詰|つ>め、さらに加速する姿なき襲撃者。"
msgstr ""

#. Occurrence C_1:2399:16916: scene=C_1
#: C_1:2399
msgctxt "text_id=16916 | speaker=unknown"
msgid "　魔術戦では敵わぬと見て、殴り合いならぬ蹴り合いを挑むつもりらしい。"
msgstr ""

#. Occurrence C_1:2404:16917: scene=C_1
#: C_1:2404
msgctxt "text_id=16917 | speaker=unknown"
msgid "　もう一人の少女、久遠寺有珠は一歩も動かず。"
msgstr ""

#. Occurrence C_1:2438:16918: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0015; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2438
msgctxt "text_id=16918 | speaker=touko"
msgid "“<被弾|ひだん>覚悟の特攻―――有珠から護符でも貰っているのでしょうけど、反省なさい青子。"
msgstr ""

#. Occurrence C_1:2445:16919: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0016; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2445
msgctxt "text_id=16919 | speaker=touko"
msgid "切札というものは、あくまで自己の力によるものを言うのよ”"
msgstr ""

#. Occurrence C_1:2451:16920: scene=C_1
#: C_1:2451
msgctxt "text_id=16920 | speaker=unknown"
msgid "　くっ、と口端をつり上げて橙子は左腕を構えた。"
msgstr ""

#. Occurrence C_1:2456:16921: scene=C_1
#: C_1:2456
msgctxt "text_id=16921 | speaker=unknown"
msgid "　なぎ払うように、胸の前で水平に。"
msgstr ""

#. Occurrence C_1:2491:16922: scene=C_1
#: C_1:2491
msgctxt "text_id=16922 | speaker=unknown"
msgid "　残り十メートル。"
msgstr ""

#. Occurrence C_1:2496:16923: scene=C_1
#: C_1:2496
msgctxt "text_id=16923 | speaker=unknown"
msgid "　本来なら不可視の青子の<位置|すがた>は、不運にも足跡が十分に示していた。"
msgstr ""

#. Occurrence C_1:2530:16924: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0017; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2530
msgctxt "text_id=16924 | speaker=touko"
msgid "「<[swel]|ソウ>―――」"
msgstr ""

#. Occurrence C_1:2564:16925: scene=C_1
#: C_1:2564
msgctxt "text_id=16925 | speaker=unknown"
msgid "　ルーンの呪詛を<刻|きざ>む橙子。"
msgstr ""

#. Occurrence C_1:2569:16926: scene=C_1
#: C_1:2569
msgctxt "text_id=16926 | speaker=unknown"
msgid "　それより早く、青子の足跡はぴたりと止まった。"
msgstr ""

#. Occurrence C_1:2580:16927: scene=C_1
#: C_1:2580
msgctxt "text_id=16927 | speaker=unknown"
msgid "　格闘戦を行うにはまだ遠すぎる。"
msgstr ""

#. Occurrence C_1:2585:16928: scene=C_1
#: C_1:2585
msgctxt "text_id=16928 | speaker=unknown"
msgid "　あの位置で止まるのはあまりに不可解。"
msgstr ""

#. Occurrence C_1:2590:16929: scene=C_1
#: C_1:2590
msgctxt "text_id=16929 | speaker=unknown"
msgid "　いや。それ以前に、あのスピードで急停止などできるものだろうか……？"
msgstr ""

#. Occurrence C_1:2615:16930: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0018; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2615
msgctxt "text_id=16930 | speaker=touko"
msgid "“跳んだか―――！”"
msgstr ""

#. Occurrence C_1:2663:16931: scene=C_1
#: C_1:2663
msgctxt "text_id=16931 | speaker=unknown"
msgid "　一瞬の判断。"
msgstr ""

#. Occurrence C_1:2668:16932: scene=C_1
#: C_1:2668
msgctxt "text_id=16932 | speaker=unknown"
msgid "　水平に構えられた橙子の腕が、月を<仰|あお>ぐよう上空に向けられる。"
msgstr ""

#. Occurrence C_1:2715:16933: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0019; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2715
msgctxt "text_id=16933 | speaker=touko"
msgid "「<[swel]|ソウェル>―――！」"
msgstr ""

#. Occurrence C_1:2818:16934: scene=C_1
#: C_1:2818
msgctxt "text_id=16934 | speaker=unknown"
msgid "　大気を<滑|はし>る、<劫火|ごうか>の導線。"
msgstr ""

#. Occurrence C_1:2823:16935: scene=C_1
#: C_1:2823
msgctxt "text_id=16935 | speaker=unknown"
msgid "　<刻印|ルーン>は空中の見えざる人体に<刻|きざ>まれ、わずか一秒で炎を巻き起こした。"
msgstr ""

#. Occurrence C_1:2828:16936: scene=C_1
#: C_1:2828
msgctxt "text_id=16936 | speaker=unknown"
msgid "　内部からの魔術抵抗は意味をなさない。"
msgstr ""

#. Occurrence C_1:2833:16937: scene=C_1
#: C_1:2833
msgctxt "text_id=16937 | speaker=unknown"
msgid "　ルーンは対象を燃やしたのではなく、対象を炎で包み込んだのだから。"
msgstr ""

#. Occurrence C_1:2946:16938: scene=C_1
#: C_1:2946
msgctxt "text_id=16938 | speaker=unknown"
msgid "　悲鳴をあげて雪原に落ちる襲撃者。"
msgstr ""

#. Occurrence C_1:2951:16939: scene=C_1
#: C_1:2951
msgctxt "text_id=16939 | speaker=unknown"
msgid "　<苦悶|くもん>に荒れ狂う体、助けを<乞|こ>うように<掲|かか>げられる手は、夢に出てきそうなほど見苦しい。"
msgstr ""

#. Occurrence C_1:2956:16940: scene=C_1
#: C_1:2956
msgctxt "text_id=16940 | speaker=unknown"
msgid "　炎は消えず、積もった雪を溶かしながら、襲撃者は息絶えるまであぶられ続ける。"
msgstr ""

#. Occurrence C_1:2963:16941: scene=C_1
#: C_1:2963
msgctxt "text_id=16941 | speaker=unknown"
msgid "　チチチ、チチチと。"
msgstr ""

#. Occurrence C_1:2968:16942: scene=C_1
#: C_1:2968
msgctxt "text_id=16942 | speaker=unknown"
msgid "　青子らしからぬ、あまりにも大げさな<三流芝居|だんまつま>をあげながら。"
msgstr ""

#. Occurrence C_1:3006:16943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0020; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3006
msgctxt "text_id=16943 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_1:3011:16944: scene=C_1
#: C_1:3011
msgctxt "text_id=16944 | speaker=unknown"
msgid "　橙子の視線は、既に有珠に向けられている。"
msgstr ""

#. Occurrence C_1:3050:16945: scene=C_1
#: C_1:3050
msgctxt "text_id=16945 | speaker=unknown"
msgid "　燃えカスなどはじめから見てはいない。"
msgstr ""

#. Occurrence C_1:3055:16946: scene=C_1
#: C_1:3055
msgctxt "text_id=16946 | speaker=unknown"
msgid "　橙子は<ソ|・><レ|・>が無抵抗に落下した時から、青子ではないと判断していた。"
msgstr ""

#. Occurrence C_1:3093:16947: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0021; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3093
msgctxt "text_id=16947 | speaker=touko"
msgid "“チッ、マインスターの使い魔は何匹いる…………！”"
msgstr ""

#. Occurrence C_1:3099:16948: scene=C_1
#: C_1:3099
msgctxt "text_id=16948 | speaker=unknown"
msgid "　<苛|いら>だたしげに舌打ちしつつ、橙子は有珠を凝視する。"
msgstr ""

#. Occurrence C_1:3104:16949: scene=C_1
#: C_1:3104
msgctxt "text_id=16949 | speaker=unknown"
msgid "　たしかに青子の姿は透明化していた。"
msgstr ""

#. Occurrence C_1:3109:16950: scene=C_1
#: C_1:3109
msgctxt "text_id=16950 | speaker=unknown"
msgid "　ただし、本人は一歩たりとも動いてはいない。"
msgstr ""

#. Occurrence C_1:3154:16951: scene=C_1
#: C_1:3154
msgctxt "text_id=16951 | speaker=unknown"
msgid "　青子が立っていた地面には、青い円陣が回りだしている。"
msgstr ""

#. Occurrence C_1:3221:16952: scene=C_1
#: C_1:3221
msgctxt "text_id=16952 | speaker=unknown"
msgid "　それは魔術刻印を動員した、<四小節の大魔術|フォース・トゥ・フォース>。"
msgstr ""

#. Occurrence C_1:3226:16953: scene=C_1
#: C_1:3226
msgctxt "text_id=16953 | speaker=unknown"
msgid "　<一工程|シングルアクション>のルーンしか―――"
msgstr ""

#. Occurrence C_1:3231:16954: scene=C_1
#: C_1:3231
msgctxt "text_id=16954 | speaker=unknown"
msgid "　いや、そもそも二小節以上の魔術を修得できない橙子にとっては、太刀打ちできない魔力の奔流―――！"
msgstr ""

#. Occurrence C_1:3318:16955: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0022; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3318
msgctxt "text_id=16955 | speaker=touko"
msgid "「―――<[eywz]|エイワズ>！」"
msgstr ""

#. Occurrence C_1:3436:16956: scene=C_1
#: C_1:3436
msgctxt "text_id=16956 | speaker=unknown"
msgid "　円陣の上に、ルーンの軌跡が刻まれる。"
msgstr ""

#. Occurrence C_1:3567:16957: scene=C_1
#: C_1:3567
msgctxt "text_id=16957 | speaker=unknown"
msgid "　<退去|エイワズ>のルーンで青子にかかった姿隠しを解呪し、橙子は<角|ひ><膜|とみ>を切り替える。"
msgstr ""

#. Occurrence C_1:3572:16958: scene=C_1
#: C_1:3572
msgctxt "text_id=16958 | speaker=unknown"
msgid "　新たに開かれる<瞳|もの>は、見たものを眼球内の無限地獄に捕らえる、合わせ鏡の積重魔眼―――！"
msgstr ""

#. Occurrence C_1:3712:16959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0023; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3712
msgctxt "text_id=16959 | speaker=touko"
msgid "「っ……！？」"
msgstr ""

#. Occurrence C_1:3742:16960: scene=C_1
#: C_1:3742
msgctxt "text_id=16960 | speaker=unknown"
msgid "　だが、魔術師の視線は文字通り<両|・><断|・>された。"
msgstr ""

#. Occurrence C_1:3747:16961: scene=C_1
#: C_1:3747
msgctxt "text_id=16961 | speaker=unknown"
msgid "　青子の前の空間が歪んでいる。"
msgstr ""

#. Occurrence C_1:3752:16962: scene=C_1
#: C_1:3752
msgctxt "text_id=16962 | speaker=unknown"
msgid "　夜気は霧のように重なり、青子の姿を<被|だぶ>らせている。"
msgstr ""

#. Occurrence C_1:3757:16963: scene=C_1
#: C_1:3757
msgctxt "text_id=16963 | speaker=unknown"
msgid "　橙子の魔眼が合わせ鏡なら、あれは三角点に置かれたマジックミラーだ。"
msgstr ""

#. Occurrence C_1:3762:16964: scene=C_1
#: C_1:3762
msgctxt "text_id=16964 | speaker=unknown"
msgid "　橙子の位置からでは視界が二つに別けられ、正面の<像|あおこ>を視認できない……！"
msgstr ""

#. Occurrence C_1:3895:16965: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0004; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:3895
msgctxt "text_id=16965 | speaker=alice"
msgid "「午睡の鏡の効果よ、橙子さん。"
msgstr ""

#. Occurrence C_1:3902:16966: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0005; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:3902
msgctxt "text_id=16966 | speaker=alice"
msgid "青子は鏡のＹ字路の奥にいる。一本道から見ている貴女に、中心は見渡せない」"
msgstr ""

#. Occurrence C_1:3949:16967: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0024; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3949
msgctxt "text_id=16967 | speaker=touko"
msgid "「……！」"
msgstr ""

#. Occurrence C_1:4044:16968: scene=C_1
#: C_1:4044
msgctxt "text_id=16968 | speaker=unknown"
msgid "　いつかの逆転とばかりに有珠は言い捨てた。"
msgstr ""

#. Occurrence C_1:4049:16969: scene=C_1
#: C_1:4049
msgctxt "text_id=16969 | speaker=unknown"
msgid "　有珠自身、橙子に飲まされた薬草によって魔術は使えない。"
msgstr ""

#. Occurrence C_1:4054:16970: scene=C_1
#: C_1:4054
msgctxt "text_id=16970 | speaker=unknown"
msgid "　だが、既に起動しているプロイたち……洋館の『鏡』と、無駄に動き回る青い鳥は、彼女の魔力がなくとも最低限の機能は果たせるのだ。"
msgstr ""

#. Occurrence C_1:4098:16971: scene=C_1
#: C_1:4098
msgctxt "text_id=16971 | speaker=unknown"
msgid "　そして、暴風の<魔弾|まだん>が<装填|そうてん>される。"
msgstr ""

#. Occurrence C_1:4176:16972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0016; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4176
msgctxt "text_id=16972 | speaker=aoko"
msgid "「<接続|セット>―――<刻印|ルート>、<交流数紋|ディレクト・カーラント>」"
msgstr ""

#. Occurrence C_1:4294:16973: scene=C_1
#: C_1:4294
msgctxt "text_id=16973 | speaker=unknown"
msgid "　右腕を<掲|かか>げ、<光|ひ><芒|か>る刻印をあらわにし、青子は三十メートル先の標的を見据える。"
msgstr ""

#. Occurrence C_1:4299:16974: scene=C_1
#: C_1:4299
msgctxt "text_id=16974 | speaker=unknown"
msgid "　<砲|う><身|で>は十分な魔力に満ちている。"
msgstr ""

#. Occurrence C_1:4337:16975: scene=C_1
#: C_1:4337
msgctxt "text_id=16975 | speaker=unknown"
msgid "　有珠の姿隠しを受けた瞬間から、青子は魔術の詠唱を始めていた。"
msgstr ""

#. Occurrence C_1:4381:16976: scene=C_1
#: C_1:4381
msgctxt "text_id=16976 | speaker=unknown"
msgid "　橙子が気付くまでの数秒間。"
msgstr ""

#. Occurrence C_1:4386:16977: scene=C_1
#: C_1:4386
msgctxt "text_id=16977 | speaker=unknown"
msgid "　最速の手順で形成し、起動させた魔術回路の回転数は自己ベストを超えている。"
msgstr ""

#. Occurrence C_1:4426:16978: scene=C_1
#: C_1:4426
msgctxt "text_id=16978 | speaker=unknown"
msgid "　<一工程|スナップ>でも<二|ド><工|ロ><程|ウ>でもない、三工程以上の<魔力圧縮|マジック・ブロウ>。"
msgstr ""

#. Occurrence C_1:4432:16979: scene=C_1
#: C_1:4432
msgctxt "text_id=16979 | speaker=unknown"
msgid "　生成され、目前に集められて渦巻く青いエーテルは、単純に撃ち出すだけで１０トン相当の質量。"
msgstr ""

#. Occurrence C_1:4437:16980: scene=C_1
#: C_1:4437
msgctxt "text_id=16980 | speaker=unknown"
msgid "　これを魔術刻印によって加工し、相乗に相乗を重ねて掃射すれば、背後の旧校舎さえ粉砕できる―――！"
msgstr ""

#. Occurrence C_1:4502:16981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0017; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4502
msgctxt "text_id=16981 | speaker=aoko"
msgid "「橙子――――――！」"
msgstr ""

#. Occurrence C_1:4542:16982: scene=C_1
#: C_1:4542
msgctxt "text_id=16982 | speaker=unknown"
msgid "　覚悟、とばかりに青子は姉を見据えた。"
msgstr ""

#. Occurrence C_1:4568:16983: scene=C_1
#: C_1:4568
msgctxt "text_id=16983 | speaker=unknown"
msgid "　橙子には対抗する時間も、回避するだけの<移動力|あし>もない。"
msgstr ""

#. Occurrence C_1:4573:16984: scene=C_1
#: C_1:4573
msgctxt "text_id=16984 | speaker=unknown"
msgid "　それを誰より理解しているのか、彼女は驚愕のまま動かなかった。"
msgstr ""

#. Occurrence C_1:4578:16985: scene=C_1
#: C_1:4578
msgctxt "text_id=16985 | speaker=unknown"
msgid "　<怯|おび>えはなく、敗北を悟った自責の瞳。"
msgstr ""

#. Occurrence C_1:4583:16986: scene=C_1
#: C_1:4583
msgctxt "text_id=16986 | speaker=unknown"
msgid "　それに青子は躊躇する事なく、右手の引き金に力をいれた。"
msgstr ""

#. Occurrence C_1:4676:16987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0018; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4676
msgctxt "text_id=16987 | speaker=aoko"
msgid "「<魔弾|ツアー><形式|プラン>、<収束|スター><投射|マイン>―――回路、放て………！！！！」"
msgstr ""

#. Occurrence C_1:4829:16988: scene=C_1
#: C_1:4829
msgctxt "text_id=16988 | speaker=unknown"
msgid "　叫び声にも似た最後の一節。"
msgstr ""

#. Occurrence C_1:4834:16989: scene=C_1
#: C_1:4834
msgctxt "text_id=16989 | speaker=unknown"
msgid "　撃ち出された架<空要|エーテル>素は仮初めの熱量となって、降り積もった雪を波と散らす。"
msgstr ""

#. Occurrence C_1:5240:16990: scene=C_1
#: C_1:5240
msgctxt "text_id=16990 | speaker=unknown"
msgid "　―――橙子を飲みこむ、圧倒的なまでの土砂。"
msgstr ""

#. Occurrence C_1:5294:16991: scene=C_1
#: C_1:5294
msgctxt "text_id=16991 | speaker=unknown"
msgid "　できうるかぎりの魔力を用いた青子の魔弾は、逃れようのない死の一撃となった。"
msgstr ""

#. Occurrence C_1:5299:16992: scene=C_1
#: C_1:5299
msgctxt "text_id=16992 | speaker=unknown"
msgid "　その衝突を目の当たりにして、青子は自分の勝利を受け入れた。"
msgstr ""

#. Occurrence C_1:5304:16993: scene=C_1
#: C_1:5304
msgctxt "text_id=16993 | speaker=unknown"
msgid "　……どこか、苦い感情と共に。"
msgstr ""

#. Occurrence C_1:5345:16994: scene=C_1
#: C_1:5345
msgctxt "text_id=16994 | speaker=unknown"
msgid "　―――そして。"
msgstr ""

#. Occurrence C_1:5362:16995: scene=C_1
#: C_1:5362
msgctxt "text_id=16995 | speaker=unknown"
msgid "　自らを飲みこんだ魔力の<奔|な><流|み>を後にして、橙子は青子の甘さに舌打ちした。"
msgstr ""

#. Occurrence C_1:5367:16996: scene=C_1
#: C_1:5367
msgctxt "text_id=16996 | speaker=unknown"
msgid "　青子とは真逆の、失望に満ちた苦さと共に。"
msgstr ""

#. Occurrence C_1:5427:16997: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0025; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:5427
msgctxt "text_id=16997 | speaker=touko"
msgid "「学ぶにしては遅すぎたが、まあ聞いておけ青子。"
msgstr ""

#. Occurrence C_1:5433:16998: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0026; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:5433
msgctxt "text_id=16998 | speaker=touko"
msgid "　切札というものは、先に出した方の負けなんだよ」"
msgstr ""

#. Occurrence C_1:5439:16999: scene=C_1
#: C_1:5439
msgctxt "text_id=16999 | speaker=unknown"
msgid "　超然とした声には、何のダメージも見られない。"
msgstr ""

#. Occurrence C_1:5444:17000: scene=C_1
#: C_1:5444
msgctxt "text_id=17000 | speaker=unknown"
msgid "　雪原に立つ魔術師の<外套|コート>には<煤|すす>一つない。"
msgstr ""

#. Occurrence C_1:5449:17001: scene=C_1
#: C_1:5449
msgctxt "text_id=17001 | speaker=unknown"
msgid "　―――<渾身|こんしん>の魔弾は、橙子の体に触れる寸前で、同位の魔力によって周囲へと<弾|はじ>き飛ばされたのだ。"
msgstr ""

#. Occurrence C_1:5493:17002: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0019; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:5493
msgctxt "text_id=17002 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_1:5499:17003: scene=C_1
#: C_1:5499
msgctxt "text_id=17003 | speaker=unknown"
msgid "　その光景を、青子はただ見つめていた。"
msgstr ""

#. Occurrence C_1:5504:17004: scene=C_1
#: C_1:5504
msgctxt "text_id=17004 | speaker=unknown"
msgid "　自身の魔術の消滅を、ではない。"
msgstr ""

#. Occurrence C_1:5509:17005: scene=C_1
#: C_1:5509
msgctxt "text_id=17005 | speaker=unknown"
msgid "　悪夢でも見るように、姉の背後に浮遊するモノを凝視する。"
msgstr ""

#. Occurrence C_1:5515:17006: scene=C_1
#: C_1:5515
msgctxt "text_id=17006 | speaker=unknown"
msgid "　橙子の背後に現れた、<夥|おびただ>しいまでの魔術刻印を。"
msgstr ""

#. Occurrence C_1:5551:17007: scene=C_1
#: C_1:5551
msgctxt "text_id=17007 | speaker=unknown"
msgid "　……それは一瞬の出来事だった。"
msgstr ""

#. Occurrence C_1:5556:17008: scene=C_1
#: C_1:5556
msgctxt "text_id=17008 | speaker=unknown"
msgid "　大波となって押し寄せる魔弾を前に、橙子は軽やかに右指を鳴らした。"
msgstr ""

#. Occurrence C_1:5576:17009: scene=C_1
#: C_1:5576
msgctxt "text_id=17009 | speaker=unknown"
msgid "　途端、背後からざあ、と音をたてて幾多もの文字が羅列されていったのだ。"
msgstr ""

#. Occurrence C_1:5582:17010: scene=C_1
#: C_1:5582
msgctxt "text_id=17010 | speaker=unknown"
msgid "　<言葉|テキスト>は<美術|アート>となり、金色の花に成った。"
msgstr ""

#. Occurrence C_1:5587:17011: scene=C_1
#: C_1:5587
msgctxt "text_id=17011 | speaker=unknown"
msgid "　おそらくは数百の。"
msgstr ""

#. Occurrence C_1:5592:17012: scene=C_1
#: C_1:5592
msgctxt "text_id=17012 | speaker=unknown"
msgid "　西欧だけに留まらない、多種多様な魔術の<群像|カタチ>。"
msgstr ""

#. Occurrence C_1:5613:17013: scene=C_1
#: C_1:5613
msgctxt "text_id=17013 | speaker=unknown"
msgid "　本来、魔術師の肌に刻む筈の、"
msgstr ""

#. Occurrence C_1:5619:17014: scene=C_1
#: C_1:5619
msgctxt "text_id=17014 | speaker=unknown"
msgid "　本来、蒼崎橙子には無い筈の、"
msgstr ""

#. Occurrence C_1:5624:17015: scene=C_1
#: C_1:5624
msgctxt "text_id=17015 | speaker=unknown"
msgid "　本来、その門派の後継者しか知らない筈の、"
msgstr ""

#. Occurrence C_1:5633:17016: scene=C_1
#: C_1:5633
msgctxt "text_id=17016 | speaker=unknown"
msgid "　月光より鮮やかに咲く魔術刻印。"
msgstr ""

#. Occurrence C_1:5665:17017: scene=C_1
#: C_1:5665
msgctxt "text_id=17017 | speaker=unknown"
msgid "　それは橙子を守る<守護の獣|トーテムポール>となって、彼女の背後の空間に刻まれていた。"
msgstr ""

#. Occurrence C_10:63:17018: scene=C_10
#: C_10:63
msgctxt "text_id=17018 | speaker=unknown"
msgid "　―――詰まるところ。"
msgstr ""

#. Occurrence C_10:68:17019: scene=C_10
#: C_10:68
msgctxt "text_id=17019 | speaker=unknown"
msgid "　魔術とは人智であり世界であり、"
msgstr ""

#. Occurrence C_10:73:17020: scene=C_10
#: C_10:73
msgctxt "text_id=17020 | speaker=unknown"
msgid "　魔法とはそれらに含まれない、<埒|らち><天外|てんがい>の孤独である。"
msgstr ""

#. Occurrence C_10:96:17021: scene=C_10
#: C_10:96
msgctxt "text_id=17021 | speaker=unknown"
msgid "　……はじめの一つは全てを変えた。"
msgstr ""

#. Occurrence C_10:102:17022: scene=C_10
#: C_10:102
msgctxt "text_id=17022 | speaker=unknown"
msgid "　……つぎの二つは多くを認めた。"
msgstr ""

#. Occurrence C_10:108:17023: scene=C_10
#: C_10:108
msgctxt "text_id=17023 | speaker=unknown"
msgid "　……受けて三つは未来を示した。"
msgstr ""

#. Occurrence C_10:114:17024: scene=C_10
#: C_10:114
msgctxt "text_id=17024 | speaker=unknown"
msgid "　……繋ぐ四つは姿を隠した。"
msgstr ""

#. Occurrence C_10:121:17025: scene=C_10
#: C_10:121
msgctxt "text_id=17025 | speaker=unknown"
msgid "　そして終わりの五つ目は、とっくに<意義|せき>を失っていた。"
msgstr ""

#. Occurrence C_10:142:17026: scene=C_10
#: C_10:142
msgctxt "text_id=17026 | speaker=unknown"
msgid "　三つ目で終わっていれば良かったのに、と誰かが言った。"
msgstr ""

#. Occurrence C_10:179:17027: scene=C_10
#: C_10:179
msgctxt "text_id=17027 | speaker=unknown"
msgid "　魔術とは歴史の研鑽。"
msgstr ""

#. Occurrence C_10:184:17028: scene=C_10
#: C_10:184
msgctxt "text_id=17028 | speaker=unknown"
msgid "　人の手による<業|わざ>と、星の元に<巡|めぐ>る命だ。"
msgstr ""

#. Occurrence C_10:189:17029: scene=C_10
#: C_10:189
msgctxt "text_id=17029 | speaker=unknown"
msgid "　けれど魔法は<天|てん>の<外|そと>の神の摂理。"
msgstr ""

#. Occurrence C_10:194:17030: scene=C_10
#: C_10:194
msgctxt "text_id=17030 | speaker=unknown"
msgid "　人にも星にも含まれない<業|わざ>を、一体地上の誰が、どうして、奇跡と<讃|たた>え<尊|とうと>ぶものか。"
msgstr ""

#. Occurrence C_10:218:17031: scene=C_10
#: C_10:218
msgctxt "text_id=17031 | speaker=unknown"
msgid "　明白な罪科。"
msgstr ""

#. Occurrence C_10:223:17032: scene=C_10
#: C_10:223
msgctxt "text_id=17032 | speaker=unknown"
msgid "　魔法とは、人類の敵そのもの。"
msgstr ""

#. Occurrence C_10:228:17033: scene=C_10
#: C_10:228
msgctxt "text_id=17033 | speaker=unknown"
msgid "　故に―――"
msgstr ""

#. Occurrence C_10:238:17034: scene=C_10
#: C_10:238
msgctxt "text_id=17034 | speaker=unknown"
msgid "　<新|あら>たに魔法を<宿|やど>したものは、その赤い影に殺される。"
msgstr ""

#. Occurrence C_10:331:17035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0000; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:331
msgctxt "text_id=17035 | speaker=aoko"
msgid "「―――<聴|き>け、万物の霊長」"
msgstr ""

#. Occurrence C_10:443:17036: scene=C_10
#: C_10:443
msgctxt "text_id=17036 | speaker=unknown"
msgid "　声は高らかに、冬の空に響き渡る。"
msgstr ""

#. Occurrence C_10:448:17037: scene=C_10
#: C_10:448
msgctxt "text_id=17037 | speaker=unknown"
msgid "　空間そのものに走る断裂。"
msgstr ""

#. Occurrence C_10:453:17038: scene=C_10
#: C_10:453
msgctxt "text_id=17038 | speaker=unknown"
msgid "　周囲の<風景|カタチ>が軋んでいく様は、<伽藍|がらん>の崩壊を思わせる。"
msgstr ""

#. Occurrence C_10:562:17039: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_10_0000; voice_prefix=A20; voice_category=11; scene=C_10
#: C_10:562
msgctxt "text_id=17039 | speaker=touko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_10:568:17040: scene=C_10
#: C_10:568
msgctxt "text_id=17040 | speaker=unknown"
msgid "　撤退すべきか、それとも戦うべきか。"
msgstr ""

#. Occurrence C_10:573:17041: scene=C_10
#: C_10:573
msgctxt "text_id=17041 | speaker=unknown"
msgid "　橙子は<逸|はや>る気持ちを抑えながら、無様にも事の<顛末|てんまつ>を見届けてしまう。"
msgstr ""

#. Occurrence C_10:578:17042: scene=C_10
#: C_10:578
msgctxt "text_id=17042 | speaker=unknown"
msgid "　長年の苦悩―――これまで追い続けてきたモノを前にして、合理的な判断などできよう筈がない。"
msgstr ""

#. Occurrence C_10:604:17043: scene=C_10
#: C_10:604
msgctxt "text_id=17043 | speaker=unknown"
msgid "　互いの命運は、今や不確定にたゆたっている。"
msgstr ""

#. Occurrence C_10:609:17044: scene=C_10
#: C_10:609
msgctxt "text_id=17044 | speaker=unknown"
msgid "　背後の魔術刻印と地形の有利性から、橙子の戦力は青子の十倍強。負ける道理はない。"
msgstr ""

#. Occurrence C_10:629:17045: scene=C_10
#: C_10:629
msgctxt "text_id=17045 | speaker=unknown"
msgid "　だが魔法は別だ。"
msgstr ""

#. Occurrence C_10:634:17046: scene=C_10
#: C_10:634
msgctxt "text_id=17046 | speaker=unknown"
msgid "　仮に、蒼崎の魔法が久遠寺有珠の“童話の怪物”と同系統のモノなら、術者の力量差は関係ない。"
msgstr ""

#. Occurrence C_10:639:17047: scene=C_10
#: C_10:639
msgctxt "text_id=17047 | speaker=unknown"
msgid "　その時は“魔法”と“蒼崎橙子”の戦いになる。"
msgstr ""

#. Occurrence C_10:644:17048: scene=C_10
#: C_10:644
msgctxt "text_id=17048 | speaker=unknown"
msgid "　……勝ち目はない。"
msgstr ""

#. Occurrence C_10:649:17049: scene=C_10
#: C_10:649
msgctxt "text_id=17049 | speaker=unknown"
msgid "　魔法の特異性、超越性は、魔術の技量差など吹き飛ばしてしまうだろう。"
msgstr ""

#. Occurrence C_10:705:17050: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_10_0001; voice_prefix=A20; voice_category=11; scene=C_10
#: C_10:705
msgctxt "text_id=17050 | speaker=touko"
msgid "「―――だが」"
msgstr ""

#. Occurrence C_10:774:17051: scene=C_10
#: C_10:774
msgctxt "text_id=17051 | speaker=unknown"
msgid "　本当に使えるのか、と橙子は妹を凝視する。"
msgstr ""

#. Occurrence C_10:779:17052: scene=C_10
#: C_10:779
msgctxt "text_id=17052 | speaker=unknown"
msgid "　今の宣言には力がなかった。"
msgstr ""

#. Occurrence C_10:784:17053: scene=C_10
#: C_10:784
msgctxt "text_id=17053 | speaker=unknown"
msgid "　高らかに声をあげながら、あるのは自制心だけで、何者をも代償にする<傲慢|つよさ>が存在しなかった。"
msgstr ""

#. Occurrence C_10:804:17054: scene=C_10
#: C_10:804
msgctxt "text_id=17054 | speaker=unknown"
msgid "　魔法を身に宿すとはどのような事なのか、選ばれなかった橙子には分からない。"
msgstr ""

#. Occurrence C_10:809:17055: scene=C_10
#: C_10:809
msgctxt "text_id=17055 | speaker=unknown"
msgid "　だが世界を変えるという暴挙。"
msgstr ""

#. Occurrence C_10:814:17056: scene=C_10
#: C_10:814
msgctxt "text_id=17056 | speaker=unknown"
msgid "　星を敵に回す<不遜|ふそん>に、人の精神が耐えられる筈がない。"
msgstr ""

#. Occurrence C_10:885:17057: scene=C_10
#: C_10:885
msgctxt "text_id=17057 | speaker=unknown"
msgid "　迷いがあるのなら尚のこと、あの少女には魔法の力は重すぎる―――！"
msgstr ""

#. Occurrence C_10:979:17058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0001; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:979
msgctxt "text_id=17058 | speaker=aoko"
msgid "「―――そりゃあ、ね」"
msgstr ""

#. Occurrence C_10:985:17059: scene=C_10
#: C_10:985
msgctxt "text_id=17059 | speaker=unknown"
msgid "　橙子の視線を受けて、青子はひとり自嘲した。"
msgstr ""

#. Occurrence C_10:990:17060: scene=C_10
#: C_10:990
msgctxt "text_id=17060 | speaker=unknown"
msgid "　迷いは晴れない。"
msgstr ""

#. Occurrence C_10:995:17061: scene=C_10
#: C_10:995
msgctxt "text_id=17061 | speaker=unknown"
msgid "　胸の恐れが消える事なんてきっとない。"
msgstr ""

#. Occurrence C_10:1028:17062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0002; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:1028
msgctxt "text_id=17062 | speaker=aoko"
msgid "「―――でも、だからって」"
msgstr ""

#. Occurrence C_10:1034:17063: scene=C_10
#: C_10:1034
msgctxt "text_id=17063 | speaker=unknown"
msgid "　いつまでも逃げる訳にはいかない。"
msgstr ""

#. Occurrence C_10:1039:17064: scene=C_10
#: C_10:1039
msgctxt "text_id=17064 | speaker=unknown"
msgid "　迷いも恐れも消えないからこそ、そんなもので立ち止まる自分が許せないと。"
msgstr ""

#. Occurrence C_10:1044:17065: scene=C_10
#: C_10:1044
msgctxt "text_id=17065 | speaker=unknown"
msgid "　瞳を閉じて、彼女は最後の工程に身を投げた。"
msgstr ""

#. Occurrence C_10:1136:17066: scene=C_10
#: C_10:1136
msgctxt "text_id=17066 | speaker=unknown"
msgid "　光を閉ざすように、時を止める。"
msgstr ""

#. Occurrence C_10:1142:17067: scene=C_10
#: C_10:1142
msgctxt "text_id=17067 | speaker=unknown"
msgid "　そして、彼女は自己の闇へと埋没した。"
msgstr ""

#. Occurrence C_10:1148:17068: scene=C_10
#: C_10:1148
msgctxt "text_id=17068 | speaker=unknown"
msgid "　何もかもが止まったまま過ぎていく。"
msgstr ""

#. Occurrence C_10:1154:17069: scene=C_10
#: C_10:1154
msgctxt "text_id=17069 | speaker=unknown"
msgid "　彼女以外のすべてが途絶えた、果てのない星の運河に。"
msgstr ""

#. Occurrence C_10:1183:17070: scene=C_10
#: C_10:1183
msgctxt "text_id=17070 | speaker=unknown"
msgid "　途端。"
msgstr ""

#. Occurrence C_10:1188:17071: scene=C_10
#: C_10:1188
msgctxt "text_id=17071 | speaker=unknown"
msgid "　何の答えもなく<彼|コ><方|コ>に訪れた浅はかさに、消えたくなる。"
msgstr ""

#. Occurrence C_10:1220:17072: scene=C_10
#: C_10:1220
msgctxt "text_id=17072 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　―――ああ、また。"
msgstr ""

#. Occurrence C_10:1227:17073: scene=C_10
#: C_10:1227
msgctxt "text_id=17073 | speaker=unknown"
msgid "　今度こそ、あの赤い影がやってくる。"
msgstr ""

#. Occurrence C_10:1294:17074: scene=C_10
#: C_10:1294
msgctxt "text_id=17074 | speaker=unknown"
msgid "　不意に、"
msgstr ""

#. Occurrence C_10:1299:17075: scene=C_10
#: C_10:1299
msgctxt "text_id=17075 | speaker=unknown"
msgid "　　　　　新しい記憶を見た。"
msgstr ""

#. Occurrence C_10:1305:17076: scene=C_10
#: C_10:1305
msgctxt "text_id=17076 | speaker=unknown"
msgid "　他者を媒介にして　　を交換しようとした結果だろう。"
msgstr ""

#. Occurrence C_10:1310:17077: scene=C_10
#: C_10:1310
msgctxt "text_id=17077 | speaker=unknown"
msgid "　ワタシは、聞いた事もないクセに、慣れ親しんだその音を聴く。"
msgstr ""

#. Occurrence C_10:1388:17078: scene=C_10
#: C_10:1388
msgctxt "text_id=17078 | speaker=unknown"
msgid "　　　　　　　　"
msgstr ""

msgctxt "text_id=17079 | speaker=unknown"
msgid "何も望まないように。"
msgstr ""

msgctxt "text_id=17080 | speaker=unknown"
msgid "　　　　　　　　何も求めないように。"
msgstr ""

#. Occurrence C_10:1481:17081: scene=C_10
#: C_10:1481
msgctxt "text_id=17081 | speaker=unknown"
msgid "　今はゼロに向けて逆行する意識を、"
msgstr ""

#. Occurrence C_10:1486:17082: scene=C_10
#: C_10:1486
msgctxt "text_id=17082 | speaker=unknown"
msgid "　　　　　　　　　　　　　一つに統合しなくてはならない。"
msgstr ""

#. Occurrence C_10:1491:17083: scene=C_10
#: C_10:1491
msgctxt "text_id=17083 | speaker=unknown"
msgid "　こんな音。"
msgstr ""

#. Occurrence C_10:1496:17084: scene=C_10
#: C_10:1496
msgctxt "text_id=17084 | speaker=unknown"
msgid "　こんな、悔しくて涙がでそうな戯言に、"
msgstr ""

#. Occurrence C_10:1501:17085: scene=C_10
#: C_10:1501
msgctxt "text_id=17085 | speaker=unknown"
msgid "　　　　　　　　　　　後ろ髪を引かれている場合じゃない。"
msgstr ""

#. Occurrence C_10:1507:17086: scene=C_10
#: C_10:1507
msgctxt "text_id=17086 | speaker=unknown"
msgid "　そもそもワタシの最大の問題は、あの赤い幽霊で―――"
msgstr ""

#. Occurrence C_10:1583:17087: scene=C_10
#: C_10:1583
msgctxt "text_id=17087 | speaker=unknown"
msgid "　　　　　　　"
msgstr ""

msgctxt "text_id=17088 | speaker=unknown"
msgid "生の価値も覚えてはいけません。"
msgstr ""

msgctxt "text_id=17089 | speaker=unknown"
msgid "　　　　　　　死の<尊|とうと>さも、考えてはいけません。"
msgstr ""

#. Occurrence C_10:1676:17090: scene=C_10
#: C_10:1676
msgctxt "text_id=17090 | speaker=unknown"
msgid "　音は続いていく。"
msgstr ""

#. Occurrence C_10:1681:17091: scene=C_10
#: C_10:1681
msgctxt "text_id=17091 | speaker=unknown"
msgid "　それはこの旅路に組みこまれている物ではなく、"
msgstr ""

#. Occurrence C_10:1686:17092: scene=C_10
#: C_10:1686
msgctxt "text_id=17092 | speaker=unknown"
msgid "　　　　　　　　　　　　　　外部からの妨害に他ならない。"
msgstr ""

#. Occurrence C_10:1692:17093: scene=C_10
#: C_10:1692
msgctxt "text_id=17093 | speaker=unknown"
msgid "　なのに、ここまで自分の心を乱す音の正体を、"
msgstr ""

#. Occurrence C_10:1697:17094: scene=C_10
#: C_10:1697
msgctxt "text_id=17094 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　　ワタシはようやく悟った。"
msgstr ""

#. Occurrence C_10:1732:17095: scene=C_10
#: C_10:1732
msgctxt "text_id=17095 | speaker=unknown"
msgid "“……なに、それ”"
msgstr ""

#. Occurrence C_10:1738:17096: scene=C_10
#: C_10:1738
msgctxt "text_id=17096 | speaker=unknown"
msgid "　不快げな呟きは、音の主に向けられたものだった。"
msgstr ""

#. Occurrence C_10:1744:17097: scene=C_10
#: C_10:1744
msgctxt "text_id=17097 | speaker=unknown"
msgid "　もしくは、その声をおとなしく聞いている誰かに対して。"
msgstr ""

#. Occurrence C_10:1780:17098: scene=C_10
#: C_10:1780
msgctxt "text_id=17098 | speaker=unknown"
msgid "　赤い影は戸惑っている。"
msgstr ""

#. Occurrence C_10:1785:17099: scene=C_10
#: C_10:1785
msgctxt "text_id=17099 | speaker=unknown"
msgid "　答えも覚悟も持ってこなかったワタシを、憎悪に満ちた目で睨んでいる。"
msgstr ""

#. Occurrence C_10:1823:17100: scene=C_10
#: C_10:1823
msgctxt "text_id=17100 | speaker=unknown"
msgid "　オマエは、まさか。"
msgstr ""

#. Occurrence C_10:1828:17101: scene=C_10
#: C_10:1828
msgctxt "text_id=17101 | speaker=unknown"
msgid "　まさか、<そ|・><ん|・><な|・><理|・><由|・><で|・>。"
msgstr ""

#. Occurrence C_10:1864:17102: scene=C_10
#: C_10:1864
msgctxt "text_id=17102 | speaker=unknown"
msgid "　そんな思いつきで、ワタシの獲物になるつもりか―――！"
msgstr ""

#. Occurrence C_10:1921:17103: scene=C_10
#: C_10:1921
msgctxt "text_id=17103 | speaker=unknown"
msgid "　　　　　　　　"
msgstr ""

msgctxt "text_id=17104 | speaker=unknown"
msgid "それが貴方の全てです。"
msgstr ""

msgctxt "text_id=17105 | speaker=unknown"
msgid "　　　　　それ以外、貴方には何も無いのです。"
msgstr ""

#. Occurrence C_10:1992:17106: scene=C_10
#: C_10:1992
msgctxt "text_id=17106 | speaker=unknown"
msgid "　巻き戻しの影響―――否を許さない断定。"
msgstr ""

#. Occurrence C_10:1997:17107: scene=C_10
#: C_10:1997
msgctxt "text_id=17107 | speaker=unknown"
msgid "　彼の一番だった頃―――あまりにも意味のない人生。"
msgstr ""

#. Occurrence C_10:2003:17108: scene=C_10
#: C_10:2003
msgctxt "text_id=17108 | speaker=unknown"
msgid "　それを彼女は打ち消した。"
msgstr ""

#. Occurrence C_10:2008:17109: scene=C_10
#: C_10:2008
msgctxt "text_id=17109 | speaker=unknown"
msgid "　彼にとって絶対の<原則|もの>であるその音を、さらに上回る力強さで。"
msgstr ""

#. Occurrence C_10:2014:17110: scene=C_10
#: C_10:2014
msgctxt "text_id=17110 | speaker=unknown"
msgid "　邪魔だ、と目の前の蜘蛛の巣を払い除けるように。"
msgstr ""

#. Occurrence C_10:2057:17111: scene=C_10
#: C_10:2057
msgctxt "text_id=17111 | speaker=unknown"
msgid "　音は千切れ、また違う音が耳に響く。"
msgstr ""

#. Occurrence C_10:2064:17112: scene=C_10
#: C_10:2064
msgctxt "text_id=17112 | speaker=unknown"
msgid "　　　　　　　　　／何も望まない。"
msgstr ""

msgctxt "text_id=17113 | speaker=unknown"
msgid "何も欲しくない。"
msgstr ""

#. Occurrence C_10:2072:17114: scene=C_10
#: C_10:2072
msgctxt "text_id=17114 | speaker=unknown"
msgid "　断定に従う、無垢な心。"
msgstr ""

#. Occurrence C_10:2079:17115: scene=C_10
#: C_10:2079
msgctxt "text_id=17115 | speaker=unknown"
msgid "　　　　　　　　／だから、"
msgstr ""

msgctxt "text_id=17116 | speaker=unknown"
msgid "何を与えられる事はない。"
msgstr ""

#. Occurrence C_10:2087:17117: scene=C_10
#: C_10:2087
msgctxt "text_id=17117 | speaker=unknown"
msgid "　肯定が導く、不実の命。"
msgstr ""

#. Occurrence C_10:2130:17118: scene=C_10
#: C_10:2130
msgctxt "text_id=17118 | speaker=unknown"
msgid "“……あんまりにも、バカげてる”"
msgstr ""

#. Occurrence C_10:2136:17119: scene=C_10
#: C_10:2136
msgctxt "text_id=17119 | speaker=unknown"
msgid "　<未|ま><来|え>を目指す足が止まる。"
msgstr ""

#. Occurrence C_10:2142:17120: scene=C_10
#: C_10:2142
msgctxt "text_id=17120 | speaker=unknown"
msgid "　ワタシは思いつきで<航|み><路|ち>を変える。"
msgstr ""

#. Occurrence C_10:2148:17121: scene=C_10
#: C_10:2148
msgctxt "text_id=17121 | speaker=unknown"
msgid "　大事なものが変わったというより、ひどく頭にくるコトができてしまって、なんて言うか―――"
msgstr ""

#. Occurrence C_10:2337:17122: scene=C_10
#: C_10:2337
msgctxt "text_id=17122 | speaker=unknown"
msgid "“こんな物が過去だって言うの、アンタは……！”"
msgstr ""

#. Occurrence C_10:2343:17123: scene=C_10
#: C_10:2343
msgctxt "text_id=17123 | speaker=unknown"
msgid "　誰かに、文句の一つでも言わないと気が済まない……！！"
msgstr ""

#. Occurrence C_10:2363:17124: scene=C_10
#: C_10:2363
msgctxt "text_id=17124 | speaker=unknown"
msgid "　声の主か、それを聞き届ける彼か、"
msgstr ""

#. Occurrence C_10:2368:17125: scene=C_10
#: C_10:2368
msgctxt "text_id=17125 | speaker=unknown"
msgid "　それを黙って見ているだけの自分か、"
msgstr ""

#. Occurrence C_10:2373:17126: scene=C_10
#: C_10:2373
msgctxt "text_id=17126 | speaker=unknown"
msgid "　それとも、彼をそうしてしまった何者へか。"
msgstr ""

#. Occurrence C_10:2379:17127: scene=C_10
#: C_10:2379
msgctxt "text_id=17127 | speaker=unknown"
msgid "　答えは出ないまま、ワタシは閉じた<目蓋|まぶた>を開いて―――"
msgstr ""

#. Occurrence C_10:2444:17128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0006; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2444
msgctxt "text_id=17128 | speaker=aoko"
msgid "「―――告げる」"
msgstr ""

#. Occurrence C_10:2450:17129: scene=C_10
#: C_10:2450
msgctxt "text_id=17129 | speaker=unknown"
msgid "　引き上げてきたものを解放する。"
msgstr ""

#. Occurrence C_10:2455:17130: scene=C_10
#: C_10:2455
msgctxt "text_id=17130 | speaker=unknown"
msgid "　何を見てきたのか、何があったのかなど、青子の記憶には残っていない。"
msgstr ""

#. Occurrence C_10:2460:17131: scene=C_10
#: C_10:2460
msgctxt "text_id=17131 | speaker=unknown"
msgid "　あるのは心臓を<昂|たか>ぶらせる激情だけ。"
msgstr ""

#. Occurrence C_10:2465:17132: scene=C_10
#: C_10:2465
msgctxt "text_id=17132 | speaker=unknown"
msgid "　自分でも正体の分からないものに押されて、彼女は魔法のフタを開く。"
msgstr ""

#. Occurrence C_10:2548:17133: scene=C_10
#: C_10:2548
msgctxt "text_id=17133 | speaker=unknown"
msgid "　変化は劇的だった。"
msgstr ""

#. Occurrence C_10:2553:17134: scene=C_10
#: C_10:2553
msgctxt "text_id=17134 | speaker=unknown"
msgid "　少女の足下の雪が消え、緑の地面が<覗|のぞ>いていく。"
msgstr ""

#. Occurrence C_10:2558:17135: scene=C_10
#: C_10:2558
msgctxt "text_id=17135 | speaker=unknown"
msgid "　それは雪解けによるものではなく、まったく別の風景に書き換わったものであり、"
msgstr ""

#. Occurrence C_10:2568:17136: scene=C_10
#: C_10:2568
msgctxt "text_id=17136 | speaker=unknown"
msgid "　それを批難するように、あらゆる要素が、彼女の行為を消しにかかる。"
msgstr ""

#. Occurrence C_10:2631:17137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0007; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2631
msgctxt "text_id=17137 | speaker=aoko"
msgid "「っ、―――」"
msgstr ""

#. Occurrence C_10:2637:17138: scene=C_10
#: C_10:2637
msgctxt "text_id=17138 | speaker=unknown"
msgid "　放電は彼女自身をも許さない。"
msgstr ""

#. Occurrence C_10:2642:17139: scene=C_10
#: C_10:2642
msgctxt "text_id=17139 | speaker=unknown"
msgid "　その奇跡は世界を壊すと。"
msgstr ""

#. Occurrence C_10:2647:17140: scene=C_10
#: C_10:2647
msgctxt "text_id=17140 | speaker=unknown"
msgid "　自らの保身の為、世界自身が彼女の抹殺に動き出す。"
msgstr ""

#. Occurrence C_10:2813:17141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0008; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2813
msgctxt "text_id=17141 | speaker=aoko"
msgid "「っ、―――！」"
msgstr ""

#. Occurrence C_10:2819:17142: scene=C_10
#: C_10:2819
msgctxt "text_id=17142 | speaker=unknown"
msgid "　全身の細胞を焼く痛みに、意識が現世から消失する。"
msgstr ""

#. Occurrence C_10:2887:17143: scene=C_10
#: C_10:2887
msgctxt "text_id=17143 | speaker=unknown"
msgid "　だが怯まない。"
msgstr ""

#. Occurrence C_10:2892:17144: scene=C_10
#: C_10:2892
msgctxt "text_id=17144 | speaker=unknown"
msgid "　この痛みもこの孤立も、全ては生身のまま根源に至る為。"
msgstr ""

#. Occurrence C_10:2897:17145: scene=C_10
#: C_10:2897
msgctxt "text_id=17145 | speaker=unknown"
msgid "　魔法を継いだ時から、この程度の責め苦、彼女は何度も超えてきた。"
msgstr ""

#. Occurrence C_10:2974:17146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0009; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2974
msgctxt "text_id=17146 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_10:2980:17147: scene=C_10
#: C_10:2980
msgctxt "text_id=17147 | speaker=unknown"
msgid "　声なき声をあげて、<宇|ソ><宙|ラ>の在り方と拮抗する。"
msgstr ""

#. Occurrence C_10:3054:17148: scene=C_10
#: C_10:3054
msgctxt "text_id=17148 | speaker=unknown"
msgid "　負荷は彼女の<網膜|もうまく>も神経も焼き捨てる。"
msgstr ""

#. Occurrence C_10:3059:17149: scene=C_10
#: C_10:3059
msgctxt "text_id=17149 | speaker=unknown"
msgid "　その果てに、"
msgstr ""

#. Occurrence C_10:3110:17150: scene=C_10
#: C_10:3110
msgctxt "text_id=17150 | speaker=unknown"
msgid "　光を見た。"
msgstr ""

#. Occurrence C_10:3124:17151: scene=C_10
#: C_10:3124
msgctxt "text_id=17151 | speaker=unknown"
msgid "　何の為に戻ってきたのか。"
msgstr ""

#. Occurrence C_10:3129:17152: scene=C_10
#: C_10:3129
msgctxt "text_id=17152 | speaker=unknown"
msgid "　何を叫びたいのか、彼女はようやく思い出し―――"
msgstr ""

#. Occurrence C_10:3181:17153: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0010; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:3181
msgctxt "text_id=17153 | speaker=aoko"
msgid "「<秩序|あお>を示す我が<銘|な>において告げる」"
msgstr ""

#. Occurrence C_10:3193:17154: scene=C_10
#: C_10:3193
msgctxt "text_id=17154 | speaker=unknown"
msgid "　止めろ、と<正|ただ>す声がする。"
msgstr ""

#. Occurrence C_10:3198:17155: scene=C_10
#: C_10:3198
msgctxt "text_id=17155 | speaker=unknown"
msgid "　忘我の果てに魔法の正体に手が届く。"
msgstr ""

#. Occurrence C_10:3203:17156: scene=C_10
#: C_10:3203
msgctxt "text_id=17156 | speaker=unknown"
msgid "　それでは意味がない、と牙を伸ばす赤色の影がいる。"
msgstr ""

#. Occurrence C_10:3208:17157: scene=C_10
#: C_10:3208
msgctxt "text_id=17157 | speaker=unknown"
msgid "　多くの迷い、多くの怒り。"
msgstr ""

#. Occurrence C_10:3214:17158: scene=C_10
#: C_10:3214
msgctxt "text_id=17158 | speaker=unknown"
msgid "　けれどそんなもの、彼女には／ワタシには関係ない。"
msgstr ""

#. Occurrence C_10:3235:17159: scene=C_10
#: C_10:3235
msgctxt "text_id=17159 | speaker=unknown"
msgid "　魔法使いの責務とか、これで人類滅亡とか勝手にしろ。"
msgstr ""

#. Occurrence C_10:3240:17160: scene=C_10
#: C_10:3240
msgctxt "text_id=17160 | speaker=unknown"
msgid "　いいかげんもう聞き飽きた。"
msgstr ""

#. Occurrence C_10:3245:17161: scene=C_10
#: C_10:3245
msgctxt "text_id=17161 | speaker=unknown"
msgid "　いま、私が指を動かす理由はたった一つ。"
msgstr ""

#. Occurrence C_10:3251:17162: scene=C_10
#: C_10:3251
msgctxt "text_id=17162 | speaker=unknown"
msgid "つまり、なんていうか、口にするのもどうかと思うけど―――"
msgstr ""

#. Occurrence C_10:3261:17163: scene=C_10
#: C_10:3261
msgctxt "text_id=17163 | speaker=unknown"
msgid "　私はこんなにも、コイツを助けたがってる……！！！！"
msgstr ""

#. Occurrence C_10:3392:17164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0011; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:3392
#. Occurrence C_10:4183:17164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0011; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:4183
msgctxt "text_id=17164 | speaker=aoko"
msgid "「―――<全て|not,>は<正し|SANE>く」"
msgstr ""

#. Occurrence C_10:3398:17165: scene=C_10
#: C_10:3398
#. Occurrence C_10:4189:17165: scene=C_10
#: C_10:4189
msgctxt "text_id=17165 | speaker=unknown"
msgid "　沸き上がる青い旋風。"
msgstr ""

#. Occurrence C_10:3403:17166: scene=C_10
#: C_10:3403
#. Occurrence C_10:4194:17166: scene=C_10
#: C_10:4194
msgctxt "text_id=17166 | speaker=unknown"
msgid "　迷いも<憂|うれ>いも捨てさった瞳で、魔法使いは世界を相手にペテンを始める。"
msgstr ""

#. Occurrence C_10:3509:17167: scene=C_10
#: C_10:3509
#. Occurrence C_10:4291:17167: scene=C_10
#: C_10:4291
msgctxt "text_id=17167 | speaker=unknown"
msgid "　逆行する時間。"
msgstr ""

#. Occurrence C_10:3750:17168: scene=C_10
#: C_10:3750
#. Occurrence C_10:4512:17168: scene=C_10
#: C_10:4512
msgctxt "text_id=17168 | speaker=unknown"
msgid "　書き換えられる原風景。"
msgstr ""

#. Occurrence C_10:4049:17169: scene=C_10
#: C_10:4049
#. Occurrence C_10:4760:17169: scene=C_10
#: C_10:4760
msgctxt "text_id=17169 | speaker=unknown"
msgid "　見れば、それは白い花だった。"
msgstr ""

#. Occurrence C_10:4054:17170: scene=C_10
#: C_10:4054
#. Occurrence C_10:4765:17170: scene=C_10
#: C_10:4765
msgctxt "text_id=17170 | speaker=unknown"
msgid "　雪よりも真白い野花の<群|むれ>は、さざ波のように世界を侵食していき、そして―――"
msgstr ""

#. Occurrence C_10:4866:17171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0012; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:4866
msgctxt "text_id=17171 | speaker=aoko"
msgid "「―――秩<序|five>は、こ<こに崩れ落ち|　timeless words>た」"
msgstr ""

#. Occurrence C_10:4872:17172: scene=C_10
#: C_10:4872
msgctxt "text_id=17172 | speaker=unknown"
msgid "　宣言通り。"
msgstr ""

#. Occurrence C_10:4877:17173: scene=C_10
#: C_10:4877
msgctxt "text_id=17173 | speaker=unknown"
msgid "　五番目の魔法が、この時間、この領域にだけ、その姿を現した。"
msgstr ""

#. Occurrence C_11:157:17174: scene=C_11
#: C_11:157
msgctxt "text_id=17174 | speaker=unknown"
msgid "　人里離れた雪の広場は、<瞬|またた>きの間に変貌した。"
msgstr ""

#. Occurrence C_11:162:17175: scene=C_11
#: C_11:162
msgctxt "text_id=17175 | speaker=unknown"
msgid "　一面に咲き誇る白花の海。"
msgstr ""

#. Occurrence C_11:167:17176: scene=C_11
#: C_11:167
msgctxt "text_id=17176 | speaker=unknown"
msgid "　周囲にある裸の木々と朽ちた旧校舎だけが、ここが元の世界である事を告げている。"
msgstr ""

#. Occurrence C_11:172:17177: scene=C_11
#: C_11:172
msgctxt "text_id=17177 | speaker=unknown"
msgid "　冷たい風もこの野原では暖かだ。"
msgstr ""

#. Occurrence C_11:177:17178: scene=C_11
#: C_11:177
msgctxt "text_id=17178 | speaker=unknown"
msgid "　見上げる夜空すら、満天の星の夜に戻っている。"
msgstr ""

#. Occurrence C_11:212:17179: scene=C_11
#: C_11:212
msgctxt "text_id=17179 | speaker=unknown"
msgid "　手を伸ばせば届きそうなほど近い星の明かり。"
msgstr ""

#. Occurrence C_11:217:17180: scene=C_11
#: C_11:217
msgctxt "text_id=17180 | speaker=unknown"
msgid "　淋しさも心地よさも混ざり合った、虫の羽音と夜の<囁|ささや>きだけの孤影。"
msgstr ""

#. Occurrence C_11:222:17181: scene=C_11
#: C_11:222
msgctxt "text_id=17181 | speaker=unknown"
msgid "　人の営みを<排|はい>した、<穢|けが>れも<悼|いた>みもない風景。"
msgstr ""

#. Occurrence C_11:227:17182: scene=C_11
#: C_11:227
msgctxt "text_id=17182 | speaker=unknown"
msgid "　何もないけれど、同時に何も必要としない世界。"
msgstr ""

#. Occurrence C_11:233:17183: scene=C_11
#: C_11:233
msgctxt "text_id=17183 | speaker=unknown"
msgid "　……そしてそれが、彼の一番だった頃。"
msgstr ""

#. Occurrence C_11:303:17184: scene=C_11
#: C_11:303
msgctxt "text_id=17184 | speaker=unknown"
msgid "　冬の荒地を、春の草原に変えてしまう。"
msgstr ""

#. Occurrence C_11:308:17185: scene=C_11
#: C_11:308
msgctxt "text_id=17185 | speaker=unknown"
msgid "　それが青子の言う『魔法』だという事に、橙子は呆然としていた。"
msgstr ""

#. Occurrence C_11:313:17186: scene=C_11
#: C_11:313
msgctxt "text_id=17186 | speaker=unknown"
msgid "　これはこれで悪くはないが、彼女の見たかった『魔法』は断じて、こんなロマンチックなだけのものではない。"
msgstr ""

#. Occurrence C_11:333:17187: scene=C_11
#: C_11:333
msgctxt "text_id=17187 | speaker=unknown"
msgid "　何か大がかりな術式を展開したようだが、周囲の<魔力|マナ>に変化もない。"
msgstr ""

#. Occurrence C_11:338:17188: scene=C_11
#: C_11:338
msgctxt "text_id=17188 | speaker=unknown"
msgid "　拍子抜けもいいところだ。久遠寺有珠のフラットスナークに比べれば<児|じ><戯|ぎ>に等しい。"
msgstr ""

#. Occurrence C_11:380:17189: scene=C_11
#: C_11:380
msgctxt "text_id=17189 | speaker=unknown"
msgid "　変わったのはこの花園と、あの―――"
msgstr ""

#. Occurrence C_11:433:17190: scene=C_11
#: C_11:433
msgctxt "text_id=17190 | speaker=unknown"
msgid "　出で立ちの変わった青子だけ。"
msgstr ""

#. Occurrence C_11:438:17191: scene=C_11
#: C_11:438
msgctxt "text_id=17191 | speaker=unknown"
msgid "　自身の肉体に何らかの<強化|ブースト>をかけたと見るべきだが、今の青子では何をしようと橙子には及ばない。"
msgstr ""

#. Occurrence C_11:444:17192: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0000; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:444
msgctxt "text_id=17192 | speaker=touko"
msgid "「……たしかに、魔法といえば魔法だが」"
msgstr ""

#. Occurrence C_11:449:17193: scene=C_11
#: C_11:449
msgctxt "text_id=17193 | speaker=unknown"
msgid "　呟きには微かな苛立ちがある。"
msgstr ""

#. Occurrence C_11:470:17194: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0001; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:470
msgctxt "text_id=17194 | speaker=touko"
msgid "「あいにくと、お互い夢見る年頃ではないんだ。"
msgstr ""

#. Occurrence C_11:515:17195: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0002; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:515
msgctxt "text_id=17195 | speaker=touko"
msgid "　まさか、それで終わりではないだろう？」"
msgstr ""

#. Occurrence C_11:537:17196: scene=C_11
#: C_11:537
msgctxt "text_id=17196 | speaker=unknown"
msgid "　青子は花の海を歩き始める。"
msgstr ""

#. Occurrence C_11:554:17197: scene=C_11
#: C_11:554
msgctxt "text_id=17197 | speaker=unknown"
msgid "　向かう先は、遠方にいる橙子に他ならない。"
msgstr ""

#. Occurrence C_11:569:17198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0000; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:569
msgctxt "text_id=17198 | speaker=aoko"
msgid "「いえ、これでおしまいよ。私も、貴女も」"
msgstr ""

#. Occurrence C_11:618:17199: scene=C_11
#: C_11:618
msgctxt "text_id=17199 | speaker=unknown"
msgid "　短く返された言葉に、橙子は微妙な違和感をおぼえた。"
msgstr ""

#. Occurrence C_11:629:17200: scene=C_11
#: C_11:629
msgctxt "text_id=17200 | speaker=unknown"
msgid "　今の声は、青子とは違う気がする。"
msgstr ""

#. Occurrence C_11:634:17201: scene=C_11
#: C_11:634
msgctxt "text_id=17201 | speaker=unknown"
msgid "　声質はほぼ同じだから、口調が違うのだろうか？"
msgstr ""

#. Occurrence C_11:639:17202: scene=C_11
#: C_11:639
msgctxt "text_id=17202 | speaker=unknown"
msgid "　いや、それも同じだ。"
msgstr ""

#. Occurrence C_11:644:17203: scene=C_11
#: C_11:644
msgctxt "text_id=17203 | speaker=unknown"
msgid "　どこか違うとしたら、それは………。"
msgstr ""

#. Occurrence C_11:704:17204: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0003; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:704
msgctxt "text_id=17204 | speaker=touko"
msgid "「――――――！」"
msgstr ""

#. Occurrence C_11:710:17205: scene=C_11
#: C_11:710
msgctxt "text_id=17205 | speaker=unknown"
msgid "　そこで、橙子はもう一つの変化に気が付いた。"
msgstr ""

#. Occurrence C_11:715:17206: scene=C_11
#: C_11:715
msgctxt "text_id=17206 | speaker=unknown"
msgid "　変わったのは広場と青子だけではない。"
msgstr ""

#. Occurrence C_11:720:17207: scene=C_11
#: C_11:720
msgctxt "text_id=17207 | speaker=unknown"
msgid "　青子の足下、二つになっていた死体が復元している。"
msgstr ""

#. Occurrence C_11:803:17208: scene=C_11
#: C_11:803
msgctxt "text_id=17208 | speaker=unknown"
msgid "　死者の蘇生？　傷の治療？"
msgstr ""

#. Occurrence C_11:808:17209: scene=C_11
#: C_11:808
msgctxt "text_id=17209 | speaker=unknown"
msgid "　そんな大がかりな術式を施した様子はないし、何より、体を復元したところで“死”は<覆|くつがえ>らない。"
msgstr ""

#. Occurrence C_11:813:17210: scene=C_11
#: C_11:813
msgctxt "text_id=17210 | speaker=unknown"
msgid "　古来、死者の<完|・><全|・><な|・>蘇生は魔法ですら叶えていない。"
msgstr ""

#. Occurrence C_11:818:17211: scene=C_11
#: C_11:818
msgctxt "text_id=17211 | speaker=unknown"
msgid "　だが―――青子の背後で倒れている青年が、意識がないまま呼吸をしているのはどう説明する―――！？"
msgstr ""

#. Occurrence C_11:889:17212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0004; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:889
msgctxt "text_id=17212 | speaker=touko"
msgid "“死者の蘇生が蒼崎の魔法……？"
msgstr ""

#. Occurrence C_11:895:17213: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0005; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:895
msgctxt "text_id=17213 | speaker=touko"
msgid "　いや違う。あれは蘇生というより……”"
msgstr ""

#. Occurrence C_11:970:17214: scene=C_11
#: C_11:970
msgctxt "text_id=17214 | speaker=unknown"
msgid "　その答えが出るより早く、橙子は違和感の正体に気が付いた。"
msgstr ""

#. Occurrence C_11:975:17215: scene=C_11
#: C_11:975
msgctxt "text_id=17215 | speaker=unknown"
msgid "　先ほどの青子の仕草は年相応のものではなかった。"
msgstr ""

#. Occurrence C_11:980:17216: scene=C_11
#: C_11:980
msgctxt "text_id=17216 | speaker=unknown"
msgid "　わずかな外見の変化より、留意すべきは中身の変化だ。"
msgstr ""

#. Occurrence C_11:985:17217: scene=C_11
#: C_11:985
msgctxt "text_id=17217 | speaker=unknown"
msgid "　まさかの結論に達した時、青子は橙子との距離を残り十メートルまで詰めていた。"
msgstr ""

#. Occurrence C_11:1008:17218: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0001; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:1008
msgctxt "text_id=17218 | speaker=aoko"
msgid "「―――<回路|タービン>、<接続|セット>」"
msgstr ""

#. Occurrence C_11:1014:17219: scene=C_11
#: C_11:1014
msgctxt "text_id=17219 | speaker=unknown"
msgid "　その左手が、目の高さまで上げられる。"
msgstr ""

#. Occurrence C_11:1109:17220: scene=C_11
#: C_11:1109
msgctxt "text_id=17220 | speaker=unknown"
msgid "　青子の体内で生成される魔力量が目に見えて……いや、耳に聞こえるほど違う。"
msgstr ""

#. Occurrence C_11:1114:17221: scene=C_11
#: C_11:1114
msgctxt "text_id=17221 | speaker=unknown"
msgid "　橙子ですら聞いた事のない快音。"
msgstr ""

#. Occurrence C_11:1119:17222: scene=C_11
#: C_11:1119
msgctxt "text_id=17222 | speaker=unknown"
msgid "　青子のソレは、<凡夫|ぼんぷ>の魔術師に見られる、単一機能しか持たない低級魔術回路だ。魔力の生成量は橙子を遥かに下回る。"
msgstr ""

#. Occurrence C_11:1139:17223: scene=C_11
#: C_11:1139
msgctxt "text_id=17223 | speaker=unknown"
msgid "　だがあの速度は異常にすぎる。"
msgstr ""

#. Occurrence C_11:1144:17224: scene=C_11
#: C_11:1144
msgctxt "text_id=17224 | speaker=unknown"
msgid "　あきらかに血流の速度を上回っているし、なにより―――"
msgstr ""

#. Occurrence C_11:1212:17225: scene=C_11
#: C_11:1212
msgctxt "text_id=17225 | speaker=unknown"
msgid "　魔術による<振動|おと>ならともかく、<た|・><だ|・><魔|・><術|・><回|・><路|・><が|・><起|・><動|・><す|・><る|・><だ|・><け|・><で|・><波|おと>をあげるなど、協会でも聞いた事がない―――！"
msgstr ""

#. Occurrence C_11:1256:17226: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0006; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1256
msgctxt "text_id=17226 | speaker=touko"
msgid "「我が目前に勝利ありき―――」"
msgstr ""

#. Occurrence C_11:1358:17227: scene=C_11
#: C_11:1358
msgctxt "text_id=17227 | speaker=unknown"
msgid "　<悪寒|おかん>に<急|せ>かされるよう、橙子は中空にルーンを刻む。"
msgstr ""

#. Occurrence C_11:1363:17228: scene=C_11
#: C_11:1363
msgctxt "text_id=17228 | speaker=unknown"
msgid "　青子が仕掛けてくるであろう魔術を防ぐため<勝利|トゥール>の加護を張り、さらに刻印の力で強化し、障壁としたのだ。"
msgstr ""

#. Occurrence C_11:1450:17229: scene=C_11
#: C_11:1450
msgctxt "text_id=17229 | speaker=unknown"
msgid "　対して、青子は意にも介さず、照準を合わせる為に腕をあげる事もなく、"
msgstr ""

#. Occurrence C_11:1457:17230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0002; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:1457
msgctxt "text_id=17230 | speaker=aoko"
msgid "「―――魔弾、展開」"
msgstr ""

#. Occurrence C_11:1463:17231: scene=C_11
#: C_11:1463
msgctxt "text_id=17231 | speaker=unknown"
msgid "　短く、自分自身に命令した。"
msgstr ""

#. Occurrence C_11:1768:17232: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0007; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1768
msgctxt "text_id=17232 | speaker=touko"
msgid "「！！！？」"
msgstr ""

#. Occurrence C_11:1774:17233: scene=C_11
#: C_11:1774
msgctxt "text_id=17233 | speaker=unknown"
msgid "　魔術の起こりさえ見えない。"
msgstr ""

#. Occurrence C_11:1779:17234: scene=C_11
#: C_11:1779
msgctxt "text_id=17234 | speaker=unknown"
msgid "　一言で放たれた魔弾は実に二十発。"
msgstr ""

#. Occurrence C_11:1784:17235: scene=C_11
#: C_11:1784
msgctxt "text_id=17235 | speaker=unknown"
msgid "　それは流星のように、ロケット弾すら弾くルーンの壁を溶解し、蒼崎橙子の<礼装|コート>を撃ち抜いた。"
msgstr ""

#. Occurrence C_11:1944:17236: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0008; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1944
msgctxt "text_id=17236 | speaker=touko"
msgid "「っ、装填ではなく展開だと―――！？」"
msgstr ""

#. Occurrence C_11:1950:17237: scene=C_11
#: C_11:1950
msgctxt "text_id=17237 | speaker=unknown"
msgid "　<礼装|コート>にかけてある防護のルーンが悲鳴をあげる。"
msgstr ""

#. Occurrence C_11:1955:17238: scene=C_11
#: C_11:1955
msgctxt "text_id=17238 | speaker=unknown"
msgid "　あの掃射をもう一度受ければ<保|も>たない。"
msgstr ""

#. Occurrence C_11:1960:17239: scene=C_11
#: C_11:1960
msgctxt "text_id=17239 | speaker=unknown"
msgid "　それ以前に、今の直撃で間違いなく<内臓|かいろ>に傷が入った。"
msgstr ""

#. Occurrence C_11:1980:17240: scene=C_11
#: C_11:1980
msgctxt "text_id=17240 | speaker=unknown"
msgid "　認めたくはないが、直接的な火力において蒼崎青子は蒼崎橙子を上回っている。"
msgstr ""

#. Occurrence C_11:2035:17241: scene=C_11
#: C_11:2035
msgctxt "text_id=17241 | speaker=unknown"
msgid "　さらに認めがたいのは―――おそらく、あの女はまだ<本|・><気|・><に|・><す|・><ら|・><な|・><っ|・><て|・><い|・><な|・><い|・>……！"
msgstr ""

#. Occurrence C_11:2072:17242: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0009; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2072
msgctxt "text_id=17242 | speaker=touko"
msgid "「<[ansz]|アンサズ>、<[swel]|ソウェル>、<[ingz]|イングズ>ッ！」"
msgstr ""

#. Occurrence C_11:2109:17243: scene=C_11
#: C_11:2109
msgctxt "text_id=17243 | speaker=unknown"
msgid "　橙子は跳びのきながら中空にルーンを描く。"
msgstr ""

#. Occurrence C_11:2114:17244: scene=C_11
#: C_11:2114
msgctxt "text_id=17244 | speaker=unknown"
msgid "　一喝に応じて刻印は炎へと転じていく。"
msgstr ""

#. Occurrence C_11:2119:17245: scene=C_11
#: C_11:2119
msgctxt "text_id=17245 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence C_11:2128:17246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0003; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:2128
msgctxt "text_id=17246 | speaker=aoko"
msgid "「―――<古|おそ>いっ！」"
msgstr ""

#. Occurrence C_11:2210:17247: scene=C_11
#: C_11:2210
msgctxt "text_id=17247 | speaker=unknown"
msgid "　それを、青子はただ一言で打ち消した。"
msgstr ""

#. Occurrence C_11:2215:17248: scene=C_11
#: C_11:2215
msgctxt "text_id=17248 | speaker=unknown"
msgid "　ルーンは意味を持つ前に砕け散る。"
msgstr ""

#. Occurrence C_11:2220:17249: scene=C_11
#: C_11:2220
msgctxt "text_id=17249 | speaker=unknown"
msgid "　単純に、ルーンをカタチにする橙子の魔力より、彼女の言葉の力が上回ったのだ。"
msgstr ""

#. Occurrence C_11:2280:17250: scene=C_11
#: C_11:2280
msgctxt "text_id=17250 | speaker=unknown"
msgid "　ルーンを無効化し、青子は白い花園を突き進む。"
msgstr ""

#. Occurrence C_11:2285:17251: scene=C_11
#: C_11:2285
msgctxt "text_id=17251 | speaker=unknown"
msgid "　その<表情|かお>も、安定した魔術回路の働きも、息遣いさえ今までの彼女とは違う。"
msgstr ""

#. Occurrence C_11:2290:17252: scene=C_11
#: C_11:2290
msgctxt "text_id=17252 | speaker=unknown"
msgid "　それは多くの戦闘経験を得た者にしか出来えない、最適化された自己管理だ。"
msgstr ""

#. Occurrence C_11:2311:17253: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0010; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2311
msgctxt "text_id=17253 | speaker=touko"
msgid "「―――あれは、<経験|じかん>か―――？」"
msgstr ""

#. Occurrence C_11:2316:17254: scene=C_11
#: C_11:2316
msgctxt "text_id=17254 | speaker=unknown"
msgid "　それが蒼崎の魔法の正体だとしたら、たしかにすべてが<符|ふ><合|ごう>する。"
msgstr ""

#. Occurrence C_11:2336:17255: scene=C_11
#: C_11:2336
msgctxt "text_id=17255 | speaker=unknown"
msgid "　青子の魔術回路が増幅されたのではない。"
msgstr ""

#. Occurrence C_11:2341:17256: scene=C_11
#: C_11:2341
msgctxt "text_id=17256 | speaker=unknown"
msgid "　そもそもそんな事は出来ないし、橙子のように外付けにしたところで、増えるのは魔力の総量と使用可能な術式だけ。"
msgstr ""

#. Occurrence C_11:2347:17257: scene=C_11
#: C_11:2347
msgctxt "text_id=17257 | speaker=unknown"
msgid "魔術師自体の資質、魔術回路の純度は変わらない。"
msgstr ""

#. Occurrence C_11:2352:17258: scene=C_11
#: C_11:2352
msgctxt "text_id=17258 | speaker=unknown"
msgid "　だが、今の青子は明らかに<魔|・><術|・><師|・><と|・><し|・><て|・>蒼崎橙子を凌駕している。"
msgstr ""

#. Occurrence C_11:2373:17259: scene=C_11
#: C_11:2373
msgctxt "text_id=17259 | speaker=unknown"
msgid "　ならば答えは一つ。"
msgstr ""

#. Occurrence C_11:2396:17260: scene=C_11
#: C_11:2396
msgctxt "text_id=17260 | speaker=unknown"
msgid "　あの見習い魔術師は一瞬で一人前の魔術師に成長―――"
msgstr ""

#. Occurrence C_11:2396:17261: scene=C_11
#: C_11:2396
msgctxt "text_id=17261 | speaker=unknown"
msgid "　いや、自身の<時|・><間|・><を|・><早|・><送|・><り|・>したのだ。"
msgstr ""

#. Occurrence C_11:2463:17262: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0011; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2463
msgctxt "text_id=17262 | speaker=touko"
msgid "「っ―――！」"
msgstr ""

#. Occurrence C_11:2497:17263: scene=C_11
#: C_11:2497
msgctxt "text_id=17263 | speaker=unknown"
msgid "　青子に背を向けて、オレンジ色の魔術師は走りだした。"
msgstr ""

#. Occurrence C_11:2502:17264: scene=C_11
#: C_11:2502
msgctxt "text_id=17264 | speaker=unknown"
msgid "　<こ|・><こ|・>では勝ち目がないと直感し、旧校舎に逃げこんでいく。"
msgstr ""

#. Occurrence C_11:2507:17265: scene=C_11
#: C_11:2507
msgctxt "text_id=17265 | speaker=unknown"
msgid "　その背中を青子は狙わなかった。"
msgstr ""

#. Occurrence C_11:2512:17266: scene=C_11
#: C_11:2512
msgctxt "text_id=17266 | speaker=unknown"
msgid "　情けからではなく、冷静に、この距離からでは仕損じると判断して。"
msgstr ""

#. Occurrence C_11:2533:17267: scene=C_11
#: C_11:2533
msgctxt "text_id=17267 | speaker=unknown"
msgid "　逃すまいと青子は身を乗り出し、はた、と思い立ったように足を止めた。"
msgstr ""

#. Occurrence C_11:2579:17268: scene=C_11
#: C_11:2579
msgctxt "text_id=17268 | speaker=unknown"
msgid "　……言葉にするのは少し迷う。"
msgstr ""

#. Occurrence C_11:2584:17269: scene=C_11
#: C_11:2584
msgctxt "text_id=17269 | speaker=unknown"
msgid "　彼女は小さく息を呑んで、"
msgstr ""

#. Occurrence C_11:2601:17270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0004; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:2601
msgctxt "text_id=17270 | speaker=aoko"
msgid "「アリス。そいつ、お願い」"
msgstr ""

#. Occurrence C_11:2674:17271: scene=C_11
#: C_11:2674
msgctxt "text_id=17271 | speaker=unknown"
msgid "　大人びた声を恥じるように、そんな言葉を口にした。"
msgstr ""

#. Occurrence C_11:2757:17272: scene=C_11
#: C_11:2757
msgctxt "text_id=17272 | speaker=unknown"
msgid "　白い花が散っていく。"
msgstr ""

#. Occurrence C_11:2762:17273: scene=C_11
#: C_11:2762
msgctxt "text_id=17273 | speaker=unknown"
msgid "　青子は振り返らず、長い髪をなびかせて橙子の後を追っていった。"
msgstr ""

#. Occurrence C_12:70:17274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0000; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:70
msgctxt "text_id=17274 | speaker=soujuurou"
msgid "「―――あれ？」"
msgstr ""

#. Occurrence C_12:76:17275: scene=C_12
#: C_12:76
msgctxt "text_id=17275 | speaker=unknown"
msgid "　ぱちり、と軽快に<目蓋|まぶた>が開く。"
msgstr ""

#. Occurrence C_12:81:17276: scene=C_12
#: C_12:81
msgctxt "text_id=17276 | speaker=unknown"
msgid "　<永|なが>い休眠から草十郎は目を覚ました。"
msgstr ""

#. Occurrence C_12:101:17277: scene=C_12
#: C_12:101
msgctxt "text_id=17277 | speaker=unknown"
msgid "　仰向けに寝っころがっているらしく、視界にはいっぱいの星空が広がっている。"
msgstr ""

#. Occurrence C_12:106:17278: scene=C_12
#: C_12:106
msgctxt "text_id=17278 | speaker=unknown"
msgid "　木々によって形作られた円形の空。"
msgstr ""

#. Occurrence C_12:111:17279: scene=C_12
#: C_12:111
msgctxt "text_id=17279 | speaker=unknown"
msgid "　それは初めて見たものなのに、"
msgstr ""

#. Occurrence C_12:116:17280: scene=C_12
#: C_12:116
msgctxt "text_id=17280 | speaker=unknown"
msgid "　久しく忘れていた景色に見えて、居心地が悪かった。"
msgstr ""

#. Occurrence C_12:187:17281: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0001; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:187
msgctxt "text_id=17281 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence C_12:193:17282: scene=C_12
#: C_12:193
msgctxt "text_id=17282 | speaker=unknown"
msgid "　どうにも自分が確かではない。"
msgstr ""

#. Occurrence C_12:198:17283: scene=C_12
#: C_12:198
msgctxt "text_id=17283 | speaker=unknown"
msgid "　眠る前に何をしていたのか、"
msgstr ""

#. Occurrence C_12:203:17284: scene=C_12
#: C_12:203
msgctxt "text_id=17284 | speaker=unknown"
msgid "　どうして眠っていたのか、"
msgstr ""

#. Occurrence C_12:208:17285: scene=C_12
#: C_12:208
msgctxt "text_id=17285 | speaker=unknown"
msgid "　キレイさっぱり記憶にない。"
msgstr ""

#. Occurrence C_12:213:17286: scene=C_12
#: C_12:213
msgctxt "text_id=17286 | speaker=unknown"
msgid "　これから出かけようと玄関をすぎた直後、目を開けたらベッドにいたような気分だ。"
msgstr ""

#. Occurrence C_12:234:17287: scene=C_12
#: C_12:234
msgctxt "text_id=17287 | speaker=unknown"
msgid "　前後の出来事が無さすぎて、自分が何者であるのかさえ、すぐには思い至らない。"
msgstr ""

#. Occurrence C_12:285:17288: scene=C_12
#: C_12:285
msgctxt "text_id=17288 | speaker=unknown"
msgid "　思い出せるのはただ、"
msgstr ""

#. Occurrence C_12:345:17289: scene=C_12
#: C_12:345
msgctxt "text_id=17289 | speaker=unknown"
msgid "　見たこともない女の人と、"
msgstr ""

#. Occurrence C_12:407:17290: scene=C_12
#: C_12:407
msgctxt "text_id=17290 | speaker=unknown"
msgid "　首にかかった細い"
msgstr ""

#. Occurrence C_12:443:17291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0000; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:443
msgctxt "text_id=17291 | speaker=alice"
msgid "「静希君」"
msgstr ""

#. Occurrence C_12:502:17292: scene=C_12
#: C_12:502
msgctxt "text_id=17292 | speaker=unknown"
msgid "　真横から誰かの声……低いのによく通る声は、たしか、久遠寺有珠という少女の物だ。"
msgstr ""

#. Occurrence C_12:523:17293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0002; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:523
msgctxt "text_id=17293 | speaker=soujuurou"
msgid "「そういえば、そうだった」"
msgstr ""

#. Occurrence C_12:582:17294: scene=C_12
#: C_12:582
msgctxt "text_id=17294 | speaker=unknown"
msgid "　脈絡のない呟きと共に、草十郎は体を起こす。"
msgstr ""

#. Occurrence C_12:656:17295: scene=C_12
#: C_12:656
msgctxt "text_id=17295 | speaker=unknown"
msgid "　目を覚ました彼の横には、黒衣の少女が正座していた。"
msgstr ""

#. Occurrence C_12:681:17296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0003; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:681
msgctxt "text_id=17296 | speaker=soujuurou"
msgid "「……花だ」"
msgstr ""

#. Occurrence C_12:720:17297: scene=C_12
#: C_12:720
msgctxt "text_id=17297 | speaker=unknown"
msgid "　<傍|かたわ>らの有珠を見ず、ぼんやりと口にする。"
msgstr ""

#. Occurrence C_12:725:17298: scene=C_12
#: C_12:725
msgctxt "text_id=17298 | speaker=unknown"
msgid "　……<蒼|あお>い月明かりの下、枯れた木々と雪原に囲まれて、春の花園が<揺|ゆ>らめいていた。"
msgstr ""

#. Occurrence C_12:780:17299: scene=C_12
#: C_12:780
msgctxt "text_id=17299 | speaker=unknown"
msgid "　夜風に散る花びらは蝶のように、白い身を闇夜にくっきりと浮かびあがらせる。"
msgstr ""

#. Occurrence C_12:785:17300: scene=C_12
#: C_12:785
msgctxt "text_id=17300 | speaker=unknown"
msgid "　長く、その光景を見つめて、草十郎はそっと首に指を置いた。"
msgstr ""

#. Occurrence C_12:796:17301: scene=C_12
#: C_12:796
msgctxt "text_id=17301 | speaker=unknown"
msgid "　はじめは、傷口に触れるように恐る恐る。"
msgstr ""

#. Occurrence C_12:802:17302: scene=C_12
#: C_12:802
msgctxt "text_id=17302 | speaker=unknown"
msgid "　あとは、握りこむように、強く強く。"
msgstr ""

#. Occurrence C_12:823:17303: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0001; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:823
msgctxt "text_id=17303 | speaker=alice"
msgid "「―――静希君」"
msgstr ""

#. Occurrence C_12:829:17304: scene=C_12
#: C_12:829
msgctxt "text_id=17304 | speaker=unknown"
msgid "　その暗転を止めたのは、傍らの少女の声だった。"
msgstr ""

#. Occurrence C_12:850:17305: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0002; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:850
msgctxt "text_id=17305 | speaker=alice"
msgid "「せっかく戻れたのに、またいくの……？」"
msgstr ""

#. Occurrence C_12:936:17306: scene=C_12
#: C_12:936
msgctxt "text_id=17306 | speaker=unknown"
msgid "　問いかけの意味を、草十郎は掴めなかった。"
msgstr ""

#. Occurrence C_12:941:17307: scene=C_12
#: C_12:941
msgctxt "text_id=17307 | speaker=unknown"
msgid "　批難と哀しみの混じった声。"
msgstr ""

#. Occurrence C_12:946:17308: scene=C_12
#: C_12:946
msgctxt "text_id=17308 | speaker=unknown"
msgid "　その、有珠らしからぬ眼差しに責められて、彼は無意識から解放された。"
msgstr ""

#. Occurrence C_12:1004:17309: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0004; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1004
msgctxt "text_id=17309 | speaker=soujuurou"
msgid "「いくって、どこに」"
msgstr ""

#. Occurrence C_12:1010:17310: scene=C_12
#: C_12:1010
msgctxt "text_id=17310 | speaker=unknown"
msgid "　首から落ちる指。"
msgstr ""

#. Occurrence C_12:1015:17311: scene=C_12
#: C_12:1015
msgctxt "text_id=17311 | speaker=unknown"
msgid "　有珠は答えず、無表情に空を見上げた。"
msgstr ""

#. Occurrence C_12:1021:17312: scene=C_12
#: C_12:1021
msgctxt "text_id=17312 | speaker=unknown"
msgid "　そこにあるのは、ただ暗いばかりの――――――。"
msgstr ""

#. Occurrence C_12:1042:17313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0005; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1042
msgctxt "text_id=17313 | speaker=soujuurou"
msgid "「……ま、いいや。それより俺は何をしてたんだろう。"
msgstr ""

#. Occurrence C_12:1048:17314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0006; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1048
msgctxt "text_id=17314 | speaker=soujuurou"
msgid "　なんかヘンだ。ごちゃごちゃしてる」"
msgstr ""

#. Occurrence C_12:1102:17315: scene=C_12
#: C_12:1102
msgctxt "text_id=17315 | speaker=unknown"
msgid "　はて、と首を傾げる草十郎を、有珠はじいっと観察する。"
msgstr ""

#. Occurrence C_12:1107:17316: scene=C_12
#: C_12:1107
msgctxt "text_id=17316 | speaker=unknown"
msgid "　さっきの人狼を一蹴した少年と、こうやって呆けている少年はまるっきり別人で、そのくせ、まるで違和感がない。"
msgstr ""

#. Occurrence C_12:1127:17317: scene=C_12
#: C_12:1127
msgctxt "text_id=17317 | speaker=unknown"
msgid "　その不思議を見抜こうと少年を見つめるのだが、納得いく答えは出ないだろう事も、なんとなく有珠は認めていた。"
msgstr ""

#. Occurrence C_12:1150:17318: scene=C_12
#: C_12:1150
msgctxt "text_id=17318 | speaker=unknown"
msgid "　そうして問いかける。"
msgstr ""

#. Occurrence C_12:1155:17319: scene=C_12
#: C_12:1155
msgctxt "text_id=17319 | speaker=unknown"
msgid "　彼が眠っていた間、遠く離れた彼女が何度も繰り返して、しまいには怒って止めてしまった、その問いを。"
msgstr ""

#. Occurrence C_12:1283:17320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0003; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1283
msgctxt "text_id=17320 | speaker=alice"
msgid "「……今まで、静希君は何をしていたの？」"
msgstr ""

#. Occurrence C_12:1289:17321: scene=C_12
#: C_12:1289
msgctxt "text_id=17321 | speaker=unknown"
msgid "　静かな問いかけは、旅人を魅了する魔術に等しい。"
msgstr ""

#. Occurrence C_12:1294:17322: scene=C_12
#: C_12:1294
msgctxt "text_id=17322 | speaker=unknown"
msgid "　それに魅了されてか、草十郎は記憶の海に沈みこむ。"
msgstr ""

#. Occurrence C_12:1335:17323: scene=C_12
#: C_12:1335
msgctxt "text_id=17323 | speaker=unknown"
msgid "　沈黙の間、ふたりは兄妹のように、白い丘に<佇|たたず>んでいた。"
msgstr ""

#. Occurrence C_12:1356:17324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0007; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1356
msgctxt "text_id=17324 | speaker=soujuurou"
msgid "「……誰かの声が聞こえた気がする。"
msgstr ""

#. Occurrence C_12:1363:17325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0008; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1363
msgctxt "text_id=17325 | speaker=soujuurou"
msgid "何かを訊いているようだった。けど、自分は最後まで、一言も返せなかった」"
msgstr ""

#. Occurrence C_12:1369:17326: scene=C_12
#: C_12:1369
msgctxt "text_id=17326 | speaker=unknown"
msgid "　死中の闇において繰り返された問いを、彼はおぼろげに思い出した。"
msgstr ""

#. Occurrence C_12:1374:17327: scene=C_12
#: C_12:1374
msgctxt "text_id=17327 | speaker=unknown"
msgid "　死んでいた事すら分かっていないが、彼女の時間と交差した断片は残っているようだ。"
msgstr ""

#. Occurrence C_12:1431:17328: scene=C_12
#: C_12:1431
msgctxt "text_id=17328 | speaker=unknown"
msgid "　草十郎は悔いるように顔を<曇|くも>らせる。"
msgstr ""

#. Occurrence C_12:1436:17329: scene=C_12
#: C_12:1436
msgctxt "text_id=17329 | speaker=unknown"
msgid "　その横顔に有珠は静かに問いかける。"
msgstr ""

#. Occurrence C_12:1445:17330: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0004; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1445
msgctxt "text_id=17330 | speaker=alice"
msgid "「……それで、欲しい物は見つかった？」"
msgstr ""

#. Occurrence C_12:1544:17331: scene=C_12
#: C_12:1544
msgctxt "text_id=17331 | speaker=unknown"
msgid "　それが『誰か』に訊ねられていた事だと思い出して、彼はかすかにうなずいた。"
msgstr ""

#. Occurrence C_12:1678:17332: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0009; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1678
msgctxt "text_id=17332 | speaker=soujuurou"
msgid "「……ああ、そうだった。"
msgstr ""

#. Occurrence C_12:1685:17333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0010; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1685
msgctxt "text_id=17333 | speaker=soujuurou"
msgid "けれどね、有珠。そんな物は、見つからないって思っていたんだ。"
msgstr ""

#. Occurrence C_12:1691:17334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0011; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1691
msgctxt "text_id=17334 | speaker=soujuurou"
msgid "　……うん。ずっと、そう思っていた」"
msgstr ""

#. Occurrence C_12:1704:17335: scene=C_12
#: C_12:1704
msgctxt "text_id=17335 | speaker=unknown"
msgid "　悔いる声には、かすかな強さが混じっている。"
msgstr ""

#. Occurrence C_12:1709:17336: scene=C_12
#: C_12:1709
msgctxt "text_id=17336 | speaker=unknown"
msgid "　見下ろす白い花園は、死者を迎える<彼岸|ひがん>のようだ。"
msgstr ""

#. Occurrence C_12:1714:17337: scene=C_12
#: C_12:1714
msgctxt "text_id=17337 | speaker=unknown"
msgid "　それが、少しだけ草十郎には<眩|まぶ>しかった。"
msgstr ""

#. Occurrence C_12:1765:17338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0012; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1765
msgctxt "text_id=17338 | speaker=soujuurou"
msgid "「思い出した。青子の前でざっくりいったんだっけ。"
msgstr ""

#. Occurrence C_12:1771:17339: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0013; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1771
msgctxt "text_id=17339 | speaker=soujuurou"
msgid "　なのに生きているのは、どういう事なんだろう」"
msgstr ""

#. Occurrence C_12:1798:17340: scene=C_12
#: C_12:1798
msgctxt "text_id=17340 | speaker=unknown"
msgid "　不思議そうに体を触る草十郎。"
msgstr ""

#. Occurrence C_12:1803:17341: scene=C_12
#: C_12:1803
msgctxt "text_id=17341 | speaker=unknown"
msgid "　両腕も完全に元のままで、肝心の青子の姿はない。"
msgstr ""

#. Occurrence C_12:1882:17342: scene=C_12
#: C_12:1882
msgctxt "text_id=17342 | speaker=unknown"
msgid "　答えを求めて有珠に視線を向けると、彼女は座ったままで、どこか拗ねるように、"
msgstr ""

#. Occurrence C_12:1954:17343: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0005; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1954
msgctxt "text_id=17343 | speaker=alice"
msgid "「巻き戻されたのよ、静希君は。"
msgstr ""

#. Occurrence C_12:1960:17344: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0006; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1960
msgctxt "text_id=17344 | speaker=alice"
msgid "　この風景も本来は貴方の記憶だけど、わからない……？」"
msgstr ""

#. Occurrence C_12:1966:17345: scene=C_12
#: C_12:1966
msgctxt "text_id=17345 | speaker=unknown"
msgid "　などと、おかしな言葉を口にした。"
msgstr ""

#. Occurrence C_12:2007:17346: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0014; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2007
msgctxt "text_id=17346 | speaker=soujuurou"
msgid "「俺の、記憶って……そのわりには、知らないところなんだけど」"
msgstr ""

#. Occurrence C_12:2013:17347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0007; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2013
msgctxt "text_id=17347 | speaker=alice"
msgid "「いま静希君の時間は青子に使われているから。それが戻されるまで思い出す事はないわ」"
msgstr ""

#. Occurrence C_12:2019:17348: scene=C_12
#: C_12:2019
msgctxt "text_id=17348 | speaker=unknown"
msgid "　物騒な返答をして、有珠は花園を見渡した。"
msgstr ""

#. Occurrence C_12:2082:17349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0008; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2082
msgctxt "text_id=17349 | speaker=alice"
msgid "「……でも、これが消えてしまうのは残念ね。"
msgstr ""

#. Occurrence C_12:2088:17350: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0009; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2088
msgctxt "text_id=17350 | speaker=alice"
msgid "　元に戻れば、思い返せるのはわたしだけなのに」"
msgstr ""

#. Occurrence C_12:2094:17351: scene=C_12
#: C_12:2094
msgctxt "text_id=17351 | speaker=unknown"
msgid "　一瞬だけ瞳を細めて、有珠は白い花々を見る。"
msgstr ""

#. Occurrence C_12:2155:17352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0015; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2155
msgctxt "text_id=17352 | speaker=soujuurou"
msgid "「…………」"
msgstr ""

#. Occurrence C_12:2160:17353: scene=C_12
#: C_12:2160
msgctxt "text_id=17353 | speaker=unknown"
msgid "　彼女の言葉は、草十郎にはやっぱりさっぱり。"
msgstr ""

#. Occurrence C_12:2231:17354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0016; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2231
msgctxt "text_id=17354 | speaker=soujuurou"
msgid "「有珠。君、答える気がないんだろう」"
msgstr ""

#. Occurrence C_12:2236:17355: scene=C_12
#: C_12:2236
msgctxt "text_id=17355 | speaker=unknown"
msgid "　草十郎の声に、有珠はつい、と振り向いた。"
msgstr ""

#. Occurrence C_12:2294:17356: scene=C_12
#: C_12:2294
msgctxt "text_id=17356 | speaker=unknown"
msgid "　深い瞳は、どんな感情を秘めているかも分からない。"
msgstr ""

#. Occurrence C_12:2370:17357: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0010; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2370
msgctxt "text_id=17357 | speaker=alice"
msgid "「意味のない話だけど、聞きたい？」"
msgstr ""

#. Occurrence C_12:2376:17358: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0017; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2376
msgctxt "text_id=17358 | speaker=soujuurou"
msgid "「聞きたい。有珠が教えてくれるなら尚更だ」"
msgstr ""

#. Occurrence C_12:2437:17359: scene=C_12
#: C_12:2437
msgctxt "text_id=17359 | speaker=unknown"
msgid "　力強くうなずく草十郎に、有珠はそう、とため息まじりに目を閉じた。"
msgstr ""

#. Occurrence C_12:2442:17360: scene=C_12
#: C_12:2442
msgctxt "text_id=17360 | speaker=unknown"
msgid "　それでも口を開いたのは、草十郎を嫌っての事ではなく、彼女なりに気を遣っているからだろう。"
msgstr ""

#. Occurrence C_12:2590:17361: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0011; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2590
msgctxt "text_id=17361 | speaker=alice"
msgid "「……結論だけ言うと、貴方は一度死んで、生き返ったの。"
msgstr ""

#. Occurrence C_12:2596:17362: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0012; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2596
msgctxt "text_id=17362 | speaker=alice"
msgid "　静希君が橙子さんに殺されてから、青子が目を覚ますまでの五分間分の時間を巻き戻して。"
msgstr ""

#. Occurrence C_12:2602:17363: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0013; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2602
msgctxt "text_id=17363 | speaker=alice"
msgid "　その時、貴方は十年近い年月を青子に使われた。"
msgstr ""

#. Occurrence C_12:2608:17364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0014; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2608
msgctxt "text_id=17364 | speaker=alice"
msgid "　二人とも肉体年齢は変わってないから、<精神|なか>の時間だけ持っていったんでしょうね。"
msgstr ""

#. Occurrence C_12:2614:17365: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0015; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2614
msgctxt "text_id=17365 | speaker=alice"
msgid "　だから今、この景色を懐かしく思えるのは青子だけ。"
msgstr ""

#. Occurrence C_12:2621:17366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0016; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2621
msgctxt "text_id=17366 | speaker=alice"
msgid "　そして…………」"
msgstr ""

#. Occurrence C_12:2641:17367: scene=C_12
#: C_12:2641
msgctxt "text_id=17367 | speaker=unknown"
msgid "　そして、時間の交換が終われば、この数分たらずの出来事は、青子と草十郎の記憶から失われる。"
msgstr ""

#. Occurrence C_12:2647:17368: scene=C_12
#: C_12:2647
msgctxt "text_id=17368 | speaker=unknown"
msgid "　青子ひとりだけの変化ではなく、他人を媒介にした魔法の結果だ。"
msgstr ""

#. Occurrence C_12:2652:17369: scene=C_12
#: C_12:2652
msgctxt "text_id=17369 | speaker=unknown"
msgid "　青子ひとりでの逆行であれば、時間軸の矛盾もふくめて彼女の経験になるが、今回は<ま|・><っ|・><と|・><う|・>な時間旅行である。"
msgstr ""

#. Occurrence C_12:2657:17370: scene=C_12
#: C_12:2657
msgctxt "text_id=17370 | speaker=unknown"
msgid "　矛盾はきちんと修正される。"
msgstr ""

#. Occurrence C_12:2683:17371: scene=C_12
#: C_12:2683
msgctxt "text_id=17371 | speaker=unknown"
msgid "　いずれ魔法が解ければ、"
msgstr ""

#. Occurrence C_12:2688:17372: scene=C_12
#: C_12:2688
msgctxt "text_id=17372 | speaker=unknown"
msgid "　此処を懐かしく思った青子も、"
msgstr ""

#. Occurrence C_12:2693:17373: scene=C_12
#: C_12:2693
msgctxt "text_id=17373 | speaker=unknown"
msgid "　此処を初めてと感じた草十郎も、"
msgstr ""

#. Occurrence C_12:2698:17374: scene=C_12
#: C_12:2698
msgctxt "text_id=17374 | speaker=unknown"
msgid "　なかった事として修正される。"
msgstr ""

#. Occurrence C_12:2704:17375: scene=C_12
#: C_12:2704
msgctxt "text_id=17375 | speaker=unknown"
msgid "　この奇跡。"
msgstr ""

#. Occurrence C_12:2709:17376: scene=C_12
#: C_12:2709
msgctxt "text_id=17376 | speaker=unknown"
msgid "　白い花の海を覚えていられるのは、第三者である有珠と橙子だけになる。"
msgstr ""

#. Occurrence C_12:2730:17377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0018; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2730
msgctxt "text_id=17377 | speaker=soujuurou"
msgid "「……時間を、持っていく……？」"
msgstr ""

#. Occurrence C_12:2736:17378: scene=C_12
#: C_12:2736
msgctxt "text_id=17378 | speaker=unknown"
msgid "　ますます首を傾げる草十郎に、有珠はとりあえず形だけ説明する事にした。"
msgstr ""

#. Occurrence C_12:2741:17379: scene=C_12
#: C_12:2741
msgctxt "text_id=17379 | speaker=unknown"
msgid "　理解してもらえなくても、概要を説明してあげれば草十郎は聞き返してこない、と青子が言っていたのを思いだして。"
msgstr ""

#. Occurrence C_12:2762:17380: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0017; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2762
msgctxt "text_id=17380 | speaker=alice"
msgid "「静希君を生き返らせる方法はなかったから、生命の復元より、死そのものの回避を青子は<試|こころ>みたのよ。"
msgstr ""

#. Occurrence C_12:2768:17381: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0018; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2768
msgctxt "text_id=17381 | speaker=alice"
msgid "　まだ青子には無理なのか、それとも、今回も<日|ひ><和|よ>ったのか。"
msgstr ""

#. Occurrence C_12:2774:17382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0019; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2774
msgctxt "text_id=17382 | speaker=alice"
msgid "　大きな操作は避けて、小さな操作―――自分と貴方だけの交換に<留|とど>めたようね」"
msgstr ""

#. Occurrence C_12:2882:17383: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0020; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2882
msgctxt "text_id=17383 | speaker=alice"
msgid "「貴方はいま、五分間だけ時間を跳んだ事になるわ。"
msgstr ""

#. Occurrence C_12:2888:17384: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0021; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2888
msgctxt "text_id=17384 | speaker=alice"
msgid "　仮に、遠い未来、この時間を検索できる人がいたとしても、貴方だけは誰にも見つけられない。だって、時間軸の上にいなかったんですもの」"
msgstr ""

#. Occurrence C_12:2962:17385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0022; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2962
msgctxt "text_id=17385 | speaker=alice"
msgid "「そして同時に、青子は自分の時間を上乗せするために、貴方から時間を借り受けた。"
msgstr ""

#. Occurrence C_12:2968:17386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0023; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2968
msgctxt "text_id=17386 | speaker=alice"
msgid "　たぶん幼年期の時間でしょうね。個人の時間操作は、忘却している部分の方が楽だと聞くし……静希君？」"
msgstr ""

#. Occurrence C_12:3029:17387: scene=C_12
#: C_12:3029
msgctxt "text_id=17387 | speaker=unknown"
msgid "　もうこの辺で止めておく？"
msgstr ""

#. Occurrence C_12:3034:17388: scene=C_12
#: C_12:3034
msgctxt "text_id=17388 | speaker=unknown"
msgid "　という有珠の視線に、頷く事しかできない草十郎だった。"
msgstr ""

#. Occurrence C_12:3073:17389: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0024; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3073
msgctxt "text_id=17389 | speaker=alice"
msgid "「……つまり、二つの奇跡を青子は行使したの。"
msgstr ""

#. Occurrence C_12:3079:17390: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0025; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3079
msgctxt "text_id=17390 | speaker=alice"
msgid "　貴方の体の巻き戻しと、自分の体の早送りね。"
msgstr ""

#. Occurrence C_12:3085:17391: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0026; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3085
msgctxt "text_id=17391 | speaker=alice"
msgid "　静希君の時間に介入する際、ついでに十年分の時間を借り受けて、未来の自分を持ってきた」"
msgstr ""

#. Occurrence C_12:3106:17392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0027; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3106
msgctxt "text_id=17392 | speaker=alice"
msgid "「だから、いま橙子さんを殺そうとしているのは<二|・><十|・><七|・><歳|・>分の<経験|じかん>をもった蒼崎青子という事になるわ」"
msgstr ""

#. Occurrence C_12:3112:17393: scene=C_12
#: C_12:3112
msgctxt "text_id=17393 | speaker=unknown"
msgid "　……だから、まったくちんぷんかんぷんなんだ、有珠。"
msgstr ""

#. Occurrence C_12:3117:17394: scene=C_12
#: C_12:3117
msgctxt "text_id=17394 | speaker=unknown"
msgid "　そんな感想を表情で示しながらも、橙子に関する説明に草十郎は眉をひそめた。"
msgstr ""

#. Occurrence C_12:3138:17395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0019; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:3138
msgctxt "text_id=17395 | speaker=soujuurou"
msgid "「……橙子さんを殺すって、青子が？」"
msgstr ""

#. Occurrence C_12:3190:17396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0028; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3190
msgctxt "text_id=17396 | speaker=alice"
msgid "「もう、終わってるでしょうけど」"
msgstr ""

#. Occurrence C_12:3283:17397: scene=C_12
#: C_12:3283
msgctxt "text_id=17397 | speaker=unknown"
msgid "　有珠の返答に、草十郎は即座に走りだした。"
msgstr ""

#. Occurrence C_12:3288:17398: scene=C_12
#: C_12:3288
msgctxt "text_id=17398 | speaker=unknown"
msgid "　白い花びらを散らしながら駆けていく姿は、人狼と対した時の勇ましさを思わせる。"
msgstr ""

#. Occurrence C_12:3360:17399: scene=C_12
#: C_12:3360
msgctxt "text_id=17399 | speaker=unknown"
msgid "　有珠は引き止める事もせず、ただその姿を見続けた。"
msgstr ""

#. Occurrence C_12:3448:17400: scene=C_12
#: C_12:3448
msgctxt "text_id=17400 | speaker=unknown"
msgid "　……ある雪の日の夜。"
msgstr ""

#. Occurrence C_12:3453:17401: scene=C_12
#: C_12:3453
msgctxt "text_id=17401 | speaker=unknown"
msgid "　誰かのために白犬塚の坂を駆け下りていったであろう、少年の姿と重ねながら。"
msgstr ""

#. Occurrence C_12:3496:17402: scene=C_12
#: C_12:3496
msgctxt "text_id=17402 | speaker=unknown"
msgid "　草十郎は旧校舎に入っていく。"
msgstr ""

#. Occurrence C_12:3501:17403: scene=C_12
#: C_12:3501
msgctxt "text_id=17403 | speaker=unknown"
msgid "　先ほどから破滅的な音と光が<乱舞|らんぶ>し、<瓦解|がかい>寸前の<墓標|ぼひょう>となった場所に、戸惑う事もなく。"
msgstr ""

#. Occurrence C_12:3524:17404: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0029; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3524
msgctxt "text_id=17404 | speaker=alice"
msgid "「―――ほら。"
msgstr ""

#. Occurrence C_12:3563:17405: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0030; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3563
msgctxt "text_id=17405 | speaker=alice"
msgid "　悪いけれど、やっぱり無駄だったわ、青子」"
msgstr ""

#. Occurrence C_12:3569:17406: scene=C_12
#: C_12:3569
msgctxt "text_id=17406 | speaker=unknown"
msgid "　白い花の中でひとり呟く。"
msgstr ""

#. Occurrence C_12:3574:17407: scene=C_12
#: C_12:3574
msgctxt "text_id=17407 | speaker=unknown"
msgid "　青子はこうなる事を予期して、草十郎の足止めを有珠に託したのだ。"
msgstr ""

#. Occurrence C_12:3579:17408: scene=C_12
#: C_12:3579
msgctxt "text_id=17408 | speaker=unknown"
msgid "　橙子との交戦中に割って入られたら、今度こそかばいようがないと。"
msgstr ""

#. Occurrence C_12:3629:17409: scene=C_12
#: C_12:3629
msgctxt "text_id=17409 | speaker=unknown"
msgid "　が、青子の見事なまでの草十郎の把握ぶりもこうなっては後の祭りだ。"
msgstr ""

#. Occurrence C_12:3634:17410: scene=C_12
#: C_12:3634
msgctxt "text_id=17410 | speaker=unknown"
msgid "　追いかける気にもならず、"
msgstr ""

#. Occurrence C_12:3639:17411: scene=C_12
#: C_12:3639
msgctxt "text_id=17411 | speaker=unknown"
msgid "　黒衣の少女は細い眉をかすかに曇らせて、消えていく花園の中で<佇|たたず>むのだった。"
msgstr ""

#. Occurrence C_13:461:17412: scene=C_13
#: C_13:461
msgctxt "text_id=17412 | speaker=unknown"
msgid "　飛び交う<電刃|でんじん>を、暴風の如き<魔弾|まだん>が叩き伏せる。"
msgstr ""

#. Occurrence C_13:546:17413: scene=C_13
#: C_13:546
msgctxt "text_id=17413 | speaker=unknown"
msgid "　魔術師にとって、拠点とする<工房|アジト>は始まりにして最後の切札である。"
msgstr ""

#. Occurrence C_13:551:17414: scene=C_13
#: C_13:551
msgctxt "text_id=17414 | speaker=unknown"
msgid "　<不遜|ふそん>な挑戦者、<不埒|ふらち>な盗人を切りきざむ為、<幾重|いくえ><数多|あまた>の防衛術式が張られている。"
msgstr ""

#. Occurrence C_13:556:17415: scene=C_13
#: C_13:556
msgctxt "text_id=17415 | speaker=unknown"
msgid "　この旧校舎もその例に漏れず、希代の人形師にしてルーン使いである蒼崎橙子の手が入っていた。"
msgstr ""

#. Occurrence C_13:561:17416: scene=C_13
#: C_13:561
msgctxt "text_id=17416 | speaker=unknown"
msgid "　彼女の<偏執|へんしつ>的なこだわりを反映させた<工房|ソレ>は、訪れるものを人魔区別なく<鏖殺|おうさつ>する。"
msgstr ""

#. Occurrence C_13:667:17417: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0000; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:667
msgctxt "text_id=17417 | speaker=touko"
msgid "「っ、足止めぐらいは果たせバカモン―――！」"
msgstr ""

#. Occurrence C_13:673:17418: scene=C_13
#: C_13:673
msgctxt "text_id=17418 | speaker=unknown"
msgid "　廊下を走りながら、橙子は廊下に組み込んだトラップを起動させていく。"
msgstr ""

#. Occurrence C_13:678:17419: scene=C_13
#: C_13:678
msgctxt "text_id=17419 | speaker=unknown"
msgid "　だが、その一切は通用しない。"
msgstr ""

#. Occurrence C_13:843:17420: scene=C_13
#: C_13:843
msgctxt "text_id=17420 | speaker=unknown"
msgid "　質、<量|りょう>問わず、十や二十のルーンでは、あの小娘を止める事さえ出来ない。"
msgstr ""

#. Occurrence C_13:848:17421: scene=C_13
#: C_13:848
msgctxt "text_id=17421 | speaker=unknown"
msgid "　卓越した運動神経と攻撃予測、"
msgstr ""

#. Occurrence C_13:853:17422: scene=C_13
#: C_13:853
msgctxt "text_id=17422 | speaker=unknown"
msgid "　両手にまとった魔弾の威力は、橙子の用意したルーンを壁ごとぶち抜いて余りある―――！"
msgstr ""

#. Occurrence C_13:1142:17423: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0001_0; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:1142
msgctxt "text_id=17423 | speaker=touko"
msgid "「それで一人前のつもりか単細胞め―――"
msgstr ""

#. Occurrence C_13:1149:17424: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0001_1; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:1149
msgctxt "text_id=17424 | speaker=touko"
msgid "　熟成したところで壊すコトしか出来ないとは、呆れたな！」"
msgstr ""

#. Occurrence C_13:1348:17425: scene=C_13
#: C_13:1348
msgctxt "text_id=17425 | speaker=unknown"
msgid "　<罵倒|ばとう>と共に天井が開き、ルーンによる重圧がかけられる。"
msgstr ""

#. Occurrence C_13:1353:17426: scene=C_13
#: C_13:1353
msgctxt "text_id=17426 | speaker=unknown"
msgid "　廊下は不可視の壁に、"
msgstr ""

#. Occurrence C_13:1358:17427: scene=C_13
#: C_13:1358
msgctxt "text_id=17427 | speaker=unknown"
msgid "　ゼラチンと化した大気を前に、青子は走る足を止め、右足を跳ね上げた。"
msgstr ""

#. Occurrence C_13:1589:17428: scene=C_13
#: C_13:1589
msgctxt "text_id=17428 | speaker=unknown"
msgid "　まさに<天墜|てんつい>。"
msgstr ""

#. Occurrence C_13:1595:17429: scene=C_13
#: C_13:1595
msgctxt "text_id=17429 | speaker=unknown"
msgid "真一文字に蹴り上げられた足は大気を裂き、そのままルーンごと天井を粉砕する。"
msgstr ""

#. Occurrence C_13:1699:17430: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0000; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1699
msgctxt "text_id=17430 | speaker=aoko"
msgid "「アンタの方こそ、いつまでたってもこの凝り性……！"
msgstr ""

#. Occurrence C_13:1705:17431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0001; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1705
msgctxt "text_id=17431 | speaker=aoko"
msgid "　どこもかしこもルーンだらけ、少しは遠慮ってもんがないの！？　宇宙要塞ばりに改造してんじゃないってぇの！"
msgstr ""

#. Occurrence C_13:1798:17432: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0002; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1798
msgctxt "text_id=17432 | speaker=aoko"
msgid "　みんなの思い出の校舎なんだから、もっと大切に扱いなさいよね！」"
msgstr ""

#. Occurrence C_13:1939:17433: scene=C_13
#: C_13:1939
msgctxt "text_id=17433 | speaker=unknown"
msgid "　くたびれた板張りの廊下を、"
msgstr ""

#. Occurrence C_13:1944:17434: scene=C_13
#: C_13:1944
msgctxt "text_id=17434 | speaker=unknown"
msgid "　何十年と風雪に耐えてきた壁を、<木|こ>っ<端|ぱ>と散らしながら青子は走る。"
msgstr ""

#. Occurrence C_13:1949:17435: scene=C_13
#: C_13:1949
msgctxt "text_id=17435 | speaker=unknown"
msgid "　ごく当然の惨劇である。"
msgstr ""

#. Occurrence C_13:1954:17436: scene=C_13
#: C_13:1954
msgctxt "text_id=17436 | speaker=unknown"
msgid "　橙子のルーンはあくまで対人に効果を発揮する“呪い”だが、青子の魔弾は何であろうと分け<隔|へだ>てなく<猛威|もうい>を振るう。"
msgstr ""

#. Occurrence C_13:2035:17437: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0002; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2035
msgctxt "text_id=17437 | speaker=touko"
msgid "「っ、<優雅|ゆうが>さの欠片もない！"
msgstr ""

#. Occurrence C_13:2041:17438: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0003; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2041
msgctxt "text_id=17438 | speaker=touko"
msgid "　あんなのが自分の妹だと思うと―――」"
msgstr ""

#. Occurrence C_13:2047:17439: scene=C_13
#: C_13:2047
msgctxt "text_id=17439 | speaker=unknown"
msgid "　吐き気はしないまでも全身の血を交換したくなる橙子だが、今はそれどころではない。"
msgstr ""

#. Occurrence C_13:2055:17440: scene=C_13
#: C_13:2055
msgctxt "text_id=17440 | speaker=unknown"
msgid "　追ってくる少女は先ほどまでの蒼崎青子ではなく、“完成した”蒼崎青子なのだ。"
msgstr ""

#. Occurrence C_13:2060:17441: scene=C_13
#: C_13:2060
msgctxt "text_id=17441 | speaker=unknown"
msgid "　髪の毛一本ほどの油断も許されまい。"
msgstr ""

#. Occurrence C_13:2081:17442: scene=C_13
#: C_13:2081
msgctxt "text_id=17442 | speaker=unknown"
msgid "　だが―――"
msgstr ""

#. Occurrence C_13:2144:17443: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0004; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2144
msgctxt "text_id=17443 | speaker=touko"
msgid "「笑わせる。そんなものが魔法であるものか！」"
msgstr ""

#. Occurrence C_13:2150:17444: scene=C_13
#: C_13:2150
msgctxt "text_id=17444 | speaker=unknown"
msgid "　個人限定の時間旅行―――それが蒼崎の魔法の正体などとは、橙子は思っていない。"
msgstr ""

#. Occurrence C_13:2155:17445: scene=C_13
#: C_13:2155
msgctxt "text_id=17445 | speaker=unknown"
msgid "　青子の変化はあくまで魔法の副産物だ。"
msgstr ""

#. Occurrence C_13:2160:17446: scene=C_13
#: C_13:2160
msgctxt "text_id=17446 | speaker=unknown"
msgid "　魔法の正体、その深淵に<青子|アレ>が届いたかまでは測れないが、決して、そんな単純な奇跡ではない。"
msgstr ""

#. Occurrence C_13:2243:17447: scene=C_13
#: C_13:2243
msgctxt "text_id=17447 | speaker=unknown"
msgid "　なぜなら―――時間旅行の概念は、既に第二魔法に含まれている。"
msgstr ""

#. Occurrence C_13:2248:17448: scene=C_13
#: C_13:2248
msgctxt "text_id=17448 | speaker=unknown"
msgid "　記録の<改竄|かいざん>、<事象|じしょう>の書き換え等は、すなわち並行世界の運営にあたる。"
msgstr ""

#. Occurrence C_13:2253:17449: scene=C_13
#: C_13:2253
msgctxt "text_id=17449 | speaker=unknown"
msgid "　いまさらそんなものが第五魔法と呼ばれる筈もない。"
msgstr ""

#. Occurrence C_13:2295:17450: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0005; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2295
msgctxt "text_id=17450 | speaker=touko"
msgid "「―――となると、次に出てくる疑問はこれか。"
msgstr ""

#. Occurrence C_13:2330:17451: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0006; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2330
msgctxt "text_id=17451 | speaker=touko"
msgid "　青子！　貴様、その十年分の時間をどこから持ってきた！」"
msgstr ""

#. Occurrence C_13:2560:17452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0003; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:2560
msgctxt "text_id=17452 | speaker=aoko"
msgid "「あのボンクラからよ、悪い!?"
msgstr ""

#. Occurrence C_13:2567:17453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0004; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:2567
msgctxt "text_id=17453 | speaker=aoko"
msgid "　後で返すんだから、アンタに批難される覚えはありませんけど！」"
msgstr ""

#. Occurrence C_13:2607:17454: scene=C_13
#: C_13:2607
msgctxt "text_id=17454 | speaker=unknown"
msgid "　そう、それはいい。"
msgstr ""

#. Occurrence C_13:2612:17455: scene=C_13
#: C_13:2612
msgctxt "text_id=17455 | speaker=unknown"
msgid "　一方的ではあるが、この時間軸での時間の総量は変わっていない。"
msgstr ""

#. Occurrence C_13:2617:17456: scene=C_13
#: C_13:2617
msgctxt "text_id=17456 | speaker=unknown"
msgid "　だが―――"
msgstr ""

#. Occurrence C_13:2706:17457: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0007; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2706
msgctxt "text_id=17457 | speaker=touko"
msgid "「では、あの五分間はどうする!?"
msgstr ""

#. Occurrence C_13:2712:17458: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0008; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2712
msgctxt "text_id=17458 | speaker=touko"
msgid "　まさか私を始末した後、彼を元の状態に戻すのか!?」"
msgstr ""

#. Occurrence C_13:2775:17459: scene=C_13
#: C_13:2775
msgctxt "text_id=17459 | speaker=unknown"
msgid "　青子の足が止まる。"
msgstr ""

#. Occurrence C_13:2841:17460: scene=C_13
#: C_13:2841
msgctxt "text_id=17460 | speaker=unknown"
msgid "　蒼崎の魔法の矛盾と、青子の人間性の矛盾。"
msgstr ""

#. Occurrence C_13:2891:17461: scene=C_13
#: C_13:2891
msgctxt "text_id=17461 | speaker=unknown"
msgid "　二つの隙が、橙子に反撃の<狼煙|のろし>をあげさせる。"
msgstr ""

#. Occurrence C_13:2996:17462: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0009; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2996
msgctxt "text_id=17462 | speaker=touko"
msgid "「そうだ。時間操作では死者の蘇生は許されない。"
msgstr ""

#. Occurrence C_13:3021:17463: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0010; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3021
msgctxt "text_id=17463 | speaker=touko"
msgid "　おまえがしたコトは一時だけの気休めか―――」"
msgstr ""

#. Occurrence C_13:3027:17464: scene=C_13
#: C_13:3027
msgctxt "text_id=17464 | speaker=unknown"
msgid "　橙子の背中の魔術刻印が、その真価を発揮する。"
msgstr ""

#. Occurrence C_13:3032:17465: scene=C_13
#: C_13:3032
msgctxt "text_id=17465 | speaker=unknown"
msgid "　刻印からの魔力提供を受け、廊下に仕込まれた最大の仕掛けが物質化する。"
msgstr ""

#. Occurrence C_13:3278:17466: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0011; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3278
msgctxt "text_id=17466 | speaker=touko"
msgid "「―――あるいは、より<罪|つみ>深い<暴虐|ぼうぎゃく>というコトだ！」"
msgstr ""

#. Occurrence C_13:3340:17467: scene=C_13
#: C_13:3340
msgctxt "text_id=17467 | speaker=unknown"
msgid "　現れる三枚のルーン石。"
msgstr ""

#. Occurrence C_13:3345:17468: scene=C_13
#: C_13:3345
msgctxt "text_id=17468 | speaker=unknown"
msgid "　その規模も込められた魔力も、これまでのモノとはケタが違う。"
msgstr ""

#. Occurrence C_13:3350:17469: scene=C_13
#: C_13:3350
msgctxt "text_id=17469 | speaker=unknown"
msgid "　これこそ北欧の巨人の<御業|みわざ>、"
msgstr ""

#. Occurrence C_13:3355:17470: scene=C_13
#: C_13:3355
msgctxt "text_id=17470 | speaker=unknown"
msgid "　蒼崎橙子が魔術協会で復元・分生させた、失われた“原初のルーン”のレプリカである。"
msgstr ""

#. Occurrence C_13:3381:17471: scene=C_13
#: C_13:3381
msgctxt "text_id=17471 | speaker=unknown"
msgid "　三枚の水晶膜は刻まれたルーンを一千万規模に膨張させる。"
msgstr ""

#. Occurrence C_13:3386:17472: scene=C_13
#: C_13:3386
msgctxt "text_id=17472 | speaker=unknown"
msgid "　魔弾による相殺など許さない。"
msgstr ""

#. Occurrence C_13:3391:17473: scene=C_13
#: C_13:3391
msgctxt "text_id=17473 | speaker=unknown"
msgid "　青子の出力が橙子を遥かに上回るものだとしても、この巨石はさらに数倍。"
msgstr ""

#. Occurrence C_13:3396:17474: scene=C_13
#: C_13:3396
msgctxt "text_id=17474 | speaker=unknown"
msgid "『魔力を放出する』だけの青子の魔術特性では、この呪いを防ぐ事も躱す事も出来はしない……！"
msgstr ""

#. Occurrence C_13:3638:17475: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0005; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:3638
msgctxt "text_id=17475 | speaker=aoko"
msgid "「―――<主|メ><観|イ><軸|ン>、<固定|セット>」"
msgstr ""

#. Occurrence C_13:3644:17476: scene=C_13
#: C_13:3644
msgctxt "text_id=17476 | speaker=unknown"
msgid "　短い自己暗示と、意を決する深呼吸。"
msgstr ""

#. Occurrence C_13:3649:17477: scene=C_13
#: C_13:3649
msgctxt "text_id=17477 | speaker=unknown"
msgid "　青子は防ぎもせず避けもせず、ルーンの嵐へと突進する。"
msgstr ""

#. Occurrence C_13:3922:17478: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0012; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3922
msgctxt "text_id=17478 | speaker=touko"
msgid "「貴様―――この時間軸に存在していないな!?」"
msgstr ""

#. Occurrence C_13:3928:17479: scene=C_13
#: C_13:3928
msgctxt "text_id=17479 | speaker=unknown"
msgid "　やはり、と得心しながら、橙子は魔術刻印をフル稼働させる。"
msgstr ""

#. Occurrence C_13:3935:17480: scene=C_13
#: C_13:3935
msgctxt "text_id=17480 | speaker=unknown"
msgid "　青子にルーンが作用しないのは、アレが今も秒単位で時間旅行を繰り返しているからだ。"
msgstr ""

#. Occurrence C_13:3940:17481: scene=C_13
#: C_13:3940
msgctxt "text_id=17481 | speaker=unknown"
msgid "　着弾したルーンをいずこかの時間に跳ばしているのか、"
msgstr ""

#. Occurrence C_13:3945:17482: scene=C_13
#: C_13:3945
msgctxt "text_id=17482 | speaker=unknown"
msgid "　それとも、何千という“<自分|たて>”を重ね着しているのか。"
msgstr ""

#. Occurrence C_13:3950:17483: scene=C_13
#: C_13:3950
msgctxt "text_id=17483 | speaker=unknown"
msgid "　どちらにせよそんなデタラメ、魔力が続くはずがない……！"
msgstr ""

#. Occurrence C_13:4060:17484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0006; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:4060
msgctxt "text_id=17484 | speaker=aoko"
msgid "「一枚目！」"
msgstr ""

#. Occurrence C_13:4066:17485: scene=C_13
#: C_13:4066
msgctxt "text_id=17485 | speaker=unknown"
msgid "　巨石が文字通り一蹴される。"
msgstr ""

#. Occurrence C_13:4071:17486: scene=C_13
#: C_13:4071
msgctxt "text_id=17486 | speaker=unknown"
msgid "　残りは二枚。距離にして十メートル。"
msgstr ""

#. Occurrence C_13:4127:17487: scene=C_13
#: C_13:4127
msgctxt "text_id=17487 | speaker=unknown"
msgid "　橙子の魔力残量は十分だ。刻印を使い果たすが、十秒は掃射を続けられる。"
msgstr ""

#. Occurrence C_13:4203:17488: scene=C_13
#: C_13:4203
msgctxt "text_id=17488 | speaker=unknown"
msgid "　対する青子は、魔術師としての常識で考えるのならここで打ち止め。"
msgstr ""

#. Occurrence C_13:4208:17489: scene=C_13
#: C_13:4208
msgctxt "text_id=17489 | speaker=unknown"
msgid "　これ以上の反則は行えまい。"
msgstr ""

#. Occurrence C_13:4214:17490: scene=C_13
#: C_13:4214
msgctxt "text_id=17490 | speaker=unknown"
msgid "　だが―――反則と言うのなら、それは時間旅行の段階で反則である。"
msgstr ""

#. Occurrence C_13:4298:17491: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0013; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:4298
msgctxt "text_id=17491 | speaker=touko"
msgid "「青子―――！」"
msgstr ""

#. Occurrence C_13:4634:17492: scene=C_13
#: C_13:4634
msgctxt "text_id=17492 | speaker=unknown"
msgid "　同じ展開が繰り返される。"
msgstr ""

#. Occurrence C_13:4639:17493: scene=C_13
#: C_13:4639
msgctxt "text_id=17493 | speaker=unknown"
msgid "　橙子の疑念は、ここに至って憎悪に変貌した。"
msgstr ""

#. Occurrence C_13:4644:17494: scene=C_13
#: C_13:4644
msgctxt "text_id=17494 | speaker=unknown"
msgid "　時間旅行の術式などどうでもいい。"
msgstr ""

#. Occurrence C_13:4649:17495: scene=C_13
#: C_13:4649
msgctxt "text_id=17495 | speaker=unknown"
msgid "　問題はあの魔力量。"
msgstr ""

#. Occurrence C_13:4655:17496: scene=C_13
#: C_13:4655
msgctxt "text_id=17496 | speaker=unknown"
msgid "時間旅行に必要なだけのエネルギーを、あの女はどこから捻出しているのか……？"
msgstr ""

#. Occurrence C_13:4730:17497: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0014; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:4730
msgctxt "text_id=17497 | speaker=touko"
msgid "「やはりそうか。おまえは―――！」"
msgstr ""

#. Occurrence C_13:4815:17498: scene=C_13
#: C_13:4815
msgctxt "text_id=17498 | speaker=unknown"
msgid "　静希草十郎の死。"
msgstr ""

#. Occurrence C_13:4820:17499: scene=C_13
#: C_13:4820
msgctxt "text_id=17499 | speaker=unknown"
msgid "　彼を、まだ生きていた頃の五分前に戻したというが、では、その五分間はどこに行くのか。"
msgstr ""

#. Occurrence C_13:4917:17500: scene=C_13
#: C_13:4917
msgctxt "text_id=17500 | speaker=unknown"
msgid "　青子の魔法は、世界そのものを書き換える“並行世界の運営”ではない。"
msgstr ""

#. Occurrence C_13:4922:17501: scene=C_13
#: C_13:4922
msgctxt "text_id=17501 | speaker=unknown"
msgid "　青子は『草十郎の五分間』だけを巻き戻した。"
msgstr ""

#. Occurrence C_13:4927:17502: scene=C_13
#: C_13:4927
msgctxt "text_id=17502 | speaker=unknown"
msgid "　が、それでは魔法が切れた時、彼が死体に戻るのも道理。"
msgstr ""

#. Occurrence C_13:4932:17503: scene=C_13
#: C_13:4932
msgctxt "text_id=17503 | speaker=unknown"
msgid "　世界を換えずに行う時間旅行では、そもそも過去を変えられない。"
msgstr ""

#. Occurrence C_13:4974:17504: scene=C_13
#: C_13:4974
msgctxt "text_id=17504 | speaker=unknown"
msgid "　……故に。"
msgstr ""

#. Occurrence C_13:4979:17505: scene=C_13
#: C_13:4979
msgctxt "text_id=17505 | speaker=unknown"
msgid "　彼を救いたいのなら死者を蘇生させるか、"
msgstr ""

#. Occurrence C_13:5034:17506: scene=C_13
#: C_13:5034
msgctxt "text_id=17506 | speaker=unknown"
msgid "　それとも―――現実にあった<五分間|エネルギー>を、このままどこにも還さず、遠い場所に<棚|たな>上げしておくしかない―――！"
msgstr ""

#. Occurrence C_13:5147:17507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0007; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5147
msgctxt "text_id=17507 | speaker=aoko"
msgid "「二枚目！」"
msgstr ""

#. Occurrence C_13:5153:17508: scene=C_13
#: C_13:5153
msgctxt "text_id=17508 | speaker=unknown"
msgid "　青子の進撃は止まらない。"
msgstr ""

#. Occurrence C_13:5158:17509: scene=C_13
#: C_13:5158
msgctxt "text_id=17509 | speaker=unknown"
msgid "　橙子は憎しみをもって、最後の<巨石|まもり>の後ろで青子を睨む。"
msgstr ""

#. Occurrence C_13:5247:17510: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0015; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5247
msgctxt "text_id=17510 | speaker=touko"
msgid "「答えろ青子！　貴様、彼の時間をどこにやった！"
msgstr ""

#. Occurrence C_13:5254:17511: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0016; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5254
msgctxt "text_id=17511 | speaker=touko"
msgid "　そこにあった熱量の帳尻を、どうやって合わせている！？」"
msgstr ""

#. Occurrence C_13:5360:17512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0008; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5360
msgctxt "text_id=17512 | speaker=aoko"
msgid "「っ、そんなの知るか！　アイツの時間なら、遥かな未来に<措|お>いてきたわよ！」"
msgstr ""

#. Occurrence C_13:5392:17513: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0017; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5392
msgctxt "text_id=17513 | speaker=touko"
msgid "「な―――」"
msgstr ""

#. Occurrence C_13:5455:17514: scene=C_13
#: C_13:5455
msgctxt "text_id=17514 | speaker=unknown"
msgid "　あと五メートル。"
msgstr ""

#. Occurrence C_13:5460:17515: scene=C_13
#: C_13:5460
msgctxt "text_id=17515 | speaker=unknown"
msgid "　肉薄するデタラメに、橙子は目を<覆|おお>いたくなった。"
msgstr ""

#. Occurrence C_13:5465:17516: scene=C_13
#: C_13:5465
msgctxt "text_id=17516 | speaker=unknown"
msgid "　いま<現在|ここ>で作った負債を、未来に<措|お>いてきただと？"
msgstr ""

#. Occurrence C_13:5470:17517: scene=C_13
#: C_13:5470
msgctxt "text_id=17517 | speaker=unknown"
msgid "　タイムパラドックスの方がまだ人道的だ。"
msgstr ""

#. Occurrence C_13:5475:17518: scene=C_13
#: C_13:5475
msgctxt "text_id=17518 | speaker=unknown"
msgid "　そんな膨大な、無計画な熱量の消費を許してはならない。"
msgstr ""

#. Occurrence C_13:5576:17519: scene=C_13
#: C_13:5576
msgctxt "text_id=17519 | speaker=unknown"
msgid "　そも、時間旅行だけでも膨大なエネルギーを要する。"
msgstr ""

#. Occurrence C_13:5581:17520: scene=C_13
#: C_13:5581
msgctxt "text_id=17520 | speaker=unknown"
msgid "　ここに無いものを持ってくる事にも魔力は必要だが、"
msgstr ""

#. Occurrence C_13:5586:17521: scene=C_13
#: C_13:5586
msgctxt "text_id=17521 | speaker=unknown"
msgid "　それと同じに、ここに有るものを“無くす”事にも莫大なエネルギーが<消費|うしな>われる。"
msgstr ""

#. Occurrence C_13:5591:17522: scene=C_13
#: C_13:5591
msgctxt "text_id=17522 | speaker=unknown"
msgid "　その冷却に使われた魔力はどうする？"
msgstr ""

#. Occurrence C_13:5596:17523: scene=C_13
#: C_13:5596
msgctxt "text_id=17523 | speaker=unknown"
msgid "　プラスにしろマイナスにしろ、それは秩序の崩壊だ。"
msgstr ""

#. Occurrence C_13:5601:17524: scene=C_13
#: C_13:5601
msgctxt "text_id=17524 | speaker=unknown"
msgid "　魔法の作る<歪|ゆが>みは、いずれこの<宙域|ちゅういき>すべてに及ぶだろう。"
msgstr ""

#. Occurrence C_13:5648:17525: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0018; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5648
msgctxt "text_id=17525 | speaker=touko"
msgid "「ば―――バカここに極まったな！"
msgstr ""

#. Occurrence C_13:5688:17526: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0019; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5688
msgctxt "text_id=17526 | speaker=touko"
msgid "　何千億年後にくる宇宙の死滅、人類の行く末に待つ<どん詰|デッド><まり|エンド>に、さらなる負債を押しつける気か!?"
msgstr ""

#. Occurrence C_13:5695:17527: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0020; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5695
msgctxt "text_id=17527 | speaker=touko"
msgid "　この星の頭上に隕石を作っているようなものだぞ!?"
msgstr ""

#. Occurrence C_13:5781:17528: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0021; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5781
msgctxt "text_id=17528 | speaker=touko"
msgid "　というか、おまえの重みでこの星を押し潰す気か!?」"
msgstr ""

#. Occurrence C_13:5825:17529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0009; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5825
msgctxt "text_id=17529 | speaker=aoko"
msgid "「な―――」"
msgstr ""

#. Occurrence C_13:5831:17530: scene=C_13
#: C_13:5831
msgctxt "text_id=17530 | speaker=unknown"
msgid "　その喩えはあんまりだ、と目をむく青子。"
msgstr ""

#. Occurrence C_13:5836:17531: scene=C_13
#: C_13:5836
msgctxt "text_id=17531 | speaker=unknown"
msgid "　突き進む足も、勢いあまって床をブチ抜いていたりする。"
msgstr ""

#. Occurrence C_13:5947:17532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0010; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5947
msgctxt "text_id=17532 | speaker=aoko"
msgid "「その時はその時で、今度は負債を過去に送ってやるわよ！　それなら文句ないんでしょう！？"
msgstr ""

#. Occurrence C_13:5954:17533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0011; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5954
msgctxt "text_id=17533 | speaker=aoko"
msgid "　歪みに潰されるのは過去だけなんだから！」"
msgstr ""

#. Occurrence C_13:6025:17534: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0022; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6025
msgctxt "text_id=17534 | speaker=touko"
msgid "「それで解決したつもりか！？"
msgstr ""

#. Occurrence C_13:6031:17535: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0023; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6031
msgctxt "text_id=17535 | speaker=touko"
msgid "　現在が確定している以上、過去を消滅させてもいいと！？"
msgstr ""

#. Occurrence C_13:6037:17536: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0024; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6037
msgctxt "text_id=17536 | speaker=touko"
msgid "　それでいいのは私たちだけだ！　問題の総量、宇宙の負債はどうする！？」"
msgstr ""

#. Occurrence C_13:6099:17537: scene=C_13
#: C_13:6099
msgctxt "text_id=17537 | speaker=unknown"
msgid "　―――そう。"
msgstr ""

#. Occurrence C_13:6128:17538: scene=C_13
#: C_13:6128
msgctxt "text_id=17538 | speaker=unknown"
msgid "　宇宙が閉じているにせよ、現在も<拡|ひろ>がっているにせよ、"
msgstr ""

#. Occurrence C_13:6133:17539: scene=C_13
#: C_13:6133
msgctxt "text_id=17539 | speaker=unknown"
msgid "　消費熱量の増大は手に負えないものになる。"
msgstr ""

#. Occurrence C_13:6153:17540: scene=C_13
#: C_13:6153
msgctxt "text_id=17540 | speaker=unknown"
msgid "　際限のない広がり、"
msgstr ""

#. Occurrence C_13:6158:17541: scene=C_13
#: C_13:6158
msgctxt "text_id=17541 | speaker=unknown"
msgid "　際限のない消費、"
msgstr ""

#. Occurrence C_13:6163:17542: scene=C_13
#: C_13:6163
msgctxt "text_id=17542 | speaker=unknown"
msgid "　際限のない成長の末に待つモノは、希望に満ちた未来などではない。"
msgstr ""

#. Occurrence C_13:6169:17543: scene=C_13
#: C_13:6169
msgctxt "text_id=17543 | speaker=unknown"
msgid "　<開闢|かいびゃく>の前の無。"
msgstr ""

#. Occurrence C_13:6174:17544: scene=C_13
#: C_13:6174
msgctxt "text_id=17544 | speaker=unknown"
msgid "　いずれ宇宙は<熱的死|ねつてきし>する。"
msgstr ""

#. Occurrence C_13:6195:17545: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0025; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6195
msgctxt "text_id=17545 | speaker=touko"
msgid "「青子の―――蒼崎の魔法は、その結末をより確かなものにするだけだ！　その責任を、おまえは―――！」"
msgstr ""

#. Occurrence C_13:6201:17546: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0012; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6201
msgctxt "text_id=17546 | speaker=aoko"
msgid "「言われなくても分かってる！"
msgstr ""

#. Occurrence C_13:6207:17547: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0013; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6207
msgctxt "text_id=17547 | speaker=aoko"
msgid "　責任なんて、私が生きてる間になんとかするわよ！」"
msgstr ""

#. Occurrence C_13:6298:17548: scene=C_13
#: C_13:6298
msgctxt "text_id=17548 | speaker=unknown"
msgid "　残り二メートル。"
msgstr ""

#. Occurrence C_13:6303:17549: scene=C_13
#: C_13:6303
msgctxt "text_id=17549 | speaker=unknown"
msgid "　ルーンの掃射は、もはや橙子の憎悪を宿した<熱線|ねっせん>となって突き刺さる。"
msgstr ""

#. Occurrence C_13:6308:17550: scene=C_13
#: C_13:6308
msgctxt "text_id=17550 | speaker=unknown"
msgid "　その熱さに身を裂かれながらも、より強い感情で青子は地面を蹴り―――"
msgstr ""

#. Occurrence C_13:6516:17551: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0026; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6516
msgctxt "text_id=17551 | speaker=touko"
msgid "「責任をとると言ったな……！　では、その具体案は！？」"
msgstr ""

#. Occurrence C_13:6602:17552: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0014; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6602
msgctxt "text_id=17552 | speaker=aoko"
msgid "「そんなの―――これから考えるに決まってるでしょう！」"
msgstr ""

#. Occurrence C_13:6659:17553: scene=C_13
#: C_13:6659
msgctxt "text_id=17553 | speaker=unknown"
msgid "「―――"
msgstr ""

#. Occurrence C_13:6667:17554: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0027; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6667
msgctxt "text_id=17554 | speaker=touko"
msgid "おまえは、最悪だ！」"
msgstr ""

#. Occurrence C_13:6855:17555: scene=C_13
#: C_13:6855
msgctxt "text_id=17555 | speaker=unknown"
msgid "　―――砕け散る最後の守り。"
msgstr ""

#. Occurrence C_13:6860:17556: scene=C_13
#: C_13:6860
msgctxt "text_id=17556 | speaker=unknown"
msgid "　二人の魔術師は拳を打てば届く距離で魔術を組み上げる。"
msgstr ""

#. Occurrence C_13:6868:17557: scene=C_13
#: C_13:6868
msgctxt "text_id=17557 | speaker=unknown"
msgid "　赤色のルーンと、青色のエーテル流。"
msgstr ""

#. Occurrence C_13:6875:17558: scene=C_13
#: C_13:6875
msgctxt "text_id=17558 | speaker=unknown"
msgid "　撃ち出された魔弾は<瀑布|ばくふ>となって、背後に浮かんだ刻印ごと、蒼崎橙子を粉砕した。"
msgstr ""

#. Occurrence C_14:80:17559: scene=C_14
#: C_14:80
msgctxt "text_id=17559 | speaker=unknown"
msgid "　有珠の言った通り。"
msgstr ""

#. Occurrence C_14:85:17560: scene=C_14
#: C_14:85
msgctxt "text_id=17560 | speaker=unknown"
msgid "　草十郎が追いつく前に、決着はついていた。"
msgstr ""

#. Occurrence C_14:113:17561: scene=C_14
#: C_14:113
msgctxt "text_id=17561 | speaker=unknown"
msgid "　何十年もの風化に耐えてきた木造の校舎は、実に分かりやすく彼女たちの道行きを示していた。"
msgstr ""

#. Occurrence C_14:118:17562: scene=C_14
#: C_14:118
msgctxt "text_id=17562 | speaker=unknown"
msgid "　外れて戸が開かなくなった昇降口、"
msgstr ""

#. Occurrence C_14:123:17563: scene=C_14
#: C_14:123
msgctxt "text_id=17563 | speaker=unknown"
msgid "　ぎしぎしと音をたてる廊下、"
msgstr ""

#. Occurrence C_14:128:17564: scene=C_14
#: C_14:128
msgctxt "text_id=17564 | speaker=unknown"
msgid "　体重をのせれば踏み抜けそうな階段。"
msgstr ""

#. Occurrence C_14:167:17565: scene=C_14
#: C_14:167
msgctxt "text_id=17565 | speaker=unknown"
msgid "　それらを徹底的に破壊しながら続く逃走とその追跡は、二階の奥で終わりを告げていた。"
msgstr ""

#. Occurrence C_14:239:17566: scene=C_14
#: C_14:239
msgctxt "text_id=17566 | speaker=unknown"
msgid "　廊下の突き当たり、三階に続く小階段の前。"
msgstr ""

#. Occurrence C_14:244:17567: scene=C_14
#: C_14:244
msgctxt "text_id=17567 | speaker=unknown"
msgid "　橙子は壁に背を預けるかたちで崩れ落ちていた。"
msgstr ""

#. Occurrence C_14:249:17568: scene=C_14
#: C_14:249
msgctxt "text_id=17568 | speaker=unknown"
msgid "　傷つきながらも青子から視線は逸らさない。"
msgstr ""

#. Occurrence C_14:299:17569: scene=C_14
#: C_14:299
msgctxt "text_id=17569 | speaker=unknown"
msgid "　内部出血、さらには骨折。"
msgstr ""

#. Occurrence C_14:304:17570: scene=C_14
#: C_14:304
msgctxt "text_id=17570 | speaker=unknown"
msgid "　彼女の<骨格|フレーム>はもう満足に動かない。"
msgstr ""

#. Occurrence C_14:309:17571: scene=C_14
#: C_14:309
msgctxt "text_id=17571 | speaker=unknown"
msgid "　青子の跳び蹴りでショートしたのか、<魔眼|ひだりめ>は内部から破裂し、開かれる事はない。"
msgstr ""

#. Occurrence C_14:314:17572: scene=C_14
#: C_14:314
msgctxt "text_id=17572 | speaker=unknown"
msgid "　それだけの<満身|まんしん><創痍|そうい>ぶりで、呼吸を乱していないのは最後の意地か。"
msgstr ""

#. Occurrence C_14:319:17573: scene=C_14
#: C_14:319
msgctxt "text_id=17573 | speaker=unknown"
msgid "　目前で、無傷のまま見下ろしてくる妹に対しての。"
msgstr ""

#. Occurrence C_14:360:17574: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0000; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:360
msgctxt "text_id=17574 | speaker=touko"
msgid "「……屋上までは、<保|も>つと思っていたんだが」"
msgstr ""

#. Occurrence C_14:383:17575: scene=C_14
#: C_14:383
msgctxt "text_id=17575 | speaker=unknown"
msgid "　自嘲ではなく、純粋な思いを橙子は口にした。"
msgstr ""

#. Occurrence C_14:388:17576: scene=C_14
#: C_14:388
msgctxt "text_id=17576 | speaker=unknown"
msgid "　青子は冷たい視線だけを返す。"
msgstr ""

#. Occurrence C_14:467:17577: scene=C_14
#: C_14:467
msgctxt "text_id=17577 | speaker=unknown"
msgid "　先ほどからまったく変わらない青色の目。"
msgstr ""

#. Occurrence C_14:472:17578: scene=C_14
#: C_14:472
msgctxt "text_id=17578 | speaker=unknown"
msgid "　冴え<凍|こご>えるそれは、冷酷なものだとしても、どうしようもなく美しい。"
msgstr ""

#. Occurrence C_14:477:17579: scene=C_14
#: C_14:477
msgctxt "text_id=17579 | speaker=unknown"
msgid "　青子は橙子には近寄らず、数歩の距離を開けて右手を差しだした。"
msgstr ""

#. Occurrence C_14:523:17580: scene=C_14
#: C_14:523
msgctxt "text_id=17580 | speaker=unknown"
msgid "　撃ち落とした獲物に<引導|いんどう>を渡す、<射手|しゃしゅ>のように。"
msgstr ""

#. Occurrence C_14:585:17581: scene=C_14
#: C_14:585
msgctxt "text_id=17581 | speaker=unknown"
msgid "　勝負はついた。"
msgstr ""

#. Occurrence C_14:590:17582: scene=C_14
#: C_14:590
msgctxt "text_id=17582 | speaker=unknown"
msgid "　管理地を奪いに来た魔術師は、死をもって敗北とする。"
msgstr ""

#. Occurrence C_14:647:17583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0000; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:647
msgctxt "text_id=17583 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_14:691:17584: scene=C_14
#: C_14:691
msgctxt "text_id=17584 | speaker=unknown"
msgid "　不必要な沈黙。"
msgstr ""

#. Occurrence C_14:696:17585: scene=C_14
#: C_14:696
msgctxt "text_id=17585 | speaker=unknown"
msgid "　半壊した壁から差しこむ月明かりが、二人の影を廊下に映している。"
msgstr ""

#. Occurrence C_14:701:17586: scene=C_14
#: C_14:701
msgctxt "text_id=17586 | speaker=unknown"
msgid "　先ほどまでの<馬|バ><鹿|カ><騒|さわ>ぎも既に無い。"
msgstr ""

#. Occurrence C_14:707:17587: scene=C_14
#: C_14:707
msgctxt "text_id=17587 | speaker=unknown"
msgid "　<火花|ひばな><散|ち>る嵐は過ぎ、"
msgstr ""

msgctxt "text_id=17588 | speaker=unknown"
msgid "　張り詰めた寒気だけが、旧校舎を支配している。"
msgstr ""

#. Occurrence C_14:730:17589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0001; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:730
msgctxt "text_id=17589 | speaker=aoko"
msgid "「何か、言い残す事はある？」"
msgstr ""

#. Occurrence C_14:780:17590: scene=C_14
#: C_14:780
msgctxt "text_id=17590 | speaker=unknown"
msgid "　唐突に青子は口を開けた。"
msgstr ""

#. Occurrence C_14:785:17591: scene=C_14
#: C_14:785
msgctxt "text_id=17591 | speaker=unknown"
msgid "　橙子はそうだな、としばし考えこむ。"
msgstr ""

#. Occurrence C_14:790:17592: scene=C_14
#: C_14:790
msgctxt "text_id=17592 | speaker=unknown"
msgid "　途中、コートのポケットを軽く叩き、何も入っていない音に渋い顔をした。"
msgstr ""

#. Occurrence C_14:835:17593: scene=C_14
#: C_14:835
msgctxt "text_id=17593 | speaker=unknown"
msgid "「…………"
msgstr ""

#. Occurrence C_14:843:17594: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0001; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:843
msgctxt "text_id=17594 | speaker=touko"
msgid "最後に<一服|いっぷく>と思ったが、あいにく、おまえを待っている間に吸い切ってしまってね。"
msgstr ""

msgctxt "text_id=17595 | speaker=unknown"
msgid "日本の煙草は<旨|うま>すぎていけない」"
msgstr ""

#. Occurrence C_14:850:17596: scene=C_14
#: C_14:850
msgctxt "text_id=17596 | speaker=unknown"
msgid "　橙子の言葉に、青子はそう、と小さくうなずく。"
msgstr ""

#. Occurrence C_14:856:17597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0002; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:856
msgctxt "text_id=17597 | speaker=aoko"
msgid "「なかなか、常人には真似できない<遺言|ゆいごん>だったわ」"
msgstr ""

#. Occurrence C_14:863:17598: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0002; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:863
msgctxt "text_id=17598 | speaker=touko"
msgid "「待て待て。いくら私でも、遺言まで謎かけをする気はないよ。お望み通り、敗者は敗者らしく<遠吠|とおぼ>えをあげるから聞くといい」"
msgstr ""

#. Occurrence C_14:897:17599: scene=C_14
#: C_14:897
msgctxt "text_id=17599 | speaker=unknown"
msgid "　橙子の声は皮肉げではあるものの、青子への敵意も憎悪もない。"
msgstr ""

#. Occurrence C_14:902:17600: scene=C_14
#: C_14:902
msgctxt "text_id=17600 | speaker=unknown"
msgid "　―――おそらく。"
msgstr ""

#. Occurrence C_14:907:17601: scene=C_14
#: C_14:907
msgctxt "text_id=17601 | speaker=unknown"
msgid "　彼女が報復しようとしたものは青子個人ではなく、自分と妹を取りこんだ、魔術師の家系そのものだったからだろう。"
msgstr ""

#. Occurrence C_14:945:17602: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0003; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:945
msgctxt "text_id=17602 | speaker=touko"
msgid "「……蒼崎の魔法が、時間旅行に端を発するものとは思わなかった。まだ事情がありそうだが、当事者ではない私には何ともね。"
msgstr ""

#. Occurrence C_14:952:17603: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0004; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:952
msgctxt "text_id=17603 | speaker=touko"
msgid "<凡夫|ぼんぷ>には分からない悩みだ、せいぜい大事に付き合っていけばいいさ。"
msgstr ""

#. Occurrence C_14:979:17604: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0005; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:979
msgctxt "text_id=17604 | speaker=touko"
msgid "　……しかし、十年経ってもソレでは先が思いやられる。有珠は何をしていたんだか」"
msgstr ""

#. Occurrence C_14:1049:17605: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0003; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1049
msgctxt "text_id=17605 | speaker=aoko"
msgid "「アリスにしてはよく付き合ってくれた方よ。魔術師としてはいつまでも半人前っていうのが彼女の結論。"
msgstr ""

#. Occurrence C_14:1116:17606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0004; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1116
msgctxt "text_id=17606 | speaker=aoko"
msgid "　―――けどまあ、そうね。"
msgstr ""

#. Occurrence C_14:1122:17607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0005; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1122
msgctxt "text_id=17607 | speaker=aoko"
msgid "　あの狼となら、いい勝負をしたんじゃない？」"
msgstr ""

#. Occurrence C_14:1162:17608: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0006; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1162
msgctxt "text_id=17608 | speaker=touko"
msgid "「うん？　あれはダメだ、敗北を知ってしまった。もう完全じゃあない。"
msgstr ""

#. Occurrence C_14:1169:17609: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0007; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1169
msgctxt "text_id=17609 | speaker=touko"
msgid "半人前に<値|あたい>で<勝|まさ>っていようが、魔法の前には特異性を見失うだろう。"
msgstr ""

#. Occurrence C_14:1175:17610: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0008; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1175
msgctxt "text_id=17610 | speaker=touko"
msgid "　ところで青子。"
msgstr ""

#. Occurrence C_14:1181:17611: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0009; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1181
msgctxt "text_id=17611 | speaker=touko"
msgid "　おまえの魔法とやらは、手段か、それとも結果か？」"
msgstr ""

#. Occurrence C_14:1212:17612: scene=C_14
#: C_14:1212
msgctxt "text_id=17612 | speaker=unknown"
msgid "　先なのか、後なのか。"
msgstr ""

#. Occurrence C_14:1234:17613: scene=C_14
#: C_14:1234
msgctxt "text_id=17613 | speaker=unknown"
msgid "　ある場所を目指す為に魔法を必要としたのか、"
msgstr ""

#. Occurrence C_14:1239:17614: scene=C_14
#: C_14:1239
msgctxt "text_id=17614 | speaker=unknown"
msgid "　その場所に到達した為に魔法が出来てしまったのか。"
msgstr ""

#. Occurrence C_14:1260:17615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0006; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1260
msgctxt "text_id=17615 | speaker=aoko"
msgid "「―――後よ。私は扉の前で尻尾をまいたから、じじいの思惑なんて知らないけど」"
msgstr ""

#. Occurrence C_14:1266:17616: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0010; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1266
msgctxt "text_id=17616 | speaker=touko"
msgid "「第一魔法と同じ経緯か。ますます業が深い。第二から第四はその場所へ到達する為に生み出されたものと聞く。"
msgstr ""

#. Occurrence C_14:1273:17617: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0011; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1273
msgctxt "text_id=17617 | speaker=touko"
msgid "同族嫌悪は世の常だ。いずれ第一と食い合わなければいいのだがね。"
msgstr ""

#. Occurrence C_14:1279:17618: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0012; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1279
msgctxt "text_id=17618 | speaker=touko"
msgid "　……しかし、扉ときたか。魔法の継承とは<路|パス>の継承のようだな。ではやはり、ここに<泉|ユミル>の入り口があると？」"
msgstr ""

#. Occurrence C_14:1316:17619: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0007; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1316
msgctxt "text_id=17619 | speaker=aoko"
msgid "「北欧かぶれの貴女にとってはね。私にとってはアカシャの門と言えるものよ。"
msgstr ""

#. Occurrence C_14:1322:17620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0008; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1322
msgctxt "text_id=17620 | speaker=aoko"
msgid "　……最初からそれを狙っていたんでしょう、貴女は」"
msgstr ""

#. Occurrence C_14:1341:17621: scene=C_14
#: C_14:1341
msgctxt "text_id=17621 | speaker=unknown"
msgid "　青子の問いに、橙子は残された命をはき出すように、ああ、と力なくうなずいた。"
msgstr ""

#. Occurrence C_14:1363:17622: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0013; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1363
msgctxt "text_id=17622 | speaker=touko"
msgid "「……望めば手に入るというのに、何代も待つのは嫌だったんだ。"
msgstr ""

msgctxt "text_id=17623 | speaker=unknown"
msgid "祖父とはそれで決別したようなものだったよ。"
msgstr ""

#. Occurrence C_14:1373:17624: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0014; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1373
msgctxt "text_id=17624 | speaker=touko"
msgid "蒼崎に対する復讐心は、それには優先されなかった。"
msgstr ""

#. Occurrence C_14:1393:17625: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0015; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1393
msgctxt "text_id=17625 | speaker=touko"
msgid "　まあ、全ては終わった事だ。もう語る必要はない。"
msgstr ""

#. Occurrence C_14:1399:17626: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0016; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1399
msgctxt "text_id=17626 | speaker=touko"
msgid "　……最後に、<根源|こんげん>に触れた感想が聞きたいな」"
msgstr ""

#. Occurrence C_14:1467:17627: scene=C_14
#: C_14:1467
msgctxt "text_id=17627 | speaker=unknown"
msgid "　深く息を吸いこんで橙子は言った。"
msgstr ""

#. Occurrence C_14:1472:17628: scene=C_14
#: C_14:1472
msgctxt "text_id=17628 | speaker=unknown"
msgid "　憎しみのない<遺言|ゆいごん>。"
msgstr ""

#. Occurrence C_14:1477:17629: scene=C_14
#: C_14:1477
msgctxt "text_id=17629 | speaker=unknown"
msgid "　青子は答えず、右手を高々とかかげる。"
msgstr ""

#. Occurrence C_14:1514:17630: scene=C_14
#: C_14:1514
msgctxt "text_id=17630 | speaker=unknown"
msgid "　数少ない祖父の言いつけ。"
msgstr ""

#. Occurrence C_14:1519:17631: scene=C_14
#: C_14:1519
msgctxt "text_id=17631 | speaker=unknown"
msgid "　魔法の源。"
msgstr ""

#. Occurrence C_14:1524:17632: scene=C_14
#: C_14:1524
msgctxt "text_id=17632 | speaker=unknown"
msgid "　<根源|こんげん>に関しての知識、<所感|しょかん>は一切<漏|も>らしてはならない。"
msgstr ""

#. Occurrence C_14:1552:17633: scene=C_14
#: C_14:1552
msgctxt "text_id=17633 | speaker=unknown"
msgid "　けれど、姉の最後の頼みならば、その感想ぐらいは伝えてあげるべきなのだろうか。"
msgstr ""

#. Occurrence C_14:1595:17634: scene=C_14
#: C_14:1595
msgctxt "text_id=17634 | speaker=unknown"
msgid "　……天を指すその腕が振り落とされれば、話は終わりだ。"
msgstr ""

#. Occurrence C_14:1614:17635: scene=C_14
#: C_14:1614
msgctxt "text_id=17635 | speaker=unknown"
msgid "　この朽ちた建物が姉だった人の<墓標|ぼひょう>になるだろう。"
msgstr ""

#. Occurrence C_14:1638:17636: scene=C_14
#: C_14:1638
msgctxt "text_id=17636 | speaker=unknown"
msgid "　なら素直になるべきだし、そもそも、青子は祖父の言いつけを守る気などさらさら無い。"
msgstr ""

#. Occurrence C_14:1687:17637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0009; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1687
msgctxt "text_id=17637 | speaker=aoko"
msgid "「……白状するとね、姉さん」"
msgstr ""

#. Occurrence C_14:1735:17638: scene=C_14
#: C_14:1735
msgctxt "text_id=17638 | speaker=unknown"
msgid "　蒼い廊下に、声は響く。"
msgstr ""

#. Occurrence C_14:1788:17639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0010; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1788
msgctxt "text_id=17639 | speaker=aoko"
msgid "「―――正直、ぜんっぜん分からなかったわ」"
msgstr ""

#. Occurrence C_14:1798:17640: scene=C_14
#: C_14:1798
msgctxt "text_id=17640 | speaker=unknown"
msgid "　なんだかミもフタもない感想を告げて、落雷のように、青子は右腕を振り落とした。"
msgstr ""

#. Occurrence C_14:1838:17641: scene=C_14
#: C_14:1838
msgctxt "text_id=17641 | speaker=unknown"
msgid "　……いや、落とそうとした。"
msgstr ""

#. Occurrence C_14:1859:17642: scene=C_14
#: C_14:1859
msgctxt "text_id=17642 | speaker=unknown"
msgid "　けれど腕は青子の意に反して止まり、どんなに力を入れても下げられない。"
msgstr ""

#. Occurrence C_14:1884:17643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0011; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1884
msgctxt "text_id=17643 | speaker=aoko"
msgid "「―――何の、つもり」"
msgstr ""

#. Occurrence C_14:1890:17644: scene=C_14
#: C_14:1890
msgctxt "text_id=17644 | speaker=unknown"
msgid "　アリスの役たたず、と内心恨みながら青子は不愉快そうに吐き捨てた。"
msgstr ""

#. Occurrence C_14:1895:17645: scene=C_14
#: C_14:1895
msgctxt "text_id=17645 | speaker=unknown"
msgid "　自分の背後に現れて、かかげた右手を掴んでいる静希草十郎に向けて。"
msgstr ""

#. Occurrence C_14:1913:17646: scene=C_14
#: C_14:1913
msgctxt "text_id=17646 | speaker=unknown"
msgid "　表情にこそでていないが、橙子も彼の乱入に驚いている。"
msgstr ""

#. Occurrence C_14:1955:17647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0012; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1955
msgctxt "text_id=17647 | speaker=aoko"
msgid "「手、離して」"
msgstr ""

#. Occurrence C_14:1961:17648: scene=C_14
#: C_14:1961
msgctxt "text_id=17648 | speaker=unknown"
msgid "　草十郎に振り返る事も、掴まれた腕を見る事もせず、前だけを見つめて青子は言う。"
msgstr ""

#. Occurrence C_14:1966:17649: scene=C_14
#: C_14:1966
msgctxt "text_id=17649 | speaker=unknown"
msgid "　……そういえば、懐かしいあの時も、この男は唐突に現れて人形から自分をかばったんだっけ、などと思いつつ。"
msgstr ""

#. Occurrence C_14:2003:17650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0013; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2003
msgctxt "text_id=17650 | speaker=aoko"
msgid "「聞こえなかった？　二度はないわよ」"
msgstr ""

#. Occurrence C_14:2020:17651: scene=C_14
#: C_14:2020
msgctxt "text_id=17651 | speaker=unknown"
msgid "　青子の声に嘘はない。"
msgstr ""

#. Occurrence C_14:2025:17652: scene=C_14
#: C_14:2025
msgctxt "text_id=17652 | speaker=unknown"
msgid "　邪魔をするのなら、草十郎だろうと容赦はしない。"
msgstr ""

#. Occurrence C_14:2030:17653: scene=C_14
#: C_14:2030
msgctxt "text_id=17653 | speaker=unknown"
msgid "『命だけは助けてあげる』"
msgstr ""

#. Occurrence C_14:2035:17654: scene=C_14
#: C_14:2035
msgctxt "text_id=17654 | speaker=unknown"
msgid "　その約束とは矛盾しているけれど、そこまでしないと草十郎には伝わらないと理解している。"
msgstr ""

#. Occurrence C_14:2066:17655: scene=C_14
#: C_14:2066
msgctxt "text_id=17655 | speaker=unknown"
msgid "　けれど、青子のそんな鉄の意志を聞いても、草十郎は腕を掴んだまま離さない。"
msgstr ""

#. Occurrence C_14:2087:17656: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0015; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2087
msgctxt "text_id=17656 | speaker=aoko"
msgid "「いい加減に……」"
msgstr ""

#. Occurrence C_14:2107:17657: scene=C_14
#: C_14:2107
msgctxt "text_id=17657 | speaker=unknown"
msgid "　離せッ……！　と青子は振り向く。"
msgstr ""

#. Occurrence C_14:2112:17658: scene=C_14
#: C_14:2112
msgctxt "text_id=17658 | speaker=unknown"
msgid "　とたん、声の続きは<喉|のど>に<詰|つ>まってしまった。"
msgstr ""

#. Occurrence C_14:2149:17659: scene=C_14
#: C_14:2149
msgctxt "text_id=17659 | speaker=unknown"
msgid "　……その<表情|かお>を、見るべきではなかったと後悔する。"
msgstr ""

#. Occurrence C_14:2154:17660: scene=C_14
#: C_14:2154
msgctxt "text_id=17660 | speaker=unknown"
msgid "　自分の腕を掴んでいる少年の顔を見て、青子は鏡だな、と痛感した。"
msgstr ""

#. Occurrence C_14:2191:17661: scene=C_14
#: C_14:2191
msgctxt "text_id=17661 | speaker=unknown"
msgid "　<悼|いた>むような哀しみ。"
msgstr ""

#. Occurrence C_14:2196:17662: scene=C_14
#: C_14:2196
msgctxt "text_id=17662 | speaker=unknown"
msgid "　<糾|ただ>すような怒り。"
msgstr ""

#. Occurrence C_14:2202:17663: scene=C_14
#: C_14:2202
msgctxt "text_id=17663 | speaker=unknown"
msgid "　相容れない感情に沈んだ顔は、自分の中にある都合の悪い面を連想させる。"
msgstr ""

#. Occurrence C_14:2261:17664: scene=C_14
#: C_14:2261
msgctxt "text_id=17664 | speaker=unknown"
msgid "　静かに、声もなく、意志もなく。"
msgstr ""

#. Occurrence C_14:2266:17665: scene=C_14
#: C_14:2266
msgctxt "text_id=17665 | speaker=unknown"
msgid "　<贖|あがな>いがたい罪を問う、灰色のさびた瞳。"
msgstr ""

#. Occurrence C_14:2310:17666: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0016; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2310
msgctxt "text_id=17666 | speaker=aoko"
msgid "「……言いたい事があるなら、はっきり口にしなさい。"
msgstr ""

#. Occurrence C_14:2316:17667: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0017; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2316
msgctxt "text_id=17667 | speaker=aoko"
msgid "　それが出来ないなら消えて」"
msgstr ""

#. Occurrence C_14:2341:17668: scene=C_14
#: C_14:2341
msgctxt "text_id=17668 | speaker=unknown"
msgid "　態度を崩さない青子から、草十郎はそっと手をほどいた。"
msgstr ""

#. Occurrence C_14:2348:17669: scene=C_14
#: C_14:2348
msgctxt "text_id=17669 | speaker=unknown"
msgid "　ふたりは敵と味方のように見つめ合う。"
msgstr ""

#. Occurrence C_14:2395:17670: scene=C_14
#: C_14:2395
msgctxt "text_id=17670 | speaker=unknown"
msgid "　互いに口にする事はなくて、あるのは終わらない沈黙の<苦|にが>さだけ。"
msgstr ""

#. Occurrence C_14:2423:17671: scene=C_14
#: C_14:2423
msgctxt "text_id=17671 | speaker=unknown"
msgid "　その中で、不意に、"
msgstr ""

#. Occurrence C_14:2434:17672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0000; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:2434
msgctxt "text_id=17672 | speaker=soujuurou"
msgid "「人殺しは、いけない事だ」"
msgstr ""

#. Occurrence C_14:2463:17673: scene=C_14
#: C_14:2463
msgctxt "text_id=17673 | speaker=unknown"
msgid "　あまりにも聞き慣れた、短い言葉が告げられた。"
msgstr ""

#. Occurrence C_14:2495:17674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0018; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2495
msgctxt "text_id=17674 | speaker=aoko"
msgid "「…………」"
msgstr ""

#. Occurrence C_14:2500:17675: scene=C_14
#: C_14:2500
msgctxt "text_id=17675 | speaker=unknown"
msgid "　それは気持ちを形にしただけの、つまらない言葉だったけれど。"
msgstr ""

#. Occurrence C_14:2505:17676: scene=C_14
#: C_14:2505
msgctxt "text_id=17676 | speaker=unknown"
msgid "　今の青子には、その重さが嫌というほど分かってしまう。"
msgstr ""

#. Occurrence C_14:2510:17677: scene=C_14
#: C_14:2510
msgctxt "text_id=17677 | speaker=unknown"
msgid "　いずれ忘れてしまうとしても、静希草十郎の過去を断片的に知ってしまった彼女には、本当に痛いほど理解できた。"
msgstr ""

#. Occurrence C_14:2549:17678: scene=C_14
#: C_14:2549
msgctxt "text_id=17678 | speaker=unknown"
msgid "　けれどうなずく事はできない。"
msgstr ""

#. Occurrence C_14:2554:17679: scene=C_14
#: C_14:2554
msgctxt "text_id=17679 | speaker=unknown"
msgid "　立場は逆転していくものだ。今を逃したら次は自分が追い詰められる。"
msgstr ""

#. Occurrence C_14:2559:17680: scene=C_14
#: C_14:2559
msgctxt "text_id=17680 | speaker=unknown"
msgid "　だいたい、一度ならず二度までも殺されかけた。"
msgstr ""

#. Occurrence C_14:2564:17681: scene=C_14
#: C_14:2564
msgctxt "text_id=17681 | speaker=unknown"
msgid "　この借りを帳消しにするほど彼女は優しくはないし、"
msgstr ""

#. Occurrence C_14:2569:17682: scene=C_14
#: C_14:2569
msgctxt "text_id=17682 | speaker=unknown"
msgid "　なにより―――このままでは、橙子の言う通り、いつまでも半人前だ。"
msgstr ""

#. Occurrence C_14:2623:17683: scene=C_14
#: C_14:2623
msgctxt "text_id=17683 | speaker=unknown"
msgid "　まだ彼女は、魔術師として最初の<咎|とが>を果たしていない。"
msgstr ""

#. Occurrence C_14:2628:17684: scene=C_14
#: C_14:2628
msgctxt "text_id=17684 | speaker=unknown"
msgid "　その機会が肉親になるのなら、なにより強い決意になると青子は知っている。"
msgstr ""

#. Occurrence C_14:2696:17685: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0019; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2696
msgctxt "text_id=17685 | speaker=aoko"
msgid "「…………っ」"
msgstr ""

#. Occurrence C_14:2701:17686: scene=C_14
#: C_14:2701
msgctxt "text_id=17686 | speaker=unknown"
msgid "　なのに、心の中では彼の台詞が繰り返されている。"
msgstr ""

#. Occurrence C_14:2706:17687: scene=C_14
#: C_14:2706
msgctxt "text_id=17687 | speaker=unknown"
msgid "　……人殺しは、いけない事だ。"
msgstr ""

#. Occurrence C_14:2711:17688: scene=C_14
#: C_14:2711
msgctxt "text_id=17688 | speaker=unknown"
msgid "　子供じみた<率直|そっちょく>さ。その願いが彼にとってどれほど<尊|とうと>いものなのか、憎らしいほど感じ取れる。"
msgstr ""

#. Occurrence C_14:2716:17689: scene=C_14
#: C_14:2716
msgctxt "text_id=17689 | speaker=unknown"
msgid "　それを振り払うため、青子は草十郎を睨みつけた。"
msgstr ""

#. Occurrence C_14:2768:17690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0020_0; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2768
msgctxt "text_id=17690 | speaker=aoko"
msgid "「だから？　"
msgstr ""

msgctxt "text_id=17691 | speaker=unknown"
msgid "殺されたクセに、その相手まで<庇|かば>うっていうのアンタは？　"
msgstr ""

#. Occurrence C_14:2779:17692: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0020_1; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2779
msgctxt "text_id=17692 | speaker=aoko"
msgid "元気になったら懲りずにやってくる殺人鬼が相手でも見逃してやれっていうの？」"
msgstr ""

#. Occurrence C_14:2810:17693: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0001; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:2810
msgctxt "text_id=17693 | speaker=soujuurou"
msgid "「……まさか。そこまでいったら聖者だ。自分には、そこまでの事は言えない」"
msgstr ""

#. Occurrence C_14:2855:17694: scene=C_14
#: C_14:2855
msgctxt "text_id=17694 | speaker=unknown"
msgid "　だが、彼は見逃すだろう。"
msgstr ""

#. Occurrence C_14:2860:17695: scene=C_14
#: C_14:2860
msgctxt "text_id=17695 | speaker=unknown"
msgid "　悪人の改心を期待するのではなく、"
msgstr ""

#. Occurrence C_14:2865:17696: scene=C_14
#: C_14:2865
msgctxt "text_id=17696 | speaker=unknown"
msgid "　悪人の人生を考慮してのものでもなく。"
msgstr ""

#. Occurrence C_14:2893:17697: scene=C_14
#: C_14:2893
msgctxt "text_id=17697 | speaker=unknown"
msgid "　ただ、誰かが生きている事に、感謝したいだけなのだと。"
msgstr ""

#. Occurrence C_14:2938:17698: scene=C_14
#: C_14:2938
msgctxt "text_id=17698 | speaker=unknown"
msgid "“……じゅうぶん聖者なのよ、あなたは……！”"
msgstr ""

#. Occurrence C_14:2944:17699: scene=C_14
#: C_14:2944
msgctxt "text_id=17699 | speaker=unknown"
msgid "　だから、それが頭にくる。"
msgstr ""

#. Occurrence C_14:2949:17700: scene=C_14
#: C_14:2949
msgctxt "text_id=17700 | speaker=unknown"
msgid "　<無|む><知|ち><善良|ぜんりょう>すぎて頭にくるなんて、これでは本当にミラーハウスの焼き直しだ。"
msgstr ""

#. Occurrence C_14:2968:17701: scene=C_14
#: C_14:2968
msgctxt "text_id=17701 | speaker=unknown"
msgid "　違うのは、草十郎がそこまで固執する理由を、今の青子は知っている事。"
msgstr ""

#. Occurrence C_14:2973:17702: scene=C_14
#: C_14:2973
msgctxt "text_id=17702 | speaker=unknown"
msgid "　草十郎はその経緯を、今は彼女に奪われている事。"
msgstr ""

#. Occurrence C_14:3011:17703: scene=C_14
#: C_14:3011
msgctxt "text_id=17703 | speaker=unknown"
msgid "　彼は、彼女とすれ違うように前に出た。"
msgstr ""

#. Occurrence C_14:3016:17704: scene=C_14
#: C_14:3016
msgctxt "text_id=17704 | speaker=unknown"
msgid "　自身が、決して口にしてはならない言葉と共に。"
msgstr ""

#. Occurrence C_14:3051:17705: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0002; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3051
msgctxt "text_id=17705 | speaker=soujuurou"
msgid "「仕返しなら、殺された人間がやるのが筋だろう。"
msgstr ""

#. Occurrence C_14:3057:17706: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0003; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3057
msgctxt "text_id=17706 | speaker=soujuurou"
msgid "　君を止められないのは分かってる。"
msgstr ""

#. Occurrence C_14:3064:17707: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0004; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3064
msgctxt "text_id=17707 | speaker=soujuurou"
msgid "だから、蒼崎がやるぐらいなら、俺がやる」"
msgstr ""

#. Occurrence C_14:3100:17708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0022; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3100
msgctxt "text_id=17708 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_14:3106:17709: scene=C_14
#: C_14:3106
msgctxt "text_id=17709 | speaker=unknown"
msgid "　……その言葉に敗北を感じたのは、果たして誰だったのか。"
msgstr ""

#. Occurrence C_14:3111:17710: scene=C_14
#: C_14:3111
msgctxt "text_id=17710 | speaker=unknown"
msgid "　二人を無言で見つめていた橙子は眠るように目蓋を閉じた。"
msgstr ""

#. Occurrence C_14:3132:17711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0005; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3132
msgctxt "text_id=17711 | speaker=soujuurou"
msgid "「ごめんなさい、橙子さん」"
msgstr ""

#. Occurrence C_14:3138:17712: scene=C_14
#: C_14:3138
msgctxt "text_id=17712 | speaker=unknown"
msgid "　歩み出る草十郎に、橙子は仕方なげに、小さくうなずいた。"
msgstr ""

#. Occurrence C_14:3191:17713: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0017; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3191
msgctxt "text_id=17713 | speaker=touko"
msgid "「……そうだな。君には、それもいいかもしれない。"
msgstr ""

#. Occurrence C_14:3197:17714: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0018; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3197
msgctxt "text_id=17714 | speaker=touko"
msgid "　今は特殊な状況だから、醒めた後に君がどれほど悔やむ事になるか想像もできない。"
msgstr ""

#. Occurrence C_14:3203:17715: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0019; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3203
msgctxt "text_id=17715 | speaker=touko"
msgid "　ただ、それで君の停滞は終わるだろう。晴れて<禊|みそ>ぎ落としというワケだ。純粋に祝福してあげられる。"
msgstr ""

#. Occurrence C_14:3209:17716: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0020; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3209
msgctxt "text_id=17716 | speaker=touko"
msgid "　気に食わないのは、それを決意させたのが私ではなかったという事ぐらいか」"
msgstr ""

#. Occurrence C_14:3241:17717: scene=C_14
#: C_14:3241
msgctxt "text_id=17717 | speaker=unknown"
msgid "　草十郎には分からない言葉を告げて、橙子は唇を堅く閉じた。"
msgstr ""

#. Occurrence C_14:3246:17718: scene=C_14
#: C_14:3246
msgctxt "text_id=17718 | speaker=unknown"
msgid "　……無防備な、細い首が差し出される。"
msgstr ""

#. Occurrence C_14:3251:17719: scene=C_14
#: C_14:3251
msgctxt "text_id=17719 | speaker=unknown"
msgid "　さらに一歩踏みだす草十郎。"
msgstr ""

#. Occurrence C_14:3288:17720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0023; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3288
msgctxt "text_id=17720 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_14:3393:17721: scene=C_14
#: C_14:3393
msgctxt "text_id=17721 | speaker=unknown"
msgid "　それより早く青子は動いた。"
msgstr ""

#. Occurrence C_14:3398:17722: scene=C_14
#: C_14:3398
msgctxt "text_id=17722 | speaker=unknown"
msgid "　草十郎の前に回りこんで、全身に巡る魔力をすべてカットして、力のかぎり右手を振るった。"
msgstr ""

#. Occurrence C_14:3403:17723: scene=C_14
#: C_14:3403
msgctxt "text_id=17723 | speaker=unknown"
msgid "　頬を叩く乾いた音と、廊下を数歩よろめく足音。"
msgstr ""

#. Occurrence C_14:3463:17724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0006; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3463
msgctxt "text_id=17724 | speaker=soujuurou"
msgid "「……あお……崎……？」"
msgstr ""

#. Occurrence C_14:3559:17725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0024; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3559
msgctxt "text_id=17725 | speaker=aoko"
msgid "「この、卑怯者―――」"
msgstr ""

#. Occurrence C_14:3617:17726: scene=C_14
#: C_14:3617
msgctxt "text_id=17726 | speaker=unknown"
msgid "　泣きそうなほど怒っている青子は、そのままくるりと草十郎に背を向ける。"
msgstr ""

#. Occurrence C_14:3622:17727: scene=C_14
#: C_14:3622
msgctxt "text_id=17727 | speaker=unknown"
msgid "　これ以上その顔を見ていたら、本気で殺しかねないと拗ねるように。"
msgstr ""

#. Occurrence C_14:3643:17728: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0021; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3643
msgctxt "text_id=17728 | speaker=touko"
msgid "「他人の記憶を取り込んだ代償か。引きずられたな、青子」"
msgstr ""

#. Occurrence C_14:3649:17729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0025; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3649
msgctxt "text_id=17729 | speaker=aoko"
msgid "「そうよ。自分の意志を<他|ひ><人|と>に曲げられるのが、こんなに悔しいなんて、知らなかった」"
msgstr ""

#. Occurrence C_14:3670:17730: scene=C_14
#: C_14:3670
msgctxt "text_id=17730 | speaker=unknown"
msgid "　皮肉げな呟きに、青子はついそんな返答をしてしまった。"
msgstr ""

#. Occurrence C_14:3675:17731: scene=C_14
#: C_14:3675
msgctxt "text_id=17731 | speaker=unknown"
msgid "　橙子は可笑しそうに唇をつり上げる。"
msgstr ""

#. Occurrence C_14:3718:17732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0026; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3718
msgctxt "text_id=17732 | speaker=aoko"
msgid "「……何が可笑しいのよ、貴女」"
msgstr ""

#. Occurrence C_14:3756:17733: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0022; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3756
msgctxt "text_id=17733 | speaker=touko"
msgid "「いや、おまえにも人並の情けがあるとは思っていなくてね。"
msgstr ""

#. Occurrence C_14:3762:17734: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0023; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3762
msgctxt "text_id=17734 | speaker=touko"
msgid "　バカ呼ばわりは訂正しておくよ。他人の理想を<背|せ><負|お>うのに<怯|おび>えるなんて、十年経っても可愛いじゃないか」"
msgstr ""

#. Occurrence C_14:3815:17735: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0027; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3815
msgctxt "text_id=17735 | speaker=aoko"
msgid "「―――アンタね」"
msgstr ""

#. Occurrence C_14:3865:17736: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0024; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3865
msgctxt "text_id=17736 | speaker=touko"
msgid "「そう睨むな、今のは心からの賛辞だ。"
msgstr ""

#. Occurrence C_14:3871:17737: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0025; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3871
msgctxt "text_id=17737 | speaker=touko"
msgid "　で、私をどうする？　彼に殺させるか、それとも見逃すか？」"
msgstr ""

#. Occurrence C_14:3877:17738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0028; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3877
msgctxt "text_id=17738 | speaker=aoko"
msgid "「……仕方ないでしょ。貴女の言う通り、これが何よりの代償だったんだから」"
msgstr ""

#. Occurrence C_14:3951:17739: scene=C_14
#: C_14:3951
msgctxt "text_id=17739 | speaker=unknown"
msgid "　言って、青子はちらりと草十郎の顔を見た。"
msgstr ""

#. Occurrence C_14:3956:17740: scene=C_14
#: C_14:3956
msgctxt "text_id=17740 | speaker=unknown"
msgid "　<頬|ほほ>を<叩|たた>かれた事で緊張が解けたのか、いつもの<呆|ぼう>とした表情に戻っている。"
msgstr ""

#. Occurrence C_14:4002:17741: scene=C_14
#: C_14:4002
msgctxt "text_id=17741 | speaker=unknown"
msgid "　……たとえ今は過去の記憶がなくとも、深層意識に刻まれた<不文律|ふぶんりつ>は消えはしない。"
msgstr ""

#. Occurrence C_14:4007:17742: scene=C_14
#: C_14:4007
msgctxt "text_id=17742 | speaker=unknown"
msgid "　それを、草十郎は自ら犯そうとした。"
msgstr ""

#. Occurrence C_14:4012:17743: scene=C_14
#: C_14:4012
msgctxt "text_id=17743 | speaker=unknown"
msgid "　自己を永遠に壊し続けるであろう事を代償に。"
msgstr ""

#. Occurrence C_14:4017:17744: scene=C_14
#: C_14:4017
msgctxt "text_id=17744 | speaker=unknown"
msgid "　静希草十郎のためでなく、蒼崎青子を守るために。"
msgstr ""

#. Occurrence C_14:4052:17745: scene=C_14
#: C_14:4052
msgctxt "text_id=17745 | speaker=unknown"
msgid "　今の青子にはそれがよく解っている。"
msgstr ""

#. Occurrence C_14:4057:17746: scene=C_14
#: C_14:4057
msgctxt "text_id=17746 | speaker=unknown"
msgid "　だから彼が『自分がやる』といった瞬間、敗北を知らされた。"
msgstr ""

#. Occurrence C_14:4062:17747: scene=C_14
#: C_14:4062
msgctxt "text_id=17747 | speaker=unknown"
msgid "　それは彼を見殺しにする事と同義であり―――"
msgstr ""

#. Occurrence C_14:4067:17748: scene=C_14
#: C_14:4067
msgctxt "text_id=17748 | speaker=unknown"
msgid "　なにより、それを許せば自分は、彼にとって命より大事な物になってしまう。"
msgstr ""

#. Occurrence C_14:4088:17749: scene=C_14
#: C_14:4088
msgctxt "text_id=17749 | speaker=unknown"
msgid "　……そんな物に、青子はなりたくはなかったのだ。"
msgstr ""

#. Occurrence C_14:4109:17750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0007; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:4109
msgctxt "text_id=17750 | speaker=soujuurou"
msgid "「……蒼崎、やっぱりその、自分の受けた傷は自分で返さないと気が済まない性格か？」"
msgstr ""

#. Occurrence C_14:4132:17751: scene=C_14
#: C_14:4132
msgctxt "text_id=17751 | speaker=unknown"
msgid "　見当違いの心配をしている草十郎から、ぷい、と青子は顔を背ける。"
msgstr ""

#. Occurrence C_14:4137:17752: scene=C_14
#: C_14:4137
msgctxt "text_id=17752 | speaker=unknown"
msgid "　あとは目前に倒れこむ橙子を、いつも通りの不機嫌そうな視線で見下ろした。"
msgstr ""

#. Occurrence C_14:4184:17753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0029; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4184
msgctxt "text_id=17753 | speaker=aoko"
msgid "「……分かったわよ。橙子、今回は見逃してあげる。"
msgstr ""

#. Occurrence C_14:4190:17754: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0030; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4190
msgctxt "text_id=17754 | speaker=aoko"
msgid "　けど、ただで帰れるとは思ってないわよね？」"
msgstr ""

#. Occurrence C_14:4196:17755: scene=C_14
#: C_14:4196
msgctxt "text_id=17755 | speaker=unknown"
msgid "　声もなく口元に笑みを浮かべる青子を、橙子は眉をひそめて見つめた。"
msgstr ""

#. Occurrence C_14:4251:17756: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0026; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4251
msgctxt "text_id=17756 | speaker=touko"
msgid "「祖父の所に突き出すのなら、ここで引導を渡してくれ」"
msgstr ""

#. Occurrence C_14:4258:17757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0031; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4258
msgctxt "text_id=17757 | speaker=aoko"
msgid "「まさか。私もあの人には会いたくないもの。貴女にはこのまま出ていってもらうわ。"
msgstr ""

msgctxt "text_id=17758 | speaker=unknown"
msgid "邪魔もしないし、協会に届けも出さない。"
msgstr ""

#. Occurrence C_14:4266:17759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0032; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4266
msgctxt "text_id=17759 | speaker=aoko"
msgid "　律架は私が言いふくめておくから、今回の件は私たちだけの秘密よ」"
msgstr ""

#. Occurrence C_14:4301:17760: scene=C_14
#: C_14:4301
msgctxt "text_id=17760 | speaker=unknown"
msgid "　橙子はますます眉をひそめる。"
msgstr ""

#. Occurrence C_14:4306:17761: scene=C_14
#: C_14:4306
msgctxt "text_id=17761 | speaker=unknown"
msgid "　そんな都合のいい話、ある訳がない。"
msgstr ""

#. Occurrence C_14:4339:17762: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0027; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4339
msgctxt "text_id=17762 | speaker=touko"
msgid "「青子。何を企んでいる」"
msgstr ""

#. Occurrence C_14:4404:17763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0033; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4404
msgctxt "text_id=17763 | speaker=aoko"
msgid "「別に。"
msgstr ""

msgctxt "text_id=17764 | speaker=unknown"
msgid "そのかわりに呪いをプレゼントしようと思って。今までさんざんガンドくらってきたし、おあいこでしょ？"
msgstr ""

#. Occurrence C_14:4412:17765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0034; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4412
msgctxt "text_id=17765 | speaker=aoko"
msgid "　まあ、私のはちょっと強力だけど。"
msgstr ""

#. Occurrence C_14:4419:17766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0035; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4419
msgctxt "text_id=17766 | speaker=aoko"
msgid "今後この土地に入ろうものなら、マダガスカルガエルになってもらうわ」"
msgstr ""

#. Occurrence C_14:4425:17767: scene=C_14
#: C_14:4425
msgctxt "text_id=17767 | speaker=unknown"
msgid "　まるで明日の夕飯は中華にしよう、という気軽さで微笑んで、彼女は橙子へと歩み寄った。"
msgstr ""

#. Occurrence C_14:4485:17768: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0028; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4485
msgctxt "text_id=17768 | speaker=touko"
msgid "「待て……！"
msgstr ""

#. Occurrence C_14:4491:17769: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0029; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4491
msgctxt "text_id=17769 | speaker=touko"
msgid "　なんでそういうモノだけ修得してるんだ、おまえは！」"
msgstr ""

#. Occurrence C_14:4497:17770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0036; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4497
msgctxt "text_id=17770 | speaker=aoko"
msgid "「そりゃ師匠がアリスだもの。<偏|かたよ>るのは当然でしょ？」"
msgstr ""

#. Occurrence C_14:4537:17771: scene=C_14
#: C_14:4537
msgctxt "text_id=17771 | speaker=unknown"
msgid "　むう、と納得しつつ眉をひそめる蒼崎・姉。"
msgstr ""

#. Occurrence C_14:4542:17772: scene=C_14
#: C_14:4542
msgctxt "text_id=17772 | speaker=unknown"
msgid "　妹がいつまで経っても半人前なのは、そのあたりに原因があったのかと。"
msgstr ""

#. Occurrence C_14:4590:17773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0037; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4590
msgctxt "text_id=17773 | speaker=aoko"
msgid "「草十郎、席<外|はず>して。"
msgstr ""

#. Occurrence C_14:4596:17774: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0038; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4596
msgctxt "text_id=17774 | speaker=aoko"
msgid "　覗き見が趣味なら、別に見ていってもいいけど」"
msgstr ""

#. Occurrence C_14:4627:17775: scene=C_14
#: C_14:4627
msgctxt "text_id=17775 | speaker=unknown"
msgid "　言いつつ、青子は姉のコートをはぎ取りにかかる。"
msgstr ""

#. Occurrence C_14:4632:17776: scene=C_14
#: C_14:4632
msgctxt "text_id=17776 | speaker=unknown"
msgid "　橙子のイヤそうな目と、青子のどことなく楽しげな目が対照的で、草十郎は少しだけ悩んでしまった。"
msgstr ""

#. Occurrence C_14:4637:17777: scene=C_14
#: C_14:4637
msgctxt "text_id=17777 | speaker=unknown"
msgid "　はたして、このまま青子と橙子をふたりだけにしていいものか、と。"
msgstr ""

#. Occurrence C_14:4657:17778: scene=C_14
#: C_14:4657
msgctxt "text_id=17778 | speaker=unknown"
msgid "　けれど結局、罰ゲームを思わせる姉妹の様子に草十郎はうん、と頷き、"
msgstr ""

#. Occurrence C_14:4670:17779: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0008; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:4670
msgctxt "text_id=17779 | speaker=soujuurou"
msgid "「覗き見は、たしかにいい趣味じゃないな」"
msgstr ""

#. Occurrence C_14:4682:17780: scene=C_14
#: C_14:4682
msgctxt "text_id=17780 | speaker=unknown"
msgid "　いつかのように呟いて、適当な空き教室へ退場した。"
msgstr ""

#. Occurrence C_14:4729:17781: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0030; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4729
msgctxt "text_id=17781 | speaker=touko"
msgid "「ちょっ、なんだその不細工で悪趣味な術式は……！　"
msgstr ""

msgctxt "text_id=17782 | speaker=unknown"
msgid "センスがないにも程がある！　おまえ、本当に私の妹か！？」"
msgstr ""

#. Occurrence C_14:4739:17783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0039; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4739
msgctxt "text_id=17783 | speaker=aoko"
msgid "「ええ。この通り、芸術的才能はぜんぶ姉貴に持っていかれた憐れな妹でして。嘆くなら自分の天才性を嘆きなさい、橙子」"
msgstr ""

#. Occurrence C_14:4745:17784: scene=C_14
#: C_14:4745
msgctxt "text_id=17784 | speaker=unknown"
msgid "　廊下には泣き声とも笑い声ともつかない苦悶の声が、遠吠えのように響いていった。"
msgstr ""

#. Occurrence C_15:97:17785: scene=C_15
#: C_15:97
msgctxt "text_id=17785 | speaker=unknown"
msgid "　咲き乱れていた白い花々は、ひとつ、またひとつと夜空へ舞い上がっていく。"
msgstr ""

#. Occurrence C_15:102:17786: scene=C_15
#: C_15:102
msgctxt "text_id=17786 | speaker=unknown"
msgid "　<吹|ふ><雪|ぶ>く<花霞|はながすみ>の中、有珠は原初の星空を見つめていた。"
msgstr ""

#. Occurrence C_15:107:17787: scene=C_15
#: C_15:107
msgctxt "text_id=17787 | speaker=unknown"
msgid "　花びらは<群雲|むらくも>になって、静かに、眠るように欠けていく。"
msgstr ""

#. Occurrence C_15:112:17788: scene=C_15
#: C_15:112
msgctxt "text_id=17788 | speaker=unknown"
msgid "　いずれは一輪の<華影|かえい>もなく、広場はもとの雪原に<還|かえ>るのだろう。"
msgstr ""

#. Occurrence C_15:207:17789: scene=C_15
#: C_15:207
msgctxt "text_id=17789 | speaker=unknown"
msgid "　魔法は終わり。"
msgstr ""

#. Occurrence C_15:212:17790: scene=C_15
#: C_15:212
msgctxt "text_id=17790 | speaker=unknown"
msgid "　過去の光景は、あと数分足らずで退場する。"
msgstr ""

#. Occurrence C_15:217:17791: scene=C_15
#: C_15:217
msgctxt "text_id=17791 | speaker=unknown"
msgid "　少年と少女の、行き違った時間のように。"
msgstr ""

#. Occurrence C_15:290:17792: scene=C_15
#: C_15:290
msgctxt "text_id=17792 | speaker=unknown"
msgid "　旧校舎から音が<絶|た>えて<久|ひさ>しい。"
msgstr ""

#. Occurrence C_15:295:17793: scene=C_15
#: C_15:295
msgctxt "text_id=17793 | speaker=unknown"
msgid "　有珠は無言で待ち続ける。"
msgstr ""

#. Occurrence C_15:300:17794: scene=C_15
#: C_15:300
msgctxt "text_id=17794 | speaker=unknown"
msgid "　しばらくの<後|あと>、旧校舎から現れた草十郎の姿を見て、有珠は白い息をこぼした。"
msgstr ""

#. Occurrence C_15:306:17795: scene=C_15
#: C_15:306
msgctxt "text_id=17795 | speaker=unknown"
msgid "　かすかな安堵をふくんだ、終わりを認める嘆息を。"
msgstr ""

#. Occurrence C_15:355:17796: scene=C_15
#: C_15:355
msgctxt "text_id=17796 | speaker=unknown"
msgid "　草十郎は青子を抱えてやってきた。"
msgstr ""

#. Occurrence C_15:360:17797: scene=C_15
#: C_15:360
msgctxt "text_id=17797 | speaker=unknown"
msgid "　背中におぶるのではなく、前に寝かせるように両手で。"
msgstr ""

#. Occurrence C_15:382:17798: scene=C_15
#: C_15:382
msgctxt "text_id=17798 | speaker=unknown"
msgid "　青子は眠っているのか、安らかな顔で目蓋を閉じていた。"
msgstr ""

#. Occurrence C_15:387:17799: scene=C_15
#: C_15:387
msgctxt "text_id=17799 | speaker=unknown"
msgid "　ぐったりとした、けれどしなやかな体と長い髪が、童話の眠り姫を連想させる。"
msgstr ""

#. Occurrence C_15:423:17800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0000; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:423
msgctxt "text_id=17800 | speaker=soujuurou"
msgid "「待っていてくれたんだ、有珠」"
msgstr ""

#. Occurrence C_15:429:17801: scene=C_15
#: C_15:429
msgctxt "text_id=17801 | speaker=unknown"
msgid "　苦もなく青子を抱える草十郎に、有珠は頷きだけで返答した。"
msgstr ""

#. Occurrence C_15:450:17802: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0000; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:450
msgctxt "text_id=17802 | speaker=alice"
msgid "「橙子さんはどうなったの？」"
msgstr ""

#. Occurrence C_15:456:17803: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0001; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:456
msgctxt "text_id=17803 | speaker=soujuurou"
msgid "「……いや。よく分からないけど、橙子さんは帰ったよ。"
msgstr ""

#. Occurrence C_15:462:17804: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0002; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:462
msgctxt "text_id=17804 | speaker=soujuurou"
msgid "　蒼崎が言うにはそう簡単に解呪できない呪いをかけたから、むこう十年は三咲市には入ってこれないって。"
msgstr ""

#. Occurrence C_15:468:17805: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0003; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:468
msgctxt "text_id=17805 | speaker=soujuurou"
msgid "　その後、橙子さんが尻尾をまくのを仁王立ちで見届けて、見えなくなったらそのまま倒れたんだ」"
msgstr ""

#. Occurrence C_15:505:17806: scene=C_15
#: C_15:505
msgctxt "text_id=17806 | speaker=unknown"
msgid "　その光景は簡単に想像できるのか、有珠はそう、と素っ気なく応えた。"
msgstr ""

#. Occurrence C_15:510:17807: scene=C_15
#: C_15:510
msgctxt "text_id=17807 | speaker=unknown"
msgid "　橙子の心配はするクセに青子の心配はこれっぽっちもしていないらしい。"
msgstr ""

#. Occurrence C_15:515:17808: scene=C_15
#: C_15:515
msgctxt "text_id=17808 | speaker=unknown"
msgid "　青子と有珠の関係そのものを、ちょっと心配してしまう草十郎だった。"
msgstr ""

#. Occurrence C_15:551:17809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0004; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:551
msgctxt "text_id=17809 | speaker=soujuurou"
msgid "「それはともかくとして。"
msgstr ""

#. Occurrence C_15:557:17810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0005; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:557
msgctxt "text_id=17810 | speaker=soujuurou"
msgid "　青子はどうなっているんだろう？」"
msgstr ""

#. Occurrence C_15:563:17811: scene=C_15
#: C_15:563
msgctxt "text_id=17811 | speaker=unknown"
msgid "　わりとどうでもいいような口ぶりで、草十郎は寝息をたてている少女の顔を覗きこむ。"
msgstr ""

#. Occurrence C_15:601:17812: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0001; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:601
msgctxt "text_id=17812 | speaker=alice"
msgid "「……<無順|むじゅん>と<正順|せいじゅん>を合わせているのね。"
msgstr ""

#. Occurrence C_15:607:17813: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0002; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:607
msgctxt "text_id=17813 | speaker=alice"
msgid "　彼女の時間は今の時間とは異なってしまったから、歯車を合わせるまで目は覚めないわ」"
msgstr ""

#. Occurrence C_15:613:17814: scene=C_15
#: C_15:613
msgctxt "text_id=17814 | speaker=unknown"
msgid "　有珠の言葉に、なるほど、などと<胡乱|うろん>な相づちをうって、草十郎は旧校舎を振り返った。"
msgstr ""

#. Occurrence C_15:665:17815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0006; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:665
msgctxt "text_id=17815 | speaker=soujuurou"
msgid "「なんか拍子抜けしたよ。"
msgstr ""

#. Occurrence C_15:671:17816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0007; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:671
msgctxt "text_id=17816 | speaker=soujuurou"
msgid "　結局、橙子さんと蒼崎、どっちが勝ったのかよく掴めない」"
msgstr ""

#. Occurrence C_15:692:17817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0003; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:692
msgctxt "text_id=17817 | speaker=alice"
msgid "「……そうね。魔術師の争いには明確な点数はつけられないから。どちらが強いかで勝負はつかないわ。"
msgstr ""

#. Occurrence C_15:698:17818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0004; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:698
msgctxt "text_id=17818 | speaker=alice"
msgid "　橙子さんの大目的が蒼崎の魔法の解明なら、魔法を使わされた時点で青子の負けよ。"
msgstr ""

#. Occurrence C_15:705:17819: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0005; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:705
msgctxt "text_id=17819 | speaker=alice"
msgid "……その後のいざこざは、<凱旋|がいせん>する勝者を夜道で襲ったようなものだし」"
msgstr ""

#. Occurrence C_15:725:17820: scene=C_15
#: C_15:725
msgctxt "text_id=17820 | speaker=unknown"
msgid "　言って、有珠は森の方角に視線を投げた。"
msgstr ""

#. Occurrence C_15:730:17821: scene=C_15
#: C_15:730
msgctxt "text_id=17821 | speaker=unknown"
msgid "　それが『帰りましょう』という意思表示である事は、草十郎にも読み取れた。"
msgstr ""

#. Occurrence C_15:783:17822: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0008; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:783
msgctxt "text_id=17822 | speaker=soujuurou"
msgid "「そうだね。蒼崎も有珠も、このままじゃ風邪をひく。"
msgstr ""

#. Occurrence C_15:789:17823: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0009; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:789
msgctxt "text_id=17823 | speaker=soujuurou"
msgid "　ああ、それと。蒼崎が橙子さんに呪いをかける時、何かしてたんだけど」"
msgstr ""

#. Occurrence C_15:795:17824: scene=C_15
#: C_15:795
msgctxt "text_id=17824 | speaker=unknown"
msgid "　わかる？　と訊きたがる草十郎に、有珠はやや作り物っぽい、いつもの無感情な視線を向けた。"
msgstr ""

#. Occurrence C_15:843:17825: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0006; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:843
msgctxt "text_id=17825 | speaker=alice"
msgid "「……見たの、静希君？」"
msgstr ""

#. Occurrence C_15:849:17826: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0010; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:849
msgctxt "text_id=17826 | speaker=soujuurou"
msgid "「いや、蒼崎が出てけって」"
msgstr ""

#. Occurrence C_15:865:17827: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0007; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:865
msgctxt "text_id=17827 | speaker=alice"
msgid "「……そう。それで、青子はどんな呪いをかけたの？」"
msgstr ""

#. Occurrence C_15:871:17828: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0011; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:871
msgctxt "text_id=17828 | speaker=soujuurou"
msgid "「えーと、カエルがどうとか」"
msgstr ""

#. Occurrence C_15:901:17829: scene=C_15
#: C_15:901
msgctxt "text_id=17829 | speaker=unknown"
msgid "　草十郎の言葉に、有珠はますます顔を<曇|くも>らせる。"
msgstr ""

#. Occurrence C_15:906:17830: scene=C_15
#: C_15:906
msgctxt "text_id=17830 | speaker=unknown"
msgid "　……体を変異させる呪いなんて、青子はまだ修得していないはずなのに。"
msgstr ""

#. Occurrence C_15:979:17831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0008; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:979
msgctxt "text_id=17831 | speaker=alice"
msgid "「そ―――」"
msgstr ""

#. Occurrence C_15:985:17832: scene=C_15
#: C_15:985
msgctxt "text_id=17832 | speaker=unknown"
msgid "　思い立って、その言葉を飲む。"
msgstr ""

#. Occurrence C_15:990:17833: scene=C_15
#: C_15:990
msgctxt "text_id=17833 | speaker=unknown"
msgid "　そう、たしかにさっきまでの彼女なら、それぐらいは知っていたかもしれない。"
msgstr ""

#. Occurrence C_15:995:17834: scene=C_15
#: C_15:995
msgctxt "text_id=17834 | speaker=unknown"
msgid "　そうなると青子の言う通り、むこう十年は呪いの解呪はできないだろう。"
msgstr ""

#. Occurrence C_15:1015:17835: scene=C_15
#: C_15:1015
msgctxt "text_id=17835 | speaker=unknown"
msgid "　なにしろ呪いをかけた本人が、その呪いをまだ修得していないのだ。"
msgstr ""

#. Occurrence C_15:1020:17836: scene=C_15
#: C_15:1020
msgctxt "text_id=17836 | speaker=unknown"
msgid "　<回|まわ>そうにも、呪い返す相手がいない。"
msgstr ""

#. Occurrence C_15:1025:17837: scene=C_15
#: C_15:1025
msgctxt "text_id=17837 | speaker=unknown"
msgid "　いかに橙子が優れた呪いの破壊を開発しても、因にあたる<青子|あいて>がいないのでは成立しない。"
msgstr ""

#. Occurrence C_15:1101:17838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0009; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1101
msgctxt "text_id=17838 | speaker=alice"
msgid "「青子が橙子さんにつけたのは<切傷|きりきず>ぐらいだから、静希君が心配するような事はないわ。"
msgstr ""

#. Occurrence C_15:1107:17839: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0010; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1107
msgctxt "text_id=17839 | speaker=alice"
msgid "　……青子にしては、ずいぶんと<生温|なまぬる>い処置だけど」"
msgstr ""

#. Occurrence C_15:1153:17840: scene=C_15
#: C_15:1153
msgctxt "text_id=17840 | speaker=unknown"
msgid "　わりと非道な事を言って、有珠は歩きだした。"
msgstr ""

#. Occurrence C_15:1158:17841: scene=C_15
#: C_15:1158
msgctxt "text_id=17841 | speaker=unknown"
msgid "　草十郎も青子を抱いたまま付いていく。"
msgstr ""

#. Occurrence C_15:1171:17842: scene=C_15
#: C_15:1171
msgctxt "text_id=17842 | speaker=unknown"
msgid "　ふたりは広場から出て森の中に入る。"
msgstr ""

#. Occurrence C_15:1176:17843: scene=C_15
#: C_15:1176
msgctxt "text_id=17843 | speaker=unknown"
msgid "　その時、不意に草十郎は足を止めた。"
msgstr ""

#. Occurrence C_15:1223:17844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0011; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1223
msgctxt "text_id=17844 | speaker=alice"
msgid "「…………静希君？」"
msgstr ""

#. Occurrence C_15:1229:17845: scene=C_15
#: C_15:1229
msgctxt "text_id=17845 | speaker=unknown"
msgid "　草十郎は不思議そうに、旧校舎の広場を振り返る。"
msgstr ""

#. Occurrence C_15:1329:17846: scene=C_15
#: C_15:1329
msgctxt "text_id=17846 | speaker=unknown"
msgid "　眼差しは、望郷の<類|たぐい>だろうか。"
msgstr ""

#. Occurrence C_15:1334:17847: scene=C_15
#: C_15:1334
msgctxt "text_id=17847 | speaker=unknown"
msgid "　一夜だけの、二度と見る事のない風景を<懐|なつ>かしみながらも、二度と出会えない事を<悟|さと>っている顔。"
msgstr ""

#. Occurrence C_15:1339:17848: scene=C_15
#: C_15:1339
msgctxt "text_id=17848 | speaker=unknown"
msgid "　戻らない船を見送る子供のようだ。"
msgstr ""

#. Occurrence C_15:1345:17849: scene=C_15
#: C_15:1345
msgctxt "text_id=17849 | speaker=unknown"
msgid "　……その横顔に、わずかな同情を抱いている事に気付いて、有珠は自らを<戒|いまし>めた。"
msgstr ""

#. Occurrence C_15:1417:17850: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0012; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1417
msgctxt "text_id=17850 | speaker=alice"
msgid "「あの<荒地|あれち>がどうかした……？」"
msgstr ""

#. Occurrence C_15:1423:17851: scene=C_15
#: C_15:1423
msgctxt "text_id=17851 | speaker=unknown"
msgid "　雪原に戻りかける花園を、少女は荒地と言った。"
msgstr ""

#. Occurrence C_15:1428:17852: scene=C_15
#: C_15:1428
msgctxt "text_id=17852 | speaker=unknown"
msgid "　有珠の問いかけに、草十郎はいや、と首を振る。"
msgstr ""

#. Occurrence C_15:1449:17853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0012; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1449
msgctxt "text_id=17853 | speaker=soujuurou"
msgid "「なんとなく知っている場所に似てる気がして。"
msgstr ""

#. Occurrence C_15:1455:17854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0013; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1455
msgctxt "text_id=17854 | speaker=soujuurou"
msgid "　おかしいな、やってきた時はそんな気はしなかったのに」"
msgstr ""

#. Occurrence C_15:1507:17855: scene=C_15
#: C_15:1507
msgctxt "text_id=17855 | speaker=unknown"
msgid "　彼は、いつまでも名残惜しそうに雪原を見つめていた。"
msgstr ""

#. Occurrence C_15:1512:17856: scene=C_15
#: C_15:1512
msgctxt "text_id=17856 | speaker=unknown"
msgid "　放っておけば朝が来るまで、いや、朝が来ても見つめたままだろう。"
msgstr ""

#. Occurrence C_15:1517:17857: scene=C_15
#: C_15:1517
msgctxt "text_id=17857 | speaker=unknown"
msgid "　……けれど、それは意味のない行為だ。"
msgstr ""

#. Occurrence C_15:1522:17858: scene=C_15
#: C_15:1522
msgctxt "text_id=17858 | speaker=unknown"
msgid "　彼が恋焦がれている風景は、有珠だけが覚えているものなのだから。"
msgstr ""

#. Occurrence C_15:1550:17859: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0013; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1550
msgctxt "text_id=17859 | speaker=alice"
msgid "「……ここは、その場所にそんなに似てる？」"
msgstr ""

#. Occurrence C_15:1556:17860: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0014; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1556
msgctxt "text_id=17860 | speaker=soujuurou"
msgid "「ぜんぜん似てない。<面影|おもかげ>すら<皆無|かいむ>だ」"
msgstr ""

#. Occurrence C_15:1562:17861: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0014; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1562
msgctxt "text_id=17861 | speaker=alice"
msgid "「なら、それは気の迷いよ」"
msgstr ""

#. Occurrence C_15:1600:17862: scene=C_15
#: C_15:1600
msgctxt "text_id=17862 | speaker=unknown"
msgid "　強く断定する有珠の言葉に、草十郎は静かに頷いた。"
msgstr ""

#. Occurrence C_15:1605:17863: scene=C_15
#: C_15:1605
msgctxt "text_id=17863 | speaker=unknown"
msgid "　ありえないものに焦がれるのは、もう止めようと微笑むように。"
msgstr ""

#. Occurrence C_15:1676:17864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0015; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1676
msgctxt "text_id=17864 | speaker=soujuurou"
msgid "「そうだね。たぶん、幻を見ていたんだ。"
msgstr ""

#. Occurrence C_15:1682:17865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0016; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1682
msgctxt "text_id=17865 | speaker=soujuurou"
msgid "　……あれは一度、幸福だった時の夢だった」"
msgstr ""

#. Occurrence C_15:1688:17866: scene=C_15
#: C_15:1688
msgctxt "text_id=17866 | speaker=unknown"
msgid "　尽きぬ名残を断ち切って、草十郎は雪原から目を背ける。"
msgstr ""

#. Occurrence C_15:1693:17867: scene=C_15
#: C_15:1693
msgctxt "text_id=17867 | speaker=unknown"
msgid "　どこにも共通点のない、彼が一度だけ幸福だった野原から。"
msgstr ""

#. Occurrence C_15:1746:17868: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0017; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1746
msgctxt "text_id=17868 | speaker=soujuurou"
msgid "「さ、早く帰ろう。蒼崎は重いし、体も疲れてる。"
msgstr ""

#. Occurrence C_15:1752:17869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0018; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1752
msgctxt "text_id=17869 | speaker=soujuurou"
msgid "　洋館についたらあったかいお茶を淹れよう、有珠」"
msgstr ""

#. Occurrence C_15:1772:17870: scene=C_15
#: C_15:1772
msgctxt "text_id=17870 | speaker=unknown"
msgid "　鮮やかな笑顔をうかべて、草十郎は少女の名を呼びかけた。"
msgstr ""

#. Occurrence C_15:1777:17871: scene=C_15
#: C_15:1777
msgctxt "text_id=17871 | speaker=unknown"
msgid "　それに一瞬だけ有珠は息を止めてしまう。"
msgstr ""

#. Occurrence C_15:1782:17872: scene=C_15
#: C_15:1782
msgctxt "text_id=17872 | speaker=unknown"
msgid "　こんな風に、あんまりにも自然に名を呼ばれたのはいつ以来だろう。"
msgstr ""

#. Occurrence C_15:1787:17873: scene=C_15
#: C_15:1787
msgctxt "text_id=17873 | speaker=unknown"
msgid "　なんとか頷き返す有珠と、歩きだす草十郎。"
msgstr ""

#. Occurrence C_15:1792:17874: scene=C_15
#: C_15:1792
msgctxt "text_id=17874 | speaker=unknown"
msgid "　その背中に、有珠はちょっとした疑問を投げかけてみた。"
msgstr ""

#. Occurrence C_15:1813:17875: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0015; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1813
msgctxt "text_id=17875 | speaker=alice"
msgid "「……重いって、わたしより？」"
msgstr ""

#. Occurrence C_15:1847:17876: scene=C_15
#: C_15:1847
msgctxt "text_id=17876 | speaker=unknown"
msgid "　……青子と有珠では身長差がある。"
msgstr ""

#. Occurrence C_15:1852:17877: scene=C_15
#: C_15:1852
msgctxt "text_id=17877 | speaker=unknown"
msgid "　有珠の方が軽いのは当たり前のコトだろうけど、その答えを、少女は彼の口から聞いてみたかったのかも知れない。"
msgstr ""

#. Occurrence C_15:1857:17878: scene=C_15
#: C_15:1857
msgctxt "text_id=17878 | speaker=unknown"
msgid "　そんな有珠の期待にそうように、草十郎はきっぱりと口にした。"
msgstr ""

#. Occurrence C_15:1884:17879: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0019; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1884
msgctxt "text_id=17879 | speaker=soujuurou"
msgid "「ああ。数値的に言うのなら、有珠より十キロ増しぐらい」"
msgstr ""

#. Occurrence C_15:1890:17880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0016; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1890
msgctxt "text_id=17880 | speaker=alice"
msgid "「そう。青子が聞いてたら大変ね」"
msgstr ""

#. Occurrence C_15:1907:17881: scene=C_15
#: C_15:1907
msgctxt "text_id=17881 | speaker=unknown"
msgid "　それは、後で青子に告げ口をしよう、という悪戯心を思わせる口調だった。"
msgstr ""

#. Occurrence C_15:1928:17882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0020; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1928
msgctxt "text_id=17882 | speaker=soujuurou"
msgid "「……意地が悪いな、有珠も。"
msgstr ""

#. Occurrence C_15:1935:17883: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0021; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1935
msgctxt "text_id=17883 | speaker=soujuurou"
msgid "それに、さっきのは本人の名誉のために四捨五入してたんだぞ、いちおう」"
msgstr ""

#. Occurrence C_15:1965:17884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0017; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1965
msgctxt "text_id=17884 | speaker=alice"
msgid "「――――――」"
msgstr ""

#. Occurrence C_15:1971:17885: scene=C_15
#: C_15:1971
msgctxt "text_id=17885 | speaker=unknown"
msgid "　弁解どころか、青子が本気で怒りかねない事実だった。"
msgstr ""

#. Occurrence C_15:1992:17886: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0022; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1992
msgctxt "text_id=17886 | speaker=soujuurou"
msgid "「…………ダメかな？」"
msgstr ""

#. Occurrence C_15:2035:17887: scene=C_15
#: C_15:2035
msgctxt "text_id=17887 | speaker=unknown"
msgid "　困った顔で有珠の様子をうかがう草十郎。"
msgstr ""

#. Occurrence C_15:2040:17888: scene=C_15
#: C_15:2040
msgctxt "text_id=17888 | speaker=unknown"
msgid "　その仕草は妙に温かで、有珠はつい、<緩|ゆる>んだ頬をかすかな笑顔に変えてしまった。"
msgstr ""

#. Occurrence C_15:2065:17889: scene=C_15
#: C_15:2065
msgctxt "text_id=17889 | speaker=unknown"
msgid "　人前で笑う事に慣れていないためか、有珠は顔を背けて森へと歩きだした。"
msgstr ""

#. Occurrence C_15:2070:17890: scene=C_15
#: C_15:2070
msgctxt "text_id=17890 | speaker=unknown"
msgid "　そんな有珠の後ろ姿を見ながら、草十郎は相変わらず見当違いの感想を口にする。"
msgstr ""

#. Occurrence C_15:2111:17891: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0023; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:2111
msgctxt "text_id=17891 | speaker=soujuurou"
msgid "「―――なんだ。"
msgstr ""

#. Occurrence C_15:2118:17892: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0024; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:2118
msgctxt "text_id=17892 | speaker=soujuurou"
msgid "友達の悪口で怒るなんて、やっぱり仲はいいんじゃないか、蒼崎」"
msgstr ""

#. Occurrence C_15:2128:17893: scene=C_15
#: C_15:2128
msgctxt "text_id=17893 | speaker=unknown"
msgid "　青子を抱いたまま呟いて、草十郎はしずしずと有珠の後を追っていった。"
msgstr ""

#. Occurrence C_15:2179:17894: scene=C_15
#: C_15:2179
msgctxt "text_id=17894 | speaker=unknown"
msgid "　森の中、眠り姫に口づけする勇気もなく、助けただけでお城に帰還しようとする若い騎士。"
msgstr ""

#. Occurrence C_15:2185:17895: scene=C_15
#: C_15:2185
msgctxt "text_id=17895 | speaker=unknown"
msgid "　十分な活躍はした筈なのに格好がつかない彼は、そんな物語の主人公を思わせた。"
msgstr ""

#. Occurrence C_2:68:17896: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0000; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:68
msgctxt "text_id=17896 | speaker=touko"
msgid "「と、まあこういう訳だ。"
msgstr ""

#. Occurrence C_2:74:17897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0001; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:74
msgctxt "text_id=17897 | speaker=touko"
msgid "　ベオだけに頼ってはいない事がよく分かったろう」"
msgstr ""

#. Occurrence C_2:80:17898: scene=C_2
#: C_2:80
msgctxt "text_id=17898 | speaker=unknown"
msgid "　表情は冷淡なまま。勝利は<揺|ゆ>るぎないものとなったのに、橙子には喜びの笑みもない。"
msgstr ""

#. Occurrence C_2:129:17899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0002; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:129
msgctxt "text_id=17899 | speaker=touko"
msgid "「姿を隠したのは鏡の応用か。"
msgstr ""

#. Occurrence C_2:135:17900: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0003; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:135
msgctxt "text_id=17900 | speaker=touko"
msgid "　……探知や隔離だけでなく、援護まで行えるとはね。"
msgstr ""

#. Occurrence C_2:141:17901: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0004; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:141
msgctxt "text_id=17901 | speaker=touko"
msgid "　三大のプロイには含まれないものの、汎用性の面で言えばアレも破格のプロイだな」"
msgstr ""

#. Occurrence C_2:166:17902: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:166
msgctxt "text_id=17902 | speaker=aoko"
msgid "「……持ち上げるじゃない。なに、騙された負けおしみ？」"
msgstr ""

#. Occurrence C_2:218:17903: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0005; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:218
msgctxt "text_id=17903 | speaker=touko"
msgid "「いや、ただの自画自賛だよ。"
msgstr ""

#. Occurrence C_2:224:17904: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0006; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:224
msgctxt "text_id=17904 | speaker=touko"
msgid "　なにしろ今の<鏡|バージョン>は私とマインスターの合作だ。趣味に興じすぎてあれこれと機能を足してしまったと、今更ながら悔いているところさ」"
msgstr ""

#. Occurrence C_2:250:17905: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0007; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:250
msgctxt "text_id=17905 | speaker=touko"
msgid "「その後、青子に見せかけて私に向かってきたのは例の駒鳥。それに気を取られている間の大規模な魔術の発動。"
msgstr ""

#. Occurrence C_2:261:17906: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0008; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:261
msgctxt "text_id=17906 | speaker=touko"
msgid "　私の魔眼は有珠が防ぎ、青子は攻撃だけに専念する……組み立ては悪くはない。よくやったと言っておくよ」"
msgstr ""

#. Occurrence C_2:310:17907: scene=C_2
#: C_2:310
msgctxt "text_id=17907 | speaker=unknown"
msgid "　一連の攻防を顧みて、所感を述べる橙子。"
msgstr ""

#. Occurrence C_2:315:17908: scene=C_2
#: C_2:315
msgctxt "text_id=17908 | speaker=unknown"
msgid "　青子は橙子の背後に咲いた魔術刻印に気を取られている。"
msgstr ""

#. Occurrence C_2:320:17909: scene=C_2
#: C_2:320
msgctxt "text_id=17909 | speaker=unknown"
msgid "　有珠だけが、橙子の言動を正確に把握していた。"
msgstr ""

#. Occurrence C_2:361:17910: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0009; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:361
msgctxt "text_id=17910 | speaker=touko"
msgid "「しかし、それもここまでだ。"
msgstr ""

#. Occurrence C_2:367:17911: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0010; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:367
msgctxt "text_id=17911 | speaker=touko"
msgid "　惜しいな青子。わずか二年であれだけの魔術を使えるのなら、あと数年もすれば一流の<射手|しゃしゅ>になっていただろうに」"
msgstr ""

#. Occurrence C_2:377:17912: scene=C_2
#: C_2:377
msgctxt "text_id=17912 | speaker=unknown"
msgid "　橙子は再度指を鳴らす。"
msgstr ""

#. Occurrence C_2:382:17913: scene=C_2
#: C_2:382
msgctxt "text_id=17913 | speaker=unknown"
msgid "　中空に浮かぶ刻印に、さらなる光が灯っていく―――"
msgstr ""

#. Occurrence C_2:425:17914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0001; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:425
msgctxt "text_id=17914 | speaker=aoko"
msgid "“……有珠。アレは何？”"
msgstr ""

#. Occurrence C_2:431:17915: scene=C_2
#: C_2:431
msgctxt "text_id=17915 | speaker=unknown"
msgid "　傍らの有珠の手に触れて、青子は呼びかけた。"
msgstr ""

#. Occurrence C_2:436:17916: scene=C_2
#: C_2:436
msgctxt "text_id=17916 | speaker=unknown"
msgid "　青子は振り返る事さえできない。"
msgstr ""

#. Occurrence C_2:441:17917: scene=C_2
#: C_2:441
msgctxt "text_id=17917 | speaker=unknown"
msgid "　橙子から目を離した瞬間、この戦いが終わる事を肌で感じているからだ。"
msgstr ""

#. Occurrence C_2:468:17918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_0000; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:468
msgctxt "text_id=17918 | speaker=alice"
msgid "「見ての通り、魔術刻印よ。……信じられないけど」"
msgstr ""

#. Occurrence C_2:474:17919: scene=C_2
#: C_2:474
msgctxt "text_id=17919 | speaker=unknown"
msgid "　有珠の声には、驚きと、不快感がこめられていた。"
msgstr ""

#. Occurrence C_2:479:17920: scene=C_2
#: C_2:479
msgctxt "text_id=17920 | speaker=unknown"
msgid "　その気持ちは青子にも理解できる。"
msgstr ""

#. Occurrence C_2:484:17921: scene=C_2
#: C_2:484
msgctxt "text_id=17921 | speaker=unknown"
msgid "　そもそも、魔術刻印とは各々の家系が独特の形で伝える物だ。文字である事から魔道書と同一に思われるが、その実態は大きく異なる。"
msgstr ""

#. Occurrence C_2:530:17922: scene=C_2
#: C_2:530
msgctxt "text_id=17922 | speaker=unknown"
msgid "　魔術には形がない。"
msgstr ""

#. Occurrence C_2:535:17923: scene=C_2
#: C_2:535
msgctxt "text_id=17923 | speaker=unknown"
msgid "　実像がなく、再現性さえ不確かだ。"
msgstr ""

#. Occurrence C_2:544:17924: scene=C_2
#: C_2:544
msgctxt "text_id=17924 | speaker=unknown"
msgid "　ソレを明確な形にしようと、莫大な時間、心血を削る技術をかけたもの―――"
msgstr ""

#. Occurrence C_2:550:17925: scene=C_2
#: C_2:550
msgctxt "text_id=17925 | speaker=unknown"
msgid "一族の悲願と希望の結晶が、各門派の後継者の証、魔術刻印なのである。"
msgstr ""

#. Occurrence C_2:570:17926: scene=C_2
#: C_2:570
msgctxt "text_id=17926 | speaker=unknown"
msgid "　そして、刻印は単体では効果を発揮しない。"
msgstr ""

#. Occurrence C_2:575:17927: scene=C_2
#: C_2:575
msgctxt "text_id=17927 | speaker=unknown"
msgid "　一族の先端にいるモノ。"
msgstr ""

#. Occurrence C_2:580:17928: scene=C_2
#: C_2:580
msgctxt "text_id=17928 | speaker=unknown"
msgid "　刻印を身に宿し、いずれ自身も刻印の一部になる事を覚悟した魔術師がいなければ、そもそも意味を見失う。"
msgstr ""

#. Occurrence C_2:601:17929: scene=C_2
#: C_2:601
msgctxt "text_id=17929 | speaker=unknown"
msgid "　魔道書との最大の違いはそこだ。"
msgstr ""

#. Occurrence C_2:606:17930: scene=C_2
#: C_2:606
msgctxt "text_id=17930 | speaker=unknown"
msgid "　刻印は写本した所で意味はないし、分け与える事もできない。"
msgstr ""

#. Occurrence C_2:611:17931: scene=C_2
#: C_2:611
msgctxt "text_id=17931 | speaker=unknown"
msgid "　故に。"
msgstr ""

#. Occurrence C_2:616:17932: scene=C_2
#: C_2:616
msgctxt "text_id=17932 | speaker=unknown"
msgid "　橙子の背後に出現している刻印が他人の写しだとしても、本来の持ち主にしか<恩恵|おんけい>はないのだが―――"
msgstr ""

#. Occurrence C_2:769:17933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0002; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:769
msgctxt "text_id=17933 | speaker=aoko"
msgid "“でも、たしかに私の魔弾はあの刻印からの魔術で<弾|はじ>かれた。……あれは、もしかすると”"
msgstr ""

#. Occurrence C_2:775:17934: scene=C_2
#: C_2:775
msgctxt "text_id=17934 | speaker=unknown"
msgid "　見えない物を必死に見るように、青子は目を細めて橙子を見つめる。"
msgstr ""

#. Occurrence C_2:780:17935: scene=C_2
#: C_2:780
msgctxt "text_id=17935 | speaker=unknown"
msgid "　刻印をコピーしても意味はない。"
msgstr ""

#. Occurrence C_2:785:17936: scene=C_2
#: C_2:785
msgctxt "text_id=17936 | speaker=unknown"
msgid "　刻印は受け継いだ後継者でなければ発動できない。"
msgstr ""

#. Occurrence C_2:790:17937: scene=C_2
#: C_2:790
msgctxt "text_id=17937 | speaker=unknown"
msgid "　―――なら、それは―――"
msgstr ""

#. Occurrence C_2:875:17938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_9000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:875
msgctxt "text_id=17938 | speaker=aoko"
msgid "「……そう。"
msgstr ""

#. Occurrence C_2:875:17939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_9000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:875
msgctxt "text_id=17939 | speaker=aoko"
msgid "　肌に刻まず中空に浮かべてるのは、そういう事……」"
msgstr ""

#. Occurrence C_2:881:17940: scene=C_2
#: C_2:881
msgctxt "text_id=17940 | speaker=unknown"
msgid "　不快だ、と吐き捨てる青子。"
msgstr ""

#. Occurrence C_2:886:17941: scene=C_2
#: C_2:886
msgctxt "text_id=17941 | speaker=unknown"
msgid "　橙子は理解の早い敵に、満足してうなずいた。"
msgstr ""

#. Occurrence C_2:939:17942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0011; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:939
msgctxt "text_id=17942 | speaker=touko"
msgid "「ああ、この体には合わないのでな、私の背後の空間に固定している。"
msgstr ""

#. Occurrence C_2:946:17943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0012; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:946
msgctxt "text_id=17943 | speaker=touko"
msgid "本当はね、おまえたちのように肉に刻んだほうがいいんだ。魔術の起動が一動作で済むんだから。"
msgstr ""

#. Occurrence C_2:952:17944: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0013; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:952
msgctxt "text_id=17944 | speaker=touko"
msgid "　だが実際に使用するのなら、こうするしかない」"
msgstr ""

#. Occurrence C_2:979:17945: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0014; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:979
msgctxt "text_id=17945 | speaker=touko"
msgid "「起動までの手順は一つ増えるが、なに、マイナスばかりでもない。所詮は他人事なんでね、<痛|・><み|・><は|・><ま|・><っ|・><た|・><く|・><感|・><じ|・><な|・><い|・>」"
msgstr ""

#. Occurrence C_2:999:17946: scene=C_2
#: C_2:999
msgctxt "text_id=17946 | speaker=unknown"
msgid "　それは肉体的なものであり、精神的なものだろう。"
msgstr ""

#. Occurrence C_2:1029:17947: scene=C_2
#: C_2:1029
msgctxt "text_id=17947 | speaker=unknown"
msgid "　青子とて姉の非人間性を知ってはいたが、ここまでのものとは予想していなかった。"
msgstr ""

#. Occurrence C_2:1055:17948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0003; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1055
msgctxt "text_id=17948 | speaker=aoko"
msgid "「……ふん、合うワケないじゃない。他人の魔術刻印を<剥|は>がしてるんだから、血筋の照合からして馴染むはずがないわ。"
msgstr ""

#. Occurrence C_2:1066:17949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0004; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1066
msgctxt "text_id=17949 | speaker=aoko"
msgid "　―――で。"
msgstr ""

#. Occurrence C_2:1073:17950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0005; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1073
msgctxt "text_id=17950 | speaker=aoko"
msgid "奪われた連中は死ぬ事もできず、今もどこかに<幽閉|いかされ>ているワケだ。刻印の持ち主が死んだら起動すらできないものね、それ」"
msgstr ""

#. Occurrence C_2:1150:17951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_0002; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:1150
msgctxt "text_id=17951 | speaker=alice"
msgid "「―――橙子さん、貴女―――」"
msgstr ""

#. Occurrence C_2:1187:17952: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0015; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1187
msgctxt "text_id=17952 | speaker=touko"
msgid "「非難される覚えはないんだが。"
msgstr ""

#. Occurrence C_2:1194:17953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0016; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1194
msgctxt "text_id=17953 | speaker=touko"
msgid "私はかかる火の粉を払っただけだよ。向こうから戦いを挑んできたんだから、戦利品ぐらいは用意してもらわないと。"
msgstr ""

#. Occurrence C_2:1205:17954: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0017; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1205
msgctxt "text_id=17954 | speaker=touko"
msgid "　まあ、中にはつまらない単語を口にした馬鹿者もいるが、それはそれだ。"
msgstr ""

#. Occurrence C_2:1231:17955: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0018; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1231
msgctxt "text_id=17955 | speaker=touko"
msgid "　むしろ優しいと思うけどね。私を殺しに来た連中を、わざわざ生かしてあげてるんだから」"
msgstr ""

#. Occurrence C_2:1260:17956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0006; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1260
msgctxt "text_id=17956 | speaker=aoko"
msgid "「は。その魔術師たちがちゃんと<人|・><間|・><の|・><カ|・><タ|・><チ|・>をしてる事を祈るわ、肉親として」"
msgstr ""

#. Occurrence C_2:1333:17957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0019; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1333
msgctxt "text_id=17957 | speaker=touko"
msgid "「おまえね、私をなんだと思ってるんだ。"
msgstr ""

#. Occurrence C_2:1380:17958: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0020; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1380
msgctxt "text_id=17958 | speaker=touko"
msgid "　脳だけ保存とか、面倒だから百人ひとまとめにした肉塊とか、そんな手抜きなんぞするものか！"
msgstr ""

#. Occurrence C_2:1386:17959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0021; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1386
msgctxt "text_id=17959 | speaker=touko"
msgid "　きちんとカフェを用意して、食事も娯楽も睡眠も自由に提供してるんだぞ？　中には“一生ここで暮らしたい！”なんて騒ぎ立てる莫迦もいるぐらいだ！」"
msgstr ""

#. Occurrence C_2:1469:17960: scene=C_2
#: C_2:1469
msgctxt "text_id=17960 | speaker=unknown"
msgid "　……どこまで信じていいものか微妙な返答だったが、橙子の刻印がコピーではなく本物である事は真実だ。"
msgstr ""

#. Occurrence C_2:1474:17961: scene=C_2
#: C_2:1474
msgctxt "text_id=17961 | speaker=unknown"
msgid "　有珠はますます眉をひそめる。"
msgstr ""

#. Occurrence C_2:1479:17962: scene=C_2
#: C_2:1479
msgctxt "text_id=17962 | speaker=unknown"
msgid "　なぜなら、その行為自体にあまり意味がない。"
msgstr ""

#. Occurrence C_2:1484:17963: scene=C_2
#: C_2:1484
msgctxt "text_id=17963 | speaker=unknown"
msgid "　他者の刻印を奪い、自分用に加工するのはたいへんな手間だったろう。"
msgstr ""

#. Occurrence C_2:1530:17964: scene=C_2
#: C_2:1530
msgctxt "text_id=17964 | speaker=unknown"
msgid "　そんな事をしている時間があるなら、刻印を材料にして模造品を造った方がはるかに効率がいい。"
msgstr ""

#. Occurrence C_2:1535:17965: scene=C_2
#: C_2:1535
msgctxt "text_id=17965 | speaker=unknown"
msgid "　他の魔術師ならいざ知らず、卓越した人形師である橙子なら、刻印を利用してより強力な人形を造れただろう。"
msgstr ""

#. Occurrence C_2:1540:17966: scene=C_2
#: C_2:1540
msgctxt "text_id=17966 | speaker=unknown"
msgid "　刻印の持ち主である魔術師以上の、自分の命令通りに動く人形を。"
msgstr ""

#. Occurrence C_2:1585:17967: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_9000; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:1585
msgctxt "text_id=17967 | speaker=alice"
msgid "「……なんで、そんな事を」"
msgstr ""

#. Occurrence C_2:1607:17968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0007; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1607
msgctxt "text_id=17968 | speaker=aoko"
msgid "「そういう人なのよ、姉貴は。これで行く、と決めたらそれしか目に入らない人なの。過程より結果の人なの。"
msgstr ""

#. Occurrence C_2:1622:17969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0008; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1622
msgctxt "text_id=17969 | speaker=aoko"
msgid "　……ある日の話よ。テレビでピザのＣＭをやっててさ、私たちは唐突にあのデブ<食|しょく>を食べたくなった。"
msgstr ""

#. Occurrence C_2:1629:17970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0009; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1629
msgctxt "text_id=17970 | speaker=aoko"
msgid "でも悲しいかな、一般家庭であるうちにあったのはサラミだけ」"
msgstr ""

#. Occurrence C_2:1657:17971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0010; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1657
msgctxt "text_id=17971 | speaker=aoko"
msgid "「うちの実家、山奥にあるの知ってるでしょ？"
msgstr ""

#. Occurrence C_2:1663:17972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0011; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1663
msgctxt "text_id=17972 | speaker=aoko"
msgid "　町まで行くのに一時間はかかる。中学一年だった私は我慢できなくて町まで行ったけど、ピザ屋なんか一軒もなくてとぼとぼ帰ったの」"
msgstr ""

#. Occurrence C_2:1691:17973: scene=C_2
#: C_2:1691
msgctxt "text_id=17973 | speaker=unknown"
msgid "　田舎町の悲劇だった。"
msgstr ""

#. Occurrence C_2:1696:17974: scene=C_2
#: C_2:1696
msgctxt "text_id=17974 | speaker=unknown"
msgid "　回転寿司がようやくできた三咲町において、ピザ屋の台頭はあと二年待たねばならない。"
msgstr ""

#. Occurrence C_2:1782:17975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0012; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1782
msgctxt "text_id=17975 | speaker=aoko"
msgid "「なのに。"
msgstr ""

#. Occurrence C_2:1789:17976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0013; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1789
msgctxt "text_id=17976 | speaker=aoko"
msgid "骨折り損で家に帰ったら、姉貴のヤツ、おかえりー、とか手を振ってピザ食べてやがったのよ……！"
msgstr ""

#. Occurrence C_2:1795:17977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0014; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1795
msgctxt "text_id=17977 | speaker=aoko"
msgid "　お<煎餅|せんべい>を下地にしてみたわー、とか言って。"
msgstr ""

#. Occurrence C_2:1801:17978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0015; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1801
msgctxt "text_id=17978 | speaker=aoko"
msgid "　外みたら鶏三羽と牛一頭まるまる消えてて、ああ、この女には等価交換とか手間とかお金の問題とか、そういうの一切頭にないんだって思い知らされたわ！」"
msgstr ""

#. Occurrence C_2:1848:17979: scene=C_2
#: C_2:1848
msgctxt "text_id=17979 | speaker=unknown"
msgid "　それはそれで凄い事だと思う有珠であった。"
msgstr ""

#. Occurrence C_2:1921:17980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0016; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1921
msgctxt "text_id=17980 | speaker=aoko"
msgid "「そんな無茶な奴だから、ガンド撃ちで目に見える傷跡を出そうなんて、平気で考えるのよね。"
msgstr ""

#. Occurrence C_2:1927:17981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0017; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1927
msgctxt "text_id=17981 | speaker=aoko"
msgid "　あんなの、ゲマトリア一節分の詠唱で同じ効果を出せるのに、あくまで呪術にこだわるから空も飛べない人形になるのよ、バカ姉貴っ！」"
msgstr ""

#. Occurrence C_2:1980:17982: scene=C_2
#: C_2:1980
msgctxt "text_id=17982 | speaker=unknown"
msgid "　自分そっくりに造られた人形を思いだし、ここぞとばかりに怒鳴る青子。"
msgstr ""

#. Occurrence C_2:1985:17983: scene=C_2
#: C_2:1985
msgctxt "text_id=17983 | speaker=unknown"
msgid "　今にして思えば、あれは彼女への痛烈な嫌味だったからだ。"
msgstr ""

#. Occurrence C_2:2004:17984: scene=C_2
#: C_2:2004
msgctxt "text_id=17984 | speaker=unknown"
msgid "　青子の<罵倒|ばとう>に、橙子の細い眉が微かに動く。"
msgstr ""

#. Occurrence C_2:2009:17985: scene=C_2
#: C_2:2009
msgctxt "text_id=17985 | speaker=unknown"
msgid "　今まで表情のなかった橙子だが、自慢の人形をけなされて気分をいたく害したらしい。"
msgstr ""

#. Occurrence C_2:2044:17986: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0023; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2044
msgctxt "text_id=17986 | speaker=touko"
msgid "「……その人形に追い詰められたのはおまえだったね。"
msgstr ""

#. Occurrence C_2:2050:17987: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0024; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2050
msgctxt "text_id=17987 | speaker=touko"
msgid "　それと、数<値変換|ゲマトリア>式はカバラの秘術だ。私はルーン専門だから、おまえのように広く浅く知識を広める気はないよ。"
msgstr ""

#. Occurrence C_2:2088:17988: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0025; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2088
msgctxt "text_id=17988 | speaker=touko"
msgid "　―――まあ、もっとも。"
msgstr ""

#. Occurrence C_2:2095:17989: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0026; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2095
msgctxt "text_id=17989 | speaker=touko"
msgid "この刻印の所有者の一人から、ケルトの結界を教わりはしたがね」"
msgstr ""

#. Occurrence C_2:2115:17990: scene=C_2
#: C_2:2115
msgctxt "text_id=17990 | speaker=unknown"
msgid "　橙子は左後方の刻印に視線を向ける。"
msgstr ""

#. Occurrence C_2:2120:17991: scene=C_2
#: C_2:2120
msgctxt "text_id=17991 | speaker=unknown"
msgid "　こうしている今も光り輝いている刻印。"
msgstr ""

#. Occurrence C_2:2125:17992: scene=C_2
#: C_2:2125
msgctxt "text_id=17992 | speaker=unknown"
msgid "　それは、たえず何らかの魔術を行使している証だ。"
msgstr ""

#. Occurrence C_2:2184:17993: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0027; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2184
msgctxt "text_id=17993 | speaker=touko"
msgid "「これは『城』で祖父を封じこめるのに使っていてね。"
msgstr ""

#. Occurrence C_2:2190:17994: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0028; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2190
msgctxt "text_id=17994 | speaker=touko"
msgid "　半人半妖のドルイド僧を閉じこめた塔……とまではいかないが―――そうだな、私では郵便ポストぐらいの大きさが限界か。"
msgstr ""

#. Occurrence C_2:2202:17995: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0029; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2202
msgctxt "text_id=17995 | speaker=touko"
msgid "　ほら、むかし<青子|おまえ>が壊した赤いポスト。ちょうどあれぐらいの可愛い鳥小屋だよ。"
msgstr ""

#. Occurrence C_2:2209:17996: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0030; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2209
msgctxt "text_id=17996 | speaker=touko"
msgid "人間ひとり分を仕舞うには窮屈だろうが、祖父は肉体というより霊体に近い。見様によっては、そっちの方が相応しいかもしれないね」"
msgstr ""

#. Occurrence C_2:2234:17997: scene=C_2
#: C_2:2234
msgctxt "text_id=17997 | speaker=unknown"
msgid "　<陰鬱|いんうつ>な笑いをかみ殺しながら、橙子は淡々と説明する。"
msgstr ""

#. Occurrence C_2:2239:17998: scene=C_2
#: C_2:2239
msgctxt "text_id=17998 | speaker=unknown"
msgid "　常に冷静な彼女だが、祖父に対しては感情を<抑|おさ>えきれないらしい。"
msgstr ""

#. Occurrence C_2:2273:17999: scene=C_2
#: C_2:2273
msgctxt "text_id=17999 | speaker=unknown"
msgid "　それが<鬱積|うっせき>した憎悪である事は、彼女の笑みを見れば明らかだった。"
msgstr ""

#. Occurrence C_2:2294:18000: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0031; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2294
msgctxt "text_id=18000 | speaker=touko"
msgid "「そういった訳でね、先の青子の魔術を防いだので、この刻印もしばらくは使用不能なんだ。"
msgstr ""

#. Occurrence C_2:2332:18001: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0032; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2332
msgctxt "text_id=18001 | speaker=touko"
msgid "　今のが本当の魔法だったなら、わずか三行の刻印では打ち消せなかっただろうに。青子。おまえは<僅差|きんさ>で負けたんだ。恥じる事はないよ。"
msgstr ""

#. Occurrence C_2:2344:18002: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0033; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2344
msgctxt "text_id=18002 | speaker=touko"
msgid "　じゃあそろそろ終わりにしよう。"
msgstr ""

#. Occurrence C_2:2350:18003: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0034; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2350
msgctxt "text_id=18003 | speaker=touko"
msgid "　抵抗をするのは自由だが、ベオ相手にそれは辛いぞ」"
msgstr ""

#. Occurrence C_2:2411:18004: scene=C_2
#: C_2:2411
msgctxt "text_id=18004 | speaker=unknown"
msgid "　ぱちん、と橙子の左手が鳴る。"
msgstr ""

#. Occurrence C_2:2416:18005: scene=C_2
#: C_2:2416
msgctxt "text_id=18005 | speaker=unknown"
msgid "　旧校舎に<潜|ひそ>む黄金の人狼。"
msgstr ""

#. Occurrence C_2:2421:18006: scene=C_2
#: C_2:2421
msgctxt "text_id=18006 | speaker=unknown"
msgid "　彼を呼び出す合図は、森に<木霊|こだま>するように長く響いた。"
msgstr ""

#. Occurrence C_2:2426:18007: scene=C_2
#: C_2:2426
msgctxt "text_id=18007 | speaker=unknown"
msgid "　その残響が消えるより早く、青子は背後にいる有珠へ叫ぶ。"
msgstr ""

#. Occurrence C_3:39:18008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0000; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:39
msgctxt "text_id=18008 | speaker=aoko"
msgid "「行って、有珠！」"
msgstr ""

#. Occurrence C_3:84:18009: scene=C_3
#: C_3:84
msgctxt "text_id=18009 | speaker=unknown"
msgid "　<叱咤|しった>に近い指示に、有珠は無言で従った。"
msgstr ""

#. Occurrence C_3:89:18010: scene=C_3
#: C_3:89
msgctxt "text_id=18010 | speaker=unknown"
msgid "　橙子と対峙する青子を残し、有珠はためらう事なく森へと<踵|きびす>を返す。"
msgstr ""

#. Occurrence C_3:109:18011: scene=C_3
#: C_3:109
msgctxt "text_id=18011 | speaker=unknown"
msgid "　……敗北が決定的になった以上、ふたり一緒に殺される愚だけは犯せない。"
msgstr ""

#. Occurrence C_3:114:18012: scene=C_3
#: C_3:114
msgctxt "text_id=18012 | speaker=unknown"
msgid "　どちらかが生き延びれば三度目の正直もある。"
msgstr ""

#. Occurrence C_3:119:18013: scene=C_3
#: C_3:119
msgctxt "text_id=18013 | speaker=unknown"
msgid "　その為に犠牲になるのは自分の役割だと青子は判断したのだ。"
msgstr ""

#. Occurrence C_3:180:18014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0001; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:180
msgctxt "text_id=18014 | speaker=aoko"
msgid "『……橙子自身の切札も分かったし、有珠が本調子になれば勝てない相手じゃないものね……』"
msgstr ""

#. Occurrence C_3:188:18015: scene=C_3
#: C_3:188
msgctxt "text_id=18015 | speaker=unknown"
msgid "　走り去る有珠の足音を聞きながら、青子は少しだけ残念そうに呟いた。"
msgstr ""

#. Occurrence C_3:193:18016: scene=C_3
#: C_3:193
msgctxt "text_id=18016 | speaker=unknown"
msgid "　……惜しいのは自分の死ではなく、有珠が橙子を打ち負かす瞬間が見られない事だけ。"
msgstr ""

#. Occurrence C_3:198:18017: scene=C_3
#: C_3:198
msgctxt "text_id=18017 | speaker=unknown"
msgid "　それ以外に何を無念に思う事があるだろうか。"
msgstr ""

#. Occurrence C_3:218:18018: scene=C_3
#: C_3:218
msgctxt "text_id=18018 | speaker=unknown"
msgid "　有珠が森へと消えていく。"
msgstr ""

#. Occurrence C_3:223:18019: scene=C_3
#: C_3:223
msgctxt "text_id=18019 | speaker=unknown"
msgid "　それを背中で感じながら、青子は橙子を睨み続ける。"
msgstr ""

#. Occurrence C_3:254:18020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0002; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:254
msgctxt "text_id=18020 | speaker=aoko"
msgid "「……いつまで焦らす気？"
msgstr ""

#. Occurrence C_3:254:18021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0002; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:254
msgctxt "text_id=18021 | speaker=aoko"
msgid "　私、待たされるのは好きじゃないんだけど」"
msgstr ""

#. Occurrence C_3:272:18022: scene=C_3
#: C_3:272
msgctxt "text_id=18022 | speaker=unknown"
msgid "　合図はされたものの、人狼の姿はない。"
msgstr ""

#. Occurrence C_3:277:18023: scene=C_3
#: C_3:277
msgctxt "text_id=18023 | speaker=unknown"
msgid "　あの怪物なら一分とかからず、旧校舎から飛んでくるだろうに、と。"
msgstr ""

#. Occurrence C_3:298:18024: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0000; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:298
msgctxt "text_id=18024 | speaker=touko"
msgid "「そう急くな。いま赤ずきんを追っているところだ。"
msgstr ""

#. Occurrence C_3:304:18025: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0001; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:304
msgctxt "text_id=18025 | speaker=touko"
msgid "　黒帽子の彼女をそう喩えるのは、やや無理があるがね」"
msgstr ""

#. Occurrence C_3:348:18026: scene=C_3
#: C_3:348
msgctxt "text_id=18026 | speaker=unknown"
msgid "　皮肉げに響く橙子の声。"
msgstr ""

#. Occurrence C_3:375:18027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0003; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:375
msgctxt "text_id=18027 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_3:380:18028: scene=C_3
#: C_3:380
msgctxt "text_id=18028 | speaker=unknown"
msgid "　校庭で流れる、関わりのない放送みたいだ。"
msgstr ""

#. Occurrence C_3:400:18029: scene=C_3
#: C_3:400
msgctxt "text_id=18029 | speaker=unknown"
msgid "　青子は呆然と立ちつくす。"
msgstr ""

#. Occurrence C_3:419:18030: scene=C_3
#: C_3:419
msgctxt "text_id=18030 | speaker=unknown"
msgid "　今の橙子の言葉を、青子は<忘我|ぼうが>する事で、現実ではないと聞き流し―――"
msgstr ""

#. Occurrence C_3:473:18031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0004; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:473
msgctxt "text_id=18031 | speaker=aoko"
msgid "「有珠―――！」"
msgstr ""

#. Occurrence C_3:479:18032: scene=C_3
#: C_3:479
msgctxt "text_id=18032 | speaker=unknown"
msgid "　誤魔化しきれるはずもなく、青子は背後を振り返った。"
msgstr ""

#. Occurrence C_3:484:18033: scene=C_3
#: C_3:484
msgctxt "text_id=18033 | speaker=unknown"
msgid "　……夜の森は白雪のおかげで、月明かりだけでも十分に遠くを見通せた。"
msgstr ""

#. Occurrence C_3:489:18034: scene=C_3
#: C_3:489
msgctxt "text_id=18034 | speaker=unknown"
msgid "　その真白い闇の中から、ひとりの少年が歩いてくるのが見てとれる。"
msgstr ""

#. Occurrence C_3:542:18035: scene=C_3
#: C_3:542
msgctxt "text_id=18035 | speaker=unknown"
msgid "　青子の胸より背の低い少年は、自分より大きな<有珠|ひとかげ>を肩にかけて歩いていた。"
msgstr ""

#. Occurrence C_3:547:18036: scene=C_3
#: C_3:547
msgctxt "text_id=18036 | speaker=unknown"
msgid "　少年は無造作に有珠の体を投げ捨てる。"
msgstr ""

#. Occurrence C_3:601:18037: scene=C_3
#: C_3:601
msgctxt "text_id=18037 | speaker=unknown"
msgid "　放られた有珠は、数メートルもの放物線を描いて、青子の目前に落下する。"
msgstr ""

#. Occurrence C_3:606:18038: scene=C_3
#: C_3:606
msgctxt "text_id=18038 | speaker=unknown"
msgid "　頭から。ごきりと、首の骨を折るように。"
msgstr ""

#. Occurrence C_3:749:18039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0005; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:749
msgctxt "text_id=18039 | speaker=aoko"
msgid "「―――っ！」"
msgstr ""

#. Occurrence C_3:755:18040: scene=C_3
#: C_3:755
msgctxt "text_id=18040 | speaker=unknown"
msgid "　やめたほうがいいのに、と思いつつ青子は有珠を受けとめた。"
msgstr ""

#. Occurrence C_3:760:18041: scene=C_3
#: C_3:760
msgctxt "text_id=18041 | speaker=unknown"
msgid "　有珠の軽い体が何倍にもなって両腕にのし掛かる。"
msgstr ""

#. Occurrence C_3:781:18042: scene=C_3
#: C_3:781
msgctxt "text_id=18042 | speaker=unknown"
msgid "　……縫合したばかりの傷が、容赦なく開いていく。"
msgstr ""

#. Occurrence C_3:786:18043: scene=C_3
#: C_3:786
msgctxt "text_id=18043 | speaker=unknown"
msgid "　受けとめた両腕が赤い。"
msgstr ""

#. Occurrence C_3:791:18044: scene=C_3
#: C_3:791
msgctxt "text_id=18044 | speaker=unknown"
msgid "　ぬらりとした血の感触と激痛に、青子は歯を食いしばって耐えた。"
msgstr ""

#. Occurrence C_3:847:18045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0006; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:847
msgctxt "text_id=18045 | speaker=aoko"
msgid "「有珠、無事……？」"
msgstr ""

#. Occurrence C_3:853:18046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_3_0000; voice_prefix=A40; voice_category=2; scene=C_3
#: C_3:853
msgctxt "text_id=18046 | speaker=alice"
msgid "「……………………」"
msgstr ""

#. Occurrence C_3:859:18047: scene=C_3
#: C_3:859
msgctxt "text_id=18047 | speaker=unknown"
msgid "　返事はないものの、意識はあるようだ。"
msgstr ""

#. Occurrence C_3:864:18048: scene=C_3
#: C_3:864
msgctxt "text_id=18048 | speaker=unknown"
msgid "　有珠は森に入ったところで人狼の奇襲を受けたのだろう。"
msgstr ""

#. Occurrence C_3:869:18049: scene=C_3
#: C_3:869
msgctxt "text_id=18049 | speaker=unknown"
msgid "　昨夜、狼に切り裂かれた腹部は、青子と同じように血で<滲|にじ>んでいた。"
msgstr ""

#. Occurrence C_3:890:18050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0007; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:890
msgctxt "text_id=18050 | speaker=aoko"
msgid "「……はじめから、森に<潜|ひそ>ませていたとはね」"
msgstr ""

#. Occurrence C_3:930:18051: scene=C_3
#: C_3:930
msgctxt "text_id=18051 | speaker=unknown"
msgid "　チ、と自分の浅はかさを呪いながら、有珠の体をそっと下ろす。"
msgstr ""

#. Occurrence C_3:935:18052: scene=C_3
#: C_3:935
msgctxt "text_id=18052 | speaker=unknown"
msgid "　青子の視線は目前の敵―――金髪の少年に向けられている。"
msgstr ""

#. Occurrence C_3:978:18053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0008; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:978
msgctxt "text_id=18053 | speaker=aoko"
msgid "「つまり、あれよね。"
msgstr ""

#. Occurrence C_3:984:18054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0009; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:984
msgctxt "text_id=18054 | speaker=aoko"
msgid "　甘く見ていたフリで、初めから、余裕なかったんだ」"
msgstr ""

#. Occurrence C_3:1047:18055: scene=C_3
#: C_3:1047
msgctxt "text_id=18055 | speaker=unknown"
msgid "　青子の怒気を受けても、少年はうす笑いを崩さない。"
msgstr ""

#. Occurrence C_3:1052:18056: scene=C_3
#: C_3:1052
msgctxt "text_id=18056 | speaker=unknown"
msgid "　少女たちを見つめる瞳は<爛|らん>と輝き、明らかに、この後の惨劇を待ち焦がれている風だ。"
msgstr ""

#. Occurrence C_3:1057:18057: scene=C_3
#: C_3:1057
msgctxt "text_id=18057 | speaker=unknown"
msgid "　夜目にも鮮やかな金髪とグリーンの瞳、"
msgstr ""

#. Occurrence C_3:1062:18058: scene=C_3
#: C_3:1062
msgctxt "text_id=18058 | speaker=unknown"
msgid "　少年というよりは少女に見える顔立ちも、"
msgstr ""

#. Occurrence C_3:1068:18059: scene=C_3
#: C_3:1068
msgctxt "text_id=18059 | speaker=unknown"
msgid "今はそういうカタチをしただけの、違う星の生き物としか思えない―――"
msgstr ""

#. Occurrence C_3:1134:18060: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0002; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:1134
msgctxt "text_id=18060 | speaker=touko"
msgid "「ベオ。今日は喰っていいぞ」"
msgstr ""

#. Occurrence C_3:1140:18061: scene=C_3
#: C_3:1140
msgctxt "text_id=18061 | speaker=unknown"
msgid "　遠くから響く、橙子の短い声。"
msgstr ""

#. Occurrence C_3:1145:18062: scene=C_3
#: C_3:1145
msgctxt "text_id=18062 | speaker=unknown"
msgid "　少年は小さく笑ったように見えた。"
msgstr ""

#. Occurrence C_3:1150:18063: scene=C_3
#: C_3:1150
msgctxt "text_id=18063 | speaker=unknown"
msgid "　けれど、まさか。"
msgstr ""

#. Occurrence C_3:1253:18064: scene=C_3
#: C_3:1253
msgctxt "text_id=18064 | speaker=unknown"
msgid "　そこで青子が<自|・><分|・>から少年に走り出すなど、誰に予想できただろうか。"
msgstr ""

#. Occurrence C_3:1313:18065: scene=C_3
#: C_3:1313
msgctxt "text_id=18065 | speaker=unknown"
msgid "　足跡だけの駒鳥より早く、両手から赤い血を地面にこぼしながら、青子は少年へと疾走する。"
msgstr ""

#. Occurrence C_3:1318:18066: scene=C_3
#: C_3:1318
msgctxt "text_id=18066 | speaker=unknown"
msgid "　橙子は予想外の展開に目を見張り、"
msgstr ""

#. Occurrence C_3:1323:18067: scene=C_3
#: C_3:1323
msgctxt "text_id=18067 | speaker=unknown"
msgid "　地面に寝かされた有珠は<虚|うつ>ろな目で見守る事しかできない。"
msgstr ""

#. Occurrence C_3:1328:18068: scene=C_3
#: C_3:1328
msgctxt "text_id=18068 | speaker=unknown"
msgid "　人狼の少年とて、今まで獲物としか思っていなかった<雌鹿|めじか>の反撃に意表を突かれていた。"
msgstr ""

#. Occurrence C_3:1448:18069: scene=C_3
#: C_3:1448
msgctxt "text_id=18069 | speaker=unknown"
msgid "　六メートルもの間合いを一気に詰めて、青子は片足で雪原をダン、と踏み付けた。"
msgstr ""

#. Occurrence C_3:1453:18070: scene=C_3
#: C_3:1453
msgctxt "text_id=18070 | speaker=unknown"
msgid "　停止と回転軸を兼ねた踏みこみ。"
msgstr ""

#. Occurrence C_3:1458:18071: scene=C_3
#: C_3:1458
msgctxt "text_id=18071 | speaker=unknown"
msgid "　攻撃意図を瞬時に悟るも、少年の跳び退きは間に合わない。"
msgstr ""

#. Occurrence C_3:1536:18072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0010; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:1536
msgctxt "text_id=18072 | speaker=aoko"
msgid "「―――首！」"
msgstr ""

#. Occurrence C_3:1542:18073: scene=C_3
#: C_3:1542
msgctxt "text_id=18073 | speaker=unknown"
msgid "　片足が、走った勢いもそのままに跳ね上がる。"
msgstr ""

#. Occurrence C_3:1547:18074: scene=C_3
#: C_3:1547
msgctxt "text_id=18074 | speaker=unknown"
msgid "　少年の首を狙った回し蹴りは弧を描いて、この上ないタイミングで少年の<延髄|えんずい>に<炸裂|さくれつ>した。"
msgstr ""

#. Occurrence C_3:1624:18075: scene=C_3
#: C_3:1624
msgctxt "text_id=18075 | speaker=unknown"
msgid "　魔力によって強化された白兵術式。"
msgstr ""

#. Occurrence C_3:1629:18076: scene=C_3
#: C_3:1629
msgctxt "text_id=18076 | speaker=unknown"
msgid "　人形との戦いでコツを掴んだ青子の、この森の痩せた木なら<粉砕|ふんさい>しかねない、強烈な一撃だった。"
msgstr ""

#. Occurrence C_3:1678:18077: scene=C_3
#: C_3:1678
msgctxt "text_id=18077 | speaker=unknown"
msgid "　少年は動かない。"
msgstr ""

#. Occurrence C_3:1683:18078: scene=C_3
#: C_3:1683
msgctxt "text_id=18078 | speaker=unknown"
msgid "　そして青子も、右足を首に直撃させたまま止まっていた。"
msgstr ""

#. Occurrence C_3:1724:18079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0011; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:1724
msgctxt "text_id=18079 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence C_3:1730:18080: scene=C_3
#: C_3:1730
msgctxt "text_id=18080 | speaker=unknown"
msgid "　首筋が、<戦慄|せんりつ>で凍りついている。"
msgstr ""

#. Occurrence C_3:1735:18081: scene=C_3
#: C_3:1735
msgctxt "text_id=18081 | speaker=unknown"
msgid "　あの人形を破壊したのと同等の手応え。"
msgstr ""

#. Occurrence C_3:1740:18082: scene=C_3
#: C_3:1740
msgctxt "text_id=18082 | speaker=unknown"
msgid "　倒せないまでも、首の骨にダメージを与えた筈だ。"
msgstr ""

#. Occurrence C_3:1747:18083: scene=C_3
#: C_3:1747
msgctxt "text_id=18083 | speaker=unknown"
msgid "　そう確信した青子の思い上がりを正すように、少年は眉すら動かさず、目前の青子を見つめていた。"
msgstr ""

#. Occurrence C_3:1782:18084: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0000; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1782
msgctxt "text_id=18084 | speaker=beo"
msgid "「……ふーん。お姉さんの右足は、たしか噛み切った方だ。"
msgstr ""

#. Occurrence C_3:1788:18085: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0001; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1788
msgctxt "text_id=18085 | speaker=beo"
msgid "　それで首を狙ったのは、すごいよね。女の人は本能的に自分の体を<庇|かば>うものだって、トーコさんは言ってたのに。"
msgstr ""

#. Occurrence C_3:1794:18086: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0002; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1794
msgctxt "text_id=18086 | speaker=beo"
msgid "　けど残念、せっかくの勇気も無駄でした。ボクの体毛の質は、<こ|・><の|・><姿|・>でも変わらない。うぶ毛だけでも、お姉さんの蹴りを受けとめる事はできる」"
msgstr ""

#. Occurrence C_3:1814:18087: scene=C_3
#: C_3:1814
msgctxt "text_id=18087 | speaker=unknown"
msgid "　痛みがあるのは青子の方だけ。"
msgstr ""

#. Occurrence C_3:1819:18088: scene=C_3
#: C_3:1819
msgctxt "text_id=18088 | speaker=unknown"
msgid "　延髄を蹴った足の<脛|すね>は、まるで斧で切り落とされたように、感覚というものがない―――"
msgstr ""

#. Occurrence C_3:1840:18089: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0003; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1840
msgctxt "text_id=18089 | speaker=beo"
msgid "「それに、少しだけ迷いがあったな。くっつけたばっかりの足だから庇ったでしょ？"
msgstr ""

#. Occurrence C_3:1847:18090: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0004; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1847
msgctxt "text_id=18090 | speaker=beo"
msgid "　人間がボクの相手をするなら、そんなこと気にしちゃいけないのに。"
msgstr ""

#. Occurrence C_3:1853:18091: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0005; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1853
msgctxt "text_id=18091 | speaker=beo"
msgid "　ああ、でも―――」"
msgstr ""

#. Occurrence C_3:1859:18092: scene=C_3
#: C_3:1859
msgctxt "text_id=18092 | speaker=unknown"
msgid "　青子の驚愕を浴びながら少年は笑う。"
msgstr ""

#. Occurrence C_3:1864:18093: scene=C_3
#: C_3:1864
msgctxt "text_id=18093 | speaker=unknown"
msgid "　足は戻せない。"
msgstr ""

#. Occurrence C_3:1870:18094: scene=C_3
#: C_3:1870
msgctxt "text_id=18094 | speaker=unknown"
msgid "たぶん地面に下ろした瞬間、自分が腹から裂かれると青子は予測してしまい―――"
msgstr ""

#. Occurrence C_3:1913:18095: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0006; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1913
msgctxt "text_id=18095 | speaker=beo"
msgid "「どっちにしろミンチだから、気にしても仕方がないよね？」"
msgstr ""

#. Occurrence C_3:1942:18096: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0007; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1942
msgctxt "text_id=18096 | speaker=beo"
msgid "「ほら、もったいない。せっかく治ったばかりなのに」"
msgstr ""

#. Occurrence C_3:1955:18097: scene=C_3
#: C_3:1955
msgctxt "text_id=18097 | speaker=unknown"
msgid "　少年の指らしきものが、右足に食いこんだ事が、青子にはよく判らなかった。"
msgstr ""

#. Occurrence C_3:1975:18098: scene=C_3
#: C_3:1975
msgctxt "text_id=18098 | speaker=unknown"
msgid "　もともと少年の言うとおり、右足には感覚なんてほとんどなかったのだ。"
msgstr ""

#. Occurrence C_3:1980:18099: scene=C_3
#: C_3:1980
msgctxt "text_id=18099 | speaker=unknown"
msgid "　今の一撃で完全に麻痺した足は、またも<凄惨|せいさん>な運命を繰り返したらしい。"
msgstr ""

#. Occurrence C_3:2027:18100: scene=C_3
#: C_3:2027
msgctxt "text_id=18100 | speaker=unknown"
msgid "　……ただ、今回は千切られる事なく、骨まで握られた。"
msgstr ""

#. Occurrence C_3:2032:18101: scene=C_3
#: C_3:2032
msgctxt "text_id=18101 | speaker=unknown"
msgid "　感覚はないけれど、<夥|おびただ>しい血の量と、<無惨|むざん>にやせこけた自分の足の<醜|みにく>さが、目に痛い。"
msgstr ""

#. Occurrence C_3:2037:18102: scene=C_3
#: C_3:2037
msgctxt "text_id=18102 | speaker=unknown"
msgid "　普通なら出血量だけでショック死。"
msgstr ""

#. Occurrence C_3:2084:18103: scene=C_3
#: C_3:2084
msgctxt "text_id=18103 | speaker=unknown"
msgid "　魔術刻印というものは、こういう時に残酷よね、と他人事のように青子は思う。"
msgstr ""

#. Occurrence C_3:2138:18104: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0008; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:2138
msgctxt "text_id=18104 | speaker=beo"
msgid "「あれ？　まだ目が死んでない。"
msgstr ""

#. Occurrence C_3:2157:18105: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0009; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:2157
msgctxt "text_id=18105 | speaker=beo"
msgid "　……あんまり苦しめたくないんだけど。ガンジョウなのも考え物だよ、お姉さん」"
msgstr ""

#. Occurrence C_3:2163:18106: scene=C_3
#: C_3:2163
msgctxt "text_id=18106 | speaker=unknown"
msgid "　少年の手が、青子の胸に<放|はな>たれる。"
msgstr ""

#. Occurrence C_3:2185:18107: scene=C_3
#: C_3:2185
msgctxt "text_id=18107 | speaker=unknown"
msgid "　胸の中心に刺さった<杭|くい>―――いや、少年の拳の痛みに、青子の意識が消えかかる。"
msgstr ""

#. Occurrence C_3:2255:18108: scene=C_3
#: C_3:2255
msgctxt "text_id=18108 | speaker=unknown"
msgid "　……飛んでいる。"
msgstr ""

#. Occurrence C_3:2260:18109: scene=C_3
#: C_3:2260
msgctxt "text_id=18109 | speaker=unknown"
msgid "　中身のない空気人形のように、自分の体が飛んでいるのが分かる。"
msgstr ""

#. Occurrence C_3:2265:18110: scene=C_3
#: C_3:2265
msgctxt "text_id=18110 | speaker=unknown"
msgid "　先ほどの有珠と同じように大きく空中に放られて、青子は背中から地面に落ちた。"
msgstr ""

#. Occurrence C_3:2393:18111: scene=C_3
#: C_3:2393
msgctxt "text_id=18111 | speaker=unknown"
msgid "　潰された右足と、胸に残る拳の衝撃。"
msgstr ""

#. Occurrence C_3:2399:18112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0012; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2399
msgctxt "text_id=18112 | speaker=aoko"
msgid "「っ―――、…………！」"
msgstr ""

#. Occurrence C_3:2404:18113: scene=C_3
#: C_3:2404
msgctxt "text_id=18113 | speaker=unknown"
msgid "　満足な呼吸はできず、心臓をえぐり取られたとしか思えない痛みに、視界が点滅する。"
msgstr ""

#. Occurrence C_3:2409:18114: scene=C_3
#: C_3:2409
msgctxt "text_id=18114 | speaker=unknown"
msgid "　目から火が出るとはこういう事か。"
msgstr ""

#. Occurrence C_3:2422:18115: scene=C_3
#: C_3:2422
msgctxt "text_id=18115 | speaker=unknown"
msgid "　恐ろしいのは痛みがまったく<薄|うす>れないこと。"
msgstr ""

#. Occurrence C_3:2427:18116: scene=C_3
#: C_3:2427
msgctxt "text_id=18116 | speaker=unknown"
msgid "　無惨にあえぐ青子の胸には、いまも拳大の、杭の感覚が残っている―――"
msgstr ""

#. Occurrence C_3:2502:18117: scene=C_3
#: C_3:2502
msgctxt "text_id=18117 | speaker=unknown"
msgid "　……少年はゆっくりと、雪原に殴り飛ばされた青子に近寄っていく。"
msgstr ""

#. Occurrence C_3:2507:18118: scene=C_3
#: C_3:2507
msgctxt "text_id=18118 | speaker=unknown"
msgid "　唇を舐める赤い舌。"
msgstr ""

#. Occurrence C_3:2512:18119: scene=C_3
#: C_3:2512
msgctxt "text_id=18119 | speaker=unknown"
msgid "　喜びに<濁|にご>った目が、呼吸すら精一杯の<獲物|あおこ>を見つめている。"
msgstr ""

#. Occurrence C_3:2572:18120: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0013; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2572
msgctxt "text_id=18120 | speaker=aoko"
msgid "“―――、―――…………”"
msgstr ""

#. Occurrence C_3:2578:18121: scene=C_3
#: C_3:2578
msgctxt "text_id=18121 | speaker=unknown"
msgid "　もう、ここで意識を失ってしまおうか、なんて甘さを青子はかみ砕く。"
msgstr ""

#. Occurrence C_3:2583:18122: scene=C_3
#: C_3:2583
msgctxt "text_id=18122 | speaker=unknown"
msgid "　……けれど、頑張ってどうなるのか。"
msgstr ""

#. Occurrence C_3:2588:18123: scene=C_3
#: C_3:2588
msgctxt "text_id=18123 | speaker=unknown"
msgid "　落下した背中は雪に助けられたが、拳を受けた胸の<陥没|かんぼつ>と、潰された右足が、容赦なく生命を奪っていく。"
msgstr ""

#. Occurrence C_3:2643:18124: scene=C_3
#: C_3:2643
msgctxt "text_id=18124 | speaker=unknown"
msgid "　自分がスクラップみたいに壊れてしまったと分かるのに、"
msgstr ""

#. Occurrence C_3:2648:18125: scene=C_3
#: C_3:2648
msgctxt "text_id=18125 | speaker=unknown"
msgid "　どうして今も、必死に痺れた心臓を蘇生させようと、魔術刻印を回しているのか。"
msgstr ""

#. Occurrence C_3:2762:18126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0014; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2762
msgctxt "text_id=18126 | speaker=aoko"
msgid "“―――ぁ…………、れは”"
msgstr ""

#. Occurrence C_3:2844:18127: scene=C_3
#: C_3:2844
msgctxt "text_id=18127 | speaker=unknown"
msgid "　絶望的な状況で青子の意識を繋ぎ止めていたのは、遠くで<佇|たたず>む橙子の姿だった。"
msgstr ""

#. Occurrence C_3:2864:18128: scene=C_3
#: C_3:2864
msgctxt "text_id=18128 | speaker=unknown"
msgid "　……橙子は、たしかに驚いている。"
msgstr ""

#. Occurrence C_3:2869:18129: scene=C_3
#: C_3:2869
msgctxt "text_id=18129 | speaker=unknown"
msgid "　何か意外な物を見たような、彼女らしからぬ思考停止。"
msgstr ""

#. Occurrence C_3:2874:18130: scene=C_3
#: C_3:2874
msgctxt "text_id=18130 | speaker=unknown"
msgid "　それが何であるかが気になって、青子はいまだ意識を保っていた。"
msgstr ""

#. Occurrence C_3:2910:18131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0015; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2910
msgctxt "text_id=18131 | speaker=aoko"
msgid "“…………な、に？”"
msgstr ""

#. Occurrence C_3:2929:18132: scene=C_3
#: C_3:2929
msgctxt "text_id=18132 | speaker=unknown"
msgid "　沈みかける顔を起こして、橙子の視線の先を見る。"
msgstr ""

#. Occurrence C_3:2934:18133: scene=C_3
#: C_3:2934
msgctxt "text_id=18133 | speaker=unknown"
msgid "　いったい、この絶対的な勝利の状況で、あの女を驚かせる物とは何なのだろう、と。"
msgstr ""

#. Occurrence C_4:87:18134: scene=C_4
#: C_4:87
msgctxt "text_id=18134 | speaker=unknown"
msgid "　胸の<鼓動|おと>が平常時より高い。"
msgstr ""

#. Occurrence C_4:93:18135: scene=C_4
#: C_4:93
msgctxt "text_id=18135 | speaker=unknown"
msgid "　<千々|ちぢ>に乱れていく思考を、彼は慎重に抑えつける。"
msgstr ""

#. Occurrence C_4:128:18136: scene=C_4
#: C_4:128
msgctxt "text_id=18136 | speaker=unknown"
msgid "　心を弱める雑念。"
msgstr ""

#. Occurrence C_4:133:18137: scene=C_4
#: C_4:133
msgctxt "text_id=18137 | speaker=unknown"
msgid "　寄り道でしかない不要な意識を、できるだけ見えない<左脳|ところ>に整理する。"
msgstr ""

#. Occurrence C_4:182:18138: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_4_0000; voice_prefix=A30; voice_category=3; scene=C_4
#: C_4:182
msgctxt "text_id=18138 | speaker=soujuurou"
msgid "「―――――――――」"
msgstr ""

#. Occurrence C_4:188:18139: scene=C_4
#: C_4:188
msgctxt "text_id=18139 | speaker=unknown"
msgid "　呼吸が速いのも、力が入っているのも、<偏|ひとえ>に自分の責任だ。"
msgstr ""

#. Occurrence C_4:193:18140: scene=C_4
#: C_4:193
msgctxt "text_id=18140 | speaker=unknown"
msgid "　彼は努めて、冷静であれと繰り返す。"
msgstr ""

#. Occurrence C_4:234:18141: scene=C_4
#: C_4:234
msgctxt "text_id=18141 | speaker=unknown"
msgid "　教会を出てからここまで、一秒も止まらなかった。"
msgstr ""

#. Occurrence C_4:239:18142: scene=C_4
#: C_4:239
msgctxt "text_id=18142 | speaker=unknown"
msgid "　ここからはどうだろう。"
msgstr ""

#. Occurrence C_4:281:18143: scene=C_4
#: C_4:281
msgctxt "text_id=18143 | speaker=unknown"
msgid "　信号が多い。"
msgstr ""

#. Occurrence C_4:286:18144: scene=C_4
#: C_4:286
msgctxt "text_id=18144 | speaker=unknown"
msgid "　人が多い。"
msgstr ""

#. Occurrence C_4:291:18145: scene=C_4
#: C_4:291
msgctxt "text_id=18145 | speaker=unknown"
msgid "　タクシーを使うのも手ではあるが、クリスマスの街は混みあっている。"
msgstr ""

#. Occurrence C_4:297:18146: scene=C_4
#: C_4:297
msgctxt "text_id=18146 | speaker=unknown"
msgid "だいたいタクシー待ちが多すぎる。それならこのまま、小回りのきく自分の足を信用した。"
msgstr ""

#. Occurrence C_4:302:18147: scene=C_4
#: C_4:302
msgctxt "text_id=18147 | speaker=unknown"
msgid "　昨夜以上に最短距離で行けるよう、夜の街を駆けていく。"
msgstr ""

#. Occurrence C_4:370:18148: scene=C_4
#: C_4:370
msgctxt "text_id=18148 | speaker=unknown"
msgid "　胸の<鼓|お><動|と>は針のようだ。"
msgstr ""

#. Occurrence C_4:376:18149: scene=C_4
#: C_4:376
msgctxt "text_id=18149 | speaker=unknown"
msgid "　<早鐘|はやがね>は依然として鳴り続けている。"
msgstr ""

#. Occurrence C_4:381:18150: scene=C_4
#: C_4:381
msgctxt "text_id=18150 | speaker=unknown"
msgid "　この程度の距離で音を上げる事はないのに、まったくもって落ち着かない。"
msgstr ""

#. Occurrence C_4:416:18151: scene=C_4
#: C_4:416
msgctxt "text_id=18151 | speaker=unknown"
msgid "　ふわふわした<自分|からだ>には、その音はいささか大きすぎるようだった。"
msgstr ""

#. Occurrence C_4:421:18152: scene=C_4
#: C_4:421
msgctxt "text_id=18152 | speaker=unknown"
msgid "　嫌な予感だけが先走ってしまう。"
msgstr ""

#. Occurrence C_4:426:18153: scene=C_4
#: C_4:426
msgctxt "text_id=18153 | speaker=unknown"
msgid "　でも冷静に、冷静に。"
msgstr ""

#. Occurrence C_4:431:18154: scene=C_4
#: C_4:431
msgctxt "text_id=18154 | speaker=unknown"
msgid "　だって、それだけが彼の武器だ。"
msgstr ""

#. Occurrence C_4:436:18155: scene=C_4
#: C_4:436
msgctxt "text_id=18155 | speaker=unknown"
msgid "　無力であるが故に、落ち着く事だけが自分にできる最善だと、彼はよく理解していた。"
msgstr ""

#. Occurrence C_4:507:18156: scene=C_4
#: C_4:507
msgctxt "text_id=18156 | speaker=unknown"
msgid "　―――反面。"
msgstr ""

#. Occurrence C_4:512:18157: scene=C_4
#: C_4:512
msgctxt "text_id=18157 | speaker=unknown"
msgid "　しゃにむに走るたび、胸の鼓動は速くなる。"
msgstr ""

#. Occurrence C_4:601:18158: scene=C_4
#: C_4:601
msgctxt "text_id=18158 | speaker=unknown"
msgid "　月光が森をかすかに照らす。"
msgstr ""

#. Occurrence C_4:606:18159: scene=C_4
#: C_4:606
msgctxt "text_id=18159 | speaker=unknown"
msgid "　はげ山にはそれだけで十分だった。"
msgstr ""

#. Occurrence C_4:611:18160: scene=C_4
#: C_4:611
msgctxt "text_id=18160 | speaker=unknown"
msgid "　ふたり分の足跡を追いかける。"
msgstr ""

#. Occurrence C_4:616:18161: scene=C_4
#: C_4:616
msgctxt "text_id=18161 | speaker=unknown"
msgid "　この先はいつかの遊園地と同じ、彼には関わりのない窮地だ。"
msgstr ""

#. Occurrence C_4:685:18162: scene=C_4
#: C_4:685
msgctxt "text_id=18162 | speaker=unknown"
msgid "『―――貴方が行っても何も出来ない』"
msgstr ""

#. Occurrence C_4:733:18163: scene=C_4
#: C_4:733
msgctxt "text_id=18163 | speaker=unknown"
msgid "　戒めの言葉に、心音だけが高くなる。"
msgstr ""

#. Occurrence C_4:738:18164: scene=C_4
#: C_4:738
msgctxt "text_id=18164 | speaker=unknown"
msgid "　地を蹴る足は勢いをまして、戸惑う心は後方に千切れて消えていく。"
msgstr ""

#. Occurrence C_4:765:18165: scene=C_4
#: C_4:765
msgctxt "text_id=18165 | speaker=unknown"
msgid "　そんな事、言われるまでもない。"
msgstr ""

#. Occurrence C_4:770:18166: scene=C_4
#: C_4:770
msgctxt "text_id=18166 | speaker=unknown"
msgid "　何より彼自身が痛感している。"
msgstr ""

#. Occurrence C_4:775:18167: scene=C_4
#: C_4:775
msgctxt "text_id=18167 | speaker=unknown"
msgid "　役に立たないだけならまだマシで、最悪、彼女たちにとってマイナスにしかならないのではと。"
msgstr ""

#. Occurrence C_4:780:18168: scene=C_4
#: C_4:780
msgctxt "text_id=18168 | speaker=unknown"
msgid "　それが教会で一瞬だけ足を止めた呪縛だった。"
msgstr ""

#. Occurrence C_4:786:18169: scene=C_4
#: C_4:786
msgctxt "text_id=18169 | speaker=unknown"
msgid "　でも、結局は―――"
msgstr ""

#. Occurrence C_4:850:18170: scene=C_4
#: C_4:850
msgctxt "text_id=18170 | speaker=unknown"
msgid "　体は、何もしない後悔より、砕け散る後悔を選んだ。"
msgstr ""

#. Occurrence C_4:856:18171: scene=C_4
#: C_4:856
msgctxt "text_id=18171 | speaker=unknown"
msgid "　森を走る足取りは乱れない。"
msgstr ""

#. Occurrence C_4:861:18172: scene=C_4
#: C_4:861
msgctxt "text_id=18172 | speaker=unknown"
msgid "　乱れそうなのは鼓動だけ。"
msgstr ""

#. Occurrence C_4:866:18173: scene=C_4
#: C_4:866
msgctxt "text_id=18173 | speaker=unknown"
msgid "　自分の弱さだけが叫んでいる。"
msgstr ""

#. Occurrence C_4:918:18174: scene=C_4
#: C_4:918
msgctxt "text_id=18174 | speaker=unknown"
msgid "　あの遊園地の空を駆け下りた時とまったく同じ。"
msgstr ""

#. Occurrence C_4:944:18175: scene=C_4
#: C_4:944
msgctxt "text_id=18175 | speaker=unknown"
msgid "　どんな理由も<経緯|いきさつ>も関係ない。"
msgstr ""

#. Occurrence C_4:966:18176: scene=C_4
#: C_4:966
msgctxt "text_id=18176 | speaker=unknown"
msgid "　結局のところ、"
msgstr ""

#. Occurrence C_4:991:18177: scene=C_4
#: C_4:991
msgctxt "text_id=18177 | speaker=unknown"
msgid "“―――自分が、<彼女|だれか>を助けたいんだ”"
msgstr ""

#. Occurrence C_4:997:18178: scene=C_4
#: C_4:997
msgctxt "text_id=18178 | speaker=unknown"
msgid "　ただそれだけの、純粋な欲求だ。"
msgstr ""

#. Occurrence C_4:1050:18179: scene=C_4
#: C_4:1050
msgctxt "text_id=18179 | speaker=unknown"
msgid "　心音は調子を崩さない。"
msgstr ""

#. Occurrence C_4:1055:18180: scene=C_4
#: C_4:1055
msgctxt "text_id=18180 | speaker=unknown"
msgid "　暗い森を走っていく間、彼の脳裏を占めていたものは一つだけ。"
msgstr ""

#. Occurrence C_4:1060:18181: scene=C_4
#: C_4:1060
msgctxt "text_id=18181 | speaker=unknown"
msgid "　彼女たちへの心配でも、橙子に対する敵意でもない。"
msgstr ""

#. Occurrence C_4:1110:18182: scene=C_4
#: C_4:1110
msgctxt "text_id=18182 | speaker=unknown"
msgid "　赤い花に飾られたような肢体。"
msgstr ""

#. Occurrence C_4:1115:18183: scene=C_4
#: C_4:1115
msgctxt "text_id=18183 | speaker=unknown"
msgid "　産声にも似た苦痛の声。"
msgstr ""

#. Occurrence C_4:1120:18184: scene=C_4
#: C_4:1120
msgctxt "text_id=18184 | speaker=unknown"
msgid "　美しいと感じたものが、静かに死滅していく現実。"
msgstr ""

#. Occurrence C_4:1126:18185: scene=C_4
#: C_4:1126
msgctxt "text_id=18185 | speaker=unknown"
msgid "　なんて<拭|ぬぐ>いがたい悪夢。"
msgstr ""

#. Occurrence C_4:1131:18186: scene=C_4
#: C_4:1131
msgctxt "text_id=18186 | speaker=unknown"
msgid "　だから、もう二度と。"
msgstr ""

#. Occurrence C_4:1136:18187: scene=C_4
#: C_4:1136
msgctxt "text_id=18187 | speaker=unknown"
msgid "　あんな光景は、見たくなかったのに。"
msgstr ""

#. Occurrence C_4:1185:18188: scene=C_4
#: C_4:1185
msgctxt "text_id=18188 | speaker=unknown"
msgid "　森はじき終わろうとしている。"
msgstr ""

#. Occurrence C_4:1190:18189: scene=C_4
#: C_4:1190
msgctxt "text_id=18189 | speaker=unknown"
msgid "　月光はさえざえと旧校舎を示している。"
msgstr ""

#. Occurrence C_4:1195:18190: scene=C_4
#: C_4:1195
msgctxt "text_id=18190 | speaker=unknown"
msgid "　その、絶望的なタイミングで思い至ってしまった。"
msgstr ""

#. Occurrence C_4:1200:18191: scene=C_4
#: C_4:1200
msgctxt "text_id=18191 | speaker=unknown"
msgid "　あんな光景は二度と見たくない。"
msgstr ""

#. Occurrence C_4:1205:18192: scene=C_4
#: C_4:1205
msgctxt "text_id=18192 | speaker=unknown"
msgid "　そのためにこうして自分は走っている。"
msgstr ""

#. Occurrence C_4:1227:18193: scene=C_4
#: C_4:1227
msgctxt "text_id=18193 | speaker=unknown"
msgid "　……けれど。"
msgstr ""

#. Occurrence C_4:1233:18194: scene=C_4
#: C_4:1233
msgctxt "text_id=18194 | speaker=unknown"
msgid "もし二度目と直面した時、どうすれば冷静でいられるのか。"
msgstr ""

#. Occurrence C_4:1297:18195: scene=C_4
#: C_4:1297
msgctxt "text_id=18195 | speaker=unknown"
msgid "　そうして、彼は広場に辿り着いた。"
msgstr ""

#. Occurrence C_4:1302:18196: scene=C_4
#: C_4:1302
msgctxt "text_id=18196 | speaker=unknown"
msgid "　長く走った事で乱れた呼吸も、<瘧|おこり>のように上下する肩も、嘘のように消え去った。"
msgstr ""

#. Occurrence C_4:1307:18197: scene=C_4
#: C_4:1307
msgctxt "text_id=18197 | speaker=unknown"
msgid "　<排気|はいき>も<慣性|かんせい>もない、時間停止のような思考停止。"
msgstr ""

#. Occurrence C_4:1313:18198: scene=C_4
#: C_4:1313
msgctxt "text_id=18198 | speaker=unknown"
msgid "　二度目は、たしかにあった。"
msgstr ""

#. Occurrence C_4:1360:18199: scene=C_4
#: C_4:1360
msgctxt "text_id=18199 | speaker=unknown"
msgid "　一度目のような目眩と吐き気はあったかどうか。"
msgstr ""

#. Occurrence C_4:1365:18200: scene=C_4
#: C_4:1365
msgctxt "text_id=18200 | speaker=unknown"
msgid "　ここまで積み重ねてきた弱音。"
msgstr ""

#. Occurrence C_4:1370:18201: scene=C_4
#: C_4:1370
msgctxt "text_id=18201 | speaker=unknown"
msgid "　頭を乱していた迷いは、より強い感情で、跡形もなく消え去った。"
msgstr ""

#. Occurrence C_4:1376:18202: scene=C_4
#: C_4:1376
msgctxt "text_id=18202 | speaker=unknown"
msgid "完全に、<頭蓋|ずがい>の外にはじき出された。"
msgstr ""

#. Occurrence C_4:1467:18203: scene=C_4
#: C_4:1467
msgctxt "text_id=18203 | speaker=unknown"
msgid "　―――心音は胸を貫く<楔|くさび>のように。"
msgstr ""

#. Occurrence C_4:1472:18204: scene=C_4
#: C_4:1472
msgctxt "text_id=18204 | speaker=unknown"
msgid "　それはひときわ高い、意識を覚ます原初の鼓動。"
msgstr ""

#. Occurrence C_5:78:18205: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0000; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:78
msgctxt "text_id=18205 | speaker=soujuurou"
msgid "「――――――」"
msgstr ""

#. Occurrence C_5:84:18206: scene=C_5
#: C_5:84
msgctxt "text_id=18206 | speaker=unknown"
msgid "　<深|ふか>く<細|ほそ>く息を吐いて、草十郎は広場に足を踏み入れた。"
msgstr ""

#. Occurrence C_5:105:18207: scene=C_5
#: C_5:105
msgctxt "text_id=18207 | speaker=unknown"
msgid "　視線は金髪の少年に合わせてはいるものの、意識は自分に向けられている。"
msgstr ""

#. Occurrence C_5:110:18208: scene=C_5
#: C_5:110
msgctxt "text_id=18208 | speaker=unknown"
msgid "　冷静であれ、冷静であれ、と。"
msgstr ""

#. Occurrence C_5:146:18209: scene=C_5
#: C_5:146
msgctxt "text_id=18209 | speaker=unknown"
msgid "　彼は全身全霊で、<努|つと>めて呼吸を合わせている。"
msgstr ""

#. Occurrence C_5:166:18210: scene=C_5
#: C_5:166
msgctxt "text_id=18210 | speaker=unknown"
msgid "　広場の状況は、青子たちの敗北を物語っていた。"
msgstr ""

#. Occurrence C_5:197:18211: scene=C_5
#: C_5:197
msgctxt "text_id=18211 | speaker=unknown"
msgid "　青子は<仰向|あおむ>けに倒れている。"
msgstr ""

#. Occurrence C_5:202:18212: scene=C_5
#: C_5:202
msgctxt "text_id=18212 | speaker=unknown"
msgid "　片足は真っ赤で、<腿|もも>は<醜|みにく>く潰されていた。"
msgstr ""

#. Occurrence C_5:222:18213: scene=C_5
#: C_5:222
msgctxt "text_id=18213 | speaker=unknown"
msgid "　青子の<瞳|め>は<霞|かす>んでいるものの、やってきた草十郎を見すえる程度には、気丈な意志が残っている。"
msgstr ""

#. Occurrence C_5:227:18214: scene=C_5
#: C_5:227
msgctxt "text_id=18214 | speaker=unknown"
msgid "　小さく咳きこんでいるところを見ると、腹部か背中を強く殴打したのだろう。"
msgstr ""

#. Occurrence C_5:232:18215: scene=C_5
#: C_5:232
msgctxt "text_id=18215 | speaker=unknown"
msgid "　いや、その両方か、と草十郎は判断した。"
msgstr ""

#. Occurrence C_5:286:18216: scene=C_5
#: C_5:286
msgctxt "text_id=18216 | speaker=unknown"
msgid "　有珠は青子ほど重傷には見えないが、やはり地面に倒れたまま動けない。"
msgstr ""

#. Occurrence C_5:291:18217: scene=C_5
#: C_5:291
msgctxt "text_id=18217 | speaker=unknown"
msgid "　青子とは反対にうつぶせで、懸命に両肘を地面に立て、起きあがろうとしているのが痛々しかった。"
msgstr ""

#. Occurrence C_5:371:18218: scene=C_5
#: C_5:371
msgctxt "text_id=18218 | speaker=unknown"
msgid "　広場の奥に鎮座する旧校舎の前には、いつか見た魔術師の姿。"
msgstr ""

#. Occurrence C_5:376:18219: scene=C_5
#: C_5:376
msgctxt "text_id=18219 | speaker=unknown"
msgid "　それにはまったくの無意志を<示|しめ>し、草十郎は歩きだした。"
msgstr ""

#. Occurrence C_5:428:18220: scene=C_5
#: C_5:428
msgctxt "text_id=18220 | speaker=unknown"
msgid "　彼は広場に到着した時より落ち着いた面もちで、青子へと足を進める。"
msgstr ""

#. Occurrence C_5:433:18221: scene=C_5
#: C_5:433
msgctxt "text_id=18221 | speaker=unknown"
msgid "　橙子はそれを止めない。"
msgstr ""

#. Occurrence C_5:438:18222: scene=C_5
#: C_5:438
msgctxt "text_id=18222 | speaker=unknown"
msgid "　ただ、誰に気付かれるコトなく、瞳に苦悩の色を浮かべただけだった。"
msgstr ""

#. Occurrence C_5:472:18223: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0000; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:472
msgctxt "text_id=18223 | speaker=beo"
msgid "「お兄さんも、その人たちの仲間？」"
msgstr ""

#. Occurrence C_5:478:18224: scene=C_5
#: C_5:478
msgctxt "text_id=18224 | speaker=unknown"
msgid "　勝者の余裕か、人狼の少年は親しげに話しかける。"
msgstr ""

#. Occurrence C_5:483:18225: scene=C_5
#: C_5:483
msgctxt "text_id=18225 | speaker=unknown"
msgid "　新しい獲物が来た、程度の気持ちなのだろう。"
msgstr ""

#. Occurrence C_5:493:18226: scene=C_5
#: C_5:493
msgctxt "text_id=18226 | speaker=unknown"
msgid "　草十郎は応えずに青子へと歩いていく。"
msgstr ""

#. Occurrence C_5:518:18227: scene=C_5
#: C_5:518
msgctxt "text_id=18227 | speaker=unknown"
msgid "　完全な無視に、少年から笑みが消えた。"
msgstr ""

#. Occurrence C_5:523:18228: scene=C_5
#: C_5:523
msgctxt "text_id=18228 | speaker=unknown"
msgid "　悪魔の機嫌を損ねた事も気にならないのか、草十郎は歩みを止めない。"
msgstr ""

#. Occurrence C_5:553:18229: scene=C_5
#: C_5:553
msgctxt "text_id=18229 | speaker=unknown"
msgid "　そうして青子の元まで到着すると、彼は痛ましげに顔を<曇|くも>らせた。"
msgstr ""

#. Occurrence C_5:602:18230: scene=C_5
#: C_5:602
msgctxt "text_id=18230 | speaker=unknown"
msgid "　……らしくなく、自然な言葉が見つからない。"
msgstr ""

#. Occurrence C_5:607:18231: scene=C_5
#: C_5:607
msgctxt "text_id=18231 | speaker=unknown"
msgid "　短い逡巡の<末|すえ>、かろうじて口に出来たのは、"
msgstr ""

#. Occurrence C_5:664:18232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0001; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:664
msgctxt "text_id=18232 | speaker=soujuurou"
msgid "「なってないぞ生徒会長。"
msgstr ""

#. Occurrence C_5:670:18233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0002; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:670
msgctxt "text_id=18233 | speaker=soujuurou"
msgid "　行く時ぐらい、声をかけるものだろう」"
msgstr ""

#. Occurrence C_5:676:18234: scene=C_5
#: C_5:676
msgctxt "text_id=18234 | speaker=unknown"
msgid "　叱るような<気遣|きづか>うような、不器用な呼びかけだけだった。"
msgstr ""

#. Occurrence C_5:725:18235: scene=C_5
#: C_5:725
msgctxt "text_id=18235 | speaker=unknown"
msgid "「………………"
msgstr ""

#. Occurrence C_5:732:18236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0000; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:732
msgctxt "text_id=18236 | speaker=aoko"
msgid "この、ばか」"
msgstr ""

#. Occurrence C_5:737:18237: scene=C_5
#: C_5:737
msgctxt "text_id=18237 | speaker=unknown"
msgid "　腹の痛みもなんのその、青子は自分をかばうように立つ草十郎を罵倒する。"
msgstr ""

#. Occurrence C_5:777:18238: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0003; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:777
msgctxt "text_id=18238 | speaker=soujuurou"
msgid "「安心した。余裕あるじゃないか、蒼崎」"
msgstr ""

#. Occurrence C_5:782:18239: scene=C_5
#: C_5:782
msgctxt "text_id=18239 | speaker=unknown"
msgid "　そんな青子の強がりを真に受けたのか、草十郎の声は明るい。"
msgstr ""

#. Occurrence C_5:802:18240: scene=C_5
#: C_5:802
msgctxt "text_id=18240 | speaker=unknown"
msgid "　……実際、青子には余裕どころか体力も無い。"
msgstr ""

#. Occurrence C_5:807:18241: scene=C_5
#: C_5:807
msgctxt "text_id=18241 | speaker=unknown"
msgid "　なのに草十郎の返事はいつも通りで、"
msgstr ""

#. Occurrence C_5:812:18242: scene=C_5
#: C_5:812
msgctxt "text_id=18242 | speaker=unknown"
msgid "『さすが蒼崎、殺しても死なないな』とでも言いたげな<暢気|のんき>さだ。"
msgstr ""

#. Occurrence C_5:860:18243: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0001; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:860
msgctxt "text_id=18243 | speaker=aoko"
msgid "「アンタ、ね―――」"
msgstr ""

#. Occurrence C_5:874:18244: scene=C_5
#: C_5:874
msgctxt "text_id=18244 | speaker=unknown"
msgid "　つい口に出して、青子は息を呑んだ。"
msgstr ""

#. Occurrence C_5:879:18245: scene=C_5
#: C_5:879
msgctxt "text_id=18245 | speaker=unknown"
msgid "　……草十郎は何も勘違いしていない。"
msgstr ""

#. Occurrence C_5:884:18246: scene=C_5
#: C_5:884
msgctxt "text_id=18246 | speaker=unknown"
msgid "　いかに間が抜けていても、今の状況がどれほど危険なのか、痛いほど理解している。"
msgstr ""

#. Occurrence C_5:913:18247: scene=C_5
#: C_5:913
msgctxt "text_id=18247 | speaker=unknown"
msgid "　その証拠に、暢気な台詞が空々しく聞こえるほど、その表情は凍りついていた。"
msgstr ""

#. Occurrence C_5:934:18248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0002; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:934
msgctxt "text_id=18248 | speaker=aoko"
msgid "「……いったい、何のつもりで……」"
msgstr ""

#. Occurrence C_5:956:18249: scene=C_5
#: C_5:956
msgctxt "text_id=18249 | speaker=unknown"
msgid "　来たのよ、といいかけて青子は咳きこんでしまった。"
msgstr ""

#. Occurrence C_5:961:18250: scene=C_5
#: C_5:961
msgctxt "text_id=18250 | speaker=unknown"
msgid "　草十郎は人差し指を口元に立てて頷く。"
msgstr ""

#. Occurrence C_5:966:18251: scene=C_5
#: C_5:966
msgctxt "text_id=18251 | speaker=unknown"
msgid "　青子には理解しがたいが、無理して話しちゃダメだ、というジェスチャーらしい。"
msgstr ""

#. Occurrence C_5:987:18252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0004; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:987
msgctxt "text_id=18252 | speaker=soujuurou"
msgid "「だって、ほら。状況はあの時と一緒だ。"
msgstr ""

#. Occurrence C_5:1005:18253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0005; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1005
msgctxt "text_id=18253 | speaker=soujuurou"
msgid "　君がやられたら、次はこっちの番なんだろう？　だから協力をしに来たんじゃないか。"
msgstr ""

#. Occurrence C_5:1011:18254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0006; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1011
msgctxt "text_id=18254 | speaker=soujuurou"
msgid "　……まあ。何もできないのも、あの時と変わってはいないんだけど」"
msgstr ""

#. Occurrence C_5:1058:18255: scene=C_5
#: C_5:1058
msgctxt "text_id=18255 | speaker=unknown"
msgid "　青子には答えもない。"
msgstr ""

#. Occurrence C_5:1063:18256: scene=C_5
#: C_5:1063
msgctxt "text_id=18256 | speaker=unknown"
msgid "　ただ呆然と顔をあげて、本気で呆れるように、草十郎を見つめ返す事しかできなかった。"
msgstr ""

#. Occurrence C_5:1111:18257: scene=C_5
#: C_5:1111
msgctxt "text_id=18257 | speaker=unknown"
msgid "　そんなふたりを、人狼は<苛立|いらだ>たしく見つめている。"
msgstr ""

#. Occurrence C_5:1116:18258: scene=C_5
#: C_5:1116
msgctxt "text_id=18258 | speaker=unknown"
msgid "　彼には王者としての自意識がある。"
msgstr ""

#. Occurrence C_5:1121:18259: scene=C_5
#: C_5:1121
msgctxt "text_id=18259 | speaker=unknown"
msgid "　無視されただけでも<轢殺|れきさつ>もので、橙子さえいなければサクッと草十郎の喉を噛みちぎっている。"
msgstr ""

#. Occurrence C_5:1158:18260: scene=C_5
#: C_5:1158
msgctxt "text_id=18260 | speaker=unknown"
msgid "　自分の重圧は確かに伝わっている筈だ。"
msgstr ""

#. Occurrence C_5:1163:18261: scene=C_5
#: C_5:1163
msgctxt "text_id=18261 | speaker=unknown"
msgid "　なのに獲物からは、まったく恐れが伝わってこない。"
msgstr ""

#. Occurrence C_5:1168:18262: scene=C_5
#: C_5:1168
msgctxt "text_id=18262 | speaker=unknown"
msgid "　……考えづらいが、まさか、ひょっとして。"
msgstr ""

#. Occurrence C_5:1185:18263: scene=C_5
#: C_5:1185
msgctxt "text_id=18263 | speaker=unknown"
msgid "　あの人間の視界には、自分はどうでもいいモノとして映っているのではないだろうか―――？"
msgstr ""

#. Occurrence C_5:1228:18264: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0001; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1228
msgctxt "text_id=18264 | speaker=beo"
msgid "「……まあ、誰でもいいんだけど。筋ばった肉は歯ごたえがあっていいし、何より食いでがある。"
msgstr ""

#. Occurrence C_5:1234:18265: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0002; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1234
msgctxt "text_id=18265 | speaker=beo"
msgid "　先に、そのお兄さんからハジメテもかまわないよね？」"
msgstr ""

#. Occurrence C_5:1295:18266: scene=C_5
#: C_5:1295
msgctxt "text_id=18266 | speaker=unknown"
msgid "　少年はもう一度呼びかけた。"
msgstr ""

#. Occurrence C_5:1300:18267: scene=C_5
#: C_5:1300
msgctxt "text_id=18267 | speaker=unknown"
msgid "　それにも応えず、草十郎は片手をゆっくりと鼻にあてた。"
msgstr ""

#. Occurrence C_5:1305:18268: scene=C_5
#: C_5:1305
msgctxt "text_id=18268 | speaker=unknown"
msgid "　<極|きわ>めて冷静に。"
msgstr ""

#. Occurrence C_5:1310:18269: scene=C_5
#: C_5:1310
msgctxt "text_id=18269 | speaker=unknown"
msgid "　少年に意識は向けず、けれど目は逸らさず。"
msgstr ""

#. Occurrence C_5:1349:18270: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0007; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1349
msgctxt "text_id=18270 | speaker=soujuurou"
msgid "「……匂うな」"
msgstr ""

#. Occurrence C_5:1368:18271: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0003; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1368
msgctxt "text_id=18271 | speaker=beo"
msgid "「…………？」"
msgstr ""

#. Occurrence C_5:1421:18272: scene=C_5
#: C_5:1421
msgctxt "text_id=18272 | speaker=unknown"
msgid "　不快げに呟かれた声に誰もが首をかしげる。"
msgstr ""

#. Occurrence C_5:1426:18273: scene=C_5
#: C_5:1426
msgctxt "text_id=18273 | speaker=unknown"
msgid "　彼の言う匂いなんて、少しも嗅ぎ取れないからだ。"
msgstr ""

#. Occurrence C_5:1468:18274: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0004; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1468
msgctxt "text_id=18274 | speaker=beo"
msgid "「……へえ。何が匂うって言うのかな、お兄さん」"
msgstr ""

#. Occurrence C_5:1485:18275: scene=C_5
#: C_5:1485
msgctxt "text_id=18275 | speaker=unknown"
msgid "　余裕に満ちてはいるが、苛立ちに急かされた声。"
msgstr ""

#. Occurrence C_5:1496:18276: scene=C_5
#: C_5:1496
msgctxt "text_id=18276 | speaker=unknown"
msgid "　<度重|たびかさ>なる無視に少年は怒気を抑えきれない。"
msgstr ""

#. Occurrence C_5:1501:18277: scene=C_5
#: C_5:1501
msgctxt "text_id=18277 | speaker=unknown"
msgid "　それでようやく、草十郎は遠くの、けれど真っ正面にいる少年へと体を向けた。"
msgstr ""

#. Occurrence C_5:1559:18278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0008; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1559
msgctxt "text_id=18278 | speaker=soujuurou"
msgid "「品のない肉の匂いがする。これだから犬は嫌いなんだ」"
msgstr ""

#. Occurrence C_5:1565:18279: scene=C_5
#: C_5:1565
msgctxt "text_id=18279 | speaker=unknown"
msgid "　心底から不快だ、と言わんばかりの声。"
msgstr ""

#. Occurrence C_5:1571:18280: scene=C_5
#: C_5:1571
msgctxt "text_id=18280 | speaker=unknown"
msgid "　草十郎にとってはただの独り言。"
msgstr ""

#. Occurrence C_5:1577:18281: scene=C_5
#: C_5:1577
msgctxt "text_id=18281 | speaker=unknown"
msgid "　少年にとって侮辱以外の何物でもない。"
msgstr ""

#. Occurrence C_5:1583:18282: scene=C_5
#: C_5:1583
msgctxt "text_id=18282 | speaker=unknown"
msgid "　草十郎本人に、そんなつもりが全くなかったとしても。"
msgstr ""

#. Occurrence C_5:1642:18283: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0005; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1642
msgctxt "text_id=18283 | speaker=beo"
msgid "「―――、は」"
msgstr ""

#. Occurrence C_5:1648:18284: scene=C_5
#: C_5:1648
msgctxt "text_id=18284 | speaker=unknown"
msgid "　瞬間、たしかに風が吹いた。"
msgstr ""

#. Occurrence C_5:1653:18285: scene=C_5
#: C_5:1653
msgctxt "text_id=18285 | speaker=unknown"
msgid "　人狼に起きた感情の変化だろう。"
msgstr ""

#. Occurrence C_5:1658:18286: scene=C_5
#: C_5:1658
msgctxt "text_id=18286 | speaker=unknown"
msgid "　獣気は大気を焼く風になって、雪原に<風紋|ふうもん>を走らせた。"
msgstr ""

#. Occurrence C_5:1716:18287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0003; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:1716
msgctxt "text_id=18287 | speaker=aoko"
msgid "「草十郎…………！」"
msgstr ""

#. Occurrence C_5:1722:18288: scene=C_5
#: C_5:1722
msgctxt "text_id=18288 | speaker=unknown"
msgid "　このままでは草十郎が真っ先に殺される、と青子は体に力をいれた。"
msgstr ""

#. Occurrence C_5:1727:18289: scene=C_5
#: C_5:1727
msgctxt "text_id=18289 | speaker=unknown"
msgid "　だが、壊れた体は指先ぐらいしか動かない。"
msgstr ""

#. Occurrence C_5:1732:18290: scene=C_5
#: C_5:1732
msgctxt "text_id=18290 | speaker=unknown"
msgid "　見れば、草十郎の失言だけは聞こえていたのか、有珠もなんとか立ち上がろうとしている。"
msgstr ""

#. Occurrence C_5:1771:18291: scene=C_5
#: C_5:1771
msgctxt "text_id=18291 | speaker=unknown"
msgid "　草十郎の姿は、そんなふたりとは対照的だった。"
msgstr ""

#. Occurrence C_5:1776:18292: scene=C_5
#: C_5:1776
msgctxt "text_id=18292 | speaker=unknown"
msgid "　<泰然|たいぜん>としてさえ見える立ち姿。"
msgstr ""

#. Occurrence C_5:1781:18293: scene=C_5
#: C_5:1781
msgctxt "text_id=18293 | speaker=unknown"
msgid "　少年の苛立ちは、それで限界を超えてしまった。"
msgstr ""

#. Occurrence C_5:1826:18294: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0006_0; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1826
msgctxt "text_id=18294 | speaker=beo"
msgid "「……そうか。ようするに、ボクが子供だからって舐めてるんだね、"
msgstr ""

#. Occurrence C_5:1840:18295: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0006_1; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1840
msgctxt "text_id=18295 | speaker=beo"
msgid "お兄さんは…………！」"
msgstr ""

#. Occurrence C_5:1946:18296: scene=C_5
#: C_5:1946
msgctxt "text_id=18296 | speaker=unknown"
msgid "　―――人間の時間が終わる。"
msgstr ""

#. Occurrence C_5:1954:18297: scene=C_5
#: C_5:1954
msgctxt "text_id=18297 | speaker=unknown"
msgid "　怒気を含んだ言葉と共に、少年の<躯|からだ>が変化する。"
msgstr ""

#. Occurrence C_5:1959:18298: scene=C_5
#: C_5:1959
msgctxt "text_id=18298 | speaker=unknown"
msgid "　肉体はさらに大きく、その肌は悪魔の牙めいた、刺々しい毛並みに包まれていく。"
msgstr ""

#. Occurrence C_5:2156:18299: scene=C_5
#: C_5:2156
msgctxt "text_id=18299 | speaker=unknown"
msgid "　人間の物だった顔も手も、いびつなカタチに膨れ上がっていく。"
msgstr ""

#. Occurrence C_5:2161:18300: scene=C_5
#: C_5:2161
msgctxt "text_id=18300 | speaker=unknown"
msgid "　それは大気中の魔力を取りこみ、存在規模を膨張させていく異形の獣―――ヒトのカタチをした、狼の姿だった。"
msgstr ""

#. Occurrence C_5:2183:18301: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_5_0000; voice_prefix=A20; voice_category=11; scene=C_5
#: C_5:2183
msgctxt "text_id=18301 | speaker=touko"
msgid "「獣化の許しは出していないぞ、ベオ……！」"
msgstr ""

#. Occurrence C_5:2195:18302: scene=C_5
#: C_5:2195
msgctxt "text_id=18302 | speaker=unknown"
msgid "　傍観していた橙子が叫ぶが、人狼と化した少年は応えない。"
msgstr ""

#. Occurrence C_5:2200:18303: scene=C_5
#: C_5:2200
msgctxt "text_id=18303 | speaker=unknown"
msgid "　その荒い息遣いをケモノの口から吐き出すだけだ。"
msgstr ""

#. Occurrence C_5:2253:18304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0009; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2253
msgctxt "text_id=18304 | speaker=soujuurou"
msgid "「そんな、バカな話、が」"
msgstr ""

#. Occurrence C_5:2259:18305: scene=C_5
#: C_5:2259
msgctxt "text_id=18305 | speaker=unknown"
msgid "　少年の変身を見届けて、ぽつりと草十郎は漏らす。"
msgstr ""

#. Occurrence C_5:2264:18306: scene=C_5
#: C_5:2264
msgctxt "text_id=18306 | speaker=unknown"
msgid "　人から獣に変わっただけでも悪夢なのだ。"
msgstr ""

#. Occurrence C_5:2269:18307: scene=C_5
#: C_5:2269
msgctxt "text_id=18307 | speaker=unknown"
msgid "　加えて、自分より小さかった少年が二メートル近い大きさになれば、もう理解の外だろう。正常な理性が残っているかすら怪しい。"
msgstr ""

#. Occurrence C_5:2296:18308: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0010; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2296
msgctxt "text_id=18308 | speaker=soujuurou"
msgid "「……驚いた」"
msgstr ""

#. Occurrence C_5:2325:18309: scene=C_5
#: C_5:2325
msgctxt "text_id=18309 | speaker=unknown"
msgid "　獲物の呟きに、人狼は満足そうに口元を歪ませた。"
msgstr ""

#. Occurrence C_5:2330:18310: scene=C_5
#: C_5:2330
msgctxt "text_id=18310 | speaker=unknown"
msgid "　おかしな人間だったが、結局はいつも通りだと。"
msgstr ""

#. Occurrence C_5:2363:18311: scene=C_5
#: C_5:2363
msgctxt "text_id=18311 | speaker=unknown"
msgid "　……けれど。"
msgstr ""

#. Occurrence C_5:2369:18312: scene=C_5
#: C_5:2369
msgctxt "text_id=18312 | speaker=unknown"
msgid "彼の虚栄心が満たされたのはほんの一瞬。"
msgstr ""

#. Occurrence C_5:2374:18313: scene=C_5
#: C_5:2374
msgctxt "text_id=18313 | speaker=unknown"
msgid "　狩られるだけの<獲物|にんげん>は、心底呆れたように息をついて、"
msgstr ""

#. Occurrence C_5:2400:18314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0011; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2400
msgctxt "text_id=18314 | speaker=soujuurou"
msgid "「それじゃ、ほんとに犬そのものじゃないか」"
msgstr ""

#. Occurrence C_5:2476:18315: voice_id=X30_C_5_0000; voice_prefix=X30; voice_category=0; scene=C_5
#: C_5:2476
msgctxt "text_id=18315 | speaker=unknown"
msgid "「――――――」"
msgstr ""

#. Occurrence C_5:2482:18316: scene=C_5
#: C_5:2482
msgctxt "text_id=18316 | speaker=unknown"
msgid "　<木|こ>っ<端|ぱ><微塵|みじん>に砕け散るような沈黙。"
msgstr ""

#. Occurrence C_5:2487:18317: scene=C_5
#: C_5:2487
msgctxt "text_id=18317 | speaker=unknown"
msgid "　青子も有珠も、橙子さえも声がない。"
msgstr ""

#. Occurrence C_5:2539:18318: scene=C_5
#: C_5:2539
msgctxt "text_id=18318 | speaker=unknown"
msgid "　自分たちでさえ目を<背|そむ>ける人狼の獣化を目の当たりにして、まさか、そんな言葉を返せる人間がいようとは。"
msgstr ""

#. Occurrence C_5:2580:18319: scene=C_5
#: C_5:2580
msgctxt "text_id=18319 | speaker=unknown"
msgid "　楽観者は子供騙しの映画を見たような不満顔。"
msgstr ""

#. Occurrence C_5:2616:18320: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0007; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:2616
msgctxt "text_id=18320 | speaker=beo"
msgid "「“―――、―――、―――”」"
msgstr ""

#. Occurrence C_5:2625:18321: scene=C_5
#: C_5:2625
msgctxt "text_id=18321 | speaker=unknown"
msgid "　……もはや、何もかも手遅れだった。"
msgstr ""

#. Occurrence C_5:2645:18322: scene=C_5
#: C_5:2645
msgctxt "text_id=18322 | speaker=unknown"
msgid "　絶対者としての風格。"
msgstr ""

#. Occurrence C_5:2650:18323: scene=C_5
#: C_5:2650
msgctxt "text_id=18323 | speaker=unknown"
msgid "　最強を自負していた人狼から、感情の起こりが消えていく。"
msgstr ""

#. Occurrence C_5:2656:18324: scene=C_5
#: C_5:2656
msgctxt "text_id=18324 | speaker=unknown"
msgid "　つまり本気になったのだ、と理解できた者は何人いたか。"
msgstr ""

#. Occurrence C_5:2705:18325: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_5_0001; voice_prefix=A20; voice_category=11; scene=C_5
#: C_5:2705
msgctxt "text_id=18325 | speaker=touko"
msgid "「ベオ、殺すな―――！」"
msgstr ""

#. Occurrence C_5:2711:18326: scene=C_5
#: C_5:2711
msgctxt "text_id=18326 | speaker=unknown"
msgid "　仮初めの主人の制止など、金の獣には届かない。"
msgstr ""

#. Occurrence C_5:2716:18327: scene=C_5
#: C_5:2716
msgctxt "text_id=18327 | speaker=unknown"
msgid "　人狼は前傾姿勢になりながら、たった十メートル先の草十郎を凝視する。"
msgstr ""

#. Occurrence C_5:2776:18328: scene=C_5
#: C_5:2776
msgctxt "text_id=18328 | speaker=unknown"
msgid "　そう、たった十メートル。"
msgstr ""

#. Occurrence C_5:2781:18329: scene=C_5
#: C_5:2781
msgctxt "text_id=18329 | speaker=unknown"
msgid "　<突進|はし>って０．５秒。"
msgstr ""

#. Occurrence C_5:2786:18330: scene=C_5
#: C_5:2786
msgctxt "text_id=18330 | speaker=unknown"
msgid "　上から下、顔から足首まで、その爪で三枚に下ろすのにさらに０．５秒。"
msgstr ""

#. Occurrence C_5:2796:18331: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0008; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:2796
msgctxt "text_id=18331 | speaker=beo"
msgid "「“死んだよ、おまえ……！”」"
msgstr ""

#. Occurrence C_5:2862:18332: scene=C_5
#: C_5:2862
msgctxt "text_id=18332 | speaker=unknown"
msgid "　凶悪な<悦|よろこ>びに満ちた呟き。"
msgstr ""

#. Occurrence C_5:2867:18333: scene=C_5
#: C_5:2867
msgctxt "text_id=18333 | speaker=unknown"
msgid "　それだけを合図にして、人狼は草十郎へと弾け跳ぶ。"
msgstr ""

#. Occurrence C_5:2873:18334: scene=C_5
#: C_5:2873
msgctxt "text_id=18334 | speaker=unknown"
msgid "　まさしく一秒。"
msgstr ""

#. Occurrence C_5:2878:18335: scene=C_5
#: C_5:2878
msgctxt "text_id=18335 | speaker=unknown"
msgid "　金の毛並みは残像<遥|はる>かに、それは、暴風にしか見えない程の<速度|たけり>だった。"
msgstr ""

#. Occurrence C_5B:36:18336: scene=C_5B
#: C_5B:36
msgctxt "text_id=18336 | speaker=unknown"
msgid "　―――ならば、それは神速か。"
msgstr ""

#. Occurrence C_5B:47:18337: scene=C_5B
#: C_5B:47
msgctxt "text_id=18337 | speaker=unknown"
msgid "　弾け跳んだ人狼が黒影なら、<迎|むか>え撃たんと踏みこむ彼も無音の影。"
msgstr ""

#. Occurrence C_5B:52:18338: scene=C_5B
#: C_5B:52
msgctxt "text_id=18338 | speaker=unknown"
msgid "　向かうべき位置はきっかり三歩分。"
msgstr ""

#. Occurrence C_5B:57:18339: scene=C_5B
#: C_5B:57
msgctxt "text_id=18339 | speaker=unknown"
msgid "　その、わずか一メートルの前進に、彼は<人生|おのれ>の全てを<賭|と>した。"
msgstr ""

#. Occurrence C_5B:107:18340: scene=C_5B
#: C_5B:107
msgctxt "text_id=18340 | speaker=unknown"
msgid "　<瞬|またた>きひとつ分の時間で迫る死。"
msgstr ""

#. Occurrence C_5B:112:18341: scene=C_5B
#: C_5B:112
msgctxt "text_id=18341 | speaker=unknown"
msgid "　疾走する巨大な暴力を前にして、彼は避ける素振りさえ見せなかった。"
msgstr ""

#. Occurrence C_5B:185:18342: scene=C_5B
#: C_5B:185
msgctxt "text_id=18342 | speaker=unknown"
msgid "　地面よ割れよとばかりに踏みこまれる前<脚|あし>。"
msgstr ""

#. Occurrence C_5B:319:18343: scene=C_5B
#: C_5B:319
msgctxt "text_id=18343 | speaker=unknown"
msgid "　ありあまる脚力が、はち切れんばかりの<背筋|はいきん>が、人狼の腕を振り下ろさせる。"
msgstr ""

#. Occurrence C_5B:383:18344: scene=C_5B
#: C_5B:383
msgctxt "text_id=18344 | speaker=unknown"
msgid "　わずかな踏み込みが人狼の爪を<躱|かわ>す。"
msgstr ""

#. Occurrence C_5B:388:18345: scene=C_5B
#: C_5B:388
msgctxt "text_id=18345 | speaker=unknown"
msgid "　しかし、彼が飛びこんだのは回避の為ではない。"
msgstr ""

#. Occurrence C_5B:393:18346: scene=C_5B
#: C_5B:393
msgctxt "text_id=18346 | speaker=unknown"
msgid "　彼にはただ、この位置が必要だっただけ。"
msgstr ""

#. Occurrence C_5B:399:18347: scene=C_5B
#: C_5B:399
msgctxt "text_id=18347 | speaker=unknown"
msgid "　そも、<躱|かわ>すも<躱|かわ>さないもない。"
msgstr ""

#. Occurrence C_5B:404:18348: scene=C_5B
#: C_5B:404
msgctxt "text_id=18348 | speaker=unknown"
msgid "　彼の思考には初めから、<そ|・><の|・><点|・>しか存在しない。"
msgstr ""

#. Occurrence C_5B:445:18349: scene=C_5B
#: C_5B:445
msgctxt "text_id=18349 | speaker=unknown"
msgid "　―――狙うは一点。"
msgstr ""

#. Occurrence C_5B:475:18350: scene=C_5B
#: C_5B:475
msgctxt "text_id=18350 | speaker=unknown"
msgid "　意識の同一、"
msgstr ""

#. Occurrence C_5B:519:18351: scene=C_5B
#: C_5B:519
msgctxt "text_id=18351 | speaker=unknown"
msgid "　呼吸の合致。"
msgstr ""

#. Occurrence C_5B:561:18352: scene=C_5B
#: C_5B:561
msgctxt "text_id=18352 | speaker=unknown"
msgid "　<体幹|たいかん>の見切りと筋肉の<凝固|ぎょうこ><弛緩|しかん>その<隙間|すきま>。"
msgstr ""

#. Occurrence C_5B:595:18353: scene=C_5B
#: C_5B:595
msgctxt "text_id=18353 | speaker=unknown"
msgid "　その地点こそ、唯一とも言える、<生命|いのち>の壁の亀裂である。"
msgstr ""

#. Occurrence C_5B:949:18354: scene=C_5B
#: C_5B:949
msgctxt "text_id=18354 | speaker=unknown"
msgid "　人狼の胸に<叩|たた>きつけられる、あまりにも弱い人の力。"
msgstr ""

#. Occurrence C_5B:992:18355: scene=C_5B
#: C_5B:992
msgctxt "text_id=18355 | speaker=unknown"
msgid "　鈍い打撃音と、飛び散る血飛沫。"
msgstr ""

#. Occurrence C_5B:997:18356: scene=C_5B
#: C_5B:997
msgctxt "text_id=18356 | speaker=unknown"
msgid "　肉片も流血もすべては彼のもの。"
msgstr ""

#. Occurrence C_5B:1066:18357: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5B_0000; voice_prefix=A50; voice_category=12; scene=C_5B
#: C_5B:1066
msgctxt "text_id=18357 | speaker=beo"
msgid "「“、―――！？”」"
msgstr ""

#. Occurrence C_5B:1072:18358: scene=C_5B
#: C_5B:1072
msgctxt "text_id=18358 | speaker=unknown"
msgid "　振り上げた人狼の爪が<痙攣|けいれん>する。"
msgstr ""

#. Occurrence C_5B:1077:18359: scene=C_5B
#: C_5B:1077
msgctxt "text_id=18359 | speaker=unknown"
msgid "　人狼の精神より先に、人狼の肉体が、取るに足りない衝撃に虚脱した。"
msgstr ""

#. Occurrence C_5B:1098:18360: scene=C_5B
#: C_5B:1098
msgctxt "text_id=18360 | speaker=unknown"
msgid "　正体の分からない一瞬の不明。"
msgstr ""

#. Occurrence C_5B:1104:18361: scene=C_5B
#: C_5B:1104
msgctxt "text_id=18361 | speaker=unknown"
msgid "　息を吐こうと喉をあげる狼の口。"
msgstr ""

#. Occurrence C_5B:1110:18362: scene=C_5B
#: C_5B:1110
msgctxt "text_id=18362 | speaker=unknown"
msgid "　狼は知らず、あえぐようにうつぶせに倒れかける。"
msgstr ""

#. Occurrence C_5B:1162:18363: scene=C_5B
#: C_5B:1162
msgctxt "text_id=18363 | speaker=unknown"
msgid "　その横を、か細い人影がすり抜ける。"
msgstr ""

#. Occurrence C_5B:1327:18364: scene=C_5B
#: C_5B:1327
msgctxt "text_id=18364 | speaker=unknown"
msgid "　衝撃は短い槍のように。"
msgstr ""

#. Occurrence C_5B:1332:18365: scene=C_5B
#: C_5B:1332
msgctxt "text_id=18365 | speaker=unknown"
msgid "　人影は折れた左腕を<庇|かば>いもせず、前のめりに倒れこむ人狼の背中へ、残る右腕を<抉|えぐ>り打つ。"
msgstr ""

#. Occurrence C_5B:1393:18366: scene=C_5B
#: C_5B:1393
msgctxt "text_id=18366 | speaker=unknown"
msgid "　もう一度、鈍い音がした。"
msgstr ""

#. Occurrence C_5B:1398:18367: scene=C_5B
#: C_5B:1398
msgctxt "text_id=18367 | speaker=unknown"
msgid "　正面から<穿|うが>った位置と寸分違わぬ箇所を<貫|つ>く、心臓を圧する破裂の<楔|くさび>。"
msgstr ""

#. Occurrence C_5B:1403:18368: scene=C_5B
#: C_5B:1403
msgctxt "text_id=18368 | speaker=unknown"
msgid "　一度目と違うのは飛び散る<血潮|ちしお>がない事と、獣のあえぎがした事だけ。"
msgstr ""

#. Occurrence C_5B:1492:18369: scene=C_5B
#: C_5B:1492
msgctxt "text_id=18369 | speaker=unknown"
msgid "　ガ、と吐血をして人狼は倒れこんだ。"
msgstr ""

#. Occurrence C_5B:1497:18370: scene=C_5B
#: C_5B:1497
msgctxt "text_id=18370 | speaker=unknown"
msgid "　立ち上がる気配はない。"
msgstr ""

#. Occurrence C_5B:1503:18371: scene=C_5B
#: C_5B:1503
msgctxt "text_id=18371 | speaker=unknown"
msgid "なぎ払われた命はない。"
msgstr ""

#. Occurrence C_5B:1555:18372: scene=C_5B
#: C_5B:1555
msgctxt "text_id=18372 | speaker=unknown"
msgid "　<以|もっ>て事は終わった。"
msgstr ""

#. Occurrence C_5B:1560:18373: scene=C_5B
#: C_5B:1560
msgctxt "text_id=18373 | speaker=unknown"
msgid "　振るわれた暴力に一切の<撓|たわ>みなく、"
msgstr ""

#. Occurrence C_5B:1565:18374: scene=C_5B
#: C_5B:1565
msgctxt "text_id=18374 | speaker=unknown"
msgid "　猛る金獣の四肢、無欠にして<天賦|てんぷ><盤石|ばんじゃく>。"
msgstr ""

#. Occurrence C_5B:1570:18375: scene=C_5B
#: C_5B:1570
msgctxt "text_id=18375 | speaker=unknown"
msgid "　されど。わずか三秒の<交|まじ>わりで、人狼は敗北した。"
msgstr ""

#. Occurrence C_5B:1651:18376: voice_id=X30_C_5B_0000; voice_prefix=X30; voice_category=0; scene=C_5B
#: C_5B:1651
msgctxt "text_id=18376 | speaker=unknown"
msgid "「――――――」"
msgstr ""

#. Occurrence C_5B:1657:18377: scene=C_5B
#: C_5B:1657
msgctxt "text_id=18377 | speaker=unknown"
msgid "　この世のものとは思えない結末に誰もが目を疑う。"
msgstr ""

#. Occurrence C_5B:1686:18378: scene=C_5B
#: C_5B:1686
msgctxt "text_id=18378 | speaker=unknown"
msgid "　当事者は呼吸さえ乱さず、淡々と、倒れ<臥|ふ>した人狼を見下ろしていた。"
msgstr ""

msgctxt "text_id=18379 | speaker=unknown"
msgid "　ならば、それは神速か。"
msgstr ""

msgctxt "text_id=18380 | speaker=unknown"
msgid "　弾け跳んだ人狼が黒影なら、<迎|むか>え撃たんと踏みこむ彼も無音の黒影。"
msgstr ""

msgctxt "text_id=18381 | speaker=unknown"
msgid "　向かうべき位置はきっかり三歩分。"
msgstr ""

msgctxt "text_id=18382 | speaker=unknown"
msgid "　その、わずか一メートルの前進に、彼は<人生|おのれ>の全てを<賭|と>した。"
msgstr ""

msgctxt "text_id=18383 | speaker=unknown"
msgid "「――――――」"
msgstr ""

msgctxt "text_id=18384 | speaker=unknown"
msgid "　この世のものとは思えない結末に、当事者以外の誰もが目を疑う。"
msgstr ""

msgctxt "text_id=18385 | speaker=unknown"
msgid "　それを一身に受けながら、人狼を見下ろしているのは言うまでもなく、静希草十郎という名前の、ごく当たり前の少年だった。"
msgstr ""

#. Occurrence C_6:40:18386: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0000; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:40
msgctxt "text_id=18386 | speaker=beo"
msgid "“……なんで……ボクが……？”"
msgstr ""

#. Occurrence C_6:61:18387: scene=C_6
#: C_6:61
msgctxt "text_id=18387 | speaker=unknown"
msgid "　地面に倒れ臥した後でも、<人|カ><狼|レ>は自分に起きた出来事を把握できなかった。"
msgstr ""

#. Occurrence C_6:66:18388: scene=C_6
#: C_6:66
msgctxt "text_id=18388 | speaker=unknown"
msgid "　心臓が破裂し、血液の逆流によって脳をふくむ身体機能が停止し、地面に倒れこんだ。"
msgstr ""

#. Occurrence C_6:71:18389: scene=C_6
#: C_6:71
msgctxt "text_id=18389 | speaker=unknown"
msgid "　そこまでは確認できる。"
msgstr ""

#. Occurrence C_6:76:18390: scene=C_6
#: C_6:76
msgctxt "text_id=18390 | speaker=unknown"
msgid "　通常の動物なら、それが死である事も承知している。"
msgstr ""

#. Occurrence C_6:108:18391: scene=C_6
#: C_6:108
msgctxt "text_id=18391 | speaker=unknown"
msgid "　だが<人|カ><狼|レ>にとってはどうでもいい問題だ。"
msgstr ""

#. Occurrence C_6:121:18392: scene=C_6
#: C_6:121
msgctxt "text_id=18392 | speaker=unknown"
msgid "　なにしろ心臓は復元を終え、身体機能はほぼ回復している。"
msgstr ""

#. Occurrence C_6:126:18393: scene=C_6
#: C_6:126
msgctxt "text_id=18393 | speaker=unknown"
msgid "　彼の神秘性を上回る魔術を受けた訳でもなし、こんな傷、小石につまずいたのと変わらない。"
msgstr ""

#. Occurrence C_6:143:18394: scene=C_6
#: C_6:143
msgctxt "text_id=18394 | speaker=unknown"
msgid "　……だから、<矛盾|もんだい>は。"
msgstr ""

#. Occurrence C_6:148:18395: scene=C_6
#: C_6:148
msgctxt "text_id=18395 | speaker=unknown"
msgid "　小石につまずいた程度で、心臓が止まる生き物はいないということ。"
msgstr ""

#. Occurrence C_6:169:18396: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0001; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:169
msgctxt "text_id=18396 | speaker=beo"
msgid "“……思い、出さないと……”"
msgstr ""

#. Occurrence C_6:187:18397: scene=C_6
#: C_6:187
msgctxt "text_id=18397 | speaker=unknown"
msgid "　<人|カ><狼|レ>は必死に記憶を呼び覚ます。"
msgstr ""

#. Occurrence C_6:192:18398: scene=C_6
#: C_6:192
msgctxt "text_id=18398 | speaker=unknown"
msgid "　爪を振り上げたところまでは、なんとか思い出せる。"
msgstr ""

#. Occurrence C_6:197:18399: scene=C_6
#: C_6:197
msgctxt "text_id=18399 | speaker=unknown"
msgid "　論点はその後だ。"
msgstr ""

#. Occurrence C_6:202:18400: scene=C_6
#: C_6:202
msgctxt "text_id=18400 | speaker=unknown"
msgid "　形状次第では速射砲の直撃すら耐える自分が、なぜ、人間程度の腕力に倒されたのか。"
msgstr ""

#. Occurrence C_6:234:18401: scene=C_6
#: C_6:234
msgctxt "text_id=18401 | speaker=unknown"
msgid "　いや。"
msgstr ""

#. Occurrence C_6:240:18402: scene=C_6
#: C_6:240
msgctxt "text_id=18402 | speaker=unknown"
msgid "なぜ、と言うのなら、そもそも相手が何をしたのかが分からない。"
msgstr ""

#. Occurrence C_6:258:18403: scene=C_6
#: C_6:258
msgctxt "text_id=18403 | speaker=unknown"
msgid "　たしか、<懐|ふところ>に入られた瞬間、小さな衝撃を一点に<搾|しぼ>りこむような接触があった。"
msgstr ""

#. Occurrence C_6:263:18404: scene=C_6
#: C_6:263
msgctxt "text_id=18404 | speaker=unknown"
msgid "　あの正確な一撃によって、心臓だけがダメージを受けたのかもしれない。"
msgstr ""

#. Occurrence C_6:308:18405: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0002; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:308
msgctxt "text_id=18405 | speaker=beo"
msgid "“ハ―――”"
msgstr ""

#. Occurrence C_6:314:18406: scene=C_6
#: C_6:314
msgctxt "text_id=18406 | speaker=unknown"
msgid "　そんな馬鹿な話はない。"
msgstr ""

#. Occurrence C_6:319:18407: scene=C_6
#: C_6:319
msgctxt "text_id=18407 | speaker=unknown"
msgid "　仮にそうだとしても、それだけで止まる心臓なぞ<人|カ><狼|レ>は待ち合わせていない。"
msgstr ""

#. Occurrence C_6:352:18408: scene=C_6
#: C_6:352
msgctxt "text_id=18408 | speaker=unknown"
msgid "　結局、どれだけ自問しても明確な答えはでなかった。"
msgstr ""

#. Occurrence C_6:358:18409: scene=C_6
#: C_6:358
msgctxt "text_id=18409 | speaker=unknown"
msgid "　そもそも“窮地に陥る”経験がなく、人間の<研磨|けんま>を知らない<人|カ><狼|レ>に、その答えは遠すぎた。"
msgstr ""

#. Occurrence C_6:391:18410: scene=C_6
#: C_6:391
msgctxt "text_id=18410 | speaker=unknown"
msgid "　なので、<人|カ><狼|レ>にとって確かな事は、己が倒れ臥している事実だけ。"
msgstr ""

#. Occurrence C_6:396:18411: scene=C_6
#: C_6:396
msgctxt "text_id=18411 | speaker=unknown"
msgid "　手探りで経緯を思い返す。"
msgstr ""

#. Occurrence C_6:402:18412: scene=C_6
#: C_6:402
msgctxt "text_id=18412 | speaker=unknown"
msgid "　―――胸に<炸裂|さくれつ>した衝撃と、一瞬の空白。"
msgstr ""

#. Occurrence C_6:408:18413: scene=C_6
#: C_6:408
msgctxt "text_id=18413 | speaker=unknown"
msgid "　その後、相手におおい<被|かぶ>さるように倒れこむ<最中|さなか>、もう一度背中に衝撃が走ったのだ。"
msgstr ""

#. Occurrence C_6:413:18414: scene=C_6
#: C_6:413
msgctxt "text_id=18414 | speaker=unknown"
msgid "　心臓を破ったのは、その一撃によるものらしい。"
msgstr ""

#. Occurrence C_6:446:18415: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0003; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:446
msgctxt "text_id=18415 | speaker=beo"
msgid "“……ふざけてる。そんな事で、ボクが―――”"
msgstr ""

#. Occurrence C_6:467:18416: scene=C_6
#: C_6:467
msgctxt "text_id=18416 | speaker=unknown"
msgid "　倒される筈はない。"
msgstr ""

#. Occurrence C_6:472:18417: scene=C_6
#: C_6:472
msgctxt "text_id=18417 | speaker=unknown"
msgid "　物理的に間違っている。"
msgstr ""

#. Occurrence C_6:477:18418: scene=C_6
#: C_6:477
msgctxt "text_id=18418 | speaker=unknown"
msgid "　反則じみた結末に、少年は歯ぎしりをして全身に力をこめた。"
msgstr ""

#. Occurrence C_6:498:18419: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0004; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:498
msgctxt "text_id=18419 | speaker=beo"
msgid "“―――そうだ。こんなのはウソだ。同族でだってボクを負かせる奴はいなかった。"
msgstr ""

#. Occurrence C_6:505:18420: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0005; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:505
msgctxt "text_id=18420 | speaker=beo"
msgid "こんな痛みも、こんな事態も、全部ウソだ。"
msgstr ""

#. Occurrence C_6:512:18421: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0006; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:512
msgctxt "text_id=18421 | speaker=beo"
msgid "不合理に狂っている。"
msgstr ""

#. Occurrence C_6:519:18422: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0007; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:519
msgctxt "text_id=18422 | speaker=beo"
msgid "だって、この<器|ボク>が、他の生き物に負けるハズが……！”"
msgstr ""

#. Occurrence C_6:543:18423: scene=C_6
#: C_6:543
msgctxt "text_id=18423 | speaker=unknown"
msgid "　考察の時間は終わりだ。"
msgstr ""

#. Occurrence C_6:548:18424: scene=C_6
#: C_6:548
msgctxt "text_id=18424 | speaker=unknown"
msgid "　とうに傷は癒えている。"
msgstr ""

#. Occurrence C_6:553:18425: scene=C_6
#: C_6:553
msgctxt "text_id=18425 | speaker=unknown"
msgid "　再戦のため、<人|カ><狼|レ>は倒れたまま、傍らに立つ敵を睨みつけ、"
msgstr ""

#. Occurrence C_6:584:18426: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0008; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:584
msgctxt "text_id=18426 | speaker=beo"
msgid "“負ける――ハズ、が―――”"
msgstr ""

#. Occurrence C_6:609:18427: scene=C_6
#: C_6:609
msgctxt "text_id=18427 | speaker=unknown"
msgid "　瞬間。"
msgstr ""

#. Occurrence C_6:614:18428: scene=C_6
#: C_6:614
msgctxt "text_id=18428 | speaker=unknown"
msgid "　よく分からない新種の痛みが、人狼の背中を走り抜けた。"
msgstr ""

#. Occurrence C_6:680:18429: scene=C_6
#: C_6:680
msgctxt "text_id=18429 | speaker=unknown"
msgid "　頭上には無機質な<視|め>。<眼|め>。<目|め>。"
msgstr ""

#. Occurrence C_6:685:18430: scene=C_6
#: C_6:685
msgctxt "text_id=18430 | speaker=unknown"
msgid "　あまりにも<活|いろ>がない。"
msgstr ""

#. Occurrence C_6:690:18431: scene=C_6
#: C_6:690
msgctxt "text_id=18431 | speaker=unknown"
msgid "　まだ虚空にある月の方が<活|い>きている。"
msgstr ""

#. Occurrence C_6:695:18432: scene=C_6
#: C_6:695
msgctxt "text_id=18432 | speaker=unknown"
msgid "　ソレの両腕は折れている。"
msgstr ""

#. Occurrence C_6:700:18433: scene=C_6
#: C_6:700
msgctxt "text_id=18433 | speaker=unknown"
msgid "　人智に収まらぬ強打によって跡形もない。"
msgstr ""

#. Occurrence C_6:705:18434: scene=C_6
#: C_6:705
msgctxt "text_id=18434 | speaker=unknown"
msgid "　痛覚があるのなら<叫|こえ>が漏れる。"
msgstr ""

#. Occurrence C_6:710:18435: scene=C_6
#: C_6:710
msgctxt "text_id=18435 | speaker=unknown"
msgid "　なのに無音という事は。"
msgstr ""

#. Occurrence C_6:715:18436: scene=C_6
#: C_6:715
msgctxt "text_id=18436 | speaker=unknown"
msgid "　故に／"
msgstr ""

#. Occurrence C_6:715:18437: scene=C_6
#: C_6:715
msgctxt "text_id=18437 | speaker=unknown"
msgid "あるいは元より"
msgstr ""

#. Occurrence C_6:715:18438: scene=C_6
#: C_6:715
msgctxt "text_id=18438 | speaker=unknown"
msgid "／生きていない。／"
msgstr ""

#. Occurrence C_6:715:18439: scene=C_6
#: C_6:715
msgctxt "text_id=18439 | speaker=unknown"
msgid "のか。"
msgstr ""

#. Occurrence C_6:735:18440: scene=C_6
#: C_6:735
msgctxt "text_id=18440 | speaker=unknown"
msgid "　ソレは死人のような<貌|め>で<人|カ><狼|レ>を凝視している。"
msgstr ""

#. Occurrence C_6:740:18441: scene=C_6
#: C_6:740
msgctxt "text_id=18441 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　"
msgstr ""

#. Occurrence C_6:740:18442: scene=C_6
#: C_6:740
msgctxt "text_id=18442 | speaker=unknown"
msgid "近いモノなら知っている。"
msgstr ""

#. Occurrence C_6:745:18443: scene=C_6
#: C_6:745
msgctxt "text_id=18443 | speaker=unknown"
msgid "　憎悪もなし歓喜もなし。"
msgstr ""

#. Occurrence C_6:750:18444: scene=C_6
#: C_6:750
msgctxt "text_id=18444 | speaker=unknown"
msgid "　いかなる意思の発露もなし。"
msgstr ""

#. Occurrence C_6:755:18445: scene=C_6
#: C_6:755
msgctxt "text_id=18445 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　"
msgstr ""

#. Occurrence C_6:755:18446: scene=C_6
#: C_6:755
msgctxt "text_id=18446 | speaker=unknown"
msgid "<脳|ちせい>のない昆虫だ。"
msgstr ""

#. Occurrence C_6:775:18447: scene=C_6
#: C_6:775
msgctxt "text_id=18447 | speaker=unknown"
msgid "　ぞわりと体毛がささくれ立つ。"
msgstr ""

#. Occurrence C_6:780:18448: scene=C_6
#: C_6:780
msgctxt "text_id=18448 | speaker=unknown"
msgid "　己が背に走る感情の名を、人狼は知らない。"
msgstr ""

#. Occurrence C_6:785:18449: scene=C_6
#: C_6:785
msgctxt "text_id=18449 | speaker=unknown"
msgid "　その不可解さに<怖|おじ>けてしまったことを、そもそも恐怖を知らなかった<人|カ><狼|レ>には、微塵たりとも自覚できない。"
msgstr ""

#. Occurrence C_6:839:18450: scene=C_6
#: C_6:839
msgctxt "text_id=18450 | speaker=unknown"
msgid "　……金狼は今まで、多くの神秘と戦い、これを打ち破ってきた。"
msgstr ""

#. Occurrence C_6:845:18451: scene=C_6
#: C_6:845
msgctxt "text_id=18451 | speaker=unknown"
msgid "　カレは自分以上の巨体を誇る獣を知っている。"
msgstr ""

#. Occurrence C_6:850:18452: scene=C_6
#: C_6:850
msgctxt "text_id=18452 | speaker=unknown"
msgid "　自分と同じ、伝承から生まれた獣も知っている。"
msgstr ""

#. Occurrence C_6:856:18453: scene=C_6
#: C_6:856
msgctxt "text_id=18453 | speaker=unknown"
msgid "　だが、コレは知らない。"
msgstr ""

#. Occurrence C_6:861:18454: scene=C_6
#: C_6:861
msgctxt "text_id=18454 | speaker=unknown"
msgid "　人間ほどの大きさをした昆虫など、彼は出会ってもいないし、想像した事さえなかった。"
msgstr ""

#. Occurrence C_6:911:18455: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0009; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:911
msgctxt "text_id=18455 | speaker=beo"
msgid "“―――、―――”"
msgstr ""

#. Occurrence C_6:919:18456: scene=C_6
#: C_6:919
msgctxt "text_id=18456 | speaker=unknown"
msgid "　背筋が二つに割れそうな<悪寒|おかん>。"
msgstr ""

#. Occurrence C_6:924:18457: scene=C_6
#: C_6:924
msgctxt "text_id=18457 | speaker=unknown"
msgid "　今ここで少しでも動けば、何の理由も初動もなく、首めがけてあの足が落ちてくる。"
msgstr ""

#. Occurrence C_6:929:18458: scene=C_6
#: C_6:929
msgctxt "text_id=18458 | speaker=unknown"
msgid "　そんな絶望的な予感とは裏腹に、この相手は決して動かない事も、少年は感じ取っていた。"
msgstr ""

#. Occurrence C_6:966:18459: scene=C_6
#: C_6:966
msgctxt "text_id=18459 | speaker=unknown"
msgid "　この人間は、これ以上の暴力は振るわない。"
msgstr ""

#. Occurrence C_6:971:18460: scene=C_6
#: C_6:971
msgctxt "text_id=18460 | speaker=unknown"
msgid "　生き物らしい……いや、動物らしい本能がない石くれのクセに、<人|・><間|・><ら|・><し|・><い|・><分|・><別|・><で|・><動|・><い|・><て|・><い|・><る|・>。"
msgstr ""

#. Occurrence C_6:1020:18461: scene=C_6
#: C_6:1020
msgctxt "text_id=18461 | speaker=unknown"
msgid "　その矛盾が、<人|カ><狼|レ>の<価値観|こころ>に粘りつく。"
msgstr ""

#. Occurrence C_6:1025:18462: scene=C_6
#: C_6:1025
msgctxt "text_id=18462 | speaker=unknown"
msgid "　未知の<感情|きょうふ>からくる<幻肢痛|げんしつう>。"
msgstr ""

#. Occurrence C_6:1030:18463: scene=C_6
#: C_6:1030
msgctxt "text_id=18463 | speaker=unknown"
msgid "　ぷつぷつと音をたてて、小さな<画鋲|がびょう>が心臓に迫るようだ。"
msgstr ""

#. Occurrence C_6:1036:18464: scene=C_6
#: C_6:1036
msgctxt "text_id=18464 | speaker=unknown"
msgid "　それは<人|カ><狼|レ>がはじめて出会った疑問であり、現実だった。"
msgstr ""

#. Occurrence C_6:1042:18465: scene=C_6
#: C_6:1042
msgctxt "text_id=18465 | speaker=unknown"
msgid "　この世にはどうしようもない矛盾があり、そして―――"
msgstr ""

#. Occurrence C_6:1047:18466: scene=C_6
#: C_6:1047
msgctxt "text_id=18466 | speaker=unknown"
msgid "　答えなど知りたくもない“不合理”があるのだと。"
msgstr ""

#. Occurrence C_6:1100:18467: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0010; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1100
msgctxt "text_id=18467 | speaker=beo"
msgid "“っ―――い、た―――ぃ”"
msgstr ""

#. Occurrence C_6:1106:18468: scene=C_6
#: C_6:1106
msgctxt "text_id=18468 | speaker=unknown"
msgid "　それまで遮断していた痛覚が、全身にあふれ出す。"
msgstr ""

#. Occurrence C_6:1111:18469: scene=C_6
#: C_6:1111
msgctxt "text_id=18469 | speaker=unknown"
msgid "　こんな事も初めてだった。"
msgstr ""

#. Occurrence C_6:1116:18470: scene=C_6
#: C_6:1116
msgctxt "text_id=18470 | speaker=unknown"
msgid "　今まで<人|カ><狼|レ>の体は痛覚すら制御してきた。"
msgstr ""

#. Occurrence C_6:1121:18471: scene=C_6
#: C_6:1121
msgctxt "text_id=18471 | speaker=unknown"
msgid "　そもそも悪寒など感じた事もなかった。"
msgstr ""

#. Occurrence C_6:1126:18472: scene=C_6
#: C_6:1126
msgctxt "text_id=18472 | speaker=unknown"
msgid "　精霊がいたのなら嘆いただろう。"
msgstr ""

#. Occurrence C_6:1131:18473: scene=C_6
#: C_6:1131
msgctxt "text_id=18473 | speaker=unknown"
msgid "　……ああ。生まれながら完成していたモノが、人の世の不条理に混乱している。"
msgstr ""

#. Occurrence C_6:1195:18474: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0011; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1195
msgctxt "text_id=18474 | speaker=beo"
msgid "“いた―――いたい、いたい、いたい―――！”"
msgstr ""

#. Occurrence C_6:1201:18475: scene=C_6
#: C_6:1201
msgctxt "text_id=18475 | speaker=unknown"
msgid "　心臓は完治している。"
msgstr ""

#. Occurrence C_6:1207:18476: scene=C_6
#: C_6:1207
msgctxt "text_id=18476 | speaker=unknown"
msgid "恐れからくる幻肢痛にあえぎながら、<人|カ><狼|レ>は震える体を抱きしめる。"
msgstr ""

#. Occurrence C_6:1213:18477: scene=C_6
#: C_6:1213
msgctxt "text_id=18477 | speaker=unknown"
msgid "　頭上にはレンズのような人間の目。"
msgstr ""

#. Occurrence C_6:1218:18478: scene=C_6
#: C_6:1218
msgctxt "text_id=18478 | speaker=unknown"
msgid "　それで、少年は自分が生きている理由をようやく悟った。"
msgstr ""

#. Occurrence C_6:1238:18479: scene=C_6
#: C_6:1238
msgctxt "text_id=18479 | speaker=unknown"
msgid "　たとえ両腕がなくても、残った足だけでこの相手は自分を殺せただろう。"
msgstr ""

#. Occurrence C_6:1243:18480: scene=C_6
#: C_6:1243
msgctxt "text_id=18480 | speaker=unknown"
msgid "　けれどそれはありえない。"
msgstr ""

#. Occurrence C_6:1248:18481: scene=C_6
#: C_6:1248
msgctxt "text_id=18481 | speaker=unknown"
msgid "　なぜなら、この相手は<た|・><だ|・><や|・><り|・><返|・><し|・><た|・><だ|・><け|・>なのだから。"
msgstr ""

#. Occurrence C_6:1254:18482: scene=C_6
#: C_6:1254
msgctxt "text_id=18482 | speaker=unknown"
msgid "　彼を殺そうとした狼に対しての反撃、ではない。"
msgstr ""

#. Occurrence C_6:1259:18483: scene=C_6
#: C_6:1259
msgctxt "text_id=18483 | speaker=unknown"
msgid "　これは彼女たちを傷つけた行為に対する、当然の報復だった。"
msgstr ""

#. Occurrence C_6:1301:18484: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0012; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1301
msgctxt "text_id=18484 | speaker=beo"
msgid "“―――、……、―――”"
msgstr ""

#. Occurrence C_6:1307:18485: scene=C_6
#: C_6:1307
msgctxt "text_id=18485 | speaker=unknown"
msgid "　おかしさから<喉|のど>がひきつる。"
msgstr ""

#. Occurrence C_6:1312:18486: scene=C_6
#: C_6:1312
msgctxt "text_id=18486 | speaker=unknown"
msgid "　呼吸はさっきから乱れっぱなし。"
msgstr ""

#. Occurrence C_6:1317:18487: scene=C_6
#: C_6:1317
msgctxt "text_id=18487 | speaker=unknown"
msgid "　この人間には自己がない。"
msgstr ""

#. Occurrence C_6:1323:18488: scene=C_6
#: C_6:1323
msgctxt "text_id=18488 | speaker=unknown"
msgid "立ち塞がった金狼を、己に向けられた脅威だと計りもしない。"
msgstr ""

#. Occurrence C_6:1328:18489: scene=C_6
#: C_6:1328
msgctxt "text_id=18489 | speaker=unknown"
msgid "　憎悪も恐怖も、おそらくは殺意すらなかったのはそういう事だ。"
msgstr ""

#. Occurrence C_6:1375:18490: scene=C_6
#: C_6:1375
msgctxt "text_id=18490 | speaker=unknown"
msgid "　―――そう。人狼が生かされているのは、この人間の意志によるものではない。"
msgstr ""

#. Occurrence C_6:1380:18491: scene=C_6
#: C_6:1380
msgctxt "text_id=18491 | speaker=unknown"
msgid "　戦いも機械的なら、その判断も機械的。"
msgstr ""

#. Occurrence C_6:1385:18492: scene=C_6
#: C_6:1385
msgctxt "text_id=18492 | speaker=unknown"
msgid "　この生き物はただ、<等|・><価|・><な|・><交|・><換|・><を|・><行|・><っ|・><た|・>だけなのだ。"
msgstr ""

#. Occurrence C_6:1390:18493: scene=C_6
#: C_6:1390
msgctxt "text_id=18493 | speaker=unknown"
msgid "　人狼が彼女たちを一人でも手に掛けていれば、この差し引きは違っただろう。"
msgstr ""

#. Occurrence C_6:1437:18494: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0013; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1437
msgctxt "text_id=18494 | speaker=beo"
msgid "“……殺していたら、殺されていた……？”"
msgstr ""

#. Occurrence C_6:1443:18495: scene=C_6
#: C_6:1443
msgctxt "text_id=18495 | speaker=unknown"
msgid "　その問いかけに、ぞくりとした。"
msgstr ""

#. Occurrence C_6:1448:18496: scene=C_6
#: C_6:1448
msgctxt "text_id=18496 | speaker=unknown"
msgid "　今まで考える事すらなかった恐れ。"
msgstr ""

#. Occurrence C_6:1453:18497: scene=C_6
#: C_6:1453
msgctxt "text_id=18497 | speaker=unknown"
msgid "　自分はその<規律|ルール>の外にいるのだと、当然のように思っていたのに―――！"
msgstr ""

#. Occurrence C_6:1516:18498: scene=C_6
#: C_6:1516
msgctxt "text_id=18498 | speaker=unknown"
msgid "　体中に痛みが走る。"
msgstr ""

#. Occurrence C_6:1521:18499: scene=C_6
#: C_6:1521
msgctxt "text_id=18499 | speaker=unknown"
msgid "　いかな神秘であろうと、傷つき、朽ちる事に例外はない。"
msgstr ""

#. Occurrence C_6:1526:18500: scene=C_6
#: C_6:1526
msgctxt "text_id=18500 | speaker=unknown"
msgid "　そんな当たり前の摂理を、少年はようやく思い知った。"
msgstr ""

#. Occurrence C_6:1531:18501: scene=C_6
#: C_6:1531
msgctxt "text_id=18501 | speaker=unknown"
msgid "　いや、思い知らされてしまった。"
msgstr ""

#. Occurrence C_6:1587:18502: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0014; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1587
msgctxt "text_id=18502 | speaker=beo"
msgid "“……殺されてた……間違いなく……”"
msgstr ""

#. Occurrence C_6:1593:18503: scene=C_6
#: C_6:1593
msgctxt "text_id=18503 | speaker=unknown"
msgid "　無機質な目は、感慨もなく見下ろしている。"
msgstr ""

#. Occurrence C_6:1598:18504: scene=C_6
#: C_6:1598
msgctxt "text_id=18504 | speaker=unknown"
msgid "　報復は万物に共通する摂理だ。"
msgstr ""

#. Occurrence C_6:1603:18505: scene=C_6
#: C_6:1603
msgctxt "text_id=18505 | speaker=unknown"
msgid "　それはもう痛いほどよく分かった。"
msgstr ""

#. Occurrence C_6:1609:18506: scene=C_6
#: C_6:1609
msgctxt "text_id=18506 | speaker=unknown"
msgid "　―――なのに。"
msgstr ""

msgctxt "text_id=18507 | speaker=unknown"
msgid "なのに。"
msgstr ""

msgctxt "text_id=18508 | speaker=unknown"
msgid "なのに。"
msgstr ""

#. Occurrence C_6:1619:18509: scene=C_6
#: C_6:1619
msgctxt "text_id=18509 | speaker=unknown"
msgid "　それを体現した生き物が、なにより、その決まりから外れているおぞましさ……！"
msgstr ""

#. Occurrence C_6:1695:18510: scene=C_6
#: C_6:1695
msgctxt "text_id=18510 | speaker=unknown"
msgid "　敗北の痛み、心臓の痛み、なにより、不可解を知った痛み。"
msgstr ""

#. Occurrence C_6:1700:18511: scene=C_6
#: C_6:1700
msgctxt "text_id=18511 | speaker=unknown"
msgid "　痛み、痛み、痛み。"
msgstr ""

#. Occurrence C_6:1719:18512: scene=C_6
#: C_6:1719
msgctxt "text_id=18512 | speaker=unknown"
msgid "　あり得ない出来事によって、完璧だった世界が崩れていく。"
msgstr ""

#. Occurrence C_6:1724:18513: scene=C_6
#: C_6:1724
msgctxt "text_id=18513 | speaker=unknown"
msgid "　それは全身を食い尽くす<茨|いばら>となって、少年の心柱を切断していった。"
msgstr ""

#. Occurrence C_6:1771:18514: scene=C_6
#: C_6:1771
msgctxt "text_id=18514 | speaker=unknown"
msgid "　　　　　　　目眩を起こすほどの疑問。"
msgstr ""

#. Occurrence C_6:1776:18515: scene=C_6
#: C_6:1776
msgctxt "text_id=18515 | speaker=unknown"
msgid "　　　ああ―――"
msgstr ""

#. Occurrence C_6:1782:18516: scene=C_6
#: C_6:1782
msgctxt "text_id=18516 | speaker=unknown"
msgid "人間は、<あ|・><ま|・><り|・><に|・><も|・><不|・><可|・><解|・><す|・><ぎ|・><る|・>。"
msgstr ""

#. Occurrence C_6:1822:18517: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0015; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1822
msgctxt "text_id=18517 | speaker=beo"
msgid "“……殺されてた。殺されてた、殺されてた……”"
msgstr ""

#. Occurrence C_6:1829:18518: scene=C_6
#: C_6:1829
msgctxt "text_id=18518 | speaker=unknown"
msgid "　他人の死に向けられたものではなく、己が生に対する<畏|おそ>れ。"
msgstr ""

#. Occurrence C_6:1834:18519: scene=C_6
#: C_6:1834
msgctxt "text_id=18519 | speaker=unknown"
msgid "　それに耐えられなくなって、<人|カ><狼|レ>は獣から人間に戻ってしまった。"
msgstr ""

#. Occurrence C_6:1839:18520: scene=C_6
#: C_6:1839
msgctxt "text_id=18520 | speaker=unknown"
msgid "　……静かに。"
msgstr ""

#. Occurrence C_6:1844:18521: scene=C_6
#: C_6:1844
msgctxt "text_id=18521 | speaker=unknown"
msgid "　母親の膝で<怯|おび>える子供のように、体を震わせながら。"
msgstr ""

#. Occurrence C_7:80:18522: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0000; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:80
msgctxt "text_id=18522 | speaker=aoko"
msgid "「な…………」"
msgstr ""

#. Occurrence C_7:86:18523: scene=C_7
#: C_7:86
msgctxt "text_id=18523 | speaker=unknown"
msgid "　倒れたまま、青子はつい声を飲んでしまった。"
msgstr ""

#. Occurrence C_7:91:18524: scene=C_7
#: C_7:91
msgctxt "text_id=18524 | speaker=unknown"
msgid "　正直、目の前で起こった事が把握できない。"
msgstr ""

#. Occurrence C_7:136:18525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0001; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:136
msgctxt "text_id=18525 | speaker=aoko"
msgid "「……草十郎、アンタ……」"
msgstr ""

#. Occurrence C_7:141:18526: scene=C_7
#: C_7:141
msgctxt "text_id=18526 | speaker=unknown"
msgid "　つい呼びかける声が震えてしまう。"
msgstr ""

#. Occurrence C_7:147:18527: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0000; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:147
msgctxt "text_id=18527 | speaker=soujuurou"
msgid "「なに？」"
msgstr ""

#. Occurrence C_7:168:18528: scene=C_7
#: C_7:168
msgctxt "text_id=18528 | speaker=unknown"
msgid "　草十郎はいつもの口調で、ごく自然に振り向いた。"
msgstr ""

#. Occurrence C_7:189:18529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0002; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:189
msgctxt "text_id=18529 | speaker=aoko"
msgid "「なにって……いま自分が何をしたか分かってんの！？」"
msgstr ""

#. Occurrence C_7:250:18530: scene=C_7
#: C_7:250
msgctxt "text_id=18530 | speaker=unknown"
msgid "　悪いのはアンタの方、と言わんばかりの怒鳴り声だった。"
msgstr ""

#. Occurrence C_7:260:18531: scene=C_7
#: C_7:260
msgctxt "text_id=18531 | speaker=unknown"
msgid "　草十郎は目を点にして、青子が怒るような事をしたかな、と考えこむ。"
msgstr ""

#. Occurrence C_7:298:18532: scene=C_7
#: C_7:298
msgctxt "text_id=18532 | speaker=unknown"
msgid "　視線を下に向けると、人狼は少年の姿に戻っていた。"
msgstr ""

#. Occurrence C_7:303:18533: scene=C_7
#: C_7:303
msgctxt "text_id=18533 | speaker=unknown"
msgid "　……青子はこの事を言っているんだろうか、とようやく気付いて、草十郎は不機嫌そうに眉をひそめた。"
msgstr ""

#. Occurrence C_7:339:18534: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0001; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:339
msgctxt "text_id=18534 | speaker=soujuurou"
msgid "「心外だな。蒼崎は分かってると思ってた」"
msgstr ""

#. Occurrence C_7:344:18535: scene=C_7
#: C_7:344
msgctxt "text_id=18535 | speaker=unknown"
msgid "　向けられる批難の目。"
msgstr ""

#. Occurrence C_7:350:18536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0003; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:350
msgctxt "text_id=18536 | speaker=aoko"
msgid "「え……わ、分かってるって、何をよ」"
msgstr ""

#. Occurrence C_7:355:18537: scene=C_7
#: C_7:355
msgctxt "text_id=18537 | speaker=unknown"
msgid "　非難される覚えはないので、青子もややつっけんどんに聞き返す。"
msgstr ""

#. Occurrence C_7:365:18538: scene=C_7
#: C_7:365
msgctxt "text_id=18538 | speaker=unknown"
msgid "　それに、草十郎は重いため息を洩らした。"
msgstr ""

#. Occurrence C_7:399:18539: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0002; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:399
msgctxt "text_id=18539 | speaker=soujuurou"
msgid "「山じゃ、熊はそう珍しいものじゃない。"
msgstr ""

#. Occurrence C_7:405:18540: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0003; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:405
msgctxt "text_id=18540 | speaker=soujuurou"
msgid "　以前、確かに言ったじゃないか」"
msgstr ""

#. Occurrence C_7:443:18541: scene=C_7
#: C_7:443
msgctxt "text_id=18541 | speaker=unknown"
msgid "「――――――"
msgstr ""

#. Occurrence C_7:452:18542: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0004; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:452
msgctxt "text_id=18542 | speaker=aoko"
msgid "は？」"
msgstr ""

#. Occurrence C_7:472:18543: scene=C_7
#: C_7:472
msgctxt "text_id=18543 | speaker=unknown"
msgid "　……開いた口が<塞|ふさ>がらない。"
msgstr ""

#. Occurrence C_7:477:18544: scene=C_7
#: C_7:477
msgctxt "text_id=18544 | speaker=unknown"
msgid "　今の言葉をそのままの意味として受け入れるのには、幾分かの時間を要した。"
msgstr ""

#. Occurrence C_7:497:18545: scene=C_7
#: C_7:497
msgctxt "text_id=18545 | speaker=unknown"
msgid "　青子はいつかの、他愛のないやりとりを思い出す。"
msgstr ""

#. Occurrence C_7:548:18546: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0004; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:548
msgctxt "text_id=18546 | speaker=soujuurou"
msgid "『……君、もしかして俺を罵迦にしているのか？"
msgstr ""

#. Occurrence C_7:554:18547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0005; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:554
msgctxt "text_id=18547 | speaker=soujuurou"
msgid "　まったく、なんで熊を倒すためなんかに修業しなくちゃいけないんだ』"
msgstr ""

#. Occurrence C_7:614:18548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0005; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:614
msgctxt "text_id=18548 | speaker=aoko"
msgid "「………………」"
msgstr ""

#. Occurrence C_7:619:18549: scene=C_7
#: C_7:619
msgctxt "text_id=18549 | speaker=unknown"
msgid "　そう。よくよく思い返してみると、アレはおかしな言い回しだったのだ。"
msgstr ""

#. Occurrence C_7:624:18550: scene=C_7
#: C_7:624
msgctxt "text_id=18550 | speaker=unknown"
msgid "　熊という巨獣に慣れていないと言えない台詞だし、"
msgstr ""

#. Occurrence C_7:629:18551: scene=C_7
#: C_7:629
msgctxt "text_id=18551 | speaker=unknown"
msgid "　そもそも何より、彼本人が“修業をしていた”なんて時代錯誤な言葉を否定していない。"
msgstr ""

#. Occurrence C_7:678:18552: scene=C_7
#: C_7:678
msgctxt "text_id=18552 | speaker=unknown"
msgid "　……と、なると。"
msgstr ""

#. Occurrence C_7:713:18553: scene=C_7
#: C_7:713
msgctxt "text_id=18553 | speaker=unknown"
msgid "　彼にとって、自分より大きな動物は珍しいものではなく。"
msgstr ""

#. Occurrence C_7:719:18554: scene=C_7
#: C_7:719
msgctxt "text_id=18554 | speaker=unknown"
msgid "　野生の熊と遭遇するような生活をしていたのなら、人間が狼になる程度、驚くことはあれ、恐れることはないのかもしれない。"
msgstr ""

#. Occurrence C_7:769:18555: scene=C_7
#: C_7:769
msgctxt "text_id=18555 | speaker=unknown"
msgid "　そこまで思い至って、青子は大きくうなだれた。"
msgstr ""

#. Occurrence C_7:774:18556: scene=C_7
#: C_7:774
msgctxt "text_id=18556 | speaker=unknown"
msgid "　初めから、いちばん常識から外れていたのは、一体誰だったのか―――"
msgstr ""

#. Occurrence C_7:795:18557: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0006; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:795
msgctxt "text_id=18557 | speaker=aoko"
msgid "「……まいったわ。貴方の勝ちよ、草十郎」"
msgstr ""

#. Occurrence C_7:819:18558: scene=C_7
#: C_7:819
msgctxt "text_id=18558 | speaker=unknown"
msgid "　感服したのか、それとも心底呆れたのか。"
msgstr ""

#. Occurrence C_7:824:18559: scene=C_7
#: C_7:824
msgctxt "text_id=18559 | speaker=unknown"
msgid "　とにかく肩の力をがっくりと落として、青子は自分にだけ聞こえるよう、そんな台詞を呟いた。"
msgstr ""

#. Occurrence C_8:74:18560: scene=C_8
#: C_8:74
msgctxt "text_id=18560 | speaker=unknown"
msgid "　一方、橙子は一連の出来事を正確に把握していた。"
msgstr ""

#. Occurrence C_8:79:18561: scene=C_8
#: C_8:79
msgctxt "text_id=18561 | speaker=unknown"
msgid "　倒れ<臥|ふ>し、人型になってしまったベオと、"
msgstr ""

#. Occurrence C_8:84:18562: scene=C_8
#: C_8:84
msgctxt "text_id=18562 | speaker=unknown"
msgid "　その傍らに立っている、両腕を粉砕した少年。"
msgstr ""

#. Occurrence C_8:104:18563: scene=C_8
#: C_8:104
msgctxt "text_id=18563 | speaker=unknown"
msgid "　人狼の一撃を受けて青子と有珠はまだ立ち上がれそうにないが、呼吸ができる程度には回復している。"
msgstr ""

#. Occurrence C_8:109:18564: scene=C_8
#: C_8:109
msgctxt "text_id=18564 | speaker=unknown"
msgid "　対して、自分に残された物はあと数刻……三、四回分のルーン文字だけである。"
msgstr ""

#. Occurrence C_8:129:18565: scene=C_8
#: C_8:129
msgctxt "text_id=18565 | speaker=unknown"
msgid "　背後の魔術刻印は使えない。"
msgstr ""

#. Occurrence C_8:134:18566: scene=C_8
#: C_8:134
msgctxt "text_id=18566 | speaker=unknown"
msgid "　刻印の残魔力量―――祖父を密閉している結界を解除すれば攻撃に回せるが、それは下策にすぎる。"
msgstr ""

#. Occurrence C_8:196:18567: scene=C_8
#: C_8:196
msgctxt "text_id=18567 | speaker=unknown"
msgid "　そもそも、いま祖父を解放すれば霊地の所有権は根こそぎ奪われる。"
msgstr ""

#. Occurrence C_8:201:18568: scene=C_8
#: C_8:201
msgctxt "text_id=18568 | speaker=unknown"
msgid "　ここで青子たちに勝利しても始めからやり直し―――なんて徒労は容認できないし、なにより、この姉妹喧嘩に二度目はない。"
msgstr ""

#. Occurrence C_8:206:18569: scene=C_8
#: C_8:206
msgctxt "text_id=18569 | speaker=unknown"
msgid "　一度きりの奇襲だからこそ、彼女は全ての資金を<費|つい>やしたのだ。"
msgstr ""

#. Occurrence C_8:262:18570: scene=C_8
#: C_8:262
msgctxt "text_id=18570 | speaker=unknown"
msgid "　自分がまだ蒼崎の身内である事を利用した侵攻。"
msgstr ""

#. Occurrence C_8:267:18571: scene=C_8
#: C_8:267
msgctxt "text_id=18571 | speaker=unknown"
msgid "　身を粉にして得た三年間の成果を協会に売り渡し、"
msgstr ""

#. Occurrence C_8:272:18572: scene=C_8
#: C_8:272
msgctxt "text_id=18572 | speaker=unknown"
msgid "　二十年分の髪を代償にし、新たな使い魔を動員した。"
msgstr ""

#. Occurrence C_8:278:18573: scene=C_8
#: C_8:278
msgctxt "text_id=18573 | speaker=unknown"
msgid "　この条件で戦える事など、おそらく二度とはありえまい。"
msgstr ""

#. Occurrence C_8:318:18574: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0000; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:318
msgctxt "text_id=18574 | speaker=touko"
msgid "“―――だが、私は失敗した”"
msgstr ""

#. Occurrence C_8:324:18575: scene=C_8
#: C_8:324
msgctxt "text_id=18575 | speaker=unknown"
msgid "　敗因は一点、人狼の力を絶対視しすぎていた事だ。"
msgstr ""

#. Occurrence C_8:329:18576: scene=C_8
#: C_8:329
msgctxt "text_id=18576 | speaker=unknown"
msgid "　本来、そこに間違いはない。"
msgstr ""

#. Occurrence C_8:334:18577: scene=C_8
#: C_8:334
msgctxt "text_id=18577 | speaker=unknown"
msgid "　相手が魔術師であるのなら黄金のベオウルフだけで完璧なまでに勝利できる。"
msgstr ""

#. Occurrence C_8:383:18578: scene=C_8
#: C_8:383
msgctxt "text_id=18578 | speaker=unknown"
msgid "　……ただ、そこに神風みたいなトラブルが紛れこんだ。"
msgstr ""

#. Occurrence C_8:389:18579: scene=C_8
#: C_8:389
msgctxt "text_id=18579 | speaker=unknown"
msgid "　ベオの強さは相性の強さだ。"
msgstr ""

#. Occurrence C_8:394:18580: scene=C_8
#: C_8:394
msgctxt "text_id=18580 | speaker=unknown"
msgid "　それを熟知しておきながら、なぜ、アレを食い物にできる例外もあると<留意|りゅうい>しなかったのか。"
msgstr ""

#. Occurrence C_8:414:18581: scene=C_8
#: C_8:414
msgctxt "text_id=18581 | speaker=unknown"
msgid "　橙子は冷えきった心で、立ち尽くす少年を凝視する。"
msgstr ""

#. Occurrence C_8:474:18582: scene=C_8
#: C_8:474
msgctxt "text_id=18582 | speaker=unknown"
msgid "　……草十郎の両腕は、ひどい事になっていた。"
msgstr ""

#. Occurrence C_8:480:18583: scene=C_8
#: C_8:480
msgctxt "text_id=18583 | speaker=unknown"
msgid "　正面からベオを打った左手は、腕のカタチをしていない。"
msgstr ""

#. Occurrence C_8:485:18584: scene=C_8
#: C_8:485
msgctxt "text_id=18584 | speaker=unknown"
msgid "　知恵の輪のように折れ曲がった骨と、はじけ散った筋肉繊維。<粉砕|ふんさい><骨折|こっせつ>と呼ぶのも馬鹿らしい。"
msgstr ""

#. Occurrence C_8:505:18585: scene=C_8
#: C_8:505
msgctxt "text_id=18585 | speaker=unknown"
msgid "　残った右腕も、肘に赤い血がにじみ出ている。"
msgstr ""

#. Occurrence C_8:510:18586: scene=C_8
#: C_8:510
msgctxt "text_id=18586 | speaker=unknown"
msgid "　ベオの背中を強打した肘は、その肩の筋組織まで破裂させたのだろう。"
msgstr ""

#. Occurrence C_8:545:18587: scene=C_8
#: C_8:545
msgctxt "text_id=18587 | speaker=unknown"
msgid "　……だらりと下がっている両腕を見ると、どちらも二度とは振るえまい。"
msgstr ""

#. Occurrence C_8:565:18588: scene=C_8
#: C_8:565
msgctxt "text_id=18588 | speaker=unknown"
msgid "　だが、より深い損傷を負っているのは彼の腕ではなく、内臓と左足だ。"
msgstr ""

#. Occurrence C_8:570:18589: scene=C_8
#: C_8:570
msgctxt "text_id=18589 | speaker=unknown"
msgid "　軸足となった草十郎の左足は、ベオの突進を支えたに等しい。"
msgstr ""

#. Occurrence C_8:576:18590: scene=C_8
#: C_8:576
msgctxt "text_id=18590 | speaker=unknown"
msgid "無事のように見えるが、あれはもう、ただ胴体に付いているだけの肉片だ。"
msgstr ""

#. Occurrence C_8:581:18591: scene=C_8
#: C_8:581
msgctxt "text_id=18591 | speaker=unknown"
msgid "　<内臓|なかみ>はもっと酷い。ベオの体重を受け止めた事で背骨は<軋|きし>み、所々が内出血をしている。"
msgstr ""

#. Occurrence C_8:631:18592: scene=C_8
#: C_8:631
msgctxt "text_id=18592 | speaker=unknown"
msgid "　つまり死に<体|たい>。"
msgstr ""

#. Occurrence C_8:636:18593: scene=C_8
#: C_8:636
msgctxt "text_id=18593 | speaker=unknown"
msgid "　あれは翼を失った鳥と同じ。"
msgstr ""

#. Occurrence C_8:641:18594: scene=C_8
#: C_8:641
msgctxt "text_id=18594 | speaker=unknown"
msgid "　生きる為のカタチを捨てた、終わった命。"
msgstr ""

#. Occurrence C_8:646:18595: scene=C_8
#: C_8:646
msgctxt "text_id=18595 | speaker=unknown"
msgid "　もう一度戦えば、彼に戦う<術|すべ>はない。"
msgstr ""

#. Occurrence C_8:692:18596: scene=C_8
#: C_8:692
msgctxt "text_id=18596 | speaker=unknown"
msgid "　対して、倒れている人狼に傷はない。"
msgstr ""

#. Occurrence C_8:697:18597: scene=C_8
#: C_8:697
msgctxt "text_id=18597 | speaker=unknown"
msgid "　口から吐いた<血咳|けっせき>は一度だけだ。"
msgstr ""

#. Occurrence C_8:702:18598: scene=C_8
#: C_8:702
msgctxt "text_id=18598 | speaker=unknown"
msgid "　雪原を染める赤い血は、草十郎だけが流している。"
msgstr ""

#. Occurrence C_8:707:18599: scene=C_8
#: C_8:707
msgctxt "text_id=18599 | speaker=unknown"
msgid "　あの鋼より硬い人狼の体毛を、躊躇する事なく殴り付けた証拠である。"
msgstr ""

#. Occurrence C_8:741:18600: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0001; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:741
msgctxt "text_id=18600 | speaker=touko"
msgid "“……当然だ。衝撃には反動が伴う。"
msgstr ""

#. Occurrence C_8:747:18601: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0002; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:747
msgctxt "text_id=18601 | speaker=touko"
msgid "　拳を振るうのなら相応の負担がある。まして相手は人狼。"
msgstr ""

#. Occurrence C_8:753:18602: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0003; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:753
msgctxt "text_id=18602 | speaker=touko"
msgid "　走ってくる鉄の壁を真っ向から殴るようなものだ。"
msgstr ""

#. Occurrence C_8:771:18603: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0004; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:771
msgctxt "text_id=18603 | speaker=touko"
msgid "　それを―――”"
msgstr ""

#. Occurrence C_8:801:18604: scene=C_8
#: C_8:801
msgctxt "text_id=18604 | speaker=unknown"
msgid "　承知の上で、平然と<行|おこな>ったのか。"
msgstr ""

#. Occurrence C_8:806:18605: scene=C_8
#: C_8:806
msgctxt "text_id=18605 | speaker=unknown"
msgid "　動物は自分の体を庇って、本能的に力を加減してしまう。"
msgstr ""

#. Occurrence C_8:811:18606: scene=C_8
#: C_8:811
msgctxt "text_id=18606 | speaker=unknown"
msgid "　それを理性の力、技術の<巧|たく>みで<補|おぎな>うのが人間の利点だとしたら、今のは人間の長所の結晶であり、同時に、あまりにも人間性からかけ離れている。"
msgstr ""

#. Occurrence C_8:843:18607: scene=C_8
#: C_8:843
msgctxt "text_id=18607 | speaker=unknown"
msgid "　自身の保存を顧みない、無償の一撃。"
msgstr ""

#. Occurrence C_8:848:18608: scene=C_8
#: C_8:848
msgctxt "text_id=18608 | speaker=unknown"
msgid "　自己保存の<楔|くさび>を外せば、その一撃は驚異的なものになるだろう。"
msgstr ""

#. Occurrence C_8:853:18609: scene=C_8
#: C_8:853
msgctxt "text_id=18609 | speaker=unknown"
msgid "　鋼の如き人狼の体毛を貫通したのはその結果だ。"
msgstr ""

#. Occurrence C_8:871:18610: scene=C_8
#: C_8:871
msgctxt "text_id=18610 | speaker=unknown"
msgid "　……けれど、人間程度の腕力で、戦車の砲撃にも耐えるあの怪物を倒せるなどとは誰が思おうか。"
msgstr ""

#. Occurrence C_8:915:18611: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0005; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:915
msgctxt "text_id=18611 | speaker=touko"
msgid "“……いや、違う。"
msgstr ""

#. Occurrence C_8:922:18612: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0006; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:922
msgctxt "text_id=18612 | speaker=touko"
msgid "ためらう事なく殴り付けたから壊れた、のではない。"
msgstr ""

#. Occurrence C_8:929:18613: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0007; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:929
msgctxt "text_id=18613 | speaker=touko"
msgid "初めから、アレは<壊|・><す|・><事|・><を|・><前|・><提|・><に|・><し|・><て|・>いたな……”"
msgstr ""

#. Occurrence C_8:962:18614: scene=C_8
#: C_8:962
msgctxt "text_id=18614 | speaker=unknown"
msgid "　身体を引き替えにした心臓撃ち。"
msgstr ""

#. Occurrence C_8:999:18615: scene=C_8
#: C_8:999
msgctxt "text_id=18615 | speaker=unknown"
msgid "　草十郎の狼退治を脳裏に再生した途端、橙子はぞくりとした感覚を味わった。"
msgstr ""

#. Occurrence C_8:1019:18616: scene=C_8
#: C_8:1019
msgctxt "text_id=18616 | speaker=unknown"
msgid "　彼女にとっては悪夢でしかない筈なのに、目を奪った人体合理の極北。"
msgstr ""

#. Occurrence C_8:1041:18617: scene=C_8
#: C_8:1041
msgctxt "text_id=18617 | speaker=unknown"
msgid "　門外漢である橙子に見えたものは、アレはわずかな偶然もふくまない、当然の帰結であるという事だけ。"
msgstr ""

#. Occurrence C_8:1046:18618: scene=C_8
#: C_8:1046
msgctxt "text_id=18618 | speaker=unknown"
msgid "　少年はあの瞬間―――ベオの胸板を貫く事だけに<専心|せんしん>していた。"
msgstr ""

#. Occurrence C_8:1090:18619: scene=C_8
#: C_8:1090
msgctxt "text_id=18619 | speaker=unknown"
msgid "　この広場に現れ、青子たちを視界に収めた時から。"
msgstr ""

#. Occurrence C_8:1095:18620: scene=C_8
#: C_8:1095
msgctxt "text_id=18620 | speaker=unknown"
msgid "　ベオを観察し、ベオと呼吸を合わせ、"
msgstr ""

#. Occurrence C_8:1100:18621: scene=C_8
#: C_8:1100
msgctxt "text_id=18621 | speaker=unknown"
msgid "　ベオの欠点、交差するのならどの位置が適切か、どのタイミングなら決して<覆|くつがえ>らない天秤が覆るのかを算出し。"
msgstr ""

#. Occurrence C_8:1122:18622: scene=C_8
#: C_8:1122
msgctxt "text_id=18622 | speaker=unknown"
msgid "　<こ|・><の|・><条|・><件|・>なら勝機があると読み、そうなるように、自身の全てを費やした。"
msgstr ""

#. Occurrence C_8:1142:18623: scene=C_8
#: C_8:1142
msgctxt "text_id=18623 | speaker=unknown"
msgid "　……それは、野生の感性などでは決してない。"
msgstr ""

#. Occurrence C_8:1148:18624: scene=C_8
#: C_8:1148
msgctxt "text_id=18624 | speaker=unknown"
msgid "　野生の獣なら、勝てない相手には挑まない。"
msgstr ""

#. Occurrence C_8:1168:18625: scene=C_8
#: C_8:1168
msgctxt "text_id=18625 | speaker=unknown"
msgid "　勝ち目のない戦いに命を賭すのは、人間だけの矛盾である。"
msgstr ""

#. Occurrence C_8:1226:18626: scene=C_8
#: C_8:1226
msgctxt "text_id=18626 | speaker=unknown"
msgid "　その矛盾が、あの一撃を練りあげた。"
msgstr ""

#. Occurrence C_8:1231:18627: scene=C_8
#: C_8:1231
msgctxt "text_id=18627 | speaker=unknown"
msgid "　全身の円運動、<踝|かかと>から首までの捻りだしを、<錐|きり>状にして集結させた。"
msgstr ""

#. Occurrence C_8:1236:18628: scene=C_8
#: C_8:1236
msgctxt "text_id=18628 | speaker=unknown"
msgid "　……あるいは、ベオが突進による<轢殺|れきさつ>を目的としたのなら、草十郎は為す術なくひき殺されていただろう。"
msgstr ""

#. Occurrence C_8:1241:18629: scene=C_8
#: C_8:1241
msgctxt "text_id=18629 | speaker=unknown"
msgid "　だがベオは相手を引き裂く事を選んだ。"
msgstr ""

#. Occurrence C_8:1247:18630: scene=C_8
#: C_8:1247
msgctxt "text_id=18630 | speaker=unknown"
msgid "いや、安い挑発で選ばされた。"
msgstr ""

#. Occurrence C_8:1311:18631: scene=C_8
#: C_8:1311
msgctxt "text_id=18631 | speaker=unknown"
msgid "　金狼が突進し、踏みこむ瞬間。"
msgstr ""

#. Occurrence C_8:1333:18632: scene=C_8
#: C_8:1333
msgctxt "text_id=18632 | speaker=unknown"
msgid "　爪を振り上げ、下ろす時の<気勢|いしき>の淀み。"
msgstr ""

#. Occurrence C_8:1364:18633: scene=C_8
#: C_8:1364
msgctxt "text_id=18633 | speaker=unknown"
msgid "　運動の基点、脈拍の乱れ、一瞬の無防備さ。"
msgstr ""

#. Occurrence C_8:1385:18634: scene=C_8
#: C_8:1385
msgctxt "text_id=18634 | speaker=unknown"
msgid "　彼が突いたのはその一点だ。"
msgstr ""

#. Occurrence C_8:1391:18635: scene=C_8
#: C_8:1391
msgctxt "text_id=18635 | speaker=unknown"
msgid "　力を持て余し、ただ周囲にまき散らすだけの怪物と。"
msgstr ""

#. Occurrence C_8:1396:18636: scene=C_8
#: C_8:1396
msgctxt "text_id=18636 | speaker=unknown"
msgid "　数少ない力を<束|たば>ね、極小の一点に注ぎこむ人間の執念。"
msgstr ""

#. Occurrence C_8:1401:18637: scene=C_8
#: C_8:1401
msgctxt "text_id=18637 | speaker=unknown"
msgid "　その差が、天秤を人間に<傾|かたむ>けた。"
msgstr ""

#. Occurrence C_8:1446:18638: scene=C_8
#: C_8:1446
msgctxt "text_id=18638 | speaker=unknown"
msgid "　その後、あの<無様|ぶざま>な肘撃ちでベオの心臓は破裂した。"
msgstr ""

#. Occurrence C_8:1451:18639: scene=C_8
#: C_8:1451
msgctxt "text_id=18639 | speaker=unknown"
msgid "　二撃目の肘撃ちには何の美しさもない。"
msgstr ""

#. Occurrence C_8:1456:18640: scene=C_8
#: C_8:1456
msgctxt "text_id=18640 | speaker=unknown"
msgid "　力まかせの、ベオと大差ない未熟な攻撃だった。"
msgstr ""

#. Occurrence C_8:1461:18641: scene=C_8
#: C_8:1461
msgctxt "text_id=18641 | speaker=unknown"
msgid "　本来ならベオの体毛に弾かれるだけの肘撃ちを致命傷たらしめたのは、最初の一撃があってこそ。"
msgstr ""

#. Occurrence C_8:1495:18642: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0008; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1495
msgctxt "text_id=18642 | speaker=touko"
msgid "“……あの時点でベオは丸裸にされていた。"
msgstr ""

#. Occurrence C_8:1501:18643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0009; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1501
msgctxt "text_id=18643 | speaker=touko"
msgid "　無敵の人狼が、その機能の一切を休止させられた。"
msgstr ""

#. Occurrence C_8:1507:18644: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0010; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1507
msgctxt "text_id=18644 | speaker=touko"
msgid "　つまり―――”"
msgstr ""

#. Occurrence C_8:1570:18645: scene=C_8
#: C_8:1570
msgctxt "text_id=18645 | speaker=unknown"
msgid "　アレは『壊す』のではなく、『止める』ための芸術だ。"
msgstr ""

#. Occurrence C_8:1611:18646: scene=C_8
#: C_8:1611
msgctxt "text_id=18646 | speaker=unknown"
msgid "　生物には欠点がある。"
msgstr ""

#. Occurrence C_8:1640:18647: scene=C_8
#: C_8:1640
msgctxt "text_id=18647 | speaker=unknown"
msgid "　どのような強者であれ、弱い部分、弱い瞬間、弱い時間は存在する。"
msgstr ""

#. Occurrence C_8:1645:18648: scene=C_8
#: C_8:1645
msgctxt "text_id=18648 | speaker=unknown"
msgid "　それは<生態機能|フィジカル>だけに及ばず、<精神|メンタル>にもある落とし穴だ。"
msgstr ""

#. Occurrence C_8:1665:18649: scene=C_8
#: C_8:1665
msgctxt "text_id=18649 | speaker=unknown"
msgid "　曰く、調子が悪い。"
msgstr ""

#. Occurrence C_8:1670:18650: scene=C_8
#: C_8:1670
msgctxt "text_id=18650 | speaker=unknown"
msgid "　思考が冴えない、気分が乗らない。"
msgstr ""

#. Occurrence C_8:1675:18651: scene=C_8
#: C_8:1675
msgctxt "text_id=18651 | speaker=unknown"
msgid "　<病|やまい>、睡眠、食事、最小単位で言うのなら呼吸の隙間。"
msgstr ""

#. Occurrence C_8:1681:18652: scene=C_8
#: C_8:1681
msgctxt "text_id=18652 | speaker=unknown"
msgid "　多くの理由から、理性あるものはその力を十全に発揮できない危険がある。"
msgstr ""

#. Occurrence C_8:1686:18653: scene=C_8
#: C_8:1686
msgctxt "text_id=18653 | speaker=unknown"
msgid "　いかな神話の獣と言えど、ヒトであるかぎりその縛りからは逃れられない。"
msgstr ""

#. Occurrence C_8:1746:18654: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0011; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1746
msgctxt "text_id=18654 | speaker=touko"
msgid "“……弱点、欠点を突く魔術なら知っているが―――全てを投げうって<弱|・><点|・><を|・><生|・><む|・>とはな”"
msgstr ""

#. Occurrence C_8:1786:18655: scene=C_8
#: C_8:1786
msgctxt "text_id=18655 | speaker=unknown"
msgid "　あの少年の心臓撃ちは、ベオを殺す目的で撃たれたものではない。"
msgstr ""

#. Occurrence C_8:1791:18656: scene=C_8
#: C_8:1791
msgctxt "text_id=18656 | speaker=unknown"
msgid "　アレは弱点がないものに、弱点を作っただけ。"
msgstr ""

#. Occurrence C_8:1796:18657: scene=C_8
#: C_8:1796
msgctxt "text_id=18657 | speaker=unknown"
msgid "　その後の肘撃ちが力任せでありながらベオを粉砕したのは、既にベオが己の完全性を見失っていたからだ。"
msgstr ""

#. Occurrence C_8:1858:18658: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0012; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1858
msgctxt "text_id=18658 | speaker=touko"
msgid "“……加えて、笑える事に不意打ちですらない。"
msgstr ""

#. Occurrence C_8:1864:18659: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0013; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1864
msgctxt "text_id=18659 | speaker=touko"
msgid "　ベオの神経の伝達速度なら、毒が当たった瞬間に感知し、対応できる。"
msgstr ""

#. Occurrence C_8:1875:18660: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0014; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1875
msgctxt "text_id=18660 | speaker=touko"
msgid "　だが―――そもそも、それを毒と認識できなければ変形のしようもない。"
msgstr ""

#. Occurrence C_8:1882:18661: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0015; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1882
msgctxt "text_id=18661 | speaker=touko"
msgid "<毒|・><で|・><は|・><な|・><い|・><も|・><の|・><が|・><毒|・><に|・><な|・><る|・>なんて落とし穴を、誰が教えてやれるものか―――”"
msgstr ""

#. Occurrence C_8:1930:18662: scene=C_8
#: C_8:1930
msgctxt "text_id=18662 | speaker=unknown"
msgid "　舌打ちの一つもしたくなる。"
msgstr ""

#. Occurrence C_8:1935:18663: scene=C_8
#: C_8:1935
msgctxt "text_id=18663 | speaker=unknown"
msgid "　アレは究極の<献身|けんしん>。もしくは<捨身|しゃしん>。"
msgstr ""

#. Occurrence C_8:1940:18664: scene=C_8
#: C_8:1940
msgctxt "text_id=18664 | speaker=unknown"
msgid "　見返りを一切考えず、たった一秒の空白を作り上げる為だけに己の全てを賭した。"
msgstr ""

#. Occurrence C_8:1945:18665: scene=C_8
#: C_8:1945
msgctxt "text_id=18665 | speaker=unknown"
msgid "　それが出来る技量と経験を、あの少年は持っていたのだ。"
msgstr ""

#. Occurrence C_8:1965:18666: scene=C_8
#: C_8:1965
msgctxt "text_id=18666 | speaker=unknown"
msgid "　奇跡を呼ぶ幸運も、"
msgstr ""

#. Occurrence C_8:1970:18667: scene=C_8
#: C_8:1970
msgctxt "text_id=18667 | speaker=unknown"
msgid "　奇跡を掴む情熱も、あの行為には関わりがない。"
msgstr ""

#. Occurrence C_8:1998:18668: scene=C_8
#: C_8:1998
msgctxt "text_id=18668 | speaker=unknown"
msgid "　アレは才能によるものではなく、執念、怨念の<類|たぐい>。"
msgstr ""

#. Occurrence C_8:2004:18669: scene=C_8
#: C_8:2004
msgctxt "text_id=18669 | speaker=unknown"
msgid "　過度の、極限状態での<鍛練|くりかえし>でなければ、あんな、一瞬で自身を焼却するような真似はできない。"
msgstr ""

#. Occurrence C_8:2025:18670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0016; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2025
msgctxt "text_id=18670 | speaker=touko"
msgid "“……子供には、相手が悪かったようね”"
msgstr ""

#. Occurrence C_8:2048:18671: scene=C_8
#: C_8:2048
msgctxt "text_id=18671 | speaker=unknown"
msgid "　うずくまるベオを見て、橙子は自身の甘さに失望した。"
msgstr ""

#. Occurrence C_8:2053:18672: scene=C_8
#: C_8:2053
msgctxt "text_id=18672 | speaker=unknown"
msgid "　性能のみを評価して連れてきたが、経験の少なさがこの結果を生んだのだ。"
msgstr ""

#. Occurrence C_8:2058:18673: scene=C_8
#: C_8:2058
msgctxt "text_id=18673 | speaker=unknown"
msgid "　ベオが子供でなければ、せめて一度でも自分と対等の相手と命を削りあう経験があったのなら、すぐさま立ち上がって草十郎を食い殺していただろうに。"
msgstr ""

#. Occurrence C_8:2090:18674: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0017; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2090
msgctxt "text_id=18674 | speaker=touko"
msgid "“ベオを責めるべきか、それとも……君を評価すべきなのか”"
msgstr ""

#. Occurrence C_8:2098:18675: scene=C_8
#: C_8:2098
msgctxt "text_id=18675 | speaker=unknown"
msgid "　そして、彼女は静かに左手を持ち上げる。"
msgstr ""

#. Occurrence C_8:2118:18676: scene=C_8
#: C_8:2118
msgctxt "text_id=18676 | speaker=unknown"
msgid "　気が付く者は一人もいなかった。"
msgstr ""

#. Occurrence C_8:2138:18677: scene=C_8
#: C_8:2138
msgctxt "text_id=18677 | speaker=unknown"
msgid "　遠くで立つ少年の姿は、絵本の狩人に見えた。"
msgstr ""

#. Occurrence C_8:2143:18678: scene=C_8
#: C_8:2143
msgctxt "text_id=18678 | speaker=unknown"
msgid "　細い肉付きだが、アレは意図的に無駄を削ぎ落とされた結果だろう。"
msgstr ""

#. Occurrence C_8:2148:18679: scene=C_8
#: C_8:2148
msgctxt "text_id=18679 | speaker=unknown"
msgid "　今の光景の後だと、その<飄然|ひょうぜん>とした仕草も、獲物を狙う獣のしなやかさを思わせる。"
msgstr ""

#. Occurrence C_8:2153:18680: scene=C_8
#: C_8:2153
msgctxt "text_id=18680 | speaker=unknown"
msgid "　それを感じながら、橙子は不意に思い出した。"
msgstr ""

#. Occurrence C_8:2158:18681: scene=C_8
#: C_8:2158
msgctxt "text_id=18681 | speaker=unknown"
msgid "　自分が彼と初めて話をした時、まっさきに脳裏によぎった事柄を。"
msgstr ""

#. Occurrence C_8:2179:18682: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0018; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2179
msgctxt "text_id=18682 | speaker=touko"
msgid "“……そうだったな。"
msgstr ""

#. Occurrence C_8:2185:18683: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0019; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2185
msgctxt "text_id=18683 | speaker=touko"
msgid "　だが、それは忘れていたかったよ、草十郎君”"
msgstr ""

#. Occurrence C_8:2227:18684: scene=C_8
#: C_8:2227
msgctxt "text_id=18684 | speaker=unknown"
msgid "　自分らしからぬ感傷を、鉄の理性が飲み下す。"
msgstr ""

#. Occurrence C_8:2232:18685: scene=C_8
#: C_8:2232
msgctxt "text_id=18685 | speaker=unknown"
msgid "　手段の善悪など、蒼崎の後継ぎとして育てられた時に消失している。"
msgstr ""

#. Occurrence C_8:2237:18686: scene=C_8
#: C_8:2237
msgctxt "text_id=18686 | speaker=unknown"
msgid "　だから、今からでも。"
msgstr ""

#. Occurrence C_8:2242:18687: scene=C_8
#: C_8:2242
msgctxt "text_id=18687 | speaker=unknown"
msgid "　彼女のやるべき行為は、たった一つに決まっていた。"
msgstr ""

#. Occurrence C_9:56:18688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0000; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:56
msgctxt "text_id=18688 | speaker=soujuurou"
msgid "「でも、よかった」"
msgstr ""

#. Occurrence C_9:62:18689: scene=C_9
#: C_9:62
msgctxt "text_id=18689 | speaker=unknown"
msgid "　折れた両腕が痛むのか、草十郎は一歩も動かずに、そんな事を呟いた。"
msgstr ""

#. Occurrence C_9:125:18690: scene=C_9
#: C_9:125
msgctxt "text_id=18690 | speaker=unknown"
msgid "　彼は青子を見ていない。"
msgstr ""

#. Occurrence C_9:130:18691: scene=C_9
#: C_9:130
msgctxt "text_id=18691 | speaker=unknown"
msgid "　労りのこもった視線は、遠くの有珠に向けられている。"
msgstr ""

#. Occurrence C_9:135:18692: scene=C_9
#: C_9:135
msgctxt "text_id=18692 | speaker=unknown"
msgid "　どうしてか、その姿が孤独に見えて、"
msgstr ""

#. Occurrence C_9:142:18693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0000; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:142
msgctxt "text_id=18693 | speaker=aoko"
msgid "「よかったって、なにがよ」"
msgstr ""

#. Occurrence C_9:148:18694: scene=C_9
#: C_9:148
msgctxt "text_id=18694 | speaker=unknown"
msgid "　焚きつけるように、青子はそう問いかけた。"
msgstr ""

#. Occurrence C_9:168:18695: scene=C_9
#: C_9:168
msgctxt "text_id=18695 | speaker=unknown"
msgid "　ふたりの距離は離れてはいるが、互いが二歩も踏みだせば手が届く距離でもあった。"
msgstr ""

#. Occurrence C_9:173:18696: scene=C_9
#: C_9:173
msgctxt "text_id=18696 | speaker=unknown"
msgid "　小さな声も、この静けさではよく届く。"
msgstr ""

#. Occurrence C_9:197:18697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0001; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:197
msgctxt "text_id=18697 | speaker=aoko"
msgid "「私たちが無事だったから、なんて言ったら怒るわよ」"
msgstr ""

#. Occurrence C_9:236:18698: scene=C_9
#: C_9:236
msgctxt "text_id=18698 | speaker=unknown"
msgid "　本心から青子は言う。"
msgstr ""

#. Occurrence C_9:241:18699: scene=C_9
#: C_9:241
msgctxt "text_id=18699 | speaker=unknown"
msgid "　草十郎は青子から少しだけ顔を背けて、いや、と首を振った。"
msgstr ""

#. Occurrence C_9:279:18700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0001; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:279
msgctxt "text_id=18700 | speaker=soujuurou"
msgid "「口にするのは三度目だけど、蒼崎の心配はしていないんだ。"
msgstr ""

#. Occurrence C_9:285:18701: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0002; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:285
msgctxt "text_id=18701 | speaker=soujuurou"
msgid "　……いや、さっきはちょっと、意識が飛んだようなんだけど」"
msgstr ""

#. Occurrence C_9:310:18702: scene=C_9
#: C_9:310
msgctxt "text_id=18702 | speaker=unknown"
msgid "　照れくさそうに苦笑する。"
msgstr ""

#. Occurrence C_9:315:18703: scene=C_9
#: C_9:315
msgctxt "text_id=18703 | speaker=unknown"
msgid "　一度目は目眩で意識を失った。けれど、二度目は目眩も吐き気も、強い激情でかき消された。"
msgstr ""

#. Occurrence C_9:320:18704: scene=C_9
#: C_9:320
msgctxt "text_id=18704 | speaker=unknown"
msgid "　彼は彼なりに冷静に、やれる事に<努|つと>めただけ。"
msgstr ""

#. Occurrence C_9:325:18705: scene=C_9
#: C_9:325
msgctxt "text_id=18705 | speaker=unknown"
msgid "　ただ、どんなに冷静になろうとしたところで、その根底にあったものは、自分本意な怒りだったのだ。"
msgstr ""

#. Occurrence C_9:365:18706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0002; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:365
msgctxt "text_id=18706 | speaker=aoko"
msgid "「ふーん……じゃ、何がよかったのよ、草十郎」"
msgstr ""

#. Occurrence C_9:370:18707: scene=C_9
#: C_9:370
msgctxt "text_id=18707 | speaker=unknown"
msgid "　やや不満そうな青子の声。"
msgstr ""

#. Occurrence C_9:375:18708: scene=C_9
#: C_9:375
msgctxt "text_id=18708 | speaker=unknown"
msgid "　それに、"
msgstr ""

#. Occurrence C_9:396:18709: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0003; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:396
msgctxt "text_id=18709 | speaker=soujuurou"
msgid "「だって、ようやく約束が守れた。そっちだけが約束を守っているのに、こっちは果たせなかっただろ。"
msgstr ""

#. Occurrence C_9:402:18710: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0004; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:402
msgctxt "text_id=18710 | speaker=soujuurou"
msgid "　それがずっと気になっていたんだ。その機会があって、本当によかった」"
msgstr ""

#. Occurrence C_9:424:18711: scene=C_9
#: C_9:424
msgctxt "text_id=18711 | speaker=unknown"
msgid "　彼は本当に嬉しそうに、ささやかな笑顔を浮かべた。"
msgstr ""

#. Occurrence C_9:506:18712: scene=C_9
#: C_9:506
msgctxt "text_id=18712 | speaker=unknown"
msgid "　青子は呆然とその言葉を聞いている。"
msgstr ""

#. Occurrence C_9:523:18713: scene=C_9
#: C_9:523
msgctxt "text_id=18713 | speaker=unknown"
msgid "　一瞬、草十郎の言う約束とは何なのか、彼女には思い当たらなかった。"
msgstr ""

#. Occurrence C_9:528:18714: scene=C_9
#: C_9:528
msgctxt "text_id=18714 | speaker=unknown"
msgid "　それがもう遥か昔の出来事のような、遊園地でのものと気付いた時、思考が真っ白になってしまった。"
msgstr ""

#. Occurrence C_9:571:18715: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0005; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:571
msgctxt "text_id=18715 | speaker=soujuurou"
msgid "『アイツをやっつけるのに協力したら、俺の事は見逃してくれる？』"
msgstr ""

#. Occurrence C_9:577:18716: scene=C_9
#: C_9:577
msgctxt "text_id=18716 | speaker=unknown"
msgid "　自分から提案を持ちだしたものの、結局、あまり役には立てなかった。"
msgstr ""

#. Occurrence C_9:582:18717: scene=C_9
#: C_9:582
msgctxt "text_id=18717 | speaker=unknown"
msgid "　それを彼はずっと気に病んでいたのだろう。"
msgstr ""

#. Occurrence C_9:613:18718: scene=C_9
#: C_9:613
msgctxt "text_id=18718 | speaker=unknown"
msgid "　……青子にとってあの約束は、自分だけの<約|も><束|の>だと思っていたのに。"
msgstr ""

#. Occurrence C_9:664:18719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0003; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:664
msgctxt "text_id=18719 | speaker=aoko"
msgid "「……あんな、どうでもいい事を……？」"
msgstr ""

#. Occurrence C_9:670:18720: scene=C_9
#: C_9:670
msgctxt "text_id=18720 | speaker=unknown"
msgid "　信じられない、と呟く青子。"
msgstr ""

#. Occurrence C_9:675:18721: scene=C_9
#: C_9:675
msgctxt "text_id=18721 | speaker=unknown"
msgid "　か細いその声に、草十郎はああ、とうなずいた。"
msgstr ""

#. Occurrence C_9:696:18722: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0006; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:696
msgctxt "text_id=18722 | speaker=soujuurou"
msgid "「約束は、自分のために果たすものだって、教えてくれたのは蒼崎だ。"
msgstr ""

#. Occurrence C_9:724:18723: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0007; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:724
msgctxt "text_id=18723 | speaker=soujuurou"
msgid "　だから、君が守っているかぎり俺も守らないといけない。"
msgstr ""

#. Occurrence C_9:735:18724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0008; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:735
msgctxt "text_id=18724 | speaker=soujuurou"
msgid "　……ああ。ずっと、俺はそうしたかったんだ」"
msgstr ""

#. Occurrence C_9:777:18725: scene=C_9
#: C_9:777
msgctxt "text_id=18725 | speaker=unknown"
msgid "　告解のような独白に、青子は答えない。"
msgstr ""

#. Occurrence C_9:782:18726: scene=C_9
#: C_9:782
msgctxt "text_id=18726 | speaker=unknown"
msgid "　返答する言葉が見当たらない。"
msgstr ""

#. Occurrence C_9:787:18727: scene=C_9
#: C_9:787
msgctxt "text_id=18727 | speaker=unknown"
msgid "　……何なんだろう、この男は。"
msgstr ""

#. Occurrence C_9:792:18728: scene=C_9
#: C_9:792
msgctxt "text_id=18728 | speaker=unknown"
msgid "　あんな些細な約束を大事に思って、こんな簡単な言葉を大切そうに口にして。"
msgstr ""

#. Occurrence C_9:812:18729: scene=C_9
#: C_9:812
msgctxt "text_id=18729 | speaker=unknown"
msgid "　人狼を倒してしまった事も謎なら、その性格も謎だらけだ。"
msgstr ""

#. Occurrence C_9:817:18730: scene=C_9
#: C_9:817
msgctxt "text_id=18730 | speaker=unknown"
msgid "　―――いまさら思い返すまでもなく。"
msgstr ""

#. Occurrence C_9:822:18731: scene=C_9
#: C_9:822
msgctxt "text_id=18731 | speaker=unknown"
msgid "　少なくとも蒼崎青子にとって、この相手は<徹頭|てっとう><徹尾|てつび>、正体不明の存在なのだった。"
msgstr ""

#. Occurrence C_9:854:18732: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0009; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:854
msgctxt "text_id=18732 | speaker=soujuurou"
msgid "「それじゃ、借りは返したから帳尻はゼロだ。"
msgstr ""

#. Occurrence C_9:860:18733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0010; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:860
msgctxt "text_id=18733 | speaker=soujuurou"
msgid "　これで貸し借りはなしだぞ、蒼崎」"
msgstr ""

#. Occurrence C_9:866:18734: scene=C_9
#: C_9:866
msgctxt "text_id=18734 | speaker=unknown"
msgid "　草十郎は冗談っぽく口にする。"
msgstr ""

#. Occurrence C_9:871:18735: scene=C_9
#: C_9:871
msgctxt "text_id=18735 | speaker=unknown"
msgid "　無言で沈みこむ青子に気を利かせたのだろう。"
msgstr ""

#. Occurrence C_9:876:18736: scene=C_9
#: C_9:876
msgctxt "text_id=18736 | speaker=unknown"
msgid "　いつもは気が付かないけれど、今回ばかりは、彼のそんな穏やかな優しさは伝わったようだ。"
msgstr ""

#. Occurrence C_9:922:18737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0004; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:922
msgctxt "text_id=18737 | speaker=aoko"
msgid "「貸しがついたのはこっちの方よ。"
msgstr ""

#. Occurrence C_9:929:18738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0005; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:929
msgctxt "text_id=18738 | speaker=aoko"
msgid "……これじゃ、どうやって返していいか分からないじゃない」"
msgstr ""

#. Occurrence C_9:935:18739: scene=C_9
#: C_9:935
msgctxt "text_id=18739 | speaker=unknown"
msgid "　青子のぼやきに、草十郎はもう一度、ああ、と嬉しげに頷いた。"
msgstr ""

#. Occurrence C_9:971:18740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0011; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:971
msgctxt "text_id=18740 | speaker=soujuurou"
msgid "「それより蒼崎の足、なんか<塞|ふさ>がってるな。"
msgstr ""

#. Occurrence C_9:988:18741: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0012; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:988
msgctxt "text_id=18741 | speaker=soujuurou"
msgid "　もしかして、もう立てるのか？」"
msgstr ""

#. Occurrence C_9:994:18742: scene=C_9
#: C_9:994
msgctxt "text_id=18742 | speaker=unknown"
msgid "　あったりまえよ、と青子は目で意地を張る。"
msgstr ""

#. Occurrence C_9:1008:18743: scene=C_9
#: C_9:1008
msgctxt "text_id=18743 | speaker=unknown"
msgid "　その気丈さに呆れながら、草十郎は右手を差し伸べた。"
msgstr ""

#. Occurrence C_9:1030:18744: scene=C_9
#: C_9:1030
msgctxt "text_id=18744 | speaker=unknown"
msgid "　肘が砕けているのに、青子にはその右手は何より頑丈そうに見えた。"
msgstr ""

#. Occurrence C_9:1035:18745: scene=C_9
#: C_9:1035
msgctxt "text_id=18745 | speaker=unknown"
msgid "　どう見ても再起不能。おそらくは<一生涯|いっしょうがい><完治|かんち>しまい。"
msgstr ""

#. Occurrence C_9:1040:18746: scene=C_9
#: C_9:1040
msgctxt "text_id=18746 | speaker=unknown"
msgid "　それでも青子を立たせる為なら、その時だけは痛まないのだろう。"
msgstr ""

#. Occurrence C_9:1061:18747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0006; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1061
msgctxt "text_id=18747 | speaker=aoko"
msgid "「……ほんと、アンタってばか」"
msgstr ""

#. Occurrence C_9:1070:18748: scene=C_9
#: C_9:1070
msgctxt "text_id=18748 | speaker=unknown"
msgid "　見上げながら青子は小さく呟いた。"
msgstr ""

#. Occurrence C_9:1075:18749: scene=C_9
#: C_9:1075
msgctxt "text_id=18749 | speaker=unknown"
msgid "　悔しいけれど、今はその手を拒めそうにない。"
msgstr ""

#. Occurrence C_9:1080:18750: scene=C_9
#: C_9:1080
msgctxt "text_id=18750 | speaker=unknown"
msgid "　青子は仕方なげに、草十郎の手を取ろうと手を伸ばす。"
msgstr ""

#. Occurrence C_9:1117:18751: scene=C_9
#: C_9:1117
msgctxt "text_id=18751 | speaker=unknown"
msgid "　けれど、その手が触れ合う事はなかった。"
msgstr ""

#. Occurrence C_9:1127:18752: scene=C_9
#: C_9:1127
msgctxt "text_id=18752 | speaker=unknown"
msgid "　しゃん、と鈴を鳴らす音。"
msgstr ""

#. Occurrence C_9:1144:18753: scene=C_9
#: C_9:1144
msgctxt "text_id=18753 | speaker=unknown"
msgid "　風は線を引いて走った。"
msgstr ""

#. Occurrence C_9:1149:18754: scene=C_9
#: C_9:1149
msgctxt "text_id=18754 | speaker=unknown"
msgid "　断頭台の刃は、胴体を裂くように横なぐりに。"
msgstr ""

#. Occurrence C_9:1189:18755: scene=C_9
#: C_9:1189
msgctxt "text_id=18755 | speaker=unknown"
msgid "　あっけなく崩れ落ちる。"
msgstr ""

#. Occurrence C_9:1196:18756: scene=C_9
#: C_9:1196
msgctxt "text_id=18756 | speaker=unknown"
msgid "　目の前に落ちた<物|モ><体|ノ>が一秒前まで誰だったか、彼女はすぐに、思い出せなかった。"
msgstr ""

#. Occurrence C_9:1234:18757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0007; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1234
msgctxt "text_id=18757 | speaker=aoko"
msgid "「そう……じゅうろう……？」"
msgstr ""

#. Occurrence C_9:1254:18758: scene=C_9
#: C_9:1254
msgctxt "text_id=18758 | speaker=unknown"
msgid "　自分と同じく地に臥した、そう呼ばれていた物に青子は語りかけた。"
msgstr ""

#. Occurrence C_9:1259:18759: scene=C_9
#: C_9:1259
msgctxt "text_id=18759 | speaker=unknown"
msgid "　彼の顔はもう、自分より低いところに倒れている。"
msgstr ""

#. Occurrence C_9:1264:18760: scene=C_9
#: C_9:1264
msgctxt "text_id=18760 | speaker=unknown"
msgid "　鼻腔をつく<臓|ハ><物|ラ>の異臭。"
msgstr ""

#. Occurrence C_9:1269:18761: scene=C_9
#: C_9:1269
msgctxt "text_id=18761 | speaker=unknown"
msgid "　かつて胃のあった箇所から、赤い血液が飛散している。"
msgstr ""

#. Occurrence C_9:1302:18762: scene=C_9
#: C_9:1302
msgctxt "text_id=18762 | speaker=unknown"
msgid "　一瞬の出来事だった。"
msgstr ""

#. Occurrence C_9:1307:18763: scene=C_9
#: C_9:1307
msgctxt "text_id=18763 | speaker=unknown"
msgid "　水のつまったバケツを倒した時みたいに、何もかも一瞬で終わってしまって、現実感がまるで無い。"
msgstr ""

#. Occurrence C_9:1326:18764: scene=C_9
#: C_9:1326
msgctxt "text_id=18764 | speaker=unknown"
msgid "　唯一の救いは、たぶん、痛みさえ一瞬だった事ぐらい。"
msgstr ""

#. Occurrence C_9:1331:18765: scene=C_9
#: C_9:1331
msgctxt "text_id=18765 | speaker=unknown"
msgid "　青子は一変した状況を目前にしながら、冷静に、即死だな、と判断する自分に腹を立てた。"
msgstr ""

#. Occurrence C_9:1347:18766: scene=C_9
#: C_9:1347
msgctxt "text_id=18766 | speaker=unknown"
msgid "　……しかし。"
msgstr ""

#. Occurrence C_9:1353:18767: scene=C_9
#: C_9:1353
msgctxt "text_id=18767 | speaker=unknown"
msgid "そうなると、これを行った相手にはどんな感情をぶつければいいのだろう。"
msgstr ""

#. Occurrence C_9:1396:18768: scene=C_9
#: C_9:1396
msgctxt "text_id=18768 | speaker=unknown"
msgid "　怒りは自分相手に使ってしまった。"
msgstr ""

#. Occurrence C_9:1401:18769: scene=C_9
#: C_9:1401
msgctxt "text_id=18769 | speaker=unknown"
msgid "　他人に回す余裕なんて許さない。"
msgstr ""

#. Occurrence C_9:1406:18770: scene=C_9
#: C_9:1406
msgctxt "text_id=18770 | speaker=unknown"
msgid "　この憎悪は自分を焼く為に使うと決めた。"
msgstr ""

#. Occurrence C_9:1411:18771: scene=C_9
#: C_9:1411
msgctxt "text_id=18771 | speaker=unknown"
msgid "　次の問題は、コレを上回る激情が、はたして自分の中にあるかどうか。"
msgstr ""

#. Occurrence C_9:1416:18772: scene=C_9
#: C_9:1416
msgctxt "text_id=18772 | speaker=unknown"
msgid "　疑問に思いつつ、それを探すのはわりと楽しそうな気がして、彼女はくすりと<微笑|わら>ってしまった。"
msgstr ""

#. Occurrence C_9:1463:18773: scene=C_9
#: C_9:1463
msgctxt "text_id=18773 | speaker=unknown"
msgid "　旧校舎に視線を向けると、片腕を胸の位置に構えた蒼崎橙子の姿がある。"
msgstr ""

#. Occurrence C_9:1468:18774: scene=C_9
#: C_9:1468
msgctxt "text_id=18774 | speaker=unknown"
msgid "　彼女は青子や有珠には魔力で<弾|はじ>かれる簡素なルーン魔術を、刻印を持たない<草|あ><十|い><郎|て>に放ったのだ。"
msgstr ""

#. Occurrence C_9:1502:18775: scene=C_9
#: C_9:1502
msgctxt "text_id=18775 | speaker=unknown"
msgid "　橙子は琥珀色の瞳をやや細めて、崩れ落ちた死体を見つめている。"
msgstr ""

#. Occurrence C_9:1507:18776: scene=C_9
#: C_9:1507
msgctxt "text_id=18776 | speaker=unknown"
msgid "　そこにどんな感情があるかなんて、青子はいちいち考えてみる気にもならなかった。"
msgstr ""

#. Occurrence C_9:1512:18777: scene=C_9
#: C_9:1512
msgctxt "text_id=18777 | speaker=unknown"
msgid "　もし仮に後悔の色なんてあったりしたら、それこそ一生許せないだろうし。"
msgstr ""

#. Occurrence C_9:1578:18778: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0000; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1578
msgctxt "text_id=18778 | speaker=touko"
msgid "「やはり、君からこうしておくべきだったな」"
msgstr ""

#. Occurrence C_9:1584:18779: scene=C_9
#: C_9:1584
msgctxt "text_id=18779 | speaker=unknown"
msgid "　橙子は青子にではなく、もう応えない死体に語りかけた。"
msgstr ""

#. Occurrence C_9:1589:18780: scene=C_9
#: C_9:1589
msgctxt "text_id=18780 | speaker=unknown"
msgid "　反応もない。"
msgstr ""

#. Occurrence C_9:1595:18781: scene=C_9
#: C_9:1595
msgctxt "text_id=18781 | speaker=unknown"
msgid "呼吸もない。"
msgstr ""

#. Occurrence C_9:1600:18782: scene=C_9
#: C_9:1600
msgctxt "text_id=18782 | speaker=unknown"
msgid "　それが完全に死んでいる事を確認して、青子は腕に力をこめて立ち上がった。"
msgstr ""

#. Occurrence C_9:1660:18783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0008; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1660
msgctxt "text_id=18783 | speaker=aoko"
msgid "「案外、無様ね」"
msgstr ""

#. Occurrence C_9:1666:18784: scene=C_9
#: C_9:1666
msgctxt "text_id=18784 | speaker=unknown"
msgid "　遠く離れた姉に向けて、青子は乾いた声で語りかける。"
msgstr ""

#. Occurrence C_9:1673:18785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0009; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1673
msgctxt "text_id=18785 | speaker=aoko"
msgid "「でも正しい選択だわ。これで勝負はやり直しだもの」"
msgstr ""

#. Occurrence C_9:1749:18786: scene=C_9
#: C_9:1749
msgctxt "text_id=18786 | speaker=unknown"
msgid "　彼の死体に背を向けて、青子は橙子へと向き直った。"
msgstr ""

#. Occurrence C_9:1754:18787: scene=C_9
#: C_9:1754
msgctxt "text_id=18787 | speaker=unknown"
msgid "　両者の距離は遠い。"
msgstr ""

#. Occurrence C_9:1759:18788: scene=C_9
#: C_9:1759
msgctxt "text_id=18788 | speaker=unknown"
msgid "　それは実際の広がりより、遥かに遠い<断絶|だんぜつ>。"
msgstr ""

#. Occurrence C_9:1764:18789: scene=C_9
#: C_9:1764
msgctxt "text_id=18789 | speaker=unknown"
msgid "　本当は交わす言葉なんて無いのだけど、今までの姉妹としての人生に敬意を表して、ふたりは益体のない会話を交わす。"
msgstr ""

#. Occurrence C_9:1785:18790: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0001; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1785
msgctxt "text_id=18790 | speaker=touko"
msgid "「―――ああ。魔術刻印という私の切札はこの通りで、人狼というカードもおまえの切札の前に破れ去った。"
msgstr ""

#. Occurrence C_9:1791:18791: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0002; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1791
msgctxt "text_id=18791 | speaker=touko"
msgid "　だが、そちらも刻印を使いきり、彼もいま息絶えた。"
msgstr ""

#. Occurrence C_9:1797:18792: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0003; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1797
msgctxt "text_id=18792 | speaker=touko"
msgid "　互いに決定打はなくなった訳だ」"
msgstr ""

#. Occurrence C_9:1818:18793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0010; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1818
msgctxt "text_id=18793 | speaker=aoko"
msgid "「そうね。私も甘かった。人狼が再起不能になった時点で、貴女が敗北を認めたなんて勝手に思い上がるんだから。"
msgstr ""

#. Occurrence C_9:1824:18794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0011; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1824
msgctxt "text_id=18794 | speaker=aoko"
msgid "　……本来ならそうなるんだけど、貴女がそんなに<諦|あきら>めがいいのなら、この町に戻ってきはしないものね。"
msgstr ""

#. Occurrence C_9:1858:18795: scene=C_9
#: C_9:1858
msgctxt "text_id=18795 | speaker=unknown"
msgid "　――――――"
msgstr ""

#. Occurrence C_9:1867:18796: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0012; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1867
msgctxt "text_id=18796 | speaker=aoko"
msgid "本当に、甘かった」"
msgstr ""

#. Occurrence C_9:1917:18797: scene=C_9
#: C_9:1917
msgctxt "text_id=18797 | speaker=unknown"
msgid "　青子の声が、自分の<言霊|ことだま>を圧倒している事を橙子は認めた。"
msgstr ""

#. Occurrence C_9:1922:18798: scene=C_9
#: C_9:1922
msgctxt "text_id=18798 | speaker=unknown"
msgid "　青子の見解は正しい。それほど橙子は<使い魔|ベオウルフ>に依存していた。"
msgstr ""

#. Occurrence C_9:1927:18799: scene=C_9
#: C_9:1927
msgctxt "text_id=18799 | speaker=unknown"
msgid "　有珠と青子にどんな切札があろうと、彼女たちが魔術師である以上、倒しようのなかった最強の人狼。"
msgstr ""

#. Occurrence C_9:1932:18800: scene=C_9
#: C_9:1932
msgctxt "text_id=18800 | speaker=unknown"
msgid "　それを破った草十郎がいるかぎりは、橙子に勝利はない。"
msgstr ""

#. Occurrence C_9:1937:18801: scene=C_9
#: C_9:1937
msgctxt "text_id=18801 | speaker=unknown"
msgid "　けれど草十郎は人狼を討つ事はできても、魔術師に対しては、そのかぎりではなかったのだ。"
msgstr ""

#. Occurrence C_9:1979:18802: scene=C_9
#: C_9:1979
msgctxt "text_id=18802 | speaker=unknown"
msgid "　だから殺した。"
msgstr ""

#. Occurrence C_9:1984:18803: scene=C_9
#: C_9:1984
msgctxt "text_id=18803 | speaker=unknown"
msgid "　草十郎さえ退場すれば人狼を阻む者はいなくなる。"
msgstr ""

#. Occurrence C_9:1989:18804: scene=C_9
#: C_9:1989
msgctxt "text_id=18804 | speaker=unknown"
msgid "　人狼の再起に時間はかかるだろうが、精神的なものであるなら治療可能だ。"
msgstr ""

#. Occurrence C_9:1994:18805: scene=C_9
#: C_9:1994
msgctxt "text_id=18805 | speaker=unknown"
msgid "　その前に青子たちは挑んでくるだろうが、有珠の体内の毒草を解呪しないかぎり橙子の優位は動かない。"
msgstr ""

#. Occurrence C_9:2068:18806: scene=C_9
#: C_9:2068
msgctxt "text_id=18806 | speaker=unknown"
msgid "　この通り、今はお互い決定打が無い。"
msgstr ""

#. Occurrence C_9:2073:18807: scene=C_9
#: C_9:2073
msgctxt "text_id=18807 | speaker=unknown"
msgid "　戦いはどう見ても後日に引き伸ばされる事になる。"
msgstr ""

#. Occurrence C_9:2091:18808: scene=C_9
#: C_9:2091
msgctxt "text_id=18808 | speaker=unknown"
msgid "　―――青子が、それを使わなければ。"
msgstr ""

#. Occurrence C_9:2167:18809: scene=C_9
#: C_9:2167
msgctxt "text_id=18809 | speaker=unknown"
msgid "　粉雪が舞う。"
msgstr ""

#. Occurrence C_9:2172:18810: scene=C_9
#: C_9:2172
msgctxt "text_id=18810 | speaker=unknown"
msgid "　彼女を中心に、大気そのものが<軋|きし>みをあげる。"
msgstr ""

#. Occurrence C_9:2178:18811: scene=C_9
#: C_9:2178
msgctxt "text_id=18811 | speaker=unknown"
msgid "　―――神秘を<超越|ちょうえつ>した魔術。"
msgstr ""

#. Occurrence C_9:2184:18812: scene=C_9
#: C_9:2184
msgctxt "text_id=18812 | speaker=unknown"
msgid "　人智を<拒|こば>む奇跡の扉が、この雪原に下りようとしている。"
msgstr ""

#. Occurrence C_9:2259:18813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0004; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:2259
msgctxt "text_id=18813 | speaker=touko"
msgid "「やる気のようね、青子」"
msgstr ""

#. Occurrence C_9:2351:18814: scene=C_9
#: C_9:2351
msgctxt "text_id=18814 | speaker=unknown"
msgid "　橙子は結界の維持を解除した。"
msgstr ""

#. Occurrence C_9:2356:18815: scene=C_9
#: C_9:2356
msgctxt "text_id=18815 | speaker=unknown"
msgid "　これで祖父は自由になり、ここまで破壊した三咲の結界は修復されてしまうだろう。"
msgstr ""

#. Occurrence C_9:2361:18816: scene=C_9
#: C_9:2361
msgctxt "text_id=18816 | speaker=unknown"
msgid "　だが、今ここで刻印を使わなければ自分の命が無いと彼女は即断した。"
msgstr ""

#. Occurrence C_9:2381:18817: scene=C_9
#: C_9:2381
msgctxt "text_id=18817 | speaker=unknown"
msgid "　使用可能になった橙子の刻印は、青子の<刻印|それ>の二倍強。"
msgstr ""

#. Occurrence C_9:2407:18818: scene=C_9
#: C_9:2407
msgctxt "text_id=18818 | speaker=unknown"
msgid "　その脅威を青子は半眼で眺めている。"
msgstr ""

#. Occurrence C_9:2423:18819: scene=C_9
#: C_9:2423
msgctxt "text_id=18819 | speaker=unknown"
msgid "　まるっきり興味の外。"
msgstr ""

#. Occurrence C_9:2428:18820: scene=C_9
#: C_9:2428
msgctxt "text_id=18820 | speaker=unknown"
msgid "　彼女はそんな<外部|モノ>より、心中に<潜|ひそ>むモノを探りあて、慎重に捕まえていた。"
msgstr ""

#. Occurrence C_9:2476:18821: scene=C_9
#: C_9:2476
msgctxt "text_id=18821 | speaker=unknown"
msgid "　……それは、<藻|も>のような手応えだった。"
msgstr ""

#. Occurrence C_9:2481:18822: scene=C_9
#: C_9:2481
msgctxt "text_id=18822 | speaker=unknown"
msgid "　激情の<類|たぐい>ではないし、堅くも、大きくもない。"
msgstr ""

#. Occurrence C_9:2493:18823: scene=C_9
#: C_9:2493
msgctxt "text_id=18823 | speaker=unknown"
msgid "　きっと、こんなのはその場の<勢|いきお>い。"
msgstr ""

#. Occurrence C_9:2498:18824: scene=C_9
#: C_9:2498
msgctxt "text_id=18824 | speaker=unknown"
msgid "　彼女は思考そのものを放棄して、心中のわだかまりを掌中に収め、強く敵を凝視する。"
msgstr ""

#. Occurrence C_9:2522:18825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0013; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:2522
msgctxt "text_id=18825 | speaker=aoko"
msgid "「いいわよ、橙子」"
msgstr ""

#. Occurrence C_9:2527:18826: scene=C_9
#: C_9:2527
msgctxt "text_id=18826 | speaker=unknown"
msgid "　小さな、けれど叫びより確かな呟き。"
msgstr ""

#. Occurrence C_9:2534:18827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0014; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:2534
msgctxt "text_id=18827 | speaker=aoko"
msgid "「―――お望みどおり、本当の『魔法』を見せてあげる」"
msgstr ""

#. Occurrence C_9:2540:18828: scene=C_9
#: C_9:2540
msgctxt "text_id=18828 | speaker=unknown"
msgid "　輝きを失った右腕の刻印に<意識|ちから>を込めて、彼女はその続きをはっきりと紡いだ。"
msgstr ""

#. Occurrence C_9:2616:18829: scene=C_9
#: C_9:2616
msgctxt "text_id=18829 | speaker=unknown"
msgid "　ひとつの呪文。"
msgstr ""

#. Occurrence C_9:2623:18830: scene=C_9
#: C_9:2623
msgctxt "text_id=18830 | speaker=unknown"
msgid "　深い想いが<籠|こ>められた彼女の訣別。"
msgstr ""

#. Occurrence C_9:2629:18831: scene=C_9
#: C_9:2629
msgctxt "text_id=18831 | speaker=unknown"
msgid "　それは、ある誰かの幸福だった時間を巻き戻す、青い色をした魔法のことば。"
msgstr ""

#. Occurrence D_1:52:18832: scene=D_1
#: D_1:52
msgctxt "text_id=18832 | speaker=unknown"
msgid "　それから六日が経って、天気は晴れて。"
msgstr ""

#. Occurrence D_1:109:18833: scene=D_1
#: D_1:109
msgctxt "text_id=18833 | speaker=unknown"
msgid "　彼がその話を聞いたのは、一日かけての大掃除が終わって、有珠と一服している時。"
msgstr ""

#. Occurrence D_1:133:18834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0000; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:133
msgctxt "text_id=18834 | speaker=aoko"
msgid "「草十郎、今日ぐらいはバイト休みでしょ？」"
msgstr ""

#. Occurrence D_1:139:18835: scene=D_1
#: D_1:139
msgctxt "text_id=18835 | speaker=unknown"
msgid "　居間に入ってくるなり、青子はいつもの調子でそう言った。"
msgstr ""

#. Occurrence D_1:170:18836: scene=D_1
#: D_1:170
msgctxt "text_id=18836 | speaker=unknown"
msgid "　夜もふけて、時刻は九時になろうとしている。"
msgstr ""

#. Occurrence D_1:175:18837: scene=D_1
#: D_1:175
msgctxt "text_id=18837 | speaker=unknown"
msgid "　昼間の晴天から一変して、窓の外は厚い雲。"
msgstr ""

#. Occurrence D_1:180:18838: scene=D_1
#: D_1:180
msgctxt "text_id=18838 | speaker=unknown"
msgid "　それをのんびり眺めていた草十郎は、うん？と平和そうに首をかしげた。"
msgstr ""

#. Occurrence D_1:201:18839: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0000; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:201
msgctxt "text_id=18839 | speaker=soujuurou"
msgid "「休みだけど、どうして？」"
msgstr ""

#. Occurrence D_1:207:18840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0001; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:207
msgctxt "text_id=18840 | speaker=aoko"
msgid "「これから実家に戻るから、用意しておいて」"
msgstr ""

#. Occurrence D_1:213:18841: scene=D_1
#: D_1:213
msgctxt "text_id=18841 | speaker=unknown"
msgid "　緩みきった草十郎の表情は、青子の登場でとたんに曇ってしまう。"
msgstr ""

#. Occurrence D_1:218:18842: scene=D_1
#: D_1:218
msgctxt "text_id=18842 | speaker=unknown"
msgid "　今の台詞が自分にどう関係するのか掴めず、草十郎は正面に座っている有珠をちらりと盗み見た。"
msgstr ""

#. Occurrence D_1:255:18843: scene=D_1
#: D_1:255
msgctxt "text_id=18843 | speaker=unknown"
msgid "　有珠にとっても今の台詞は意外だったらしく、わずかに目を開かせて、青子と草十郎を<見比|みくら>べている。"
msgstr ""

#. Occurrence D_1:303:18844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0001; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:303
msgctxt "text_id=18844 | speaker=soujuurou"
msgid "「用意って、何の？」"
msgstr ""

#. Occurrence D_1:308:18845: scene=D_1
#: D_1:308
msgctxt "text_id=18845 | speaker=unknown"
msgid "　大掃除が終わるまで行方を<暗|くら>ましていた青子への批難をぐっと<堪|こら>えて、草十郎は恐る恐る聞き返す。"
msgstr ""

#. Occurrence D_1:333:18846: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0002; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:333
msgctxt "text_id=18846 | speaker=aoko"
msgid "「用意は用意よ。一時間ぐらい歩く山の上だから、寒くない格好しろって言ってるの」"
msgstr ""

#. Occurrence D_1:369:18847: scene=D_1
#: D_1:369
msgctxt "text_id=18847 | speaker=unknown"
msgid "　草十郎はますます顔を曇らせる。"
msgstr ""

#. Occurrence D_1:374:18848: scene=D_1
#: D_1:374
msgctxt "text_id=18848 | speaker=unknown"
msgid "　今の言い回しだと、まるで―――"
msgstr ""

#. Occurrence D_1:381:18849: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0000; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:381
msgctxt "text_id=18849 | speaker=alice"
msgid "「……静希君を連れていくの？」"
msgstr ""

#. Occurrence D_1:407:18850: scene=D_1
#: D_1:407
msgctxt "text_id=18850 | speaker=unknown"
msgid "　草十郎が口にするより早く、有珠が青子に問いかけた。"
msgstr ""

#. Occurrence D_1:412:18851: scene=D_1
#: D_1:412
msgctxt "text_id=18851 | speaker=unknown"
msgid "　それにいけない？　と青子は言い返す。"
msgstr ""

#. Occurrence D_1:447:18852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0003; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:447
msgctxt "text_id=18852 | speaker=aoko"
msgid "「私だってあんなとこに行きたくないわよ。"
msgstr ""

#. Occurrence D_1:453:18853: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0004; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:453
msgctxt "text_id=18853 | speaker=aoko"
msgid "　けど今日ぐらいは顔を出せってうるさいから、ホントに顔だけ見せにいくの。"
msgstr ""

#. Occurrence D_1:460:18854: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0005; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:460
msgctxt "text_id=18854 | speaker=aoko"
msgid "草十郎を連れていくのは、たんに暇だからだけど」"
msgstr ""

#. Occurrence D_1:491:18855: scene=D_1
#: D_1:491
msgctxt "text_id=18855 | speaker=unknown"
msgid "　文句ないでしょ？　と胸を張って主張する。"
msgstr ""

#. Occurrence D_1:516:18856: scene=D_1
#: D_1:516
msgctxt "text_id=18856 | speaker=unknown"
msgid "　有珠はどこかうかない顔をして青子を見る。"
msgstr ""

#. Occurrence D_1:528:18857: scene=D_1
#: D_1:528
msgctxt "text_id=18857 | speaker=unknown"
msgid "　草十郎も露骨にイヤそうな顔をして青子を見る。"
msgstr ""

#. Occurrence D_1:557:18858: scene=D_1
#: D_1:557
msgctxt "text_id=18858 | speaker=unknown"
msgid "　そんなふたりの無言の抗議は、もちろん、青子にはまったく通じなかった。"
msgstr ""

#. Occurrence D_1:584:18859: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0006; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:584
msgctxt "text_id=18859 | speaker=aoko"
msgid "「それじゃ、<半|はん>になったら出かけるからね」"
msgstr ""

#. Occurrence D_1:596:18860: scene=D_1
#: D_1:596
msgctxt "text_id=18860 | speaker=unknown"
msgid "　言いたい事だけ言って、青子は居間から姿を消した。"
msgstr ""

#. Occurrence D_1:625:18861: scene=D_1
#: D_1:625
msgctxt "text_id=18861 | speaker=unknown"
msgid "　残ったふたりは呆然とするばかりだ。"
msgstr ""

#. Occurrence D_1:676:18862: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0002; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:676
msgctxt "text_id=18862 | speaker=soujuurou"
msgid "「有珠。蒼崎の家って、遠いのか？」"
msgstr ""

#. Occurrence D_1:682:18863: scene=D_1
#: D_1:682
msgctxt "text_id=18863 | speaker=unknown"
msgid "　九時半まであと十分ほどの時計を見つめながら、草十郎は問いかけた。"
msgstr ""

#. Occurrence D_1:703:18864: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0001; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:703
msgctxt "text_id=18864 | speaker=alice"
msgid "「場所的には三咲市の端よ。ここから電車で四駅分<下|くだ>った、小さな山の中にあるわ。"
msgstr ""

#. Occurrence D_1:709:18865: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0002; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:709
msgctxt "text_id=18865 | speaker=alice"
msgid "　……貴方の住んでいたところに比べれば丘でしょうけど」"
msgstr ""

#. Occurrence D_1:723:18866: scene=D_1
#: D_1:723
msgctxt "text_id=18866 | speaker=unknown"
msgid "　表情こそ変わらないものの、有珠の声は思いっきり不機嫌そうだった。……本人がそうと気付いていないところが、いっそうのご機嫌斜めぶりを<示|しめ>している。"
msgstr ""

#. Occurrence D_1:744:18867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0003; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:744
msgctxt "text_id=18867 | speaker=soujuurou"
msgid "「そっか。今から行ったら、帰ってくるのは明日になるね」"
msgstr ""

#. Occurrence D_1:750:18868: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0003; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:750
msgctxt "text_id=18868 | speaker=alice"
msgid "「……帰ってこられたらの話だけど」"
msgstr ""

#. Occurrence D_1:770:18869: scene=D_1
#: D_1:770
msgctxt "text_id=18869 | speaker=unknown"
msgid "　草十郎の独り言に、有珠も独り言で反応した。"
msgstr ""

#. Occurrence D_1:775:18870: scene=D_1
#: D_1:775
msgctxt "text_id=18870 | speaker=unknown"
msgid "　これから旅立つ人間に、思いっきり不吉な予言をするように。"
msgstr ""

#. Occurrence D_1:796:18871: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0004; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:796
msgctxt "text_id=18871 | speaker=soujuurou"
msgid "「……蒼崎の家ってお化けでも出るのか？」"
msgstr ""

#. Occurrence D_1:807:18872: scene=D_1
#: D_1:807
msgctxt "text_id=18872 | speaker=unknown"
msgid "　草十郎の問いに有珠は答えない。"
msgstr ""

#. Occurrence D_1:812:18873: scene=D_1
#: D_1:812
msgctxt "text_id=18873 | speaker=unknown"
msgid "　ティーカップから視線を上げ、無言で草十郎を眺めるだけだった。"
msgstr ""

#. Occurrence D_1:833:18874: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0005; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:833
msgctxt "text_id=18874 | speaker=soujuurou"
msgid "「……有珠？」"
msgstr ""

#. Occurrence D_1:859:18875: scene=D_1
#: D_1:859
msgctxt "text_id=18875 | speaker=unknown"
msgid "　どこか様子のおかしい彼女に呼びかけると、有珠はふい、と顔を背けてしまった。"
msgstr ""

#. Occurrence D_1:864:18876: scene=D_1
#: D_1:864
msgctxt "text_id=18876 | speaker=unknown"
msgid "　……時計は、もうじき半になろうとしている。"
msgstr ""

#. Occurrence D_1:869:18877: scene=D_1
#: D_1:869
msgctxt "text_id=18877 | speaker=unknown"
msgid "　有珠の様子は気がかりだが、草十郎は仕方なくソファーから立ち上がった。"
msgstr ""

#. Occurrence D_1:892:18878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0006; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:892
msgctxt "text_id=18878 | speaker=soujuurou"
msgid "「それじゃ、行ってくるよ」"
msgstr ""

#. Occurrence D_1:952:18879: scene=D_1
#: D_1:952
msgctxt "text_id=18879 | speaker=unknown"
msgid "　トコトコと居間を横切る草十郎。"
msgstr ""

#. Occurrence D_1:957:18880: scene=D_1
#: D_1:957
msgctxt "text_id=18880 | speaker=unknown"
msgid "　その背中を、有珠はいつまでも見つめ続けた。"
msgstr ""

#. Occurrence D_1:1002:18881: scene=D_1
#: D_1:1002
msgctxt "text_id=18881 | speaker=unknown"
msgid "　草十郎が部屋に戻って外行きに着替え、ロビーまで下りた時、青子はとっくに準備を済ませて待っていた。"
msgstr ""

#. Occurrence D_1:1008:18882: scene=D_1
#: D_1:1008
msgctxt "text_id=18882 | speaker=unknown"
msgid "　青子の横には有珠がいて、何やら話しこんでいる。"
msgstr ""

#. Occurrence D_1:1013:18883: scene=D_1
#: D_1:1013
msgctxt "text_id=18883 | speaker=unknown"
msgid "　草十郎が階段を下りきると、青子はよし、と調子をとるように会話を切った。"
msgstr ""

#. Occurrence D_1:1046:18884: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0007; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:1046
msgctxt "text_id=18884 | speaker=aoko"
msgid "「それじゃ行きましょうか。有珠、留守番よろしくね」"
msgstr ""

#. Occurrence D_1:1068:18885: scene=D_1
#: D_1:1068
msgctxt "text_id=18885 | speaker=unknown"
msgid "　有珠は頷きだけで応えた。"
msgstr ""

#. Occurrence D_1:1075:18886: scene=D_1
#: D_1:1075
msgctxt "text_id=18886 | speaker=unknown"
msgid "　青子はつかつかと玄関へ歩いていく。"
msgstr ""

#. Occurrence D_1:1080:18887: scene=D_1
#: D_1:1080
msgctxt "text_id=18887 | speaker=unknown"
msgid "　草十郎はロビーでコートを羽織りつつ、青子の後を追うように歩きだした。"
msgstr ""

#. Occurrence D_1:1116:18888: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0008; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:1116
msgctxt "text_id=18888 | speaker=aoko"
msgid "「ほら、ぐずぐずしないっ！」"
msgstr ""

#. Occurrence D_1:1127:18889: scene=D_1
#: D_1:1127
msgctxt "text_id=18889 | speaker=unknown"
msgid "　青子の呼びかけに足を速める草十郎だったが、何を思ったか唐突に立ち止まった。"
msgstr ""

#. Occurrence D_1:1132:18890: scene=D_1
#: D_1:1132
msgctxt "text_id=18890 | speaker=unknown"
msgid "　そういえば部屋のストーブがつけっぱなしだったな、なんて素振りで、ひとり<佇|たたず>む有珠へと振り返る。"
msgstr ""

#. Occurrence D_1:1169:18891: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_9000; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:1169
msgctxt "text_id=18891 | speaker=soujuurou"
msgid "「それじゃ行ってくる。できるだけ早めに帰ってくるから、寝ないで待ってるんだぞ有珠」"
msgstr ""

#. Occurrence D_1:1219:18892: scene=D_1
#: D_1:1219
msgctxt "text_id=18892 | speaker=unknown"
msgid "　突然の言いつけに、有珠は不意をつかれたように<瞬|またた>きをした。"
msgstr ""

#. Occurrence D_1:1224:18893: scene=D_1
#: D_1:1224
msgctxt "text_id=18893 | speaker=unknown"
msgid "　草十郎は返事を待っていて、"
msgstr ""

#. Occurrence D_1:1229:18894: scene=D_1
#: D_1:1229
msgctxt "text_id=18894 | speaker=unknown"
msgid "　青子は腕を組んでふたりのやりとりを眺めている。"
msgstr ""

#. Occurrence D_1:1250:18895: scene=D_1
#: D_1:1250
msgctxt "text_id=18895 | speaker=unknown"
msgid "　……それに少し戸惑ってから、有珠は無言で居間へと行ってしまった。"
msgstr ""

#. Occurrence D_1:1270:18896: scene=D_1
#: D_1:1270
msgctxt "text_id=18896 | speaker=unknown"
msgid "　どうでもいい草十郎の言葉に、こくんと<控|ひか>え目にうなずいてから。"
msgstr ""

#. Occurrence D_2:57:18897: scene=D_2
#: D_2:57
msgctxt "text_id=18897 | speaker=unknown"
msgid "　<秋古城|あきこしろ>というのが、その駅の名前だった。"
msgstr ""

#. Occurrence D_2:81:18898: scene=D_2
#: D_2:81
msgctxt "text_id=18898 | speaker=unknown"
msgid "　夜はふけて十一時より少し前。"
msgstr ""

#. Occurrence D_2:86:18899: scene=D_2
#: D_2:86
msgctxt "text_id=18899 | speaker=unknown"
msgid "　参拝客の一団を乗せた<上|のぼ>りの列車とは逆行して、ふたりはその小さな駅に着いた。"
msgstr ""

#. Occurrence D_2:106:18900: scene=D_2
#: D_2:106
msgctxt "text_id=18900 | speaker=unknown"
msgid "　周囲はあまりにも暗く、静かだ。"
msgstr ""

#. Occurrence D_2:111:18901: scene=D_2
#: D_2:111
msgctxt "text_id=18901 | speaker=unknown"
msgid "　駅というより深夜の波止場を思わせる。"
msgstr ""

#. Occurrence D_2:131:18902: scene=D_2
#: D_2:131
msgctxt "text_id=18902 | speaker=unknown"
msgid "　平時でさえ、この駅で降りる人は少ないのだろう。"
msgstr ""

#. Occurrence D_2:136:18903: scene=D_2
#: D_2:136
msgctxt "text_id=18903 | speaker=unknown"
msgid "　時折やってくる列車を見送るだけの停留所。"
msgstr ""

#. Occurrence D_2:141:18904: scene=D_2
#: D_2:141
msgctxt "text_id=18904 | speaker=unknown"
msgid "　駅のまわりにはコンビニエンスストアの一軒もなく、あるのは一面の畑と、道に立てられた街灯だけ。"
msgstr ""

#. Occurrence D_2:161:18905: scene=D_2
#: D_2:161
msgctxt "text_id=18905 | speaker=unknown"
msgid "　駅員室で座ったまま眠る駅員の前にキップを置いて、青子は時刻表を確認する。"
msgstr ""

#. Occurrence D_2:166:18906: scene=D_2
#: D_2:166
msgctxt "text_id=18906 | speaker=unknown"
msgid "　零時半過ぎに、もう一本だけ帰りの電車がある。"
msgstr ""

#. Occurrence D_2:172:18907: scene=D_2
#: D_2:172
msgctxt "text_id=18907 | speaker=unknown"
msgid "　最終電車を確認して、青子は急ぎ足で駅を後にした。"
msgstr ""

#. Occurrence D_2:220:18908: scene=D_2
#: D_2:220
msgctxt "text_id=18908 | speaker=unknown"
msgid "　……年老いた駅員はひとりきりだった。"
msgstr ""

#. Occurrence D_2:225:18909: scene=D_2
#: D_2:225
msgctxt "text_id=18909 | speaker=unknown"
msgid "　彼はストーブとテレビをつけたまま、こくこくと船を<漕|こ>いでいる。"
msgstr ""

#. Occurrence D_2:245:18910: scene=D_2
#: D_2:245
msgctxt "text_id=18910 | speaker=unknown"
msgid "　その寝顔は満ち足りている。"
msgstr ""

#. Occurrence D_2:250:18911: scene=D_2
#: D_2:250
msgctxt "text_id=18911 | speaker=unknown"
msgid "　あまりにも広大な夜の闇。"
msgstr ""

#. Occurrence D_2:255:18912: scene=D_2
#: D_2:255
msgctxt "text_id=18912 | speaker=unknown"
msgid "　自動車の供給と共に<廃|すた>れてしまった小さな駅。"
msgstr ""

#. Occurrence D_2:283:18913: scene=D_2
#: D_2:283
msgctxt "text_id=18913 | speaker=unknown"
msgid "　暗い宇宙の中でただひとつ光を放つ、孤独な星のようだ。"
msgstr ""

#. Occurrence D_2:289:18914: scene=D_2
#: D_2:289
msgctxt "text_id=18914 | speaker=unknown"
msgid "　それを何十年と守り、これからも人生の終わりまで付きそう事を良しとした老人に一礼して、草十郎も暗い夜に足を向けた。"
msgstr ""

#. Occurrence D_2:347:18915: scene=D_2
#: D_2:347
msgctxt "text_id=18915 | speaker=unknown"
msgid "　駅から出ると、そこは村というよりは里だった。"
msgstr ""

#. Occurrence D_2:352:18916: scene=D_2
#: D_2:352
msgctxt "text_id=18916 | speaker=unknown"
msgid "　駅前には<広場|ロータリー>すらない。"
msgstr ""

#. Occurrence D_2:357:18917: scene=D_2
#: D_2:357
msgctxt "text_id=18917 | speaker=unknown"
msgid "　パノラマに広がる平地は一面の畑で、網の目のように<畦道|あぜみち>がある。"
msgstr ""

#. Occurrence D_2:362:18918: scene=D_2
#: D_2:362
msgctxt "text_id=18918 | speaker=unknown"
msgid "　夏であれば風紋を走らせる小麦畑も、冬の夜では荒地にしか見えない。"
msgstr ""

#. Occurrence D_2:367:18919: scene=D_2
#: D_2:367
msgctxt "text_id=18919 | speaker=unknown"
msgid "　ただ一面の闇の中、電灯だけが場違いに<灯|とも>っている。"
msgstr ""

#. Occurrence D_2:395:18920: scene=D_2
#: D_2:395
msgctxt "text_id=18920 | speaker=unknown"
msgid "　寒さは夜になってより厳しさを増していた。"
msgstr ""

#. Occurrence D_2:400:18921: scene=D_2
#: D_2:400
msgctxt "text_id=18921 | speaker=unknown"
msgid "　冷気は容赦なく、指先から<感覚|ねつ>を奪っていく。"
msgstr ""

#. Occurrence D_2:422:18922: scene=D_2
#: D_2:422
msgctxt "text_id=18922 | speaker=unknown"
msgid "　両手をポケットにいれて、青子は畦道を歩きだした。"
msgstr ""

#. Occurrence D_2:427:18923: scene=D_2
#: D_2:427
msgctxt "text_id=18923 | speaker=unknown"
msgid "　<靴|ブーツ>には土の感触。"
msgstr ""

#. Occurrence D_2:432:18924: scene=D_2
#: D_2:432
msgctxt "text_id=18924 | speaker=unknown"
msgid "　町とは違う柔らかさに、青子は懐かしさを感じている。"
msgstr ""

#. Occurrence D_2:437:18925: scene=D_2
#: D_2:437
msgctxt "text_id=18925 | speaker=unknown"
msgid "　彼女にとっては、中学生時代まで毎日のように通った道だ。"
msgstr ""

#. Occurrence D_2:472:18926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0000; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:472
msgctxt "text_id=18926 | speaker=aoko"
msgid "「あの山の真ん中あたり、家の明かりが見えるでしょ？"
msgstr ""

#. Occurrence D_2:472:18927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0000; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:472
msgctxt "text_id=18927 | speaker=aoko"
msgid "　アレがうち」"
msgstr ""

#. Occurrence D_2:478:18928: scene=D_2
#: D_2:478
msgctxt "text_id=18928 | speaker=unknown"
msgid "　もりあがった<山|やみ>を指さす青子。"
msgstr ""

#. Occurrence D_2:483:18929: scene=D_2
#: D_2:483
msgctxt "text_id=18929 | speaker=unknown"
msgid "　ここからだと四十分も歩けば辿り着けるだろう。"
msgstr ""

#. Occurrence D_2:503:18930: scene=D_2
#: D_2:503
msgctxt "text_id=18930 | speaker=unknown"
msgid "　道は長く、しばらくは畦道が続いている。"
msgstr ""

#. Occurrence D_2:508:18931: scene=D_2
#: D_2:508
msgctxt "text_id=18931 | speaker=unknown"
msgid "　青子は振り返らず、明かりに照らされた道を歩いていく。"
msgstr ""

#. Occurrence D_2:514:18932: scene=D_2
#: D_2:514
msgctxt "text_id=18932 | speaker=unknown"
msgid "　浮かび上がった道は、暗い海にかけられた<桟橋|さんばし>のように見えた。"
msgstr ""

#. Occurrence D_2:569:18933: scene=D_2
#: D_2:569
msgctxt "text_id=18933 | speaker=unknown"
msgid "　山に近づくにつれ、暗闇は深くなる。"
msgstr ""

#. Occurrence D_2:574:18934: scene=D_2
#: D_2:574
msgctxt "text_id=18934 | speaker=unknown"
msgid "　ここでは人の<喧|お><噪|と>は忘れ去られている。"
msgstr ""

#. Occurrence D_2:579:18935: scene=D_2
#: D_2:579
msgctxt "text_id=18935 | speaker=unknown"
msgid "　頭上の月の光は眩しいほど。"
msgstr ""

#. Occurrence D_2:584:18936: scene=D_2
#: D_2:584
msgctxt "text_id=18936 | speaker=unknown"
msgid "　真っ黒い山道は、その光に照らされて<闇色|やみいろ>から<影色|かげいろ>になっている。"
msgstr ""

#. Occurrence D_2:589:18937: scene=D_2
#: D_2:589
msgctxt "text_id=18937 | speaker=unknown"
msgid "　周りは暗いけれど、世界はたしかに見渡せた。"
msgstr ""

#. Occurrence D_2:636:18938: scene=D_2
#: D_2:636
msgctxt "text_id=18938 | speaker=unknown"
msgid "　ゴールの見えない道は<延々|えんえん>と続いている。"
msgstr ""

#. Occurrence D_2:641:18939: scene=D_2
#: D_2:641
msgctxt "text_id=18939 | speaker=unknown"
msgid "　青子のペースに合わせて歩きながら、ふと草十郎は彼女の横顔を盗み見た。"
msgstr ""

#. Occurrence D_2:661:18940: scene=D_2
#: D_2:661
msgctxt "text_id=18940 | speaker=unknown"
msgid "　月明かりが鮮やかとは言え、ここまで静かな夜道に青子は不安を感じないのだろうか。"
msgstr ""

#. Occurrence D_2:666:18941: scene=D_2
#: D_2:666
msgctxt "text_id=18941 | speaker=unknown"
msgid "　青子は無言のまま、いたって普通の顔つきで歩いている。"
msgstr ""

#. Occurrence D_2:696:18942: scene=D_2
#: D_2:696
msgctxt "text_id=18942 | speaker=unknown"
msgid "　こんな顔の時は、決まって強がっている時だ。"
msgstr ""

#. Occurrence D_2:701:18943: scene=D_2
#: D_2:701
msgctxt "text_id=18943 | speaker=unknown"
msgid "　一ヶ月程度の未熟な経験からではあるが、草十郎は確かにそう感じ取った。"
msgstr ""

#. Occurrence D_2:706:18944: scene=D_2
#: D_2:706
msgctxt "text_id=18944 | speaker=unknown"
msgid "　何か、些細だけれど無視できない問題を、彼女は飲みこもうとしているらしい。"
msgstr ""

#. Occurrence D_2:747:18945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0000; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:747
msgctxt "text_id=18945 | speaker=soujuurou"
msgid "「蒼崎でもこういうところは恐いのかい？」"
msgstr ""

#. Occurrence D_2:753:18946: scene=D_2
#: D_2:753
msgctxt "text_id=18946 | speaker=unknown"
msgid "　試しに訊いてみると、青子は意外にも頷いた。"
msgstr ""

#. Occurrence D_2:800:18947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0001; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:800
msgctxt "text_id=18947 | speaker=aoko"
msgid "「こんな夜道を恐がらない人なんて、普通いないでしょう。"
msgstr ""

#. Occurrence D_2:806:18948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0002; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:806
msgctxt "text_id=18948 | speaker=aoko"
msgid "　我慢できるか無視できるかの二つだけよ。そのどちらも出来ない人は、夜に出歩かないわ」"
msgstr ""

#. Occurrence D_2:812:18949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0001; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:812
msgctxt "text_id=18949 | speaker=soujuurou"
msgid "「なるほど。それじゃ、どうして自分を連れてきたんだ」"
msgstr ""

#. Occurrence D_2:858:18950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0003; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:858
msgctxt "text_id=18950 | speaker=aoko"
msgid "「言わなかった？　こんな何もない道をひとりで歩くのは時間の無駄でしょ。退屈しのぎに話し相手がほしかったの」"
msgstr ""

#. Occurrence D_2:864:18951: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0002; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:864
msgctxt "text_id=18951 | speaker=soujuurou"
msgid "「……そういえば、そんな事を言ってたな」"
msgstr ""

#. Occurrence D_2:933:18952: scene=D_2
#: D_2:933
msgctxt "text_id=18952 | speaker=unknown"
msgid "　それきり草十郎は黙りこむ。"
msgstr ""

#. Occurrence D_2:938:18953: scene=D_2
#: D_2:938
msgctxt "text_id=18953 | speaker=unknown"
msgid "　別に青子の言葉に落ちこんだ訳でもなく、必死に何かを探しているような素振りだ。"
msgstr ""

#. Occurrence D_2:1017:18954: scene=D_2
#: D_2:1017
msgctxt "text_id=18954 | speaker=unknown"
msgid "　夜の道は続いていく。"
msgstr ""

#. Occurrence D_2:1023:18955: scene=D_2
#: D_2:1023
msgctxt "text_id=18955 | speaker=unknown"
msgid "　ふたりの足音だけが響く中、青子は彼女なりに耐えてみたけれど、それも限界とばかりに口を開けた。"
msgstr ""

#. Occurrence D_2:1047:18956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0004; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1047
msgctxt "text_id=18956 | speaker=aoko"
msgid "「草十郎、退屈しのぎに何か話してよ」"
msgstr ""

#. Occurrence D_2:1053:18957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0003; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1053
msgctxt "text_id=18957 | speaker=soujuurou"
msgid "「……まいったな。話すような事はないんだけど」"
msgstr ""

#. Occurrence D_2:1059:18958: scene=D_2
#: D_2:1059
msgctxt "text_id=18958 | speaker=unknown"
msgid "　面目ない、と頭を抱える。"
msgstr ""

#. Occurrence D_2:1064:18959: scene=D_2
#: D_2:1064
msgctxt "text_id=18959 | speaker=unknown"
msgid "　どうも、さっき黙りこんだのは<話|そ><題|れ>を探しての事らしい。"
msgstr ""

#. Occurrence D_2:1069:18960: scene=D_2
#: D_2:1069
msgctxt "text_id=18960 | speaker=unknown"
msgid "　青子は呆れながらも温かなため息をひとつ。"
msgstr ""

#. Occurrence D_2:1074:18961: scene=D_2
#: D_2:1074
msgctxt "text_id=18961 | speaker=unknown"
msgid "　とことん律儀な草十郎の人柄が、彼女を悩ませていたモノを少しだけ<剥|は>がしていった。"
msgstr ""

#. Occurrence D_2:1103:18962: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0005; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1103
msgctxt "text_id=18962 | speaker=aoko"
msgid "「莫迦ね、嘘でもなんでもいいから、とにかく話をすればいいの。別に面白い話なんて期待してないから」"
msgstr ""

#. Occurrence D_2:1117:18963: scene=D_2
#: D_2:1117
msgctxt "text_id=18963 | speaker=unknown"
msgid "　青子は素っ気ない態度で、あんまりな事を言う。"
msgstr ""

#. Occurrence D_2:1122:18964: scene=D_2
#: D_2:1122
msgctxt "text_id=18964 | speaker=unknown"
msgid "　そもそも嘘なんて言ったら、それこそお仕置きタイムだ。"
msgstr ""

#. Occurrence D_2:1127:18965: scene=D_2
#: D_2:1127
msgctxt "text_id=18965 | speaker=unknown"
msgid "　前に嘘は嫌い、といったのは蒼崎本人じゃないか、と草十郎は内心でごちてみた。"
msgstr ""

#. Occurrence D_2:1132:18966: scene=D_2
#: D_2:1132
msgctxt "text_id=18966 | speaker=unknown"
msgid "　当然、青子からの返事はない。"
msgstr ""

#. Occurrence D_2:1186:18967: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0004; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1186
msgctxt "text_id=18967 | speaker=soujuurou"
msgid "「……仕方ない。話はないけど、聞きたい事ならあった。"
msgstr ""

#. Occurrence D_2:1192:18968: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0005; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1192
msgctxt "text_id=18968 | speaker=soujuurou"
msgid "　何でもいいならそれもいいだろう？」"
msgstr ""

#. Occurrence D_2:1252:18969: scene=D_2
#: D_2:1252
msgctxt "text_id=18969 | speaker=unknown"
msgid "　草十郎の提案に、青子はかすかに眉を寄せた。"
msgstr ""

#. Occurrence D_2:1257:18970: scene=D_2
#: D_2:1257
msgctxt "text_id=18970 | speaker=unknown"
msgid "　けれどそれも一瞬で、彼女はすぐに元の、落ち着いた<表情|かお>に戻る。"
msgstr ""

#. Occurrence D_2:1317:18971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0006; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1317
msgctxt "text_id=18971 | speaker=aoko"
msgid "「……ま、それもいいか。どうせ、もうすぐ忘れるんだから」"
msgstr ""

#. Occurrence D_2:1323:18972: scene=D_2
#: D_2:1323
msgctxt "text_id=18972 | speaker=unknown"
msgid "　草十郎から目を逸らして、呟くように青子は答えた。"
msgstr ""

#. Occurrence D_2:1328:18973: scene=D_2
#: D_2:1328
msgctxt "text_id=18973 | speaker=unknown"
msgid "　山中の目的地は、まだ影も形も見えてこない。"
msgstr ""

#. Occurrence D_3:55:18974: scene=D_3
#: D_3:55
msgctxt "text_id=18974 | speaker=unknown"
msgid "　あれからずっと<抱|かか>えていた疑問。"
msgstr ""

#. Occurrence D_3:60:18975: scene=D_3
#: D_3:60
msgctxt "text_id=18975 | speaker=unknown"
msgid "　今回の事件の<顛末|てんまつ>と、姉妹間の決着。"
msgstr ""

#. Occurrence D_3:65:18976: scene=D_3
#: D_3:65
msgctxt "text_id=18976 | speaker=unknown"
msgid "　そういった余分な話を、草十郎は口にする。"
msgstr ""

#. Occurrence D_3:86:18977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0000; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:86
msgctxt "text_id=18977 | speaker=soujuurou"
msgid "「それで、橙子さんは何がしたかったんだ？」"
msgstr ""

#. Occurrence D_3:92:18978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0000; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:92
msgctxt "text_id=18978 | speaker=aoko"
msgid "「あれ、言わなかった？　<蒼崎|わたし>への復讐と、根源に接触する事だって。"
msgstr ""

#. Occurrence D_3:99:18979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0001; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:99
msgctxt "text_id=18979 | speaker=aoko"
msgid "根源の渦については前に少しだけ話したでしょ」"
msgstr ""

#. Occurrence D_3:105:18980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0001; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:105
msgctxt "text_id=18980 | speaker=soujuurou"
msgid "「……たしか、魔術の源だっけ」"
msgstr ""

#. Occurrence D_3:152:18981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0002; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:152
msgctxt "text_id=18981 | speaker=aoko"
msgid "「そう。そして最終目的でもあるわ。"
msgstr ""

#. Occurrence D_3:163:18982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0003; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:163
msgctxt "text_id=18982 | speaker=aoko"
msgid "　根源の渦っていうのは、全ての<叡知|えいち>が記録された位置、全ての事柄が決定された場所。"
msgstr ""

#. Occurrence D_3:169:18983: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0004; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:169
msgctxt "text_id=18983 | speaker=aoko"
msgid "　そこを見て、触れて、理解できれば不可能なんて言葉すら作り替えられる。伝承によって呼び名は様々だけど、ようするに神さまのいる位置なんでしょうね」"
msgstr ""

#. Occurrence D_3:216:18984: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0002; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:216
msgctxt "text_id=18984 | speaker=soujuurou"
msgid "「神さまっていうのは、<八百万|やおよろず>的なものじゃなく？」"
msgstr ""

#. Occurrence D_3:256:18985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0005; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:256
msgctxt "text_id=18985 | speaker=aoko"
msgid "「……たまにそういうコト言いだすから厄介よねアンタは。"
msgstr ""

#. Occurrence D_3:262:18986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0006; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:262
msgctxt "text_id=18986 | speaker=aoko"
msgid "　そりゃ万象に宿る神さまもいるでしょうけど、これはその前、そういうのを決めた大前提みたいなものよ」"
msgstr ""

#. Occurrence D_3:288:18987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0007; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:288
msgctxt "text_id=18987 | speaker=aoko"
msgid "「そんなものの入り口がどうして三咲にあったのかは知らないけど、祖父はそれを発見して、新しい魔法を作り出した。"
msgstr ""

#. Occurrence D_3:294:18988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0008; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:294
msgctxt "text_id=18988 | speaker=aoko"
msgid "　でも、その後に根源への<路|みち>を閉ざしちゃったのよ。"
msgstr ""

#. Occurrence D_3:301:18989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0009; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:301
msgctxt "text_id=18989 | speaker=aoko"
msgid "魔法さえ成立したのなら、神さまへの<路|みち>は消えるべきだって」"
msgstr ""

#. Occurrence D_3:349:18990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0010; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:349
msgctxt "text_id=18990 | speaker=aoko"
msgid "「……たぶん、私たちが生きているかぎり開放する気はなくて、橙子はそれが腹立たしかったんだと思う。"
msgstr ""

#. Occurrence D_3:355:18991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0011; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:355
msgctxt "text_id=18991 | speaker=aoko"
msgid "　たとえ力不足で取り込まれても、道があるのなら試すべきだ。自己の消滅を恐れるぐらいなら、そもそも魔術なんて学ばなかった―――ってね」"
msgstr ""

#. Occurrence D_3:381:18992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0012; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:381
msgctxt "text_id=18992 | speaker=aoko"
msgid "「でも祖父は<礎|いしずえ>になろうとする意志さえ認めなかった。"
msgstr ""

#. Occurrence D_3:387:18993: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0013; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:387
msgctxt "text_id=18993 | speaker=aoko"
msgid "　もっと強力な後継ぎが生まれるまで、根源の解析は許可しない。後継ぎに魔法は<譲|ゆず>るけれど、根源への路だけは閉ざしていたのよ。"
msgstr ""

#. Occurrence D_3:393:18994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0014; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:393
msgctxt "text_id=18994 | speaker=aoko"
msgid "　……橙子の気持ちも分かるけど、私は祖父に賛成だわ。"
msgstr ""

#. Occurrence D_3:399:18995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0015; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:399
msgctxt "text_id=18995 | speaker=aoko"
msgid "　根源なんてものに興味はないし、第一、今まで一人も生還者がいないんだもの。それが本当に神々の座なのか保証もないし」"
msgstr ""

#. Occurrence D_3:448:18996: scene=D_3
#: D_3:448
msgctxt "text_id=18996 | speaker=unknown"
msgid "　話しているうちに機嫌を損ねたのか、後半はなかば文句になっていた。"
msgstr ""

#. Occurrence D_3:453:18997: scene=D_3
#: D_3:453
msgctxt "text_id=18997 | speaker=unknown"
msgid "　なんだかんだ言って、青子本人も祖父には賛同しきれない部分があるらしい。"
msgstr ""

#. Occurrence D_3:458:18998: scene=D_3
#: D_3:458
msgctxt "text_id=18998 | speaker=unknown"
msgid "　それを気にしながら、草十郎は今の話のおかしな部分について訊き返す。"
msgstr ""

#. Occurrence D_3:503:18999: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0003; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:503
msgctxt "text_id=18999 | speaker=soujuurou"
msgid "「蒼崎。一人も生還者がいないって、どういう事だ？」"
msgstr ""

#. Occurrence D_3:509:19000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0016; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:509
msgctxt "text_id=19000 | speaker=aoko"
msgid "「根源に触れて、帰ってきた者は一人もいないの。世界規模でね。"
msgstr ""

#. Occurrence D_3:515:19001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0017; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:515
msgctxt "text_id=19001 | speaker=aoko"
msgid "　触れれば即消滅。人間程度の魂だと触れた瞬間に<元|・><に|・><戻|・><る|・>とか、根源に取りこまれるとか」"
msgstr ""

#. Occurrence D_3:536:19002: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0018; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:536
msgctxt "text_id=19002 | speaker=aoko"
msgid "「なんで、どんなに歴史に名を残した魔術師でも、あれにだけは触れていないわ。せいぜい間近にして、大急ぎで自分の魔術を安定させた程度だもの」"
msgstr ""

#. Occurrence D_3:542:19003: scene=D_3
#: D_3:542
msgctxt "text_id=19003 | speaker=unknown"
msgid "　そこがおかしい、と草十郎は眉をひそめる。"
msgstr ""

#. Occurrence D_3:563:19004: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0004; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:563
msgctxt "text_id=19004 | speaker=soujuurou"
msgid "「それじゃあ、どうしてそこがそういう場所だって分かるんだ」"
msgstr ""

#. Occurrence D_3:569:19005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0019; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:569
msgctxt "text_id=19005 | speaker=aoko"
msgid "「そりゃあ、中に入って伝えた人がいたからでしょう」"
msgstr ""

#. Occurrence D_3:604:19006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0005; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:604
msgctxt "text_id=19006 | speaker=soujuurou"
msgid "「でも生還者はいないって」"
msgstr ""

#. Occurrence D_3:644:19007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0020; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:644
msgctxt "text_id=19007 | speaker=aoko"
msgid "「だから。そういう人たちは、中で神さまにでもなっちゃったんじゃない？」"
msgstr ""

#. Occurrence D_3:649:19008: scene=D_3
#: D_3:649
msgctxt "text_id=19008 | speaker=unknown"
msgid "　実にきっぱりと彼女は言った。"
msgstr ""

#. Occurrence D_3:654:19009: scene=D_3
#: D_3:654
msgctxt "text_id=19009 | speaker=unknown"
msgid "　何でもない話のように、昨日の話をするように。"
msgstr ""

#. Occurrence D_3:680:19010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0021; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:680
msgctxt "text_id=19010 | speaker=aoko"
msgid "「そうなればこっちに帰ってくる必要はないでしょうし、もしかすると、単に帰って来られないだけかもね。"
msgstr ""

#. Occurrence D_3:691:19011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0022; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:691
msgctxt "text_id=19011 | speaker=aoko"
msgid "　……ま、神さまって位置づけが私たちが思っているようなものとは思えないから、あまり幸福そうには思えないけど」"
msgstr ""

#. Occurrence D_3:724:19012: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0006; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:724
msgctxt "text_id=19012 | speaker=soujuurou"
msgid "「………………」"
msgstr ""

#. Occurrence D_3:744:19013: scene=D_3
#: D_3:744
msgctxt "text_id=19013 | speaker=unknown"
msgid "　成功者も失敗者も、それに触れては、こちらの世界に帰っては来られない。"
msgstr ""

#. Occurrence D_3:749:19014: scene=D_3
#: D_3:749
msgctxt "text_id=19014 | speaker=unknown"
msgid "　根源の渦とやらを人々に伝えたのは、"
msgstr ""

#. Occurrence D_3:749:19015: scene=D_3
#: D_3:749
msgctxt "text_id=19015 | speaker=unknown"
msgid "　一番初めに神さまになった誰かが、淋しさから仲間を欲しがった結果なのかもしれない。"
msgstr ""

#. Occurrence D_3:754:19016: scene=D_3
#: D_3:754
msgctxt "text_id=19016 | speaker=unknown"
msgid "　……あるいは、あちらの仕事はあまりにも膨大で、他にも仲間を欲しがったのか。"
msgstr ""

#. Occurrence D_3:759:19017: scene=D_3
#: D_3:759
msgctxt "text_id=19017 | speaker=unknown"
msgid "　草十郎には、いくら考えても掴めない事ではあるが。"
msgstr ""

#. Occurrence D_3:785:19018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0007; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:785
msgctxt "text_id=19018 | speaker=soujuurou"
msgid "「……橙子さんは、そうなりたかったのかな」"
msgstr ""

#. Occurrence D_3:819:19019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0023; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:819
msgctxt "text_id=19019 | speaker=aoko"
msgid "「まさか。あの人は単に知りたかっただけよ。"
msgstr ""

#. Occurrence D_3:825:19020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0024; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:825
msgctxt "text_id=19020 | speaker=aoko"
msgid "　その後に残された人たちの事なんて興味はないの。昔から、目標に没頭しても成果を愛する人じゃなかったから」"
msgstr ""

#. Occurrence D_3:883:19021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0025; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:883
msgctxt "text_id=19021 | speaker=aoko"
msgid "「正直なところ、そのあたり姉貴は突き抜けてるわ。"
msgstr ""

#. Occurrence D_3:890:19022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0026; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:890
msgctxt "text_id=19022 | speaker=aoko"
msgid "ホントの天才ってのはああいう非人間のコト言うのよ。苦労して作り上げたモノの、その後をまったく考えないんだから」"
msgstr ""

#. Occurrence D_3:896:19023: scene=D_3
#: D_3:896
msgctxt "text_id=19023 | speaker=unknown"
msgid "　呆れているようにも認めているようにも取れる口ぶり。"
msgstr ""

#. Occurrence D_3:924:19024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0027; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:924
msgctxt "text_id=19024 | speaker=aoko"
msgid "「でも、そのくせ面倒見はいいって言うか。"
msgstr ""

#. Occurrence D_3:930:19025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0028; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:930
msgctxt "text_id=19025 | speaker=aoko"
msgid "　未来の事は考えないのに、今あるものには何にでも興味を持つんだから」"
msgstr ""

#. Occurrence D_3:943:19026: scene=D_3
#: D_3:943
msgctxt "text_id=19026 | speaker=unknown"
msgid "　これだから天才肌の女は、と悪態をつく青子。"
msgstr ""

#. Occurrence D_3:948:19027: scene=D_3
#: D_3:948
msgctxt "text_id=19027 | speaker=unknown"
msgid "　<敵意|てきい>の<欠片|かけら>もない声は、聞くものとしては微笑ましい。"
msgstr ""

#. Occurrence D_3:1002:19028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0008; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:1002
msgctxt "text_id=19028 | speaker=soujuurou"
msgid "「そうだね。それに、橙子さんはこっちの方が好きみたいだったから」"
msgstr ""

#. Occurrence D_3:1008:19029: scene=D_3
#: D_3:1008
msgctxt "text_id=19029 | speaker=unknown"
msgid "　そんな事を口にしたら、草十郎は先ほどの言葉の意味も分かってしまった。"
msgstr ""

#. Occurrence D_3:1027:19030: scene=D_3
#: D_3:1027
msgctxt "text_id=19030 | speaker=unknown"
msgid "“根源になんて興味はない”"
msgstr ""

#. Occurrence D_3:1060:19031: scene=D_3
#: D_3:1060
msgctxt "text_id=19031 | speaker=unknown"
msgid "　つまり青子も、橙子と同じ気持ちなのだろう、と。"
msgstr ""

#. Occurrence D_4:40:19032: scene=D_4
#: D_4:40
msgctxt "text_id=19032 | speaker=unknown"
msgid "　―――と。"
msgstr ""

#. Occurrence D_4:45:19033: scene=D_4
#: D_4:45
msgctxt "text_id=19033 | speaker=unknown"
msgid "　橙子と言えば、草十郎にはちょっとした疑問があった。"
msgstr ""

#. Occurrence D_4:93:19034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0000; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:93
msgctxt "text_id=19034 | speaker=soujuurou"
msgid "「そういえば。カエルにするって、いったい……」"
msgstr ""

#. Occurrence D_4:99:19035: scene=D_4
#: D_4:99
msgctxt "text_id=19035 | speaker=unknown"
msgid "　あれ以来まったく口にしなかった話題を、草十郎は口にしてみた。"
msgstr ""

#. Occurrence D_4:104:19036: scene=D_4
#: D_4:104
msgctxt "text_id=19036 | speaker=unknown"
msgid "　それを訊くのは<禁忌|タブー>のように思えていたし、なにより、その<突飛|とっぴ>さ故、真実を聞くのが<躊躇|ためら>われたというか。"
msgstr ""

#. Occurrence D_4:153:19037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0000; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:153
msgctxt "text_id=19037 | speaker=aoko"
msgid "「いったいも何も、言葉通りの意味だけど。"
msgstr ""

#. Occurrence D_4:159:19038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0001; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:159
msgctxt "text_id=19038 | speaker=aoko"
msgid "　もともとルーン使いには変身術があるぶん、橙子にはかかりやすかったみたいよ？」"
msgstr ""

#. Occurrence D_4:198:19039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0001; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:198
msgctxt "text_id=19039 | speaker=soujuurou"
msgid "「いや、そんな当然のように言われても……」"
msgstr ""

#. Occurrence D_4:204:19040: scene=D_4
#: D_4:204
msgctxt "text_id=19040 | speaker=unknown"
msgid "　本気でどう切り返していいか、ちくりと胃が痛む草十郎だった。"
msgstr ""

#. Occurrence D_4:264:19041: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0002; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:264
msgctxt "text_id=19041 | speaker=soujuurou"
msgid "「…………まあ。それで、どうやって？」"
msgstr ""

#. Occurrence D_4:270:19042: scene=D_4
#: D_4:270
msgctxt "text_id=19042 | speaker=unknown"
msgid "　聞きたくはないけれど、話の流れから問いたださずにはいられない。"
msgstr ""

#. Occurrence D_4:275:19043: scene=D_4
#: D_4:275
msgctxt "text_id=19043 | speaker=unknown"
msgid "　草十郎の嫌そうな顔には気が付かず、青子は前を見たまま、教師よろしく説明をする。"
msgstr ""

#. Occurrence D_4:321:19044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0002; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:321
msgctxt "text_id=19044 | speaker=aoko"
msgid "「二種類あって、精神を入れ替えるのか、肉体を再編成するかね。"
msgstr ""

#. Occurrence D_4:327:19045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0003; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:327
msgctxt "text_id=19045 | speaker=aoko"
msgid "　精神だけを入れ替えるのは簡単な分、すぐ元に戻れるわ。"
msgstr ""

#. Occurrence D_4:333:19046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0004; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:333
msgctxt "text_id=19046 | speaker=aoko"
msgid "　夢を見ているようなものだし、ちょっとしたショックで元の体に意識が戻ってくれるから」"
msgstr ""

#. Occurrence D_4:360:19047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0005; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:360
msgctxt "text_id=19047 | speaker=aoko"
msgid "「厄介なのは肉体そのものを変えてしまう方で、この場合、術が切れるまで元に戻るのは難しいでしょうね。"
msgstr ""

#. Occurrence D_4:366:19048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0006; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:366
msgctxt "text_id=19048 | speaker=aoko"
msgid "　私がやったのは、その再編成の方みたい。"
msgstr ""

#. Occurrence D_4:378:19049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0007; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:378
msgctxt "text_id=19049 | speaker=aoko"
msgid "　たぶん塩基配列を組み換えるんだろうけど、もうちんぷんかんぷん。ま、魔術が科学的な説明するのもナンセンスだし？」"
msgstr ""

#. Occurrence D_4:398:19050: scene=D_4
#: D_4:398
msgctxt "text_id=19050 | speaker=unknown"
msgid "　しれっと、まさに他人事のように青子は言った。"
msgstr ""

#. Occurrence D_4:403:19051: scene=D_4
#: D_4:403
msgctxt "text_id=19051 | speaker=unknown"
msgid "　あの時の青子が扱った魔術は前借りしたようなもので、今の青子にはまったく使えないものらしい。"
msgstr ""

#. Occurrence D_4:441:19052: scene=D_4
#: D_4:441
msgctxt "text_id=19052 | speaker=unknown"
msgid "　不幸中の幸いではあるが、同時に、十年後にくる逃れられない脅威でもある。"
msgstr ""

#. Occurrence D_4:446:19053: scene=D_4
#: D_4:446
msgctxt "text_id=19053 | speaker=unknown"
msgid "　とばっちりを受ける候補その一としては、たいへん頭の痛い問題だった。"
msgstr ""

#. Occurrence D_4:473:19054: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0003; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:473
msgctxt "text_id=19054 | speaker=soujuurou"
msgid "「あと数年後には蒼崎はそんな事もできるのか。"
msgstr ""

#. Occurrence D_4:479:19055: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0004; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:479
msgctxt "text_id=19055 | speaker=soujuurou"
msgid "　…………<末|すえ>恐ろしいな」"
msgstr ""

#. Occurrence D_4:491:19056: scene=D_4
#: D_4:491
msgctxt "text_id=19056 | speaker=unknown"
msgid "　心底からの気持ちを呟く草十郎。"
msgstr ""

#. Occurrence D_4:496:19057: scene=D_4
#: D_4:496
msgctxt "text_id=19057 | speaker=unknown"
msgid "　それに青子はきょとんと目を見開く。"
msgstr ""

#. Occurrence D_4:501:19058: scene=D_4
#: D_4:501
msgctxt "text_id=19058 | speaker=unknown"
msgid "　何をいまさら、と言いたげな顔だった。"
msgstr ""

#. Occurrence D_4:552:19059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0008; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:552
msgctxt "text_id=19059 | speaker=aoko"
msgid "「えっとね。有珠ならそれぐらい、今でもできるわよ」"
msgstr ""

#. Occurrence D_4:635:19060: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0005; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:635
msgctxt "text_id=19060 | speaker=soujuurou"
msgid "「――――――なん、だと？」"
msgstr ""

#. Occurrence D_4:696:19061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0009; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:696
msgctxt "text_id=19061 | speaker=aoko"
msgid "「……やっぱりね、そんな事だと思ってたわ。"
msgstr ""

#. Occurrence D_4:702:19062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0010; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:702
msgctxt "text_id=19062 | speaker=aoko"
msgid "　前にも言ったでしょ、アンタはあの娘を甘く見てるって。"
msgstr ""

#. Occurrence D_4:708:19063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0011; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:708
msgctxt "text_id=19063 | speaker=aoko"
msgid "　有珠の部屋のもろもろの人形は、あの娘に逆らった執事たちのなれの果てなんだから」"
msgstr ""

#. Occurrence D_4:736:19064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0006; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:736
msgctxt "text_id=19064 | speaker=soujuurou"
msgid "「……まさか。有珠はそんなコトしないぞ」"
msgstr ""

#. Occurrence D_4:799:19065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0012; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:799
msgctxt "text_id=19065 | speaker=aoko"
msgid "「いやいや、これがこれが。私もねー、付き合い初めて半年はそう思ってたんだけどねー」"
msgstr ""

#. Occurrence D_4:804:19066: scene=D_4
#: D_4:804
msgctxt "text_id=19066 | speaker=unknown"
msgid "　軽快に笑いとばす青子だが、その陽気さが逆に怖い。"
msgstr ""

#. Occurrence D_4:854:19067: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0007; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:854
msgctxt "text_id=19067 | speaker=soujuurou"
msgid "「……蒼崎。その冗談、笑えないぞ」"
msgstr ""

#. Occurrence D_4:886:19068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0013; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:886
msgctxt "text_id=19068 | speaker=aoko"
msgid "「あら、私は笑わせる気なんて、これっぽっちもないんだけど？」"
msgstr ""

#. Occurrence D_4:936:19069: scene=D_4
#: D_4:936
msgctxt "text_id=19069 | speaker=unknown"
msgid "　青子は明らかに草十郎をからかっている。"
msgstr ""

#. Occurrence D_4:941:19070: scene=D_4
#: D_4:941
msgctxt "text_id=19070 | speaker=unknown"
msgid "　どこまで信じていいのか判別がつかず、ますます顔をしかめる草十郎。"
msgstr ""

#. Occurrence D_4:947:19071: scene=D_4
#: D_4:947
msgctxt "text_id=19071 | speaker=unknown"
msgid "そんな消沈ぶりが楽しくて、青子はにまにまと微笑んでいる。"
msgstr ""

#. Occurrence D_4:1006:19072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0014; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:1006
msgctxt "text_id=19072 | speaker=aoko"
msgid "“……ま、あそこでアンタの言葉にうなずいちゃうあの娘が、そこまで魔女になれる筈もないんだけど―――”"
msgstr ""

#. Occurrence D_4:1012:19073: scene=D_4
#: D_4:1012
msgctxt "text_id=19073 | speaker=unknown"
msgid "　温かな感想を胸に留めた少女は、彼の横顔を見ながら歩いていく。"
msgstr ""

#. Occurrence D_5:72:19074: scene=D_5
#: D_5:72
msgctxt "text_id=19074 | speaker=unknown"
msgid "　道はいつしか、<畦道|あぜみち>から山道になっていた。"
msgstr ""

#. Occurrence D_5:78:19075: scene=D_5
#: D_5:78
msgctxt "text_id=19075 | speaker=unknown"
msgid "　小振りな山は思いのほか<拓|ひら>けていて、木々はあるものの、山道は横に広い。"
msgstr ""

#. Occurrence D_5:83:19076: scene=D_5
#: D_5:83
msgctxt "text_id=19076 | speaker=unknown"
msgid "　自然の並木道は<延々|えんえん>と山頂に向かっている。"
msgstr ""

#. Occurrence D_5:109:19077: scene=D_5
#: D_5:109
msgctxt "text_id=19077 | speaker=unknown"
msgid "　土の道には<轍|わだち>がある。"
msgstr ""

#. Occurrence D_5:114:19078: scene=D_5
#: D_5:114
msgctxt "text_id=19078 | speaker=unknown"
msgid "　おそらく蒼崎の家から車が通っているのだろう。"
msgstr ""

#. Occurrence D_5:119:19079: scene=D_5
#: D_5:119
msgctxt "text_id=19079 | speaker=unknown"
msgid "　はげ山には街灯も民家もなく、明かりは星と月の光だけだった。"
msgstr ""

#. Occurrence D_5:168:19080: scene=D_5
#: D_5:168
msgctxt "text_id=19080 | speaker=unknown"
msgid "　山道の傾斜は、段々と平坦になっていく。"
msgstr ""

#. Occurrence D_5:173:19081: scene=D_5
#: D_5:173
msgctxt "text_id=19081 | speaker=unknown"
msgid "　道はずっと先にある民家の前で途切れようとしていた。"
msgstr ""

#. Occurrence D_5:179:19082: scene=D_5
#: D_5:179
msgctxt "text_id=19082 | speaker=unknown"
msgid "　まだ遠くで建物の<輪郭|りんかく>も掴めないけれど、暖かそうな窓明かりから、あれが蒼崎の家だろうと草十郎は読み取った。"
msgstr ""

#. Occurrence D_5:201:19083: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0000; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:201
msgctxt "text_id=19083 | speaker=soujuurou"
msgid "「ところで、君が家で団らんしている間、自分は何をしていればいいんだろう」"
msgstr ""

#. Occurrence D_5:207:19084: scene=D_5
#: D_5:207
msgctxt "text_id=19084 | speaker=unknown"
msgid "　一家<団欒|だんらん>する青子の姿は想像しにくかったが、無理やりしてみると、それはそれでたいへん幸福そうな場面が想像できた。"
msgstr ""

#. Occurrence D_5:212:19085: scene=D_5
#: D_5:212
msgctxt "text_id=19085 | speaker=unknown"
msgid "　自分が入る事でそれを壊すのは<忍|しの>びなく、草十郎は青子にそう訊ねたのだ。"
msgstr ""

#. Occurrence D_5:302:19086: scene=D_5
#: D_5:302
msgctxt "text_id=19086 | speaker=unknown"
msgid "　草十郎としては今から帰っても、ここで一晩<野営|やえい>しても文句はない。"
msgstr ""

#. Occurrence D_5:307:19087: scene=D_5
#: D_5:307
msgctxt "text_id=19087 | speaker=unknown"
msgid "　けれど、青子の返答は予想外のものだった。"
msgstr ""

#. Occurrence D_5:329:19088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0000; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:329
msgctxt "text_id=19088 | speaker=aoko"
msgid "「君は、うちの離れにいって祖父に会うの。"
msgstr ""

#. Occurrence D_5:335:19089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0001; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:335
msgctxt "text_id=19089 | speaker=aoko"
msgid "　たぶん、そこで今日までの記憶を消されるわ」"
msgstr ""

#. Occurrence D_5:342:19090: scene=D_5
#: D_5:342
msgctxt "text_id=19090 | speaker=unknown"
msgid "　ぴたりと足を止めて青子はそう言った。"
msgstr ""

#. Occurrence D_5:347:19091: scene=D_5
#: D_5:347
msgctxt "text_id=19091 | speaker=unknown"
msgid "　今までの打ち解けた雰囲気もなく、他人と話すように。"
msgstr ""

#. Occurrence D_5:402:19092: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0001; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:402
msgctxt "text_id=19092 | speaker=soujuurou"
msgid "「え………………？」"
msgstr ""

#. Occurrence D_5:407:19093: scene=D_5
#: D_5:407
msgctxt "text_id=19093 | speaker=unknown"
msgid "　驚いて、草十郎も足を止める。"
msgstr ""

#. Occurrence D_5:430:19094: scene=D_5
#: D_5:430
msgctxt "text_id=19094 | speaker=unknown"
msgid "　追い抜いてしまった青子を振り返ると、それが真実である事がはっきりと分かった。"
msgstr ""

#. Occurrence D_5:451:19095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0002; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:451
msgctxt "text_id=19095 | speaker=aoko"
msgid "「…………………………」"
msgstr ""

#. Occurrence D_5:456:19096: scene=D_5
#: D_5:456
msgctxt "text_id=19096 | speaker=unknown"
msgid "　睨むような沈黙と、それを自然に受けとめる草十郎。"
msgstr ""

#. Occurrence D_5:461:19097: scene=D_5
#: D_5:461
msgctxt "text_id=19097 | speaker=unknown"
msgid "　先に口を開けたのは、やっぱり青子だった。"
msgstr ""

#. Occurrence D_5:492:19098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0003; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:492
msgctxt "text_id=19098 | speaker=aoko"
msgid "「驚かないのね、貴方」"
msgstr ""

#. Occurrence D_5:528:19099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0002; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:528
msgctxt "text_id=19099 | speaker=soujuurou"
msgid "「……いや、驚いたけど。でも、それは初めから決まっていた事だ。そうか、それで蒼崎は俺を連れて来たのか」"
msgstr ""

#. Occurrence D_5:540:19100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0004; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:540
msgctxt "text_id=19100 | speaker=aoko"
msgid "「退屈しのぎは本当よ。それとは別に、祖父が貴方を連れて来いって言ったの」"
msgstr ""

#. Occurrence D_5:656:19101: scene=D_5
#: D_5:656
msgctxt "text_id=19101 | speaker=unknown"
msgid "　なるほど、と少年はうなずく。"
msgstr ""

#. Occurrence D_5:661:19102: scene=D_5
#: D_5:661
msgctxt "text_id=19102 | speaker=unknown"
msgid "　夜は<密|ひそ>やかに変わりなく、少年も、なにひとつ変わりはなかった。"
msgstr ""

#. Occurrence D_5:666:19103: scene=D_5
#: D_5:666
msgctxt "text_id=19103 | speaker=unknown"
msgid "　……目前の少女が、その在り方を憎らしいと思うほどに。"
msgstr ""

#. Occurrence D_5:694:19104: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0003; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:694
msgctxt "text_id=19104 | speaker=soujuurou"
msgid "「それじゃ行こうか。立っていると寒い」"
msgstr ""

#. Occurrence D_5:700:19105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0005; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:700
msgctxt "text_id=19105 | speaker=aoko"
msgid "「草十郎」"
msgstr ""

#. Occurrence D_5:705:19106: scene=D_5
#: D_5:705
msgctxt "text_id=19106 | speaker=unknown"
msgid "　歩きだそうとする草十郎を、青子は声で引き止める。"
msgstr ""

#. Occurrence D_5:711:19107: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0006; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:711
msgctxt "text_id=19107 | speaker=aoko"
msgid "「貴方はそれでいいの？"
msgstr ""

#. Occurrence D_5:717:19108: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0007; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:717
msgctxt "text_id=19108 | speaker=aoko"
msgid "　記憶を消されるって事は、今までの一ヶ月がなくなるのと同じなのよ」"
msgstr ""

#. Occurrence D_5:786:19109: scene=D_5
#: D_5:786
msgctxt "text_id=19109 | speaker=unknown"
msgid "　青子の問いに、草十郎はそうか、と呟いた。"
msgstr ""

#. Occurrence D_5:791:19110: scene=D_5
#: D_5:791
msgctxt "text_id=19110 | speaker=unknown"
msgid "　青子の事はもちろん、有珠の事や、あの洋館での暮らしを忘れて一ヶ月前の自分に戻るのは、手に入れかけた宝物を無くしてしまうような気がする。"
msgstr ""

#. Occurrence D_5:796:19111: scene=D_5
#: D_5:796
msgctxt "text_id=19111 | speaker=unknown"
msgid "　けれど、それを惜しいと、彼は思わなかった。"
msgstr ""

#. Occurrence D_5:847:19112: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0004; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:847
msgctxt "text_id=19112 | speaker=soujuurou"
msgid "「たしかにそれは嫌だな。蒼崎と知り合ってからの一ヶ月は楽しかったし、有珠とも約束したばっかりだし。"
msgstr ""

#. Occurrence D_5:853:19113: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0005; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:853
msgctxt "text_id=19113 | speaker=soujuurou"
msgid "　でも蒼崎が消えるわけじゃないんだろう？　冬休みが終われば、また学校で会えるじゃないか」"
msgstr ""

#. Occurrence D_5:900:19114: scene=D_5
#: D_5:900
msgctxt "text_id=19114 | speaker=unknown"
msgid "　それに青子は返答しなかった。"
msgstr ""

#. Occurrence D_5:905:19115: scene=D_5
#: D_5:905
msgctxt "text_id=19115 | speaker=unknown"
msgid "　青子はあえて口にはしなかったが、記憶を消されるのは草十郎だけではない。"
msgstr ""

#. Occurrence D_5:910:19116: scene=D_5
#: D_5:910
msgctxt "text_id=19116 | speaker=unknown"
msgid "　彼女の祖父が介入する以上、青子も草十郎に関する記憶を消されるのだ。"
msgstr ""

#. Occurrence D_5:978:19117: scene=D_5
#: D_5:978
msgctxt "text_id=19117 | speaker=unknown"
msgid "　その後には、お互いの接点はないように思われた。"
msgstr ""

#. Occurrence D_5:983:19118: scene=D_5
#: D_5:983
msgctxt "text_id=19118 | speaker=unknown"
msgid "　こんな関係になる事もなく、ただ気に食わない生徒にしか見えない。"
msgstr ""

#. Occurrence D_5:988:19119: scene=D_5
#: D_5:988
msgctxt "text_id=19119 | speaker=unknown"
msgid "　どんなに優れた偶然が働いても、もう、今の状況には戻れない。"
msgstr ""

#. Occurrence D_5:993:19120: scene=D_5
#: D_5:993
msgctxt "text_id=19120 | speaker=unknown"
msgid "　……それを少し残念だと思うのは、たしかに、未練だと認めるしかない。"
msgstr ""

#. Occurrence D_5:1014:19121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0008; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1014
msgctxt "text_id=19121 | speaker=aoko"
msgid "「そう。なら行きましょ」"
msgstr ""

#. Occurrence D_5:1060:19122: scene=D_5
#: D_5:1060
msgctxt "text_id=19122 | speaker=unknown"
msgid "　整理のつかないまま、理屈だけで感情を切り捨てて、青子は歩きだした。"
msgstr ""

#. Occurrence D_5:1066:19123: scene=D_5
#: D_5:1066
msgctxt "text_id=19123 | speaker=unknown"
msgid "　そのとなりに草十郎は付き添っていく。"
msgstr ""

#. Occurrence D_5:1087:19124: scene=D_5
#: D_5:1087
msgctxt "text_id=19124 | speaker=unknown"
msgid "　目的地まであと数分。"
msgstr ""

#. Occurrence D_5:1092:19125: scene=D_5
#: D_5:1092
msgctxt "text_id=19125 | speaker=unknown"
msgid "　草十郎はいつも通りの顔で歩いていて、青子にはそれが腹立たしい。"
msgstr ""

#. Occurrence D_5:1105:19126: scene=D_5
#: D_5:1105
msgctxt "text_id=19126 | speaker=unknown"
msgid "　こっちはホンの少しだけど未練と思っているのに、この男は<微塵|みじん>もそう思っていないのだ。"
msgstr ""

#. Occurrence D_5:1133:19127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0009; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1133
msgctxt "text_id=19127 | speaker=aoko"
msgid "「……そりゃあね、平気で自分の腕を叩き折れるヤツに、そんな<繊細|せんさい>なコト期待していないけ、ど……」"
msgstr ""

#. Occurrence D_5:1167:19128: scene=D_5
#: D_5:1167
msgctxt "text_id=19128 | speaker=unknown"
msgid "　つい憎まれ口を叩いて、青子は唐突に思い出した。"
msgstr ""

#. Occurrence D_5:1172:19129: scene=D_5
#: D_5:1172
msgctxt "text_id=19129 | speaker=unknown"
msgid "　いや、思い至ってしまった。"
msgstr ""

#. Occurrence D_5:1219:19130: scene=D_5
#: D_5:1219
msgctxt "text_id=19130 | speaker=unknown"
msgid "　一度きりの狼退治。"
msgstr ""

#. Occurrence D_5:1224:19131: scene=D_5
#: D_5:1224
msgctxt "text_id=19131 | speaker=unknown"
msgid "　静希草十郎とは何者なのか、という不明点を。"
msgstr ""

#. Occurrence D_5:1229:19132: scene=D_5
#: D_5:1229
msgctxt "text_id=19132 | speaker=unknown"
msgid "　あの夜の青子は草十郎の<時間|きおく>を知ってはいたが、今の青子は知る<由|よし>もない。"
msgstr ""

#. Occurrence D_5:1239:19133: scene=D_5
#: D_5:1239
msgctxt "text_id=19133 | speaker=unknown"
msgid "　この凡庸な少年の間違い。"
msgstr ""

#. Occurrence D_5:1245:19134: scene=D_5
#: D_5:1245
msgctxt "text_id=19134 | speaker=unknown"
msgid "なぜあんな事が出来たのか、そもそも、彼は山でどんな生活をしていたのか。"
msgstr ""

#. Occurrence D_5:1270:19135: scene=D_5
#: D_5:1270
msgctxt "text_id=19135 | speaker=unknown"
msgid "　今まで気になってはいたものの、ついに聞き出す機会には恵まれなかった。"
msgstr ""

#. Occurrence D_5:1275:19136: scene=D_5
#: D_5:1275
msgctxt "text_id=19136 | speaker=unknown"
msgid "　その疑問も、祖父に会えば疑問と思う事さえなくなってしまうだろう。"
msgstr ""

#. Occurrence D_5:1304:19137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0010; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1304
msgctxt "text_id=19137 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence D_5:1310:19138: scene=D_5
#: D_5:1310
msgctxt "text_id=19138 | speaker=unknown"
msgid "　たとえすぐに忘れてしまうにしても―――いや、数分後には何もかも無かった事になるのなら。"
msgstr ""

#. Occurrence D_5:1315:19139: scene=D_5
#: D_5:1315
msgctxt "text_id=19139 | speaker=unknown"
msgid "　彼に、その矛盾を吐き出させる機会は今しかない。"
msgstr ""

#. Occurrence D_5:1364:19140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0011; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1364
msgctxt "text_id=19140 | speaker=aoko"
msgid "「待って。私も最後にひとつ、訊きたい事がある。"
msgstr ""

#. Occurrence D_5:1370:19141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0012; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1370
msgctxt "text_id=19141 | speaker=aoko"
msgid "　―――アンタ、山でどんな生活を送ってたの？」"
msgstr ""

#. Occurrence D_5:1378:19142: scene=D_5
#: D_5:1378
msgctxt "text_id=19142 | speaker=unknown"
msgid "　青子の問いに、草十郎はぴたりと足を止めた。"
msgstr ""

#. Occurrence D_5:1383:19143: scene=D_5
#: D_5:1383
msgctxt "text_id=19143 | speaker=unknown"
msgid "　その顔は今までのどんなものより<辛|つら>そうに見える。"
msgstr ""

#. Occurrence D_5:1425:19144: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0006; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1425
msgctxt "text_id=19144 | speaker=soujuurou"
msgid "「つまらないよ、そんな話は」"
msgstr ""

#. Occurrence D_5:1431:19145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0013; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1431
msgctxt "text_id=19145 | speaker=aoko"
msgid "「面白い話は期待してないって言ったでしょ。"
msgstr ""

#. Occurrence D_5:1437:19146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0014; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1437
msgctxt "text_id=19146 | speaker=aoko"
msgid "　どうせ私も草十郎の事は忘れるんだから、それぐらい話してくれてもいいんじゃない？」"
msgstr ""

#. Occurrence D_5:1443:19147: scene=D_5
#: D_5:1443
msgctxt "text_id=19147 | speaker=unknown"
msgid "　けち、とばかりに見据える青子の発言に、草十郎は驚いて顔をあげた。"
msgstr ""

#. Occurrence D_5:1469:19148: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0007; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1469
msgctxt "text_id=19148 | speaker=soujuurou"
msgid "「……忘れるって、蒼崎が？」"
msgstr ""

#. Occurrence D_5:1498:19149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0015; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1498
msgctxt "text_id=19149 | speaker=aoko"
msgid "「当然よ。アンタが忘れても、私が覚えているんじゃ意味がないでしょう。お互いが忘れなくちゃ人と人の関係は断てないわ。"
msgstr ""

#. Occurrence D_5:1510:19150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0016; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1510
msgctxt "text_id=19150 | speaker=aoko"
msgid "　……行って来いで公平じゃない。"
msgstr ""

#. Occurrence D_5:1517:19151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0017; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1517
msgctxt "text_id=19151 | speaker=aoko"
msgid "なんで、そんな顔するの」"
msgstr ""

#. Occurrence D_5:1537:19152: scene=D_5
#: D_5:1537
msgctxt "text_id=19152 | speaker=unknown"
msgid "　言われて、草十郎は口元を手で隠した。"
msgstr ""

#. Occurrence D_5:1542:19153: scene=D_5
#: D_5:1542
msgctxt "text_id=19153 | speaker=unknown"
msgid "　自分がどんな顔をしていたか判らないが、情けない顔をしている気がして。"
msgstr ""

#. Occurrence D_5:1637:19154: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0008; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1637
msgctxt "text_id=19154 | speaker=soujuurou"
msgid "「そうか、蒼崎も忘れるのか。"
msgstr ""

#. Occurrence D_5:1642:19155: scene=D_5
#: D_5:1642
msgctxt "text_id=19155 | speaker=unknown"
msgid "　…………"
msgstr ""

#. Occurrence D_5:1649:19156: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0009; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1649
msgctxt "text_id=19156 | speaker=soujuurou"
msgid "そこまでは、考えていなかった」"
msgstr ""

#. Occurrence D_5:1655:19157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0018; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1655
msgctxt "text_id=19157 | speaker=aoko"
msgid "「ええ。そして、私は貴方とは会わなくなる。断定はできないけど、まず間違いなくね」"
msgstr ""

#. Occurrence D_5:1675:19158: scene=D_5
#: D_5:1675
msgctxt "text_id=19158 | speaker=unknown"
msgid "　だから、これは最後の会話。"
msgstr ""

#. Occurrence D_5:1680:19159: scene=D_5
#: D_5:1680
msgctxt "text_id=19159 | speaker=unknown"
msgid "　青子の台詞からも、お互いが忘れるという事からも、それは感じ取れた。"
msgstr ""

#. Occurrence D_5:1700:19160: scene=D_5
#: D_5:1700
msgctxt "text_id=19160 | speaker=unknown"
msgid "　蒼崎青子は変わらず学校にいて、その後ろ姿に草十郎は<憧|あこが>れる。"
msgstr ""

#. Occurrence D_5:1705:19161: scene=D_5
#: D_5:1705
msgctxt "text_id=19161 | speaker=unknown"
msgid "　けれど、その先に接点はない。"
msgstr ""

#. Occurrence D_5:1711:19162: scene=D_5
#: D_5:1711
msgctxt "text_id=19162 | speaker=unknown"
msgid "どんなに草十郎が話しかけても、青子は他人を必要としていないのだから。"
msgstr ""

#. Occurrence D_5:1716:19163: scene=D_5
#: D_5:1716
msgctxt "text_id=19163 | speaker=unknown"
msgid "　……いや、そもそも自分から話しかける事が彼にはできない。少なくとも、一ヶ月前の草十郎には。"
msgstr ""

#. Occurrence D_5:1845:19164: scene=D_5
#: D_5:1845
msgctxt "text_id=19164 | speaker=unknown"
msgid "　そこでようやく、彼は忘却の<無|む><慈|じ><悲|ひ>さを知った。"
msgstr ""

#. Occurrence D_5:1850:19165: scene=D_5
#: D_5:1850
msgctxt "text_id=19165 | speaker=unknown"
msgid "　青子の事を忘れる、とは彼女との出来事を忘れるのではなく、蒼崎青子という名前、存在からして忘れる、という事だ。"
msgstr ""

#. Occurrence D_5:1855:19166: scene=D_5
#: D_5:1855
msgctxt "text_id=19166 | speaker=unknown"
msgid "　彼女に憧れる自分はいても、その正体を掴む事はない。"
msgstr ""

#. Occurrence D_5:1860:19167: scene=D_5
#: D_5:1860
msgctxt "text_id=19167 | speaker=unknown"
msgid "　どんなに優れた偶然が働いても、今の状況には戻れない。"
msgstr ""

#. Occurrence D_5:1880:19168: scene=D_5
#: D_5:1880
msgctxt "text_id=19168 | speaker=unknown"
msgid "　この夜の歩みは、互いの死を見取る<葬式|そうしき>と変わらない。"
msgstr ""

#. Occurrence D_5:1888:19169: scene=D_5
#: D_5:1888
msgctxt "text_id=19169 | speaker=unknown"
msgid "　草十郎は蒼崎青子という人物を殺して、"
msgstr ""

#. Occurrence D_5:1893:19170: scene=D_5
#: D_5:1893
msgctxt "text_id=19170 | speaker=unknown"
msgid "　青子は静希草十郎という人物を殺す。"
msgstr ""

#. Occurrence D_5:1899:19171: scene=D_5
#: D_5:1899
msgctxt "text_id=19171 | speaker=unknown"
msgid "　その後に残るものは、何もない。"
msgstr ""

#. Occurrence D_5:1968:19172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0019; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1968
msgctxt "text_id=19172 | speaker=aoko"
msgid "「だから、その前に聞いておきたいの。嫌だっていうなら、あとはこのまま家まで直行するだけだけど」"
msgstr ""

#. Occurrence D_5:2000:19173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0010; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:2000
msgctxt "text_id=19173 | speaker=soujuurou"
msgid "「それはさみしいな。"
msgstr ""

#. Occurrence D_5:2007:19174: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0011; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:2007
msgctxt "text_id=19174 | speaker=soujuurou"
msgid "……うん、くだらない話だけど、会話がないよりはましだろう」"
msgstr ""

#. Occurrence D_5:2100:19175: scene=D_5
#: D_5:2100
msgctxt "text_id=19175 | speaker=unknown"
msgid "　呟いて、草十郎は歩きだした。"
msgstr ""

#. Occurrence D_5:2106:19176: scene=D_5
#: D_5:2106
msgctxt "text_id=19176 | speaker=unknown"
msgid "　今度は青子が付き添うよう、となりに並ぶ。"
msgstr ""

#. Occurrence D_5:2112:19177: scene=D_5
#: D_5:2112
msgctxt "text_id=19177 | speaker=unknown"
msgid "　道はあと数分足らずで終わろうとしている。"
msgstr ""

#. Occurrence D_5:2118:19178: scene=D_5
#: D_5:2118
msgctxt "text_id=19178 | speaker=unknown"
msgid "　寒さのせいでふたりの吐息は白く、暗い夜道によく残った。"
msgstr ""

#. Occurrence D_6:42:19179: scene=D_6
#: D_6:42
msgctxt "text_id=19179 | speaker=unknown"
msgid "　後になって青子は振り返る。"
msgstr ""

#. Occurrence D_6:47:19180: scene=D_6
#: D_6:47
msgctxt "text_id=19180 | speaker=unknown"
msgid "　あれは会話ではなく告解に近いもので―――"
msgstr ""

#. Occurrence D_6:52:19181: scene=D_6
#: D_6:52
msgctxt "text_id=19181 | speaker=unknown"
msgid "　彼にしては長く続けられた、不出来な昔話のようだったと。"
msgstr ""

#. Occurrence D_6:87:19182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0000; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:87
msgctxt "text_id=19182 | speaker=soujuurou"
msgid "「山での暮らしは、別に、どうという事はない。"
msgstr ""

msgctxt "text_id=19183 | speaker=unknown"
msgid "毎日同じ事を繰り返して、毎日同じ事を教えられた。"
msgstr ""

#. Occurrence D_6:95:19184: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0001; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:95
msgctxt "text_id=19184 | speaker=soujuurou"
msgid "　そこでは明日はないんだ。"
msgstr ""

#. Occurrence D_6:103:19185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0002; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:103
msgctxt "text_id=19185 | speaker=soujuurou"
msgid "始まりが朝で、夜になれば終わる。一日は次の日には繋がらない。"
msgstr ""

msgctxt "text_id=19186 | speaker=unknown"
msgid "だから、明日を夢見る事もない」"
msgstr ""

#. Occurrence D_6:128:19187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0003; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:128
msgctxt "text_id=19187 | speaker=soujuurou"
msgid "「次の日を楽しみにする、なんて言葉は、こっちに来てから知った感覚だったな。"
msgstr ""

#. Occurrence D_6:134:19188: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0004; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:134
msgctxt "text_id=19188 | speaker=soujuurou"
msgid "　初めは馴染めなかったし、馴染む気もなかった。"
msgstr ""

#. Occurrence D_6:140:19189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0005; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:140
msgctxt "text_id=19189 | speaker=soujuurou"
msgid "　けど、みんながまた明日、と満足そうに口にする。いつのまにか、そういうものを夢見るようになっている自分がいた」"
msgstr ""

#. Occurrence D_6:219:19190: scene=D_6
#: D_6:219
msgctxt "text_id=19190 | speaker=unknown"
msgid "　歩きながら草十郎は語っていく。"
msgstr ""

#. Occurrence D_6:224:19191: scene=D_6
#: D_6:224
msgctxt "text_id=19191 | speaker=unknown"
msgid "　青子には視線を向けず、前を見つめながら、夜に語りかけるように。"
msgstr ""

#. Occurrence D_6:229:19192: scene=D_6
#: D_6:229
msgctxt "text_id=19192 | speaker=unknown"
msgid "　青子は沈黙に徹している。"
msgstr ""

#. Occurrence D_6:234:19193: scene=D_6
#: D_6:234
msgctxt "text_id=19193 | speaker=unknown"
msgid "　うなずきも問いかけも、今は無意味な行いだ。"
msgstr ""

#. Occurrence D_6:255:19194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0006; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:255
msgctxt "text_id=19194 | speaker=soujuurou"
msgid "「目が覚めていつもの一日に戻って、ふと気が付くと昨日までいた誰かがいない。"
msgstr ""

#. Occurrence D_6:261:19195: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0007; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:261
msgctxt "text_id=19195 | speaker=soujuurou"
msgid "　訊ねてみると、夜に体調を崩したらしい。たまにね、眠れなくなって家から出ていって、それっきりな人もいたんだ。"
msgstr ""

#. Occurrence D_6:267:19196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0008; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:267
msgctxt "text_id=19196 | speaker=soujuurou"
msgid "　見なくなってしばらくした後、崖の下で見覚えのある遺体を見付けた事もあった」"
msgstr ""

#. Occurrence D_6:288:19197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0009; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:288
msgctxt "text_id=19197 | speaker=soujuurou"
msgid "「……今にして思うと、それは異常な事だ。"
msgstr ""

#. Occurrence D_6:294:19198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0010; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:294
msgctxt "text_id=19198 | speaker=soujuurou"
msgid "　集まって暮らしていればそんな事にはならなかったのに、自分たちは関わらなかった。一日で完結する世界だったから、他人は必要じゃなかったのかも知れない」"
msgstr ""

#. Occurrence D_6:383:19199: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0011; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:383
msgctxt "text_id=19199 | speaker=soujuurou"
msgid "「山では食べる物も少なかった。飢えないためには、他の人がよりつけない場所に行くことが多くなる。その途中の道で、いなくなってしまう人も多かった」"
msgstr ""

#. Occurrence D_6:404:19200: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0012; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:404
msgctxt "text_id=19200 | speaker=soujuurou"
msgid "「山では、誰も他人から奪うことを考えなかった。"
msgstr ""

#. Occurrence D_6:411:19201: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0013; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:411
msgctxt "text_id=19201 | speaker=soujuurou"
msgid "　口にできるものを探す時、気をくばる相手は犬だの熊だのだけで、人を気にする事はなかったんだよ。"
msgstr ""

msgctxt "text_id=19202 | speaker=unknown"
msgid "今は、その逆になりつつあるけど。"
msgstr ""

#. Occurrence D_6:419:19203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0014; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:419
msgctxt "text_id=19203 | speaker=soujuurou"
msgid "　ともかく、生活の半分はそれだけで済んでいた」"
msgstr ""

#. Occurrence D_6:439:19204: scene=D_6
#: D_6:439
msgctxt "text_id=19204 | speaker=unknown"
msgid "　草十郎は変わらず前を見つめている。"
msgstr ""

#. Occurrence D_6:444:19205: scene=D_6
#: D_6:444
msgctxt "text_id=19205 | speaker=unknown"
msgid "　思い出に苦しんでいる様子はない。"
msgstr ""

#. Occurrence D_6:449:19206: scene=D_6
#: D_6:449
msgctxt "text_id=19206 | speaker=unknown"
msgid "　青子から見ればとても人の住む環境ではないソレを、彼は当然と思っている。むしろ懐かしがってさえいるようだ。"
msgstr ""

#. Occurrence D_6:455:19207: scene=D_6
#: D_6:455
msgctxt "text_id=19207 | speaker=unknown"
msgid "　けれど、そこからの告白は、ゆっくりと苦悩を刻んでいった。"
msgstr ""

#. Occurrence D_6:496:19208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0015; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:496
msgctxt "text_id=19208 | speaker=soujuurou"
msgid "「もう半分は、まあ、身を守る手段を教わっていた。"
msgstr ""

#. Occurrence D_6:502:19209: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0016; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:502
msgctxt "text_id=19209 | speaker=soujuurou"
msgid "　学校の授業に比べたら些細な事だ。単に、自分の体はどう動くものなのか、生き物はどう動くものなのかを、よく見て、よく考えろと言われた。"
msgstr ""

#. Occurrence D_6:508:19210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0017; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:508
msgctxt "text_id=19210 | speaker=soujuurou"
msgid "　単純な反復運動だ。小石を蹴ったり森の中にこもったり、まあ、そんな意味合いのコトをやっていたんだ」"
msgstr ""

#. Occurrence D_6:585:19211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0018; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:585
msgctxt "text_id=19211 | speaker=soujuurou"
msgid "「あの決まり事がはじまると朝も夜もなかった。"
msgstr ""

#. Occurrence D_6:591:19212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0019; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:591
msgctxt "text_id=19212 | speaker=soujuurou"
msgid "　外の変化に気持ちを向ける余裕はなくて、ふと気が付くとずいぶん長く食事をしていない、なんてのもざらだった。"
msgstr ""

#. Occurrence D_6:597:19213: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0020; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:597
msgctxt "text_id=19213 | speaker=soujuurou"
msgid "　あ、ちゃんとご<飯|はん>はもらえたよ、そういうのの後は」"
msgstr ""

#. Occurrence D_6:618:19214: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0021; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:618
msgctxt "text_id=19214 | speaker=soujuurou"
msgid "「あれが何のためだったのかは、今でも分からない。"
msgstr ""

#. Occurrence D_6:624:19215: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0022; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:624
msgctxt "text_id=19215 | speaker=soujuurou"
msgid "　ただ山で暮らしていくには役に立ったし、そもそもあれだって生活の一部だった。"
msgstr ""

#. Occurrence D_6:630:19216: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0023; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:630
msgctxt "text_id=19216 | speaker=soujuurou"
msgid "　生きるって事はそうする事だって思ってた。こうやって息をして歩くためには、あの繰り返しは当然のものだったんだ」"
msgstr ""

#. Occurrence D_6:674:19217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0000; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:674
msgctxt "text_id=19217 | speaker=aoko"
msgid "「草十郎、それは」"
msgstr ""

#. Occurrence D_6:694:19218: scene=D_6
#: D_6:694
msgctxt "text_id=19218 | speaker=unknown"
msgid "　草十郎は淡々と語るけれど、その異常さに青子は口を挟んでしまった。"
msgstr ""

#. Occurrence D_6:699:19219: scene=D_6
#: D_6:699
msgctxt "text_id=19219 | speaker=unknown"
msgid "　彼は歩きながら、うん、とうなずいて青子にちらりと視線を移す。"
msgstr ""

#. Occurrence D_6:746:19220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0024; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:746
msgctxt "text_id=19220 | speaker=soujuurou"
msgid "「何かがおかしかったんだろう。あれは身を守る知恵じゃなくて、もっと違う用途のものだった。"
msgstr ""

#. Occurrence D_6:752:19221: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0025; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:752
msgctxt "text_id=19221 | speaker=soujuurou"
msgid "　たまにいなくなる知り合いは、山の土になったんじゃなくて、他の場所で、他の理由で消えた場合もあったんだろう」"
msgstr ""

#. Occurrence D_6:851:19222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0026; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:851
msgctxt "text_id=19222 | speaker=soujuurou"
msgid "「でも、考える事さえなかった。"
msgstr ""

#. Occurrence D_6:857:19223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0027; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:857
msgctxt "text_id=19223 | speaker=soujuurou"
msgid "　精神の<隙間|すきま>を知れだの、命の勝ち負けを知れだの、意味をくみ取らないまま<鵜|う><呑|の>みにして、当然のように繰り返した。"
msgstr ""

#. Occurrence D_6:863:19224: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0028; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:863
msgctxt "text_id=19224 | speaker=soujuurou"
msgid "　それがどう評価されるものなのか、俺には分からない。"
msgstr ""

#. Occurrence D_6:869:19225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0029; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:869
msgctxt "text_id=19225 | speaker=soujuurou"
msgid "　ただ、知らなければ。"
msgstr ""

#. Occurrence D_6:875:19226: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0030; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:875
msgctxt "text_id=19226 | speaker=soujuurou"
msgid "　外の事なんて知らなければ、悩むことなく、自分はそこに居続けられたと思う」"
msgstr ""

#. Occurrence D_6:881:19227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0001; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:881
msgctxt "text_id=19227 | speaker=aoko"
msgid "「……貴方の嫌いな、生き死にの真似を続けて？」"
msgstr ""

#. Occurrence D_6:928:19228: scene=D_6
#: D_6:928
msgctxt "text_id=19228 | speaker=unknown"
msgid "　その問いに、彼は答えなかった。"
msgstr ""

#. Occurrence D_6:933:19229: scene=D_6
#: D_6:933
msgctxt "text_id=19229 | speaker=unknown"
msgid "　無言のまま足は進む。"
msgstr ""

#. Occurrence D_6:938:19230: scene=D_6
#: D_6:938
msgctxt "text_id=19230 | speaker=unknown"
msgid "　……数々の矛盾、点在していた不合理を、今更ながら青子は噛みしめる。"
msgstr ""

#. Occurrence D_6:1002:19231: scene=D_6
#: D_6:1002
msgctxt "text_id=19231 | speaker=unknown"
msgid "　たとえば、この少年の教養のバランスだ。"
msgstr ""

#. Occurrence D_6:1007:19232: scene=D_6
#: D_6:1007
msgctxt "text_id=19232 | speaker=unknown"
msgid "　文明の機器をまったく知らないくせに、基礎知識だけは持ち合わせていた。"
msgstr ""

#. Occurrence D_6:1012:19233: scene=D_6
#: D_6:1012
msgctxt "text_id=19233 | speaker=unknown"
msgid "　今の話では人付き合いは皆無だというのに、意思の<疎通|そつう>、言葉による対話に慣れていた。"
msgstr ""

#. Occurrence D_6:1017:19234: scene=D_6
#: D_6:1017
msgctxt "text_id=19234 | speaker=unknown"
msgid "　それは偶発的には生まれるはずのない環境、第三者の意図によって作られた<異常性|おかしさ>だ。"
msgstr ""

#. Occurrence D_6:1037:19235: scene=D_6
#: D_6:1037
msgctxt "text_id=19235 | speaker=unknown"
msgid "　……その、第三者の意図など青子には分からない。"
msgstr ""

#. Occurrence D_6:1042:19236: scene=D_6
#: D_6:1042
msgctxt "text_id=19236 | speaker=unknown"
msgid "　彼のような人間を育てる事に何の意味があったのか。"
msgstr ""

#. Occurrence D_6:1047:19237: scene=D_6
#: D_6:1047
msgctxt "text_id=19237 | speaker=unknown"
msgid "　利害目的か、それとも、その山奥ではいまだに当然の<生活|ありかた>だったのか。"
msgstr ""

#. Occurrence D_6:1069:19238: scene=D_6
#: D_6:1069
msgctxt "text_id=19238 | speaker=unknown"
msgid "　彼は一度だけ、どうして、と訊ねたコトがあるらしい。"
msgstr ""

#. Occurrence D_6:1074:19239: scene=D_6
#: D_6:1074
msgctxt "text_id=19239 | speaker=unknown"
msgid "　疑問を覚えた彼に、彼を引き取った老人は、"
msgstr ""

#. Occurrence D_6:1080:19240: scene=D_6
#: D_6:1080
msgctxt "text_id=19240 | speaker=unknown"
msgid "“んなもんオメエ、昔から続いているだけだろうよ。"
msgstr ""

#. Occurrence D_6:1085:19241: scene=D_6
#: D_6:1085
msgctxt "text_id=19241 | speaker=unknown"
msgid "　続ける理由もなかったが、止める理由もなかったのさ”"
msgstr ""

#. Occurrence D_6:1091:19242: scene=D_6
#: D_6:1091
msgctxt "text_id=19242 | speaker=unknown"
msgid "　そう笑って、彼に<戸籍|こせき>と新生活を<見繕|みつくろ>って、山以外で<野|の><垂|た>れ死ねと見送った。"
msgstr ""

#. Occurrence D_6:1152:19243: scene=D_6
#: D_6:1152
msgctxt "text_id=19243 | speaker=unknown"
msgid "　道の終わりには、彼女の帰る場所があった。"
msgstr ""

#. Occurrence D_6:1157:19244: scene=D_6
#: D_6:1157
msgctxt "text_id=19244 | speaker=unknown"
msgid "　これといって特色のない一般家屋。"
msgstr ""

#. Occurrence D_6:1162:19245: scene=D_6
#: D_6:1162
msgctxt "text_id=19245 | speaker=unknown"
msgid "　街にある一戸建てをそのまま持ってきて、日々の趣味として畑や家畜を育てている、あまりにも平和な家。"
msgstr ""

#. Occurrence D_6:1168:19246: scene=D_6
#: D_6:1168
msgctxt "text_id=19246 | speaker=unknown"
msgid "　それを視界に収めて、先ほどの少女の問いに答えようと、彼は口を開けた。"
msgstr ""

#. Occurrence D_6:1215:19247: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0031; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1215
msgctxt "text_id=19247 | speaker=soujuurou"
msgid "「自分には、できなかった。知らなければ良かったのに、知ってしまったから。"
msgstr ""

#. Occurrence D_6:1222:19248: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0032; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1222
msgctxt "text_id=19248 | speaker=soujuurou"
msgid "その後は簡単だ。"
msgstr ""

#. Occurrence D_6:1228:19249: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0033; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1228
msgctxt "text_id=19249 | speaker=soujuurou"
msgid "　鳴けない鳥はいらないと言われた。"
msgstr ""

#. Occurrence D_6:1234:19250: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0034; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1234
msgctxt "text_id=19250 | speaker=soujuurou"
msgid "　今まで疑いもなく出来た事を、意味を知っただけで出来なくなったものはいらないと」"
msgstr ""

#. Occurrence D_6:1318:19251: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0035; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1318
msgctxt "text_id=19251 | speaker=soujuurou"
msgid "「どんなに山にいたくても、できないのなら意味がない。"
msgstr ""

#. Occurrence D_6:1324:19252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0036; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1324
msgctxt "text_id=19252 | speaker=soujuurou"
msgid "　俺は意味を知った瞬間に、意味を信じるコトができなくなった。だから山を下りたんだ。"
msgstr ""

#. Occurrence D_6:1330:19253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0037; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1330
msgctxt "text_id=19253 | speaker=soujuurou"
msgid "　……けれど、どうなんだろう。"
msgstr ""

#. Occurrence D_6:1336:19254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0038; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1336
msgctxt "text_id=19254 | speaker=soujuurou"
msgid "　そこでは、そうする事だけが全てだった。"
msgstr ""

#. Occurrence D_6:1342:19255: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0039; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1342
msgctxt "text_id=19255 | speaker=soujuurou"
msgid "　そうする事だけしか教えられなかった。"
msgstr ""

#. Occurrence D_6:1349:19256: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0040; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1349
msgctxt "text_id=19256 | speaker=soujuurou"
msgid "だから―――」"
msgstr ""

#. Occurrence D_6:1369:19257: scene=D_6
#: D_6:1369
msgctxt "text_id=19257 | speaker=unknown"
msgid "　間違えていたのは。"
msgstr ""

#. Occurrence D_6:1374:19258: scene=D_6
#: D_6:1374
msgctxt "text_id=19258 | speaker=unknown"
msgid "　おかしかったのは、疑いを持ってしまった自分だったのか、と。"
msgstr ""

#. Occurrence D_6:1379:19259: scene=D_6
#: D_6:1379
msgctxt "text_id=19259 | speaker=unknown"
msgid "　自戒のように、彼の呟きは途切れていった。"
msgstr ""

#. Occurrence D_6:1420:19260: scene=D_6
#: D_6:1420
msgctxt "text_id=19260 | speaker=unknown"
msgid "　……青子は思う。"
msgstr ""

#. Occurrence D_6:1425:19261: scene=D_6
#: D_6:1425
msgctxt "text_id=19261 | speaker=unknown"
msgid "　彼の<棲|す>んでいた世界は、ある意味で完成していた。"
msgstr ""

#. Occurrence D_6:1506:19262: scene=D_6
#: D_6:1506
msgctxt "text_id=19262 | speaker=unknown"
msgid "　一つの事柄を成立させたければ、それ以外は何もない世界を作ればいい。"
msgstr ""

#. Occurrence D_6:1511:19263: scene=D_6
#: D_6:1511
msgctxt "text_id=19263 | speaker=unknown"
msgid "　それがどんな不道徳な事でも、不道徳という概念を知らなければ、それは正義だ。"
msgstr ""

#. Occurrence D_6:1516:19264: scene=D_6
#: D_6:1516
msgctxt "text_id=19264 | speaker=unknown"
msgid "　いや、そもそも正しさの観念すらない。"
msgstr ""

#. Occurrence D_6:1522:19265: scene=D_6
#: D_6:1522
msgctxt "text_id=19265 | speaker=unknown"
msgid "　あるのはただ一つ。"
msgstr ""

#. Occurrence D_6:1528:19266: scene=D_6
#: D_6:1528
msgctxt "text_id=19266 | speaker=unknown"
msgid "その世界が、あまりにも行き止まっている、という事だけ。"
msgstr ""

#. Occurrence D_6:1548:19267: scene=D_6
#: D_6:1548
msgctxt "text_id=19267 | speaker=unknown"
msgid "　……悲劇は、そこで満ち足りてしまった事だ。"
msgstr ""

#. Occurrence D_6:1554:19268: scene=D_6
#: D_6:1554
msgctxt "text_id=19268 | speaker=unknown"
msgid "　その間違いだらけの世界で、"
msgstr ""

#. Occurrence D_6:1559:19269: scene=D_6
#: D_6:1559
msgctxt "text_id=19269 | speaker=unknown"
msgid "　　　間違いだらけの人間として、"
msgstr ""

#. Occurrence D_6:1564:19270: scene=D_6
#: D_6:1564
msgctxt "text_id=19270 | speaker=unknown"
msgid "　　　　こうやって残ってしまった。"
msgstr ""

#. Occurrence D_6:1584:19271: scene=D_6
#: D_6:1584
msgctxt "text_id=19271 | speaker=unknown"
msgid "　彼はそれを悪と知りながら、今でも美しいと感じている。"
msgstr ""

#. Occurrence D_6:1590:19272: scene=D_6
#: D_6:1590
msgctxt "text_id=19272 | speaker=unknown"
msgid "　真相はどうあれ、彼にとって、その世界は完成していた。"
msgstr ""

#. Occurrence D_6:1595:19273: scene=D_6
#: D_6:1595
msgctxt "text_id=19273 | speaker=unknown"
msgid "　悪いのは外の世界を知ってしまった自分。"
msgstr ""

#. Occurrence D_6:1600:19274: scene=D_6
#: D_6:1600
msgctxt "text_id=19274 | speaker=unknown"
msgid "　だって、それを知らなければ、彼は今でも幸福だったのだから。"
msgstr ""

#. Occurrence D_6:1700:19275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0041; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1700
msgctxt "text_id=19275 | speaker=soujuurou"
msgid "“知らなければ、良かったのに。”"
msgstr ""

#. Occurrence D_6:1706:19276: scene=D_6
#: D_6:1706
msgctxt "text_id=19276 | speaker=unknown"
msgid "　その言葉の罪深さは、呟く本人が誰よりも。"
msgstr ""

#. Occurrence D_6:1726:19277: scene=D_6
#: D_6:1726
msgctxt "text_id=19277 | speaker=unknown"
msgid "　だから彼は問うたのだ。"
msgstr ""

#. Occurrence D_6:1731:19278: scene=D_6
#: D_6:1731
msgctxt "text_id=19278 | speaker=unknown"
msgid "　おかしいのは一体なんなのか。"
msgstr ""

#. Occurrence D_6:1736:19279: scene=D_6
#: D_6:1736
msgctxt "text_id=19279 | speaker=unknown"
msgid "　間違っていたのは誰なのかを。"
msgstr ""

#. Occurrence D_6:1741:19280: scene=D_6
#: D_6:1741
msgctxt "text_id=19280 | speaker=unknown"
msgid "　自分の言葉ではなく、少女の言葉で、明確に告発してほしかった。"
msgstr ""

#. Occurrence D_6:1747:19281: scene=D_6
#: D_6:1747
msgctxt "text_id=19281 | speaker=unknown"
msgid "　一瞬の、けれど<永劫|えいごう>のような思考の末、"
msgstr ""

#. Occurrence D_6:1790:19282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0002; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1790
msgctxt "text_id=19282 | speaker=aoko"
msgid "「―――私には、答えられないわ」"
msgstr ""

#. Occurrence D_6:1870:19283: scene=D_6
#: D_6:1870
msgctxt "text_id=19283 | speaker=unknown"
msgid "　少女は静かに、そう返答した。"
msgstr ""

#. Occurrence D_6:1875:19284: scene=D_6
#: D_6:1875
msgctxt "text_id=19284 | speaker=unknown"
msgid "　分からない、ではなく、答えられない。"
msgstr ""

#. Occurrence D_6:1880:19285: scene=D_6
#: D_6:1880
msgctxt "text_id=19285 | speaker=unknown"
msgid "　それは嘘を言わない彼女にとって、精一杯の回答だった。"
msgstr ""

#. Occurrence D_6:1885:19286: scene=D_6
#: D_6:1885
msgctxt "text_id=19286 | speaker=unknown"
msgid "　少年は深くかみしめる。"
msgstr ""

#. Occurrence D_6:1890:19287: scene=D_6
#: D_6:1890
msgctxt "text_id=19287 | speaker=unknown"
msgid "　今のがどれほど優しい言葉なのか、考えるまでもないのだから。"
msgstr ""

#. Occurrence D_6:1912:19288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0042_0; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1912
msgctxt "text_id=19288 | speaker=soujuurou"
msgid "「うん、そうだな。"
msgstr ""

#. Occurrence D_6:1919:19289: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0042_1; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1919
msgctxt "text_id=19289 | speaker=soujuurou"
msgid "君の最初の優しさが、今でよかった」"
msgstr ""

#. Occurrence D_6:1925:19290: scene=D_6
#: D_6:1925
msgctxt "text_id=19290 | speaker=unknown"
msgid "　などと、<倖|しあわ>せそうに言う草十郎を、青子はじとりと睨みつけた。"
msgstr ""

#. Occurrence D_6:1946:19291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0003; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1946
msgctxt "text_id=19291 | speaker=aoko"
msgid "「なによそれ。"
msgstr ""

#. Occurrence D_6:1952:19292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0004; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1952
msgctxt "text_id=19292 | speaker=aoko"
msgid "　まるで、普段から優しくないみたいじゃない」"
msgstr ""

#. Occurrence D_6:1958:19293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0043; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1958
msgctxt "text_id=19293 | speaker=soujuurou"
msgid "「蒼崎は優しくないじゃないか」"
msgstr ""

#. Occurrence D_6:1964:19294: scene=D_6
#: D_6:1964
msgctxt "text_id=19294 | speaker=unknown"
msgid "　きっぱりと言われて、青子は反論できなかった。"
msgstr ""

#. Occurrence D_6:1969:19295: scene=D_6
#: D_6:1969
msgctxt "text_id=19295 | speaker=unknown"
msgid "　……それは、たしかに彼の言う通りで。"
msgstr ""

#. Occurrence D_6:2041:19296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0005; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2041
msgctxt "text_id=19296 | speaker=aoko"
msgid "「……そうね。優しくなんかないわね、私」"
msgstr ""

#. Occurrence D_6:2047:19297: scene=D_6
#: D_6:2047
msgctxt "text_id=19297 | speaker=unknown"
msgid "　どこか<寂|さみ>しげな青子の同意に、ほら、と草十郎は笑った。"
msgstr ""

#. Occurrence D_6:2052:19298: scene=D_6
#: D_6:2052
msgctxt "text_id=19298 | speaker=unknown"
msgid "　見守るような微笑みは、彼が誰よりも、それを誇りに思っているからだろう。"
msgstr ""

#. Occurrence D_6:2072:19299: scene=D_6
#: D_6:2072
msgctxt "text_id=19299 | speaker=unknown"
msgid "　それが気まずくて温かくて、青子はあんな質問をした事を後悔した。"
msgstr ""

#. Occurrence D_6:2077:19300: scene=D_6
#: D_6:2077
msgctxt "text_id=19300 | speaker=unknown"
msgid "　もっと違う、なんでもない話をすれば、こんな<陰欝|いんうつ>とした気分にはならなかったのにと。"
msgstr ""

#. Occurrence D_6:2121:19301: scene=D_6
#: D_6:2121
msgctxt "text_id=19301 | speaker=unknown"
msgid "　道は、あと数歩分もない。"
msgstr ""

#. Occurrence D_6:2126:19302: scene=D_6
#: D_6:2126
msgctxt "text_id=19302 | speaker=unknown"
msgid "　木の柵に囲まれた建物は、冬の中にある<憩|いこ>いの宿に見えた。"
msgstr ""

#. Occurrence D_6:2131:19303: scene=D_6
#: D_6:2131
msgctxt "text_id=19303 | speaker=unknown"
msgid "　窓からこぼれる明かりが、今の気分に逆らって食卓の<賑|にぎ>わいを想像させる。"
msgstr ""

#. Occurrence D_6:2152:19304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0006; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2152
msgctxt "text_id=19304 | speaker=aoko"
msgid "「ごめん。悪いこと聞いちゃって」"
msgstr ""

#. Occurrence D_6:2159:19305: scene=D_6
#: D_6:2159
msgctxt "text_id=19305 | speaker=unknown"
msgid "　青子は庭の入り口で立ち止まる。"
msgstr ""

#. Occurrence D_6:2164:19306: scene=D_6
#: D_6:2164
msgctxt "text_id=19306 | speaker=unknown"
msgid "　最後なのに、それとも最後だから、一度くらいは謝っておこうと思ったのか。"
msgstr ""

#. Occurrence D_6:2169:19307: scene=D_6
#: D_6:2169
msgctxt "text_id=19307 | speaker=unknown"
msgid "　それに草十郎はいや、と答えるだけだった。"
msgstr ""

#. Occurrence D_6:2214:19308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0007; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2214
msgctxt "text_id=19308 | speaker=aoko"
msgid "「話、途中なのにね」"
msgstr ""

#. Occurrence D_6:2220:19309: scene=D_6
#: D_6:2220
msgctxt "text_id=19309 | speaker=unknown"
msgid "　辿り着いてしまった家を見上げて、白い息をこぼす。"
msgstr ""

#. Occurrence D_6:2225:19310: scene=D_6
#: D_6:2225
msgctxt "text_id=19310 | speaker=unknown"
msgid "　うなずく草十郎の顔に、もう<昏|くら>い<翳|かげ>りは微塵もない。"
msgstr ""

#. Occurrence D_6:2246:19311: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0044; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2246
msgctxt "text_id=19311 | speaker=soujuurou"
msgid "「自分も、話してみてようやく振り向けたと思う。だから蒼崎には感謝してるよ。"
msgstr ""

#. Occurrence D_6:2252:19312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0045; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2252
msgctxt "text_id=19312 | speaker=soujuurou"
msgid "　―――それに、これはもう終わった事だ。"
msgstr ""

#. Occurrence D_6:2258:19313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0046; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2258
msgctxt "text_id=19313 | speaker=soujuurou"
msgid "　続きを話すのは、また機会があった時にしよう」"
msgstr ""

#. Occurrence D_6:2359:19314: scene=D_6
#: D_6:2359
msgctxt "text_id=19314 | speaker=unknown"
msgid "　消え入るような笑顔で、草十郎は青子と顔を向き合わせる。"
msgstr ""

#. Occurrence D_6:2364:19315: scene=D_6
#: D_6:2364
msgctxt "text_id=19315 | speaker=unknown"
msgid "　今まで通りの、何でもない静希草十郎として。"
msgstr ""

#. Occurrence D_6:2369:19316: scene=D_6
#: D_6:2369
msgctxt "text_id=19316 | speaker=unknown"
msgid "　それが痛ましくて、そんな日がこない事を青子は祈った。"
msgstr ""

#. Occurrence D_6:2374:19317: scene=D_6
#: D_6:2374
msgctxt "text_id=19317 | speaker=unknown"
msgid "　自分のためと、この特異な少年のために。"
msgstr ""

#. Occurrence D_6:2424:19318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0008; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2424
msgctxt "text_id=19318 | speaker=aoko"
msgid "“……もっとも、そんな機会はもうこないか”"
msgstr ""

#. Occurrence D_6:2430:19319: scene=D_6
#: D_6:2430
msgctxt "text_id=19319 | speaker=unknown"
msgid "　そして、彼女は一軒家の更に向こう、小さな森に隠れた<洞|どう><穴|けつ>を指さした。"
msgstr ""

#. Occurrence D_6:2477:19320: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0009; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2477
msgctxt "text_id=19320 | speaker=aoko"
msgid "「あそこ、ちょっとした洞穴があるの。そこに祖父がいるから、行って。"
msgstr ""

#. Occurrence D_6:2483:19321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0010; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2483
msgctxt "text_id=19321 | speaker=aoko"
msgid "　……ほんとはもっと違った話が聞きたかったけど。仕方ないか、魔法は十二時になるときれちゃうものだしね」"
msgstr ""

#. Occurrence D_6:2528:19322: scene=D_6
#: D_6:2528
msgctxt "text_id=19322 | speaker=unknown"
msgid "　皮肉げな微笑みを浮かべて、青子はそう言った。"
msgstr ""

#. Occurrence D_6:2534:19323: scene=D_6
#: D_6:2534
msgctxt "text_id=19323 | speaker=unknown"
msgid "　それがどんな童話の引用かも知らず、草十郎は歩きだす。"
msgstr ""

#. Occurrence D_6:2540:19324: scene=D_6
#: D_6:2540
msgctxt "text_id=19324 | speaker=unknown"
msgid "　家から離れた森は遠すぎて、青子には<地上|ここ>とは別の場所のように思えた。"
msgstr ""

#. Occurrence D_6:2545:19325: scene=D_6
#: D_6:2545
msgctxt "text_id=19325 | speaker=unknown"
msgid "　実際は五分もかからない、短く、手の届く距離なのに。"
msgstr ""

#. Occurrence D_6:2566:19326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0011; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2566
msgctxt "text_id=19326 | speaker=aoko"
msgid "「さよなら、静希くん」"
msgstr ""

#. Occurrence D_6:2572:19327: scene=D_6
#: D_6:2572
msgctxt "text_id=19327 | speaker=unknown"
msgid "　振り向かずに歩いていく背中に、青子は呟きかける。"
msgstr ""

#. Occurrence D_6:2577:19328: scene=D_6
#: D_6:2577
msgctxt "text_id=19328 | speaker=unknown"
msgid "　聞こえる筈のないそれを、やっぱり草十郎は聞き届けたようだ。"
msgstr ""

#. Occurrence D_6:2584:19329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0047; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2584
msgctxt "text_id=19329 | speaker=soujuurou"
msgid "「ああ。じゃあまた明日、町の何処かで」"
msgstr ""

#. Occurrence D_6:2590:19330: scene=D_6
#: D_6:2590
msgctxt "text_id=19330 | speaker=unknown"
msgid "　少年は片手を上げて答えると、彼方の森へと消えていった。"
msgstr ""

#. Occurrence D_6:2716:19331: scene=D_6
#: D_6:2716
msgctxt "text_id=19331 | speaker=unknown"
msgid "　それを見届けて、青子はひとり<天|そら>を<仰|あお>ぐ。"
msgstr ""

#. Occurrence D_6:2721:19332: scene=D_6
#: D_6:2721
msgctxt "text_id=19332 | speaker=unknown"
msgid "　今夜は月よりも星が綺麗だ。"
msgstr ""

#. Occurrence D_6:2726:19333: scene=D_6
#: D_6:2726
msgctxt "text_id=19333 | speaker=unknown"
msgid "　それをさっきまで懐かしそうに眺めていた人物は、嘘みたいにあっさり、別れの言葉を告げて消えていった。"
msgstr ""

#. Occurrence D_6:2732:19334: scene=D_6
#: D_6:2732
msgctxt "text_id=19334 | speaker=unknown"
msgid "　まったく、と青子は今更ながら納得する。"
msgstr ""

#. Occurrence D_6:2737:19335: scene=D_6
#: D_6:2737
msgctxt "text_id=19335 | speaker=unknown"
msgid "　結局、いちばん普通じゃなかったのは誰だったのか。"
msgstr ""

#. Occurrence D_6:2757:19336: scene=D_6
#: D_6:2757
msgctxt "text_id=19336 | speaker=unknown"
msgid "　草十郎の行いは、言ってしまえば誰にだってできる事だ。"
msgstr ""

#. Occurrence D_6:2762:19337: scene=D_6
#: D_6:2762
msgctxt "text_id=19337 | speaker=unknown"
msgid "　けれど、彼の言う繰り返しを続けられる人間はそうはいない。"
msgstr ""

#. Occurrence D_6:2767:19338: scene=D_6
#: D_6:2767
msgctxt "text_id=19338 | speaker=unknown"
msgid "　あんな山での生活をしていれば、たしかに、今までの出来事なんてどうという事もなかったのだろう。"
msgstr ""

#. Occurrence D_6:2773:19339: scene=D_6
#: D_6:2773
msgctxt "text_id=19339 | speaker=unknown"
msgid "　自分は魔法使いだから奇跡を起こすけれど、"
msgstr ""

#. Occurrence D_6:2778:19340: scene=D_6
#: D_6:2778
msgctxt "text_id=19340 | speaker=unknown"
msgid "　彼は常識を繰り返した<末|すえ>にひとつの奇跡に辿り着いて、最後に、あんな魔法を見せたのだ。"
msgstr ""

#. Occurrence D_6:2799:19341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0012; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2799
msgctxt "text_id=19341 | speaker=aoko"
msgid "「素手で熊を倒すなんて、私にはどう転んでもできないし」"
msgstr ""

#. Occurrence D_6:2805:19342: scene=D_6
#: D_6:2805
msgctxt "text_id=19342 | speaker=unknown"
msgid "　だから、それはすごいコトだ。"
msgstr ""

#. Occurrence D_6:2810:19343: scene=D_6
#: D_6:2810
msgctxt "text_id=19343 | speaker=unknown"
msgid "　……その魔法は、彼にとって哀しいぐらい、無意味な物だったとしても。"
msgstr ""

#. Occurrence D_6:2815:19344: scene=D_6
#: D_6:2815
msgctxt "text_id=19344 | speaker=unknown"
msgid "　あれは確かに、人間だけが持つ輝きだった。"
msgstr ""

#. Occurrence D_6:2875:19345: scene=D_6
#: D_6:2875
msgctxt "text_id=19345 | speaker=unknown"
msgid "　彼女は星空から目を離して歩きだした。"
msgstr ""

#. Occurrence D_6:2880:19346: scene=D_6
#: D_6:2880
msgctxt "text_id=19346 | speaker=unknown"
msgid "　玄関の明かりはついていて、鍵はかかっていない。"
msgstr ""

#. Occurrence D_6:2885:19347: scene=D_6
#: D_6:2885
msgctxt "text_id=19347 | speaker=unknown"
msgid "　くっと服の袖をあげて時計を見ると、時刻はあと半刻で零時になろうとしていた。"
msgstr ""

#. Occurrence D_6:2890:19348: scene=D_6
#: D_6:2890
msgctxt "text_id=19348 | speaker=unknown"
msgid "　……どうやら、年内に来いという両親の言いつけは守れたようだ。"
msgstr ""

#. Occurrence D_6:2910:19349: scene=D_6
#: D_6:2910
msgctxt "text_id=19349 | speaker=unknown"
msgid "　扉に手を掛けて、深呼吸を一度する。"
msgstr ""

#. Occurrence D_6:2915:19350: scene=D_6
#: D_6:2915
msgctxt "text_id=19350 | speaker=unknown"
msgid "　それで、さっきまでの淡い未練を、彼女は綺麗に断ち切った。"
msgstr ""

#. Occurrence D_6:2958:19351: scene=D_6
#: D_6:2958
msgctxt "text_id=19351 | speaker=unknown"
msgid "　実家に帰ってくるのは二年ぶりだ。"
msgstr ""

#. Occurrence D_6:2963:19352: scene=D_6
#: D_6:2963
msgctxt "text_id=19352 | speaker=unknown"
msgid "　高校に入学してから下宿を始めて、今日までの二年間。"
msgstr ""

#. Occurrence D_6:2968:19353: scene=D_6
#: D_6:2968
msgctxt "text_id=19353 | speaker=unknown"
msgid "　早かったといえば早くすぎたその月日は、なぜか今になって思い出のように、自分の中を走り抜けていった。"
msgstr ""

#. Occurrence D_6:2974:19354: scene=D_6
#: D_6:2974
msgctxt "text_id=19354 | speaker=unknown"
msgid "　扉に手をかけて、今までの事を思い出すのなら。"
msgstr ""

#. Occurrence D_6:2979:19355: scene=D_6
#: D_6:2979
msgctxt "text_id=19355 | speaker=unknown"
msgid "　扉を開ければ、これからの事を見つめる事になるのだろう。"
msgstr ""

#. Occurrence D_6:2999:19356: scene=D_6
#: D_6:2999
msgctxt "text_id=19356 | speaker=unknown"
msgid "　ノブを持つ手に力をいれる。"
msgstr ""

#. Occurrence D_6:3004:19357: scene=D_6
#: D_6:3004
msgctxt "text_id=19357 | speaker=unknown"
msgid "　……中の風景はどこか微妙に違うけれど、記憶の中で見なれた温かい風景だった。"
msgstr ""

#. Occurrence D_6:3026:19358: scene=D_6
#: D_6:3026
msgctxt "text_id=19358 | speaker=unknown"
msgid "　自分が去って、月日が経っても変わらず出迎えてくれるものがある事は、なんて幸福なんだろう。"
msgstr ""

#. Occurrence D_6:3031:19359: scene=D_6
#: D_6:3031
msgctxt "text_id=19359 | speaker=unknown"
msgid "　それにほんの些細な、言葉にしない小さな感謝をして、彼女は自分の家に帰ってきた。"
msgstr ""

#. Occurrence D_6:3038:19360: scene=D_6
#: D_6:3038
msgctxt "text_id=19360 | speaker=unknown"
msgid "　呼び鈴も押さずに、ただいまと微笑んで。"
msgstr ""

#. Occurrence D_7:63:19361: scene=D_7
#: D_7:63
msgctxt "text_id=19361 | speaker=unknown"
msgid "　その洞穴に入った瞬間、奇妙な懐かしさに襲われた。"
msgstr ""

#. Occurrence D_7:70:19362: scene=D_7
#: D_7:70
msgctxt "text_id=19362 | speaker=unknown"
msgid "　<郷愁|きょうしゅう>ではなく、もっと<前期|いぜん>の。"
msgstr ""

#. Occurrence D_7:77:19363: scene=D_7
#: D_7:77
msgctxt "text_id=19363 | speaker=unknown"
msgid "　今の自分すら遠く想うほどの、<彼方|かなた>に至る懐かしさだ。"
msgstr ""

#. Occurrence D_7:151:19364: scene=D_7
#: D_7:151
msgctxt "text_id=19364 | speaker=unknown"
msgid "　その人物が何者であったかは、よく覚えていない。"
msgstr ""

#. Occurrence D_7:156:19365: scene=D_7
#: D_7:156
msgctxt "text_id=19365 | speaker=unknown"
msgid "　自分と同じだったかも知れないし、老人だった気もする。"
msgstr ""

#. Occurrence D_7:161:19366: scene=D_7
#: D_7:161
msgctxt "text_id=19366 | speaker=unknown"
msgid "　人らしき<輪郭|りんかく>だけがあり、その中身を判別する事はできなかった。"
msgstr ""

#. Occurrence D_7:166:19367: scene=D_7
#: D_7:166
msgctxt "text_id=19367 | speaker=unknown"
msgid "　叶ったとしても、表現するための適切なパーツが思いつかない。"
msgstr ""

#. Occurrence D_7:171:19368: scene=D_7
#: D_7:171
msgctxt "text_id=19368 | speaker=unknown"
msgid "　はっきりしていたのは、その煙のような人物が、青子の言う『祖父』という事だけだった。"
msgstr ""

#. Occurrence D_7:192:19369: voice_id=F60_D_7_0000; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:192
msgctxt "text_id=19369 | speaker=unknown"
msgid "「娘たちが世話になった」"
msgstr ""

#. Occurrence D_7:199:19370: scene=D_7
#: D_7:199
msgctxt "text_id=19370 | speaker=unknown"
msgid "　老人の声はしわがれていたが、張りがあり、洞穴によく響いた。"
msgstr ""

#. Occurrence D_7:222:19371: voice_id=F60_D_7_0001; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:222
msgctxt "text_id=19371 | speaker=unknown"
msgid "「これも縁だ。望みがあるのなら聞こう」"
msgstr ""

#. Occurrence D_7:228:19372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0000; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:228
msgctxt "text_id=19372 | speaker=soujuurou"
msgid "「望みはないです。でも、訊きたい事は一つあります。"
msgstr ""

#. Occurrence D_7:234:19373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0001; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:234
msgctxt "text_id=19373 | speaker=soujuurou"
msgid "　……どうして、二人を争わせたんですか？」"
msgstr ""

#. Occurrence D_7:240:19374: voice_id=F60_D_7_0002; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:240
msgctxt "text_id=19374 | speaker=unknown"
msgid "「それは私の外で起きた物語だ。答える事はできない」"
msgstr ""

#. Occurrence D_7:246:19375: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0002; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:246
msgctxt "text_id=19375 | speaker=soujuurou"
msgid "「そうしむけたのは貴方だと聞きました」"
msgstr ""

#. Occurrence D_7:267:19376: voice_id=F60_D_7_0003; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:267
msgctxt "text_id=19376 | speaker=unknown"
msgid "「星の<巡|めぐ>りだ。あれらは相容れない才能を与えられ、あのような形でしか<交|か>み合えない人間だ。私の意図に関係なく、共に居ればどちらかが<軋|きし>みをあげた。"
msgstr ""

#. Occurrence D_7:273:19377: voice_id=F60_D_7_0004; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:273
msgctxt "text_id=19377 | speaker=unknown"
msgid "　だが、確かに衝突を避ける余地はあった。あれらの意志が凡庸であったか、あるいは破格のものであったのなら、多くの<不純|ふじゅん>に耐えただろう。"
msgstr ""

#. Occurrence D_7:279:19378: voice_id=F60_D_7_0005; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:279
msgctxt "text_id=19378 | speaker=unknown"
msgid "　君のように、自己の崩壊が見えていても、共存を尊ぶように。しかし娘たちはそれを選ばなかった」"
msgstr ""

#. Occurrence D_7:300:19379: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0003; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:300
msgctxt "text_id=19379 | speaker=soujuurou"
msgid "「彼女たちが争うのは彼女たちのせいだって言うんですね。その原因は、貴方にあるのに」"
msgstr ""

#. Occurrence D_7:306:19380: voice_id=F60_D_7_0006; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:306
msgctxt "text_id=19380 | speaker=unknown"
msgid "「そうだ。あれらの争いは、あれらの生をあらわすもの。原因と言うのなら、私などゼロに等しい」"
msgstr ""

#. Occurrence D_7:312:19381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0004; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:312
msgctxt "text_id=19381 | speaker=soujuurou"
msgid "「ゼロ……？　形が無いという事ですか」"
msgstr ""

#. Occurrence D_7:333:19382: voice_id=F60_D_7_0007; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:333
msgctxt "text_id=19382 | speaker=unknown"
msgid "「形ではなく、意味が無い。"
msgstr ""

#. Occurrence D_7:339:19383: voice_id=F60_D_7_0008; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:339
msgctxt "text_id=19383 | speaker=unknown"
msgid "　私という起因から起こり、娘たちが一つの<題目|いのち>を得た時点で、私は<現代|ぶたい>から消え失せた。その後の因は、常に娘たちから生じたものだ。私の介入はない」"
msgstr ""

#. Occurrence D_7:360:19384: voice_id=F60_D_7_0009; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:360
msgctxt "text_id=19384 | speaker=unknown"
msgid "「今回、どちらが時間を終わらせても、あるいは両者が終わらせても、私には無価値だった。"
msgstr ""

#. Occurrence D_7:366:19385: voice_id=F60_D_7_0010; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:366
msgctxt "text_id=19385 | speaker=unknown"
msgid "　いや、もとより無価値だ。"
msgstr ""

#. Occurrence D_7:372:19386: voice_id=F60_D_7_0011; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:372
msgctxt "text_id=19386 | speaker=unknown"
msgid "　私に価値を与える<題目|いのち>は、まだ生まれていない。"
msgstr ""

#. Occurrence D_7:378:19387: voice_id=F60_D_7_0012; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:378
msgctxt "text_id=19387 | speaker=unknown"
msgid "　あれらがどうなろうと、やるべき事は変わらない」"
msgstr ""

#. Occurrence D_7:399:19388: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_9000; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:399
msgctxt "text_id=19388 | speaker=soujuurou"
msgid "「……青子が生きていても死んでいても、後継ぎを作るという事ですか」"
msgstr ""

#. Occurrence D_7:405:19389: voice_id=F60_D_7_0013; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:405
msgctxt "text_id=19389 | speaker=unknown"
msgid "「おそらく。この体が消えないのは、そういう事だ」"
msgstr ""

#. Occurrence D_7:432:19390: scene=D_7
#: D_7:432
msgctxt "text_id=19390 | speaker=unknown"
msgid "　洞穴に充満した、蒸気のような<精気|オド>に目眩がした。"
msgstr ""

#. Occurrence D_7:437:19391: scene=D_7
#: D_7:437
msgctxt "text_id=19391 | speaker=unknown"
msgid "　この老人は、青子と橙子が生まれた瞬間に、彼女たちが孫である事を忘れたのだ。"
msgstr ""

#. Occurrence D_7:442:19392: scene=D_7
#: D_7:442
msgctxt "text_id=19392 | speaker=unknown"
msgid "　……正統な蒼崎の後継者は、たぶん、永遠に誕生しないだろう。"
msgstr ""

#. Occurrence D_7:447:19393: scene=D_7
#: D_7:447
msgctxt "text_id=19393 | speaker=unknown"
msgid "　この老人がいるかぎり、<際限|さいげん>なく新しい力は求められる。"
msgstr ""

#. Occurrence D_7:452:19394: scene=D_7
#: D_7:452
msgctxt "text_id=19394 | speaker=unknown"
msgid "　そこには<妥協|だきょう>も<限界|げんかい>もない。"
msgstr ""

#. Occurrence D_7:473:19395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0005; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:473
msgctxt "text_id=19395 | speaker=soujuurou"
msgid "「青子は、そのために過去を捨てたのに？」"
msgstr ""

#. Occurrence D_7:496:19396: scene=D_7
#: D_7:496
msgctxt "text_id=19396 | speaker=unknown"
msgid "　沈黙があった。"
msgstr ""

#. Occurrence D_7:502:19397: scene=D_7
#: D_7:502
msgctxt "text_id=19397 | speaker=unknown"
msgid "ただ一度だけの、短い沈黙。"
msgstr ""

#. Occurrence D_7:507:19398: scene=D_7
#: D_7:507
msgctxt "text_id=19398 | speaker=unknown"
msgid "　不確かな人物像は、その輪郭さえぼやけていく。"
msgstr ""

#. Occurrence D_7:528:19399: scene=D_7
#: D_7:528
msgctxt "text_id=19399 | speaker=unknown"
msgid "　―――昔。"
msgstr ""

#. Occurrence D_7:534:19400: scene=D_7
#: D_7:534
msgctxt "text_id=19400 | speaker=unknown"
msgid "　因の切れた幼子が、この洞穴に入ってきた事がある。"
msgstr ""

#. Occurrence D_7:539:19401: scene=D_7
#: D_7:539
msgctxt "text_id=19401 | speaker=unknown"
msgid "　<無|む><知|ち>、<無|む><垢|く>から生まれた願いを、老人は自動的に叶えてやった。"
msgstr ""

#. Occurrence D_7:544:19402: scene=D_7
#: D_7:544
msgctxt "text_id=19402 | speaker=unknown"
msgid "　老人は長く残るために自我を失った魔法使いで、そのとき自分にできる事なら、なんでも叶えてしまうのだ。"
msgstr ""

#. Occurrence D_7:558:19403: scene=D_7
#: D_7:558
msgctxt "text_id=19403 | speaker=unknown"
msgid "　そしてあの日は、何もかもが符合しすぎていた。"
msgstr ""

#. Occurrence D_7:600:19404: scene=D_7
#: D_7:600
msgctxt "text_id=19404 | speaker=unknown"
msgid "　<自|みずか>らが<招|まね>いた罪を見て、<幼子|おさなご>は瞳にいっぱいの涙をためて、老人を睨みつけた。"
msgstr ""

#. Occurrence D_7:605:19405: scene=D_7
#: D_7:605
msgctxt "text_id=19405 | speaker=unknown"
msgid "　全ては失われる。誰でもいい貴方の失敗一つで、前置きもなく、あっさりと。"
msgstr ""

#. Occurrence D_7:610:19406: scene=D_7
#: D_7:610
msgctxt "text_id=19406 | speaker=unknown"
msgid "　幼子はその不条理に<癇癪|かんしゃく>を起こした。"
msgstr ""

#. Occurrence D_7:615:19407: scene=D_7
#: D_7:615
msgctxt "text_id=19407 | speaker=unknown"
msgid "　世界なんてそんなもんじゃぞ、と嘆息する魔法使いに、"
msgstr ""

#. Occurrence D_7:615:19408: scene=D_7
#: D_7:615
msgctxt "text_id=19408 | speaker=unknown"
msgid "“ジジイ、うるさい”と真っ向から立ち向かった。"
msgstr ""

#. Occurrence D_7:632:19409: scene=D_7
#: D_7:632
msgctxt "text_id=19409 | speaker=unknown"
msgid "　そして―――"
msgstr ""

#. Occurrence D_7:667:19410: scene=D_7
#: D_7:667
msgctxt "text_id=19410 | speaker=unknown"
msgid "　―――そう、そして。"
msgstr ""

#. Occurrence D_7:672:19411: scene=D_7
#: D_7:672
msgctxt "text_id=19411 | speaker=unknown"
msgid "　一つの命と全ての命を、同じものとして<償|つぐな>ってみせると、泣きながら走り出した。"
msgstr ""

#. Occurrence D_7:733:19412: voice_id=F60_D_7_0014; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:733
msgctxt "text_id=19412 | speaker=unknown"
msgid "「それは間違いだ、少年」"
msgstr ""

#. Occurrence D_7:741:19413: scene=D_7
#: D_7:741
msgctxt "text_id=19413 | speaker=unknown"
msgid "　……あの時、あるいは。"
msgstr ""

#. Occurrence D_7:751:19414: voice_id=F60_D_7_0015; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:751
msgctxt "text_id=19414 | speaker=unknown"
msgid "「捨てたのではない。"
msgstr ""

#. Occurrence D_7:758:19415: voice_id=F60_D_7_0016; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:758
msgctxt "text_id=19415 | speaker=unknown"
msgid "<過|そ><去|れ>を美しくする為に、アレは生きているのだ」"
msgstr ""

#. Occurrence D_7:767:19416: scene=D_7
#: D_7:767
msgctxt "text_id=19416 | speaker=unknown"
msgid "　<己|そ>の役割は、とうに終わっていたのかも知れないが。"
msgstr ""

#. Occurrence D_7:787:19417: scene=D_7
#: D_7:787
msgctxt "text_id=19417 | speaker=unknown"
msgid "　老人の姿は青年に変わって見えた。"
msgstr ""

#. Occurrence D_7:792:19418: scene=D_7
#: D_7:792
msgctxt "text_id=19418 | speaker=unknown"
msgid "　ほんの一瞬だけの、陽炎のような揺らぎだった。"
msgstr ""

#. Occurrence D_7:848:19419: voice_id=F60_D_7_0017; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:848
msgctxt "text_id=19419 | speaker=unknown"
msgid "「君の過ちを正そう。娘たちは、私という物をよく解っている。ともすれば、私本人より理解しているとも言える。"
msgstr ""

#. Occurrence D_7:854:19420: voice_id=F60_D_7_0018; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:854
msgctxt "text_id=19420 | speaker=unknown"
msgid "　私が娘たちの人格を考慮せぬように、娘たちもまた、私という物の人格を認めていない。"
msgstr ""

#. Occurrence D_7:860:19421: voice_id=F60_D_7_0019; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:860
msgctxt "text_id=19421 | speaker=unknown"
msgid "　祖父さえいなかったのなら、という考えさえないだろう」"
msgstr ""

#. Occurrence D_7:881:19422: voice_id=F60_D_7_0020; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:881
msgctxt "text_id=19422 | speaker=unknown"
msgid "「あれらはそもそも、争いあう自分たちを一度も<卑|ひ><下|げ>はしない筈だ。"
msgstr ""

#. Occurrence D_7:888:19423: voice_id=F60_D_7_0021; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:888
msgctxt "text_id=19423 | speaker=unknown"
msgid "君に、その関係を解れというのは酷だろうが。"
msgstr ""

#. Occurrence D_7:894:19424: voice_id=F60_D_7_0022; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:894
msgctxt "text_id=19424 | speaker=unknown"
msgid "　訊ね事は終わったようだ。"
msgstr ""

#. Occurrence D_7:900:19425: voice_id=F60_D_7_0023; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:900
msgctxt "text_id=19425 | speaker=unknown"
msgid "　次は私の番だ。"
msgstr ""

#. Occurrence D_7:906:19426: voice_id=F60_D_7_0024; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:906
msgctxt "text_id=19426 | speaker=unknown"
msgid "　君の名前を知りたい」"
msgstr ""

#. Occurrence D_7:942:19427: scene=D_7
#: D_7:942
msgctxt "text_id=19427 | speaker=unknown"
msgid "　老人の問いに答える。"
msgstr ""

#. Occurrence D_7:952:19428: scene=D_7
#: D_7:952
msgctxt "text_id=19428 | speaker=unknown"
msgid "　煙は顔をしかめるように、かすかに揺らいでいた。"
msgstr ""

#. Occurrence D_7:973:19429: voice_id=F60_D_7_0025; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:973
msgctxt "text_id=19429 | speaker=unknown"
msgid "「……意外だ。君は孤立しているというのに、複数を示す名が付いているとは思わなかった。"
msgstr ""

#. Occurrence D_7:979:19430: voice_id=F60_D_7_0026; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:979
msgctxt "text_id=19430 | speaker=unknown"
msgid "　似合わん。まったく、似合わん。"
msgstr ""

#. Occurrence D_7:985:19431: voice_id=F60_D_7_0027; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:985
msgctxt "text_id=19431 | speaker=unknown"
msgid "　だが、そちらでは正しい事だ。不釣り合いな場所にいるのなら、不釣り合いな名が必要だろう。"
msgstr ""

#. Occurrence D_7:991:19432: voice_id=F60_D_7_0028; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:991
msgctxt "text_id=19432 | speaker=unknown"
msgid "　稀少ではあるが、やはり無価値だ。"
msgstr ""

#. Occurrence D_7:997:19433: voice_id=F60_D_7_0029; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:997
msgctxt "text_id=19433 | speaker=unknown"
msgid "　全てを肯定する<諦|あきら>めは死に<由来|ゆらい>するものだろう。続くものがない以上、一代かぎりの才能は無価値だ」"
msgstr ""

#. Occurrence D_7:1052:19434: voice_id=F60_D_7_0030; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1052
msgctxt "text_id=19434 | speaker=unknown"
msgid "「―――<青子|アレ>の行く末に影響を与えた君に興味を持ったが、失望した。"
msgstr ""

#. Occurrence D_7:1058:19435: voice_id=F60_D_7_0031; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1058
msgctxt "text_id=19435 | speaker=unknown"
msgid "　無駄な時間を過ごしたようだ。"
msgstr ""

#. Occurrence D_7:1064:19436: voice_id=F60_D_7_0032; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1064
msgctxt "text_id=19436 | speaker=unknown"
msgid "　今は結ばれているが、いずれ離れていくのは変えようのない結末だ。"
msgstr ""

#. Occurrence D_7:1070:19437: voice_id=F60_D_7_0033; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1070
msgctxt "text_id=19437 | speaker=unknown"
msgid "　では立ち去りたまえ。"
msgstr ""

#. Occurrence D_7:1076:19438: voice_id=F60_D_7_0034; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1076
msgctxt "text_id=19438 | speaker=unknown"
msgid "　私は死者に用はない。二度と会う事はないだろう」"
msgstr ""

#. Occurrence D_7:1109:19439: scene=D_7
#: D_7:1109
msgctxt "text_id=19439 | speaker=unknown"
msgid "　風景が霞んでいく。"
msgstr ""

#. Occurrence D_7:1115:19440: scene=D_7
#: D_7:1115
msgctxt "text_id=19440 | speaker=unknown"
msgid "　記憶が薄れていく。"
msgstr ""

#. Occurrence D_7:1122:19441: scene=D_7
#: D_7:1122
msgctxt "text_id=19441 | speaker=unknown"
msgid "　答えのなかった会話。"
msgstr ""

#. Occurrence D_7:1128:19442: scene=D_7
#: D_7:1128
msgctxt "text_id=19442 | speaker=unknown"
msgid "　意義のなかった時間のあと、全ては夢のように霧散した。"
msgstr ""

#. Occurrence D_8:59:19443: scene=D_8
#: D_8:59
msgctxt "text_id=19443 | speaker=unknown"
msgid "　夜気は寒くて、空は綺麗だった。"
msgstr ""

#. Occurrence D_8:64:19444: scene=D_8
#: D_8:64
msgctxt "text_id=19444 | speaker=unknown"
msgid "　一日の終わりに<映|うつ>る光景は、けれど、一日だって同じ事はない。"
msgstr ""

#. Occurrence D_8:69:19445: scene=D_8
#: D_8:69
msgctxt "text_id=19445 | speaker=unknown"
msgid "　今日の景色は今日だけの物だ。"
msgstr ""

#. Occurrence D_8:74:19446: scene=D_8
#: D_8:74
msgctxt "text_id=19446 | speaker=unknown"
msgid "　人の知覚では大差のない風景にしか映らなくても、"
msgstr ""

#. Occurrence D_8:79:19447: scene=D_8
#: D_8:79
msgctxt "text_id=19447 | speaker=unknown"
msgid "　その時の風景の美しさも、ありのままに感じる傷心も、すべてが<儚|はかな>くて、明日は違った自分で目が覚める。"
msgstr ""

#. Occurrence D_8:99:19448: scene=D_8
#: D_8:99
msgctxt "text_id=19448 | speaker=unknown"
msgid "　山の閑散とした空気の中では、そんなあたり前の事が冬の寒さよりずっと、体に沁みこんでくるようだった。"
msgstr ""

#. Occurrence D_8:105:19449: scene=D_8
#: D_8:105
msgctxt "text_id=19449 | speaker=unknown"
msgid "　彼は時を忘れたように空を見上げている。"
msgstr ""

#. Occurrence D_8:110:19450: scene=D_8
#: D_8:110
msgctxt "text_id=19450 | speaker=unknown"
msgid "　それを止めたのは、呆然と立ち尽くす青子の視線だった。"
msgstr ""

#. Occurrence D_8:131:19451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0000; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:131
msgctxt "text_id=19451 | speaker=soujuurou"
msgid "「なんだ。早かったな、蒼崎」"
msgstr ""

#. Occurrence D_8:179:19452: scene=D_8
#: D_8:179
msgctxt "text_id=19452 | speaker=unknown"
msgid "　庭から出てきたばかりの青子に向けて、草十郎は話しかけた。"
msgstr ""

#. Occurrence D_8:212:19453: scene=D_8
#: D_8:212
msgctxt "text_id=19453 | speaker=unknown"
msgid "　青子は言葉もなく立ち尽くしていたけれど、すぐに気を取り直してつかつかと歩きだした。"
msgstr ""

#. Occurrence D_8:224:19454: scene=D_8
#: D_8:224
msgctxt "text_id=19454 | speaker=unknown"
msgid "　そのまま草十郎の前まで行くと、じろりとした目で睨む。"
msgstr ""

#. Occurrence D_8:229:19455: scene=D_8
#: D_8:229
msgctxt "text_id=19455 | speaker=unknown"
msgid "　こんなヤツ認めない、と言わんばかりの視線の激しさに、草十郎は肩をすくめた。"
msgstr ""

#. Occurrence D_8:234:19456: scene=D_8
#: D_8:234
msgctxt "text_id=19456 | speaker=unknown"
msgid "　青子がどうしてこんなに怒っているか、草十郎にはまったく見当がつかない。"
msgstr ""

#. Occurrence D_8:281:19457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0000; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:281
msgctxt "text_id=19457 | speaker=aoko"
msgid "「……なんで、まだここにいるのよ」"
msgstr ""

#. Occurrence D_8:287:19458: scene=D_8
#: D_8:287
msgctxt "text_id=19458 | speaker=unknown"
msgid "“……自分は、なんとか割り切ったのに”"
msgstr ""

#. Occurrence D_8:293:19459: scene=D_8
#: D_8:293
msgctxt "text_id=19459 | speaker=unknown"
msgid "　それなのに、この男が目の前にいるコトが青子には憎らしかったらしい。喜ぶべき事なのか悲しむべき事なのかを考えるのは、たぶん、その怒りが治まってからだろう。"
msgstr ""

#. Occurrence D_8:298:19460: scene=D_8
#: D_8:298
msgctxt "text_id=19460 | speaker=unknown"
msgid "　人間、思い通りにいかないと無性に腹が立つものなのだ。"
msgstr ""

#. Occurrence D_8:319:19461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0001; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:319
msgctxt "text_id=19461 | speaker=aoko"
msgid "「さっきから十分と二十秒も経ってない。"
msgstr ""

#. Occurrence D_8:325:19462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0002; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:325
msgctxt "text_id=19462 | speaker=aoko"
msgid "　なんでこんなところで突っ立ってるのよ、アンタ」"
msgstr ""

#. Occurrence D_8:331:19463: scene=D_8
#: D_8:331
msgctxt "text_id=19463 | speaker=unknown"
msgid "　いかに祖父といえど、記憶を消去して空白の一ヶ月をつなげるのには一日を要する筈だ。"
msgstr ""

#. Occurrence D_8:336:19464: scene=D_8
#: D_8:336
msgctxt "text_id=19464 | speaker=unknown"
msgid "　だからあとの処置はぜんぶ祖父に任せようと思ったのに、草十郎はここでぼんやりと空を見上げていた。"
msgstr ""

#. Occurrence D_8:356:19465: scene=D_8
#: D_8:356
msgctxt "text_id=19465 | speaker=unknown"
msgid "“……<祈祷師|きとうし>じゃあるまいし、ほんと、夜空を見上げるのが好きな奴”"
msgstr ""

#. Occurrence D_8:362:19466: scene=D_8
#: D_8:362
msgctxt "text_id=19466 | speaker=unknown"
msgid "　そんな青子の、口にはしない一方的な感情をぶつけられながら、草十郎は事情を説明する。"
msgstr ""

#. Occurrence D_8:413:19467: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0001; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:413
msgctxt "text_id=19467 | speaker=soujuurou"
msgid "「……あの老人からの伝言だけど。"
msgstr ""

#. Occurrence D_8:419:19468: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0002; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:419
msgctxt "text_id=19468 | speaker=soujuurou"
msgid "　記憶の消去は君の役目で、人に頼るな、だそうだ。今日呼ばれたのは、たんに悪口を聞かせたかっただけらしいよ」"
msgstr ""

#. Occurrence D_8:431:19469: scene=D_8
#: D_8:431
msgctxt "text_id=19469 | speaker=unknown"
msgid "　その言葉で青子の憑き物は落ちた。"
msgstr ""

#. Occurrence D_8:436:19470: scene=D_8
#: D_8:436
msgctxt "text_id=19470 | speaker=unknown"
msgid "　今にも平手打ちが飛んできそうな態度が、すう、と落ち着いたものになる。"
msgstr ""

#. Occurrence D_8:463:19471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0003; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:463
msgctxt "text_id=19471 | speaker=aoko"
msgid "「……そっか。"
msgstr ""

#. Occurrence D_8:463:19472: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0003; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:463
msgctxt "text_id=19472 | speaker=aoko"
msgid "　人に任せるなんて、たしかに私らしくなかった」"
msgstr ""

#. Occurrence D_8:469:19473: scene=D_8
#: D_8:469
msgctxt "text_id=19473 | speaker=unknown"
msgid "　きびしかった瞳が、段々といつもの、不機嫌そうな顔になっていく。"
msgstr ""

#. Occurrence D_8:494:19474: scene=D_8
#: D_8:494
msgctxt "text_id=19474 | speaker=unknown"
msgid "　ホッと安堵する草十郎。"
msgstr ""

#. Occurrence D_8:499:19475: scene=D_8
#: D_8:499
msgctxt "text_id=19475 | speaker=unknown"
msgid "　ご機嫌は、なんとか戻ってくれたようだ。"
msgstr ""

#. Occurrence D_8:537:19476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0003; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:537
msgctxt "text_id=19476 | speaker=soujuurou"
msgid "「納得いったなら、行こう。"
msgstr ""

#. Occurrence D_8:543:19477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0004; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:543
msgctxt "text_id=19477 | speaker=soujuurou"
msgid "　急がないと最終電車に間に合わない」"
msgstr ""

#. Occurrence D_8:564:19478: scene=D_8
#: D_8:564
msgctxt "text_id=19478 | speaker=unknown"
msgid "　返事を待たず草十郎は歩きだした。"
msgstr ""

#. Occurrence D_8:569:19479: scene=D_8
#: D_8:569
msgctxt "text_id=19479 | speaker=unknown"
msgid "　青子はその背中を少しの間だけ見つめてから、小言を言いつつ付いていく。"
msgstr ""

#. Occurrence D_8:645:19480: scene=D_8
#: D_8:645
msgctxt "text_id=19480 | speaker=unknown"
msgid "　帰り道は、来る時より楽だった。"
msgstr ""

#. Occurrence D_8:650:19481: scene=D_8
#: D_8:650
msgctxt "text_id=19481 | speaker=unknown"
msgid "　眼下の景色は一面の闇。"
msgstr ""

#. Occurrence D_8:655:19482: scene=D_8
#: D_8:655
msgctxt "text_id=19482 | speaker=unknown"
msgid "　その黒い海の中、灯台のように、小さな駅が輝いている。"
msgstr ""

#. Occurrence D_8:675:19483: scene=D_8
#: D_8:675
msgctxt "text_id=19483 | speaker=unknown"
msgid "　ふたりはしばらく、言葉もなく歩いていた。"
msgstr ""

#. Occurrence D_8:680:19484: scene=D_8
#: D_8:680
msgctxt "text_id=19484 | speaker=unknown"
msgid "　青子は来る時の会話を思い出して、若かったなぁ、と反省中。"
msgstr ""

#. Occurrence D_8:685:19485: scene=D_8
#: D_8:685
msgctxt "text_id=19485 | speaker=unknown"
msgid "　こんな事なら、あんなしんみりとした話をするんじゃなかった、と照れている。"
msgstr ""

#. Occurrence D_8:705:19486: scene=D_8
#: D_8:705
msgctxt "text_id=19486 | speaker=unknown"
msgid "　一方の草十郎は、いつも通り、何も考えてはいなかった。"
msgstr ""

#. Occurrence D_8:710:19487: scene=D_8
#: D_8:710
msgctxt "text_id=19487 | speaker=unknown"
msgid "　草十郎にとっては普通の、青子にとっては気まずい沈黙。"
msgstr ""

#. Occurrence D_8:715:19488: scene=D_8
#: D_8:715
msgctxt "text_id=19488 | speaker=unknown"
msgid "　そんな中、不意に草十郎はおかしな事を言いだした。"
msgstr ""

#. Occurrence D_8:789:19489: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0005; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:789
msgctxt "text_id=19489 | speaker=soujuurou"
msgid "「有珠には、お<餅|もち>を買っていってあげよう」"
msgstr ""

#. Occurrence D_8:854:19490: scene=D_8
#: D_8:854
msgctxt "text_id=19490 | speaker=unknown"
msgid "　目を点にする青子。"
msgstr ""

#. Occurrence D_8:902:19491: scene=D_8
#: D_8:902
msgctxt "text_id=19491 | speaker=unknown"
msgid "　この男はいったいなんなんだろう、という不満とか疑問がありありと浮かんでいる。"
msgstr ""

#. Occurrence D_8:964:19492: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0004; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:964
msgctxt "text_id=19492 | speaker=aoko"
msgid "「お餅が、なに……？」"
msgstr ""

#. Occurrence D_8:1011:19493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0006; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1011
msgctxt "text_id=19493 | speaker=soujuurou"
msgid "「お土産。有珠、ひとりで待っているんだから、喜ぶと思う」"
msgstr ""

#. Occurrence D_8:1048:19494: scene=D_8
#: D_8:1048
msgctxt "text_id=19494 | speaker=unknown"
msgid "　うーん、と青子は難しそうに口に手をあてた。"
msgstr ""

#. Occurrence D_8:1053:19495: scene=D_8
#: D_8:1053
msgctxt "text_id=19495 | speaker=unknown"
msgid "　手袋をしていない細い指が、寒さで白く染まっている。"
msgstr ""

#. Occurrence D_8:1074:19496: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0005; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1074
msgctxt "text_id=19496 | speaker=aoko"
msgid "“……あの娘にはそういうの逆効果だけど、草十郎がやるぶんには大丈夫か……”"
msgstr ""

#. Occurrence D_8:1079:19497: scene=D_8
#: D_8:1079
msgctxt "text_id=19497 | speaker=unknown"
msgid "　見るからに無欲という彼の雰囲気は、こういう<時|とき>便利だ。"
msgstr ""

#. Occurrence D_8:1084:19498: scene=D_8
#: D_8:1084
msgctxt "text_id=19498 | speaker=unknown"
msgid "　有珠も素直に厚意を受け取る公算<大|だい>である。"
msgstr ""

#. Occurrence D_8:1105:19499: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0006; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1105
msgctxt "text_id=19499 | speaker=aoko"
msgid "「そうね。たしかに有珠はこういうの根にもって、口に出さずに恨んでる<性質|たち>だけど。"
msgstr ""

#. Occurrence D_8:1111:19500: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0007; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1111
msgctxt "text_id=19500 | speaker=aoko"
msgid "　また、なんだってお土産がお餅なの？」"
msgstr ""

#. Occurrence D_8:1117:19501: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0007; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1117
msgctxt "text_id=19501 | speaker=soujuurou"
msgid "「だって、食べた事なさそうだろ、彼女」"
msgstr ""

#. Occurrence D_8:1155:19502: scene=D_8
#: D_8:1155
msgctxt "text_id=19502 | speaker=unknown"
msgid "　あっさりと返答されて、青子はたしかに、と同意してしまった。"
msgstr ""

#. Occurrence D_8:1160:19503: scene=D_8
#: D_8:1160
msgctxt "text_id=19503 | speaker=unknown"
msgid "　有珠がお餅を食べている姿をつい想像し、とたんに帰るのが楽しみになってくる。"
msgstr ""

#. Occurrence D_8:1190:19504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0008; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1190
msgctxt "text_id=19504 | speaker=aoko"
msgid "「アンタって本当に無心よね。"
msgstr ""

#. Occurrence D_8:1205:19505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0009; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1205
msgctxt "text_id=19505 | speaker=aoko"
msgid "　……そういえば前から不思議に思ってたんだけど、いつから有珠と仲良くなったの？　そのきっかけが、私には分からないんだけど」"
msgstr ""

#. Occurrence D_8:1255:19506: scene=D_8
#: D_8:1255
msgctxt "text_id=19506 | speaker=unknown"
msgid "　隣りから覗きこむように見つめられて、草十郎はさて、と考えを巡らせた。"
msgstr ""

#. Occurrence D_8:1281:19507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0008; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1281
msgctxt "text_id=19507 | speaker=soujuurou"
msgid "「大きなきっかけとか、そういうのはないと思うけど。"
msgstr ""

#. Occurrence D_8:1287:19508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0009; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1287
msgctxt "text_id=19508 | speaker=soujuurou"
msgid "　しいていうなら初めて話した時かな。もっと確かになったのはロビーで話した時だろうね」"
msgstr ""

#. Occurrence D_8:1293:19509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0010; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1293
msgctxt "text_id=19509 | speaker=aoko"
msgid "「たったそれだけ？」"
msgstr ""

#. Occurrence D_8:1304:19510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0010; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1304
msgctxt "text_id=19510 | speaker=soujuurou"
msgid "「ああ。親しくなるっていうのは、そういう事だろ？」"
msgstr ""

#. Occurrence D_8:1329:19511: scene=D_8
#: D_8:1329
msgctxt "text_id=19511 | speaker=unknown"
msgid "　変なこと訊くんだな、と草十郎は言葉をきった。"
msgstr ""

#. Occurrence D_8:1334:19512: scene=D_8
#: D_8:1334
msgctxt "text_id=19512 | speaker=unknown"
msgid "　言葉ではなく感性で通じ合う。"
msgstr ""

#. Occurrence D_8:1339:19513: scene=D_8
#: D_8:1339
msgctxt "text_id=19513 | speaker=unknown"
msgid "　たしかに、この少年と有珠はそんな関係なのかも知れない。"
msgstr ""

#. Occurrence D_8:1398:19514: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0011; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1398
msgctxt "text_id=19514 | speaker=aoko"
msgid "「……そういえば、初めから『有珠』って呼び捨てだったものね、アンタは」"
msgstr ""

#. Occurrence D_8:1417:19515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0011; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1417
msgctxt "text_id=19515 | speaker=soujuurou"
msgid "「そうだっけ？　よく覚えていないけど。……それより、なにを怒ってるんだ蒼崎？」"
msgstr ""

#. Occurrence D_8:1457:19516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0012; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1457
msgctxt "text_id=19516 | speaker=aoko"
msgid "「別に怒ってないわよ、私」"
msgstr ""

#. Occurrence D_8:1463:19517: scene=D_8
#: D_8:1463
msgctxt "text_id=19517 | speaker=unknown"
msgid "　その返答は、やや冷たくて、どことなく愛らしかった。"
msgstr ""

#. Occurrence D_8:1483:19518: scene=D_8
#: D_8:1483
msgctxt "text_id=19518 | speaker=unknown"
msgid "　山道は半分にさしかかる。"
msgstr ""

#. Occurrence D_8:1488:19519: scene=D_8
#: D_8:1488
msgctxt "text_id=19519 | speaker=unknown"
msgid "　平地に近づくにつれ星空は遠のいていくようで、草十郎はぼんやりと空を見上げ続ける。"
msgstr ""

#. Occurrence D_8:1493:19520: scene=D_8
#: D_8:1493
msgctxt "text_id=19520 | speaker=unknown"
msgid "　来る時からその素振りが気になっていた青子だが、ここにきてようやく、その理由に思い至った。"
msgstr ""

#. Occurrence D_8:1498:19521: scene=D_8
#: D_8:1498
msgctxt "text_id=19521 | speaker=unknown"
msgid "　ようするに、彼は懐かしがっているのだ。"
msgstr ""

#. Occurrence D_8:1503:19522: scene=D_8
#: D_8:1503
msgctxt "text_id=19522 | speaker=unknown"
msgid "　山から見る星空というヤツを。"
msgstr ""

#. Occurrence D_8:1523:19523: scene=D_8
#: D_8:1523
msgctxt "text_id=19523 | speaker=unknown"
msgid "「――――――"
msgstr ""

#. Occurrence D_8:1530:19524: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0012; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1530
msgctxt "text_id=19524 | speaker=soujuurou"
msgid "蒼崎」"
msgstr ""

#. Occurrence D_8:1550:19525: scene=D_8
#: D_8:1550
msgctxt "text_id=19525 | speaker=unknown"
msgid "　不意に、草十郎は見上げたまま問いかけてきた。"
msgstr ""

#. Occurrence D_8:1557:19526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0013; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1557
msgctxt "text_id=19526 | speaker=soujuurou"
msgid "「ひとつ聞きたいんだけど、君に後悔はあるのかな」"
msgstr ""

#. Occurrence D_8:1563:19527: scene=D_8
#: D_8:1563
msgctxt "text_id=19527 | speaker=unknown"
msgid "　両手を上着のポケットにいれたまま、白い息をする草十郎。"
msgstr ""

#. Occurrence D_8:1568:19528: scene=D_8
#: D_8:1568
msgctxt "text_id=19528 | speaker=unknown"
msgid "　青子にはその姿が、幻のように遠く感じられた。"
msgstr ""

#. Occurrence D_8:1603:19529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0013; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1603
msgctxt "text_id=19529 | speaker=aoko"
msgid "「……どうしたの、突然そんなこと聞いて」"
msgstr ""

#. Occurrence D_8:1609:19530: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0014; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1609
msgctxt "text_id=19530 | speaker=soujuurou"
msgid "「いいから、答えて。聞きたいんだ。"
msgstr ""

#. Occurrence D_8:1616:19531: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0015; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1616
msgctxt "text_id=19531 | speaker=soujuurou"
msgid "君に、悔いはあるのかないのかを」"
msgstr ""

#. Occurrence D_8:1629:19532: scene=D_8
#: D_8:1629
msgctxt "text_id=19532 | speaker=unknown"
msgid "　……それは、哀しい問いだった。"
msgstr ""

#. Occurrence D_8:1634:19533: scene=D_8
#: D_8:1634
msgctxt "text_id=19533 | speaker=unknown"
msgid "　なんと答えても彼は多くの物を失うのだろう。"
msgstr ""

#. Occurrence D_8:1639:19534: scene=D_8
#: D_8:1639
msgctxt "text_id=19534 | speaker=unknown"
msgid "　それでも答えを求めている以上、青子はさっぱりと返答する。"
msgstr ""

#. Occurrence D_8:1678:19535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0014; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1678
msgctxt "text_id=19535 | speaker=aoko"
msgid "「ないわよ、そんなの。だってそれをしない為に、今を頑張ってるんだもの。"
msgstr ""

#. Occurrence D_8:1684:19536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0015; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1684
msgctxt "text_id=19536 | speaker=aoko"
msgid "　後悔なんてのはね、草十郎。するものじゃなくて、無くしていく為にあるものなのよ」"
msgstr ""

#. Occurrence D_8:1704:19537: scene=D_8
#: D_8:1704
msgctxt "text_id=19537 | speaker=unknown"
msgid "「―――――――――」"
msgstr ""

#. Occurrence D_8:1752:19538: scene=D_8
#: D_8:1752
msgctxt "text_id=19538 | speaker=unknown"
msgid "　……ああ、と。"
msgstr ""

#. Occurrence D_8:1757:19539: scene=D_8
#: D_8:1757
msgctxt "text_id=19539 | speaker=unknown"
msgid "　噛みしめるように、彼は万感の想いを<葬|みおく>った。"
msgstr ""

#. Occurrence D_8:1763:19540: scene=D_8
#: D_8:1763
msgctxt "text_id=19540 | speaker=unknown"
msgid "　もう形も匂いも薄れている全てに、手を伸ばさず、手を振った。"
msgstr ""

#. Occurrence D_8:1784:19541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0017; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1784
msgctxt "text_id=19541 | speaker=soujuurou"
msgid "「―――そうか。後悔も、無くなるものなのか」"
msgstr ""

#. Occurrence D_8:1790:19542: scene=D_8
#: D_8:1790
msgctxt "text_id=19542 | speaker=unknown"
msgid "　呟く顔にはかすかな痛み。"
msgstr ""

#. Occurrence D_8:1795:19543: scene=D_8
#: D_8:1795
msgctxt "text_id=19543 | speaker=unknown"
msgid "　ただ、<鮮|あざ>やかで。"
msgstr ""

#. Occurrence D_8:1800:19544: scene=D_8
#: D_8:1800
msgctxt "text_id=19544 | speaker=unknown"
msgid "　そう言い切れるほど自分は強くはないけれど、それに焦がれている。そう言い切れる彼女に、強く焦がれている。"
msgstr ""

#. Occurrence D_8:1805:19545: scene=D_8
#: D_8:1805
msgctxt "text_id=19545 | speaker=unknown"
msgid "　なら、いつか―――"
msgstr ""

#. Occurrence D_8:1882:19546: scene=D_8
#: D_8:1882
msgctxt "text_id=19546 | speaker=unknown"
msgid "　いまは、空も闇も遠く。"
msgstr ""

#. Occurrence D_8:1888:19547: scene=D_8
#: D_8:1888
msgctxt "text_id=19547 | speaker=unknown"
msgid "　今日だけの景色が、いつまでも美しく思えるのなら。"
msgstr ""

#. Occurrence D_8:1893:19548: scene=D_8
#: D_8:1893
msgctxt "text_id=19548 | speaker=unknown"
msgid "　残してきた<幾|いく>つかの悔いが、星のように思える日が、いつかはあるのだろうか？"
msgstr ""

#. Occurrence D_8:1958:19549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0016; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1958
msgctxt "text_id=19549 | speaker=aoko"
msgid "「いい空ね。町じゃ、ちょっと見れないな」"
msgstr ""

#. Occurrence D_8:1964:19550: scene=D_8
#: D_8:1964
msgctxt "text_id=19550 | speaker=unknown"
msgid "　見上げる草十郎にならって、青子は暗い空を眺めた。"
msgstr ""

#. Occurrence D_8:1969:19551: scene=D_8
#: D_8:1969
msgctxt "text_id=19551 | speaker=unknown"
msgid "　星は町でのそれより強く輝いている。"
msgstr ""

#. Occurrence D_8:1974:19552: scene=D_8
#: D_8:1974
msgctxt "text_id=19552 | speaker=unknown"
msgid "　澄んだ空気と、明かりのない闇のおかげだ。"
msgstr ""

#. Occurrence D_8:1979:19553: scene=D_8
#: D_8:1979
msgctxt "text_id=19553 | speaker=unknown"
msgid "　それを憎むような眼差しで草十郎は見つめていた。"
msgstr ""

#. Occurrence D_8:1984:19554: scene=D_8
#: D_8:1984
msgctxt "text_id=19554 | speaker=unknown"
msgid "　……こんなにも綺麗な星なのに、それを偽物と決め付けるように。"
msgstr ""

#. Occurrence D_8:2005:19555: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0018; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2005
msgctxt "text_id=19555 | speaker=soujuurou"
msgid "「……そうだね。でも、ここでも手は届きそうにない」"
msgstr ""

#. Occurrence D_8:2011:19556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0017; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2011
msgctxt "text_id=19556 | speaker=aoko"
msgid "「え……？」"
msgstr ""

#. Occurrence D_8:2017:19557: scene=D_8
#: D_8:2017
msgctxt "text_id=19557 | speaker=unknown"
msgid "　突然の否定に驚いて、青子は草十郎の顔を覗き見る。"
msgstr ""

#. Occurrence D_8:2022:19558: scene=D_8
#: D_8:2022
msgctxt "text_id=19558 | speaker=unknown"
msgid "　……憎むような瞳は、もうくすんだ色に戻っていた。"
msgstr ""

#. Occurrence D_8:2027:19559: scene=D_8
#: D_8:2027
msgctxt "text_id=19559 | speaker=unknown"
msgid "　一呼吸して草十郎は呟く。"
msgstr ""

#. Occurrence D_8:2032:19560: scene=D_8
#: D_8:2032
msgctxt "text_id=19560 | speaker=unknown"
msgid "　視線はいまだ星空に釘付けたまま。"
msgstr ""

#. Occurrence D_8:2084:19561: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0019; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2084
msgctxt "text_id=19561 | speaker=soujuurou"
msgid "「山ではね、蒼崎。星は本当に手が届きそうなんだ。届かないのは分かっていても、望めば掴めそうなぐらい近いのに。"
msgstr ""

#. Occurrence D_8:2091:19562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0020; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2091
msgctxt "text_id=19562 | speaker=soujuurou"
msgid "都会の星は、そう思う事さえ許してくれない」"
msgstr ""

#. Occurrence D_8:2190:19563: scene=D_8
#: D_8:2190
msgctxt "text_id=19563 | speaker=unknown"
msgid "　それが本当のソラ。"
msgstr ""

#. Occurrence D_8:2195:19564: scene=D_8
#: D_8:2195
msgctxt "text_id=19564 | speaker=unknown"
msgid "　彼の語る山の星空は、<天象儀|プラネタリウム>より素晴らしい物だった。"
msgstr ""

#. Occurrence D_8:2200:19565: scene=D_8
#: D_8:2200
msgctxt "text_id=19565 | speaker=unknown"
msgid "　降り注ぐ雨のような、回る星々。"
msgstr ""

#. Occurrence D_8:2205:19566: scene=D_8
#: D_8:2205
msgctxt "text_id=19566 | speaker=unknown"
msgid "　指でなぞるだけで観測できる、原初のままの夜空。"
msgstr ""

#. Occurrence D_8:2211:19567: scene=D_8
#: D_8:2211
msgctxt "text_id=19567 | speaker=unknown"
msgid "　……それは、彼にはもう戻る事のできない、帰り道すら知らない故郷。"
msgstr ""

#. Occurrence D_8:2232:19568: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0021; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2232
msgctxt "text_id=19568 | speaker=soujuurou"
msgid "「……今まで、目に映るすべてを山と比べていた。こんな場所は、本当は嫌いだったんだ。今でも、正直なじめない。"
msgstr ""

#. Occurrence D_8:2238:19569: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0022; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2238
msgctxt "text_id=19569 | speaker=soujuurou"
msgid "　でも、いつか比べるのは街になってしまうんだろう。自分は、こっちに下りてきてしまったんだから」"
msgstr ""

#. Occurrence D_8:2303:19570: scene=D_8
#: D_8:2303
msgctxt "text_id=19570 | speaker=unknown"
msgid "　それが今までの後悔。"
msgstr ""

#. Occurrence D_8:2308:19571: scene=D_8
#: D_8:2308
msgctxt "text_id=19571 | speaker=unknown"
msgid "　星空から視線を離して、草十郎は青子へと視線を向ける。"
msgstr ""

#. Occurrence D_8:2313:19572: scene=D_8
#: D_8:2313
msgctxt "text_id=19572 | speaker=unknown"
msgid "　いつもとは違う、ためらいがちの彼女の瞳が、少し痛い。"
msgstr ""

#. Occurrence D_8:2318:19573: scene=D_8
#: D_8:2318
msgctxt "text_id=19573 | speaker=unknown"
msgid "　それは自分への同情か、それともただの<憐愍|れんびん>か。"
msgstr ""

#. Occurrence D_8:2323:19574: scene=D_8
#: D_8:2323
msgctxt "text_id=19574 | speaker=unknown"
msgid "　……そのどちらにしたって、彼女らしくない瞳をさせているのは自分だ。"
msgstr ""

#. Occurrence D_8:2328:19575: scene=D_8
#: D_8:2328
msgctxt "text_id=19575 | speaker=unknown"
msgid "　青子の無言の問いかけに、草十郎は目を閉じてうなずいた。"
msgstr ""

#. Occurrence D_8:2379:19576: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0023; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2379
msgctxt "text_id=19576 | speaker=soujuurou"
msgid "「……うん。それは仕方のない事だ。"
msgstr ""

#. Occurrence D_8:2385:19577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0024; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2385
msgctxt "text_id=19577 | speaker=soujuurou"
msgid "　ただ、そうなるのなら、そうなってしまう以上に、すばらしい物を手に入れないといけない。"
msgstr ""

#. Occurrence D_8:2391:19578: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0025; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2391
msgctxt "text_id=19578 | speaker=soujuurou"
msgid "　後悔を、いつか、後悔と思わないために」"
msgstr ""

#. Occurrence D_8:2422:19579: scene=D_8
#: D_8:2422
msgctxt "text_id=19579 | speaker=unknown"
msgid "　彼は感謝するように、そう告白した。"
msgstr ""

#. Occurrence D_8:2427:19580: scene=D_8
#: D_8:2427
msgctxt "text_id=19580 | speaker=unknown"
msgid "　古いカラは捨てなければいけない。"
msgstr ""

#. Occurrence D_8:2432:19581: scene=D_8
#: D_8:2432
msgctxt "text_id=19581 | speaker=unknown"
msgid "　喪失は踏み越えなければならない。"
msgstr ""

#. Occurrence D_8:2438:19582: scene=D_8
#: D_8:2438
msgctxt "text_id=19582 | speaker=unknown"
msgid "　それが、青子の答えで彼が失った、彼の全てだったモノ。"
msgstr ""

#. Occurrence D_8:2483:19583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0018; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2483
msgctxt "text_id=19583 | speaker=aoko"
msgid "「……やめてよね。私の一言でいちいち<人生観|じんせいかん>変えられちゃ、荷が重いじゃない」"
msgstr ""

#. Occurrence D_8:2489:19584: scene=D_8
#: D_8:2489
msgctxt "text_id=19584 | speaker=unknown"
msgid "　向けられた笑顔があんまりに柔らかくて、青子は顔を背けながら憎まれ口を言う。"
msgstr ""

#. Occurrence D_8:2494:19585: scene=D_8
#: D_8:2494
msgctxt "text_id=19585 | speaker=unknown"
msgid "　……本音である可能性も大きいが、それはそれで彼女らしい。"
msgstr ""

#. Occurrence D_8:2545:19586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0019; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2545
msgctxt "text_id=19586 | speaker=aoko"
msgid "「それで、祖父と何を話したの？"
msgstr ""

#. Occurrence D_8:2551:19587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0020; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2551
msgctxt "text_id=19587 | speaker=aoko"
msgid "　あの人が他人に興味を持つなんて、すごい事よ」"
msgstr ""

#. Occurrence D_8:2557:19588: scene=D_8
#: D_8:2557
msgctxt "text_id=19588 | speaker=unknown"
msgid "　せっかくの質問だったが、あの老人との会話について、草十郎は答えなかった。"
msgstr ""

#. Occurrence D_8:2562:19589: scene=D_8
#: D_8:2562
msgctxt "text_id=19589 | speaker=unknown"
msgid "　当たり障りのない返答をしてお茶をにごす。"
msgstr ""

#. Occurrence D_8:2643:19590: scene=D_8
#: D_8:2643
msgctxt "text_id=19590 | speaker=unknown"
msgid "　道は、もうじき平坦な路面に戻ろうとしていた。"
msgstr ""

#. Occurrence D_8:2648:19591: scene=D_8
#: D_8:2648
msgctxt "text_id=19591 | speaker=unknown"
msgid "　柔らかな土の地面は、<畦道|あぜみち>の固い土の道になるのだろう。"
msgstr ""

#. Occurrence D_8:2654:19592: scene=D_8
#: D_8:2654
msgctxt "text_id=19592 | speaker=unknown"
msgid "　その前に、ぴたりと草十郎は立ち止まった。"
msgstr ""

#. Occurrence D_8:2659:19593: scene=D_8
#: D_8:2659
msgctxt "text_id=19593 | speaker=unknown"
msgid "　目を閉じて、耳を澄ます。"
msgstr ""

#. Occurrence D_8:2664:19594: scene=D_8
#: D_8:2664
msgctxt "text_id=19594 | speaker=unknown"
msgid "　その後にうん、とうなずいて青子に向き直った。"
msgstr ""

#. Occurrence D_8:2716:19595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0026; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2716
msgctxt "text_id=19595 | speaker=soujuurou"
msgid "「おめでとう、蒼崎」"
msgstr ""

#. Occurrence D_8:2721:19596: scene=D_8
#: D_8:2721
msgctxt "text_id=19596 | speaker=unknown"
msgid "　青子はわけも分からず目をまたたかせる。"
msgstr ""

#. Occurrence D_8:2735:19597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0021; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2735
msgctxt "text_id=19597 | speaker=aoko"
msgid "「なによ、突然」"
msgstr ""

#. Occurrence D_8:2740:19598: scene=D_8
#: D_8:2740
msgctxt "text_id=19598 | speaker=unknown"
msgid "　当然の反応。"
msgstr ""

#. Occurrence D_8:2745:19599: scene=D_8
#: D_8:2745
msgctxt "text_id=19599 | speaker=unknown"
msgid "　それに、少年はほころぶように、"
msgstr ""

#. Occurrence D_8:2789:19600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0027; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2789
msgctxt "text_id=19600 | speaker=soujuurou"
msgid "「新しい年だ」"
msgstr ""

#. Occurrence D_8:2794:19601: scene=D_8
#: D_8:2794
msgctxt "text_id=19601 | speaker=unknown"
msgid "　喜びに満ちた笑顔で、そう返答した。"
msgstr ""

#. Occurrence D_8:2815:19602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0022; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2815
msgctxt "text_id=19602 | speaker=aoko"
msgid "「――――――」"
msgstr ""

#. Occurrence D_8:2904:19603: scene=D_8
#: D_8:2904
msgctxt "text_id=19603 | speaker=unknown"
msgid "　青子は呆然と、ただ彼の顔を見てしまう。"
msgstr ""

#. Occurrence D_8:2909:19604: scene=D_8
#: D_8:2909
msgctxt "text_id=19604 | speaker=unknown"
msgid "　あまりの不意打ちで、遠く離れた<社木|やしろぎ>から<除夜|じょや>の鐘が聞こえた気がするぐらいだ。"
msgstr ""

#. Occurrence D_8:2914:19605: scene=D_8
#: D_8:2914
msgctxt "text_id=19605 | speaker=unknown"
msgid "　今日が<今年|ことし>最後の日だと知っていたのに、彼女はそれをどうとも思っていなかった。"
msgstr ""

#. Occurrence D_8:2967:19606: scene=D_8
#: D_8:2967
msgctxt "text_id=19606 | speaker=unknown"
msgid "　なのに、たった少しの言葉だけで。"
msgstr ""

#. Occurrence D_8:2972:19607: scene=D_8
#: D_8:2972
msgctxt "text_id=19607 | speaker=unknown"
msgid "　遠い昔に置いたままの、鐘の音の奇跡を信じていた少女が振り向いた気がしたのだ。"
msgstr ""

#. Occurrence D_8:3028:19608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0023; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:3028
msgctxt "text_id=19608 | speaker=aoko"
msgid "「そっか……午前零時で、もう新しい年なんだ」"
msgstr ""

#. Occurrence D_8:3034:19609: scene=D_8
#: D_8:3034
msgctxt "text_id=19609 | speaker=unknown"
msgid "　知らなかった事のように青子は呟く。"
msgstr ""

#. Occurrence D_8:3039:19610: scene=D_8
#: D_8:3039
msgctxt "text_id=19610 | speaker=unknown"
msgid "　その口元に、少しだけの微笑みを浮かべて。"
msgstr ""

#. Occurrence D_8:3108:19611: scene=D_8
#: D_8:3108
msgctxt "text_id=19611 | speaker=unknown"
msgid "　……そう。"
msgstr ""

#. Occurrence D_8:3113:19612: scene=D_8
#: D_8:3113
msgctxt "text_id=19612 | speaker=unknown"
msgid "　思い出の中で振り向く少女は、初めての<振|ふ>り<袖|そで>なのに緊張の素振りもなくて、あんまり可愛くはなかったけれど。"
msgstr ""

#. Occurrence D_8:3118:19613: scene=D_8
#: D_8:3118
msgctxt "text_id=19613 | speaker=unknown"
msgid "　それでも、鏡越しに微笑んでしまうだけの愛らしさはあったのだ。"
msgstr ""

#. Occurrence D_8:3123:19614: scene=D_8
#: D_8:3123
msgctxt "text_id=19614 | speaker=unknown"
msgid "　温かそうな青子の顔を見て、草十郎は満足そうに目蓋を閉じた。それが何より嬉しい、と言うように。"
msgstr ""

#. Occurrence D_8:3187:19615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0028; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:3187
msgctxt "text_id=19615 | speaker=soujuurou"
msgid "「―――うん、色々あったけど。"
msgstr ""

#. Occurrence D_8:3193:19616: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0029; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:3193
msgctxt "text_id=19616 | speaker=soujuurou"
msgid "　新しい年を、君と<迎|むか>えられて良かった」"
msgstr ""

#. Occurrence D_8:3299:19617: scene=D_8
#: D_8:3299
msgctxt "text_id=19617 | speaker=unknown"
msgid "　そう言って草十郎は歩きだした。"
msgstr ""

#. Occurrence D_8:3312:19618: scene=D_8
#: D_8:3312
msgctxt "text_id=19618 | speaker=unknown"
msgid "　たぶん、こんな夜なのにひとりで待っている有珠の為に。"
msgstr ""

#. Occurrence D_8:3317:19619: scene=D_8
#: D_8:3317
msgctxt "text_id=19619 | speaker=unknown"
msgid "　その横を歩きながら、青子はさっきの言葉をもう一度だけ思いだす。"
msgstr ""

#. Occurrence D_8:3353:19620: scene=D_8
#: D_8:3353
msgctxt "text_id=19620 | speaker=unknown"
msgid "　新年を告げる言葉。"
msgstr ""

#. Occurrence D_8:3358:19621: scene=D_8
#: D_8:3358
msgctxt "text_id=19621 | speaker=unknown"
msgid "　本当に自然に告げられたあの一言のせいで、もう何年も前から知り合っている友人の気さえした。"
msgstr ""

#. Occurrence D_8:3363:19622: scene=D_8
#: D_8:3363
msgctxt "text_id=19622 | speaker=unknown"
msgid "　それをとても幸福な事だと感じるのは、たぶん間違いじゃないはずだ。"
msgstr ""

#. Occurrence D_8:3395:19623: scene=D_8
#: D_8:3395
msgctxt "text_id=19623 | speaker=unknown"
msgid "　いずれ、この少年ともあっさりと別れる日が来るのだろうけど。"
msgstr ""

#. Occurrence D_8:3400:19624: scene=D_8
#: D_8:3400
msgctxt "text_id=19624 | speaker=unknown"
msgid "　その時まで、こんな風に自然に、古い友人のように付き合えるのなら、それは悪いことじゃない。"
msgstr ""

#. Occurrence D_8:3447:19625: scene=D_8
#: D_8:3447
msgctxt "text_id=19625 | speaker=unknown"
msgid "　一見<素朴|そぼく>な、けれど特異な少年。"
msgstr ""

#. Occurrence D_8:3452:19626: scene=D_8
#: D_8:3452
msgctxt "text_id=19626 | speaker=unknown"
msgid "　彼との束の間の友情がいったい<何|い><時|つ>まで続くか考えながら、青子は足を進ませる。"
msgstr ""

#. Occurrence D_8:3457:19627: scene=D_8
#: D_8:3457
msgctxt "text_id=19627 | speaker=unknown"
msgid "　途中で一度だけ、草十郎のように、名残惜しく夜空を見上げてから。"
msgstr ""

#. Occurrence D_8:3510:19628: scene=D_8
#: D_8:3510
msgctxt "text_id=19628 | speaker=unknown"
msgid "　空には満天の星の夜。"
msgstr ""

#. Occurrence D_8:3515:19629: scene=D_8
#: D_8:3515
msgctxt "text_id=19629 | speaker=unknown"
msgid "　ふたりは届かない星空の<下|した>、山道を<下|お>りていく。"
msgstr ""

#. Occurrence D_9:78:19630: scene=D_9
#: D_9:78
msgctxt "text_id=19630 | speaker=unknown"
msgid "　　　　　　私がその本を見つけたのは、"
msgstr ""

msgctxt "text_id=19631 | speaker=unknown"
msgid "　　　　　　日曜のけだるい午前中の事だった。"
msgstr ""

#. Occurrence D_9:130:19632: scene=D_9
#: D_9:130
msgctxt "text_id=19632 | speaker=unknown"
msgid "　部外者……というか約一名の冒険野郎……立ち入り禁止の、久遠寺邸の図書室。"
msgstr ""

#. Occurrence D_9:136:19633: scene=D_9
#: D_9:136
msgctxt "text_id=19633 | speaker=unknown"
msgid "　本棚の上に隠すように置かれたそれは、なんとなく秘密めいて私の興味をひいたのだ。"
msgstr ""

#. Occurrence D_9:157:19634: scene=D_9
#: D_9:157
msgctxt "text_id=19634 | speaker=unknown"
msgid "　盾にでもなりそうなほど大きな本を、苦労しながら本棚の上から引っ張り出す。"
msgstr ""

#. Occurrence D_9:163:19635: scene=D_9
#: D_9:163
msgctxt "text_id=19635 | speaker=unknown"
msgid "　パラパラとめくっていくうちに、これがルーン魔術の<魔導|グリ><書|モア>、それも<原書|オリジナル>に関するものである事に気が付いた。"
msgstr ""

#. Occurrence D_9:184:19636: scene=D_9
#: D_9:184
msgctxt "text_id=19636 | speaker=unknown"
msgid "　まさかね、と思っているうちに、ここのところ探す<素|そ><振|ぶ>りさえ<止|や>めてしまった、目的の物が発見された。"
msgstr ""

#. Occurrence D_9:190:19637: scene=D_9
#: D_9:190
msgctxt "text_id=19637 | speaker=unknown"
msgid "　北欧の大神が戦乙女に使ったとされる、存在だけは有名な忘却のルーン文字だ。"
msgstr ""

#. Occurrence D_9:211:19638: scene=D_9
#: D_9:211
msgctxt "text_id=19638 | speaker=unknown"
msgid "　その使用法が如実に書かれたページとにらめっこすること数分。"
msgstr ""

#. Occurrence D_9:217:19639: scene=D_9
#: D_9:217
msgctxt "text_id=19639 | speaker=unknown"
msgid "……結局、私は本を閉じる事にした。"
msgstr ""

#. Occurrence D_9:223:19640: scene=D_9
#: D_9:223
msgctxt "text_id=19640 | speaker=unknown"
msgid "　そうして元の位置より、もうちょっと見付けにくい場所に戻そうとした時、あれっと思い出す。"
msgstr ""

#. Occurrence D_9:228:19641: scene=D_9
#: D_9:228
msgctxt "text_id=19641 | speaker=unknown"
msgid "　……この本を、どこかで見た事があるのだ。"
msgstr ""

#. Occurrence D_9:249:19642: scene=D_9
#: D_9:249
msgctxt "text_id=19642 | speaker=unknown"
msgid "　あれはいつだったろう。"
msgstr ""

#. Occurrence D_9:254:19643: scene=D_9
#: D_9:254
msgctxt "text_id=19643 | speaker=unknown"
msgid "　たしか……そう、彼が初めて遊びに行こうと誘った時。"
msgstr ""

#. Occurrence D_9:259:19644: scene=D_9
#: D_9:259
msgctxt "text_id=19644 | speaker=unknown"
msgid "　自分の目前に座っていた少女が手にしていたのが、この本だったと思うけど……。"
msgstr ""

#. Occurrence D_9:280:19645: scene=D_9
#: D_9:280
msgctxt "text_id=19645 | speaker=unknown"
msgid "　いや、きっとそうだ。"
msgstr ""

#. Occurrence D_9:285:19646: scene=D_9
#: D_9:285
msgctxt "text_id=19646 | speaker=unknown"
msgid "　小さな笑いをこらえきれず、私は本を寸分違わない元の場所に戻すことにした。"
msgstr ""

#. Occurrence D_9:290:19647: scene=D_9
#: D_9:290
msgctxt "text_id=19647 | speaker=unknown"
msgid "　ここの蔵書量なら本棚の中に混ぜたほうが見付ける可能性は低いのだけど、ここは彼女の微笑ましい努力をくんで見なかった事にしよう。"
msgstr ""

#. Occurrence D_9:295:19648: scene=D_9
#: D_9:295
msgctxt "text_id=19648 | speaker=unknown"
msgid "　……文字通り、自分の事を棚に上げてる、とは思うけど。"
msgstr ""

#. Occurrence D_9:316:19649: scene=D_9
#: D_9:316
msgctxt "text_id=19649 | speaker=unknown"
msgid "　その時、本館の方から聞きなれた叫び声が聞こえてきた。"
msgstr ""

#. Occurrence D_9:322:19650: scene=D_9
#: D_9:322
msgctxt "text_id=19650 | speaker=unknown"
msgid "　最近、彼は家政婦業に目覚めたのか、洋館のいたるところを掃除しようと頑張っている。"
msgstr ""

#. Occurrence D_9:343:19651: scene=D_9
#: D_9:343
msgctxt "text_id=19651 | speaker=unknown"
msgid "　……それはいいんだけど、この洋館には私や有珠にだって手を出せない開かずの間が幾つもある。"
msgstr ""

#. Occurrence D_9:349:19652: scene=D_9
#: D_9:349
msgctxt "text_id=19652 | speaker=unknown"
msgid "　それを構わず開けてしまうものだから、火の粉はこっちにまで飛んでくる。"
msgstr ""

#. Occurrence D_9:370:19653: scene=D_9
#: D_9:370
msgctxt "text_id=19653 | speaker=unknown"
msgid "　この前は、有珠のお母さんが保存していた亡霊船を開放して大騒ぎになったんだっけ。"
msgstr ""

#. Occurrence D_9:376:19654: scene=D_9
#: D_9:376
msgctxt "text_id=19654 | speaker=unknown"
msgid "　カティサークとかいう<飛ばし屋|スピードスター>を捕まえるのは、本当に苦労した。"
msgstr ""

#. Occurrence D_9:382:19655: scene=D_9
#: D_9:382
msgctxt "text_id=19655 | speaker=unknown"
msgid "あのいけすかない金狼の手を借りるのはもうゴメンである。"
msgstr ""

#. Occurrence D_9:403:19656: scene=D_9
#: D_9:403
msgctxt "text_id=19656 | speaker=unknown"
msgid "　その前は地下室の悪霊さんご一行の封印を解いて、"
msgstr ""

#. Occurrence D_9:408:19657: scene=D_9
#: D_9:408
msgctxt "text_id=19657 | speaker=unknown"
msgid "　さらにいけすかない教会ご一行が洋館に乗りこんでくるだけでなく、一週間も滞在しやがったし。"
msgstr ""

#. Occurrence D_9:414:19658: scene=D_9
#: D_9:414
msgctxt "text_id=19658 | speaker=unknown"
msgid "　もう少しさかのぼれば、有珠の部屋に勝手に入って、そのとばっちりで私も鏡の国に落っこちて、あやうく有珠と全面戦争をする羽目になりかけた。"
msgstr ""

#. Occurrence D_9:446:19659: scene=D_9
#: D_9:446
msgctxt "text_id=19659 | speaker=unknown"
msgid "　……考えてみると。"
msgstr ""

#. Occurrence D_9:451:19660: scene=D_9
#: D_9:451
msgctxt "text_id=19660 | speaker=unknown"
msgid "　あいつ、学習能力がないみたい。"
msgstr ""

#. Occurrence D_9:469:19661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_9_0000; voice_prefix=A10; voice_category=1; scene=D_9
#: D_9:469
msgctxt "text_id=19661 | speaker=aoko"
msgid "「もう、いい加減にしてよね、あのバカ……！」"
msgstr ""

#. Occurrence D_9:505:19662: scene=D_9
#: D_9:505
msgctxt "text_id=19662 | speaker=unknown"
msgid "　さっきまでの幸福な気分が台無しになって、私は図書室から飛び出した。"
msgstr ""

#. Occurrence D_9:510:19663: scene=D_9
#: D_9:510
msgctxt "text_id=19663 | speaker=unknown"
msgid "　たぶん、この後は廊下で立ち尽くしている元凶に飛び蹴りでも食らわせる、なんて未来視をうかべながら。"
msgstr ""

#. Occurrence D_9:532:19664: scene=D_9
#: D_9:532
msgctxt "text_id=19664 | speaker=unknown"
msgid "　でもまあ、それはそれで楽しい日常には変わりはない。"
msgstr ""

#. Occurrence D_9:553:19665: scene=D_9
#: D_9:553
msgctxt "text_id=19665 | speaker=unknown"
msgid "　棚の上に隠された私たちふたりの秘密。"
msgstr ""

#. Occurrence D_9:558:19666: scene=D_9
#: D_9:558
msgctxt "text_id=19666 | speaker=unknown"
msgid "　あの本はたぶん、もう開かれる事はないだろう―――"
msgstr ""

#. Occurrence NZ1:112:19667: voice_id=BA0_NZ1_0000; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:112
msgctxt "text_id=19667 | speaker=unknown"
msgid "　　　　　　 なぜなにー"
msgstr ""

#. Occurrence NZ1:144:19668: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0000; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:144
msgctxt "text_id=19668 | speaker=alice"
msgid "　　　　　　プロイー"
msgstr ""

#. Occurrence NZ1:175:19669: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19669 | speaker=unknown"
msgid "魔法の魔の字も知らない全国のシャバ僧ども。"
msgstr ""

#. Occurrence NZ1:175:19670: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19670 | speaker=unknown"
msgid "ヒロインにならんと高校デビューしたものの、"
msgstr ""

#. Occurrence NZ1:175:19671: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19671 | speaker=unknown"
msgid "真のヒロインにその座を奪われた青セーターども。"
msgstr ""

#. Occurrence NZ1:208:19672: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19672 | speaker=unknown"
msgid "　　こんばんはッス。"
msgstr ""

#. Occurrence NZ1:208:19673: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19673 | speaker=unknown"
msgid "　　よく分からない話をよく分からない方向でレクチャーする"
msgstr ""

#. Occurrence NZ1:208:19674: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19674 | speaker=unknown"
msgid "　　真番組『なぜなにプロイ』の時間っスよ。"
msgstr ""

#. Occurrence NZ1:258:19675: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0001; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:258
msgctxt "text_id=19675 | speaker=alice"
msgid "　　　　　 …………。"
msgstr ""

#. Occurrence NZ1:289:19676: voice_id=BA0_NZ1_0003; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:289
msgctxt "text_id=19676 | speaker=unknown"
msgid "　　　司会はグレートスリー<＋|プラス>１こと、"
msgstr ""

#. Occurrence NZ1:289:19677: voice_id=BA0_NZ1_0003; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:289
msgctxt "text_id=19677 | speaker=unknown"
msgid "　　　コマドリ・ザ・くるっくー。"
msgstr ""

#. Occurrence NZ1:315:19678: voice_id=BA0_NZ1_0004; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:315
msgctxt "text_id=19678 | speaker=unknown"
msgid "　　ティーチャ役にはマイ天使であるところの"
msgstr ""

#. Occurrence NZ1:315:19679: voice_id=BA0_NZ1_0004; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:315
msgctxt "text_id=19679 | speaker=unknown"
msgid "　　アリスさんをお招きしたッス。"
msgstr ""

#. Occurrence NZ1:346:19680: voice_id=BA0_NZ1_0005; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:346
msgctxt "text_id=19680 | speaker=unknown"
msgid "つーかここアリスさんの部屋ッスね！"
msgstr ""

#. Occurrence NZ1:346:19681: voice_id=BA0_NZ1_0005; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:346
msgctxt "text_id=19681 | speaker=unknown"
msgid "時間になってもアリスさんがスタジオに来ないんで、"
msgstr ""

msgctxt "text_id=19682 | speaker=unknown"
msgid "アリスさんの部屋にカメラ持ち込んだッスよ。"
msgstr ""

#. Occurrence NZ1:385:19683: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19683 | speaker=unknown"
msgid "　　　発想の転換？　なんス？"
msgstr ""

#. Occurrence NZ1:385:19684: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19684 | speaker=unknown"
msgid "　　　ゲストが来ないなら、"
msgstr ""

#. Occurrence NZ1:385:19685: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19685 | speaker=unknown"
msgid "　　　ゲストの部屋でやればいいじゃない？"
msgstr ""

#. Occurrence NZ1:434:19686: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0002; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:434
msgctxt "text_id=19686 | speaker=alice"
msgid "……いいから、はじめてちょうだい。"
msgstr ""

#. Occurrence NZ1:434:19687: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0002; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:434
msgctxt "text_id=19687 | speaker=alice"
msgid "一秒でも早く終わらせて、光より早く出て行って。"
msgstr ""

#. Occurrence NZ1:501:19688: voice_id=BA0_NZ1_0007; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:501
msgctxt "text_id=19688 | speaker=unknown"
msgid "　　うひゃー、照れるッスー！"
msgstr ""

#. Occurrence NZ1:501:19689: voice_id=BA0_NZ1_0007; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:501
msgctxt "text_id=19689 | speaker=unknown"
msgid "　　のたうちまわるっス－！"
msgstr ""

#. Occurrence NZ1:565:19690: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0003; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:565
msgctxt "text_id=19690 | speaker=alice"
msgid "　　　………………………なぜ？"
msgstr ""

#. Occurrence NZ1:625:19691: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19691 | speaker=unknown"
msgid "　　や、ジブン的に"
msgstr ""

#. Occurrence NZ1:625:19692: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19692 | speaker=unknown"
msgid "　　「ビジネスはすぐに終わらせて、アナタとプライベート"
msgstr ""

#. Occurrence NZ1:625:19693: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19693 | speaker=unknown"
msgid "　　タイムに入りたいの……」と解釈したッス。"
msgstr ""

#. Occurrence NZ1:690:19694: voice_id=BA0_NZ1_0009; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:690
msgctxt "text_id=19694 | speaker=unknown"
msgid "人語の奥の深さってやべぇッスよね。"
msgstr ""

#. Occurrence NZ1:690:19695: voice_id=BA0_NZ1_0009; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:690
msgctxt "text_id=19695 | speaker=unknown"
msgid "正直、相手やジブンが何を伝えたいのか、九割方は<意味不能|イ　ミ　フ>ッス。"
msgstr ""

#. Occurrence NZ1:741:19696: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0004; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:741
msgctxt "text_id=19696 | speaker=alice"
msgid "　そうね。"
msgstr ""

#. Occurrence NZ1:741:19697: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0004; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:741
msgctxt "text_id=19697 | speaker=alice"
msgid "　わたしも、その意見には賛成よ。"
msgstr ""

#. Occurrence NZ1:801:19698: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19698 | speaker=unknown"
msgid "　　　うはっ、このほとばしる信頼感……！"
msgstr ""

#. Occurrence NZ1:801:19699: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19699 | speaker=unknown"
msgid "　　　頼られるって時に重いッス。"
msgstr ""

#. Occurrence NZ1:801:19700: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19700 | speaker=unknown"
msgid "　　　というか、物理的に重いッス？"
msgstr ""

#. Occurrence NZ1:877:19701: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0005; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:877
msgctxt "text_id=19701 | speaker=alice"
msgid "　　　　　　ロビン。"
msgstr ""

#. Occurrence NZ1:930:19702: voice_id=BA0_NZ1_0011; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:930
msgctxt "text_id=19702 | speaker=unknown"
msgid "　　　　　チャッス。"
msgstr ""

#. Occurrence NZ1:963:19703: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19703 | speaker=unknown"
msgid "　　今回は初歩の初歩、使い魔の説明っスよ。"
msgstr ""

#. Occurrence NZ1:963:19704: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19704 | speaker=unknown"
msgid "　　魔術オンチなイチゲンさんに優しい授業。"
msgstr ""

#. Occurrence NZ1:963:19705: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19705 | speaker=unknown"
msgid "　　それが「なぜなにプロイ」なワケッスね。"
msgstr ""

#. Occurrence NZ1:994:19706: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19706 | speaker=unknown"
msgid "　で。この『使い魔』ってなんスかアリスさん。"
msgstr ""

#. Occurrence NZ1:994:19707: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19707 | speaker=unknown"
msgid "　自分、生まれてこの方、"
msgstr ""

#. Occurrence NZ1:994:19708: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19708 | speaker=unknown"
msgid "　見たことも聞いたコトもないッスよ？"
msgstr ""

#. Occurrence NZ1:1025:19709: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0006; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1025
msgctxt "text_id=19709 | speaker=alice"
msgid "　　使い魔というのは、"
msgstr ""

#. Occurrence NZ1:1025:19710: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0006; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1025
msgctxt "text_id=19710 | speaker=alice"
msgid "　　魔術師が使役するロボットみたいなものよ。"
msgstr ""

#. Occurrence NZ1:1051:19711: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0007; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1051
msgctxt "text_id=19711 | speaker=alice"
msgid "古来から、魔術師は工房にこもって研鑽を重ねるのが<生業|なりわい>だから。信頼できるモノに素材集めや外界の偵察、外敵の駆除を任せるの。"
msgstr ""

#. Occurrence NZ1:1082:19712: voice_id=BA0_NZ1_0014; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1082
msgctxt "text_id=19712 | speaker=unknown"
msgid "　　ただのコマ使いっスね。"
msgstr ""

#. Occurrence NZ1:1082:19713: voice_id=BA0_NZ1_0014; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1082
msgctxt "text_id=19713 | speaker=unknown"
msgid "　　それは弟子とは違うんスか？"
msgstr ""

#. Occurrence NZ1:1114:19714: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0008; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1114
msgctxt "text_id=19714 | speaker=alice"
msgid "　　違うわ。"
msgstr ""

#. Occurrence NZ1:1114:19715: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0008; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1114
msgctxt "text_id=19715 | speaker=alice"
msgid "　　弟子というのは<業|わざ>を引き継いで師を越える後継者でしょう？"
msgstr ""

#. Occurrence NZ1:1140:19716: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0009; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1140
msgctxt "text_id=19716 | speaker=alice"
msgid "　　　<弟子|かれら>はいずれ師を超える義務があるし、"
msgstr ""

#. Occurrence NZ1:1140:19717: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0009; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1140
msgctxt "text_id=19717 | speaker=alice"
msgid "　　　師も、そういうものでなければ弟子にはとらないわ。"
msgstr ""

#. Occurrence NZ1:1166:19718: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0010; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1166
msgctxt "text_id=19718 | speaker=alice"
msgid "　　　　でも使い魔は造られた時の性能がすべてだから。"
msgstr ""

#. Occurrence NZ1:1166:19719: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0010; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1166
msgctxt "text_id=19719 | speaker=alice"
msgid "　　　　成長しないものを、後継ぎにはできないわ。"
msgstr ""

#. Occurrence NZ1:1197:19720: voice_id=BA0_NZ1_0015; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1197
msgctxt "text_id=19720 | speaker=unknown"
msgid "そっかー。道理でジブン、何年経っても記憶容量増えないワケッスねー。然るに、生まれた時から<完成|パーフェクト>だった、と。"
msgstr ""

#. Occurrence NZ1:1230:19721: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0011; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1230
msgctxt "text_id=19721 | speaker=alice"
msgid "　　　そうね。パーフェクトに役たたずね。"
msgstr ""

#. Occurrence NZ1:1261:19722: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0012; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1261
msgctxt "text_id=19722 | speaker=alice"
msgid "使い魔の多くは小動物をベースに造られるわ。"
msgstr ""

#. Occurrence NZ1:1261:19723: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0012; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1261
msgctxt "text_id=19723 | speaker=alice"
msgid "これは、使い魔は術者からの魔力供給で活動するタイプが多いから。"
msgstr ""

#. Occurrence NZ1:1287:19724: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0013; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1287
msgctxt "text_id=19724 | speaker=alice"
msgid "使い魔は大きいほど魔力提供を必要とする。"
msgstr ""

#. Occurrence NZ1:1287:19725: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0013; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1287
msgctxt "text_id=19725 | speaker=alice"
msgid "だから魔力消費も少なく、造ってしまえば<栄養|どうりょく>を自力で補充できる小動物は便利なの。"
msgstr ""

#. Occurrence NZ1:1320:19726: voice_id=BA0_NZ1_0016; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1320
msgctxt "text_id=19726 | speaker=unknown"
msgid "　？　ジブン、狩りとかしたコトないッスよ？"
msgstr ""

#. Occurrence NZ1:1320:19727: voice_id=BA0_NZ1_0016; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1320
msgctxt "text_id=19727 | speaker=unknown"
msgid "　蛋白質も食物繊維も要らないッス？"
msgstr ""

#. Occurrence NZ1:1353:19728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0014; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1353
msgctxt "text_id=19728 | speaker=alice"
msgid "貴方たちプロイはまた別のくくり。"
msgstr ""

#. Occurrence NZ1:1353:19729: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0014; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1353
msgctxt "text_id=19729 | speaker=alice"
msgid "とにかく、魔術師たちにとって、使い魔は自分の命令を聞く「従者」「ペット」だと思えばいいわ。"
msgstr ""

#. Occurrence NZ1:1394:19730: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0015; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1394
msgctxt "text_id=19730 | speaker=alice"
msgid "このように、猫や鳥、鼠を使い魔にするのが一般的ね。"
msgstr ""

#. Occurrence NZ1:1433:19731: voice_id=BA0_NZ1_0017; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1433
msgctxt "text_id=19731 | speaker=unknown"
msgid "　　アリスさん、この物騒なのは"
msgstr ""

#. Occurrence NZ1:1433:19732: voice_id=BA0_NZ1_0017; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1433
msgctxt "text_id=19732 | speaker=unknown"
msgid "　　どういうカテゴリーッスか？"
msgstr ""

#. Occurrence NZ1:1464:19733: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0016; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1464
msgctxt "text_id=19733 | speaker=alice"
msgid "　これは戦闘用に調律された自動人形。"
msgstr ""

#. Occurrence NZ1:1464:19734: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0016; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1464
msgctxt "text_id=19734 | speaker=alice"
msgid "　ここまでくると<使い魔|ファミリア>というより<衛兵|センチネル>だけど。"
msgstr ""

#. Occurrence NZ1:1490:19735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19735 | speaker=alice"
msgid "　　……これは使い魔のセオリーから外れた特注品よ。"
msgstr ""

#. Occurrence NZ1:1490:19736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19736 | speaker=alice"
msgid "　　また、アナタのように人間互換できる知性を持った使い魔も"
msgstr ""

#. Occurrence NZ1:1490:19737: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19737 | speaker=alice"
msgid "　　特例にあたるわ。"
msgstr ""

#. Occurrence NZ1:1526:19738: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19738 | speaker=alice"
msgid "　　　でも、そんなのは魔力の無駄ね。コストが高いだけ。"
msgstr ""

#. Occurrence NZ1:1526:19739: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19739 | speaker=alice"
msgid "　　　たいていは術者本人が済ませた方が早かったり、"
msgstr ""

#. Occurrence NZ1:1526:19740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19740 | speaker=alice"
msgid "　　　もっと安い材料で代用できるから。"
msgstr ""

#. Occurrence NZ1:1557:19741: voice_id=BA0_NZ1_0018; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1557
msgctxt "text_id=19741 | speaker=unknown"
msgid "　　手段と結果を間違える、"
msgstr ""

#. Occurrence NZ1:1557:19742: voice_id=BA0_NZ1_0018; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1557
msgctxt "text_id=19742 | speaker=unknown"
msgid "　　ってやつッスね。"
msgstr ""

#. Occurrence NZ1:1588:19743: voice_id=BA0_NZ1_0019_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1588
msgctxt "text_id=19743 | speaker=unknown"
msgid "　ん？　んじゃ、使い魔は術者より弱いんスね。"
msgstr ""

#. Occurrence NZ1:1588:19744: voice_id=BA0_NZ1_0019_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1588
msgctxt "text_id=19744 | speaker=unknown"
msgid "　あくまで前座ってコトっスか？"
msgstr ""

#. Occurrence NZ1:1599:19745: voice_id=BA0_NZ1_0019_1; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1599
msgctxt "text_id=19745 | speaker=unknown"
msgid "　うは、マジ使えないヤツらッスー！"
msgstr ""

#. Occurrence NZ1:1631:19746: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19746 | speaker=alice"
msgid "　　アナタらしい短絡思考ねロビン。"
msgstr ""

#. Occurrence NZ1:1631:19747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19747 | speaker=alice"
msgid "　　痺れるわ。これがわたしの使い魔だなんて、"
msgstr ""

#. Occurrence NZ1:1631:19748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19748 | speaker=alice"
msgid "　　どうにかなってしまいそう。"
msgstr ""

#. Occurrence NZ1:1662:19749: voice_id=BA0_NZ1_0020; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1662
msgctxt "text_id=19749 | speaker=unknown"
msgid "　アリスさん、"
msgstr ""

#. Occurrence NZ1:1662:19750: voice_id=BA0_NZ1_0020; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1662
msgctxt "text_id=19750 | speaker=unknown"
msgid "　言葉はステキなのにどうして顔が怖いんスか？"
msgstr ""

#. Occurrence NZ1:1693:19751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0020; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1693
msgctxt "text_id=19751 | speaker=alice"
msgid "　術者の十分の一ぐらいの性能しかなくても、"
msgstr ""

#. Occurrence NZ1:1693:19752: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0020; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1693
msgctxt "text_id=19752 | speaker=alice"
msgid "　本人より“強い”使い魔を造る事は簡単よ。"
msgstr ""

#. Occurrence NZ1:1724:19753: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0021; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1724
msgctxt "text_id=19753 | speaker=alice"
msgid "　　試しに、こんどアナタのお腹に"
msgstr ""

#. Occurrence NZ1:1724:19754: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0021; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1724
msgctxt "text_id=19754 | speaker=alice"
msgid "　　デリンジャーを埋め込んでみましょうか。"
msgstr ""

#. Occurrence NZ1:1755:19755: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0022; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1755
msgctxt "text_id=19755 | speaker=alice"
msgid "　泣いたり笑ったり飛んだりはできなくなるけど、"
msgstr ""

#. Occurrence NZ1:1755:19756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0022; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1755
msgctxt "text_id=19756 | speaker=alice"
msgid "　相手を驚かせるぐらいはできるわ、きっと。"
msgstr ""

#. Occurrence NZ1:1832:19757: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19757 | speaker=unknown"
msgid "　　コ―――コマドリ・ザ・クラッカー！"
msgstr ""

#. Occurrence NZ1:1832:19758: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19758 | speaker=unknown"
msgid "　　かっちょいいッスー！"
msgstr ""

#. Occurrence NZ1:1832:19759: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19759 | speaker=unknown"
msgid "　　クリスマスに大活躍の予感……！"
msgstr ""

#. Occurrence NZ1:1868:19760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0023; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1868
msgctxt "text_id=19760 | speaker=alice"
msgid "　　　まさに豆鉄砲ね。"
msgstr ""

#. Occurrence NZ1:1868:19761: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0023; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1868
msgctxt "text_id=19761 | speaker=alice"
msgid "　　　そのまま消費されてくれないかしら。"
msgstr ""

#. Occurrence NZ1:1901:19762: voice_id=BA0_NZ1_0022; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1901
msgctxt "text_id=19762 | speaker=unknown"
msgid "　　なんか当たりキツイッス。"
msgstr ""

#. Occurrence NZ1:1901:19763: voice_id=BA0_NZ1_0022; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1901
msgctxt "text_id=19763 | speaker=unknown"
msgid "　　でも、これで大まかな説明はしたっスね。"
msgstr ""

#. Occurrence NZ1:1927:19764: voice_id=BA0_NZ1_0023; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1927
msgctxt "text_id=19764 | speaker=unknown"
msgid "　使い魔は魔術師を守るロボットで、"
msgstr ""

#. Occurrence NZ1:1927:19765: voice_id=BA0_NZ1_0023; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1927
msgctxt "text_id=19765 | speaker=unknown"
msgid "　その性能は造った魔術師によってマチマチ、と。"
msgstr ""

#. Occurrence NZ1:1958:19766: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19766 | speaker=unknown"
msgid "　ん？　万能感あふれるアリスさんはともかく、"
msgstr ""

#. Occurrence NZ1:1958:19767: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19767 | speaker=unknown"
msgid "　青子さんが使い魔を造ったらどうなるッスか？"
msgstr ""

#. Occurrence NZ1:1958:19768: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19768 | speaker=unknown"
msgid "　やっぱり、起動・即・自爆？"
msgstr ""

#. Occurrence NZ1:1989:19769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0024; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1989
msgctxt "text_id=19769 | speaker=alice"
msgid "　あり得ない仮定ね。"
msgstr ""

#. Occurrence NZ1:1989:19770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0024; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1989
msgctxt "text_id=19770 | speaker=alice"
msgid "　青子には使い魔を造るだけの技量はないもの。"
msgstr ""

#. Occurrence NZ1:2020:19771: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19771 | speaker=alice"
msgid "　そもそも、彼女は壊す事しかできないのよ？"
msgstr ""

#. Occurrence NZ1:2020:19772: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19772 | speaker=alice"
msgid "　その唯一の特技を使い魔に任せてしまったら、"
msgstr ""

#. Occurrence NZ1:2020:19773: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19773 | speaker=alice"
msgid "　存在意義も跡形もなく壊れてしまうわ。"
msgstr ""

#. Occurrence NZ1:2051:19774: voice_id=BA0_NZ1_0025; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2051
msgctxt "text_id=19774 | speaker=unknown"
msgid "　　ハハハ。"
msgstr ""

#. Occurrence NZ1:2051:19775: voice_id=BA0_NZ1_0025; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2051
msgctxt "text_id=19775 | speaker=unknown"
msgid "　　さりげにひどい発言ッス。"
msgstr ""

#. Occurrence NZ1:2082:19776: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0026; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2082
msgctxt "text_id=19776 | speaker=alice"
msgid "戦闘において、青子は使い魔に任せる必要がない。"
msgstr ""

#. Occurrence NZ1:2082:19777: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0026; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2082
msgctxt "text_id=19777 | speaker=alice"
msgid "逆に、私は戦う事はできないから―――"
msgstr ""

#. Occurrence NZ1:2113:19778: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19778 | speaker=unknown"
msgid "　　なるほどー。"
msgstr ""

#. Occurrence NZ1:2113:19779: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19779 | speaker=unknown"
msgid "　　青子さんは青子さん自身が強い。"
msgstr ""

#. Occurrence NZ1:2113:19780: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19780 | speaker=unknown"
msgid "　　アリスさんはアリスさんの周りが強い。"
msgstr ""

#. Occurrence NZ1:2153:19781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0027; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2153
msgctxt "text_id=19781 | speaker=alice"
