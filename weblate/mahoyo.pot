msgid "　　ルイスキャロルの大ファンでもあったッス。"
msgstr ""

#. Occurrence NZ2:1672:19895: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19895 | speaker=unknown"
msgid "　魔女は自分の代で、先代から遺されたプロイを"
msgstr ""

#. Occurrence NZ2:1672:19896: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19896 | speaker=unknown"
msgid "　自分用にチューンナップするッスよ。"
msgstr ""

#. Occurrence NZ2:1672:19897: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19897 | speaker=unknown"
msgid "　母君、キャロルにはまってたからあの始末ッス。"
