#. Occurrence WIK_F_A:274:21999: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_F_A
