msgid "　それが済んだら……そうね。"
msgstr ""

#. Occurrence NZ2:1925:19914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0021; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1925
msgctxt "text_id=19914 | speaker=alice"
msgid "　電柱にでもぶつかって、盛大に死んでちょうだい。"
