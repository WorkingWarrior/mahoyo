#. Occurrence NZ2:1703:19898: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19898 | speaker=unknown"
msgid "　　 禁を犯した時も、ノータイムで"
msgstr ""

#. Occurrence NZ2:1703:19899: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19899 | speaker=unknown"
msgid "　　「名前はアリスにしましょう」なんて"
msgstr ""

#. Occurrence NZ2:1703:19900: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19900 | speaker=unknown"
msgid "　　 微笑んだぐらいッスから！"
msgstr ""

#. Occurrence NZ2:1740:19901: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0018; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1740
msgctxt "text_id=19901 | speaker=alice"
msgid "　　……あきれた。"
msgstr ""

#. Occurrence NZ2:1740:19902: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0018; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1740
msgctxt "text_id=19902 | speaker=alice"
msgid "　　少女趣味のかたまりだったのね、あの人。"
msgstr ""

#. Occurrence NZ2:1777:19903: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
msgctxt "text_id=19903 | speaker=unknown"
msgid "　　ハハハなに言ってるッスか、"
msgstr ""

#. Occurrence NZ2:1777:19904: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
