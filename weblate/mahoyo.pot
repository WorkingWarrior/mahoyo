#: NZ4:1402
msgctxt "text_id=20206 | speaker=alice"
msgid "　前日譚である「コックロビンとジェニーレンの幸せな求婚」が"
msgstr ""

#. Occurrence NZ4:1402:20207: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0015; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1402
msgctxt "text_id=20207 | speaker=alice"
msgid "　出版され、これまたヒット。"
msgstr ""

#. Occurrence NZ4:1433:20208: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20208 | speaker=alice"
msgid "　その後、コックロビンの死の後を歌った"
msgstr ""

#. Occurrence NZ4:1433:20209: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20209 | speaker=alice"
msgid "　スズメの裁判と処罰も出版。"
msgstr ""

#. Occurrence NZ4:1433:20210: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20210 | speaker=alice"
msgid "　羨ましいわ。印税だけで大もうけね、ロビン。"
msgstr ""

#. Occurrence NZ4:1465:20211: voice_id=BA0_NZ4_0016; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1465
msgctxt "text_id=20211 | speaker=unknown"
msgid "　　鳥には一円も入ってこないッスけどね。"
msgstr ""

#. Occurrence NZ4:1496:20212: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20212 | speaker=unknown"
msgid "　　それよりアリスさん、知ってるッスか。"
msgstr ""

#. Occurrence NZ4:1496:20213: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20213 | speaker=unknown"
msgid "　　駒鳥はイギリスの国鳥ッスよ。"
msgstr ""

#. Occurrence NZ4:1496:20214: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20214 | speaker=unknown"
msgid "　　クリスマスの象徴でもあるッス。"
msgstr ""

#. Occurrence NZ4:1523:20215: voice_id=BA0_NZ4_0018_0; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1523
msgctxt "text_id=20215 | speaker=unknown"
msgid "　　つまり―――まほよの主役はジブ"
msgstr ""

#. Occurrence NZ4:1564:20216: voice_id=BA0_NZ4_0018_1; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1564
msgctxt "text_id=20216 | speaker=unknown"
msgid "きゃ。"
msgstr ""

#. Occurrence NZ4:1708:20217: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0017; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1708
msgctxt "text_id=20217 | speaker=alice"
msgid "　　　あんまり調子に乗ってると、たいへんよ"
msgstr ""

#. Occurrence NZ4:1735:20218: voice_id=BA0_NZ4_0019; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1735
msgctxt "text_id=20218 | speaker=unknown"
msgid "　 既にこれ以上ないほど大変ッス"
msgstr ""

#. Occurrence NZ4:1766:20219: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0018; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1766
msgctxt "text_id=20219 | speaker=alice"
msgid "　　あとは……ほとんど残り物ね。"
msgstr ""

#. Occurrence NZ4:1766:20220: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0018; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1766
msgctxt "text_id=20220 | speaker=alice"
msgid "　　とりたてて紹介するほどの物ではないわ。"
