msgid "　　アナタには勿体ない名称ね。"
msgstr ""

#. Occurrence NZ4:1288:20195: voice_id=BA0_NZ4_0015; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1288
msgctxt "text_id=20195 | speaker=unknown"
msgid "　まさにミケランジェロクラスの造形ッス。"
