#. Occurrence NZ2:2239:19933: voice_id=BA0_NZ2_0032_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2239
msgctxt "text_id=19933 | speaker=unknown"
msgid "　ノータイムでマルカジリ。"
msgstr ""

#. Occurrence NZ2:2245:19934: voice_id=BA0_NZ2_0032_1; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2245
msgctxt "text_id=19934 | speaker=unknown"
msgid "　やっぱりプロイってお菓子なんス？"
