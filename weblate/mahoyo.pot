#. Occurrence NZ2:1777:19905: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
msgctxt "text_id=19905 | speaker=unknown"
msgid "　　アリスさんも"
msgstr ""

#. Occurrence NZ2:1785:19906: voice_id=BA0_NZ2_0028_1; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1785
msgctxt "text_id=19906 | speaker=unknown"
msgid "負けてはいな"
