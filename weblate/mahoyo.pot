msgid "　これがプロイキッシャーの綴り。"
msgstr ""

#. Occurrence NZ2:1172:19863: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0011; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1172
msgctxt "text_id=19863 | speaker=alice"
msgid "　これだけで説明になると思うのだけど、どう？"
msgstr ""

#. Occurrence NZ2:1204:19864: voice_id=BA0_NZ2_0019; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1204
msgctxt "text_id=19864 | speaker=unknown"
msgid "　　　ぷろい？　きっくしゃー？"
msgstr ""

#. Occurrence NZ2:1235:19865: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19865 | speaker=alice"
msgid "キックシャーのクはほとんどサイレントよ。"
msgstr ""

#. Occurrence NZ2:1235:19866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19866 | speaker=alice"
msgid "西欧圏の、子供のオモチャ、子供だまし、軽蔑的に珍しいもの、"
msgstr ""

#. Occurrence NZ2:1235:19867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19867 | speaker=alice"
msgid "といった意味ね。"
msgstr ""

#. Occurrence NZ2:1266:19868: voice_id=BA0_NZ2_0020; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1266
msgctxt "text_id=19868 | speaker=unknown"
msgid "　あ。知ってるッス、"
msgstr ""

#. Occurrence NZ2:1266:19869: voice_id=BA0_NZ2_0020; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1266
msgctxt "text_id=19869 | speaker=unknown"
msgid "　それ変人の意味でも用い―――"
msgstr ""

#. Occurrence NZ2:1337:19870: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19870 | speaker=alice"
msgid "　　　プロイも同様に西欧圏のオモチャで、"
msgstr ""

#. Occurrence NZ2:1337:19871: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19871 | speaker=alice"
msgid "　　　こっちは戦争ごっこに使われるもの。"
msgstr ""

#. Occurrence NZ2:1337:19872: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19872 | speaker=alice"
msgid "　　　子供の教育用玩具の総称ね。"
msgstr ""

#. Occurrence NZ2:1368:19873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19873 | speaker=alice"
msgid "　戦略、戦術の俗語でもあり、"
msgstr ""

#. Occurrence NZ2:1368:19874: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19874 | speaker=alice"
msgid "　スコットランドだと……な意味もあるけれど、"
msgstr ""

#. Occurrence NZ2:1368:19875: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19875 | speaker=alice"
msgid "　それは忘れて。"
msgstr ""

#. Occurrence NZ2:1402:19876: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19876 | speaker=unknown"
msgid "　ふむ。この二つの単語をむりやり繋げたのが"
msgstr ""

#. Occurrence NZ2:1402:19877: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19877 | speaker=unknown"
msgid "　プロイキッシャーなんスね。"
msgstr ""

#. Occurrence NZ2:1402:19878: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19878 | speaker=unknown"
msgid "　もしかしてアリスさんオリジナル？"
msgstr ""

#. Occurrence NZ2:1433:19879: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0015; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1433
msgctxt "text_id=19879 | speaker=alice"
msgid "……わたしの母に伝わっていた独自の魔術系統よ。"
msgstr ""

#. Occurrence NZ2:1433:19880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0015; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1433
msgctxt "text_id=19880 | speaker=alice"
msgid "魔術協会に公開して権利と利益を得る、なんて低俗^な事はしていないから。"
msgstr ""

#. Occurrence NZ2:1466:19881: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19881 | speaker=unknown"
msgid "　　まあ、公開したところでアリスさんにしか"
msgstr ""

#. Occurrence NZ2:1466:19882: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19882 | speaker=unknown"
msgid "　　扱えないんですけどね！"
msgstr ""

#. Occurrence NZ2:1466:19883: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19883 | speaker=unknown"
msgid "　　マインスターの血に縛られてるッス！"
msgstr ""

#. Occurrence NZ2:1497:19884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0016; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1497
msgctxt "text_id=19884 | speaker=alice"
msgid "　　……アナタ、"
msgstr ""

#. Occurrence NZ2:1497:19885: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0016; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1497
msgctxt "text_id=19885 | speaker=alice"
msgid "　　本当はちゃんと分かっているんじゃないの？"
msgstr ""

#. Occurrence NZ2:1528:19886: voice_id=BA0_NZ2_0023; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1528
msgctxt "text_id=19886 | speaker=unknown"
msgid "？　すまないッス、今なに言ったのか忘れたッス。"
msgstr ""

#. Occurrence NZ2:1528:19887: voice_id=BA0_NZ2_0023; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1528
msgctxt "text_id=19887 | speaker=unknown"
msgid "ジブン、昔のコトは未来よりあやふやッスから。"
msgstr ""

#. Occurrence NZ2:1559:19888: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0017; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1559
msgctxt "text_id=19888 | speaker=alice"
msgid "　……。"
msgstr ""

#. Occurrence NZ2:1559:19889: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0017; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1559
msgctxt "text_id=19889 | speaker=alice"
msgid "　マインスターというのは、なに？"
msgstr ""

#. Occurrence NZ2:1608:19890: voice_id=BA0_NZ2_0024; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1608
msgctxt "text_id=19890 | speaker=unknown"
msgid "マイ女神ッス。アリスさんの母君ッスね。"
msgstr ""

#. Occurrence NZ2:1608:19891: voice_id=BA0_NZ2_0024; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1608
msgctxt "text_id=19891 | speaker=unknown"
msgid "あと、純血の魔女とか、いかにもなセカンドネームがあったッス。"
msgstr ""

#. Occurrence NZ2:1641:19892: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
msgctxt "text_id=19892 | speaker=unknown"
msgid "　　でも母君、ミーハーだったんスよね。"
msgstr ""

#. Occurrence NZ2:1641:19893: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
msgctxt "text_id=19893 | speaker=unknown"
msgid "　　流行り物に弱いというか。"
msgstr ""

#. Occurrence NZ2:1641:19894: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
