#. Occurrence NZ4:975:20180: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0009; voice_prefix=A40; voice_category=2; scene=NZ4
