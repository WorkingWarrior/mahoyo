#. Occurrence NZ2:1959:19916: voice_id=BA0_NZ2_0029; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1959
msgctxt "text_id=19916 | speaker=unknown"
msgid "　　アリスさん、なんか当たりきついッス！"
msgstr ""

#. Occurrence NZ2:1990:19917: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0022; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1990
