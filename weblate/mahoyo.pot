#. Occurrence NZ5:463:20293: voice_id=BA0_NZ5_0005; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:463
msgctxt "text_id=20293 | speaker=unknown"
msgid "　なんかスイッチ入ってるッスー。"
msgstr ""

#. Occurrence NZ5:498:20294: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20294 | speaker=alice"
msgid "　　さあ、なぜなにプロイの時間よ、ロビン。"
msgstr ""

#. Occurrence NZ5:498:20295: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20295 | speaker=alice"
msgid "　　今日は気分がいいから、"
msgstr ""

#. Occurrence NZ5:498:20296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20296 | speaker=alice"
msgid "　　取っておきの話をするとしましょう。"
msgstr ""

#. Occurrence NZ5:529:20297: voice_id=BA0_NZ5_0006; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:529
msgctxt "text_id=20297 | speaker=unknown"
msgid "　　あー、ついにきたッスね。"
msgstr ""

#. Occurrence NZ5:529:20298: voice_id=BA0_NZ5_0006; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:529
msgctxt "text_id=20298 | speaker=unknown"
msgid "　　三大プロイ、グレートスリーについて。"
msgstr ""

#. Occurrence NZ5:560:20299: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20299 | speaker=unknown"
msgid "　　アリスさんの母上の、そのまた母上の、"
msgstr ""

#. Occurrence NZ5:560:20300: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20300 | speaker=unknown"
msgid "　　そのまた母上の……とにかく初代ッスね。"
msgstr ""

#. Occurrence NZ5:560:20301: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20301 | speaker=unknown"
msgid "　　初代の頃から伝わってきた、三つの奇跡。"
msgstr ""

#. Occurrence NZ5:591:20302: voice_id=BA0_NZ5_0008; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:591
msgctxt "text_id=20302 | speaker=unknown"
msgid "　それが三大プロイ。"
msgstr ""

#. Occurrence NZ5:591:20303: voice_id=BA0_NZ5_0008; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:591
msgctxt "text_id=20303 | speaker=unknown"
msgid "　初めの魔女が造ったとされる、偉大な三品。"
msgstr ""

#. Occurrence NZ5:622:20304: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20304 | speaker=unknown"
msgid "　　橋の巨人テムズトロル、"
msgstr ""

#. Occurrence NZ5:622:20305: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20305 | speaker=unknown"
msgid "　　月の油フラットスナーク、"
msgstr ""

#. Occurrence NZ5:622:20306: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20306 | speaker=unknown"
msgid "　　三つ目は……あれ、何だったっス？"
msgstr ""

#. Occurrence NZ5:653:20307: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0006; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:653
msgctxt "text_id=20307 | speaker=alice"
msgid "　最後の一体はまだ秘密よ。"
msgstr ""

#. Occurrence NZ5:653:20308: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0006; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:653
msgctxt "text_id=20308 | speaker=alice"
msgid "　今回はテムズの話をしましょう。"
msgstr ""

#. Occurrence NZ5:696:20309: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20309 | speaker=alice"
msgid "　　　もとになったマザーグースはロンドン橋。"
msgstr ""

#. Occurrence NZ5:696:20310: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20310 | speaker=alice"
msgid "　　　『ロンドン橋　落ちた　落ちた　落ちた"
msgstr ""

#. Occurrence NZ5:696:20311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20311 | speaker=alice"
msgid "　　　ロンドン橋　落ちた　<わたしのきれいなご婦人よ|マ　イ　フ　ェ　ア　レ　デ　ィ >』"
msgstr ""

#. Occurrence NZ5:722:20312: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0008; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:722
msgctxt "text_id=20312 | speaker=alice"
msgid "　日本語訳されて音楽の教材にもなっているから、"
msgstr ""

#. Occurrence NZ5:722:20313: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0008; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:722
msgctxt "text_id=20313 | speaker=alice"
msgid "　知っている人も多いでしょうね。"
msgstr ""

#. Occurrence NZ5:753:20314: voice_id=BA0_NZ5_0010; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:753
msgctxt "text_id=20314 | speaker=unknown"
msgid "　別名、デオチトロルッスー！"
msgstr ""

#. Occurrence NZ5:753:20315: voice_id=BA0_NZ5_0010; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:753
msgctxt "text_id=20315 | speaker=unknown"
msgid "　こいつ、ザコ相手にしか活躍してないッスよね！"
msgstr ""

#. Occurrence NZ5:784:20316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20316 | speaker=alice"
msgid "　　　……相手が悪かったのよ。"
msgstr ""

#. Occurrence NZ5:784:20317: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20317 | speaker=alice"
msgid "　　　それに、わたしとの相性も悪いし。"
msgstr ""

#. Occurrence NZ5:784:20318: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20318 | speaker=alice"
msgid "　　　実はわたし、テムズをうまく使えないの。"
msgstr ""

#. Occurrence NZ5:810:20319: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0010; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:810
msgctxt "text_id=20319 | speaker=alice"
msgid "　　わたしが顕現させられるのは二段階目まで。"
msgstr ""

#. Occurrence NZ5:810:20320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0010; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:810
msgctxt "text_id=20320 | speaker=alice"
msgid "　　三番目と四番目の歌詞は未知の領域よ。"
msgstr ""

#. Occurrence NZ5:842:20321: voice_id=BA0_NZ5_0011; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:842
msgctxt "text_id=20321 | speaker=unknown"
msgid "　三番目と四番目って、なんスか？"
msgstr ""

#. Occurrence NZ5:874:20322: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0011; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:874
msgctxt "text_id=20322 | speaker=alice"
msgid "　　　ロンドン橋の歌詞よ。"
msgstr ""

#. Occurrence NZ5:900:20323: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0012; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:900
msgctxt "text_id=20323 | speaker=alice"
msgid "『～木と土は流される"
msgstr ""

#. Occurrence NZ5:900:20324: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0012; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:900
msgctxt "text_id=20324 | speaker=alice"
msgid "　～煉瓦とモルタルは崩れてしまう』"
msgstr ""

#. Occurrence NZ5:926:20325: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0013; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:926
msgctxt "text_id=20325 | speaker=alice"
msgid "　　『～鉄と鋼は折れ曲がる"
msgstr ""

#. Occurrence NZ5:926:20326: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0013; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:926
msgctxt "text_id=20326 | speaker=alice"
msgid "　　　～銀と金は盗まれる』"
msgstr ""

#. Occurrence NZ5:957:20327: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20327 | speaker=alice"
msgid "　　　　テムズはロンドン橋のプロイだけど、"
msgstr ""

#. Occurrence NZ5:957:20328: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20328 | speaker=alice"
msgid "　　　　時代に添ってその在り方を変えてきた。"
msgstr ""

#. Occurrence NZ5:957:20329: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20329 | speaker=alice"
msgid "　　　　だから、今はマザーグース通り四種類の姿があるの。"
msgstr ""

#. Occurrence NZ5:1005:20330: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20330 | speaker=unknown"
msgid "　ウッド、ストーンの他にまだ先があるんスね。"
msgstr ""

#. Occurrence NZ5:1005:20331: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20331 | speaker=unknown"
msgid "　でもいいんスか、"
msgstr ""

#. Occurrence NZ5:1005:20332: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20332 | speaker=unknown"
msgid "　こんなカンタンに奥の手をさらしちゃって？"
msgstr ""

#. Occurrence NZ5:1036:20333: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0015; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1036
msgctxt "text_id=20333 | speaker=alice"
msgid "　　ええ。ロンドン橋の歌詞なんて、"
msgstr ""

#. Occurrence NZ5:1036:20334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0015; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1036
msgctxt "text_id=20334 | speaker=alice"
msgid "　　いまどき調べれば誰だって分かるのだし。"
msgstr ""

#. Occurrence NZ5:1062:20335: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20335 | speaker=alice"
msgid "　 そもそもわたし、"
msgstr ""

#. Occurrence NZ5:1062:20336: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20336 | speaker=alice"
msgid "　 どうあってもストーンまでしか使えないわ。"
msgstr ""

#. Occurrence NZ5:1062:20337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20337 | speaker=alice"
msgid "　 ネタをバラしても支障はないでしょう？"
msgstr ""

#. Occurrence NZ5:1094:20338: voice_id=BA0_NZ5_0013; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1094
msgctxt "text_id=20338 | speaker=unknown"
msgid "　　どうして使えないんスか？"
msgstr ""

#. Occurrence NZ5:1125:20339: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0017; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1125
msgctxt "text_id=20339 | speaker=alice"
msgid "　わたし、人間の文明社会に興味がないもの。"
msgstr ""

#. Occurrence NZ5:1125:20340: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0017; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1125
msgctxt "text_id=20340 | speaker=alice"
msgid "　わたしの心象世界にある橋は『木と石まで』、というコトね。"
msgstr ""

#. Occurrence NZ5:1156:20341: voice_id=BA0_NZ5_0014; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1156
msgctxt "text_id=20341 | speaker=unknown"
msgid "　なんと。"
msgstr ""

#. Occurrence NZ5:1156:20342: voice_id=BA0_NZ5_0014; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1156
msgctxt "text_id=20342 | speaker=unknown"
msgid "　無敵のアリスさんにも弱点があったんスね……"
msgstr ""

#. Occurrence NZ5:1188:20343: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20343 | speaker=unknown"
msgid " あ。いや、振り返ってみればそんなに"
msgstr ""

#. Occurrence NZ5:1188:20344: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20344 | speaker=unknown"
msgid " 無敵じゃなかったッスね！　アリスさん、負け星のが多いッス、"
msgstr ""

#. Occurrence NZ5:1188:20345: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20345 | speaker=unknown"
msgid " ジブンとおそろッスー！"
msgstr ""

#. Occurrence NZ5:1225:20346: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20346 | speaker=unknown"
msgid "でも、風の噂によるとテムズトロルは"
msgstr ""

#. Occurrence NZ5:1225:20347: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20347 | speaker=unknown"
msgid "世界屈指のゴーレムと聞いたッスよ。"
msgstr ""

#. Occurrence NZ5:1225:20348: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20348 | speaker=unknown"
msgid "最高級のテムズトロルはどれくらい強いんスか？"
msgstr ""

#. Occurrence NZ5:1256:20349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0018; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1256
msgctxt "text_id=20349 | speaker=alice"
msgid "　そうね。テムズを最後まで建築できる魔女が、"
msgstr ""

#. Occurrence NZ5:1256:20350: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0018; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1256
msgctxt "text_id=20350 | speaker=alice"
msgid "　もし現代にいるのなら―――"
msgstr ""

#. Occurrence NZ5:1282:20351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0019; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1282
msgctxt "text_id=20351 | speaker=alice"
msgid " そのテムズは奥の手を出しきった青子でも"
msgstr ""

#. Occurrence NZ5:1282:20352: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0019; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1282
msgctxt "text_id=20352 | speaker=alice"
msgid " 倒しきれない、踏破不可能の橋になるでしょうね。"
msgstr ""

#. Occurrence NZ5:1313:20353: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0020; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1313
msgctxt "text_id=20353 | speaker=alice"
msgid "　　産業革命時の<煤煙|スモッグ>都市、ロンドン。"
msgstr ""

#. Occurrence NZ5:1313:20354: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0020; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1313
msgctxt "text_id=20354 | speaker=alice"
msgid "　　その異名を上回る、都市の巨人として顕現するのだから。"
msgstr ""

#. Occurrence NZ5:1344:20355: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20355 | speaker=unknown"
msgid "　ハハハ、また大きく出たッスね！"
msgstr ""

#. Occurrence NZ5:1344:20356: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20356 | speaker=unknown"
msgid "　都市！　都市っスか！"
msgstr ""

#. Occurrence NZ5:1344:20357: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20357 | speaker=unknown"
msgid "　口だけならなんとでも言えるってヤツッス？"
msgstr ""

#. Occurrence NZ5:1370:20358: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20358 | speaker=unknown"
msgid "アリスさん、その見栄っ張りで負けず嫌いなところ、"
msgstr ""

#. Occurrence NZ5:1370:20359: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20359 | speaker=unknown"
msgid "直した方がいいッスよ。"
msgstr ""

#. Occurrence NZ5:1370:20360: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20360 | speaker=unknown"
msgid "親愛なるプロイからの、涙の忠告ッス！"
msgstr ""

#. Occurrence NZ5:1401:20361: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20361 | speaker=alice"
msgid "　　ありがとう。"
msgstr ""

#. Occurrence NZ5:1401:20362: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20362 | speaker=alice"
msgid "　　それじゃあさっそく、"
msgstr ""

#. Occurrence NZ5:1401:20363: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20363 | speaker=alice"
msgid "　　性格改善に付き合ってもらおうかしら。"
msgstr ""

#. Occurrence NZ5:1432:20364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_0; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1432
msgctxt "text_id=20364 | speaker=alice"
msgid "　　まずは、“口だけなら”というところから。"
msgstr ""

#. Occurrence NZ5:1443:20365: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_1; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1443
msgctxt "text_id=20365 | speaker=alice"
msgid "　　出番よテムズ。"
msgstr ""

#. Occurrence NZ5:1443:20366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_1; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1443
msgctxt "text_id=20366 | speaker=alice"
msgid "　　アナタの力を見せてあげなさい。"
msgstr ""

#. Occurrence NZ5:1513:20367: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20367 | speaker=unknown"
msgid "　デオチ出たーーーーーー！"
msgstr ""

#. Occurrence NZ5:1513:20368: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20368 | speaker=unknown"
msgid "　というか、すでにデオチの体の上だったッス？"
msgstr ""

#. Occurrence NZ5:1513:20369: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20369 | speaker=unknown"
msgid "　初めからジブンに逃げ場はなかったッス？"
msgstr ""

#. Occurrence NZ5:1539:20370: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0023; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1539
msgctxt "text_id=20370 | speaker=alice"
msgid "　そうよ。だから言ったでしょう。"
msgstr ""

#. Occurrence NZ5:1539:20371: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0023; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1539
msgctxt "text_id=20371 | speaker=alice"
msgid "　山を舐めるな、と。"
msgstr ""

#. Occurrence NZ5:1571:20372: voice_id=BA0_NZ5_0020; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1571
msgctxt "text_id=20372 | speaker=unknown"
msgid "　いや、そういう意味じゃなかった気がするッス。"
msgstr ""

#. Occurrence NZ6:162:20373: voice_id=BA0_NZ6_0000; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:162
msgctxt "text_id=20373 | speaker=unknown"
msgid "　　この映画、字幕が出てないッスね。"
msgstr ""

#. Occurrence NZ6:162:20374: voice_id=BA0_NZ6_0000; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:162
msgctxt "text_id=20374 | speaker=unknown"
msgid "　　ジブン、ちゃんとセリフあるんスけどー。"
msgstr ""

#. Occurrence NZ6:196:20375: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20375 | speaker=alice"
msgid "　　　　知ってるわ。"
msgstr ""

#. Occurrence NZ6:196:20376: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20376 | speaker=alice"
msgid "　　　　でも耳障りだったから、わたし権限で編集さんに"
msgstr ""

#. Occurrence NZ6:196:20377: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20377 | speaker=alice"
msgid "　　　　貴方の台詞だけカットしてもらったの。"
msgstr ""

#. Occurrence NZ6:222:20378: voice_id=BA0_NZ6_0001; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:222
msgctxt "text_id=20378 | speaker=unknown"
msgid " グレイト。もう何もかもアリスさん中心なんスね。"
msgstr ""

#. Occurrence NZ6:222:20379: voice_id=BA0_NZ6_0001; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:222
msgctxt "text_id=20379 | speaker=unknown"
msgid " ジブンだけサイレント映画の気分ッス。"
msgstr ""

#. Occurrence NZ6:286:20380: voice_id=BA0_NZ6_0002; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:286
msgctxt "text_id=20380 | speaker=unknown"
msgid "　　　　二体目ッスね。"
msgstr ""

#. Occurrence NZ6:312:20381: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0001; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:312
msgctxt "text_id=20381 | speaker=alice"
msgid "　二体目ね。"
msgstr ""

#. Occurrence NZ6:312:20382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0001; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:312
msgctxt "text_id=20382 | speaker=alice"
msgid "　誤解されそうだから言っておくと、スナークの本体は液体よ。"
msgstr ""

#. Occurrence NZ6:338:20383: voice_id=BA0_NZ6_0003; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:338
msgctxt "text_id=20383 | speaker=unknown"
msgid "　スナークの二つ名、月の油ッスね。"
msgstr ""

#. Occurrence NZ6:338:20384: voice_id=BA0_NZ6_0003; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:338
msgctxt "text_id=20384 | speaker=unknown"
msgid "　フラットスナークの名前は誰が付けたんスか？"
msgstr ""

#. Occurrence NZ6:403:20385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20385 | speaker=alice"
msgid "　アナタもよく知っている彼女だけど。"
msgstr ""

#. Occurrence NZ6:403:20386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20386 | speaker=alice"
msgid "　わたし、彼女と仲良くなるまで、プロイに名前を"
msgstr ""

#. Occurrence NZ6:403:20387: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20387 | speaker=alice"
msgid "　つけていなかったから。"
msgstr ""

#. Occurrence NZ6:429:20388: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0003; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:429
msgctxt "text_id=20388 | speaker=alice"
msgid "　　強い順とか、思い入れがある順に、"
msgstr ""

#. Occurrence NZ6:429:20389: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0003; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:429
msgctxt "text_id=20389 | speaker=alice"
msgid "　　一番、二番、と呼んでいただけだったの。"
msgstr ""

#. Occurrence NZ6:498:20390: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20390 | speaker=unknown"
msgid "　順番？　番号じゃなくて？"
msgstr ""

#. Occurrence NZ6:498:20391: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20391 | speaker=unknown"
msgid "　名前をつけないぐうたら……"
msgstr ""

#. Occurrence NZ6:498:20392: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20392 | speaker=unknown"
msgid "　いや、シンプルさはアリスさんらしいッスけど、なんで順番？"
msgstr ""

#. Occurrence NZ6:524:20393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0004; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:524
msgctxt "text_id=20393 | speaker=alice"
msgid "　だって、番号を付けても混乱するだけでしょう？"
msgstr ""

#. Occurrence NZ6:524:20394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0004; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:524
msgctxt "text_id=20394 | speaker=alice"
msgid "　どれが強いか、どれが好きかなんて、日によって変わるのだし。"
msgstr ""

#. Occurrence NZ6:550:20395: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20395 | speaker=alice"
msgid "だから気持ち次第で、その日ごとに順番は違ったわ。"
msgstr ""

#. Occurrence NZ6:550:20396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20396 | speaker=alice"
msgid "一番はディドルが鉄板。"
msgstr ""

#. Occurrence NZ6:550:20397: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20397 | speaker=alice"
msgid "テムズはたいてい三番か四番だったわね。"
msgstr ""

#. Occurrence NZ6:614:20398: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20398 | speaker=alice"
msgid "　　ああ、思いだした。"
msgstr ""

#. Occurrence NZ6:614:20399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20399 | speaker=alice"
msgid "　　彼女とプロイで遊んでいる時、"
msgstr ""

#. Occurrence NZ6:614:20400: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20400 | speaker=alice"
msgid "　　それで困ったコトになって。"
msgstr ""

#. Occurrence NZ6:684:20401: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20401 | speaker=liddell"
msgid "「アリス、明日、新しいパパがやってくるの。"
msgstr ""

#. Occurrence NZ6:684:20402: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20402 | speaker=liddell"
msgid "　だから六番のプロイを貸してちょうだい。"
msgstr ""

#. Occurrence NZ6:684:20403: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20403 | speaker=liddell"
msgid "　ワタシ、おめかしして出迎えたいの！」"
msgstr ""

#. Occurrence NZ6:753:20404: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0007; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:753
msgctxt "text_id=20404 | speaker=alice"
msgid "　そう言った彼女に、わたし、その日は気分的に"
msgstr ""

#. Occurrence NZ6:753:20405: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0007; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:753
msgctxt "text_id=20405 | speaker=alice"
msgid " 「これは六番目」と決めていたプロイを貸したわ。"
msgstr ""

#. Occurrence NZ6:824:20406: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20406 | speaker=unknown"
msgid "　 ……。"
msgstr ""

#. Occurrence NZ6:824:20407: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20407 | speaker=unknown"
msgid "　もうだいたい分かったッスけど、いちおう訊いておくッス。"
msgstr ""

#. Occurrence NZ6:824:20408: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20408 | speaker=unknown"
msgid "　それはなんのプロイだったっスか？"
msgstr ""

#. Occurrence NZ6:855:20409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0008; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:855
msgctxt "text_id=20409 | speaker=alice"
msgid "後に、彼女がゴブリンフロンと名付けるようになった香水よ。"
msgstr ""

#. Occurrence NZ6:855:20410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0008; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:855
msgctxt "text_id=20410 | speaker=alice"
msgid "その香水をかけると、一日、悪口とスラングしか言えなくなるの。"
msgstr ""

#. Occurrence NZ6:887:20411: voice_id=BA0_NZ6_0006; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:887
msgctxt "text_id=20411 | speaker=unknown"
msgid "　　　　……………………。"
msgstr ""

#. Occurrence NZ6:918:20412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0009; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:918
msgctxt "text_id=20412 | speaker=alice"
msgid "　　その後、彼女はプロイに名前を付けるよう提案してきたわ。"
msgstr ""

#. Occurrence NZ6:918:20413: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0009; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:918
msgctxt "text_id=20413 | speaker=alice"
msgid "　　なぜか涙で赤くなった目で。"
msgstr ""

#. Occurrence NZ6:949:20414: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0010; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:949
msgctxt "text_id=20414 | speaker=alice"
msgid "『これはスイーツハーツ。これはスクリプス・ハンプティ。これはディドルディドル。これはフラットスナーク。いい。これからはこの名前で統一するのよ』"
msgstr ""

#. Occurrence NZ6:980:20415: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0011; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:980
msgctxt "text_id=20415 | speaker=alice"
msgid "……名は体を表すと言うでしょう？"
msgstr ""

#. Occurrence NZ6:980:20416: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0011; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:980
msgctxt "text_id=20416 | speaker=alice"
msgid "わたし、そんな変換間違えのような名前より、その日の気分で分けた方が楽でいいと思ったのだけど、"
msgstr ""

#. Occurrence NZ6:1011:20417: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0012; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1011
msgctxt "text_id=20417 | speaker=alice"
msgid "『アンタの気分なんて他人には分かんないし。その度にアタシの運命が狂っていくコトを、もうちょっと気にしてちょうだい』"
msgstr ""

#. Occurrence NZ6:1042:20418: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0013; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1042
msgctxt "text_id=20418 | speaker=alice"
msgid "『それに近い将来、こういう名前がトレンドになる時代がくるから。絶対。すぐに飽きられるだろうけど』"
msgstr ""

#. Occurrence NZ6:1073:20419: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0014; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1073
msgctxt "text_id=20419 | speaker=alice"
msgid "『なんで、どうせつけるならイカした方がグッドでバッド。せっかくアタシたちだけのオリジナリティなのよ、ポップに流行らせなくちゃ大損だわ！』"
msgstr ""

#. Occurrence NZ6:1104:20420: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0015; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1104
msgctxt "text_id=20420 | speaker=alice"
msgid "それ以来、わたしはプロイを名前で呼ぶようになった。いちいち名前を覚える手間はあったけれど、プロイを間違えるコトはなくなったわ。"
msgstr ""

#. Occurrence NZ6:1135:20421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20421 | speaker=alice"
msgid "　　まさにコロンブスのタマゴね。"
msgstr ""

#. Occurrence NZ6:1135:20422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20422 | speaker=alice"
msgid "　　なんていう発想の柔軟さ、斬新さかしら。"
msgstr ""

#. Occurrence NZ6:1135:20423: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20423 | speaker=alice"
msgid "　　時々思うのだけど、あの娘は天才ね。"
msgstr ""

#. Occurrence NZ6:1166:20424: voice_id=BA0_NZ6_0007; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1166
msgctxt "text_id=20424 | speaker=unknown"
msgid "　そッスね。ジブンも思うんスけど、"
msgstr ""

#. Occurrence NZ6:1166:20425: voice_id=BA0_NZ6_0007; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1166
msgctxt "text_id=20425 | speaker=unknown"
msgid "　アリスさんって時々すごくヴァカァですよね。"
msgstr ""

#. Occurrence NZ6:1329:20426: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0017; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1329
msgctxt "text_id=20426 | speaker=alice"
msgid "　　……やられてしまったわね。"
msgstr ""

#. Occurrence NZ6:1362:20427: voice_id=BA0_NZ6_0008; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1362
msgctxt "text_id=20427 | speaker=unknown"
msgid "油なだけによく燃えるッスねー。"
msgstr ""

#. Occurrence NZ6:1362:20428: voice_id=BA0_NZ6_0008; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1362
msgctxt "text_id=20428 | speaker=unknown"
msgid "スナークはどんなプロイなんスか？"
msgstr ""

#. Occurrence NZ6:1388:20429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0018; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1388
msgctxt "text_id=20429 | speaker=alice"
msgid "　　本編でだいたいのあらましは語っているわ。"
msgstr ""

#. Occurrence NZ6:1388:20430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0018; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1388
msgctxt "text_id=20430 | speaker=alice"
msgid "　　細かなデータは、"
msgstr ""

#. Occurrence NZ6:1456:20431: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20431 | speaker=unknown"
msgid "うむ。"
msgstr ""

#. Occurrence NZ6:1456:20432: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20432 | speaker=unknown"
msgid "その貴重な油を、青子さんは燃やしてしまった、と。"
msgstr ""

#. Occurrence NZ6:1456:20433: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20433 | speaker=unknown"
msgid "これ、なんとか戻せないんスか？"
msgstr ""

#. Occurrence NZ6:1482:20434: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0019; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1482
msgctxt "text_id=20434 | speaker=alice"
msgid "残念ながら不可能よ。"
msgstr ""

#. Occurrence NZ6:1482:20435: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0019; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1482
msgctxt "text_id=20435 | speaker=alice"
msgid "この時代ではスナークを精製するコトはできない。"
msgstr ""

#. Occurrence NZ6:1515:20436: voice_id=BA0_NZ6_0010; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1515
msgctxt "text_id=20436 | speaker=unknown"
msgid "こうして貴重な文化遺産は、フィーリングだけで生きている野蛮人に壊されていくんスねー。"
msgstr ""

#. Occurrence NZ6:1515:20437: voice_id=BA0_NZ6_0010; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1515
msgctxt "text_id=20437 | speaker=unknown"
msgid "うはっ、文明を蹂躙するのっておもしれぇー！"
msgstr ""

#. Occurrence NZ6:1586:20438: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20438 | speaker=unknown"
msgid "しっかし、デオチに続いてスナークもこのザマとか！"
msgstr ""

#. Occurrence NZ6:1586:20439: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20439 | speaker=unknown"
msgid "ギャハハ、何がグレートスリーッスか！"
msgstr ""

#. Occurrence NZ6:1586:20440: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20440 | speaker=unknown"
msgid "甘え。グレートスリーは甘え。"
msgstr ""

#. Occurrence NZ6:1657:20441: voice_id=BA0_NZ6_0012; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1657
msgctxt "text_id=20441 | speaker=unknown"
msgid "しかしジブン、やるプロイッスから。産廃を有効利用するッスよ。おーい、外の店員さーん。この残った油で、とりあえずフライドポテトでも揚げてくれ？"
msgstr ""

#. Occurrence NZ6:1688:20442: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0020; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1688
msgctxt "text_id=20442 | speaker=alice"
msgid "あら、アナタにしては名案ねロビン。"
msgstr ""

#. Occurrence NZ6:1688:20443: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0020; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1688
msgctxt "text_id=20443 | speaker=alice"
msgid "それじゃあ、わたしはフライドチキンにしてもらお^うかしら。"
msgstr ""

#. Occurrence NZ6:1720:20444: voice_id=BA0_NZ6_0013; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1720
msgctxt "text_id=20444 | speaker=unknown"
msgid "………………。"
msgstr ""

#. Occurrence NZ6:1720:20445: voice_id=BA0_NZ6_0013; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1720
msgctxt "text_id=20445 | speaker=unknown"
msgid "外のメニュー、ホットドッグとポップコーンとポテ^トしかなかったッスよ。"
msgstr ""

#. Occurrence NZ6:1751:20446: voice_id=BA0_NZ6_0014; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1751
msgctxt "text_id=20446 | speaker=unknown"
msgid "ジブン、映画館はまず飲食店のメニューからチェックする派ッスから。だいたい映画館でフライドチキンとか、匂いが無頼ッス。他のお客さんに迷惑ッス。"
msgstr ""

#. Occurrence NZ6:1782:20447: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20447 | speaker=alice"
msgid "　　　知っているわ。でも安心して。"
msgstr ""

#. Occurrence NZ6:1782:20448: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20448 | speaker=alice"
msgid "　　　わたし、お腹はすいていないから。"
msgstr ""

#. Occurrence NZ6:1782:20449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20449 | speaker=alice"
msgid "　　　ただ油で揚げてもらうだけでいいの。"
msgstr ""

#. Occurrence NZ6:1815:20450: voice_id=BA0_NZ6_0015; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1815
msgctxt "text_id=20450 | speaker=unknown"
msgid "　ハハハ。食事として、頼むワケでは、ないと。"
msgstr ""

#. Occurrence NZ6:1907:20451: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0022; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1907
msgctxt "text_id=20451 | speaker=alice"
msgid "高温で全身まんべんなく、毛先から毛穴までゆであがるのは初めてなんじゃないかしら。"
msgstr ""

#. Occurrence NZ6:1907:20452: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0022; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1907
msgctxt "text_id=20452 | speaker=alice"
msgid "また一つ死因コレクションが増えたわね、ロビン。"
msgstr ""

#. Occurrence NZ6:2019:20453: voice_id=BA0_NZ6_0016; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:2019
msgctxt "text_id=20453 | speaker=unknown"
msgid "この世でいちばん増やしたくないレパートリー、"
msgstr ""

#. Occurrence NZ6:2019:20454: voice_id=BA0_NZ6_0016; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:2019
msgctxt "text_id=20454 | speaker=unknown"
msgid "あざーっスーーーー！　でも世界にはまだまだ未知の死因が隠れているッスよー！"
msgstr ""

#. Occurrence NZ6:2106:20455: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0023; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2106
msgctxt "text_id=20455 | speaker=alice"
msgid "　……映画はここまでのようね。"
msgstr ""

#. Occurrence NZ6:2106:20456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0023; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2106
msgctxt "text_id=20456 | speaker=alice"
msgid "　同時上映のある劇場も、最近は減ってきたわね。"
msgstr ""

#. Occurrence NZ6:2137:20457: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0024; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2137
msgctxt "text_id=20457 | speaker=alice"
msgid "　　最後に三体目の紹介をしたかったけど、"
msgstr ""

#. Occurrence NZ6:2137:20458: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0024; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2137
msgctxt "text_id=20458 | speaker=alice"
msgid "　　それはまたの機会に。"
msgstr ""

#. Occurrence NZ6:2197:20459: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20459 | speaker=alice"
msgid "　　長かった本編を楽しんでくれた皆さん。"
msgstr ""

#. Occurrence NZ6:2197:20460: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20460 | speaker=alice"
msgid "　　すぐ終わるようで、なかなか終わらなかった"
msgstr ""

#. Occurrence NZ6:2197:20461: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20461 | speaker=alice"
msgid "　　番外編に付き合ってくれた皆さん。"
msgstr ""

#. Occurrence NZ6:2223:20462: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20462 | speaker=alice"
msgid "「魔法使いの夜」は、これで一旦の終了となります。"
msgstr ""

#. Occurrence NZ6:2223:20463: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20463 | speaker=alice"
msgid "続きはまた、いつかどこかで。"
msgstr ""

#. Occurrence NZ6:2223:20464: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20464 | speaker=alice"
msgid "旅する星がするりと落ちて、貴方の胸に輝く時に。"
msgstr ""

#. Occurrence NZ6:2249:20465: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0027; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2249
msgctxt "text_id=20465 | speaker=alice"
msgid "　 ―――それでは。"
msgstr ""

#. Occurrence NZ6:2249:20466: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0027; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2249
msgctxt "text_id=20466 | speaker=alice"
msgid "　 長らくのご視聴、ありがとうございました。"
msgstr ""

#. Occurrence SP1:41:20467: scene=SP1
#: SP1:41
msgctxt "text_id=20467 | speaker=unknown"
msgid "　人里<離|はな>れた辺境から都会に来てはや一年。"
msgstr ""

#. Occurrence SP1:46:20468: scene=SP1
#: SP1:46
msgctxt "text_id=20468 | speaker=unknown"
msgid "　ヒトとケモノとで一番の大きな違いは、『好き嫌い』という嗜好性なんじゃないだろうか、とカレは思った。"
msgstr ""

#. Occurrence SP1:97:20469: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0000; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:97
msgctxt "text_id=20469 | speaker=beo"
msgid "「ふーん、ここが新しいアジトかー。"
msgstr ""

#. Occurrence SP1:103:20470: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0001; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:103
msgctxt "text_id=20470 | speaker=beo"
msgid "　うん、いいんじゃない？　ちょっとみすぼらしいけど、まわりに人間がいないのはキレイでいいよね」"
msgstr ""

#. Occurrence SP1:128:20471: scene=SP1
#: SP1:128
msgctxt "text_id=20471 | speaker=unknown"
msgid "　白いコートの人影が、くるくると廊下で<躍|おど>る。"
msgstr ""

#. Occurrence SP1:133:20472: scene=SP1
#: SP1:133
msgctxt "text_id=20472 | speaker=unknown"
msgid "　その様はウインドウショッピングを楽しむ少女のようだ。"
msgstr ""

#. Occurrence SP1:138:20473: scene=SP1
#: SP1:138
msgctxt "text_id=20473 | speaker=unknown"
msgid "　事実、ソレは興味津々とばかりに朽ち果てた校舎の無惨を<愉|たの>しんでいる。"
msgstr ""

#. Occurrence SP1:170:20474: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0000; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:170
msgctxt "text_id=20474 | speaker=touko"
msgid "「そこ、あんまりはしゃがないの。なにしろ<築|ちく>六十年からの廃屋なんだから。"
msgstr ""

#. Occurrence SP1:176:20475: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0001; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:176
msgctxt "text_id=20475 | speaker=touko"
msgid "　調子に乗ってると、バキッと床を<踏|ふ>み抜いて―――」"
msgstr ""

#. Occurrence SP1:182:20476: scene=SP1
#: SP1:182
msgctxt "text_id=20476 | speaker=unknown"
msgid "　楽しいわよ、と言いかけた口が閉じる。"
msgstr ""

#. Occurrence SP1:213:20477: scene=SP1
#: SP1:213
msgctxt "text_id=20477 | speaker=unknown"
msgid "　響いている足音は一人分だけ。"
msgstr ""

#. Occurrence SP1:218:20478: scene=SP1
#: SP1:218
msgctxt "text_id=20478 | speaker=unknown"
msgid "　老朽化した廊下を<労|ねぎら>ってか、それとも身も心も浮かれているのか。"
msgstr ""

#. Occurrence SP1:223:20479: scene=SP1
#: SP1:223
msgctxt "text_id=20479 | speaker=unknown"
msgid "　コート姿のソレは先ほどから微塵も、自身の三十キロ程度の重さすら、廊下に加えてはいなかった。"
msgstr ""

#. Occurrence SP1:259:20480: scene=SP1
#: SP1:259
msgctxt "text_id=20480 | speaker=unknown"
msgid "　曰く、<仁獣|じんじゅう>は野原を歩いても草花を傷つけないと云う。"
msgstr ""

#. Occurrence SP1:264:20481: scene=SP1
#: SP1:264
msgctxt "text_id=20481 | speaker=unknown"
msgid "　あのコート姿の人影もその<類|たぐい>の生き物らしい。"
msgstr ""

#. Occurrence SP1:269:20482: scene=SP1
#: SP1:269
msgctxt "text_id=20482 | speaker=unknown"
msgid "　カレは環境側の生き物だ。"
msgstr ""

#. Occurrence SP1:274:20483: scene=SP1
#: SP1:274
msgctxt "text_id=20483 | speaker=unknown"
msgid "　高等、下等、どちらであろうと肉持つ獣には何の温情も持たないが、同胞には人並み……いや、狼並みの温情を持つらしい。"
msgstr ""

#. Occurrence SP1:311:20484: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0002; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:311
msgctxt "text_id=20484 | speaker=touko"
msgid "「ま、相性は良い、とプラスに考えましょう。"
msgstr ""

#. Occurrence SP1:322:20485: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0003; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:322
msgctxt "text_id=20485 | speaker=touko"
msgid "　町に出かけてくるけど、何かほしいものはある？　マンガとか、小説とか」"
msgstr ""

#. Occurrence SP1:335:20486: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0002_0; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:335
msgctxt "text_id=20486 | speaker=beo"
msgid "「んー、特にいりません。"
msgstr ""

#. Occurrence SP1:348:20487: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0002_1; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:348
msgctxt "text_id=20487 | speaker=beo"
msgid "あ、帰りにハンバーガー買ってきてくれたら嬉しいな！　あの、パン生地がどっしりしてて、ハンバーグがぎゅっとしたヤツがいい！」"
msgstr ""

#. Occurrence SP1:374:20488: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0004; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:374
msgctxt "text_id=20488 | speaker=touko"
msgid "「まだオモチャより食い気ときた。食事の調達方法も確保しないとダメみたいね。"
msgstr ""

#. Occurrence SP1:380:20489: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0005; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:380
msgctxt "text_id=20489 | speaker=touko"
msgid "　……失敗したかな？　ルームサービスのあるホテルの方が、<後々|あとあと>証拠は残らなさそう」"
msgstr ""

#. Occurrence SP1:400:20490: scene=SP1
#: SP1:400
msgctxt "text_id=20490 | speaker=unknown"
msgid "　やれやれとため息をつくのは、言うまでもなく蒼崎橙子である。"
msgstr ""

#. Occurrence SP1:405:20491: scene=SP1
#: SP1:405
msgctxt "text_id=20491 | speaker=unknown"
msgid "　眼鏡をかけているので、口調も仕草も彼女本来のものに固定されている。"
msgstr ""

#. Occurrence SP1:439:20492: scene=SP1
#: SP1:439
msgctxt "text_id=20492 | speaker=unknown"
msgid "　十二月初頭。"
msgstr ""

#. Occurrence SP1:444:20493: scene=SP1
#: SP1:444
msgctxt "text_id=20493 | speaker=unknown"
msgid "　彼女とカレが三咲市にやってきてから、まる一ヶ月が経過しようとしていた。"
msgstr ""

#. Occurrence SP1:449:20494: scene=SP1
#: SP1:449
msgctxt "text_id=20494 | speaker=unknown"
msgid "　今までは隣町から三咲町を攻略していた橙子だが、そろそろ本番という事で、<本営|ほんえい>をここ旧校舎に移転させたのである。"
msgstr ""

#. Occurrence SP1:478:20495: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0003; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:478
msgctxt "text_id=20495 | speaker=beo"
msgid "「？　なに、ホテルの方が良かったの？」"
msgstr ""

#. Occurrence SP1:495:20496: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0006; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:495
msgctxt "text_id=20496 | speaker=touko"
msgid "「そりゃあ楽だもの。グレードが良ければホテル暮らしは快適です」"
msgstr ""

#. Occurrence SP1:501:20497: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0004; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:501
msgctxt "text_id=20497 | speaker=beo"
msgid "「ふーん。でもトーコさん、こういう廃墟好きだよね」"
msgstr ""

#. Occurrence SP1:507:20498: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0007; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:507
msgctxt "text_id=20498 | speaker=touko"
msgid "「え、そうかな？」"
msgstr ""

#. Occurrence SP1:513:20499: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0005; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:513
msgctxt "text_id=20499 | speaker=beo"
msgid "「そうだよ。今回みたいなのは特にそう。"
msgstr ""

#. Occurrence SP1:519:20500: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0006; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:519
msgctxt "text_id=20500 | speaker=beo"
msgid "　趣味に走る時、まわりにヒトがいるのイヤがるじゃない。いろんな物に興味を持つクセに、興味を持たれるのはメンドウってゆーか」"
msgstr ""

#. Occurrence SP1:556:20501: scene=SP1
#: SP1:556
msgctxt "text_id=20501 | speaker=unknown"
msgid "　指摘されて、そっか、と納得する橙子だった。"
msgstr ""

#. Occurrence SP1:561:20502: scene=SP1
#: SP1:561
msgctxt "text_id=20502 | speaker=unknown"
msgid "　カレと契約したのは二年前だが、本格的に護衛として同伴させてからじき一年。"
msgstr ""

#. Occurrence SP1:566:20503: scene=SP1
#: SP1:566
msgctxt "text_id=20503 | speaker=unknown"
msgid "　蒼崎橙子という人間の根っこにある問題を、カレはきちんと把握しているらしい。"
msgstr ""

#. Occurrence SP1:601:20504: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0008; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:601
msgctxt "text_id=20504 | speaker=touko"
msgid "「人混みは嫌いじゃないんだけどねー。廃ビルでも廃工場でも、いっそあの遊園地でも良かったのよ？"
msgstr ""

#. Occurrence SP1:607:20505: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0009; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:607
msgctxt "text_id=20505 | speaker=touko"
msgid "　でも、こんな田舎町じゃ君を連れているだけで噂になるでしょ。結果的に、<山奥|ここ>に工房を構えるしかなかったの」"
msgstr ""

#. Occurrence SP1:634:20506: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0007; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:634
msgctxt "text_id=20506 | speaker=beo"
msgid "「えー。ちゃんとヒト形になってるじゃん、ボク。"
msgstr ""

#. Occurrence SP1:634:20507: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0007; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:634
msgctxt "text_id=20507 | speaker=beo"
msgid "　別に目立たないと思うけどなー」"
msgstr ""

#. Occurrence SP1:645:20508: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0010; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:645
msgctxt "text_id=20508 | speaker=touko"
msgid "「色合いの問題です。アジア系は無理にしても、せめて<黒髪|ブルネット>に化けてくれれば、いくらでも誤魔化せるんだけど」"
msgstr ""

#. Occurrence SP1:678:20509: scene=SP1
#: SP1:678
msgctxt "text_id=20509 | speaker=unknown"
msgid "　しかし、その要望は叶わない。"
msgstr ""

#. Occurrence SP1:683:20510: scene=SP1
#: SP1:683
msgctxt "text_id=20510 | speaker=unknown"
msgid "　ヒト形になる事自体、カレにとってはストレスなのだ。"
msgstr ""

#. Occurrence SP1:688:20511: scene=SP1
#: SP1:688
msgctxt "text_id=20511 | speaker=unknown"
msgid "　カレからしてみれば、せめて好みのカタチになる事がギリギリの妥協点なのである。"
msgstr ""

#. Occurrence SP1:693:20512: scene=SP1
#: SP1:693
msgctxt "text_id=20512 | speaker=unknown"
msgid "　今は町から旧校舎に移動する為、やむなくヒト形に変身しているが、寝床になる教室が決まればすぐに狼のカタチに戻ってしまう。"
msgstr ""

#. Occurrence SP1:732:20513: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0011; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:732
msgctxt "text_id=20513 | speaker=touko"
msgid "「なんだってヒト形でいるのを嫌がるのかしらね。別に難しいワケじゃないんでしょう、ソレ？　もともとアストラル体みたいなものなんだから、貴方」"
msgstr ""

#. Occurrence SP1:738:20514: scene=SP1
#: SP1:738
msgctxt "text_id=20514 | speaker=unknown"
msgid "　カレの体は状況に応じて変態する。"
msgstr ""

#. Occurrence SP1:743:20515: scene=SP1
#: SP1:743
msgctxt "text_id=20515 | speaker=unknown"
msgid "　物質界で安定する為の<触媒|にくたい>を必要としない、万能の生命だ。"
msgstr ""

#. Occurrence SP1:748:20516: scene=SP1
#: SP1:748
msgctxt "text_id=20516 | speaker=unknown"
msgid "　魔術的に言えば、魂が物質化した高次生命である。"
msgstr ""

#. Occurrence SP1:783:20517: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0008; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:783
msgctxt "text_id=20517 | speaker=beo"
msgid "「そりゃあ何の力もリスクもないけど、メンドウなものはメンドウだよ。"
msgstr ""

#. Occurrence SP1:789:20518: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0009; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:789
msgctxt "text_id=20518 | speaker=beo"
msgid "　人間だって無駄なコトはしたくないでしょ？"
msgstr ""

#. Occurrence SP1:789:20519: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0009; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:789
msgctxt "text_id=20519 | speaker=beo"
msgid "　ボク、ヒト形になるコトに有利性をまったく感じないしー」"
msgstr ""

#. Occurrence SP1:813:20520: scene=SP1
#: SP1:813
msgctxt "text_id=20520 | speaker=unknown"
msgid "　カレにとって「人間の姿」とは何の価値も見いだせないものらしい。"
msgstr ""

#. Occurrence SP1:818:20521: scene=SP1
#: SP1:818
msgctxt "text_id=20521 | speaker=unknown"
msgid "　なら外見を地味にしても良かろう、と橙子は指摘したものだが、意味がない変態だからこそ、せめて“気持ちの良い”状態を優先するのだ、とカレは言った。"
msgstr ""

#. Occurrence SP1:863:20522: scene=SP1
#: SP1:863
msgctxt "text_id=20522 | speaker=unknown"
msgid "　カレにとってあのカタチはヒト形において唯一『楽しい』イメージらしく、そこから外れる事を<頑|がん>として受け入れない。"
msgstr ""

#. Occurrence SP1:868:20523: scene=SP1
#: SP1:868
msgctxt "text_id=20523 | speaker=unknown"
msgid "　結果、地方都市には場違いな、外国の貴人そのもののルックスになる。"
msgstr ""

#. Occurrence SP1:873:20524: scene=SP1
#: SP1:873
msgctxt "text_id=20524 | speaker=unknown"
msgid "　着ているコートも、注文の多いカレを納得させる為、橙子が手ずから選んだ逸品だった。"
msgstr ""

#. Occurrence SP1:916:20525: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0012; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:916
msgctxt "text_id=20525 | speaker=touko"
msgid "「じゃ、お留守番お願いねベオ君。"
msgstr ""

#. Occurrence SP1:922:20526: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0013; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:922
msgctxt "text_id=20526 | speaker=touko"
msgid "　来ないとは思うけど、もし人が来たら捕まえておいて。"
msgstr ""

#. Occurrence SP1:922:20527: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0013; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:922
msgctxt "text_id=20527 | speaker=touko"
msgid "　その際、<脚|あし>の一本ぐらいなら傷つけてもＯＫだから」"
msgstr ""

#. Occurrence SP1:934:20528: scene=SP1
#: SP1:934
msgctxt "text_id=20528 | speaker=unknown"
msgid "　物騒な言いつけを残して、橙子は町へと出かけていく。"
msgstr ""

#. Occurrence SP1:963:20529: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0010; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:963
msgctxt "text_id=20529 | speaker=beo"
msgid "「はーい、まかされましたー！"
msgstr ""

#. Occurrence SP1:969:20530: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0011; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:969
msgctxt "text_id=20530 | speaker=beo"
msgid "　だいじょうぶ、人間とかそもそも口に合わないし！"
msgstr ""

#. Occurrence SP1:975:20531: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0012; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:975
msgctxt "text_id=20531 | speaker=beo"
msgid "　こっちのコトは気にせず、あのピリピリするお土産よろしくねー！」"
msgstr ""

#. Occurrence SP1:1023:20532: scene=SP1
#: SP1:1023
msgctxt "text_id=20532 | speaker=unknown"
msgid "　雇い主を見送って、ベオはトスン、と机に着地した。"
msgstr ""

#. Occurrence SP1:1028:20533: scene=SP1
#: SP1:1028
msgctxt "text_id=20533 | speaker=unknown"
msgid "　その姿はヒトから狼の姿に変化している。"
msgstr ""

#. Occurrence SP1:1049:20534: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0013; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1049
msgctxt "text_id=20534 | speaker=beo"
msgid "「“あーあ、タイクツー。世界中をまわって、こんな田舎町が終着とかヒョウシ抜けもいいところー”」"
msgstr ""

#. Occurrence SP1:1068:20535: scene=SP1
#: SP1:1068
msgctxt "text_id=20535 | speaker=unknown"
msgid "　ベオが蒼崎橙子と出会ったのは二年前。"
msgstr ""

#. Occurrence SP1:1073:20536: scene=SP1
#: SP1:1073
msgctxt "text_id=20536 | speaker=unknown"
msgid "　人狼の里に現れた魔術師は、里の者たちと交渉の末、ベオの教育係を請け負った。"
msgstr ""

#. Occurrence SP1:1093:20537: scene=SP1
#: SP1:1093
msgctxt "text_id=20537 | speaker=unknown"
msgid "　無論、里はベオに対して何の拘束力も持ち合わせていない。最終的にベオをその気にさせたのは、里への義理ではなく、橙子への興味だった。"
msgstr ""

#. Occurrence SP1:1098:20538: scene=SP1
#: SP1:1098
msgctxt "text_id=20538 | speaker=unknown"
msgid "　橙子は洞窟で眠るソレの前に立ち、"
msgstr ""

#. Occurrence SP1:1126:20539: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0014; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1126
msgctxt "text_id=20539 | speaker=touko"
msgid "「え、生きている意味が知りたい？"
msgstr ""

#. Occurrence SP1:1132:20540: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0015; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1132
msgctxt "text_id=20540 | speaker=touko"
msgid "　なんだ。そんな事で取引が成立するとはね」"
msgstr ""

#. Occurrence SP1:1138:20541: scene=SP1
#: SP1:1138
msgctxt "text_id=20541 | speaker=unknown"
msgid "　涼しげに笑った後、その長い髪を切って拘束の<契約|くさり>にした。"
msgstr ""

#. Occurrence SP1:1170:20542: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0016; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1170
msgctxt "text_id=20542 | speaker=touko"
msgid "「自由を知るには窮屈さを知っておかないとね。"
msgstr ""

#. Occurrence SP1:1176:20543: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0017; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1176
msgctxt "text_id=20543 | speaker=touko"
msgid "　同じように、生きている意味を知りたければ、まずは死ねない<執着|こだわり>を見付けないと。"
msgstr ""

#. Occurrence SP1:1182:20544: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0018; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1182
msgctxt "text_id=20544 | speaker=touko"
msgid "　―――そうだな、例えばの話。そいつを殺すまでは、とてもじゃないが死ねないほどの憎しみとか」"
msgstr ""

#. Occurrence SP1:1202:20545: scene=SP1
#: SP1:1202
msgctxt "text_id=20545 | speaker=unknown"
msgid "　蒼崎橙子の二十年分の蓄積。"
msgstr ""

#. Occurrence SP1:1207:20546: scene=SP1
#: SP1:1207
msgctxt "text_id=20546 | speaker=unknown"
msgid "　分身とも言える髪を、彼女はあっさりと手放した。"
msgstr ""

#. Occurrence SP1:1212:20547: scene=SP1
#: SP1:1212
msgctxt "text_id=20547 | speaker=unknown"
msgid "　それだけの価値が、今まで貯めてきたものをノータイムで切り捨てられるだけの価値が、ベオにあると確信して。"
msgstr ""

#. Occurrence SP1:1246:20548: scene=SP1
#: SP1:1246
msgctxt "text_id=20548 | speaker=unknown"
msgid "　またベオも同じように、この人間が稀少な価値を持つ生き物だと嗅ぎ取っていた。"
msgstr ""

#. Occurrence SP1:1251:20549: scene=SP1
#: SP1:1251
msgctxt "text_id=20549 | speaker=unknown"
msgid "　そんな異才に認められるのはベオとて悪い気はしなかったし、何より、窮屈さを知れと言いながらも、極めて自由な女性の振るまいに関心を覚えてしまったのだ。"
msgstr ""

#. Occurrence SP1:1285:20550: scene=SP1
#: SP1:1285
msgctxt "text_id=20550 | speaker=unknown"
msgid "　そうして、"
msgstr ""

#. Occurrence SP1:1290:20551: scene=SP1
#: SP1:1290
msgctxt "text_id=20551 | speaker=unknown"
msgid "　ベオは契約の縛りを甘んじて受け入れ、里の外―――"
msgstr ""

#. Occurrence SP1:1295:20552: scene=SP1
#: SP1:1295
msgctxt "text_id=20552 | speaker=unknown"
msgid "　外の世界に足を向けた。"
msgstr ""

#. Occurrence SP1:1345:20553: scene=SP1
#: SP1:1345
msgctxt "text_id=20553 | speaker=unknown"
msgid "　まずは一年、イギリスの工房で基本的な知識を学んだ。"
msgstr ""

#. Occurrence SP1:1350:20554: scene=SP1
#: SP1:1350
msgctxt "text_id=20554 | speaker=unknown"
msgid "『時計塔』と呼ばれる魔術協会の学舎での話である。"
msgstr ""

#. Occurrence SP1:1356:20555: scene=SP1
#: SP1:1356
msgctxt "text_id=20555 | speaker=unknown"
msgid "　その頃、蒼崎橙子には専用の使い魔がいた。"
msgstr ""

#. Occurrence SP1:1361:20556: scene=SP1
#: SP1:1361
msgctxt "text_id=20556 | speaker=unknown"
msgid "　立場的にはベオの先輩というヤツである。"
msgstr ""

#. Occurrence SP1:1366:20557: scene=SP1
#: SP1:1366
msgctxt "text_id=20557 | speaker=unknown"
msgid "　ベオは一年で先輩より優れている事を証明し、橙子と共に世界を巡る旅に出かけた。"
msgstr ""

#. Occurrence SP1:1397:20558: scene=SP1
#: SP1:1397
msgctxt "text_id=20558 | speaker=unknown"
msgid "　北欧の森を走るという<魔眼収集列車|レール・ツェッペリン>。"
msgstr ""

#. Occurrence SP1:1402:20559: scene=SP1
#: SP1:1402
msgctxt "text_id=20559 | speaker=unknown"
msgid "　北海にいまなお生き続ける<巨大古代種|ムールクラーケ>。"
msgstr ""

#. Occurrence SP1:1407:20560: scene=SP1
#: SP1:1407
msgctxt "text_id=20560 | speaker=unknown"
msgid "　三角形に開いた、異界に通じる<帰らず|バミューダ>の海。"
msgstr ""

#. Occurrence SP1:1412:20561: scene=SP1
#: SP1:1412
msgctxt "text_id=20561 | speaker=unknown"
msgid "　西欧諸国に潜む、<神代連盟|エルダータイトル>を名乗る魔術師のなれの果て。"
msgstr ""

#. Occurrence SP1:1432:20562: scene=SP1
#: SP1:1432
msgctxt "text_id=20562 | speaker=unknown"
msgid "　いずれも楽しむには十分な“異常”であり、"
msgstr ""

#. Occurrence SP1:1437:20563: scene=SP1
#: SP1:1437
msgctxt "text_id=20563 | speaker=unknown"
msgid "　カレは蒼崎橙子に付いてきた判断を正しく思った。"
msgstr ""

#. Occurrence SP1:1442:20564: scene=SP1
#: SP1:1442
msgctxt "text_id=20564 | speaker=unknown"
msgid "　だって、里で眠っていた時に比べれば、少しだけ退屈しない。"
msgstr ""

#. Occurrence SP1:1484:20565: scene=SP1
#: SP1:1484
msgctxt "text_id=20565 | speaker=unknown"
msgid "　甘い蜜には、より甘い毒を。"
msgstr ""

#. Occurrence SP1:1489:20566: scene=SP1
#: SP1:1489
msgctxt "text_id=20566 | speaker=unknown"
msgid "　薬に慣れたのなら、更なる劇薬を。"
msgstr ""

#. Occurrence SP1:1494:20567: scene=SP1
#: SP1:1494
msgctxt "text_id=20567 | speaker=unknown"
msgid "　この無邪気な生き物が次の獲物を楽しみにするようになったのは、当然の流れと言える。"
msgstr ""

#. Occurrence SP1:1499:20568: scene=SP1
#: SP1:1499
msgctxt "text_id=20568 | speaker=unknown"
msgid "　その娯楽、その期待の最高峰が、蒼崎橙子の最終目的。"
msgstr ""

#. Occurrence SP1:1504:20569: scene=SP1
#: SP1:1504
msgctxt "text_id=20569 | speaker=unknown"
msgid "　自由自在な彼女をして、在るだけで許せないモノ、と言わしめた獲物である。"
msgstr ""

#. Occurrence SP1:1539:20570: scene=SP1
#: SP1:1539
msgctxt "text_id=20570 | speaker=unknown"
msgid "　新しい脅威に向かう度、ベオは橙子に問いただしたものだ。"
msgstr ""

#. Occurrence SP1:1549:20571: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0014; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1549
msgctxt "text_id=20571 | speaker=beo"
msgid "「“ねえ、これがトーコさんの殺したい相手？”」"
msgstr ""

#. Occurrence SP1:1555:20572: scene=SP1
#: SP1:1555
msgctxt "text_id=20572 | speaker=unknown"
msgid "　しかし、魔術師は口元を皮肉げにゆがめて首を横に振るばかり。"
msgstr ""

#. Occurrence SP1:1560:20573: scene=SP1
#: SP1:1560
msgctxt "text_id=20573 | speaker=unknown"
msgid "　こんな<易|やさ>しいものじゃあない、と希代の人形師は語る。"
msgstr ""

#. Occurrence SP1:1601:20574: scene=SP1
#: SP1:1601
msgctxt "text_id=20574 | speaker=unknown"
msgid "　それまで橙子とベオが倒してきた相手、"
msgstr ""

#. Occurrence SP1:1601:20575: scene=SP1
#: SP1:1601
msgctxt "text_id=20575 | speaker=unknown"
msgid "　交渉してきた相手は、カレに及ばないまでも、いずれ<人智|じんち>及ばぬ魔境たちだった。"
msgstr ""

#. Occurrence SP1:1606:20576: scene=SP1
#: SP1:1606
msgctxt "text_id=20576 | speaker=unknown"
msgid "　では、それらを向こうに回す敵とは如何ほどのモノか？"
msgstr ""

#. Occurrence SP1:1611:20577: scene=SP1
#: SP1:1611
msgctxt "text_id=20577 | speaker=unknown"
msgid "　そこまで言われては気になって仕方がない。"
msgstr ""

#. Occurrence SP1:1616:20578: scene=SP1
#: SP1:1616
msgctxt "text_id=20578 | speaker=unknown"
msgid "　やがて自分が雇われた目的が“魔法”と知り、"
msgstr ""

#. Occurrence SP1:1621:20579: scene=SP1
#: SP1:1621
msgctxt "text_id=20579 | speaker=unknown"
msgid "　それなら相手にとって不足はない、と珍しく闘志を燃やしたのだが―――"
msgstr ""

#. Occurrence SP1:1656:20580: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0015; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1656
msgctxt "text_id=20580 | speaker=beo"
msgid "「“レーセイになって考えてみると、本物が偽物を相手にするとかオトナげないかも。"
msgstr ""

#. Occurrence SP1:1656:20581: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0015; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1656
msgctxt "text_id=20581 | speaker=beo"
msgid "　魔法なんていっても、結局は人間の手によるものなんだし”」"
msgstr ""

#. Occurrence SP1:1700:20582: scene=SP1
#: SP1:1700
msgctxt "text_id=20582 | speaker=unknown"
msgid "　ソレの関心は、やはり自分に対してのみ。"
msgstr ""

#. Occurrence SP1:1706:20583: scene=SP1
#: SP1:1706
msgctxt "text_id=20583 | speaker=unknown"
msgid "　命を知らず、自由を知らず、楽しみといったら食事だけ。"
msgstr ""

#. Occurrence SP1:1712:20584: scene=SP1
#: SP1:1712
msgctxt "text_id=20584 | speaker=unknown"
msgid "　そんな自分に不満はないが、退屈である事だけはいかんともしがたい。"
msgstr ""

#. Occurrence SP1:1717:20585: scene=SP1
#: SP1:1717
msgctxt "text_id=20585 | speaker=unknown"
msgid "　それと。蒼崎橙子に同行するようになってからは、彼女に対してもよく分からない感情を持ち始めていた。"
msgstr ""

#. Occurrence SP1:1754:20586: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0016; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1754
msgctxt "text_id=20586 | speaker=beo"
msgid "「“トーコさん、あれでほんと一途だから。"
msgstr ""

#. Occurrence SP1:1760:20587: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0017; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1760
msgctxt "text_id=20587 | speaker=beo"
msgid "　何でもできるのはボクと同じなのに、何にでも一生懸命になれるのって、ちょっとヘンだよね”」"
msgstr ""

#. Occurrence SP1:1779:20588: scene=SP1
#: SP1:1779
msgctxt "text_id=20588 | speaker=unknown"
msgid "　やれやれ、と大げさに肩をすくめて<瞼|まぶた>を閉じる。"
msgstr ""

#. Occurrence SP1:1784:20589: scene=SP1
#: SP1:1784
msgctxt "text_id=20589 | speaker=unknown"
msgid "　それが<妬|ねた>みという感情である事を知らないまま、金色の狼は意識を落とした。"
msgstr ""

#. Occurrence SP1:1845:20590: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0019; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1845
msgctxt "text_id=20590 | speaker=touko"
msgid "「四年ぶりに帰ってきてみれば、住み慣れた町の面影は何処へやら、かあ。"
msgstr ""

#. Occurrence SP1:1851:20591: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0020; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1851
msgctxt "text_id=20591 | speaker=touko"
msgid "　駅前なんてもう別物だし、大手術にも程が……ああ、やっぱり<角|かど>の煙草屋さん、なくなってる。"
msgstr ""

#. Occurrence SP1:1857:20592: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0021; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1857
msgctxt "text_id=20592 | speaker=touko"
msgid "　あーあ。自動販売機で煙草を買うのにも、そろそろ慣れなくちゃいけないのかも」"
msgstr ""

#. Occurrence SP1:1891:20593: scene=SP1
#: SP1:1891
msgctxt "text_id=20593 | speaker=unknown"
msgid "　なんてグチをこぼしながら、蒼崎橙子は四年ぶりの故郷を歩く。"
msgstr ""

#. Occurrence SP1:1896:20594: scene=SP1
#: SP1:1896
msgctxt "text_id=20594 | speaker=unknown"
msgid "　その姿は<緩|ゆる>みに緩みきっていた。"
msgstr ""

#. Occurrence SP1:1901:20595: scene=SP1
#: SP1:1901
msgctxt "text_id=20595 | speaker=unknown"
msgid "　使い魔も連れておらず、"
msgstr ""

#. Occurrence SP1:1906:20596: scene=SP1
#: SP1:1906
msgctxt "text_id=20596 | speaker=unknown"
msgid "　護身用の「鞄」もアジトに置きっぱなし。"
msgstr ""

#. Occurrence SP1:1911:20597: scene=SP1
#: SP1:1911
msgctxt "text_id=20597 | speaker=unknown"
msgid "　気持ちは完全に観光気分で、緊張のキの字もない。"
msgstr ""

#. Occurrence SP1:1944:20598: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0022; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1944
msgctxt "text_id=20598 | speaker=touko"
msgid "「ここなんてあぜ道同然だったのに、今じゃ立派なストリートときた。"
msgstr ""

#. Occurrence SP1:1953:20599: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0023; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1953
msgctxt "text_id=20599 | speaker=touko"
msgid "　因果なものね。帰ってきたっていうのに、あっちに戻った時と同じ気持ちになってきた」"
msgstr ""

#. Occurrence SP1:1988:20600: scene=SP1
#: SP1:1988
msgctxt "text_id=20600 | speaker=unknown"
msgid "　橙子にとって、帰郷はこれで二度目になる。"
msgstr ""

#. Occurrence SP1:1993:20601: scene=SP1
#: SP1:1993
msgctxt "text_id=20601 | speaker=unknown"
msgid "　四年前に蒼崎家から出奔し、こうして秘密裏に戻って来たのが<二度目|こんかい>。"
msgstr ""

#. Occurrence SP1:1998:20602: scene=SP1
#: SP1:1998
msgctxt "text_id=20602 | speaker=unknown"
msgid "　一度目の帰郷はもっと前。"
msgstr ""

#. Occurrence SP1:2003:20603: scene=SP1
#: SP1:2003
msgctxt "text_id=20603 | speaker=unknown"
msgid "　十四歳の時、彼女は英国のとある学院に留学していた経歴を持つ。"
msgstr ""

#. Occurrence SP1:2049:20604: scene=SP1
#: SP1:2049
msgctxt "text_id=20604 | speaker=unknown"
msgid "　橙子は二年間あちらで学生として過ごし、日本に帰国。"
msgstr ""

#. Occurrence SP1:2054:20605: scene=SP1
#: SP1:2054
msgctxt "text_id=20605 | speaker=unknown"
msgid "　高校は地元の学校を選び、礼園女学院で三年間過ごした後、再び英国に出奔した。"
msgstr ""

#. Occurrence SP1:2059:20606: scene=SP1
#: SP1:2059
msgctxt "text_id=20606 | speaker=unknown"
msgid "　それが四年前の出来事だ。"
msgstr ""

#. Occurrence SP1:2064:20607: scene=SP1
#: SP1:2064
msgctxt "text_id=20607 | speaker=unknown"
msgid "　その時、英国の田舎町に戻った時と同じ感想を、いま橙子は抱いている。"
msgstr ""

#. Occurrence SP1:2104:20608: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0024; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2104
msgctxt "text_id=20608 | speaker=touko"
msgid "「寂しい？　んー、ちょっと違う。呆れてる……とも違うし、怖がっている、も近くて遠いような……」"
msgstr ""

#. Occurrence SP1:2110:20609: scene=SP1
#: SP1:2110
msgctxt "text_id=20609 | speaker=unknown"
msgid "　肩を丸めて考えこむ。"
msgstr ""

#. Occurrence SP1:2115:20610: scene=SP1
#: SP1:2115
msgctxt "text_id=20610 | speaker=unknown"
msgid "　背中にむずむずと湧きたつ、いまいち言語化できないざわめき。"
msgstr ""

#. Occurrence SP1:2135:20611: scene=SP1
#: SP1:2135
msgctxt "text_id=20611 | speaker=unknown"
msgid "　急激な変化を迎えた時代。あらゆるものが安価で、かつ安易に造り替えられていく風潮。"
msgstr ""

#. Occurrence SP1:2140:20612: scene=SP1
#: SP1:2140
msgctxt "text_id=20612 | speaker=unknown"
msgid "　橙子はしばし考えこんでから、そっか、と指を鳴らして足を踏み出した。"
msgstr ""

#. Occurrence SP1:2173:20613: scene=SP1
#: SP1:2173
msgctxt "text_id=20613 | speaker=unknown"
msgid "　難しく考える必要はない。"
msgstr ""

#. Occurrence SP1:2178:20614: scene=SP1
#: SP1:2178
msgctxt "text_id=20614 | speaker=unknown"
msgid "　これはただ、今がそういう時代であるだけの話。"
msgstr ""

#. Occurrence SP1:2183:20615: scene=SP1
#: SP1:2183
msgctxt "text_id=20615 | speaker=unknown"
msgid "　単に、古いものを新しいものに取り替える時期が、当然のようにやってきたのだ。"
msgstr ""

#. Occurrence SP1:2197:20616: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0025; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2197
msgctxt "text_id=20616 | speaker=touko"
msgid "「うん。つまり、私の時代ってコトだ！」"
msgstr ""

#. Occurrence SP1:2217:20617: scene=SP1
#: SP1:2217
msgctxt "text_id=20617 | speaker=unknown"
msgid "“橙子さん、やっちゃってください”"
msgstr ""

#. Occurrence SP1:2223:20618: scene=SP1
#: SP1:2223
msgctxt "text_id=20618 | speaker=unknown"
msgid "　そんなノリノリの<自|じ><己|こ><啓発|けいはつ>に背中を押されて、蒼崎橙子は意気揚々と駅に向かって歩きだした。"
msgstr ""

#. Occurrence SP1:2265:20619: scene=SP1
#: SP1:2265
msgctxt "text_id=20619 | speaker=unknown"
msgid "　大通りをずんずんと<驀進|ばくしん>する様は、トップモデルか独裁者かという迫力である。"
msgstr ""

#. Occurrence SP1:2270:20620: scene=SP1
#: SP1:2270
msgctxt "text_id=20620 | speaker=unknown"
msgid "　しかし、"
msgstr ""

#. Occurrence SP1:2270:20621: scene=SP1
#: SP1:2270
msgctxt "text_id=20621 | speaker=unknown"
msgid "『手始めに、この大通りをメチャクチャにしてやるぜー！』"
msgstr ""

#. Occurrence SP1:2275:20622: scene=SP1
#: SP1:2275
msgctxt "text_id=20622 | speaker=unknown"
msgid "　と意気込んでのコトでは、無論、ない。"
msgstr ""

#. Occurrence SP1:2295:20623: scene=SP1
#: SP1:2295
msgctxt "text_id=20623 | speaker=unknown"
msgid "　橙子とて、これからはじまる大掃除、大工事の前にセンスのない町並み……"
msgstr ""

#. Occurrence SP1:2300:20624: scene=SP1
#: SP1:2300
msgctxt "text_id=20624 | speaker=unknown"
msgid "　何の工夫も見られない、十年後には時代遅れになっているであろう大通り……"
msgstr ""

#. Occurrence SP1:2305:20625: scene=SP1
#: SP1:2305
msgctxt "text_id=20625 | speaker=unknown"
msgid "　を<更地|さらち>にしたいところではあるが、今の彼女にはその前にやらねばならぬ事があるのである。"
msgstr ""

#. Occurrence SP1:2361:20626: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0026; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2361
msgctxt "text_id=20626 | speaker=touko"
msgid "「甘い設定だ。"
msgstr ""

#. Occurrence SP1:2367:20627: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0027; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2367
msgctxt "text_id=20627 | speaker=touko"
msgid "　こんな釘のしぼりで、客を<煙|けむ>にまけると思ったか」"
msgstr ""

#. Occurrence SP1:2390:20628: scene=SP1
#: SP1:2390
msgctxt "text_id=20628 | speaker=unknown"
msgid "　橙子がまず向かった先は結界の支点ではなく、繁華街のパチンコ店だった。"
msgstr ""

#. Occurrence SP1:2395:20629: scene=SP1
#: SP1:2395
msgctxt "text_id=20629 | speaker=unknown"
msgid "　駅前は様変わりしたといっても、下町はそう変わっていない。"
msgstr ""

#. Occurrence SP1:2400:20630: scene=SP1
#: SP1:2400
msgctxt "text_id=20630 | speaker=unknown"
msgid "　橙子は昔馴染みのパチンコ店に突入するや、五千円を銀玉に両替。そのまま二階フロアにあがり、今日一番の出玉設定をしている台を見抜き、ハンドルに手を掛けた。"
msgstr ""

#. Occurrence SP1:2427:20631: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0028; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2427
msgctxt "text_id=20631 | speaker=touko"
msgid "「そろそろ打ち止めかな。ひーふーみー……千両箱が十二箱か。まあ、四年ぶりにしちゃあ上等だろう」"
msgstr ""

#. Occurrence SP1:2433:20632: scene=SP1
#: SP1:2433
msgctxt "text_id=20632 | speaker=unknown"
msgid "　台詞は冷めたものだが、口元ではちょろい、と上機嫌の<体|てい>である。"
msgstr ""

#. Occurrence SP1:2453:20633: scene=SP1
#: SP1:2453
msgctxt "text_id=20633 | speaker=unknown"
msgid "　パチンコホールは定番とも言える娯楽提供場だが、<盛|さか>んなのは日本だけで、外国ではあまり見られない。"
msgstr ""

#. Occurrence SP1:2458:20634: scene=SP1
#: SP1:2458
msgctxt "text_id=20634 | speaker=unknown"
msgid "　効率が悪い、時間がかかる、騙しあいの面白味がない、リスクとリターンがあっていない……等々の理由で、<本|・><場|・>のプレイヤーたちからは子供の遊びと敬遠されている。"
msgstr ""

#. Occurrence SP1:2492:20635: scene=SP1
#: SP1:2492
msgctxt "text_id=20635 | speaker=unknown"
msgid "　橙子の留学先でもそれは同じで、パチンコ店なぞ影も形も見あたらなかった。"
msgstr ""

#. Occurrence SP1:2497:20636: scene=SP1
#: SP1:2497
msgctxt "text_id=20636 | speaker=unknown"
msgid "　帰国した彼女が真っ先にパチンコ店に突貫したのは、五年ぶりの懐かしさから―――"
msgstr ""

#. Occurrence SP1:2502:20637: scene=SP1
#: SP1:2502
msgctxt "text_id=20637 | speaker=unknown"
msgid "　ではなく、単に、軍資金が底をつきかけた為である。"
msgstr ""

#. Occurrence SP1:2523:20638: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0029; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2523
msgctxt "text_id=20638 | speaker=touko"
msgid "「しっかし、ヘリのチャーター代だけで足が出るとは。日本は平和すぎて裏稼業の相場が高すぎるんだ、クソッ。"
msgstr ""

#. Occurrence SP1:2529:20639: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0030; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2529
msgctxt "text_id=20639 | speaker=touko"
msgid "　おかげで無一文だ。とりあえず、ベオの<食|く>い<扶|ぶ><持|ち>だけでも<稼|かせ>がにゃならん」"
msgstr ""

#. Occurrence SP1:2549:20640: scene=SP1
#: SP1:2549
msgctxt "text_id=20640 | speaker=unknown"
msgid "　旧校舎を工房に改造する為、コンテナ三台分の資材をヘリコプターで隣町にまで輸送させた。"
msgstr ""

#. Occurrence SP1:2554:20641: scene=SP1
#: SP1:2554
msgctxt "text_id=20641 | speaker=unknown"
msgid "　山奥である旧校舎にはトラックを走らせるだけの道がなく、結果、橙子の貯金はすっからかんになってしまったのだ。"
msgstr ""

#. Occurrence SP1:2582:20642: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0031; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2582
msgctxt "text_id=20642 | speaker=touko"
msgid "「お、スリーセブン。コイツは本格的におしまいかな。"
msgstr ""

#. Occurrence SP1:2594:20643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0032; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2594
msgctxt "text_id=20643 | speaker=touko"
msgid "　まったく。こういう、どうでもいいゲームだけは星の巡りがいいときている」"
msgstr ""

#. Occurrence SP1:2600:20644: scene=SP1
#: SP1:2600
msgctxt "text_id=20644 | speaker=unknown"
msgid "　文句をいいつつ、口元はやはり上機嫌だ。"
msgstr ""

#. Occurrence SP1:2605:20645: scene=SP1
#: SP1:2605
msgctxt "text_id=20645 | speaker=unknown"
msgid "　片手はハンドル、片手は安い煙草、気ままに足を組んでパチンコ店を荒らすのも、まんざらでもない橙子だった。"
msgstr ""

#. Occurrence SP1:2672:20646: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0033; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2672
msgctxt "text_id=20646 | speaker=touko"
msgid "「？」"
msgstr ""

#. Occurrence SP1:2678:20647: scene=SP1
#: SP1:2678
msgctxt "text_id=20647 | speaker=unknown"
msgid "　視界の<隅|すみ>で何かが固まっている気配を察して、メガネをかける。"
msgstr ""

#. Occurrence SP1:2683:20648: scene=SP1
#: SP1:2683
msgctxt "text_id=20648 | speaker=unknown"
msgid "　妙な物音に橙子が視線を向けると、そこには顔面蒼白の店員の姿があった。"
msgstr ""

#. Occurrence SP1:2688:20649: scene=SP1
#: SP1:2688
msgctxt "text_id=20649 | speaker=unknown"
msgid "　まだ高校生にしか見えない、童顔の店員である。"
msgstr ""

#. Occurrence SP1:2743:20650: scene=SP1
#: SP1:2743
msgctxt "text_id=20650 | speaker=unknown"
msgid "　何があったのか、店員は橙子を見るなり硬直し、その後、あたふたと走り去った。"
msgstr ""

#. Occurrence SP1:2748:20651: scene=SP1
#: SP1:2748
msgctxt "text_id=20651 | speaker=unknown"
msgid "　というか、逃げだしていった。"
msgstr ""

#. Occurrence SP1:2777:20652: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0034; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2777
msgctxt "text_id=20652 | speaker=touko"
msgid "「……む。私、そんなに引く感じ？」"
msgstr ""

#. Occurrence SP1:2783:20653: scene=SP1
#: SP1:2783
msgctxt "text_id=20653 | speaker=unknown"
msgid "　橙子とて年頃の女性である。"
msgstr ""

#. Occurrence SP1:2788:20654: scene=SP1
#: SP1:2788
msgctxt "text_id=20654 | speaker=unknown"
msgid "　見つめられたり声をかけられたりするのは正直面倒だが、それにしても、一目散に逃げられる、というのはあんまりではなかろうか、と唇をとがらせる。"
msgstr ""

#. Occurrence SP1:2793:20655: scene=SP1
#: SP1:2793
msgctxt "text_id=20655 | speaker=unknown"
msgid "　あの高校生……今度見かけたら脅かしてやろう、と心のチェックリストに書き込みつつ、橙子はゲームを再開した。"
msgstr ""

#. Occurrence SP1:2839:20656: scene=SP1
#: SP1:2839
msgctxt "text_id=20656 | speaker=unknown"
msgid "　大量の景品を抱えてパチンコ店を後にする。"
msgstr ""

#. Occurrence SP1:2844:20657: scene=SP1
#: SP1:2844
msgctxt "text_id=20657 | speaker=unknown"
msgid "　せっかくの大勝ちなのだが、最後の出来事のおかげで素直に喜べない。"
msgstr ""

#. Occurrence SP1:2878:20658: scene=SP1
#: SP1:2878
msgctxt "text_id=20658 | speaker=unknown"
msgid "　橙子はなんだかなー、と頭を掻きつつ、店の裏手にある換金所に足を向け、"
msgstr ""

#. Occurrence SP1:2885:20659: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0000; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:2885
msgctxt "text_id=20659 | speaker=eiri"
msgid "「おや、橙子さんじゃないですか」"
msgstr ""

#. Occurrence SP1:2891:20660: scene=SP1
#: SP1:2891
msgctxt "text_id=20660 | speaker=unknown"
msgid "　四年ぶりに聞く、思い出深い声に呼び止められた。"
msgstr ""

#. Occurrence SP1:2944:20661: scene=SP1
#: SP1:2944
msgctxt "text_id=20661 | speaker=unknown"
msgid "　ピン、と眠っていたベオの耳が立つ。"
msgstr ""

#. Occurrence SP1:2949:20662: scene=SP1
#: SP1:2949
msgctxt "text_id=20662 | speaker=unknown"
msgid "　時刻は日没前。"
msgstr ""

#. Occurrence SP1:2954:20663: scene=SP1
#: SP1:2954
msgctxt "text_id=20663 | speaker=unknown"
msgid "　嗅ぎ慣れた匂いが近づいてくるのを察して、カレは大きな<欠伸|あくび>と共に目を覚ました。"
msgstr ""

#. Occurrence SP1:3002:20664: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0018; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3002
msgctxt "text_id=20664 | speaker=beo"
msgid "「んー、よっと」"
msgstr ""

#. Occurrence SP1:3010:20665: scene=SP1
#: SP1:3010
msgctxt "text_id=20665 | speaker=unknown"
msgid "　ベオは机から床に飛び降り、ヒト形に変化する。"
msgstr ""

#. Occurrence SP1:3015:20666: scene=SP1
#: SP1:3015
msgctxt "text_id=20666 | speaker=unknown"
msgid "　<仮初|かりそ>めの主従関係ではあるが、留守番役として、出迎えぐらいはきっちりとこなす気らしい。"
msgstr ""

#. Occurrence SP1:3065:20667: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0019; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3065
msgctxt "text_id=20667 | speaker=beo"
msgid "「あれ？」"
msgstr ""

#. Occurrence SP1:3085:20668: scene=SP1
#: SP1:3085
msgctxt "text_id=20668 | speaker=unknown"
msgid "　廊下で顔を会わすなり、ベオは違和感に顔をしかめた。"
msgstr ""

#. Occurrence SP1:3090:20669: scene=SP1
#: SP1:3090
msgctxt "text_id=20669 | speaker=unknown"
msgid "　嗅ぎ慣れたはずの匂いに、なにか、余分な厚みが混じっている気がしたからだ。"
msgstr ""

#. Occurrence SP1:3122:20670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0035; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3122
msgctxt "text_id=20670 | speaker=touko"
msgid "「ただいまベオくん。"
msgstr ""

#. Occurrence SP1:3122:20671: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0035; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3122
msgctxt "text_id=20671 | speaker=touko"
msgid "　はい、真面目にお留守番していたお土産」"
msgstr ""

#. Occurrence SP1:3129:20672: scene=SP1
#: SP1:3129
msgctxt "text_id=20672 | speaker=unknown"
msgid "　橙子は手にした紙袋をベオに手渡す。"
msgstr ""

#. Occurrence SP1:3134:20673: scene=SP1
#: SP1:3134
msgctxt "text_id=20673 | speaker=unknown"
msgid "　ハンバーガーのたっぷり詰まった紙袋を受け取って、カレは喜びながら、やっぱりおかしい、と首を傾げた。"
msgstr ""

#. Occurrence SP1:3170:20674: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0036; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3170
msgctxt "text_id=20674 | speaker=touko"
msgid "「どうしたの、浮かない顔して。留守中、何かあった？」"
msgstr ""

#. Occurrence SP1:3176:20675: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0020; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3176
msgctxt "text_id=20675 | speaker=beo"
msgid "「いや、思わず寝ちゃうぐらい何もなかったけど……トーコさんの方こそ何かあった？"
msgstr ""

#. Occurrence SP1:3182:20676: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0021; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3182
msgctxt "text_id=20676 | speaker=beo"
msgid "　なんか元気ないし。妙に疲れてるし。なにより、ちゃんとボクの好きなお店のハンバーガー、買ってきてるし」"
msgstr ""

#. Occurrence SP1:3209:20677: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0037; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3209
msgctxt "text_id=20677 | speaker=touko"
msgid "「え、そう？　別に、何もなかったけど？」"
msgstr ""

#. Occurrence SP1:3243:20678: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0022; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3243
msgctxt "text_id=20678 | speaker=beo"
msgid "「………………」"
msgstr ""

#. Occurrence SP1:3248:20679: scene=SP1
#: SP1:3248
msgctxt "text_id=20679 | speaker=unknown"
msgid "　怪しい。怪しいコトこの上ない。"
msgstr ""

#. Occurrence SP1:3253:20680: scene=SP1
#: SP1:3253
msgctxt "text_id=20680 | speaker=unknown"
msgid "　ベオの不満点の一つとして、橙子の食事への<拘|こだわ>りの無さがあげられる。"
msgstr ""

#. Occurrence SP1:3258:20681: scene=SP1
#: SP1:3258
msgctxt "text_id=20681 | speaker=unknown"
msgid "　ハンバーガーなんてどこでも一緒だろう、とのたまう橙子は、どうでもいい店で買い物を済ませてしまうのだ。"
msgstr ""

#. Occurrence SP1:3263:20682: scene=SP1
#: SP1:3263
msgctxt "text_id=20682 | speaker=unknown"
msgid "　そんな橙子が、日本ではまだ店舗の少ないロッテリャーでハンバーガーを買ってきてくれるなぞ百回に一回あるかないか。加えて、"
msgstr ""

#. Occurrence SP1:3298:20683: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0038; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3298
msgctxt "text_id=20683 | speaker=touko"
msgid "「い、いいじゃない、"
msgstr ""

#. Occurrence SP1:3298:20684: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0038; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3298
msgctxt "text_id=20684 | speaker=touko"
msgid "　ちゃんと好きなお店のバーガーを買ってきたんだからっ」"
msgstr ""

#. Occurrence SP1:3324:20685: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0039; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3324
msgctxt "text_id=20685 | speaker=touko"
msgid "「これは私なりの、ベオくんへの感謝の気持ち。"
msgstr ""

#. Occurrence SP1:3330:20686: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0040; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3330
msgctxt "text_id=20686 | speaker=touko"
msgid "　今まで色々連れ回したけど、これからもよろしくね」"
msgstr ""

#. Occurrence SP1:3336:20687: scene=SP1
#: SP1:3336
msgctxt "text_id=20687 | speaker=unknown"
msgid "　この愛想笑いである。"
msgstr ""

#. Occurrence SP1:3341:20688: scene=SP1
#: SP1:3341
msgctxt "text_id=20688 | speaker=unknown"
msgid "　使い魔の人権なんて考えたコトもない蒼崎橙子がこんなコトを言いだしたら、三咲町に放たれた数十体の人形たちはロジックエラーの末、自爆して果てるだろう。"
msgstr ""

#. Occurrence SP1:3381:20689: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0023; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3381
msgctxt "text_id=20689 | speaker=beo"
msgid "「<胡散|うさん>くさい、<芝居|しばい>くさい、<抹香|まっこう>くさい！"
msgstr ""

#. Occurrence SP1:3387:20690: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0024; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3387
msgctxt "text_id=20690 | speaker=beo"
msgid "　優しいトーコさんなんてトーコさんじゃない！"
msgstr ""

#. Occurrence SP1:3400:20691: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0025; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3400
msgctxt "text_id=20691 | speaker=beo"
msgid "　いっつも周りを恨んでいて、文句ばっかり言って、幸せそうなヒトたちをメチャクチャにしたいんだけど大義名分がないから我慢してる……そんな、理性のおかげでかろうじて性格破綻者を<免|まぬが>れてるトーコさんはどこいったのさ？」"
msgstr ""

#. Occurrence SP1:3434:20692: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0041; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3434
msgctxt "text_id=20692 | speaker=touko"
msgid "「失礼しちゃうなあ。私だって、たまには優しくなる時ぐらいあるんだから。"
msgstr ""

#. Occurrence SP1:3440:20693: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0042; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3440
msgctxt "text_id=20693 | speaker=touko"
msgid "　ほら、四年ぶりに故郷に帰ってきたのよ？　ベオくんだって里に帰ったら、ちょっとぐらいホッとするでしょ？"
msgstr ""

#. Occurrence SP1:3446:20694: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0043; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3446
msgctxt "text_id=20694 | speaker=touko"
msgid "　それと同じ。私だって、ホームシックになる程度の可愛らしさはあるんです」"
msgstr ""

#. Occurrence SP1:3467:20695: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0026; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3467
msgctxt "text_id=20695 | speaker=beo"
msgid "「すっごい嘘。月が涙を流すぐらい嘘！」"
msgstr ""

#. Occurrence SP1:3473:20696: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0044; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3473
msgctxt "text_id=20696 | speaker=touko"
msgid "「ホントですぅ～！"
msgstr ""

#. Occurrence SP1:3479:20697: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0045; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3479
msgctxt "text_id=20697 | speaker=touko"
msgid "　もぅ、ベオくんそれ返して！　罰として夕食抜き！」"
msgstr ""

#. Occurrence SP1:3528:20698: scene=SP1
#: SP1:3528
msgctxt "text_id=20698 | speaker=unknown"
msgid "　紙袋を取り返そうとする橙子を<躱|かわ>して、ベオは窓の外に飛び出した。"
msgstr ""

#. Occurrence SP1:3533:20699: scene=SP1
#: SP1:3533
msgctxt "text_id=20699 | speaker=unknown"
msgid "　そのまま器用に壁を蹴って、旧校舎の屋根まで退避する。"
msgstr ""

#. Occurrence SP1:3554:20700: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0027; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3554
msgctxt "text_id=20700 | speaker=beo"
msgid "「なんだい。ほーんと、つまんない！"
msgstr ""

#. Occurrence SP1:3560:20701: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0028; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3560
msgctxt "text_id=20701 | speaker=beo"
msgid "　言い訳するトーコさんとか、ボク、見たくない！」"
msgstr ""

#. Occurrence SP1:3587:20702: scene=SP1
#: SP1:3587
msgctxt "text_id=20702 | speaker=unknown"
msgid "　紙袋からハンバーガーを取り出し、ぱくりとかぶりつく。"
msgstr ""

#. Occurrence SP1:3607:20703: scene=SP1
#: SP1:3607
msgctxt "text_id=20703 | speaker=unknown"
msgid "　……しかし。"
msgstr ""

#. Occurrence SP1:3612:20704: scene=SP1
#: SP1:3612
msgctxt "text_id=20704 | speaker=unknown"
msgid "　芝居くさい、とは言ったが、橙子が普段より穏やかだったのは事実だった。"
msgstr ""

#. Occurrence SP1:3617:20705: scene=SP1
#: SP1:3617
msgctxt "text_id=20705 | speaker=unknown"
msgid "　なぜそうなのかは分からないが、先ほどの橙子には特別な……というか、今までベオには見せなかった……感情があったようだ。"
msgstr ""

#. Occurrence SP1:3638:20706: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0029; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3638
msgctxt "text_id=20706 | speaker=beo"
msgid "「……なんだろ、あの匂い。"
msgstr ""

#. Occurrence SP1:3644:20707: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0030; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3644
msgctxt "text_id=20707 | speaker=beo"
msgid "　妙にふわふわしてて、うっとうしくて―――」"
msgstr ""

#. Occurrence SP1:3650:20708: scene=SP1
#: SP1:3650
msgctxt "text_id=20708 | speaker=unknown"
msgid "　あれがどんな感情なのか、ベオには分からない。"
msgstr ""

#. Occurrence SP1:3655:20709: scene=SP1
#: SP1:3655
msgctxt "text_id=20709 | speaker=unknown"
msgid "　好きと嫌い、美味しいと不味いしか知らないカレには、まだそういう<機|き><微|び>が分からない。"
msgstr ""

#. Occurrence SP1:3692:20710: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0031; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3692
msgctxt "text_id=20710 | speaker=beo"
msgid "「ま、いいけど。ボクには関係ないし。トーコさんも、明日になればいつものトーコさんだろうし」"
msgstr ""

#. Occurrence SP1:3698:20711: scene=SP1
#: SP1:3698
msgctxt "text_id=20711 | speaker=unknown"
msgid "　不満げにぼやきながら、パクパクとハンバーガーを消費していく。"
msgstr ""

#. Occurrence SP1:3703:20712: scene=SP1
#: SP1:3703
msgctxt "text_id=20712 | speaker=unknown"
msgid "　……正直なところ。"
msgstr ""

#. Occurrence SP1:3708:20713: scene=SP1
#: SP1:3708
msgctxt "text_id=20713 | speaker=unknown"
msgid "　分かりたいとは思わないが、未知があるコトに、ちょっとだけ不満なベオだった。"
msgstr ""

#. Occurrence SP1:3769:20714: scene=SP1
#: SP1:3769
msgctxt "text_id=20714 | speaker=unknown"
msgid "　それから何日か経過した。"
msgstr ""

#. Occurrence SP1:3774:20715: scene=SP1
#: SP1:3774
msgctxt "text_id=20715 | speaker=unknown"
msgid "　旧校舎の改造は人知れず進んでいく。"
msgstr ""

#. Occurrence SP1:3779:20716: scene=SP1
#: SP1:3779
msgctxt "text_id=20716 | speaker=unknown"
msgid "　あと一ヶ月近くここで待機、と言いつけられたベオは退屈で仕方がない。"
msgstr ""

#. Occurrence SP1:3784:20717: scene=SP1
#: SP1:3784
msgctxt "text_id=20717 | speaker=unknown"
msgid "　日々とじこもって肉を食べているだけでは、心も体も<鈍|にぶ>るというもの。"
msgstr ""

#. Occurrence SP1:3789:20718: scene=SP1
#: SP1:3789
msgctxt "text_id=20718 | speaker=unknown"
msgid "　一方、"
msgstr ""

#. Occurrence SP1:3833:20719: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0046; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3833
msgctxt "text_id=20719 | speaker=touko"
msgid "「買い出しに出てくるから、後はよろしくねー」"
msgstr ""

#. Occurrence SP1:3864:20720: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0047; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3864
msgctxt "text_id=20720 | speaker=touko"
msgid "「元気してた？　はい、お土産のローストビーフ！」"
msgstr ""

#. Occurrence SP1:3893:20721: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0048; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3893
msgctxt "text_id=20721 | speaker=touko"
msgid "「いってきまーす。屋上の機材、片づけておいてね～」"
msgstr ""

#. Occurrence SP1:3933:20722: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0049; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3933
msgctxt "text_id=20722 | speaker=touko"
msgid "「ただいまー。今日もお留守番、ご苦労さま"
msgstr ""

#. Occurrence SP1:3933:20723: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0049; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3933
msgctxt "text_id=20723 | speaker=touko"
msgid "」"
msgstr ""

#. Occurrence SP1:3965:20724: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0050; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3965
msgctxt "text_id=20724 | speaker=touko"
msgid "「よし、行ってくるでござる」"
msgstr ""

#. Occurrence SP1:3995:20725: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0051; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3995
msgctxt "text_id=20725 | speaker=touko"
msgid "「おつかれー！　え、お酒くさい？　ばっか、酔ってなんかないですぅー。もーぜんぜん酔ってなんかないもーん」"
msgstr ""

#. Occurrence SP1:4015:20726: scene=SP1
#: SP1:4015
msgctxt "text_id=20726 | speaker=unknown"
msgid "　このように。"
msgstr ""

#. Occurrence SP1:4020:20727: scene=SP1
#: SP1:4020
msgctxt "text_id=20727 | speaker=unknown"
msgid "　自宅警備中のカレとは対照的に、魔術師は実に行動的、かつ上機嫌だった。"
msgstr ""

#. Occurrence SP1:4025:20728: scene=SP1
#: SP1:4025
msgctxt "text_id=20728 | speaker=unknown"
msgid "　着々と要塞化していく<臨時工房|アジト>の出来に、よほど満足しているらしい。"
msgstr ""

#. Occurrence SP1:4071:20729: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0032; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4071
msgctxt "text_id=20729 | speaker=beo"
msgid "「ちがう。もー、ぜぇっっっったいちがう。"
msgstr ""

#. Occurrence SP1:4077:20730: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0033; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4077
msgctxt "text_id=20730 | speaker=beo"
msgid "　そんなんでトーコさんの機嫌はよくなんないし。"
msgstr ""

#. Occurrence SP1:4083:20731: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0034; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4083
msgctxt "text_id=20731 | speaker=beo"
msgid "　<旧校舎|こ　こ>に関しちゃグチグチ不満ばっかりこぼしてるし。"
msgstr ""

#. Occurrence SP1:4089:20732: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0035; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4089
msgctxt "text_id=20732 | speaker=beo"
msgid "　何より、ござるとかバカっぽいコト言わないし」"
msgstr ""

#. Occurrence SP1:4116:20733: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0052; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4116
msgctxt "text_id=20733 | speaker=touko"
msgid "「うん？　どうしたのベオくん。すっごく不細工な顔してるけど。そろそろ暴れたくて仕方がない？」"
msgstr ""

#. Occurrence SP1:4151:20734: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0036; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4151
msgctxt "text_id=20734 | speaker=beo"
msgid "「そういうモンダイじゃありませーん。"
msgstr ""

#. Occurrence SP1:4157:20735: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0037; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4157
msgctxt "text_id=20735 | speaker=beo"
msgid "　……まあそりゃ、早く本命とやらと戦ってみたいけど、もうちょっと先なんでしょ。ならガマンする。トーコさんの言葉は今のところハズレないから、おとなしく従います。"
msgstr ""

#. Occurrence SP1:4163:20736: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0038; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4163
msgctxt "text_id=20736 | speaker=beo"
msgid "　けど―――」"
msgstr ""

#. Occurrence SP1:4169:20737: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0053; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4169
msgctxt "text_id=20737 | speaker=touko"
msgid "「けど？」"
msgstr ""

#. Occurrence SP1:4195:20738: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0039; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4195
msgctxt "text_id=20738 | speaker=beo"
msgid "「なんかヘン。いつも下準備の時はこれぐらいヒマだけど、緊張感がない。"
msgstr ""

#. Occurrence SP1:4201:20739: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0040; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4201
msgctxt "text_id=20739 | speaker=beo"
msgid "　毎日食べて寝て食べて寝てじゃ<肥|ふと>るー。ぶくぶくに<肥|ふと>るよー。そんなのカッコヨクないよー」"
msgstr ""

#. Occurrence SP1:4237:20740: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0054; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4237
msgctxt "text_id=20740 | speaker=touko"
msgid "「なに言ってるんだか。ベオくんにそんな心配は無用でしょう。<排泄|はいせつ>もしないクセに、まともな生き物ぶってるんじゃありません」"
msgstr ""

#. Occurrence SP1:4243:20741: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0041; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4243
msgctxt "text_id=20741 | speaker=beo"
msgid "「うん。だから、おもにトーコさんが。ブクブクに」"
msgstr ""

#. Occurrence SP1:4270:20742: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0055; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4270
msgctxt "text_id=20742 | speaker=touko"
msgid "「ベオくん、それホント！？"
msgstr ""

#. Occurrence SP1:4276:20743: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0056; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4276
msgctxt "text_id=20743 | speaker=touko"
msgid "　数値は変わってない筈だけど、なんかこう、アストラル的に増えちゃったりしてる！？」"
msgstr ""

#. Occurrence SP1:4319:20744: scene=SP1
#: SP1:4319
msgctxt "text_id=20744 | speaker=unknown"
msgid "　これである。"
msgstr ""

#. Occurrence SP1:4324:20745: scene=SP1
#: SP1:4324
msgctxt "text_id=20745 | speaker=unknown"
msgid "　ベオの目の確かさを知っている魔術師は、体重計よりカレの鑑識眼を信じたらしい。"
msgstr ""

#. Occurrence SP1:4329:20746: scene=SP1
#: SP1:4329
msgctxt "text_id=20746 | speaker=unknown"
msgid "　いつもの橙子ならメガネを外し、"
msgstr ""

#. Occurrence SP1:4363:20747: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0057; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4363
msgctxt "text_id=20747 | speaker=touko"
msgid "「唐突だが、特攻兵器の有用性を確認したくなった。"
msgstr ""

#. Occurrence SP1:4374:20748: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0058; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4374
msgctxt "text_id=20748 | speaker=touko"
msgid "　ああいや、意見は聞いていない。さあベオ、この首輪をつけてみろ。思いっきりハイに飛べるぞ」"
msgstr ""

#. Occurrence SP1:4380:20749: scene=SP1
#: SP1:4380
msgctxt "text_id=20749 | speaker=unknown"
msgid "　ぐらいは本気で実行してくるだろうに、<肥|にぶ>っているにも程がある。"
msgstr ""

#. Occurrence SP1:4431:20750: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0042; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4431
msgctxt "text_id=20750 | speaker=beo"
msgid "「……別に<増|ふ>えてないよ。"
msgstr ""

#. Occurrence SP1:4437:20751: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0043; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4437
msgctxt "text_id=20751 | speaker=beo"
msgid "　昨日とちょっとの上下差はあるけど、そんなの人間なら当たり前だし。いちいち本気にするとか、見苦しいからやめてほしい」"
msgstr ""

#. Occurrence SP1:4471:20752: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0059; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4471
msgctxt "text_id=20752 | speaker=touko"
msgid "「本当？"
msgstr ""

#. Occurrence SP1:4477:20753: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0060; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4477
msgctxt "text_id=20753 | speaker=touko"
msgid "　こう、後でボテっとくるような気配とか、ない？」"
msgstr ""

#. Occurrence SP1:4483:20754: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0044; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4483
msgctxt "text_id=20754 | speaker=beo"
msgid "「ないってば。昨日摂った栄養分はきれいに分配されてるし。いつも通りのトーコさんだよ」"
msgstr ""

#. Occurrence SP1:4516:20755: scene=SP1
#: SP1:4516
msgctxt "text_id=20755 | speaker=unknown"
msgid "　それは嘘だ。"
msgstr ""

#. Occurrence SP1:4521:20756: scene=SP1
#: SP1:4521
msgctxt "text_id=20756 | speaker=unknown"
msgid "　厳密に言えば、橙子はベオの知る“いつも通り”ではない。"
msgstr ""

#. Occurrence SP1:4526:20757: scene=SP1
#: SP1:4526
msgctxt "text_id=20757 | speaker=unknown"
msgid "　肉体面では寸分変わらぬ彼女でも、数日前から妙な違和感が付きまとっている。"
msgstr ""

#. Occurrence SP1:4546:20758: scene=SP1
#: SP1:4546
msgctxt "text_id=20758 | speaker=unknown"
msgid "　あの、妙に<浮|う>わ<浮|う>わした匂い。"
msgstr ""

#. Occurrence SP1:4551:20759: scene=SP1
#: SP1:4551
msgctxt "text_id=20759 | speaker=unknown"
msgid "　野生の獣にしか嗅ぎ取れない変化だが、それは日に日に増していっている。"
msgstr ""

#. Occurrence SP1:4556:20760: scene=SP1
#: SP1:4556
msgctxt "text_id=20760 | speaker=unknown"
msgid "　カレが不機嫌なのは、あの匂いが“どんな味”なのか、まったく見当がつかないからだった。"
msgstr ""

#. Occurrence SP1:4587:20761: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0061; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4587
msgctxt "text_id=20761 | speaker=touko"
msgid "「それなら安心安心、と。"
msgstr ""

#. Occurrence SP1:4601:20762: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0062; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4601
msgctxt "text_id=20762 | speaker=touko"
msgid "　私は出かけてくるから、お留守番よろしくね～！」"
msgstr ""

#. Occurrence SP1:4613:20763: scene=SP1
#: SP1:4613
msgctxt "text_id=20763 | speaker=unknown"
msgid "　ベオの不機嫌さに気付かず、橙子は緩みきった足取りで旧校舎を後にした。"
msgstr ""

#. Occurrence SP1:4618:20764: scene=SP1
#: SP1:4618
msgctxt "text_id=20764 | speaker=unknown"
msgid "　ここ数日、ずっとこれの繰り返しである。"
msgstr ""

#. Occurrence SP1:4660:20765: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0045; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4660
msgctxt "text_id=20765 | speaker=beo"
msgid "「………………」"
msgstr ""

#. Occurrence SP1:4665:20766: scene=SP1
#: SP1:4665
msgctxt "text_id=20766 | speaker=unknown"
msgid "　窓硝子に映った自分の姿を見て、ベオはしばし思案した。"
msgstr ""

#. Occurrence SP1:4670:20767: scene=SP1
#: SP1:4670
msgctxt "text_id=20767 | speaker=unknown"
msgid "　これでは何の解決にもならない。"
msgstr ""

#. Occurrence SP1:4675:20768: scene=SP1
#: SP1:4675
msgctxt "text_id=20768 | speaker=unknown"
msgid "　雇い主の様子がおかしいのはタダさねばならないし、"
msgstr ""

#. Occurrence SP1:4680:20769: scene=SP1
#: SP1:4680
msgctxt "text_id=20769 | speaker=unknown"
msgid "　胸に湧いたこのモヤモヤも晴らさないと楽しくない。"
msgstr ""

#. Occurrence SP1:4715:20770: scene=SP1
#: SP1:4715
msgctxt "text_id=20770 | speaker=unknown"
msgid "　金色の生き物は仕方あるまい、と鹿爪らしく頷いて、"
msgstr ""

#. Occurrence SP1:4722:20771: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0046; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4722
msgctxt "text_id=20771 | speaker=beo"
msgid "「よし。トーコさんを尾行しよう」"
msgstr ""

#. Occurrence SP1:4728:20772: scene=SP1
#: SP1:4728
msgctxt "text_id=20772 | speaker=unknown"
msgid "　今日一日だけ、自分の信条を<隅|すみ>に追いやるコトにした。"
msgstr ""

#. Occurrence SP1:4790:20773: scene=SP1
#: SP1:4790
msgctxt "text_id=20773 | speaker=unknown"
msgid "“今年の冬の寒さは、例年より厳しくなるらしい。”"
msgstr ""

#. Occurrence SP1:4795:20774: scene=SP1
#: SP1:4795
msgctxt "text_id=20774 | speaker=unknown"
msgid "“衣食住の備えは万全に。”"
msgstr ""

#. Occurrence SP1:4800:20775: scene=SP1
#: SP1:4800
msgctxt "text_id=20775 | speaker=unknown"
msgid "“僕らに衣は関係ないけど、残り二つは大切だよ。”"
msgstr ""

#. Occurrence SP1:4806:20776: scene=SP1
#: SP1:4806
msgctxt "text_id=20776 | speaker=unknown"
msgid "　そんな世間話を聞きながら、カレは三咲町を横断する。"
msgstr ""

#. Occurrence SP1:4835:20777: scene=SP1
#: SP1:4835
msgctxt "text_id=20777 | speaker=unknown"
msgid "　平日の午後一時過ぎ。"
msgstr ""

#. Occurrence SP1:4840:20778: scene=SP1
#: SP1:4840
msgctxt "text_id=20778 | speaker=unknown"
msgid "　会社員は昼休みを終えてオフィスビルへ、学生たちはまだ学校で授業中だ。"
msgstr ""

#. Occurrence SP1:4845:20779: scene=SP1
#: SP1:4845
msgctxt "text_id=20779 | speaker=unknown"
msgid "　人混みは主婦が中心で、大通りはどことなくまったりとした雰囲気だった。"
msgstr ""

#. Occurrence SP1:4878:20780: scene=SP1
#: SP1:4878
msgctxt "text_id=20780 | speaker=unknown"
msgid "　そんな穏やかな世界に、不穏な異分子がひとり。"
msgstr ""

#. Occurrence SP1:4883:20781: scene=SP1
#: SP1:4883
msgctxt "text_id=20781 | speaker=unknown"
msgid "　買い物中の奥さま方、売店の店員、外回りのサラリーマン等から様々な視線を浴びながら、蒼崎橙子はどこ吹く風で大通りを闊歩する。"
msgstr ""

#. Occurrence SP1:4888:20782: scene=SP1
#: SP1:4888
msgctxt "text_id=20782 | speaker=unknown"
msgid "　目立つ服装はもとより、彼女本人の“姿勢の強さ”が人目を惹くのだろう。"
msgstr ""

#. Occurrence SP1:4893:20783: scene=SP1
#: SP1:4893
msgctxt "text_id=20783 | speaker=unknown"
msgid "　俗に言う、モデル歩きというヤツである。"
msgstr ""

#. Occurrence SP1:4934:20784: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0047; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4934
msgctxt "text_id=20784 | speaker=beo"
msgid "「“……人には目立つなって言うクセに、本人はアレだもんなあ。潜伏期間中、相手に見つかるのはボクだけのせいじゃないと思う……”」"
msgstr ""

#. Occurrence SP1:4940:20785: scene=SP1
#: SP1:4940
msgctxt "text_id=20785 | speaker=unknown"
msgid "　なんて、言いたいコトをぐっと堪えながらカレは雇い主の後方、十メートルの位置をキープする。"
msgstr ""

#. Occurrence SP1:4963:20786: scene=SP1
#: SP1:4963
msgctxt "text_id=20786 | speaker=unknown"
msgid "　橙子本人の名誉の為に注釈しておくと、彼女とて自分がどれほど目立つか理解している。"
msgstr ""

#. Occurrence SP1:4968:20787: scene=SP1
#: SP1:4968
msgctxt "text_id=20787 | speaker=unknown"
msgid "　今は人通りの少ない時間帯なのですっぴんだが、学生や社会人が多くなる時間帯では視線よけのルーンを刻んだ<装飾|アクセ>できらびやかさを四割ほど落としているのだ。"
msgstr ""

#. Occurrence SP1:5002:20788: scene=SP1
#: SP1:5002
msgctxt "text_id=20788 | speaker=unknown"
msgid "　蒼崎橙子は商店街でいくつか買い物を済ませた後、住宅地に向かった。"
msgstr ""

#. Occurrence SP1:5007:20789: scene=SP1
#: SP1:5007
msgctxt "text_id=20789 | speaker=unknown"
msgid "　彼女は何の変哲もない一般家屋を訪問した。"
msgstr ""

#. Occurrence SP1:5012:20790: scene=SP1
#: SP1:5012
msgctxt "text_id=20790 | speaker=unknown"
msgid "　ベルを押し、「蒼崎橙子です」と告げると、門は静かに開かれた。"
msgstr ""

#. Occurrence SP1:5017:20791: scene=SP1
#: SP1:5017
msgctxt "text_id=20791 | speaker=unknown"
msgid "　どうも、商店街の買い物はこの家への土産であるらしい。"
msgstr ""

#. Occurrence SP1:5050:20792: scene=SP1
#: SP1:5050
msgctxt "text_id=20792 | speaker=unknown"
msgid "　表札には<浅葱|あさぎ>とある。"
msgstr ""

#. Occurrence SP1:5055:20793: scene=SP1
#: SP1:5055
msgctxt "text_id=20793 | speaker=unknown"
msgid "　ふと、<潮|しお>の匂いがする、とカレは感じ取ったが、三咲町は山間の街だ。"
msgstr ""

#. Occurrence SP1:5060:20794: scene=SP1
#: SP1:5060
msgctxt "text_id=20794 | speaker=unknown"
msgid "　こんなところに潮の匂いが在るのはおかしい、何か別の匂いだろう、とカレは忘れるコトにした。"
msgstr ""

#. Occurrence SP1:5094:20795: scene=SP1
#: SP1:5094
msgctxt "text_id=20795 | speaker=unknown"
msgid "　橙子は三十分ほどで出てきた。"
msgstr ""

#. Occurrence SP1:5099:20796: scene=SP1
#: SP1:5099
msgctxt "text_id=20796 | speaker=unknown"
msgid "　彼女の中ではわりと重い案件だったのか、家から出るなり両腕を空に伸ばして深呼吸をする。"
msgstr ""

#. Occurrence SP1:5104:20797: scene=SP1
#: SP1:5104
msgctxt "text_id=20797 | speaker=unknown"
msgid "　肩の荷を下ろすような、そんな伸びだった。"
msgstr ""

#. Occurrence SP1:5125:20798: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0063; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5125
msgctxt "text_id=20798 | speaker=touko"
msgid "「これで根回しは終了、っと。"
msgstr ""

#. Occurrence SP1:5131:20799: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0064; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5131
msgctxt "text_id=20799 | speaker=touko"
msgid "　後は―――最後の念押しね。ああ、面倒くさい」"
msgstr ""

#. Occurrence SP1:5137:20800: scene=SP1
#: SP1:5137
msgctxt "text_id=20800 | speaker=unknown"
msgid "　やれやれと呟く橙子。"
msgstr ""

#. Occurrence SP1:5142:20801: scene=SP1
#: SP1:5142
msgctxt "text_id=20801 | speaker=unknown"
msgid "　が。口調とは裏腹に、口元からはやっぱり例の、浮わ浮わした匂いがするのであった。"
msgstr ""

#. Occurrence SP1:5187:20802: scene=SP1
#: SP1:5187
msgctxt "text_id=20802 | speaker=unknown"
msgid "　橙子が次に向かったのは、何の変哲もないアパートだった。"
msgstr ""

#. Occurrence SP1:5192:20803: scene=SP1
#: SP1:5192
msgctxt "text_id=20803 | speaker=unknown"
msgid "　傍目には偶然通りかかったように見えるが、カレの鼻は誤魔化せない。"
msgstr ""

#. Occurrence SP1:5197:20804: scene=SP1
#: SP1:5197
msgctxt "text_id=20804 | speaker=unknown"
msgid "　橙子は散歩するような素振りで時間を調整し、午後二時三十分、きっちりとこの時間に合わせてアパートにやってきたのだ。"
msgstr ""

#. Occurrence SP1:5217:20805: scene=SP1
#: SP1:5217
msgctxt "text_id=20805 | speaker=unknown"
msgid "　そうして、アパートの駐車場には、"
msgstr ""

#. Occurrence SP1:5234:20806: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0000; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5234
msgctxt "text_id=20806 | speaker=ritsuka"
msgid "「へ？」"
msgstr ""

#. Occurrence SP1:5239:20807: scene=SP1
#: SP1:5239
msgctxt "text_id=20807 | speaker=unknown"
msgid "　たったいま一階の部屋から出てきた、<周瀬|すせ><律架|りつか>の姿があった。"
msgstr ""

#. Occurrence SP1:5272:20808: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0065; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5272
msgctxt "text_id=20808 | speaker=touko"
msgid "「はあい、お久しぶり。"
msgstr ""

#. Occurrence SP1:5272:20809: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0065; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5272
msgctxt "text_id=20809 | speaker=touko"
msgid "　こんなところでバッタリ出会うなんて奇遇ね、律架」"
msgstr ""

#. Occurrence SP1:5290:20810: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0001; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5290
msgctxt "text_id=20810 | speaker=ritsuka"
msgid "「うそ、トコちゃん！？　貴女、帰ってきてたの！？」"
msgstr ""

#. Occurrence SP1:5326:20811: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0066; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5326
msgctxt "text_id=20811 | speaker=touko"
msgid "「ええ。ちょっと前にね、こっそり、人目を忍ぶように、窓から侵入するサンタクロースさながらに。"
msgstr ""

#. Occurrence SP1:5338:20812: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0067; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5338
msgctxt "text_id=20812 | speaker=touko"
msgid "　あ、言うまでもなく目的はこの町をぶっ潰すコト。"
msgstr ""

#. Occurrence SP1:5338:20813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0067; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5338
msgctxt "text_id=20813 | speaker=touko"
msgid "　私の過去共々キレイさっぱり清算するため、この度、準備万端でやってまいりました。"
msgstr ""

#. Occurrence SP1:5350:20814: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0068; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5350
msgctxt "text_id=20814 | speaker=touko"
msgid "　なのでぇー。邪魔になる協会の人間とか教会の人間とか、気付かれる前にやっちゃうぞ☆」"
msgstr ""

#. Occurrence SP1:5377:20815: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0002; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5377
msgctxt "text_id=20815 | speaker=ritsuka"
msgid "「あらあら、それはご丁寧にどうも……って、"
msgstr ""

#. Occurrence SP1:5389:20816: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0003; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5389
msgctxt "text_id=20816 | speaker=ritsuka"
msgid "　トコちゃん、それわたしのことー！"
msgstr ""

#. Occurrence SP1:5389:20817: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0003; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5389
msgctxt "text_id=20817 | speaker=ritsuka"
msgid "　協会の人間って、いまわたししかいないんですけどー！」"
msgstr ""

#. Occurrence SP1:5400:20818: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0069; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5400
msgctxt "text_id=20818 | speaker=touko"
msgid "「あら不思議。むしろラッキー？"
msgstr ""

#. Occurrence SP1:5400:20819: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0069; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5400
msgctxt "text_id=20819 | speaker=touko"
msgid "　懐かしくて散歩していたら、まさか標的の一人に出遭うなんて。ひとつ手間が省けた感じ？」"
msgstr ""

#. Occurrence SP1:5436:20820: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0004; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5436
msgctxt "text_id=20820 | speaker=ritsuka"
msgid "「関係ないのー！　わたし、協会と関係ないからー！"
msgstr ""

#. Occurrence SP1:5448:20821: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0005; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5448
msgctxt "text_id=20821 | speaker=ritsuka"
msgid "　だってここ一年、真面目に仕事してないし！"
msgstr ""

#. Occurrence SP1:5459:20822: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0006; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5459
msgctxt "text_id=20822 | speaker=ritsuka"
msgid "　というか、仮にも兄弟子をつかまえて本気で殺すとか言わないでほしいですー！」"
msgstr ""

#. Occurrence SP1:5492:20823: scene=SP1
#: SP1:5492
msgctxt "text_id=20823 | speaker=unknown"
msgid "　アパートから現れた女性は、わたわたと涙目で手を振り回す。"
msgstr ""

#. Occurrence SP1:5497:20824: scene=SP1
#: SP1:5497
msgctxt "text_id=20824 | speaker=unknown"
msgid "　が、それは無用の心配だ。"
msgstr ""

#. Occurrence SP1:5502:20825: scene=SP1
#: SP1:5502
msgctxt "text_id=20825 | speaker=unknown"
msgid "　向かいの家の塀の穴から覗いているカレからしてみれば、橙子の殺気は偽物である。"
msgstr ""

#. Occurrence SP1:5507:20826: scene=SP1
#: SP1:5507
msgctxt "text_id=20826 | speaker=unknown"
msgid "　蒼崎橙子は、常からして他人をからかって愉しむ癖のある、たいへん困った女性だ。"
msgstr ""

#. Occurrence SP1:5512:20827: scene=SP1
#: SP1:5512
msgctxt "text_id=20827 | speaker=unknown"
msgid "　その困ったところが、あの相手に対しては二倍増しで表れているだけらしい。"
msgstr ""

#. Occurrence SP1:5556:20828: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0070; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5556
msgctxt "text_id=20828 | speaker=touko"
msgid "「……はあ。それを言うなら姉弟子でしょ」"
msgstr ""

#. Occurrence SP1:5568:20829: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0007; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5568
msgctxt "text_id=20829 | speaker=ritsuka"
msgid "「えー。だってトコちゃん、妹って感じしないんだもん。間違っても姉弟子、なんて胸を張って言えませんっ」"
msgstr ""

#. Occurrence SP1:5580:20830: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0071; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5580
msgctxt "text_id=20830 | speaker=touko"
msgid "「そうよね。技量的にも、とても先輩なんて言えるものじゃなかったし。律架の特技なんて、今じゃ深夜販売の商品以下だし。そろそろ職替え考えたら？　いいとこ紹介するよ。イタリアで見付けた、もう廃業寸前のサーカス一座とかどう？」"
msgstr ""

#. Occurrence SP1:5621:20831: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0008; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5621
msgctxt "text_id=20831 | speaker=ritsuka"
msgid "「そんな日給バイトはこりごりです！"
msgstr ""

#. Occurrence SP1:5621:20832: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0008; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5621
msgctxt "text_id=20832 | speaker=ritsuka"
msgid "　せめて週給のところを紹介して！」"
msgstr ""

#. Occurrence SP1:5627:20833: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0072; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5627
msgctxt "text_id=20833 | speaker=touko"
msgid "「……うわあ。通販以下ってところは否定しないんだ」"
msgstr ""

#. Occurrence SP1:5639:20834: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0009; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5639
msgctxt "text_id=20834 | speaker=ritsuka"
msgid "「なぜ？　トコちゃんの指摘は正しいわ。"
msgstr ""

#. Occurrence SP1:5651:20835: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0010; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5651
msgctxt "text_id=20835 | speaker=ritsuka"
msgid "　だってわたし、何もできない役立たずですから。"
msgstr ""

#. Occurrence SP1:5651:20836: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0010; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5651
msgctxt "text_id=20836 | speaker=ritsuka"
msgid "　魔術協会いちのお荷物、ここに参上～♪」"
msgstr ""

#. Occurrence SP1:5691:20837: scene=SP1
#: SP1:5691
msgctxt "text_id=20837 | speaker=unknown"
msgid "　ぽやぽやした笑顔に毒気を抜かれたのか、橙子もつられて微笑む。"
msgstr ""

#. Occurrence SP1:5696:20838: scene=SP1
#: SP1:5696
msgctxt "text_id=20838 | speaker=unknown"
msgid "　傍目には<和|わ><気|き><藹々|あいあい>とした関係だ。"
msgstr ""

#. Occurrence SP1:5739:20839: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0011; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5739
msgctxt "text_id=20839 | speaker=ritsuka"
msgid "「あ、わたしへの疑いは解けたとみたわ。"
msgstr ""

#. Occurrence SP1:5751:20840: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0012; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5751
msgctxt "text_id=20840 | speaker=ritsuka"
msgid "　それなら寄ってく？　これから用事があったんだけど、別に後回しでいいし。久しぶりだもの、お互いつもる話とか楽しそうじゃない？」"
msgstr ""

#. Occurrence SP1:5778:20841: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0073; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5778
msgctxt "text_id=20841 | speaker=touko"
msgid "「ほんと、相変わらずゆるゆるね律架は。"
msgstr ""

#. Occurrence SP1:5784:20842: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0074; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5784
msgctxt "text_id=20842 | speaker=touko"
msgid "　たしかに気が変わったわ。その様子じゃ協会との関係なんて無いようなものだし、貴女は貴女の信条を守っているようだし。"
msgstr ""

#. Occurrence SP1:5790:20843: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0075; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5790
msgctxt "text_id=20843 | speaker=touko"
msgid "　―――そう、本気で青子の味方なんだ」"
msgstr ""

#. Occurrence SP1:5817:20844: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0013; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5817
msgctxt "text_id=20844 | speaker=ritsuka"
msgid "「もっちろん！　アコちゃんはまだ半人前ですもの。"
msgstr ""

#. Occurrence SP1:5829:20845: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0014; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5829
msgctxt "text_id=20845 | speaker=ritsuka"
msgid "　付かず離れず、あくまで他人行儀に、アコちゃんが死ぬような目にあっても遠くから見守るわ」"
msgstr ""

#. Occurrence SP1:5841:20846: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0076; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5841
msgctxt "text_id=20846 | speaker=touko"
msgid "「それは結構。青子もホント、いい性格をした理解者に恵まれたもんだ」"
msgstr ""

#. Occurrence SP1:5866:20847: scene=SP1
#: SP1:5866
msgctxt "text_id=20847 | speaker=unknown"
msgid "　橙子は一歩、周瀬律架から身を引いた。"
msgstr ""

#. Occurrence SP1:5871:20848: scene=SP1
#: SP1:5871
msgctxt "text_id=20848 | speaker=unknown"
msgid "　やや名残惜しげな顔が、話はここで終わりである事を示している。"
msgstr ""

#. Occurrence SP1:5904:20849: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0015; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5904
msgctxt "text_id=20849 | speaker=ritsuka"
msgid "「あれ、寄っていかないの？"
msgstr ""

#. Occurrence SP1:5910:20850: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0016; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5910
msgctxt "text_id=20850 | speaker=ritsuka"
msgid "　わたし、コーヒー淹れるの上手くなったよ？」"
msgstr ""

#. Occurrence SP1:5928:20851: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0077; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5928
msgctxt "text_id=20851 | speaker=touko"
msgid "「ありがとう。けど遠慮しとく。こっちはまだ潜伏中だし、街攻略の準備もあるしね。"
msgstr ""

#. Occurrence SP1:5928:20852: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0077; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5928
msgctxt "text_id=20852 | speaker=touko"
msgid "　ここで緊張感をなくすのは<上|う><手|ま>くないでしょ」"
msgstr ""

#. Occurrence SP1:5964:20853: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0017; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5964
msgctxt "text_id=20853 | speaker=ritsuka"
msgid "「あらまあ、真面目さん。"
msgstr ""

#. Occurrence SP1:5976:20854: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0018; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5976
msgctxt "text_id=20854 | speaker=ritsuka"
msgid "　でもそうよね、トコちゃんはそういう人でした。根を詰めすぎて、目的より手段そのものに熱中しちゃうタイプ。"
msgstr ""

#. Occurrence SP1:5982:20855: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0019; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5982
msgctxt "text_id=20855 | speaker=ritsuka"
msgid "　ほーんと、どんな準備かは分からないけど、トコちゃんに狙われる人たちはたいへんだ」"
msgstr ""

#. Occurrence SP1:6008:20856: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0078; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6008
msgctxt "text_id=20856 | speaker=touko"
msgid "「ん？　別に普通でしょ？　基本、魔術戦やって、こっちが勝ったら刻印を貰うだけ。"
msgstr ""

#. Occurrence SP1:6014:20857: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0079; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6014
msgctxt "text_id=20857 | speaker=touko"
msgid "　時代遅れの魔女じゃあるまいし、倒した相手に呪いとかかけないわよ、私？」"
msgstr ""

#. Occurrence SP1:6049:20858: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0020; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6049
msgctxt "text_id=20858 | speaker=ritsuka"
msgid "「だからそこです。"
msgstr ""

#. Occurrence SP1:6055:20859: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0021; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6055
msgctxt "text_id=20859 | speaker=ritsuka"
msgid "　相手の命より収集を優先してるじゃない。"
msgstr ""

#. Occurrence SP1:6066:20860: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0022; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6066
msgctxt "text_id=20860 | speaker=ritsuka"
msgid "　その人たち、目玉だけになっても生きている、なんてコトにならなければいいけど。"
msgstr ""

#. Occurrence SP1:6077:20861: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0023; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6077
msgctxt "text_id=20861 | speaker=ritsuka"
msgid "　貴女は気を<遣|つか>っているつもりだろうけど、相手にとっては拷問だからね、それ」"
msgstr ""

#. Occurrence SP1:6115:20862: scene=SP1
#: SP1:6115
msgctxt "text_id=20862 | speaker=unknown"
msgid "　なるほど、と橙子は頷いた。"
msgstr ""

#. Occurrence SP1:6120:20863: scene=SP1
#: SP1:6120
msgctxt "text_id=20863 | speaker=unknown"
msgid "　自分の収集癖は、傍目にはそう映るのかと。"
msgstr ""

#. Occurrence SP1:6179:20864: scene=SP1
#: SP1:6179
msgctxt "text_id=20864 | speaker=unknown"
msgid "　蒼崎橙子は戦闘に利益を求める。"
msgstr ""

#. Occurrence SP1:6184:20865: scene=SP1
#: SP1:6184
msgctxt "text_id=20865 | speaker=unknown"
msgid "　敵対した魔術師を倒した後、彼らが有益な素材を提供してくれるのなら命までは奪わない。"
msgstr ""

#. Occurrence SP1:6189:20866: scene=SP1
#: SP1:6189
msgctxt "text_id=20866 | speaker=unknown"
msgid "　むしろ、ギブアンドテイクとばかりに無理やり命を助けさえする。"
msgstr ""

#. Occurrence SP1:6194:20867: scene=SP1
#: SP1:6194
msgctxt "text_id=20867 | speaker=unknown"
msgid "　結果、ロンドンの彼女の工房には『術式提供者用・慰安施設』なるものが出来てしまった。"
msgstr ""

#. Occurrence SP1:6199:20868: scene=SP1
#: SP1:6199
msgctxt "text_id=20868 | speaker=unknown"
msgid "　彼女に敗れた、あるいは自分から協力者になった魔術師たちの棲む魔窟である。"
msgstr ""

#. Occurrence SP1:6219:20869: scene=SP1
#: SP1:6219
msgctxt "text_id=20869 | speaker=unknown"
msgid "　現在、多くの魔術特許を持ち、月の収入が１万ポンドを超える橙子だが、大半はその施設の維持に充てられている。"
msgstr ""

#. Occurrence SP1:6224:20870: scene=SP1
#: SP1:6224
msgctxt "text_id=20870 | speaker=unknown"
msgid "　棲みついた魔術師たちの要望―――追加施設、特別待遇を望む声は日に日に増しており、いいかげん会社を<興|おこ>すか、あるいは全員<釈|ク><放|ビ>にするかと、悩み多い橙子だった。"
msgstr ""

#. Occurrence SP1:6271:20871: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0080; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6271
msgctxt "text_id=20871 | speaker=touko"
msgid "「でも、誓って<拷問室|そういうもの>じゃないわよ？"
msgstr ""

#. Occurrence SP1:6277:20872: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0081; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6277
msgctxt "text_id=20872 | speaker=touko"
msgid "　拷問なんて手間暇かかりすぎるし。娯楽を与える方が管理コストは低いんだってば。"
msgstr ""

#. Occurrence SP1:6283:20873: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0082; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6283
msgctxt "text_id=20873 | speaker=touko"
msgid "　<現代|いま>はいい脚本そろってるしね。適当な映画のプロットを拝借して、それを再現するだけで喜んでもらえるし。"
msgstr ""

#. Occurrence SP1:6289:20874: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0083; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6289
msgctxt "text_id=20874 | speaker=touko"
msgid "　仮想であれ現実であれ、自分が主役になれる物語なんて最高じゃない」"
msgstr ""

#. Occurrence SP1:6326:20875: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0024; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6326
msgctxt "text_id=20875 | speaker=ritsuka"
msgid "「ふーん。つかぬ事をお伺いいたしますけど、上演ジャンルはどのようなバランスで？"
msgstr ""

#. Occurrence SP1:6332:20876: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0025; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6332
msgctxt "text_id=20876 | speaker=ritsuka"
msgid "　恋愛３、活劇３、サスペンス３、アニメ１？」"
msgstr ""

#. Occurrence SP1:6338:20877: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0084; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6338
msgctxt "text_id=20877 | speaker=touko"
msgid "「は？　そりゃ、基本ホラーでしょ。エンタメのすべてが詰まってるんだし」"
msgstr ""

#. Occurrence SP1:6350:20878: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0026; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6350
msgctxt "text_id=20878 | speaker=ritsuka"
msgid "「……。わたし、トコちゃんのそういうところ、素で怖いわ。"
msgstr ""

#. Occurrence SP1:6356:20879: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0027; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6356
msgctxt "text_id=20879 | speaker=ritsuka"
msgid "　というか、女の子なんだからもっとロマンを求めてほしいの」"
msgstr ""

#. Occurrence SP1:6391:20880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0085; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6391
msgctxt "text_id=20880 | speaker=touko"
msgid "「む。今回<捕|つか>まえる候補にあがっている人間に言われると、さすがに考慮せざるをえない。"
msgstr ""

#. Occurrence SP1:6397:20881: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0086; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6397
msgctxt "text_id=20881 | speaker=touko"
msgid "　んー、囚人を放り込む<仮|は><想|こ><現|に><実|わ>の、バランスに気を遣ってみればいいの？　ホラー８ぐらい？」"
msgstr ""

#. Occurrence SP1:6415:20882: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0028; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6415
msgctxt "text_id=20882 | speaker=ritsuka"
msgid "「恋愛９！　恋愛９でお願いします！　それがダメなら推理９で是非！」"
msgstr ""

#. Occurrence SP1:6421:20883: scene=SP1
#: SP1:6421
msgctxt "text_id=20883 | speaker=unknown"
msgid "　橙子に狙われた場合、絶対に負けると信じきった上での即答だった。"
msgstr ""

#. Occurrence SP1:6455:20884: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0087; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6455
msgctxt "text_id=20884 | speaker=touko"
msgid "「了解、そういう事態になったら善処する」"
msgstr ""

#. Occurrence SP1:6467:20885: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0029; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6467
msgctxt "text_id=20885 | speaker=ritsuka"
msgid "「はーい。そういう事態って、どんな事態？」"
msgstr ""

#. Occurrence SP1:6478:20886: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0088; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6478
msgctxt "text_id=20886 | speaker=touko"
msgid "「誰かの味方をするのはいいけど、私の敵に回った時、かな。あと今日の事を口外した瞬間、足下からパクッといくから気をつけて」"
msgstr ""

#. Occurrence SP1:6517:20887: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0030; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6517
msgctxt "text_id=20887 | speaker=ritsuka"
msgid "「へ？　足下って、影のこと？"
msgstr ""

#. Occurrence SP1:6530:20888: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0031; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6530
msgctxt "text_id=20888 | speaker=ritsuka"
msgid "　あ―――あれ。そもそもなんていうか、トコちゃん。"
msgstr ""

#. Occurrence SP1:6538:20889: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0032; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6538
msgctxt "text_id=20889 | speaker=ritsuka"
msgid "　わたし、一歩も動けないんだけどー！」"
msgstr ""

#. Occurrence SP1:6560:20890: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0089; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6560
msgctxt "text_id=20890 | speaker=touko"
msgid "「ふふふ、ごめんなさい律架。実は一週間かけて、貴女の部屋に罠をしかけてたの。"
msgstr ""

#. Occurrence SP1:6566:20891: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0090; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6566
msgctxt "text_id=20891 | speaker=touko"
msgid "　ドアの境界に影で作った使い魔を仕込ませた、みたいな？　しばらくは貴女の影に棲みついているから、私に不利な証言したらたいへんだぞ"
msgstr ""

#. Occurrence SP1:6566:20892: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0090; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6566
msgctxt "text_id=20892 | speaker=touko"
msgid "」"
msgstr ""

#. Occurrence SP1:6601:20893: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0033; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6601
msgctxt "text_id=20893 | speaker=ritsuka"
msgid "「わたし、すでにたいへんだったのかー！"
msgstr ""

#. Occurrence SP1:6612:20894: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0034; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6612
msgctxt "text_id=20894 | speaker=ritsuka"
msgid "　悪魔！　人でなし！　天才悪魔！　トコちゃんはもう少し一般常識を学ぶべきです！　もう、どうりで夜な夜な泥棒さんがピッキングしてると思った！」"
msgstr ""

#. Occurrence SP1:6647:20895: scene=SP1
#: SP1:6647
msgctxt "text_id=20895 | speaker=unknown"
msgid "　影の使い魔には気付かなかったものの、深夜、細工をしている橙子の気配には気付いていたらしい。"
msgstr ""

#. Occurrence SP1:6652:20896: scene=SP1
#: SP1:6652
msgctxt "text_id=20896 | speaker=unknown"
msgid "　ただの泥棒と思ってスルーし続けるあたり、律架に一般常識を問われたくない橙子だった。"
msgstr ""

#. Occurrence SP1:6678:20897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0091; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6678
msgctxt "text_id=20897 | speaker=touko"
msgid "「その使い魔、年明けには溶けるから安心なさい。"
msgstr ""

#. Occurrence SP1:6684:20898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0092; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6684
msgctxt "text_id=20898 | speaker=touko"
msgid "　じゃあね律架。縁があったらまた会いましょう。その時は自慢のコーヒーをご馳走してね。"
msgstr ""

#. Occurrence SP1:6695:20899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0093; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6695
msgctxt "text_id=20899 | speaker=touko"
msgid "　ああ、あと深夜販売の商品だってバカにできたもんじゃないわ。あのシンプルさ、けっこう好きよ、私」"
msgstr ""

#. Occurrence SP1:6747:20900: scene=SP1
#: SP1:6747
msgctxt "text_id=20900 | speaker=unknown"
msgid "　旧知の友人にウインクをして、橙子はアパートを後にする。"
msgstr ""

#. Occurrence SP1:6752:20901: scene=SP1
#: SP1:6752
msgctxt "text_id=20901 | speaker=unknown"
msgid "“また会いましょう”"
msgstr ""

#. Occurrence SP1:6757:20902: scene=SP1
#: SP1:6757
msgctxt "text_id=20902 | speaker=unknown"
msgid "　その言葉に、橙子自身、空しいものを感じながら。"
msgstr ""

#. Occurrence SP1:6777:20903: scene=SP1
#: SP1:6777
msgctxt "text_id=20903 | speaker=unknown"
msgid "　今回の計画は、どうあっても彼女の肉体を無事には済まさない。成功するにしろ失敗するにしろ、蒼崎橙子はこの世から消失する。"
msgstr ""

#. Occurrence SP1:6783:20904: scene=SP1
#: SP1:6783
msgctxt "text_id=20904 | speaker=unknown"
msgid "　それでも再会の<空言|からごと>を残す程度には―――"
msgstr ""

#. Occurrence SP1:6788:20905: scene=SP1
#: SP1:6788
msgctxt "text_id=20905 | speaker=unknown"
msgid "　蒼崎橙子は、周瀬律架に思い入れがあったのだろう。"
msgstr ""

#. Occurrence SP1:6818:20906: scene=SP1
#: SP1:6818
msgctxt "text_id=20906 | speaker=unknown"
msgid "　そんな友人を、律架は金縛り状態で見送った。"
msgstr ""

#. Occurrence SP1:6823:20907: scene=SP1
#: SP1:6823
msgctxt "text_id=20907 | speaker=unknown"
msgid "　蒼崎橙子が帰ってきた。"
msgstr ""

#. Occurrence SP1:6828:20908: scene=SP1
#: SP1:6828
msgctxt "text_id=20908 | speaker=unknown"
msgid "　律架にとって、それは今回の事件の真相を知るに等しい。"
msgstr ""

#. Occurrence SP1:6833:20909: scene=SP1
#: SP1:6833
msgctxt "text_id=20909 | speaker=unknown"
msgid "　橙子より二歳ほど年上の周瀬律架は、十年前から橙子の祖^父―――五番目の魔法の路を発掘した魔術師―――の監視^役として派遣された魔術師だ。"
msgstr ""

#. Occurrence SP1:6838:20910: scene=SP1
#: SP1:6838
msgctxt "text_id=20910 | speaker=unknown"
msgid "　彼女は蒼崎橙子の先輩であり、また、蒼崎青子の先輩でもある。"
msgstr ""

#. Occurrence SP1:6843:20911: scene=SP1
#: SP1:6843
msgctxt "text_id=20911 | speaker=unknown"
msgid "　故に、姉妹の事情をそれなりに把握していた。"
msgstr ""

#. Occurrence SP1:6876:20912: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0035; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6876
msgctxt "text_id=20912 | speaker=ritsuka"
msgid "「うーん。そりゃあ、口止めの一つもしないとね。"
msgstr ""

#. Occurrence SP1:6882:20913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0036; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6882
msgctxt "text_id=20913 | speaker=ritsuka"
msgid "　トコちゃんを見てまっさきに警戒するのはわたしと―――」"
msgstr ""

#. Occurrence SP1:6888:20914: scene=SP1
#: SP1:6888
msgctxt "text_id=20914 | speaker=unknown"
msgid "　あと一人。"
msgstr ""

#. Occurrence SP1:6893:20915: scene=SP1
#: SP1:6893
msgctxt "text_id=20915 | speaker=unknown"
msgid "　真の意味で蒼崎姉妹の兄弟子と言える人物。"
msgstr ""

#. Occurrence SP1:6898:20916: scene=SP1
#: SP1:6898
msgctxt "text_id=20916 | speaker=unknown"
msgid "　蒼崎橙子の教育係を務めた、ある麗人が残っている。"
msgstr ""

#. Occurrence SP1:6924:20917: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0037; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6924
msgctxt "text_id=20917 | speaker=ritsuka"
msgid "「ま、そっちはそっちで根回ししてるかな。"
msgstr ""

#. Occurrence SP1:6930:20918: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0038; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6930
msgctxt "text_id=20918 | speaker=ritsuka"
msgid "　トコちゃんならそのあたり完璧だろうけど―――」"
msgstr ""

#. Occurrence SP1:6957:20919: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0039; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6957
msgctxt "text_id=20919 | speaker=ritsuka"
msgid "「もうちょっとこう、敵には非情になった方がいいわよね。　トコちゃんは相手の人権を尊重しすぎっていうか、根本が甘いっていうか。"
msgstr ""

#. Occurrence SP1:6964:20920: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0040; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6964
msgctxt "text_id=20920 | speaker=ritsuka"
msgid "殺すと決めた相手に顔を見せるとか、どうかと思うの、わたし」"
msgstr ""

#. Occurrence SP1:6994:20921: scene=SP1
#: SP1:6994
msgctxt "text_id=20921 | speaker=unknown"
msgid "　蒼崎橙子は魔術師というより研究者で、基本、戦いに向いた人間ではない。"
msgstr ""

#. Occurrence SP1:6999:20922: scene=SP1
#: SP1:6999
msgctxt "text_id=20922 | speaker=unknown"
msgid "　残酷なクセに冷酷ではない。"
msgstr ""

#. Occurrence SP1:7004:20923: scene=SP1
#: SP1:7004
msgctxt "text_id=20923 | speaker=unknown"
msgid "　合理的な、むごたらしい仕打ちができるクセに、他人への思いやりなどを持ってしまっている。"
msgstr ""

#. Occurrence SP1:7009:20924: scene=SP1
#: SP1:7009
msgctxt "text_id=20924 | speaker=unknown"
msgid "　そのあたりの整合性のなさが彼女自身を苦しめなければいいけど、と、律架はひとり、我が事のように嘆息した。"
msgstr ""

#. Occurrence SP1:7055:20925: scene=SP1
#: SP1:7055
msgctxt "text_id=20925 | speaker=unknown"
msgid "　蒼崎橙子は住宅地を後にすると、街で一番大きな公園に足を向けた。"
msgstr ""

#. Occurrence SP1:7060:20926: scene=SP1
#: SP1:7060
msgctxt "text_id=20926 | speaker=unknown"
msgid "　冬の初めの、午後三時過ぎの並木道。"
msgstr ""

#. Occurrence SP1:7065:20927: scene=SP1
#: SP1:7065
msgctxt "text_id=20927 | speaker=unknown"
msgid "　秋であれば散歩をする人々で<彩|いろど>られる道だが、今は橙子の姿しかない。"
msgstr ""

#. Occurrence SP1:7096:20928: scene=SP1
#: SP1:7096
msgctxt "text_id=20928 | speaker=unknown"
msgid "　……いや、正確にはもう一人分。"
msgstr ""

#. Occurrence SP1:7102:20929: scene=SP1
#: SP1:7102
msgctxt "text_id=20929 | speaker=unknown"
msgid "　十メートル以上の距離をとって芝生を歩くベオは、ここにきて雇い主の変化を嗅ぎ取った。"
msgstr ""

#. Occurrence SP1:7109:20930: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0048; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:7109
msgctxt "text_id=20930 | speaker=beo"
msgid "「“トーコさん、こんな町中でメガネ、外してる？”」"
msgstr ""

#. Occurrence SP1:7141:20931: scene=SP1
#: SP1:7141
msgctxt "text_id=20931 | speaker=unknown"
msgid "　蒼崎橙子はメガネの有り無しで人格をスイッチする。"
msgstr ""

#. Occurrence SP1:7146:20932: scene=SP1
#: SP1:7146
msgctxt "text_id=20932 | speaker=unknown"
msgid "　どちらが素なのかはベオには不明だが、メガネを外した彼女は遊びのない、男性的な思考に変化する。"
msgstr ""

#. Occurrence SP1:7151:20933: scene=SP1
#: SP1:7151
msgctxt "text_id=20933 | speaker=unknown"
msgid "　俗に言う二重人格……ではなく、物事の優先度を組み替えただけのもので、おもに相手を叩きのめす時、彼女はメガネを外す。"
msgstr ""

#. Occurrence SP1:7156:20934: scene=SP1
#: SP1:7156
msgctxt "text_id=20934 | speaker=unknown"
msgid "　妥協、憂慮、同情。そういったものを脳の外に追いやった、非人間に変身するのである。"
msgstr ""

#. Occurrence SP1:7191:20935: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0049; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:7191
msgctxt "text_id=20935 | speaker=beo"
msgid "「“ってコトは、さっきから近づいてくる匂いはトーコさんの敵……なんだ、けど……”」"
msgstr ""

#. Occurrence SP1:7197:20936: scene=SP1
#: SP1:7197
msgctxt "text_id=20936 | speaker=unknown"
msgid "　木の<陰|かげ>に<潜|ひそ>みながら、ベオはむう、と眉を寄せた。"
msgstr ""

#. Occurrence SP1:7202:20937: scene=SP1
#: SP1:7202
msgctxt "text_id=20937 | speaker=unknown"
msgid "　橙子からは確かに敵意とか緊張とか、その手の匂いが<零|こぼ>れている。"
msgstr ""

#. Occurrence SP1:7207:20938: scene=SP1
#: SP1:7207
msgctxt "text_id=20938 | speaker=unknown"
msgid "　けれど同時に、あの妙な匂いが強くなっている事に、ベオは不満げに鼻をひくつかせるのだった。"
msgstr ""

#. Occurrence SP1:7249:20939: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0001; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7249
msgctxt "text_id=20939 | speaker=eiri"
msgid "「こんにちは。なんとなしに散歩していただけなのですが、また出逢えるとは奇遇ですね、橙子さん」"
msgstr ""

#. Occurrence SP1:7258:20940: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0095; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7258
msgctxt "text_id=20940 | speaker=touko"
msgid "「ああ。たまたま続いた偶然だ。世間話をする仲でもなし、挨拶を交わす程度に済ませよう」"
msgstr ""

#. Occurrence SP1:7291:20941: scene=SP1
#: SP1:7291
msgctxt "text_id=20941 | speaker=unknown"
msgid "　橙子に声をかけたのは、ベオにとって未知の人間だった。"
msgstr ""

#. Occurrence SP1:7296:20942: scene=SP1
#: SP1:7296
msgctxt "text_id=20942 | speaker=unknown"
msgid "　男の名は<文柄|ふみづか><詠梨|えいり>。"
msgstr ""

#. Occurrence SP1:7301:20943: scene=SP1
#: SP1:7301
msgctxt "text_id=20943 | speaker=unknown"
msgid "　合田教会の司祭代理であり、ベオや橙子からすれば敵よりの人物である。"
msgstr ""

#. Occurrence SP1:7321:20944: scene=SP1
#: SP1:7321
msgctxt "text_id=20944 | speaker=unknown"
msgid "　が、事前情報を知らないカレにそれを察しろというのは酷な話だろう。"
msgstr ""

#. Occurrence SP1:7326:20945: scene=SP1
#: SP1:7326
msgctxt "text_id=20945 | speaker=unknown"
msgid "　なにしろ、司祭には敵意が一切ない。"
msgstr ""

#. Occurrence SP1:7331:20946: scene=SP1
#: SP1:7331
msgctxt "text_id=20946 | speaker=unknown"
msgid "　ベオから見て、彼はどこからどう見ても一般人であり、蒼崎橙子が遅れを取る可能性など皆無だからだ。"
msgstr ""

#. Occurrence SP1:7337:20947: scene=SP1
#: SP1:7337
msgctxt "text_id=20947 | speaker=unknown"
msgid "　―――後に、カレはその手の“毒を毒と思わせない”タイプの人間から手ひどい教訓を学ぶ事になるが、それはまた別の話である。"
msgstr ""

#. Occurrence SP1:7384:20948: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0096; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7384
msgctxt "text_id=20948 | speaker=touko"
msgid "「そちらの状況はどうなんだ。神の家は働き者<揃|ぞろ>いだからな。利権をあさりに来る<欲深|よくぶか>は現れそうか？」"
msgstr ""

#. Occurrence SP1:7395:20949: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0002; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7395
msgctxt "text_id=20949 | speaker=eiri"
msgid "「いやあ。働き者、というのは全力で肯定しますけど、欲が深いとか、そんな人は少ないですよ、こちらは。"
msgstr ""

#. Occurrence SP1:7406:20950: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0003; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7406
msgctxt "text_id=20950 | speaker=eiri"
msgid "　彼らがやってくる時はたいていは教義の為ですから。"
msgstr ""

#. Occurrence SP1:7406:20951: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0003; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7406
msgctxt "text_id=20951 | speaker=eiri"
msgid "　欲望より<責務|せきむ>で動く人たちって怖くないですか？」"
msgstr ""

#. Occurrence SP1:7433:20952: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0097; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7433
msgctxt "text_id=20952 | speaker=touko"
msgid "「無駄話はしないと言っただろう。"
msgstr ""

#. Occurrence SP1:7439:20953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0098; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7439
msgctxt "text_id=20953 | speaker=touko"
msgid "　結論を言え。おまえの腰巾着は鐘を鳴らしそうか？」"
msgstr ""

#. Occurrence SP1:7465:20954: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0004; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7465
msgctxt "text_id=20954 | speaker=eiri"
msgid "「やれやれ。人のことは言えませんよ。"
msgstr ""

#. Occurrence SP1:7465:20955: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0004; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7465
msgctxt "text_id=20955 | speaker=eiri"
msgid "　橙子さんだってワーカホリック寸前じゃないですか。"
msgstr ""

#. Occurrence SP1:7471:20956: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0005; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7471
msgctxt "text_id=20956 | speaker=eiri"
msgid "　もっとこう、余裕のあるコミュニケーションをとりませんか？　立場上、いつ最後の<逢瀬|おうせ>になるか分からないワケですし」"
msgstr ""

#. Occurrence SP1:7483:20957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0099; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7483
msgctxt "text_id=20957 | speaker=touko"
msgid "「ふざけろ。いつも何も、これが最後だよ詠梨」"
msgstr ""

#. Occurrence SP1:7503:20958: scene=SP1
#: SP1:7503
msgctxt "text_id=20958 | speaker=unknown"
msgid "　微笑む司祭の提案を、橙子は一言で斬って捨てた。"
msgstr ""

#. Occurrence SP1:7508:20959: scene=SP1
#: SP1:7508
msgctxt "text_id=20959 | speaker=unknown"
msgid "　まさにけんもほろろ状態である。"
msgstr ""

#. Occurrence SP1:7543:20960: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0100; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7543
msgctxt "text_id=20960 | speaker=touko"
msgid "「だいたい次があるとしたら、その時は殺し合いだろ。"
msgstr ""

#. Occurrence SP1:7549:20961: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0101; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7549
msgctxt "text_id=20961 | speaker=touko"
msgid "　お互い手の内は知っているしな。顔を会わせた瞬間、どちらかが死んでいる。会話なんぞしている暇があるか」"
msgstr ""

#. Occurrence SP1:7555:20962: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0006; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7555
msgctxt "text_id=20962 | speaker=eiri"
msgid "「それは橙子さんだけの思いこみですけどねぇ。"
msgstr ""

#. Occurrence SP1:7561:20963: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0007; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7561
msgctxt "text_id=20963 | speaker=eiri"
msgid "　どうしてこう、邪魔者は始末する、という方向でしか物事を考えられないんでしょうか、貴女たちは」"
msgstr ""

#. Occurrence SP1:7581:20964: scene=SP1
#: SP1:7581
msgctxt "text_id=20964 | speaker=unknown"
msgid "　やれやれと肩をすくめる司祭と、"
msgstr ""

#. Occurrence SP1:7586:20965: scene=SP1
#: SP1:7586
msgctxt "text_id=20965 | speaker=unknown"
msgid "　その<外套|マント>の下を注意深く見据える橙子。"
msgstr ""

#. Occurrence SP1:7591:20966: scene=SP1
#: SP1:7591
msgctxt "text_id=20966 | speaker=unknown"
msgid "　司祭が何度「穏便に済ませたい」と口にしても、プライドにかけて信じる気はないようだ。"
msgstr ""

#. Occurrence SP1:7627:20967: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0008; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7627
msgctxt "text_id=20967 | speaker=eiri"
msgid "「まったく。そういうところも成長して帰ってくるんですから。育つのは女性としての魅力だけに留めておいてほしいものです。"
msgstr ""

#. Occurrence SP1:7633:20968: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0009; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7633
msgctxt "text_id=20968 | speaker=eiri"
msgid "　ああ、そう睨まない。本題に入りますから」"
msgstr ""

#. Occurrence SP1:7662:20969: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0010; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7662
msgctxt "text_id=20969 | speaker=eiri"
msgid "「目下、教会への報告は私が一任されています。司祭への報告は『現在、管理者は異端者と交戦中。中立の条約に基づき、司祭代理権限で監督中。なお、異端者の所属は不明、現在、履歴を調査中』といったところです」"
msgstr ""

#. Occurrence SP1:7683:20970: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0102; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7683
msgctxt "text_id=20970 | speaker=touko"
msgid "「この町に現れた魔術師は所属不明……という事になっているんだな？」"
msgstr ""

#. Occurrence SP1:7695:20971: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0011; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7695
msgctxt "text_id=20971 | speaker=eiri"
msgid "「ええ。シスター<唯架|ゆいか>は私とは別<所轄|しょかつ>の方ですが、彼女は異端者の工房はおろか、その姿さえ掴めていません。"
msgstr ""

#. Occurrence SP1:7701:20972: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0012; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7701
msgctxt "text_id=20972 | speaker=eiri"
msgid "　彼女が単独で敵の正体を暴くまで、教会から横槍が入る事はないんじゃないですかねぇ。"
msgstr ""

#. Occurrence SP1:7707:20973: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0013; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7707
msgctxt "text_id=20973 | speaker=eiri"
msgid "　今まで通り、土地を狙いにきた魔術師同士の小競り合いだと思っているんじゃないですか？」"
msgstr ""

#. Occurrence SP1:7742:20974: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0103; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7742
msgctxt "text_id=20974 | speaker=touko"
msgid "「そうか。では取引成立だな。"
msgstr ""

#. Occurrence SP1:7748:20975: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0104; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7748
msgctxt "text_id=20975 | speaker=touko"
msgid "　おまえが私の帰国の件を握り潰している間は、私も多少、回り道をする。蒼崎の親戚筋にも手は出さない」"
msgstr ""

#. Occurrence SP1:7769:20976: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0014; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7769
msgctxt "text_id=20976 | speaker=eiri"
msgid "「良かった。橙子さんは無差別な破壊工作はしませんが、とにかく最適な<道筋|みちすじ>を好みますから。"
msgstr ""

#. Occurrence SP1:7776:20977: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0015; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7776
msgctxt "text_id=20977 | speaker=eiri"
msgid "　勢い、どこぞの工場とかオフィスビルとか秘密基地にしそうでしょう？"
msgstr ""

#. Occurrence SP1:7782:20978: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0016; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7782
msgctxt "text_id=20978 | speaker=eiri"
msgid "　私がこちらに赴任している間、流血事件が続くと困るというか。私の評価が落ちるような事は、なんとも」"
msgstr ""

#. Occurrence SP1:7807:20979: scene=SP1
#: SP1:7807
msgctxt "text_id=20979 | speaker=unknown"
msgid "　人の事をなんだと思っているんだ、と抗議したくなる気持ちを抑えこむ。"
msgstr ""

#. Occurrence SP1:7812:20980: scene=SP1
#: SP1:7812
msgctxt "text_id=20980 | speaker=unknown"
msgid "　橙子とて無駄は嫌いだが、だからといって最適化の為に社会性を<無|む><下|げ>にするつもりはない。"
msgstr ""

#. Occurrence SP1:7817:20981: scene=SP1
#: SP1:7817
msgctxt "text_id=20981 | speaker=unknown"
msgid "　そもそも、犯罪行為は後処理が面倒になる。そちらの方が遥かに無駄というものだ。"
msgstr ""

#. Occurrence SP1:7848:20982: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0105; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7848
msgctxt "text_id=20982 | speaker=touko"
msgid "「……まあいいさ。お互いの利益が一致したんだからな。"
msgstr ""

#. Occurrence SP1:7854:20983: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0106; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7854
msgctxt "text_id=20983 | speaker=touko"
msgid "　では、後は事が済むまで<静観|せいかん>を決めこんでおけ」"
msgstr ""

#. Occurrence SP1:7860:20984: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0017; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7860
msgctxt "text_id=20984 | speaker=eiri"
msgid "「もうお帰りですか。名残惜しいですねぇ。"
msgstr ""

#. Occurrence SP1:7866:20985: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0018; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7866
msgctxt "text_id=20985 | speaker=eiri"
msgid "　結局一度も、今の貴女の素顔を見られなかった」"
msgstr ""

#. Occurrence SP1:7872:20986: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0107; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7872
msgctxt "text_id=20986 | speaker=touko"
msgid "「私は逆だ。そのカマキリ<面|づら>もこれで<見納|みおさ>めかと思うとせいせいする」"
msgstr ""

#. Occurrence SP1:7878:20987: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0019; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7878
msgctxt "text_id=20987 | speaker=eiri"
msgid "「ああ、待ってください。お別れの前に、一つ質問を」"
msgstr ""

#. Occurrence SP1:7912:20988: scene=SP1
#: SP1:7912
msgctxt "text_id=20988 | speaker=unknown"
msgid "　司祭に顔を向けたまま立ち去ろうとする橙子を、司祭はごく自然に制止させた。"
msgstr ""

#. Occurrence SP1:7917:20989: scene=SP1
#: SP1:7917
msgctxt "text_id=20989 | speaker=unknown"
msgid "　橙子が足を半歩後ろにズラそうと考えた瞬間に、である。"
msgstr ""

#. Occurrence SP1:7941:20990: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0020; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7941
msgctxt "text_id=20990 | speaker=eiri"
msgid "「所感なのですが。"
msgstr ""

#. Occurrence SP1:7947:20991: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0021; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7947
msgctxt "text_id=20991 | speaker=eiri"
msgid "　橙子さん、今、たいへん息苦しくはありませんか？」"
msgstr ""

#. Occurrence SP1:7959:20992: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0108; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7959
msgctxt "text_id=20992 | speaker=touko"
msgid "「まさか。私はかつてないほど充実しているよ。"
msgstr ""

#. Occurrence SP1:7965:20993: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0109; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7965
msgctxt "text_id=20993 | speaker=touko"
msgid "　なぜそんな事を訊く、詠梨」"
msgstr ""

#. Occurrence SP1:7987:20994: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0022; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7987
msgctxt "text_id=20994 | speaker=eiri"
msgid "「いえ。だって楽しそうではありますが、幸せそうではありませんので。貴女自身気付いてはいないようでしたから、<知|ち><己|き>として心配になったのです」"
msgstr ""

#. Occurrence SP1:8025:20995: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0110; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8025
msgctxt "text_id=20995 | speaker=touko"
msgid "「……幸せの定義か。思い出したよ。おまえの口癖だったな、それは。幸せのカタチは人それぞれだと。"
msgstr ""

#. Occurrence SP1:8031:20996: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0111; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8031
msgctxt "text_id=20996 | speaker=touko"
msgid "　まったくその通りだ。私の善しとする幸福が、他人であるおまえに分かるものか。つまらん心配はするな」"
msgstr ""

#. Occurrence SP1:8052:20997: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0023; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8052
msgctxt "text_id=20997 | speaker=eiri"
msgid "「いや、そりゃあ細かいところまでは分かりませんけどねぇ。とくに女の人の幸福観なんて、それこそ<奇々怪々|ききかいかい>ですから。"
msgstr ""

#. Occurrence SP1:8058:20998: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0024; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8058
msgctxt "text_id=20998 | speaker=eiri"
msgid "　ですがほら、幸福のカタチは二つに大別できます。"
msgstr ""

#. Occurrence SP1:8064:20999: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0025; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8064
msgctxt "text_id=20999 | speaker=eiri"
msgid "　橙子さんの場合、それすら気付いていないようですから。たいへん見苦しいな、と思いまして」"
msgstr ""

#. Occurrence SP1:8100:21000: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0112; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8100
msgctxt "text_id=21000 | speaker=touko"
msgid "「……ほう、ご忠告痛み入る。腐っても兄弟子という訳か。"
msgstr ""

#. Occurrence SP1:8106:21001: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0113; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8106
msgctxt "text_id=21001 | speaker=touko"
msgid "　いいぞ、聞いてやるから言ってみろ」"
msgstr ""

#. Occurrence SP1:8112:21002: scene=SP1
#: SP1:8112
msgctxt "text_id=21002 | speaker=unknown"
msgid "　それが下らないものなら、ここで殺す。"
msgstr ""

#. Occurrence SP1:8117:21003: scene=SP1
#: SP1:8117
msgctxt "text_id=21003 | speaker=unknown"
msgid "　この一ヶ月―――いや、この二年間積み重ねてきた計画を白紙に戻す事になっても殺す、と。"
msgstr ""

#. Occurrence SP1:8122:21004: scene=SP1
#: SP1:8122
msgctxt "text_id=21004 | speaker=unknown"
msgid "　橙子の敵意は、ここにきて殺意に変貌した。"
msgstr ""

#. Occurrence SP1:8155:21005: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0026; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8155
msgctxt "text_id=21005 | speaker=eiri"
msgid "「当たり前のコトですよ。"
msgstr ""

#. Occurrence SP1:8161:21006: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0027; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8161
msgctxt "text_id=21006 | speaker=eiri"
msgid "　相対的なものと絶対的なもの。比べる相手が居るか居ないかが幸福の違いです。"
msgstr ""

#. Occurrence SP1:8167:21007: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0028; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8167
msgctxt "text_id=21007 | speaker=eiri"
msgid "　自分が穏やかであれば幸福なのか、それとも―――"
msgstr ""

#. Occurrence SP1:8173:21008: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0029; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8173
msgctxt "text_id=21008 | speaker=eiri"
msgid "　どんなに満ち足りていても、<他人|ひと>より劣っていては我慢できない人間なのか」"
msgstr ""

#. Occurrence SP1:8194:21009: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0030; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8194
msgctxt "text_id=21009 | speaker=eiri"
msgid "「幸福の定義なんて、詰まるところはその二つですよ。"
msgstr ""

#. Occurrence SP1:8200:21010: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0031; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8200
msgctxt "text_id=21010 | speaker=eiri"
msgid "　私が言うまでもありませんが―――"
msgstr ""

#. Occurrence SP1:8200:21011: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0031; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8200
msgctxt "text_id=21011 | speaker=eiri"
msgid "　多くの人間は、ただ、<他人|ひと>より少しだけ幸せでありたいのです」"
msgstr ""

#. Occurrence SP1:8232:21012: scene=SP1
#: SP1:8232
msgctxt "text_id=21012 | speaker=unknown"
msgid "　涼やかに<微笑|わら>う黒衣の聖者。"
msgstr ""

#. Occurrence SP1:8237:21013: scene=SP1
#: SP1:8237
msgctxt "text_id=21013 | speaker=unknown"
msgid "　ああ、と橙子は思いだした。"
msgstr ""

#. Occurrence SP1:8242:21014: scene=SP1
#: SP1:8242
msgctxt "text_id=21014 | speaker=unknown"
msgid "　この男は根本からして、<幸福|そういうもの>を信じていない悪魔だったと。"
msgstr ""

#. Occurrence SP1:8279:21015: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0032; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8279
msgctxt "text_id=21015 | speaker=eiri"
msgid "「ほら、そんな殺気は収めて。シスター唯架が飛んできます。"
msgstr ""

#. Occurrence SP1:8285:21016: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0033; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8285
msgctxt "text_id=21016 | speaker=eiri"
msgid "　橙子さんの幸福観は絶対的なもの。貴女は自分が確かであれば満ち足りるタイプの人だったんですけどね。"
msgstr ""

#. Occurrence SP1:8291:21017: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0034; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8291
msgctxt "text_id=21017 | speaker=eiri"
msgid "　他人が気になるなんて、そんな相対的な幸福観を持っているのは、」"
msgstr ""

#. Occurrence SP1:8317:21018: scene=SP1
#: SP1:8317
msgctxt "text_id=21018 | speaker=unknown"
msgid "　青子の方、と言いかけて、司祭は自分から身を引いた。"
msgstr ""

#. Occurrence SP1:8322:21019: scene=SP1
#: SP1:8322
msgctxt "text_id=21019 | speaker=unknown"
msgid "　心底から橙子を心配しての忠告だったが、逆の結果に終わったようだ。"
msgstr ""

#. Occurrence SP1:8327:21020: scene=SP1
#: SP1:8327
msgctxt "text_id=21020 | speaker=unknown"
msgid "　司祭としては本当に名残惜しいが、これ以上怒らせて嫌われるのはよろしくない。"
msgstr ""

#. Occurrence SP1:8365:21021: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0035; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8365
msgctxt "text_id=21021 | speaker=eiri"
msgid "「言葉がすぎました。お許しを<人形師|ハイマスター>。"
msgstr ""

#. Occurrence SP1:8371:21022: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0036; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8371
msgctxt "text_id=21022 | speaker=eiri"
msgid "　それでは私はこれで。貴女たちにとっていい結果になる事を祈っています」"
msgstr ""

#. Occurrence SP1:8383:21023: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0114; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8383
msgctxt "text_id=21023 | speaker=touko"
msgid "「ふん、さっさと消えろ<穀|ごく>潰し。最後まで陰気くさい真似をしやがって。"
msgstr ""

#. Occurrence SP1:8389:21024: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0115; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8389
msgctxt "text_id=21024 | speaker=touko"
msgid "　……だいたいその服装、どうなんだ。町中でマントなんて<羽|は><織|お>って、敬遠されないのか？」"
msgstr ""

#. Occurrence SP1:8416:21025: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0037; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8416
msgctxt "text_id=21025 | speaker=eiri"
msgid "「皆さん、もう慣れてくださいましたから。"
msgstr ""

#. Occurrence SP1:8428:21026: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0038; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8428
msgctxt "text_id=21026 | speaker=eiri"
msgid "　それに、ほら。この格好だと<得物|エモノ>を差していてもバレないでしょう？"
msgstr ""

#. Occurrence SP1:8434:21027: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0039; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8434
msgctxt "text_id=21027 | speaker=eiri"
msgid "　ま、橙子さんには見抜かれてしまいましたが。相手が貴女ですからね。恥ずかしながら、長物を三本ほど、こっそり」"
msgstr ""

#. Occurrence SP1:8480:21028: scene=SP1
#: SP1:8480
msgctxt "text_id=21028 | speaker=unknown"
msgid "　最後まで笑顔を絶やさず、司祭はもと来た道へ退散していった。"
msgstr ""

#. Occurrence SP1:8496:21029: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0116; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8496
msgctxt "text_id=21029 | speaker=touko"
msgid "「……ふざけやがって。こっちは一本、それも短刀ぐらいにしか見抜けなかった。"
msgstr ""

#. Occurrence SP1:8502:21030: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0117; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8502
msgctxt "text_id=21030 | speaker=touko"
msgid "　そもそも三本ってなんだ？　魔術師でもないクセに、どうやったら隠せるんだ？　あのバカ、手品師に<鞍替|くらが>えしたワケじゃあるまいな？」"
msgstr ""

#. Occurrence SP1:8535:21031: scene=SP1
#: SP1:8535
msgctxt "text_id=21031 | speaker=unknown"
msgid "　橙子はぼやきつつ、先ほどまで目の前にいた男の姿を思い返した。"
msgstr ""

#. Occurrence SP1:8540:21032: scene=SP1
#: SP1:8540
msgctxt "text_id=21032 | speaker=unknown"
msgid "　一枚上をいかれたのは心底<憎|にく>らしいが、同時にホッとしているのも事実である。"
msgstr ""

#. Occurrence SP1:8560:21033: scene=SP1
#: SP1:8560
msgctxt "text_id=21033 | speaker=unknown"
msgid "　あの短い会話の中、橙子がもし司祭の武装を正確に見抜いてしまっていたら、その瞬間こそ、あの司祭はゼロコンマで戦いの火ぶたを切っただろう。"
msgstr ""

#. Occurrence SP1:8566:21034: scene=SP1
#: SP1:8566
msgctxt "text_id=21034 | speaker=unknown"
msgid "　その時―――どちらが生き残るかは、今の蒼崎橙子ですら予測できない。"
msgstr ""

#. Occurrence SP1:8598:21035: scene=SP1
#: SP1:8598
msgctxt "text_id=21035 | speaker=unknown"
msgid "　文柄詠梨という男は、昔からそういう人間だった。"
msgstr ""

#. Occurrence SP1:8603:21036: scene=SP1
#: SP1:8603
msgctxt "text_id=21036 | speaker=unknown"
msgid "　戦う理由も、戦う相手も要らない。"
msgstr ""

#. Occurrence SP1:8608:21037: scene=SP1
#: SP1:8608
msgctxt "text_id=21037 | speaker=unknown"
msgid "　因縁も憎悪も要らない。"
msgstr ""

#. Occurrence SP1:8613:21038: scene=SP1
#: SP1:8613
msgctxt "text_id=21038 | speaker=unknown"
msgid "　ただ、「口火を切る」瞬間だけを待つ<自動機械|オートメーション>。"
msgstr ""

#. Occurrence SP1:8618:21039: scene=SP1
#: SP1:8618
msgctxt "text_id=21039 | speaker=unknown"
msgid "　人を斬る事について考察さえしない、鍛え上げられた“殺人検証”の化身である。"
msgstr ""

#. Occurrence SP1:8652:21040: scene=SP1
#: SP1:8652
msgctxt "text_id=21040 | speaker=unknown"
msgid "　彼女がそれを間近で見たのは一度きり。"
msgstr ""

#. Occurrence SP1:8658:21041: scene=SP1
#: SP1:8658
msgctxt "text_id=21041 | speaker=unknown"
msgid "　……まだ蒼崎橙子が魔法使いの“幸福な”弟子だった頃。"
msgstr ""

#. Occurrence SP1:8663:21042: scene=SP1
#: SP1:8663
msgctxt "text_id=21042 | speaker=unknown"
msgid "　あの男は、橙子が祖父の前で静かに涙した瞬間、何の前触れもなく、何の躊躇いもなく、自らの師を一刀のもと処断したのだ。"
msgstr ""

#. Occurrence SP1:8714:21043: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A21_SP1_0000; voice_prefix=A21; voice_category=11; scene=SP1
#: SP1:8714
msgctxt "text_id=21043 | speaker=touko"
msgid "「なんで！？　どうして、貴方が<祖父|あのひと>を斬りつけたの！？」"
msgstr ""

#. Occurrence SP1:8720:21044: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B41_SP1_0000; voice_prefix=B41; voice_category=8; scene=SP1
#: SP1:8720
msgctxt "text_id=21044 | speaker=eiri"
msgid "「いえ。今なら斬れる、と思いましたので」"
msgstr ""

#. Occurrence SP1:8740:21045: scene=SP1
#: SP1:8740
msgctxt "text_id=21045 | speaker=unknown"
msgid "　あっさりとした返答に、幼い橙子がどれほど感じ入ったのか、当の本人は知るまい。"
msgstr ""

#. Occurrence SP1:8746:21046: scene=SP1
#: SP1:8746
msgctxt "text_id=21046 | speaker=unknown"
msgid "“相手が隙を見せたから、勝てると確信したから斬った”"
msgstr ""

#. Occurrence SP1:8746:21047: scene=SP1
#: SP1:8746
msgctxt "text_id=21047 | speaker=unknown"
msgid "　ではない。"
msgstr ""

#. Occurrence SP1:8751:21048: scene=SP1
#: SP1:8751
msgctxt "text_id=21048 | speaker=unknown"
msgid "“今の自分の気持ちなら斬れると思ったから、斬った”。"
msgstr ""

#. Occurrence SP1:8783:21049: scene=SP1
#: SP1:8783
msgctxt "text_id=21049 | speaker=unknown"
msgid "　ただそれだけ。"
msgstr ""

#. Occurrence SP1:8788:21050: scene=SP1
#: SP1:8788
msgctxt "text_id=21050 | speaker=unknown"
msgid "　祖父に弟子入りし、交遊を深め、唯一無二の友人関係を得た男は、胸に飛来した感情に寄って祖父を切断した。"
msgstr ""

#. Occurrence SP1:8793:21051: scene=SP1
#: SP1:8793
msgctxt "text_id=21051 | speaker=unknown"
msgid "　魔法使いに限りなく近かった魔術師の肉体を破壊したのは、誰あろう、あの司祭の神技である。"
msgstr ""

#. Occurrence SP1:8834:21052: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0118; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8834
msgctxt "text_id=21052 | speaker=touko"
msgid "「あーあ、ほんと胡散くさい、面倒くさい！"
msgstr ""

#. Occurrence SP1:8840:21053: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0119; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8840
msgctxt "text_id=21053 | speaker=touko"
msgid "　でも<目障|めざわ>りだからぜったい殺すし。魔法を<奪|うば>ってからの仕事がまた一つ増えちゃったじゃない、バカ詠梨」"
msgstr ""

#. Occurrence SP1:8865:21054: scene=SP1
#: SP1:8865
msgctxt "text_id=21054 | speaker=unknown"
msgid "　眼鏡をかけ直して、橙子は<踵|きびす>を返した。"
msgstr ""

#. Occurrence SP1:8870:21055: scene=SP1
#: SP1:8870
msgctxt "text_id=21055 | speaker=unknown"
msgid "　今日の目的はすべてクリアした。"
msgstr ""

#. Occurrence SP1:8875:21056: scene=SP1
#: SP1:8875
msgctxt "text_id=21056 | speaker=unknown"
msgid "　あとは使い魔の食料を調達する為、食費を稼いでアジトに帰るだけである。"
msgstr ""

#. Occurrence SP1:8909:21057: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0050; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:8909
msgctxt "text_id=21057 | speaker=beo"
msgid "「“ちょっ、なにあの乙女時空ーーーーーー！？”」"
msgstr ""

#. Occurrence SP1:8915:21058: scene=SP1
#: SP1:8915
msgctxt "text_id=21058 | speaker=unknown"
msgid "　と、ベオが叫んだかはさておいて。"
msgstr ""

#. Occurrence SP1:8920:21059: scene=SP1
#: SP1:8920
msgctxt "text_id=21059 | speaker=unknown"
msgid "　例の浮わ浮わした匂いはどこへやら。"
msgstr ""

#. Occurrence SP1:8925:21060: scene=SP1
#: SP1:8925
msgctxt "text_id=21060 | speaker=unknown"
msgid "　雇い主は完全にもとの蒼崎橙子に戻って、繁華街の方角に消えていった。"
msgstr ""

#. Occurrence SP1:8959:21061: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0051; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:8959
msgctxt "text_id=21061 | speaker=beo"
msgid "「“………………”」"
msgstr ""

#. Occurrence SP1:8965:21062: scene=SP1
#: SP1:8965
msgctxt "text_id=21062 | speaker=unknown"
msgid "　クンクンと鼻を鳴らす。"
msgstr ""

#. Occurrence SP1:8970:21063: scene=SP1
#: SP1:8970
msgctxt "text_id=21063 | speaker=unknown"
msgid "　あの匂いが気になってやってきたベオとしては、もはや橙子は尾行する対象になりえない。"
msgstr ""

#. Occurrence SP1:8990:21064: scene=SP1
#: SP1:8990
msgctxt "text_id=21064 | speaker=unknown"
msgid "　なぜ匂いは消えたのか。"
msgstr ""

#. Occurrence SP1:8995:21065: scene=SP1
#: SP1:8995
msgctxt "text_id=21065 | speaker=unknown"
msgid "　そもそも原因は何だったのか。"
msgstr ""

#. Occurrence SP1:9000:21066: scene=SP1
#: SP1:9000
msgctxt "text_id=21066 | speaker=unknown"
msgid "　カレはカレなりに考えこんだ末、"
msgstr ""

#. Occurrence SP1:9007:21067: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0052; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9007
msgctxt "text_id=21067 | speaker=beo"
msgid "「“うん、さっきの男が怪しいよね！”」"
msgstr ""

#. Occurrence SP1:9013:21068: scene=SP1
#: SP1:9013
msgctxt "text_id=21068 | speaker=unknown"
msgid "　気を取り直して、先ほどの男の匂いを辿る事にした。"
msgstr ""

#. Occurrence SP1:9033:21069: scene=SP1
#: SP1:9033
msgctxt "text_id=21069 | speaker=unknown"
msgid "　行き着く先が雇い主にとって鬼門である事なぞ、無論、ベオには与り知らぬコトである。"
msgstr ""

#. Occurrence SP1:9090:21070: scene=SP1
#: SP1:9090
msgctxt "text_id=21070 | speaker=unknown"
msgid "　唐突だが、<合田|あいだ>教会は年中無休、かつ、来る者拒まずの姿勢を貫いている。"
msgstr ""

#. Occurrence SP1:9095:21071: scene=SP1
#: SP1:9095
msgctxt "text_id=21071 | speaker=unknown"
msgid "　迷うもの、<貧|ひん>するものの味方であり、最近は小金稼ぎに<結|ブ><婚式|ライダル>業にまで手を出した。"
msgstr ""

#. Occurrence SP1:9100:21072: scene=SP1
#: SP1:9100
msgctxt "text_id=21072 | speaker=unknown"
msgid "　三咲市の福祉事業とも密接な関係にあり、運営はそれなりに順調だ。"
msgstr ""

#. Occurrence SP1:9105:21073: scene=SP1
#: SP1:9105
msgctxt "text_id=21073 | speaker=unknown"
msgid "　唯一の問題は、この通り、"
msgstr ""

#. Occurrence SP1:9130:21074: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0000; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9130
msgctxt "text_id=21074 | speaker=yuika"
msgid "「……詠梨神父はまた外出ですか。"
msgstr ""

#. Occurrence SP1:9136:21075: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0001; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9136
msgctxt "text_id=21075 | speaker=yuika"
msgid "　律架もサボタージュ、奉仕の生徒さんたちも日に日に減っていく一方……結局、労働力は私ひとりだけなのですね」"
msgstr ""

#. Occurrence SP1:9142:21076: scene=SP1
#: SP1:9142
msgctxt "text_id=21076 | speaker=unknown"
msgid "　台所事情は安泰でも、慢性的な人手不足だけは解消できないのだった。"
msgstr ""

#. Occurrence SP1:9175:21077: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0002; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9175
msgctxt "text_id=21077 | speaker=yuika"
msgid "「だいたい、この街の人々は信心が足りなさすぎます。"
msgstr ""

#. Occurrence SP1:9181:21078: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0003; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9181
msgctxt "text_id=21078 | speaker=yuika"
msgid "　給金がなければ働けないなど、人生をなんだと思っているのでしょう。物欲だけで構成された一日を過ごしていては、<懐|ふところ>は豊かになっても心が貧しくなるだけでしょうに」"
msgstr ""

#. Occurrence SP1:9206:21079: scene=SP1
#: SP1:9206
msgctxt "text_id=21079 | speaker=unknown"
msgid "　ひとり小言を口にしながら、シスターはひょい、と片手で<脚立|きゃたつ>を持ち上げた。"
msgstr ""

#. Occurrence SP1:9211:21080: scene=SP1
#: SP1:9211
msgctxt "text_id=21080 | speaker=unknown"
msgid "　教会の窓掃除に使う本格的な脚立で、大の大人がふたりがかりでも手に余る重量なのだが、このシスターにはそのあたり気にならないようだ。"
msgstr ""

#. Occurrence SP1:9245:21081: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0004; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9245
msgctxt "text_id=21081 | speaker=yuika"
msgid "「人々の心の<荒廃|こうはい>も気になりますが、物価の上昇も捨て置けません。消費税なるものの導入も<囁|ささや>かれますし、詠梨神父にはもっと、一日で驚異的な成果をあげる結婚式の素晴らしさを知っていただかないと。"
msgstr ""

#. Occurrence SP1:9251:21082: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0005; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9251
msgctxt "text_id=21082 | speaker=yuika"
msgid "　あの人は<誰彼|だれかれ>何彼気分で世話をして、後の事とか考えませんから。裏庭に集まった野良猫たちはどうするんですか。ああ、私ですね、それも私が受け持つのですね。もうなんでもかんでも肉体労働は私なのですね」"
msgstr ""

#. Occurrence SP1:9282:21083: scene=SP1
#: SP1:9282
msgctxt "text_id=21083 | speaker=unknown"
msgid "　もはや完全な小言マシーンと化したシスターの名は、<周瀬|すせ><唯架|ゆいか>。"
msgstr ""

#. Occurrence SP1:9287:21084: scene=SP1
#: SP1:9287
msgctxt "text_id=21084 | speaker=unknown"
msgid "　普段の彼女からは考えられない光景だが、これにはちょっとした理由がある。"
msgstr ""

#. Occurrence SP1:9307:21085: scene=SP1
#: SP1:9307
msgctxt "text_id=21085 | speaker=unknown"
msgid "　彼女は盲目であるが故に、周囲の気配を察する<感覚|センス>が研ぎ澄まされている。"
msgstr ""

#. Occurrence SP1:9312:21086: scene=SP1
#: SP1:9312
msgctxt "text_id=21086 | speaker=unknown"
msgid "　生き物―――特に人間の気配には敏感で、驚くべき事に半径十メートル単位で人の在る無しを判断できる。"
msgstr ""

#. Occurrence SP1:9317:21087: scene=SP1
#: SP1:9317
msgctxt "text_id=21087 | speaker=unknown"
msgid "　いま、彼女が素の自分をさらけだしているのは、周囲に人がいないと感じ取っているからだ。"
msgstr ""

#. Occurrence SP1:9356:21088: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0006; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9356
msgctxt "text_id=21088 | speaker=yuika"
msgid "「ええっと、今日の余り物はっと……ああ、もらい物でジャムの詰め合わせがありましたね。"
msgstr ""

#. Occurrence SP1:9362:21089: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0007; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9362
msgctxt "text_id=21089 | speaker=yuika"
msgid "　……どうなのでしょう、主よ。猫って二日経った岩のように堅いパンでもペーストすればいけるクチなんでしょうか。玉葱だけは出すな、と律架が言っていた気がしますが」"
msgstr ""

#. Occurrence SP1:9382:21090: scene=SP1
#: SP1:9382
msgctxt "text_id=21090 | speaker=unknown"
msgid "　シスターは掃除器具の後片づけをしつつ、先ほどから裏庭でミャーミャーうるさい小動物たちの<夕餉|ゆうげ>の支度をする。"
msgstr ""

#. Occurrence SP1:9387:21091: scene=SP1
#: SP1:9387
msgctxt "text_id=21091 | speaker=unknown"
msgid "　と。"
msgstr ""

#. Occurrence SP1:9399:21092: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0008; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9399
msgctxt "text_id=21092 | speaker=yuika"
msgid "「おや？　新しい迷子ですか？」"
msgstr ""

#. Occurrence SP1:9404:21093: scene=SP1
#: SP1:9404
msgctxt "text_id=21093 | speaker=unknown"
msgid "　盲目のシスターは、ひょこっと教会に現れた、小型犬の気配を感じ取った。"
msgstr ""

#. Occurrence SP1:9437:21094: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0009; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9437
msgctxt "text_id=21094 | speaker=yuika"
msgid "「ごめんなさい、今日は猫限定の日なの。キミがまざってしまったら猫どもが驚くわ。"
msgstr ""

#. Occurrence SP1:9443:21095: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0010; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9443
msgctxt "text_id=21095 | speaker=yuika"
msgid "　餌ならここで恵んであげますから、中に入るのはまた今度にしてくださいね。それ以上入ったら向かいの家の屋根あたりまでご退場願いますよ」"
msgstr ""

#. Occurrence SP1:9463:21096: scene=SP1
#: SP1:9463
msgctxt "text_id=21096 | speaker=unknown"
msgid "　教会の門をくぐろうとする茶色の小型犬を、シスターは足で押しとどめる。"
msgstr ""

#. Occurrence SP1:9468:21097: scene=SP1
#: SP1:9468
msgctxt "text_id=21097 | speaker=unknown"
msgid "　人間でないものには扱いが少々乱暴な唯架だった。"
msgstr ""

#. Occurrence SP1:9503:21098: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0053; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9503
msgctxt "text_id=21098 | speaker=beo"
msgid "「“なにこの<辛気|しんき>くさい生き物？”」"
msgstr ""

#. Occurrence SP1:9509:21099: scene=SP1
#: SP1:9509
msgctxt "text_id=21099 | speaker=unknown"
msgid "　一方、小型犬―――狼の信念はとりあえず隅に追いやった―――に変身したベオは、シスターを障害物としか見ていなかった。"
msgstr ""

#. Occurrence SP1:9529:21100: scene=SP1
#: SP1:9529
msgctxt "text_id=21100 | speaker=unknown"
msgid "　黒い男の匂いはこの先に続いている。"
msgstr ""

#. Occurrence SP1:9534:21101: scene=SP1
#: SP1:9534
msgctxt "text_id=21101 | speaker=unknown"
msgid "　人間なぞどうでもいいカレにとって、立ちふさがるシスターは電柱以下の造形物にすぎない。"
msgstr ""

#. Occurrence SP1:9539:21102: scene=SP1
#: SP1:9539
msgctxt "text_id=21102 | speaker=unknown"
msgid "　なので当然、シスターの言葉なぞ無視して門をすり抜けようとする。"
msgstr ""

#. Occurrence SP1:9572:21103: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0011; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9572
msgctxt "text_id=21103 | speaker=yuika"
msgid "「……え。な、なんでしょう、この色。"
msgstr ""

#. Occurrence SP1:9578:21104: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0012; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9578
msgctxt "text_id=21104 | speaker=yuika"
msgid "　この子、すごい色していますけど……もしかして高級な品種なのでしょうか……だとしたら……」"
msgstr ""

#. Occurrence SP1:9584:21105: scene=SP1
#: SP1:9584
msgctxt "text_id=21105 | speaker=unknown"
msgid "　どこぞのお金持ちのペットかもしれない。"
msgstr ""

#. Occurrence SP1:9589:21106: scene=SP1
#: SP1:9589
msgctxt "text_id=21106 | speaker=unknown"
msgid "　教会に来るという事は、礼拝に来る裕福層の飼い犬である可能性もある。"
msgstr ""

#. Occurrence SP1:9594:21107: scene=SP1
#: SP1:9594
msgctxt "text_id=21107 | speaker=unknown"
msgid "　これは無下にはできない、と蹴りだそうとした足を止める唯架だった。"
msgstr ""

#. Occurrence SP1:9634:21108: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0013; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9634
msgctxt "text_id=21108 | speaker=yuika"
msgid "「ごめんなさいね。詠梨神父が目当てなんでしょうけど、また出かけてしまったの。今日いちばんの餌をあげますから、大人しく帰ってくださいません？」"
msgstr ""

#. Occurrence SP1:9640:21109: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0054; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9640
msgctxt "text_id=21109 | speaker=beo"
msgid "「“ああもう、邪魔、この辛気くさい人！"
msgstr ""

#. Occurrence SP1:9640:21110: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0054; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9640
msgctxt "text_id=21110 | speaker=beo"
msgid "　よし、まわりに誰もいないし、首を噛み折ろ―――”」"
msgstr ""

#. Occurrence SP1:9675:21111: scene=SP1
#: SP1:9675
msgctxt "text_id=21111 | speaker=unknown"
msgid "　飛びかかろうとしたベオの前脚が、急停止する。　"
msgstr ""

#. Occurrence SP1:9681:21112: scene=SP1
#: SP1:9681
msgctxt "text_id=21112 | speaker=unknown"
msgid "　カパッ。"
msgstr ""

#. Occurrence SP1:9687:21113: scene=SP1
#: SP1:9687
msgctxt "text_id=21113 | speaker=unknown"
msgid "　シスターは手にした瓶の蓋をあけて、キラキラ光る液体状のものを小皿にそそいで、"
msgstr ""

msgctxt "text_id=21114 | speaker=unknown"
msgid "小型犬の前に差しだした。"
msgstr ""

#. Occurrence SP1:9722:21115: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0055; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9722
msgctxt "text_id=21115 | speaker=beo"
msgid "「“えっと―――”」"
msgstr ""

#. Occurrence SP1:9728:21116: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0014; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9728
msgctxt "text_id=21116 | speaker=yuika"
msgid "「ほら、お食べ」"
msgstr ""

#. Occurrence SP1:9752:21117: scene=SP1
#: SP1:9752
msgctxt "text_id=21117 | speaker=unknown"
msgid "　差し出された正体不明の液体。"
msgstr ""

#. Occurrence SP1:9757:21118: scene=SP1
#: SP1:9757
msgctxt "text_id=21118 | speaker=unknown"
msgid "　それはまたしても、カレにとってはじめて嗅ぐ匂いだった。"
msgstr ""

#. Occurrence SP1:9762:21119: scene=SP1
#: SP1:9762
msgctxt "text_id=21119 | speaker=unknown"
msgid "　好奇心にはひたすらに弱いベオである。"
msgstr ""

#. Occurrence SP1:9767:21120: scene=SP1
#: SP1:9767
msgctxt "text_id=21120 | speaker=unknown"
msgid "　たとえ毒が入っていようと、自然界の毒ならカレには通じない。"
msgstr ""

#. Occurrence SP1:9772:21121: scene=SP1
#: SP1:9772
msgctxt "text_id=21121 | speaker=unknown"
msgid "　ぺろりと一口舐める。"
msgstr ""

#. Occurrence SP1:9807:21122: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0056; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9807
msgctxt "text_id=21122 | speaker=beo"
msgid "「“――――――なに”」"
msgstr ""

#. Occurrence SP1:9812:21123: scene=SP1
#: SP1:9812
msgctxt "text_id=21123 | speaker=unknown"
msgid "　すこし舐める。"
msgstr ""

#. Occurrence SP1:9818:21124: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0057; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9818
msgctxt "text_id=21124 | speaker=beo"
msgid "「“――――――この”」"
msgstr ""

#. Occurrence SP1:9823:21125: scene=SP1
#: SP1:9823
msgctxt "text_id=21125 | speaker=unknown"
msgid "　さらに舐める。"
msgstr ""

#. Occurrence SP1:9829:21126: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0058; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9829
msgctxt "text_id=21126 | speaker=beo"
msgid "「“――――――あじ！”」"
msgstr ""

#. Occurrence SP1:9834:21127: scene=SP1
#: SP1:9834
msgctxt "text_id=21127 | speaker=unknown"
msgid "　もっと舐める。"
msgstr ""

#. Occurrence SP1:9865:21128: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0015; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9865
msgctxt "text_id=21128 | speaker=yuika"
msgid "「おや。牛乳を飲むような舐めっぷり。"
msgstr ""

#. Occurrence SP1:9865:21129: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0015; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9865
msgctxt "text_id=21129 | speaker=yuika"
msgid "　犬ながら惚れ惚れします」"
msgstr ""

#. Occurrence SP1:9871:21130: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0059; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9871
msgctxt "text_id=21130 | speaker=beo"
msgid "「“これ、もっとほしい！”」"
msgstr ""

#. Occurrence SP1:9877:21131: scene=SP1
#: SP1:9877
msgctxt "text_id=21131 | speaker=unknown"
msgid "　夕暮れの教会に、ワン、と元気な吠え声が響きわたる。"
msgstr ""

#. Occurrence SP1:9882:21132: scene=SP1
#: SP1:9882
msgctxt "text_id=21132 | speaker=unknown"
msgid "　この時点で、ベオにとって男の匂いなぞどうでもいい物になっていた。"
msgstr ""

#. Occurrence SP1:9909:21133: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0016; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9909
msgctxt "text_id=21133 | speaker=yuika"
msgid "「ふふ、甘いですか？　私も感動しました。"
msgstr ""

#. Occurrence SP1:9909:21134: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0016; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9909
msgctxt "text_id=21134 | speaker=yuika"
msgid "　犬どもにも甘味をたしなむ心があるのですね」"
msgstr ""

#. Occurrence SP1:9928:21135: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0060; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9928
msgctxt "text_id=21135 | speaker=beo"
msgid "「“甘い？　これが甘いってコト？”」"
msgstr ""

#. Occurrence SP1:9934:21136: scene=SP1
#: SP1:9934
msgctxt "text_id=21136 | speaker=unknown"
msgid "　シスターの呟きに、ベオはハッと顔をあげた。"
msgstr ""

#. Occurrence SP1:9939:21137: scene=SP1
#: SP1:9939
msgctxt "text_id=21137 | speaker=unknown"
msgid "　今の単語はなんだか大切な気がする。"
msgstr ""

#. Occurrence SP1:9944:21138: scene=SP1
#: SP1:9944
msgctxt "text_id=21138 | speaker=unknown"
msgid "　そもそもこの食べ物が閃光のような衝撃だった。"
msgstr ""

#. Occurrence SP1:9986:21139: scene=SP1
#: SP1:9986
msgctxt "text_id=21139 | speaker=unknown"
msgid "　ベオにとって、食事は燃料補給のパターンの一つにすぎない。"
msgstr ""

#. Occurrence SP1:9991:21140: scene=SP1
#: SP1:9991
msgctxt "text_id=21140 | speaker=unknown"
msgid "　ハンバーガーのえり好みはあるが、あれはあくまで“噛みごこち”の良し悪しだった。どうせ栄養摂取をしなくちゃいけないのだから、仕方なく食べているにすぎない。"
msgstr ""

#. Occurrence SP1:9997:21141: scene=SP1
#: SP1:9997
msgctxt "text_id=21141 | speaker=unknown"
msgid "　が、これは違う。肉食動物の“命”を燃料にするカレにとって、この食べ物はまったく意味がない。"
msgstr ""

#. Occurrence SP1:10029:21142: scene=SP1
#: SP1:10029
msgctxt "text_id=21142 | speaker=unknown"
msgid "　けれど、もっと食べたい。"
msgstr ""

#. Occurrence SP1:10034:21143: scene=SP1
#: SP1:10034
msgctxt "text_id=21143 | speaker=unknown"
msgid "　必要はないけど、これはなんていうか、すごく気持ちのいいものだ。"
msgstr ""

#. Occurrence SP1:10039:21144: scene=SP1
#: SP1:10039
msgctxt "text_id=21144 | speaker=unknown"
msgid "　体ではなく、心の栄養になるような。"
msgstr ""

#. Occurrence SP1:10060:21145: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0061; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10060
msgctxt "text_id=21145 | speaker=beo"
msgid "「“―――あれ、そもそもこの匂いって―――”」"
msgstr ""

#. Occurrence SP1:10066:21146: scene=SP1
#: SP1:10066
msgctxt "text_id=21146 | speaker=unknown"
msgid "　むむ、と振りまくっていた尻尾が止まる。"
msgstr ""

#. Occurrence SP1:10071:21147: scene=SP1
#: SP1:10071
msgctxt "text_id=21147 | speaker=unknown"
msgid "　小型犬に<扮|ふん>した黄金の狼は、自分の名前の由来である食べ物を前にして、解けない難問につきあたるのだった。"
msgstr ""

#. Occurrence SP1:10155:21148: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0062; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10155
msgctxt "text_id=21148 | speaker=beo"
msgid "「ただいまー」"
msgstr ""

#. Occurrence SP1:10174:21149: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0120; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10174
msgctxt "text_id=21149 | speaker=touko"
msgid "「はい、お帰りなさいベオくん。"
msgstr ""

#. Occurrence SP1:10180:21150: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0121; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10180
msgctxt "text_id=21150 | speaker=touko"
msgid "　遅いお帰りにお姉さん心配しちゃった。こんな時間まで無断外出とか心配したゾ。教育係<兼|けん>飼い主として、バッボーイしなくちゃいけないからそこに正座」"
msgstr ""

#. Occurrence SP1:10201:21151: scene=SP1
#: SP1:10201
msgctxt "text_id=21151 | speaker=unknown"
msgid "　ベオがヒト形に変身して工房に戻ると、笑顔でこめかみをひくつかせた蒼崎橙子が待っていた。"
msgstr ""

#. Occurrence SP1:10225:21152: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0063; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10225
msgctxt "text_id=21152 | speaker=beo"
msgid "「あ、そうか」"
msgstr ""

#. Occurrence SP1:10230:21153: scene=SP1
#: SP1:10230
msgctxt "text_id=21153 | speaker=unknown"
msgid "　失敗しちゃった、とベオは素直に反省する。"
msgstr ""

#. Occurrence SP1:10235:21154: scene=SP1
#: SP1:10235
msgctxt "text_id=21154 | speaker=unknown"
msgid "　シスターとの一件で、先回りして帰る事を失念していた。"
msgstr ""

#. Occurrence SP1:10262:21155: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0064; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10262
msgctxt "text_id=21155 | speaker=beo"
msgid "「えー、正座はいやですー。"
msgstr ""

#. Occurrence SP1:10268:21156: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0065; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10268
msgctxt "text_id=21156 | speaker=beo"
msgid "　そりゃあ無断で外に出てたけど、誰にも見つかってないし。別にボク、悪いことしてないし」"
msgstr ""

#. Occurrence SP1:10274:21157: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0122; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10274
msgctxt "text_id=21157 | speaker=touko"
msgid "「誰にも見つかっていない？"
msgstr ""

#. Occurrence SP1:10280:21158: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0123; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10280
msgctxt "text_id=21158 | speaker=touko"
msgid "　ってコトはベオくん、裏山で遊んでたの？」"
msgstr ""

#. Occurrence SP1:10292:21159: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0066; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10292
msgctxt "text_id=21159 | speaker=beo"
msgid "「ううん、裏山じゃなくて町。気付かなかったでしょ、実はトーコさんを尾行していただけなのです！」"
msgstr ""

#. Occurrence SP1:10325:21160: scene=SP1
#: SP1:10325
msgctxt "text_id=21160 | speaker=unknown"
msgid "　予想外の返答に固まる橙子。"
msgstr ""

#. Occurrence SP1:10335:21161: scene=SP1
#: SP1:10335
msgctxt "text_id=21161 | speaker=unknown"
msgid "　が、さすがにカレの扱いには慣れたものなのか、そう、とため息で頭痛を押さえこんだ。"
msgstr ""

#. Occurrence SP1:10356:21162: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0124; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10356
msgctxt "text_id=21162 | speaker=touko"
msgid "「……いいでしょう。見つからなければ<悪戯|いたずら>じゃない、と教えたのは私だしね。主人の尾行禁止、とは命令していなかったし。今回の尾行については不問に付します。"
msgstr ""

#. Occurrence SP1:10367:21163: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0125; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10367
msgctxt "text_id=21163 | speaker=touko"
msgid "　でも、どうやって人目を避けたの？　その格好だったらさすがに気付くと思うんだけど、私」"
msgstr ""

#. Occurrence SP1:10402:21164: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0067; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10402
msgctxt "text_id=21164 | speaker=beo"
msgid "「そこはキギョウヒミツです。教えたら今日みたいなトーコさん、もう見れなくなっちゃうし。楽しそうだったよね、あのヒトと」"
msgstr ""

#. Occurrence SP1:10421:21165: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0126; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10421
msgctxt "text_id=21165 | speaker=touko"
msgid "「……！」"
msgstr ""

#. Occurrence SP1:10437:21166: scene=SP1
#: SP1:10437
msgctxt "text_id=21166 | speaker=unknown"
msgid "　らしくなく、素直に反応する橙子。"
msgstr ""

#. Occurrence SP1:10442:21167: scene=SP1
#: SP1:10442
msgctxt "text_id=21167 | speaker=unknown"
msgid "　そんな雇い主の動揺に、ベオも意表をつかれてしまった。"
msgstr ""

#. Occurrence SP1:10477:21168: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0127; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10477
msgctxt "text_id=21168 | speaker=touko"
msgid "「それは違う。どんな勘違いをしたのか知らないけど、アレはただの交渉よ。教会の神父相手に、町を人質に見立てて不干渉を念押ししただけで、」"
msgstr ""

#. Occurrence SP1:10483:21169: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0068; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10483
msgctxt "text_id=21169 | speaker=beo"
msgid "「いや、楽しそうに見えたのは女のヒトの方だけど。"
msgstr ""

#. Occurrence SP1:10489:21170: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0069; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10489
msgctxt "text_id=21170 | speaker=beo"
msgid "　あの、全身ぐるぐる巻きに自分を縛ってた方」"
msgstr ""

#. Occurrence SP1:10495:21171: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0128; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10495
msgctxt "text_id=21171 | speaker=touko"
msgid "「むっ」"
msgstr ""

#. Occurrence SP1:10530:21172: scene=SP1
#: SP1:10530
msgctxt "text_id=21172 | speaker=unknown"
msgid "　しばし無言で見つめ合う一人と一匹。"
msgstr ""

#. Occurrence SP1:10535:21173: scene=SP1
#: SP1:10535
msgctxt "text_id=21173 | speaker=unknown"
msgid "　野生のカレは、ふーん、と訳知り顔で納得して、"
msgstr ""

#. Occurrence SP1:10547:21174: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0070; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10547
msgctxt "text_id=21174 | speaker=beo"
msgid "「………………。"
msgstr ""

#. Occurrence SP1:10559:21175: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0071; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10559
msgctxt "text_id=21175 | speaker=beo"
msgid "　つまり、アレってトーコさんのつがい？」"
msgstr ""

#. Occurrence SP1:10578:21176: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0129; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10578
msgctxt "text_id=21176 | speaker=touko"
msgid "「っ……！」"
msgstr ""

#. Occurrence SP1:10583:21177: scene=SP1
#: SP1:10583
msgctxt "text_id=21177 | speaker=unknown"
msgid "　蒼崎橙子をして吹き出させる、神をも恐れぬ疑問を投げかけた。"
msgstr ""

#. Occurrence SP1:10609:21178: scene=SP1
#: SP1:10609
msgctxt "text_id=21178 | speaker=unknown"
msgid "　人形師は無言で眼鏡を外して、まなじりを強く押さえた。"
msgstr ""

#. Occurrence SP1:10620:21179: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0130; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10620
msgctxt "text_id=21179 | speaker=touko"
msgid "「なんでそんな言葉だけ知ってるんだオマエは。"
msgstr ""

#. Occurrence SP1:10620:21180: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0130; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10620
msgctxt "text_id=21180 | speaker=touko"
msgid "　<耳年増|みみどしま>にも程があるぞ」"
msgstr ""

#. Occurrence SP1:10652:21181: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0072; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10652
msgctxt "text_id=21181 | speaker=beo"
msgid "「こんなの、生き物としてフツーの言葉じゃない。"
msgstr ""

#. Occurrence SP1:10658:21182: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0073; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10658
msgctxt "text_id=21182 | speaker=beo"
msgid "　……まあ、トーコさんがフツーの生き物だとは思っていなかったから、ボクとしても意外だけど。"
msgstr ""

#. Occurrence SP1:10669:21183: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0074; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10669
msgctxt "text_id=21183 | speaker=beo"
msgid "　それで、どうなの？　あのパッとしないポテトみたいな<雄|おす>、なに？」"
msgstr ""

#. Occurrence SP1:10689:21184: scene=SP1
#: SP1:10689
msgctxt "text_id=21184 | speaker=unknown"
msgid "　何が気に食わないのか、ベオは唐突に不機嫌になった。"
msgstr ""

#. Occurrence SP1:10694:21185: scene=SP1
#: SP1:10694
msgctxt "text_id=21185 | speaker=unknown"
msgid "　ベオ自身、自分が<苛|いら>ついている事は理解できたが、なぜ苛ついているのかまでは理解できていない。"
msgstr ""

#. Occurrence SP1:10736:21186: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0131; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10736
msgctxt "text_id=21186 | speaker=touko"
msgid "「何もなにも、オマエの言う通りしなびたフライドポテトだよ。少なくとも私にとってはね。気にする価値もないし、食べたくなるような魅力もない」"
msgstr ""

#. Occurrence SP1:10747:21187: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0075; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10747
msgctxt "text_id=21187 | speaker=beo"
msgid "「ホント？　ただの敵？　トーコさんにとって特別なのは、ボクだけ？」"
msgstr ""

#. Occurrence SP1:10774:21188: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0132; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10774
msgctxt "text_id=21188 | speaker=touko"
msgid "「ああ、今のところはね。"
msgstr ""

#. Occurrence SP1:10780:21189: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0133; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10780
msgctxt "text_id=21189 | speaker=touko"
msgid "　……やけぼっくいに火がつくかとも思ったが、完全に<湿気|しけ>っていた。アレを前にしてどうこう思うのは、もう二度とないだろうさ」"
msgstr ""

#. Occurrence SP1:10791:21190: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0076; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10791
msgctxt "text_id=21190 | speaker=beo"
msgid "「そっか！　なんでもないならもう忘れるコトにしまーす！　でも、ヤケボックイってなに？」"
msgstr ""

#. Occurrence SP1:10826:21191: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0134; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10826
msgctxt "text_id=21191 | speaker=touko"
msgid "「思い出を蒸し返して、前後不覚におちいるコト。"
msgstr ""

#. Occurrence SP1:10832:21192: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0135; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10832
msgctxt "text_id=21192 | speaker=touko"
msgid "　ま、その可能性だって少しはあったと思うよ。あんなんでも、私の初恋の相手のようだし」"
msgstr ""

#. Occurrence SP1:10838:21193: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0077; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10838
msgctxt "text_id=21193 | speaker=beo"
msgid "「へ？」"
msgstr ""

#. Occurrence SP1:10843:21194: scene=SP1
#: SP1:10843
msgctxt "text_id=21194 | speaker=unknown"
msgid "　恋は未経験なれど、初恋の意味ぐらいは知っているベオだった。"
msgstr ""

#. Occurrence SP1:10864:21195: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0078; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10864
msgctxt "text_id=21195 | speaker=beo"
msgid "「ハツコイって、トーコさんに！？」"
msgstr ""

#. Occurrence SP1:10870:21196: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0136; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10870
msgctxt "text_id=21196 | speaker=touko"
msgid "「……つがいはアリで初恋はナシとか、どれだけ私を動物的に観ているんだ、オマエは。"
msgstr ""

#. Occurrence SP1:10876:21197: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0137; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10876
msgctxt "text_id=21197 | speaker=touko"
msgid "　昔の話だよ。私が十代になったばかりで、<詠梨|アレ>が祖父の弟子だった頃の話だ。ヤツは魔術ではなく、精神修行の一環として祖父と付き合っていたが」"
msgstr ""

#. Occurrence SP1:10905:21198: scene=SP1
#: SP1:10905
msgctxt "text_id=21198 | speaker=unknown"
msgid "　淡々と語る橙子の横顔から、未練らしきものは見られない。"
msgstr ""

#. Occurrence SP1:10910:21199: scene=SP1
#: SP1:10910
msgctxt "text_id=21199 | speaker=unknown"
msgid "　なのにこう、普段より<言霊|ことだま>に温かみがある、とベオは眉を曇らせた。"
msgstr ""

#. Occurrence SP1:10946:21200: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0079; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10946
msgctxt "text_id=21200 | speaker=beo"
msgid "「トーコさん、まだスキなわけ？」"
msgstr ""

#. Occurrence SP1:10957:21201: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0138; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10957
msgctxt "text_id=21201 | speaker=touko"
msgid "「いや。自分でも呆れるぐらい何もなかった。"
msgstr ""

#. Occurrence SP1:10963:21202: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0139; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10963
msgctxt "text_id=21202 | speaker=touko"
msgid "　ただ青春の幻影というのかな。そういう頃の象徴のような知人とは、話すだけで懐かしいものなんだよ。"
msgstr ""

#. Occurrence SP1:10969:21203: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0140; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10969
msgctxt "text_id=21203 | speaker=touko"
msgid "　人間的にはまったく魅力を感じなくなったが、ヤツと話しているだけで、こう、昔の自分を思い返して笑いたくなる」"
msgstr ""

#. Occurrence SP1:10989:21204: scene=SP1
#: SP1:10989
msgctxt "text_id=21204 | speaker=unknown"
msgid "　<感慨|かんがい>深く語る橙子に、ベオはますます首を<傾|かし>げる。"
msgstr ""

#. Occurrence SP1:10994:21205: scene=SP1
#: SP1:10994
msgctxt "text_id=21205 | speaker=unknown"
msgid "　すごく嫌いなのにわりと好き、というのは理屈に合わない気がするからだ。"
msgstr ""

#. Occurrence SP1:11021:21206: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0080; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11021
msgctxt "text_id=21206 | speaker=beo"
msgid "「そういうの、ボク分かんないなー」"
msgstr ""

#. Occurrence SP1:11033:21207: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0141; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11033
msgctxt "text_id=21207 | speaker=touko"
msgid "「オマエには好き嫌いがないからな。<理屈|ロジック>だけじゃヒトの関係は解けないよ」"
msgstr ""

#. Occurrence SP1:11045:21208: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0081; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11045
msgctxt "text_id=21208 | speaker=beo"
msgid "「そんなのありますー！"
msgstr ""

#. Occurrence SP1:11045:21209: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0081; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11045
msgctxt "text_id=21209 | speaker=beo"
msgid "　食べ物だってえり好みするじゃんか、ボク！」"
msgstr ""

#. Occurrence SP1:11082:21210: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0142; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11082
msgctxt "text_id=21210 | speaker=touko"
msgid "「オマエの基準は有益か無益かだけだろ。"
msgstr ""

#. Occurrence SP1:11088:21211: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0143; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11088
msgctxt "text_id=21211 | speaker=touko"
msgid "　野生動物にとって味覚は、十分な栄養値があるかないかを測るセンサーでしかない。"
msgstr ""

#. Occurrence SP1:11094:21212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0144; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11094
msgctxt "text_id=21212 | speaker=touko"
msgid "　栄養値を度外視して食事をとるのは人間だけだ。"
msgstr ""

#. Occurrence SP1:11100:21213: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0145; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11100
msgctxt "text_id=21213 | speaker=touko"
msgid "　……自分の体に合っているからその食材を好む、ではないんだよ。ヒトは \"楽しい\" か \"楽しくない\" かで食事をとる。好きなものが甘く見えるのはその為だ」"
msgstr ""

#. Occurrence SP1:11131:21214: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0082; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11131
msgctxt "text_id=21214 | speaker=beo"
msgid "「甘いもの―――好きなものって、甘く見えるの？」"
msgstr ""

#. Occurrence SP1:11137:21215: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0146; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11137
msgctxt "text_id=21215 | speaker=touko"
msgid "「物の喩えだが、苦くは見えないだろ。……まあ、ヒトによってはそれもありだが。"
msgstr ""

#. Occurrence SP1:11143:21216: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0147; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11143
msgctxt "text_id=21216 | speaker=touko"
msgid "　そのあたりはアレだな、性癖の問題だ。"
msgstr ""

#. Occurrence SP1:11149:21217: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0148; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11149
msgctxt "text_id=21217 | speaker=touko"
msgid "　たまごが先か、にわとりが先かの話さ。好きだから甘いのか、甘いから好きなのか、とね」"
msgstr ""

#. Occurrence SP1:11176:21218: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0083; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11176
msgctxt "text_id=21218 | speaker=beo"
msgid "「でもボク、トーコさんは甘く見えないけど」"
msgstr ""

#. Occurrence SP1:11197:21219: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0149; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11197
msgctxt "text_id=21219 | speaker=touko"
msgid "「そりゃそうだろ。そもそもオマエはまだ“生きて”いないからな。"
msgstr ""

#. Occurrence SP1:11203:21220: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0150; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11203
msgctxt "text_id=21220 | speaker=touko"
msgid "　在るだけのモノと、生きているコトはまた別の話だ。"
msgstr ""

#. Occurrence SP1:11209:21221: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0151; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11209
msgctxt "text_id=21221 | speaker=touko"
msgid "　皮肉な話だがね。その違いを知った時、オマエは無敵ではなくなるよ、ベオ」"
msgstr ""

#. Occurrence SP1:11220:21222: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0084; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11220
msgctxt "text_id=21222 | speaker=beo"
msgid "「――――――」"
msgstr ""

#. Occurrence SP1:11245:21223: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0152; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11245
msgctxt "text_id=21223 | speaker=touko"
msgid "「さ、夕食だ。今日も大勝したからな、<霜降|しもふ>りのいいところを買ってきたぞ」"
msgstr ""

#. Occurrence SP1:11263:21224: scene=SP1
#: SP1:11263
msgctxt "text_id=21224 | speaker=unknown"
msgid "　雇い主はいつもの調子で教室に入っていった。"
msgstr ""

#. Occurrence SP1:11268:21225: scene=SP1
#: SP1:11268
msgctxt "text_id=21225 | speaker=unknown"
msgid "　ベオは浮かない顔で廊下に佇む。"
msgstr ""

#. Occurrence SP1:11273:21226: scene=SP1
#: SP1:11273
msgctxt "text_id=21226 | speaker=unknown"
msgid "“オマエはまだ生きていない”"
msgstr ""

#. Occurrence SP1:11278:21227: scene=SP1
#: SP1:11278
msgctxt "text_id=21227 | speaker=unknown"
msgid "　その台詞はベオの心をざわめかせたが、なぜそう思うのか、今のカレには分からない。"
msgstr ""

#. Occurrence SP1:11312:21228: scene=SP1
#: SP1:11312
msgctxt "text_id=21228 | speaker=unknown"
msgid "　その答えの手がかりを得るのは、これから約三週間後。"
msgstr ""

#. Occurrence SP1:11317:21229: scene=SP1
#: SP1:11317
msgctxt "text_id=21229 | speaker=unknown"
msgid "　完全であるルゥ・ベオウルフが、"
msgstr ""

#. Occurrence SP1:11322:21230: scene=SP1
#: SP1:11322
msgctxt "text_id=21230 | speaker=unknown"
msgid "　まったく完全でない生き物に、"
msgstr ""

#. Occurrence SP1:11322:21231: scene=SP1
#: SP1:11322
msgctxt "text_id=21231 | speaker=unknown"
msgid "　あっさり黒星をつけられた後のコトになる。"
msgstr ""

#. Occurrence SP1:11377:21232: scene=SP1
#: SP1:11377
msgctxt "text_id=21232 | speaker=unknown"
msgid "　無人の校舎に場違いな<呼び鈴|コール>が響き渡る。"
msgstr ""

#. Occurrence SP1:11399:21233: scene=SP1
#: SP1:11399
msgctxt "text_id=21233 | speaker=unknown"
msgid "　建物を改築した主も、"
msgstr ""

#. Occurrence SP1:11404:21234: scene=SP1
#: SP1:11404
msgctxt "text_id=21234 | speaker=unknown"
msgid "　その主を撃退した魔法使いも退場して<久|ひさ>しい、一月某日。"
msgstr ""

#. Occurrence SP1:11409:21235: scene=SP1
#: SP1:11409
msgctxt "text_id=21235 | speaker=unknown"
msgid "　蒼崎橙子が気まぐれで取り付けていった電話機は、そこに誰かがいる事を確信しているように、飽きることなく鳴り続けていた。"
msgstr ""

#. Occurrence SP1:11438:21236: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0085; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11438
msgctxt "text_id=21236 | speaker=beo"
msgid "「ああもう、うるさいなあ」"
msgstr ""

#. Occurrence SP1:11444:21237: scene=SP1
#: SP1:11444
msgctxt "text_id=21237 | speaker=unknown"
msgid "　そんな中、ごそり、と動く気配があった。"
msgstr ""

#. Occurrence SP1:11449:21238: scene=SP1
#: SP1:11449
msgctxt "text_id=21238 | speaker=unknown"
msgid "　校舎は無人には違いないが、人間ではないモノが一つ、いまだ<寝床|ねどこ>にしていたらしい。"
msgstr ""

#. Occurrence SP1:11498:21239: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0086; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11498
msgctxt "text_id=21239 | speaker=beo"
msgid "「はい、こちらガランノドウ第二出張店ー。"
msgstr ""

#. Occurrence SP1:11504:21240: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0087; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11504
msgctxt "text_id=21240 | speaker=beo"
msgid "　店主はシッポまいて逃げだしたアトですので、ご用のある方は発信音のアトにメッセージを――あ、トーコさん？"
msgstr ""

#. Occurrence SP1:11510:21241: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0088; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11510
msgctxt "text_id=21241 | speaker=beo"
msgid "　うん、はいはい。どーぞ行ってらっしゃい、ボクのコトはお構いなく」"
msgstr ""

#. Occurrence SP1:11548:21242: scene=SP1
#: SP1:11548
msgctxt "text_id=21242 | speaker=unknown"
msgid "　教室に居たのは金髪の少年だ。"
msgstr ""

#. Occurrence SP1:11553:21243: scene=SP1
#: SP1:11553
msgctxt "text_id=21243 | speaker=unknown"
msgid "　ソレは呼び鈴が鳴る前からヒトの姿をしていた。"
msgstr ""

#. Occurrence SP1:11558:21244: scene=SP1
#: SP1:11558
msgctxt "text_id=21244 | speaker=unknown"
msgid "　かつて、ひとりきりでいる時は狼の姿で微睡みに落ちていたが、今は違う。"
msgstr ""

#. Occurrence SP1:11563:21245: scene=SP1
#: SP1:11563
msgctxt "text_id=21245 | speaker=unknown"
msgid "　ソレはそうである必要もないのに、ヒトのカタチを維持している。"
msgstr ""

#. Occurrence SP1:11568:21246: scene=SP1
#: SP1:11568
msgctxt "text_id=21246 | speaker=unknown"
msgid "　どのような心境の変化か、戦闘時以外はこちらの姿を“平常”に切り替えていた。"
msgstr ""

#. Occurrence SP1:11594:21247: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0089; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11594
msgctxt "text_id=21247 | speaker=beo"
msgid "「じゃ、必要になったら呼んでよね。契約は切れたけど、ボクはまだトーコさんの使い魔だし。"
msgstr ""

#. Occurrence SP1:11600:21248: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0090; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11600
msgctxt "text_id=21248 | speaker=beo"
msgid "　うん、そう、嫌味なんかじゃないって。狼はね、誇り高いんだよ。トーコさん以上の雇い主が見つかるまで、首輪はそっちに預けておきます」"
msgstr ""

#. Occurrence SP1:11635:21249: scene=SP1
#: SP1:11635
msgctxt "text_id=21249 | speaker=unknown"
msgid "　ふと、ソレは受話器の向こうの相手が、どこを旅しているのか気になった。"
msgstr ""

#. Occurrence SP1:11640:21250: scene=SP1
#: SP1:11640
msgctxt "text_id=21250 | speaker=unknown"
msgid "　彼女は敗北を認め、使い魔との契約を<断|た>った。"
msgstr ""

#. Occurrence SP1:11645:21251: scene=SP1
#: SP1:11645
msgctxt "text_id=21251 | speaker=unknown"
msgid "　魔法の相手をさせてやる、という約束を違えたからだという。"
msgstr ""

#. Occurrence SP1:11650:21252: scene=SP1
#: SP1:11650
msgctxt "text_id=21252 | speaker=unknown"
msgid "　けれどそれは使い魔の落ち度であって彼女の責任ではない。護衛役としては、ソレはまだ仕事を果たしていないのだ。"
msgstr ""

#. Occurrence SP1:11686:21253: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0091; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11686
msgctxt "text_id=21253 | speaker=beo"
msgid "「で、トーコさんはいまどこ？」"
msgstr ""

#. Occurrence SP1:11692:21254: scene=SP1
#: SP1:11692
msgctxt "text_id=21254 | speaker=unknown"
msgid "　受話器からは聞き慣れない国の名前。"
msgstr ""

#. Occurrence SP1:11697:21255: scene=SP1
#: SP1:11697
msgctxt "text_id=21255 | speaker=unknown"
msgid "　彼女は呪いの解呪手段を開発する為、早々に日本を発ったのだ。"
msgstr ""

#. Occurrence SP1:11718:21256: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0092; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11718
msgctxt "text_id=21256 | speaker=beo"
msgid "「なにが敗北を認めた、だよ。"
msgstr ""

#. Occurrence SP1:11724:21257: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0093; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11724
msgctxt "text_id=21257 | speaker=beo"
msgid "　それって、まだ諦めてないってコトじゃん」"
msgstr ""

#. Occurrence SP1:11730:21258: scene=SP1
#: SP1:11730
msgctxt "text_id=21258 | speaker=unknown"
msgid "　まったくだ、と笑い声が返ってくる。"
msgstr ""

#. Occurrence SP1:11735:21259: scene=SP1
#: SP1:11735
msgctxt "text_id=21259 | speaker=unknown"
msgid "　受話器の向こうからは、なんとなく、熱帯の香りがした。"
msgstr ""

#. Occurrence SP1:11740:21260: scene=SP1
#: SP1:11740
msgctxt "text_id=21260 | speaker=unknown"
msgid "　それが蒼崎橙子お手製の電話機による神秘か、"
msgstr ""

#. Occurrence SP1:11745:21261: scene=SP1
#: SP1:11745
msgctxt "text_id=21261 | speaker=unknown"
msgid "　ソレ自身の超感覚によるものかは分からない。"
msgstr ""

#. Occurrence SP1:11777:21262: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0094; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11777
msgctxt "text_id=21262 | speaker=beo"
msgid "「じゃ、さっさと帰ってきてね。ボクはこっちに残ってるから、美味しいお土産、よろしく」"
msgstr ""

#. Occurrence SP1:11783:21263: scene=SP1
#: SP1:11783
msgctxt "text_id=21263 | speaker=unknown"
msgid "　なぜ？　と受話器から声がする。"
msgstr ""

#. Occurrence SP1:11788:21264: scene=SP1
#: SP1:11788
msgctxt "text_id=21264 | speaker=unknown"
msgid "　彼女の使い魔を続けると決めたのなら、この土地に残る道理はないのだから。"
msgstr ""

#. Occurrence SP1:11822:21265: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0095; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11822
msgctxt "text_id=21265 | speaker=beo"
msgid "「んー……実はボクも、よく分かんない、だけど」"
msgstr ""

#. Occurrence SP1:11828:21266: scene=SP1
#: SP1:11828
msgctxt "text_id=21266 | speaker=unknown"
msgid "　ソレは言葉を詰まらせながら、胸に手をペタペタと当てて、以前味わった痛みを<反芻|はんすう>して、"
msgstr ""

#. Occurrence SP1:11859:21267: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0096; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11859
msgctxt "text_id=21267 | speaker=beo"
msgid "「えへへ。まあ、なんといいましょうか。"
msgstr ""

#. Occurrence SP1:11865:21268: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0097; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11865
msgctxt "text_id=21268 | speaker=beo"
msgid "　ここにいれば甘いってどんなものか、分かるような気がするのです」"
msgstr ""

#. Occurrence SP1:11871:21269: scene=SP1
#: SP1:11871
msgctxt "text_id=21269 | speaker=unknown"
msgid "　無駄を知った狼は、どことなく楽しそうな声で、今後の目的を口にした。"
msgstr ""

#. Occurrence SP1:11890:21270: scene=SP1
#: SP1:11890
msgctxt "text_id=21270 | speaker=unknown"
msgid "　これもまた<初恋|はちみつ>に関する、極めて稀少な<事件|ケース>である。"
msgstr ""

#. Occurrence WIK_B_1_A:47:21271: scene=WIK_B_1_A
#: WIK_B_1_A:47
msgctxt "text_id=21271 | speaker=unknown"
msgid "　東館に入ると、すぐに蒼崎が待っていた。"
msgstr ""

#. Occurrence WIK_B_1_A:53:21272: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_1_A
#: WIK_B_1_A:53
msgctxt "text_id=21272 | speaker=kojika"
msgid "「ごめん、待たせた？」"
msgstr ""

#. Occurrence WIK_B_1_A:62:21273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1_A
#: WIK_B_1_A:62
msgctxt "text_id=21273 | speaker=aoko"
msgid "「ん、別に。私も今のところやる事ないし。"
msgstr ""

#. Occurrence WIK_B_1_A:74:21274: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_1_A
#: WIK_B_1_A:74
msgctxt "text_id=21274 | speaker=aoko"
msgid "　とりあえず中に入って。顔見知りばっかりだけど、一応挨拶はしておかないとね」"
msgstr ""

#. Occurrence WIK_B_1_A:79:21275: scene=WIK_B_1_A
#: WIK_B_1_A:79
msgctxt "text_id=21275 | speaker=unknown"
msgid "　親しき仲にも礼儀あり、という事だろう。"
msgstr ""

#. Occurrence WIK_B_1_A:84:21276: scene=WIK_B_1_A
#: WIK_B_1_A:84
msgctxt "text_id=21276 | speaker=unknown"
msgid "　彼女らしい律儀な台詞と共に、ドアノブは回された。"
msgstr ""

#. Occurrence WIK_B_1_B:110:21277: scene=WIK_B_1_B
#: WIK_B_1_B:110
msgctxt "text_id=21277 | speaker=unknown"
msgid "　中に入るなり、わたしは飛び上がりそうになる自分の体を押さえつけるハメになった。"
msgstr ""

#. Occurrence WIK_B_1_B:115:21278: scene=WIK_B_1_B
#: WIK_B_1_B:115
msgctxt "text_id=21278 | speaker=unknown"
msgid "　ロビーに比べたら親しみのある居間の様子にホッとする暇もない。"
msgstr ""

#. Occurrence WIK_B_1_B:120:21279: scene=WIK_B_1_B
#: WIK_B_1_B:120
msgctxt "text_id=21279 | speaker=unknown"
msgid "　そこには、見知っているけど予想外の顔があったからだ。"
msgstr ""

#. Occurrence WIK_B_1_B:167:21280: scene=WIK_B_1_B
#: WIK_B_1_B:167
msgctxt "text_id=21280 | speaker=unknown"
msgid "　まず彼女、久遠寺有珠。"
msgstr ""

#. Occurrence WIK_B_1_B:172:21281: scene=WIK_B_1_B
#: WIK_B_1_B:172
msgctxt "text_id=21281 | speaker=unknown"
msgid "　顔を合わせたのは一度か二度だけなので緊張はするが、予想外ではない。"
msgstr ""

#. Occurrence WIK_B_1_B:228:21282: scene=WIK_B_1_B
#: WIK_B_1_B:228
msgctxt "text_id=21282 | speaker=unknown"
msgid "　次にベオ。"
msgstr ""

#. Occurrence WIK_B_1_B:233:21283: scene=WIK_B_1_B
#: WIK_B_1_B:233
msgctxt "text_id=21283 | speaker=unknown"
msgid "　商店街の座敷童、居ついた店はかならず繁盛するというお子さま。と言うか、ていのいいたかり魔。彼とは何度も話しているから、これも予想外ではない。"
msgstr ""

#. Occurrence WIK_B_1_B:288:21284: scene=WIK_B_1_B
#: WIK_B_1_B:288
msgctxt "text_id=21284 | speaker=unknown"
msgid "　最後に副会長。"
msgstr ""

#. Occurrence WIK_B_1_B:293:21285: scene=WIK_B_1_B
#: WIK_B_1_B:293
msgctxt "text_id=21285 | speaker=unknown"
msgid "　考えてみれば、蒼崎と静希の知人で、町の名士の息子なのだから、この誕生会にいない方がおかしい。"
msgstr ""

#. Occurrence WIK_B_1_B:299:21286: scene=WIK_B_1_B
#: WIK_B_1_B:299
msgctxt "text_id=21286 | speaker=unknown"
msgid "　……おかしい、のだけど。"
msgstr ""

#. Occurrence WIK_B_1_B:354:21287: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:354
msgctxt "text_id=21287 | speaker=kojika"
msgid "「ちょっと。なんで<槻司|つきじ>がいるの？」"
msgstr ""

#. Occurrence WIK_B_1_B:365:21288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:365
msgctxt "text_id=21288 | speaker=aoko"
msgid "「あら、<鳶丸|とびまる>も来るって言ってなかったっけ。"
msgstr ""

#. Occurrence WIK_B_1_B:371:21289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:371
msgctxt "text_id=21289 | speaker=aoko"
msgid "　というか、いちいち言わないとダメだったかしら？」"
msgstr ""

#. Occurrence WIK_B_1_B:382:21290: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:382
msgctxt "text_id=21290 | speaker=kojika"
msgid "「だ……ダメって事は、別にないけど」"
msgstr ""

#. Occurrence WIK_B_1_B:408:21291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0002; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:408
msgctxt "text_id=21291 | speaker=aoko"
msgid "「ならいいじゃない。生徒会じゃ毎日顔会わせているんだし、気にならないでしょ」"
msgstr ""

#. Occurrence WIK_B_1_B:419:21292: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:419
msgctxt "text_id=21292 | speaker=kojika"
msgid "「が、学校の中と外は別よ。だいたいわたし、これ普段着なんだし」"
msgstr ""

#. Occurrence WIK_B_1_B:455:21293: scene=WIK_B_1_B
#: WIK_B_1_B:455
msgctxt "text_id=21293 | speaker=unknown"
msgid "　蒼崎は、それが何か問題でも？　といった顔。"
msgstr ""

#. Occurrence WIK_B_1_B:460:21294: scene=WIK_B_1_B
#: WIK_B_1_B:460
msgctxt "text_id=21294 | speaker=unknown"
msgid "　もちろん、問題も問題だ。"
msgstr ""

#. Occurrence WIK_B_1_B:465:21295: scene=WIK_B_1_B
#: WIK_B_1_B:465
msgctxt "text_id=21295 | speaker=unknown"
msgid "　隠していても仕方がないのでハッキリ言うと、わたし、久万梨金鹿は槻司鳶丸に片思い中なのである。"
msgstr ""

#. Occurrence WIK_B_1_B:470:21296: scene=WIK_B_1_B
#: WIK_B_1_B:470
msgctxt "text_id=21296 | speaker=unknown"
msgid "　それも歴史にして三年。"
msgstr ""

#. Occurrence WIK_B_1_B:475:21297: scene=WIK_B_1_B
#: WIK_B_1_B:475
msgctxt "text_id=21297 | speaker=unknown"
msgid "　告白までこぎつけるコトもできず、あれよあれよと三年間。我がコトながら、<唾|だ><棄|き>すべき軟弱っぷり。"
msgstr ""

#. Occurrence WIK_B_1_B:507:21298: scene=WIK_B_1_B
#: WIK_B_1_B:507
msgctxt "text_id=21298 | speaker=unknown"
msgid "　しかし、多少なりとも弁明すると、はじめからここまで臆病だったワケじゃない。"
msgstr ""

#. Occurrence WIK_B_1_B:512:21299: scene=WIK_B_1_B
#: WIK_B_1_B:512
msgctxt "text_id=21299 | speaker=unknown"
msgid "　一年生の頃は漠然と、そもそも槻司のコトは蒼崎の相方としか思っていなかったし。"
msgstr ""

#. Occurrence WIK_B_1_B:517:21300: scene=WIK_B_1_B
#: WIK_B_1_B:517
msgctxt "text_id=21300 | speaker=unknown"
msgid "　はっきりと自覚したのは二年生の時だ。"
msgstr ""

#. Occurrence WIK_B_1_B:522:21301: scene=WIK_B_1_B
#: WIK_B_1_B:522
msgctxt "text_id=21301 | speaker=unknown"
msgid "　蒼崎の友人という事で信頼されていたのか、槻司はわたしによく話しかけてきた。"
msgstr ""

#. Occurrence WIK_B_1_B:527:21302: scene=WIK_B_1_B
#: WIK_B_1_B:527
msgctxt "text_id=21302 | speaker=unknown"
msgid "　そうした後は、ひとり帰り道で訳もなく嬉しくなって、なぜだろう？　と首をかしげていたものだ。"
msgstr ""

#. Occurrence WIK_B_1_B:555:21303: scene=WIK_B_1_B
#: WIK_B_1_B:555
msgctxt "text_id=21303 | speaker=unknown"
msgid "　決定打は二年生の文化祭の後片づけの時。"
msgstr ""

#. Occurrence WIK_B_1_B:560:21304: scene=WIK_B_1_B
#: WIK_B_1_B:560
msgctxt "text_id=21304 | speaker=unknown"
msgid "　たまたまふたりで生徒会の演し物を片づけていた時、“あれ、もしかしてわたし、この人に一目惚れしていたのではないだろうか”と気が付いてしまった。"
msgstr ""

#. Occurrence WIK_B_1_B:566:21305: scene=WIK_B_1_B
#: WIK_B_1_B:566
msgctxt "text_id=21305 | speaker=unknown"
msgid "　恋は<猛毒|もうもく>と言うが、"
msgstr ""

#. Occurrence WIK_B_1_B:571:21306: scene=WIK_B_1_B
#: WIK_B_1_B:571
msgctxt "text_id=21306 | speaker=unknown"
msgid "　まったく、遅効性にも程がある。"
msgstr ""

#. Occurrence WIK_B_1_B:604:21307: scene=WIK_B_1_B
#: WIK_B_1_B:604
msgctxt "text_id=21307 | speaker=unknown"
msgid "　そこから先は、しかし、何の変化もない。"
msgstr ""

#. Occurrence WIK_B_1_B:609:21308: scene=WIK_B_1_B
#: WIK_B_1_B:609
msgctxt "text_id=21308 | speaker=unknown"
msgid "　わたしは野蛮な脳筋一族に反抗し、"
msgstr ""

#. Occurrence WIK_B_1_B:614:21309: scene=WIK_B_1_B
#: WIK_B_1_B:614
msgctxt "text_id=21309 | speaker=unknown"
msgid "　このまま家業を継がされる運命に反逆し、"
msgstr ""

#. Occurrence WIK_B_1_B:619:21310: scene=WIK_B_1_B
#: WIK_B_1_B:619
msgctxt "text_id=21310 | speaker=unknown"
msgid "　その為に中学からコツコツと律してきた自分を、少なからず誇りに思っていた。"
msgstr ""

#. Occurrence WIK_B_1_B:624:21311: scene=WIK_B_1_B
#: WIK_B_1_B:624
msgctxt "text_id=21311 | speaker=unknown"
msgid "　なので、そんな、降って湧いた思春期特有の幻想なんぞに膝を屈するのは、どうにも我慢できなかったのである。"
msgstr ""

#. Occurrence WIK_B_1_B:629:21312: scene=WIK_B_1_B
#: WIK_B_1_B:629
msgctxt "text_id=21312 | speaker=unknown"
msgid "　勇気がなかったとも言える。"
msgstr ""

#. Occurrence WIK_B_1_B:657:21313: scene=WIK_B_1_B
#: WIK_B_1_B:657
msgctxt "text_id=21313 | speaker=unknown"
msgid "　そうこうしている内に、時間はついに底を見せ始めた。"
msgstr ""

#. Occurrence WIK_B_1_B:662:21314: scene=WIK_B_1_B
#: WIK_B_1_B:662
msgctxt "text_id=21314 | speaker=unknown"
msgid "　わたしの気持ちはいっこうにふわふわしたまま。"
msgstr ""

#. Occurrence WIK_B_1_B:667:21315: scene=WIK_B_1_B
#: WIK_B_1_B:667
msgctxt "text_id=21315 | speaker=unknown"
msgid "　卒業を間近にした三年の秋になって、本気でわたしは、わたしをどうしたいのか分からなくなっていた。"
msgstr ""

#. Occurrence WIK_B_1_B:697:21316: scene=WIK_B_1_B
#: WIK_B_1_B:697
msgctxt "text_id=21316 | speaker=unknown"
msgid "　槻司の進学先は、意外な事に地元の大学らしい。生徒会役員としての権限をフルに使って調べたので間違いない。"
msgstr ""

#. Occurrence WIK_B_1_B:702:21317: scene=WIK_B_1_B
#: WIK_B_1_B:702
msgctxt "text_id=21317 | speaker=unknown"
msgid "　さすがに渠裸ではなかったけど、槻司が地元に進学するのなら、なんというか、未練がましいコトに可能性が出てきてしまう。"
msgstr ""

#. Occurrence WIK_B_1_B:707:21318: scene=WIK_B_1_B
#: WIK_B_1_B:707
msgctxt "text_id=21318 | speaker=unknown"
msgid "　わたしも、このまま地元の大学に進めば、まだ縁は切れないのだと。"
msgstr ""

#. Occurrence WIK_B_1_B:737:21319: scene=WIK_B_1_B
#: WIK_B_1_B:737
msgctxt "text_id=21319 | speaker=unknown"
msgid "　蒼崎曰く、"
msgstr ""

#. Occurrence WIK_B_1_B:746:21320: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0003; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:746
msgctxt "text_id=21320 | speaker=aoko"
msgid "『鳶丸、クマのこと気に入ってると思うけど。"
msgstr ""

#. Occurrence WIK_B_1_B:758:21321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0004; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:758
msgctxt "text_id=21321 | speaker=aoko"
msgid "　だってあいつ、好きなヤツとしか世間話しないでしょ』"
msgstr ""

#. Occurrence WIK_B_1_B:796:21322: scene=WIK_B_1_B
#: WIK_B_1_B:796
msgctxt "text_id=21322 | speaker=unknown"
msgid "　この通り、脈はある、と信じたい。"
msgstr ""

#. Occurrence WIK_B_1_B:818:21323: scene=WIK_B_1_B
#: WIK_B_1_B:818
msgctxt "text_id=21323 | speaker=unknown"
msgid "　今年の夏の騒ぎの時だって、なんか、腕折ってまで助けてくれたし。"
msgstr ""

#. Occurrence WIK_B_1_B:823:21324: scene=WIK_B_1_B
#: WIK_B_1_B:823
msgctxt "text_id=21324 | speaker=unknown"
msgid "　槻司にカノジョがいるかどうかはわたしの知るところじゃないけど、いま告白すれば可能性はなくもない。"
msgstr ""

#. Occurrence WIK_B_1_B:850:21325: scene=WIK_B_1_B
#: WIK_B_1_B:850
msgctxt "text_id=21325 | speaker=unknown"
msgid "　しかし。しかしだ。"
msgstr ""

#. Occurrence WIK_B_1_B:855:21326: scene=WIK_B_1_B
#: WIK_B_1_B:855
msgctxt "text_id=21326 | speaker=unknown"
msgid "　それでは何の為に、物心ついた時から陰に日向に戦ってきたのか、悔しくなる。"
msgstr ""

#. Occurrence WIK_B_1_B:872:21327: scene=WIK_B_1_B
#: WIK_B_1_B:872
msgctxt "text_id=21327 | speaker=unknown"
msgid "　子供の頃からきっかり将来設計を持ってきたわたしは、恋だの夢だのにうつつをぬかしている同級生たちを軽蔑さえしていた。"
msgstr ""

#. Occurrence WIK_B_1_B:898:21328: scene=WIK_B_1_B
#: WIK_B_1_B:898
msgctxt "text_id=21328 | speaker=unknown"
msgid "　そのわたしがここにきて、そんな綿アメみたいな理由で六年間の努力を無駄にするとか、本気で信じられない。"
msgstr ""

#. Occurrence WIK_B_1_B:903:21329: scene=WIK_B_1_B
#: WIK_B_1_B:903
msgctxt "text_id=21329 | speaker=unknown"
msgid "　そんなのは、わたしが目指してきた久万梨金鹿ではないと思う。"
msgstr ""

#. Occurrence WIK_B_1_B:943:21330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0005; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:943
msgctxt "text_id=21330 | speaker=aoko"
msgid "「金鹿？　どしたの、考え事？」"
msgstr ""

#. Occurrence WIK_B_1_B:956:21331: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0003_0; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:956
msgctxt "text_id=21331 | speaker=kojika"
msgid "「うん、ちょっと頭冷やしてた。おかげで落ち着いたから問題なし。"
msgstr ""

#. Occurrence WIK_B_1_B:970:21332: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0003_1; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:970
msgctxt "text_id=21332 | speaker=kojika"
msgid "さて、久遠寺さんに挨拶しないとね」"
msgstr ""

#. Occurrence WIK_B_1_B:992:21333: scene=WIK_B_1_B
#: WIK_B_1_B:992
msgctxt "text_id=21333 | speaker=unknown"
msgid "　……などと言いつつ、少しだけ後悔する。"
msgstr ""

#. Occurrence WIK_B_1_B:997:21334: scene=WIK_B_1_B
#: WIK_B_1_B:997
msgctxt "text_id=21334 | speaker=unknown"
msgid "　蒼崎から“パーティーを開くからできるだけオシャレな格好で来い”と言われた時、鼻で笑った自分を鍋で<叩|はた>きたい気分。"
msgstr ""

#. Occurrence WIK_B_1_B:1022:21335: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0004; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1022
msgctxt "text_id=21335 | speaker=kojika"
msgid "「…………」"
msgstr ""

#. Occurrence WIK_B_1_B:1027:21336: scene=WIK_B_1_B
#: WIK_B_1_B:1027
msgctxt "text_id=21336 | speaker=unknown"
msgid "　まあ、もともとドレスなんて持ってないし、頑張ったところで何もできなかっただろう。"
msgstr ""

#. Occurrence WIK_B_1_B:1043:21337: scene=WIK_B_1_B
#: WIK_B_1_B:1043
msgctxt "text_id=21337 | speaker=unknown"
msgid "　わたしはピシャと頬を叩いて、努めて、いつもの自分であるよう気を引き締めた。"
msgstr ""

#. Occurrence WIK_B_1_B:1128:21338: scene=WIK_B_1_B
#: WIK_B_1_B:1128
msgctxt "text_id=21338 | speaker=unknown"
msgid "　館の主人である久遠寺さんに挨拶をして、隣室であるサンルームに移動する。"
msgstr ""

#. Occurrence WIK_B_1_B:1152:21339: scene=WIK_B_1_B
#: WIK_B_1_B:1152
msgctxt "text_id=21339 | speaker=unknown"
msgid "　集まっているゲストは誰もが顔見知りなので、改めて自己紹介をする必要はない。"
msgstr ""

#. Occurrence WIK_B_1_B:1157:21340: scene=WIK_B_1_B
#: WIK_B_1_B:1157
msgctxt "text_id=21340 | speaker=unknown"
msgid "　サンルームと居間は一続きなので、サンルームからでも居間の様子は窺えた。"
msgstr ""

#. Occurrence WIK_B_1_B:1192:21341: scene=WIK_B_1_B
#: WIK_B_1_B:1192
msgctxt "text_id=21341 | speaker=unknown"
msgid "　居間のソファーには久遠寺さんが座って、優雅にお茶を飲んでいる。"
msgstr ""

#. Occurrence WIK_B_1_B:1204:21342: scene=WIK_B_1_B
#: WIK_B_1_B:1204
msgctxt "text_id=21342 | speaker=unknown"
msgid "　その周囲で騒いでいるのは"
msgstr ""

msgctxt "text_id=21343 | speaker=unknown"
msgid "芳助と、"
msgstr ""

msgctxt "text_id=21344 | speaker=unknown"
msgid "芳助と、"
msgstr ""

#. Occurrence WIK_B_1_B:1225:21345: scene=WIK_B_1_B
#: WIK_B_1_B:1225
msgctxt "text_id=21345 | speaker=unknown"
msgid "意外なコトに山城先生だった。"
msgstr ""

#. Occurrence WIK_B_1_B:1287:21346: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_1_B_0000; voice_prefix=B60; voice_category=7; scene=WIK_B_1_B
#: WIK_B_1_B:1287
msgctxt "text_id=21346 | speaker=yamashiro"
msgid "「ほう。裏庭の方にちらりと見えたのはオークの木なのですか。日本で言えば<楢|なら>ですが……うーん、僕の記憶には該当しないなあ。"
msgstr ""

#. Occurrence WIK_B_1_B:1299:21347: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_1_B_0001; voice_prefix=B60; voice_category=7; scene=WIK_B_1_B
#: WIK_B_1_B:1299
msgctxt "text_id=21347 | speaker=yamashiro"
msgid "　何か特別な品種なんでしょうね。日本のものとイギリスのものは見た目からして違いますし、オークの品種はそれこそ四百以上ありますから」"
msgstr ""

#. Occurrence WIK_B_1_B:1330:21348: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0000; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1330
msgctxt "text_id=21348 | speaker=kinomi"
msgid "「うお、相変わらず自分の言いたい事しか言わないよねこの人。有珠ちゃん、この先生は人の心にズカズカ踏みこんでくる蛮族だから、無視しちゃっていいぜ。"
msgstr ""

#. Occurrence WIK_B_1_B:1342:21349: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0001; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1342
msgctxt "text_id=21349 | speaker=kinomi"
msgid "　それよりオレと冬休みの予定について話し合わない？"
msgstr ""

#. Occurrence WIK_B_1_B:1355:21350: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0002; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1355
msgctxt "text_id=21350 | speaker=kinomi"
msgid "　有珠ちゃん、スキーとか苦手そうだナー。そこで、この頼れる木乃美芳助が手取り足取り教えたいナー」"
msgstr ""

#. Occurrence WIK_B_1_B:1381:21351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_B_1_B_0000; voice_prefix=A40; voice_category=2; scene=WIK_B_1_B
#: WIK_B_1_B:1381
msgctxt "text_id=21351 | speaker=alice"
msgid "「ふたりとも、退屈とはほど遠い人なのね。"
msgstr ""

#. Occurrence WIK_B_1_B:1392:21352: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_B_1_B_0001; voice_prefix=A40; voice_category=2; scene=WIK_B_1_B
#: WIK_B_1_B:1392
msgctxt "text_id=21352 | speaker=alice"
msgid "　理解したわ。木乃美君と先生は、仕付けられたウッドペッカーのよう」"
msgstr ""

#. Occurrence WIK_B_1_B:1444:21353: voice_id=BA0_WIK_B_1_B_0000; voice_prefix=BA0; voice_category=0; scene=WIK_B_1_B
#: WIK_B_1_B:1444
msgctxt "text_id=21353 | speaker=unknown"
msgid "『ハハハ、あの木を<突|つつ>くか<喋|しゃべ>ってるだけの<阿呆鳥|あほうどり>と同格っスかこのシャバ僧ども！　アリスさんから鳥認定されない草の字に比べて、ちょっとだけ格上と見たっス。"
msgstr ""

#. Occurrence WIK_B_1_B:1475:21354: voice_id=BA0_WIK_B_1_B_0001; voice_prefix=BA0; voice_category=0; scene=WIK_B_1_B
#: WIK_B_1_B:1475
msgctxt "text_id=21354 | speaker=unknown"
msgid "　ま、死ぬか生きるかだけのジブンに比べたらどっちも小物っスけど！』"
msgstr ""

#. Occurrence WIK_B_1_B:1514:21355: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0005; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1514
msgctxt "text_id=21355 | speaker=kojika"
msgid "「……なに、あのまるっとした鳥」"
msgstr ""

#. Occurrence WIK_B_1_B:1546:21356: scene=WIK_B_1_B
#: WIK_B_1_B:1546
msgctxt "text_id=21356 | speaker=unknown"
msgid "　久遠寺さんの肩には青い駒鳥がしきりにまとわりついているが、彼女の肩にとまる度に払い落とされていた。"
msgstr ""

#. Occurrence WIK_B_1_B:1551:21357: scene=WIK_B_1_B
#: WIK_B_1_B:1551
msgctxt "text_id=21357 | speaker=unknown"
msgid "　チチチ、チチチと愛らしい声で鳴いているが、放し飼いにされているのだろうか？"
msgstr ""

#. Occurrence WIK_B_1_B:1587:21358: scene=WIK_B_1_B
#: WIK_B_1_B:1587
msgctxt "text_id=21358 | speaker=unknown"
msgid "　蒼崎の姿はない。台所かトイレだろう。"
msgstr ""

#. Occurrence WIK_B_1_B:1592:21359: scene=WIK_B_1_B
#: WIK_B_1_B:1592
msgctxt "text_id=21359 | speaker=unknown"
msgid "　わたしは話し相手もなく、ひとりぼんやりしていると、"
msgstr ""

#. Occurrence WIK_B_1_B:1616:21360: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0000; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1616
msgctxt "text_id=21360 | speaker=tobimaru"
msgid "「久万梨も招待されてたんだな。"
msgstr ""

#. Occurrence WIK_B_1_B:1622:21361: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0001; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1622
msgctxt "text_id=21361 | speaker=tobimaru"
msgid "　ずいぶんと遅かったが、またアルバイトか？」"
msgstr ""

#. Occurrence WIK_B_1_B:1640:21362: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0006; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1640
msgctxt "text_id=21362 | speaker=kojika"
msgid "「――――――」"
msgstr ""

#. Occurrence WIK_B_1_B:1645:21363: scene=WIK_B_1_B
#: WIK_B_1_B:1645
msgctxt "text_id=21363 | speaker=unknown"
msgid "　槻司はいつもの調子で話しかけてきた。"
msgstr ""

#. Occurrence WIK_B_1_B:1650:21364: scene=WIK_B_1_B
#: WIK_B_1_B:1650
msgctxt "text_id=21364 | speaker=unknown"
msgid "　スラリとした手足とか、ジュースの入ったグラスを持っているだけで絵になっている。"
msgstr ""

#. Occurrence WIK_B_1_B:1676:21365: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0007; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1676
msgctxt "text_id=21365 | speaker=kojika"
msgid "「アルバイトは休み。今回の三連休、ぜんぶ休み入れたから。お金も予定額たまったし」"
msgstr ""

#. Occurrence WIK_B_1_B:1711:21366: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0002; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1711
msgctxt "text_id=21366 | speaker=tobimaru"
msgid "「そうか、そりゃよかった。三咲脱出ロケットはもう秒読み段階ってコトだな。"
msgstr ""

#. Occurrence WIK_B_1_B:1718:21367: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0003_0; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1718
msgctxt "text_id=21367 | speaker=tobimaru"
msgid "となると、早朝のコンビニで顔を合わせるのもいよいよおしまいか。"
msgstr ""

#. Occurrence WIK_B_1_B:1730:21368: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0003_1; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1730
msgctxt "text_id=21368 | speaker=tobimaru"
msgid "　ん？　そういえば、俺が煙草を吸おうとしたら水ぶっかけてきたの、おまえさんだったっけか」"
msgstr ""

#. Occurrence WIK_B_1_B:1787:21369: scene=WIK_B_1_B
#: WIK_B_1_B:1787
msgctxt "text_id=21369 | speaker=unknown"
msgid "　懐かしい話だ。"
msgstr ""

#. Occurrence WIK_B_1_B:1792:21370: scene=WIK_B_1_B
#: WIK_B_1_B:1792
msgctxt "text_id=21370 | speaker=unknown"
msgid "　一年生の頃、コンビニの駐車場で堂々と煙草を吸っている生徒がいた。"
msgstr ""

#. Occurrence WIK_B_1_B:1797:21371: scene=WIK_B_1_B
#: WIK_B_1_B:1797
msgctxt "text_id=21371 | speaker=unknown"
msgid "　他校の生徒だったけど見てしまったものは仕方がない。駆け寄って注意して、かつホースで水を撒いたら、まったく関係のない男子生徒に水を被せてしまった。"
msgstr ""

#. Occurrence WIK_B_1_B:1802:21372: scene=WIK_B_1_B
#: WIK_B_1_B:1802
msgctxt "text_id=21372 | speaker=unknown"
msgid "　あわてて謝ろうとしたら、その男子生徒の手には今まさに吸われようとしていた煙草が一本。"
msgstr ""

#. Occurrence WIK_B_1_B:1807:21373: scene=WIK_B_1_B
#: WIK_B_1_B:1807
msgctxt "text_id=21373 | speaker=unknown"
msgid "　それがこの男、槻司鳶丸だったのである。"
msgstr ""

#. Occurrence WIK_B_1_B:1841:21374: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0004; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1841
msgctxt "text_id=21374 | speaker=tobimaru"
msgid "「いやあ。あの後、まさか生徒会室で再会するとは思わなかった。俺はアレかね、気に入った女どもにはまず水かケンカをふっかけられる運命なのかねぇ」"
msgstr ""

#. Occurrence WIK_B_1_B:1852:21375: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0008; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1852
msgctxt "text_id=21375 | speaker=kojika"
msgid "「たまたまでしょ。それより槻司、いつから来てたの？」"
msgstr ""

#. Occurrence WIK_B_1_B:1878:21376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0005; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1878
msgctxt "text_id=21376 | speaker=tobimaru"
msgid "「俺たちは午前中からだよ。木乃美のヤロウが張りきっててな、仕方なくだ。"
msgstr ""

#. Occurrence WIK_B_1_B:1889:21377: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0006; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1889
msgctxt "text_id=21377 | speaker=tobimaru"
msgid "　誕生会は夕方六時からだから、まだ時間に余裕はある。"
msgstr ""

#. Occurrence WIK_B_1_B:1895:21378: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0007; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1895
msgctxt "text_id=21378 | speaker=tobimaru"
msgid "　疲れてるなら部屋で休んできたらどうだ？　ちょいと顔色悪いぜ」"
msgstr ""

#. Occurrence WIK_B_1_B:1933:21379: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0009; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1933
msgctxt "text_id=21379 | speaker=kojika"
msgid "「…………」"
msgstr ""

#. Occurrence WIK_B_1_B:1938:21380: scene=WIK_B_1_B
#: WIK_B_1_B:1938
msgctxt "text_id=21380 | speaker=unknown"
msgid "　この男の何が卑怯かって、粗雑で無遠慮のクセに、細かいところに気が利くことだと思う。"
msgstr ""

#. Occurrence WIK_B_1_B:1943:21381: scene=WIK_B_1_B
#: WIK_B_1_B:1943
msgctxt "text_id=21381 | speaker=unknown"
msgid "　わたしは人見知りが激しい。"
msgstr ""

#. Occurrence WIK_B_1_B:1948:21382: scene=WIK_B_1_B
#: WIK_B_1_B:1948
msgctxt "text_id=21382 | speaker=unknown"
msgid "　いくら顔見知りといっても、慣れない場所で多くの人間と話すのは体力を使う。"
msgstr ""

#. Occurrence WIK_B_1_B:1975:21383: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0010; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1975
msgctxt "text_id=21383 | speaker=kojika"
msgid "「そうね。ちょっと客室で一息いれてくる」"
msgstr ""

#. Occurrence WIK_B_1_B:1995:21384: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0008; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1995
msgctxt "text_id=21384 | speaker=tobimaru"
msgid "「おう、そうしろそうしろ。久万梨の部屋は、たしか」"
msgstr ""

#. Occurrence WIK_B_1_B:2007:21385: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0000; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2007
msgctxt "text_id=21385 | speaker=beo"
msgid "「ねー、トビー。草十郎さん、どこいったか知らない？」"
msgstr ""

#. Occurrence WIK_B_1_B:2018:21386: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0009; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2018
msgctxt "text_id=21386 | speaker=tobimaru"
msgid "「草十郎なら買い出しじゃないのか？"
msgstr ""

#. Occurrence WIK_B_1_B:2024:21387: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0010; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2024
msgctxt "text_id=21387 | speaker=tobimaru"
msgid "　飲み物が足りない、とか言ってたしな」"
msgstr ""

#. Occurrence WIK_B_1_B:2050:21388: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0001; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2050
msgctxt "text_id=21388 | speaker=beo"
msgid "「ほんと？　もう、行くならボクに声かけてくれれば良かったのに。あの人の、自分で出来るコトは全部ひとりでやっちゃうところ、ボクどうかと思うなー。"
msgstr ""

#. Occurrence WIK_B_1_B:2061:21389: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0002; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2061
msgctxt "text_id=21389 | speaker=beo"
msgid "　まあ、そこが動物っぽくていいんだけど！」"
msgstr ""

#. Occurrence WIK_B_1_B:2105:21390: scene=WIK_B_1_B
#: WIK_B_1_B:2105
msgctxt "text_id=21390 | speaker=unknown"
msgid "　改めて解説すると、この金髪の子供はベオ。"
msgstr ""

#. Occurrence WIK_B_1_B:2118:21391: scene=WIK_B_1_B
#: WIK_B_1_B:2118
msgctxt "text_id=21391 | speaker=unknown"
msgid "　フルネームは知らない。名乗られたこともない。"
msgstr ""

#. Occurrence WIK_B_1_B:2123:21392: scene=WIK_B_1_B
#: WIK_B_1_B:2123
msgctxt "text_id=21392 | speaker=unknown"
msgid "　槻司や蒼崎、静希がベオと呼んでいるので、わたしもそれに<倣|なら>っているだけだ。"
msgstr ""

#. Occurrence WIK_B_1_B:2128:21393: scene=WIK_B_1_B
#: WIK_B_1_B:2128
msgctxt "text_id=21393 | speaker=unknown"
msgid "　この子は妙に静希に<懐|なつ>いていて、隙さえあれば、"
msgstr ""

#. Occurrence WIK_B_1_B:2166:21394: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0003; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2166
msgctxt "text_id=21394 | speaker=beo"
msgid "『草十郎さん、今度のお休み、遊園地に行きたいです』"
msgstr ""

#. Occurrence WIK_B_1_B:2177:21395: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0004; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2177
msgctxt "text_id=21395 | speaker=beo"
msgid "『草十郎さん、お腹へっちゃってません？　ぜひご一緒しましょう』"
msgstr ""

#. Occurrence WIK_B_1_B:2188:21396: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0005; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2188
msgctxt "text_id=21396 | speaker=beo"
msgid "『草十郎さん、特に理由はありませんけど頭、なでてほしいです』"
msgstr ""

#. Occurrence WIK_B_1_B:2225:21397: scene=WIK_B_1_B
#: WIK_B_1_B:2225
msgctxt "text_id=21397 | speaker=unknown"
msgid "　などと、猫のように身をすり寄せている。"
msgstr ""

#. Occurrence WIK_B_1_B:2230:21398: scene=WIK_B_1_B
#: WIK_B_1_B:2230
msgctxt "text_id=21398 | speaker=unknown"
msgid "　静希はあれで子供に好かれる性格なのだろうか。草十郎サン草十郎サン、と実にやかましい。"
msgstr ""

#. Occurrence WIK_B_1_B:2278:21399: scene=WIK_B_1_B
#: WIK_B_1_B:2278
msgctxt "text_id=21399 | speaker=unknown"
msgid "　ともあれ、今は客室に移動しよう。"
msgstr ""

#. Occurrence WIK_B_1_B:2284:21400: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0011; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2284
msgctxt "text_id=21400 | speaker=tobimaru"
msgid "「久万梨、部屋は分かってんのか？」"
msgstr ""

#. Occurrence WIK_B_1_B:2290:21401: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0011; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:2290
msgctxt "text_id=21401 | speaker=kojika"
msgid "「はじめに蒼崎に聞いた。三十分ぐらいで戻るから」"
msgstr ""

#. Occurrence WIK_B_1:33:21402: scene=WIK_B_1
#: WIK_B_1:33
msgctxt "text_id=21402 | speaker=unknown"
msgid "　何はともあれ、屋敷の主人や、先に来ているゲストたちに挨拶をしなくては。"
msgstr ""

#. Occurrence WIK_B_1:38:21403: scene=WIK_B_1
#: WIK_B_1:38
msgctxt "text_id=21403 | speaker=unknown"
msgid "　ここは寄り道せず居間に向かおう。"
msgstr ""

#. Occurrence WIK_B_1:48:21404: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1
#: WIK_B_1:48
msgctxt "text_id=21404 | speaker=aoko"
msgid "「こっちこっち。もうだいたい集まってるから」"
msgstr ""

#. Occurrence WIK_B_1:53:21405: scene=WIK_B_1
#: WIK_B_1:53
msgctxt "text_id=21405 | speaker=unknown"
msgid "　一階、東館の廊下はやや薄暗い。"
msgstr ""

#. Occurrence WIK_B_1:58:21406: scene=WIK_B_1
#: WIK_B_1:58
msgctxt "text_id=21406 | speaker=unknown"
msgid "　手前にあるドアから談笑が漏れてきている。"
msgstr ""

#. Occurrence WIK_B_2:24:21407: scene=WIK_B_2
#: WIK_B_2:24
msgctxt "text_id=21407 | speaker=unknown"
msgid "　その前に、客室の様子を見に行く事に決めた。"
msgstr ""

#. Occurrence WIK_B_2:45:21408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:45
msgctxt "text_id=21408 | speaker=kojika"
msgid "「芳助、やっぱり荷物返して。先に自分の部屋を見てくるから。蒼崎、その客室ってどこ？」"
msgstr ""

#. Occurrence WIK_B_2:51:21409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_2_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_2
#: WIK_B_2:51
msgctxt "text_id=21409 | speaker=aoko"
msgid "「クマの部屋は二階の東館の、手前から二つ目。"
msgstr ""

#. Occurrence WIK_B_2:57:21410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_2_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_2
#: WIK_B_2:57
msgctxt "text_id=21410 | speaker=aoko"
msgid "　鍵は開いてるわ。部屋の机の上に鍵があるから、出てくる時はそれで施錠して」"
msgstr ""

#. Occurrence WIK_B_2:77:21411: scene=WIK_B_2
#: WIK_B_2:77
msgctxt "text_id=21411 | speaker=unknown"
msgid "　了解、と頷いて移動する。"
msgstr ""

#. Occurrence WIK_B_2:104:21412: scene=WIK_B_2
#: WIK_B_2:104
msgctxt "text_id=21412 | speaker=unknown"
msgid "　階段から二階に上がる。"
msgstr ""

#. Occurrence WIK_B_2:109:21413: scene=WIK_B_2
#: WIK_B_2:109
msgctxt "text_id=21413 | speaker=unknown"
msgid "　わたしの部屋は手前から二つ目の部屋だ。"
msgstr ""

#. Occurrence WIK_B_2:159:21414: scene=WIK_B_2
#: WIK_B_2:159
msgctxt "text_id=21414 | speaker=unknown"
msgid "　部屋には誰もいない。"
msgstr ""

#. Occurrence WIK_B_2:164:21415: scene=WIK_B_2
#: WIK_B_2:164
msgctxt "text_id=21415 | speaker=unknown"
msgid "　わたしは無人である事を確かめて、荷物を置き、サイフをポケットにいれた。"
msgstr ""

#. Occurrence WIK_B_2:169:21416: scene=WIK_B_2
#: WIK_B_2:169
msgctxt "text_id=21416 | speaker=unknown"
msgid "　お<守|まも>り<兼|けん>お気に入りである<×口|バツくち>兎のパスケースを携帯するかは迷ったが、どうせ中には定期と学祭での記念写真しか入っていないので、テーブルに置いておく。"
msgstr ""

#. Occurrence WIK_B_2:174:21417: scene=WIK_B_2
#: WIK_B_2:174
msgctxt "text_id=21417 | speaker=unknown"
msgid "　馴染みのない建物で過ごすのだ。体はできるだけ身軽の方が疲れない。"
msgstr ""

#. Occurrence WIK_B_2:195:21418: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:195
msgctxt "text_id=21418 | speaker=kojika"
msgid "「鍵は……ああ、これね」"
msgstr ""

#. Occurrence WIK_B_2:201:21419: scene=WIK_B_2
#: WIK_B_2:201
msgctxt "text_id=21419 | speaker=unknown"
msgid "　<真鍮|しんちゅう>の鍵。この洋館に相応しい、古めかしくも凝ったデザインだった。"
msgstr ""

#. Occurrence WIK_B_2:230:21420: scene=WIK_B_2
#: WIK_B_2:230
msgctxt "text_id=21420 | speaker=unknown"
msgid "　廊下に出ると、"
msgstr ""

#. Occurrence WIK_B_2:265:21421: scene=WIK_B_2
#: WIK_B_2:265
msgctxt "text_id=21421 | speaker=unknown"
msgid "　ちらりと、二階のホールに老人の姿が見えた。"
msgstr ""

#. Occurrence WIK_B_2:270:21422: scene=WIK_B_2
#: WIK_B_2:270
msgctxt "text_id=21422 | speaker=unknown"
msgid "　ゲストの一人だろう。挨拶をしておこうとホールに向かう。"
msgstr ""

#. Occurrence WIK_B_2:319:21423: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:319
msgctxt "text_id=21423 | speaker=kojika"
msgid "「あれ？」"
msgstr ""

#. Occurrence WIK_B_2:324:21424: scene=WIK_B_2
#: WIK_B_2:324
msgctxt "text_id=21424 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence WIK_B_2:329:21425: scene=WIK_B_2
#: WIK_B_2:329
msgctxt "text_id=21425 | speaker=unknown"
msgid "　二階のホールに老人の姿はなく、一階に下りたものと思ってロビーに下りてみたが、そこにも老人の姿はなかった。"
msgstr ""

#. Occurrence WIK_B_2:350:21426: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:350
msgctxt "text_id=21426 | speaker=kojika"
msgid "「西館の方に行ったとか？」"
msgstr ""

#. Occurrence WIK_B_2:355:21427: scene=WIK_B_2
#: WIK_B_2:355
msgctxt "text_id=21427 | speaker=unknown"
msgid "　少しだけ気になったが、主人に挨拶もしていない状態で館内を歩き回るのも失礼だ。"
msgstr ""

#. Occurrence WIK_B_2:360:21428: scene=WIK_B_2
#: WIK_B_2:360
msgctxt "text_id=21428 | speaker=unknown"
msgid "　わたしは笑い声が聞こえてくる、東館の居間へ足を向けた。"
msgstr ""

#. Occurrence WIK_B_3:33:21429: scene=WIK_B_3
#: WIK_B_3:33
msgctxt "text_id=21429 | speaker=unknown"
msgid "　意味のない行動をすると決めた。"
msgstr ""

#. Occurrence WIK_B_3:39:21430: scene=WIK_B_3
#: WIK_B_3:39
msgctxt "text_id=21430 | speaker=unknown"
msgid "　いや、ほんとに意図はない。思いつき以下の、１００パー気まぐれ、気の迷い。"
msgstr ""

#. Occurrence WIK_B_3:63:21431: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:63
msgctxt "text_id=21431 | speaker=kojika"
msgid "「ちょっと落とし物したかも。外を捜してくるから、先に居間に行っていて」"
msgstr ""

#. Occurrence WIK_B_3:74:21432: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:74
msgctxt "text_id=21432 | speaker=aoko"
msgid "「外に戻るの？　それなら私も行くわ」"
msgstr ""

#. Occurrence WIK_B_3:112:21433: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_3_0000_0; voice_prefix=B50; voice_category=6; scene=WIK_B_3
#: WIK_B_3:112
msgctxt "text_id=21433 | speaker=kinomi"
msgid "「えー。なにいってんだよ会長、落とし物したのは金鹿のドジだろ、会長関係ねぇーじゃん。"
msgstr ""

#. Occurrence WIK_B_3:123:21434: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_3_0000_1; voice_prefix=B50; voice_category=6; scene=WIK_B_3
#: WIK_B_3:123
msgctxt "text_id=21434 | speaker=kinomi"
msgid "　それより居間に来てくれよー。会長がいないと有珠ちゃんになに話していいか分かんないよー」"
msgstr ""

#. Occurrence WIK_B_3:164:21435: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:164
msgctxt "text_id=21435 | speaker=aoko"
msgid "「え……でも、クマひとりには、」"
msgstr ""

#. Occurrence WIK_B_3:192:21436: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_3_0000; voice_prefix=B60; voice_category=7; scene=WIK_B_3
#: WIK_B_3:192
msgctxt "text_id=21436 | speaker=yamashiro"
msgid "「蒼崎くん、とりあえず居間まで案内してくれません？　このロビー、ちょっと冷えますので」"
msgstr ""

#. Occurrence WIK_B_3:218:21437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0002; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:218
msgctxt "text_id=21437 | speaker=aoko"
msgid "「いや、でもゲストをひとりっきりにするワケには」"
msgstr ""

#. Occurrence WIK_B_3:229:21438: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:229
msgctxt "text_id=21438 | speaker=kojika"
msgid "「いいって、気にしないで。すぐに戻るから。"
msgstr ""

#. Occurrence WIK_B_3:241:21439: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:241
msgctxt "text_id=21439 | speaker=kojika"
msgid "　芳助、荷物返して。やっぱり自分で持つ」"
msgstr ""

#. Occurrence WIK_B_3:316:21440: scene=WIK_B_3
#: WIK_B_3:316
msgctxt "text_id=21440 | speaker=unknown"
msgid "　蒼崎を振り切るかたちで外に向かう。"
msgstr ""

#. Occurrence WIK_B_3:321:21441: scene=WIK_B_3
#: WIK_B_3:321
msgctxt "text_id=21441 | speaker=unknown"
msgid "　外に出て洋館の周りの森を、目的もなく観察する。"
msgstr ""

#. Occurrence WIK_B_3:326:21442: scene=WIK_B_3
#: WIK_B_3:326
msgctxt "text_id=21442 | speaker=unknown"
msgid "　人気はなく、天気はますます曇っていく。"
msgstr ""

#. Occurrence WIK_B_3:332:21443: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0003; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:332
msgctxt "text_id=21443 | speaker=kojika"
msgid "「？」"
msgstr ""

#. Occurrence WIK_B_3:337:21444: scene=WIK_B_3
#: WIK_B_3:337
msgctxt "text_id=21444 | speaker=unknown"
msgid "　しかし、ふと、視線を感じた。"
msgstr ""

#. Occurrence WIK_B_3:342:21445: scene=WIK_B_3
#: WIK_B_3:342
msgctxt "text_id=21445 | speaker=unknown"
msgid "　わたしは―――"
msgstr ""

#. Occurrence WIK_SELECT_C:8:21446: scene=WIK_SELECT_C
#: WIK_SELECT_C:8
msgctxt "text_id=21446 | speaker=unknown"
msgid "～選択肢Ｃ～"
msgstr ""

#. Occurrence WIK_C_1:23:21447: scene=WIK_C_1
#: WIK_C_1:23
msgctxt "text_id=21447 | speaker=unknown"
msgid "　……追いかけよう。"
msgstr ""

#. Occurrence WIK_C_1:28:21448: scene=WIK_C_1
#: WIK_C_1:28
msgctxt "text_id=21448 | speaker=unknown"
msgid "　不穏なものを感じつつ、わたしは視線の主を追った。"
msgstr ""

#. Occurrence WIK_C_1:59:21449: scene=WIK_C_1
#: WIK_C_1:59
msgctxt "text_id=21449 | speaker=unknown"
msgid "　洋館の裏側に回りこむと、そこはちょっとした林だった。"
msgstr ""

#. Occurrence WIK_C_1:64:21450: scene=WIK_C_1
#: WIK_C_1:64
msgctxt "text_id=21450 | speaker=unknown"
msgid "　洋館を隠す森より、少しだけ手入れがされている。"
msgstr ""

#. Occurrence WIK_C_1:70:21451: scene=WIK_C_1
#: WIK_C_1:70
msgctxt "text_id=21451 | speaker=unknown"
msgid "　そこに、"
msgstr ""

#. Occurrence WIK_C_1:78:21452: scene=WIK_C_1
#: WIK_C_1:78
msgctxt "text_id=21452 | speaker=unknown"
msgid "　場違いな女性がひとり。"
msgstr ""

#. Occurrence WIK_C_1:115:21453: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0000; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:115
msgctxt "text_id=21453 | speaker=touko"
msgid "「おや。君も今日のゲスト？」"
msgstr ""

#. Occurrence WIK_C_1:120:21454: scene=WIK_C_1
#: WIK_C_1:120
msgctxt "text_id=21454 | speaker=unknown"
msgid "　わたしは無意識に後退していた。"
msgstr ""

#. Occurrence WIK_C_1:125:21455: scene=WIK_C_1
#: WIK_C_1:125
msgctxt "text_id=21455 | speaker=unknown"
msgid "　それぐらい、あの女性には凄みがあった。"
msgstr ""

#. Occurrence WIK_C_1:162:21456: scene=WIK_C_1
#: WIK_C_1:162
msgctxt "text_id=21456 | speaker=unknown"
msgid "　ぱち、ぱち。"
msgstr ""

#. Occurrence WIK_C_1:167:21457: scene=WIK_C_1
#: WIK_C_1:167
msgctxt "text_id=21457 | speaker=unknown"
msgid "　逃げ気味のわたしのカカトが落ち葉を踏む音。"
msgstr ""

#. Occurrence WIK_C_1:172:21458: scene=WIK_C_1
#: WIK_C_1:172
msgctxt "text_id=21458 | speaker=unknown"
msgid "　そんな小動物めいたわたしを、女性は楽しげに眺めている。"
msgstr ""

#. Occurrence WIK_C_1:221:21459: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0001; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:221
msgctxt "text_id=21459 | speaker=touko"
msgid "「いやあ、ゲストには何の期待もしていなかったんだが、いるじゃないか、私好みの目の保養が！"
msgstr ""

#. Occurrence WIK_C_1:233:21460: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0002; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:233
msgctxt "text_id=21460 | speaker=touko"
msgid "　いいね、青子も気が利くようになったもんだ。これなら退屈はしなさそうだよ」"
msgstr ""

#. Occurrence WIK_C_1:239:21461: scene=WIK_C_1
#: WIK_C_1:239
msgctxt "text_id=21461 | speaker=unknown"
msgid "　こちらを見る目が、ちょっと、いや、かなり怪しい。"
msgstr ""

#. Occurrence WIK_C_1:244:21462: scene=WIK_C_1
#: WIK_C_1:244
msgctxt "text_id=21462 | speaker=unknown"
msgid "　警察はどこだ。"
msgstr ""

#. Occurrence WIK_C_1:272:21463: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0003; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:272
msgctxt "text_id=21463 | speaker=touko"
msgid "「そう警戒するな。私も君と同じゲストだ、仲良くしよう。"
msgstr ""

#. Occurrence WIK_C_1:285:21464: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0004; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:285
msgctxt "text_id=21464 | speaker=touko"
msgid "　……しかし。<何|・><事|・><か|・><始|・><ま|・><る|・>前に周囲の地形を確認にくる人間が、私の他にいるとはね。"
msgstr ""

#. Occurrence WIK_C_1:297:21465: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0005; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:297
msgctxt "text_id=21465 | speaker=touko"
msgid "　うん、気に入った。気に入ったし可愛いので大サービスしてあげよう。"
msgstr ""

#. Occurrence WIK_C_1:309:21466: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0006; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:309
msgctxt "text_id=21466 | speaker=touko"
msgid "　私は普段、よく見えない。私は蒼崎の部屋にいる。そして私は犯人ではない」"
msgstr ""

#. Occurrence WIK_C_1:315:21467: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_C_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_C_1
#: WIK_C_1:315
msgctxt "text_id=21467 | speaker=kojika"
msgid "「え……？」"
msgstr ""

#. Occurrence WIK_C_1:342:21468: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0007; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:342
msgctxt "text_id=21468 | speaker=touko"
msgid "「切り札になるから、あまり口外しないようにね」"
msgstr ""

#. Occurrence WIK_C_1:352:21469: scene=WIK_C_1
#: WIK_C_1:352
msgctxt "text_id=21469 | speaker=unknown"
msgid "　女性はおかしな台詞を残して、洋館の方に立ち去っていった。"
msgstr ""

#. Occurrence WIK_C_1:358:21470: scene=WIK_C_1
#: WIK_C_1:358
msgctxt "text_id=21470 | speaker=unknown"
msgid "　わたしは後を追う気にもなれず、洋館の正面玄関に戻る事にした。"
msgstr ""

#. Occurrence WIK_C_1:418:21471: scene=WIK_C_1
#: WIK_C_1:418
msgctxt "text_id=21471 | speaker=unknown"
msgid "　ロビーに戻ると、右手の東館―――居間の方から笑い声が聞こえてきた。"
msgstr ""

#. Occurrence WIK_C_1:423:21472: scene=WIK_C_1
#: WIK_C_1:423
msgctxt "text_id=21472 | speaker=unknown"
msgid "　蒼崎を待たせている。"
msgstr ""

#. Occurrence WIK_C_1:428:21473: scene=WIK_C_1
#: WIK_C_1:428
msgctxt "text_id=21473 | speaker=unknown"
msgid "　わたしは荷物を抱え直して、居間に足を向けた。"
msgstr ""

#. Occurrence WIK_C_2:48:21474: scene=WIK_C_2
#: WIK_C_2:48
msgctxt "text_id=21474 | speaker=unknown"
msgid "　……明らかに、不穏なものを感じる。"
msgstr ""

#. Occurrence WIK_C_2:53:21475: scene=WIK_C_2
#: WIK_C_2:53
msgctxt "text_id=21475 | speaker=unknown"
msgid "　幽霊屋敷の異名を思い出し、わたしは無視する事に決めた。屋敷の周りを探索する時は、誰かと一緒の時がいいだろう。"
msgstr ""

#. Occurrence WIK_C_2:85:21476: scene=WIK_C_2
#: WIK_C_2:85
msgctxt "text_id=21476 | speaker=unknown"
msgid "　ロビーに戻ると、右手の東館―――居間の方から笑い声が聞こえてきた。"
msgstr ""

#. Occurrence WIK_C_2:90:21477: scene=WIK_C_2
#: WIK_C_2:90
msgctxt "text_id=21477 | speaker=unknown"
msgid "　わたしは荷物を抱え直して、居間に足を向けた。"
msgstr ""

#. Occurrence WIK_CHAP2START:57:21478: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0000; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:57
msgctxt "text_id=21478 | speaker=eiri"
msgid "「これは酷い」"
msgstr ""

#. Occurrence WIK_CHAP2START:63:21479: scene=WIK_CHAP2START
#: WIK_CHAP2START:63
msgctxt "text_id=21479 | speaker=unknown"
msgid "　洋館の三階。"
msgstr ""

#. Occurrence WIK_CHAP2START:68:21480: scene=WIK_CHAP2START
#: WIK_CHAP2START:68
msgctxt "text_id=21480 | speaker=unknown"
msgid "　ホールの真上にあたる屋根裏部屋に入ると、そこはこの世のものとは思えぬ地獄だった。"
msgstr ""

#. Occurrence WIK_CHAP2START:88:21481: scene=WIK_CHAP2START
#: WIK_CHAP2START:88
msgctxt "text_id=21481 | speaker=unknown"
msgid "　部屋の中心には土桔由里彦氏……"
msgstr ""

#. Occurrence WIK_CHAP2START:106:21482: scene=WIK_CHAP2START
#: WIK_CHAP2START:106
msgctxt "text_id=21482 | speaker=unknown"
msgid "　と思われる遺体がある。"
msgstr ""

#. Occurrence WIK_CHAP2START:111:21483: scene=WIK_CHAP2START
#: WIK_CHAP2START:111
msgctxt "text_id=21483 | speaker=unknown"
msgid "　手足は半分以上千切れ、焼かれ、顔もない。"
msgstr ""

#. Occurrence WIK_CHAP2START:116:21484: scene=WIK_CHAP2START
#: WIK_CHAP2START:116
msgctxt "text_id=21484 | speaker=unknown"
msgid "　かろうじて原形を<留|とど>めているのは胴体部分だけ。"
msgstr ""

#. Occurrence WIK_CHAP2START:121:21485: scene=WIK_CHAP2START
#: WIK_CHAP2START:121
msgctxt "text_id=21485 | speaker=unknown"
msgid "　部屋には焦げた臭いが充満し、壁は<煤|すす>だらけだった。"
msgstr ""

#. Occurrence WIK_CHAP2START:171:21486: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:171
msgctxt "text_id=21486 | speaker=tobimaru"
msgid "「……顔はもう分からないが、こりゃ土桔の爺さんのスーツだ。間違いない」"
msgstr ""

#. Occurrence WIK_CHAP2START:183:21487: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_CHAP2START_0000; voice_prefix=B50; voice_category=6; scene=WIK_CHAP2START
#: WIK_CHAP2START:183
msgctxt "text_id=21487 | speaker=kinomi"
msgid "「オレ見ないからね！　絶対見ないから！」"
msgstr ""

#. Occurrence WIK_CHAP2START:193:21488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP2START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP2START
#: WIK_CHAP2START:193
msgctxt "text_id=21488 | speaker=alice"
msgid "「トッキィーったら、素敵な人ね。死に様までお祭りのよう」"
msgstr ""

#. Occurrence WIK_CHAP2START:203:21489: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP2START_0000; voice_prefix=A50; voice_category=12; scene=WIK_CHAP2START
#: WIK_CHAP2START:203
msgctxt "text_id=21489 | speaker=beo"
msgid "「焼き肉が食べたい」"
msgstr ""

#. Occurrence WIK_CHAP2START:213:21490: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:213
msgctxt "text_id=21490 | speaker=kojika"
msgid "「ねえ、部屋に鍵はかけてあったの？」"
msgstr ""

#. Occurrence WIK_CHAP2START:223:21491: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP2START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP2START
#: WIK_CHAP2START:223
msgctxt "text_id=21491 | speaker=aoko"
msgid "「草十郎のへ……いえ、屋根裏部屋に鍵は付いていないわ。常時、誰でも入れる状態よ」"
msgstr ""

#. Occurrence WIK_CHAP2START:248:21492: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP2START_0000; voice_prefix=B80; voice_category=13; scene=WIK_CHAP2START
#: WIK_CHAP2START:248
msgctxt "text_id=21492 | speaker=liddell"
msgid "「シット。これ、死因は爆発による損傷と火傷ね。"
msgstr ""

#. Occurrence WIK_CHAP2START:254:21493: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP2START_0001; voice_prefix=B80; voice_category=13; scene=WIK_CHAP2START
#: WIK_CHAP2START:254
msgctxt "text_id=21493 | speaker=liddell"
msgid "　爆発もとは見あたらないけど……ユリヒコ、爆弾で遊ぶ性癖があったとか？　まあ、芸術家らしいけど」"
msgstr ""

#. Occurrence WIK_CHAP2START:287:21494: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0000; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:287
msgctxt "text_id=21494 | speaker=ritsuka"
msgid "「みんな冷静になりましょう。これは犯罪よ。犯罪の<匂|にお>いがするわ」"
msgstr ""

#. Occurrence WIK_CHAP2START:302:21495: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP2START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP2START
#: WIK_CHAP2START:302
msgctxt "text_id=21495 | speaker=soujuurou"
msgid "「どちらかというと、小麦粉ではないだろうか」"
msgstr ""

#. Occurrence WIK_CHAP2START:336:21496: scene=WIK_CHAP2START
#: WIK_CHAP2START:336
msgctxt "text_id=21496 | speaker=unknown"
msgid "　芳助は怖がって二階で待機している。"
msgstr ""

#. Occurrence WIK_CHAP2START:341:21497: scene=WIK_CHAP2START
#: WIK_CHAP2START:341
msgctxt "text_id=21497 | speaker=unknown"
msgid "　わたしたちは代わる代わる現場を視認していった。"
msgstr ""

#. Occurrence WIK_CHAP2START:378:21498: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:378
msgctxt "text_id=21498 | speaker=ritsuka"
msgid "「みんな、現場には手を触れないようにね。"
msgstr ""

#. Occurrence WIK_CHAP2START:399:21499: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:399
msgctxt "text_id=21499 | speaker=ritsuka"
msgid "　見るときは二人一組で、どちらかが偽装工作をしないか監視しながら調査して。"
msgstr ""

#. Occurrence WIK_CHAP2START:420:21500: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:420
msgctxt "text_id=21500 | speaker=ritsuka"
msgid "　アッちゃん、警察に連絡をいれてもいい？　ありがと、それじゃあロビーの電話、借りるわね」"
msgstr ""

#. Occurrence WIK_CHAP2START:445:21501: scene=WIK_CHAP2START
#: WIK_CHAP2START:445
msgctxt "text_id=21501 | speaker=unknown"
msgid "　活き活きしはじめた律架さんの指示に従って、二人一組で行動する。"
msgstr ""

#. Occurrence WIK_CHAP2START:450:21502: scene=WIK_CHAP2START
#: WIK_CHAP2START:450
msgctxt "text_id=21502 | speaker=unknown"
msgid "　芳助が逃げてしまったため、流れ的に、わたしは槻司と組むコトになった。"
msgstr ""

#. Occurrence WIK_CHAP2START:485:21503: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:485
msgctxt "text_id=21503 | speaker=tobimaru"
msgid "「―――しっかし、とんでもねえ死因だな。"
msgstr ""

#. Occurrence WIK_CHAP2START:491:21504: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:491
msgctxt "text_id=21504 | speaker=tobimaru"
msgid "　爆発って、犯人はなに考えてやがる」"
msgstr ""

#. Occurrence WIK_CHAP2START:500:21505: scene=WIK_CHAP2START
#: WIK_CHAP2START:500
msgctxt "text_id=21505 | speaker=unknown"
msgid "　意外なのは、槻司がもう「何者かによる殺人事件」と断定している事だ。"
msgstr ""

#. Occurrence WIK_CHAP2START:526:21506: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0001; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:526
msgctxt "text_id=21506 | speaker=kojika"
msgid "「……これ、事故じゃないの？」"
msgstr ""

#. Occurrence WIK_CHAP2START:538:21507: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:538
msgctxt "text_id=21507 | speaker=tobimaru"
msgid "「土桔の爺さんが久遠寺邸で爆発物を取り扱う可能性はゼロだからな」"
msgstr ""

#. Occurrence WIK_CHAP2START:565:21508: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:565
msgctxt "text_id=21508 | speaker=tobimaru"
msgid "「ほら、この胴体、ちょっと見てみろ。腰のあたりに妙な焼け跡がある。これロープじゃねえかな。"
msgstr ""

#. Occurrence WIK_CHAP2START:571:21509: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:571
msgctxt "text_id=21509 | speaker=tobimaru"
msgid "　土桔の爺さんは、この部屋でロープで縛られて、軟禁されていたと見るのが妥当だろう」"
msgstr ""

#. Occurrence WIK_CHAP2START:582:21510: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0002; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:582
msgctxt "text_id=21510 | speaker=kojika"
msgid "「――――――」"
msgstr ""

#. Occurrence WIK_CHAP2START:602:21511: scene=WIK_CHAP2START
#: WIK_CHAP2START:602
msgctxt "text_id=21511 | speaker=unknown"
msgid "　では、ロープで縛られて、誰にも気付かれないうちに爆弾で殺された……？"
msgstr ""

#. Occurrence WIK_CHAP2START:613:21512: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0003; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:613
msgctxt "text_id=21512 | speaker=kojika"
msgid "「でも、なんだって」"
msgstr ""

#. Occurrence WIK_CHAP2START:625:21513: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:625
msgctxt "text_id=21513 | speaker=tobimaru"
msgid "「ああ。なんだって、そんな回りくどいコトをしたかって話だ。"
msgstr ""

#. Occurrence WIK_CHAP2START:638:21514: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:638
msgctxt "text_id=21514 | speaker=tobimaru"
msgid "爆発物を使う利点は……そうだな、起爆までのタイムラグを利用した時間操作と、遠隔操作があげられる。どちらも<不在証明|アリバイ>作りには有利だな」"
msgstr ""

#. Occurrence WIK_CHAP2START:663:21515: scene=WIK_CHAP2START
#: WIK_CHAP2START:663
msgctxt "text_id=21515 | speaker=unknown"
msgid "　……驚きだ。"
msgstr ""

#. Occurrence WIK_CHAP2START:668:21516: scene=WIK_CHAP2START
#: WIK_CHAP2START:668
msgctxt "text_id=21516 | speaker=unknown"
msgid "　槻司は死体を前にしても怯んでいない。"
msgstr ""

#. Occurrence WIK_CHAP2START:673:21517: scene=WIK_CHAP2START
#: WIK_CHAP2START:673
msgctxt "text_id=21517 | speaker=unknown"
msgid "　いたって冷静に、かつ真剣に、この状況を分析しようとしている。"
msgstr ""

#. Occurrence WIK_CHAP2START:678:21518: scene=WIK_CHAP2START
#: WIK_CHAP2START:678
msgctxt "text_id=21518 | speaker=unknown"
msgid "　こういう時の槻司は、たいへん絵になる。"
msgstr ""

#. Occurrence WIK_CHAP2START:683:21519: scene=WIK_CHAP2START
#: WIK_CHAP2START:683
msgctxt "text_id=21519 | speaker=unknown"
msgid "　というか、基本的にこの男は、本気になれば文句なしに格好いいのだ。"
msgstr ""

#. Occurrence WIK_CHAP2START:710:21520: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:710
msgctxt "text_id=21520 | speaker=tobimaru"
msgid "「だがまあ凶器は分かった。パンだ」"
msgstr ""

#. Occurrence WIK_CHAP2START:721:21521: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0004; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:721
msgctxt "text_id=21521 | speaker=kojika"
msgid "「はい？」"
msgstr ""

#. Occurrence WIK_CHAP2START:726:21522: scene=WIK_CHAP2START
#: WIK_CHAP2START:726
msgctxt "text_id=21522 | speaker=unknown"
msgid "　その時、下からわたしたちを呼ぶ声があった。"
msgstr ""

#. Occurrence WIK_CHAP2START:747:21523: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:747
msgctxt "text_id=21523 | speaker=ritsuka"
msgid "「みんな、ちょっと来てー！　大変よー！"
msgstr ""

#. Occurrence WIK_CHAP2START:753:21524: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:753
msgctxt "text_id=21524 | speaker=ritsuka"
msgid "　電話、繋がってないわー！」"
msgstr ""

#. Occurrence WIK_CHAP2START:776:21525: scene=WIK_CHAP2START
#: WIK_CHAP2START:776
msgctxt "text_id=21525 | speaker=unknown"
msgid "　槻司と顔を見合わせる。"
msgstr ""

#. Occurrence WIK_CHAP2START:788:21526: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:788
msgctxt "text_id=21526 | speaker=tobimaru"
msgid "「久万梨、行くぞ」"
msgstr ""

#. Occurrence WIK_CHAP2START:798:21527: scene=WIK_CHAP2START
#: WIK_CHAP2START:798
msgctxt "text_id=21527 | speaker=unknown"
msgid "　頷いて屋根裏を後にする。"
msgstr ""

#. Occurrence WIK_CHAP2START:820:21528: scene=WIK_CHAP2START
#: WIK_CHAP2START:820
msgctxt "text_id=21528 | speaker=unknown"
msgid "　二階で待機していた詠梨神父は、わたしたちが出ると扉を閉め、外付けの南京錠で部屋を施錠した。"
msgstr ""

#. Occurrence WIK_CHAP2START:868:21529: scene=WIK_CHAP2START
#: WIK_CHAP2START:868
msgctxt "text_id=21529 | speaker=unknown"
msgid "　雨音が耳に痛い。"
msgstr ""

#. Occurrence WIK_CHAP2START:873:21530: scene=WIK_CHAP2START
#: WIK_CHAP2START:873
msgctxt "text_id=21530 | speaker=unknown"
msgid "　屋根裏から下りてきたわたしたちは、受話器の前に集まっていた。"
msgstr ""

#. Occurrence WIK_CHAP2START:899:21531: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:899
msgctxt "text_id=21531 | speaker=ritsuka"
msgid "「電話線が切れている……んじゃなくて、電話線そのものが抜かれてるわ。これじゃあ警察に通報するのはおろか、外部への連絡も不可能よ」"
msgstr ""

#. Occurrence WIK_CHAP2START:908:21532: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP2START_0001; voice_prefix=A30; voice_category=3; scene=WIK_CHAP2START
#: WIK_CHAP2START:908
msgctxt "text_id=21532 | speaker=soujuurou"
msgid "「じゃあ、直接呼びに行ってきます」"
msgstr ""

#. Occurrence WIK_CHAP2START:917:21533: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0001; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:917
msgctxt "text_id=21533 | speaker=eiri"
msgid "「いえ、それは待ってください。いま単独行動をされるのはよろしくありません。ほら、外も」"
msgstr ""

#. Occurrence WIK_CHAP2START:937:21534: scene=WIK_CHAP2START
#: WIK_CHAP2START:937
msgctxt "text_id=21534 | speaker=unknown"
msgid "　神父が天窓を指さす。"
msgstr ""

#. Occurrence WIK_CHAP2START:1000:21535: scene=WIK_CHAP2START
#: WIK_CHAP2START:1000
msgctxt "text_id=21535 | speaker=unknown"
msgid "　……雨だれがうるさい筈だ。"
msgstr ""

#. Occurrence WIK_CHAP2START:1005:21536: scene=WIK_CHAP2START
#: WIK_CHAP2START:1005
msgctxt "text_id=21536 | speaker=unknown"
msgid "　外の天気は、もはや嵐と呼んでいい荒れ方だった。"
msgstr ""

#. Occurrence WIK_CHAP2START:1010:21537: scene=WIK_CHAP2START
#: WIK_CHAP2START:1010
msgctxt "text_id=21537 | speaker=unknown"
msgid "　徒歩でやって来たわたしたちだが、この天気で山を下りるのは少しばかり危険な気がする。"
msgstr ""

#. Occurrence WIK_CHAP2START:1030:21538: scene=WIK_CHAP2START
#: WIK_CHAP2START:1030
msgctxt "text_id=21538 | speaker=unknown"
msgid "　それに……詠梨神父が“単独行動はよろしくない”と言った理由は、何も静希の安全を気遣っての事ではない。"
msgstr ""

#. Occurrence WIK_CHAP2START:1035:21539: scene=WIK_CHAP2START
#: WIK_CHAP2START:1035
msgctxt "text_id=21539 | speaker=unknown"
msgid "　この状況でひとりきりで行動されるのは、残された者たちにとっても不利益なのだ。"
msgstr ""

#. Occurrence WIK_CHAP2START:1040:21540: scene=WIK_CHAP2START
#: WIK_CHAP2START:1040
msgctxt "text_id=21540 | speaker=unknown"
msgid "　たとえば―――ひとりになった事を利用しての、様々な証拠隠滅、とか。"
msgstr ""

#. Occurrence WIK_CHAP2START:1066:21541: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0002; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:1066
msgctxt "text_id=21541 | speaker=eiri"
msgid "「とりあえず居間に集まりましょう。"
msgstr ""

#. Occurrence WIK_CHAP2START:1072:21542: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0003; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:1072
msgctxt "text_id=21542 | speaker=eiri"
msgid "　警察に連絡を入れるのは、話を整理してからでも遅くはありません」"
msgstr ""

#. Occurrence WIK_CHAP2START:1130:21543: scene=WIK_CHAP2START
#: WIK_CHAP2START:1130
msgctxt "text_id=21543 | speaker=unknown"
msgid "　神父の意見にみんな賛成する。"
msgstr ""

#. Occurrence WIK_CHAP2START:1170:21544: scene=WIK_CHAP2START
#: WIK_CHAP2START:1170
msgctxt "text_id=21544 | speaker=unknown"
msgid "　前言撤回。芳助だけは、“なにこれ、ドッキリ？”と現実を見ていなかった。"
msgstr ""

#. Occurrence WIK_CHAP2START:1220:21545: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0005; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:1220
msgctxt "text_id=21545 | speaker=kojika"
msgid "「………………」"
msgstr ""

#. Occurrence WIK_CHAP2START:1225:21546: scene=WIK_CHAP2START
#: WIK_CHAP2START:1225
msgctxt "text_id=21546 | speaker=unknown"
msgid "　薄ら寒いものを感じて、なんとなく、玄関に視線をやった。"
msgstr ""

#. Occurrence WIK_CHAP2START:1230:21547: scene=WIK_CHAP2START
#: WIK_CHAP2START:1230
msgctxt "text_id=21547 | speaker=unknown"
msgid "　……微かな違和感。"
msgstr ""

#. Occurrence WIK_CHAP2START:1235:21548: scene=WIK_CHAP2START
#: WIK_CHAP2START:1235
msgctxt "text_id=21548 | speaker=unknown"
msgid "　外の雨は強くなる一方だ。"
msgstr ""

#. Occurrence WIK_CHAP2START:1240:21549: scene=WIK_CHAP2START
#: WIK_CHAP2START:1240
msgctxt "text_id=21549 | speaker=unknown"
msgid "　わたしは、漠然と、"
msgstr ""

#. Occurrence WIK_SELECT_F:8:21550: scene=WIK_SELECT_F
#: WIK_SELECT_F:8
msgctxt "text_id=21550 | speaker=unknown"
msgid "～選択肢Ｆ～"
msgstr ""

#. Occurrence WIK_CHAP3START:138:21551: scene=WIK_CHAP3START
#: WIK_CHAP3START:138
msgctxt "text_id=21551 | speaker=unknown"
msgid "　満場一致で山城先生の捜索が開始された。"
msgstr ""

#. Occurrence WIK_CHAP3START:152:21552: scene=WIK_CHAP3START
#: WIK_CHAP3START:152
msgctxt "text_id=21552 | speaker=unknown"
msgid "　手分けして館内を回っていると、二階の客室を担当していた律架さんがみんなを呼び集めた。"
msgstr ""

#. Occurrence WIK_CHAP3START:177:21553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:177
msgctxt "text_id=21553 | speaker=aoko"
msgid "「ここ、山城先生の客室ね。鍵はかかっているの？」"
msgstr ""

#. Occurrence WIK_CHAP3START:187:21554: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0000_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:187
msgctxt "text_id=21554 | speaker=ritsuka"
msgid "「かかっていなかったわ。留守だと思って中を覗いてみたん、"
msgstr ""

#. Occurrence WIK_CHAP3START:201:21555: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0000_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:201
msgctxt "text_id=21555 | speaker=ritsuka"
msgid "だけど……っっ」"
msgstr ""

#. Occurrence WIK_CHAP3START:207:21556: scene=WIK_CHAP3START
#: WIK_CHAP3START:207
msgctxt "text_id=21556 | speaker=unknown"
msgid "　律架さんはそこで言葉を止めた。"
msgstr ""

#. Occurrence WIK_CHAP3START:212:21557: scene=WIK_CHAP3START
#: WIK_CHAP3START:212
msgctxt "text_id=21557 | speaker=unknown"
msgid "　最後のあたりはなんとなく笑いを<堪|こら>えているように見えたが、気のせいだと思いたい。"
msgstr ""

#. Occurrence WIK_CHAP3START:241:21558: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:241
msgctxt "text_id=21558 | speaker=ritsuka"
msgid "「とにかく中を見て。話はその後にしましょう」"
msgstr ""

#. Occurrence WIK_CHAP3START:260:21559: scene=WIK_CHAP3START
#: WIK_CHAP3START:260
msgctxt "text_id=21559 | speaker=unknown"
msgid "　律架さんに<促|うなが>されて、わたしたちは部屋の中に足を踏み入れた。"
msgstr ""

#. Occurrence WIK_CHAP3START:332:21560: scene=WIK_CHAP3START
#: WIK_CHAP3START:332
msgctxt "text_id=21560 | speaker=unknown"
msgid "　客室に入るとそこは"
msgstr ""

#. Occurrence WIK_CHAP3START:338:21561: scene=WIK_CHAP3START
#: WIK_CHAP3START:338
msgctxt "text_id=21561 | speaker=unknown"
msgid "　一面の花景色。"
msgstr ""

#. Occurrence WIK_CHAP3START:408:21562: scene=WIK_CHAP3START
#: WIK_CHAP3START:408
msgctxt "text_id=21562 | speaker=unknown"
msgid "　その中心に、山城先生は眠るように息絶えていた。"
msgstr ""

#. Occurrence WIK_CHAP3START:461:21563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0001; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:461
msgctxt "text_id=21563 | speaker=aoko"
msgid "「ちょっ、ファラオ眠りって……！」"
msgstr ""

#. Occurrence WIK_CHAP3START:467:21564: scene=WIK_CHAP3START
#: WIK_CHAP3START:467
msgctxt "text_id=21564 | speaker=unknown"
msgid "　蒼崎は必死に笑いを堪えている。"
msgstr ""

#. Occurrence WIK_CHAP3START:495:21565: scene=WIK_CHAP3START
#: WIK_CHAP3START:495
msgctxt "text_id=21565 | speaker=unknown"
msgid "　かくいうわたしも、こみ上げたものを飲みこむので精一杯だった。"
msgstr ""

#. Occurrence WIK_CHAP3START:500:21566: scene=WIK_CHAP3START
#: WIK_CHAP3START:500
msgctxt "text_id=21566 | speaker=unknown"
msgid "　不謹慎だけど、花に囲まれた状態で満足そうに永眠している山城先生のビジュアルは、厳かなお葬式というより、紅白歌合戦の大歌手を連想させたからだ。"
msgstr ""

#. Occurrence WIK_CHAP3START:529:21567: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0000; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:529
msgctxt "text_id=21567 | speaker=eiri"
msgid "「いやはや、いたって健全な方だと思っていたのですが。"
msgstr ""

#. Occurrence WIK_CHAP3START:535:21568: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0001; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:535
msgctxt "text_id=21568 | speaker=eiri"
msgid "　山城先生は普段、どんな人生を送りたいと思っていたのでしょうね？」"
msgstr ""

#. Occurrence WIK_CHAP3START:550:21569: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0000; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:550
msgctxt "text_id=21569 | speaker=liddell"
msgid "「なにこれ。ただの教師がアタシより派手な死に方とか、ふざけてるの？」"
msgstr ""

#. Occurrence WIK_CHAP3START:594:21570: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0000; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:594
msgctxt "text_id=21570 | speaker=yuika"
msgid "「皆さん、詮索はそこまでです。<故人|こじん>の人間性をどうこう言うのはデリカシーが欠けています。"
msgstr ""

#. Occurrence WIK_CHAP3START:607:21571: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0001; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:607
msgctxt "text_id=21571 | speaker=yuika"
msgid "　今後、新たな犠牲者が出た時、その死を笑うような事はないように。いいですね」"
msgstr ""

#. Occurrence WIK_CHAP3START:631:21572: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0002; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:631
msgctxt "text_id=21572 | speaker=eiri"
msgid "「あ、はい。すみません、確かに不謹慎でした。"
msgstr ""

#. Occurrence WIK_CHAP3START:642:21573: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0003; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:642
msgctxt "text_id=21573 | speaker=eiri"
msgid "　やはりこういう時は頼りになりますね、唯架くんは」"
msgstr ""

#. Occurrence WIK_CHAP3START:655:21574: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0002; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:655
msgctxt "text_id=21574 | speaker=yuika"
msgid "「大人として当然の注意です。学生を監督する立場なのですから、エイリ神父も軽はずみな行為は控えてください」"
msgstr ""

#. Occurrence WIK_CHAP3START:690:21575: scene=WIK_CHAP3START
#: WIK_CHAP3START:690
msgctxt "text_id=21575 | speaker=unknown"
msgid "　ぴしゃりとした唯架さんのお叱りで、部屋の雰囲気は一気に冷えこんだ。"
msgstr ""

#. Occurrence WIK_CHAP3START:695:21576: scene=WIK_CHAP3START
#: WIK_CHAP3START:695
msgctxt "text_id=21576 | speaker=unknown"
msgid "　わたしたちは部屋を調べた後、久遠寺さんのマスターキーで山城先生の客室を施錠して、居間に戻ることになった。"
msgstr ""

#. Occurrence WIK_CHAP3START:779:21577: scene=WIK_CHAP3START
#: WIK_CHAP3START:779
msgctxt "text_id=21577 | speaker=unknown"
msgid "　居間は重苦しい空気に包まれている。"
msgstr ""

#. Occurrence WIK_CHAP3START:784:21578: scene=WIK_CHAP3START
#: WIK_CHAP3START:784
msgctxt "text_id=21578 | speaker=unknown"
msgid "　この重苦しさは死者が増えた事による<悲愴感|ひそうかん>ではない。"
msgstr ""

#. Occurrence WIK_CHAP3START:789:21579: scene=WIK_CHAP3START
#: WIK_CHAP3START:789
msgctxt "text_id=21579 | speaker=unknown"
msgid "　二人一組になった事で、ある種の空気が<蔓延|まんえん>しだしている事に、わたしは気付いていた。"
msgstr ""

#. Occurrence WIK_CHAP3START:795:21580: scene=WIK_CHAP3START
#: WIK_CHAP3START:795
msgctxt "text_id=21580 | speaker=unknown"
msgid "　……よくない事に、わたしたちは他のチームを疑い始めてしまっている。"
msgstr ""

#. Occurrence WIK_CHAP3START:822:21581: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:822
msgctxt "text_id=21581 | speaker=tobimaru"
msgid "「客室に乱れた様子はなかった。山城を客室に誘い込んだのか、山城が客室にいる時にやってきたのか。"
msgstr ""

#. Occurrence WIK_CHAP3START:834:21582: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:834
msgctxt "text_id=21582 | speaker=tobimaru"
msgid "　どちらにせよ、親しい仲での不意打ちだったんだろう。"
msgstr ""

#. Occurrence WIK_CHAP3START:834:21583: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:834
msgctxt "text_id=21583 | speaker=tobimaru"
msgid "　山城はルールを知らなかったから、あっさり笑わされたんだろうが……」"
msgstr ""

#. Occurrence WIK_CHAP3START:854:21584: scene=WIK_CHAP3START
#: WIK_CHAP3START:854
msgctxt "text_id=21584 | speaker=unknown"
msgid "　槻司は居間に集まった全員に向けて話しかけていた。"
msgstr ""

#. Occurrence WIK_CHAP3START:859:21585: scene=WIK_CHAP3START
#: WIK_CHAP3START:859
msgctxt "text_id=21585 | speaker=unknown"
msgid "　こういう時、みんなの意見を求める立場である詠梨神父がさっきから押し黙っているため、仕方なく代役を買って出た、という顔だ。"
msgstr ""

#. Occurrence WIK_CHAP3START:895:21586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0002; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:895
msgctxt "text_id=21586 | speaker=aoko"
msgid "「なに、鳶丸。アンタにしちゃ歯切れが悪いじゃない。"
msgstr ""

#. Occurrence WIK_CHAP3START:901:21587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0003; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:901
msgctxt "text_id=21587 | speaker=aoko"
msgid "　今の憶測に間違いはないと思うけど？」"
msgstr ""

#. Occurrence WIK_CHAP3START:913:21588: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:913
msgctxt "text_id=21588 | speaker=tobimaru"
msgid "「いや、教会組や久遠寺はともかく、俺や蒼崎、久万梨は山城先生をよく知ってるだろ。"
msgstr ""

#. Occurrence WIK_CHAP3START:925:21589: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:925
msgctxt "text_id=21589 | speaker=tobimaru"
msgid "　あの昼行灯が、他人の冗談に心から笑う、っていうのはかなりレアな出来事じゃないか？」"
msgstr ""

#. Occurrence WIK_CHAP3START:965:21590: scene=WIK_CHAP3START
#: WIK_CHAP3START:965
msgctxt "text_id=21590 | speaker=unknown"
msgid "　そうだ。"
msgstr ""

#. Occurrence WIK_CHAP3START:970:21591: scene=WIK_CHAP3START
#: WIK_CHAP3START:970
msgctxt "text_id=21591 | speaker=unknown"
msgid "　山城先生はいつもニコニコ顔で穏やかだけど、究極の中立者というか、柳に風、のれんに腕押し、<馬耳東風|ばじとうふう>ぐらいにたいていの意見は受け流してしまう。"
msgstr ""

#. Occurrence WIK_CHAP3START:975:21592: scene=WIK_CHAP3START
#: WIK_CHAP3START:975
msgctxt "text_id=21592 | speaker=unknown"
msgid "　山城先生が本気で笑うとしたら、それは不意打ちの、ドッキリテレビみたいな<脅|おど>かし方ではないだろうか。"
msgstr ""

#. Occurrence WIK_CHAP3START:1002:21593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1002
msgctxt "text_id=21593 | speaker=tobimaru"
msgid "「まあ、『どうやって笑わせたか』は後回しだ。"
msgstr ""

#. Occurrence WIK_CHAP3START:1014:21594: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1014
msgctxt "text_id=21594 | speaker=tobimaru"
msgid "　どうも敵さん本気で攻めてきてるみたいだからな。仲良し時間は終わりにして、本題に入ろうぜ」"
msgstr ""

#. Occurrence WIK_CHAP3START:1023:21595: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0004; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1023
msgctxt "text_id=21595 | speaker=eiri"
msgid "「そうですね。この中の誰がＡなのか。"
msgstr ""

#. Occurrence WIK_CHAP3START:1029:21596: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0005; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1029
msgctxt "text_id=21596 | speaker=eiri"
msgid "　犯人捜しを始めましょう」"
msgstr ""

#. Occurrence WIK_CHAP3START:1065:21597: scene=WIK_CHAP3START
#: WIK_CHAP3START:1065
msgctxt "text_id=21597 | speaker=unknown"
msgid "　聞きたくはない台詞だったけど、同時に誰もが口にしたくてしょうがなかった台詞。"
msgstr ""

#. Occurrence WIK_CHAP3START:1070:21598: scene=WIK_CHAP3START
#: WIK_CHAP3START:1070
msgctxt "text_id=21598 | speaker=unknown"
msgid "　そう、これは避けては通れない。"
msgstr ""

#. Occurrence WIK_CHAP3START:1075:21599: scene=WIK_CHAP3START
#: WIK_CHAP3START:1075
msgctxt "text_id=21599 | speaker=unknown"
msgid "　この中に土桔由里彦氏と山城先生を『意図的に』笑わせた人物Ａがいるのだ。"
msgstr ""

#. Occurrence WIK_CHAP3START:1080:21600: scene=WIK_CHAP3START
#: WIK_CHAP3START:1080
msgctxt "text_id=21600 | speaker=unknown"
msgid "　しかも土桔氏に対しては爆薬まで用いて―――あれ？"
msgstr ""

#. Occurrence WIK_CHAP3START:1116:21601: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP3START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP3START
#: WIK_CHAP3START:1116
msgctxt "text_id=21601 | speaker=kojika"
msgid "「ごめん。今さらだけど、土桔さんの死因ってもしかして」"
msgstr ""

#. Occurrence WIK_CHAP3START:1127:21602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP3START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP3START
#: WIK_CHAP3START:1127
msgctxt "text_id=21602 | speaker=soujuurou"
msgid "「うん、パンに殺されたんだろうね」"
msgstr ""

#. Occurrence WIK_CHAP3START:1138:21603: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1138
msgctxt "text_id=21603 | speaker=alice"
msgid "「トッキィーらしいわ。“この世に小麦粉がなければ、僕は前衛美術で世界をすくっていた”とか、よくこぼしていたもの」"
msgstr ""

#. Occurrence WIK_CHAP3START:1186:21604: scene=WIK_CHAP3START
#: WIK_CHAP3START:1186
msgctxt "text_id=21604 | speaker=unknown"
msgid "　申し訳なさそうに額をかく槻司。"
msgstr ""

#. Occurrence WIK_CHAP3START:1191:21605: scene=WIK_CHAP3START
#: WIK_CHAP3START:1191
msgctxt "text_id=21605 | speaker=unknown"
msgid "　やれ殺害時間の操作だの、身元の隠蔽だのと考察していた自分に呆れているっぽい。"
msgstr ""

#. Occurrence WIK_CHAP3START:1196:21606: scene=WIK_CHAP3START
#: WIK_CHAP3START:1196
msgctxt "text_id=21606 | speaker=unknown"
msgid "　あれで繊細なところもあるのだ、コイツは。"
msgstr ""

#. Occurrence WIK_CHAP3START:1233:21607: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0003; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1233
msgctxt "text_id=21607 | speaker=yuika"
msgid "「犯人捜しなんて、するまでもないと思いますが。"
msgstr ""

#. Occurrence WIK_CHAP3START:1245:21608: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0004; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1245
msgctxt "text_id=21608 | speaker=yuika"
msgid "　これがプロイキッシャーによる犯行なら、第一容疑者は久遠寺有珠、第二容疑者は蒼崎青子、第三容疑者はメイ・リデル・アーシェロット。以上の三名にしぼられます。"
msgstr ""

#. Occurrence WIK_CHAP3START:1257:21609: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0005; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1257
msgctxt "text_id=21609 | speaker=yuika"
msgid "　彼女たちをここで笑わせてしまえば解決です。脇腹を<抉|えぐ>るなり、足の裏を<削|そ>ぐなりすれば人間は笑います。物理的に」"
msgstr ""

#. Occurrence WIK_CHAP3START:1306:21610: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1306
msgctxt "text_id=21610 | speaker=ritsuka"
msgid "「唯ちゃん、ちょっと落ち着いて。"
msgstr ""

#. Occurrence WIK_CHAP3START:1318:21611: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1318
msgctxt "text_id=21611 | speaker=ritsuka"
msgid "　冷静に、冷静になりましょう、みんな。ケンカはよくないわ、犯人の思うつぼよ、きっと！"
msgstr ""

#. Occurrence WIK_CHAP3START:1330:21612: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1330
msgctxt "text_id=21612 | speaker=ritsuka"
msgid "　もっとミステリ的に考えましょう。まずはアリバイ検証とか、ほら、物理的に穏やかな方向で！」"
msgstr ""

#. Occurrence WIK_CHAP3START:1339:21613: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0006; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1339
msgctxt "text_id=21613 | speaker=eiri"
msgid "「律架に賛成です。唯架くんも、それは最後の手段としてとっておいてくださいね。槻司くんや久万梨さんが同席しているんですから」"
msgstr ""

#. Occurrence WIK_CHAP3START:1388:21614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1388
msgctxt "text_id=21614 | speaker=tobimaru"
msgid "「アリバイ検証はちょっと待ってもらえますか？"
msgstr ""

#. Occurrence WIK_CHAP3START:1399:21615: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1399
msgctxt "text_id=21615 | speaker=tobimaru"
msgid "　その前に、スイーツハーツだっけか？　そいつの特徴を詳しく聞きたいんですけど。"
msgstr ""

#. Occurrence WIK_CHAP3START:1405:21616: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1405
msgctxt "text_id=21616 | speaker=tobimaru"
msgid "　久遠寺、知ってる事を話してくれ。"
msgstr ""

#. Occurrence WIK_CHAP3START:1437:21617: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1437
msgctxt "text_id=21617 | speaker=tobimaru"
msgid "　ルールがどうたら以前に、そいつがどういうカタチなのか、俺たちは知らねえんだ」"
msgstr ""

#. Occurrence WIK_CHAP3START:1477:21618: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0001; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1477
msgctxt "text_id=21618 | speaker=alice"
msgid "「そうね。肝心な事を説明していなかったわ。"
msgstr ""

#. Occurrence WIK_CHAP3START:1489:21619: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0002; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1489
msgctxt "text_id=21619 | speaker=alice"
msgid "　スイーツハーツは卵形のプディングよ。<王冠|おうかん>を逆さにして、ゆで卵を載せたようなカタチ」"
msgstr ""

#. Occurrence WIK_CHAP3START:1640:21620: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1640
msgctxt "text_id=21620 | speaker=ritsuka"
msgid "「斬新ね。プリンに殺されるミステリとか、今まで聞いた事もなかったわ」"
msgstr ""

#. Occurrence WIK_CHAP3START:1678:21621: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0001; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1678
msgctxt "text_id=21621 | speaker=liddell"
msgid "「バカなの？　バカしかいないの？"
msgstr ""

#. Occurrence WIK_CHAP3START:1690:21622: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0002; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1690
msgctxt "text_id=21622 | speaker=liddell"
msgid "　それは発動する前のカタチよ。スイーツハーツは自分を食べた相手に、そっくりそのまま<擬態|ぎたい>するの」"
msgstr ""

#. Occurrence WIK_CHAP3START:1717:21623: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0003; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1717
msgctxt "text_id=21623 | speaker=liddell"
msgid "「というか、スイーツハーツを食べちゃった時点で、食べた人間……これが使用者ね、使用者は卵の中に閉じこめられて、外にはスイーツハーツが擬態した“使用者”が現れる。"
msgstr ""

#. Occurrence WIK_CHAP3START:1723:21624: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0004; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1723
msgctxt "text_id=21624 | speaker=liddell"
msgid "　活動をはじめたスイーツハーツは、人間のカタチをしているってコト」"
msgstr ""

#. Occurrence WIK_CHAP3START:1781:21625: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0010; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1781
msgctxt "text_id=21625 | speaker=tobimaru"
msgid "「―――理屈も道理もあえて訊かないが、要は、本物と偽者が入れ替わるんだな？」"
msgstr ""

#. Occurrence WIK_CHAP3START:1790:21626: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0005; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1790
msgctxt "text_id=21626 | speaker=liddell"
msgid "「前言は撤回してあげる。トビマルだけは猿以上ね。"
msgstr ""

#. Occurrence WIK_CHAP3START:1801:21627: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0006; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1801
msgctxt "text_id=21627 | speaker=liddell"
msgid "　そう、スイーツハーツは使用者に化けるプロイなの。それも完全によ。なにしろ起動してしまったら、スイーツハーツすら自分が“犯人”だとは思っていないんだもの」"
msgstr ""

#. Occurrence WIK_CHAP3START:1827:21628: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0007; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1827
msgctxt "text_id=21628 | speaker=liddell"
msgid "「完全に化けるってそういうコトでしょう？"
msgstr ""

#. Occurrence WIK_CHAP3START:1838:21629: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0008; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1838
msgctxt "text_id=21629 | speaker=liddell"
msgid "　犯人と思わしきヤツをどんなに詰問しても、拷問しても、ソレがスイーツハーツだっていう客観的、かつ絶対的な証拠がないと正体は暴けない。"
msgstr ""

#. Occurrence WIK_CHAP3START:1850:21630: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0009; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1850
msgctxt "text_id=21630 | speaker=liddell"
msgid "　“使用者”は証拠をつきつけられて、ようやく自分がスイーツハーツだって気が付くのよ」"
msgstr ""

#. Occurrence WIK_CHAP3START:1909:21631: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1909
msgctxt "text_id=21631 | speaker=ritsuka"
msgid "「あああーん！　なにそのロジックパズル！"
msgstr ""

#. Occurrence WIK_CHAP3START:1916:21632: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0007; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1916
msgctxt "text_id=21632 | speaker=ritsuka"
msgid "　たまんないですっ！　正直、もうたまんないです！」"
msgstr ""

#. Occurrence WIK_CHAP3START:1927:21633: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0006; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1927
msgctxt "text_id=21633 | speaker=yuika"
msgid "「……一流のスパイは、まず自分はスパイではないと自己暗示をかけると言いますが……厄介ですね」"
msgstr ""

#. Occurrence WIK_CHAP3START:1940:21634: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0007; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1940
msgctxt "text_id=21634 | speaker=eiri"
msgid "「いえ、それはおかしい。犯人は明確に笑わせにきているのでしょう？　それで自覚がないというのは、どうも」"
msgstr ""

#. Occurrence WIK_CHAP3START:1986:21635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0003; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1986
msgctxt "text_id=21635 | speaker=alice"
msgid "「スイーツハーツと、スイーツハーツが代行している人間はオンオフで切り替わるの。"
msgstr ""

#. Occurrence WIK_CHAP3START:2001:21636: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0004; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:2001
msgctxt "text_id=21636 | speaker=alice"
msgid "　普段は代行している人間そのものだけど、『ルール実行可能』な条件になると、その時だけスイーツハーツの人格に切り替わる。"
msgstr ""

#. Occurrence WIK_CHAP3START:2015:21637: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0005; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:2015
msgctxt "text_id=21637 | speaker=alice"
msgid "　もちろん、『代行している人間』の時の人格には、スイーツハーツを起動した時の記憶は消失しているわ」"
msgstr ""

#. Occurrence WIK_CHAP3START:2050:21638: scene=WIK_CHAP3START
#: WIK_CHAP3START:2050
msgctxt "text_id=21638 | speaker=unknown"
msgid "　……なんだってのよ、その条件。"
msgstr ""

#. Occurrence WIK_CHAP3START:2055:21639: scene=WIK_CHAP3START
#: WIK_CHAP3START:2055
msgctxt "text_id=21639 | speaker=unknown"
msgid "　まるで姿なき殺戮者、殺意なき殺人鬼じゃない。"
msgstr ""

#. Occurrence WIK_CHAP3START:2060:21640: scene=WIK_CHAP3START
#: WIK_CHAP3START:2060
msgctxt "text_id=21640 | speaker=unknown"
msgid "　その条件なら誰だって―――わたしですら―――含まれてしまう。"
msgstr ""

#. Occurrence WIK_CHAP3START:2065:21641: scene=WIK_CHAP3START
#: WIK_CHAP3START:2065
msgctxt "text_id=21641 | speaker=unknown"
msgid "　現状、誰であれスイーツハーツの可能性があるってコトだもの……！"
msgstr ""

#. Occurrence WIK_CHAP3START:2095:21642: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0008; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2095
msgctxt "text_id=21642 | speaker=ritsuka"
msgid "「みんな、落ち着いて。冷静に、冷静になりましょう。"
msgstr ""

#. Occurrence WIK_CHAP3START:2110:21643: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0009; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2110
msgctxt "text_id=21643 | speaker=ritsuka"
msgid "　楽しいからって騒いだり、ケンカしたり、もう我慢できないわたしは家に帰るぞー、とか叫んで飛び出していったりしちゃダメよ？　絶対死ぬから」"
msgstr ""

#. Occurrence WIK_CHAP3START:2119:21644: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0007; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:2119
msgctxt "text_id=21644 | speaker=yuika"
msgid "「私としては、まず貴女に冷静になってほしいのですが」"
msgstr ""

#. Occurrence WIK_CHAP3START:2166:21645: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0010; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2166
msgctxt "text_id=21645 | speaker=ritsuka"
msgid "「いやーん、ダメ、冷静になんてなれない！"
msgstr ""

#. Occurrence WIK_CHAP3START:2190:21646: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0011_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2190
msgctxt "text_id=21646 | speaker=ritsuka"
msgid "　お願い、夢でも覚めないでっ！　盛り上げる為に、みんなあと半分ぐらい殺されて！　そして当然、最後に生き残るのはわた、"
msgstr ""

#. Occurrence WIK_CHAP3START:2251:21647: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0011_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2251
msgctxt "text_id=21647 | speaker=ritsuka"
msgid "ぐほっ」"
msgstr ""

#. Occurrence WIK_CHAP3START:2293:21648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0004; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2293
msgctxt "text_id=21648 | speaker=aoko"
msgid "「そこまでのトンデモプロイとは思わなかったわ。"
msgstr ""

#. Occurrence WIK_CHAP3START:2299:21649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0005; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2299
msgctxt "text_id=21649 | speaker=aoko"
msgid "　これは真面目にアリバイ検証をするしかなさそうね」"
msgstr ""

#. Occurrence WIK_CHAP3START:2308:21650: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0011; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2308
msgctxt "text_id=21650 | speaker=tobimaru"
msgid "「そうだな。誰がスイーツハーツかは判明しないが、誰なら二人を殺せたかは見えてくるかもしれねえ」"
msgstr ""

#. Occurrence WIK_CHAP3START:2334:21651: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0012; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2334
msgctxt "text_id=21651 | speaker=tobimaru"
msgid "「それぞれこの一日の行動を証言しよう。もし自分の記憶と違ったところがあったら、容赦なく指摘してくれ。"
msgstr ""

#. Occurrence WIK_CHAP3START:2345:21652: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0013; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2345
msgctxt "text_id=21652 | speaker=tobimaru"
msgid "　それじゃあ、まずは俺からだな」"
msgstr ""

#. Occurrence WIK_CHAP3START:2379:21653: scene=WIK_CHAP3START
#: WIK_CHAP3START:2379
msgctxt "text_id=21653 | speaker=unknown"
msgid "　提案者である槻司が先陣をきっては、誰も異論は挟めない。"
msgstr ""

#. Occurrence WIK_CHAP3START:2384:21654: scene=WIK_CHAP3START
#: WIK_CHAP3START:2384
msgctxt "text_id=21654 | speaker=unknown"
msgid "　ここで待ったをかければ、それこそ自分が怪しいというようなものだし。"
msgstr ""

#. Occurrence WIK_CHAP3START:2430:21655: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0014; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2430
msgctxt "text_id=21655 | speaker=tobimaru"
msgid "「俺は午前十時に、ベオと木乃美、土桔の爺さんと久遠寺邸に到着した。"
msgstr ""

#. Occurrence WIK_CHAP3START:2442:21656: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0015; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2442
msgctxt "text_id=21656 | speaker=tobimaru"
msgid "　俺たちは久遠寺に挨拶した後、それぞれ与えられた客室で休憩、十一時には居間に再集合し、昼食をとった。"
msgstr ""

#. Occurrence WIK_CHAP3START:2454:21657: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0016; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2454
msgctxt "text_id=21657 | speaker=tobimaru"
msgid "　……そうだな、たしかそのあたりで土桔の爺さんはいなくなってたな」"
msgstr ""

#. Occurrence WIK_CHAP3START:2481:21658: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0017; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2481
msgctxt "text_id=21658 | speaker=tobimaru"
msgid "「午後になって蒼崎、山城、久万梨が到着。"
msgstr ""

#. Occurrence WIK_CHAP3START:2493:21659: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0018; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2493
msgctxt "text_id=21659 | speaker=tobimaru"
msgid "　夕方になってリデルが呼ばれもしないのに乱入。"
msgstr ""

#. Occurrence WIK_CHAP3START:2505:21660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0019; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2505
msgctxt "text_id=21660 | speaker=tobimaru"
msgid "　何度かトイレで席を立ったが、基本的には居間とサンルームで過ごしていた。"
msgstr ""

#. Occurrence WIK_CHAP3START:2517:21661: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0020; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2517
msgctxt "text_id=21661 | speaker=tobimaru"
msgid "　俺が居間にいた間、常に姿があったのは久遠寺だけだ」"
msgstr ""

#. Occurrence WIK_CHAP3START:2555:21662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0006; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2555
msgctxt "text_id=21662 | speaker=aoko"
msgid "「私は午前中は街で買い物をして、そのまま昼過ぎに久万梨と合流。なぜか山城先生もいたわ。"
msgstr ""

#. Occurrence WIK_CHAP3START:2567:21663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0007; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2567
msgctxt "text_id=21663 | speaker=aoko"
msgid "　三人で洋館に到着したのが二時過ぎ。"
msgstr ""

#. Occurrence WIK_CHAP3START:2579:21664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0008; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2579
msgctxt "text_id=21664 | speaker=aoko"
msgid "　居間で鳶丸たちに挨拶して、あとは居間とサンルームをいったりきたり、だったかな。"
msgstr ""

#. Occurrence WIK_CHAP3START:2591:21665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0009; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2591
msgctxt "text_id=21665 | speaker=aoko"
msgid "　ご不浄で何度か席を立ったけど、一度もトッキィーとは顔を合わせていないわ」"
msgstr ""

#. Occurrence WIK_CHAP3START:2629:21666: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0000; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2629
msgctxt "text_id=21666 | speaker=beo"
msgid "「ボクもするの？　いいけど、みんなと変わらないよ？"
msgstr ""

#. Occurrence WIK_CHAP3START:2641:21667: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0001; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2641
msgctxt "text_id=21667 | speaker=beo"
msgid "　えーと、三連休だったので、昨日はトビーの家で寝泊まりしてあげてたよ。ホースケも一緒だったんで、うるさいコトこの上なかったです。"
msgstr ""

#. Occurrence WIK_CHAP3START:2653:21668: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0002; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2653
msgctxt "text_id=21668 | speaker=beo"
msgid "　で、朝になってから三人で一緒に公園までいって、爺さんと合流して、ロールス・ロイスでここの門に到着。"
msgstr ""

#. Occurrence WIK_CHAP3START:2665:21669: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0003; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2665
msgctxt "text_id=21669 | speaker=beo"
msgid "　十時にはアリスに挨拶して、あとはずっとゴロゴロしてましたー！」"
msgstr ""

#. Occurrence WIK_CHAP3START:2698:21670: scene=WIK_CHAP3START
#: WIK_CHAP3START:2698
msgctxt "text_id=21670 | speaker=unknown"
msgid "　……わたしは、"
msgstr ""

#. Occurrence WIK_SELECT_I:8:21671: scene=WIK_SELECT_I
#: WIK_SELECT_I:8
msgctxt "text_id=21671 | speaker=unknown"
msgid "～選択肢Ｉ～"
msgstr ""

#. Occurrence WIK_CHAP4START:95:21672: scene=WIK_CHAP4START
#: WIK_CHAP4START:95
msgctxt "text_id=21672 | speaker=unknown"
msgid "　残されたわたしたちは、居間に移る事もできずロビーで立ち尽くしていた。"
msgstr ""

#. Occurrence WIK_CHAP4START:115:21673: scene=WIK_CHAP4START
#: WIK_CHAP4START:115
msgctxt "text_id=21673 | speaker=unknown"
msgid "　居間はほぼ明かりが落ちている。"
msgstr ""

#. Occurrence WIK_CHAP4START:120:21674: scene=WIK_CHAP4START
#: WIK_CHAP4START:120
msgctxt "text_id=21674 | speaker=unknown"
msgid "　このまま明かりを求めて客室に移動するのがまっとうな考えなんだろうけど、ここで孤立するのはきまりが悪い。"
msgstr ""

#. Occurrence WIK_CHAP4START:125:21675: scene=WIK_CHAP4START
#: WIK_CHAP4START:125
msgctxt "text_id=21675 | speaker=unknown"
msgid "　十三人目のゲスト、蒼崎のお姉さんが本当にいるのかどうか。"
msgstr ""

#. Occurrence WIK_CHAP4START:130:21676: scene=WIK_CHAP4START
#: WIK_CHAP4START:130
msgctxt "text_id=21676 | speaker=unknown"
msgid "　せめてそれを解明しないと、おちおち部屋に戻れないのだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:163:21677: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:163
msgctxt "text_id=21677 | speaker=soujuurou"
msgid "「とりあえず、唯架さんの彫像は部屋の隅に移動させよう。"
msgstr ""

#. Occurrence WIK_CHAP4START:187:21678: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0001; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:187
msgctxt "text_id=21678 | speaker=soujuurou"
msgid "あれ、重いな。すごく重いぞ唯架さん。"
msgstr ""

#. Occurrence WIK_CHAP4START:199:21679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0002; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:199
msgctxt "text_id=21679 | speaker=soujuurou"
msgid "鳶丸、手伝ってくれ」"
msgstr ""

#. Occurrence WIK_CHAP4START:208:21680: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:208
msgctxt "text_id=21680 | speaker=tobimaru"
msgid "「あいよ、俺うしろな。"
msgstr ""

#. Occurrence WIK_CHAP4START:220:21681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:220
msgctxt "text_id=21681 | speaker=tobimaru"
msgid "……む、見た目通りいい曲線してやがんな唯架さん。"
msgstr ""

#. Occurrence WIK_CHAP4START:231:21682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:231
msgctxt "text_id=21682 | speaker=tobimaru"
msgid "　シスター目当てで教会に通い詰める野郎が多いわけだ」"
msgstr ""

#. Occurrence WIK_CHAP4START:287:21683: scene=WIK_CHAP4START
#: WIK_CHAP4START:287
msgctxt "text_id=21683 | speaker=unknown"
msgid "　静希と槻司はこんな状況でも仲がいい。"
msgstr ""

#. Occurrence WIK_CHAP4START:294:21684: scene=WIK_CHAP4START
#: WIK_CHAP4START:294
msgctxt "text_id=21684 | speaker=unknown"
msgid "　というより、パニックに<陥|おちい>っていない。"
msgstr ""

#. Occurrence WIK_CHAP4START:299:21685: scene=WIK_CHAP4START
#: WIK_CHAP4START:299
msgctxt "text_id=21685 | speaker=unknown"
msgid "　わたしはもう限界ギリギリで、いま後ろから<脅|おど>かされたら笑い死ぬ前にショック死しそうだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:323:21686: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:323
msgctxt "text_id=21686 | speaker=aoko"
msgid "「クマ、お茶でも淹れてこようか？　顔色、真っ青よ」"
msgstr ""

#. Occurrence WIK_CHAP4START:335:21687: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:335
msgctxt "text_id=21687 | speaker=kojika"
msgid "「ありがと。けど要らない」"
msgstr ""

#. Occurrence WIK_CHAP4START:341:21688: scene=WIK_CHAP4START
#: WIK_CHAP4START:341
msgctxt "text_id=21688 | speaker=unknown"
msgid "　トイレ、近くなったらイヤだし。この屋敷のトイレ、奥まったところにあるから怖いのだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:367:21689: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0001; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:367
msgctxt "text_id=21689 | speaker=aoko"
msgid "「お、余裕じゃない。その調子なら朝まで持ちそうね。"
msgstr ""

#. Occurrence WIK_CHAP4START:378:21690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0002; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:378
msgctxt "text_id=21690 | speaker=aoko"
msgid "　詠梨と唯架さんは残念な事になったけど、ある意味、ちょっと安心した。この面子なら気心知れてるし、疑いあう事もないしね。"
msgstr ""

#. Occurrence WIK_CHAP4START:389:21691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0003; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:389
msgctxt "text_id=21691 | speaker=aoko"
msgid "　あとは橙子を見付ければ、」"
msgstr ""

#. Occurrence WIK_CHAP4START:395:21692: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0000; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:395
msgctxt "text_id=21692 | speaker=ritsuka"
msgid "「いえ、それには及ばないわ。ゲームはこれで終わり。"
msgstr ""

#. Occurrence WIK_CHAP4START:401:21693: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:401
msgctxt "text_id=21693 | speaker=ritsuka"
msgid "　今までよくやってくれたものね、アコちゃん？」"
msgstr ""

#. Occurrence WIK_CHAP4START:446:21694: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:446
msgctxt "text_id=21694 | speaker=alice"
msgid "「律架さん？」"
msgstr ""

#. Occurrence WIK_CHAP4START:467:21695: scene=WIK_CHAP4START
#: WIK_CHAP4START:467
msgctxt "text_id=21695 | speaker=unknown"
msgid "　声は階段から聞こえてきた。"
msgstr ""

#. Occurrence WIK_CHAP4START:473:21696: scene=WIK_CHAP4START
#: WIK_CHAP4START:473
msgctxt "text_id=21696 | speaker=unknown"
msgid "　ベオを探しに行った律架さんが戻ってきたのだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:505:21697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0004; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:505
msgctxt "text_id=21697 | speaker=aoko"
msgid "「……なによ。今のどういう意味、律架」"
msgstr ""

#. Occurrence WIK_CHAP4START:517:21698: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:517
msgctxt "text_id=21698 | speaker=ritsuka"
msgid "「だから、芝居はもういいって事です。"
msgstr ""

#. Occurrence WIK_CHAP4START:529:21699: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:529
msgctxt "text_id=21699 | speaker=ritsuka"
msgid "　チェックメイトよアコちゃん。どうしてこんな凶行に及んだのかはぜんっぜん分からないけど、物的証拠が真実を示しているの。"
msgstr ""

#. Occurrence WIK_CHAP4START:541:21700: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:541
msgctxt "text_id=21700 | speaker=ritsuka"
msgid "　まだ断定はしないけど、十中八九、貴女がスイーツハーツ最有力候補よ」"
msgstr ""

#. Occurrence WIK_CHAP4START:597:21701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0005; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:597
msgctxt "text_id=21701 | speaker=aoko"
msgid "「な、なに言いだすのよバカ律架。私がスイーツハーツだなんて、そんな訳ないじゃないっ。"
msgstr ""

#. Occurrence WIK_CHAP4START:608:21702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0006; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:608
msgctxt "text_id=21702 | speaker=aoko"
msgid "　……えーと、ないわよね？　ない筈だと思うけど……」"
msgstr ""

#. Occurrence WIK_CHAP4START:620:21703: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:620
msgctxt "text_id=21703 | speaker=ritsuka"
msgid "「しらばっくれるのもそこまで。"
msgstr ""

#. Occurrence WIK_CHAP4START:631:21704: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:631
msgctxt "text_id=21704 | speaker=ritsuka"
msgid "　ベオくんを捜している時に、貴女の部屋を見させてもらったわ。動かぬ証拠がそこにあるのよ」"
msgstr ""

#. Occurrence WIK_CHAP4START:663:21705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0007; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:663
msgctxt "text_id=21705 | speaker=aoko"
msgid "「うえ!?　ア、アンタ、どうやって私の部屋に入ったのよ!?鍵、かけてあったでしょ!?」"
msgstr ""

#. Occurrence WIK_CHAP4START:681:21706: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0007; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:681
msgctxt "text_id=21706 | speaker=ritsuka"
msgid "「わたしの数少ない特技、本格推理ピッキングです！」"
msgstr ""

#. Occurrence WIK_CHAP4START:707:21707: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0008; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:707
msgctxt "text_id=21707 | speaker=aoko"
msgid "「ないから！　本格でピッキングはご法度だから！"
msgstr ""

#. Occurrence WIK_CHAP4START:718:21708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0009; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:718
msgctxt "text_id=21708 | speaker=aoko"
msgid "　そんなんで、人が必死に隠してた死体を見付けるとか、反則じゃない！」"
msgstr ""

#. Occurrence WIK_CHAP4START:779:21709: scene=WIK_CHAP4START
#: WIK_CHAP4START:779
msgctxt "text_id=21709 | speaker=unknown"
msgid "　取り乱す蒼崎。"
msgstr ""

#. Occurrence WIK_CHAP4START:785:21710: scene=WIK_CHAP4START
#: WIK_CHAP4START:785
msgctxt "text_id=21710 | speaker=unknown"
msgid "　そんな彼女を、わたしたちはじーっと無言で観察する。"
msgstr ""

#. Occurrence WIK_CHAP4START:812:21711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0010_0; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:812
msgctxt "text_id=21711 | speaker=aoko"
msgid "「あ、いや、その……"
msgstr ""

#. Occurrence WIK_CHAP4START:825:21712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0010_1; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:825
msgctxt "text_id=21712 | speaker=aoko"
msgid "てへ☆」"
msgstr ""

#. Occurrence WIK_CHAP4START:836:21713: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:836
msgctxt "text_id=21713 | speaker=tobimaru"
msgid "「草十郎、蒼崎の部屋は？」"
msgstr ""

#. Occurrence WIK_CHAP4START:847:21714: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0003; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:847
msgctxt "text_id=21714 | speaker=soujuurou"
msgid "「東館の二階の突き当たりだ」"
msgstr ""

#. Occurrence WIK_CHAP4START:899:21715: scene=WIK_CHAP4START
#: WIK_CHAP4START:899
msgctxt "text_id=21715 | speaker=unknown"
msgid "　律架さんの先導で、わたしたちは蒼崎の部屋に向かった。"
msgstr ""

#. Occurrence WIK_CHAP4START:904:21716: scene=WIK_CHAP4START
#: WIK_CHAP4START:904
msgctxt "text_id=21716 | speaker=unknown"
msgid "　蒼崎は苦虫をかみつぶしたような顔で付いてくる。"
msgstr ""

#. Occurrence WIK_CHAP4START:914:21717: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0008; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:914
msgctxt "text_id=21717 | speaker=ritsuka"
msgid "「ドアを開けるわ」"
msgstr ""

#. Occurrence WIK_CHAP4START:919:21718: scene=WIK_CHAP4START
#: WIK_CHAP4START:919
msgctxt "text_id=21718 | speaker=unknown"
msgid "　律架さんがドアを開ける。"
msgstr ""

#. Occurrence WIK_CHAP4START:978:21719: scene=WIK_CHAP4START
#: WIK_CHAP4START:978
msgctxt "text_id=21719 | speaker=unknown"
msgid "　暗い廊下から、暗い室内へ。"
msgstr ""

#. Occurrence WIK_CHAP4START:983:21720: scene=WIK_CHAP4START
#: WIK_CHAP4START:983
msgctxt "text_id=21720 | speaker=unknown"
msgid "　わたしたちが蒼崎の部屋に入ると、そこには"
msgstr ""

#. Occurrence WIK_CHAP4START:1088:21721: scene=WIK_CHAP4START
#: WIK_CHAP4START:1088
msgctxt "text_id=21721 | speaker=unknown"
msgid "　同性のわたしでさえ、一目で綺麗だと見惚れる美人が、"
msgstr ""

#. Occurrence WIK_CHAP4START:1094:21722: scene=WIK_CHAP4START
#: WIK_CHAP4START:1094
msgctxt "text_id=21722 | speaker=unknown"
msgid "　片手にマイク、"
msgstr ""

#. Occurrence WIK_CHAP4START:1100:21723: scene=WIK_CHAP4START
#: WIK_CHAP4START:1100
msgctxt "text_id=21723 | speaker=unknown"
msgid "　かたわらに一升瓶を抱えたまま、"
msgstr ""

#. Occurrence WIK_CHAP4START:1106:21724: scene=WIK_CHAP4START
#: WIK_CHAP4START:1106
msgctxt "text_id=21724 | speaker=unknown"
msgid "　満足そうな顔で永眠していた。"
msgstr ""

#. Occurrence WIK_CHAP4START:1126:21725: scene=WIK_CHAP4START
#: WIK_CHAP4START:1126
msgctxt "text_id=21725 | speaker=unknown"
msgid "　くわえて、"
msgstr ""

#. Occurrence WIK_CHAP4START:1168:21726: scene=WIK_CHAP4START
#: WIK_CHAP4START:1168
msgctxt "text_id=21726 | speaker=unknown"
msgid "　部屋には一面、ヘンなポスターが貼られていた。"
msgstr ""

#. Occurrence WIK_CHAP4START:1192:21727: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1192
msgctxt "text_id=21727 | speaker=tobimaru"
msgid "「きゅ、急性アルコール中毒……！」"
msgstr ""

#. Occurrence WIK_CHAP4START:1201:21728: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0009; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1201
msgctxt "text_id=21728 | speaker=ritsuka"
msgid "「これが動かぬ証拠よ。アコちゃん、いくらトコちゃんが邪魔だからって、こんな、恥ずかしい姿のまま放置しておくなんて……！"
msgstr ""

#. Occurrence WIK_CHAP4START:1213:21729: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0010_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1213
msgctxt "text_id=21729 | speaker=ritsuka"
msgid "　トコちゃん、“私はプログレ派だー”なんて言ってたけど、ホントは演歌好きだったのね……"
msgstr ""

#. Occurrence WIK_CHAP4START:1226:21730: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0010_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1226
msgctxt "text_id=21730 | speaker=ritsuka"
msgid "しかも、マイマイクまで持っちゃって……」"
msgstr ""

#. Occurrence WIK_CHAP4START:1253:21731: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0011; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1253
msgctxt "text_id=21731 | speaker=aoko"
msgid "「ああ、身内の恥すぎる……だから見せたくなかったのに！」"
msgstr ""

#. Occurrence WIK_CHAP4START:1259:21732: scene=WIK_CHAP4START
#: WIK_CHAP4START:1259
msgctxt "text_id=21732 | speaker=unknown"
msgid "　身もだえする蒼崎。"
msgstr ""

#. Occurrence WIK_CHAP4START:1264:21733: scene=WIK_CHAP4START
#: WIK_CHAP4START:1264
msgctxt "text_id=21733 | speaker=unknown"
msgid "　しかし。どんな理由であれ、彼女が犠牲者を<隠蔽|いんぺい>していたのは事実である。"
msgstr ""

#. Occurrence WIK_CHAP4START:1306:21734: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0001; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:1306
msgctxt "text_id=21734 | speaker=kojika"
msgid "「そっか……思い返してみれば、蒼崎は自分の部屋に誰も寄りつかないよう動いていたんだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:1318:21735: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0002; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:1318
msgctxt "text_id=21735 | speaker=kojika"
msgid "　この人の死体が見つかったら、色々と不便だから」"
msgstr ""

#. Occurrence WIK_CHAP4START:1344:21736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0012; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1344
msgctxt "text_id=21736 | speaker=aoko"
msgid "「違う、違うってば！　私も被害者なんだって！"
msgstr ""

#. Occurrence WIK_CHAP4START:1350:21737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0013; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1350
msgctxt "text_id=21737 | speaker=aoko"
msgid "　昼過ぎに部屋に戻ってみたら、姉貴がいきなり死んでるんだもん！　そりゃ隠すでしょ、フツー！」"
msgstr ""

#. Occurrence WIK_CHAP4START:1395:21738: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1395
msgctxt "text_id=21738 | speaker=tobimaru"
msgid "「……残念だが、蒼崎。おまえさんの弁明はもう遅い。"
msgstr ""

#. Occurrence WIK_CHAP4START:1407:21739: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1407
msgctxt "text_id=21739 | speaker=tobimaru"
msgid "　それならどうして十三人目がいるかいないかを話しあっている時、姉貴の事を話さなかったんだ？」"
msgstr ""

#. Occurrence WIK_CHAP4START:1433:21740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0014; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1433
msgctxt "text_id=21740 | speaker=aoko"
msgid "「だだ、だって、あの時に切り出しても、どうして黙っていたんだって追及されるじゃない？　詠梨と唯架さんからしてみれば、私を<弾劾|だんがい>する絶好の機会だし。"
msgstr ""

#. Occurrence WIK_CHAP4START:1444:21741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0015; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1444
msgctxt "text_id=21741 | speaker=aoko"
msgid "　それなら黙っていて、私の手で犯人を捕まえようって……」"
msgstr ""

#. Occurrence WIK_CHAP4START:1487:21742: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0011; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1487
msgctxt "text_id=21742 | speaker=ritsuka"
msgid "「そうかしら。“十三人目”がいるって状態にしておけば、アコちゃんが自由に暗躍できるからじゃないの？"
msgstr ""

#. Occurrence WIK_CHAP4START:1499:21743: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0012; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1499
msgctxt "text_id=21743 | speaker=ritsuka"
msgid "　事実、トコちゃんを捜そうとしてベオくんも詠梨さんも唯ちゃんもリタイヤしちゃったんだし」"
msgstr ""

#. Occurrence WIK_CHAP4START:1509:21744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0016; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1509
msgctxt "text_id=21744 | speaker=aoko"
msgid "「だから、それは詠梨たちが自滅しただけで、」"
msgstr ""

#. Occurrence WIK_CHAP4START:1542:21745: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1542
msgctxt "text_id=21745 | speaker=tobimaru"
msgid "「悪いな蒼崎。久遠寺の説明からすると、スイーツハーツとやらは“自分でも分からない”犯人だ。"
msgstr ""

#. Occurrence WIK_CHAP4START:1554:21746: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1554
msgctxt "text_id=21746 | speaker=tobimaru"
msgid "　こいつの正体を暴くには、動機より状況証拠を優先しないといけない」"
msgstr ""

#. Occurrence WIK_CHAP4START:1581:21747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1581
msgctxt "text_id=21747 | speaker=tobimaru"
msgid "「現状、もっとも“今までの犠牲者たち”を殺害できる可能性があったのは、おまえだ」"
msgstr ""

#. Occurrence WIK_CHAP4START:1593:21748: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0013; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1593
msgctxt "text_id=21748 | speaker=ritsuka"
msgid "「ええ。悲しいけど、これ推理なのよね……」"
msgstr ""

#. Occurrence WIK_CHAP4START:1613:21749: scene=WIK_CHAP4START
#: WIK_CHAP4START:1613
msgctxt "text_id=21749 | speaker=unknown"
msgid "　槻司と律架さんが、蒼崎の両手を掴む。"
msgstr ""

#. Occurrence WIK_CHAP4START:1621:21750: scene=WIK_CHAP4START
#: WIK_CHAP4START:1621
msgctxt "text_id=21750 | speaker=unknown"
msgid "　静希もさりげなく手伝っていた。"
msgstr ""

#. Occurrence WIK_CHAP4START:1646:21751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0017; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1646
msgctxt "text_id=21751 | speaker=aoko"
msgid "「ちょっ、どうするつもり！？"
msgstr ""

#. Occurrence WIK_CHAP4START:1660:21752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0018; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1660
msgctxt "text_id=21752 | speaker=aoko"
msgid "　まままさか、疑わしきは殺すってワケ！？」"
msgstr ""

#. Occurrence WIK_CHAP4START:1687:21753: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0014; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1687
msgctxt "text_id=21753 | speaker=ritsuka"
msgid "「落ち着いて、<隔離|かくり>するだけよアコちゃん。"
msgstr ""

#. Occurrence WIK_CHAP4START:1699:21754: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0015; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1699
msgctxt "text_id=21754 | speaker=ritsuka"
msgid "　犯人と思わしき者は警察が来るまで閉じこめて、凶行をストップさせる……ミステリの常道ね。"
msgstr ""

#. Occurrence WIK_CHAP4START:1711:21755: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0016; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1711
msgctxt "text_id=21755 | speaker=ritsuka"
msgid "　えーと、外から鍵をかけられる監獄っぽい部屋はあるかしら、アッちゃん？」"
msgstr ""

#. Occurrence WIK_CHAP4START:1753:21756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0001; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:1753
msgctxt "text_id=21756 | speaker=alice"
msgid "「それなら地下室があるわ。雪山のペンションにありそうな、細い階段から直通の狭い部屋が。"
msgstr ""

#. Occurrence WIK_CHAP4START:1765:21757: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0002; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:1765
msgctxt "text_id=21757 | speaker=alice"
msgid "　青子にはそこで一晩あかしてもらいましょう」"
msgstr ""

#. Occurrence WIK_CHAP4START:1789:21758: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0019; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1789
msgctxt "text_id=21758 | speaker=aoko"
msgid "「スキー跡！"
msgstr ""

msgctxt "text_id=21759 | speaker=unknown"
msgid "　そのペンションの名前、スキー跡とか言わない有珠！？」"
msgstr ""

#. Occurrence WIK_CHAP4START:1820:21760: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0010; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1820
msgctxt "text_id=21760 | speaker=tobimaru"
msgid "「蒼崎。おまえさんがスイーツハーツでないにしろ、そこに閉じこもっていれば安全だろ。これは最後の保険でもあるんだ、観念して生け贄になってくれ」"
msgstr ""

#. Occurrence WIK_CHAP4START:1831:21761: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0020; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1831
msgctxt "text_id=21761 | speaker=aoko"
msgid "「うっ……確かに、そういう理屈になるわね。"
msgstr ""

#. Occurrence WIK_CHAP4START:1842:21762: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0021; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1842
msgctxt "text_id=21762 | speaker=aoko"
msgid "　民主主義的に、閉じこめられる隙を見せた私の負けってコトか……」"
msgstr ""

#. Occurrence WIK_CHAP4START:1877:21763: scene=WIK_CHAP4START
#: WIK_CHAP4START:1877
msgctxt "text_id=21763 | speaker=unknown"
msgid "　そう。本当はこの方法を真っ先にしてしまえば良かったんだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:1882:21764: scene=WIK_CHAP4START
#: WIK_CHAP4START:1882
msgctxt "text_id=21764 | speaker=unknown"
msgid "　蒼崎がスイーツハーツなら、もうこれ以上、不意をついて笑わせられる犠牲者は出ない。"
msgstr ""

#. Occurrence WIK_CHAP4START:1887:21765: scene=WIK_CHAP4START
#: WIK_CHAP4START:1887
msgctxt "text_id=21765 | speaker=unknown"
msgid "　蒼崎がスイーツハーツでないなら、彼女は最後まで生き残るのだから、それでこのゲームはクリアとなる。"
msgstr ""

#. Occurrence WIK_CHAP4START:1919:21766: scene=WIK_CHAP4START
#: WIK_CHAP4START:1919
msgctxt "text_id=21766 | speaker=unknown"
msgid "　けど、誰だって「おまえが犯人だ」と決めつけられて閉じこめられるのはイヤなものだ。"
msgstr ""

#. Occurrence WIK_CHAP4START:1924:21767: scene=WIK_CHAP4START
#: WIK_CHAP4START:1924
msgctxt "text_id=21767 | speaker=unknown"
msgid "　手を下す人間も気持ちが悪い。"
msgstr ""

#. Occurrence WIK_CHAP4START:1929:21768: scene=WIK_CHAP4START
#: WIK_CHAP4START:1929
msgctxt "text_id=21768 | speaker=unknown"
msgid "　この貧乏クジを引くのは、誰から見ても“有罪”な人間でなくてはならなかった。"
msgstr ""

#. Occurrence WIK_CHAP4START:1961:21769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0022; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1961
msgctxt "text_id=21769 | speaker=aoko"
msgid "「でも、これだけは言っておくわ。"
msgstr ""

#. Occurrence WIK_CHAP4START:1967:21770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0023; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1967
msgctxt "text_id=21770 | speaker=aoko"
msgid "　相手はとんでもないキレ者よ。もしかしたら本当に姿のない十三人目はいるかもしれない。最後まで気を抜かないで」"
msgstr ""

#. Occurrence WIK_CHAP4START:2002:21771: scene=WIK_CHAP4START
#: WIK_CHAP4START:2002
msgctxt "text_id=21771 | speaker=unknown"
msgid "　それが蒼崎の最後の言葉になった。"
msgstr ""

#. Occurrence WIK_CHAP4START:2007:21772: scene=WIK_CHAP4START
#: WIK_CHAP4START:2007
msgctxt "text_id=21772 | speaker=unknown"
msgid "　わたしたちは彼女を地下室に閉じこめ、外から南京錠で鍵をかけ、ようやく安心を手に入れたのである。"
msgstr ""

#. Occurrence WIK_CHAP4START:2013:21773: scene=WIK_CHAP4START
#: WIK_CHAP4START:2013
msgctxt "text_id=21773 | speaker=unknown"
msgid "　そして、わたしは―――"
msgstr ""

#. Occurrence WIK_SELECT_R:8:21774: scene=WIK_SELECT_R
#: WIK_SELECT_R:8
msgctxt "text_id=21774 | speaker=unknown"
msgid "～選択肢Ｒ～"
msgstr ""

#. Occurrence WIK_D_1:35:21775: scene=WIK_D_1
#: WIK_D_1:35
msgctxt "text_id=21775 | speaker=unknown"
msgid "　律架さんには申し訳ないけど、このまま雨脚は強くなる一方だろうな、と思った。"
msgstr ""

#. Occurrence WIK_D_2:36:21776: scene=WIK_D_2
#: WIK_D_2:36
msgctxt "text_id=21776 | speaker=unknown"
msgid "　律架さんには申し訳ないけど、このまま雨は雹になるな、と思った。"
msgstr ""

#. Occurrence WIK_D_3:36:21777: scene=WIK_D_3
#: WIK_D_3:36
msgctxt "text_id=21777 | speaker=unknown"
msgid "　わたしは、このまま帰ってしまおうか、と思った。"
msgstr ""

#. Occurrence WIK_D_3:62:21778: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0000; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:62
msgctxt "text_id=21778 | speaker=ritsuka"
msgid "「天気予報はずっとお日様マークだったのに。"
msgstr ""

#. Occurrence WIK_D_3:73:21779: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0001; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:73
msgctxt "text_id=21779 | speaker=ritsuka"
msgid "　……んー、本降りになったら帰りはタイヘンかも。ほら、山の中程までしかあがってこないでしょ、タクシー」"
msgstr ""

#. Occurrence WIK_D_3:106:21780: scene=WIK_D_3
#: WIK_D_3:106
msgctxt "text_id=21780 | speaker=unknown"
msgid "　律架さんの言う通りだ。"
msgstr ""

#. Occurrence WIK_D_3:111:21781: scene=WIK_D_3
#: WIK_D_3:111
msgctxt "text_id=21781 | speaker=unknown"
msgid "　本格的に降り出したら、帰りは濡れるのを覚悟しないといけない。"
msgstr ""

#. Occurrence WIK_D_3:116:21782: scene=WIK_D_3
#: WIK_D_3:116
msgctxt "text_id=21782 | speaker=unknown"
msgid "　二年以上ここから学校に通っていた蒼崎のタフさに、今更ながら感心するような、呆れるような。"
msgstr ""

#. Occurrence WIK_D_3:153:21783: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0002; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:153
msgctxt "text_id=21783 | speaker=ritsuka"
msgid "「あれ？　どうしたの金鹿ちゃん？"
msgstr ""

#. Occurrence WIK_D_3:159:21784: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0003; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:159
msgctxt "text_id=21784 | speaker=ritsuka"
msgid "　みんな居間にいるんじゃないの？」"
msgstr ""

#. Occurrence WIK_D_3:170:21785: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0000; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:170
msgctxt "text_id=21785 | speaker=kojika"
msgid "「いえ、部屋に忘れ物があるんです。"
msgstr ""

#. Occurrence WIK_D_3:181:21786: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0001; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:181
msgctxt "text_id=21786 | speaker=kojika"
msgid "　みなさん、先に行っていてください」"
msgstr ""

#. Occurrence WIK_D_3:303:21787: scene=WIK_D_3
#: WIK_D_3:303
msgctxt "text_id=21787 | speaker=unknown"
msgid "　客室からボストンバッグを回収して、ロビーに戻る。"
msgstr ""

#. Occurrence WIK_D_3:308:21788: scene=WIK_D_3
#: WIK_D_3:308
msgctxt "text_id=21788 | speaker=unknown"
msgid "　居間からは律架さんたちの笑い声が聞こえてくる。"
msgstr ""

#. Occurrence WIK_D_3:313:21789: scene=WIK_D_3
#: WIK_D_3:313
msgctxt "text_id=21789 | speaker=unknown"
msgid "　わたしは賑わいに後ろ髪を引かれながらも、久遠寺邸を後にした。"
msgstr ""

#. Occurrence WIK_D_3:361:21790: scene=WIK_D_3
#: WIK_D_3:361
msgctxt "text_id=21790 | speaker=unknown"
msgid "　どうして帰る気になったのか、自分でもいまいち不明。"
msgstr ""

#. Occurrence WIK_D_3:366:21791: scene=WIK_D_3
#: WIK_D_3:366
msgctxt "text_id=21791 | speaker=unknown"
msgid "　洋館の雰囲気に気圧されたとか、"
msgstr ""

#. Occurrence WIK_D_3:371:21792: scene=WIK_D_3
#: WIK_D_3:371
msgctxt "text_id=21792 | speaker=unknown"
msgid "　やっぱり柄じゃないとか、"
msgstr ""

#. Occurrence WIK_D_3:376:21793: scene=WIK_D_3
#: WIK_D_3:376
msgctxt "text_id=21793 | speaker=unknown"
msgid "　槻司がいたコトとか、たぶん、いろいろ合わさって面倒くさくなったのだ。"
msgstr ""

#. Occurrence WIK_D_3:409:21794: scene=WIK_D_3
#: WIK_D_3:409
msgctxt "text_id=21794 | speaker=unknown"
msgid "　もうじき日も沈む。"
msgstr ""

#. Occurrence WIK_D_3:414:21795: scene=WIK_D_3
#: WIK_D_3:414
msgctxt "text_id=21795 | speaker=unknown"
msgid "　夜になる前に帰れば、何事もなく今日は終わるだろう。"
msgstr ""

#. Occurrence WIK_D_3:419:21796: scene=WIK_D_3
#: WIK_D_3:419
msgctxt "text_id=21796 | speaker=unknown"
msgid "　念願の大学受験を前にして、槻司と顔を合わせるのはいろいろブレそうで怖いし。"
msgstr ""

#. Occurrence WIK_D_3:424:21797: scene=WIK_D_3
#: WIK_D_3:424
msgctxt "text_id=21797 | speaker=unknown"
msgid "　これでいいんだ、と自分に言い聞かせて、わたしは白犬塚を下りていく。"
msgstr ""

#. Occurrence WIK_D_3:486:21798: scene=WIK_D_3
#: WIK_D_3:486
msgctxt "text_id=21798 | speaker=unknown"
msgid "　―――そんな時。"
msgstr ""

#. Occurrence WIK_D_3:491:21799: scene=WIK_D_3
#: WIK_D_3:491
msgctxt "text_id=21799 | speaker=unknown"
msgid "　わたしはふと、子供たちに伝わっていた伝説を、もう一つだけ思い出した。"
msgstr ""

#. Occurrence WIK_D_3:515:21800: scene=WIK_D_3
#: WIK_D_3:515
msgctxt "text_id=21800 | speaker=unknown"
msgid "　　　　　『<逢魔|おうま>が<時|とき>にひとりで山を下りると、"
msgstr ""

#. Occurrence WIK_D_3:520:21801: scene=WIK_D_3
#: WIK_D_3:520
msgctxt "text_id=21801 | speaker=unknown"
msgid "　　　　　　人食い鬼が待っている』"
msgstr ""

#. Occurrence WIK_D_3:540:21802: scene=WIK_D_3
#: WIK_D_3:540
msgctxt "text_id=21802 | speaker=unknown"
msgid "　久遠寺邸が建つ前からもっと昔、この山には鬼が隠れ住んでいて、ひとりきりで輪から外れようとする人間を襲って殺す鬼がいた。"
msgstr ""

#. Occurrence WIK_D_3:545:21803: scene=WIK_D_3
#: WIK_D_3:545
msgctxt "text_id=21803 | speaker=unknown"
msgid "　襲って食べる、というのではなく、殺す、というのが人間的で生々しい。"
msgstr ""

#. Occurrence WIK_D_3:550:21804: scene=WIK_D_3
#: WIK_D_3:550
msgctxt "text_id=21804 | speaker=unknown"
msgid "　村社会のしきたりから外れた人間を村ぐるみで闇に葬った、なんて解釈もできる。"
msgstr ""

#. Occurrence WIK_D_3:555:21805: scene=WIK_D_3
#: WIK_D_3:555
msgctxt "text_id=21805 | speaker=unknown"
msgid "　そんな、暗い妄想に<耽|ふけ>っていると、"
msgstr ""

#. Occurrence WIK_D_3:605:21806: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0002; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:605
msgctxt "text_id=21806 | speaker=kojika"
msgid "「あれ？」"
msgstr ""

#. Occurrence WIK_D_3:611:21807: scene=WIK_D_3
#: WIK_D_3:611
msgctxt "text_id=21807 | speaker=unknown"
msgid "　道を間違えたのだろうか。"
msgstr ""

#. Occurrence WIK_D_3:616:21808: scene=WIK_D_3
#: WIK_D_3:616
msgctxt "text_id=21808 | speaker=unknown"
msgid "　わたしは久遠寺邸の裏側に出てしまった。"
msgstr ""

#. Occurrence WIK_D_3:637:21809: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0003; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:637
msgctxt "text_id=21809 | speaker=kojika"
msgid "「おかしいな……ちゃんと下に向かってたわよね、わたし」"
msgstr ""

#. Occurrence WIK_D_3:643:21810: scene=WIK_D_3
#: WIK_D_3:643
msgctxt "text_id=21810 | speaker=unknown"
msgid "　不安をごまかすように独り言をもらす。"
msgstr ""

#. Occurrence WIK_D_3:665:21811: scene=WIK_D_3
#: WIK_D_3:665
msgctxt "text_id=21811 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence WIK_D_3:670:21812: scene=WIK_D_3
#: WIK_D_3:670
msgctxt "text_id=21812 | speaker=unknown"
msgid "　木の陰に、何か、人間ほどの影があった。"
msgstr ""

#. Occurrence WIK_D_3:705:21813: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0004; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:705
msgctxt "text_id=21813 | speaker=kojika"
msgid "「誰……？」"
msgstr ""

#. Occurrence WIK_D_3:711:21814: scene=WIK_D_3
#: WIK_D_3:711
msgctxt "text_id=21814 | speaker=unknown"
msgid "　声をかける。"
msgstr ""

#. Occurrence WIK_D_3:717:21815: scene=WIK_D_3
#: WIK_D_3:717
msgctxt "text_id=21815 | speaker=unknown"
msgid "返事はない。"
msgstr ""

#. Occurrence WIK_D_3:723:21816: scene=WIK_D_3
#: WIK_D_3:723
msgctxt "text_id=21816 | speaker=unknown"
msgid "空は暗い。"
msgstr ""

#. Occurrence WIK_D_3:729:21817: scene=WIK_D_3
#: WIK_D_3:729
msgctxt "text_id=21817 | speaker=unknown"
msgid "風は吹かない。"
msgstr ""

#. Occurrence WIK_D_3:734:21818: scene=WIK_D_3
#: WIK_D_3:734
msgctxt "text_id=21818 | speaker=unknown"
msgid "　帰ろうと思った本当の理由が頭をよぎる。"
msgstr ""

#. Occurrence WIK_D_3:739:21819: scene=WIK_D_3
#: WIK_D_3:739
msgctxt "text_id=21819 | speaker=unknown"
msgid "　わたしは、そうだ。"
msgstr ""

#. Occurrence WIK_D_3:744:21820: scene=WIK_D_3
#: WIK_D_3:744
msgctxt "text_id=21820 | speaker=unknown"
msgid "　このまま洋館にいたら、何か、よくない事が起きそうだと感じたから―――"
msgstr ""

#. Occurrence WIK_D_3:796:21821: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0005; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:796
msgctxt "text_id=21821 | speaker=kojika"
msgid "「あ―――」"
msgstr ""

#. Occurrence WIK_D_3:819:21822: scene=WIK_D_3
#: WIK_D_3:819
msgctxt "text_id=21822 | speaker=unknown"
msgid "　ありえない光景を直視した。"
msgstr ""

#. Occurrence WIK_D_3:824:21823: scene=WIK_D_3
#: WIK_D_3:824
msgctxt "text_id=21823 | speaker=unknown"
msgid "　お腹がひとりでにへこむような衝撃。"
msgstr ""

#. Occurrence WIK_D_3:829:21824: scene=WIK_D_3
#: WIK_D_3:829
msgctxt "text_id=21824 | speaker=unknown"
msgid "　反射的に口に手を当てたけれど、間に合わなかった。"
msgstr ""

#. Occurrence WIK_D_3:885:21825: scene=WIK_D_3
#: WIK_D_3:885
msgctxt "text_id=21825 | speaker=unknown"
msgid "　……地面に倒れる。"
msgstr ""

#. Occurrence WIK_D_3:893:21826: scene=WIK_D_3
#: WIK_D_3:893
msgctxt "text_id=21826 | speaker=unknown"
msgid "　全身の<血|ねつ>が、力が流れていく。"
msgstr ""

#. Occurrence WIK_D_3:898:21827: scene=WIK_D_3
#: WIK_D_3:898
msgctxt "text_id=21827 | speaker=unknown"
msgid "　助けを呼ぶ手も、むなしく空を切る。"
msgstr ""

#. Occurrence WIK_D_3:903:21828: scene=WIK_D_3
#: WIK_D_3:903
msgctxt "text_id=21828 | speaker=unknown"
msgid "　わたしは最後の力を振り絞って、目の前の人影を視界に収める。"
msgstr ""

#. Occurrence WIK_D_3:934:21829: voice_id=X00_WIK_D_3_0000; voice_prefix=X00; voice_category=0; scene=WIK_D_3
#: WIK_D_3:934
msgctxt "text_id=21829 | speaker=unknown"
msgid "『……ダメジャナイカ。始マル前カラ、終ワルナンテ』"
msgstr ""

#. Occurrence WIK_D_3:982:21830: scene=WIK_D_3
#: WIK_D_3:982
msgctxt "text_id=21830 | speaker=unknown"
msgid "　振り下ろされる鉈状のナニカ。"
msgstr ""

#. Occurrence WIK_D_3:987:21831: scene=WIK_D_3
#: WIK_D_3:987
msgctxt "text_id=21831 | speaker=unknown"
msgid "　鬼の<面|かお>をした誰かが、死にいくわたしにそう言った。"
msgstr ""

#. Occurrence WIK_D_A:41:21832: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:41
msgctxt "text_id=21832 | speaker=ritsuka"
msgid "「さむっ。ここ、外より寒くない？」"
msgstr ""

#. Occurrence WIK_D_A:52:21833: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:52
msgctxt "text_id=21833 | speaker=kojika"
msgid "「ですね。居間に移動しましょう」"
msgstr ""

#. Occurrence WIK_D_A:63:21834: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0001; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:63
msgctxt "text_id=21834 | speaker=ritsuka"
msgid "「賛成だけど…"
msgstr ""

#. Occurrence WIK_D_A:76:21835: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0002; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:76
msgctxt "text_id=21835 | speaker=ritsuka"
msgid "…ま、草十郎さんには草十郎さんの仕事があるんでしょうしね。待っててあげようと思ったけど、余計な気遣いかも」"
msgstr ""

#. Occurrence WIK_D_A:102:21836: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_9000; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:102
msgctxt "text_id=21836 | speaker=kojika"
msgid "「？　静希、外にいたんですか？」"
msgstr ""

#. Occurrence WIK_D_A:114:21837: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0004; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:114
msgctxt "text_id=21837 | speaker=ritsuka"
msgid "「ええ。山道の方で草を刈っていたわ。すごい勢いで、ヘリポートでも造るかっていうぐらい」"
msgstr ""

#. Occurrence WIK_D_A:140:21838: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0001; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:140
msgctxt "text_id=21838 | speaker=kojika"
msgid "「…………」"
msgstr ""

#. Occurrence WIK_D_A:145:21839: scene=WIK_D_A
#: WIK_D_A:145
msgctxt "text_id=21839 | speaker=unknown"
msgid "　相変わらず、謎の行動力である。"
msgstr ""

#. Occurrence WIK_D_A:150:21840: scene=WIK_D_A
#: WIK_D_A:150
msgctxt "text_id=21840 | speaker=unknown"
msgid "　静希の奇行を追及しても疲れるだけだ。"
msgstr ""

#. Occurrence WIK_D_A:155:21841: scene=WIK_D_A
#: WIK_D_A:155
msgctxt "text_id=21841 | speaker=unknown"
msgid "　わたしたちは暖を求めて居間に移動した。"
msgstr ""

#. Occurrence WIK_D_A:239:21842: scene=WIK_D_A
#: WIK_D_A:239
msgctxt "text_id=21842 | speaker=unknown"
msgid "　降り出した雨は、一向に止む気配を見せない。"
msgstr ""

#. Occurrence WIK_D_A:244:21843: scene=WIK_D_A
#: WIK_D_A:244
msgctxt "text_id=21843 | speaker=unknown"
msgid "　むしろ勢いは増すばかりで、日没前だというのに外は夜並みの暗さになっていた。"
msgstr ""

#. Occurrence WIK_D_A:264:21844: scene=WIK_D_A
#: WIK_D_A:264
msgctxt "text_id=21844 | speaker=unknown"
msgid "　パーティーはまだ始まらない。"
msgstr ""

#. Occurrence WIK_D_A:269:21845: scene=WIK_D_A
#: WIK_D_A:269
msgctxt "text_id=21845 | speaker=unknown"
msgid "　居間とサンルームを見渡すと、"
msgstr ""

#. Occurrence WIK_D_A:319:21846: scene=WIK_D_A
#: WIK_D_A:319
msgctxt "text_id=21846 | speaker=unknown"
msgid "　これだけの人数が談話にふけっていた。"
msgstr ""

#. Occurrence WIK_D_A:350:21847: scene=WIK_D_A
#: WIK_D_A:350
msgctxt "text_id=21847 | speaker=unknown"
msgid "　居間では芳助が持ちこんできたカードゲームが思いの外盛り上がっている。"
msgstr ""

#. Occurrence WIK_D_A:381:21848: scene=WIK_D_A
#: WIK_D_A:381
msgctxt "text_id=21848 | speaker=unknown"
msgid "　おもに、いがみ合う方向で。"
msgstr ""

#. Occurrence WIK_D_A:401:21849: scene=WIK_D_A
#: WIK_D_A:401
msgctxt "text_id=21849 | speaker=unknown"
msgid "　なんでも『<傀儡|かいらい>さんが<徹|トゥー>る』という、ドイツ製の、ファンタジー版ゼネコンシミュレーションゲームなのだそうだ。"
msgstr ""

#. Occurrence WIK_D_A:406:21850: scene=WIK_D_A
#: WIK_D_A:406
msgctxt "text_id=21850 | speaker=unknown"
msgid "　基本、いかに相手の足を引っ張るかというゲームなので、みな愛想笑いをしながら内心ではまったく笑えず、騙し討ちの機会を狙っている。"
msgstr ""

#. Occurrence WIK_D_A:427:21851: scene=WIK_D_A
#: WIK_D_A:427
msgctxt "text_id=21851 | speaker=unknown"
msgid "　一方、サンルームの大人組はワインなどを片手に、そんな学生たちの様子を眺めている。"
msgstr ""

#. Occurrence WIK_D_A:453:21852: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:453
msgctxt "text_id=21852 | speaker=eiri"
msgid "「驚きましたね。誕生会が始まるまで、館内は自由に歩いていい決まりだとは。有珠さん、どんな心境の変化ですか？」"
msgstr ""

#. Occurrence WIK_D_A:474:21853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:474
msgctxt "text_id=21853 | speaker=alice"
msgid "「……別に。入られたら困るところは、そもそも壁に変えたから。今日だけの変更だけど、それなら遭難者もでないでしょう」"
msgstr ""

#. Occurrence WIK_D_A:508:21854: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0000; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:508
msgctxt "text_id=21854 | speaker=kinomi"
msgid "「？　壁に変えたってなにをー？"
msgstr ""

#. Occurrence WIK_D_A:521:21855: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0001; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:521
msgctxt "text_id=21855 | speaker=kinomi"
msgid "　それに遭難者とか、有珠ちゃんったら大げさなんだから～。そりゃでけえ屋敷だけど、迷子になんかなりませんよ？」"
msgstr ""

#. Occurrence WIK_D_A:561:21856: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0005; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:561
msgctxt "text_id=21856 | speaker=ritsuka"
msgid "「私たちの客室も用意してくれたのね。夜になったら帰る予定だけど、心遣いは助かっちゃうな～♪"
msgstr ""

#. Occurrence WIK_D_A:572:21857: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0006; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:572
msgctxt "text_id=21857 | speaker=ritsuka"
msgid "　唯ちゃん、せっかくだし服、着替えてこない？"
msgstr ""

#. Occurrence WIK_D_A:583:21858: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0007; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:583
msgctxt "text_id=21858 | speaker=ritsuka"
msgid "　お姉さんのチャイナドレスとか貸してあげるから。さすがにパーティー会場にシスターはどうかと思うし」"
msgstr ""

#. Occurrence WIK_D_A:614:21859: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_D_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_D_A
#: WIK_D_A:614
msgctxt "text_id=21859 | speaker=yuika"
msgid "「結構です。魔女の家で礼装を脱ぐなど自殺行為。私は貴女のように、遊びに来ている訳ではありませんので」"
msgstr ""

#. Occurrence WIK_D_A:639:21860: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:639
msgctxt "text_id=21860 | speaker=eiri"
msgid "「いや、遊びに来てるんですけどねぇ。私ですら手ぶらで来ているのに、シスター唯架ときたら……。"
msgstr ""

#. Occurrence WIK_D_A:651:21861: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0002; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:651
msgctxt "text_id=21861 | speaker=eiri"
msgid "　どうしてこう、いつでも臨戦状態、よらば切る出刃包丁みたいな性格になったんだか」"
msgstr ""

#. Occurrence WIK_D_A:665:21862: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_D_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_D_A
#: WIK_D_A:665
msgctxt "text_id=21862 | speaker=yuika"
msgid "「貴方たち二人が不真面目な分、私が引き締めなくてはいけないだけですっ」"
msgstr ""

#. Occurrence WIK_D_A:734:21863: scene=WIK_D_A
#: WIK_D_A:734
msgctxt "text_id=21863 | speaker=unknown"
msgid "　時刻は六時になった。"
msgstr ""

#. Occurrence WIK_D_A:739:21864: scene=WIK_D_A
#: WIK_D_A:739
msgctxt "text_id=21864 | speaker=unknown"
msgid "　外はもう完全に夜。"
msgstr ""

#. Occurrence WIK_D_A:744:21865: scene=WIK_D_A
#: WIK_D_A:744
msgctxt "text_id=21865 | speaker=unknown"
msgid "　山城先生や教会組がいるから、帰りの夜道は安全だろうけど、それでもこの雨脚には不安をあおられる。"
msgstr ""

#. Occurrence WIK_D_A:801:21866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:801
msgctxt "text_id=21866 | speaker=alice"
msgid "「……そろそろ支度をするべきではないかしら。"
msgstr ""

#. Occurrence WIK_D_A:814:21867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0002; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:814
msgctxt "text_id=21867 | speaker=alice"
msgid "　トッキィーはどこに？」"
msgstr ""

#. Occurrence WIK_D_A:820:21868: scene=WIK_D_A
#: WIK_D_A:820
msgctxt "text_id=21868 | speaker=unknown"
msgid "　何度目かのカードゲームを終えて、ふと、久遠寺さんが妙なコトを口にした。"
msgstr ""

#. Occurrence WIK_D_A:845:21869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0002; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:845
msgctxt "text_id=21869 | speaker=kojika"
msgid "「トッキィー？　トッキィーって、誰？」"
msgstr ""

#. Occurrence WIK_D_A:856:21870: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0002; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:856
msgctxt "text_id=21870 | speaker=kinomi"
msgid "「誰って、土桔の爺さんだろ。あれ……？"
msgstr ""

#. Occurrence WIK_D_A:869:21871: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0003; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:869
msgctxt "text_id=21871 | speaker=kinomi"
msgid "　もしかして金鹿、爺さんに挨拶してねえの？」"
msgstr ""

#. Occurrence WIK_D_A:881:21872: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0003; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:881
msgctxt "text_id=21872 | speaker=kojika"
msgid "「知らない。まだこの家に人がいるの？　……いまさらだけど、全部で何人の予定なの、このパーティー」"
msgstr ""

#. Occurrence WIK_D_A:908:21873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0003; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:908
msgctxt "text_id=21873 | speaker=alice"
msgid "「わたし、青子、静希君、槻司君、木乃美君、久万梨さん、トッキィー、その他、で合計十三人。"
msgstr ""

#. Occurrence WIK_D_A:914:21874: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0004; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:914
msgctxt "text_id=21874 | speaker=alice"
msgid "　さっきから一堂には揃わないみたいだけど」"
msgstr ""

#. Occurrence WIK_D_A:926:21875: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0004; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:926
msgctxt "text_id=21875 | speaker=kojika"
msgid "「十三人か」"
msgstr ""

#. Occurrence WIK_D_A:931:21876: scene=WIK_D_A
#: WIK_D_A:931
msgctxt "text_id=21876 | speaker=unknown"
msgid "　ひと、ふた、みー、と数えてみる。"
msgstr ""

#. Occurrence WIK_D_A:936:21877: scene=WIK_D_A
#: WIK_D_A:936
msgctxt "text_id=21877 | speaker=unknown"
msgid "　今までの情報から数えてみると……"
msgstr ""

#. Occurrence WIK_SELECT_E:8:21878: scene=WIK_SELECT_E
#: WIK_SELECT_E:8
msgctxt "text_id=21878 | speaker=unknown"
msgid "～選択肢Ｅ～"
msgstr ""

#. Occurrence WIK_E:38:21879: scene=WIK_E
#: WIK_E:38
msgctxt "text_id=21879 | speaker=unknown"
msgid "　その時、"
msgstr ""

#. Occurrence WIK_E:66:21880: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_E_0000; voice_prefix=B10; voice_category=5; scene=WIK_E
#: WIK_E:66
msgctxt "text_id=21880 | speaker=kojika"
msgid "「？」"
msgstr ""

#. Occurrence WIK_E:112:21881: scene=WIK_E
#: WIK_E:112
msgctxt "text_id=21881 | speaker=unknown"
msgid "　外から異様な風切り音が聞こえてきた。"
msgstr ""

#. Occurrence WIK_E:168:21882: scene=WIK_E
#: WIK_E:168
msgctxt "text_id=21882 | speaker=unknown"
msgid "　洋館の壁をたたき付けるような爆音。"
msgstr ""

#. Occurrence WIK_E:237:21883: scene=WIK_E
#: WIK_E:237
msgctxt "text_id=21883 | speaker=unknown"
msgid "　それに、誰もが意識を取られている中、"
msgstr ""

#. Occurrence WIK_E:338:21884: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0000; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:338
msgctxt "text_id=21884 | speaker=liddell"
msgid "「このメルヘン女、アタシをのけ者とかザケてんの！？"
msgstr ""

#. Occurrence WIK_E:344:21885: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0001; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:344
msgctxt "text_id=21885 | speaker=liddell"
msgid "　こんなボンクラどもはホイホイ呼んで、大本命かつ大人気、この超☆英国美少女であるリデル様を、なんで、アンタの誕生会に呼ばないのよっ！！！！」"
msgstr ""

#. Occurrence WIK_E:350:21886: scene=WIK_E
#: WIK_E:350
msgctxt "text_id=21886 | speaker=unknown"
msgid "　外の雨より何倍もやかましい、"
msgstr ""

#. Occurrence WIK_E:355:21887: scene=WIK_E
#: WIK_E:355
msgctxt "text_id=21887 | speaker=unknown"
msgid "　嵐の化身みたいな女がやって来た。"
msgstr ""

#. Occurrence WIK_E:396:21888: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0000; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:396
msgctxt "text_id=21888 | speaker=tobimaru"
msgid "「リデル！？　おまえ、今日は<余所|よそ>でイベントだったじゃねえか。どうやってここに来やがった！？」"
msgstr ""

#. Occurrence WIK_E:408:21889: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0002; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:408
msgctxt "text_id=21889 | speaker=liddell"
msgid "「ふん、決まってるじゃない。ヘリを飛ばして、よ。"
msgstr ""

#. Occurrence WIK_E:414:21890: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0003; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:414
msgctxt "text_id=21890 | speaker=liddell"
msgid "　覚えておきなさいトビマル。アンタたちみたいな端役と違って、アタシに不可能なんてないの。ちょっと一声かければ、地球の裏側からだってミサイル飛ばせるんだから」"
msgstr ""

#. Occurrence WIK_E:425:21891: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0001; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:425
msgctxt "text_id=21891 | speaker=tobimaru"
msgid "「いや、ミサイル飛ばされてもな」"
msgstr ""

#. Occurrence WIK_E:459:21892: scene=WIK_E
#: WIK_E:459
msgctxt "text_id=21892 | speaker=unknown"
msgid "　ピンク色で統一された女は、わたしや芳助には視線も投げず久遠寺さんへと歩み寄る。"
msgstr ""

#. Occurrence WIK_E:464:21893: scene=WIK_E
#: WIK_E:464
msgctxt "text_id=21893 | speaker=unknown"
msgid "　これみよがしにツカツカと響くブーツの音。挑発的な軍靴のようだ。"
msgstr ""

#. Occurrence WIK_E:505:21894: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0004; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:505
msgctxt "text_id=21894 | speaker=liddell"
msgid "「ほら、忙しくて引く手<数多|あまた>、史上初の億超えウィッチ、自他共に認める協会ナンバーワンのアイドルが、わざわざ専用機<飛|と>ばしてまで来てやったわよ？"
msgstr ""

#. Occurrence WIK_E:518:21895: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0005; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:518
msgctxt "text_id=21895 | speaker=liddell"
msgid "　悔しい？　悔しいでしょ？　夢にも思わなかったぐらいサプライズでしょ？　いいわ、遠慮なく喜びなさい」"
msgstr ""

#. Occurrence WIK_E:551:21896: scene=WIK_E
#: WIK_E:551
msgctxt "text_id=21896 | speaker=unknown"
msgid "　……すごい。"
msgstr ""

#. Occurrence WIK_E:556:21897: scene=WIK_E
#: WIK_E:556
msgctxt "text_id=21897 | speaker=unknown"
msgid "　あの無表情な久遠寺さんが心底うんざりしている場面に出くわすとか、たしかに夢にも思わなかった。"
msgstr ""

#. Occurrence WIK_E:583:21898: scene=WIK_E
#: WIK_E:583
msgctxt "text_id=21898 | speaker=unknown"
msgid "　ピンク女はげんなりする久遠寺さんを見下ろし、満足そうに頷いて、ようやく周囲を見渡した。"
msgstr ""

#. Occurrence WIK_E:608:21899: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0006; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:608
msgctxt "text_id=21899 | speaker=liddell"
msgid "「バッド。なにこのトンチキな面子。せっかくの誕生会だってのに、人選どうなってるの？　親の仇まで呼んじゃって、アンタ、そこまで病んじゃった？"
msgstr ""

#. Occurrence WIK_E:620:21900: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0007; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:620
msgctxt "text_id=21900 | speaker=liddell"
msgid "　ほら、そこの神父。とりあえず私たちにドゥゲザした<後|あと>、全裸になってチキン食べながら切腹してくれない？」"
msgstr ""

#. Occurrence WIK_E:645:21901: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0000; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:645
msgctxt "text_id=21901 | speaker=eiri"
msgid "「はははは。貴女にだけは言われたくありませんねぇ。"
msgstr ""

#. Occurrence WIK_E:656:21902: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0001; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:656
msgctxt "text_id=21902 | speaker=eiri"
msgid "　有珠さんに謝罪というのなら、まず貴女がするべきではないですか？　奪ったものは、きちんと本人に返さなければねぇ」"
msgstr ""

#. Occurrence WIK_E:683:21903: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0008; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:683
msgctxt "text_id=21903 | speaker=liddell"
msgid "「アタシはいいのよ、ちゃんと後でお金払ったし！"
msgstr ""

#. Occurrence WIK_E:696:21904: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0009_0; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:696
msgctxt "text_id=21904 | speaker=liddell"
msgid "　アリスだってキャッシュで受け取ったんだし、アレはもうアタシのモノっ！"
msgstr ""

#. Occurrence WIK_E:710:21905: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0009_1; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:710
msgctxt "text_id=21905 | speaker=liddell"
msgid "　外野がいちいち口はさんでんじゃないわよ」"
msgstr ""

#. Occurrence WIK_E:721:21906: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0002; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:721
msgctxt "text_id=21906 | speaker=eiri"
msgid "「なんと。有珠さんが、貴重なプロイを売却するとは」"
msgstr ""

#. Occurrence WIK_E:746:21907: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0000; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:746
msgctxt "text_id=21907 | speaker=alice"
msgid "「……はあ。お金で解決できる問題じゃないと何度も言ったのだけど。この子、資本主義の犬だから。どう言っても返してくれないの」"
msgstr ""

#. Occurrence WIK_E:758:21908: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0010; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:758
msgctxt "text_id=21908 | speaker=liddell"
msgid "「またまた、照れ隠ししちゃって、この～♪"
msgstr ""

#. Occurrence WIK_E:775:21909: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0011; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:775
msgctxt "text_id=21909 | speaker=liddell"
msgid "　アンタも取引上手よね、“お金では譲れない”とか言って巧みにレートをあげていくんだから」"
msgstr ""

#. Occurrence WIK_E:826:21910: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0000; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:826
msgctxt "text_id=21910 | speaker=kinomi"
msgid "「……なあ殿下。あのすげえ女、どっかで見覚えあんだけど。有珠ちゃんの知り合い？」"
msgstr ""

#. Occurrence WIK_E:838:21911: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0002; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:838
msgctxt "text_id=21911 | speaker=tobimaru"
msgid "「気のせいだ、忘れとけ。ありゃあ関わったら破滅する系の女だ。百害あって一利もねえ」"
msgstr ""

#. Occurrence WIK_E:850:21912: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0001; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:850
msgctxt "text_id=21912 | speaker=kinomi"
msgid "「そ、そうですよね。オレもあそこまでキラキラしている人は、ちょっと……」"
msgstr ""

#. Occurrence WIK_E:884:21913: scene=WIK_E
#: WIK_E:884
msgctxt "text_id=21913 | speaker=unknown"
msgid "　槻司はああ言っているけど、わたしは知っている。"
msgstr ""

#. Occurrence WIK_E:904:21914: scene=WIK_E
#: WIK_E:904
msgctxt "text_id=21914 | speaker=unknown"
msgid "　彼女の名前はリデル。"
msgstr ""

#. Occurrence WIK_E:909:21915: scene=WIK_E
#: WIK_E:909
msgctxt "text_id=21915 | speaker=unknown"
msgid "　一時期、槻司の家にホームステイしていた女の子だ。"
msgstr ""

#. Occurrence WIK_E:914:21916: scene=WIK_E
#: WIK_E:914
msgctxt "text_id=21916 | speaker=unknown"
msgid "　槻司のお父さんとリデルのお父さん、企業間の付き合いでのコトらしい。"
msgstr ""

#. Occurrence WIK_E:920:21917: scene=WIK_E
#: WIK_E:920
msgctxt "text_id=21917 | speaker=unknown"
msgid "　……といっても槻司の屋敷は大きいので、一つ屋根の下、という話ではないだろうし、そう親しい仲ではない、と思いたい。"
msgstr ""

#. Occurrence WIK_E:960:21918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0001; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:960
msgctxt "text_id=21918 | speaker=alice"
msgid "「……一応、訊いてあげるけど。"
msgstr ""

#. Occurrence WIK_E:966:21919: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0002; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:966
msgctxt "text_id=21919 | speaker=alice"
msgid "　リデル。貴女、何をしにきたの？」"
msgstr ""

#. Occurrence WIK_E:991:21920: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0012; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:991
msgctxt "text_id=21920 | speaker=liddell"
msgid "「なにって、アンタの誕生会でしょ？"
msgstr ""

#. Occurrence WIK_E:997:21921: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0013; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:997
msgctxt "text_id=21921 | speaker=liddell"
msgid "　トビマルの家に電話したら、“坊ちゃんなら久遠寺さんの家の誕生会にでかけた”とか言っちゃってさ。"
msgstr ""

#. Occurrence WIK_E:1009:21922: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0014; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1009
msgctxt "text_id=21922 | speaker=liddell"
msgid "　もうカーッと<脳髄|あたま>ハイになっちゃって、ライブキャンセルして飛んできたってワケ」"
msgstr ""

#. Occurrence WIK_E:1030:21923: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0003; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1030
msgctxt "text_id=21923 | speaker=alice"
msgid "「……貴女、わたしの誕生日、覚えている？」"
msgstr ""

#. Occurrence WIK_E:1042:21924: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0015; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1042
msgctxt "text_id=21924 | speaker=liddell"
msgid "「あったりまえじゃない！　自分のは忘れてもアンタのだけは忘れな………"
msgstr ""

#. Occurrence WIK_E:1054:21925: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0016; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1054
msgctxt "text_id=21925 | speaker=liddell"
msgid "　あれ？　まだ秋よね、この国？」"
msgstr ""

#. Occurrence WIK_E:1094:21926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0004; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1094
msgctxt "text_id=21926 | speaker=alice"
msgid "「良かった、脳は<ま|・><だ|・>正常ねリデル。"
msgstr ""

#. Occurrence WIK_E:1106:21927: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0005; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1106
msgctxt "text_id=21927 | speaker=alice"
msgid "　ほら。わたし、貴女の頭を叩きすぎたでしょう？"
msgstr ""

#. Occurrence WIK_E:1112:21928: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0006; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1112
msgctxt "text_id=21928 | speaker=alice"
msgid "　それで気の毒な結果を招いてしまったのかと、少しだけ心配してしまったわ」"
msgstr ""

#. Occurrence WIK_E:1142:21929: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0017; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1142
msgctxt "text_id=21929 | speaker=liddell"
msgid "「ちょっとトビマル！　なにウソ言ってんのよ、今日はアリスの誕生日じゃないっての！」"
msgstr ""

#. Occurrence WIK_E:1180:21930: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0003; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1180
msgctxt "text_id=21930 | speaker=tobimaru"
msgid "「いや、でも招待状には確かに、久遠寺邸で誕生会をするから、ぜひ参加するように、とだな」"
msgstr ""

#. Occurrence WIK_E:1191:21931: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0002; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:1191
msgctxt "text_id=21931 | speaker=kinomi"
msgid "「そうそう。オレも会長から二千円と引き替えに招待状もらったよ？"
msgstr ""

#. Occurrence WIK_E:1203:21932: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0003; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:1203
msgctxt "text_id=21932 | speaker=kinomi"
msgid "　ところで、料金とられたのオレだけじゃないよね？」"
msgstr ""

#. Occurrence WIK_E:1244:21933: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0003; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1244
msgctxt "text_id=21933 | speaker=eiri"
msgid "「はははは。知らない方が幸せな話ってどこにでもあるんですねぇ。ああ、私も久遠寺邸で誕生会をする、と覚えてきましたが」"
msgstr ""

#. Occurrence WIK_E:1256:21934: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0000; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1256
msgctxt "text_id=21934 | speaker=ritsuka"
msgid "「でも、アッちゃんの誕生日じゃないのよね？」"
msgstr ""

#. Occurrence WIK_E:1302:21935: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0007; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1302
msgctxt "text_id=21935 | speaker=alice"
msgid "「……なぜそんな勘違いを生んだのかしら。"
msgstr ""

#. Occurrence WIK_E:1314:21936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0008; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1314
msgctxt "text_id=21936 | speaker=alice"
msgid "　たしかに誕生会だけど、わたしじゃなくてトッキィーの誕生会よ。"
msgstr ""

#. Occurrence WIK_E:1321:21937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0009; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1321
msgctxt "text_id=21937 | speaker=alice"
msgid "彼、わたしに祝ってほしいというから、この屋敷を会場にしただけなのだけど」"
msgstr ""

#. Occurrence WIK_E:1384:21938: scene=WIK_E
#: WIK_E:1384
msgctxt "text_id=21938 | speaker=unknown"
msgid "　わたしは招待状を見直した。"
msgstr ""

#. Occurrence WIK_E:1389:21939: scene=WIK_E
#: WIK_E:1389
msgctxt "text_id=21939 | speaker=unknown"
msgid "“久遠寺邸で誕生会を開くから、ぜひ参加してほしい”"
msgstr ""

#. Occurrence WIK_E:1394:21940: scene=WIK_E
#: WIK_E:1394
msgctxt "text_id=21940 | speaker=unknown"
msgid "　なるほど。"
msgstr ""

#. Occurrence WIK_E:1399:21941: scene=WIK_E
#: WIK_E:1399
msgctxt "text_id=21941 | speaker=unknown"
msgid "　たしかに、誰の誕生日とは書かれていない。"
msgstr ""

#. Occurrence WIK_E:1457:21942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0000; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1457
msgctxt "text_id=21942 | speaker=aoko"
msgid "「やっほー。盛り上がっちゃって、何の騒ぎ？"
msgstr ""

#. Occurrence WIK_E:1476:21943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0001; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1476
msgctxt "text_id=21943 | speaker=aoko"
msgid "　……って、リデルリドル!?　アンタ、なんでここにいんのよ!?　ライブは!?　ねえ、いまＮＫホールでライブやってんじゃないの!?"
msgstr ""

#. Occurrence WIK_E:1482:21944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0002; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1482
msgctxt "text_id=21944 | speaker=aoko"
msgid "　私、ビデオ録画してるんですけど!?」"
msgstr ""

#. Occurrence WIK_E:1497:21945: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0018; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1497
msgctxt "text_id=21945 | speaker=liddell"
msgid "「サボタージュ。ランチのカレーが<辛|から>かったから」"
msgstr ""

#. Occurrence WIK_E:1529:21946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0003; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1529
msgctxt "text_id=21946 | speaker=aoko"
msgid "「そ、そんなバカな理由でコンサートをドタキャンするヤツがいるかーーーー！　音楽の神に謝れ！　ファンをなんだと思ってんのよアンタは!?」"
msgstr ""

#. Occurrence WIK_E:1555:21947: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0019; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1555
msgctxt "text_id=21947 | speaker=liddell"
msgid "「チッ、やっぱりコイツマジうざい。"
msgstr ""

#. Occurrence WIK_E:1566:21948: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0020; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1566
msgctxt "text_id=21948 | speaker=liddell"
msgid "　だいたいアタシ、音楽とかどうでもいいし。ファンなんてアタシに貢ぐだけの働きアリだし。ライブがハネた後はいつも空しくなってリスカするし。"
msgstr ""

#. Occurrence WIK_E:1577:21949: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0021; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1577
msgctxt "text_id=21949 | speaker=liddell"
msgid "　スポットライトは当たっても、ホントのアタシは誰も見てくれないし」"
msgstr ""

#. Occurrence WIK_E:1597:21950: scene=WIK_E
#: WIK_E:1597
msgctxt "text_id=21950 | speaker=unknown"
msgid "　ピンク女の空気が突如、一変する。"
msgstr ""

#. Occurrence WIK_E:1646:21951: scene=WIK_E
#: WIK_E:1646
msgctxt "text_id=21951 | speaker=unknown"
msgid "　ぶつぶつと呟く彼女の肩に、チチチ、と可愛らしく鳴く青い駒鳥が降り立った。"
msgstr ""

#. Occurrence WIK_E:1669:21952: voice_id=BA0_WIK_E_0000; voice_prefix=BA0; voice_category=0; scene=WIK_E
#: WIK_E:1669
msgctxt "text_id=21952 | speaker=unknown"
msgid "『ハハハ、さすがリデルさん、感情のオンオフ激しいっスね！　ホントのアタシを見てー、とか、メルヘン全開で恥ずかしくないッスか？　恥ずかしくないんスよね。スゲー、やっぱリデルさん、魔術師よりアイドル向けッス！』"
msgstr ""

#. Occurrence WIK_E:1696:21953: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0022; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1696
msgctxt "text_id=21953 | speaker=liddell"
msgid "「そうよ、悪い。どうせアタシは報われない、自分を主役と勘違いしている乞食みたいな最下層の生き物なのよ。道化なのよ。"
msgstr ""

#. Occurrence WIK_E:1709:21954: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0023; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1709
msgctxt "text_id=21954 | speaker=liddell"
msgid "わかってるからほっといてよロビン。後できっちり細切れにして、犬に食わせてあげるから」"
msgstr ""

#. Occurrence WIK_E:1715:21955: scene=WIK_E
#: WIK_E:1715
msgctxt "text_id=21955 | speaker=unknown"
msgid "　……なんか、鳥と話しているし。"
msgstr ""

#. Occurrence WIK_E:1720:21956: scene=WIK_E
#: WIK_E:1720
msgctxt "text_id=21956 | speaker=unknown"
msgid "　本格的に電波だったんだ、あのアイドル。"
msgstr ""

#. Occurrence WIK_E:1764:21957: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0004; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1764
msgctxt "text_id=21957 | speaker=eiri"
msgid "「なるほど、<土桔|ときつ>さんの誕生会でしたか。"
msgstr ""

#. Occurrence WIK_E:1770:21958: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0005; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1770
msgctxt "text_id=21958 | speaker=eiri"
msgid "　私たちもどうして呼ばれたのか半信半疑でしたが、それなら合点がいきます。"
msgstr ""

#. Occurrence WIK_E:1782:21959: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0006; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1782
msgctxt "text_id=21959 | speaker=eiri"
msgid "　シスター唯架なんて、これは罠だから完全武装で行くべきです、とか言いだす始末ですし」"
msgstr ""

#. Occurrence WIK_E:1809:21960: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0000; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1809
msgctxt "text_id=21960 | speaker=yuika"
msgid "「……コホン。"
msgstr ""

#. Occurrence WIK_E:1821:21961: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0001; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1821
msgctxt "text_id=21961 | speaker=yuika"
msgid "　しかし久遠寺さん、肝心の土桔<由里彦|ゆりひこ>氏は何処に？"
msgstr ""

#. Occurrence WIK_E:1827:21962: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0002; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1827
msgctxt "text_id=21962 | speaker=yuika"
msgid "　私たちも挨拶をしていないのですが」"
msgstr ""

#. Occurrence WIK_E:1852:21963: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0010; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1852
msgctxt "text_id=21963 | speaker=alice"
msgid "「そういえば、そうね。"
msgstr ""

#. Occurrence WIK_E:1865:21964: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0011; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1865
msgctxt "text_id=21964 | speaker=alice"
msgid "青子、トッキィーは？」"
msgstr ""

#. Occurrence WIK_E:1891:21965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0004; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1891
msgctxt "text_id=21965 | speaker=aoko"
msgid "「え、居ないの？　夕食の手配、ぜんぶあの人が担当なのに。とびきりのシェフ団を手配するから、君たちはゆっくりしていなさいって自慢してたじゃない」"
msgstr ""

#. Occurrence WIK_E:1917:21966: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0004; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1917
msgctxt "text_id=21966 | speaker=tobimaru"
msgid "「そりゃおかしいな。そういう段取りなら、シェフ団とやらは四時には到着していないと間に合わねえぞ。"
msgstr ""

#. Occurrence WIK_E:1923:21967: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0005; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1923
msgctxt "text_id=21967 | speaker=tobimaru"
msgid "　誰か、土桔の爺さんを見なかったか？」"
msgstr ""

#. Occurrence WIK_E:1963:21968: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_E_0000; voice_prefix=A50; voice_category=12; scene=WIK_E
#: WIK_E:1963
msgctxt "text_id=21968 | speaker=beo"
msgid "「お昼まではここにいたけど、それ以降は見てないよ」"
msgstr ""

#. Occurrence WIK_E:1988:21969: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0001; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1988
msgctxt "text_id=21969 | speaker=ritsuka"
msgid "「わたしは一度も見てないわ。"
msgstr ""

#. Occurrence WIK_E:1988:21970: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0001; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1988
msgctxt "text_id=21970 | speaker=ritsuka"
msgid "　何度か席を外したけど、その時も見かけなかったし」"
msgstr ""

#. Occurrence WIK_E:2023:21971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0012; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:2023
msgctxt "text_id=21971 | speaker=alice"
msgid "「……昼過ぎから今まで、五時間近く、誰もトッキィーを見ていないの……？」"
msgstr ""

#. Occurrence WIK_E:2043:21972: scene=WIK_E
#: WIK_E:2043
msgctxt "text_id=21972 | speaker=unknown"
msgid "　返事はない。"
msgstr ""

#. Occurrence WIK_E:2048:21973: scene=WIK_E
#: WIK_E:2048
msgctxt "text_id=21973 | speaker=unknown"
msgid "　……全員、何か予感じみたものがあったのか、あのピンク女や芳助でさえ無駄口を叩かない。"
msgstr ""

#. Occurrence WIK_E:2105:21974: voice_id=BA0_WIK_E_0001; voice_prefix=BA0; voice_category=0; scene=WIK_E
#: WIK_E:2105
msgctxt "text_id=21974 | speaker=unknown"
msgid "『ん、なんスかこの空気？　カラオケ？　カラオケはじまるッスか？　ジブン、テディボーイブルースとか得意ッスよ？　フリッキーにも歌つけてくれないっスかね？』"
msgstr ""

#. Occurrence WIK_E:2111:21975: scene=WIK_E
#: WIK_E:2111
msgctxt "text_id=21975 | speaker=unknown"
msgid "　声を上げているのは、テーブルの上で不思議そうに首を傾げている駒鳥だけ。"
msgstr ""

#. Occurrence WIK_E:2190:21976: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_E_0000; voice_prefix=A30; voice_category=3; scene=WIK_E
#: WIK_E:2190
msgctxt "text_id=21976 | speaker=soujuurou"
msgid "「ああ、みんな揃ってた。夕飯の支度は終わった？」"
msgstr ""

#. Occurrence WIK_E:2196:21977: scene=WIK_E
#: WIK_E:2196
msgctxt "text_id=21977 | speaker=unknown"
msgid "　……と。"
msgstr ""

#. Occurrence WIK_E:2201:21978: scene=WIK_E
#: WIK_E:2201
msgctxt "text_id=21978 | speaker=unknown"
msgid "　そこへ、ひとり<安穏|あんのん>とした男がやってきた。"
msgstr ""

#. Occurrence WIK_E:2263:21979: scene=WIK_E
#: WIK_E:2263
msgctxt "text_id=21979 | speaker=unknown"
msgid "　場の雰囲気を察したんだろう。"
msgstr ""

#. Occurrence WIK_E:2292:21980: scene=WIK_E
#: WIK_E:2292
msgctxt "text_id=21980 | speaker=unknown"
msgid "　静希は例の、なに考えているか分からない笑顔で集まった人々を見渡して、一言。"
msgstr ""

