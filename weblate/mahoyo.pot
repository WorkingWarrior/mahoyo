#: NZ3:1823
msgctxt "text_id=20012 | speaker=alice"
msgid "　　詳しくは、こう。"
msgstr ""

#. Occurrence NZ3:1869:20013: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20013 | speaker=alice"
msgid "　　　　名前はおしゃべり双子。"
msgstr ""

#. Occurrence NZ3:1869:20014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20014 | speaker=alice"
msgid "　　　　うるさい方がトゥィードルダム、"
msgstr ""

#. Occurrence NZ3:1869:20015: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20015 | speaker=alice"
msgid "　　　　さわがしい方がトゥィードルディー。"
msgstr ""

#. Occurrence NZ3:1895:20016: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0015; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1895
msgctxt "text_id=20016 | speaker=alice"
msgid "　　ダイスを振って、"
msgstr ""

#. Occurrence NZ3:1895:20017: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0015; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1895
msgctxt "text_id=20017 | speaker=alice"
msgid "　　出た目で変形するカタチが変わるプロイね。"
msgstr ""

#. Occurrence NZ3:1926:20018: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0016; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1926
msgctxt "text_id=20018 | speaker=alice"
msgid "　　　人間社会に毒されているから、"
msgstr ""

#. Occurrence NZ3:1926:20019: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0016; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1926
msgctxt "text_id=20019 | speaker=alice"
msgid "　　　普通の魔術が効きやすいのが欠点よ。"
msgstr ""

#. Occurrence NZ3:1958:20020: voice_id=BA0_NZ3_0015; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1958
msgctxt "text_id=20020 | speaker=unknown"
msgid "一の目とか、だしたコトあるッスか？"
msgstr ""

#. Occurrence NZ3:1989:20021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0017; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1989
msgctxt "text_id=20021 | speaker=alice"
msgid "　　　わたしじゃ無理みたい。"
msgstr ""

#. Occurrence NZ3:1989:20022: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0017; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1989
msgctxt "text_id=20022 | speaker=alice"
msgid "　　　子ブタの姿以外、見たこともないもの。"
msgstr ""

#. Occurrence NZ3:2039:20023: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20023 | speaker=unknown"
msgid "　　　無理も何も、ご主人様は清純すぎる！"
msgstr ""

#. Occurrence NZ3:2039:20024: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20024 | speaker=unknown"
msgid "　　　どんなものにも裏はある、"
msgstr ""

#. Occurrence NZ3:2039:20025: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20025 | speaker=unknown"
msgid "　　　僕らは振るにゃあコツがいる！"
msgstr ""

#. Occurrence NZ3:2069:20026: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20026 | speaker=unknown"
msgid "　　そうそう、時にはダーティーに！"
msgstr ""

#. Occurrence NZ3:2069:20027: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20027 | speaker=unknown"
msgid "　　とかく、この世はイカサマだらけ、"
msgstr ""

#. Occurrence NZ3:2069:20028: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20028 | speaker=unknown"
msgid "　　ズルをしないと六の目以外は出ないが定め！"
msgstr ""

#. Occurrence NZ3:2135:20029: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0018; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2135
msgctxt "text_id=20029 | speaker=alice"
msgid "　　夜の饗宴が、お皿に乗ってやってきたわね。"
msgstr ""

#. Occurrence NZ3:2166:20030: voice_id=BA0_NZ3_0016; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2166
msgctxt "text_id=20030 | speaker=unknown"
msgid "　おなじみの『ディドルディドル』ッスね。"
msgstr ""

#. Occurrence NZ3:2166:20031: voice_id=BA0_NZ3_0016; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2166
msgctxt "text_id=20031 | speaker=unknown"
msgid "　ジブンも知ってるッスよ。このマザーグース。"
msgstr ""

#. Occurrence NZ3:2198:20032: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0019; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2198
msgctxt "text_id=20032 | speaker=alice"
msgid "　　それだけ有名というコトよ。"
msgstr ""

#. Occurrence NZ3:2229:20033: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20033 | speaker=alice"
msgid "　　　　　『ヘイ、ディドル、ディドル。"
msgstr ""

#. Occurrence NZ3:2229:20034: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20034 | speaker=alice"
msgid "　　　　　　　猫とヴァイオリン。"
msgstr ""

#. Occurrence NZ3:2229:20035: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20035 | speaker=alice"
msgid "　　　　　　牛が月を飛び越えた。"
msgstr ""

#. Occurrence NZ3:2254:20036: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0021; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2254
msgctxt "text_id=20036 | speaker=alice"
msgid "　　　そのおもしろい光景を見て犬が笑った。"
msgstr ""

#. Occurrence NZ3:2254:20037: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0021; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2254
msgctxt "text_id=20037 | speaker=alice"
msgid "　　　　そしてお皿はスプーンと逃げた。』"
msgstr ""

#. Occurrence NZ3:2285:20038: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0022; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2285
msgctxt "text_id=20038 | speaker=alice"
msgid "　　　典型的な<韻踏み唄|マザーグース>ね。"
msgstr ""

#. Occurrence NZ3:2285:20039: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0022; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2285
msgctxt "text_id=20039 | speaker=alice"
msgid "　　　真夜中、猫がヴァイオリンをひいて、"
msgstr ""

#. Occurrence NZ3:2310:20040: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0023; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2310
msgctxt "text_id=20040 | speaker=alice"
msgid "牛が月を飛び越えて、犬が笑って、"
msgstr ""

#. Occurrence NZ3:2310:20041: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0023; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2310
msgctxt "text_id=20041 | speaker=alice"
msgid "擬人化された皿とスプーンが逃げていくだけの唄。"
msgstr ""

#. Occurrence NZ3:2336:20042: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20042 | speaker=alice"
msgid "　　　一説ではギリシャ・エジプトの神話を元にした……"
msgstr ""

#. Occurrence NZ3:2336:20043: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20043 | speaker=alice"
msgid "　　　とも言われているわ。星の運営を表しているのなら、"
msgstr ""

#. Occurrence NZ3:2336:20044: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20044 | speaker=alice"
msgid "　　　牛は<牡牛座|タウルス>のもじりでしょう。"
msgstr ""

#. Occurrence NZ3:2367:20045: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20045 | speaker=unknown"
msgid "　　　これは使い切りのプロイッスね。"
msgstr ""

#. Occurrence NZ3:2367:20046: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20046 | speaker=unknown"
msgid "　　　一回使ったら壊れるッス。"
msgstr ""

#. Occurrence NZ3:2367:20047: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20047 | speaker=unknown"
msgid "　　　アリスさん、そのたびに作ってるッスか？"
msgstr ""

#. Occurrence NZ3:2399:20048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0025; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2399
msgctxt "text_id=20048 | speaker=alice"
msgid "　当然でしょう。"
msgstr ""

#. Occurrence NZ3:2399:20049: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0025; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2399
msgctxt "text_id=20049 | speaker=alice"
msgid "　ディドルディドルはわたしの魔術の基本だもの。"
msgstr ""

#. Occurrence NZ3:2431:20050: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20050 | speaker=alice"
msgid "　　これを地面に沈めると、夜を助長させるの。"
msgstr ""

#. Occurrence NZ3:2431:20051: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20051 | speaker=alice"
msgid "　　夜が深まれば、それだけわたしの魔術―――"
msgstr ""

#. Occurrence NZ3:2431:20052: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20052 | speaker=alice"
msgid "　　童話詠唱が確かな意味を持つようになるわ。"
msgstr ""

#. Occurrence NZ3:2458:20053: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0027; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2458
msgctxt "text_id=20053 | speaker=alice"
msgid "　　　　　詳しくはこう。"
msgstr ""

#. Occurrence NZ3:2492:20054: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20054 | speaker=unknown"
msgid "　　わりと使いどころ限定なプロイッスね。"
msgstr ""

#. Occurrence NZ3:2492:20055: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20055 | speaker=unknown"
msgid "　　アリスさん、都市部じゃ能力半減っつーか、"
msgstr ""

#. Occurrence NZ3:2492:20056: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20056 | speaker=unknown"
msgid "　　森ガールだったッスか。"
msgstr ""

#. Occurrence NZ3:2541:20057: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20057 | speaker=alice"
msgid "　　　これは「名無しの森」ね。"
msgstr ""

#. Occurrence NZ3:2541:20058: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20058 | speaker=alice"
msgid "　　　これ単体だと意味がないから、"
msgstr ""

#. Occurrence NZ3:2541:20059: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20059 | speaker=alice"
msgid "　　　<地図|どだい>になるものが必要なのだけど……"
msgstr ""

#. Occurrence NZ3:2582:20060: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20060 | speaker=alice"
msgid "　　この「午睡の鏡」とセットで使うものよ。"
msgstr ""

#. Occurrence NZ3:2582:20061: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20061 | speaker=alice"
msgid "　　この鏡は三大プロイにはなれなかったけど、"
msgstr ""

#. Occurrence NZ3:2582:20062: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20062 | speaker=alice"
msgid "　　機能的には三大に負けていないわ。"
msgstr ""

#. Occurrence NZ3:2615:20063: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0030; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2615
msgctxt "text_id=20063 | speaker=alice"
msgid "　　　　　詳しくは、"
msgstr ""

#. Occurrence NZ3:2645:20064: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20064 | speaker=alice"
msgid "　基本的には三咲市全体の索敵と洋館内の警備。"
msgstr ""

#. Occurrence NZ3:2645:20065: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20065 | speaker=alice"
msgid "　たまに暴走して洋館内にゲートを作って、"
msgstr ""

#. Occurrence NZ3:2645:20066: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20066 | speaker=alice"
msgid "　通る人を鏡の中に招いてしまうのが難点ね。"
msgstr ""

#. Occurrence NZ3:2676:20067: voice_id=BA0_NZ3_0019; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2676
msgctxt "text_id=20067 | speaker=unknown"
msgid "ははは。それであのシャバ僧が何度死にかけたか。"
msgstr ""

#. Occurrence NZ3:2676:20068: voice_id=BA0_NZ3_0019; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2676
msgctxt "text_id=20068 | speaker=unknown"
msgid "原点は鏡の国のアリスっスね。"
msgstr ""

#. Occurrence NZ3:2708:20069: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0032; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2708
msgctxt "text_id=20069 | speaker=alice"
msgid "そうね。元々は内側に異世界を持つだけの<魔術卵|エンブリオ>で、"
msgstr ""

#. Occurrence NZ3:2708:20070: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0032; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2708
msgctxt "text_id=20070 | speaker=alice"
msgid "長いこと壊れていたらしいわ。"
msgstr ""

#. Occurrence NZ3:2734:20071: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0033; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2734
msgctxt "text_id=20071 | speaker=alice"
msgid "　　それを母と橙子さんが協力して作り直した、"
msgstr ""

#. Occurrence NZ3:2734:20072: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0033; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2734
msgctxt "text_id=20072 | speaker=alice"
msgid "　　という話よ。"
msgstr ""

#. Occurrence NZ3:2765:20073: voice_id=BA0_NZ3_0020; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2765
msgctxt "text_id=20073 | speaker=unknown"
msgid "？　なんでそんなコトするッスか？"
msgstr ""

#. Occurrence NZ3:2765:20074: voice_id=BA0_NZ3_0020; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2765
msgctxt "text_id=20074 | speaker=unknown"
msgid "マイ女神だけで十分じゃないッスか。"
msgstr ""

#. Occurrence NZ3:2797:20075: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0034; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2797
msgctxt "text_id=20075 | speaker=alice"
msgid "魔女はその生で一つ、至高のプロイを遺さないとい^けない決まりがあるから。"
msgstr ""

#. Occurrence NZ3:2829:20076: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20076 | speaker=alice"
msgid "　　「彼女はこの鏡を作り直して、"
msgstr ""

#. Occurrence NZ3:2829:20077: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20077 | speaker=alice"
msgid "　　自分の最高傑作にしたかったのよ、きっと」"
msgstr ""

#. Occurrence NZ3:2829:20078: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20078 | speaker=alice"
msgid "　　そう橙子さんは言っていたけど、どうだか。"
msgstr ""

#. Occurrence NZ3:2882:20079: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0036; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2882
msgctxt "text_id=20079 | speaker=alice"
msgid "　どうかしら。こんなふうに午睡の鏡の表面を三咲の地図にして、"
msgstr ""

#. Occurrence NZ3:2882:20080: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0036; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2882
msgctxt "text_id=20080 | speaker=alice"
msgid "　その上にコマを置くとそこが「名無しの森」になるの。"
msgstr ""

#. Occurrence NZ3:2932:20081: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20081 | speaker=alice"
msgid "　　　青子のデビュー戦で使っていたのはこのプロイね。"
msgstr ""

#. Occurrence NZ3:2932:20082: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20082 | speaker=alice"
msgid "　　　このプロイの効果範囲に来ると『この先に用はない』"
msgstr ""

#. Occurrence NZ3:2932:20083: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20083 | speaker=alice"
msgid "　　　と暗示がかかって人避けになるのだけど……"
msgstr ""

#. Occurrence NZ3:2964:20084: voice_id=BA0_NZ3_0021; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2964
msgctxt "text_id=20084 | speaker=unknown"
msgid " 空気読まないヤツには通用しないってコトッスね。"
msgstr ""

#. Occurrence NZ3:2996:20085: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20085 | speaker=alice"
msgid "……そうね。"
msgstr ""

#. Occurrence NZ3:2996:20086: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20086 | speaker=alice"
msgid "わたしのミスではないけれど、配慮が足りなかった。"
msgstr ""

#. Occurrence NZ3:2996:20087: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20087 | speaker=alice"
msgid "次からは、本当に気をつけるわ。"
msgstr ""

#. Occurrence NZ3:3041:20088: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0039; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3041
msgctxt "text_id=20088 | speaker=alice"
msgid "　　　気を取り直して、次のプロイは―――"
msgstr ""

#. Occurrence NZ3:3080:20089: voice_id=BA0_NZ3_0022; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3080
msgctxt "text_id=20089 | speaker=unknown"
msgid "　　　ヤフー！"
msgstr ""

#. Occurrence NZ3:3080:20090: voice_id=BA0_NZ3_0022; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3080
msgctxt "text_id=20090 | speaker=unknown"
msgid "　　　ジブンでも食べられる玉子ッスー！"
msgstr ""

#. Occurrence NZ3:3114:20091: voice_id=BA0_NZ3_0023; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3114
msgctxt "text_id=20091 | speaker=unknown"
msgid "　　うめぇ。玉子うめぇ。"
msgstr ""

#. Occurrence NZ3:3114:20092: voice_id=BA0_NZ3_0023; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3114
msgctxt "text_id=20092 | speaker=unknown"
msgid "　　でも、なんかハラにたまるッスこの玉子。"
msgstr ""

#. Occurrence NZ3:3147:20093: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20093 | speaker=unknown"
msgid "　消化できないっつーか、"
msgstr ""

#. Occurrence NZ3:3147:20094: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20094 | speaker=unknown"
msgid "　なんか、体の中心からチクタクチクタク音が"
msgstr ""

#. Occurrence NZ3:3147:20095: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20095 | speaker=unknown"
msgid "　するってゆーかぁ。"
msgstr ""

#. Occurrence NZ3:3178:20096: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0040; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3178
msgctxt "text_id=20096 | speaker=alice"
msgid "　　　　　　スリー。"
msgstr ""

#. Occurrence NZ3:3209:20097: voice_id=BA0_NZ3_0025; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3209
msgctxt "text_id=20097 | speaker=unknown"
msgid "　　　アリスさん？"
msgstr ""

#. Occurrence NZ3:3209:20098: voice_id=BA0_NZ3_0025; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3209
msgctxt "text_id=20098 | speaker=unknown"
msgid "　　　なんで離れるッスか？"
msgstr ""

#. Occurrence NZ3:3240:20099: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0041; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3240
msgctxt "text_id=20099 | speaker=alice"
msgid "　　　　　　トゥー。"
msgstr ""

#. Occurrence NZ3:3271:20100: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20100 | speaker=unknown"
msgid "　なんで"
msgstr ""

#. Occurrence NZ3:3271:20101: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20101 | speaker=unknown"
msgid "　“かわいそうだけど、あと一秒で爆発するのよ”"
msgstr ""

#. Occurrence NZ3:3271:20102: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20102 | speaker=unknown"
msgid "　みたいな目で見るッスか？"
msgstr ""

#. Occurrence NZ3:3302:20103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0042; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3302
msgctxt "text_id=20103 | speaker=alice"
msgid "　　　　　　ワン。"
msgstr ""

#. Occurrence NZ3:3334:20104: voice_id=BA0_NZ3_0027; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3334
msgctxt "text_id=20104 | speaker=unknown"
msgid "　　　　　タスケテ。"
msgstr ""

#. Occurrence NZ3:3365:20105: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0043; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3365
msgctxt "text_id=20105 | speaker=alice"
msgid "　　　　　　ゼロ。"
msgstr ""

#. Occurrence NZ3:3416:20106: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20106 | speaker=alice"
msgid "これはスクラッチ・ダンプティね。"
msgstr ""

#. Occurrence NZ3:3416:20107: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20107 | speaker=alice"
msgid "マザーグースの唄にあるハンプティ・ダンプティを"
msgstr ""

#. Occurrence NZ3:3416:20108: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20108 | speaker=alice"
msgid "モデルにしたものよ。"
msgstr ""

#. Occurrence NZ3:3442:20109: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0045; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3442
msgctxt "text_id=20109 | speaker=alice"
msgid "　　“塀に上った卵はあぶなかしくて、"
msgstr ""

#. Occurrence NZ3:3442:20110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0045; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3442
msgctxt "text_id=20110 | speaker=alice"
msgid "　　通りがかった王様が降りろと言っても無視するばかり。"
msgstr ""

#. Occurrence NZ3:3468:20111: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0046; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3468
msgctxt "text_id=20111 | speaker=alice"
msgid "　　怒った王様は兵士たちに命じたけれど、"
msgstr ""

#. Occurrence NZ3:3468:20112: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0046; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3468
msgctxt "text_id=20112 | speaker=alice"
msgid "　　兵士たちでも卵を下ろすコトはできなかった。"
msgstr ""

#. Occurrence NZ3:3494:20113: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20113 | speaker=alice"
msgid "　もう好きにしろ、と疲れた王様は目を離す。"
msgstr ""

#. Occurrence NZ3:3494:20114: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20114 | speaker=alice"
msgid "　そのとたんに卵は落ちて、"
msgstr ""

#. Occurrence NZ3:3494:20115: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20115 | speaker=alice"
msgid "　見るも無惨、聞くも痛快に、粉々に砕け散った。"
msgstr ""

#. Occurrence NZ3:3520:20116: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20116 | speaker=alice"
msgid "　　油断も後悔も後のお祭り。"
msgstr ""

#. Occurrence NZ3:3520:20117: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20117 | speaker=alice"
msgid "　　星のような欠片たちは、"
msgstr ""

#. Occurrence NZ3:3520:20118: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20118 | speaker=alice"
msgid "　　王の軍勢をもっても拾いきれない―――”"
msgstr ""

#. Occurrence NZ3:3557:20119: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0049; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3557
msgctxt "text_id=20119 | speaker=alice"
msgid "　　壊れた物は直らない、という寓話ね。"
msgstr ""

#. Occurrence NZ3:3557:20120: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0049; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3557
msgctxt "text_id=20120 | speaker=alice"
msgid "　　はた迷惑なお話だけど。"
msgstr ""

#. Occurrence NZ3:3605:20121: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0050; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3605
msgctxt "text_id=20121 | speaker=alice"
msgid "ちなみに、"
msgstr ""

#. Occurrence NZ3:3605:20122: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0050; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3605
msgctxt "text_id=20122 | speaker=alice"
msgid "ハンプティが卵型になったのは１９世紀半ばから。"
msgstr ""

#. Occurrence NZ3:3631:20123: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20123 | speaker=alice"
msgid "　　１８４３年にアリキスというペンネームで、"
msgstr ""

#. Occurrence NZ3:3631:20124: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20124 | speaker=alice"
msgid "　　マベリー牧師という人がハンプティの"
msgstr ""

#. Occurrence NZ3:3631:20125: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20125 | speaker=alice"
msgid "　　パノラマ絵本を書いたのがはしり。"
msgstr ""

#. Occurrence NZ3:3662:20126: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0052; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3662
msgctxt "text_id=20126 | speaker=alice"
msgid "　ルイスキャロルのハンプティは、"
msgstr ""

#. Occurrence NZ3:3662:20127: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0052; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3662
msgctxt "text_id=20127 | speaker=alice"
msgid "　それを参考にしたのでしょう。"
msgstr ""

#. Occurrence NZ3:3761:20128: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0053_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3761
msgctxt "text_id=20128 | speaker=alice"
msgid "　 今夜は品切れのようね。"
msgstr ""

#. Occurrence NZ3:3767:20129: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0053_1; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3767
msgctxt "text_id=20129 | speaker=alice"
msgid " 　シェフ、オカンジョーをお願い。"
msgstr ""

#. Occurrence NZ3:3921:20130: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0054; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3921
msgctxt "text_id=20130 | speaker=alice"
msgid "　　次は―――"
msgstr ""

#. Occurrence NZ3:3921:20131: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0054; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3921
msgctxt "text_id=20131 | speaker=alice"
msgid "　　店中の大トロを、残らずいただくわ。"
msgstr ""

#. Occurrence NZ4:126:20132: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20132 | speaker=unknown"
msgid "おーす、今日もワンワン働いているッスかシャバ僧。"
msgstr ""

#. Occurrence NZ4:126:20133: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20133 | speaker=unknown"
msgid "これで鳥の餌を一ダースくれ。"
msgstr ""

#. Occurrence NZ4:126:20134: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20134 | speaker=unknown"
msgid "ヒエかムギの一番いいところを頼む。"
msgstr ""

#. Occurrence NZ4:159:20135: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0000; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:159
msgctxt "text_id=20135 | speaker=alice"
msgid "　　いらっしゃいませ。"
msgstr ""

#. Occurrence NZ4:159:20136: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0000; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:159
msgctxt "text_id=20136 | speaker=alice"
msgid "　　昼間から買い物なんて、いい身分ねロビン。"
msgstr ""

#. Occurrence NZ4:196:20137: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20137 | speaker=unknown"
msgid "　　げぇ、アリスさん！？"
msgstr ""

#. Occurrence NZ4:196:20138: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20138 | speaker=unknown"
msgid "　　ななな、なんで店員とかしてるッスー！？"
msgstr ""

#. Occurrence NZ4:196:20139: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20139 | speaker=unknown"
msgid "　　シャバ僧はどこいったッスか！？"
msgstr ""

#. Occurrence NZ4:227:20140: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20140 | speaker=alice"
msgid "　　トリ頭のクセに細かいコトを気にするのね。"
msgstr ""

#. Occurrence NZ4:227:20141: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20141 | speaker=alice"
msgid "　　今日はわたしが店番をしているの。"
msgstr ""

#. Occurrence NZ4:227:20142: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20142 | speaker=alice"
msgid "　　何か、意見があって？"
msgstr ""

#. Occurrence NZ4:258:20143: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20143 | speaker=unknown"
msgid "いや、ないッスけど。"
msgstr ""

#. Occurrence NZ4:258:20144: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20144 | speaker=unknown"
msgid "あ。ピンときたッスよ。さてはアリスさん、"
msgstr ""

#. Occurrence NZ4:258:20145: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20145 | speaker=unknown"
msgid "シャバ僧と一緒にアルバイトとかスイーツなコ、"
msgstr ""

#. Occurrence NZ4:295:20146: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0002; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:295
msgctxt "text_id=20146 | speaker=alice"
msgid "　　　なぜなにー、プロイー。"
msgstr ""

#. Occurrence NZ4:368:20147: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0003; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:368
msgctxt "text_id=20147 | speaker=alice"
msgid "今回は比較的安全なプロイキッシャーの紹介よ。"
msgstr ""

#. Occurrence NZ4:368:20148: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0003; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:368
msgctxt "text_id=20148 | speaker=alice"
msgid "さあロビン。"
msgstr ""

