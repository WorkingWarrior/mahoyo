msgid "　　　　　　London Bridge is broken down,"
msgstr ""

#. Occurrence 1DOT5_3:4755:1542: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1542 | speaker=alice"
msgid "　　　　　　My fair lady."
msgstr ""

#. Occurrence 1DOT5_3:4833:1543: voice_id=C60_1DOT5_3_0003; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4833
msgctxt "text_id=1543 | speaker=unknown"
msgid "“ギ―――”"
msgstr ""

#. Occurrence 1DOT5_3:4841:1544: scene=1DOT5_3
#: 1DOT5_3:4841
msgctxt "text_id=1544 | speaker=unknown"
msgid "　左右の肩口に食いこむ牙。"
msgstr ""

#. Occurrence 1DOT5_3:4846:1545: scene=1DOT5_3
#: 1DOT5_3:4846
msgctxt "text_id=1545 | speaker=unknown"
msgid "　彼はこのカタチとして生まれてから、はじめて怒りの<感情|いし>を覚えた。"
msgstr ""

#. Occurrence 1DOT5_3:4866:1546: scene=1DOT5_3
#: 1DOT5_3:4866
msgctxt "text_id=1546 | speaker=unknown"
msgid "　……基準は絶対でなければならない。"
msgstr ""

#. Occurrence 1DOT5_3:4871:1547: scene=1DOT5_3
#: 1DOT5_3:4871
msgctxt "text_id=1547 | speaker=unknown"
msgid "　いかな神秘、いかな怪奇にも法則はある。"
msgstr ""

#. Occurrence 1DOT5_3:4876:1548: scene=1DOT5_3
#: 1DOT5_3:4876
msgctxt "text_id=1548 | speaker=unknown"
msgid "　コレらはそんな、彼らの<矜持|きょうじ>を無視するものだ。"
msgstr ""

#. Occurrence 1DOT5_3:4947:1549: voice_id=C20_1DOT5_3_0019; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4947
msgctxt "text_id=1549 | speaker=unknown"
msgid "『さあ、三日で衰弱！』"
msgstr ""

#. Occurrence 1DOT5_3:4953:1550: voice_id=C30_1DOT5_3_0018; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4953
msgctxt "text_id=1550 | speaker=unknown"
msgid "　　　『六日で溺死！』"
msgstr ""

#. Occurrence 1DOT5_3:4959:1551: voice_id=C20_1DOT5_3_0020; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4959
msgctxt "text_id=1551 | speaker=unknown"
msgid "『半年たてば<惨|みじ>めな<骸骨|がいこつ>！』"
msgstr ""

#. Occurrence 1DOT5_3:4966:1552: voice_id=X10_1DOT5_3_0001; voice_prefix=X10; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4966
msgctxt "text_id=1552 | speaker=unknown"
msgid "『『でもでもご無礼、面倒だからいま殺そうか！』』"
msgstr ""

#. Occurrence 1DOT5_3:5058:1553: voice_id=C60_1DOT5_3_0004; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5058
msgctxt "text_id=1553 | speaker=unknown"
msgid "“シィィィィィィイイイイイ！！！！！！”"
msgstr ""

#. Occurrence 1DOT5_3:5074:1554: scene=1DOT5_3
#: 1DOT5_3:5074
msgctxt "text_id=1554 | speaker=unknown"
msgid "　吠えた。"
msgstr ""

#. Occurrence 1DOT5_3:5079:1555: scene=1DOT5_3
#: 1DOT5_3:5079
msgctxt "text_id=1555 | speaker=unknown"
msgid "　口のないものが、<憤怒|ふんぬ>の叫びを響かせる。"
msgstr ""

#. Occurrence 1DOT5_3:5174:1556: voice_id=C20_1DOT5_3_0021; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5174
msgctxt "text_id=1556 | speaker=unknown"
msgid "『うげ？』"
msgstr ""

#. Occurrence 1DOT5_3:5180:1557: voice_id=C30_1DOT5_3_0019; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5180
msgctxt "text_id=1557 | speaker=unknown"
msgid "『うげげ！？』"
msgstr ""

#. Occurrence 1DOT5_3:5186:1558: voice_id=C20_1DOT5_3_0022; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5186
msgctxt "text_id=1558 | speaker=unknown"
msgid "『なんて便利、自分の腕を<外|はず>せる<機構|きこう>！』"
msgstr ""

#. Occurrence 1DOT5_3:5192:1559: voice_id=C30_1DOT5_3_0020; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5192
msgctxt "text_id=1559 | speaker=unknown"
msgid "『おお、オマエこそ三国一のモノノフよー！』"
msgstr ""

#. Occurrence 1DOT5_3:5296:1560: scene=1DOT5_3
#: 1DOT5_3:5296
msgctxt "text_id=1560 | speaker=unknown"
msgid "　お喋りな子豚たちは小川に落ちた。"
msgstr ""

#. Occurrence 1DOT5_3:5301:1561: scene=1DOT5_3
#: 1DOT5_3:5301
msgctxt "text_id=1561 | speaker=unknown"
msgid "　憤怒の<声|おと>は、自ら両肩を破壊した炸裂音だ。"
msgstr ""

#. Occurrence 1DOT5_3:5306:1562: scene=1DOT5_3
#: 1DOT5_3:5306
msgctxt "text_id=1562 | speaker=unknown"
msgid "　両腕を失ってなお、口裂け男は少女へと走る。"
msgstr ""

#. Occurrence 1DOT5_3:5319:1563: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0017; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5319
msgctxt "text_id=1563 | speaker=alice"
msgid "「……役立たず。後でおしおきが必要ね」"
msgstr ""

#. Occurrence 1DOT5_3:5361:1564: scene=1DOT5_3
#: 1DOT5_3:5361
msgctxt "text_id=1564 | speaker=unknown"
msgid "　もはや切りきざむ腕はないが、彼には最大の悪意が残っている。"
msgstr ""

#. Occurrence 1DOT5_3:5526:1565: scene=1DOT5_3
#: 1DOT5_3:5526
msgctxt "text_id=1565 | speaker=unknown"
msgid "　<睨|にら>んだ者の心臓を<射|い><止|と>める魔眼。"
msgstr ""

#. Occurrence 1DOT5_3:5531:1566: scene=1DOT5_3
#: 1DOT5_3:5531
msgctxt "text_id=1566 | speaker=unknown"
msgid "　心筋を<梗塞|こうそく>させる事のみに特化した魔術回路。"
msgstr ""

#. Occurrence 1DOT5_3:5536:1567: scene=1DOT5_3
#: 1DOT5_3:5536
msgctxt "text_id=1567 | speaker=unknown"
msgid "　<単純|シンプル>ではあるが、だからこそ、この至近距離で放てば回避は不可能な死の<散弾|ショットガン>。"
msgstr ""

#. Occurrence 1DOT5_3:5740:1568: voice_id=C60_1DOT5_3_0005; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5740
msgctxt "text_id=1568 | speaker=unknown"
msgid "“―――？”"
msgstr ""

#. Occurrence 1DOT5_3:5746:1569: scene=1DOT5_3
#: 1DOT5_3:5746
msgctxt "text_id=1569 | speaker=unknown"
msgid "　だが。"
msgstr ""

#. Occurrence 1DOT5_3:5751:1570: scene=1DOT5_3
#: 1DOT5_3:5751
msgctxt "text_id=1570 | speaker=unknown"
msgid "　不幸な事に、彼には目しかなく。"
msgstr ""

#. Occurrence 1DOT5_3:5781:1571: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1571 | speaker=alice"
msgid "　　　　"
msgstr ""

#. Occurrence 1DOT5_3:5781:1572: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1572 | speaker=alice"
msgid "Build it up with wood and clay,"
msgstr ""

#. Occurrence 1DOT5_3:5781:1573: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1573 | speaker=alice"
msgid "　　　　Wood and clay,Wood and clay,"
msgstr ""

#. Occurrence 1DOT5_3:5781:1574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1574 | speaker=alice"
msgid "　　　　Build it up with wood and clay,"
msgstr ""

#. Occurrence 1DOT5_3:5781:1575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1575 | speaker=alice"
msgid "　　　　My fair lady."
msgstr ""

#. Occurrence 1DOT5_3:5802:1576: scene=1DOT5_3
#: 1DOT5_3:5802
msgctxt "text_id=1576 | speaker=unknown"
msgid "　少女の唄が違うものになっていた事に、最後まで気づかなかった。"
msgstr ""

#. Occurrence 1DOT5_3:5917:1577: scene=1DOT5_3
#: 1DOT5_3:5917
msgctxt "text_id=1577 | speaker=unknown"
msgid "　ソレにとって大地を震わす一撃は、虫を払った程度のものでしかない。"
msgstr ""

#. Occurrence 1DOT5_3:5938:1578: scene=1DOT5_3
#: 1DOT5_3:5938
msgctxt "text_id=1578 | speaker=unknown"
msgid "　隆々とわきたつ緑の血管。"
msgstr ""

#. Occurrence 1DOT5_3:5943:1579: scene=1DOT5_3
#: 1DOT5_3:5943
msgctxt "text_id=1579 | speaker=unknown"
msgid "　<乾|かわ>き、何百年という時を<食|は>み、電動の<回転刃|チェインソー>すら<弾|はじ>く<樫|かし>の皮。"
msgstr ""

#. Occurrence 1DOT5_3:5948:1580: scene=1DOT5_3
#: 1DOT5_3:5948
msgctxt "text_id=1580 | speaker=unknown"
msgid "　額には色とりどりの絵の具で落書きされた「emeth」の文字。……ところどころ間違った、お約束にすぎない綴りではあるが。"
msgstr ""

#. Occurrence 1DOT5_3:6103:1581: scene=1DOT5_3
#: 1DOT5_3:6103
msgctxt "text_id=1581 | speaker=unknown"
msgid "　その姿こそテムズトロル。"
msgstr ""

#. Occurrence 1DOT5_3:6108:1582: scene=1DOT5_3
#: 1DOT5_3:6108
msgctxt "text_id=1582 | speaker=unknown"
msgid "　あるいはフォーリンダウン。"
msgstr ""

#. Occurrence 1DOT5_3:6113:1583: scene=1DOT5_3
#: 1DOT5_3:6113
msgctxt "text_id=1583 | speaker=unknown"
msgid "　またの名をグレートブリッジ。"
msgstr ""

#. Occurrence 1DOT5_3:6118:1584: scene=1DOT5_3
#: 1DOT5_3:6118
msgctxt "text_id=1584 | speaker=unknown"
msgid "　<数多|あまた><異形|いぎょう>に賞賛される、四つの奇蹟の最初のいっぽ。"
msgstr ""

#. Occurrence 1DOT5_3:6205:1585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0019; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6205
msgctxt "text_id=1585 | speaker=alice"
msgid "「テムズ、もう一体をお願い」"
msgstr ""

#. Occurrence 1DOT5_3:6230:1586: scene=1DOT5_3
#: 1DOT5_3:6230
msgctxt "text_id=1586 | speaker=unknown"
msgid "　少女の言葉に巨人が応える。"
msgstr ""

#. Occurrence 1DOT5_3:6235:1587: scene=1DOT5_3
#: 1DOT5_3:6235
msgctxt "text_id=1587 | speaker=unknown"
msgid "　地に根を張った緑の巨人は一歩も動かず、その左腕を天に<掲|かか>げ―――"
msgstr ""

#. Occurrence 1DOT5_3:6426:1588: voice_id=C50_1DOT5_3_0016; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6426
msgctxt "text_id=1588 | speaker=unknown"
msgid "“―――、―――”"
msgstr ""

#. Occurrence 1DOT5_3:6432:1589: scene=1DOT5_3
#: 1DOT5_3:6432
msgctxt "text_id=1589 | speaker=unknown"
msgid "　一方。"
msgstr ""

#. Occurrence 1DOT5_3:6437:1590: scene=1DOT5_3
#: 1DOT5_3:6437
msgctxt "text_id=1590 | speaker=unknown"
msgid "　交戦と同時に逃げ出した口裂け男は、夜の森をひた走っていた。"
msgstr ""

#. Occurrence 1DOT5_3:6442:1591: scene=1DOT5_3
#: 1DOT5_3:6442
msgctxt "text_id=1591 | speaker=unknown"
msgid "　相手を記録し、記述する事。"
msgstr ""

#. Occurrence 1DOT5_3:6447:1592: scene=1DOT5_3
#: 1DOT5_3:6447
msgctxt "text_id=1592 | speaker=unknown"
msgid "　それが、彼が己に課した<使命|オーダー>である。"
msgstr ""

#. Occurrence 1DOT5_3:6509:1593: scene=1DOT5_3
#: 1DOT5_3:6509
msgctxt "text_id=1593 | speaker=unknown"
msgid "　住み慣れた森を全力で逃げていく。"
msgstr ""

#. Occurrence 1DOT5_3:6514:1594: scene=1DOT5_3
#: 1DOT5_3:6514
msgctxt "text_id=1594 | speaker=unknown"
msgid "　有事の際は一体が敵に挑み、もう一体は撤退し、雇い主に報告するのが彼らの戦術だった。"
msgstr ""

#. Occurrence 1DOT5_3:6520:1595: scene=1DOT5_3
#: 1DOT5_3:6520
msgctxt "text_id=1595 | speaker=unknown"
msgid "　森を駆ける事。"
msgstr ""

#. Occurrence 1DOT5_3:6525:1596: scene=1DOT5_3
#: 1DOT5_3:6525
msgctxt "text_id=1596 | speaker=unknown"
msgid "　逃げる事だけに機能を特化させた口裂け男は、恐怖に縛られながらも、自身の勝ちを確信した。"
msgstr ""

#. Occurrence 1DOT5_3:6628:1597: scene=1DOT5_3
#: 1DOT5_3:6628
msgctxt "text_id=1597 | speaker=unknown"
msgid "　森で彼に追いつけるモノはいない。"
msgstr ""

#. Occurrence 1DOT5_3:6633:1598: scene=1DOT5_3
#: 1DOT5_3:6633
msgctxt "text_id=1598 | speaker=unknown"
msgid "　野生の狼ですら、離されないよう追尾するのがやっとだろう。"
msgstr ""

#. Occurrence 1DOT5_3:6638:1599: scene=1DOT5_3
#: 1DOT5_3:6638
msgctxt "text_id=1599 | speaker=unknown"
msgid "　カッカッ、と地面を蹴る鳥形の脚。"
msgstr ""

#. Occurrence 1DOT5_3:6643:1600: scene=1DOT5_3
#: 1DOT5_3:6643
msgctxt "text_id=1600 | speaker=unknown"
msgid "　制作者の<偏|かたよ>った趣味なのか、走行のみに特化した場合、彼の脚はこのように変形する。"
msgstr ""

#. Occurrence 1DOT5_3:6749:1601: scene=1DOT5_3
#: 1DOT5_3:6749
msgctxt "text_id=1601 | speaker=unknown"
msgid "　最高時速70キロ。"
msgstr ""

#. Occurrence 1DOT5_3:6754:1602: scene=1DOT5_3
#: 1DOT5_3:6754
msgctxt "text_id=1602 | speaker=unknown"
msgid "　二足歩行生物の限界を超えながら森を行く口裂け男。"
msgstr ""

#. Occurrence 1DOT5_3:6759:1603: scene=1DOT5_3
#: 1DOT5_3:6759
msgctxt "text_id=1603 | speaker=unknown"
msgid "　彼は数キロもの距離をとり、背後の安全を確認した。"
msgstr ""

#. Occurrence 1DOT5_3:6813:1604: scene=1DOT5_3
#: 1DOT5_3:6813
msgctxt "text_id=1604 | speaker=unknown"
msgid "　……追ってくるモノはいない。"
msgstr ""

#. Occurrence 1DOT5_3:6818:1605: scene=1DOT5_3
#: 1DOT5_3:6818
msgctxt "text_id=1605 | speaker=unknown"
msgid "　三日月型の口―――いや、目がほう、と安堵に<緩|ゆる>む。"
msgstr ""

#. Occurrence 1DOT5_3:6841:1606: scene=1DOT5_3
#: 1DOT5_3:6841
msgctxt "text_id=1606 | speaker=unknown"
msgid "　そうして。"
msgstr ""

#. Occurrence 1DOT5_3:6848:1607: voice_id=C50_1DOT5_3_0017; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6848
msgctxt "text_id=1607 | speaker=unknown"
msgid "“―――？”"
msgstr ""

#. Occurrence 1DOT5_3:6880:1608: scene=1DOT5_3
#: 1DOT5_3:6880
msgctxt "text_id=1608 | speaker=unknown"
msgid "　前方に体を向き直した時、彼は自らの死を見上げた。"
msgstr ""

#. Occurrence 1DOT5_3:6910:1609: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1609 | speaker=alice"
msgid "　　　　　　"
msgstr ""

#. Occurrence 1DOT5_3:6910:1610: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1610 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr ""

#. Occurrence 1DOT5_3:6910:1611: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1611 | speaker=alice"
msgid "　　　　　　Broken down,broken down―――"
msgstr ""

#. Occurrence 1DOT5_3:6971:1612: scene=1DOT5_3
#: 1DOT5_3:6971
msgctxt "text_id=1612 | speaker=unknown"
msgid "　彼方から聞こえる<暗黒童話|マザーグース>。"
msgstr ""

#. Occurrence 1DOT5_3:6976:1613: scene=1DOT5_3
#: 1DOT5_3:6976
msgctxt "text_id=1613 | speaker=unknown"
msgid "　地面から伸びた無数の<蔓|つる>。"
msgstr ""

#. Occurrence 1DOT5_3:6981:1614: scene=1DOT5_3
#: 1DOT5_3:6981
