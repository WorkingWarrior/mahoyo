#. Occurrence NZ2:1990:19918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0022; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1990
