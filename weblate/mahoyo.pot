#: NZ2:2024
msgctxt "text_id=19919 | speaker=unknown"
msgid "　　面倒って、なにがッスか。"
msgstr ""

#. Occurrence NZ2:2057:19920: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0023; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:2057
